    {
      "reason_code": "round_trip_mismatch",
      "copy_safe_diagnostic": "Re-exporting this artifact after import did not reproduce it byte-for-byte. The import was blocked to avoid silent data loss."
    },
    {
      "reason_code": "unknown_field_unpreserved",
      "copy_safe_diagnostic": "This artifact carries fields a round-trip would drop. The import was blocked so unknown fields are preserved rather than silently lost."
    }
  ]
