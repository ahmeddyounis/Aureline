{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-source-locator-and-checkout-plan-registries.schema.json",
  "title": "Aureline M5 source-locator and checkout-plan registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 repository-bootstrap matrix. It carries resolved, honest projections of the open-local / open-archive source-locator family and the clone-remote checkout-plan family across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved source-locator entries (naming a canonical registry token, a stable entry-flow ID, a semantic role, a classified source-locator kind, a published literal target / resolved checkout root or archive container / staged-trust metadata / disclosed credential posture / signer or mirror provenance / distinct mirror or air-gap hint, and canonical/accessible/audit resolution-form coverage while preserving the literal target as a verb-faithful locator and disclosing the credential posture before a network or mirror fetch) and resolved checkout-plan entries (naming a canonical registry token, a stable source-ref, a semantic role, a classified checkout mode, and the complete ref-selection / depth-filter / submodule-mode / LFS-posture / destination-path / cost-band checkout-plan object). Hard invariants forbid rewriting clone into open when a local checkout already exists, running repo-owned actions implicitly during acquisition, hiding checkout cost / topology / credential posture before mutation, and collapsing distinct acquisition verbs into one runtime path. Acceptance criteria — every claimed entry flow resolves to one stable source-locator object and one checkout-plan object; users and support can inspect the literal target, resulting mode, and checkout posture; and the suite fails when two entry routes describe the same acquisition differently or collapse distinct verbs — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_source_locator_and_checkout_plan_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "repository_bootstrap_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "repository_bootstrap_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "source_locator_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "entry_flow_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap",
        "source_locator_kind",
        "source_locator_kind_is_classified",
        "canonical_locator_mode",
        "surface_context",
        "literal_target",
        "resolved_root_or_container",
        "trust_stage_metadata",
        "credential_posture",
        "signer_or_mirror_provenance",
        "mirror_or_air_gap_hint",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "source_locator_object_complete",
        "bound_to_registry",
        "literal_target_preserved",
        "touches_network_or_mirror",
        "credential_posture_disclosed",
        "degrade_reason",
        "next_action",
        "locator_resolves_across_entry_flows"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "entry_flow_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap": { "type": "boolean" },
        "source_locator_kind": { "$ref": "#/$defs/non_empty_string" },
        "source_locator_kind_is_classified": { "type": "boolean" },
        "canonical_locator_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "literal_target": { "type": "string" },
        "resolved_root_or_container": { "type": "string" },
        "trust_stage_metadata": { "type": "string" },
        "credential_posture": { "type": "string" },
        "signer_or_mirror_provenance": { "type": "string" },
        "mirror_or_air_gap_hint": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "source_locator_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "literal_target_preserved": { "type": "boolean" },
        "touches_network_or_mirror": { "type": "boolean" },
        "credential_posture_disclosed": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "locator_resolves_across_entry_flows": { "type": "boolean" }
      }
    },
    "checkout_plan_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "source_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap",
        "checkout_mode",
        "checkout_mode_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "ref_selection",
        "depth_filter",
        "submodule_mode",
        "lfs_posture",
        "destination_path",
        "cost_band",
        "keeps_cost_visible_before_mutation",
        "plan_is_truthful",
        "repo_owned_action_scheduled",
        "repo_owned_action_staged_not_auto_run",
        "implicit_mutation_asserted",
        "implicit_mutation_explained",
        "checkout_plan_stays_honest",
        "provides_complete_checkout_plan",
        "degrade_reason",
        "next_action",
        "plan_safe_on_every_source"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "source_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap": { "type": "boolean" },
        "checkout_mode": { "$ref": "#/$defs/non_empty_string" },
        "checkout_mode_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "ref_selection": { "type": "string" },
        "depth_filter": { "type": "string" },
        "submodule_mode": { "type": "string" },
        "lfs_posture": { "type": "string" },
        "destination_path": { "type": "string" },
        "cost_band": { "type": "string" },
        "keeps_cost_visible_before_mutation": { "type": "boolean" },
        "plan_is_truthful": { "type": "boolean" },
        "repo_owned_action_scheduled": { "type": "boolean" },
        "repo_owned_action_staged_not_auto_run": { "type": "boolean" },
        "implicit_mutation_asserted": { "type": "boolean" },
        "implicit_mutation_explained": { "type": "boolean" },
        "checkout_plan_stays_honest": { "type": "boolean" },
        "provides_complete_checkout_plan": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "plan_safe_on_every_source": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "source_locator_entries",
        "checkout_plan_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewrites_clone_into_open_when_local_checkout_already_exists",
        "runs_repo_owned_actions_implicitly_during_acquisition",
        "hides_checkout_cost_topology_or_credential_posture_before_mutation",
        "collapses_distinct_acquisition_verbs_into_one_runtime_path"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "source_locator_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_locator_entry" }
        },
        "checkout_plan_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checkout_plan_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rewrites_clone_into_open_when_local_checkout_already_exists": { "const": false },
        "runs_repo_owned_actions_implicitly_during_acquisition": { "const": false },
        "hides_checkout_cost_topology_or_credential_posture_before_mutation": { "const": false },
        "collapses_distinct_acquisition_verbs_into_one_runtime_path": { "const": false }
      }
    }
  }
}
