{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-repository-bootstrap-shared-consumers.schema.json",
  "title": "M5 Repository-Bootstrap Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the five B142 repository-bootstrap families (open local, clone remote, open archive, import bundle, resume snapshot) to the acquisition-engine / shell / workspace / git-service / trust-service / diagnostics / docs-help / CLI-export / support-export consumers that render them, proving one shared repository-bootstrap registry across the start-center, OS-open, CLI, deep-link, and import entry surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_repository_bootstrap_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "repository_bootstrap_family": {
      "type": "string",
      "enum": [
        "open_local",
        "clone_remote",
        "open_archive",
        "import_bundle",
        "resume_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "acquisition_engine",
        "shell_ui",
        "workspace_service",
        "git_service",
        "trust_service",
        "diagnostics",
        "docs_help",
        "cli_export",
        "support_export"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "repository_bootstrap_grammar_drift_detected",
        "trust_stage_or_provenance_dropped",
        "rewrites_clone_into_open_when_local_checkout_already_exists",
        "runs_repo_owned_actions_implicitly_during_acquisition",
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches",
        "strands_partial_acquisition_without_resume_discard_or_readonly_choices",
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy",
        "canonical_registry_reference_missing",
        "upstream_repository_bootstrap_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_bootstrap_role_word",
        "family_word",
        "registry_reference_word",
        "entry_context_word",
        "surface_context_word",
        "trust_stage_continuity_word"
      ],
      "properties": {
        "repository_bootstrap_role_word": {
          "type": "string",
          "enum": [
            "source_locator",
            "checkout_plan",
            "credential_posture",
            "evidence_packet",
            "staged_trust",
            "resumable_acquisition",
            "post_open_queue"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "entry_context_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "trust_stage_continuity_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "bootstrap_profile_id",
        "bootstrap_profile_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "rewrites_clone_into_open_when_local_checkout_already_exists",
        "runs_repo_owned_actions_implicitly_during_acquisition",
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches",
        "strands_partial_acquisition_without_resume_discard_or_readonly_choices",
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "bootstrap_profile_id": { "type": "string", "minLength": 1 },
        "bootstrap_profile_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/repository_bootstrap_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "rewrites_clone_into_open_when_local_checkout_already_exists": {
          "type": "boolean",
          "const": false
        },
        "runs_repo_owned_actions_implicitly_during_acquisition": {
          "type": "boolean",
          "const": false
        },
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches": {
          "type": "boolean",
          "const": false
        },
        "strands_partial_acquisition_without_resume_discard_or_readonly_choices": {
          "type": "boolean",
          "const": false
        },
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_profile_same_repository_bootstrap_across_surfaces",
        "repository_bootstrap_role_words_stay_in_frozen_vocabulary",
        "trust_roles_never_run_repo_actions_or_lose_provenance",
        "acquisition_never_rewrites_clone_into_open_over_existing_checkout",
        "acquisition_never_runs_repo_owned_actions_implicitly",
        "acquisition_never_loses_signer_or_mirror_provenance",
        "partial_acquisition_never_stranded_without_resume_discard_or_readonly",
        "bootstrap_credential_posture_never_hidden_behind_generic_copy",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_profile_same_repository_bootstrap_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "repository_bootstrap_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "trust_roles_never_run_repo_actions_or_lose_provenance": {
          "type": "boolean",
          "const": true
        },
        "acquisition_never_rewrites_clone_into_open_over_existing_checkout": {
          "type": "boolean",
          "const": true
        },
        "acquisition_never_runs_repo_owned_actions_implicitly": {
          "type": "boolean",
          "const": true
        },
        "acquisition_never_loses_signer_or_mirror_provenance": {
          "type": "boolean",
          "const": true
        },
        "partial_acquisition_never_stranded_without_resume_discard_or_readonly": {
          "type": "boolean",
          "const": true
        },
        "bootstrap_credential_posture_never_hidden_behind_generic_copy": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_engine_consumes_shared_repository_bootstrap",
        "shell_ui_consumes_shared_repository_bootstrap",
        "workspace_service_consumes_shared_repository_bootstrap",
        "git_service_consumes_shared_repository_bootstrap",
        "trust_service_consumes_shared_repository_bootstrap",
        "diagnostics_consumes_shared_repository_bootstrap",
        "docs_help_consumes_shared_repository_bootstrap",
        "cli_export_consumes_shared_repository_bootstrap",
        "support_export_consumes_shared_repository_bootstrap",
        "every_family_adopted_by_two_or_more_consumers",
        "repository_bootstrap_identical_for_same_profile",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_repository_bootstrap_family"
      ],
      "properties": {
        "acquisition_engine_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "shell_ui_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "workspace_service_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "git_service_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "trust_service_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "docs_help_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "cli_export_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_repository_bootstrap": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "repository_bootstrap_identical_for_same_profile": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_repository_bootstrap_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
