{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-bootstrap-credential-posture-and-fetch-route-registries.schema.json",
  "title": "Aureline M5 bootstrap credential-posture and fetch-route registries",
  "description": "Export-safe packet for the credential-boundary + mirror/trust-route implement lane over the frozen M5 repository-bootstrap matrix. It carries resolved, honest projections of the bootstrap credential-posture grammar (auth source, proxy/mirror route, host-key or TLS-pin state, delegated-token policy, handle-only secret references, and mirror/signer provenance) and the fetch-route grammar (public upstream fetch, approved mirror fetch, air-gap bundle import, and managed snapshot resume) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved credential-posture entries (naming a canonical registry token, a stable acquisition-path ID, a semantic role, a classified auth source, a published auth-source reference / proxy or mirror route / host-key or TLS-pin state / delegated-token policy / handle-only secret reference / mirror or signer provenance, and canonical/accessible/audit resolution-form coverage while keeping any referenced secret handle-only and disclosing the host trust state) and resolved fetch-route entries (naming a canonical registry token, a stable source-ref, a semantic role, a classified fetch-route class, and the complete route-endpoint / signer-continuity / digest-continuity / mirror-provenance / recovery-language / trust-proof route object). Hard invariants forbid embedding a raw secret, token, or host trust state in a portable manifest, losing signer or mirror provenance across offline or mirrored fetches, hiding bootstrap credential posture behind generic connected-state copy, and collapsing distinct fetch routes into one runtime path. Acceptance criteria — acquisition flows expose auth source, mirror/route class, and trust proof without leaking raw credentials; portable manifests and export packets do not embed secrets, tokens, or hidden host trust state; and mirror and signer continuity remain visible and reconstructable for public, mirrored, and offline acquisition paths — are proven by the resolved examples, not merely asserted. Raw secret values, tokens, and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_bootstrap_credential_posture_and_fetch_route_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "repository_bootstrap_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "repository_bootstrap_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "credential_posture_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "acquisition_path_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap",
        "auth_source_kind",
        "auth_source_kind_is_classified",
        "canonical_auth_mode",
        "surface_context",
        "auth_source_ref",
        "proxy_or_mirror_route",
        "host_key_or_tls_pin_state",
        "delegated_token_policy",
        "handle_only_secret_reference",
        "mirror_or_signer_provenance",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "credential_posture_object_complete",
        "bound_to_registry",
        "host_trust_disclosed",
        "references_secret_material",
        "secret_kept_handle_only",
        "degrade_reason",
        "next_action",
        "posture_resolves_across_entry_flows"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "acquisition_path_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap": { "type": "boolean" },
        "auth_source_kind": { "$ref": "#/$defs/non_empty_string" },
        "auth_source_kind_is_classified": { "type": "boolean" },
        "canonical_auth_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "auth_source_ref": { "type": "string" },
        "proxy_or_mirror_route": { "type": "string" },
        "host_key_or_tls_pin_state": { "type": "string" },
        "delegated_token_policy": { "type": "string" },
        "handle_only_secret_reference": { "type": "string" },
        "mirror_or_signer_provenance": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "credential_posture_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "host_trust_disclosed": { "type": "boolean" },
        "references_secret_material": { "type": "boolean" },
        "secret_kept_handle_only": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "posture_resolves_across_entry_flows": { "type": "boolean" }
      }
    },
    "fetch_route_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "source_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap",
        "route_class",
        "route_class_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "route_endpoint_class",
        "signer_continuity_ref",
        "digest_continuity_ref",
        "mirror_provenance_ref",
        "recovery_language",
        "trust_proof_ref",
        "keeps_signer_continuity_visible",
        "route_is_truthful",
        "crosses_offline_or_mirror",
        "signer_continuity_preserved",
        "asserts_recovery",
        "recovery_explained",
        "fetch_route_stays_signer_continuous",
        "provides_complete_fetch_route",
        "degrade_reason",
        "next_action",
        "route_safe_on_every_source"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "source_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap": { "type": "boolean" },
        "route_class": { "$ref": "#/$defs/non_empty_string" },
        "route_class_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "route_endpoint_class": { "type": "string" },
        "signer_continuity_ref": { "type": "string" },
        "digest_continuity_ref": { "type": "string" },
        "mirror_provenance_ref": { "type": "string" },
        "recovery_language": { "type": "string" },
        "trust_proof_ref": { "type": "string" },
        "keeps_signer_continuity_visible": { "type": "boolean" },
        "route_is_truthful": { "type": "boolean" },
        "crosses_offline_or_mirror": { "type": "boolean" },
        "signer_continuity_preserved": { "type": "boolean" },
        "asserts_recovery": { "type": "boolean" },
        "recovery_explained": { "type": "boolean" },
        "fetch_route_stays_signer_continuous": { "type": "boolean" },
        "provides_complete_fetch_route": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "route_safe_on_every_source": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "credential_posture_entries",
        "fetch_route_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "embeds_raw_secret_token_or_host_trust_state_in_portable_manifest",
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches",
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy",
        "collapses_distinct_fetch_routes_into_one_runtime_path"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "credential_posture_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/credential_posture_entry" }
        },
        "fetch_route_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fetch_route_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "embeds_raw_secret_token_or_host_trust_state_in_portable_manifest": { "const": false },
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches": { "const": false },
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy": { "const": false },
        "collapses_distinct_fetch_routes_into_one_runtime_path": { "const": false }
      }
    }
  }
}
