{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-acquisition-evidence-and-partial-recovery-registries.schema.json",
  "title": "Aureline M5 acquisition-evidence and partial-recovery registries",
  "description": "Export-safe packet for the evidence-packet + resumable-acquisition implement lane over the frozen M5 repository-bootstrap matrix. It carries resolved, honest projections of the acquisition-evidence grammar (clone / fetch transcript, warnings and retries, resulting root identity, omitted-or-unfetched state, and current bootstrap checkpoint) and the partial-recovery grammar (resume acquisition, discard partial state, open read-only partial root, or inert status report) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved acquisition-evidence entries (naming a canonical registry token, a stable acquisition-path ID, a semantic role, a classified evidence kind, a published clone / fetch transcript reference / warnings-and-retries reference / resulting-root-identity reference / omitted-or-unfetched reference / bootstrap-checkpoint reference / evidence provenance, and canonical/accessible/audit resolution-form coverage while keeping a partial or interrupted acquisition visible and disclosing partial-not-full status before any partial-describing packet) and resolved partial-recovery entries (naming a canonical registry token, a stable source-ref, a semantic role, a classified recovery class, and the complete recovery-action-kind / recovery-site / state-consequence / lineage-consequence / explicit-action-requirement / attribution recovery object). Hard invariants forbid presenting a partial acquisition as a healthy full checkout, discarding partial state or transcript lineage without an explicit action, hiding what a recovery action would do or its state or lineage effect, and leaving partial or interrupted state invisible or unrecoverable. Acceptance criteria — partial or interrupted acquisition remains visible and recoverable rather than looking like missing or unsupported data; evidence packets let support explain what Aureline fetched, skipped, retried, or left partial; and no acquisition failure path discards partial state or transcript lineage without an explicit discard or cleanup action — are proven by the resolved examples, not merely asserted. Raw secret values, tokens, and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_acquisition_evidence_and_partial_recovery_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "repository_bootstrap_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "repository_bootstrap_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "acquisition_evidence_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "acquisition_path_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap",
        "evidence_kind",
        "evidence_kind_is_classified",
        "canonical_evidence_mode",
        "surface_context",
        "transcript_ref",
        "warnings_and_retries_ref",
        "resulting_root_identity_ref",
        "omitted_or_unfetched_ref",
        "bootstrap_checkpoint_ref",
        "evidence_provenance",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "evidence_packet_complete",
        "bound_to_registry",
        "partial_state_visible",
        "describes_partial_state",
        "partial_not_full_disclosed",
        "degrade_reason",
        "next_action",
        "evidence_resolves_across_entry_flows"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "acquisition_path_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap": { "type": "boolean" },
        "evidence_kind": { "$ref": "#/$defs/non_empty_string" },
        "evidence_kind_is_classified": { "type": "boolean" },
        "canonical_evidence_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "transcript_ref": { "type": "string" },
        "warnings_and_retries_ref": { "type": "string" },
        "resulting_root_identity_ref": { "type": "string" },
        "omitted_or_unfetched_ref": { "type": "string" },
        "bootstrap_checkpoint_ref": { "type": "string" },
        "evidence_provenance": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "evidence_packet_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "partial_state_visible": { "type": "boolean" },
        "describes_partial_state": { "type": "boolean" },
        "partial_not_full_disclosed": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "evidence_resolves_across_entry_flows": { "type": "boolean" }
      }
    },
    "partial_recovery_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "source_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap",
        "recovery_class",
        "recovery_class_is_classified",
        "recovery_class_is_state_mutating",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "recovery_action_kind",
        "recovery_site",
        "state_consequence",
        "lineage_consequence",
        "explicit_action_requirement",
        "attribution_ref",
        "identifies_recovery_site_and_state_effect",
        "action_is_truthfully_typed",
        "is_state_mutating_action",
        "explicit_discard_or_cleanup_action_present",
        "schedules_deferred_cleanup",
        "cleanup_is_disclosed",
        "discards_state_without_explicit_action",
        "partial_recovery_action_preserves_lineage",
        "provides_complete_partial_recovery",
        "degrade_reason",
        "next_action",
        "recovery_safe_on_every_source"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "source_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap": { "type": "boolean" },
        "recovery_class": { "$ref": "#/$defs/non_empty_string" },
        "recovery_class_is_classified": { "type": "boolean" },
        "recovery_class_is_state_mutating": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "recovery_action_kind": { "type": "string" },
        "recovery_site": { "type": "string" },
        "state_consequence": { "type": "string" },
        "lineage_consequence": { "type": "string" },
        "explicit_action_requirement": { "type": "string" },
        "attribution_ref": { "type": "string" },
        "identifies_recovery_site_and_state_effect": { "type": "boolean" },
        "action_is_truthfully_typed": { "type": "boolean" },
        "is_state_mutating_action": { "type": "boolean" },
        "explicit_discard_or_cleanup_action_present": { "type": "boolean" },
        "schedules_deferred_cleanup": { "type": "boolean" },
        "cleanup_is_disclosed": { "type": "boolean" },
        "discards_state_without_explicit_action": { "type": "boolean" },
        "partial_recovery_action_preserves_lineage": { "type": "boolean" },
        "provides_complete_partial_recovery": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "recovery_safe_on_every_source": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "acquisition_evidence_entries",
        "partial_recovery_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "presents_partial_acquisition_as_healthy_full_checkout",
        "discards_partial_state_or_lineage_without_explicit_action",
        "hides_what_a_recovery_action_would_do_or_its_state_or_lineage_effect",
        "leaves_partial_or_interrupted_state_invisible_or_unrecoverable"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "acquisition_evidence_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/acquisition_evidence_entry" }
        },
        "partial_recovery_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/partial_recovery_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "presents_partial_acquisition_as_healthy_full_checkout": { "const": false },
        "discards_partial_state_or_lineage_without_explicit_action": { "const": false },
        "hides_what_a_recovery_action_would_do_or_its_state_or_lineage_effect": { "const": false },
        "leaves_partial_or_interrupted_state_invisible_or_unrecoverable": { "const": false }
      }
    }
  }
}
