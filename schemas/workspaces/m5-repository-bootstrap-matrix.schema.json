{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-repository-bootstrap-matrix.schema.json",
  "title": "Aureline M5 repository-bootstrap, checkout-plan, trust-stage, and post-open-queue matrix",
  "description": "Export-safe packet freezing Aureline's concrete repository-acquisition and workspace-bootstrap behavior. The packet names every claimed M5 project-entry verb — open a local checkout, clone a remote source, open an archive, import a bundle, and resume a partial-acquisition snapshot — and binds each governed family to the claimed surface families that render it (shell, entry, diagnostics, admin, docs/help, support-export), the acquisition contexts it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each family declares the controlled vocabularies it carries: the single controlled repository-bootstrap-role vocabulary consumers bind to (source_locator, checkout_plan, credential_posture, evidence_packet, staged_trust, resumable_acquisition, post_open_queue), plus family-specific open-local roles, clone-remote roles, open-archive roles, import-bundle roles, and resume-snapshot roles. Hard invariants forbid rewriting clone into open when a local checkout already exists, running repo-owned actions implicitly during acquisition, losing signer or mirror provenance across an offline or mirrored fetch, stranding partial acquisition state without Resume / Discard / read-only choices, and hiding bootstrap credential posture behind generic connected-state copy. The matrix binds back to the already-landed repository-acquisition and source-acquisition-review packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "repository_bootstrap_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_repository_bootstrap_checkout_plan_trust_stage_and_post_open_queue_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "repository_bootstrap_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/repository_bootstrap_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "repository_bootstrap_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "repository_bootstrap_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "repository_bootstrap_family": {
      "enum": [
        "open_local",
        "clone_remote",
        "open_archive",
        "import_bundle",
        "resume_snapshot"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "source_locator",
        "checkout_plan",
        "credential_posture",
        "evidence_packet",
        "staged_trust",
        "resumable_acquisition",
        "post_open_queue"
      ]
    },
    "repository_bootstrap_row": {
      "type": "object",
      "required": [
        "repository_bootstrap_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewrites_clone_into_open_when_local_checkout_already_exists",
        "runs_repo_owned_actions_implicitly_during_acquisition",
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches",
        "strands_partial_acquisition_without_resume_discard_or_readonly_choices",
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy"
      ],
      "properties": {
        "repository_bootstrap_family": {
          "$ref": "#/$defs/repository_bootstrap_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "open_local_roles": {
          "type": "array"
        },
        "clone_remote_roles": {
          "type": "array"
        },
        "open_archive_roles": {
          "type": "array"
        },
        "import_bundle_roles": {
          "type": "array"
        },
        "resume_snapshot_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "rewrites_clone_into_open_when_local_checkout_already_exists": {
          "const": false
        },
        "runs_repo_owned_actions_implicitly_during_acquisition": {
          "const": false
        },
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches": {
          "const": false
        },
        "strands_partial_acquisition_without_resume_discard_or_readonly_choices": {
          "const": false
        },
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy": {
          "const": false
        }
      }
    }
  }
}
