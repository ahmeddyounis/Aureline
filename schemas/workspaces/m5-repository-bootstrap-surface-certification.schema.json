{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-repository-bootstrap-surface-certification.schema.json",
  "title": "Aureline M5 repository-bootstrap surface certification packet",
  "description": "M05-1195 closing capstone certifying that the frozen M5 project-entry acquisition families (open local, clone remote, open archive, import bundle, resume snapshot) hold their repository-bootstrap truth on every claimed M5 project-entry profile. Keyed on the claimed profile (live trusted acquisition surface, reviewable acquisition structure, disclosed checkout-plan profile, unverified trust-stage profile, unverified bootstrap-evidence profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and repository-bootstrap-component-truth behavior — and either passes (green), auto-narrows its acquisition claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted acquisition profile may certify a trusted acquisition surface; and every B142 hard invariant must hold (no acquisition rewrites clone into open when a local checkout already exists; no repo-owned actions run implicitly during acquisition; no signer or mirror provenance is lost across an offline or mirrored fetch; no partial acquisition is stranded without Resume / Discard / read-only choices; and the bootstrap credential posture is never hidden behind generic connected-state copy). Every row cites exactly one canonical repository-bootstrap proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_repository_bootstrap_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-repository-bootstrap-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_acquisition_surface",
        "reviewable_acquisition_structure",
        "disclosed_checkout_plan_profile",
        "unverified_trust_stage_profile",
        "unverified_bootstrap_evidence_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "repository_bootstrap_component_truth"
      ]
    },
    "repository_bootstrap_claim": {
      "enum": [
        "trusted_acquisition_surface",
        "reviewable_acquisition_surface",
        "checkout_plan_disclosed_projection",
        "trust_stage_unverified_projection",
        "bootstrap_evidence_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "repository_bootstrap_family": {
      "enum": [
        "open_local",
        "clone_remote",
        "open_archive",
        "import_bundle",
        "resume_snapshot"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "rewrote_clone_into_open_when_local_checkout_already_exists",
        "ran_repo_owned_actions_implicitly_during_acquisition",
        "lost_signer_or_mirror_provenance_across_offline_or_mirrored_fetches",
        "stranded_partial_acquisition_without_resume_discard_or_readonly_choices",
        "hid_bootstrap_credential_posture_behind_generic_connected_state_copy",
        "checkout_plan_boundary_drifted_by_surface",
        "source_locator_unstated",
        "checkout_plan_unstated",
        "credential_posture_unstated",
        "registry_reference_unstated",
        "staged_trust_rule_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rewrites_clone_into_open_when_local_checkout_already_exists",
        "runs_repo_owned_actions_implicitly_during_acquisition",
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches",
        "strands_partial_acquisition_without_resume_discard_or_readonly_choices",
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy"
      ],
      "properties": {
        "rewrites_clone_into_open_when_local_checkout_already_exists": { "const": false },
        "runs_repo_owned_actions_implicitly_during_acquisition": { "const": false },
        "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches": { "const": false },
        "strands_partial_acquisition_without_resume_discard_or_readonly_choices": { "const": false },
        "hides_bootstrap_credential_posture_behind_generic_connected_state_copy": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/repository_bootstrap_claim" },
        "to_claim": { "$ref": "#/$defs/repository_bootstrap_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_repository_bootstrap_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/repository_bootstrap_claim" },
        "certified_claim": { "$ref": "#/$defs/repository_bootstrap_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repository_bootstrap_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-repository-bootstrap-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
