{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-staged-trust-and-post-open-queue-registries.schema.json",
  "title": "Aureline M5 staged-trust and post-open bootstrap-queue registries",
  "description": "Export-safe packet for the staged-trust + post-open-queue implement lane over the frozen M5 repository-bootstrap matrix. It carries resolved, honest projections of the staged-trust grammar (browse tree/manifests/docs, compute safe metadata, the deferred repo-owned action set, the trust-prompt policy, the explicit-approval reference, and staged-trust provenance) and the post-open bootstrap-queue grammar (runs repo-owned code, hydrates network-backed content, mutates the reviewed checkout, or inert recommendation) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved staged-trust entries (naming a canonical registry token, a stable acquisition-path ID, a semantic role, a classified trust stage, a published browse-scope reference / computed-metadata reference / deferred repo-owned action set / trust-prompt policy / explicit-approval reference / staged-trust provenance, and canonical/accessible/audit resolution-form coverage while keeping the stage browse-safe before it widens trust and recording an explicit approval before any trust-widening stage) and resolved post-open-queue entries (naming a canonical registry token, a stable source-ref, a semantic role, a classified queue class, and the complete queue-item-kind / execution-site / trust-consequence / network-consequence / approval-requirement / attribution queue object). Hard invariants forbid running repo-owned actions implicitly during acquisition, auto-executing a post-open bootstrap queue item without explicit approval, hiding what a queue item would run or its trust or network consequence, and widening trust before browse-safe metadata is computed. Acceptance criteria — repository open remains useful before repo-owned actions run and no protected queue item executes implicitly during acquisition; bootstrap queue rows identify exactly what would run, where, and what trust or network consequence it carries; and the suite fails when a repository hook/task/extension or hydration step runs merely because a path was opened or cloned — are proven by the resolved examples, not merely asserted. Raw secret values, tokens, and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_staged_trust_and_post_open_queue_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "repository_bootstrap_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "repository_bootstrap_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "staged_trust_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "acquisition_path_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap",
        "trust_stage_kind",
        "trust_stage_kind_is_classified",
        "canonical_trust_mode",
        "surface_context",
        "browse_scope_ref",
        "computed_metadata_ref",
        "deferred_repo_action_set",
        "trust_prompt_policy",
        "explicit_approval_reference",
        "staged_trust_provenance",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "staged_trust_object_complete",
        "bound_to_registry",
        "browse_safe_before_widening",
        "widens_trust_or_runs_code",
        "explicit_approval_recorded",
        "degrade_reason",
        "next_action",
        "staging_resolves_across_entry_flows"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "acquisition_path_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap": { "type": "boolean" },
        "trust_stage_kind": { "$ref": "#/$defs/non_empty_string" },
        "trust_stage_kind_is_classified": { "type": "boolean" },
        "canonical_trust_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "browse_scope_ref": { "type": "string" },
        "computed_metadata_ref": { "type": "string" },
        "deferred_repo_action_set": { "type": "string" },
        "trust_prompt_policy": { "type": "string" },
        "explicit_approval_reference": { "type": "string" },
        "staged_trust_provenance": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "staged_trust_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "browse_safe_before_widening": { "type": "boolean" },
        "widens_trust_or_runs_code": { "type": "boolean" },
        "explicit_approval_recorded": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "staging_resolves_across_entry_flows": { "type": "boolean" }
      }
    },
    "post_open_queue_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "source_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap",
        "queue_class",
        "queue_class_is_classified",
        "queue_class_is_protected",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "queue_item_kind",
        "execution_site",
        "trust_consequence",
        "network_consequence",
        "approval_requirement",
        "attribution_ref",
        "identifies_run_site_and_consequence",
        "item_is_truthfully_typed",
        "is_protected_item",
        "explicit_approval_or_policy_gated",
        "schedules_deferred_followup",
        "followup_is_disclosed",
        "auto_executes_during_acquisition",
        "post_open_queue_item_holds_for_approval",
        "provides_complete_post_open_queue",
        "degrade_reason",
        "next_action",
        "queue_safe_on_every_source"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "source_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_stage_trust_and_disclose_provenance_before_bootstrap": { "type": "boolean" },
        "queue_class": { "$ref": "#/$defs/non_empty_string" },
        "queue_class_is_classified": { "type": "boolean" },
        "queue_class_is_protected": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "queue_item_kind": { "type": "string" },
        "execution_site": { "type": "string" },
        "trust_consequence": { "type": "string" },
        "network_consequence": { "type": "string" },
        "approval_requirement": { "type": "string" },
        "attribution_ref": { "type": "string" },
        "identifies_run_site_and_consequence": { "type": "boolean" },
        "item_is_truthfully_typed": { "type": "boolean" },
        "is_protected_item": { "type": "boolean" },
        "explicit_approval_or_policy_gated": { "type": "boolean" },
        "schedules_deferred_followup": { "type": "boolean" },
        "followup_is_disclosed": { "type": "boolean" },
        "auto_executes_during_acquisition": { "type": "boolean" },
        "post_open_queue_item_holds_for_approval": { "type": "boolean" },
        "provides_complete_post_open_queue": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "queue_safe_on_every_source": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "staged_trust_entries",
        "post_open_queue_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "runs_repo_owned_actions_implicitly_during_acquisition",
        "auto_executes_post_open_bootstrap_queue_without_explicit_approval",
        "hides_what_a_queue_item_would_run_or_its_trust_or_network_consequence",
        "widens_trust_before_browse_safe_metadata_is_computed"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "staged_trust_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/staged_trust_entry" }
