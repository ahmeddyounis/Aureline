        "post_open_queue_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/post_open_queue_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "runs_repo_owned_actions_implicitly_during_acquisition": { "const": false },
        "auto_executes_post_open_bootstrap_queue_without_explicit_approval": { "const": false },
        "hides_what_a_queue_item_would_run_or_its_trust_or_network_consequence": { "const": false },
