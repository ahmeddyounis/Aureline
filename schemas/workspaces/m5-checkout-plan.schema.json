{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-checkout-plan.schema.json",
  "title": "Aureline M5 checkout-plan acquisition-profile entry",
  "description": "Canonical single-entry shape of an M5 repository-bootstrap family whose truth is the checkout cost, topology, sparse/partial plan, and credential posture shown before network or disk mutation (clone remote). Every claimed M5 project-entry surface references this schema or the combined m5-repository-bootstrap-matrix.schema.json rather than reinventing its own checkout-cost, topology, or credential-posture disclosure rules. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-entry shape.",
  "type": "object",
  "required": [
    "repository_bootstrap_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "semantic_roles",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "rewrites_clone_into_open_when_local_checkout_already_exists",
    "runs_repo_owned_actions_implicitly_during_acquisition",
    "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches",
    "strands_partial_acquisition_without_resume_discard_or_readonly_choices",
    "hides_bootstrap_credential_posture_behind_generic_connected_state_copy"
  ],
  "properties": {
    "repository_bootstrap_family": {
      "$ref": "#/$defs/repository_bootstrap_family"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "source_locator",
          "checkout_plan",
          "credential_posture",
          "evidence_packet",
          "staged_trust",
          "resumable_acquisition",
          "post_open_queue"
        ]
      }
    },
    "open_local_roles": {
      "type": "array"
    },
    "clone_remote_roles": {
      "type": "array"
    },
    "open_archive_roles": {
      "type": "array"
    },
    "import_bundle_roles": {
      "type": "array"
    },
    "resume_snapshot_roles": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "rewrites_clone_into_open_when_local_checkout_already_exists": {
      "const": false
    },
    "runs_repo_owned_actions_implicitly_during_acquisition": {
      "const": false
    },
    "loses_signer_or_mirror_provenance_across_offline_or_mirrored_fetches": {
      "const": false
    },
    "strands_partial_acquisition_without_resume_discard_or_readonly_choices": {
      "const": false
    },
    "hides_bootstrap_credential_posture_behind_generic_connected_state_copy": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "repository_bootstrap_family": {
      "enum": [
        "clone_remote"
      ]
    }
  }
}
