{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspaces/m5-repository-bootstrap-accessibility-parity.schema.json",
  "title": "Aureline M5 repository-bootstrap accessibility & auto-narrowing parity",
  "description": "Export-safe packet for the M05-1194 keyboard / screen-reader / high-zoom / high-contrast / localization / CLI / export parity and honest auto-narrowing capstone over the frozen M5 repository-bootstrap matrix. Each row certifies one of the five governed project-entry acquisition families (open-local, clone-remote, open-archive, import-bundle, resume-snapshot) as keyboard-reachable, screen-reader-announced, high-zoom-legible, high-contrast-safe, localization-safe, CLI/export-safe, and self-narrowing. When an open-archive family's checkout / extraction-plan proof can only be partially disclosed, an import-bundle staged-trust fence cannot be confirmed, or a resume-snapshot family's bootstrap / mirror-signer evidence has aged out or is policy-blocked, the family's claim auto-narrows from trusted_acquisition_surface / reviewable_acquisition_surface to a checkout-plan-disclosed / trust-stage-unverified / bootstrap-evidence-unverified projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical repository-bootstrap identity / last-known registry reference. Repository-bootstrap meaning is never conveyed by an entry-chrome-only affordance, a mislabeled screenshot, or an unlabeled control alone. The packet is metadata-only: raw secret blobs, machine-specific sensitive paths, plaintext payloads, and endpoint refs never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_repository_bootstrap_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 5
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "repository_bootstrap_family": {
      "type": "string",
      "enum": [
        "open_local",
        "clone_remote",
        "open_archive",
        "import_bundle",
        "resume_snapshot"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "repository_bootstrap_claim": {
      "type": "string",
      "enum": [
        "trusted_acquisition_surface",
        "reviewable_acquisition_surface",
        "checkout_plan_disclosed_projection",
        "trust_stage_unverified_projection",
        "bootstrap_evidence_unverified_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "source_locator_clarity",
        "credential_posture_clarity",
        "checkout_plan_clarity",
        "trust_stage_fence_clarity",
        "bootstrap_evidence_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "fully_qualified",
        "checkout_plan_disclosed_partial",
        "trust_stage_unconfirmed",
        "bootstrap_evidence_unconfirmed"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "rewrote_clone_into_open_when_local_checkout_already_exists",
        "ran_repo_owned_actions_implicitly_during_acquisition",
        "lost_signer_or_mirror_provenance_across_offline_or_mirrored_fetches",
        "stranded_partial_acquisition_without_resume_discard_or_readonly_choices",
        "hid_bootstrap_credential_posture_behind_generic_connected_state_copy",
        "checkout_plan_boundary_drifted_by_surface",
        "source_locator_unstated",
        "checkout_plan_unstated",
        "credential_posture_unstated",
        "registry_reference_unstated",
        "staged_trust_rule_unstated",
        "proof_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "semantic_role",
        "registry_reference",
        "source_locator",
        "checkout_plan",
        "credential_posture"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "acquisition_engine",
        "shell_ui",
        "workspace_service",
        "git_service",
        "trust_service",
        "diagnostics",
        "docs_help",
        "cli_export",
        "support_export"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_truth_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/repository_bootstrap_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_truth_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "repository_bootstrap_family",
        "source_family_schema_ref",
        "repository_bootstrap_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "high_zoom_reach",
        "high_contrast_reach",
        "localization_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_ready_claim",
        "claim_conditions",
        "truth_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_repository_bootstrap_accessibility_parity_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "repository_bootstrap_family": { "$ref": "#/$defs/repository_bootstrap_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "repository_bootstrap_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_zoom_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_contrast_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "localization_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_ready_claim": { "$ref": "#/$defs/repository_bootstrap_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "truth_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "structure_heavy_family_count",
        "all_structure_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_trusted_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_truth_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "structure_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_structure_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_trusted_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_truth_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
