{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/m5-versioned-boundary-manifests.schema.json",
  "title": "Aureline versioned, per-family boundary-manifest register",
  "description": "Canonical, machine-readable register that publishes, per claimed M5 family and per manifest version, which capabilities stay open/local, which may be productized, the guardrails preserving the claim, the residual proprietary/hosted dependencies the family still rests on, and the release train each manifest is linked to. A manifest is published only when its release link is present and fresh, its declared label is in parity with the train evidence, every residual dependency is disclosed, every guardrail holds, the proof is fresh, and the owner signed. Otherwise it narrows on the specific axis that thins out (a release-link gap, a parity break, an undisclosed dependency, an unsatisfied guardrail, or stale proof) and drops its effective label below the launch cutline; an inherited or waived narrowing is gated upstream while a manifest-layer failure on a still-stable family holds publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "source_contract_refs",
    "manifest_cutline",
    "families",
    "asset_lanes",
    "boundary_postures",
    "support_classes",
    "lane_dispositions",
    "guardrail_kinds",
    "dependency_classes",
    "manifest_states",
    "manifest_reasons",
    "manifest_actions",
    "rules",
    "manifests",
    "release_link_parity",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_versioned_boundary_manifest_register" },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
    "manifest_cutline": { "$ref": "#/$defs/manifest_cutline" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" },
      "minItems": 1,
      "uniqueItems": true
    },
    "asset_lanes": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset_lane" },
      "minItems": 1,
      "uniqueItems": true
    },
    "boundary_postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary_posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/support_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "lane_dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/lane_disposition" },
      "minItems": 1,
      "uniqueItems": true
    },
    "guardrail_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/guardrail_kind" },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependency_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "manifest_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifest_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "manifest_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifest_reason" },
      "minItems": 1,
      "uniqueItems": true
    },
    "manifest_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifest_action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 1
    },
    "manifests": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifest" },
      "minItems": 1
    },
    "release_link_parity": { "$ref": "#/$defs/release_link_parity" },
    "publication": { "$ref": "#/$defs/publication" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "nullable_date": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
    },
    "nullable_string": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_rich",
        "ai_adjacent",
        "framework",
        "review",
        "companion",
        "managed_depth"
      ]
    },
    "asset_lane": {
      "type": "string",
      "enum": [
        "core_desktop_client_platform",
        "sdk_schema_contract",
        "docs_migration_pack",
        "marketplace_protocol",
        "managed_service",
        "restricted_brand_asset"
      ]
    },
    "boundary_posture": {
      "type": "string",
      "enum": [
        "open_local_core",
        "open_local_with_managed_optional",
        "source_available_restricted",
        "managed_service",
        "restricted_brand"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["open_local", "mixed_open_managed", "managed", "restricted"]
    },
    "lane_disposition": {
      "type": "string",
      "enum": [
        "open_local_retained",
        "productizable_add_on",
        "managed_only",
        "restricted_asset"
      ]
    },
    "guardrail_kind": {
      "type": "string",
      "enum": [
        "local_core_remains_useful",
        "no_silent_local_redefinition",
        "asset_lane_detail_published",
        "residual_dependency_disclosed",
        "release_link_published"
      ]
    },
    "guardrail_state": {
      "type": "string",
      "enum": ["satisfied", "unsatisfied", "not_applicable"]
    },
    "dependency_class": {
      "type": "string",
      "enum": [
        "proprietary_component",
        "hosted_service",
        "managed_model_provider",
        "trademark_brand_asset"
      ]
    },
    "release_link_state": {
      "type": "string",
      "enum": ["linked", "missing", "stale", "parity_broken"]
    },
    "freshness_slo_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "manifest_state": {
      "type": "string",
      "enum": [
        "published",
        "narrowed_release_link",
        "narrowed_parity",
        "narrowed_disclosure",
        "narrowed_guardrail",
        "narrowed_stale",
        "withdrawn"
      ]
    },
    "manifest_reason": {
      "type": "string",
      "enum": [
        "release_link_missing",
        "release_link_stale",
        "release_parity_broken",
        "undisclosed_residual_dependency",
        "guardrail_unsatisfied",
        "manifest_proof_stale",
        "manifest_proof_missing",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "manifest_action": {
      "type": "string",
      "enum": [
        "hold_publication",
        "link_release_evidence",
        "refresh_release_link",
        "realign_claim_to_release_evidence",
        "disclose_residual_dependency",
        "satisfy_guardrail",
        "refresh_manifest_proof",
        "request_owner_signoff"
      ]
    },
    "publication_decision": {
      "type": "string",
      "enum": ["proceed", "hold"]
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durability_matrix_ref",
        "open_paid_boundary_audit_ref",
        "m5_evidence_index_ref",
        "claim_manifest_ref",
        "release_train_index_ref",
        "support_export_ref"
      ],
      "properties": {
        "durability_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "open_paid_boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "m5_evidence_index_ref": { "$ref": "#/$defs/non_empty_string" },
        "claim_manifest_ref": { "$ref": "#/$defs/non_empty_string" },
        "release_train_index_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "manifest_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "type": "string", "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_publication",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/manifest_reason" },
        "applies_to_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" },
          "minItems": 1
        },
        "default_action": { "$ref": "#/$defs/manifest_action" },
        "blocks_publication": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/nullable_date" },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_slo_state" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" }
      }
    },
    "release_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_id",
        "train_ref",
        "train_label",
        "evidence_index_ref",
        "link_state",
        "slo_state",
        "linked_at"
      ],
      "properties": {
        "train_id": { "$ref": "#/$defs/non_empty_string" },
        "train_ref": { "$ref": "#/$defs/non_empty_string" },
        "train_label": { "$ref": "#/$defs/lifecycle_label" },
        "evidence_index_ref": { "$ref": "#/$defs/non_empty_string" },
        "link_state": { "$ref": "#/$defs/release_link_state" },
        "slo_state": { "$ref": "#/$defs/freshness_slo_state" },
        "linked_at": { "$ref": "#/$defs/nullable_date" }
      }
    },
    "residual_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "dependency_ref",
        "dependency_class",
        "affected_lane",
        "summary",
        "disclosed",
        "disclosure_surface_refs",
        "replaceable",
        "replacement_plan_ref"
      ],
      "properties": {
        "dependency_id": { "$ref": "#/$defs/non_empty_string" },
        "dependency_ref": { "$ref": "#/$defs/non_empty_string" },
        "dependency_class": { "$ref": "#/$defs/dependency_class" },
        "affected_lane": { "$ref": "#/$defs/asset_lane" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "disclosed": { "type": "boolean" },
        "disclosure_surface_refs": { "$ref": "#/$defs/ref_array" },
        "replaceable": { "type": "boolean" },
        "replacement_plan_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "guardrail_ref", "owner_ref", "state", "description"],
      "properties": {
        "kind": { "$ref": "#/$defs/guardrail_kind" },
        "guardrail_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/guardrail_state" },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "lane_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_lane",
        "disposition",
        "boundary_posture",
        "support_class",
        "must_remain_open",
        "capability_summary",
        "durability_row_ref"
      ],
      "properties": {
        "asset_lane": { "$ref": "#/$defs/asset_lane" },
        "disposition": { "$ref": "#/$defs/lane_disposition" },
        "boundary_posture": { "$ref": "#/$defs/boundary_posture" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "must_remain_open": { "type": "boolean" },
        "capability_summary": { "$ref": "#/$defs/non_empty_string" },
        "durability_row_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["waiver_ref", "expires_at", "reason"],
          "properties": {
            "waiver_ref": { "$ref": "#/$defs/non_empty_string" },
            "expires_at": { "type": "string", "format": "date" },
            "reason": { "$ref": "#/$defs/non_empty_string" }
          }
        }
      ]
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "signed_off": { "type": "boolean" },
        "signed_at": { "$ref": "#/$defs/nullable_date" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "family",
        "title",
        "manifest_version",
        "prior_version",
        "as_of",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "declared_label",
        "support_class",
        "release_link",
        "lane_entries",
        "guardrails",
        "residual_dependencies",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "manifest_state",
        "active_reasons",
        "effective_label",
        "surfaces",
        "rationale"
      ],
      "properties": {
        "manifest_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "manifest_version": { "$ref": "#/$defs/non_empty_string" },
        "prior_version": { "$ref": "#/$defs/nullable_string" },
        "as_of": { "type": "string", "format": "date" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" },
        "declared_label": { "$ref": "#/$defs/lifecycle_label" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "release_link": { "$ref": "#/$defs/release_link" },
        "lane_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/lane_entry" },
          "minItems": 1
        },
        "guardrails": {
          "type": "array",
          "items": { "$ref": "#/$defs/guardrail" },
          "minItems": 5
        },
        "residual_dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/residual_dependency" }
        },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "manifest_state": { "$ref": "#/$defs/manifest_state" },
        "active_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifest_reason" },
          "uniqueItems": true
        },
        "effective_label": { "$ref": "#/$defs/lifecycle_label" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "release_link_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parity_gate",
        "families_total",
        "families_in_parity",
        "families_link_broken",
        "families_parity_broken",
        "all_families_linked",
        "rationale"
      ],
      "properties": {
        "parity_gate": { "$ref": "#/$defs/non_empty_string" },
        "families_total": { "type": "integer", "minimum": 0 },
        "families_in_parity": { "type": "integer", "minimum": 0 },
        "families_link_broken": { "type": "integer", "minimum": 0 },
        "families_parity_broken": { "type": "integer", "minimum": 0 },
        "all_families_linked": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_manifest_ids",
        "rationale"
      ],
      "properties": {
        "publication_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/publication_decision" },
        "blocking_rule_ids": { "$ref": "#/$defs/ref_array" },
        "blocking_manifest_ids": { "$ref": "#/$defs/ref_array" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_manifests",
        "manifests_published",
        "manifests_narrowed",
        "state_published",
        "state_narrowed_release_link",
        "state_narrowed_parity",
        "state_narrowed_disclosure",
        "state_narrowed_guardrail",
        "state_narrowed_stale",
        "state_withdrawn",
        "release_blocking_total",
        "release_blocking_narrowed",
        "manifests_on_active_waiver",
        "total_residual_dependencies",
        "residual_dependencies_disclosed",
        "residual_dependencies_undisclosed",
        "total_guardrails",
        "guardrails_unsatisfied",
        "manifests_linked",
        "total_active_reasons",
        "rules_firing"
      ],
      "properties": {
        "total_manifests": { "type": "integer", "minimum": 0 },
        "manifests_published": { "type": "integer", "minimum": 0 },
        "manifests_narrowed": { "type": "integer", "minimum": 0 },
        "state_published": { "type": "integer", "minimum": 0 },
        "state_narrowed_release_link": { "type": "integer", "minimum": 0 },
        "state_narrowed_parity": { "type": "integer", "minimum": 0 },
        "state_narrowed_disclosure": { "type": "integer", "minimum": 0 },
        "state_narrowed_guardrail": { "type": "integer", "minimum": 0 },
        "state_narrowed_stale": { "type": "integer", "minimum": 0 },
        "state_withdrawn": { "type": "integer", "minimum": 0 },
        "release_blocking_total": { "type": "integer", "minimum": 0 },
        "release_blocking_narrowed": { "type": "integer", "minimum": 0 },
        "manifests_on_active_waiver": { "type": "integer", "minimum": 0 },
        "total_residual_dependencies": { "type": "integer", "minimum": 0 },
        "residual_dependencies_disclosed": { "type": "integer", "minimum": 0 },
        "residual_dependencies_undisclosed": { "type": "integer", "minimum": 0 },
        "total_guardrails": { "type": "integer", "minimum": 0 },
        "guardrails_unsatisfied": { "type": "integer", "minimum": 0 },
        "manifests_linked": { "type": "integer", "minimum": 0 },
        "total_active_reasons": { "type": "integer", "minimum": 0 },
        "rules_firing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
