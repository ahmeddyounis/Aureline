{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/m5-compliance-and-notice-binding.schema.json",
  "title": "Aureline repository-compliance and notice-binding register",
  "description": "Canonical, machine-readable register that publishes, per claimed M5 artifact family, docs pack, and mirrored output, the DCO/CLA contribution-provenance lane truth, the REUSE/SPDX file-level licensing coverage, the third-party notice-inventory state, and the SBOM/notice binding, holding the repository-compliance scan in parity with the user/admin notice/SBOM surface. A record is cleared only when provenance holds, licensing coverage is complete, the notice inventory is complete, the SBOM is present and bound, the mirror is fresh, the proof is fresh, and the owner signed. Otherwise it narrows on the specific axis that thins out (a provenance gap, a licensing gap, a notice gap, an SBOM/binding gap, a stale mirror, or stale proof) and drops its effective label below the launch cutline; a missing or partial notice is a first-class state that can never disappear behind a green SBOM badge. An inherited or waived narrowing is gated upstream while a compliance-layer failure on a still-stable subject holds promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "source_contract_refs",
    "compliance_cutline",
    "families",
    "scope_kinds",
    "support_classes",
    "control_dimensions",
    "dco_states",
    "cla_states",
    "notice_states",
    "sbom_binding_states",
    "sbom_formats",
    "postures",
    "compliance_states",
    "compliance_reasons",
    "compliance_actions",
    "rules",
    "records",
    "scan_surface_parity",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_compliance_and_notice_binding_register" },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
    "compliance_cutline": { "$ref": "#/$defs/compliance_cutline" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" },
      "minItems": 1,
      "uniqueItems": true
    },
    "scope_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/scope_kind" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/support_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "control_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_dimension" },
      "minItems": 1,
      "uniqueItems": true
    },
    "dco_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/dco_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "cla_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/cla_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "notice_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/notice_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "sbom_binding_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/sbom_binding_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "sbom_formats": {
      "type": "array",
      "items": { "$ref": "#/$defs/sbom_format" },
      "minItems": 1,
      "uniqueItems": true
    },
    "postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "compliance_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/compliance_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "compliance_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/compliance_reason" },
      "minItems": 1,
      "uniqueItems": true
    },
    "compliance_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/compliance_action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" },
      "minItems": 1
    },
    "scan_surface_parity": { "$ref": "#/$defs/scan_surface_parity" },
    "publication": { "$ref": "#/$defs/publication" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "nullable_date": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_rich",
        "ai_adjacent",
        "framework",
        "review",
        "companion",
        "managed_depth"
      ]
    },
    "scope_kind": {
      "type": "string",
      "enum": ["artifact_family", "docs_pack", "mirrored_output"]
    },
    "support_class": {
      "type": "string",
      "enum": ["open_local", "mixed_open_managed", "managed", "restricted"]
    },
    "control_dimension": {
      "type": "string",
      "enum": [
        "contribution_provenance",
        "file_level_licensing",
        "notice_inventory",
        "sbom_notice_binding",
        "mirror_freshness",
        "scan_surface_parity"
      ]
    },
    "control_state": {
      "type": "string",
      "enum": ["satisfied", "unsatisfied", "not_applicable"]
    },
    "dco_state": {
      "type": "string",
      "enum": ["all_signed", "gaps_present", "not_required"]
    },
    "cla_state": {
      "type": "string",
      "enum": ["on_file", "unresolved", "not_required"]
    },
    "notice_state": {
      "type": "string",
      "enum": ["complete", "partial", "missing", "not_required"]
    },
    "sbom_binding_state": {
      "type": "string",
      "enum": ["bound", "unbound", "not_applicable"]
    },
    "sbom_format": {
      "type": "string",
      "enum": ["spdx_primary", "cyclonedx_export"]
    },
    "posture": {
      "type": "string",
      "enum": ["clear", "gaps_found"]
    },
    "freshness_slo_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "compliance_state": {
      "type": "string",
      "enum": [
        "cleared",
        "narrowed_provenance",
        "narrowed_licensing",
        "narrowed_notice",
        "narrowed_sbom",
        "narrowed_mirror",
        "narrowed_stale",
        "withdrawn"
      ]
    },
    "compliance_reason": {
      "type": "string",
      "enum": [
        "dco_signoff_missing",
        "cla_unresolved",
        "licensing_coverage_incomplete",
        "license_exception_undocumented",
        "notice_inventory_partial",
        "notice_inventory_missing",
        "sbom_primary_missing",
        "sbom_notice_binding_broken",
        "cyclonedx_export_unavailable",
        "mirror_stale",
        "compliance_proof_stale",
        "compliance_proof_missing",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "compliance_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "collect_dco_signoff",
        "resolve_cla",
        "complete_licensing_coverage",
        "document_license_exception",
        "complete_notice_inventory",
        "generate_spdx_sbom",
        "rebind_sbom_notices",
        "enable_cyclonedx_export",
        "refresh_mirror",
        "refresh_compliance_proof",
        "request_owner_signoff"
      ]
    },
    "publication_decision": {
      "type": "string",
      "enum": ["proceed", "hold"]
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contribution_governance_ref",
        "reuse_spdx_report_ref",
        "notice_inventory_ref",
        "sbom_index_ref",
        "mirror_index_ref",
        "durability_matrix_ref",
        "m5_evidence_index_ref"
      ],
      "properties": {
        "contribution_governance_ref": { "$ref": "#/$defs/non_empty_string" },
        "reuse_spdx_report_ref": { "$ref": "#/$defs/non_empty_string" },
        "notice_inventory_ref": { "$ref": "#/$defs/non_empty_string" },
        "sbom_index_ref": { "$ref": "#/$defs/non_empty_string" },
        "mirror_index_ref": { "$ref": "#/$defs/non_empty_string" },
        "durability_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "m5_evidence_index_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "compliance_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "type": "string", "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/compliance_reason" },
        "applies_to_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" },
          "minItems": 1
        },
        "default_action": { "$ref": "#/$defs/compliance_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/nullable_date" },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_slo_state" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" }
      }
    },
    "contribution_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dco_state",
        "cla_state",
        "unsigned_commit_count",
        "dco_audit_ref",
        "cla_register_ref"
      ],
      "properties": {
        "dco_state": { "$ref": "#/$defs/dco_state" },
        "cla_state": { "$ref": "#/$defs/cla_state" },
        "unsigned_commit_count": { "type": "integer", "minimum": 0 },
        "dco_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "cla_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "licensing_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_total",
        "files_spdx_covered",
        "documented_exceptions",
        "undocumented_exceptions",
        "reuse_report_ref"
      ],
      "properties": {
        "files_total": { "type": "integer", "minimum": 0 },
        "files_spdx_covered": { "type": "integer", "minimum": 0 },
        "documented_exceptions": { "type": "integer", "minimum": 0 },
        "undocumented_exceptions": { "type": "integer", "minimum": 0 },
        "reuse_report_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "notice_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice_state", "entries_total", "entries_present", "notice_inventory_ref"],
      "properties": {
        "notice_state": { "$ref": "#/$defs/notice_state" },
        "entries_total": { "type": "integer", "minimum": 0 },
        "entries_present": { "type": "integer", "minimum": 0 },
        "notice_inventory_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "sbom_notice_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_primary_present",
        "cyclonedx_export_available",
        "binding_state",
        "formats",
        "sbom_ref",
        "notice_binding_ref"
      ],
      "properties": {
        "spdx_primary_present": { "type": "boolean" },
        "cyclonedx_export_available": { "type": "boolean" },
        "binding_state": { "$ref": "#/$defs/sbom_binding_state" },
        "formats": {
          "type": "array",
          "items": { "$ref": "#/$defs/sbom_format" },
          "uniqueItems": true
        },
        "sbom_ref": { "$ref": "#/$defs/non_empty_string" },
        "notice_binding_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "mirror_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirror_required", "mirror_freshness", "mirror_ref"],
      "properties": {
        "mirror_required": { "type": "boolean" },
        "mirror_freshness": { "$ref": "#/$defs/freshness_slo_state" },
        "mirror_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "control_ref", "owner_ref", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/control_dimension" },
        "control_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/control_state" }
      }
    },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["waiver_ref", "expires_at", "reason"],
          "properties": {
            "waiver_ref": { "$ref": "#/$defs/non_empty_string" },
            "expires_at": { "type": "string", "format": "date" },
            "reason": { "$ref": "#/$defs/non_empty_string" }
          }
        }
      ]
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "signed_off": { "type": "boolean" },
        "signed_at": { "$ref": "#/$defs/nullable_date" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "family",
        "scope_kind",
        "title",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "declared_label",
        "support_class",
        "provenance",
        "licensing",
        "notices",
        "sbom",
        "mirror",
        "controls",
        "scan_posture",
        "surface_posture",
        "scan_ref",
        "surface_ref",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "compliance_state",
        "active_reasons",
        "effective_label",
        "surfaces",
        "rationale"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "scope_kind": { "$ref": "#/$defs/scope_kind" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" },
        "declared_label": { "$ref": "#/$defs/lifecycle_label" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "provenance": { "$ref": "#/$defs/contribution_provenance" },
        "licensing": { "$ref": "#/$defs/licensing_coverage" },
        "notices": { "$ref": "#/$defs/notice_inventory" },
        "sbom": { "$ref": "#/$defs/sbom_notice_binding" },
        "mirror": { "$ref": "#/$defs/mirror_binding" },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" },
          "minItems": 6
        },
        "scan_posture": { "$ref": "#/$defs/posture" },
        "surface_posture": { "$ref": "#/$defs/posture" },
        "scan_ref": { "$ref": "#/$defs/non_empty_string" },
        "surface_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "compliance_state": { "$ref": "#/$defs/compliance_state" },
        "active_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/compliance_reason" },
          "uniqueItems": true
        },
        "effective_label": { "$ref": "#/$defs/lifecycle_label" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "scan_surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parity_gate",
        "subjects_total",
        "subjects_in_agreement",
        "subjects_in_disagreement",
        "subjects_with_gaps",
        "all_subjects_agree",
        "rationale"
      ],
      "properties": {
        "parity_gate": { "$ref": "#/$defs/non_empty_string" },
        "subjects_total": { "type": "integer", "minimum": 0 },
        "subjects_in_agreement": { "type": "integer", "minimum": 0 },
        "subjects_in_disagreement": { "type": "integer", "minimum": 0 },
        "subjects_with_gaps": { "type": "integer", "minimum": 0 },
        "all_subjects_agree": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_record_ids",
        "rationale"
      ],
      "properties": {
        "publication_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/publication_decision" },
        "blocking_rule_ids": { "$ref": "#/$defs/ref_array" },
        "blocking_record_ids": { "$ref": "#/$defs/ref_array" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_records",
        "records_cleared",
        "records_narrowed",
        "state_cleared",
        "state_narrowed_provenance",
        "state_narrowed_licensing",
        "state_narrowed_notice",
        "state_narrowed_sbom",
        "state_narrowed_mirror",
        "state_narrowed_stale",
        "state_withdrawn",
        "release_blocking_total",
        "release_blocking_narrowed",
        "records_on_active_waiver",
        "provenance_gaps",
        "licensing_gaps",
        "notice_gaps",
        "sbom_gaps",
        "mirror_gaps",
        "spdx_primary_present",
        "cyclonedx_export_available",
        "notices_complete",
        "total_active_reasons",
        "rules_firing"
      ],
      "properties": {
        "total_records": { "type": "integer", "minimum": 0 },
        "records_cleared": { "type": "integer", "minimum": 0 },
        "records_narrowed": { "type": "integer", "minimum": 0 },
        "state_cleared": { "type": "integer", "minimum": 0 },
        "state_narrowed_provenance": { "type": "integer", "minimum": 0 },
        "state_narrowed_licensing": { "type": "integer", "minimum": 0 },
        "state_narrowed_notice": { "type": "integer", "minimum": 0 },
        "state_narrowed_sbom": { "type": "integer", "minimum": 0 },
        "state_narrowed_mirror": { "type": "integer", "minimum": 0 },
        "state_narrowed_stale": { "type": "integer", "minimum": 0 },
        "state_withdrawn": { "type": "integer", "minimum": 0 },
        "release_blocking_total": { "type": "integer", "minimum": 0 },
        "release_blocking_narrowed": { "type": "integer", "minimum": 0 },
        "records_on_active_waiver": { "type": "integer", "minimum": 0 },
        "provenance_gaps": { "type": "integer", "minimum": 0 },
        "licensing_gaps": { "type": "integer", "minimum": 0 },
        "notice_gaps": { "type": "integer", "minimum": 0 },
        "sbom_gaps": { "type": "integer", "minimum": 0 },
        "mirror_gaps": { "type": "integer", "minimum": 0 },
        "spdx_primary_present": { "type": "integer", "minimum": 0 },
        "cyclonedx_export_available": { "type": "integer", "minimum": 0 },
        "notices_complete": { "type": "integer", "minimum": 0 },
        "total_active_reasons": { "type": "integer", "minimum": 0 },
        "rules_firing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
