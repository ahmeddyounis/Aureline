{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/m5-release-authority-continuity.schema.json",
  "title": "Aureline release-authority continuity register",
  "description": "Canonical, machine-readable register that publishes, per protected M5 authority lane (release signing, promotion approval, registry moderation, and security response), the named primary and backup owners, the signer/approval/operator/responder roster and its quorum, the split-authority requirement, the backup-runbook coverage, and the shiproom escalation required for critical or single-owner lanes, holding the continuity scan in parity with the governance-dashboard/promotion-packet surface. A record is cleared only when the lane has a named primary and backup owner, its roster meets quorum, the runbook is current (or only due for review), split authority is enforced where required, any required shiproom escalation is raised, the proof is fresh, and the owner signed. Otherwise it narrows on the specific axis that thins out (an owner gap, a backup/single-owner gap, a quorum gap, a runbook gap, an authority/escalation gap, or stale proof) and drops its effective label below the launch cutline; the axes never collapse into one global flag, and a green authority card can never mask a single-owner, under-quorum, or runbook-less lane. An inherited or waived narrowing is gated upstream while a continuity failure on a still-stable subject holds promotion — a single-owner, under-quorum, or runbook-less protected lane may not widen a stable claim without coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "source_contract_refs",
    "continuity_cutline",
    "families",
    "authority_lanes",
    "support_classes",
    "criticalities",
    "control_dimensions",
    "roster_kinds",
    "owner_states",
    "backup_states",
    "quorum_states",
    "split_authority_states",
    "runbook_states",
    "escalation_states",
    "postures",
    "continuity_states",
    "continuity_reasons",
    "continuity_actions",
    "rules",
    "records",
    "scan_surface_parity",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_release_authority_continuity_register"
    },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
    "continuity_cutline": { "$ref": "#/$defs/continuity_cutline" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" },
      "minItems": 1,
      "uniqueItems": true
    },
    "authority_lanes": {
      "type": "array",
      "items": { "$ref": "#/$defs/authority_lane" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/support_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "criticalities": {
      "type": "array",
      "items": { "$ref": "#/$defs/criticality" },
      "minItems": 1,
      "uniqueItems": true
    },
    "control_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_dimension" },
      "minItems": 1,
      "uniqueItems": true
    },
    "roster_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/roster_kind" },
      "minItems": 1,
      "uniqueItems": true
    },
    "owner_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/owner_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "backup_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/backup_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "quorum_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/quorum_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "split_authority_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/split_authority_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "runbook_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/runbook_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "escalation_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/escalation_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "continuity_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/continuity_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "continuity_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/continuity_reason" },
      "minItems": 1,
      "uniqueItems": true
    },
    "continuity_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/continuity_action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" },
      "minItems": 1
    },
    "scan_surface_parity": { "$ref": "#/$defs/scan_surface_parity" },
    "publication": { "$ref": "#/$defs/publication" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_rich",
        "ai_adjacent",
        "framework",
        "review",
        "companion",
        "managed_depth"
      ]
    },
    "authority_lane": {
      "type": "string",
      "enum": [
        "release_signing",
        "promotion_approval",
        "registry_moderation",
        "security_response"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["open_local", "mixed_open_managed", "managed", "restricted"]
    },
    "criticality": {
      "type": "string",
      "enum": ["routine", "elevated", "critical", "blocking"]
    },
    "control_dimension": {
      "type": "string",
      "enum": [
        "owner_coverage",
        "backup_coverage",
        "roster_quorum",
        "runbook_coverage",
        "authority_continuity",
        "scan_surface_parity"
      ]
    },
    "roster_kind": {
      "type": "string",
      "enum": [
        "signer_roster",
        "promotion_approvers",
        "moderation_operators",
        "security_responders"
      ]
    },
    "owner_state": { "type": "string", "enum": ["assigned", "vacant"] },
    "backup_state": { "type": "string", "enum": ["covered", "single_owner"] },
    "quorum_state": { "type": "string", "enum": ["met", "below_threshold"] },
    "split_authority_state": {
      "type": "string",
      "enum": ["satisfied", "unmet", "not_required"]
    },
    "runbook_state": {
      "type": "string",
      "enum": ["current", "due_for_review", "stale", "missing"]
    },
    "escalation_state": {
      "type": "string",
      "enum": ["raised", "pending", "not_required"]
    },
    "posture": { "type": "string", "enum": ["clear", "gaps_found"] },
    "control_state": {
      "type": "string",
      "enum": ["satisfied", "unsatisfied", "not_applicable"]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "continuity_state": {
      "type": "string",
      "enum": [
        "cleared",
        "narrowed_owner",
        "narrowed_backup",
        "narrowed_quorum",
        "narrowed_runbook",
        "narrowed_authority",
        "narrowed_stale",
        "withdrawn"
      ]
    },
    "continuity_reason": {
      "type": "string",
      "enum": [
        "primary_owner_vacant",
        "backup_owner_missing",
        "roster_quorum_below_threshold",
        "runbook_stale",
        "runbook_missing",
        "split_authority_unmet",
        "shiproom_escalation_missing",
        "continuity_proof_stale",
        "continuity_proof_missing",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "continuity_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "assign_primary_owner",
        "assign_backup_owner",
        "staff_roster_to_quorum",
        "refresh_continuity_runbook",
        "enforce_split_authority",
        "raise_shiproom_escalation",
        "refresh_continuity_proof",
        "request_owner_signoff"
      ]
    },
    "publication_decision": { "type": "string", "enum": ["proceed", "hold"] },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 0 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": {
          "type": "string",
          "enum": ["current", "due_for_refresh", "breached", "missing"]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "type": "string", "format": "date" },
        "reason": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"] }
      }
    },
    "owner_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_state", "primary_owner_ref", "assignment_ref"],
      "properties": {
        "owner_state": { "$ref": "#/$defs/owner_state" },
        "primary_owner_ref": { "type": "string" },
        "assignment_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "backup_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_state", "backup_owner_count", "roster_ref"],
      "properties": {
        "backup_state": { "$ref": "#/$defs/backup_state" },
        "backup_owner_count": { "type": "integer", "minimum": 0 },
        "roster_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "roster_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roster_kind",
        "quorum_state",
        "required_quorum",
        "available_members",
        "roster_ref"
      ],
      "properties": {
        "roster_kind": { "$ref": "#/$defs/roster_kind" },
        "quorum_state": { "$ref": "#/$defs/quorum_state" },
        "required_quorum": { "type": "integer", "minimum": 0 },
        "available_members": { "type": "integer", "minimum": 0 },
        "roster_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "split_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split_state", "required", "distinct_authorities", "policy_ref"],
      "properties": {
        "split_state": { "$ref": "#/$defs/split_authority_state" },
        "required": { "type": "boolean" },
        "distinct_authorities": { "type": "integer", "minimum": 0 },
        "policy_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "runbook_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runbook_state", "review_interval_days", "next_review_due", "runbook_ref"],
      "properties": {
        "runbook_state": { "$ref": "#/$defs/runbook_state" },
        "review_interval_days": { "type": "integer", "minimum": 0 },
        "next_review_due": { "type": ["string", "null"] },
        "runbook_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "shiproom_escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escalation_state", "required", "shiproom_ref", "governance_ref"],
      "properties": {
        "escalation_state": { "$ref": "#/$defs/escalation_state" },
        "required": { "type": "boolean" },
        "shiproom_ref": { "$ref": "#/$defs/non_empty_string" },
        "governance_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "continuity_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "control_ref", "owner_ref", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/control_dimension" },
        "control_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/control_state" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer_roster_ref",
        "promotion_quorum_ref",
        "registry_moderation_ref",
        "security_response_ref",
        "runbook_register_ref",
        "durability_matrix_ref",
        "shiproom_register_ref",
        "m5_evidence_index_ref"
      ],
      "properties": {
        "signer_roster_ref": { "$ref": "#/$defs/non_empty_string" },
        "promotion_quorum_ref": { "$ref": "#/$defs/non_empty_string" },
        "registry_moderation_ref": { "$ref": "#/$defs/non_empty_string" },
        "security_response_ref": { "$ref": "#/$defs/non_empty_string" },
        "runbook_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "durability_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "shiproom_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "m5_evidence_index_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "continuity_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/continuity_reason" },
        "applies_to_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/continuity_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "family",
        "lane",
        "title",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "declared_label",
        "support_class",
        "criticality",
        "owner_coverage",
        "backup_coverage",
        "roster",
        "split_authority",
        "runbook",
        "escalation",
        "controls",
        "scan_posture",
        "surface_posture",
        "scan_ref",
        "surface_ref",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "continuity_state",
        "active_reasons",
        "effective_label",
        "surfaces",
        "rationale"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "lane": { "$ref": "#/$defs/authority_lane" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" },
        "declared_label": { "$ref": "#/$defs/lifecycle_label" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "criticality": { "$ref": "#/$defs/criticality" },
        "owner_coverage": { "$ref": "#/$defs/owner_coverage" },
        "backup_coverage": { "$ref": "#/$defs/backup_coverage" },
        "roster": { "$ref": "#/$defs/roster_profile" },
        "split_authority": { "$ref": "#/$defs/split_authority" },
        "runbook": { "$ref": "#/$defs/runbook_coverage" },
        "escalation": { "$ref": "#/$defs/shiproom_escalation" },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/continuity_control" },
          "minItems": 6
        },
        "scan_posture": { "$ref": "#/$defs/posture" },
        "surface_posture": { "$ref": "#/$defs/posture" },
        "scan_ref": { "$ref": "#/$defs/non_empty_string" },
        "surface_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": {
          "oneOf": [{ "$ref": "#/$defs/waiver" }, { "type": "null" }]
        },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "continuity_state": { "$ref": "#/$defs/continuity_state" },
        "active_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/continuity_reason" }
        },
        "effective_label": { "$ref": "#/$defs/lifecycle_label" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "scan_surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parity_gate",
        "subjects_total",
        "subjects_in_agreement",
        "subjects_in_disagreement",
        "subjects_with_gaps",
        "all_subjects_agree",
        "rationale"
      ],
      "properties": {
        "parity_gate": { "$ref": "#/$defs/non_empty_string" },
        "subjects_total": { "type": "integer", "minimum": 0 },
        "subjects_in_agreement": { "type": "integer", "minimum": 0 },
        "subjects_in_disagreement": { "type": "integer", "minimum": 0 },
        "subjects_with_gaps": { "type": "integer", "minimum": 0 },
        "all_subjects_agree": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_record_ids",
        "rationale"
      ],
      "properties": {
        "publication_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/publication_decision" },
        "blocking_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "blocking_record_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_records",
        "records_cleared",
        "records_narrowed",
        "state_cleared",
        "state_narrowed_owner",
        "state_narrowed_backup",
        "state_narrowed_quorum",
        "state_narrowed_runbook",
        "state_narrowed_authority",
        "state_narrowed_stale",
        "state_withdrawn",
        "release_blocking_total",
        "release_blocking_narrowed",
        "records_on_active_waiver",
        "owner_gaps",
        "backup_gaps",
        "quorum_gaps",
        "runbook_gaps",
        "authority_gaps",
        "critical_total",
        "single_owner_total",
        "escalations_required",
        "escalations_raised",
        "split_authority_enforced",
        "total_active_reasons",
        "rules_firing"
      ],
      "properties": {
        "total_records": { "type": "integer", "minimum": 0 },
        "records_cleared": { "type": "integer", "minimum": 0 },
        "records_narrowed": { "type": "integer", "minimum": 0 },
        "state_cleared": { "type": "integer", "minimum": 0 },
        "state_narrowed_owner": { "type": "integer", "minimum": 0 },
        "state_narrowed_backup": { "type": "integer", "minimum": 0 },
        "state_narrowed_quorum": { "type": "integer", "minimum": 0 },
        "state_narrowed_runbook": { "type": "integer", "minimum": 0 },
        "state_narrowed_authority": { "type": "integer", "minimum": 0 },
        "state_narrowed_stale": { "type": "integer", "minimum": 0 },
        "state_withdrawn": { "type": "integer", "minimum": 0 },
        "release_blocking_total": { "type": "integer", "minimum": 0 },
        "release_blocking_narrowed": { "type": "integer", "minimum": 0 },
        "records_on_active_waiver": { "type": "integer", "minimum": 0 },
        "owner_gaps": { "type": "integer", "minimum": 0 },
        "backup_gaps": { "type": "integer", "minimum": 0 },
