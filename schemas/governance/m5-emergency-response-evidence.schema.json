{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/m5-emergency-response-evidence.schema.json",
  "title": "Aureline emergency-response evidence register",
  "description": "Canonical, machine-readable register that publishes, per protected M5 ecosystem/release lane and emergency packet (signed security advisory, extension/provider revocation, emergency-disable bundle, and high-severity postmortem), the packet-template binding, the hosted/mirror/offline distribution reach, the attribution, the reversibility, the audit trail (markers and post-incident reconciliation for break-glass or high-severity actions), and the release/support evidence linkage, holding the response scan in parity with the service-health/release-center/support surface. A record is cleared only when the packet template is bound, every claimed channel carries current evidence, the action is attributable, a reversible action has its reversal runbook, the audit trail is complete, the evidence is linked to release/support, the proof is fresh, and the owner signed. Otherwise it narrows on the specific axis that thins out (a template gap, a distribution-reach gap, an attribution gap, a reversibility gap, an audit gap, a linkage gap, or stale proof) and drops its effective label below the launch cutline; the axes never collapse into one global flag, and a green emergency-response card can never mask a mirror/offline customer that never received the evidence, an unattributable break-glass action, or a side-channel-only disable. An inherited or waived narrowing is gated upstream while a response failure on a still-stable subject holds promotion — a protected lane whose advisory/revocation/disable evidence did not reach a claimed mirror/offline customer, or whose break-glass action bypassed audit/reconciliation, may not widen a stable claim without coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "source_contract_refs",
    "response_cutline",
    "families",
    "packet_kinds",
    "support_classes",
    "severities",
    "control_dimensions",
    "distribution_channels",
    "channel_states",
    "template_states",
    "attribution_states",
    "reversibility_states",
    "reconciliation_states",
    "linkage_states",
    "postures",
    "response_states",
    "response_reasons",
    "response_actions",
    "rules",
    "records",
    "scan_surface_parity",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_emergency_response_evidence_register"
    },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
    "response_cutline": { "$ref": "#/$defs/response_cutline" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" },
      "minItems": 1,
      "uniqueItems": true
    },
    "packet_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/packet_kind" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/support_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "severities": {
      "type": "array",
      "items": { "$ref": "#/$defs/severity" },
      "minItems": 1,
      "uniqueItems": true
    },
    "control_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_dimension" },
      "minItems": 1,
      "uniqueItems": true
    },
    "distribution_channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/distribution_channel" },
      "minItems": 1,
      "uniqueItems": true
    },
    "channel_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/channel_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "template_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/template_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "attribution_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/attribution_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "reversibility_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/reversibility_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "reconciliation_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/reconciliation_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "linkage_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/linkage_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "response_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/response_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "response_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/response_reason" },
      "minItems": 1,
      "uniqueItems": true
    },
    "response_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/response_action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" },
      "minItems": 1
    },
    "scan_surface_parity": { "$ref": "#/$defs/scan_surface_parity" },
    "publication": { "$ref": "#/$defs/publication" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_rich",
        "ai_adjacent",
        "framework",
        "review",
        "companion",
        "managed_depth"
      ]
    },
    "packet_kind": {
      "type": "string",
      "enum": [
        "security_advisory",
        "extension_provider_revocation",
        "emergency_disable_bundle",
        "high_severity_postmortem"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["open_local", "mixed_open_managed", "managed", "restricted"]
    },
    "severity": {
      "type": "string",
      "enum": ["informational", "moderate", "high", "critical"]
    },
    "control_dimension": {
      "type": "string",
      "enum": [
        "packet_template",
        "distribution_reach",
        "attribution",
        "reversibility",
        "audit_trail",
        "evidence_linkage",
        "scan_surface_parity"
      ]
    },
    "distribution_channel": {
      "type": "string",
      "enum": ["hosted", "mirror", "offline"]
    },
    "channel_state": {
      "type": "string",
      "enum": ["propagated", "pending", "stale", "not_claimed"]
    },
    "template_state": { "type": "string", "enum": ["bound", "unbound"] },
    "attribution_state": {
      "type": "string",
      "enum": ["attributable", "unattributable"]
    },
    "reversibility_state": {
      "type": "string",
      "enum": ["reversible_with_runbook", "irreversible_by_policy", "reversal_rule_missing"]
    },
    "reconciliation_state": {
      "type": "string",
      "enum": ["reconciled", "pending", "not_required"]
    },
    "linkage_state": {
      "type": "string",
      "enum": ["linked", "side_channel_only"]
    },
    "posture": { "type": "string", "enum": ["clear", "gaps_found"] },
    "control_state": {
      "type": "string",
      "enum": ["satisfied", "unsatisfied", "not_applicable"]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "response_state": {
      "type": "string",
      "enum": [
        "cleared",
        "narrowed_template",
        "narrowed_distribution",
        "narrowed_attribution",
        "narrowed_reversibility",
        "narrowed_audit",
        "narrowed_linkage",
        "narrowed_stale",
        "withdrawn"
      ]
    },
    "response_reason": {
      "type": "string",
      "enum": [
        "packet_template_unbound",
        "mirror_propagation_incomplete",
        "offline_import_response_missing",
        "channel_evidence_stale",
        "action_unattributable",
        "reversal_rule_missing",
        "audit_markers_missing",
        "reconciliation_pending",
        "evidence_linkage_missing",
        "response_proof_stale",
        "response_proof_missing",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "response_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "bind_packet_template",
        "complete_mirror_propagation",
        "complete_offline_import_response",
        "refresh_channel_evidence",
        "record_attribution",
        "attach_reversal_rule",
        "attach_audit_markers",
        "complete_reconciliation",
        "link_release_and_support_evidence",
        "refresh_response_proof",
        "request_owner_signoff"
      ]
    },
    "publication_decision": { "type": "string", "enum": ["proceed", "hold"] },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 0 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": {
          "type": "string",
          "enum": ["current", "due_for_refresh", "breached", "missing"]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "type": "string", "format": "date" },
        "reason": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"] }
      }
    },
    "packet_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_state", "packet_kind", "signed", "template_ref", "digest_ref"],
      "properties": {
        "template_state": { "$ref": "#/$defs/template_state" },
        "packet_kind": { "$ref": "#/$defs/packet_kind" },
        "signed": { "type": "boolean" },
        "template_ref": { "$ref": "#/$defs/non_empty_string" },
        "digest_ref": { "type": "string" }
      }
    },
    "channel_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "claimed", "state", "evidence_ref"],
      "properties": {
        "channel": { "$ref": "#/$defs/distribution_channel" },
        "claimed": { "type": "boolean" },
        "state": { "$ref": "#/$defs/channel_state" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "distribution_reach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels"],
      "properties": {
        "channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/channel_evidence" },
          "minItems": 3
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribution_state", "actor_ref", "authorization_ref"],
      "properties": {
        "attribution_state": { "$ref": "#/$defs/attribution_state" },
        "actor_ref": { "type": "string" },
        "authorization_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reversibility_state", "policy_reversible", "reversal_runbook_ref"],
      "properties": {
        "reversibility_state": { "$ref": "#/$defs/reversibility_state" },
        "policy_reversible": { "type": "boolean" },
        "reversal_runbook_ref": { "type": "string" }
      }
    },
    "audit_trail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_markers_present",
        "audit_marker_ref",
        "reconciliation_state",
        "reconciliation_ref",
        "mutation_journal_ref"
      ],
      "properties": {
        "audit_markers_present": { "type": "boolean" },
        "audit_marker_ref": { "type": "string" },
        "reconciliation_state": { "$ref": "#/$defs/reconciliation_state" },
        "reconciliation_ref": { "type": "string" },
        "mutation_journal_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "evidence_linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkage_state",
        "release_artifact_ref",
        "support_export_ref",
        "bundle_digest_ref"
      ],
      "properties": {
        "linkage_state": { "$ref": "#/$defs/linkage_state" },
        "release_artifact_ref": { "type": "string" },
        "support_export_ref": { "type": "string" },
        "bundle_digest_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "response_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "control_ref", "owner_ref", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/control_dimension" },
        "control_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/control_state" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_template_ref",
        "revocation_register_ref",
        "disable_bundle_ref",
        "postmortem_register_ref",
        "mirror_propagation_ref",
        "offline_import_ref",
        "release_graph_ref",
        "support_export_ref",
        "audit_journal_ref",
        "continuity_register_ref",
        "shiproom_register_ref",
        "m5_evidence_index_ref"
      ],
      "properties": {
        "advisory_template_ref": { "$ref": "#/$defs/non_empty_string" },
        "revocation_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "disable_bundle_ref": { "$ref": "#/$defs/non_empty_string" },
        "postmortem_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "mirror_propagation_ref": { "$ref": "#/$defs/non_empty_string" },
        "offline_import_ref": { "$ref": "#/$defs/non_empty_string" },
        "release_graph_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_ref": { "$ref": "#/$defs/non_empty_string" },
        "audit_journal_ref": { "$ref": "#/$defs/non_empty_string" },
        "continuity_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "shiproom_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "m5_evidence_index_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "response_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/response_reason" },
        "applies_to_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/response_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "family",
        "packet_kind",
        "title",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "declared_label",
        "support_class",
        "severity",
        "is_break_glass",
        "packet_template",
        "distribution_reach",
        "attribution",
        "reversibility",
        "audit_trail",
        "evidence_linkage",
        "controls",
        "scan_posture",
        "surface_posture",
        "scan_ref",
        "surface_ref",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "continuity_state",
        "active_reasons",
        "effective_label",
        "surfaces",
        "rationale"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "packet_kind": { "$ref": "#/$defs/packet_kind" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" },
        "declared_label": { "$ref": "#/$defs/lifecycle_label" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "severity": { "$ref": "#/$defs/severity" },
        "is_break_glass": { "type": "boolean" },
        "packet_template": { "$ref": "#/$defs/packet_template" },
        "distribution_reach": { "$ref": "#/$defs/distribution_reach" },
        "attribution": { "$ref": "#/$defs/attribution" },
        "reversibility": { "$ref": "#/$defs/reversibility" },
        "audit_trail": { "$ref": "#/$defs/audit_trail" },
        "evidence_linkage": { "$ref": "#/$defs/evidence_linkage" },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/response_control" },
          "minItems": 7
        },
        "scan_posture": { "$ref": "#/$defs/posture" },
        "surface_posture": { "$ref": "#/$defs/posture" },
        "scan_ref": { "$ref": "#/$defs/non_empty_string" },
        "surface_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": {
          "oneOf": [{ "$ref": "#/$defs/waiver" }, { "type": "null" }]
        },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "continuity_state": { "$ref": "#/$defs/response_state" },
        "active_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/response_reason" }
        },
        "effective_label": { "$ref": "#/$defs/lifecycle_label" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "scan_surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parity_gate",
        "subjects_total",
        "subjects_in_agreement",
        "subjects_in_disagreement",
        "subjects_with_gaps",
        "all_subjects_agree",
        "rationale"
      ],
      "properties": {
        "parity_gate": { "$ref": "#/$defs/non_empty_string" },
        "subjects_total": { "type": "integer", "minimum": 0 },
        "subjects_in_agreement": { "type": "integer", "minimum": 0 },
        "subjects_in_disagreement": { "type": "integer", "minimum": 0 },
        "subjects_with_gaps": { "type": "integer", "minimum": 0 },
        "all_subjects_agree": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_record_ids",
        "rationale"
      ],
      "properties": {
        "publication_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/publication_decision" },
        "blocking_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "blocking_record_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_records",
        "records_cleared",
        "records_narrowed",
        "state_cleared",
        "state_narrowed_template",
        "state_narrowed_distribution",
        "state_narrowed_attribution",
        "state_narrowed_reversibility",
        "state_narrowed_audit",
        "state_narrowed_linkage",
        "state_narrowed_stale",
        "state_withdrawn",
        "release_blocking_total",
        "release_blocking_narrowed",
        "records_on_active_waiver",
        "template_gaps",
        "distribution_gaps",
        "attribution_gaps",
        "reversibility_gaps",
        "audit_gaps",
        "linkage_gaps",
        "mirror_reach_gaps",
        "offline_reach_gaps",
        "break_glass_total",
        "reconciliation_required",
        "reconciliation_complete",
        "total_active_reasons",
        "rules_firing"
      ],
