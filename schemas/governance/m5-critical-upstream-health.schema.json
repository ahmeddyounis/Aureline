{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/m5-critical-upstream-health.schema.json",
  "title": "Aureline critical-upstream health register",
  "description": "Canonical, machine-readable register that publishes, per critical upstream a protected M5 family depends on, the maintainer-health rating, the security posture, the update and review cadence, the license clarity, the replacement feasibility, the ownership, and the sponsor/fork/replace contingency and shiproom escalation required for red-risk or unowned upstreams, holding the upstream-health scan in parity with the governance-dashboard/promotion-packet surface. A record is cleared only when the maintainer base is healthy, the security posture is clean, the cadence has not stalled and the review is on cadence, the license is clear, the upstream is owned, any required contingency plan and shiproom escalation are recorded, the proof is fresh, and the owner signed. Otherwise it narrows on the specific axis that thins out (a maintainer gap, a security gap, a cadence gap, a license gap, an ownership/escalation gap, or stale proof) and drops its effective label below the launch cutline; the axes never collapse into one global flag, and a green upstream card can never mask an abandoned, unpatched, or unowned dependency. An inherited or waived narrowing is gated upstream while an upstream-health failure on a still-stable subject holds promotion — a red-risk or unowned protected-path dependency may not widen a stable claim without an approved sponsor, fork, or replacement plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "source_contract_refs",
    "health_cutline",
    "families",
    "upstream_kinds",
    "support_classes",
    "health_grades",
    "control_dimensions",
    "maintainer_ratings",
    "security_postures",
    "update_cadences",
    "review_cadence_states",
    "license_clarities",
    "replacement_feasibilities",
    "ownership_states",
    "contingency_states",
    "contingency_dispositions",
    "escalation_states",
    "postures",
    "health_states",
    "health_reasons",
    "health_actions",
    "rules",
    "records",
    "scan_surface_parity",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_critical_upstream_health_register"
    },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
    "health_cutline": { "$ref": "#/$defs/health_cutline" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" },
      "minItems": 1,
      "uniqueItems": true
    },
    "upstream_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/upstream_kind" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/support_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "health_grades": {
      "type": "array",
      "items": { "$ref": "#/$defs/health_grade" },
      "minItems": 1,
      "uniqueItems": true
    },
    "control_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_dimension" },
      "minItems": 1,
      "uniqueItems": true
    },
    "maintainer_ratings": {
      "type": "array",
      "items": { "$ref": "#/$defs/maintainer_rating" },
      "minItems": 1,
      "uniqueItems": true
    },
    "security_postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/security_posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "update_cadences": {
      "type": "array",
      "items": { "$ref": "#/$defs/update_cadence" },
      "minItems": 1,
      "uniqueItems": true
    },
    "review_cadence_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_cadence_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "license_clarities": {
      "type": "array",
      "items": { "$ref": "#/$defs/license_clarity" },
      "minItems": 1,
      "uniqueItems": true
    },
    "replacement_feasibilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/replacement_feasibility" },
      "minItems": 1,
      "uniqueItems": true
    },
    "ownership_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/ownership_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "contingency_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/contingency_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "contingency_dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/contingency_disposition" },
      "minItems": 1,
      "uniqueItems": true
    },
    "escalation_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/escalation_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "health_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/health_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "health_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/health_reason" },
      "minItems": 1,
      "uniqueItems": true
    },
    "health_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/health_action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" },
      "minItems": 1
    },
    "scan_surface_parity": { "$ref": "#/$defs/scan_surface_parity" },
    "publication": { "$ref": "#/$defs/publication" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "nullable_date": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_rich",
        "ai_adjacent",
        "framework",
        "review",
        "companion",
        "managed_depth"
      ]
    },
    "upstream_kind": {
      "type": "string",
      "enum": ["package", "protocol", "curated_import", "toolchain_component"]
    },
    "support_class": {
      "type": "string",
      "enum": ["open_local", "mixed_open_managed", "managed", "restricted"]
    },
    "health_grade": {
      "type": "string",
      "enum": ["green", "amber", "red", "blocked"]
    },
    "control_dimension": {
      "type": "string",
      "enum": [
        "maintainer_health",
        "security_posture",
        "update_cadence",
        "license_clarity",
        "ownership_continuity",
        "scan_surface_parity"
      ]
    },
    "control_state": {
      "type": "string",
      "enum": ["satisfied", "unsatisfied", "not_applicable"]
    },
    "maintainer_rating": {
      "type": "string",
      "enum": ["healthy", "thinning", "single_maintainer", "abandoned"]
    },
    "security_posture": {
      "type": "string",
      "enum": ["clean", "advisories_open", "unpatched_critical"]
    },
    "update_cadence": {
      "type": "string",
      "enum": ["active", "slowing", "stalled"]
    },
    "review_cadence_state": {
      "type": "string",
      "enum": ["current", "due_for_review", "overdue", "missing"]
    },
    "license_clarity": {
      "type": "string",
      "enum": ["clear", "ambiguous", "incompatible"]
    },
    "replacement_feasibility": {
      "type": "string",
      "enum": ["drop_in", "moderate", "hard", "no_known_path"]
    },
    "ownership_state": {
      "type": "string",
      "enum": ["owned", "unowned"]
    },
    "contingency_state": {
      "type": "string",
      "enum": ["recorded", "pending", "not_required"]
    },
    "contingency_disposition": {
      "type": "string",
      "enum": ["sponsor_upstream", "maintain_fork", "replace_dependency", "none"]
    },
    "escalation_state": {
      "type": "string",
      "enum": ["raised", "pending", "not_required"]
    },
    "posture": {
      "type": "string",
      "enum": ["clear", "gaps_found"]
    },
    "freshness_slo_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "health_state": {
      "type": "string",
      "enum": [
        "cleared",
        "narrowed_maintainer",
        "narrowed_security",
        "narrowed_cadence",
        "narrowed_license",
        "narrowed_ownership",
        "narrowed_stale",
        "withdrawn"
      ]
    },
    "health_reason": {
      "type": "string",
      "enum": [
        "maintainer_health_thinning",
        "maintainer_abandoned",
        "security_advisories_open",
        "security_unpatched_critical",
        "update_cadence_stalled",
        "review_cadence_overdue",
        "review_cadence_missing",
        "license_ambiguous",
        "license_incompatible",
        "upstream_unowned",
        "contingency_plan_missing",
        "shiproom_escalation_missing",
        "health_proof_stale",
        "health_proof_missing",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "health_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "assign_backup_maintainer",
        "sponsor_or_replace_upstream",
        "remediate_open_advisory",
        "patch_critical_vulnerability",
        "escalate_stalled_cadence",
        "refresh_upstream_review",
        "clarify_upstream_license",
        "assign_upstream_owner",
        "record_contingency_plan",
        "raise_shiproom_escalation",
        "refresh_health_proof",
        "request_owner_signoff"
      ]
    },
    "publication_decision": {
      "type": "string",
      "enum": ["proceed", "hold"]
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_scorecard_ref",
        "dependency_register_ref",
        "advisory_register_ref",
        "import_register_ref",
        "package_inventory_ref",
        "durability_matrix_ref",
        "shiproom_register_ref",
        "m5_evidence_index_ref"
      ],
      "properties": {
        "upstream_scorecard_ref": { "$ref": "#/$defs/non_empty_string" },
        "dependency_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "advisory_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "import_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "package_inventory_ref": { "$ref": "#/$defs/non_empty_string" },
        "durability_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "shiproom_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "m5_evidence_index_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "health_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "type": "string", "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/health_reason" },
        "applies_to_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" },
          "minItems": 1
        },
        "default_action": { "$ref": "#/$defs/health_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/nullable_date" },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_slo_state" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" }
      }
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "active_maintainer_count", "bus_factor", "assessment_ref"],
      "properties": {
        "rating": { "$ref": "#/$defs/maintainer_rating" },
        "active_maintainer_count": { "type": "integer", "minimum": 0 },
        "bus_factor": { "type": "integer", "minimum": 0 },
        "assessment_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "open_advisory_count", "advisory_ref"],
      "properties": {
        "posture": { "$ref": "#/$defs/security_posture" },
        "open_advisory_count": { "type": "integer", "minimum": 0 },
        "advisory_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "update_cadence_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence", "days_since_last_release", "release_ref"],
      "properties": {
        "cadence": { "$ref": "#/$defs/update_cadence" },
        "days_since_last_release": { "type": "integer", "minimum": 0 },
        "release_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "review_cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cadence_state",
        "review_interval_days",
        "next_review_due",
        "last_reviewed_ref"
      ],
      "properties": {
        "cadence_state": { "$ref": "#/$defs/review_cadence_state" },
        "review_interval_days": { "type": "integer", "minimum": 0 },
        "next_review_due": { "$ref": "#/$defs/nullable_date" },
        "last_reviewed_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clarity", "spdx_license_id", "license_ref"],
      "properties": {
        "clarity": { "$ref": "#/$defs/license_clarity" },
        "spdx_license_id": { "type": "string" },
        "license_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership_state", "owner_ref", "escalation_owner_ref"],
      "properties": {
        "ownership_state": { "$ref": "#/$defs/ownership_state" },
        "owner_ref": { "type": "string" },
        "escalation_owner_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "contingency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_state", "disposition", "replacement_feasibility", "plan_ref"],
      "properties": {
        "plan_state": { "$ref": "#/$defs/contingency_state" },
        "disposition": { "$ref": "#/$defs/contingency_disposition" },
        "replacement_feasibility": { "$ref": "#/$defs/replacement_feasibility" },
        "plan_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escalation_state", "required", "shiproom_ref", "governance_ref"],
      "properties": {
        "escalation_state": { "$ref": "#/$defs/escalation_state" },
        "required": { "type": "boolean" },
        "shiproom_ref": { "$ref": "#/$defs/non_empty_string" },
        "governance_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "control_ref", "owner_ref", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/control_dimension" },
        "control_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/control_state" }
      }
    },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["waiver_ref", "expires_at", "reason"],
          "properties": {
            "waiver_ref": { "$ref": "#/$defs/non_empty_string" },
            "expires_at": { "type": "string", "format": "date" },
            "reason": { "$ref": "#/$defs/non_empty_string" }
          }
        }
      ]
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "signed_off": { "type": "boolean" },
        "signed_at": { "$ref": "#/$defs/nullable_date" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "family",
        "upstream_kind",
        "title",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "declared_label",
        "support_class",
        "risk_grade",
        "maintainer",
        "security",
        "update_cadence",
        "review_cadence",
        "license",
        "ownership",
        "contingency",
        "escalation",
        "controls",
        "scan_posture",
        "surface_posture",
        "scan_ref",
        "surface_ref",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "health_state",
        "active_reasons",
        "effective_label",
        "surfaces",
        "rationale"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "upstream_kind": { "$ref": "#/$defs/upstream_kind" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" },
        "declared_label": { "$ref": "#/$defs/lifecycle_label" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "risk_grade": { "$ref": "#/$defs/health_grade" },
        "maintainer": { "$ref": "#/$defs/maintainer" },
        "security": { "$ref": "#/$defs/security" },
        "update_cadence": { "$ref": "#/$defs/update_cadence_profile" },
        "review_cadence": { "$ref": "#/$defs/review_cadence" },
        "license": { "$ref": "#/$defs/license" },
        "ownership": { "$ref": "#/$defs/ownership" },
        "contingency": { "$ref": "#/$defs/contingency" },
        "escalation": { "$ref": "#/$defs/escalation" },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" },
          "minItems": 6
        },
        "scan_posture": { "$ref": "#/$defs/posture" },
        "surface_posture": { "$ref": "#/$defs/posture" },
        "scan_ref": { "$ref": "#/$defs/non_empty_string" },
        "surface_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "health_state": { "$ref": "#/$defs/health_state" },
        "active_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/health_reason" },
          "uniqueItems": true
        },
        "effective_label": { "$ref": "#/$defs/lifecycle_label" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "scan_surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parity_gate",
        "subjects_total",
        "subjects_in_agreement",
        "subjects_in_disagreement",
        "subjects_with_gaps",
        "all_subjects_agree",
        "rationale"
      ],
      "properties": {
        "parity_gate": { "$ref": "#/$defs/non_empty_string" },
        "subjects_total": { "type": "integer", "minimum": 0 },
        "subjects_in_agreement": { "type": "integer", "minimum": 0 },
        "subjects_in_disagreement": { "type": "integer", "minimum": 0 },
        "subjects_with_gaps": { "type": "integer", "minimum": 0 },
        "all_subjects_agree": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_record_ids",
        "rationale"
      ],
      "properties": {
        "publication_gate": { "$ref": "#/$defs/non_empty_string" },
