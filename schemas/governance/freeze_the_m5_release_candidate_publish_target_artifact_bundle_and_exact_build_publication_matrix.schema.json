{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/freeze_the_m5_release_candidate_publish_target_artifact_bundle_and_exact_build_publication_matrix.schema.json",
  "title": "M5 Release-Candidate, Publish-Target, Artifact-Bundle, and Exact-Build Publication Matrix",
  "description": "Canonical typed matrix that maps every new M5 artifact family to its release candidate scope, publish target class, required evidence, exact-build identity fields, rollback/revocation posture, and mirror/offline publication expectations. Release-center surfaces, headless publication flows, support/export packets, and claim-narrowing logic ingest this directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "matrix_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "artifact_graph_ref",
    "feature_train_matrix_ref",
    "lifecycle_labels",
    "family_kinds",
    "attestation_states",
    "sbom_scopes",
    "symbol_availabilities",
    "mirror_freshness_states",
    "evidence_completeness_states",
    "freshness_states",
    "gap_reasons",
    "publication_actions",
    "launch_cutline",
    "release_blocking_artifact_refs",
    "stop_rules",
    "rows",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "description": "Schema version of the matrix." },
    "record_kind": {
      "type": "string",
      "const": "freeze_the_m5_release_candidate_publish_target_artifact_bundle_and_exact_build_publication_matrix"
    },
    "matrix_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "artifact_graph_ref": { "type": "string", "minLength": 1 },
    "feature_train_matrix_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": {
      "type": "array",
      "items": { "type": "string", "enum": ["lts", "stable", "beta", "preview", "withdrawn"] }
    },
    "family_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "notebook_pack",
          "request_data_asset",
          "profiler_replay_artifact",
          "framework_template_pack",
          "docs_pack",
          "model_pack",
          "companion_offboarding_packet",
          "managed_output"
        ]
      }
    },
    "attestation_states": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["attested", "pending_attestation", "unattested", "not_applicable"]
      }
    },
    "sbom_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["full_graph", "component_scoped", "partial", "missing", "not_applicable"]
      }
    },
    "symbol_availabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["published", "retained_internal", "stripped", "missing", "not_applicable"]
      }
    },
    "mirror_freshness_states": {
      "type": "array",
      "items": { "type": "string", "enum": ["current", "stale", "unpublished", "not_applicable"] }
    },
    "evidence_completeness_states": {
      "type": "array",
      "items": { "type": "string", "enum": ["complete", "partial", "missing"] }
    },
    "freshness_states": {
      "type": "array",
      "items": { "type": "string", "enum": ["current", "due_for_refresh", "breached", "missing"] }
    },
    "gap_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "signature_missing",
          "attestation_missing",
          "sbom_incomplete",
          "symbols_missing",
          "mirror_stale",
          "rollback_target_missing",
          "exact_build_linkage_broken",
          "evidence_incomplete",
          "proof_packet_missing",
          "proof_packet_stale",
          "waiver_expired",
          "owner_signoff_missing"
        ]
      }
    },
    "publication_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hold_publication",
          "narrow_claim",
          "re_sign_artifact",
          "re_attest",
          "regenerate_sbom",
          "publish_symbols",
          "refresh_mirror",
          "record_rollback_target",
          "rebuild_exact_build",
          "recapture_evidence",
          "refresh_proof_packet",
          "request_owner_signoff"
        ]
      }
    },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_artifact_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stop_rule" } },
    "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matrix_row" } },
    "publication": { "$ref": "#/$defs/publication_record" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutline_level", "above_cutline_levels", "below_cutline_levels", "description"],
      "properties": {
        "cutline_level": { "type": "string", "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "type": "string", "enum": ["lts", "stable"] }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "type": "string", "enum": ["beta", "preview", "withdrawn"] }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_publication",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "type": "string", "minLength": 1 },
        "applies_to_labels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "default_action": { "type": "string", "minLength": 1 },
        "blocks_publication": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "publication_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "blocking_rule_ids", "blocking_claim_ids", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blocking_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "freshness_slo", "slo_state"],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
          "properties": {
            "target_max_age_days": { "type": "integer", "minimum": 1 },
            "warn_within_days": { "type": "integer", "minimum": 0 },
            "slo_register_ref": { "type": "string", "minLength": 1 }
          }
        },
        "slo_state": {
          "type": "string",
          "enum": ["current", "due_for_refresh", "breached", "missing"]
        },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "exact_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_identity_ref",
        "provenance_ref",
        "signature_state",
        "attestation_availability",
        "sbom_scope",
        "symbol_availability",
        "mirror_freshness",
        "rollback_target_ref",
        "evidence_completeness"
      ],
      "properties": {
        "build_identity_ref": { "type": "string", "minLength": 1 },
        "provenance_ref": { "type": "string", "minLength": 1 },
        "signature_state": {
          "type": "string",
          "enum": ["verified", "present_unverified", "pending_release_signature", "missing", "revoked"]
        },
        "attestation_availability": {
          "type": "string",
          "enum": ["attested", "pending_attestation", "unattested", "not_applicable"]
        },
        "sbom_scope": {
          "type": "string",
          "enum": ["full_graph", "component_scoped", "partial", "missing", "not_applicable"]
        },
        "symbol_availability": {
          "type": "string",
          "enum": ["published", "retained_internal", "stripped", "missing", "not_applicable"]
        },
        "mirror_freshness": {
          "type": "string",
          "enum": ["current", "stale", "unpublished", "not_applicable"]
        },
        "rollback_target_ref": { "type": "string" },
        "evidence_completeness": { "type": "string", "enum": ["complete", "partial", "missing"] }
      }
    },
    "rollback_revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "blast_radius", "revocable", "posture_ref", "summary"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["rollback", "revoke", "yank", "repin", "emergency_disable"]
        },
        "blast_radius": {
          "type": "string",
          "enum": [
            "single_artifact_node",
            "artifact_family_scoped",
            "channel_pointer_scoped",
            "registry_namespace_scoped",
            "mirror_scoped",
            "full_artifact_graph"
          ]
        },
        "revocable": { "type": "boolean" },
        "posture_ref": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "mirror_offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirror_publish_expected", "offline_verifiable", "parity_ref", "summary"],
      "properties": {
        "mirror_publish_expected": { "type": "boolean" },
        "offline_verifiable": { "type": "boolean" },
        "parity_ref": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "matrix_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "family_kind",
        "artifact_ref",
        "artifact_summary",
        "release_blocking",
        "release_candidate_ref",
        "claim_ref",
        "claim_label",
        "publish_target_class",
        "exact_build",
        "rollback_revocation",
        "mirror_offline",
        "proof_packet",
        "owner_signoff",
        "published_label",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "family_kind": { "type": "string", "minLength": 1 },
        "artifact_ref": { "type": "string", "minLength": 1 },
        "artifact_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "release_candidate_ref": { "type": "string", "minLength": 1 },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "type": "string", "minLength": 1 },
        "publish_target_class": {
          "type": "string",
          "enum": [
            "local_preview",
            "internal_ring",
            "public_preview",
            "stable",
            "lts",
            "mirror_feed",
            "registry_marketplace",
            "emergency_channel"
          ]
        },
        "exact_build": { "$ref": "#/$defs/exact_build" },
        "rollback_revocation": { "$ref": "#/$defs/rollback_revocation" },
        "mirror_offline": { "$ref": "#/$defs/mirror_offline" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["waiver_ref", "expires_at", "reason"],
          "properties": {
            "waiver_ref": { "type": "string", "minLength": 1 },
            "expires_at": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "owner_signoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_ref", "signed_off"],
          "properties": {
            "owner_ref": { "type": "string", "minLength": 1 },
            "signed_off": { "type": "boolean" },
            "signed_at": { "type": ["string", "null"] }
          }
        },
        "active_gap_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "published_label": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_entries",
        "total_release_candidates",
        "entries_backed",
        "entries_narrowed",
        "entries_on_active_waiver",
        "release_blocking_total",
        "release_blocking_backed",
        "release_blocking_narrowed",
        "notebook_pack_entries",
        "request_data_asset_entries",
        "profiler_replay_entries",
        "framework_template_entries",
        "docs_pack_entries",
        "model_pack_entries",
        "companion_offboarding_entries",
        "managed_output_entries",
        "packets_current",
        "packets_due_for_refresh",
        "packets_breached",
        "packets_missing",
        "signatures_verified",
        "attestations_attested",
        "sbom_in_scope",
        "symbols_available",
        "mirror_current",
        "rollback_targets_recorded",
        "mirror_publish_expected",
        "offline_verifiable",
        "revocable_entries",
        "total_active_gap_reasons",
        "rules_firing"
      ],
      "properties": {
        "total_entries": { "type": "integer", "minimum": 0 },
        "total_release_candidates": { "type": "integer", "minimum": 0 },
        "entries_backed": { "type": "integer", "minimum": 0 },
        "entries_narrowed": { "type": "integer", "minimum": 0 },
        "entries_on_active_waiver": { "type": "integer", "minimum": 0 },
        "release_blocking_total": { "type": "integer", "minimum": 0 },
        "release_blocking_backed": { "type": "integer", "minimum": 0 },
        "release_blocking_narrowed": { "type": "integer", "minimum": 0 },
        "notebook_pack_entries": { "type": "integer", "minimum": 0 },
        "request_data_asset_entries": { "type": "integer", "minimum": 0 },
        "profiler_replay_entries": { "type": "integer", "minimum": 0 },
        "framework_template_entries": { "type": "integer", "minimum": 0 },
        "docs_pack_entries": { "type": "integer", "minimum": 0 },
        "model_pack_entries": { "type": "integer", "minimum": 0 },
        "companion_offboarding_entries": { "type": "integer", "minimum": 0 },
        "managed_output_entries": { "type": "integer", "minimum": 0 },
        "packets_current": { "type": "integer", "minimum": 0 },
        "packets_due_for_refresh": { "type": "integer", "minimum": 0 },
        "packets_breached": { "type": "integer", "minimum": 0 },
        "packets_missing": { "type": "integer", "minimum": 0 },
        "signatures_verified": { "type": "integer", "minimum": 0 },
        "attestations_attested": { "type": "integer", "minimum": 0 },
        "sbom_in_scope": { "type": "integer", "minimum": 0 },
        "symbols_available": { "type": "integer", "minimum": 0 },
        "mirror_current": { "type": "integer", "minimum": 0 },
        "rollback_targets_recorded": { "type": "integer", "minimum": 0 },
        "mirror_publish_expected": { "type": "integer", "minimum": 0 },
        "offline_verifiable": { "type": "integer", "minimum": 0 },
        "revocable_entries": { "type": "integer", "minimum": 0 },
        "total_active_gap_reasons": { "type": "integer", "minimum": 0 },
        "rules_firing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
