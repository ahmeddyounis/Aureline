{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/certify_artifact_graph_publication_exact_build_provenance_rollback_revocation_parity_and_mirror_offline_release_truth_on_all_claimed_m5_rows.schema.json",
  "title": "M5 Publication-Certification Register",
  "description": "Canonical typed register that certifies, on every claimed M5 artifact family, the full publication artifact graph: release-center object parity, clean-room rebuild, exact-build symbolication, publish-target review, rollback, revocation, and mirror/offline parity. Release-truth evidence that is stale, partial, or missing narrows the family below the launch cutline. Claim-narrowing, shiproom dashboards, the canonical M5 evidence index, Help/About, service-health, and support exports ingest this directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "manifest_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "evidence_index_ref",
    "lifecycle_labels",
    "family_kinds",
    "publication_dimensions",
    "dimension_grades",
    "cert_states",
    "narrowing_reasons",
    "stop_rule_actions",
    "automation_triggers",
    "automation_states",
    "trust_tiers",
    "freshness_states",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "rows",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "certify_artifact_graph_publication_exact_build_provenance_rollback_revocation_parity_and_mirror_offline_release_truth_on_all_claimed_m5_rows"
    },
    "manifest_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "evidence_index_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "family_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/family_kind" }
    },
    "publication_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/publication_dimension" }
    },
    "dimension_grades": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimension_grade" }
    },
    "cert_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/cert_state" }
    },
    "narrowing_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/narrowing_reason" }
    },
    "stop_rule_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/stop_action" }
    },
    "automation_triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/automation_trigger" }
    },
    "automation_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/automation_state" }
    },
    "trust_tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/trust_tier" }
    },
    "freshness_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/freshness_state" }
    },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop_rule" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family_kind": {
      "type": "string",
      "enum": [
        "notebook_pack",
        "request_data_asset",
        "profiler_replay_artifact",
        "framework_template_pack",
        "docs_pack",
        "model_pack",
        "companion_offboarding_packet",
        "managed_output"
      ]
    },
    "publication_dimension": {
      "type": "string",
      "enum": [
        "release_center_parity",
        "clean_room_rebuild",
        "exact_build_symbolication",
        "publish_target_review",
        "rollback_record",
        "revocation_record",
        "mirror_offline_parity"
      ]
    },
    "dimension_grade": {
      "type": "string",
      "enum": ["pass", "partial", "fail", "waived", "missing"]
    },
    "cert_state": {
      "type": "string",
      "enum": [
        "certified",
        "dimension_regressed",
        "stale",
        "on_waiver",
        "automation_undefined",
        "owner_unsigned"
      ]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "publication_dimension_failed",
        "publication_dimension_missing",
        "proof_packet_missing",
        "proof_packet_stale",
        "owner_manifest_unsigned",
        "rollback_plan_unverified",
        "downgrade_automation_undefined",
        "waiver_expired",
        "ambient_credential_inherited",
        "mirror_offline_drill_stale"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "narrow_label",
        "remediate_dimension",
        "refresh_proof_packet",
        "request_owner_signoff",
        "verify_rollback_plan",
        "define_downgrade_automation",
        "renew_waiver",
        "rotate_scoped_credential",
        "refresh_mirror_drill"
      ]
    },
    "automation_trigger": {
      "type": "string",
      "enum": ["proof_stale", "dimension_regressed", "owner_revoked", "manual"]
    },
    "automation_state": {
      "type": "string",
      "enum": ["defined", "unverified", "undefined"]
    },
    "trust_tier": {
      "type": "string",
      "enum": ["first_party", "verified_partner", "community", "generated"]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/narrowing_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "dimension_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "grade", "evidence_ref"],
      "properties": {
        "dimension": { "$ref": "#/$defs/publication_dimension" },
        "grade": { "$ref": "#/$defs/dimension_grade" },
        "evidence_ref": { "type": "string" }
      }
    },
    "publish_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_source_ref",
        "auth_source_disclosed",
        "inherits_ambient_credentials"
      ],
      "properties": {
        "auth_source_ref": { "type": "string", "minLength": 1 },
        "auth_source_disclosed": { "type": "boolean" },
        "inherits_ambient_credentials": { "type": "boolean" }
      }
    },
    "mirror_offline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_ref",
        "hosted_parity",
        "mirrored_parity",
        "offline_parity",
        "drill_state"
      ],
      "properties": {
        "drill_ref": { "type": "string", "minLength": 1 },
        "hosted_parity": { "type": "boolean" },
        "mirrored_parity": { "type": "boolean" },
        "offline_parity": { "type": "boolean" },
        "drill_state": { "$ref": "#/$defs/freshness_state" }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_window_ref",
        "policy_ref",
        "trust_tier",
        "redaction_disclosed"
      ],
      "properties": {
        "support_window_ref": { "type": "string", "minLength": 1 },
        "policy_ref": { "type": "string", "minLength": 1 },
        "trust_tier": { "$ref": "#/$defs/trust_tier" },
        "scope_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "redaction_disclosed": { "type": "boolean" }
      }
    },
    "downgrade_automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automation_ref",
        "rollback_plan_ref",
        "trigger",
        "target_floor",
        "state",
        "rollback_verified"
      ],
      "properties": {
        "automation_ref": { "type": "string", "minLength": 1 },
        "rollback_plan_ref": { "type": "string", "minLength": 1 },
        "trigger": { "$ref": "#/$defs/automation_trigger" },
        "target_floor": { "$ref": "#/$defs/lifecycle_label" },
        "state": { "$ref": "#/$defs/automation_state" },
        "rollback_verified": { "type": "boolean" }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 0 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "proof_index_ref",
        "freshness_slo",
        "slo_state"
      ],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_state" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"] }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "family_kind",
        "family_ref",
        "family_summary",
        "release_blocking",
        "claim_ref",
        "claim_label",
        "cert_state",
        "scorecard",
        "publish_target",
        "mirror_offline",
        "disclosure",
        "downgrade_automation",
        "proof_packet",
        "owner_signoff",
        "published_label",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "family_kind": { "$ref": "#/$defs/family_kind" },
        "family_ref": { "type": "string", "minLength": 1 },
        "family_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "cert_state": { "$ref": "#/$defs/cert_state" },
        "scorecard": {
          "type": "array",
          "minItems": 7,
          "items": { "$ref": "#/$defs/dimension_cell" }
        },
        "publish_target": { "$ref": "#/$defs/publish_target" },
        "mirror_offline": { "$ref": "#/$defs/mirror_offline" },
        "disclosure": { "$ref": "#/$defs/disclosure" },
        "downgrade_automation": { "$ref": "#/$defs/downgrade_automation" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": {
          "anyOf": [{ "$ref": "#/$defs/waiver" }, { "type": "null" }]
        },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "publication_destinations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocking_claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_entries",
        "total_families",
        "entries_certified",
        "entries_narrowed",
        "entries_on_active_waiver",
        "entries_with_dimension_gap",
        "entries_with_owner_gap",
        "entries_with_automation_gap",
        "entries_with_ambient_credential_gap",
        "entries_with_mirror_drill_gap",
        "entries_redaction_undisclosed",
        "release_blocking_total",
        "release_blocking_certified",
        "release_blocking_narrowed",
        "first_party_entries",
        "verified_partner_entries",
        "community_entries",
        "generated_entries",
        "packets_current",
        "packets_due_for_refresh",
        "packets_breached",
        "packets_missing",
        "mirror_drills_current",
        "mirror_drills_due_for_refresh",
        "mirror_drills_breached",
        "mirror_drills_missing",
        "total_active_narrowing_reasons",
        "total_dimension_cells",
        "cells_pass",
        "cells_partial",
        "cells_fail",
        "cells_waived",
        "cells_missing",
        "rules_firing"
      ],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
