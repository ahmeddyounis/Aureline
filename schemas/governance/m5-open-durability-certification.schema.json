{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/m5-open-durability-certification.schema.json",
  "title": "Aureline open-durability certification register",
  "description": "Canonical, machine-readable register that certifies, per claimed M5 ecosystem/release row, all six open-durability axes at once: the published and release-linked open-boundary manifest (with no hidden proprietary baseline), the current REUSE/SPDX licensing with bound notice inventory and SBOM, the attributed third-party/generated import provenance with every critical import owned, the met signer quorum with a non-single-person emergency authority, the current advisory/revocation/disable drill evidence, and the healthy and owned critical upstreams. A record is certified only when every axis holds, the certification proof is fresh, and the owner signed. Otherwise it narrows on the specific axis that thins out (a boundary, compliance, import, authority, emergency, upstream, or stale-proof gap) and drops its effective label below the launch cutline; the axes never collapse into one global flag, and a green certification card can never mask a hidden proprietary baseline, an ownerless critical import, a single-person emergency authority, a stale notice/SBOM, an uncovered drill, or an unhealthy upstream. An inherited or waived narrowing is gated upstream while a certification failure on a still-stable row holds promotion — a row that depends on a hidden proprietary baseline, an ownerless critical import, or a single-person emergency authority may not widen a stable claim without an approved plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "source_contract_refs",
    "certification_cutline",
    "families",
    "row_kinds",
    "support_classes",
    "control_dimensions",
    "boundary_states",
    "compliance_states",
    "import_states",
    "authority_states",
    "emergency_states",
    "upstream_states",
    "postures",
    "certification_states",
    "certification_reasons",
    "certification_actions",
    "rules",
    "records",
    "scan_surface_parity",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_open_durability_certification_register"
    },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
    "certification_cutline": { "$ref": "#/$defs/certification_cutline" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" },
      "minItems": 1,
      "uniqueItems": true
    },
    "row_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/row_kind" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/support_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "control_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_dimension" },
      "minItems": 1,
      "uniqueItems": true
    },
    "boundary_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "compliance_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/compliance_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "import_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/import_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "authority_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/authority_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "emergency_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/emergency_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "upstream_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/upstream_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "certification_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/certification_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "certification_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/certification_reason" },
      "minItems": 1,
      "uniqueItems": true
    },
    "certification_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/certification_action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" },
      "minItems": 1
    },
    "scan_surface_parity": { "$ref": "#/$defs/scan_surface_parity" },
    "publication": { "$ref": "#/$defs/publication" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_rich",
        "ai_adjacent",
        "framework",
        "review",
        "companion",
        "managed_depth"
      ]
    },
    "row_kind": { "type": "string", "enum": ["ecosystem", "release"] },
    "support_class": {
      "type": "string",
      "enum": ["open_local", "mixed_open_managed", "managed", "restricted"]
    },
    "control_dimension": {
      "type": "string",
      "enum": [
        "boundary_manifest",
        "repository_compliance",
        "import_durability",
        "signer_authority",
        "emergency_response",
        "critical_upstream",
        "scan_surface_parity"
      ]
    },
    "boundary_state": {
      "type": "string",
      "enum": ["published", "unpublished", "hidden_proprietary_baseline"]
    },
    "compliance_state": {
      "type": "string",
      "enum": ["current", "stale", "notice_binding_missing"]
    },
    "import_state": {
      "type": "string",
      "enum": ["attributed", "provenance_missing", "ownerless_critical_import"]
    },
    "authority_state": {
      "type": "string",
      "enum": ["quorum_met", "quorum_unmet", "single_person_authority"]
    },
    "emergency_state": { "type": "string", "enum": ["current", "stale"] },
    "upstream_state": { "type": "string", "enum": ["healthy", "unhealthy"] },
    "posture": { "type": "string", "enum": ["clear", "gaps_found"] },
    "control_state": {
      "type": "string",
      "enum": ["satisfied", "unsatisfied", "not_applicable"]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "certification_state": {
      "type": "string",
      "enum": [
        "certified",
        "narrowed_boundary",
        "narrowed_compliance",
        "narrowed_import",
        "narrowed_authority",
        "narrowed_emergency",
        "narrowed_upstream",
        "narrowed_stale",
        "withdrawn"
      ]
    },
    "certification_reason": {
      "type": "string",
      "enum": [
        "boundary_manifest_missing",
        "hidden_proprietary_baseline",
        "repository_compliance_stale",
        "notice_binding_missing",
        "import_provenance_missing",
        "ownerless_critical_import",
        "signer_quorum_unmet",
        "single_person_emergency_authority",
        "emergency_response_stale",
        "critical_upstream_unhealthy",
        "certification_proof_stale",
        "certification_proof_missing",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "certification_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "publish_boundary_manifest",
        "disclose_proprietary_baseline",
        "refresh_repository_compliance",
        "bind_notices_and_sbom",
        "attribute_import_provenance",
        "assign_import_owner",
        "meet_signer_quorum",
        "add_backup_authority",
        "refresh_emergency_response",
        "remediate_critical_upstream",
        "refresh_certification_proof",
        "request_owner_signoff"
      ]
    },
    "publication_decision": { "type": "string", "enum": ["proceed", "hold"] },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 0 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": {
          "type": "string",
          "enum": ["current", "due_for_refresh", "breached", "missing"]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "type": "string", "format": "date" },
        "reason": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"] }
      }
    },
    "boundary_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "manifest_published",
        "proprietary_baseline_hidden",
        "manifest_ref",
        "evidence_ref"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/boundary_state" },
        "manifest_published": { "type": "boolean" },
        "proprietary_baseline_hidden": { "type": "boolean" },
        "manifest_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "compliance_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "licensing_current",
        "notice_sbom_bound",
        "compliance_register_ref",
        "evidence_ref"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/compliance_state" },
        "licensing_current": { "type": "boolean" },
        "notice_sbom_bound": { "type": "boolean" },
        "compliance_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "import_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance_attributed",
        "critical_import_owned",
        "import_register_ref",
        "evidence_ref"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/import_state" },
        "provenance_attributed": { "type": "boolean" },
        "critical_import_owned": { "type": "boolean" },
        "import_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "required_distinct_humans",
        "available_distinct_humans",
        "backup_present",
        "continuity_register_ref",
        "evidence_ref"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/authority_state" },
        "required_distinct_humans": { "type": "integer", "minimum": 0 },
        "available_distinct_humans": { "type": "integer", "minimum": 0 },
        "backup_present": { "type": "boolean" },
        "continuity_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "emergency_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "drill_current", "response_register_ref", "evidence_ref"],
      "properties": {
        "state": { "$ref": "#/$defs/emergency_state" },
        "drill_current": { "type": "boolean" },
        "response_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "upstream_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "upstream_healthy",
        "upstream_health_register_ref",
        "evidence_ref"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/upstream_state" },
        "upstream_healthy": { "type": "boolean" },
        "upstream_health_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "control_ref", "owner_ref", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/control_dimension" },
        "control_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/control_state" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_manifest_register_ref",
        "boundary_durability_matrix_ref",
        "compliance_register_ref",
        "import_register_ref",
        "authority_continuity_register_ref",
        "emergency_response_register_ref",
        "upstream_health_register_ref",
        "release_graph_ref",
        "support_export_ref",
        "shiproom_register_ref",
        "stable_promotion_packet_ref",
        "m5_evidence_index_ref"
      ],
      "properties": {
        "boundary_manifest_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_durability_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "compliance_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "import_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "authority_continuity_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "emergency_response_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "upstream_health_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "release_graph_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_ref": { "$ref": "#/$defs/non_empty_string" },
        "shiproom_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "stable_promotion_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "m5_evidence_index_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "certification_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/certification_reason" },
        "applies_to_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/certification_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "family",
        "row_kind",
        "title",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "declared_label",
        "support_class",
        "boundary",
        "compliance",
        "import_durability",
        "authority",
        "emergency",
        "upstream",
        "controls",
        "scan_posture",
        "surface_posture",
        "scan_ref",
        "surface_ref",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "certification_state",
        "active_reasons",
        "effective_label",
        "surfaces",
        "rationale"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "row_kind": { "$ref": "#/$defs/row_kind" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" },
        "declared_label": { "$ref": "#/$defs/lifecycle_label" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "boundary": { "$ref": "#/$defs/boundary_binding" },
        "compliance": { "$ref": "#/$defs/compliance_binding" },
        "import_durability": { "$ref": "#/$defs/import_binding" },
        "authority": { "$ref": "#/$defs/authority_binding" },
        "emergency": { "$ref": "#/$defs/emergency_binding" },
        "upstream": { "$ref": "#/$defs/upstream_binding" },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" },
          "minItems": 1
        },
        "scan_posture": { "$ref": "#/$defs/posture" },
        "surface_posture": { "$ref": "#/$defs/posture" },
        "scan_ref": { "$ref": "#/$defs/non_empty_string" },
        "surface_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": {
          "oneOf": [{ "$ref": "#/$defs/waiver" }, { "type": "null" }]
        },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "certification_state": { "$ref": "#/$defs/certification_state" },
        "active_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/certification_reason" }
        },
        "effective_label": { "$ref": "#/$defs/lifecycle_label" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "scan_surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parity_gate",
        "subjects_total",
        "subjects_in_agreement",
        "subjects_in_disagreement",
        "subjects_with_gaps",
        "all_subjects_agree",
        "rationale"
      ],
      "properties": {
        "parity_gate": { "$ref": "#/$defs/non_empty_string" },
        "subjects_total": { "type": "integer", "minimum": 0 },
        "subjects_in_agreement": { "type": "integer", "minimum": 0 },
        "subjects_in_disagreement": { "type": "integer", "minimum": 0 },
        "subjects_with_gaps": { "type": "integer", "minimum": 0 },
        "all_subjects_agree": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_record_ids",
        "rationale"
      ],
      "properties": {
        "publication_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/publication_decision" },
        "blocking_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "blocking_record_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_records",
        "records_certified",
        "records_narrowed",
        "state_certified",
        "state_narrowed_boundary",
        "state_narrowed_compliance",
        "state_narrowed_import",
        "state_narrowed_authority",
        "state_narrowed_emergency",
        "state_narrowed_upstream",
        "state_narrowed_stale",
        "state_withdrawn",
        "release_blocking_total",
        "release_blocking_narrowed",
        "records_on_active_waiver",
        "boundary_gaps",
        "compliance_gaps",
        "import_gaps",
        "authority_gaps",
        "emergency_gaps",
        "upstream_gaps",
        "hidden_proprietary_baseline_gaps",
        "ownerless_critical_import_gaps",
        "single_person_authority_gaps",
        "total_active_reasons",
        "rules_firing"
      ],
      "properties": {
        "total_records": { "type": "integer", "minimum": 0 },
        "records_certified": { "type": "integer", "minimum": 0 },
        "records_narrowed": { "type": "integer", "minimum": 0 },
        "state_certified": { "type": "integer", "minimum": 0 },
        "state_narrowed_boundary": { "type": "integer", "minimum": 0 },
        "state_narrowed_compliance": { "type": "integer", "minimum": 0 },
        "state_narrowed_import": { "type": "integer", "minimum": 0 },
        "state_narrowed_authority": { "type": "integer", "minimum": 0 },
        "state_narrowed_emergency": { "type": "integer", "minimum": 0 },
