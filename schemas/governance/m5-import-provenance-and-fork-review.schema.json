{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/m5-import-provenance-and-fork-review.schema.json",
  "title": "Aureline import-provenance and local-fork review register",
  "description": "Canonical, machine-readable register that publishes, per protected-path import used by an M5 family, the import provenance (origin attribution, SPDX license identification, upstream version pin), the update ownership, the divergence profile (local-modification posture, divergence age, and review state), the sponsor/fork/replace decision required for long-lived forks and single-source imports, and the generated-code provenance (generator identity and regeneration path), holding the dependency-health/import scan in parity with the user/admin import surface. A record is cleared only when provenance holds, the import is owned, any required divergence review is current, any required decision is recorded, generated-code provenance is complete, the proof is fresh, and the owner signed. Otherwise it narrows on the specific axis that thins out (a provenance gap, an ownership gap, a divergence/decision gap, a generator gap, or stale proof) and drops its effective label below the launch cutline; the axes never collapse into one global flag, and a clean import card can never mask an ownerless, unattributed, or generator-free import. An inherited or waived narrowing is gated upstream while an import-layer failure on a still-stable subject holds promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "source_contract_refs",
    "import_cutline",
    "families",
    "import_kinds",
    "support_classes",
    "control_dimensions",
    "origin_states",
    "license_states",
    "upstream_pin_states",
    "ownership_states",
    "divergence_states",
    "divergence_review_states",
    "decision_states",
    "decision_dispositions",
    "postures",
    "import_states",
    "import_reasons",
    "import_actions",
    "rules",
    "records",
    "manifest_surface_parity",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_import_provenance_and_fork_review_register"
    },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
    "import_cutline": { "$ref": "#/$defs/import_cutline" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" },
      "minItems": 1,
      "uniqueItems": true
    },
    "import_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/import_kind" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/support_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "control_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_dimension" },
      "minItems": 1,
      "uniqueItems": true
    },
    "origin_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/origin_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "license_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/license_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "upstream_pin_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/upstream_pin_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "ownership_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/ownership_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "divergence_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/divergence_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "divergence_review_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/divergence_review_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "decision_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "decision_dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision_disposition" },
      "minItems": 1,
      "uniqueItems": true
    },
    "postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "import_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/import_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "import_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/import_reason" },
      "minItems": 1,
      "uniqueItems": true
    },
    "import_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/import_action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" },
      "minItems": 1
    },
    "manifest_surface_parity": { "$ref": "#/$defs/manifest_surface_parity" },
    "publication": { "$ref": "#/$defs/publication" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "nullable_date": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_rich",
        "ai_adjacent",
        "framework",
        "review",
        "companion",
        "managed_depth"
      ]
    },
    "import_kind": {
      "type": "string",
      "enum": [
        "third_party_import",
        "generated_artifact",
        "local_fork",
        "curated_single_source"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["open_local", "mixed_open_managed", "managed", "restricted"]
    },
    "control_dimension": {
      "type": "string",
      "enum": [
        "import_provenance",
        "update_ownership",
        "divergence_review",
        "decision_path",
        "generator_provenance",
        "manifest_surface_parity"
      ]
    },
    "control_state": {
      "type": "string",
      "enum": ["satisfied", "unsatisfied", "not_applicable"]
    },
    "origin_state": {
      "type": "string",
      "enum": ["attributed", "unattributed"]
    },
    "license_state": {
      "type": "string",
      "enum": ["identified", "unidentified", "not_applicable"]
    },
    "upstream_pin_state": {
      "type": "string",
      "enum": ["pinned", "floating", "not_applicable"]
    },
    "ownership_state": {
      "type": "string",
      "enum": ["owned", "ownerless"]
    },
    "divergence_state": {
      "type": "string",
      "enum": ["in_sync", "diverged", "forked"]
    },
    "divergence_review_state": {
      "type": "string",
      "enum": ["current", "stale", "missing", "not_required"]
    },
    "decision_state": {
      "type": "string",
      "enum": ["recorded", "pending", "not_required"]
    },
    "decision_disposition": {
      "type": "string",
      "enum": ["sponsor_upstream", "maintain_fork", "replace_dependency", "none"]
    },
    "posture": {
      "type": "string",
      "enum": ["clear", "gaps_found"]
    },
    "freshness_slo_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "import_state": {
      "type": "string",
      "enum": [
        "cleared",
        "narrowed_provenance",
        "narrowed_ownership",
        "narrowed_divergence",
        "narrowed_generator",
        "narrowed_stale",
        "withdrawn"
      ]
    },
    "import_reason": {
      "type": "string",
      "enum": [
        "origin_unattributed",
        "license_unidentified",
        "upstream_version_floating",
        "update_owner_missing",
        "divergence_review_stale",
        "divergence_review_missing",
        "decision_record_missing",
        "generator_identity_missing",
        "regeneration_path_missing",
        "import_proof_stale",
        "import_proof_missing",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "import_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "attribute_origin",
        "identify_license",
        "pin_upstream_version",
        "assign_update_owner",
        "refresh_divergence_review",
        "record_sponsor_fork_replace_decision",
        "record_generator_identity",
        "record_regeneration_path",
        "refresh_import_proof",
        "request_owner_signoff"
      ]
    },
    "publication_decision": {
      "type": "string",
      "enum": ["proceed", "hold"]
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "third_party_import_register_ref",
        "import_manifest_ref",
        "dependency_register_ref",
        "critical_upstream_scorecard_ref",
        "generated_lineage_ref",
        "package_inventory_ref",
        "durability_matrix_ref",
        "m5_evidence_index_ref"
      ],
      "properties": {
        "third_party_import_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "import_manifest_ref": { "$ref": "#/$defs/non_empty_string" },
        "dependency_register_ref": { "$ref": "#/$defs/non_empty_string" },
        "critical_upstream_scorecard_ref": { "$ref": "#/$defs/non_empty_string" },
        "generated_lineage_ref": { "$ref": "#/$defs/non_empty_string" },
        "package_inventory_ref": { "$ref": "#/$defs/non_empty_string" },
        "durability_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "m5_evidence_index_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "import_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "type": "string", "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/import_reason" },
        "applies_to_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" },
          "minItems": 1
        },
        "default_action": { "$ref": "#/$defs/import_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/nullable_date" },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_slo_state" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" }
      }
    },
    "import_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_state",
        "license_state",
        "upstream_pin_state",
        "spdx_license_id",
        "upstream_version",
        "origin_ref",
        "license_ref"
      ],
      "properties": {
        "origin_state": { "$ref": "#/$defs/origin_state" },
        "license_state": { "$ref": "#/$defs/license_state" },
        "upstream_pin_state": { "$ref": "#/$defs/upstream_pin_state" },
        "spdx_license_id": { "type": "string" },
        "upstream_version": { "type": "string" },
        "origin_ref": { "$ref": "#/$defs/non_empty_string" },
        "license_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "update_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership_state", "update_owner_ref", "last_update_ref"],
      "properties": {
        "ownership_state": { "$ref": "#/$defs/ownership_state" },
        "update_owner_ref": { "type": "string" },
        "last_update_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "divergence_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "divergence_state",
        "local_patch_count",
        "divergence_age_days",
        "review_state",
        "review_ref"
      ],
      "properties": {
        "divergence_state": { "$ref": "#/$defs/divergence_state" },
        "local_patch_count": { "type": "integer", "minimum": 0 },
        "divergence_age_days": { "type": "integer", "minimum": 0 },
        "review_state": { "$ref": "#/$defs/divergence_review_state" },
        "review_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_state", "disposition", "decision_ref", "review_board_ref"],
      "properties": {
        "decision_state": { "$ref": "#/$defs/decision_state" },
        "disposition": { "$ref": "#/$defs/decision_disposition" },
        "decision_ref": { "$ref": "#/$defs/non_empty_string" },
        "review_board_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "generator_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "generator_identity_present",
        "regeneration_path_present",
        "generator_ref",
        "regeneration_path_ref"
      ],
      "properties": {
        "applies": { "type": "boolean" },
        "generator_identity_present": { "type": "boolean" },
        "regeneration_path_present": { "type": "boolean" },
        "generator_ref": { "type": "string" },
        "regeneration_path_ref": { "type": "string" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "control_ref", "owner_ref", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/control_dimension" },
        "control_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/control_state" }
      }
    },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["waiver_ref", "expires_at", "reason"],
          "properties": {
            "waiver_ref": { "$ref": "#/$defs/non_empty_string" },
            "expires_at": { "type": "string", "format": "date" },
            "reason": { "$ref": "#/$defs/non_empty_string" }
          }
        }
      ]
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "signed_off": { "type": "boolean" },
        "signed_at": { "$ref": "#/$defs/nullable_date" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "family",
        "import_kind",
        "title",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "declared_label",
        "support_class",
        "provenance",
        "ownership",
        "divergence",
        "decision",
        "generator",
        "controls",
        "manifest_scan_posture",
        "surface_posture",
        "scan_ref",
        "surface_ref",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "import_state",
        "active_reasons",
        "effective_label",
        "surfaces",
        "rationale"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "import_kind": { "$ref": "#/$defs/import_kind" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" },
        "declared_label": { "$ref": "#/$defs/lifecycle_label" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "provenance": { "$ref": "#/$defs/import_provenance" },
        "ownership": { "$ref": "#/$defs/update_ownership" },
        "divergence": { "$ref": "#/$defs/divergence_profile" },
        "decision": { "$ref": "#/$defs/decision_record" },
        "generator": { "$ref": "#/$defs/generator_provenance" },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" },
          "minItems": 6
        },
        "manifest_scan_posture": { "$ref": "#/$defs/posture" },
        "surface_posture": { "$ref": "#/$defs/posture" },
        "scan_ref": { "$ref": "#/$defs/non_empty_string" },
        "surface_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "import_state": { "$ref": "#/$defs/import_state" },
        "active_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/import_reason" },
          "uniqueItems": true
        },
        "effective_label": { "$ref": "#/$defs/lifecycle_label" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "manifest_surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parity_gate",
        "subjects_total",
        "subjects_in_agreement",
        "subjects_in_disagreement",
        "subjects_with_gaps",
        "all_subjects_agree",
        "rationale"
      ],
      "properties": {
        "parity_gate": { "$ref": "#/$defs/non_empty_string" },
        "subjects_total": { "type": "integer", "minimum": 0 },
        "subjects_in_agreement": { "type": "integer", "minimum": 0 },
        "subjects_in_disagreement": { "type": "integer", "minimum": 0 },
        "subjects_with_gaps": { "type": "integer", "minimum": 0 },
        "all_subjects_agree": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_record_ids",
        "rationale"
      ],
      "properties": {
        "publication_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/publication_decision" },
        "blocking_rule_ids": { "$ref": "#/$defs/ref_array" },
        "blocking_record_ids": { "$ref": "#/$defs/ref_array" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_records",
        "records_cleared",
        "records_narrowed",
        "state_cleared",
        "state_narrowed_provenance",
        "state_narrowed_ownership",
        "state_narrowed_divergence",
        "state_narrowed_generator",
        "state_narrowed_stale",
        "state_withdrawn",
        "release_blocking_total",
        "release_blocking_narrowed",
        "records_on_active_waiver",
        "provenance_gaps",
        "ownership_gaps",
        "divergence_gaps",
        "generator_gaps",
        "third_party_imports",
        "generated_artifacts",
        "long_lived_imports",
        "decisions_recorded",
        "total_active_reasons",
        "rules_firing"
      ],
      "properties": {
        "total_records": { "type": "integer", "minimum": 0 },
        "records_cleared": { "type": "integer", "minimum": 0 },
        "records_narrowed": { "type": "integer", "minimum": 0 },
        "state_cleared": { "type": "integer", "minimum": 0 },
        "state_narrowed_provenance": { "type": "integer", "minimum": 0 },
        "state_narrowed_ownership": { "type": "integer", "minimum": 0 },
        "state_narrowed_divergence": { "type": "integer", "minimum": 0 },
        "state_narrowed_generator": { "type": "integer", "minimum": 0 },
        "state_narrowed_stale": { "type": "integer", "minimum": 0 },
        "state_withdrawn": { "type": "integer", "minimum": 0 },
        "release_blocking_total": { "type": "integer", "minimum": 0 },
        "release_blocking_narrowed": { "type": "integer", "minimum": 0 },
        "records_on_active_waiver": { "type": "integer", "minimum": 0 },
        "provenance_gaps": { "type": "integer", "minimum": 0 },
        "ownership_gaps": { "type": "integer", "minimum": 0 },
