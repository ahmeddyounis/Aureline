{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/ship_clean_room_rebuild_exact_build_symbolication_release_center_sync_and_advisory_revocation_rehearsal_automation_for_m5_depth_trains.schema.json",
  "title": "M5 Rehearsal-Automation Register",
  "description": "Canonical typed register that automates clean-room rebuild, exact-build symbolication, release-center sync, and advisory/revocation rehearsals for every claimed M5 artifact family. Claim-narrowing, shiproom dashboards, the evidence index, and support exports ingest this directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "publication_matrix_ref",
    "clean_room_proof_ref",
    "exact_build_identity_ref",
    "release_center_ref",
    "advisory_register_ref",
    "lifecycle_labels",
    "family_kinds",
    "rehearsal_kinds",
    "rehearsal_results",
    "rebuild_provenances",
    "automation_states",
    "gap_reasons",
    "stop_rule_actions",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "rows",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "ship_clean_room_rebuild_exact_build_symbolication_release_center_sync_and_advisory_revocation_rehearsal_automation_for_m5_depth_trains"
    },
    "register_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "publication_matrix_ref": { "type": "string", "minLength": 1 },
    "clean_room_proof_ref": { "type": "string", "minLength": 1 },
    "exact_build_identity_ref": { "type": "string", "minLength": 1 },
    "release_center_ref": { "type": "string", "minLength": 1 },
    "advisory_register_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "family_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/family_kind" }
    },
    "rehearsal_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/rehearsal_kind" }
    },
    "rehearsal_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/rehearsal_result" }
    },
    "rebuild_provenances": {
      "type": "array",
      "items": { "$ref": "#/$defs/rebuild_provenance" }
    },
    "automation_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/automation_state" }
    },
    "gap_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap_reason" }
    },
    "stop_rule_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/stop_rule_action" }
    },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop_rule" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family_row" }
    },
    "promotion": { "$ref": "#/$defs/promotion_record" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family_kind": {
      "type": "string",
      "enum": [
        "notebook_pack",
        "request_data_asset",
        "profiler_replay_artifact",
        "framework_template_pack",
        "docs_pack",
        "model_pack",
        "companion_offboarding_packet",
        "managed_output"
      ]
    },
    "rehearsal_kind": {
      "type": "string",
      "enum": [
        "clean_room_rebuild",
        "exact_build_symbolication",
        "release_center_sync",
        "advisory_revocation_drill"
      ]
    },
    "rehearsal_result": {
      "type": "string",
      "enum": ["passed", "failed", "not_run"]
    },
    "rebuild_provenance": {
      "type": "string",
      "enum": ["from_clean_state", "warm_cache_only", "not_applicable"]
    },
    "automation_state": {
      "type": "string",
      "enum": [
        "current",
        "on_waiver",
        "narrowed_stale",
        "narrowed_missing",
        "narrowed_failed",
        "narrowed_unbacked",
        "narrowed_waiver_expired"
      ]
    },
    "gap_reason": {
      "type": "string",
      "enum": [
        "claim_label_narrowed",
        "rehearsal_packet_missing",
        "rehearsal_packet_stale",
        "rehearsal_failed",
        "rebuild_cache_only",
        "symbolication_freshness_decoupled",
        "evidence_incomplete",
        "waiver_expired",
        "owner_signoff_missing"
      ]
    },
    "stop_rule_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "narrow_label",
        "rerun_rehearsal",
        "refresh_evidence",
        "recouple_freshness",
        "request_owner_signoff"
      ]
    },
    "slo_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "type": "string", "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "type": "string", "enum": ["lts", "stable"] }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "type": "string", "enum": ["beta", "preview", "withdrawn"] }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "proof_index_ref",
        "freshness_slo",
        "slo_state"
      ],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": {
          "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
        },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/slo_state" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rehearsal_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "result", "proof_packet", "rebuild_provenance", "rationale"],
      "properties": {
        "kind": { "$ref": "#/$defs/rehearsal_kind" },
        "result": { "$ref": "#/$defs/rehearsal_result" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "rebuild_provenance": { "$ref": "#/$defs/rebuild_provenance" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/gap_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_rule_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["waiver_ref", "expires_at", "reason"],
          "properties": {
            "waiver_ref": { "type": "string", "minLength": 1 },
            "expires_at": { "type": "string", "format": "date" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": {
          "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
        }
      }
    },
    "family_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "family_kind",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "claim_ref",
        "claim_label",
        "automation_state",
        "rehearsals",
        "owner_signoff",
        "published_label",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "family_kind": { "$ref": "#/$defs/family_kind" },
        "subject_ref": { "type": "string", "minLength": 1 },
        "subject_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "automation_state": { "$ref": "#/$defs/automation_state" },
        "rehearsals": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/rehearsal_record" }
        },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_gap_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap_reason" }
        },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "publication_destinations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocking_claim_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_entries",
        "total_claims",
        "entries_holding_stable",
        "entries_narrowed",
        "entries_on_active_waiver",
        "release_blocking_total",
        "release_blocking_holding",
        "release_blocking_narrowed",
        "notebook_pack_entries",
        "request_data_asset_entries",
        "profiler_replay_artifact_entries",
        "framework_template_pack_entries",
        "docs_pack_entries",
        "model_pack_entries",
        "companion_offboarding_packet_entries",
        "managed_output_entries",
        "rehearsals_current",
        "rehearsals_due_for_refresh",
        "rehearsals_breached",
        "rehearsals_missing",
        "rehearsals_passed",
        "rehearsals_failed",
        "rehearsals_not_run",
        "rebuild_cache_only_entries",
        "symbolication_decoupled_entries",
        "total_active_gap_reasons",
        "rules_firing"
      ],
      "properties": {
        "total_entries": { "type": "integer", "minimum": 0 },
        "total_claims": { "type": "integer", "minimum": 0 },
        "entries_holding_stable": { "type": "integer", "minimum": 0 },
        "entries_narrowed": { "type": "integer", "minimum": 0 },
        "entries_on_active_waiver": { "type": "integer", "minimum": 0 },
        "release_blocking_total": { "type": "integer", "minimum": 0 },
        "release_blocking_holding": { "type": "integer", "minimum": 0 },
        "release_blocking_narrowed": { "type": "integer", "minimum": 0 },
        "notebook_pack_entries": { "type": "integer", "minimum": 0 },
        "request_data_asset_entries": { "type": "integer", "minimum": 0 },
        "profiler_replay_artifact_entries": { "type": "integer", "minimum": 0 },
        "framework_template_pack_entries": { "type": "integer", "minimum": 0 },
        "docs_pack_entries": { "type": "integer", "minimum": 0 },
        "model_pack_entries": { "type": "integer", "minimum": 0 },
        "companion_offboarding_packet_entries": { "type": "integer", "minimum": 0 },
        "managed_output_entries": { "type": "integer", "minimum": 0 },
        "rehearsals_current": { "type": "integer", "minimum": 0 },
        "rehearsals_due_for_refresh": { "type": "integer", "minimum": 0 },
        "rehearsals_breached": { "type": "integer", "minimum": 0 },
        "rehearsals_missing": { "type": "integer", "minimum": 0 },
        "rehearsals_passed": { "type": "integer", "minimum": 0 },
        "rehearsals_failed": { "type": "integer", "minimum": 0 },
        "rehearsals_not_run": { "type": "integer", "minimum": 0 },
        "rebuild_cache_only_entries": { "type": "integer", "minimum": 0 },
        "symbolication_decoupled_entries": { "type": "integer", "minimum": 0 },
        "total_active_gap_reasons": { "type": "integer", "minimum": 0 },
        "rules_firing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
