{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/governance/m5-boundary-and-upstream-durability.schema.json",
  "title": "Aureline open/local-boundary, repository-compliance, third-party-import, and maintainer/signer-durability matrix",
  "description": "Canonical, machine-readable matrix that freezes, per asset lane, the open-versus-paid boundary posture, the repository-compliance and third-party-import controls, the emergency signing/registry/security authority, and the continuity rules. Each row narrows on the specific axis that thins out (boundary drift, compliance, authority, continuity, or stale proof) and drops its effective label below the launch cutline; an inherited or waived narrowing is gated upstream while a durability-layer failure on a still-stable lane holds publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "matrix_id",
    "status",
    "overview_page",
    "as_of",
    "source_contract_refs",
    "boundary_cutline",
    "asset_lanes",
    "boundary_postures",
    "support_classes",
    "control_dimensions",
    "durability_states",
    "durability_reasons",
    "matrix_actions",
    "rules",
    "rows",
    "publication",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_boundary_and_upstream_durability_matrix" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
    "boundary_cutline": { "$ref": "#/$defs/boundary_cutline" },
    "asset_lanes": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset_lane" },
      "minItems": 1,
      "uniqueItems": true
    },
    "boundary_postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary_posture" },
      "minItems": 1,
      "uniqueItems": true
    },
    "support_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/support_class" },
      "minItems": 1,
      "uniqueItems": true
    },
    "control_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_dimension" },
      "minItems": 1,
      "uniqueItems": true
    },
    "durability_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/durability_state" },
      "minItems": 1,
      "uniqueItems": true
    },
    "durability_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/durability_reason" },
      "minItems": 1,
      "uniqueItems": true
    },
    "matrix_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/matrix_action" },
      "minItems": 1,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 1
    },
    "publication": { "$ref": "#/$defs/publication" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "nullable_date": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "asset_lane": {
      "type": "string",
      "enum": [
        "core_desktop_client_platform",
        "sdk_schema_contract",
        "docs_migration_pack",
        "marketplace_protocol",
        "managed_service",
        "restricted_brand_asset"
      ]
    },
    "boundary_posture": {
      "type": "string",
      "enum": [
        "open_local_core",
        "open_local_with_managed_optional",
        "source_available_restricted",
        "managed_service",
        "restricted_brand"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["open_local", "mixed_open_managed", "managed", "restricted"]
    },
    "control_dimension": {
      "type": "string",
      "enum": [
        "contribution_provenance",
        "file_level_licensing",
        "third_party_import",
        "generated_code_attribution",
        "sbom_and_notices",
        "signer_coverage",
        "registry_emergency_action",
        "security_response",
        "critical_upstream_ownership"
      ]
    },
    "control_state": {
      "type": "string",
      "enum": ["satisfied", "unsatisfied", "not_applicable"]
    },
    "backup_coverage": {
      "type": "string",
      "enum": ["covered", "waived", "uncovered"]
    },
    "risk_class": {
      "type": "string",
      "enum": ["low", "medium", "high", "blocked"]
    },
    "freshness_slo_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "durability_state": {
      "type": "string",
      "enum": [
        "durable",
        "narrowed_boundary_drift",
        "narrowed_compliance_gap",
        "narrowed_authority_gap",
        "narrowed_continuity_gap",
        "narrowed_stale",
        "withdrawn"
      ]
    },
    "durability_reason": {
      "type": "string",
      "enum": [
        "boundary_baseline_violated",
        "compliance_control_unsatisfied",
        "signer_quorum_unmet",
        "emergency_authority_owner_missing",
        "single_point_of_failure",
        "backup_coverage_missing",
        "critical_upstream_unowned",
        "proof_freshness_breached",
        "proof_packet_missing",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "matrix_action": {
      "type": "string",
      "enum": [
        "hold_publication",
        "restore_open_baseline",
        "narrow_boundary_label",
        "satisfy_compliance_control",
        "assign_emergency_authority",
        "add_backup_coverage",
        "refresh_proof_packet",
        "request_owner_signoff"
      ]
    },
    "publication_decision": {
      "type": "string",
      "enum": ["proceed", "hold"]
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_paid_boundary_audit_ref",
        "signing_quorum_ref",
        "third_party_import_manifest_ref",
        "critical_upstream_health_ref",
        "maintainer_coverage_policy_ref",
        "security_severity_matrix_ref"
      ],
      "properties": {
        "open_paid_boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "signing_quorum_ref": { "$ref": "#/$defs/non_empty_string" },
        "third_party_import_manifest_ref": { "$ref": "#/$defs/non_empty_string" },
        "critical_upstream_health_ref": { "$ref": "#/$defs/non_empty_string" },
        "maintainer_coverage_policy_ref": { "$ref": "#/$defs/non_empty_string" },
        "security_severity_matrix_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "boundary_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "open_baseline_postures",
        "description"
      ],
      "properties": {
        "cutline_level": { "type": "string", "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "open_baseline_postures": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundary_posture" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_publication",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/durability_reason" },
        "applies_to_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" },
          "minItems": 1
        },
        "default_action": { "$ref": "#/$defs/matrix_action" },
        "blocks_publication": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/nullable_date" },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_slo_state" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" }
      }
    },
    "control_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "control_ref", "owner_ref", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/control_dimension" },
        "control_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/control_state" }
      }
    },
    "signer_quorum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_distinct_humans", "available_distinct_humans", "quorum_profile_ref"],
      "properties": {
        "required_distinct_humans": { "type": "integer", "minimum": 0 },
        "available_distinct_humans": { "type": "integer", "minimum": 0 },
        "quorum_profile_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "emergency_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_owner_ref",
        "backup_owner_refs",
        "signer_quorum",
        "registry_emergency_owner_ref",
        "security_response_owner_ref"
      ],
      "properties": {
        "primary_owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "backup_owner_refs": { "$ref": "#/$defs/ref_array" },
        "signer_quorum": { "$ref": "#/$defs/signer_quorum" },
        "registry_emergency_owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "security_response_owner_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "critical_upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_ref", "owner_ref", "risk_class", "fork_replace_plan_ref"],
      "properties": {
        "upstream_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_ref": { "type": "string" },
        "risk_class": { "$ref": "#/$defs/risk_class" },
        "fork_replace_plan_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "continuity_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_coverage", "single_point_of_failure", "critical_upstreams"],
      "properties": {
        "backup_coverage": { "$ref": "#/$defs/backup_coverage" },
        "single_point_of_failure": { "type": "boolean" },
        "critical_upstreams": {
          "type": "array",
          "items": { "$ref": "#/$defs/critical_upstream" }
        }
      }
    },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["waiver_ref", "expires_at", "reason"],
          "properties": {
            "waiver_ref": { "$ref": "#/$defs/non_empty_string" },
            "expires_at": { "type": "string", "format": "date" },
            "reason": { "$ref": "#/$defs/non_empty_string" }
          }
        }
      ]
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "signed_off": { "type": "boolean" },
        "signed_at": { "$ref": "#/$defs/nullable_date" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "asset_lane",
        "subject_ref",
        "subject_summary",
        "release_blocking",
        "must_remain_open",
        "boundary_posture",
        "support_class",
        "declared_label",
        "compliance_controls",
        "emergency_authority",
        "continuity",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "durability_state",
        "active_reasons",
        "effective_label",
        "reuse_destinations",
        "rationale"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "asset_lane": { "$ref": "#/$defs/asset_lane" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" },
        "must_remain_open": { "type": "boolean" },
        "boundary_posture": { "$ref": "#/$defs/boundary_posture" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "declared_label": { "$ref": "#/$defs/lifecycle_label" },
        "compliance_controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control_binding" },
          "minItems": 1
        },
        "emergency_authority": { "$ref": "#/$defs/emergency_authority" },
        "continuity": { "$ref": "#/$defs/continuity_coverage" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "durability_state": { "$ref": "#/$defs/durability_state" },
        "active_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/durability_reason" },
          "uniqueItems": true
        },
        "effective_label": { "$ref": "#/$defs/lifecycle_label" },
        "reuse_destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_row_ids",
        "rationale"
      ],
      "properties": {
        "publication_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/publication_decision" },
        "blocking_rule_ids": { "$ref": "#/$defs/ref_array" },
        "blocking_row_ids": { "$ref": "#/$defs/ref_array" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "rows_durable",
        "rows_narrowed",
        "state_durable",
        "state_narrowed_boundary_drift",
        "state_narrowed_compliance_gap",
        "state_narrowed_authority_gap",
        "state_narrowed_continuity_gap",
        "state_narrowed_stale",
        "state_withdrawn",
        "must_remain_open_rows",
        "open_baseline_rows",
        "release_blocking_total",
        "release_blocking_durable",
        "release_blocking_narrowed",
        "rows_on_active_waiver",
        "total_controls",
        "controls_satisfied",
        "controls_unsatisfied",
        "controls_not_applicable",
        "packets_current",
        "packets_due_for_refresh",
        "packets_breached",
        "packets_missing",
        "total_active_reasons",
        "rules_firing"
      ],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "rows_durable": { "type": "integer", "minimum": 0 },
        "rows_narrowed": { "type": "integer", "minimum": 0 },
        "state_durable": { "type": "integer", "minimum": 0 },
        "state_narrowed_boundary_drift": { "type": "integer", "minimum": 0 },
        "state_narrowed_compliance_gap": { "type": "integer", "minimum": 0 },
        "state_narrowed_authority_gap": { "type": "integer", "minimum": 0 },
        "state_narrowed_continuity_gap": { "type": "integer", "minimum": 0 },
        "state_narrowed_stale": { "type": "integer", "minimum": 0 },
        "state_withdrawn": { "type": "integer", "minimum": 0 },
        "must_remain_open_rows": { "type": "integer", "minimum": 0 },
        "open_baseline_rows": { "type": "integer", "minimum": 0 },
        "release_blocking_total": { "type": "integer", "minimum": 0 },
        "release_blocking_durable": { "type": "integer", "minimum": 0 },
        "release_blocking_narrowed": { "type": "integer", "minimum": 0 },
        "rows_on_active_waiver": { "type": "integer", "minimum": 0 },
        "total_controls": { "type": "integer", "minimum": 0 },
        "controls_satisfied": { "type": "integer", "minimum": 0 },
        "controls_unsatisfied": { "type": "integer", "minimum": 0 },
        "controls_not_applicable": { "type": "integer", "minimum": 0 },
        "packets_current": { "type": "integer", "minimum": 0 },
        "packets_due_for_refresh": { "type": "integer", "minimum": 0 },
        "packets_breached": { "type": "integer", "minimum": 0 },
        "packets_missing": { "type": "integer", "minimum": 0 },
        "total_active_reasons": { "type": "integer", "minimum": 0 },
        "rules_firing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
