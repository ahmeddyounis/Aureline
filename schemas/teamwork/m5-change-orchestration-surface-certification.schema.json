{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/teamwork/m5-change-orchestration-surface-certification.schema.json",
  "title": "Aureline M5 change-orchestration surface certification packet",
  "description": "M05-1303 closing B154 capstone certifying that the frozen M5 change-orchestration object classes (change object, patch-stack / queue, stack-edit / review sheet, landing-candidate sheet, portable shelf / bundle, worktree cleanup preview) hold their change-orchestration truth on every claimed M5 Git, review, AI, work-item, provider, help, and support / export surface. Keyed on the claimed consumer profile (fully-certified change-orchestration lane, reviewable change-object record structure, unbound-worktree-binding profile, inferred-stack-membership profile, silently-reordered-stack profile, ambient-branch-landing profile, stale-validation-shelf profile, partial-cleanup-evidence profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and change-orchestration-truth behavior — and either passes (green), auto-narrows its change-orchestration claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a fully-certified change-orchestration lane whose selected change object, worktree / base identity, stack membership and order, landing state, validation freshness, and cleanup evidence all converge on one export-safe, provider-authoritative, internally consistent record may certify a certified change-orchestration record; and every B154 hard invariant must hold (stack membership is never inferred from branch names alone; another worktree is never mutated without an explicit selected change object and worktree binding; stack members are never silently reordered, collapsed, or retargeted; Aureline never lands from ambient branch state; and an orphaned worktree or stale member is never deleted without previewing running tasks, open editors, uncommitted changes, recovery checkpoints, and export-safe evidence). Every row cites exactly one canonical change-orchestration matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_change_orchestration_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-change-orchestration-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "certified_change_orchestration_lane",
        "reviewable_change_orchestration_record_structure",
        "unbound_worktree_binding_profile",
        "inferred_stack_membership_profile",
        "silently_reordered_stack_profile",
        "ambient_branch_landing_profile",
        "stale_validation_shelf_profile",
        "partial_cleanup_evidence_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "change_orchestration_truth"
      ]
    },
    "change_orchestration_claim": {
      "enum": [
        "certified_change_orchestration_truth",
        "reviewable_change_orchestration_record",
        "worktree_binding_unverified_projection",
        "stack_membership_unverified_projection",
        "stack_order_unverified_projection",
        "landing_authority_unverified_projection",
        "validation_freshness_unverified_projection",
        "cleanup_evidence_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "change_object",
        "patch_stack_queue",
        "stack_edit_review_sheet",
        "landing_candidate_sheet",
        "portable_shelf",
        "worktree_cleanup_preview"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "stack_membership_inferred_from_branch_name_alone",
        "cross_worktree_write_without_selected_change_object",
        "stack_members_silently_reordered",
        "landed_from_ambient_branch_state",
        "orphan_deleted_without_safety_preview",
        "selected_change_object_unstated",
        "worktree_binding_unstated",
        "stack_membership_source_unstated",
        "stack_order_unstated",
        "landing_state_unstated",
        "validation_freshness_unstated",
        "change_orchestration_matrix_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infers_stack_membership_from_branch_names_alone",
        "mutates_another_worktree_without_a_selected_change_object_and_worktree_binding",
        "silently_reorders_collapses_or_retargets_stack_members",
        "lands_from_ambient_branch_state",
        "deletes_orphaned_worktrees_or_stale_members_without_previewing_running_work_and_recovery"
      ],
      "properties": {
        "infers_stack_membership_from_branch_names_alone": { "const": false },
        "mutates_another_worktree_without_a_selected_change_object_and_worktree_binding": { "const": false },
        "silently_reorders_collapses_or_retargets_stack_members": { "const": false },
        "lands_from_ambient_branch_state": { "const": false },
        "deletes_orphaned_worktrees_or_stale_members_without_previewing_running_work_and_recovery": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/change_orchestration_claim" },
        "to_claim": { "$ref": "#/$defs/change_orchestration_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_change_orchestration_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/change_orchestration_claim" },
        "certified_claim": { "$ref": "#/$defs/change_orchestration_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-change-orchestration-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
