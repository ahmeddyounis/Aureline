{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/teamwork/m5-change-intent-lifecycle-matrix.schema.json",
  "title": "Aureline M5 change-intent, start-work-sheet, linked-change-panel, ready-for-review-handoff, resolve-close-sheet, and blocked-escalate-card matrix",
  "description": "Export-safe packet freezing Aureline's change-intent lifecycle model \u2014 the durable change-intent record, the start-work sheet, the linked-change panel, the ready-for-review handoff sheet, the resolve-or-close sheet, and the blocked-or-escalate card a work-item-driven consumer must treat as first-class, durable, provider-aware engineering objects. The packet names every covered object class and binds each to the claimed surface families that render it, the classification stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain change-intent / start-work / linked-change / handoff / resolve / blocker schema, the required visible state (surface label, provider ownership, local-versus-provider state, linked engineering identity, relation source, blocker state, and validation evidence), and the mandatory labels it must show (identity, lifecycle_role, canonical_reference, plus provider_commit_state, relation_source, blocker_state). The commit_state field makes a provider-committed update mechanically distinct from a local-only draft. Hard invariants forbid start work silently creating a branch / worktree / review draft / provider link without disclosure, a local handoff packet or queued publish masquerading as a provider-committed update, flattening the four relation sources into one badge, auto-resolving tracked work while engineering blockers remain, and dropping local notes / handoff packets / linked evidence when a provider write fails. The matrix binds back to the already-landed stable-proof-index and migration-task-row packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "change_intent_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_change_intent_start_work_handoff_resolve_and_blocker_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "change_intent_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/change_intent_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "change_intent_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "change_intent_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "change_intent_record",
        "start_work_sheet",
        "linked_change_panel",
        "ready_for_review_handoff_sheet",
        "resolve_close_sheet",
        "blocked_escalate_card"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "commit_state": {
      "enum": [
        "provider_committed",
        "local_only_draft",
        "queued_for_publish",
        "publish_failed_retained",
        "provider_unavailable",
        "offline_handoff_packet",
        "stale_relative_to_provider"
      ]
    },
    "semantic_role": {
      "enum": [
        "provider_ownership_disclosure",
        "local_versus_provider_state_disclosure",
        "linked_engineering_identity_disclosure",
        "side_effect_disclosure",
        "validation_evidence_disclosure",
        "publish_later_fallback_disclosure",
        "final_resolution_authority_disclosure"
      ]
    },
    "required_visible_state": {
      "type": "object",
      "required": [
        "surface_label",
        "provider_ownership",
        "local_versus_provider_state",
        "linked_engineering_identity",
        "relation_source_state",
        "blocker_state",
        "validation_evidence"
      ],
      "properties": {
        "surface_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider_ownership": {
          "$ref": "#/$defs/non_empty_string"
        },
        "local_versus_provider_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "linked_engineering_identity": {
          "$ref": "#/$defs/non_empty_string"
        },
        "relation_source_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "blocker_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "validation_evidence": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "change_intent_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "commit_state",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "required_visible_state",
        "surface_families",
        "classification_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "lets_start_work_silently_create_a_side_effect_without_disclosure",
        "lets_a_local_handoff_packet_or_queued_publish_masquerade_as_a_provider_committed_update",
        "flattens_linked_by_provider_linked_locally_suggested_and_stale_into_one_relation_badge",
        "auto_resolves_tracked_work_while_engineering_blockers_remain_unresolved",
        "drops_local_notes_handoff_packets_or_linked_evidence_when_provider_write_fails"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "commit_state": {
          "$ref": "#/$defs/commit_state"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_visible_state": {
          "$ref": "#/$defs/required_visible_state"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "classification_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "change_intent_record_roles": {
          "type": "array"
        },
        "start_work_roles": {
          "type": "array"
        },
        "linked_change_roles": {
          "type": "array"
        },
        "handoff_roles": {
          "type": "array"
        },
        "resolve_roles": {
          "type": "array"
        },
        "blocked_escalate_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "lets_start_work_silently_create_a_side_effect_without_disclosure": {
          "const": false
        },
        "lets_a_local_handoff_packet_or_queued_publish_masquerade_as_a_provider_committed_update": {
          "const": false
        },
        "flattens_linked_by_provider_linked_locally_suggested_and_stale_into_one_relation_badge": {
          "const": false
        },
        "auto_resolves_tracked_work_while_engineering_blockers_remain_unresolved": {
          "const": false
        },
        "drops_local_notes_handoff_packets_or_linked_evidence_when_provider_write_fails": {
          "const": false
        }
      }
    }
  }
}
