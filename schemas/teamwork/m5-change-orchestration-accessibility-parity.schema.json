{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/teamwork/m5-change-orchestration-accessibility-parity.schema.json",
  "title": "Aureline M5 change-orchestration accessibility & auto-narrowing parity",
  "description": "Export-safe packet for the M05-1302 keyboard / screen-reader / high-zoom / high-contrast / CLI / export parity and honest auto-narrowing capstone over the frozen M5 change-object, patch-stack, and landing matrix. Each row certifies one of the six canonical change-orchestration objects (change_object, patch_stack_queue, stack_edit_review_sheet, landing_candidate_sheet, portable_shelf, worktree_cleanup_preview) as keyboard-complete, assistive-tech-reachable, high-zoom / high-contrast-safe, CLI/export-safe, and self-narrowing. When a change object's selected worktree binding is unbound, a patch-stack queue's membership is inferred or unverifiable, a stack-edit review sheet's order is drifted or restack-required, a landing candidate's queue authority or protected-branch rule cannot be proven, a portable shelf's validation or approval evidence is stale, or a worktree-cleanup preview's evidence is partial, the object's claim auto-narrows from trusted_provider_landed_surface / local_reviewable_surface to a selected-change-binding-unverified / stack-membership-unverified / stack-order-unverified / landing-authority-unverified / validation-freshness-unverified / cleanup-evidence-unverified projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical object identity / last-known state. A local landing estimate never masquerades as a provider-authoritative land, ambient branch state is never shown as a reviewed landing candidate, and stack membership is never inferred from branch names alone. The packet is metadata-only: raw diff hunks, message payloads, credentials, secrets, and endpoint refs never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_change_orchestration_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 6
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "object": {
      "type": "string",
      "enum": [
        "change_object",
        "patch_stack_queue",
        "stack_edit_review_sheet",
        "landing_candidate_sheet",
        "portable_shelf",
        "worktree_cleanup_preview"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "change_orchestration_claim": {
      "type": "string",
      "enum": [
        "trusted_provider_landed_surface",
        "local_reviewable_surface",
        "selected_change_binding_unverified_projection",
        "stack_membership_unverified_projection",
        "stack_order_unverified_projection",
        "landing_authority_unverified_projection",
        "validation_freshness_unverified_projection",
        "cleanup_evidence_unverified_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "selected_change_binding_clarity",
        "stack_membership_clarity",
        "stack_order_integrity_clarity",
        "landing_authority_clarity",
        "validation_freshness_clarity",
        "cleanup_evidence_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "fully_qualified",
        "selected_change_binding_unbound",
        "stack_membership_inferred_or_unverifiable",
        "stack_order_drifted_or_restack_required",
        "queue_or_protected_branch_unprovable",
        "validation_or_approval_stale",
        "cleanup_evidence_partial"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "stack_membership_inferred_from_branch_name_alone",
        "cross_worktree_write_without_selected_change_object",
        "stack_members_silently_reordered",
        "landed_from_ambient_branch_state",
        "orphan_deleted_without_safety_preview",
        "selected_change_object_unstated",
        "worktree_binding_unstated",
        "stack_membership_source_unstated",
        "stack_order_unstated",
        "landing_state_unstated",
        "validation_freshness_unstated",
        "change_orchestration_matrix_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "lifecycle_role",
        "canonical_reference",
        "landing_state",
        "stack_membership_source",
        "cleanup_safety"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "change_object_detail",
        "patch_stack_queue",
        "stack_edit_review_sheet",
        "review_detail",
        "provider_merge_queue",
        "portable_shelf",
        "worktree_cleanup_preview",
        "support_export_packet",
        "help_docs"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_truth_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/change_orchestration_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_truth_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "object",
        "source_object_schema_ref",
        "object_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "high_zoom_reach",
        "high_contrast_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_ready_claim",
        "claim_conditions",
        "truth_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_change_orchestration_accessibility_parity_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/object" },
        "source_object_schema_ref": { "type": "string", "minLength": 1 },
        "object_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_zoom_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_contrast_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_ready_claim": { "$ref": "#/$defs/change_orchestration_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "truth_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "object_count",
        "structure_heavy_object_count",
        "all_structure_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_trusted_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_truth_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "object_count": { "type": "integer", "minimum": 0 },
        "structure_heavy_object_count": { "type": "integer", "minimum": 0 },
        "all_structure_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_trusted_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_truth_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
