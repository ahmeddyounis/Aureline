{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/teamwork/m5-change-intent-shared-consumers.schema.json",
  "title": "M5 Change-Intent Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the six B153 change-intent lifecycle objects (change-intent record, start-work sheet, linked-change panel, ready-for-review handoff sheet, resolve-or-close sheet, blocked-or-escalate card) to the work-item-detail / start-work-sheet / linked-change-panel / review-detail / ready-for-review-handoff / resolve-close-sheet / blocked-escalate-card / support-export / help-docs consumers that render them, proving one shared change-intent vocabulary across the work-item, review, Git / worktree, AI-evidence, support / export, and provider-handoff surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_change_intent_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "change_intent_object": {
      "type": "string",
      "enum": [
        "change_intent_record",
        "start_work_sheet",
        "linked_change_panel",
        "ready_for_review_handoff_sheet",
        "resolve_close_sheet",
        "blocked_escalate_card"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "work_item_detail",
        "start_work_sheet",
        "linked_change_panel",
        "review_detail",
        "ready_for_review_handoff",
        "resolve_close_sheet",
        "blocked_escalate_card",
        "support_export_packet",
        "help_docs"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "vocabulary_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "change_intent_vocabulary_drift_detected",
        "relation_source_or_commit_state_disclosure_dropped",
        "lets_a_local_handoff_or_queued_publish_masquerade_as_a_provider_committed_update",
        "silently_creates_a_branch_worktree_review_draft_or_provider_link_without_disclosure",
        "flattens_linked_by_provider_linked_locally_suggested_and_stale_or_broken_into_one_relation_badge",
        "auto_resolves_tracked_work_while_engineering_blockers_remain_unresolved",
        "drops_local_notes_handoff_packets_or_linked_evidence_when_provider_write_fails",
        "canonical_registry_reference_missing",
        "upstream_change_intent_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_intent_role_word",
        "object_word",
        "registry_reference_word",
        "commit_state_word",
        "surface_context_word",
        "relation_source_word"
      ],
      "properties": {
        "change_intent_role_word": {
          "type": "string",
          "enum": [
            "provider_ownership_disclosure",
            "local_versus_provider_state_disclosure",
            "linked_engineering_identity_disclosure",
            "side_effect_disclosure",
            "validation_evidence_disclosure",
            "publish_later_fallback_disclosure",
            "final_resolution_authority_disclosure"
          ]
        },
        "object_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "commit_state_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "relation_source_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "subject_id",
        "subject_label",
        "object",
        "consumer",
        "representation",
        "state_facets",
        "vocabulary_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "lets_a_local_handoff_or_queued_publish_masquerade_as_a_provider_committed_update",
        "silently_creates_a_branch_worktree_review_draft_or_provider_link_without_disclosure",
        "flattens_linked_by_provider_linked_locally_suggested_and_stale_or_broken_into_one_relation_badge",
        "auto_resolves_tracked_work_while_engineering_blockers_remain_unresolved",
        "drops_local_notes_handoff_packets_or_linked_evidence_when_provider_write_fails",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "subject_label": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/change_intent_object" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "vocabulary_state": { "$ref": "#/$defs/vocabulary_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "lets_a_local_handoff_or_queued_publish_masquerade_as_a_provider_committed_update": {
          "type": "boolean",
          "const": false
        },
        "silently_creates_a_branch_worktree_review_draft_or_provider_link_without_disclosure": {
          "type": "boolean",
          "const": false
        },
        "flattens_linked_by_provider_linked_locally_suggested_and_stale_or_broken_into_one_relation_badge": {
          "type": "boolean",
          "const": false
        },
        "auto_resolves_tracked_work_while_engineering_blockers_remain_unresolved": {
          "type": "boolean",
          "const": false
        },
        "drops_local_notes_handoff_packets_or_linked_evidence_when_provider_write_fails": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "vocabulary_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "vocabulary_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_reuse_proven_by_fixtures",
        "same_subject_same_change_intent_vocabulary_across_surfaces",
        "change_intent_role_words_stay_in_frozen_vocabulary",
        "gate_roles_never_let_local_draft_read_as_provider_committed",
        "side_effects_never_created_without_separate_disclosure",
        "relation_sources_never_flattened_into_one_badge",
        "tracked_work_never_auto_resolved_while_blockers_remain",
        "local_notes_handoff_and_linked_evidence_never_dropped_on_provider_write_failure",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "copy_export_open_provider_preserve_one_payload",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "object_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_subject_same_change_intent_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "change_intent_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "gate_roles_never_let_local_draft_read_as_provider_committed": {
          "type": "boolean",
          "const": true
        },
        "side_effects_never_created_without_separate_disclosure": {
          "type": "boolean",
          "const": true
        },
        "relation_sources_never_flattened_into_one_badge": {
          "type": "boolean",
          "const": true
        },
        "tracked_work_never_auto_resolved_while_blockers_remain": {
          "type": "boolean",
          "const": true
        },
        "local_notes_handoff_and_linked_evidence_never_dropped_on_provider_write_failure": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "copy_export_open_provider_preserve_one_payload": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_detail_consumes_shared_change_intent_vocabulary",
        "start_work_sheet_consumes_shared_change_intent_vocabulary",
        "linked_change_panel_consumes_shared_change_intent_vocabulary",
        "ready_for_review_handoff_consumes_shared_change_intent_vocabulary",
        "work_item_detail_consumes_shared_change_intent_vocabulary",
        "resolve_close_sheet_consumes_shared_change_intent_vocabulary",
        "blocked_escalate_card_consumes_shared_change_intent_vocabulary",
        "support_export_packet_consumes_shared_change_intent_vocabulary",
        "help_docs_consumes_shared_change_intent_vocabulary",
        "every_object_adopted_by_two_or_more_consumers",
        "change_intent_vocabulary_identical_for_same_subject",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_change_intent_object"
      ],
      "properties": {
        "review_detail_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "start_work_sheet_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "linked_change_panel_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "ready_for_review_handoff_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "work_item_detail_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "resolve_close_sheet_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "blocked_escalate_card_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "support_export_packet_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "help_docs_consumes_shared_change_intent_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "every_object_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "change_intent_vocabulary_identical_for_same_subject": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_change_intent_object": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
