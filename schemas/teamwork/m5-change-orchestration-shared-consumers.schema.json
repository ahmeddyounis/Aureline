{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/teamwork/m5-change-orchestration-shared-consumers.schema.json",
  "title": "M5 Change-Orchestration Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the six B154 change-orchestration objects (change object, patch stack / queue, stack-edit / review sheet, landing-candidate sheet, portable shelf / bundle, worktree cleanup preview) to the change-object-detail / patch-stack-queue / stack-edit-review-sheet / review-detail / provider-merge-queue / portable-shelf / worktree-cleanup-preview / support-export / help-docs consumers that render them, proving one shared change-orchestration vocabulary across the Git / worktree, review, work-item, AI-branch-agent, support / export, and portable-handoff surfaces and enforcing that no surface treats ambient branch state as a reviewed landing candidate or mutates another worktree without an explicit selected change object and worktree binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_change_orchestration_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "change_orchestration_object": {
      "type": "string",
      "enum": [
        "change_object",
        "patch_stack_queue",
        "stack_edit_review_sheet",
        "landing_candidate_sheet",
        "portable_shelf",
        "worktree_cleanup_preview"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "change_object_detail",
        "patch_stack_queue",
        "stack_edit_review_sheet",
        "review_detail",
        "provider_merge_queue",
        "portable_shelf",
        "worktree_cleanup_preview",
        "support_export_packet",
        "help_docs"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "vocabulary_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "change_orchestration_vocabulary_drift_detected",
        "membership_source_or_landing_state_disclosure_dropped",
        "treats_ambient_branch_state_as_a_reviewed_landing_candidate",
        "mutates_another_worktree_without_a_selected_change_object_and_worktree_binding",
        "infers_stack_membership_from_branch_names_alone",
        "silently_reorders_collapses_or_retargets_stack_members",
        "deletes_orphaned_worktrees_or_stale_members_without_previewing_running_work_and_recovery",
        "canonical_registry_reference_missing",
        "upstream_change_orchestration_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_orchestration_role_word",
        "object_word",
        "registry_reference_word",
        "landing_state_word",
        "surface_context_word",
        "membership_source_word"
      ],
      "properties": {
        "change_orchestration_role_word": {
          "type": "string",
          "enum": [
            "selected_change_object_disclosure",
            "worktree_binding_disclosure",
            "stack_membership_disclosure",
            "landing_state_disclosure",
            "validation_freshness_disclosure",
            "rollback_export_fallback_disclosure",
            "cleanup_safety_disclosure"
          ]
        },
        "object_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "landing_state_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "membership_source_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "subject_id",
        "subject_label",
        "object",
        "consumer",
        "representation",
        "state_facets",
        "vocabulary_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "treats_ambient_branch_state_as_a_reviewed_landing_candidate",
        "mutates_another_worktree_without_a_selected_change_object_and_worktree_binding",
        "infers_stack_membership_from_branch_names_alone",
        "silently_reorders_collapses_or_retargets_stack_members",
        "deletes_orphaned_worktrees_or_stale_members_without_previewing_running_work_and_recovery",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "subject_label": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/change_orchestration_object" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "vocabulary_state": { "$ref": "#/$defs/vocabulary_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "treats_ambient_branch_state_as_a_reviewed_landing_candidate": {
          "type": "boolean",
          "const": false
        },
        "mutates_another_worktree_without_a_selected_change_object_and_worktree_binding": {
          "type": "boolean",
          "const": false
        },
        "infers_stack_membership_from_branch_names_alone": {
          "type": "boolean",
          "const": false
        },
        "silently_reorders_collapses_or_retargets_stack_members": {
          "type": "boolean",
          "const": false
        },
        "deletes_orphaned_worktrees_or_stale_members_without_previewing_running_work_and_recovery": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "vocabulary_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "vocabulary_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_reuse_proven_by_fixtures",
        "same_subject_same_change_orchestration_vocabulary_across_surfaces",
        "change_orchestration_role_words_stay_in_frozen_vocabulary",
        "gate_roles_never_let_ambient_branch_read_as_landing_candidate",
        "cross_worktree_writes_never_made_without_selected_change_binding",
        "stack_membership_never_inferred_from_branch_names",
        "stack_members_never_silently_reordered_collapsed_or_retargeted",
        "orphaned_worktrees_never_deleted_without_previewing_running_work_and_recovery",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "copy_export_open_provider_preserve_one_payload",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "object_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_subject_same_change_orchestration_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "change_orchestration_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "gate_roles_never_let_ambient_branch_read_as_landing_candidate": {
          "type": "boolean",
          "const": true
        },
        "cross_worktree_writes_never_made_without_selected_change_binding": {
          "type": "boolean",
          "const": true
        },
        "stack_membership_never_inferred_from_branch_names": {
          "type": "boolean",
          "const": true
        },
        "stack_members_never_silently_reordered_collapsed_or_retargeted": {
          "type": "boolean",
          "const": true
        },
        "orphaned_worktrees_never_deleted_without_previewing_running_work_and_recovery": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "copy_export_open_provider_preserve_one_payload": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_detail_consumes_shared_change_orchestration_vocabulary",
        "patch_stack_queue_consumes_shared_change_orchestration_vocabulary",
        "stack_edit_review_sheet_consumes_shared_change_orchestration_vocabulary",
        "provider_merge_queue_consumes_shared_change_orchestration_vocabulary",
        "change_object_detail_consumes_shared_change_orchestration_vocabulary",
        "portable_shelf_consumes_shared_change_orchestration_vocabulary",
        "worktree_cleanup_preview_consumes_shared_change_orchestration_vocabulary",
        "support_export_packet_consumes_shared_change_orchestration_vocabulary",
        "help_docs_consumes_shared_change_orchestration_vocabulary",
        "every_object_adopted_by_two_or_more_consumers",
        "change_orchestration_vocabulary_identical_for_same_subject",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_change_orchestration_object"
      ],
      "properties": {
        "review_detail_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "patch_stack_queue_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "stack_edit_review_sheet_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "provider_merge_queue_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "change_object_detail_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "portable_shelf_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "worktree_cleanup_preview_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "support_export_packet_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "help_docs_consumes_shared_change_orchestration_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "every_object_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "change_orchestration_vocabulary_identical_for_same_subject": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_change_orchestration_object": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
