{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/teamwork/m5-change-intent-surface-certification.schema.json",
  "title": "Aureline M5 change-intent surface certification packet",
  "description": "M05-1293 closing B153 capstone certifying that the frozen M5 change-intent object classes (change-intent record, start-work sheet, linked-change panel, ready-for-review handoff sheet, resolve-or-close sheet, blocked-or-escalate card) hold their change-intent truth on every claimed M5 work-item, start-work, review, provider, help, and support / export surface. Keyed on the claimed consumer profile (fully-certified change-intent lane, reviewable change-intent record structure, local-only-or-reconcile-required commit-state profile, undisclosed-start-work-side-effect profile, flattened-linked-relation-source profile, blocked-handoff-publishability profile, local-only-resolution-authority profile, unresolved-blocker-continuity profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and change-intent-truth behavior — and either passes (green), auto-narrows its change-intent claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a fully-certified change-intent lane whose provider ownership, local-versus-provider commit state, linked branch / worktree / review identity, relation source, blocker / resolution state, and validation evidence all converge on one export-safe, provider-committed, internally consistent record may certify a certified change-intent record; and every B153 hard invariant must hold (start work never silently creates a branch, worktree, review draft, or provider link without separately disclosing each side effect; a local handoff packet or queued publish never masquerades as a provider-committed update; linked-by-provider, linked-locally, suggested-by-Aureline, and stale-or-broken relation are never flattened into one generic relation badge; tracked work is never auto-resolved while engineering blockers remain unresolved; and local notes, handoff packets, or linked evidence are never dropped when a provider write fails). Every row cites exactly one canonical change-intent lifecycle matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_change_intent_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-change-intent-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "certified_change_intent_lane",
        "reviewable_change_intent_record_structure",
        "local_only_or_reconcile_commit_state_profile",
        "undisclosed_start_work_side_effect_profile",
        "flattened_linked_relation_source_profile",
        "blocked_handoff_publishability_profile",
        "local_only_resolution_authority_profile",
        "unresolved_blocker_continuity_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "change_intent_truth"
      ]
    },
    "change_intent_claim": {
      "enum": [
        "certified_change_intent_truth",
        "reviewable_change_intent_record",
        "commit_state_unverified_projection",
        "side_effect_disclosure_unverified_projection",
        "linked_relation_source_unverified_projection",
        "handoff_publishability_unverified_projection",
        "resolution_authority_unverified_projection",
        "blocker_continuity_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "change_intent_record",
        "start_work_sheet",
        "linked_change_panel",
        "ready_for_review_handoff_sheet",
        "resolve_close_sheet",
        "blocked_escalate_card"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "silent_side_effect_created",
        "local_handoff_shown_as_provider_committed",
        "relation_sources_flattened",
        "auto_resolved_with_open_blocker",
        "local_evidence_dropped_on_provider_write_failure",
        "provider_ownership_unstated",
        "local_versus_provider_state_unstated",
        "linked_engineering_identity_unstated",
        "relation_source_unstated",
        "blocker_state_unstated",
        "validation_evidence_unstated",
        "change_intent_matrix_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lets_start_work_silently_create_a_side_effect_without_disclosure",
        "lets_a_local_handoff_packet_or_queued_publish_masquerade_as_a_provider_committed_update",
        "flattens_linked_by_provider_linked_locally_suggested_and_stale_into_one_relation_badge",
        "auto_resolves_tracked_work_while_engineering_blockers_remain_unresolved",
        "drops_local_notes_handoff_packets_or_linked_evidence_when_provider_write_fails"
      ],
      "properties": {
        "lets_start_work_silently_create_a_side_effect_without_disclosure": { "const": false },
        "lets_a_local_handoff_packet_or_queued_publish_masquerade_as_a_provider_committed_update": { "const": false },
        "flattens_linked_by_provider_linked_locally_suggested_and_stale_into_one_relation_badge": { "const": false },
        "auto_resolves_tracked_work_while_engineering_blockers_remain_unresolved": { "const": false },
        "drops_local_notes_handoff_packets_or_linked_evidence_when_provider_write_fails": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/change_intent_claim" },
        "to_claim": { "$ref": "#/$defs/change_intent_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_change_intent_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/change_intent_claim" },
        "certified_claim": { "$ref": "#/$defs/change_intent_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-change-intent-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
