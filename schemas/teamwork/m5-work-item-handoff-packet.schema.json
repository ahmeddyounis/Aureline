{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/teamwork/m5-work-item-handoff-packet.schema.json",
  "title": "Aureline M5 work-item handoff packet",
  "description": "Canonical per-domain descriptor for a portable work-item handoff packet. Names the object class, its change-intent association, the packaged validation evidence, the linked engineering identity, the publish-later fallback, and the local-versus-provider commit state so an offline handoff packet stays portable across a lost provider connection without ever reading as a provider-committed update. The matrix references this schema for offline handoff continuity. Secret values and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "change_intent_association",
    "packaged_validation_evidence",
    "linked_engineering_identity",
    "publish_later_fallback",
    "commit_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "change_intent_record"
      ]
    },
    "change_intent_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "packaged_validation_evidence": {
      "$ref": "#/$defs/non_empty_string"
    },
    "linked_engineering_identity": {
      "$ref": "#/$defs/non_empty_string"
    },
    "publish_later_fallback": {
      "$ref": "#/$defs/non_empty_string"
    },
    "commit_state": {
      "enum": [
        "provider_committed",
        "local_only_draft",
        "queued_for_publish",
        "publish_failed_retained",
        "provider_unavailable",
        "offline_handoff_packet",
        "stale_relative_to_provider"
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
