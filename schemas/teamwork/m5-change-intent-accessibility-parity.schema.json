{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/teamwork/m5-change-intent-accessibility-parity.schema.json",
  "title": "Aureline M5 change-intent accessibility & auto-narrowing parity",
  "description": "Export-safe packet for the M05-1292 keyboard / screen-reader / high-zoom / high-contrast / CLI / export parity and honest auto-narrowing capstone over the frozen M5 change-intent and engineering-lifecycle matrix. Each row certifies one of the six canonical change-intent objects (change_intent_record, start_work_sheet, linked_change_panel, ready_for_review_handoff_sheet, resolve_close_sheet, blocked_escalate_card) as keyboard-complete, assistive-tech-reachable, high-zoom / high-contrast-safe, CLI/export-safe, and self-narrowing. When a change-intent commit state is local-only or reconcile-required, a start-work side effect is undisclosed, a linked branch / worktree / review relation is stale or broken, provider write scope is missing so a handoff packet is not publishable, a resolution is local-only, or a blocker is unresolved, the object's claim auto-narrows from trusted_provider_committed_surface / local_reviewable_surface to a provider-commit-state-unverified / side-effect-disclosure-unverified / linked-relation-unverified / handoff-publishability-unverified / resolution-authority-unverified / blocker-continuity-unverified projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical object identity / last-known state. A local handoff packet or queued publish never masquerades as a provider-committed update, and linked-by-provider, linked-locally, suggested, and stale-or-broken relations are never flattened into one badge. The packet is metadata-only: raw diff hunks, message payloads, credentials, secrets, and endpoint refs never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_change_intent_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 6
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "object": {
      "type": "string",
      "enum": [
        "change_intent_record",
        "start_work_sheet",
        "linked_change_panel",
        "ready_for_review_handoff_sheet",
        "resolve_close_sheet",
        "blocked_escalate_card"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "change_intent_claim": {
      "type": "string",
      "enum": [
        "trusted_provider_committed_surface",
        "local_reviewable_surface",
        "provider_commit_state_unverified_projection",
        "side_effect_disclosure_unverified_projection",
        "linked_relation_unverified_projection",
        "handoff_publishability_unverified_projection",
        "resolution_authority_unverified_projection",
        "blocker_continuity_unverified_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "provider_commit_state_clarity",
        "side_effect_disclosure_clarity",
        "linked_relation_source_clarity",
        "handoff_publishability_clarity",
        "resolution_authority_clarity",
        "blocker_continuity_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "fully_qualified",
        "local_only_or_reconcile_required",
        "side_effect_undisclosed",
        "linked_relation_stale_or_broken",
        "handoff_publishability_blocked",
        "resolution_authority_local_only",
        "blocker_unresolved_or_masquerade"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "silent_side_effect_created",
        "local_handoff_shown_as_provider_committed",
        "relation_sources_flattened",
        "auto_resolved_with_open_blocker",
        "local_evidence_dropped_on_provider_write_failure",
        "provider_ownership_unstated",
        "local_versus_provider_state_unstated",
        "linked_engineering_identity_unstated",
        "relation_source_unstated",
        "blocker_state_unstated",
        "validation_evidence_unstated",
        "change_intent_matrix_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "lifecycle_role",
        "canonical_reference",
        "provider_commit_state",
        "relation_source",
        "blocker_state"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "work_item_detail",
        "start_work_sheet",
        "linked_change_panel",
        "review_detail",
        "ready_for_review_handoff",
        "resolve_close_sheet",
        "blocked_escalate_card",
        "support_export_packet",
        "help_docs"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_truth_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/change_intent_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_truth_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "object",
        "source_object_schema_ref",
        "object_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "high_zoom_reach",
        "high_contrast_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_ready_claim",
        "claim_conditions",
        "truth_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_change_intent_accessibility_parity_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/object" },
        "source_object_schema_ref": { "type": "string", "minLength": 1 },
        "object_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_zoom_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_contrast_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_ready_claim": { "$ref": "#/$defs/change_intent_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "truth_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "object_count",
        "structure_heavy_object_count",
        "all_structure_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_trusted_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_truth_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "object_count": { "type": "integer", "minimum": 0 },
        "structure_heavy_object_count": { "type": "integer", "minimum": 0 },
        "all_structure_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_trusted_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_truth_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
