{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/search/action-binding.schema.json",
  "title": "Aureline search action-binding, parity, and no-wrong-target fallback truth",
  "description": "Boundary schema for the search action-binding packet. Preview, open-in-place, split, peek, and external-handoff actions are bound to canonical result refs and relation kinds across the claimed M5 flows (search results, docs results, graph-backed results, history/back-forward replay, support handoff replay). Definition and declaration stay distinguishable; wrong-target-safe fallbacks under narrowed scope, trust, or freshness are explicit and recoverable; and split/peek/open-in-place preserve attributable return anchors. The same binding objects are reused by the product UI, history/back-forward, and support replay consumers. The packet is metadata-only: no raw query text or bodies are admitted, and convenience routing never widens authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "doc_ref",
    "schema_ref",
    "artifact_ref",
    "source_spec_refs",
    "supporting_contract_refs",
    "covered_flows",
    "covered_action_kinds",
    "covered_relation_kinds",
    "covered_fallback_triggers",
    "flows",
    "consumer_projections",
    "export_safe_summary"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "search_action_binding_packet" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "const": "search.m5.action_bindings.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "doc_ref": { "type": "string", "minLength": 1 },
    "schema_ref": { "type": "string", "minLength": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "source_spec_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supporting_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "covered_flows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/flow_class" }
    },
    "covered_action_kinds": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/action_kind" }
    },
    "covered_relation_kinds": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/relation_kind" }
    },
    "covered_fallback_triggers": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/fallback_trigger" }
    },
    "flows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/flow_row" }
    },
    "consumer_projections": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "export_safe_summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "flow_class": {
      "type": "string",
      "enum": [
        "search_results",
        "docs_results",
        "graph_results",
        "history_replay",
        "support_handoff"
      ]
    },
    "action_kind": {
      "type": "string",
      "enum": ["preview", "open_in_place", "split", "peek", "external_handoff"]
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "definition",
        "declaration",
        "implementation",
        "reference",
        "type",
        "call",
        "route-binding",
        "owner-link",
        "doc-link"
      ]
    },
    "fallback_trigger": {
      "type": "string",
      "enum": [
        "none",
        "scope_narrowed",
        "trust_policy",
        "freshness_stale",
        "target_missing"
      ]
    },
    "action_fallback_mode": {
      "type": "string",
      "enum": [
        "direct",
        "open_captured_snapshot",
        "route_to_canonical_source",
        "rerun_live_query",
        "policy_narrowed",
        "unavailable"
      ]
    },
    "history_policy": {
      "type": "string",
      "enum": [
        "record_history_entry",
        "reuse_existing_entry",
        "suppress_for_captured_replay",
        "policy_forbids_history"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": ["product_ui", "history_back_forward", "support_replay"]
    },
    "search_action_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_target_ref",
        "alternate_behaviors",
        "required_surface_capabilities",
        "fallback_mode",
        "history_policy"
      ],
      "properties": {
        "open_target_ref": { "type": "string", "minLength": 1 },
        "alternate_behaviors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_surface_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fallback_mode": { "$ref": "#/$defs/action_fallback_mode" },
        "history_policy": { "$ref": "#/$defs/history_policy" }
      }
    },
    "wrong_target_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "fallback_mode",
        "original_target_ref",
        "fallback_target_ref",
        "relation_kind_changed",
        "crosses_to_external_handoff",
        "visible_reason",
        "recovery_action",
        "recoverable"
      ],
      "properties": {
        "trigger": { "$ref": "#/$defs/fallback_trigger" },
        "fallback_mode": { "$ref": "#/$defs/action_fallback_mode" },
        "original_target_ref": { "type": "string", "minLength": 1 },
        "fallback_target_ref": { "type": "string", "minLength": 1 },
        "relation_kind_changed": { "type": "boolean" },
        "crosses_to_external_handoff": { "type": "boolean" },
        "visible_reason": { "type": "string", "minLength": 1 },
        "recovery_action": { "type": "string", "minLength": 1 },
        "recoverable": { "type": "boolean", "const": true }
      }
    },
    "resolved_action_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "action_kind",
        "result_id",
        "display_title",
        "requested_relation_kind",
        "resolved_relation_kind",
        "return_anchor_ref",
        "action_binding",
        "fallback_trigger",
        "authority_not_widened",
        "raw_boundary_material_excluded",
        "summary"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "action_kind": { "$ref": "#/$defs/action_kind" },
        "result_id": {
          "type": "string",
          "minLength": 1,
          "description": "Durable, surface-independent result URN. Never a display label or transient list index."
        },
        "display_title": { "type": "string", "minLength": 1 },
        "requested_relation_kind": { "$ref": "#/$defs/relation_kind" },
        "resolved_relation_kind": { "$ref": "#/$defs/relation_kind" },
        "return_anchor_ref": { "type": "string", "minLength": 1 },
        "action_binding": { "$ref": "#/$defs/search_action_binding" },
        "fallback_trigger": { "$ref": "#/$defs/fallback_trigger" },
        "fallback": { "$ref": "#/$defs/wrong_target_fallback" },
        "authority_not_widened": { "type": "boolean", "const": true },
        "raw_boundary_material_excluded": { "type": "boolean", "const": true },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "flow_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow",
        "flow_label",
        "query_session_id_ref",
        "query_hash",
        "bindings",
        "summary"
      ],
      "properties": {
        "flow": { "$ref": "#/$defs/flow_class" },
        "flow_label": { "type": "string", "minLength": 1 },
        "query_session_id_ref": { "type": "string", "minLength": 1 },
        "query_hash": { "type": "string", "minLength": 1 },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_action_binding" }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_ref",
        "ingested_packet_id",
        "preserves_action_bindings",
        "preserves_relation_kinds",
        "preserves_return_anchors",
        "preserves_fallback_reasons",
        "reuses_same_binding_objects",
        "widens_authority",
        "ambient_authority_excluded",
        "summary"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "consumer_ref": { "type": "string", "minLength": 1 },
        "ingested_packet_id": {
          "type": "string",
          "const": "search.m5.action_bindings.v1"
        },
        "preserves_action_bindings": { "type": "boolean", "const": true },
        "preserves_relation_kinds": { "type": "boolean", "const": true },
        "preserves_return_anchors": { "type": "boolean", "const": true },
        "preserves_fallback_reasons": { "type": "boolean", "const": true },
        "reuses_same_binding_objects": { "type": "boolean", "const": true },
        "widens_authority": { "type": "boolean", "const": false },
        "ambient_authority_excluded": { "type": "boolean", "const": true },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
