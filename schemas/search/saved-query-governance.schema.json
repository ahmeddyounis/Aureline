{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/search/saved-query-governance.schema.json",
  "title": "Aureline saved-query, scope-pack, retention, and signed deep-link governance truth",
  "description": "Boundary schema for the M5 saved-query governance packet. It binds the canonical saved query, scope pack, query-history, and search deep-link artifacts; proves saved queries survive reopen, migration, and scope drift without silent semantic breakage; wraps each deep link with a tamper-evident content signature that discloses scope, freshness, and partiality while preserving a supportable return path and never implying live current certainty; and certifies that raw query text stays local-only by default. The packet is privacy-governed: raw query text is confined to local-only artifacts, and sync, share, and support export carry redacted metadata only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "doc_ref",
    "schema_ref",
    "artifact_ref",
    "source_spec_refs",
    "supporting_contract_refs",
    "covered_privacy_classes",
    "covered_sync_classes",
    "covered_retention_modes",
    "covered_redaction_profiles",
    "covered_data_classes",
    "saved_queries",
    "signed_deep_links",
    "retention_matrix",
    "consumer_projections",
    "export_safe_summary"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "saved_query_governance_packet" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "const": "search.m5.saved_query_governance.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "doc_ref": { "type": "string", "minLength": 1 },
    "schema_ref": { "type": "string", "minLength": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "source_spec_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supporting_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "covered_privacy_classes": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/privacy_class" }
    },
    "covered_sync_classes": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/sync_class" }
    },
    "covered_retention_modes": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/retention_mode" }
    },
    "covered_redaction_profiles": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/redaction_profile" }
    },
    "covered_data_classes": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/data_class" }
    },
    "saved_queries": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/governed_saved_query_row" }
    },
    "signed_deep_links": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/signed_deep_link" }
    },
    "retention_matrix": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/retention_row" }
    },
    "consumer_projections": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "export_safe_summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "privacy_class": {
      "type": "string",
      "enum": [
        "local_only_private",
        "workspace_shared_redacted",
        "support_export_redacted",
        "policy_withheld"
      ]
    },
    "sync_class": {
      "type": "string",
      "enum": [
        "local_only",
        "explicit_user_sync",
        "workspace_shared",
        "repo_provided",
        "policy_managed",
        "support_export_only"
      ]
    },
    "retention_mode": {
      "type": "string",
      "enum": [
        "local_only_default",
        "local_only_ephemeral",
        "workspace_shared_explicit",
        "repo_provided_read_only",
        "policy_owned_managed",
        "support_export_bounded"
      ]
    },
    "redaction_profile": {
      "type": "string",
      "enum": [
        "literal_local_only",
        "hashes_scope_and_result_refs",
        "metadata_only_no_query_material",
        "policy_withheld",
        "explicit_literal_consent"
      ]
    },
    "widening_basis": {
      "type": "string",
      "enum": [
        "not_widened_local_default",
        "explicit_user_opt_in",
        "policy_owned",
        "repo_provided_artifact",
        "team_shared_artifact",
        "support_case_export"
      ]
    },
    "result_semantics": {
      "type": "string",
      "enum": [
        "current_live_results",
        "captured_snapshot",
        "live_rerun_required",
        "scope_changed_since_capture",
        "empty_because_scope_changed"
      ]
    },
    "scope_honesty_state": {
      "type": "string",
      "enum": [
        "captured_scope_still_current",
        "recipient_must_re_resolve",
        "current_scope_wider_narrowed_to_captured",
        "current_scope_narrower_disclosed",
        "current_scope_changed_rebind_required"
      ]
    },
    "data_class": {
      "type": "string",
      "enum": [
        "raw_query_text",
        "query_hash",
        "parsed_query_ast",
        "scope_metadata",
        "result_refs"
      ]
    },
    "signature_scheme": {
      "type": "string",
      "enum": [
        "local_content_digest",
        "workspace_signed_digest",
        "policy_signed_digest"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": ["product_ui", "sync_portability", "support_export"]
    },
    "durable_artifact": {
      "type": "object",
      "description": "A canonical durable search artifact (saved query, scope pack, history entry, or deep link). Validated in full by its own lane schema; here it must at least carry the privacy, sync, and scope governance fields.",
      "required": ["record_kind", "schema_version", "privacy_class", "sync_class"],
      "properties": {
        "record_kind": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "integer", "minimum": 1 },
        "privacy_class": { "$ref": "#/$defs/privacy_class" },
        "sync_class": { "$ref": "#/$defs/sync_class" },
        "retention_mode": { "$ref": "#/$defs/retention_mode" },
        "redaction_profile": { "$ref": "#/$defs/redaction_profile" },
        "result_semantics": { "$ref": "#/$defs/result_semantics" },
        "scope_honesty_state": { "$ref": "#/$defs/scope_honesty_state" }
      }
    },
    "scope_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_stable_scope_id",
        "current_stable_scope_id",
        "scope_honesty_state",
        "result_semantics",
        "rerun_required",
        "effective_scope_narrowed_to_captured",
        "silent_semantic_break",
        "disclosure"
      ],
      "properties": {
        "captured_stable_scope_id": { "type": "string", "minLength": 1 },
        "current_stable_scope_id": { "type": "string", "minLength": 1 },
        "scope_honesty_state": { "$ref": "#/$defs/scope_honesty_state" },
        "result_semantics": { "$ref": "#/$defs/result_semantics" },
        "rerun_required": { "type": "boolean" },
        "effective_scope_narrowed_to_captured": { "type": "boolean" },
        "silent_semantic_break": { "type": "boolean", "const": false },
        "disclosure": { "type": "string", "minLength": 1 }
      }
    },
    "governed_saved_query_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "saved_query",
        "scope_pack",
        "history_entry",
        "scope_drift",
        "survives_reopen",
        "survives_migration",
        "survives_scope_drift",
        "summary"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "saved_query": { "$ref": "#/$defs/durable_artifact" },
        "scope_pack": { "$ref": "#/$defs/durable_artifact" },
        "history_entry": { "$ref": "#/$defs/durable_artifact" },
        "scope_drift": { "$ref": "#/$defs/scope_drift" },
        "survives_reopen": { "type": "boolean", "const": true },
        "survives_migration": { "type": "boolean", "const": true },
        "survives_scope_drift": { "type": "boolean", "const": true },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "signed_deep_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_link_id",
        "deep_link",
        "intent_summary",
        "completeness_note",
        "freshness_disclosure",
        "scope_disclosure",
        "partiality_disclosed",
        "return_anchor_ref",
        "implies_live_current_certainty",
        "signature_scheme",
        "signing_key_id",
        "signed_fields",
        "payload_digest",
        "signature",
        "summary"
      ],
      "properties": {
        "signed_link_id": { "type": "string", "minLength": 1 },
        "deep_link": { "$ref": "#/$defs/durable_artifact" },
        "intent_summary": { "type": "string", "minLength": 1 },
        "completeness_note": { "type": "string", "minLength": 1 },
        "freshness_disclosure": { "$ref": "#/$defs/result_semantics" },
        "scope_disclosure": { "$ref": "#/$defs/scope_honesty_state" },
        "partiality_disclosed": { "type": "boolean", "const": true },
        "return_anchor_ref": { "type": "string", "minLength": 1 },
        "implies_live_current_certainty": { "type": "boolean", "const": false },
        "signature_scheme": { "$ref": "#/$defs/signature_scheme" },
        "signing_key_id": { "type": "string", "minLength": 1 },
        "signed_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "payload_digest": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "retention_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_class",
        "local_retention_mode",
        "local_sync_class",
        "default_redaction",
        "synced_by_default",
        "on_sync_redaction",
        "widening_basis",
        "retained_beyond_session",
        "policy_redaction_required",
        "disclosure"
      ],
      "properties": {
        "data_class": { "$ref": "#/$defs/data_class" },
        "local_retention_mode": { "$ref": "#/$defs/retention_mode" },
        "local_sync_class": { "$ref": "#/$defs/sync_class", "const": "local_only" },
        "default_redaction": { "$ref": "#/$defs/redaction_profile" },
        "synced_by_default": { "type": "boolean" },
        "synced_retention_mode": { "$ref": "#/$defs/retention_mode" },
        "synced_sync_class": { "$ref": "#/$defs/sync_class" },
        "on_sync_redaction": { "$ref": "#/$defs/redaction_profile" },
        "widening_basis": { "$ref": "#/$defs/widening_basis" },
        "retained_beyond_session": { "type": "boolean" },
        "policy_redaction_required": { "type": "boolean" },
        "disclosure": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_ref",
        "ingested_packet_id",
        "preserves_privacy_and_sync_class",
        "preserves_captured_vs_current_scope",
        "reuses_same_artifacts",
        "widens_authority",
        "raw_query_text_excluded",
        "ambient_authority_excluded",
        "summary"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "consumer_ref": { "type": "string", "minLength": 1 },
        "ingested_packet_id": { "type": "string", "const": "search.m5.saved_query_governance.v1" },
        "preserves_privacy_and_sync_class": { "type": "boolean", "const": true },
        "preserves_captured_vs_current_scope": { "type": "boolean", "const": true },
        "reuses_same_artifacts": { "type": "boolean", "const": true },
        "widens_authority": { "type": "boolean", "const": false },
        "raw_query_text_excluded": { "type": "boolean", "const": true },
        "ambient_authority_excluded": { "type": "boolean", "const": true },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
