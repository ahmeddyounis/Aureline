{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/search/m5-search-navigation-qualification.schema.json",
  "title": "Aureline M5 search/navigation qualification packet",
  "description": "Boundary schema for the m5_search_navigation_qualification_packet emitted by aureline-search. The packet freezes the M5 search-query, result-identity, ranking-reason, and saved-query/privacy matrix: it binds the canonical search contract objects (SearchQuerySession, SearchResultRef, RankingReason, SearchActionBinding, SavedQuery, ScopePack, SearchExportPacket) to their own lane schema, fixture corpus, and record kind, freezes the closed result-state vocabulary (exact, context_promoted, semantic, partial_index, withheld_latency, policy_hidden, cached, stale, imported) and the privacy/retention/consent posture for query material, and proves that every claimed M5 search surface answers off the one shared query-session and result-identity model across the product and CLI/headless deployment modes. It then exposes the same qualification index to the product search surface, CLI/headless, docs/help, support export, shiproom, and release-manifest consumers. The packet is metadata-safe and never embeds raw query text, source bodies, provider payloads, or live credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "doc_ref",
    "schema_ref",
    "artifact_ref",
    "source_spec_refs",
    "supporting_contract_refs",
    "claimed_surfaces",
    "deployment_modes",
    "contract_objects",
    "result_state_vocabulary",
    "privacy_bindings",
    "qualification_rows",
    "downgrade_rules",
    "consumer_bindings",
    "export_safe_summary"
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "quick_open",
        "file_search",
        "symbol_search",
        "docs_search",
        "graph_backed_search",
        "ai_context_retrieval",
        "saved_query_reopen",
        "search_export"
      ]
    },
    "deployment_mode": {
      "type": "string",
      "enum": [
        "product_surface",
        "cli_headless"
      ]
    },
    "object_class": {
      "type": "string",
      "enum": [
        "query_session",
        "result_ref",
        "ranking_reason",
        "action_binding",
        "saved_query",
        "scope_pack",
        "export_packet"
      ]
    },
    "result_state": {
      "type": "string",
      "enum": [
        "exact",
        "context_promoted",
        "semantic",
        "partial_index",
        "withheld_latency",
        "policy_hidden",
        "cached",
        "stale",
        "imported"
      ]
    },
    "privacy_data_class": {
      "type": "string",
      "enum": [
        "raw_query_text",
        "query_hash",
        "saved_query_sync",
        "support_export_packet"
      ]
    },
    "privacy_class": {
      "type": "string",
      "enum": [
        "local_sensitive",
        "local_derived",
        "user_synced",
        "export_metadata"
      ]
    },
    "retention_mode": {
      "type": "string",
      "enum": [
        "local_only_default",
        "local_hash_only",
        "explicit_sync_opt_in",
        "support_export_bounded"
      ]
    },
    "consent_requirement": {
      "type": "string",
      "enum": [
        "none_local_default",
        "explicit_for_share",
        "explicit_sync_opt_in",
        "explicit_per_export"
      ]
    },
    "qualification_state": {
      "type": "string",
      "enum": [
        "qualified",
        "scope_limited",
        "local_query_text_only",
        "blocked_unverified"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "shared_model_drift",
        "partial_index_or_stale_scope",
        "withheld_or_policy_hidden",
        "query_text_privacy_unconsented",
        "imported_provenance_unverified",
        "consumer_binding_missing"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "product_search_surface",
        "cli_headless",
        "docs_help",
        "support_export",
        "shiproom",
        "release_manifest"
      ]
    },
    "contract_object_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "object_class",
        "label",
        "backing_schema_ref",
        "backing_fixture_ref",
        "backing_record_kind",
        "privacy_data_class",
        "summary"
      ],
      "properties": {
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "object_class": { "$ref": "#/$defs/object_class" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "backing_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "backing_fixture_ref": { "$ref": "#/$defs/non_empty_string" },
        "backing_record_kind": { "$ref": "#/$defs/non_empty_string" },
        "privacy_data_class": { "$ref": "#/$defs/privacy_data_class" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "result_state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_class",
        "token",
        "label",
        "narrows_scope",
        "must_stay_visible",
        "summary"
      ],
      "properties": {
        "state_class": { "$ref": "#/$defs/result_state" },
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "narrows_scope": { "type": "boolean" },
        "must_stay_visible": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "privacy_binding_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_class",
        "privacy_class",
        "retention_mode",
        "consent_requirement",
        "local_only_by_default",
        "summary"
      ],
      "properties": {
        "data_class": { "$ref": "#/$defs/privacy_data_class" },
        "privacy_class": { "$ref": "#/$defs/privacy_class" },
        "retention_mode": { "$ref": "#/$defs/retention_mode" },
        "consent_requirement": { "$ref": "#/$defs/consent_requirement" },
        "local_only_by_default": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_row_id",
        "surface",
        "surface_label",
        "published_state",
        "deployment_mode_coverage",
        "shared_query_session_ref",
        "shared_result_identity_ref",
        "bound_object_ids",
        "expressible_states",
        "query_text_privacy_class",
        "persists_query_material",
        "local_query_text_first",
        "stale_proof_tokens",
        "downgrade_rule_ids",
        "summary"
      ],
      "properties": {
        "qualification_row_id": { "$ref": "#/$defs/non_empty_string" },
        "surface": { "$ref": "#/$defs/surface_class" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "published_state": { "$ref": "#/$defs/qualification_state" },
        "deployment_mode_coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/deployment_mode" },
          "minItems": 1
        },
        "shared_query_session_ref": { "$ref": "#/$defs/non_empty_string" },
        "shared_result_identity_ref": { "$ref": "#/$defs/non_empty_string" },
        "bound_object_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "expressible_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/result_state" },
          "minItems": 1
        },
        "query_text_privacy_class": { "$ref": "#/$defs/privacy_class" },
        "persists_query_material": { "type": "boolean" },
        "local_query_text_first": { "type": "boolean" },
        "stale_proof_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "downgrade_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_class",
        "source_state",
        "downgraded_state",
        "required_effect",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_class": { "$ref": "#/$defs/downgrade_trigger" },
        "source_state": { "$ref": "#/$defs/qualification_state" },
        "downgraded_state": { "$ref": "#/$defs/qualification_state" },
        "required_effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_ref",
        "ingested_packet_id",
        "qualification_row_count",
        "required_verbatim_fields",
        "narrow_on_stale_proof",
        "explicit_limited_state_labels_required",
        "summary"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "qualification_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_verbatim_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrow_on_stale_proof": { "type": "boolean" },
        "explicit_limited_state_labels_required": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  },
  "properties": {
    "record_kind": {
      "const": "m5_search_navigation_qualification_packet"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "const": "search.m5.search_navigation_qualification.v1"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "doc_ref": {
      "const": "docs/search/m5-search-navigation-qualification.md"
    },
    "schema_ref": {
      "const": "schemas/search/m5-search-navigation-qualification.schema.json"
    },
    "artifact_ref": {
      "const": "artifacts/search/m5/m5-search-navigation-qualification.md"
    },
    "source_spec_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 1
    },
    "supporting_contract_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 1
    },
    "claimed_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_class" },
      "minItems": 1
    },
    "deployment_modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/deployment_mode" },
      "minItems": 1
    },
    "contract_objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract_object_row" },
      "minItems": 1
    },
    "result_state_vocabulary": {
      "type": "array",
      "items": { "$ref": "#/$defs/result_state_row" },
      "minItems": 1
    },
    "privacy_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/privacy_binding_row" },
      "minItems": 1
    },
    "qualification_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualification_row" },
      "minItems": 1
    },
    "downgrade_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_rule" },
      "minItems": 1
    },
    "consumer_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_binding" },
      "minItems": 1
    },
    "export_safe_summary": {
      "$ref": "#/$defs/non_empty_string"
    }
  }
}
