{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/search/query-session-first-consumers.schema.json",
  "title": "Aureline durable query-session and result-identity first-consumers substrate",
  "description": "Boundary schema for the materialized durable query-session and result-identity substrate. One hash-only SearchQuerySession is minted per search surface (quick open, symbol search, full-text search, references, docs search, recent navigation) and bound to materialized result identities that carry full source-stratum dedupe lineage, structured ranking reasons, and explicit action bindings. The packet proves the same session and result ids are reused across surfaces and by the first consumers (desktop, CLI/headless inspect, AI context assembly, support export) so results reopen, replay, export, and explain without reconstructing state from rendered UI text. The packet is metadata-only: no raw query text, source bodies, provider payloads, or secrets cross the boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "doc_ref",
    "schema_ref",
    "artifact_ref",
    "source_spec_refs",
    "supporting_contract_refs",
    "covered_surfaces",
    "durable_sessions",
    "cross_surface_reuse",
    "consumer_bindings",
    "export_safe_summary"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "search_query_session_first_consumers_packet"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": {
      "type": "string",
      "const": "search.m5.query_session_first_consumers.v1"
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "doc_ref": { "type": "string", "minLength": 1 },
    "schema_ref": { "type": "string", "minLength": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "source_spec_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supporting_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "covered_surfaces": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_kind" }
    },
    "durable_sessions": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/durable_surface_session" }
    },
    "cross_surface_reuse": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cross_surface_reuse_row" }
    },
    "consumer_bindings": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/consumer_reuse_binding" }
    },
    "export_safe_summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface_kind": {
      "type": "string",
      "enum": [
        "quick_open",
        "symbol_search",
        "full_text_search",
        "references",
        "docs_search",
        "recent_navigation"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "desktop",
        "cli_headless_inspect",
        "ai_context_assembly",
        "support_export"
      ]
    },
    "churn_event": {
      "type": "string",
      "enum": [
        "row_virtualization",
        "preview_pane_toggle",
        "reason_chip_toggle",
        "pane_restore"
      ]
    },
    "result_kind": {
      "type": "string",
      "enum": [
        "workspace_file",
        "symbol",
        "command",
        "docs_anchor",
        "recent_target",
        "graph_entity",
        "imported_artifact"
      ]
    },
    "source_stratum": {
      "type": "string",
      "enum": [
        "lexical_filename",
        "lexical_path",
        "lexical_content",
        "semantic_vector",
        "structural_symbol",
        "graph_entity",
        "docs_index",
        "command_registry",
        "recent_targets",
        "imported_cache"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "live",
        "captured_snapshot",
        "hot_set_current",
        "partial_index",
        "stale",
        "unknown"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "heuristic"]
    },
    "fact_label": {
      "type": "string",
      "enum": [
        "exact",
        "context_promoted",
        "semantic",
        "partial_index",
        "withheld_latency",
        "policy_hidden"
      ]
    },
    "ranking_signal": {
      "type": "string",
      "enum": [
        "exact_name_match",
        "lexical_prefix",
        "lexical_substring",
        "lexical_path",
        "semantic_vector_similarity",
        "graph_expansion",
        "recency_or_hot_set",
        "generated_artifact_deprioritization",
        "canonical_source_tie_break",
        "snapshot_fidelity_tie_break"
      ]
    },
    "tie_break_class": {
      "type": "string",
      "enum": [
        "none",
        "canonical_source",
        "snapshot_fidelity",
        "recency",
        "stable_id_order"
      ]
    },
    "fallback_mode": {
      "type": "string",
      "enum": [
        "direct",
        "open_captured_snapshot",
        "route_to_canonical_source",
        "rerun_live_query",
        "policy_narrowed",
        "unavailable"
      ]
    },
    "history_policy": {
      "type": "string",
      "enum": [
        "record_history_entry",
        "reuse_existing_entry",
        "suppress_for_captured_replay",
        "policy_forbids_history"
      ]
    },
    "query_session": {
      "type": "object",
      "description": "Embedded durable SearchQuerySession; see schemas/search/query_session.schema.json for the canonical contract. The packet requires hash-only sessions, so query_text is absent.",
      "required": [
        "record_kind",
        "schema_version",
        "query_session_id",
        "surface",
        "query_text_mode",
        "scope_class",
        "stable_scope_id",
        "scope_mode",
        "scope_label",
        "planner_version",
        "readiness_state",
        "observed_at"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "search_query_session" },
        "schema_version": { "type": "integer" },
        "query_session_id": { "type": "string", "minLength": 1 },
        "surface": {
          "type": "string",
          "enum": ["quick_open", "file_search", "symbol_search", "docs_search"]
        },
        "query_text_mode": {
          "type": "string",
          "enum": ["local_text", "hash_only", "omitted_by_policy"]
        },
        "query_hash": { "type": "string" },
        "parsed_query": { "type": "object" },
        "scope_class": { "type": "string" },
        "stable_scope_id": { "type": "string" },
        "scope_mode": { "type": "string" },
        "scope_label": { "type": "string" },
        "planner_version": { "type": "string" },
        "readiness_state": { "type": "string" },
        "policy_posture": { "type": "string" },
        "observed_at": { "type": "string" }
      }
    },
    "dedupe_contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_stratum", "canonical_anchor_ref"],
      "properties": {
        "source_stratum": { "$ref": "#/$defs/source_stratum" },
        "canonical_anchor_ref": { "type": "string", "minLength": 1 },
        "contributor_result_id": { "type": "string" }
      }
    },
    "result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "result_kind",
        "canonical_object_refs",
        "anchor_or_span_ref",
        "snapshot_or_commit_ref",
        "freshness",
        "confidence",
        "dedupe_lineage"
      ],
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 1,
          "description": "Durable, surface-independent URN-style result identity. Never a display label or transient list index."
        },
        "result_kind": { "$ref": "#/$defs/result_kind" },
        "canonical_object_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "anchor_or_span_ref": { "type": "string", "minLength": 1 },
        "snapshot_or_commit_ref": { "type": "string", "minLength": 1 },
        "freshness": { "$ref": "#/$defs/freshness" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "dedupe_lineage": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dedupe_contributor" }
        }
      }
    },
    "ranking_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_label", "promoted_signals", "suppressed_signals", "tie_break_class"],
      "properties": {
        "fact_label": { "$ref": "#/$defs/fact_label" },
        "promoted_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/ranking_signal" }
        },
        "suppressed_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/ranking_signal" }
        },
        "tie_break_class": { "$ref": "#/$defs/tie_break_class" },
        "withheld_candidate_note": { "type": "string" },
        "partiality_note": { "type": "string" }
      }
    },
    "action_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_target_ref", "alternate_behaviors", "required_surface_capabilities", "fallback_mode", "history_policy"],
      "properties": {
        "open_target_ref": { "type": "string", "minLength": 1 },
        "alternate_behaviors": { "type": "array", "items": { "type": "string" } },
        "required_surface_capabilities": { "type": "array", "items": { "type": "string" } },
        "fallback_mode": { "$ref": "#/$defs/fallback_mode" },
        "history_policy": { "$ref": "#/$defs/history_policy" }
      }
    },
    "durable_result_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_ref",
        "ranking_reason",
        "action_binding",
        "display_title",
        "stable_across_churn",
        "raw_boundary_material_excluded"
      ],
      "properties": {
        "result_ref": { "$ref": "#/$defs/result_ref" },
        "ranking_reason": { "$ref": "#/$defs/ranking_reason" },
        "action_binding": { "$ref": "#/$defs/action_binding" },
        "display_title": { "type": "string", "minLength": 1 },
        "stable_across_churn": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/churn_event" }
        },
        "raw_boundary_material_excluded": { "type": "boolean", "const": true }
      }
    },
    "durable_surface_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "surface_label", "query_session", "result_rows", "summary"],
      "properties": {
        "surface": { "$ref": "#/$defs/surface_kind" },
        "surface_label": { "type": "string", "minLength": 1 },
        "query_session": { "$ref": "#/$defs/query_session" },
        "result_rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/durable_result_row" }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "cross_surface_reuse_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_target_ref", "shared_result_id", "surfaces", "summary"],
      "properties": {
        "canonical_target_ref": { "type": "string", "minLength": 1 },
        "shared_result_id": { "type": "string", "minLength": 1 },
        "surfaces": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/surface_kind" }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_reuse_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_ref",
        "ingested_packet_id",
        "reused_query_session_ids",
        "reused_result_ids",
        "preserves_source_stratum_lineage",
        "reconstructs_from_ui_text",
        "invents_private_candidate_list",
        "supports_reopen",
        "supports_replay",
        "supports_export",
        "supports_explain",
        "raw_private_material_excluded",
        "ambient_authority_excluded",
        "summary"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "consumer_ref": { "type": "string", "minLength": 1 },
        "ingested_packet_id": {
          "type": "string",
          "const": "search.m5.query_session_first_consumers.v1"
        },
        "reused_query_session_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reused_result_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "preserves_source_stratum_lineage": { "type": "boolean", "const": true },
        "reconstructs_from_ui_text": { "type": "boolean", "const": false },
        "invents_private_candidate_list": { "type": "boolean", "const": false },
        "supports_reopen": { "type": "boolean", "const": true },
        "supports_replay": { "type": "boolean", "const": true },
        "supports_export": { "type": "boolean", "const": true },
        "supports_explain": { "type": "boolean", "const": true },
        "raw_private_material_excluded": { "type": "boolean", "const": true },
        "ambient_authority_excluded": { "type": "boolean", "const": true },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
