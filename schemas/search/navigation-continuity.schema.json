{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/search/navigation-continuity.schema.json",
  "title": "Aureline navigation-continuity binding truth",
  "description": "Boundary schema for the navigation-continuity binding packet. Breadcrumb, outline, bookmark, recent-location, back/forward, and peek artifacts are bound to canonical anchors across the editor, diff, notebook, docs, search, and graph surfaces. Bookmarks bind to canonical anchors first and remap only with stable evidence (never a nearest-target fallback); drift, missing-target, scope-unavailable, and archived states stay visible with reasons and recovery choices instead of relocating. Restore reopens continuity artifacts with their drift reasons preserved, and the same continuity objects are reused by the product UI, back/forward history, session restore, and support replay consumers. The packet is metadata-only: no raw query text or bodies are admitted, sessions are referenced hash-only, and convenience routing never widens authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "doc_ref",
    "schema_ref",
    "artifact_ref",
    "source_spec_refs",
    "supporting_contract_refs",
    "covered_surfaces",
    "covered_artifact_kinds",
    "covered_drift_states",
    "surfaces",
    "restore",
    "consumer_projections",
    "export_safe_summary"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "navigation_continuity_binding_packet"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "const": "search.m5.navigation_continuity.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "doc_ref": { "type": "string", "minLength": 1 },
    "schema_ref": { "type": "string", "minLength": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "source_spec_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supporting_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "covered_surfaces": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface" }
    },
    "covered_artifact_kinds": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/artifact_kind" }
    },
    "covered_drift_states": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/drift_state" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_binding" }
    },
    "restore": { "$ref": "#/$defs/restore_projection" },
    "consumer_projections": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "export_safe_summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface": {
      "type": "string",
      "enum": ["editor", "diff", "notebook", "docs", "search", "topology"]
    },
    "artifact_kind": {
      "type": "string",
      "enum": [
        "breadcrumb_trail",
        "outline_snapshot",
        "navigation_mark",
        "navigation_history_entry",
        "peek_context"
      ]
    },
    "drift_state": {
      "type": "string",
      "enum": [
        "bound",
        "remapped",
        "drifted",
        "missing_target",
        "scope_unavailable",
        "archived"
      ]
    },
    "history_role": {
      "type": "string",
      "enum": ["back", "forward", "recent"]
    },
    "consumer_class": {
      "type": "string",
      "enum": ["product_ui", "history_back_forward", "session_restore", "support_replay"]
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "surface",
        "canonical_target_ref",
        "drift_state",
        "remap_evidence_refs",
        "used_nearby_fallback",
        "recovery_choices",
        "authority_not_widened",
        "raw_boundary_material_excluded",
        "summary"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_kind": { "$ref": "#/$defs/artifact_kind" },
        "surface": { "$ref": "#/$defs/surface" },
        "label": { "type": "string", "minLength": 1 },
        "canonical_target_ref": { "type": "string", "minLength": 1 },
        "resolved_target_ref": { "type": "string", "minLength": 1 },
        "result_id_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Durable, surface-independent result URN. Never a display label or transient list index."
        },
        "query_session_id_ref": { "type": "string", "minLength": 1 },
        "origin_target_ref": { "type": "string", "minLength": 1 },
        "history_role": { "$ref": "#/$defs/history_role" },
        "drift_state": { "$ref": "#/$defs/drift_state" },
        "drift_reason": { "type": "string", "minLength": 1 },
        "remap_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "used_nearby_fallback": { "type": "boolean", "const": false },
        "recovery_choices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "authority_not_widened": { "type": "boolean", "const": true },
        "raw_boundary_material_excluded": { "type": "boolean", "const": true },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "surface_label", "artifacts", "summary"],
      "properties": {
        "surface": { "$ref": "#/$defs/surface" },
        "surface_label": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_binding" }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "restored_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id_ref",
        "drift_state",
        "target_resolves_under_current_scope",
        "artifact_preserved",
        "recovery_choices"
      ],
      "properties": {
        "artifact_id_ref": { "type": "string", "minLength": 1 },
        "drift_state": { "$ref": "#/$defs/drift_state" },
        "target_resolves_under_current_scope": { "type": "boolean" },
        "artifact_preserved": { "type": "boolean" },
        "restore_reason": { "type": "string", "minLength": 1 },
        "recovery_choices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "restore_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restore_packet_id", "restore_source_ref", "artifacts"],
      "properties": {
        "restore_packet_id": { "type": "string", "minLength": 1 },
        "restore_source_ref": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/restored_artifact" }
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_ref",
        "ingested_packet_id",
        "preserves_export_safe_ids",
        "preserves_drift_vocabulary",
        "preserves_drift_reasons",
        "preserves_origin_destination",
        "reuses_same_continuity_objects",
        "widens_authority",
        "ambient_authority_excluded",
        "summary"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "consumer_ref": { "type": "string", "minLength": 1 },
        "ingested_packet_id": {
          "type": "string",
          "const": "search.m5.navigation_continuity.v1"
        },
        "preserves_export_safe_ids": { "type": "boolean", "const": true },
        "preserves_drift_vocabulary": { "type": "boolean", "const": true },
        "preserves_drift_reasons": { "type": "boolean", "const": true },
        "preserves_origin_destination": { "type": "boolean", "const": true },
        "reuses_same_continuity_objects": { "type": "boolean", "const": true },
        "widens_authority": { "type": "boolean", "const": false },
        "ambient_authority_excluded": { "type": "boolean", "const": true },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
