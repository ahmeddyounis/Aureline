{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/search/m5-search-navigation-certification.schema.json",
  "title": "Aureline M5 search/navigation certification packet",
  "description": "Boundary schema for the m5_search_navigation_certification_packet emitted by aureline-search. The packet certifies that the four M5 search/docs/graph depth lanes (query-session identity, ranking explainability, saved-query privacy, and navigation continuity) carry current evidence. Each lane cites its own evidence packet, boundary schema, reviewer doc, review artifact, fixture corpus, and record kind together with that evidence's freshness and a recheck deadline. The certification state is derived fail-closed: stale or schema-superseded evidence drops the lane to retest_pending, a degraded source lane or a broken cross-surface parity drops it to limited, and missing evidence or a missing consumer binding drops it to unsupported. Help/About, docs/help, support export, and the claim-publication manifest ingest this one index by reference and narrow with it. The packet is metadata-safe and never embeds raw query text, source bodies, provider payloads, or live credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "doc_ref",
    "schema_ref",
    "artifact_ref",
    "source_spec_refs",
    "supporting_contract_refs",
    "certified_lanes",
    "parity_surfaces",
    "freshness_policy",
    "lane_rows",
    "parity_audits",
    "downgrade_rules",
    "consumer_bindings",
    "export_safe_summary"
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "lane_class": {
      "type": "string",
      "enum": [
        "query_session_identity",
        "ranking_explainability",
        "saved_query_privacy",
        "navigation_continuity"
      ]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "product_surface",
        "cli_headless",
        "docs_help",
        "support_export"
      ]
    },
    "freshness_class": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "missing",
        "superseded"
      ]
    },
    "certification_state": {
      "type": "string",
      "enum": [
        "certified",
        "retest_pending",
        "limited",
        "unsupported"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "evidence_stale",
        "schema_version_drift",
        "degraded_source_state",
        "surface_parity_break",
        "evidence_missing",
        "consumer_binding_missing"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "help_about",
        "docs_help",
        "support_export",
        "claim_publication_manifest"
      ]
    },
    "freshness_state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness_class",
        "token",
        "label",
        "requires_retest",
        "summary"
      ],
      "properties": {
        "freshness_class": { "$ref": "#/$defs/freshness_class" },
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "requires_retest": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recheck_window_days",
        "freshness_states",
        "summary"
      ],
      "properties": {
        "recheck_window_days": {
          "type": "integer",
          "minimum": 1
        },
        "freshness_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/freshness_state_row" },
          "minItems": 1
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "lane_certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification_row_id",
        "lane",
        "lane_label",
        "certified_claim",
        "evidence_packet_id",
        "evidence_schema_ref",
        "evidence_doc_ref",
        "evidence_artifact_ref",
        "evidence_fixture_dir",
        "evidence_record_kind",
        "evidence_freshness",
        "evidence_generated_at",
        "recheck_by",
        "source_state_token",
        "source_state_is_degraded",
        "certification_state",
        "stale_proof_tokens",
        "downgrade_rule_ids",
        "summary"
      ],
      "properties": {
        "certification_row_id": { "$ref": "#/$defs/non_empty_string" },
        "lane": { "$ref": "#/$defs/lane_class" },
        "lane_label": { "$ref": "#/$defs/non_empty_string" },
        "certified_claim": { "$ref": "#/$defs/non_empty_string" },
        "evidence_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "evidence_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_artifact_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_fixture_dir": { "$ref": "#/$defs/non_empty_string" },
        "evidence_record_kind": { "$ref": "#/$defs/non_empty_string" },
        "evidence_freshness": { "$ref": "#/$defs/freshness_class" },
        "evidence_generated_at": { "type": "string" },
        "recheck_by": { "$ref": "#/$defs/non_empty_string" },
        "source_state_token": { "$ref": "#/$defs/non_empty_string" },
        "source_state_is_degraded": { "type": "boolean" },
        "certification_state": { "$ref": "#/$defs/certification_state" },
        "stale_proof_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "downgrade_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_parity_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "surface_label",
        "in_parity",
        "projected_state_token",
        "note"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/surface_class" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "in_parity": { "type": "boolean" },
        "projected_state_token": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "parity_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "surface_parity",
        "all_in_parity",
        "summary"
      ],
      "properties": {
        "lane": { "$ref": "#/$defs/lane_class" },
        "surface_parity": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_parity_row" },
          "minItems": 1
        },
        "all_in_parity": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_class",
        "source_state",
        "downgraded_state",
        "required_effect",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_class": { "$ref": "#/$defs/downgrade_trigger" },
        "source_state": { "$ref": "#/$defs/certification_state" },
        "downgraded_state": { "$ref": "#/$defs/certification_state" },
        "required_effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_ref",
        "ingested_packet_id",
        "lane_row_count",
        "required_verbatim_fields",
        "narrow_on_stale_evidence",
        "explicit_limited_state_labels_required",
        "summary"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "lane_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_verbatim_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrow_on_stale_evidence": { "type": "boolean" },
        "explicit_limited_state_labels_required": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  },
  "properties": {
    "record_kind": {
      "const": "m5_search_navigation_certification_packet"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "const": "search.m5.search_navigation_certification.v1"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "doc_ref": {
      "const": "docs/search/m5-search-navigation-certification.md"
    },
    "schema_ref": {
      "const": "schemas/search/m5-search-navigation-certification.schema.json"
    },
    "artifact_ref": {
      "const": "artifacts/search/m5/m5-search-navigation-certification.md"
    },
    "source_spec_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 1
    },
    "supporting_contract_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 1
    },
    "certified_lanes": {
      "type": "array",
      "items": { "$ref": "#/$defs/lane_class" },
      "minItems": 1
    },
    "parity_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_class" },
      "minItems": 1
    },
    "freshness_policy": {
      "$ref": "#/$defs/freshness_policy"
    },
    "lane_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/lane_certification_row" },
      "minItems": 1
    },
    "parity_audits": {
      "type": "array",
      "items": { "$ref": "#/$defs/parity_audit" },
      "minItems": 1
    },
    "downgrade_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_rule" },
      "minItems": 1
    },
    "consumer_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_binding" },
      "minItems": 1
    },
    "export_safe_summary": {
      "$ref": "#/$defs/non_empty_string"
    }
  }
}
