{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-event-coverage.schema.json",
  "title": "Aureline M5 event-class non-visual coverage",
  "description": "Export-safe catalog that materializes one coverage row per governed M5 dynamic-event family (diagnostics, completion/snippet/session changes, run/debug/test transitions, terminal command boundaries, collaboration control/recording changes, AI patch/review milestones, and stale/degraded-truth transitions). Each family enumerates the concrete meaning-changing dynamic events a professional user follows non-visually, binding every event to the announcement-grammar class it narrates through, a stable concise-identity message id, whether it discloses a blocked/degraded reason, and the reopenable durable fallback surface that preserves the same identity and state labels the user heard. Only meaning-changing events enter the assistive channel; every family can announce a blocked/degraded reason; and a family auto-narrows when its bridge or proof state goes stale. The controlled event-class and durable-fallback-surface vocabularies are reused verbatim from the announcement grammar, and the shared state vocabularies from the frozen dynamic-surface matrix; the coverage-shaped vocabularies (event family, event producer, reason class) are frozen in a self-describing coverage vocabulary set. Raw provider payloads, credentials, secret material, screenshots, and untranslated free-text prose never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "catalog_label",
    "families",
    "shared_vocabulary_set",
    "announcement_vocabulary_set",
    "coverage_vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_event_class_coverage_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "families": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/family_coverage"
      }
    },
    "shared_vocabulary_set": {
      "$ref": "#/$defs/shared_vocabulary_set"
    },
    "announcement_vocabulary_set": {
      "$ref": "#/$defs/announcement_vocabulary_set"
    },
    "coverage_vocabulary_set": {
      "$ref": "#/$defs/coverage_vocabulary_set"
    },
    "conformance_review": {
      "$ref": "#/$defs/conformance_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "event_family": {
      "type": "string",
      "enum": [
        "diagnostics",
        "completion_and_session",
        "run_debug_test",
        "terminal_boundary",
        "collaboration_control",
        "ai_patch_review",
        "stale_degraded_truth"
      ]
    },
    "event_producer": {
      "type": "string",
      "enum": [
        "editor",
        "terminal",
        "debug",
        "review",
        "collab",
        "ai",
        "notebook",
        "shell"
      ]
    },
    "reason_class": {
      "type": "string",
      "enum": [
        "not_applicable",
        "blocked",
        "degraded",
        "stale",
        "unavailable",
        "policy_restricted"
      ]
    },
    "announcement_event_class": {
      "type": "string",
      "enum": [
        "mode_or_state_change",
        "blocker_raised",
        "progress_milestone",
        "selection_or_context_change",
        "success_with_recovery",
        "degraded_or_stale_truth"
      ]
    },
    "durable_fallback_surface": {
      "type": "string",
      "enum": [
        "activity_row",
        "run_header",
        "patch_review_header",
        "banner_detail",
        "selection_summary",
        "notification_center_entry",
        "status_detail"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "accessible_fidelity": {
      "type": "string",
      "enum": [
        "full_accessible",
        "degraded_accessible",
        "summary_only"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "bridge_unavailable",
        "bridge_partial_or_stale",
        "focus_teleported",
        "focus_lost",
        "live_region_spam",
        "announcement_meaning_lost",
        "non_visual_fidelity_lost",
        "label_or_role_drift",
        "pointer_or_hover_dependence",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "editor",
        "terminal",
        "notebook",
        "data_grid",
        "review",
        "help",
        "presentation",
        "support_export",
        "ai_surfaces"
      ]
    },
    "degraded_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "announces_reason",
        "reason_class"
      ],
      "properties": {
        "announces_reason": {
          "type": "boolean"
        },
        "reason_class": {
          "$ref": "#/$defs/reason_class"
        }
      }
    },
    "durable_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "surface_ref",
        "reopenable"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/durable_fallback_surface"
        },
        "surface_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reopenable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "dynamic_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "label",
        "meaning_changing",
        "announcement_event_class",
        "identity_message_id",
        "degraded_disclosure",
        "durable_fallback"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "meaning_changing": {
          "type": "boolean",
          "const": true
        },
        "announcement_event_class": {
          "$ref": "#/$defs/announcement_event_class"
        },
        "identity_message_id": {
          "type": "string",
          "pattern": "^event\\."
        },
        "degraded_disclosure": {
          "$ref": "#/$defs/degraded_disclosure"
        },
        "durable_fallback": {
          "$ref": "#/$defs/durable_fallback"
        }
      }
    },
    "family_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "family",
        "label",
        "owner_role",
        "qualification",
        "non_visual_fidelity",
        "producers",
        "events",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "family_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "family": {
          "$ref": "#/$defs/event_family"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "non_visual_fidelity": {
          "$ref": "#/$defs/accessible_fidelity"
        },
        "producers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event_producer"
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dynamic_event"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "shared_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "announcement_politeness",
        "coalescing_strategies",
        "fallback_durabilities",
        "non_visual_fidelities",
        "bridge_states",
        "focus_return_dispositions",
        "semantic_role_classes"
      ],
      "properties": {
        "announcement_politeness": {
          "type": "array",
          "const": [
            "polite",
            "assertive",
            "silent"
          ]
        },
        "coalescing_strategies": {
          "type": "array",
          "const": [
            "none",
            "dedupe_same_meaning",
            "last_meaning_wins_with_count",
            "start_and_terminal_only",
            "focused_surface_only"
          ]
        },
        "fallback_durabilities": {
          "type": "array",
          "const": [
            "immediate",
            "coalesced",
            "on_focus",
            "durable_surface_only",
            "not_delivered_silent"
          ]
        },
        "non_visual_fidelities": {
          "type": "array",
          "const": [
            "full_accessible",
            "degraded_accessible",
            "summary_only",
            "inspect_only",
            "unsupported_blocked",
            "not_applicable"
          ]
        },
        "bridge_states": {
          "type": "array",
          "const": [
            "bridged_active",
            "partial",
            "stale",
            "unavailable"
          ]
        },
        "focus_return_dispositions": {
          "type": "array",
          "const": [
            "returned_exact",
            "returned_nearest_safe_ancestor",
            "returned_current_batch_or_detail_owner",
            "returned_placeholder_announced",
            "focus_loss_denied",
            "focus_not_applicable_non_interactive"
          ]
        },
        "semantic_role_classes": {
          "type": "array",
          "const": [
            "landmark_region",
            "structure_group",
            "interactive_control",
            "text_document",
            "status_region",
            "live_log_region",
            "data_grid_cell",
            "notebook_cell"
          ]
        }
      }
    },
    "announcement_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_classes",
        "durable_fallback_surfaces",
        "value_kinds",
        "suppression_rules"
      ],
      "properties": {
        "event_classes": {
          "type": "array",
          "const": [
            "mode_or_state_change",
            "blocker_raised",
            "progress_milestone",
            "selection_or_context_change",
            "success_with_recovery",
            "degraded_or_stale_truth"
          ]
        },
        "durable_fallback_surfaces": {
          "type": "array",
          "const": [
            "activity_row",
            "run_header",
            "patch_review_header",
            "banner_detail",
            "selection_summary",
            "notification_center_entry",
            "status_detail"
          ]
        },
        "value_kinds": {
          "type": "array",
          "const": [
            "mode_name",
            "state_name",
            "count",
            "duration_label",
            "severity_label",
            "surface_name",
            "item_identity",
            "recovery_label",
            "freshness_label"
          ]
        },
        "suppression_rules": {
          "type": "array",
          "const": [
            "suppress_unchanged_meaning",
            "suppress_repaint_only_ticks",
            "suppress_duplicate_within_window",
            "suppress_background_refresh_when_unfocused",
            "suppress_low_value_progress_midpoints",
            "suppress_when_durable_surface_visible"
          ]
        }
      }
    },
    "coverage_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_families",
        "event_producers",
        "reason_classes"
      ],
      "properties": {
        "event_families": {
          "type": "array",
          "const": [
            "diagnostics",
            "completion_and_session",
            "run_debug_test",
            "terminal_boundary",
            "collaboration_control",
            "ai_patch_review",
            "stale_degraded_truth"
          ]
        },
        "event_producers": {
          "type": "array",
          "const": [
            "editor",
            "terminal",
            "debug",
            "review",
            "collab",
            "ai",
            "notebook",
            "shell"
          ]
        },
        "reason_classes": {
          "type": "array",
          "const": [
            "not_applicable",
            "blocked",
            "degraded",
            "stale",
            "unavailable",
            "policy_restricted"
          ]
        }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflows_narrate_transitions_without_visual_only_cues",
        "each_family_announces_identity_plus_blocked_or_degraded_reason",
        "events_route_through_one_announcement_grammar_not_per_surface_prose",
        "durable_fallback_preserves_event_identity_and_state_labels",
        "only_meaning_changing_events_enter_assistive_channel",
        "support_export_can_reconstruct_what_user_should_have_been_told",
        "claimed_families_auto_narrow_when_bridge_or_proof_stale",
        "downgrade_narrows_instead_of_hides",
        "no_visual_only_or_pointer_only_event_source"
      ],
      "properties": {
        "workflows_narrate_transitions_without_visual_only_cues": {
          "type": "boolean",
          "const": true
        },
        "each_family_announces_identity_plus_blocked_or_degraded_reason": {
          "type": "boolean",
          "const": true
        },
        "events_route_through_one_announcement_grammar_not_per_surface_prose": {
          "type": "boolean",
          "const": true
        },
        "durable_fallback_preserves_event_identity_and_state_labels": {
          "type": "boolean",
          "const": true
        },
        "only_meaning_changing_events_enter_assistive_channel": {
          "type": "boolean",
          "const": true
        },
        "support_export_can_reconstruct_what_user_should_have_been_told": {
          "type": "boolean",
          "const": true
        },
        "claimed_families_auto_narrow_when_bridge_or_proof_stale": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "no_visual_only_or_pointer_only_event_source": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editor_routes_diagnostics_and_assist",
        "terminal_routes_command_boundaries",
        "debug_and_test_route_transitions",
        "review_and_ai_route_milestones",
        "collaboration_routes_control_changes",
        "notebook_routes_session_changes",
        "shell_routes_stale_degraded_truth",
        "support_export_reuses_coverage",
        "docs_help_reuse_coverage",
        "at_conformance_packets_reuse_coverage"
      ],
      "properties": {
        "editor_routes_diagnostics_and_assist": {
          "type": "boolean",
          "const": true
        },
        "terminal_routes_command_boundaries": {
          "type": "boolean",
          "const": true
        },
        "debug_and_test_route_transitions": {
          "type": "boolean",
          "const": true
        },
        "review_and_ai_route_milestones": {
          "type": "boolean",
          "const": true
        },
        "collaboration_routes_control_changes": {
          "type": "boolean",
          "const": true
        },
        "notebook_routes_session_changes": {
          "type": "boolean",
          "const": true
        },
        "shell_routes_stale_degraded_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_coverage": {
          "type": "boolean",
          "const": true
        },
        "docs_help_reuse_coverage": {
          "type": "boolean",
          "const": true
        },
        "at_conformance_packets_reuse_coverage": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required",
        "stable_promotion_blocks_without_mapped_proof"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        },
        "stable_promotion_blocks_without_mapped_proof": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
