{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-announcement-grammar.schema.json",
  "title": "Aureline M5 live-announcement grammar",
  "description": "Export-safe catalog that materializes one live-announcement grammar class per governed M5 dynamic-event class (mode/state change, blocker, progress milestone, selection/context change, success-with-recovery, and degraded/stale truth). Each class binds a stable message id and placeholder-driven template to its live-region channel (polite/assertive/silent), its required runtime fields, its coalescing budget and suppression rules, and the durable fallback surface a screen-reader user can reopen. Narrated state changes use placeholder insertion rather than concatenated fragments; coalescing budgets and suppression rules keep repeated polls, streaming updates, and background refreshes from flooding the live region; and every high-value announcement has a durable UI counterpart. The controlled channel/coalescing/fallback vocabularies are reused verbatim from the frozen dynamic-surface matrix; the grammar-shaped vocabularies (dynamic-event class, durable fallback surface, placeholder value kind, suppression rule) are frozen in a self-describing grammar vocabulary set. Raw provider payloads, credentials, secret material, screenshots, and untranslated free-text prose never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "catalog_label",
    "classes",
    "shared_vocabulary_set",
    "grammar_vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_live_announcement_grammar_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "classes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/grammar_class"
      }
    },
    "shared_vocabulary_set": {
      "$ref": "#/$defs/shared_vocabulary_set"
    },
    "grammar_vocabulary_set": {
      "$ref": "#/$defs/grammar_vocabulary_set"
    },
    "conformance_review": {
      "$ref": "#/$defs/conformance_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "event_class": {
      "type": "string",
      "enum": [
        "mode_or_state_change",
        "blocker_raised",
        "progress_milestone",
        "selection_or_context_change",
        "success_with_recovery",
        "degraded_or_stale_truth"
      ]
    },
    "durable_fallback_surface": {
      "type": "string",
      "enum": [
        "activity_row",
        "run_header",
        "patch_review_header",
        "banner_detail",
        "selection_summary",
        "notification_center_entry",
        "status_detail"
      ]
    },
    "value_kind": {
      "type": "string",
      "enum": [
        "mode_name",
        "state_name",
        "count",
        "duration_label",
        "severity_label",
        "surface_name",
        "item_identity",
        "recovery_label",
        "freshness_label"
      ]
    },
    "suppression_rule": {
      "type": "string",
      "enum": [
        "suppress_unchanged_meaning",
        "suppress_repaint_only_ticks",
        "suppress_duplicate_within_window",
        "suppress_background_refresh_when_unfocused",
        "suppress_low_value_progress_midpoints",
        "suppress_when_durable_surface_visible"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "announcement_politeness": {
      "type": "string",
      "enum": [
        "polite",
        "assertive",
        "silent"
      ]
    },
    "coalescing_strategy": {
      "type": "string",
      "enum": [
        "none",
        "dedupe_same_meaning",
        "last_meaning_wins_with_count",
        "start_and_terminal_only",
        "focused_surface_only"
      ]
    },
    "fallback_durability": {
      "type": "string",
      "enum": [
        "immediate",
        "coalesced",
        "on_focus",
        "durable_surface_only",
        "not_delivered_silent"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "bridge_unavailable",
        "bridge_partial_or_stale",
        "focus_teleported",
        "focus_lost",
        "live_region_spam",
        "announcement_meaning_lost",
        "non_visual_fidelity_lost",
        "label_or_role_drift",
        "pointer_or_hover_dependence",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "editor",
        "terminal",
        "notebook",
        "data_grid",
        "review",
        "help",
        "presentation",
        "support_export",
        "ai_surfaces"
      ]
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value_kind",
        "required"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "value_kind": {
          "$ref": "#/$defs/value_kind"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "message_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "template",
        "placeholders"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "pattern": "^announcement\\."
        },
        "template": {
          "$ref": "#/$defs/non_empty_string"
        },
        "placeholders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placeholder"
          }
        }
      }
    },
    "coalescing_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "max_announcements_per_window",
        "window_seconds",
        "min_interval_ms",
        "suppress_unchanged_meaning"
      ],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/coalescing_strategy",
          "not": {
            "const": "none"
          }
        },
        "max_announcements_per_window": {
          "type": "integer",
          "minimum": 1
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "min_interval_ms": {
          "type": "integer",
          "minimum": 0
        },
        "suppress_unchanged_meaning": {
          "type": "boolean"
        }
      }
    },
    "durable_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "surface_ref",
        "reopenable"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/durable_fallback_surface"
        },
        "surface_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reopenable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "grammar_class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "event_class",
        "label",
        "owner_role",
        "qualification",
        "channel",
        "message_template",
        "required_fields",
        "coalescing_budget",
        "suppression_rules",
        "fallback_durability",
        "durable_fallback",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "class_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "event_class": {
          "$ref": "#/$defs/event_class"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "channel": {
          "$ref": "#/$defs/announcement_politeness"
        },
        "message_template": {
          "$ref": "#/$defs/message_template"
        },
        "required_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "coalescing_budget": {
          "$ref": "#/$defs/coalescing_budget"
        },
        "suppression_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/suppression_rule"
          }
        },
        "fallback_durability": {
          "$ref": "#/$defs/fallback_durability"
        },
        "durable_fallback": {
          "$ref": "#/$defs/durable_fallback"
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "shared_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "announcement_politeness",
        "coalescing_strategies",
        "fallback_durabilities",
        "non_visual_fidelities",
        "bridge_states",
        "focus_return_dispositions",
        "semantic_role_classes"
      ],
      "properties": {
        "announcement_politeness": {
          "type": "array",
          "const": [
            "polite",
            "assertive",
            "silent"
          ]
        },
        "coalescing_strategies": {
          "type": "array",
          "const": [
            "none",
            "dedupe_same_meaning",
            "last_meaning_wins_with_count",
            "start_and_terminal_only",
            "focused_surface_only"
          ]
        },
        "fallback_durabilities": {
          "type": "array",
          "const": [
            "immediate",
            "coalesced",
            "on_focus",
            "durable_surface_only",
            "not_delivered_silent"
          ]
        },
        "non_visual_fidelities": {
          "type": "array",
          "const": [
            "full_accessible",
            "degraded_accessible",
            "summary_only",
            "inspect_only",
            "unsupported_blocked",
            "not_applicable"
          ]
        },
        "bridge_states": {
          "type": "array",
          "const": [
            "bridged_active",
            "partial",
            "stale",
            "unavailable"
          ]
        },
        "focus_return_dispositions": {
          "type": "array",
          "const": [
            "returned_exact",
            "returned_nearest_safe_ancestor",
            "returned_current_batch_or_detail_owner",
            "returned_placeholder_announced",
            "focus_loss_denied",
            "focus_not_applicable_non_interactive"
          ]
        },
        "semantic_role_classes": {
          "type": "array",
          "const": [
            "landmark_region",
            "structure_group",
            "interactive_control",
            "text_document",
            "status_region",
            "live_log_region",
            "data_grid_cell",
            "notebook_cell"
          ]
        }
      }
    },
    "grammar_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_classes",
        "durable_fallback_surfaces",
        "value_kinds",
        "suppression_rules"
      ],
      "properties": {
        "event_classes": {
          "type": "array",
          "const": [
            "mode_or_state_change",
            "blocker_raised",
            "progress_milestone",
            "selection_or_context_change",
            "success_with_recovery",
            "degraded_or_stale_truth"
          ]
        },
        "durable_fallback_surfaces": {
          "type": "array",
          "const": [
            "activity_row",
            "run_header",
            "patch_review_header",
            "banner_detail",
            "selection_summary",
            "notification_center_entry",
            "status_detail"
          ]
        },
        "value_kinds": {
          "type": "array",
          "const": [
            "mode_name",
            "state_name",
            "count",
            "duration_label",
            "severity_label",
            "surface_name",
            "item_identity",
            "recovery_label",
            "freshness_label"
          ]
        },
        "suppression_rules": {
          "type": "array",
          "const": [
            "suppress_unchanged_meaning",
            "suppress_repaint_only_ticks",
            "suppress_duplicate_within_window",
            "suppress_background_refresh_when_unfocused",
            "suppress_low_value_progress_midpoints",
            "suppress_when_durable_surface_visible"
          ]
        }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_governed_grammar_not_per_surface_prose",
        "stable_message_ids_with_placeholders_not_concatenated_fragments",
        "polite_assertive_channel_rules_enforced",
        "coalescing_budgets_bound_repeated_narration",
        "repeated_polls_and_refreshes_do_not_flood_live_region",
        "every_high_value_announcement_has_durable_fallback",
        "narrated_state_points_back_to_durable_surface",
        "announcements_convey_meaning_not_repaint_noise",
        "claimed_classes_auto_narrow_when_bridge_or_proof_stale",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "one_governed_grammar_not_per_surface_prose": {
          "type": "boolean",
          "const": true
        },
        "stable_message_ids_with_placeholders_not_concatenated_fragments": {
          "type": "boolean",
          "const": true
        },
        "polite_assertive_channel_rules_enforced": {
          "type": "boolean",
          "const": true
        },
        "coalescing_budgets_bound_repeated_narration": {
          "type": "boolean",
          "const": true
        },
        "repeated_polls_and_refreshes_do_not_flood_live_region": {
          "type": "boolean",
          "const": true
        },
        "every_high_value_announcement_has_durable_fallback": {
          "type": "boolean",
          "const": true
        },
        "narrated_state_points_back_to_durable_surface": {
          "type": "boolean",
          "const": true
        },
        "announcements_convey_meaning_not_repaint_noise": {
          "type": "boolean",
          "const": true
        },
        "claimed_classes_auto_narrow_when_bridge_or_proof_stale": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_consumes_grammar",
        "editor_consumes_grammar",
        "terminal_consumes_grammar",
        "notebook_consumes_grammar",
        "data_grid_consumes_grammar",
        "review_consumes_grammar",
        "notifications_consume_grammar",
        "help_documents_grammar",
        "support_export_reuses_grammar",
        "at_conformance_packets_reuse_grammar"
      ],
      "properties": {
        "shell_consumes_grammar": {
          "type": "boolean",
          "const": true
        },
        "editor_consumes_grammar": {
          "type": "boolean",
          "const": true
        },
        "terminal_consumes_grammar": {
          "type": "boolean",
          "const": true
        },
        "notebook_consumes_grammar": {
          "type": "boolean",
          "const": true
        },
        "data_grid_consumes_grammar": {
          "type": "boolean",
          "const": true
        },
        "review_consumes_grammar": {
          "type": "boolean",
          "const": true
        },
        "notifications_consume_grammar": {
          "type": "boolean",
          "const": true
        },
        "help_documents_grammar": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_grammar": {
          "type": "boolean",
          "const": true
        },
        "at_conformance_packets_reuse_grammar": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required",
        "stable_promotion_blocks_without_mapped_proof"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        },
        "stable_promotion_blocks_without_mapped_proof": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
