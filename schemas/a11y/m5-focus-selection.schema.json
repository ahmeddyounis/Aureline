{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-focus-selection.schema.json",
  "title": "Aureline M5 focus-return and stable-selection contract",
  "description": "Export-safe contract that materializes one focus-zone row per governed M5 surface (modal dialogs, sheets, command palettes, popovers, rename fields, inspector promotions, dense collections, streamed lists, shell zones, multi-window layouts, and follow/presentation modes). Each zone binds an explicit focus-return rule with a real return target and a safe fallback for when the invoking object no longer exists, a stable-item-identity rule that preserves focus and selection by stable item identity (never row index) across virtualization, refresh, streaming inserts, filtering, sort changes, and multi-window restore/layout adjustments, and — for dense collections only — a roving-tabindex rule that pins a single tab stop, predictable arrow/home/end/page navigation, and a disclosed (never silent) multi-selection narrowing. No zone may claim keyboard completeness unless it states and proves its focus-return and stable-item-identity behavior, and a zone auto-narrows when its bridge or proof state goes stale. The controlled focus-return-disposition vocabulary is reused verbatim from the frozen dynamic-surface matrix and the durable-fallback-surface vocabulary from the announcement grammar; the focus-shaped vocabularies (zone kind, interaction model, async-update class, identity strategy, collection navigation key) are frozen in a self-describing focus vocabulary set. Raw provider payloads, credentials, secret material, screenshots, and untranslated free-text prose never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "contract_label",
    "zones",
    "shared_vocabulary_set",
    "focus_vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_focus_and_selection_contract"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "contract_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "zones": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/focus_zone_contract"
      }
    },
    "shared_vocabulary_set": {
      "$ref": "#/$defs/shared_vocabulary_set"
    },
    "focus_vocabulary_set": {
      "$ref": "#/$defs/focus_vocabulary_set"
    },
    "conformance_review": {
      "$ref": "#/$defs/conformance_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "zone_kind": {
      "type": "string",
      "enum": [
        "modal_dialog",
        "sheet",
        "command_palette",
        "popover",
        "rename_field",
        "inspector_promotion",
        "dense_collection",
        "streamed_list",
        "shell_zone",
        "multi_window_layout",
        "follow_presentation"
      ]
    },
    "interaction_model": {
      "type": "string",
      "enum": [
        "transient_overlay",
        "dense_collection",
        "shell_zone",
        "multi_window_layout",
        "follow_presentation"
      ]
    },
    "async_update_class": {
      "type": "string",
      "enum": [
        "virtualization",
        "refresh",
        "streaming_insert",
        "filtering",
        "sort_change",
        "multi_window_restore",
        "layout_adjustment",
        "overlay_teardown"
      ]
    },
    "identity_strategy": {
      "type": "string",
      "enum": [
        "stable_key",
        "content_hash",
        "path_or_uri",
        "row_index_only"
      ]
    },
    "collection_nav_key": {
      "type": "string",
      "enum": [
        "arrow_up_down",
        "arrow_left_right",
        "home_end",
        "page_up_down",
        "type_ahead"
      ]
    },
    "focus_return_disposition": {
      "type": "string",
      "enum": [
        "returned_exact",
        "returned_nearest_safe_ancestor",
        "returned_current_batch_or_detail_owner",
        "returned_placeholder_announced",
        "focus_loss_denied",
        "focus_not_applicable_non_interactive"
      ]
    },
    "durable_fallback_surface": {
      "type": "string",
      "enum": [
        "activity_row",
        "run_header",
        "patch_review_header",
        "banner_detail",
        "selection_summary",
        "notification_center_entry",
        "status_detail"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "accessible_fidelity": {
      "type": "string",
      "enum": [
        "full_accessible",
        "degraded_accessible",
        "summary_only"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "bridge_unavailable",
        "bridge_partial_or_stale",
        "focus_teleported",
        "focus_lost",
        "live_region_spam",
        "announcement_meaning_lost",
        "non_visual_fidelity_lost",
        "label_or_role_drift",
        "pointer_or_hover_dependence",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "editor",
        "terminal",
        "notebook",
        "data_grid",
        "review",
        "help",
        "presentation",
        "support_export",
        "ai_surfaces"
      ]
    },
    "focus_return_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "return_target_ref",
        "primary_disposition",
        "safe_fallback_disposition",
        "announces_return"
      ],
      "properties": {
        "return_target_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "primary_disposition": {
          "$ref": "#/$defs/focus_return_disposition"
        },
        "safe_fallback_disposition": {
          "type": "string",
          "enum": [
            "returned_nearest_safe_ancestor",
            "returned_current_batch_or_detail_owner",
            "returned_placeholder_announced"
          ]
        },
        "announces_return": {
          "type": "boolean"
        }
      }
    },
    "stable_identity_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_strategy",
        "preserves_focus",
        "preserves_selection",
        "preserved_across"
      ],
      "properties": {
        "identity_strategy": {
          "type": "string",
          "enum": [
            "stable_key",
            "content_hash",
            "path_or_uri"
          ]
        },
        "preserves_focus": {
          "type": "boolean",
          "const": true
        },
        "preserves_selection": {
          "type": "boolean",
          "const": true
        },
        "preserved_across": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/async_update_class"
          }
        }
      }
    },
    "roving_tabindex_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_tab_stop",
        "navigation_keys",
        "multi_selection_narrowing_announced"
      ],
      "properties": {
        "single_tab_stop": {
          "type": "boolean",
          "const": true
        },
        "navigation_keys": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/collection_nav_key"
          }
        },
        "multi_selection_narrowing_announced": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "durable_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "surface_ref",
        "reopenable"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/durable_fallback_surface"
        },
        "surface_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reopenable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "focus_zone_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "zone_kind",
        "interaction_model",
        "label",
        "owner_role",
        "qualification",
        "non_visual_fidelity",
        "keyboard_complete_claim",
        "focus_return",
        "stable_identity",
        "roving_tabindex",
        "durable_fallback",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^focus-zone:"
        },
        "zone_kind": {
          "$ref": "#/$defs/zone_kind"
        },
        "interaction_model": {
          "$ref": "#/$defs/interaction_model"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "non_visual_fidelity": {
          "$ref": "#/$defs/accessible_fidelity"
        },
        "keyboard_complete_claim": {
          "type": "boolean"
        },
        "focus_return": {
          "$ref": "#/$defs/focus_return_rule"
        },
        "stable_identity": {
          "$ref": "#/$defs/stable_identity_rule"
        },
        "roving_tabindex": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/roving_tabindex_rule"
            }
          ]
        },
        "durable_fallback": {
          "$ref": "#/$defs/durable_fallback"
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "shared_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "announcement_politeness",
        "coalescing_strategies",
        "fallback_durabilities",
        "non_visual_fidelities",
        "bridge_states",
        "focus_return_dispositions",
        "semantic_role_classes"
      ],
      "properties": {
        "announcement_politeness": {
          "type": "array",
          "const": [
            "polite",
            "assertive",
            "silent"
          ]
        },
        "coalescing_strategies": {
          "type": "array",
          "const": [
            "none",
            "dedupe_same_meaning",
            "last_meaning_wins_with_count",
            "start_and_terminal_only",
            "focused_surface_only"
          ]
        },
        "fallback_durabilities": {
          "type": "array",
          "const": [
            "immediate",
            "coalesced",
            "on_focus",
            "durable_surface_only",
            "not_delivered_silent"
          ]
        },
        "non_visual_fidelities": {
          "type": "array",
          "const": [
            "full_accessible",
            "degraded_accessible",
            "summary_only",
            "inspect_only",
            "unsupported_blocked",
            "not_applicable"
          ]
        },
        "bridge_states": {
          "type": "array",
          "const": [
            "bridged_active",
            "partial",
            "stale",
            "unavailable"
          ]
        },
        "focus_return_dispositions": {
          "type": "array",
          "const": [
            "returned_exact",
            "returned_nearest_safe_ancestor",
            "returned_current_batch_or_detail_owner",
            "returned_placeholder_announced",
            "focus_loss_denied",
            "focus_not_applicable_non_interactive"
          ]
        },
        "semantic_role_classes": {
          "type": "array",
          "const": [
            "landmark_region",
            "structure_group",
            "interactive_control",
            "text_document",
            "status_region",
            "live_log_region",
            "data_grid_cell",
            "notebook_cell"
          ]
        }
      }
    },
    "focus_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_kinds",
        "interaction_models",
        "async_update_classes",
        "identity_strategies",
        "collection_nav_keys"
      ],
      "properties": {
        "zone_kinds": {
          "type": "array",
          "const": [
            "modal_dialog",
            "sheet",
            "command_palette",
            "popover",
            "rename_field",
            "inspector_promotion",
            "dense_collection",
            "streamed_list",
            "shell_zone",
            "multi_window_layout",
            "follow_presentation"
          ]
        },
        "interaction_models": {
          "type": "array",
          "const": [
            "transient_overlay",
            "dense_collection",
            "shell_zone",
            "multi_window_layout",
            "follow_presentation"
          ]
        },
        "async_update_classes": {
          "type": "array",
          "const": [
            "virtualization",
            "refresh",
            "streaming_insert",
            "filtering",
            "sort_change",
            "multi_window_restore",
            "layout_adjustment",
            "overlay_teardown"
          ]
        },
        "identity_strategies": {
          "type": "array",
          "const": [
            "stable_key",
            "content_hash",
            "path_or_uri",
            "row_index_only"
          ]
        },
        "collection_nav_keys": {
          "type": "array",
          "const": [
            "arrow_up_down",
            "arrow_left_right",
            "home_end",
            "page_up_down",
            "type_ahead"
          ]
        }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transient_surfaces_declare_explicit_focus_return",
        "focus_never_teleports_or_vanishes_on_async_update",
        "safe_fallback_when_invoking_object_gone",
        "focus_and_selection_preserved_by_stable_item_identity",
        "no_row_index_based_focus_loss_or_selection_drift",
        "dense_collections_use_roving_single_tab_stop",
        "predictable_arrow_home_end_page_navigation",
        "no_silent_multi_selection_narrowing",
        "overlays_return_to_safe_working_context",
        "keyboard_complete_requires_focus_return_and_stable_identity",
        "claimed_zones_auto_narrow_when_bridge_or_proof_stale",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "transient_surfaces_declare_explicit_focus_return": {
          "type": "boolean",
          "const": true
        },
        "focus_never_teleports_or_vanishes_on_async_update": {
          "type": "boolean",
          "const": true
        },
        "safe_fallback_when_invoking_object_gone": {
          "type": "boolean",
          "const": true
        },
        "focus_and_selection_preserved_by_stable_item_identity": {
          "type": "boolean",
          "const": true
        },
        "no_row_index_based_focus_loss_or_selection_drift": {
          "type": "boolean",
          "const": true
        },
        "dense_collections_use_roving_single_tab_stop": {
          "type": "boolean",
          "const": true
        },
        "predictable_arrow_home_end_page_navigation": {
          "type": "boolean",
          "const": true
        },
        "no_silent_multi_selection_narrowing": {
          "type": "boolean",
          "const": true
        },
        "overlays_return_to_safe_working_context": {
          "type": "boolean",
          "const": true
        },
        "keyboard_complete_requires_focus_return_and_stable_identity": {
          "type": "boolean",
          "const": true
        },
        "claimed_zones_auto_narrow_when_bridge_or_proof_stale": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_returns_focus_on_overlay_teardown",
        "search_palette_returns_focus_to_invoker",
        "review_preserves_row_identity_across_refresh",
        "data_grid_uses_roving_tabindex",
        "notifications_route_focus_return_targets",
        "presentation_follow_mode_preserves_context",
        "multi_window_restore_preserves_identity",
        "support_export_reuses_contract",
        "docs_help_reuse_contract",
        "at_conformance_packets_reuse_contract"
      ],
      "properties": {
        "shell_returns_focus_on_overlay_teardown": {
          "type": "boolean",
          "const": true
        },
        "search_palette_returns_focus_to_invoker": {
          "type": "boolean",
          "const": true
        },
        "review_preserves_row_identity_across_refresh": {
          "type": "boolean",
          "const": true
        },
        "data_grid_uses_roving_tabindex": {
          "type": "boolean",
          "const": true
        },
        "notifications_route_focus_return_targets": {
          "type": "boolean",
          "const": true
        },
        "presentation_follow_mode_preserves_context": {
          "type": "boolean",
          "const": true
        },
        "multi_window_restore_preserves_identity": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_contract": {
          "type": "boolean",
          "const": true
        },
        "docs_help_reuse_contract": {
          "type": "boolean",
          "const": true
        },
        "at_conformance_packets_reuse_contract": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required",
        "stable_promotion_blocks_without_mapped_proof"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        },
        "stable_promotion_blocks_without_mapped_proof": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
