{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-dynamic-a11y-certification.schema.json",
  "title": "Aureline M5 dynamic-surface assistive-tech certification packet",
  "description": "Export-safe certification capstone that qualifies every claimed M5 custom-rendered dynamic surface (shell region, editor/terminal canvas, dense collection, notebook/data cell, review/diff, and durable overlay/sheet) across the six governed assistive-tech proof dimensions: bridge health, dynamic announcement coverage, focus-return, non-visual summaries, zoom/contrast/motion (visual-adaptation) parity, and the stale-proof downgrade rules. Each row binds every dimension to the proof packet that keeps it current, resolves a green/yellow/red traffic-light status (certified / limited / retest-pending / degraded), and resolves a release gate the release/public-truth automation reads: a surface that lacks current proof or carries a disclosed narrowing auto-narrows below its claim before Stable promotion, while an unwaived blocking regression blocks the claim and is named (never left invisible). Active waivers are disclosed with their scope (the waived dimension), accountable owner, and expiry, and the exact stale-proof causes are named per dimension. The shared state vocabularies are reused verbatim from the frozen dynamic-surface matrix, the diagnostic outcome/severity tokens from the AT diagnostics, and the protected surface families from the surface descriptors; the certification-shaped vocabularies (proof dimension, proof freshness state, certification status, certification signal, certification gate decision) are frozen in a self-describing vocabulary set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "surfaces",
    "vocabulary_set",
    "shared_vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "release_gate",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_dynamic_a11y_certification"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "report_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surfaces": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/surface_certification_row"
      }
    },
    "vocabulary_set": {
      "$ref": "#/$defs/certification_vocabulary_set"
    },
    "shared_vocabulary_set": {
      "$ref": "#/$defs/shared_vocabulary_set"
    },
    "conformance_review": {
      "$ref": "#/$defs/conformance_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "release_gate": {
      "$ref": "#/$defs/release_gate"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "certification_message_id": {
      "type": "string",
      "pattern": "^certification\\."
    },
    "proof_dimension": {
      "enum": [
        "bridge_health",
        "announcement_coverage",
        "focus_return",
        "non_visual_summaries",
        "visual_adaptation_parity",
        "stale_proof_downgrade"
      ]
    },
    "proof_freshness_state": {
      "enum": ["current", "stale", "missing"]
    },
    "certification_status": {
      "enum": ["certified", "limited", "retest_pending", "degraded"]
    },
    "certification_signal": {
      "enum": ["green", "yellow", "red"]
    },
    "certification_gate_decision": {
      "enum": ["certified_promote", "auto_narrowed", "blocked"]
    },
    "diagnostic_outcome": {
      "enum": ["pass", "regressed", "auto_narrowed", "not_applicable"]
    },
    "diagnostic_severity": {
      "enum": ["blocking", "advisory"]
    },
    "qualification_class": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "surface_family": {
      "enum": [
        "shell_region",
        "editor_canvas",
        "terminal_canvas",
        "dense_collection",
        "notebook_cell",
        "data_cell",
        "review_diff",
        "overlay_sheet"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "proof_stale",
        "bridge_unavailable",
        "bridge_partial_or_stale",
        "focus_teleported",
        "focus_lost",
        "live_region_spam",
        "announcement_meaning_lost",
        "non_visual_fidelity_lost",
        "label_or_role_drift",
        "pointer_or_hover_dependence",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "enum": [
        "shell",
        "editor",
        "terminal",
        "notebook",
        "data_grid",
        "review",
        "help",
        "presentation",
        "support_export",
        "ai_surfaces"
      ]
    },
    "durable_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "surface_ref", "reopenable"],
      "properties": {
        "surface": {
          "type": "string"
        },
        "surface_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reopenable": {
          "const": true
        }
      }
    },
    "dimension_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "backing_proof_ref",
        "proof_freshness",
        "conformance",
        "severity",
        "detail_message_id",
        "evidence_ref"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/proof_dimension"
        },
        "backing_proof_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proof_freshness": {
          "$ref": "#/$defs/proof_freshness_state"
        },
        "conformance": {
          "$ref": "#/$defs/diagnostic_outcome"
        },
        "severity": {
          "$ref": "#/$defs/diagnostic_severity"
        },
        "stale_cause": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "detail_message_id": {
          "$ref": "#/$defs/certification_message_id"
        },
        "evidence_ref": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiver_id",
        "dimension",
        "reason_message_id",
        "owner_role",
        "expires_at",
        "narrowed_to"
      ],
      "properties": {
        "waiver_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dimension": {
          "$ref": "#/$defs/proof_dimension"
        },
        "reason_message_id": {
          "$ref": "#/$defs/certification_message_id"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "narrowed_to": {
          "enum": ["beta", "preview", "experimental", "unavailable", "held"]
        }
      }
    },
    "stale_proof_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "dimension",
        "trigger",
        "freshness",
        "conformance",
        "waived",
        "cause_message_id"
      ],
      "properties": {
        "surface_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dimension": {
          "$ref": "#/$defs/proof_dimension"
        },
        "trigger": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "freshness": {
          "$ref": "#/$defs/proof_freshness_state"
        },
        "conformance": {
          "$ref": "#/$defs/diagnostic_outcome"
        },
        "waived": {
          "type": "boolean"
        },
        "cause_message_id": {
          "$ref": "#/$defs/certification_message_id"
        }
      }
    },
    "surface_certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_family",
        "surface_label",
        "owner_role",
        "object_identity_ref",
        "claimed_qualification",
        "effective_qualification",
        "certification_status",
        "signal",
        "dimensions",
        "waivers",
        "gate_decision",
        "stale_proof_causes",
        "durable_fallback",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "consumer_surfaces",
        "status_message_id",
        "gate_message_id"
      ],
      "properties": {
        "surface_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_family": {
          "$ref": "#/$defs/surface_family"
        },
        "surface_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "object_identity_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claimed_qualification": {
          "const": "stable"
        },
        "effective_qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "certification_status": {
          "$ref": "#/$defs/certification_status"
        },
        "signal": {
          "$ref": "#/$defs/certification_signal"
        },
        "dimensions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/dimension_certification"
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waiver"
          }
        },
        "gate_decision": {
          "$ref": "#/$defs/certification_gate_decision"
        },
        "stale_proof_causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stale_proof_cause"
          }
        },
        "durable_fallback": {
          "$ref": "#/$defs/durable_fallback"
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "required_proof_packet_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        },
        "status_message_id": {
          "$ref": "#/$defs/certification_message_id"
        },
        "gate_message_id": {
          "$ref": "#/$defs/certification_message_id"
        }
      }
    },
    "certification_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_dimensions",
        "proof_freshness_states",
        "certification_statuses",
        "certification_signals",
        "certification_gate_decisions",
        "diagnostic_outcomes",
        "diagnostic_severities",
        "qualification_classes",
        "downgrade_triggers",
        "consumer_surfaces",
        "surface_families"
      ],
      "properties": {
        "proof_dimensions": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "proof_freshness_states": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "certification_statuses": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "certification_signals": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "certification_gate_decisions": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "diagnostic_outcomes": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "diagnostic_severities": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "qualification_classes": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "downgrade_triggers": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "surface_families": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "shared_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "announcement_politeness",
        "coalescing_strategies",
        "fallback_durabilities",
        "non_visual_fidelities",
        "bridge_states",
        "focus_return_dispositions",
        "semantic_role_classes"
      ],
      "properties": {
        "announcement_politeness": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "coalescing_strategies": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "fallback_durabilities": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "non_visual_fidelities": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "bridge_states": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "focus_return_dispositions": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "semantic_role_classes": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_dynamic_surface_has_certification_row",
        "matrix_six_dimensions_covered_per_surface",
        "bridge_health_certified_from_diagnostics",
        "announcement_coverage_certified",
        "focus_return_certified",
        "non_visual_summaries_certified",
        "zoom_contrast_motion_parity_certified",
        "stale_proof_downgrade_rules_enforced",
        "stale_or_missing_proof_auto_narrows_before_stable",
        "unwaived_regressions_block_stable_promotion",
        "regressions_not_invisible_in_release_truth",
        "active_waivers_disclosed_with_scope_and_expiry",
        "exact_stale_proof_causes_named",
        "dashboard_traffic_light_matches_rows",
        "surfaces_reuse_descriptor_object_identity",
        "support_export_carries_no_raw_boundary_material"
      ],
      "properties": {
        "every_dynamic_surface_has_certification_row": { "const": true },
        "matrix_six_dimensions_covered_per_surface": { "const": true },
        "bridge_health_certified_from_diagnostics": { "const": true },
        "announcement_coverage_certified": { "const": true },
        "focus_return_certified": { "const": true },
        "non_visual_summaries_certified": { "const": true },
        "zoom_contrast_motion_parity_certified": { "const": true },
        "stale_proof_downgrade_rules_enforced": { "const": true },
        "stale_or_missing_proof_auto_narrows_before_stable": { "const": true },
        "unwaived_regressions_block_stable_promotion": { "const": true },
        "regressions_not_invisible_in_release_truth": { "const": true },
        "active_waivers_disclosed_with_scope_and_expiry": { "const": true },
        "exact_stale_proof_causes_named": { "const": true },
        "dashboard_traffic_light_matches_rows": { "const": true },
        "surfaces_reuse_descriptor_object_identity": { "const": true },
        "support_export_carries_no_raw_boundary_material": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_center_consumes_certification",
        "support_export_consumes_certification",
        "docs_help_documents_certification",
        "onboarding_reflects_certification",
        "presentation_reflects_certification",
        "shell_editor_notebook_data_review_consume_certification",
        "release_public_truth_gates_on_certification",
        "stable_claim_matrix_reads_certification"
      ],
      "properties": {
        "release_center_consumes_certification": { "const": true },
        "support_export_consumes_certification": { "const": true },
        "docs_help_documents_certification": { "const": true },
        "onboarding_reflects_certification": { "const": true },
        "presentation_reflects_certification": { "const": true },
        "shell_editor_notebook_data_review_consume_certification": { "const": true },
        "release_public_truth_gates_on_certification": { "const": true },
        "stable_claim_matrix_reads_certification": { "const": true }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_stable_promotion",
        "blocked_surface_ids",
        "auto_narrowed_surface_ids",
        "certified_surface_ids",
        "waived_surface_ids",
        "gate_message_id"
      ],
      "properties": {
        "blocks_stable_promotion": {
          "type": "boolean"
        },
        "blocked_surface_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "auto_narrowed_surface_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "certified_surface_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "waived_surface_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "gate_message_id": {
          "$ref": "#/$defs/certification_message_id"
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "const": true
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required",
        "stable_promotion_blocks_without_mapped_proof"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "mirror_offline_parity_required": {
          "const": true
        },
        "stable_promotion_blocks_without_mapped_proof": {
          "const": true
        }
      }
    }
  }
}
