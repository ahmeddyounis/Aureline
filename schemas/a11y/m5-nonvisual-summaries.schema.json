{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-nonvisual-summaries.schema.json",
  "title": "Aureline M5 non-visual custom-surface summaries",
  "description": "Export-safe catalog that materializes one non-visual summary row per claimed M5 custom-rendered surface (custom editors, terminal/log canvases, dense tables/trees, logs/traces, charts, and rich review/artifact viewers). Each row binds a stable surface id to the same object identity the visual surface carries, a quantified structure summary (a stable message id, a semantic role class, and at least one named dimension, never a vague one-liner), at least two object-linked and keyboard-reachable drill-down routes, an export-safe text alternative plus metadata view for surfaces whose visual state materially affects decisions, and the current preview/cached/generated/approximate/sampled/buffered presentation state so provisional truth stays visible in the non-visual representation rather than only in the visual chrome. Every provisional presentation state is exercised across the catalog; a surface auto-narrows when its bridge or proof state goes stale. The shared state vocabularies are reused verbatim from the frozen dynamic-surface matrix, and the durable-fallback surface tokens from the announcement grammar; the summary-shaped vocabularies (surface kind, summary producer, presentation state, drill-down kind, text-alternative kind) are frozen in a self-describing summary vocabulary set. Raw provider payloads, credentials, secret material, screenshots, and untranslated free-text prose never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "catalog_label",
    "summaries",
    "shared_vocabulary_set",
    "summary_vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_nonvisual_summary_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "summaries": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/surface_summary"
      }
    },
    "shared_vocabulary_set": {
      "$ref": "#/$defs/shared_vocabulary_set"
    },
    "summary_vocabulary_set": {
      "$ref": "#/$defs/summary_vocabulary_set"
    },
    "conformance_review": {
      "$ref": "#/$defs/conformance_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "summary_message_id": {
      "type": "string",
      "pattern": "^summary\\."
    },
    "surface_kind": {
      "type": "string",
      "enum": [
        "custom_editor",
        "terminal_canvas",
        "data_grid",
        "tree_outline",
        "log_stream",
        "trace_timeline",
        "chart",
        "review_diff",
        "artifact_viewer"
      ]
    },
    "summary_producer": {
      "type": "string",
      "enum": [
        "editor",
        "terminal",
        "data",
        "observability",
        "review",
        "docs"
      ]
    },
    "presentation_state": {
      "type": "string",
      "enum": [
        "authoritative",
        "preview",
        "cached",
        "generated",
        "approximate",
        "sampled",
        "buffered"
      ]
    },
    "drilldown_kind": {
      "type": "string",
      "enum": [
        "enumerate_structure",
        "open_item_detail",
        "jump_to_region",
        "describe_series",
        "read_text_alternative",
        "open_metadata_view"
      ]
    },
    "text_alternative_kind": {
      "type": "string",
      "enum": [
        "not_applicable",
        "chart_description",
        "image_alt_text",
        "design_spec_metadata",
        "diff_summary"
      ]
    },
    "semantic_role_class": {
      "type": "string",
      "enum": [
        "landmark_region",
        "structure_group",
        "interactive_control",
        "text_document",
        "status_region",
        "live_log_region",
        "data_grid_cell",
        "notebook_cell"
      ]
    },
    "durable_fallback_surface": {
      "type": "string",
      "enum": [
        "activity_row",
        "run_header",
        "patch_review_header",
        "banner_detail",
        "selection_summary",
        "notification_center_entry",
        "status_detail"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "accessible_fidelity": {
      "type": "string",
      "enum": [
        "full_accessible",
        "degraded_accessible",
        "summary_only"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "bridge_unavailable",
        "bridge_partial_or_stale",
        "focus_teleported",
        "focus_lost",
        "live_region_spam",
        "announcement_meaning_lost",
        "non_visual_fidelity_lost",
        "label_or_role_drift",
        "pointer_or_hover_dependence",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "editor",
        "terminal",
        "notebook",
        "data_grid",
        "review",
        "help",
        "presentation",
        "support_export",
        "ai_surfaces"
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dimension_message_id"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dimension_message_id": {
          "$ref": "#/$defs/summary_message_id"
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure_message_id",
        "role_class",
        "dimensions"
      ],
      "properties": {
        "structure_message_id": {
          "$ref": "#/$defs/summary_message_id"
        },
        "role_class": {
          "$ref": "#/$defs/semantic_role_class"
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dimension"
          }
        }
      }
    },
    "drilldown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drilldown_id",
        "kind",
        "label",
        "route_message_id",
        "target_identity_ref",
        "keyboard_reachable"
      ],
      "properties": {
        "drilldown_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kind": {
          "$ref": "#/$defs/drilldown_kind"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "route_message_id": {
          "$ref": "#/$defs/summary_message_id"
        },
        "target_identity_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keyboard_reachable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "text_alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provided",
        "alt_text_message_id",
        "export_metadata_fields"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/text_alternative_kind"
        },
        "provided": {
          "type": "boolean"
        },
        "alt_text_message_id": {
          "type": "string"
        },
        "export_metadata_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "durable_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "surface_ref",
        "reopenable"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/durable_fallback_surface"
        },
        "surface_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reopenable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "surface_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_id",
        "surface_kind",
        "label",
        "owner_role",
        "object_identity_ref",
        "qualification",
        "non_visual_fidelity",
        "presentation_state",
        "producers",
        "structure",
        "drilldowns",
        "text_alternative",
        "durable_fallback",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "summary_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_kind": {
          "$ref": "#/$defs/surface_kind"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "object_identity_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "non_visual_fidelity": {
          "$ref": "#/$defs/accessible_fidelity"
        },
        "presentation_state": {
          "$ref": "#/$defs/presentation_state"
        },
        "producers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/summary_producer"
          }
        },
        "structure": {
          "$ref": "#/$defs/structure"
        },
        "drilldowns": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/drilldown"
          }
        },
        "text_alternative": {
          "$ref": "#/$defs/text_alternative"
        },
        "durable_fallback": {
          "$ref": "#/$defs/durable_fallback"
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "shared_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "announcement_politeness",
        "coalescing_strategies",
        "fallback_durabilities",
        "non_visual_fidelities",
        "bridge_states",
        "focus_return_dispositions",
        "semantic_role_classes"
      ],
      "properties": {
        "announcement_politeness": {
          "type": "array",
          "const": [
            "polite",
            "assertive",
            "silent"
          ]
        },
        "coalescing_strategies": {
          "type": "array",
          "const": [
            "none",
            "dedupe_same_meaning",
            "last_meaning_wins_with_count",
            "start_and_terminal_only",
            "focused_surface_only"
          ]
        },
        "fallback_durabilities": {
          "type": "array",
          "const": [
            "immediate",
            "coalesced",
            "on_focus",
            "durable_surface_only",
            "not_delivered_silent"
          ]
        },
        "non_visual_fidelities": {
          "type": "array",
          "const": [
            "full_accessible",
            "degraded_accessible",
            "summary_only",
            "inspect_only",
            "unsupported_blocked",
            "not_applicable"
          ]
        },
        "bridge_states": {
          "type": "array",
          "const": [
            "bridged_active",
            "partial",
            "stale",
            "unavailable"
          ]
        },
        "focus_return_dispositions": {
          "type": "array",
          "const": [
            "returned_exact",
            "returned_nearest_safe_ancestor",
            "returned_current_batch_or_detail_owner",
            "returned_placeholder_announced",
            "focus_loss_denied",
            "focus_not_applicable_non_interactive"
          ]
        },
        "semantic_role_classes": {
          "type": "array",
          "const": [
            "landmark_region",
            "structure_group",
            "interactive_control",
            "text_document",
            "status_region",
            "live_log_region",
            "data_grid_cell",
            "notebook_cell"
          ]
        }
      }
    },
    "summary_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_kinds",
        "summary_producers",
        "presentation_states",
        "drilldown_kinds",
        "text_alternative_kinds"
      ],
      "properties": {
        "surface_kinds": {
          "type": "array",
          "const": [
            "custom_editor",
            "terminal_canvas",
            "data_grid",
            "tree_outline",
            "log_stream",
            "trace_timeline",
            "chart",
            "review_diff",
            "artifact_viewer"
          ]
        },
        "summary_producers": {
          "type": "array",
          "const": [
            "editor",
            "terminal",
            "data",
            "observability",
            "review",
            "docs"
          ]
        },
        "presentation_states": {
          "type": "array",
          "const": [
            "authoritative",
            "preview",
            "cached",
            "generated",
            "approximate",
            "sampled",
            "buffered"
          ]
        },
        "drilldown_kinds": {
          "type": "array",
          "const": [
            "enumerate_structure",
            "open_item_detail",
            "jump_to_region",
            "describe_series",
            "read_text_alternative",
            "open_metadata_view"
          ]
        },
        "text_alternative_kinds": {
          "type": "array",
          "const": [
            "not_applicable",
            "chart_description",
            "image_alt_text",
            "design_spec_metadata",
            "diff_summary"
          ]
        }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces_explain_structure_without_vision_or_hover",
        "drilldowns_remain_actionable_not_vague_one_liners",
        "summaries_linked_to_same_object_identity_as_visual",
        "provisional_states_visible_in_non_visual_representation",
        "visual_artifacts_provide_text_alternative_and_metadata_view",
        "chart_and_artifact_viewers_no_longer_require_visual_interpretation_alone",
        "no_pixel_only_or_pointer_only_truth_source",
        "claimed_surfaces_auto_narrow_when_bridge_or_proof_stale",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "surfaces_explain_structure_without_vision_or_hover": {
          "type": "boolean",
          "const": true
        },
        "drilldowns_remain_actionable_not_vague_one_liners": {
          "type": "boolean",
          "const": true
        },
        "summaries_linked_to_same_object_identity_as_visual": {
          "type": "boolean",
          "const": true
        },
        "provisional_states_visible_in_non_visual_representation": {
          "type": "boolean",
          "const": true
        },
        "visual_artifacts_provide_text_alternative_and_metadata_view": {
          "type": "boolean",
          "const": true
        },
        "chart_and_artifact_viewers_no_longer_require_visual_interpretation_alone": {
          "type": "boolean",
          "const": true
        },
        "no_pixel_only_or_pointer_only_truth_source": {
          "type": "boolean",
          "const": true
        },
        "claimed_surfaces_auto_narrow_when_bridge_or_proof_stale": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editor_consumes_summaries",
        "terminal_consumes_summaries",
        "data_grid_and_tree_consume_summaries",
        "observability_logs_traces_charts_consume_summaries",
        "review_and_artifact_viewers_consume_summaries",
        "docs_help_reuse_summaries",
        "support_export_reuses_summaries",
        "at_conformance_packets_reuse_summaries"
      ],
      "properties": {
        "editor_consumes_summaries": {
          "type": "boolean",
          "const": true
        },
        "terminal_consumes_summaries": {
          "type": "boolean",
          "const": true
        },
        "data_grid_and_tree_consume_summaries": {
          "type": "boolean",
          "const": true
        },
        "observability_logs_traces_charts_consume_summaries": {
          "type": "boolean",
          "const": true
        },
        "review_and_artifact_viewers_consume_summaries": {
          "type": "boolean",
          "const": true
        },
        "docs_help_reuse_summaries": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_summaries": {
          "type": "boolean",
          "const": true
        },
        "at_conformance_packets_reuse_summaries": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required",
        "stable_promotion_blocks_without_mapped_proof"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        },
        "stable_promotion_blocks_without_mapped_proof": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
