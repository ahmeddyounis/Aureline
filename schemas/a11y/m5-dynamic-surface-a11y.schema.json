{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-dynamic-surface-a11y.schema.json",
  "title": "Aureline M5 accessibility-bridge, live-announcement, focus-return, and non-visual dynamic-surface matrix",
  "description": "Export-safe packet freezing the canonical M5 assistive-technology object model for custom-rendered dynamic surfaces. The packet names every governed accessibility object — the accessibility-surface descriptor, the screen-reader label model, the live-announcement class, the focus-return contract, the dense-surface non-visual summary, and the bridge-diagnostics packet — and binds each to its qualification class, required fields, the controlled state vocabularies it carries, the concrete vocabulary tokens it admits, evidence requirements, the assistive-tech proof packet that keeps it current, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. A self-describing vocabulary set freezes the controlled vocabulary for announcement politeness, coalescing strategy, fallback durability, non-visual fidelity, bridge state, focus-return disposition, and semantic role class, mirroring the canonical tokens already owned by the screen-reader/live-region, accessibility-tree, focus/zoom/pointer-independence, collection-announcement, and operational-surface parity contracts. Raw provider payloads, credentials, secret material, screenshots, and untranslated free-text prose never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "object_rows",
    "vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_accessibility_bridge_live_announcement_focus_return_and_non_visual_dynamic_surface_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_rows": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/object_row"
      }
    },
    "vocabulary_set": {
      "$ref": "#/$defs/vocabulary_set"
    },
    "conformance_review": {
      "$ref": "#/$defs/conformance_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
