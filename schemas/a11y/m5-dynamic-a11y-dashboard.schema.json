{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-dynamic-a11y-dashboard.schema.json",
  "title": "Aureline M5 dynamic-surface assistive-tech certification dashboard",
  "description": "Compact green/yellow/red scoreboard projection of the M5 dynamic-surface assistive-tech certification packet. The dashboard names the certified, limited, retest-pending, and degraded surfaces, the surfaces that auto-narrowed or are blocked from Stable promotion, the surfaces carrying active waivers, the active waiver ids, and the exact stale-proof / regression causes across all surfaces. It carries the same packet id as the certification packet it projects so consumers can resolve the full rows. It carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "certification_packet_id",
    "report_label",
    "total_surfaces",
    "green_count",
    "yellow_count",
    "red_count",
    "certified_surface_ids",
    "limited_surface_ids",
    "retest_pending_surface_ids",
    "degraded_surface_ids",
    "auto_narrowed_surface_ids",
    "blocked_surface_ids",
    "waived_surface_ids",
    "active_waiver_ids",
    "blocks_stable_promotion",
    "stale_proof_causes",
    "source_contract_refs",
    "dashboard_message_id",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_dynamic_a11y_dashboard"
    },
    "schema_version": {
      "const": 1
    },
    "certification_packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "report_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "total_surfaces": {
      "type": "integer",
      "minimum": 0
    },
    "green_count": {
      "type": "integer",
      "minimum": 0
    },
    "yellow_count": {
      "type": "integer",
      "minimum": 0
    },
    "red_count": {
      "type": "integer",
      "minimum": 0
    },
    "certified_surface_ids": {
      "$ref": "#/$defs/surface_id_array"
    },
    "limited_surface_ids": {
      "$ref": "#/$defs/surface_id_array"
    },
    "retest_pending_surface_ids": {
      "$ref": "#/$defs/surface_id_array"
    },
    "degraded_surface_ids": {
      "$ref": "#/$defs/surface_id_array"
    },
    "auto_narrowed_surface_ids": {
      "$ref": "#/$defs/surface_id_array"
    },
    "blocked_surface_ids": {
      "$ref": "#/$defs/surface_id_array"
    },
    "waived_surface_ids": {
      "$ref": "#/$defs/surface_id_array"
    },
    "active_waiver_ids": {
      "$ref": "#/$defs/surface_id_array"
    },
    "blocks_stable_promotion": {
      "type": "boolean"
    },
    "stale_proof_causes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stale_proof_cause"
      }
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "dashboard_message_id": {
      "type": "string",
      "pattern": "^certification\\."
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "surface_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "proof_dimension": {
      "enum": [
        "bridge_health",
        "announcement_coverage",
        "focus_return",
        "non_visual_summaries",
        "visual_adaptation_parity",
        "stale_proof_downgrade"
      ]
    },
    "proof_freshness_state": {
      "enum": ["current", "stale", "missing"]
    },
    "diagnostic_outcome": {
      "enum": ["pass", "regressed", "auto_narrowed", "not_applicable"]
    },
    "downgrade_trigger": {
      "enum": [
        "proof_stale",
        "bridge_unavailable",
        "bridge_partial_or_stale",
        "focus_teleported",
        "focus_lost",
        "live_region_spam",
        "announcement_meaning_lost",
        "non_visual_fidelity_lost",
        "label_or_role_drift",
        "pointer_or_hover_dependence",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "stale_proof_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "dimension",
        "trigger",
        "freshness",
        "conformance",
        "waived",
        "cause_message_id"
      ],
      "properties": {
        "surface_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dimension": {
          "$ref": "#/$defs/proof_dimension"
        },
        "trigger": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "freshness": {
          "$ref": "#/$defs/proof_freshness_state"
        },
        "conformance": {
          "$ref": "#/$defs/diagnostic_outcome"
        },
        "waived": {
          "type": "boolean"
        },
        "cause_message_id": {
          "type": "string",
          "pattern": "^certification\\."
        }
      }
    }
  }
}
