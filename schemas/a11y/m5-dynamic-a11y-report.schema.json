{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-dynamic-a11y-report.schema.json",
  "title": "Aureline M5 dynamic-surface assistive-tech diagnostics report",
  "description": "Export-safe report that materializes one diagnostics row per claimed M5 protected custom-rendered surface family (shell region, editor/terminal canvas, dense collection, notebook/data cell, review/diff, and durable overlay/sheet). Each row probes the OS accessibility bridge (bridge state plus expected/present/missing semantic-node coverage), runs the full battery of assistive-tech diagnostic checks (one per class: bridge health, missing semantic nodes, announcement-rate and coalescing violations, focus-return failures, high-zoom/high-contrast/reduced-motion regressions, and screen-reader label/role drift), measures the surface's live-region traffic against a published announcement-spam budget, declares its high-zoom/high-contrast/reduced-motion conformance, discloses its current degraded state mirroring the probe, and resolves a per-surface release gate. A surface auto-narrows (a disclosed claim change with a matching downgrade trigger) when its bridge or proof goes stale, and the release/public-truth automation reads the gate to fail rows for unhandled blocking regressions (bridge regressions, announcement spam, or zoom/contrast/motion breakage). Every diagnostic finding is carried by a stable diagnostic.-prefixed message id and an export-safe evidence ref so a support bundle can disclose bridge health, the exported focus-contract disposition, and the current degraded state without leaking raw provider payloads, credentials, screenshots, or untranslated free-text prose. The shared state vocabularies are reused verbatim from the frozen dynamic-surface matrix, the protected surface families and bridge taxonomy from the surface descriptors, and the coalescing-budget and durable-fallback tokens from the announcement grammar; the diagnostics-shaped vocabularies (diagnostic class, outcome, severity, visual-adaptation mode, release-gate decision) are frozen in a self-describing diagnostics vocabulary set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "surfaces",
    "shared_vocabulary_set",
    "diagnostics_vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "release_gate",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_dynamic_a11y_diagnostics_report"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "report_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surfaces": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/surface_diagnostics"
      }
    },
    "shared_vocabulary_set": {
      "$ref": "#/$defs/shared_vocabulary_set"
    },
    "diagnostics_vocabulary_set": {
      "$ref": "#/$defs/diagnostics_vocabulary_set"
    },
    "conformance_review": {
      "$ref": "#/$defs/conformance_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "release_gate": {
      "$ref": "#/$defs/release_gate"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "diagnostic_message_id": {
      "type": "string",
      "pattern": "^diagnostic\\."
    },
    "diagnostic_class": {
      "type": "string",
      "enum": [
        "bridge_health",
        "missing_semantic_node",
        "announcement_rate",
        "coalescing_violation",
        "focus_return_failure",
        "high_zoom_regression",
        "high_contrast_regression",
        "reduced_motion_regression",
        "label_or_role_drift"
      ]
    },
    "diagnostic_outcome": {
      "type": "string",
      "enum": [
        "pass",
        "regressed",
        "auto_narrowed",
        "not_applicable"
      ]
    },
    "diagnostic_severity": {
      "type": "string",
      "enum": [
        "blocking",
        "advisory"
      ]
    },
    "release_gate_decision": {
      "type": "string",
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "shell_region",
        "editor_canvas",
        "terminal_canvas",
        "dense_collection",
        "notebook_cell",
        "data_cell",
        "review_diff",
        "overlay_sheet"
      ]
    },
    "bridge_kind": {
      "type": "string",
      "enum": [
        "ui_automation",
        "ns_accessibility",
        "at_spi",
        "headless_inspector"
      ]
    },
    "bridge_degradation_reason": {
      "type": "string",
      "enum": [
        "none",
        "platform_bridge_unavailable",
        "partial_tree_mapping",
        "stale_mapping",
        "virtualization_truth_unavailable",
        "live_region_unavailable",
        "policy_or_trust_restriction",
        "not_applicable"
      ]
    },
    "bridge_state": {
      "type": "string",
      "enum": [
        "bridged_active",
        "partial",
        "stale",
        "unavailable"
      ]
    },
    "non_visual_fidelity": {
      "type": "string",
      "enum": [
        "full_accessible",
        "degraded_accessible",
        "summary_only",
        "inspect_only",
        "unsupported_blocked",
        "not_applicable"
      ]
    },
    "coalescing_strategy": {
      "type": "string",
      "enum": [
        "none",
        "dedupe_same_meaning",
        "last_meaning_wins_with_count",
        "start_and_terminal_only",
        "focused_surface_only"
      ]
    },
    "focus_return_disposition": {
      "type": "string",
      "enum": [
        "returned_exact",
        "returned_nearest_safe_ancestor",
        "returned_current_batch_or_detail_owner",
        "returned_placeholder_announced",
        "focus_loss_denied",
        "focus_not_applicable_non_interactive"
      ]
    },
    "durable_fallback_surface": {
      "type": "string",
      "enum": [
        "activity_row",
        "run_header",
        "patch_review_header",
        "banner_detail",
        "selection_summary",
        "notification_center_entry",
        "status_detail"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "bridge_unavailable",
        "bridge_partial_or_stale",
        "focus_teleported",
        "focus_lost",
        "live_region_spam",
        "announcement_meaning_lost",
        "non_visual_fidelity_lost",
        "label_or_role_drift",
        "pointer_or_hover_dependence",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "editor",
        "terminal",
        "notebook",
        "data_grid",
        "review",
        "help",
        "presentation",
        "support_export",
        "ai_surfaces"
      ]
    },
    "semantic_node_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_nodes",
        "present_nodes",
        "missing_nodes"
      ],
      "properties": {
        "expected_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "present_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "missing_nodes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bridge_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge_kind",
        "bridge_state",
        "non_visual_fidelity",
        "semantic_node_coverage",
        "degradation_reason",
        "probe_message_id"
      ],
      "properties": {
        "bridge_kind": {
          "$ref": "#/$defs/bridge_kind"
        },
        "bridge_state": {
          "$ref": "#/$defs/bridge_state"
        },
        "non_visual_fidelity": {
          "$ref": "#/$defs/non_visual_fidelity"
        },
        "semantic_node_coverage": {
          "$ref": "#/$defs/semantic_node_coverage"
        },
        "degradation_reason": {
          "$ref": "#/$defs/bridge_degradation_reason"
        },
        "probe_message_id": {
          "$ref": "#/$defs/diagnostic_message_id"
        }
      }
    },
    "diagnostic_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "outcome",
        "severity",
        "detail_message_id",
        "evidence_ref"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/diagnostic_class"
        },
        "outcome": {
          "$ref": "#/$defs/diagnostic_outcome"
        },
        "severity": {
          "$ref": "#/$defs/diagnostic_severity"
        },
        "detail_message_id": {
          "$ref": "#/$defs/diagnostic_message_id"
        },
        "evidence_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "focus_return_disposition": {
          "$ref": "#/$defs/focus_return_disposition"
        }
      }
    },
    "coalescing_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "max_announcements_per_window",
        "window_seconds",
        "min_interval_ms",
        "suppress_unchanged_meaning"
      ],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/coalescing_strategy"
        },
        "max_announcements_per_window": {
          "type": "integer",
          "minimum": 1
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "min_interval_ms": {
          "type": "integer",
          "minimum": 0
        },
        "suppress_unchanged_meaning": {
          "type": "boolean"
        }
      }
    },
    "announcement_budget_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget",
        "observed_announcements_in_window",
        "observed_min_interval_ms",
        "within_budget",
        "budget_message_id"
      ],
      "properties": {
        "budget": {
          "$ref": "#/$defs/coalescing_budget"
        },
        "observed_announcements_in_window": {
          "type": "integer",
          "minimum": 0
        },
        "observed_min_interval_ms": {
          "type": "integer",
          "minimum": 0
        },
        "within_budget": {
          "type": "boolean"
        },
        "budget_message_id": {
          "$ref": "#/$defs/diagnostic_message_id"
        }
      }
    },
    "visual_conformance_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high_zoom",
        "high_contrast",
        "reduced_motion",
        "conformance_message_id"
      ],
      "properties": {
        "high_zoom": {
          "$ref": "#/$defs/diagnostic_outcome"
        },
        "high_contrast": {
          "$ref": "#/$defs/diagnostic_outcome"
        },
        "reduced_motion": {
          "$ref": "#/$defs/diagnostic_outcome"
        },
        "conformance_message_id": {
          "$ref": "#/$defs/diagnostic_message_id"
        }
      }
    },
    "degraded_state_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_degraded",
        "bridge_state",
        "non_visual_fidelity",
        "degradation_reason",
        "disclosure_message_id"
      ],
      "properties": {
        "is_degraded": {
          "type": "boolean"
        },
        "bridge_state": {
          "$ref": "#/$defs/bridge_state"
        },
        "non_visual_fidelity": {
          "$ref": "#/$defs/non_visual_fidelity"
        },
        "degradation_reason": {
          "$ref": "#/$defs/bridge_degradation_reason"
        },
        "disclosure_message_id": {
          "$ref": "#/$defs/diagnostic_message_id"
        }
      }
    },
    "surface_release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blocking_finding_classes",
        "gate_message_id"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/release_gate_decision"
        },
        "blocking_finding_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic_class"
          }
        },
        "gate_message_id": {
          "$ref": "#/$defs/diagnostic_message_id"
        }
      }
    },
    "durable_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "surface_ref",
        "reopenable"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/durable_fallback_surface"
        },
        "surface_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reopenable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "surface_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_family",
        "surface_label",
        "owner_role",
        "object_identity_ref",
        "qualification",
        "bridge_probe",
        "checks",
        "announcement_budget",
        "visual_conformance",
        "current_degraded_state",
        "gate",
        "durable_fallback",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "surface_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_family": {
          "$ref": "#/$defs/surface_family"
        },
        "surface_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "object_identity_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "bridge_probe": {
          "$ref": "#/$defs/bridge_probe"
        },
        "checks": {
          "type": "array",
          "minItems": 9,
          "items": {
            "$ref": "#/$defs/diagnostic_check"
          }
        },
        "announcement_budget": {
          "$ref": "#/$defs/announcement_budget_check"
        },
        "visual_conformance": {
          "$ref": "#/$defs/visual_conformance_check"
        },
        "current_degraded_state": {
          "$ref": "#/$defs/degraded_state_disclosure"
        },
        "gate": {
          "$ref": "#/$defs/surface_release_gate"
        },
        "durable_fallback": {
          "$ref": "#/$defs/durable_fallback"
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "shared_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "announcement_politeness",
        "coalescing_strategies",
        "fallback_durabilities",
        "non_visual_fidelities",
        "bridge_states",
        "focus_return_dispositions",
        "semantic_role_classes"
      ],
      "properties": {
        "announcement_politeness": {
          "type": "array",
          "const": [
            "polite",
            "assertive",
            "silent"
          ]
        },
        "coalescing_strategies": {
          "type": "array",
          "const": [
            "none",
            "dedupe_same_meaning",
            "last_meaning_wins_with_count",
            "start_and_terminal_only",
            "focused_surface_only"
          ]
        },
        "fallback_durabilities": {
          "type": "array",
          "const": [
            "immediate",
            "coalesced",
            "on_focus",
            "durable_surface_only",
            "not_delivered_silent"
          ]
        },
        "non_visual_fidelities": {
          "type": "array",
          "const": [
            "full_accessible",
            "degraded_accessible",
            "summary_only",
            "inspect_only",
            "unsupported_blocked",
            "not_applicable"
          ]
        },
        "bridge_states": {
          "type": "array",
          "const": [
            "bridged_active",
            "partial",
            "stale",
            "unavailable"
          ]
        },
        "focus_return_dispositions": {
          "type": "array",
          "const": [
            "returned_exact",
            "returned_nearest_safe_ancestor",
            "returned_current_batch_or_detail_owner",
            "returned_placeholder_announced",
            "focus_loss_denied",
            "focus_not_applicable_non_interactive"
          ]
        },
        "semantic_role_classes": {
          "type": "array",
          "const": [
            "landmark_region",
            "structure_group",
            "interactive_control",
            "text_document",
            "status_region",
            "live_log_region",
            "data_grid_cell",
            "notebook_cell"
          ]
        }
      }
    },
    "diagnostics_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_classes",
        "diagnostic_outcomes",
        "diagnostic_severities",
        "visual_adaptation_modes",
        "release_gate_decisions",
        "surface_families",
        "bridge_kinds",
        "bridge_degradation_reasons"
      ],
      "properties": {
        "diagnostic_classes": {
          "type": "array",
          "const": [
            "bridge_health",
            "missing_semantic_node",
            "announcement_rate",
            "coalescing_violation",
            "focus_return_failure",
            "high_zoom_regression",
            "high_contrast_regression",
            "reduced_motion_regression",
            "label_or_role_drift"
          ]
        },
        "diagnostic_outcomes": {
          "type": "array",
          "const": [
            "pass",
            "regressed",
            "auto_narrowed",
            "not_applicable"
          ]
        },
        "diagnostic_severities": {
          "type": "array",
          "const": [
            "blocking",
            "advisory"
          ]
        },
        "visual_adaptation_modes": {
          "type": "array",
          "const": [
            "high_zoom",
            "high_contrast",
            "reduced_motion"
          ]
        },
        "release_gate_decisions": {
          "type": "array",
          "const": [
            "pass",
            "blocked"
          ]
        },
        "surface_families": {
          "type": "array",
          "const": [
            "shell_region",
            "editor_canvas",
            "terminal_canvas",
            "dense_collection",
            "notebook_cell",
            "data_cell",
            "review_diff",
            "overlay_sheet"
          ]
        },
        "bridge_kinds": {
          "type": "array",
          "const": [
            "ui_automation",
            "ns_accessibility",
            "at_spi",
            "headless_inspector"
          ]
        },
        "bridge_degradation_reasons": {
          "type": "array",
          "const": [
            "none",
            "platform_bridge_unavailable",
            "partial_tree_mapping",
            "stale_mapping",
            "virtualization_truth_unavailable",
            "live_region_unavailable",
            "policy_or_trust_restriction",
            "not_applicable"
          ]
        }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_protected_surface_has_diagnostics",
        "bridge_state_and_missing_nodes_diagnosable",
        "announcement_rate_and_coalescing_diagnosable",
        "focus_return_failures_diagnosable",
        "zoom_contrast_motion_regressions_diagnosable",
        "announcement_spam_budgets_enforced",
        "release_gate_fails_on_blocking_regressions",
        "degraded_state_disclosed_not_hidden",
        "diagnostics_reuse_descriptor_object_identity",
        "support_export_carries_bridge_health_message_ids_focus_failures_degraded_state",
        "claimed_surfaces_auto_narrow_when_bridge_or_proof_stale",
        "per_surface_diagnostics_not_replaced_by_aggregate_dashboard"
      ],
      "properties": {
        "every_protected_surface_has_diagnostics": {
          "type": "boolean",
          "const": true
        },
        "bridge_state_and_missing_nodes_diagnosable": {
          "type": "boolean",
          "const": true
        },
        "announcement_rate_and_coalescing_diagnosable": {
          "type": "boolean",
          "const": true
        },
        "focus_return_failures_diagnosable": {
          "type": "boolean",
          "const": true
        },
        "zoom_contrast_motion_regressions_diagnosable": {
          "type": "boolean",
          "const": true
        },
        "announcement_spam_budgets_enforced": {
          "type": "boolean",
          "const": true
        },
        "release_gate_fails_on_blocking_regressions": {
          "type": "boolean",
          "const": true
        },
        "degraded_state_disclosed_not_hidden": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_reuse_descriptor_object_identity": {
          "type": "boolean",
          "const": true
        },
        "support_export_carries_bridge_health_message_ids_focus_failures_degraded_state": {
          "type": "boolean",
          "const": true
        },
        "claimed_surfaces_auto_narrow_when_bridge_or_proof_stale": {
          "type": "boolean",
          "const": true
        },
        "per_surface_diagnostics_not_replaced_by_aggregate_dashboard": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_consumes_diagnostics",
        "editor_surface_diagnosed",
        "terminal_surface_diagnosed",
        "data_grid_surface_diagnosed",
        "notebook_surface_diagnosed",
        "review_surface_diagnosed",
        "support_export_consumes_diagnostics",
        "help_documents_diagnostics",
        "release_public_truth_gates_on_diagnostics",
        "at_conformance_packets_reuse_diagnostics"
      ],
      "properties": {
        "shell_consumes_diagnostics": {
          "type": "boolean",
          "const": true
        },
        "editor_surface_diagnosed": {
