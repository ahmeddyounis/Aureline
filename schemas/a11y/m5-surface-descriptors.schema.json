          "const": true
        },
        "editor_consumes_descriptors": {
          "type": "boolean",
          "const": true
        },
        "terminal_consumes_descriptors": {
          "type": "boolean",
          "const": true
        },
        "notebook_consumes_descriptors": {
          "type": "boolean",
          "const": true
        },
        "data_grid_consumes_descriptors": {
          "type": "boolean",
          "const": true
        },
        "review_consumes_descriptors": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_reuse_descriptors": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_descriptors": {
          "type": "boolean",
          "const": true
        },
        "docs_help_reuse_descriptors": {
          "type": "boolean",
          "const": true
        },
        "at_conformance_packets_reuse_descriptors": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
