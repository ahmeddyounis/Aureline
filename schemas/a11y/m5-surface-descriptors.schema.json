{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/a11y/m5-surface-descriptors.schema.json",
  "title": "Aureline M5 accessibility-surface descriptors and OS accessibility-bridge mappings",
  "description": "Export-safe catalog that materializes one accessibility-surface descriptor per claimed M5 custom-rendered dynamic surface (shell regions, the editor and terminal canvases, dense lists/tables, notebook and data cells, the review/diff surface, and durable overlay/sheet surfaces). Each descriptor binds a stable surface id to its semantic roles/regions, its screen-reader label model, its focus-order metadata, its reduced-motion and high-zoom postures, and its current OS accessibility-bridge mapping and health, so the bridge no longer depends on per-surface hand wiring that drifts from docs, diagnostics, or assistive-tech proof artifacts. The controlled state vocabularies (semantic role class, non-visual fidelity, bridge state, focus-return disposition, announcement politeness, coalescing strategy, fallback durability) are reused verbatim from the frozen dynamic-surface matrix; the descriptor-shaped vocabularies (surface family, bridge kind, name source, state label class, reduced-motion posture, high-zoom posture, bridge degradation reason) are frozen in a self-describing descriptor vocabulary set. Raw provider payloads, credentials, secret material, screenshots, and untranslated free-text prose never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "catalog_label",
    "descriptors",
    "shared_vocabulary_set",
    "descriptor_vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_accessibility_surface_descriptor_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "descriptors": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/surface_descriptor"
      }
    },
    "shared_vocabulary_set": {
      "$ref": "#/$defs/shared_vocabulary_set"
    },
    "descriptor_vocabulary_set": {
      "$ref": "#/$defs/descriptor_vocabulary_set"
    },
    "conformance_review": {
      "$ref": "#/$defs/conformance_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "shell_region",
        "editor_canvas",
        "terminal_canvas",
        "dense_collection",
        "notebook_cell",
        "data_cell",
        "review_diff",
        "overlay_sheet"
      ]
    },
    "bridge_kind": {
      "type": "string",
      "enum": [
        "ui_automation",
        "ns_accessibility",
        "at_spi",
        "headless_inspector"
      ]
    },
    "name_source": {
      "type": "string",
      "enum": [
        "visible_label",
        "message_id_source",
        "document_or_symbol_label",
        "row_or_cell_identity",
        "generated_summary",
        "degraded_fallback_label"
      ]
    },
    "state_label_class": {
      "type": "string",
      "enum": [
        "severity",
        "freshness",
        "support",
        "selection_scope",
        "virtualization",
        "trust_or_policy",
        "live_region",
        "not_applicable"
      ]
    },
    "reduced_motion_posture": {
      "type": "string",
      "enum": [
        "no_animation",
        "animation_disabled_state_preserved",
        "crossfade_replaced_with_instant",
        "motion_independent_already",
        "not_applicable"
      ]
    },
    "high_zoom_posture": {
      "type": "string",
      "enum": [
        "reflows_to_single_column",
        "scrolls_without_clipping",
        "content_scales_with_container",
        "fixed_layout_no_change",
        "not_applicable"
      ]
    },
    "bridge_degradation_reason": {
      "type": "string",
      "enum": [
        "none",
        "platform_bridge_unavailable",
        "partial_tree_mapping",
        "stale_mapping",
        "virtualization_truth_unavailable",
        "live_region_unavailable",
        "policy_or_trust_restriction",
        "not_applicable"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role_class": {
      "type": "string",
      "enum": [
        "landmark_region",
        "structure_group",
        "interactive_control",
        "text_document",
        "status_region",
        "live_log_region",
        "data_grid_cell",
        "notebook_cell"
      ]
    },
    "non_visual_fidelity": {
      "type": "string",
      "enum": [
        "full_accessible",
        "degraded_accessible",
        "summary_only",
        "inspect_only",
        "unsupported_blocked",
        "not_applicable"
      ]
    },
    "bridge_state": {
      "type": "string",
      "enum": [
        "bridged_active",
        "partial",
        "stale",
        "unavailable"
      ]
    },
    "focus_return_disposition": {
      "type": "string",
      "enum": [
        "returned_exact",
        "returned_nearest_safe_ancestor",
        "returned_current_batch_or_detail_owner",
        "returned_placeholder_announced",
        "focus_loss_denied",
        "focus_not_applicable_non_interactive"
      ]
    },
    "announcement_politeness": {
      "type": "string",
      "enum": [
        "polite",
        "assertive",
        "silent"
      ]
    },
    "coalescing_strategy": {
      "type": "string",
      "enum": [
        "none",
        "dedupe_same_meaning",
        "last_meaning_wins_with_count",
        "start_and_terminal_only",
        "focused_surface_only"
      ]
    },
    "fallback_durability": {
      "type": "string",
      "enum": [
        "immediate",
        "coalesced",
        "on_focus",
        "durable_surface_only",
        "not_delivered_silent"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "bridge_unavailable",
        "bridge_partial_or_stale",
        "focus_teleported",
        "focus_lost",
        "live_region_spam",
        "announcement_meaning_lost",
        "non_visual_fidelity_lost",
        "label_or_role_drift",
        "pointer_or_hover_dependence",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "editor",
        "terminal",
        "notebook",
        "data_grid",
        "review",
        "help",
        "presentation",
        "support_export",
        "ai_surfaces"
      ]
    },
    "surface_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "role_class",
        "label",
        "is_landmark"
      ],
      "properties": {
        "region_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "role_class": {
          "$ref": "#/$defs/semantic_role_class"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "is_landmark": {
          "type": "boolean"
        }
      }
    },
    "label_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_model_id",
        "name_source",
        "state_label_classes",
        "fallback_durability",
        "non_visual_fidelity"
      ],
      "properties": {
        "label_model_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "name_source": {
          "$ref": "#/$defs/name_source"
        },
        "state_label_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state_label_class"
          }
        },
        "fallback_durability": {
          "$ref": "#/$defs/fallback_durability"
        },
        "non_visual_fidelity": {
          "$ref": "#/$defs/non_visual_fidelity"
        }
      }
    },
    "focus_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_index",
        "region_id",
        "role_class",
        "focusable"
      ],
      "properties": {
        "order_index": {
          "type": "integer",
          "minimum": 0
        },
        "region_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "role_class": {
          "$ref": "#/$defs/semantic_role_class"
        },
        "focusable": {
          "type": "boolean"
        }
      }
    },
    "focus_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus_contract_id",
        "stops",
        "async_return_disposition",
        "return_fallback_durability"
      ],
      "properties": {
        "focus_contract_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/focus_stop"
          }
        },
        "async_return_disposition": {
          "$ref": "#/$defs/focus_return_disposition"
        },
        "return_fallback_durability": {
          "$ref": "#/$defs/fallback_durability"
        }
      }
    },
    "motion_zoom_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reduced_motion",
        "high_zoom",
        "behavior_changes_under_reduced_motion",
        "behavior_changes_under_high_zoom"
      ],
      "properties": {
        "reduced_motion": {
          "$ref": "#/$defs/reduced_motion_posture"
        },
        "high_zoom": {
          "$ref": "#/$defs/high_zoom_posture"
        },
        "behavior_changes_under_reduced_motion": {
          "type": "boolean"
        },
        "behavior_changes_under_high_zoom": {
          "type": "boolean"
        }
      }
    },
    "native_role_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui_automation",
        "ns_accessibility",
        "at_spi"
      ],
      "properties": {
        "ui_automation": {
          "type": ["string", "null"]
        },
        "ns_accessibility": {
          "type": ["string", "null"]
        },
        "at_spi": {
          "type": ["string", "null"]
        }
      }
    },
    "bridge_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge_kind",
        "bridge_state",
        "non_visual_fidelity",
        "native_role_hint",
        "degradation_reason"
      ],
      "properties": {
        "bridge_kind": {
          "$ref": "#/$defs/bridge_kind"
        },
        "bridge_state": {
          "$ref": "#/$defs/bridge_state"
        },
        "non_visual_fidelity": {
          "$ref": "#/$defs/non_visual_fidelity"
        },
        "native_role_hint": {
          "$ref": "#/$defs/native_role_hint"
        },
        "degradation_reason": {
          "$ref": "#/$defs/bridge_degradation_reason"
        }
      }
    },
    "live_announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "politeness",
        "coalescing"
      ],
      "properties": {
        "politeness": {
          "$ref": "#/$defs/announcement_politeness"
        },
        "coalescing": {
          "$ref": "#/$defs/coalescing_strategy"
        }
      }
    },
    "surface_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_family",
        "surface_label",
        "owner_role",
        "qualification",
        "primary_role_class",
        "regions",
        "label_model",
        "focus_order",
        "motion_zoom",
        "bridge_mapping",
        "live_announcement",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "surface_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_family": {
          "$ref": "#/$defs/surface_family"
        },
        "surface_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "primary_role_class": {
          "$ref": "#/$defs/semantic_role_class"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surface_region"
          }
        },
        "label_model": {
          "$ref": "#/$defs/label_model"
        },
        "focus_order": {
          "$ref": "#/$defs/focus_order"
        },
        "motion_zoom": {
          "$ref": "#/$defs/motion_zoom_posture"
        },
        "bridge_mapping": {
          "$ref": "#/$defs/bridge_mapping"
        },
        "live_announcement": {
          "$ref": "#/$defs/live_announcement"
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "shared_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "announcement_politeness",
        "coalescing_strategies",
        "fallback_durabilities",
        "non_visual_fidelities",
        "bridge_states",
        "focus_return_dispositions",
        "semantic_role_classes"
      ],
      "properties": {
        "announcement_politeness": {
          "type": "array",
          "const": [
            "polite",
            "assertive",
            "silent"
          ]
        },
        "coalescing_strategies": {
          "type": "array",
          "const": [
            "none",
            "dedupe_same_meaning",
            "last_meaning_wins_with_count",
            "start_and_terminal_only",
            "focused_surface_only"
          ]
        },
        "fallback_durabilities": {
          "type": "array",
          "const": [
            "immediate",
            "coalesced",
            "on_focus",
            "durable_surface_only",
            "not_delivered_silent"
          ]
        },
        "non_visual_fidelities": {
          "type": "array",
          "const": [
            "full_accessible",
            "degraded_accessible",
            "summary_only",
            "inspect_only",
            "unsupported_blocked",
            "not_applicable"
          ]
        },
        "bridge_states": {
          "type": "array",
          "const": [
            "bridged_active",
            "partial",
            "stale",
            "unavailable"
          ]
        },
        "focus_return_dispositions": {
          "type": "array",
          "const": [
            "returned_exact",
            "returned_nearest_safe_ancestor",
            "returned_current_batch_or_detail_owner",
            "returned_placeholder_announced",
            "focus_loss_denied",
            "focus_not_applicable_non_interactive"
          ]
        },
        "semantic_role_classes": {
          "type": "array",
          "const": [
            "landmark_region",
            "structure_group",
            "interactive_control",
            "text_document",
            "status_region",
            "live_log_region",
            "data_grid_cell",
            "notebook_cell"
          ]
        }
      }
    },
    "descriptor_vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "bridge_kinds",
        "name_sources",
        "state_label_classes",
        "reduced_motion_postures",
        "high_zoom_postures",
        "bridge_degradation_reasons"
      ],
      "properties": {
        "surface_families": {
          "type": "array",
          "const": [
            "shell_region",
            "editor_canvas",
            "terminal_canvas",
            "dense_collection",
            "notebook_cell",
            "data_cell",
            "review_diff",
            "overlay_sheet"
          ]
        },
        "bridge_kinds": {
          "type": "array",
          "const": [
            "ui_automation",
            "ns_accessibility",
            "at_spi",
            "headless_inspector"
          ]
        },
        "name_sources": {
          "type": "array",
          "const": [
            "visible_label",
            "message_id_source",
            "document_or_symbol_label",
            "row_or_cell_identity",
            "generated_summary",
            "degraded_fallback_label"
          ]
        },
        "state_label_classes": {
          "type": "array",
          "const": [
            "severity",
            "freshness",
            "support",
            "selection_scope",
            "virtualization",
            "trust_or_policy",
            "live_region",
            "not_applicable"
          ]
        },
        "reduced_motion_postures": {
          "type": "array",
          "const": [
            "no_animation",
            "animation_disabled_state_preserved",
            "crossfade_replaced_with_instant",
            "motion_independent_already",
            "not_applicable"
          ]
        },
        "high_zoom_postures": {
          "type": "array",
          "const": [
            "reflows_to_single_column",
            "scrolls_without_clipping",
            "content_scales_with_container",
            "fixed_layout_no_change",
            "not_applicable"
          ]
        },
        "bridge_degradation_reasons": {
          "type": "array",
          "const": [
            "none",
            "platform_bridge_unavailable",
            "partial_tree_mapping",
            "stale_mapping",
            "virtualization_truth_unavailable",
            "live_region_unavailable",
            "policy_or_trust_restriction",
            "not_applicable"
          ]
        }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_claimed_surface_has_descriptor",
        "descriptors_expose_roles_and_regions",
        "descriptors_carry_screen_reader_label_model",
        "descriptors_carry_focus_order_metadata",
        "focus_never_teleports_or_vanishes_on_async_update",
        "reduced_motion_and_high_zoom_declared_when_behavior_changes",
        "bridge_health_disclosed_not_hidden",
        "one_descriptor_contract_not_per_surface_handwiring",
        "descriptors_reused_in_diagnostics_support_docs_and_proof",
        "claimed_descriptors_auto_narrow_when_bridge_or_proof_stale",
        "no_pixel_only_or_pointer_only_source_of_truth",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "every_claimed_surface_has_descriptor": {
          "type": "boolean",
          "const": true
        },
        "descriptors_expose_roles_and_regions": {
          "type": "boolean",
          "const": true
        },
        "descriptors_carry_screen_reader_label_model": {
          "type": "boolean",
          "const": true
        },
        "descriptors_carry_focus_order_metadata": {
          "type": "boolean",
          "const": true
        },
        "focus_never_teleports_or_vanishes_on_async_update": {
          "type": "boolean",
          "const": true
        },
        "reduced_motion_and_high_zoom_declared_when_behavior_changes": {
          "type": "boolean",
          "const": true
        },
        "bridge_health_disclosed_not_hidden": {
          "type": "boolean",
          "const": true
        },
        "one_descriptor_contract_not_per_surface_handwiring": {
          "type": "boolean",
          "const": true
        },
        "descriptors_reused_in_diagnostics_support_docs_and_proof": {
          "type": "boolean",
          "const": true
        },
        "claimed_descriptors_auto_narrow_when_bridge_or_proof_stale": {
          "type": "boolean",
          "const": true
        },
        "no_pixel_only_or_pointer_only_source_of_truth": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_consumes_descriptors",
        "editor_consumes_descriptors",
        "terminal_consumes_descriptors",
        "notebook_consumes_descriptors",
        "data_grid_consumes_descriptors",
        "review_consumes_descriptors",
        "diagnostics_reuse_descriptors",
        "support_export_reuses_descriptors",
        "docs_help_reuse_descriptors",
        "at_conformance_packets_reuse_descriptors"
