{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aureline.dev/compat/m5-qualification-row-badge-bindings.schema.json",
  "title": "M5 qualification-row badge / evaluation-pack / compatibility-report binding register",
  "description": "Canonical typed register that binds every machine-readable M5 qualification row to the marketable artifacts that advertise it: a support-class badge carrying the published label, support class, evidence freshness, and known caveats; an evaluation pack; a compatibility report; and a release-center card. The badge may never publish wider than the qualification row it binds, which may never exceed the canonical claim, and it auto-narrows when its binding evidence is stale or missing or when marketable wording would exceed the row. Release center, Help/About, service health, support export, docs, release notes, CLI inspect, and marketplace listings ingest this directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "qualification_matrix_ref",
    "evidence_index_ref",
    "lifecycle_labels",
    "family_kinds",
    "support_classes",
    "artifact_kinds",
    "artifact_states",
    "badge_surfaces",
    "binding_states",
    "freshness_states",
    "narrowing_reasons",
    "stop_actions",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "bindings",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "bind_m5_qualification_rows_to_marketable_badges_evaluation_packs_and_compatibility_reports"
    },
    "register_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "qualification_matrix_ref": { "type": "string", "minLength": 1 },
    "evidence_index_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
    "family_kinds": { "type": "array", "items": { "$ref": "#/$defs/family_kind" } },
    "support_classes": { "type": "array", "items": { "$ref": "#/$defs/support_class" } },
    "artifact_kinds": { "type": "array", "items": { "$ref": "#/$defs/artifact_kind" } },
    "artifact_states": { "type": "array", "items": { "$ref": "#/$defs/artifact_state" } },
    "badge_surfaces": { "type": "array", "items": { "$ref": "#/$defs/badge_surface" } },
    "binding_states": { "type": "array", "items": { "$ref": "#/$defs/binding_state" } },
    "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness_state" } },
    "narrowing_reasons": { "type": "array", "items": { "$ref": "#/$defs/narrowing_reason" } },
    "stop_actions": { "type": "array", "items": { "$ref": "#/$defs/stop_action" } },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stop_rule" } },
    "bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "type": "object" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family_kind": {
      "type": "string",
      "enum": [
        "notebook",
        "ai_provider",
        "remote_helper",
        "companion",
        "ecosystem",
        "managed_service",
        "toolchain_runtime"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["full_support", "maintenance_only", "security_only", "limited", "end_of_life"]
    },
    "artifact_kind": {
      "type": "string",
      "enum": ["marketable_badge", "evaluation_pack", "compatibility_report", "release_center_card"]
    },
    "artifact_state": {
      "type": "string",
      "enum": ["current", "stale", "missing"]
    },
    "badge_surface": {
      "type": "string",
      "enum": [
        "release_center",
        "help_about",
        "service_health",
        "support_export",
        "docs",
        "release_notes",
        "cli_inspect",
        "marketplace_listing"
      ]
    },
    "binding_state": {
      "type": "string",
      "enum": [
        "published",
        "narrowed_row_downgraded",
        "narrowed_stale",
        "narrowed_missing",
        "withheld"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "qualification_row_narrowed",
        "evidence_stale",
        "evidence_missing",
        "evaluation_pack_stale",
        "evaluation_pack_missing",
        "compatibility_report_stale",
        "compatibility_report_missing",
        "over_claim_beyond_row",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "hold_publication",
        "narrow_badge",
        "withhold_badge",
        "refresh_evaluation_pack",
        "refresh_compatibility_report",
        "refresh_evidence",
        "align_marketing_to_row",
        "request_owner_signoff"
      ]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "const": "stable" },
        "above_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "below_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/narrowing_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "marketable_badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_text",
        "badge_label",
        "support_class",
        "freshness_state",
        "freshness_disclosed",
        "caveats_disclosed"
      ],
      "properties": {
        "badge_text": { "type": "string", "minLength": 1 },
        "badge_label": { "$ref": "#/$defs/lifecycle_label" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "caveat_summary": { "type": "array", "items": { "type": "string" } },
        "freshness_disclosed": { "type": "boolean" },
        "caveats_disclosed": { "type": "boolean" }
      }
    },
    "binding_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "artifact_ref", "state"],
      "properties": {
        "artifact_kind": { "$ref": "#/$defs/artifact_kind" },
        "artifact_ref": { "type": "string" },
        "state": { "$ref": "#/$defs/artifact_state" },
        "captured_at": { "type": ["string", "null"] }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "freshness_slo", "slo_state"],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_state" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "waiver": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"] }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "family_kind",
        "family_ref",
        "family_summary",
        "release_blocking",
        "claim_ref",
        "claim_label",
        "qualification_row_ref",
        "row_published_label",
        "binding_state",
        "support_class",
        "badge",
        "evaluation_pack",
        "compatibility_report",
        "release_center_card",
        "surfaces",
        "proof_packet",
        "owner_signoff",
        "published_label",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "family_kind": { "$ref": "#/$defs/family_kind" },
        "family_ref": { "type": "string", "minLength": 1 },
        "family_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "qualification_row_ref": { "type": "string", "minLength": 1 },
        "row_published_label": { "$ref": "#/$defs/lifecycle_label" },
        "binding_state": { "$ref": "#/$defs/binding_state" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "badge": { "$ref": "#/$defs/marketable_badge" },
        "evaluation_pack": { "$ref": "#/$defs/binding_artifact_ref" },
        "compatibility_report": { "$ref": "#/$defs/binding_artifact_ref" },
        "release_center_card": { "$ref": "#/$defs/binding_artifact_ref" },
        "surfaces": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/badge_surface" }
        },
        "compatibility_caveats": { "type": "array", "items": { "type": "string" } },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": { "type": "array", "items": { "type": "string" } },
        "blocking_claim_ids": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
