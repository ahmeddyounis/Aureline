{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aureline.dev/compat/m5-family-certification.schema.json",
  "title": "M5 per-family certification register",
  "description": "Canonical typed register that certifies every claimed M5 stable-facing family. For each family it binds the four governance pillars the source documents treat as the public contract — the qualification-matrix row, the mixed-version skew window, the diff/deprecation packet, and the claim-publication entry — into one certification packet and decides whether the family may carry a certified Stable claim or is narrowed. The pillars never collapse into one global flag: each carries its own freshness state, so a stale qualification dimension narrows the family while the skew and claim pillars stay current. A certified family reuses the public claim's published label and support class verbatim (claim-manifest parity) and rides all four pillars current inside an open validity window with owner sign-off; a family may never certify a greener label or broader support class than its public claim. A family whose public claim already narrowed merely inherits that narrowing (row_downgraded) and is gated upstream, while a certification-layer failure (a stale or missing pillar, a stale/missing certification proof packet, a broken claim parity, a missing diff report, an expired window or waiver, or a missing sign-off) on a family whose public claim is still at or above the cutline narrows the certified claim and holds promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "qualification_matrix_ref",
    "claim_manifest_ref",
    "diff_report_ref",
    "skew_inspector_ref",
    "evidence_index_ref",
    "lifecycle_labels",
    "family_kinds",
    "support_classes",
    "row_states",
    "skew_window_classes",
    "deprecation_statuses",
    "evidence_states",
    "pillar_kinds",
    "required_pillars",
    "certification_states",
    "freshness_states",
    "certification_reasons",
    "stop_actions",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "rows",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "certify_m5_family_qualification_skew_deprecation_and_claim_publication"
    },
    "register_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "qualification_matrix_ref": { "type": "string", "minLength": 1 },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "diff_report_ref": { "type": "string", "minLength": 1 },
    "skew_inspector_ref": { "type": "string", "minLength": 1 },
    "evidence_index_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
    "family_kinds": { "type": "array", "items": { "$ref": "#/$defs/family_kind" } },
    "support_classes": { "type": "array", "items": { "$ref": "#/$defs/support_class" } },
    "row_states": { "type": "array", "items": { "$ref": "#/$defs/row_state" } },
    "skew_window_classes": { "type": "array", "items": { "$ref": "#/$defs/skew_window_class" } },
    "deprecation_statuses": { "type": "array", "items": { "$ref": "#/$defs/deprecation_status" } },
    "evidence_states": { "type": "array", "items": { "$ref": "#/$defs/evidence_state" } },
    "pillar_kinds": { "type": "array", "items": { "$ref": "#/$defs/pillar_kind" } },
    "required_pillars": { "type": "array", "items": { "$ref": "#/$defs/pillar_kind" } },
    "certification_states": { "type": "array", "items": { "$ref": "#/$defs/certification_state" } },
    "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness_state" } },
    "certification_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/certification_reason" }
    },
    "stop_actions": { "type": "array", "items": { "$ref": "#/$defs/stop_action" } },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stop_rule" } },
    "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "type": "object" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family_kind": {
      "type": "string",
      "enum": [
        "notebook",
        "ai_provider",
        "remote_helper",
        "companion",
        "ecosystem",
        "managed_service",
        "toolchain_runtime"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["full_support", "maintenance_only", "security_only", "limited", "end_of_life"]
    },
    "row_state": {
      "type": "string",
      "enum": [
        "qualified",
        "limited",
        "on_waiver",
        "retest_pending",
        "stale",
        "unsupported_skew",
        "deprecated",
        "incomplete"
      ]
    },
    "skew_window_class": {
      "type": "string",
      "enum": [
        "lockstep_only",
        "bounded_skew",
        "backward_compatible",
        "forward_compatible",
        "unsupported_skew"
      ]
    },
    "deprecation_status": {
      "type": "string",
      "enum": ["active", "deprecated", "successor_available", "removal_scheduled", "removed"]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["current", "stale", "missing", "dropped", "unsigned"]
    },
    "pillar_kind": {
      "type": "string",
      "enum": ["qualification_matrix", "skew_window", "diff_deprecation", "claim_publication"]
    },
    "certification_state": {
      "type": "string",
      "enum": [
        "certified",
        "narrowed_row_downgraded",
        "narrowed_stale",
        "narrowed_retest_pending",
        "withheld"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "certification_reason": {
      "type": "string",
      "enum": [
        "row_downgraded",
        "qualification_stale",
        "retest_pending",
        "skew_window_exceeded",
        "deprecation_scheduled",
        "diff_report_missing",
        "claim_parity_broken",
        "evidence_stale",
        "evidence_missing",
        "owner_signoff_missing",
        "validity_window_expired",
        "claim_publication_missing"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "hold_certification",
        "narrow_row",
        "withhold_row",
        "refresh_evidence",
        "schedule_retest",
        "renew_validity_window",
        "request_owner_signoff",
        "publish_diff_report",
        "align_claim_parity"
      ]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutline_level", "above_cutline_levels", "below_cutline_levels", "description"],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "below_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "proof_index_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"], "format": "date" },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_state" },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "waiver": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "validity_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "expires_at", "expired"],
      "properties": {
        "starts_at": { "type": "string", "format": "date" },
        "expires_at": { "type": "string", "format": "date" },
        "expired": { "type": "boolean" }
      }
    },
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pillar_ref", "state", "summary"],
      "properties": {
        "kind": { "$ref": "#/$defs/pillar_kind" },
        "pillar_ref": { "type": "string" },
        "state": { "$ref": "#/$defs/evidence_state" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/certification_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "family_kind",
        "family_ref",
        "family_summary",
        "release_blocking",
        "qualification_row_ref",
        "claim_manifest_entry_ref",
        "skew_window_ref",
        "diff_deprecation_packet_ref",
        "claim_label",
        "source_published_label",
        "source_support_class",
        "source_claim_text",
        "row_state",
        "skew_window_class",
        "deprecation_status",
        "pillars",
        "validity_window",
        "certification_state",
        "certified_support_class",
        "certified_label",
        "certification_caveats",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "active_certification_reasons",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "family_kind": { "$ref": "#/$defs/family_kind" },
        "family_ref": { "type": "string", "minLength": 1 },
        "family_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "qualification_row_ref": { "type": "string", "minLength": 1 },
        "claim_manifest_entry_ref": { "type": "string", "minLength": 1 },
        "skew_window_ref": { "type": "string", "minLength": 1 },
        "diff_deprecation_packet_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "source_published_label": { "$ref": "#/$defs/lifecycle_label" },
        "source_support_class": { "$ref": "#/$defs/support_class" },
        "source_claim_text": { "type": "string", "minLength": 1 },
        "row_state": { "$ref": "#/$defs/row_state" },
        "skew_window_class": { "$ref": "#/$defs/skew_window_class" },
        "deprecation_status": { "$ref": "#/$defs/deprecation_status" },
        "pillars": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/pillar" }
        },
        "validity_window": { "$ref": "#/$defs/validity_window" },
        "certification_state": { "$ref": "#/$defs/certification_state" },
        "certified_support_class": { "$ref": "#/$defs/support_class" },
        "certified_label": { "$ref": "#/$defs/lifecycle_label" },
        "certification_caveats": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_certification_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/certification_reason" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "blocking_rule_ids", "blocking_claim_ids", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blocking_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
