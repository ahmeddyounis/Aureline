{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aureline.dev/compat/m5-boundary-skew-inspectors.schema.json",
  "title": "M5 mixed-version boundary skew-inspector register",
  "description": "Canonical typed register of the runtime skew inspectors bound to the M5 boundary-crossing flows — helper/agent attach, extension/runtime load, workspace-state import/restore, and provider snapshot/open. Each inspector binds the boundary to the version skew it inspects, the fail-closed verdict it reports before a mutating-or-privileged action, the helper/agent/host/schema/provider downgrade subject it speaks for, a structured upgrade-order guide, and the stable claim it backs. Help/About, release-center, service-health, support, and export surfaces ingest this directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "qualification_matrix_ref",
    "lifecycle_labels",
    "boundary_kinds",
    "downgrade_subjects",
    "gated_actions",
    "action_risks",
    "skew_window_classes",
    "inspector_verdicts",
    "gate_postures",
    "upgrade_lead_sides",
    "inspector_states",
    "narrowing_reasons",
    "stop_rule_actions",
    "launch_cutline",
    "release_blocking_boundary_refs",
    "stop_rules",
    "inspectors",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "ship_mixed_version_skew_inspectors_upgrade_order_guides_and_fail_closed_unsupported_skew_states_across_m5_boundaries"
    },
    "register_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "qualification_matrix_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "boundary_kinds": { "type": "array", "items": { "$ref": "#/$defs/boundary_kind" } },
    "downgrade_subjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_subject" }
    },
    "gated_actions": { "type": "array", "items": { "$ref": "#/$defs/gated_action" } },
    "action_risks": { "type": "array", "items": { "$ref": "#/$defs/action_risk" } },
    "skew_window_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/skew_window_class" }
    },
    "inspector_verdicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/inspector_verdict" }
    },
    "gate_postures": { "type": "array", "items": { "$ref": "#/$defs/gate_posture" } },
    "upgrade_lead_sides": {
      "type": "array",
      "items": { "$ref": "#/$defs/upgrade_lead_side" }
    },
    "inspector_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/inspector_state" }
    },
    "narrowing_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/narrowing_reason" }
    },
    "stop_rule_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/stop_action" }
    },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_boundary_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop_rule" }
    },
    "inspectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inspector" }
    },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "type": "object" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "boundary_kind": {
      "type": "string",
      "enum": [
        "helper_agent_attach",
        "extension_runtime_load",
        "state_import_restore",
        "provider_snapshot_open"
      ]
    },
    "downgrade_subject": {
      "type": "string",
      "enum": ["helper", "agent", "host", "schema", "provider"]
    },
    "gated_action": {
      "type": "string",
      "enum": ["attach", "load", "restore", "open"]
    },
    "action_risk": {
      "type": "string",
      "enum": ["mutating", "privileged", "mutating_and_privileged"]
    },
    "skew_window_class": {
      "type": "string",
      "enum": [
        "lockstep_only",
        "bounded_skew",
        "backward_compatible",
        "forward_compatible",
        "unsupported_skew"
      ]
    },
    "inspector_verdict": {
      "type": "string",
      "enum": [
        "inside_window",
        "unsupported_skew",
        "reconnect_required",
        "reinstall_required",
        "migration_needed",
        "retest_pending"
      ]
    },
    "gate_posture": {
      "type": "string",
      "enum": ["allow", "fail_closed"]
    },
    "upgrade_lead_side": {
      "type": "string",
      "enum": ["none_required", "local_first", "peer_first", "coordinated"]
    },
    "inspector_state": {
      "type": "string",
      "enum": [
        "inside_window",
        "limited",
        "on_waiver",
        "fail_closed",
        "retest_pending",
        "evidence_stale",
        "incomplete"
      ]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "skew_window_exceeded",
        "reconnect_required",
        "reinstall_required",
        "migration_needed",
        "retest_pending",
        "evidence_stale",
        "evidence_missing",
        "waiver_expired",
        "owner_signoff_missing",
        "claim_publication_missing"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "widen_or_document_skew",
        "guide_reconnect",
        "guide_reinstall",
        "guide_migration",
        "retest_boundary",
        "refresh_evidence",
        "capture_evidence",
        "narrow_label",
        "request_owner_signoff",
        "republish_claim"
      ]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/narrowing_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "skew_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skew_window_class",
        "local_version",
        "peer_version",
        "min_supported_version",
        "max_supported_version",
        "skew_window_ref"
      ],
      "properties": {
        "skew_window_class": { "$ref": "#/$defs/skew_window_class" },
        "local_version": { "type": "string", "minLength": 1 },
        "peer_version": { "type": "string", "minLength": 1 },
        "min_supported_version": { "type": "string", "minLength": 1 },
        "max_supported_version": { "type": "string", "minLength": 1 },
        "negotiated_fields": { "type": "array", "items": { "type": "string" } },
        "skew_window_ref": { "type": "string", "minLength": 1 }
      }
    },
    "upgrade_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "side", "instruction"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "side": { "$ref": "#/$defs/upgrade_lead_side" },
        "instruction": { "type": "string", "minLength": 1 }
      }
    },
    "upgrade_order_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead_side", "guide_ref"],
      "properties": {
        "lead_side": { "$ref": "#/$defs/upgrade_lead_side" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/upgrade_step" } },
        "guide_ref": { "type": "string", "minLength": 1 }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "proof_index_ref",
        "freshness_slo",
        "slo_state"
      ],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": {
          "type": "string",
          "enum": ["current", "due_for_refresh", "breached", "missing"]
        },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "waiver": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"] }
      }
    },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "boundary_kind",
        "boundary_ref",
        "boundary_summary",
        "release_blocking",
        "downgrade_subject",
        "gated_action",
        "action_risk",
        "local_role",
        "peer_role",
        "claim_ref",
        "claim_label",
        "inspector_state",
        "skew_window",
        "verdict",
        "gate_posture",
        "upgrade_order_guide",
        "proof_packet",
        "owner_signoff",
        "published_label",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "boundary_kind": { "$ref": "#/$defs/boundary_kind" },
        "boundary_ref": { "type": "string", "minLength": 1 },
        "boundary_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "downgrade_subject": { "$ref": "#/$defs/downgrade_subject" },
        "gated_action": { "$ref": "#/$defs/gated_action" },
        "action_risk": { "$ref": "#/$defs/action_risk" },
        "local_role": { "type": "string", "minLength": 1 },
        "peer_role": { "type": "string", "minLength": 1 },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "inspector_state": { "$ref": "#/$defs/inspector_state" },
        "skew_window": { "$ref": "#/$defs/skew_window" },
        "verdict": { "$ref": "#/$defs/inspector_verdict" },
        "gate_posture": { "$ref": "#/$defs/gate_posture" },
        "upgrade_order_guide": { "$ref": "#/$defs/upgrade_order_guide" },
        "compatibility_caveats": { "type": "array", "items": { "type": "string" } },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "publication_destinations": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": { "type": "array", "items": { "type": "string" } },
        "blocking_claim_ids": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
