{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aureline.dev/compat/m5-public-interface-diff-reports.schema.json",
  "title": "M5 public-interface diff-report register",
  "description": "Canonical typed register of the public-interface diff reports for changed stable-facing M5 contracts — wire/state schemas, CLI/headless outputs, exported packets, SDK/runtime contracts, and compatibility bridges. Each report binds the contract to the diff it carries (added, removed, and changed surface plus the reader/writer compatibility review), the compatibility window it lives in, the support-class caveat it publishes, and the successor/deprecation packet that governs how the old contract leaves the window. Docs, Help/About, release-center, service-health, CLI inspect, support, upgrade-notes, and export surfaces ingest this directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "version_windows_ref",
    "qualification_matrix_ref",
    "lifecycle_labels",
    "contract_kinds",
    "change_classes",
    "compatibility_postures",
    "window_support_states",
    "review_postures",
    "support_classes",
    "deprecation_statuses",
    "report_states",
    "narrowing_reasons",
    "stop_rule_actions",
    "launch_cutline",
    "release_blocking_contract_refs",
    "stop_rules",
    "reports",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "implement_public_interface_diff_reports_compatibility_windows_support_class_caveats_and_successor_deprecation_packets_for_changed_stable_facing_m5_contracts"
    },
    "register_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "version_windows_ref": { "type": "string", "minLength": 1 },
    "qualification_matrix_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
    "contract_kinds": { "type": "array", "items": { "$ref": "#/$defs/contract_kind" } },
    "change_classes": { "type": "array", "items": { "$ref": "#/$defs/change_class" } },
    "compatibility_postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/compatibility_posture" }
    },
    "window_support_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/window_support_state" }
    },
    "review_postures": { "type": "array", "items": { "$ref": "#/$defs/review_posture" } },
    "support_classes": { "type": "array", "items": { "$ref": "#/$defs/support_class" } },
    "deprecation_statuses": {
      "type": "array",
      "items": { "$ref": "#/$defs/deprecation_status" }
    },
    "report_states": { "type": "array", "items": { "$ref": "#/$defs/report_state" } },
    "narrowing_reasons": { "type": "array", "items": { "$ref": "#/$defs/narrowing_reason" } },
    "stop_rule_actions": { "type": "array", "items": { "$ref": "#/$defs/stop_action" } },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_contract_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop_rule" }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/report" }
    },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "type": "object" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "contract_kind": {
      "type": "string",
      "enum": [
        "schema",
        "cli_headless_output",
        "exported_packet",
        "sdk_runtime_contract",
        "compatibility_bridge"
      ]
    },
    "change_class": {
      "type": "string",
      "enum": ["additive", "behavioral", "breaking"]
    },
    "compatibility_posture": {
      "type": "string",
      "enum": ["fully_compatible", "backward_compatible", "forward_compatible", "breaking"]
    },
    "window_support_state": {
      "type": "string",
      "enum": ["within_window", "support_ended"]
    },
    "review_posture": {
      "type": "string",
      "enum": ["compatible", "breaking", "unreviewed"]
    },
    "support_class": {
      "type": "string",
      "enum": ["fully_supported", "supported_with_caveats", "limited", "unsupported"]
    },
    "deprecation_status": {
      "type": "string",
      "enum": ["deprecated", "superseded", "removal_scheduled", "removed"]
    },
    "report_state": {
      "type": "string",
      "enum": [
        "published",
        "limited",
        "on_waiver",
        "breaking_unpacketed",
        "deprecation_incomplete",
        "compat_review_pending",
        "removal_overdue",
        "support_window_ended",
        "evidence_stale",
        "incomplete"
      ]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "breaking_change_unpacketed",
        "reader_writer_review_missing",
        "deprecation_packet_incomplete",
        "removal_overdue",
        "support_window_ended",
        "evidence_stale",
        "evidence_missing",
        "waiver_expired",
        "owner_signoff_missing",
        "claim_publication_missing"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "publish_deprecation_packet",
        "complete_compat_review",
        "complete_deprecation_packet",
        "execute_or_extend_removal",
        "extend_or_close_window",
        "refresh_evidence",
        "capture_evidence",
        "narrow_label",
        "request_owner_signoff",
        "republish_claim"
      ]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutline_level", "above_cutline_levels", "below_cutline_levels", "description"],
      "properties": {
        "cutline_level": { "const": "stable" },
        "above_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "below_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/narrowing_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "surface_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed", "reader_posture", "writer_posture", "diff_ref"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "changed": { "type": "array", "items": { "type": "string" } },
        "reader_posture": { "$ref": "#/$defs/review_posture" },
        "writer_posture": { "$ref": "#/$defs/review_posture" },
        "diff_ref": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posture",
        "min_supported_version",
        "current_version",
        "max_supported_version",
        "support_state",
        "window_ref"
      ],
      "properties": {
        "posture": { "$ref": "#/$defs/compatibility_posture" },
        "min_supported_version": { "type": "string", "minLength": 1 },
        "current_version": { "type": "string", "minLength": 1 },
        "max_supported_version": { "type": "string", "minLength": 1 },
        "support_state": { "$ref": "#/$defs/window_support_state" },
        "window_ref": { "type": "string", "minLength": 1 }
      }
    },
    "support_caveat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_class", "caveats"],
      "properties": {
        "support_class": { "$ref": "#/$defs/support_class" },
        "caveats": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contract_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "deprecation_packet": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "owner_ref", "alias_map", "removal_overdue", "packet_ref"],
      "properties": {
        "status": { "$ref": "#/$defs/deprecation_status" },
        "owner_ref": { "type": "string", "minLength": 1 },
        "successor_ref": { "type": ["string", "null"] },
        "alias_map": { "type": "array", "items": { "$ref": "#/$defs/contract_alias" } },
        "removal_checkpoint": { "type": ["string", "null"] },
        "removal_date": { "type": ["string", "null"] },
        "removal_overdue": { "type": "boolean" },
        "migration_ref": { "type": ["string", "null"] },
        "rollback_implications": { "type": ["string", "null"] },
        "packet_ref": { "type": "string", "minLength": 1 }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "freshness_slo", "slo_state"],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": {
          "type": "string",
          "enum": ["current", "due_for_refresh", "breached", "missing"]
        },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "waiver": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"] }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "contract_kind",
        "contract_ref",
        "contract_summary",
        "release_blocking",
        "change_class",
        "claim_ref",
        "claim_label",
        "report_state",
        "interface_diff",
        "compatibility_window",
        "support_caveat",
        "deprecation_packet",
        "proof_packet",
        "owner_signoff",
        "published_label",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "contract_kind": { "$ref": "#/$defs/contract_kind" },
        "contract_ref": { "type": "string", "minLength": 1 },
        "contract_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "change_class": { "$ref": "#/$defs/change_class" },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "report_state": { "$ref": "#/$defs/report_state" },
        "interface_diff": { "$ref": "#/$defs/surface_diff" },
        "compatibility_window": { "$ref": "#/$defs/compatibility_window" },
        "support_caveat": { "$ref": "#/$defs/support_caveat" },
        "deprecation_packet": { "$ref": "#/$defs/deprecation_packet" },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "publication_destinations": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": { "type": "array", "items": { "type": "string" } },
        "blocking_claim_ids": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
