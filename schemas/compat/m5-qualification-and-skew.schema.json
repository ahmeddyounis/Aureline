{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aureline.dev/compat/m5-qualification-and-skew.schema.json",
  "title": "M5 qualification-row, support-window, skew-window, and deprecation-packet matrix",
  "description": "Canonical typed matrix that freezes one qualification row per M5 stable-facing family, each binding the family to its stable claim, a qualification row of one cell per dimension, a declared skew window, a support window, a deprecation packet, a proof packet, and an owner sign-off. Docs, release notes, CLI inspect, in-product badges, support exports, certification reports, and shiproom dashboards ingest this directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "matrix_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "lifecycle_labels",
    "family_kinds",
    "qualification_dimensions",
    "qualification_states",
    "row_states",
    "skew_window_classes",
    "skew_unsupported_behaviors",
    "support_classes",
    "deprecation_statuses",
    "narrowing_reasons",
    "stop_rule_actions",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "rows",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "freeze_m5_qualification_row_support_window_skew_window_and_deprecation_packet_matrix"
    },
    "matrix_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "family_kinds": { "type": "array", "items": { "$ref": "#/$defs/family_kind" } },
    "qualification_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualification_dimension" }
    },
    "qualification_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualification_state" }
    },
    "row_states": { "type": "array", "items": { "$ref": "#/$defs/row_state" } },
    "skew_window_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/skew_window_class" }
    },
    "skew_unsupported_behaviors": {
      "type": "array",
      "items": { "$ref": "#/$defs/skew_unsupported_behavior" }
    },
    "support_classes": { "type": "array", "items": { "$ref": "#/$defs/support_class" } },
    "deprecation_statuses": {
      "type": "array",
      "items": { "$ref": "#/$defs/deprecation_status" }
    },
    "narrowing_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/narrowing_reason" }
    },
    "stop_rule_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/stop_action" }
    },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop_rule" }
    },
    "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "type": "object" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family_kind": {
      "type": "string",
      "enum": [
        "notebook",
        "ai_provider",
        "remote_helper",
        "companion",
        "ecosystem",
        "managed_service",
        "toolchain_runtime"
      ]
    },
    "qualification_dimension": {
      "type": "string",
      "enum": [
        "platform",
        "deployment_profile",
        "archetype_bundle",
        "toolchain_envelope",
        "client_scope"
      ]
    },
    "qualification_state": {
      "type": "string",
      "enum": ["qualified", "limited", "retest_pending", "stale", "waived", "missing"]
    },
    "row_state": {
      "type": "string",
      "enum": [
        "qualified",
        "limited",
        "on_waiver",
        "retest_pending",
        "stale",
        "unsupported_skew",
        "deprecated",
        "incomplete"
      ]
    },
    "skew_window_class": {
      "type": "string",
      "enum": [
        "lockstep_only",
        "bounded_skew",
        "backward_compatible",
        "forward_compatible",
        "unsupported_skew"
      ]
    },
    "skew_unsupported_behavior": {
      "type": "string",
      "enum": [
        "fail_closed",
        "reconnect_required",
        "reinstall_required",
        "coordinated_upgrade_only",
        "block_boundary"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": [
        "full_support",
        "maintenance_only",
        "security_only",
        "limited",
        "end_of_life"
      ]
    },
    "deprecation_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "successor_available",
        "removal_scheduled",
        "removed"
      ]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "qualification_incomplete",
        "qualification_stale",
        "retest_pending",
        "skew_window_exceeded",
        "deprecation_scheduled",
        "support_window_ended",
        "waiver_expired",
        "owner_signoff_missing",
        "claim_publication_missing"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "narrow_label",
        "complete_qualification",
        "refresh_evidence",
        "retest_boundary",
        "widen_or_document_skew",
        "publish_successor_migration",
        "renew_support_window",
        "request_owner_signoff",
        "republish_claim"
      ]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "const": "stable" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/narrowing_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "qualification_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state", "evidence_ref"],
      "properties": {
        "dimension": { "$ref": "#/$defs/qualification_dimension" },
        "state": { "$ref": "#/$defs/qualification_state" },
        "evidence_ref": { "type": "string" }
      }
    },
    "skew_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skew_window_class",
        "min_supported_version",
        "max_supported_version",
        "unsupported_behavior",
        "skew_window_ref"
      ],
      "properties": {
        "skew_window_class": { "$ref": "#/$defs/skew_window_class" },
        "min_supported_version": { "type": "string", "minLength": 1 },
        "max_supported_version": { "type": "string", "minLength": 1 },
        "negotiated_fields": { "type": "array", "items": { "type": "string" } },
        "unsupported_behavior": { "$ref": "#/$defs/skew_unsupported_behavior" },
        "skew_window_ref": { "type": "string", "minLength": 1 }
      }
    },
    "support_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_class", "supported_since", "support_window_ref"],
      "properties": {
        "support_class": { "$ref": "#/$defs/support_class" },
        "supported_since": { "type": "string", "minLength": 1 },
        "end_of_support": { "type": ["string", "null"] },
        "support_window_ref": { "type": "string", "minLength": 1 }
      }
    },
    "deprecation_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "deprecation_packet_ref"],
      "properties": {
        "status": { "$ref": "#/$defs/deprecation_status" },
        "successor_ref": { "type": ["string", "null"] },
        "removal_after": { "type": ["string", "null"] },
        "migration_ref": { "type": ["string", "null"] },
        "deprecation_packet_ref": { "type": "string", "minLength": 1 }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "proof_index_ref",
        "freshness_slo",
        "slo_state"
      ],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"] },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": {
          "type": "string",
          "enum": ["current", "due_for_refresh", "breached", "missing"]
        },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "waiver": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"] }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "family_kind",
        "family_ref",
        "family_summary",
        "release_blocking",
        "claim_ref",
        "claim_label",
        "row_state",
        "qualification_row",
        "skew_window",
        "support_window",
        "deprecation_packet",
        "proof_packet",
        "owner_signoff",
        "published_label",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "family_kind": { "$ref": "#/$defs/family_kind" },
        "family_ref": { "type": "string", "minLength": 1 },
        "family_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "row_state": { "$ref": "#/$defs/row_state" },
        "qualification_row": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/qualification_cell" }
        },
        "skew_window": { "$ref": "#/$defs/skew_window" },
        "support_window": { "$ref": "#/$defs/support_window" },
        "deprecation_packet": { "$ref": "#/$defs/deprecation_packet" },
        "compatibility_caveats": { "type": "array", "items": { "type": "string" } },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "publication_destinations": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": { "type": "array", "items": { "type": "string" } },
        "blocking_claim_ids": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
