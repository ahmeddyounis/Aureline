{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aureline.dev/compat/m5-claim-publication-manifests.schema.json",
  "title": "M5 claim-publication manifest register",
  "description": "Canonical typed register that binds every claimed M5 stable-facing family to one claim-publication manifest: the exact marketable wording, support class, scope caveats, and validity window; the backing reference-workspace, compatibility, and evaluation report refs; and the closed set of consuming destinations the manifest drives (website/docs, release notes, in-product badge, CLI inspect, evaluation pack, admin export). Every destination renders from the one manifest id with the same published label, support class, and exact wording, so docs, release notes, badges, CLI inspect, and evaluation packs reuse one source of truth and a narrowed manifest downgrades every consuming surface at once. Stale, missing, dropped, or unsigned evidence, an expired validity window, or wording wider than the qualification row narrows the claim and holds promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "qualification_matrix_ref",
    "evidence_index_ref",
    "lifecycle_labels",
    "family_kinds",
    "support_classes",
    "report_kinds",
    "report_states",
    "destination_kinds",
    "required_destinations",
    "manifest_states",
    "freshness_states",
    "narrowing_reasons",
    "stop_actions",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "manifests",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "add_m5_claim_publication_manifests_and_automatic_claim_narrowing"
    },
    "register_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "qualification_matrix_ref": { "type": "string", "minLength": 1 },
    "evidence_index_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
    "family_kinds": { "type": "array", "items": { "$ref": "#/$defs/family_kind" } },
    "support_classes": { "type": "array", "items": { "$ref": "#/$defs/support_class" } },
    "report_kinds": { "type": "array", "items": { "$ref": "#/$defs/report_kind" } },
    "report_states": { "type": "array", "items": { "$ref": "#/$defs/report_state" } },
    "destination_kinds": { "type": "array", "items": { "$ref": "#/$defs/destination" } },
    "required_destinations": { "type": "array", "items": { "$ref": "#/$defs/destination" } },
    "manifest_states": { "type": "array", "items": { "$ref": "#/$defs/manifest_state" } },
    "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness_state" } },
    "narrowing_reasons": { "type": "array", "items": { "$ref": "#/$defs/narrowing_reason" } },
    "stop_actions": { "type": "array", "items": { "$ref": "#/$defs/stop_action" } },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stop_rule" } },
    "manifests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/manifest" } },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "type": "object" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "family_kind": {
      "type": "string",
      "enum": [
        "notebook",
        "ai_provider",
        "remote_helper",
        "companion",
        "ecosystem",
        "managed_service",
        "toolchain_runtime"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["full_support", "maintenance_only", "security_only", "limited", "end_of_life"]
    },
    "report_kind": {
      "type": "string",
      "enum": ["reference_workspace_report", "compatibility_report", "evaluation_report"]
    },
    "report_state": {
      "type": "string",
      "enum": ["current", "stale", "missing", "dropped", "unsigned"]
    },
    "destination": {
      "type": "string",
      "enum": [
        "website_docs",
        "release_notes",
        "in_product_badge",
        "cli_inspect",
        "evaluation_pack",
        "admin_export",
        "help_about",
        "service_health",
        "support_export"
      ]
    },
    "manifest_state": {
      "type": "string",
      "enum": [
        "published",
        "narrowed_row_downgraded",
        "narrowed_stale",
        "narrowed_missing",
        "withheld"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "qualification_row_narrowed",
        "evidence_stale",
        "evidence_missing",
        "report_stale",
        "report_missing",
        "report_dropped",
        "report_unsigned",
        "validity_window_expired",
        "over_claim_beyond_row",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "hold_publication",
        "narrow_claim",
        "withhold_claim",
        "refresh_report",
        "refresh_evidence",
        "align_copy_to_row",
        "renew_validity_window",
        "request_owner_signoff"
      ]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutline_level", "above_cutline_levels", "below_cutline_levels", "description"],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "below_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "proof_index_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"], "format": "date" },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_state" },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "validity_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "expires_at", "expired"],
      "properties": {
        "starts_at": { "type": "string", "format": "date" },
        "expires_at": { "type": "string", "format": "date" },
        "expired": { "type": "boolean" }
      }
    },
    "published_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_text", "support_class", "scope_caveats", "validity_window"],
      "properties": {
        "claim_text": { "type": "string", "minLength": 1 },
        "support_class": { "$ref": "#/$defs/support_class" },
        "scope_caveats": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "validity_window": { "$ref": "#/$defs/validity_window" }
      }
    },
    "report_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_kind", "report_ref", "state", "captured_at"],
      "properties": {
        "report_kind": { "$ref": "#/$defs/report_kind" },
        "report_ref": { "type": "string" },
        "state": { "$ref": "#/$defs/report_state" },
        "captured_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "destination_rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination",
        "source_manifest_id",
        "rendered_label",
        "rendered_support_class",
        "rendered_claim_text",
        "discloses_freshness",
        "discloses_caveats"
      ],
      "properties": {
        "destination": { "$ref": "#/$defs/destination" },
        "source_manifest_id": { "type": "string", "minLength": 1 },
        "rendered_label": { "$ref": "#/$defs/lifecycle_label" },
        "rendered_support_class": { "$ref": "#/$defs/support_class" },
        "rendered_claim_text": { "type": "string", "minLength": 1 },
        "discloses_freshness": { "type": "boolean" },
        "discloses_caveats": { "type": "boolean" }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/narrowing_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "family_kind",
        "family_ref",
        "family_summary",
        "release_blocking",
        "claim_ref",
        "claim_label",
        "qualification_row_ref",
        "row_published_label",
        "manifest_state",
        "published_claim",
        "reference_workspace_report",
        "compatibility_report",
        "evaluation_report",
        "destinations",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "active_narrowing_reasons",
        "published_label",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "family_kind": { "$ref": "#/$defs/family_kind" },
        "family_ref": { "type": "string", "minLength": 1 },
        "family_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "qualification_row_ref": { "type": "string", "minLength": 1 },
        "row_published_label": { "$ref": "#/$defs/lifecycle_label" },
        "manifest_state": { "$ref": "#/$defs/manifest_state" },
        "published_claim": { "$ref": "#/$defs/published_claim" },
        "reference_workspace_report": { "$ref": "#/$defs/report_ref" },
        "compatibility_report": { "$ref": "#/$defs/report_ref" },
        "evaluation_report": { "$ref": "#/$defs/report_ref" },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/destination_rendering" }
        },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }] },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "blocking_rule_ids", "blocking_claim_ids", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blocking_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
