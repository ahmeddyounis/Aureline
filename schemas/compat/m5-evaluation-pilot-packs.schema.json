{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aureline.dev/compat/m5-evaluation-pilot-packs.schema.json",
  "title": "M5 private evaluation/pilot evidence-pack register",
  "description": "Canonical typed register that packages enterprise and ecosystem evaluation/pilot materials on top of the public claim-publication manifest. For each enterprise/ecosystem lane it binds one evidence pack to a named bundle id and its mirror refs, the support contacts, the known-issues deltas beyond the public known-limits, and the deployment caveats; and to the public claim-publication manifest entry it reuses — its exact wording, support class, and published label, all hard ceilings. A pack may never publish a greener label or broader support class than its public claim, a published pack reuses the public wording verbatim, and every partner-facing destination (evaluation pack, pilot packet, admin export, support export) renders from the one pack, so a narrowed pack downgrades every partner surface at once. Pilot-only wording can never bypass a support-class limit or stale evidence. A pack whose public claim narrowed, whose bundle mirror or proof evidence went stale, missing, dropped, or unsigned, whose validity window expired, or whose owner sign-off lapsed narrows the pack; a pack-layer failure on a pack whose public claim is still at or above the cutline holds promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "qualification_matrix_ref",
    "known_limits_ref",
    "evidence_index_ref",
    "lifecycle_labels",
    "lane_kinds",
    "family_kinds",
    "support_classes",
    "evidence_states",
    "mirror_kinds",
    "issue_severities",
    "destination_kinds",
    "required_destinations",
    "pack_states",
    "freshness_states",
    "narrowing_reasons",
    "stop_actions",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "packs",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "type": "string",
      "const": "ship_m5_private_evaluation_pilot_evidence_packs"
    },
    "register_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "claim_manifest_ref": { "type": "string", "minLength": 1 },
    "qualification_matrix_ref": { "type": "string", "minLength": 1 },
    "known_limits_ref": { "type": "string", "minLength": 1 },
    "evidence_index_ref": { "type": "string", "minLength": 1 },
    "lifecycle_labels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
    "lane_kinds": { "type": "array", "items": { "$ref": "#/$defs/lane_kind" } },
    "family_kinds": { "type": "array", "items": { "$ref": "#/$defs/family_kind" } },
    "support_classes": { "type": "array", "items": { "$ref": "#/$defs/support_class" } },
    "evidence_states": { "type": "array", "items": { "$ref": "#/$defs/evidence_state" } },
    "mirror_kinds": { "type": "array", "items": { "$ref": "#/$defs/mirror_kind" } },
    "issue_severities": { "type": "array", "items": { "$ref": "#/$defs/issue_severity" } },
    "destination_kinds": { "type": "array", "items": { "$ref": "#/$defs/destination" } },
    "required_destinations": { "type": "array", "items": { "$ref": "#/$defs/destination" } },
    "pack_states": { "type": "array", "items": { "$ref": "#/$defs/pack_state" } },
    "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness_state" } },
    "narrowing_reasons": { "type": "array", "items": { "$ref": "#/$defs/narrowing_reason" } },
    "stop_actions": { "type": "array", "items": { "$ref": "#/$defs/stop_action" } },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stop_rule" } },
    "packs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pack" } },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "type": "object" }
  },
  "$defs": {
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "lane_kind": {
      "type": "string",
      "enum": ["enterprise_evaluation", "enterprise_pilot", "ecosystem_partner", "managed_pilot"]
    },
    "family_kind": {
      "type": "string",
      "enum": [
        "notebook",
        "ai_provider",
        "remote_helper",
        "companion",
        "ecosystem",
        "managed_service",
        "toolchain_runtime"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": ["full_support", "maintenance_only", "security_only", "limited", "end_of_life"]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["current", "stale", "missing", "dropped", "unsigned"]
    },
    "mirror_kind": {
      "type": "string",
      "enum": ["primary", "offline_bundle", "partner_mirror", "air_gapped"]
    },
    "issue_severity": {
      "type": "string",
      "enum": ["blocker", "major", "minor"]
    },
    "destination": {
      "type": "string",
      "enum": [
        "evaluation_pack",
        "pilot_packet",
        "admin_export",
        "support_export",
        "service_health",
        "release_center"
      ]
    },
    "pack_state": {
      "type": "string",
      "enum": [
        "published",
        "narrowed_public_claim",
        "narrowed_stale",
        "narrowed_missing",
        "withheld"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "public_claim_narrowed",
        "evidence_stale",
        "evidence_missing",
        "mirror_stale",
        "mirror_missing",
        "mirror_dropped",
        "mirror_unsigned",
        "validity_window_expired",
        "over_claim_beyond_public_claim",
        "owner_signoff_missing",
        "waiver_expired"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "hold_publication",
        "narrow_pack",
        "withhold_pack",
        "refresh_mirror",
        "refresh_evidence",
        "align_copy_to_public_claim",
        "renew_validity_window",
        "request_owner_signoff"
      ]
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutline_level", "above_cutline_levels", "below_cutline_levels", "description"],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "below_cutline_levels": { "type": "array", "items": { "$ref": "#/$defs/lifecycle_label" } },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "freshness_slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_max_age_days", "warn_within_days", "slo_register_ref"],
      "properties": {
        "target_max_age_days": { "type": "integer", "minimum": 1 },
        "warn_within_days": { "type": "integer", "minimum": 0 },
        "slo_register_ref": { "type": "string", "minLength": 1 }
      }
    },
    "proof_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_ref",
        "proof_index_ref",
        "captured_at",
        "freshness_slo",
        "slo_state",
        "evidence_refs"
      ],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "packet_ref": { "type": "string", "minLength": 1 },
        "proof_index_ref": { "type": "string", "minLength": 1 },
        "captured_at": { "type": ["string", "null"], "format": "date" },
        "freshness_slo": { "$ref": "#/$defs/freshness_slo" },
        "slo_state": { "$ref": "#/$defs/freshness_state" },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_ref", "expires_at", "reason"],
      "properties": {
        "waiver_ref": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "owner_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "signed_off", "signed_at"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1 },
        "signed_off": { "type": "boolean" },
        "signed_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "validity_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "expires_at", "expired"],
      "properties": {
        "starts_at": { "type": "string", "format": "date" },
        "expires_at": { "type": "string", "format": "date" },
        "expired": { "type": "boolean" }
      }
    },
    "mirror_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirror_id", "mirror_kind", "location_ref", "bundle_digest_ref", "state"],
      "properties": {
        "mirror_id": { "type": "string", "minLength": 1 },
        "mirror_kind": { "$ref": "#/$defs/mirror_kind" },
        "location_ref": { "type": "string" },
        "bundle_digest_ref": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/evidence_state" }
      }
    },
    "support_contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "contact_ref"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "contact_ref": { "type": "string", "minLength": 1 }
      }
    },
    "known_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "summary", "severity", "workaround_ref", "public_known_limit_ref", "disclosed"],
      "properties": {
        "issue_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/issue_severity" },
        "workaround_ref": { "type": "string", "minLength": 1 },
        "public_known_limit_ref": { "type": ["string", "null"], "minLength": 1 },
        "disclosed": { "type": "boolean" }
      }
    },
    "destination_rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination",
        "source_pack_id",
        "rendered_label",
        "rendered_support_class",
        "rendered_claim_text",
        "discloses_freshness",
        "discloses_known_issues",
        "discloses_caveats"
      ],
      "properties": {
        "destination": { "$ref": "#/$defs/destination" },
        "source_pack_id": { "type": "string", "minLength": 1 },
        "rendered_label": { "$ref": "#/$defs/lifecycle_label" },
        "rendered_support_class": { "$ref": "#/$defs/support_class" },
        "rendered_claim_text": { "type": "string", "minLength": 1 },
        "discloses_freshness": { "type": "boolean" },
        "discloses_known_issues": { "type": "boolean" },
        "discloses_caveats": { "type": "boolean" }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "trigger_reason": { "$ref": "#/$defs/narrowing_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "title",
        "lane_kind",
        "family_kind",
        "family_ref",
        "family_summary",
        "release_blocking",
        "claim_manifest_ref",
        "claim_manifest_entry_ref",
        "public_claim_label",
        "public_support_class",
        "public_claim_text",
        "bundle_id",
        "mirror_refs",
        "support_contacts",
        "known_issues_delta",
        "deployment_caveats",
        "validity_window",
        "pack_state",
        "pack_support_class",
        "pack_published_label",
        "pack_claim_text",
        "destinations",
        "proof_packet",
        "waiver",
        "owner_signoff",
        "active_narrowing_reasons",
        "rationale"
      ],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "lane_kind": { "$ref": "#/$defs/lane_kind" },
        "family_kind": { "$ref": "#/$defs/family_kind" },
        "family_ref": { "type": "string", "minLength": 1 },
        "family_summary": { "type": "string", "minLength": 1 },
        "release_blocking": { "type": "boolean" },
        "claim_manifest_ref": { "type": "string", "minLength": 1 },
        "claim_manifest_entry_ref": { "type": "string", "minLength": 1 },
        "public_claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "public_support_class": { "$ref": "#/$defs/support_class" },
        "public_claim_text": { "type": "string", "minLength": 1 },
        "bundle_id": { "type": "string", "minLength": 1 },
        "mirror_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mirror_ref" } },
        "support_contacts": { "type": "array", "items": { "$ref": "#/$defs/support_contact" } },
        "known_issues_delta": { "type": "array", "items": { "$ref": "#/$defs/known_issue" } },
        "deployment_caveats": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "validity_window": { "$ref": "#/$defs/validity_window" },
        "pack_state": { "$ref": "#/$defs/pack_state" },
        "pack_support_class": { "$ref": "#/$defs/support_class" },
        "pack_published_label": { "$ref": "#/$defs/lifecycle_label" },
        "pack_claim_text": { "type": "string", "minLength": 1 },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/destination_rendering" }
        },
        "proof_packet": { "$ref": "#/$defs/proof_packet" },
        "waiver": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }] },
        "owner_signoff": { "$ref": "#/$defs/owner_signoff" },
        "active_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_gate", "decision", "blocking_rule_ids", "blocking_claim_ids", "rationale"],
      "properties": {
        "promotion_gate": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blocking_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
