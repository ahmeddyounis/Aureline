{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ux/m5-accessibility-and-continuity.schema.json",
  "title": "Aureline M5 keyboard, assistive-tech, reduced-motion, and interruption-safe continuity across forms and sheets",
  "description": "Canonical, export-safe object model for the accessibility and interruption-safety contract every M5 dense multi-step form, inline validation-link group, and batch/staged-review sheet must hold so the shared structured-input model stays fully usable under keyboard-only, assistive-tech, reduced-motion, reconnect, and restart conditions. One contract is reused across the provider, admin, request, package, settings, import, and project lanes. Each surface binds its keyboard reachability (deterministic focus order, roving focus, batch-action keyboard parity, an escapable focus trap), its assistive-tech reachability (permanent screen-reader labels, inline validation links announced, blocked-submit reasons in a live region, the step position announced), its reduced-motion behavior (bound to the shared substitution class so state never depends on animation), and its interruption-safe continuity (a recovery journal that preserves the current step, blocked fields, and draft across reconnect, restart, missing dependency, and crash), so an effective claim can be re-derived without trusting a grade: a surface that drops a keyboard path, an undefined focus order, an unreachable batch action, a missing screen-reader label, an un-announced validation link or blocked submit, a motion-only state, a lost step/blocked-field/draft on interruption, a mutable imported review, a lost recovery path, a missing continuity journal, or renders wider than its claim floors to continuity_unsafe, while a labelled recoverable gap holds a first-party surface at continuity_narrowed, an import/migration review sits at continuity_review_overlay, and a Labs/unadvertised surface makes no public claim. No credential bodies, secret values, raw provider payloads, absolute paths, or URLs ever cross this boundary; refs carry opaque ids only. Adding an enum value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking and requires a new decision row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "label",
    "as_of",
    "taxonomy_version",
    "redaction_class_token",
    "verification_freshness",
    "surfaces"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "m5_accessibility_continuity_set_packet" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "label": { "type": "string", "minLength": 1, "maxLength": 220 },
    "as_of": { "type": "string", "format": "date-time" },
    "taxonomy_version": { "type": "integer", "const": 1 },
    "redaction_class_token": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "structured_fields_with_path_redaction",
        "support_bundle_scoped",
        "broadened_capture"
      ],
      "description": "Default redaction posture for the packet. No credential bodies, secret values, raw provider payloads, absolute paths, or URLs ever cross this boundary; refs carry opaque ids only."
    },
    "verification_freshness": { "$ref": "#/$defs/verification_freshness" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "opaque_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
    "opaque_ref_nullable": {
      "oneOf": [{ "$ref": "#/$defs/opaque_ref" }, { "type": "null" }]
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 400 },
    "verification_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_freshness_slo_hours",
        "last_verification_refresh",
        "auto_downgrade_on_stale"
      ],
      "properties": {
        "verification_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_verification_refresh": { "type": "string", "format": "date-time" },
        "auto_downgrade_on_stale": { "type": "boolean" }
      }
    },
    "surface_kind": {
      "type": "string",
      "enum": [
        "multi_step_form",
        "inline_validation_links",
        "batch_review_sheet",
        "staged_review_sheet",
        "config_editor"
      ]
    },
    "surface_lane": {
      "type": "string",
      "enum": ["provider", "admin", "request", "package", "settings", "import", "projects"]
    },
    "surface_origin": {
      "type": "string",
      "enum": ["local_form", "remote_form", "provider_form", "imported_review"]
    },
    "journal_state": {
      "type": "string",
      "enum": ["complete", "partial", "stale", "missing"]
    },
    "proof_currency": {
      "type": "string",
      "enum": [
        "verified_current",
        "cached_within_window",
        "stale_expired",
        "requires_review",
        "missing_proof"
      ]
    },
    "recovery_target": {
      "type": "string",
      "enum": ["surface_and_step", "step_only", "none_keyboard_fallback"]
    },
    "claim_posture": {
      "type": "string",
      "enum": ["claimed_stable", "labs_unadvertised"]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "live_surface",
        "review_sheet",
        "diagnostics_panel",
        "support_export",
        "accessibility_audit",
        "help_inline",
        "cli_headless"
      ]
    },
    "reduced_motion_substitution_class": {
      "type": "string",
      "description": "The shared design-system reduced-motion substitution posture (from crate::motion).",
      "enum": [
        "crossfade_only",
        "maintain_essential_keep_simplified",
        "suppress_entirely",
        "collapse_to_instant",
        "non_motion_state_marker"
      ]
    },
    "continuity_claim": {
      "type": "string",
      "enum": [
        "continuity_unsafe",
        "continuity_review_overlay",
        "continuity_narrowed",
        "continuity_certified",
        "continuity_labs_not_claimed"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_ref",
        "canonical_surface_ref",
        "form_ref",
        "provider_ref",
        "source_artifact_ref",
        "policy_ref",
        "journal_ref",
        "recovery_backlink_ref"
      ],
      "properties": {
        "session_ref": { "$ref": "#/$defs/opaque_ref" },
        "canonical_surface_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "form_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "provider_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "source_artifact_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "policy_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "journal_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "recovery_backlink_ref": { "$ref": "#/$defs/opaque_ref_nullable" }
      }
    },
    "keyboard_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus_order_defined",
        "all_controls_reachable",
        "roving_tabindex",
        "batch_actions_keyboard_parity",
        "focus_trap_escapable",
        "focus_trap_escape_labeled",
        "keyboard_label"
      ],
      "properties": {
        "focus_order_defined": { "type": "boolean" },
        "all_controls_reachable": { "type": "boolean" },
        "roving_tabindex": { "type": "boolean" },
        "batch_actions_keyboard_parity": { "type": "boolean" },
        "focus_trap_escapable": { "type": "boolean" },
        "focus_trap_escape_labeled": { "type": "boolean" },
        "keyboard_label": { "$ref": "#/$defs/label" }
      }
    },
    "assistive_tech": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen_reader_labels_present",
        "validation_links_announced",
        "blocked_submit_live_region",
        "step_position_announced",
        "at_label"
      ],
      "properties": {
        "screen_reader_labels_present": { "type": "boolean" },
        "validation_links_announced": { "type": "boolean" },
        "blocked_submit_live_region": { "type": "boolean" },
        "step_position_announced": { "type": "boolean" },
        "at_label": { "$ref": "#/$defs/label" }
      }
    },
    "reduced_motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "substitution_class",
        "state_conveyed_without_motion",
        "progress_non_motion_marker",
        "substitution_labeled",
        "progress_marker_labeled",
        "reduced_motion_label"
      ],
      "properties": {
        "substitution_class": { "$ref": "#/$defs/reduced_motion_substitution_class" },
        "state_conveyed_without_motion": { "type": "boolean" },
        "progress_non_motion_marker": { "type": "boolean" },
        "substitution_labeled": { "type": "boolean" },
        "progress_marker_labeled": { "type": "boolean" },
        "reduced_motion_label": { "$ref": "#/$defs/label" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboard", "assistive_tech", "reduced_motion"],
      "properties": {
        "keyboard": { "$ref": "#/$defs/keyboard_access" },
        "assistive_tech": { "$ref": "#/$defs/assistive_tech" },
        "reduced_motion": { "$ref": "#/$defs/reduced_motion" }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal_backed",
        "journal_state",
        "current_step_preserved",
        "blocked_fields_preserved",
        "draft_state_preserved",
        "resume_on_reconnect",
        "resume_on_restart",
        "resume_on_missing_dependency",
        "resume_on_crash",
        "continuity_label"
      ],
      "properties": {
        "journal_backed": { "type": "boolean" },
        "journal_state": { "$ref": "#/$defs/journal_state" },
        "current_step_preserved": { "type": "boolean" },
        "blocked_fields_preserved": { "type": "boolean" },
        "draft_state_preserved": { "type": "boolean" },
        "resume_on_reconnect": { "type": "boolean" },
        "resume_on_restart": { "type": "boolean" },
        "resume_on_missing_dependency": { "type": "boolean" },
        "resume_on_crash": { "type": "boolean" },
        "continuity_label": { "$ref": "#/$defs/label" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard_complete",
        "focus_order_deterministic",
        "batch_actions_keyboard_reachable",
        "screen_reader_reachable",
        "validation_links_in_at",
        "blocked_submit_in_live_region",
        "state_without_motion",
        "step_resumes_correctly",
        "blocked_fields_retained",
        "draft_state_retained",
        "imported_review_read_only",
        "step_position_announced"
      ],
      "properties": {
        "keyboard_complete": { "type": "boolean" },
        "focus_order_deterministic": { "type": "boolean" },
        "batch_actions_keyboard_reachable": { "type": "boolean" },
        "screen_reader_reachable": { "type": "boolean" },
        "validation_links_in_at": { "type": "boolean" },
        "blocked_submit_in_live_region": { "type": "boolean" },
        "state_without_motion": { "type": "boolean" },
        "step_resumes_correctly": { "type": "boolean" },
        "blocked_fields_retained": { "type": "boolean" },
        "draft_state_retained": { "type": "boolean" },
        "imported_review_read_only": { "type": "boolean" },
        "step_position_announced": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_currency", "proof_ref"],
      "properties": {
        "proof_currency": { "$ref": "#/$defs/proof_currency" },
        "proof_ref": { "$ref": "#/$defs/opaque_ref_nullable" }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "rendered_claim",
        "recovery_visible",
        "read_only",
        "source_surface_ref"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/consumer_surface" },
        "rendered_claim": { "$ref": "#/$defs/continuity_claim" },
        "recovery_visible": { "type": "boolean" },
        "read_only": { "type": "boolean" },
        "source_surface_ref": { "$ref": "#/$defs/opaque_ref" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_kind",
        "lane",
        "origin",
        "label_summary",
        "claim_posture",
        "declared_recovery_target",
        "lineage",
        "accessibility",
        "continuity",
        "integrity",
        "verification",
        "renderings"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/stable_id" },
        "surface_kind": { "$ref": "#/$defs/surface_kind" },
        "lane": { "$ref": "#/$defs/surface_lane" },
        "origin": { "$ref": "#/$defs/surface_origin" },
        "label_summary": { "$ref": "#/$defs/label" },
        "claim_posture": { "$ref": "#/$defs/claim_posture" },
        "declared_recovery_target": { "$ref": "#/$defs/recovery_target" },
        "lineage": { "$ref": "#/$defs/lineage" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "continuity": { "$ref": "#/$defs/continuity" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "verification": { "$ref": "#/$defs/verification" },
        "renderings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rendering" }
        }
      }
    }
  }
}
