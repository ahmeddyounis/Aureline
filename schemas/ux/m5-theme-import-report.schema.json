{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ux/m5-theme-import-report.schema.json",
  "title": "Aureline M5 imported-theme mapping & rollback report",
  "description": "Boundary schema for the migration-center imported-theme report produced by crates/aureline-shell/src/theme_import_reports/mod.rs. Each imported theme is projected as one row carrying source provenance (ecosystem, tool, version, opaque theme id), a translated-token count and an explicit unresolved-slot count, syntax-token coverage, a parity note and a controlled parity-claim state, a rollback ref, and the controlled migration-center outcome state. The migration center, support/export wrapper, compatibility packets, release/public-truth packs, and sync/import flows all consume this one report object. A row claims full parity only when zero slots are unresolved, zero honesty checks are blocked, and syntax coverage is complete; every imported visual customization carries a reversible rollback ref. Raw theme files, raw token values, raw screenshots, raw URLs, raw absolute paths, and raw user content never cross this boundary; records carry opaque refs, closed vocabulary, counts, and short privacy-safe labels only. The closed appearance vocabulary (source_ecosystem_class, mapping_state, parity_claim_state, import_outcome_state, rollback_path_class) is re-exported by reference from schemas/ux/theme_import_report.schema.json; this schema mints no parallel appearance vocabulary. This schema is the boundary contract for the JSON fixtures checked in under fixtures/ux/m5/theme-import-corpus/ and the support-export wrapper consumed by the CI gate at tools/ci/m5/theme_import_report_check.py.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/m5_theme_import_report_record" },
    { "$ref": "#/$defs/m5_theme_import_report_support_export_record" }
  ],
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Integer schema version. Bumped only on breaking payload changes; additive optional fields and additive vocabulary do not bump it."
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "shell:m5_theme_import_report:v1",
      "description": "Stable shared contract ref every record carries."
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque, stable id safe to log, safe on RPC, and safe in support/export packets."
    },
    "monotonic_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "source_ecosystem_class": {
      "type": "string",
      "enum": [
        "vscode",
        "jetbrains",
        "vim",
        "emacs",
        "zed",
        "sublime",
        "textmate",
        "unknown"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (source_ecosystem_class) without modification."
    },
    "mapping_state": {
      "type": "string",
      "enum": [
        "translated",
        "substituted_fallback",
        "unsupported",
        "unresolved",
        "blocked_honesty",
        "deprecated_replacement"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (mapping_state) without modification."
    },
    "import_outcome_state": {
      "type": "string",
      "enum": [
        "preview_ready",
        "applied",
        "applied_with_warnings",
        "blocked",
        "rolled_back",
        "cancelled",
        "policy_denied",
        "review_required"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (import_outcome_state) without modification."
    },
    "parity_claim_state": {
      "type": "string",
      "enum": [
        "not_claimed",
        "claimed_with_report",
        "partial_claim_with_gaps",
        "denied_unresolved_or_blocked"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (parity_claim_state) without modification."
    },
    "rollback_path_class": {
      "type": "string",
      "enum": [
        "restore_appearance_checkpoint",
        "discard_preview",
        "reopen_import_review",
        "manual_repair_required",
        "rollback_unavailable_denied"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (rollback_path_class) without modification."
    },
    "source_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ecosystem",
        "source_tool_name",
        "source_tool_version",
        "source_theme_identifier"
      ],
      "properties": {
        "source_ecosystem": { "$ref": "#/$defs/source_ecosystem_class" },
        "source_tool_name": { "$ref": "#/$defs/non_empty_string" },
        "source_tool_version": { "$ref": "#/$defs/non_empty_string" },
        "source_theme_identifier": { "$ref": "#/$defs/opaque_id" }
      }
    },
    "mapping_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_source_slot_count",
        "translated_slot_count",
        "substituted_with_fallback_count",
        "unsupported_slot_count",
        "unresolved_mapping_count",
        "blocked_honesty_count"
      ],
      "properties": {
        "total_source_slot_count": { "type": "integer", "minimum": 0 },
        "translated_slot_count": { "type": "integer", "minimum": 0 },
        "substituted_with_fallback_count": { "type": "integer", "minimum": 0 },
        "unsupported_slot_count": { "type": "integer", "minimum": 0 },
        "unresolved_mapping_count": { "type": "integer", "minimum": 0 },
        "blocked_honesty_count": { "type": "integer", "minimum": 0 }
      }
    },
    "syntax_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_source_scope_count",
        "translated_scope_count",
        "substituted_scope_count",
        "unresolved_scope_count",
        "blocked_scope_count",
        "coverage_percent"
      ],
      "properties": {
        "total_source_scope_count": { "type": "integer", "minimum": 0 },
        "translated_scope_count": { "type": "integer", "minimum": 0 },
        "substituted_scope_count": { "type": "integer", "minimum": 0 },
        "unresolved_scope_count": { "type": "integer", "minimum": 0 },
        "blocked_scope_count": { "type": "integer", "minimum": 0 },
        "coverage_percent": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "rollback_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback_path_class",
        "checkpoint_ref",
        "rollback_ref",
        "user_visible_action_id",
        "note"
      ],
      "properties": {
        "rollback_path_class": { "$ref": "#/$defs/rollback_path_class" },
        "checkpoint_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/opaque_id" }]
        },
        "rollback_ref": { "$ref": "#/$defs/opaque_id" },
        "user_visible_action_id": { "$ref": "#/$defs/opaque_id" },
        "note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    },
    "unresolved_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_slot_ref", "summary", "fallback_disclosed"],
      "properties": {
        "source_slot_ref": { "$ref": "#/$defs/opaque_id" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "fallback_disclosed": { "type": "boolean" }
      }
    },
    "known_deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation_id", "summary", "recoverable"],
      "properties": {
        "deviation_id": { "$ref": "#/$defs/opaque_id" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "recoverable": { "type": "boolean" }
      }
    },
    "outcome_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_ready",
        "applied",
        "applied_with_warnings",
        "blocked",
        "rolled_back",
        "cancelled",
        "policy_denied",
        "review_required",
        "total_rows"
      ],
      "properties": {
        "preview_ready": { "type": "integer", "minimum": 0 },
        "applied": { "type": "integer", "minimum": 0 },
        "applied_with_warnings": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "rolled_back": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 },
        "policy_denied": { "type": "integer", "minimum": 0 },
        "review_required": { "type": "integer", "minimum": 0 },
        "total_rows": { "type": "integer", "minimum": 0 }
      }
    },
    "aggregate_token_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_source_slots",
        "total_translated_slots",
        "total_unresolved_slots",
        "total_blocked_slots"
      ],
      "properties": {
        "total_source_slots": { "type": "integer", "minimum": 0 },
        "total_translated_slots": { "type": "integer", "minimum": 0 },
        "total_unresolved_slots": { "type": "integer", "minimum": 0 },
        "total_blocked_slots": { "type": "integer", "minimum": 0 }
      }
    },
    "theme_import_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "row_id",
        "title",
        "source_tool",
        "source_artifact_ref",
        "target_theme_package_ref",
        "import_outcome",
        "primary_mapping_state",
        "mapping_summary",
        "syntax_coverage",
        "parity_claim_state",
        "parity_note",
        "mutates_durable_state",
        "rollback",
        "compatibility_note",
        "unresolved_slots",
        "known_deviations",
        "docs_help_refs",
        "narrative"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_theme_import_report_row_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_tool": { "$ref": "#/$defs/source_tool" },
        "source_artifact_ref": { "$ref": "#/$defs/opaque_id" },
        "target_theme_package_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/opaque_id" }]
        },
        "import_outcome": { "$ref": "#/$defs/import_outcome_state" },
        "primary_mapping_state": { "$ref": "#/$defs/mapping_state" },
        "mapping_summary": { "$ref": "#/$defs/mapping_summary" },
        "syntax_coverage": { "$ref": "#/$defs/syntax_coverage" },
        "parity_claim_state": { "$ref": "#/$defs/parity_claim_state" },
        "parity_note": { "$ref": "#/$defs/non_empty_string" },
        "mutates_durable_state": { "type": "boolean" },
        "rollback": { "$ref": "#/$defs/rollback_ref" },
        "compatibility_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        },
        "unresolved_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/unresolved_slot" }
        },
        "known_deviations": {
          "type": "array",
          "items": { "$ref": "#/$defs/known_deviation" }
        },
        "docs_help_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "narrative": { "$ref": "#/$defs/non_empty_string" }
      },
      "allOf": [
        {
          "description": "A full parity claim requires zero unresolved mappings and zero blocked honesty checks.",
          "if": {
            "properties": { "parity_claim_state": { "const": "claimed_with_report" } },
            "required": ["parity_claim_state"]
          },
          "then": {
            "properties": {
              "mapping_summary": {
                "type": "object",
                "properties": {
                  "unresolved_mapping_count": { "const": 0 },
                  "blocked_honesty_count": { "const": 0 }
                }
              }
            }
          }
        }
      ]
    },
    "m5_theme_import_report_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "report_id",
        "source_schema_ref",
        "headline",
        "preview_before_apply",
        "rows",
        "outcome_summary",
        "aggregate_tokens",
        "ecosystem_coverage",
        "every_import_reversible",
        "no_overclaimed_parity",
        "unresolved_counts_disclosed",
        "no_raw_theme_content",
        "migration_center_refs",
        "compatibility_report_refs",
        "release_truth_refs",
        "sync_refs",
        "readiness_review_refs",
        "docs_help_refs",
        "export_refs",
        "support_packet_refs",
        "published_report_ref",
        "published_doc_ref",
        "generated_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_theme_import_report_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "report_id": { "$ref": "#/$defs/opaque_id" },
        "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "headline": { "$ref": "#/$defs/non_empty_string" },
        "preview_before_apply": { "type": "boolean" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/theme_import_row" }
        },
        "outcome_summary": { "$ref": "#/$defs/outcome_summary" },
        "aggregate_tokens": { "$ref": "#/$defs/aggregate_token_summary" },
        "ecosystem_coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_ecosystem_class" }
        },
        "every_import_reversible": { "type": "boolean" },
        "no_overclaimed_parity": { "type": "boolean" },
        "unresolved_counts_disclosed": { "type": "boolean" },
        "no_raw_theme_content": { "type": "boolean" },
        "migration_center_refs": { "$ref": "#/$defs/ref_array" },
        "compatibility_report_refs": { "$ref": "#/$defs/ref_array" },
        "release_truth_refs": { "$ref": "#/$defs/ref_array" },
        "sync_refs": { "$ref": "#/$defs/ref_array" },
        "readiness_review_refs": { "$ref": "#/$defs/ref_array" },
        "docs_help_refs": { "$ref": "#/$defs/ref_array" },
        "export_refs": { "$ref": "#/$defs/ref_array" },
        "support_packet_refs": { "$ref": "#/$defs/ref_array" },
        "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
        "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/monotonic_timestamp" }
      }
    },
    "m5_theme_import_report_support_export_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "support_export_id",
        "report",
        "case_ids"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_theme_import_report_support_export_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "support_export_id": { "$ref": "#/$defs/non_empty_string" },
        "report": { "$ref": "#/$defs/m5_theme_import_report_record" },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    }
  }
}
