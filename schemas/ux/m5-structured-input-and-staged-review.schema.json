{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ux/m5-structured-input-and-staged-review.schema.json",
  "title": "Aureline M5 structured-input and staged-review set",
  "description": "Canonical, export-safe object model that freezes the structured-input, parameter-provenance, draft-state, and staged-review truth shared by mutation-capable forms, wizards, and review sheets across the provider, admin, request, package, import, settings, and project lanes. Each surface binds its field provenance (default/detected/imported/policy-locked/user-override/required-unset, with overrides kept distinct), its field- and form-level validation state, its draft-versus-applied state and recovery behavior, its submit blockers, and its staged-review (commit) sheet declaring target scope, omitted defaults, included/excluded/blocked members, side effects, and a rollback/export path. The surface carries enough identity to re-derive an effective claim without trusting a grade: a form that hides a field source, blurs draft versus applied, hides target scope or omitted defaults, buries a blocked prerequisite or rollback consequence behind a generic Continue, silently overrides a policy lock, submits over an invalid-blocking field, lets an imported/restore review read as a local apply, loses its reopen path, or discards a recoverable draft floors to surface_unsafe and falls back to an explicit blocked state with a reopen/keyboard recovery path, while a labelled recoverable gap holds a first-party surface at surface_narrowed, an imported/restore review sits at surface_review_overlay, and a Labs/unadvertised surface makes no public claim. No credential bodies, secret values, raw provider payloads, absolute paths, or URLs ever cross this boundary; refs carry opaque ids only. Adding an enum value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking and requires a new decision row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "label",
    "as_of",
    "taxonomy_version",
    "redaction_class_token",
    "verification_freshness",
    "surfaces"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "m5_structured_input_set_packet" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
    "as_of": { "type": "string", "format": "date-time" },
    "taxonomy_version": { "type": "integer", "const": 1 },
    "redaction_class_token": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "structured_fields_with_path_redaction",
        "support_bundle_scoped",
        "broadened_capture"
      ],
      "description": "Default redaction posture for the packet. No credential bodies, secret values, raw provider payloads, absolute paths, or URLs ever cross this boundary; refs carry opaque ids only."
    },
    "verification_freshness": { "$ref": "#/$defs/verification_freshness" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "opaque_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
    "opaque_ref_nullable": {
      "oneOf": [{ "$ref": "#/$defs/opaque_ref" }, { "type": "null" }]
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 400 },
    "verification_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_freshness_slo_hours",
        "last_verification_refresh",
        "auto_downgrade_on_stale"
      ],
      "properties": {
        "verification_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_verification_refresh": { "type": "string", "format": "date-time" },
        "auto_downgrade_on_stale": { "type": "boolean" }
      }
    },
    "surface_kind": {
      "type": "string",
      "enum": [
        "structured_form",
        "multi_step_wizard",
        "publish_review_dialog",
        "import_restore_dialog",
        "install_review_sheet",
        "parameterized_workflow"
      ]
    },
    "lane": {
      "type": "string",
      "enum": ["provider", "admin", "request", "package", "import", "settings", "projects"]
    },
    "mutation_class": {
      "type": "string",
      "enum": ["local", "remote", "provider_backed", "import_export", "policy_locked"]
    },
    "source_of_value_class": {
      "type": "string",
      "enum": [
        "default_value",
        "detected_value",
        "imported_value",
        "policy_locked",
        "user_override",
        "required_unset"
      ]
    },
    "field_state": {
      "type": "string",
      "enum": [
        "editable",
        "read_only_locked",
        "disabled_blocked",
        "masked_credential",
        "computed_derived"
      ]
    },
    "validation_state": {
      "type": "string",
      "enum": ["valid", "pending_async", "warning", "invalid_blocking", "not_validated"]
    },
    "draft_state": {
      "type": "string",
      "enum": [
        "clean_applied",
        "dirty_draft",
        "autosaved_draft",
        "recovered_draft",
        "submitting",
        "submit_failed_recoverable"
      ]
    },
    "interruption_behavior": {
      "type": "string",
      "enum": [
        "preserves_recoverable_draft",
        "prompts_restore_on_reopen",
        "discards_with_explicit_confirm",
        "reconnect_resumes_in_place",
        "no_recovery"
      ]
    },
    "staged_review_member_class": {
      "type": "string",
      "enum": ["included", "excluded_by_default", "excluded_by_user", "blocked_prerequisite"]
    },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "reversible_local",
        "reversible_with_export",
        "irreversible_confirmed",
        "external_publish",
        "policy_governed"
      ]
    },
    "submit_blocker_class": {
      "type": "string",
      "enum": [
        "invalid_field",
        "missing_prerequisite",
        "cross_field_conflict",
        "unresolved_policy_lock",
        "pending_validation",
        "unreviewed_side_effect"
      ]
    },
    "surface_origin": {
      "type": "string",
      "enum": ["local_authoring", "remote_target", "provider_backed", "imported_or_restore"]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["live", "cached_snapshot", "stale_expired", "superseded_by_newer_source", "missing"]
    },
    "proof_currency": {
      "type": "string",
      "enum": ["verified_current", "cached_within_window", "stale_expired", "requires_review", "missing_proof"]
    },
    "reopen_target": {
      "type": "string",
      "enum": ["surface_and_draft", "draft_only", "none_keyboard_fallback"]
    },
    "claim_posture": {
      "type": "string",
      "enum": ["claimed_stable", "labs_unadvertised"]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "form_view",
        "wizard_step",
        "review_sheet",
        "diagnostics_panel",
        "support_export",
        "ai_evidence",
        "help_inline"
      ]
    },
    "surface_claim": {
      "type": "string",
      "enum": [
        "surface_unsafe",
        "surface_review_overlay",
        "surface_narrowed",
        "surface_certified",
        "surface_labs_not_claimed"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_ref",
        "canonical_surface_ref",
        "origin_target_ref",
        "provider_ref",
        "source_artifact_ref",
        "draft_store_ref",
        "rollback_plan_ref",
        "reopen_backlink_ref"
      ],
      "properties": {
        "session_ref": { "$ref": "#/$defs/opaque_ref" },
        "canonical_surface_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "origin_target_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "provider_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "source_artifact_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "draft_store_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "rollback_plan_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "reopen_backlink_ref": { "$ref": "#/$defs/opaque_ref_nullable" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_state",
        "draft_applied_distinct",
        "autosave_enabled",
        "local_draft_persisted",
        "restore_prompt_on_reopen",
        "interruption_behavior",
        "reconnect_resumes",
        "dirty_field_count",
        "last_autosave_present"
      ],
      "properties": {
        "draft_state": { "$ref": "#/$defs/draft_state" },
        "draft_applied_distinct": { "type": "boolean" },
        "autosave_enabled": { "type": "boolean" },
        "local_draft_persisted": { "type": "boolean" },
        "restore_prompt_on_reopen": { "type": "boolean" },
        "interruption_behavior": { "$ref": "#/$defs/interruption_behavior" },
        "reconnect_resumes": { "type": "boolean" },
        "dirty_field_count": { "type": "integer", "minimum": 0 },
        "last_autosave_present": { "type": "boolean" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "source_class",
        "source_class_labeled",
        "field_state",
        "validation_state",
        "validation_state_labeled",
        "override_distinct_from_default",
        "policy_lock_respected",
        "label_summary"
      ],
      "properties": {
        "field_id": { "$ref": "#/$defs/stable_id" },
        "source_class": { "$ref": "#/$defs/source_of_value_class" },
        "source_class_labeled": { "type": "boolean" },
        "field_state": { "$ref": "#/$defs/field_state" },
        "validation_state": { "$ref": "#/$defs/validation_state" },
        "validation_state_labeled": { "type": "boolean" },
        "override_distinct_from_default": { "type": "boolean" },
        "policy_lock_respected": { "type": "boolean" },
        "label_summary": { "$ref": "#/$defs/label" }
      }
    },
    "submit_blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_id",
        "blocker_class",
        "explained_before_submit",
        "blocks_submit",
        "resolution_hint_present",
        "label_summary"
      ],
      "properties": {
        "blocker_id": { "$ref": "#/$defs/stable_id" },
        "blocker_class": { "$ref": "#/$defs/submit_blocker_class" },
        "explained_before_submit": { "type": "boolean" },
        "blocks_submit": { "type": "boolean" },
        "resolution_hint_present": { "type": "boolean" },
        "label_summary": { "$ref": "#/$defs/label" }
      }
    },
    "staged_review_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "member_class", "reason_labeled", "label_summary"],
      "properties": {
        "member_id": { "$ref": "#/$defs/stable_id" },
        "member_class": { "$ref": "#/$defs/staged_review_member_class" },
        "reason_labeled": { "type": "boolean" },
        "label_summary": { "$ref": "#/$defs/label" }
      }
    },
    "side_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "effect_class",
        "disclosed_before_commit",
        "reversible",
        "label_summary"
      ],
      "properties": {
        "effect_id": { "$ref": "#/$defs/stable_id" },
        "effect_class": { "$ref": "#/$defs/side_effect_class" },
        "disclosed_before_commit": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "label_summary": { "$ref": "#/$defs/label" }
      }
    },
    "staged_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_scope_declared",
        "target_scope_label",
        "omitted_defaults_disclosed",
        "omitted_default_count",
        "members",
        "members_classes_labeled",
        "side_effects",
        "side_effects_disclosed",
        "rollback_path_present",
        "export_path_present",
        "commit_action_is_specific"
      ],
      "properties": {
        "target_scope_declared": { "type": "boolean" },
        "target_scope_label": { "$ref": "#/$defs/label" },
        "omitted_defaults_disclosed": { "type": "boolean" },
        "omitted_default_count": { "type": "integer", "minimum": 0 },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/staged_review_member" }
        },
        "members_classes_labeled": { "type": "boolean" },
        "side_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect" }
        },
        "side_effects_disclosed": { "type": "boolean" },
        "rollback_path_present": { "type": "boolean" },
        "export_path_present": { "type": "boolean" },
        "commit_action_is_specific": { "type": "boolean" }
      }
    },
    "draft_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoverable_after_interruption",
        "recovery_behavior",
        "recovery_token_present",
        "reconnect_safe",
        "recovery_label"
      ],
      "properties": {
        "recoverable_after_interruption": { "type": "boolean" },
        "recovery_behavior": { "$ref": "#/$defs/interruption_behavior" },
        "recovery_token_present": { "type": "boolean" },
        "reconnect_safe": { "type": "boolean" },
        "recovery_label": { "$ref": "#/$defs/label" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserves_field_provenance",
        "draft_applied_distinct",
        "target_scope_visible",
        "omitted_defaults_visible",
        "blocked_prereqs_explained",
        "rollback_visible",
        "commit_action_specific",
        "imported_review_read_only",
        "recoverable_draft_preserved",
        "validation_state_visible",
        "policy_locks_respected",
        "freshness_state_visible",
        "superseded_state_marked",
        "reopen_visible_on_demand"
      ],
      "properties": {
        "preserves_field_provenance": { "type": "boolean" },
        "draft_applied_distinct": { "type": "boolean" },
        "target_scope_visible": { "type": "boolean" },
        "omitted_defaults_visible": { "type": "boolean" },
        "blocked_prereqs_explained": { "type": "boolean" },
        "rollback_visible": { "type": "boolean" },
        "commit_action_specific": { "type": "boolean" },
        "imported_review_read_only": { "type": "boolean" },
        "recoverable_draft_preserved": { "type": "boolean" },
        "validation_state_visible": { "type": "boolean" },
        "policy_locks_respected": { "type": "boolean" },
        "freshness_state_visible": { "type": "boolean" },
        "superseded_state_marked": { "type": "boolean" },
        "reopen_visible_on_demand": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_currency", "proof_ref"],
      "properties": {
        "proof_currency": { "$ref": "#/$defs/proof_currency" },
        "proof_ref": { "$ref": "#/$defs/opaque_ref_nullable" }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "rendered_claim",
        "provenance_visible",
        "read_only",
        "source_surface_ref"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/consumer_surface" },
        "rendered_claim": { "$ref": "#/$defs/surface_claim" },
        "provenance_visible": { "type": "boolean" },
        "read_only": { "type": "boolean" },
        "source_surface_ref": { "$ref": "#/$defs/opaque_ref" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_kind",
        "lane",
        "mutation_class",
        "origin",
        "label_summary",
        "claim_posture",
        "declared_freshness_state",
        "declared_reopen_target",
        "lineage",
        "session",
        "fields",
        "submit_blockers",
        "staged_review",
        "draft_recovery",
        "integrity",
        "verification",
        "renderings"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/stable_id" },
        "surface_kind": { "$ref": "#/$defs/surface_kind" },
        "lane": { "$ref": "#/$defs/lane" },
        "mutation_class": { "$ref": "#/$defs/mutation_class" },
        "origin": { "$ref": "#/$defs/surface_origin" },
        "label_summary": { "$ref": "#/$defs/label" },
        "claim_posture": { "$ref": "#/$defs/claim_posture" },
        "declared_freshness_state": { "$ref": "#/$defs/freshness_state" },
        "declared_reopen_target": { "$ref": "#/$defs/reopen_target" },
        "lineage": { "$ref": "#/$defs/lineage" },
        "session": { "$ref": "#/$defs/session" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        },
        "submit_blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/submit_blocker" }
        },
        "staged_review": { "$ref": "#/$defs/staged_review" },
        "draft_recovery": { "$ref": "#/$defs/draft_recovery" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "verification": { "$ref": "#/$defs/verification" },
        "renderings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rendering" }
        }
      }
    }
  }
}
