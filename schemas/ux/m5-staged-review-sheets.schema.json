{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ux/m5-staged-review-sheets.schema.json",
  "title": "Aureline M5 staged-review (commit) sheets across mutation flows",
  "description": "Canonical, export-safe object model that makes the commit sheet itself the first-class object every consequential M5 mutation flow stops at before it changes remote/provider/admin/package/request/import state. One review model is reused across provider publish-later, admin/source-management, request replay/mutation, package install/update/remove, and import/export/publish flows. Each sheet declares its target scope, its disclosed omitted defaults, a reconciled included/excluded/blocked/hidden count block, a disclosed side-effect summary with a rollback/export path, and a scope-and-effect-specific commit action, so an effective claim can be re-derived without trusting a grade: a sheet that hides its target scope, lets its member counts disagree, leaves hidden/collapsed members uncounted, hides the included/excluded/blocked counts on a multi-object action, hides omitted defaults, leaves a side effect undisclosed, buries a blocked prerequisite or rollback consequence behind a generic Continue, lets an imported/restore review read as a local apply, loses its reopen path, or renders wider than its claim floors to sheet_unsafe, while a labelled recoverable gap holds a first-party sheet at sheet_narrowed, an import/export review sits at sheet_review_overlay, and a Labs/unadvertised sheet makes no public claim. No credential bodies, secret values, raw provider payloads, absolute paths, or URLs ever cross this boundary; refs carry opaque ids only. Adding an enum value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking and requires a new decision row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "label",
    "as_of",
    "taxonomy_version",
    "redaction_class_token",
    "verification_freshness",
    "sheets"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "m5_staged_review_sheet_set_packet" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
    "as_of": { "type": "string", "format": "date-time" },
    "taxonomy_version": { "type": "integer", "const": 1 },
    "redaction_class_token": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "structured_fields_with_path_redaction",
        "support_bundle_scoped",
        "broadened_capture"
      ],
      "description": "Default redaction posture for the packet. No credential bodies, secret values, raw provider payloads, absolute paths, or URLs ever cross this boundary; refs carry opaque ids only."
    },
    "verification_freshness": { "$ref": "#/$defs/verification_freshness" },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sheet" }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "opaque_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
    "opaque_ref_nullable": {
      "oneOf": [{ "$ref": "#/$defs/opaque_ref" }, { "type": "null" }]
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 400 },
    "count": { "type": "integer", "minimum": 0 },
    "verification_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_freshness_slo_hours",
        "last_verification_refresh",
        "auto_downgrade_on_stale"
      ],
      "properties": {
        "verification_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_verification_refresh": { "type": "string", "format": "date-time" },
        "auto_downgrade_on_stale": { "type": "boolean" }
      }
    },
    "mutation_flow": {
      "type": "string",
      "enum": [
        "provider_publish_later",
        "admin_source_management",
        "request_replay_mutation",
        "package_lifecycle",
        "import_export_publish",
        "settings_bulk_apply"
      ]
    },
    "flow_lane": {
      "type": "string",
      "enum": ["provider", "admin", "request", "package", "import", "settings"]
    },
    "scope_kind": {
      "type": "string",
      "enum": ["single_object", "multi_object_explicit", "query_backed", "workspace_wide"]
    },
    "review_member_class": {
      "type": "string",
      "enum": [
        "included",
        "excluded_by_default",
        "excluded_by_user",
        "blocked_prerequisite",
        "hidden_collapsed"
      ]
    },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "reversible_local",
        "reversible_with_export",
        "irreversible_confirmed",
        "external_publish",
        "policy_governed"
      ]
    },
    "recoverability_class": {
      "type": "string",
      "enum": [
        "fully_reversible",
        "reversible_via_export",
        "partially_reversible",
        "irreversible"
      ]
    },
    "sheet_origin": {
      "type": "string",
      "enum": ["local_commit", "remote_commit", "provider_commit", "imported_review"]
    },
    "claim_posture": {
      "type": "string",
      "enum": ["claimed_stable", "labs_unadvertised"]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "live",
        "cached_snapshot",
        "stale_expired",
        "superseded_by_newer_source",
        "missing"
      ]
    },
    "proof_currency": {
      "type": "string",
      "enum": [
        "verified_current",
        "cached_within_window",
        "stale_expired",
        "requires_review",
        "missing_proof"
      ]
    },
    "reopen_target": {
      "type": "string",
      "enum": ["sheet_and_scope", "scope_only", "none_keyboard_fallback"]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_sheet",
        "batch_selection_bar",
        "diagnostics_panel",
        "support_export",
        "ai_evidence",
        "help_inline",
        "cli_confirmation"
      ]
    },
    "sheet_claim": {
      "type": "string",
      "enum": [
        "sheet_unsafe",
        "sheet_review_overlay",
        "sheet_narrowed",
        "sheet_certified",
        "sheet_labs_not_claimed"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_ref",
        "canonical_sheet_ref",
        "target_ref",
        "provider_ref",
        "source_artifact_ref",
        "rollback_plan_ref",
        "export_bundle_ref",
        "reopen_backlink_ref"
      ],
      "properties": {
        "session_ref": { "$ref": "#/$defs/opaque_ref" },
        "canonical_sheet_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "target_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "provider_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "source_artifact_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "rollback_plan_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "export_bundle_ref": { "$ref": "#/$defs/opaque_ref_nullable" },
        "reopen_backlink_ref": { "$ref": "#/$defs/opaque_ref_nullable" }
      }
    },
    "target_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_declared", "scope_label"],
      "properties": {
        "scope_kind": { "$ref": "#/$defs/scope_kind" },
        "scope_declared": { "type": "boolean" },
        "scope_label": { "$ref": "#/$defs/label" }
      }
    },
    "member_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "blocked", "hidden", "total_matched", "counts_visible"],
      "properties": {
        "included": { "$ref": "#/$defs/count" },
        "excluded": { "$ref": "#/$defs/count" },
        "blocked": { "$ref": "#/$defs/count" },
        "hidden": { "$ref": "#/$defs/count" },
        "total_matched": { "$ref": "#/$defs/count" },
        "counts_visible": { "type": "boolean" }
      }
    },
    "review_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "member_class", "reason_labeled", "label_summary"],
      "properties": {
        "member_id": { "$ref": "#/$defs/stable_id" },
        "member_class": { "$ref": "#/$defs/review_member_class" },
        "reason_labeled": { "type": "boolean" },
        "label_summary": { "$ref": "#/$defs/label" }
      }
    },
    "side_effect_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "effect_class", "disclosed_before_commit", "reversible", "label_summary"],
      "properties": {
        "effect_id": { "$ref": "#/$defs/stable_id" },
        "effect_class": { "$ref": "#/$defs/side_effect_class" },
        "disclosed_before_commit": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "label_summary": { "$ref": "#/$defs/label" }
      }
    },
    "recoverability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoverability_class",
        "recoverability_class_labeled",
        "rollback_path_present",
        "export_path_present",
        "recovery_label"
      ],
      "properties": {
        "recoverability_class": { "$ref": "#/$defs/recoverability_class" },
        "recoverability_class_labeled": { "type": "boolean" },
        "rollback_path_present": { "type": "boolean" },
        "export_path_present": { "type": "boolean" },
        "recovery_label": { "$ref": "#/$defs/label" }
      }
    },
    "commit_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_action_is_specific",
        "commit_action_label",
        "cancel_action_is_specific",
        "cancel_action_label"
      ],
      "properties": {
        "commit_action_is_specific": { "type": "boolean" },
        "commit_action_label": { "$ref": "#/$defs/label" },
        "cancel_action_is_specific": { "type": "boolean" },
        "cancel_action_label": { "$ref": "#/$defs/label" }
      }
    },
    "staged_review_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "omitted_defaults_disclosed",
        "omitted_default_count",
        "counts",
        "members",
        "members_classes_labeled",
        "side_effects",
        "side_effects_disclosed",
        "side_effect_summary_labeled",
        "recoverability",
        "commit"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/target_scope" },
        "omitted_defaults_disclosed": { "type": "boolean" },
        "omitted_default_count": { "$ref": "#/$defs/count" },
        "counts": { "$ref": "#/$defs/member_counts" },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/review_member" }
        },
        "members_classes_labeled": { "type": "boolean" },
        "side_effects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/side_effect_descriptor" }
        },
        "side_effects_disclosed": { "type": "boolean" },
        "side_effect_summary_labeled": { "type": "boolean" },
        "recoverability": { "$ref": "#/$defs/recoverability" },
        "commit": { "$ref": "#/$defs/commit_action" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_scope_visible",
        "counts_visible",
        "omitted_defaults_visible",
        "side_effects_disclosed",
        "blocked_prereqs_explained",
        "rollback_visible",
        "commit_action_specific",
        "imported_review_read_only",
        "member_classes_labeled",
        "recoverability_labeled",
        "freshness_state_visible",
        "superseded_state_marked",
        "reopen_visible_on_demand"
      ],
      "properties": {
        "target_scope_visible": { "type": "boolean" },
        "counts_visible": { "type": "boolean" },
        "omitted_defaults_visible": { "type": "boolean" },
        "side_effects_disclosed": { "type": "boolean" },
        "blocked_prereqs_explained": { "type": "boolean" },
        "rollback_visible": { "type": "boolean" },
        "commit_action_specific": { "type": "boolean" },
        "imported_review_read_only": { "type": "boolean" },
        "member_classes_labeled": { "type": "boolean" },
        "recoverability_labeled": { "type": "boolean" },
        "freshness_state_visible": { "type": "boolean" },
        "superseded_state_marked": { "type": "boolean" },
        "reopen_visible_on_demand": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_currency", "proof_ref"],
      "properties": {
        "proof_currency": { "$ref": "#/$defs/proof_currency" },
        "proof_ref": { "$ref": "#/$defs/opaque_ref_nullable" }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "rendered_claim", "scope_visible", "read_only", "source_sheet_ref"],
      "properties": {
        "surface": { "$ref": "#/$defs/consumer_surface" },
        "rendered_claim": { "$ref": "#/$defs/sheet_claim" },
        "scope_visible": { "type": "boolean" },
        "read_only": { "type": "boolean" },
        "source_sheet_ref": { "$ref": "#/$defs/opaque_ref" }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheet_id",
        "flow",
        "lane",
        "origin",
        "label_summary",
        "claim_posture",
        "declared_freshness_state",
        "declared_reopen_target",
        "lineage",
        "sheet",
        "integrity",
        "verification",
        "renderings"
      ],
      "properties": {
        "sheet_id": { "$ref": "#/$defs/stable_id" },
        "flow": { "$ref": "#/$defs/mutation_flow" },
        "lane": { "$ref": "#/$defs/flow_lane" },
        "origin": { "$ref": "#/$defs/sheet_origin" },
        "label_summary": { "$ref": "#/$defs/label" },
        "claim_posture": { "$ref": "#/$defs/claim_posture" },
        "declared_freshness_state": { "$ref": "#/$defs/freshness_state" },
        "declared_reopen_target": { "$ref": "#/$defs/reopen_target" },
        "lineage": { "$ref": "#/$defs/lineage" },
        "sheet": { "$ref": "#/$defs/staged_review_sheet" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "verification": { "$ref": "#/$defs/verification" },
        "renderings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rendering" }
        }
      }
    }
  }
}
