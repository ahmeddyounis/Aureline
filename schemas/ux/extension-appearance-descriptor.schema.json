{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ux/extension-appearance-descriptor.schema.json",
  "title": "Aureline extension appearance-inheritance descriptors",
  "description": "Governed, inspectable runtime descriptors that disclose whether an extension-backed or embedded surface inherits Aureline's theme, focus, contrast, density, and reduced-motion semantics. The audit derives a visible inheritance badge, blocks unbacked host-parity claims, and emits closed-vocabulary defects. This is the product-facing runtime twin of the design-side audited record frozen in schemas/design/extension_ui_appearance_descriptor.schema.json; it reuses the same inheritance-axis (theme, focus, contrast, density, reduced_motion) and parity-claim (no_parity_claim, claims_host_parity, partial_claim_with_gaps, denied_claim) vocabulary rather than minting parallel values. Records carry no raw theme files, token values, screenshots, or user content.",
  "anyOf": [
    { "$ref": "#/$defs/audit" },
    { "$ref": "#/$defs/descriptor" },
    { "$ref": "#/$defs/support_export" },
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/input_corpus" },
    { "$ref": "#/$defs/descriptor_corpus" }
  ],
  "$defs": {
    "axis_class": {
      "type": "string",
      "enum": ["theme", "focus", "contrast", "density", "reduced_motion"]
    },
    "posture_class": {
      "type": "string",
      "enum": ["inherits", "partial", "does_not_inherit", "not_disclosed"]
    },
    "surface_kind_class": {
      "type": "string",
      "enum": [
        "extension_detail_pane",
        "embedded_webview",
        "provider_panel",
        "preview_pane",
        "docs_help_pane",
        "diagnostics_pane"
      ]
    },
    "lifecycle_class": {
      "type": "string",
      "enum": [
        "preview",
        "beta",
        "stable",
        "deprecated",
        "removed",
        "limited",
        "revoked"
      ]
    },
    "badge_class": {
      "type": "string",
      "enum": [
        "full_inheritance",
        "partial_inheritance",
        "does_not_inherit",
        "undisclosed"
      ]
    },
    "parity_claim_state_class": {
      "type": "string",
      "enum": [
        "no_parity_claim",
        "claims_host_parity",
        "partial_claim_with_gaps",
        "denied_claim"
      ]
    },
    "defect_kind_class": {
      "type": "string",
      "enum": [
        "undisclosed_axis",
        "overclaimed_parity",
        "hidden_inheritance_gap",
        "host_badge_chrome_hidden",
        "support_export_parity_drift",
        "raw_appearance_material_exported"
      ]
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": {
      "type": "string",
      "const": "extensions:m5_appearance_descriptor:v1"
    },
    "appearance_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "summary"],
      "properties": {
        "axis": { "$ref": "#/$defs/axis_class" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "axis_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "posture", "user_visible_disclosure_required"],
      "properties": {
        "axis": { "$ref": "#/$defs/axis_class" },
        "posture": { "$ref": "#/$defs/posture_class" },
        "user_visible_disclosure_required": { "type": "boolean" }
      }
    },
    "inheritance_badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_class",
        "badge_label",
        "caveat_line",
        "implies_host_parity"
      ],
      "properties": {
        "badge_class": { "$ref": "#/$defs/badge_class" },
        "badge_label": { "type": "string", "minLength": 1 },
        "caveat_line": { "type": "string", "minLength": 1 },
        "implies_host_parity": { "type": "boolean" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_id",
        "host_id",
        "package_id",
        "package_name",
        "publisher_label",
        "surface_kind",
        "surface_label",
        "lifecycle_class",
        "inherit_theme",
        "inherit_focus",
        "inherit_contrast",
        "inherit_density",
        "inherit_reduced_motion",
        "claims_first_party_parity",
        "host_rendered_appearance_badge",
        "caveat_summary",
        "generated_at"
      ],
      "properties": {
        "descriptor_id": { "type": "string", "minLength": 1 },
        "host_id": { "type": "string", "minLength": 1 },
        "package_id": { "type": "string", "minLength": 1 },
        "package_name": { "type": "string", "minLength": 1 },
        "publisher_label": { "type": "string", "minLength": 1 },
        "surface_kind": { "$ref": "#/$defs/surface_kind_class" },
        "surface_label": { "type": "string", "minLength": 1 },
        "lifecycle_class": { "$ref": "#/$defs/lifecycle_class" },
        "inherit_theme": { "$ref": "#/$defs/posture_class" },
        "inherit_focus": { "$ref": "#/$defs/posture_class" },
        "inherit_contrast": { "$ref": "#/$defs/posture_class" },
        "inherit_density": { "$ref": "#/$defs/posture_class" },
        "inherit_reduced_motion": { "$ref": "#/$defs/posture_class" },
        "known_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/appearance_gap" }
        },
        "accessibility_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "claims_first_party_parity": { "type": "boolean" },
        "host_rendered_appearance_badge": { "type": "boolean" },
        "caveat_summary": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 }
      }
    },
    "input_corpus": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor_id",
        "host_id",
        "package_id",
        "package_name",
        "publisher_label",
        "surface_kind",
        "surface_label",
        "lifecycle_class",
        "axes",
        "known_gaps",
        "accessibility_evidence_refs",
        "badge",
        "claims_first_party_parity",
        "parity_claim_state",
        "parity_reason",
        "host_rendered_appearance_badge",
        "rendered_on_surfaces",
        "caveat_summary",
        "defect_kind_tokens",
        "generated_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "extension_appearance_descriptor_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor_id": { "type": "string", "minLength": 1 },
        "host_id": { "type": "string", "minLength": 1 },
        "package_id": { "type": "string", "minLength": 1 },
        "package_name": { "type": "string", "minLength": 1 },
        "publisher_label": { "type": "string", "minLength": 1 },
        "surface_kind": { "$ref": "#/$defs/surface_kind_class" },
        "surface_label": { "type": "string", "minLength": 1 },
        "lifecycle_class": { "$ref": "#/$defs/lifecycle_class" },
        "axes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/axis_posture" }
        },
        "known_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/appearance_gap" }
        },
        "accessibility_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "badge": { "$ref": "#/$defs/inheritance_badge" },
        "claims_first_party_parity": { "type": "boolean" },
        "parity_claim_state": { "$ref": "#/$defs/parity_claim_state_class" },
        "parity_reason": { "type": "string", "minLength": 1 },
        "host_rendered_appearance_badge": { "type": "boolean" },
        "rendered_on_surfaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "caveat_summary": { "type": "string", "minLength": 1 },
        "defect_kind_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/defect_kind_class" }
        },
        "generated_at": { "type": "string", "minLength": 1 }
      }
    },
    "descriptor_corpus": {
      "type": "array",
      "items": { "$ref": "#/$defs/descriptor" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_count",
        "full_inheritance_count",
        "partial_inheritance_count",
        "does_not_inherit_count",
        "undisclosed_count",
        "host_parity_claim_count",
        "partial_parity_claim_count",
        "denied_parity_claim_count",
        "defect_count"
      ],
      "properties": {
        "descriptor_count": { "type": "integer", "minimum": 0 },
        "full_inheritance_count": { "type": "integer", "minimum": 0 },
        "partial_inheritance_count": { "type": "integer", "minimum": 0 },
        "does_not_inherit_count": { "type": "integer", "minimum": 0 },
        "undisclosed_count": { "type": "integer", "minimum": 0 },
        "host_parity_claim_count": { "type": "integer", "minimum": 0 },
        "partial_parity_claim_count": { "type": "integer", "minimum": 0 },
        "denied_parity_claim_count": { "type": "integer", "minimum": 0 },
        "defect_count": { "type": "integer", "minimum": 0 }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "defect_id",
        "defect_kind",
        "descriptor_ref",
        "field",
        "message",
        "visible_in_product"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "extension_appearance_descriptor_defect_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "defect_id": { "type": "string", "minLength": 1 },
        "defect_kind": { "$ref": "#/$defs/defect_kind_class" },
        "descriptor_ref": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "visible_in_product": { "type": "boolean" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "audit_id",
        "generated_at",
        "schema_ref",
        "design_contract_ref",
        "docs_ref",
        "report_ref",
        "rendered_surface_tokens",
        "summary",
        "descriptors",
        "defects"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "extension_appearance_audit_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "audit_id": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "schema_ref": { "type": "string", "minLength": 1 },
        "design_contract_ref": { "type": "string", "minLength": 1 },
        "docs_ref": { "type": "string", "minLength": 1 },
        "report_ref": { "type": "string", "minLength": 1 },
        "rendered_surface_tokens": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "summary": { "$ref": "#/$defs/summary" },
        "descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "defects": {
          "type": "array",
          "items": { "$ref": "#/$defs/defect" }
        }
      }
    },
    "support_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor_ref",
        "host_id",
        "package_id",
        "surface_label",
        "lifecycle_class",
        "posture_by_axis",
        "badge_token",
        "parity_claim_token",
        "host_rendered_appearance_badge",
        "defect_kind_tokens"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "extension_appearance_support_row_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor_ref": { "type": "string", "minLength": 1 },
        "host_id": { "type": "string", "minLength": 1 },
        "package_id": { "type": "string", "minLength": 1 },
        "surface_label": { "type": "string", "minLength": 1 },
        "lifecycle_class": { "$ref": "#/$defs/lifecycle_class" },
        "posture_by_axis": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/posture_class" }
        },
        "badge_token": { "$ref": "#/$defs/badge_class" },
        "parity_claim_token": { "$ref": "#/$defs/parity_claim_state_class" },
        "host_rendered_appearance_badge": { "type": "boolean" },
        "defect_kind_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/defect_kind_class" }
        }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "export_id",
        "generated_at",
        "audit_ref",
        "docs_ref",
        "schema_ref",
        "summary",
        "support_rows",
        "case_ids",
        "defect_counts_by_kind",
        "raw_appearance_material_excluded"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "extension_appearance_support_export_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "export_id": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "audit_ref": { "type": "string", "minLength": 1 },
        "docs_ref": { "type": "string", "minLength": 1 },
        "schema_ref": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/summary" },
        "support_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/support_row" }
        },
        "case_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "defect_counts_by_kind": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "raw_appearance_material_excluded": { "type": "boolean" }
      }
    }
  }
}
