{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ux/m5-theme-package-manifest.schema.json",
  "title": "Aureline M5 theme-package manifest audit",
  "description": "Boundary schema for the M5 theme-package manifest audit emitted by the aureline-shell theme_packages module. The audit carries the versioned theme-package manifests the product already claims (a built-in default pack, a built-in high-contrast pack, and signed extension-contributed packs) and binds every registered M5 depth surface (notebook, result grid, profiler timeline, preview/browser pane, docs/help pane, companion surface, extension-backed surface) to its active theme package, the supported appearance modes it honours, the inheritance posture and disclosed inheritance gaps, the package provenance, and the stale-or-disabled evidence state it discloses. The manifest objects are a re-export projection of the canonical theme_package_manifest_record frozen in schemas/ux/theme_package_manifest.schema.json; this lane mints no parallel theme, density, motion, provenance, signature, or compatibility vocabulary. Acceptance: every surface MUST resolve its active_package_id to a registered manifest, MUST honour only modes the package supports, MUST inherit or disclose every inheritance axis the package expects, MUST disclose provenance and any stale-or-disabled package state, and MUST ride the shared appearance-session model; first-party manifests MUST carry the semantic, component, and syntax token sets and cover the dark, light, and reduced-motion modes the product already claims. Raw token tables, raw asset bytes, raw rendered screenshots, raw URLs, raw absolute paths, and raw signing keys never cross this boundary; this schema carries opaque ids, typed vocabulary, small counts, and short privacy-safe labels only. This schema is the only boundary contract for the JSON fixtures checked in under fixtures/ux/m5/theme-package-modes/ and the support-export wrapper consumed by the CI gate at tools/ci/m5/theme_package_manifest_check.py.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/theme_package_manifest_report_record" },
    { "$ref": "#/$defs/theme_package_manifest_support_export_record" }
  ],
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Integer schema version for the M5 theme-package contract. Bumped only on breaking payload changes."
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "shell:m5_theme_packages:v1",
      "description": "Stable shared contract ref every record carries."
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque, stable id safe to log and safe in support bundles. Raw URLs, raw paths, raw signing keys, and raw asset bytes never appear here."
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Short privacy-safe label or note text."
    },
    "theme_mode_class": {
      "type": "string",
      "enum": ["dark_reference", "light_parity", "high_contrast_dark", "high_contrast_light"],
      "description": "Re-exported from schemas/ux/theme_package_manifest.schema.json theme_class without modification."
    },
    "density_class": {
      "type": "string",
      "enum": ["compact", "standard", "comfortable"],
      "description": "Re-exported from schemas/ux/theme_package_manifest.schema.json density_class without modification."
    },
    "motion_posture_class": {
      "type": "string",
      "enum": [
        "motion_standard",
        "motion_reduced",
        "motion_low_motion",
        "motion_power_saver",
        "motion_critical_hot_path"
      ],
      "description": "Re-exported from schemas/ux/theme_package_manifest.schema.json accessibility_posture_class without modification."
    },
    "provenance_class": {
      "type": "string",
      "enum": [
        "built_in_with_product",
        "extension_contributed",
        "community_supplied",
        "imported_translated",
        "air_gapped_offline"
      ],
      "description": "Re-exported from schemas/ux/theme_package_manifest.schema.json theme_package_distribution_class without modification."
    },
    "signature_state": {
      "type": "string",
      "enum": [
        "signed_verified",
        "signed_unverified",
        "unsigned_explicit_acceptance",
        "signature_failed_blocked",
        "not_applicable_built_in"
      ],
      "description": "Re-exported from schemas/ux/theme_package_manifest.schema.json theme_package_signature_state without modification."
    },
    "compatibility_state": {
      "type": "string",
      "enum": [
        "exact_build_match",
        "compatible_minor_drift",
        "incompatible_drift_detected",
        "pre_release_unverified",
        "unknown_target_build"
      ],
      "description": "Re-exported from the canonical version_match_state vocabulary without modification."
    },
    "token_set_kind": {
      "type": "string",
      "enum": ["semantic", "component", "syntax"]
    },
    "inheritance_axis": {
      "type": "string",
      "enum": ["theme", "contrast", "density", "focus", "reduced_motion"]
    },
    "inheritance_posture": {
      "type": "string",
      "enum": [
        "fully_inherited",
        "partial_inheritance_disclosed",
        "does_not_inherit_disclosed"
      ]
    },
    "package_evidence_state": {
      "type": "string",
      "enum": ["current", "stale_evidence", "disabled_package"]
    },
    "semantic_salience": {
      "type": "string",
      "enum": [
        "decorative_only",
        "informational",
        "lifecycle_bearing",
        "trust_bearing",
        "severity_bearing"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "notebook",
        "result_grid",
        "profiler_timeline",
        "preview_browser_pane",
        "docs_help_pane",
        "companion_surface",
        "extension_backed_surface"
      ]
    },
    "contrast_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrast_evidence_ref",
        "meets_aa_normal_text",
        "meets_aaa_normal_text",
        "forced_colors_preserved"
      ],
      "properties": {
        "contrast_evidence_ref": { "$ref": "#/$defs/opaque_id" },
        "meets_aa_normal_text": { "type": "boolean" },
        "meets_aaa_normal_text": { "type": "boolean" },
        "forced_colors_preserved": { "type": "boolean" }
      }
    },
    "token_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "token_set_ref", "token_count"],
      "properties": {
        "kind": { "$ref": "#/$defs/token_set_kind" },
        "token_set_ref": { "$ref": "#/$defs/opaque_id" },
        "token_count": { "type": "integer", "minimum": 0 }
      }
    },
    "theme_package_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "canonical_manifest_schema_ref",
        "package_id",
        "package_version_label",
        "package_revision_ref",
        "provenance_class",
        "signature_state",
        "supported_theme_modes",
        "supported_density_classes",
        "supported_motion_postures",
        "token_sets",
        "contrast_metadata",
        "min_design_token_schema_version",
        "max_design_token_schema_version",
        "compatibility_state",
        "inheritance_expectations",
        "import_mapping_report_ref",
        "provenance_note",
        "minted_at"
      ],
      "properties": {
        "record_kind": { "const": "shell_m5_theme_package_manifest_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "canonical_manifest_schema_ref": { "type": "string", "minLength": 1 },
        "package_id": { "$ref": "#/$defs/opaque_id" },
        "package_version_label": { "$ref": "#/$defs/short_text" },
        "package_revision_ref": { "$ref": "#/$defs/opaque_id" },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "supported_theme_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/theme_mode_class" }
        },
        "supported_density_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/density_class" }
        },
        "supported_motion_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/motion_posture_class" }
        },
        "token_sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_set" }
        },
        "contrast_metadata": { "$ref": "#/$defs/contrast_metadata" },
        "min_design_token_schema_version": { "type": "integer", "minimum": 1 },
        "max_design_token_schema_version": { "type": "integer", "minimum": 1 },
        "compatibility_state": { "$ref": "#/$defs/compatibility_state" },
        "inheritance_expectations": {
          "type": "array",
          "items": { "$ref": "#/$defs/inheritance_axis" },
          "uniqueItems": true
        },
        "import_mapping_report_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/opaque_id" }]
        },
        "provenance_note": { "$ref": "#/$defs/short_text" },
        "minted_at": { "type": "string", "format": "date-time" }
      }
    },
    "surface_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_family",
        "descriptor_revision_ref",
        "primary_label_ref",
        "appearance_anchor_ref",
        "accessibility_note",
        "semantic_salience",
        "marketed_on_desktop_rows",
        "registered_on_appearance_session"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/opaque_id" },
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "descriptor_revision_ref": { "$ref": "#/$defs/opaque_id" },
        "primary_label_ref": { "$ref": "#/$defs/opaque_id" },
        "appearance_anchor_ref": { "$ref": "#/$defs/opaque_id" },
        "accessibility_note": { "$ref": "#/$defs/short_text" },
        "semantic_salience": { "$ref": "#/$defs/semantic_salience" },
        "marketed_on_desktop_rows": { "type": "boolean" },
        "registered_on_appearance_session": { "type": "boolean" }
      }
    },
    "blocking_finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "active_package_unknown",
            "unsupported_mode_claimed",
            "inheritance_gap_hidden",
            "provenance_not_disclosed",
            "stale_evidence_on_marketed_surface",
            "disabled_package_rendering_undisclosed",
            "surface_not_on_appearance_session",
            "descriptor_missing_appearance_anchor",
            "missing_accessibility_note",
            "inheritance_posture_mismatch",
            "manifest_token_set_incomplete",
            "manifest_missing_required_mode",
            "manifest_signature_failed_still_registered"
          ]
        },
        "surface_id": { "type": "string" },
        "package_id": { "type": "string" },
        "mode": { "type": "string" },
        "axis": { "type": "string" },
        "token_set_kind": { "type": "string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor",
        "active_package_id",
        "honored_theme_modes",
        "honored_density_classes",
        "honored_motion_postures",
        "inheritance_posture",
        "inherited_axes",
        "disclosed_inheritance_gaps",
        "provenance_disclosed",
        "evidence_state",
        "evidence_ref",
        "high_salience",
        "marketed",
        "blocking_findings"
      ],
      "properties": {
        "record_kind": { "const": "shell_m5_theme_package_surface_binding_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor": { "$ref": "#/$defs/surface_descriptor" },
        "active_package_id": { "$ref": "#/$defs/opaque_id" },
        "honored_theme_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/theme_mode_class" }
        },
        "honored_density_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/density_class" }
        },
        "honored_motion_postures": {
          "type": "array",
          "items": { "$ref": "#/$defs/motion_posture_class" }
        },
        "inheritance_posture": { "$ref": "#/$defs/inheritance_posture" },
        "inherited_axes": {
          "type": "array",
          "items": { "$ref": "#/$defs/inheritance_axis" },
          "uniqueItems": true
        },
        "disclosed_inheritance_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/inheritance_axis" },
          "uniqueItems": true
        },
        "provenance_disclosed": { "type": "boolean" },
        "evidence_state": { "$ref": "#/$defs/package_evidence_state" },
        "evidence_ref": { "$ref": "#/$defs/opaque_id" },
        "high_salience": { "type": "boolean" },
        "marketed": { "type": "boolean" },
        "blocking_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocking_finding" }
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "provenance_class",
        "surfaces_using",
        "marketed_surfaces_using"
      ],
      "properties": {
        "package_id": { "$ref": "#/$defs/opaque_id" },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "surfaces_using": { "type": "integer", "minimum": 0 },
        "marketed_surfaces_using": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_version_label",
        "provenance_class",
        "signature_state",
        "compatibility_state",
        "disclosed_evidence_state"
      ],
      "properties": {
        "package_id": { "$ref": "#/$defs/opaque_id" },
        "package_version_label": { "$ref": "#/$defs/short_text" },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "compatibility_state": { "$ref": "#/$defs/compatibility_state" },
        "disclosed_evidence_state": { "$ref": "#/$defs/package_evidence_state" }
      }
    },
    "narrowable_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "package_id", "reason"],
      "properties": {
        "surface_id": { "$ref": "#/$defs/opaque_id" },
        "package_id": { "$ref": "#/$defs/opaque_id" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "findings_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_package_unknown",
        "unsupported_mode_claimed",
        "inheritance_gap_hidden",
        "provenance_not_disclosed",
        "stale_evidence_on_marketed_surface",
        "disabled_package_rendering_undisclosed",
        "surface_not_on_appearance_session",
        "descriptor_missing_appearance_anchor",
        "missing_accessibility_note",
        "inheritance_posture_mismatch",
        "manifest_token_set_incomplete",
        "manifest_missing_required_mode",
        "manifest_signature_failed_still_registered",
        "total_blocking_findings"
      ],
      "properties": {
        "active_package_unknown": { "type": "integer", "minimum": 0 },
        "unsupported_mode_claimed": { "type": "integer", "minimum": 0 },
        "inheritance_gap_hidden": { "type": "integer", "minimum": 0 },
        "provenance_not_disclosed": { "type": "integer", "minimum": 0 },
        "stale_evidence_on_marketed_surface": { "type": "integer", "minimum": 0 },
        "disabled_package_rendering_undisclosed": { "type": "integer", "minimum": 0 },
        "surface_not_on_appearance_session": { "type": "integer", "minimum": 0 },
        "descriptor_missing_appearance_anchor": { "type": "integer", "minimum": 0 },
        "missing_accessibility_note": { "type": "integer", "minimum": 0 },
        "inheritance_posture_mismatch": { "type": "integer", "minimum": 0 },
        "manifest_token_set_incomplete": { "type": "integer", "minimum": 0 },
        "manifest_missing_required_mode": { "type": "integer", "minimum": 0 },
        "manifest_signature_failed_still_registered": { "type": "integer", "minimum": 0 },
        "total_blocking_findings": { "type": "integer", "minimum": 0 }
      }
    },
    "theme_package_manifest_report_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "report_id",
        "source_schema_ref",
        "canonical_manifest_schema_ref",
        "manifests",
        "surfaces",
        "package_coverage",
        "provenance_index",
        "findings_summary",
        "manifest_count",
        "registered_surface_count",
        "high_salience_surface_count",
        "marketed_surface_count",
        "narrowable_marketed_surfaces",
        "report_clean",
        "published_report_ref",
        "published_doc_ref",
        "docs_help_refs",
        "support_export_refs",
        "generated_at"
      ],
      "properties": {
        "record_kind": { "const": "shell_m5_theme_package_manifest_report_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "report_id": { "$ref": "#/$defs/opaque_id" },
        "source_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_manifest_schema_ref": { "type": "string", "minLength": 1 },
        "manifests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/theme_package_manifest" }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_binding" }
        },
        "package_coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_summary" }
        },
        "provenance_index": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance_entry" }
        },
        "findings_summary": { "$ref": "#/$defs/findings_summary" },
        "manifest_count": { "type": "integer", "minimum": 0 },
        "registered_surface_count": { "type": "integer", "minimum": 0 },
        "high_salience_surface_count": { "type": "integer", "minimum": 0 },
        "marketed_surface_count": { "type": "integer", "minimum": 0 },
        "narrowable_marketed_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowable_surface" }
        },
        "report_clean": { "type": "boolean" },
        "published_report_ref": { "type": "string", "minLength": 1 },
        "published_doc_ref": { "type": "string", "minLength": 1 },
        "docs_help_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "support_export_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "theme_package_manifest_support_export_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "support_export_id",
        "report",
        "case_ids"
      ],
      "properties": {
        "record_kind": { "const": "shell_m5_theme_package_manifest_support_export_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "support_export_id": { "$ref": "#/$defs/opaque_id" },
        "report": { "$ref": "#/$defs/theme_package_manifest_report_record" },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opaque_id" }
        }
      }
    }
  }
}
