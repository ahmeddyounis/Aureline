{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ux/finish-the-migration-center-diff-rollback-and-unsupported.schema.json",
  "title": "Aureline migration-flow disclosure record",
  "description": "Boundary schema for migration_flow_disclosure_record. Preview records bind a before/after diff to one rollback requirement, never to a fabricated checkpoint. Checkpoint, restore, undo, compare, apply-session, and Stable claims require later execution evidence. A seeded dry-run therefore remains below Stable with rollback_evidence_incomplete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "notice",
    "shared_contract_ref",
    "record_id",
    "as_of",
    "migration_review_ref",
    "source_ecosystem",
    "source_ecosystem_label",
    "header",
    "title",
    "summary",
    "diff",
    "rollback",
    "taxonomy",
    "claim_ceiling",
    "stable_qualification",
    "recovery_routes",
    "surfaces",
    "routes",
    "accessibility",
    "available_without_account",
    "available_without_managed_services",
    "honesty_marker_present",
    "upstream",
    "diagnostics_export_ref",
    "support_export_ref",
    "evidence_refs",
    "narrative_refs"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "migration_flow_disclosure_record" },
    "schema_version": { "type": "integer", "const": 2 },
    "notice": { "$ref": "#/$defs/reviewable_sentence" },
    "shared_contract_ref": {
      "type": "string",
      "const": "shell:migration_flow_disclosure_stable:v2"
    },
    "record_id": { "$ref": "#/$defs/stable_token" },
    "as_of": { "$ref": "#/$defs/utc_date_time" },
    "migration_review_ref": { "$ref": "#/$defs/migration_review_ref" },
    "source_ecosystem": { "$ref": "#/$defs/source_ecosystem" },
    "source_ecosystem_label": { "$ref": "#/$defs/non_empty_string" },
    "header": { "$ref": "#/$defs/migration_flow_header" },
    "title": { "$ref": "#/$defs/reviewable_sentence" },
    "summary": { "$ref": "#/$defs/reviewable_sentence" },
    "diff": { "$ref": "#/$defs/diff_disclosure" },
    "rollback": { "$ref": "#/$defs/rollback_disclosure" },
    "taxonomy": { "$ref": "#/$defs/gap_taxonomy" },
    "claim_ceiling": { "$ref": "#/$defs/claim_ceiling" },
    "stable_qualification": { "$ref": "#/$defs/stable_qualification" },
    "recovery_routes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/recovery_route" }
    },
    "surfaces": { "$ref": "#/$defs/surface_parity" },
    "routes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entry_route" }
    },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "available_without_account": { "type": "boolean", "const": true },
    "available_without_managed_services": { "type": "boolean", "const": true },
    "honesty_marker_present": { "type": "boolean" },
    "upstream": { "$ref": "#/$defs/upstream_refs" },
    "diagnostics_export_ref": { "$ref": "#/$defs/canonical_ref" },
    "support_export_ref": { "$ref": "#/$defs/canonical_ref" },
    "evidence_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/canonical_ref" } },
    "narrative_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/canonical_ref" } }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!.*(?:^|\\s|[=/\\\\({,:;\\[])[Ff][Ii][Ll][Ee]:)(?!.*(?:^|\\s|[=({,:;\\[])(?:[/\\\\~][^\\s]|[A-Za-z]:[/\\\\]))(?!.*(?:\\.\\.[/\\\\]|://))\\S(?:[^\\u0000-\\u001F\\u007F]*\\S)?$" },
    "reviewable_sentence": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!.*(?:^|\\s|[=/\\\\({,:;\\[])[Ff][Ii][Ll][Ee]:)(?!.*(?:^|\\s|[=({,:;\\[])(?:[/\\\\~][^\\s]|[A-Za-z]:[/\\\\]))(?!.*(?:\\.\\.[/\\\\]|://))\\S(?:[^\\u0000-\\u001F\\u007F]*\\S)?$" },
    "stable_token": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" },
    "source_path": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!/|[A-Za-z]:/)(?!.*(?:\\.\\./|//))(?!.*(?:^|[=/({,:;\\[])[Ff][Ii][Ll][Ee]:)[A-Za-z0-9:._/#-]+$" },
    "utc_date_time": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "canonical_ref": {
      "type": "string",
      "description": "Opaque durable-object ref of the form aureline://<class>/<id>; <class> is not a generic landing page.",
      "pattern": "^aureline://(?!(home|dashboard|landing|index|overview|start|root)/)[A-Za-z0-9_-]+/[A-Za-z0-9._:-]+(?:/[A-Za-z0-9._:-]+)*$",
      "maxLength": 200
    },
    "migration_review_ref": {
      "type": "string",
      "pattern": "^migration-review:[A-Za-z0-9._:-]+$",
      "maxLength": 200
    },
    "rollback_requirement_ref": {
      "type": "string",
      "description": "Dry-run checkpoint requirement. This is not a checkpoint handle.",
      "pattern": "^rollback-requirement:[A-Za-z0-9._:-]+$",
      "maxLength": 200
    },
    "migration_gap_id": {
      "type": "string",
      "pattern": "^migration-flow-gap:[A-Za-z0-9._:-]+$",
      "maxLength": 200
    },
    "source_ecosystem": {
      "type": "string",
      "enum": ["vs_code_code_oss", "jet_brains_family", "vim_neovim", "emacs"]
    },
    "classification": {
      "type": "string",
      "enum": ["exact", "translated", "partial", "shimmed", "unsupported"]
    },
    "gap_classification": {
      "type": "string",
      "enum": ["shimmed", "unsupported"]
    },
    "import_domain": {
      "type": "string",
      "enum": [
        "settings",
        "shortcuts",
        "keymaps",
        "themes_and_visuals",
        "snippets_and_templates",
        "tasks_and_run_configs",
        "launch_debug",
        "extensions_and_providers",
        "workspace_profile"
      ]
    },
    "claim_class": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "not_claimed"]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "diff_not_reviewed_before_apply",
        "rollback_evidence_incomplete",
        "unsupported_gaps_hidden_before_apply",
        "taxonomy_incomplete"
      ]
    },
    "recovery_action_role": {
      "type": "string",
      "enum": ["primary", "recovery", "secondary"]
    },
    "route_surface": {
      "type": "string",
      "enum": ["migration_center", "settings_import_history", "command_palette", "menu_command"]
    },
    "layout_mode": {
      "type": "string",
      "enum": ["normal", "high_contrast", "zoomed"]
    },
    "diff_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_preview_ref",
        "reviewed_before_apply",
        "row_count",
        "every_row_has_before_after",
        "every_row_uses_one_requirement"
      ],
      "properties": {
        "diff_preview_ref": { "$ref": "#/$defs/canonical_ref" },
        "reviewed_before_apply": { "type": "boolean" },
        "row_count": { "type": "integer", "minimum": 0 },
        "every_row_has_before_after": { "type": "boolean" },
        "every_row_uses_one_requirement": { "type": "boolean" }
      }
    },
    "rollback_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback_requirement_ref",
        "created_before_apply",
        "protects_every_domain",
        "verified_for_this_flow",
        "undo_available",
        "compare_available"
      ],
      "properties": {
        "rollback_requirement_ref": { "$ref": "#/$defs/rollback_requirement_ref" },
        "checkpoint_ref": { "$ref": "#/$defs/canonical_ref" },
        "restore_record_ref": { "$ref": "#/$defs/canonical_ref" },
        "created_before_apply": { "type": "boolean" },
        "protects_every_domain": { "type": "boolean" },
        "verified_for_this_flow": { "type": "boolean" },
        "undo_available": { "type": "boolean" },
        "undo_action_ref": { "$ref": "#/$defs/canonical_ref" },
        "compare_available": { "type": "boolean" },
        "compare_action_ref": { "$ref": "#/$defs/canonical_ref" }
      },
      "allOf": [
        {
          "if": { "not": { "required": ["checkpoint_ref"] } },
          "then": {
            "properties": {
              "created_before_apply": { "const": false },
              "protects_every_domain": { "const": false },
              "verified_for_this_flow": { "const": false },
              "undo_available": { "const": false },
              "compare_available": { "const": false }
            },
            "not": {
              "anyOf": [
                { "required": ["restore_record_ref"] },
                { "required": ["undo_action_ref"] },
                { "required": ["compare_action_ref"] }
              ]
            }
          },
          "else": { "required": ["restore_record_ref"] }
        },
        {
          "if": { "properties": { "undo_available": { "const": true } } },
          "then": { "required": ["checkpoint_ref", "restore_record_ref", "undo_action_ref"] },
          "else": { "not": { "required": ["undo_action_ref"] } }
        },
        {
          "if": { "properties": { "compare_available": { "const": true } } },
          "then": { "required": ["checkpoint_ref", "restore_record_ref", "compare_action_ref"] },
          "else": { "not": { "required": ["compare_action_ref"] } }
        }
      ]
    },
    "unsupported_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "domain",
        "classification",
        "source_label",
        "gap_summary",
        "visible_before_apply",
        "retained_after_apply",
        "docs_help_refs",
        "support_export_refs"
      ],
      "properties": {
        "gap_id": { "$ref": "#/$defs/migration_gap_id" },
        "domain": { "$ref": "#/$defs/import_domain" },
        "classification": { "$ref": "#/$defs/gap_classification" },
        "source_label": { "$ref": "#/$defs/non_empty_string" },
        "gap_summary": { "$ref": "#/$defs/reviewable_sentence" },
        "visible_before_apply": { "type": "boolean", "const": true },
        "retained_after_apply": { "type": "boolean" },
        "docs_help_refs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/source_path" } },
        "support_export_refs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/source_path" } }
      }
    },
    "gap_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact",
        "translated",
        "partial",
        "shimmed",
        "unsupported",
        "classifications_present",
        "unsupported_gaps_visible_before_apply",
        "gaps"
      ],
      "properties": {
        "exact": { "type": "integer", "minimum": 0 },
        "translated": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "shimmed": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "classifications_present": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/classification" }
        },
        "unsupported_gaps_visible_before_apply": { "type": "boolean", "const": true },
        "gaps": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/unsupported_gap" } }
      }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asserts_diff_reviewed_before_apply",
        "asserts_rollback_available",
        "asserts_no_unsupported_gaps",
        "asserts_full_fidelity_import"
      ],
      "properties": {
        "asserts_diff_reviewed_before_apply": { "type": "boolean" },
        "asserts_rollback_available": { "type": "boolean" },
        "asserts_no_unsupported_gaps": { "type": "boolean" },
        "asserts_full_fidelity_import": { "type": "boolean" }
      }
    },
    "stable_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_class", "qualifies_stable", "narrowing_reasons"],
      "properties": {
        "claim_class": { "$ref": "#/$defs/claim_class" },
        "qualifies_stable": { "type": "boolean" },
        "narrowing_reasons": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/narrowing_reason" }
        }
      }
    },
    "recovery_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "action_label", "action_role", "keyboard_reachable"],
      "properties": {
        "action_id": { "$ref": "#/$defs/stable_token" },
        "action_label": { "$ref": "#/$defs/non_empty_string" },
        "action_role": { "$ref": "#/$defs/recovery_action_role" },
        "keyboard_reachable": { "type": "boolean", "const": true }
      }
    },
    "entry_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "route_ref", "keyboard_reachable", "activates_same_flow"],
      "properties": {
        "surface": { "$ref": "#/$defs/route_surface" },
        "route_ref": { "$ref": "#/$defs/canonical_ref" },
        "keyboard_reachable": { "type": "boolean", "const": true },
        "activates_same_flow": { "type": "boolean", "const": true }
      }
    },
    "surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_center_row_id",
        "settings_import_history_row_id",
        "command_palette_command_id",
        "recovery_action_ids",
        "reopen_surfaces",
        "parity_holds"
      ],
      "properties": {
        "migration_center_row_id": { "$ref": "#/$defs/stable_token" },
        "settings_import_history_row_id": { "$ref": "#/$defs/stable_token" },
        "command_palette_command_id": { "$ref": "#/$defs/stable_token" },
        "recovery_action_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "reopen_surfaces": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "parity_holds": { "type": "boolean", "const": true }
      }
    },
    "layout_mode_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "row_narration_available", "recovery_affordances_reachable"],
      "properties": {
        "mode": { "$ref": "#/$defs/layout_mode" },
        "row_narration_available": { "type": "boolean", "const": true },
        "recovery_affordances_reachable": { "type": "boolean", "const": true }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus_order_index",
        "tab_stop_count",
        "row_narration",
        "action_labels",
        "layout_modes"
      ],
      "properties": {
        "focus_order_index": { "type": "integer", "minimum": 0 },
        "tab_stop_count": { "type": "integer", "minimum": 1 },
        "row_narration": { "$ref": "#/$defs/reviewable_sentence" },
        "action_labels": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty_string" } },
        "layout_modes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/layout_mode_disclosure" }
        }
      }
    },
    "migration_flow_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_review_ref",
        "source_tool_label",
        "source_version_label",
        "target_scope_ref",
        "target_scope_label",
        "writes_land_in",
        "checkpoint_requirement_notice",
        "rollback_requirement_ref",
        "restore_action_enabled",
        "compatibility_report_ref",
        "compatibility_report_action_ref",
        "support_export_ref",
        "issue_template_ref",
        "partial_apply_context_visible",
        "downgrade_context_visible",
        "restore_context_visible"
      ],
      "properties": {
        "migration_review_ref": { "$ref": "#/$defs/migration_review_ref" },
        "source_tool_label": { "$ref": "#/$defs/non_empty_string" },
        "source_version_label": { "$ref": "#/$defs/non_empty_string" },
        "target_scope_ref": { "$ref": "#/$defs/canonical_ref" },
        "target_scope_label": { "$ref": "#/$defs/non_empty_string" },
        "writes_land_in": { "$ref": "#/$defs/reviewable_sentence" },
        "checkpoint_requirement_notice": { "$ref": "#/$defs/reviewable_sentence" },
        "rollback_requirement_ref": { "$ref": "#/$defs/rollback_requirement_ref" },
        "checkpoint_ref": { "$ref": "#/$defs/canonical_ref" },
        "restore_record_ref": { "$ref": "#/$defs/canonical_ref" },
        "restore_action_ref": { "$ref": "#/$defs/canonical_ref" },
        "restore_action_enabled": { "type": "boolean" },
        "compatibility_report_ref": { "$ref": "#/$defs/canonical_ref" },
        "compatibility_report_action_ref": { "$ref": "#/$defs/canonical_ref" },
        "support_export_ref": { "$ref": "#/$defs/canonical_ref" },
        "issue_template_ref": { "$ref": "#/$defs/canonical_ref" },
        "partial_apply_context_visible": { "type": "boolean", "const": true },
        "downgrade_context_visible": { "type": "boolean", "const": true },
        "restore_context_visible": { "type": "boolean", "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "restore_action_enabled": { "const": true } } },
          "then": { "required": ["checkpoint_ref", "restore_record_ref", "restore_action_ref"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["checkpoint_ref"] },
                { "required": ["restore_record_ref"] },
                { "required": ["restore_action_ref"] }
              ]
            }
          }
        }
      ]
    },
    "upstream_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wizard_review_ref",
        "wizard_mapping_report_ref",
        "rollback_requirement_ref",
        "import_diff_preview_ref",
        "corpus_scoreboard_ref",
        "corpus_section_ref"
      ],
      "properties": {
        "wizard_review_ref": { "$ref": "#/$defs/migration_review_ref" },
        "wizard_mapping_report_ref": { "$ref": "#/$defs/non_empty_string" },
        "rollback_requirement_ref": { "$ref": "#/$defs/rollback_requirement_ref" },
        "import_diff_preview_ref": { "$ref": "#/$defs/non_empty_string" },
        "corpus_scoreboard_ref": { "$ref": "#/$defs/non_empty_string" },
        "corpus_section_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
