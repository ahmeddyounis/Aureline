{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ux/m5-theme-import-parity.schema.json",
  "title": "Aureline M5 theme-package, appearance-session, token-overlay, and import-parity matrix",
  "description": "Boundary schema for the frozen M5 appearance-object matrix and the theme-import-parity qualification audit. The report freezes one canonical object-model index — theme packages, appearance sessions, token overlays, imported-theme reports, and extension appearance descriptors each name their canonical schema and the vocabulary group they own — and then certifies, for every M5 surface that consumes those objects (shell chrome, docs/help panes, support/export, extension-hosted and embedded surfaces, and the marketplace/account/sync settings surface), that imported-theme mapping, token-overlay validation, theme-package compatibility, appearance-session integrity, and extension-surface inheritance stay honest. A surface may legitimately downgrade — stale evidence, an unsupported slot, partial inheritance, or a restart-or-reload-required change — but only when the downgrade is disclosed in product, export, and diagnostics; a hidden downgrade, a silently dropped overlay token, a hidden unresolved import mapping, a hidden inheritance gap, a full-fidelity parity claim with no report, a missing rollback path, or stale evidence on a marketed row is a blocker so release tooling can narrow the row. The schema mints no parallel theme_class, density_class, contrast_mode, accessibility_posture_class, mapping_state, overlay_validation_state, inheritance_state, parity_claim_state, import_outcome_state, rollback_path_class, source_ecosystem, or surface vocabulary; those values are re-exported by reference from schemas/design/token_export_manifest.schema.json, schemas/design/theme_support_row.schema.json, schemas/ux/theme_import_report.schema.json, and schemas/ux/appearance_checkpoint.schema.json. Raw token tables, raw asset bytes, raw screenshots, raw URLs, raw absolute paths, and raw user content never cross this boundary; records carry opaque refs, closed vocabulary, counts, and short privacy-safe labels only. This schema is the only boundary contract for the JSON fixtures checked in under fixtures/ux/m5/theme-package-interop/ and the support-export wrapper consumed by the CI gate at tools/ci/m5/theme_import_parity_check.py.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/m5_theme_import_parity_report_record" },
    { "$ref": "#/$defs/m5_theme_import_parity_support_export_record" }
  ],
  "$defs": {
    "m5_theme_import_parity_schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Integer schema version for the M5 theme-import-parity contract. Bumped only on breaking payload changes; additive optional fields and additive vocabulary do not bump it."
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "shell:m5_theme_import_parity:v1",
      "description": "Stable shared contract ref every record carries."
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "monotonic_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "object_family": {
      "type": "string",
      "enum": [
        "theme_package",
        "appearance_session",
        "token_overlay",
        "theme_import_report",
        "extension_appearance_descriptor"
      ],
      "description": "The canonical M5 appearance-object families this matrix freezes. Each family names exactly one canonical schema in the object_model_index."
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "shell_chrome",
        "editor_canvas",
        "terminal_canvas",
        "review_and_diff_canvas",
        "palette_and_search_canvas",
        "install_update_attach_canvas",
        "ai_apply_canvas",
        "collaboration_canvas",
        "provider_bearing_canvas",
        "docs_help_service_health_canvas",
        "support_export_canvas",
        "onboarding_surface",
        "notification_surface",
        "inspector_surface",
        "extension_hosted_surface",
        "embedded_webview_surface",
        "service_dashboard_surface",
        "docs_help_embedded_surface",
        "native_extension_panel",
        "terminal_decoration_surface",
        "marketplace_account_surface"
      ],
      "description": "Re-exported from schemas/design/theme_support_row.schema.json (surface_class) without modification."
    },
    "parity_row": {
      "type": "string",
      "enum": [
        "theme_package_compatibility",
        "appearance_session_integrity",
        "token_overlay_validation",
        "imported_theme_parity",
        "extension_surface_inheritance"
      ],
      "description": "The five import-parity rows every registered surface must report, one per canonical object family."
    },
    "parity_dimension": {
      "type": "string",
      "enum": [
        "theme_package",
        "appearance_session",
        "token_overlay",
        "import_report",
        "extension_descriptor"
      ],
      "description": "The object dimension a parity row certifies; must agree with the row's canonical dimension."
    },
    "qualification_status": {
      "type": "string",
      "enum": [
        "qualified",
        "explicitly_narrowed",
        "not_applicable",
        "platform_omitted",
        "declared_capture_gap",
        "hidden_downgrade",
        "missing_evidence"
      ],
      "description": "Status a surface reports for one parity row. Only `qualified` rows project disclosed downgrade truth and captured evidence; the narrowed/not-applicable statuses require a narrowing_reason; `hidden_downgrade` and `missing_evidence` are blockers."
    },
    "compatibility_state": {
      "type": "string",
      "enum": [
        "current",
        "stale_evidence",
        "unsupported_slot",
        "partial_inheritance",
        "restart_or_reload_required"
      ],
      "description": "The one frozen compatibility and downgrade vocabulary for M5 appearance objects: a current row, or a disclosed downgrade because evidence is stale, a slot/mode is unsupported, inheritance is partial, or the change needs a restart or reload. A non-current state is honest only when the matching downgrade_disclosed_* flags are true."
    },
    "mapping_state": {
      "type": "string",
      "enum": [
        "translated",
        "substituted_fallback",
        "unsupported",
        "unresolved",
        "blocked_honesty",
        "deprecated_replacement"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (mapping_state) without modification."
    },
    "overlay_validation_state": {
      "type": "string",
      "enum": [
        "valid",
        "valid_with_warnings",
        "blocked",
        "inert_unresolved",
        "rolled_back"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (overlay_validation_state) without modification."
    },
    "inheritance_state": {
      "type": "string",
      "enum": ["inherits", "partial", "does_not_inherit"],
      "description": "Re-exported from schemas/ux/appearance_checkpoint.schema.json (inheritance_state) without modification."
    },
    "parity_claim_state": {
      "type": "string",
      "enum": [
        "not_claimed",
        "claimed_with_report",
        "partial_claim_with_gaps",
        "denied_unresolved_or_blocked"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (parity_claim_state) without modification."
    },
    "import_outcome_state": {
      "type": "string",
      "enum": [
        "preview_ready",
        "applied",
        "applied_with_warnings",
        "blocked",
        "rolled_back",
        "cancelled",
        "policy_denied",
        "review_required"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (import_outcome_state) without modification."
    },
    "rollback_path_class": {
      "type": "string",
      "enum": [
        "restore_appearance_checkpoint",
        "discard_preview",
        "reopen_import_review",
        "manual_repair_required",
        "rollback_unavailable_denied"
      ],
      "description": "Re-exported from schemas/ux/theme_import_report.schema.json (rollback_path_class) without modification."
    },
    "evidence_freshness": {
      "type": "string",
      "enum": ["fresh", "stale"]
    },
    "semantic_salience": {
      "type": "string",
      "enum": [
        "decorative_only",
        "informational",
        "lifecycle_bearing",
        "trust_bearing",
        "severity_bearing"
      ],
      "description": "Re-exported from schemas/ux/m5-appearance-qualification.schema.json (semantic_salience) without modification."
    },
    "surface_lifecycle": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "blocking_finding_class": {
      "type": "string",
      "enum": [
        "hidden_downgrade",
        "missing_evidence",
        "unresolved_mapping_hidden",
        "token_silently_dropped",
        "inheritance_gap_hidden",
        "rollback_path_missing",
        "restart_reload_undisclosed",
        "stale_evidence_on_marketed_row",
        "protected_cue_color_only",
        "parity_claim_without_report",
        "object_model_index_drift",
        "dimension_drift",
        "missing_narrowing_reason",
        "missing_projection",
        "descriptor_missing_appearance_anchor",
        "missing_accessibility_note",
        "surface_not_on_appearance_session"
      ]
    },
    "object_model_index_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "canonical_schema_ref",
        "record_kind",
        "owns_vocabulary",
        "consuming_surfaces"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/object_family" },
        "canonical_schema_ref": {
          "$ref": "#/$defs/non_empty_string",
          "description": "Repo-relative path to the canonical, already-frozen schema for this family. The matrix indexes it; it does not re-mint the object."
        },
        "record_kind": { "$ref": "#/$defs/non_empty_string" },
        "owns_vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "consuming_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        }
      }
    },
    "parity_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_family",
        "descriptor_revision_ref",
        "primary_label_ref",
        "appearance_anchor_ref",
        "accessibility_note",
        "semantic_salience",
        "lifecycle_label",
        "marketed_on_desktop_rows",
        "registered_on_appearance_session"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "descriptor_revision_ref": { "$ref": "#/$defs/non_empty_string" },
        "primary_label_ref": { "$ref": "#/$defs/non_empty_string" },
        "appearance_anchor_ref": { "$ref": "#/$defs/non_empty_string" },
        "accessibility_note": { "$ref": "#/$defs/non_empty_string" },
        "semantic_salience": { "$ref": "#/$defs/semantic_salience" },
        "lifecycle_label": { "$ref": "#/$defs/surface_lifecycle" },
        "marketed_on_desktop_rows": { "type": "boolean" },
        "registered_on_appearance_session": { "type": "boolean" }
      }
    },
    "parity_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "dimension",
        "object_family",
        "qualification_status",
        "marketed_on_row",
        "object_ref",
        "projected_compatibility_state",
        "projected_mapping_state",
        "projected_overlay_validation_state",
        "projected_inheritance_state",
        "projected_parity_claim_state",
        "projected_import_outcome",
        "projected_rollback_path",
        "downgrade_disclosed_in_product",
        "downgrade_disclosed_in_export",
        "downgrade_disclosed_in_diagnostics",
        "report_ref",
        "evidence_freshness",
        "evidence_captured_at",
        "narrowing_reason",
        "note"
      ],
      "properties": {
        "row": { "$ref": "#/$defs/parity_row" },
        "dimension": { "$ref": "#/$defs/parity_dimension" },
        "object_family": { "$ref": "#/$defs/object_family" },
        "qualification_status": { "$ref": "#/$defs/qualification_status" },
        "marketed_on_row": { "type": "boolean" },
        "object_ref": {
          "oneOf": [{ "$ref": "#/$defs/non_empty_string" }, { "type": "null" }],
          "description": "Opaque ref to the canonical object instance (theme package, appearance session, overlay, import report, or extension descriptor) this row certifies."
        },
        "projected_compatibility_state": {
          "oneOf": [{ "$ref": "#/$defs/compatibility_state" }, { "type": "null" }]
        },
        "projected_mapping_state": {
          "oneOf": [{ "$ref": "#/$defs/mapping_state" }, { "type": "null" }]
        },
        "projected_overlay_validation_state": {
          "oneOf": [{ "$ref": "#/$defs/overlay_validation_state" }, { "type": "null" }]
        },
        "projected_inheritance_state": {
          "oneOf": [{ "$ref": "#/$defs/inheritance_state" }, { "type": "null" }]
        },
        "projected_parity_claim_state": {
          "oneOf": [{ "$ref": "#/$defs/parity_claim_state" }, { "type": "null" }]
        },
        "projected_import_outcome": {
          "oneOf": [{ "$ref": "#/$defs/import_outcome_state" }, { "type": "null" }]
        },
        "projected_rollback_path": {
          "oneOf": [{ "$ref": "#/$defs/rollback_path_class" }, { "type": "null" }]
        },
        "downgrade_disclosed_in_product": {
          "oneOf": [{ "type": "boolean" }, { "type": "null" }]
        },
        "downgrade_disclosed_in_export": {
          "oneOf": [{ "type": "boolean" }, { "type": "null" }]
        },
        "downgrade_disclosed_in_diagnostics": {
          "oneOf": [{ "type": "boolean" }, { "type": "null" }]
        },
        "report_ref": {
          "oneOf": [{ "$ref": "#/$defs/non_empty_string" }, { "type": "null" }]
        },
        "evidence_freshness": {
          "oneOf": [{ "$ref": "#/$defs/evidence_freshness" }, { "type": "null" }]
        },
        "evidence_captured_at": {
          "oneOf": [{ "$ref": "#/$defs/monotonic_timestamp" }, { "type": "null" }]
        },
        "narrowing_reason": {
          "oneOf": [{ "$ref": "#/$defs/non_empty_string" }, { "type": "null" }]
        },
        "note": {
          "oneOf": [{ "$ref": "#/$defs/non_empty_string" }, { "type": "null" }]
        }
      }
    },
    "blocking_finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": { "$ref": "#/$defs/blocking_finding_class" },
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "row": { "$ref": "#/$defs/parity_row" }
      }
    },
    "row_coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "qualified_rows",
        "explicitly_narrowed_rows",
        "not_applicable_rows",
        "platform_omitted_rows",
        "declared_capture_gap_rows",
        "hidden_downgrade_rows",
        "missing_evidence_rows"
      ],
      "properties": {
        "row": { "$ref": "#/$defs/parity_row" },
        "qualified_rows": { "type": "integer", "minimum": 0 },
        "explicitly_narrowed_rows": { "type": "integer", "minimum": 0 },
        "not_applicable_rows": { "type": "integer", "minimum": 0 },
        "platform_omitted_rows": { "type": "integer", "minimum": 0 },
        "declared_capture_gap_rows": { "type": "integer", "minimum": 0 },
        "hidden_downgrade_rows": { "type": "integer", "minimum": 0 },
        "missing_evidence_rows": { "type": "integer", "minimum": 0 }
      }
    },
    "findings_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_blocking_findings",
        "hidden_downgrade",
        "missing_evidence",
        "unresolved_mapping_hidden",
        "token_silently_dropped",
        "inheritance_gap_hidden",
        "rollback_path_missing",
        "restart_reload_undisclosed",
        "stale_evidence_on_marketed_row",
        "protected_cue_color_only",
        "parity_claim_without_report",
        "object_model_index_drift",
        "dimension_drift",
        "missing_narrowing_reason",
        "missing_projection",
        "descriptor_missing_appearance_anchor",
        "missing_accessibility_note",
        "surface_not_on_appearance_session"
      ],
      "properties": {
        "total_blocking_findings": { "type": "integer", "minimum": 0 },
        "hidden_downgrade": { "type": "integer", "minimum": 0 },
        "missing_evidence": { "type": "integer", "minimum": 0 },
        "unresolved_mapping_hidden": { "type": "integer", "minimum": 0 },
        "token_silently_dropped": { "type": "integer", "minimum": 0 },
        "inheritance_gap_hidden": { "type": "integer", "minimum": 0 },
        "rollback_path_missing": { "type": "integer", "minimum": 0 },
        "restart_reload_undisclosed": { "type": "integer", "minimum": 0 },
        "stale_evidence_on_marketed_row": { "type": "integer", "minimum": 0 },
        "protected_cue_color_only": { "type": "integer", "minimum": 0 },
        "parity_claim_without_report": { "type": "integer", "minimum": 0 },
        "object_model_index_drift": { "type": "integer", "minimum": 0 },
        "dimension_drift": { "type": "integer", "minimum": 0 },
        "missing_narrowing_reason": { "type": "integer", "minimum": 0 },
        "missing_projection": { "type": "integer", "minimum": 0 },
        "descriptor_missing_appearance_anchor": { "type": "integer", "minimum": 0 },
        "missing_accessibility_note": { "type": "integer", "minimum": 0 },
        "surface_not_on_appearance_session": { "type": "integer", "minimum": 0 }
      }
    },
    "appearance_anchor_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "surface_id", "appearance_anchor_ref"],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "appearance_anchor_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "narrowable_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "row", "reason"],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "row": { "$ref": "#/$defs/parity_row" },
        "reason": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "m5_theme_import_parity_row_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor",
        "bindings",
        "blocking_findings",
        "high_salience",
        "marketed"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_theme_import_parity_row_record"
        },
        "schema_version": { "$ref": "#/$defs/m5_theme_import_parity_schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor": { "$ref": "#/$defs/parity_descriptor" },
        "bindings": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/parity_binding" }
        },
        "blocking_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocking_finding" }
        },
        "high_salience": { "type": "boolean" },
        "marketed": { "type": "boolean" }
      }
    },
    "m5_theme_import_parity_report_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "report_id",
        "source_schema_ref",
        "object_model_index",
        "required_rows",
        "rows",
        "row_coverage",
        "findings_summary",
        "appearance_anchor_index",
        "registered_surface_count",
        "high_salience_surface_count",
        "marketed_surface_count",
        "parity_rows_checked",
        "narrowable_marketed_rows",
        "report_clean",
        "published_report_ref",
        "published_doc_ref",
        "docs_help_refs",
        "support_export_refs",
        "generated_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_theme_import_parity_report_record"
        },
        "schema_version": { "$ref": "#/$defs/m5_theme_import_parity_schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "report_id": { "$ref": "#/$defs/non_empty_string" },
        "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "object_model_index": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/object_model_index_entry" }
        },
        "required_rows": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/parity_row" }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/m5_theme_import_parity_row_record" }
        },
        "row_coverage": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/row_coverage_summary" }
        },
        "findings_summary": { "$ref": "#/$defs/findings_summary" },
        "appearance_anchor_index": {
          "type": "array",
          "items": { "$ref": "#/$defs/appearance_anchor_entry" }
        },
        "registered_surface_count": { "type": "integer", "minimum": 0 },
        "high_salience_surface_count": { "type": "integer", "minimum": 0 },
        "marketed_surface_count": { "type": "integer", "minimum": 0 },
        "parity_rows_checked": { "type": "integer", "minimum": 0 },
        "narrowable_marketed_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowable_row" }
        },
        "report_clean": { "type": "boolean" },
        "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
        "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "docs_help_refs": { "$ref": "#/$defs/ref_array" },
        "support_export_refs": { "$ref": "#/$defs/ref_array" },
        "generated_at": { "$ref": "#/$defs/monotonic_timestamp" }
      }
    },
    "m5_theme_import_parity_support_export_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "support_export_id",
        "report",
        "case_ids"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_theme_import_parity_support_export_record"
        },
        "schema_version": { "$ref": "#/$defs/m5_theme_import_parity_schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "support_export_id": { "$ref": "#/$defs/non_empty_string" },
        "report": { "$ref": "#/$defs/m5_theme_import_parity_report_record" },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    }
  }
}
