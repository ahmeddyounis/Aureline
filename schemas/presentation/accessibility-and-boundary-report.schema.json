{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/presentation/accessibility-and-boundary-report.schema.json",
  "title": "Aureline presentation accessibility and boundary report",
  "description": "Canonical, export-safe accessibility / reduced-motion / boundary conformance report for one presentation overlay. A claimed presentation surface must meet the same accessibility and boundary-truth bar as the rest of the shell: every overlay surface (presenter bar, agenda / waypoint rail, spotlight inset, speaker-notes tray, audience strip, breakaway banner, provenance strip) is keyboard reachable in a single contiguous focus ring, renders a visible focus indicator, respects reduced motion, is screen-reader reachable, and carries a non-empty accessible label. Spotlight, zoom, and follow controls stay operable without pointer-only or motion-only dependence and never trap focus. The local / remote / shared boundary labels are preserved in the boundary_posture and on source-bearing surfaces — never flattened to a generic badge — so diagnostics and support can explain what the audience is looking at and where it lives. conformance_class (fully_accessible, degraded_announced, non_conformant) maps onto the shell accessibility-support vocabulary (support_state / role_confidence) one-to-one; an honest high-zoom degrade to a summarized-reachable surface is degraded_announced, never a silent truncation. Adding a new enum value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking and requires a new decision row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "session_id",
    "leader_follow_state",
    "zoom_tier",
    "conformance_class",
    "support_state",
    "role_confidence",
    "boundary_posture",
    "surfaces",
    "keyboard_complete",
    "pointer_only",
    "screen_reader_reachable",
    "reduced_motion_respected",
    "high_zoom_supported",
    "focus_order_contiguous",
    "no_focus_trap",
    "boundary_labels_preserved",
    "accessible_labels_complete"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "presentation_accessibility_report_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string", "const": "shell:presentation_mode_beta:v1" },
    "session_id": { "$ref": "#/$defs/stable_id" },
    "leader_follow_state": { "$ref": "#/$defs/leader_follow_state" },
    "zoom_tier": { "$ref": "#/$defs/zoom_tier" },
    "conformance_class": { "$ref": "#/$defs/conformance_class" },
    "support_state": { "$ref": "#/$defs/support_state" },
    "role_confidence": { "$ref": "#/$defs/role_confidence" },
    "boundary_posture": { "$ref": "#/$defs/boundary_posture" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_conformance" }
    },
    "keyboard_complete": { "type": "boolean" },
    "pointer_only": { "type": "boolean", "const": false },
    "screen_reader_reachable": { "type": "boolean" },
    "reduced_motion_respected": { "type": "boolean" },
    "high_zoom_supported": { "type": "boolean" },
    "focus_order_contiguous": { "type": "boolean" },
    "no_focus_trap": { "type": "boolean", "const": true },
    "boundary_labels_preserved": { "type": "boolean", "const": true },
    "accessible_labels_complete": { "type": "boolean" }
  },
  "allOf": [
    {
      "comment": "A fully accessible overlay maps to the full-accessible / exact shell vocabulary.",
      "if": { "properties": { "conformance_class": { "const": "fully_accessible" } } },
      "then": {
        "properties": {
          "support_state": { "const": "full_accessible" },
          "role_confidence": { "const": "exact" }
        }
      }
    },
    {
      "comment": "A degraded-announced overlay maps to the degraded-accessible / degraded shell vocabulary.",
      "if": { "properties": { "conformance_class": { "const": "degraded_announced" } } },
      "then": {
        "properties": {
          "support_state": { "const": "degraded_accessible" },
          "role_confidence": { "const": "degraded" }
        }
      }
    }
  ],
  "$defs": {
    "leader_follow_state": {
      "type": "string",
      "enum": ["presenting", "following_presenter", "broken_away", "requesting_follow"]
    },
    "zoom_tier": {
      "type": "string",
      "enum": ["standard", "high_zoom"]
    },
    "conformance_class": {
      "type": "string",
      "enum": ["fully_accessible", "degraded_announced", "non_conformant"]
    },
    "support_state": {
      "type": "string",
      "enum": [
        "full_accessible",
        "degraded_accessible",
        "summary_only",
        "inspect_only",
        "unsupported_blocked",
        "not_applicable"
      ]
    },
    "role_confidence": {
      "type": "string",
      "enum": ["exact", "degraded", "summary_only", "unavailable"]
    },
    "high_zoom_reflow": {
      "type": "string",
      "enum": ["reflows", "summarized_reachable"]
    },
    "boundary_label": {
      "type": "string",
      "enum": ["local", "remote", "shared"]
    },
    "audience_scope": {
      "type": "string",
      "enum": ["solo_rehearsal", "shared_workspace", "invited_guests"]
    },
    "surface_tag": {
      "type": "string",
      "enum": [
        "presenter_bar",
        "waypoint_rail",
        "spotlight_frame",
        "speaker_notes_tray",
        "audience_strip",
        "breakaway_banner",
        "provenance_strip"
      ]
    },
    "boundary_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_boundary_labels",
        "audience_scope",
        "boundary_labels_visible",
        "flattened_to_generic"
      ],
      "properties": {
        "current_boundary_label": { "$ref": "#/$defs/boundary_label" },
        "distinct_boundary_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundary_label" },
          "uniqueItems": true
        },
        "audience_scope": { "$ref": "#/$defs/audience_scope" },
        "boundary_labels_visible": { "type": "boolean", "const": true },
        "flattened_to_generic": { "type": "boolean", "const": false }
      }
    },
    "surface_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "surface",
        "is_actionable",
        "keyboard_reachable",
        "visible_focus_indicator",
        "screen_reader_reachable",
        "respects_reduced_motion",
        "high_zoom_reflow",
        "accessible_label",
        "support_state",
        "pointer_only",
        "motion_only",
        "traps_focus",
        "erases_boundary_label"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "presentation_accessibility_surface_record"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "shared_contract_ref": { "type": "string", "const": "shell:presentation_mode_beta:v1" },
        "surface": { "$ref": "#/$defs/surface_tag" },
        "is_actionable": { "type": "boolean" },
        "focus_order_index": { "type": "integer", "minimum": 1 },
        "keyboard_reachable": { "type": "boolean", "const": true },
        "visible_focus_indicator": { "type": "boolean", "const": true },
        "screen_reader_reachable": { "type": "boolean", "const": true },
        "respects_reduced_motion": { "type": "boolean", "const": true },
        "high_zoom_reflow": { "$ref": "#/$defs/high_zoom_reflow" },
        "accessible_label": { "$ref": "#/$defs/short_text" },
        "boundary_label": { "$ref": "#/$defs/boundary_label" },
        "support_state": { "$ref": "#/$defs/support_state" },
        "pointer_only": { "type": "boolean", "const": false },
        "motion_only": { "type": "boolean", "const": false },
        "traps_focus": { "type": "boolean", "const": false },
        "erases_boundary_label": { "type": "boolean", "const": false }
      },
      "allOf": [
        {
          "comment": "An actionable surface sits in the keyboard focus ring.",
          "if": { "properties": { "is_actionable": { "const": true } } },
          "then": { "required": ["focus_order_index"] }
        },
        {
          "comment": "A reflowing surface is fully accessible; a summarized one is honestly degraded.",
          "if": { "properties": { "high_zoom_reflow": { "const": "reflows" } } },
          "then": { "properties": { "support_state": { "const": "full_accessible" } } }
        },
        {
          "comment": "A summarized-reachable surface maps to the degraded-accessible state.",
          "if": { "properties": { "high_zoom_reflow": { "const": "summarized_reachable" } } },
          "then": { "properties": { "support_state": { "const": "degraded_accessible" } } }
        }
      ]
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}
