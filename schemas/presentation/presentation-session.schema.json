{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/presentation/presentation-session.schema.json",
  "title": "Aureline presentation session",
  "description": "Canonical, export-safe presentation-session object: the single governed boundary the shell uses to drive an M5 guided walkthrough as a thin, reversible layer over existing editor, diff, docs, graph, and notebook surfaces — never a parallel artifact type. It captures the layout preset, current anchor, ordered follow-waypoints (each bound to a stable source object per follow-waypoint.schema.json), audience scope and participants, leader/follow posture, local-only speaker notes (per speaker-note.schema.json), and the restore checkpoint captured on enter so exit, cancel, and crash recovery restore the exact prior environment. Follow, break away, request follow, and take over remain distinct, attributable states; teaching/classroom roles stay separate from edit/debug/approval authority. The session never widens authority: grants_mutation_authority, grants_control_authority, and establishes_private_data_ownership are always false, while speaker_notes_default_local_only, preserves_source_provenance, and reuses_existing_surfaces_only are always true. Restore, diagnostics, help, support-export, and release surfaces ingest this object rather than cloning presentation-state text. Adding a new enum value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking and requires a new decision row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "session_id",
    "lifecycle_state",
    "leader_follow_state",
    "layout_preset",
    "audience_scope",
    "current_focus_waypoint_ref",
    "waypoints",
    "audience_participants",
    "restore_checkpoint",
    "grants_mutation_authority",
    "grants_control_authority",
    "establishes_private_data_ownership",
    "speaker_notes_default_local_only",
    "preserves_source_provenance",
    "reuses_existing_surfaces_only"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "presentation_session_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string", "const": "shell:presentation_mode_beta:v1" },
    "session_id": { "$ref": "#/$defs/stable_id" },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "entering",
        "active",
        "exited_restored",
        "cancelled_restored",
        "crash_recovered_restored"
      ]
    },
    "leader_follow_state": {
      "type": "string",
      "enum": ["presenting", "following_presenter", "broken_away", "requesting_follow"]
    },
    "layout_preset": {
      "type": "string",
      "enum": ["inherit_current", "focused_single", "split_compare", "narrative_wide"]
    },
    "audience_scope": {
      "type": "string",
      "enum": ["solo_rehearsal", "shared_workspace", "invited_guests"]
    },
    "current_focus_waypoint_ref": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stable_id" }]
    },
    "waypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://aureline.dev/schemas/presentation/follow-waypoint.schema.json" }
    },
    "audience_participants": {
      "type": "array",
      "items": { "$ref": "#/$defs/audience_participant" }
    },
    "restore_checkpoint": { "$ref": "#/$defs/restore_checkpoint" },
    "grants_mutation_authority": { "type": "boolean", "const": false },
    "grants_control_authority": { "type": "boolean", "const": false },
    "establishes_private_data_ownership": { "type": "boolean", "const": false },
    "speaker_notes_default_local_only": { "type": "boolean", "const": true },
    "preserves_source_provenance": { "type": "boolean", "const": true },
    "reuses_existing_surfaces_only": { "type": "boolean", "const": true }
  },
  "$defs": {
    "audience_participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_id", "role_badge", "follow_state", "is_external_guest"],
      "properties": {
        "participant_id": { "$ref": "#/$defs/stable_id" },
        "role_badge": { "type": "string", "enum": ["presenter", "co_presenter", "viewer"] },
        "follow_state": {
          "type": "string",
          "enum": ["following", "broken_away", "requesting_follow"]
        },
        "is_external_guest": { "type": "boolean" }
      }
    },
    "restore_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "prior_layout_ref",
        "prior_focus_ref",
        "prior_panel_visibility_ref",
        "accessibility_posture_ref",
        "captured_at"
      ],
      "properties": {
        "checkpoint_id": { "$ref": "#/$defs/stable_id" },
        "prior_layout_ref": { "$ref": "#/$defs/stable_id" },
        "prior_focus_ref": { "$ref": "#/$defs/stable_id" },
        "prior_panel_visibility_ref": { "$ref": "#/$defs/stable_id" },
        "accessibility_posture_ref": { "$ref": "#/$defs/stable_id" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    }
  }
}
