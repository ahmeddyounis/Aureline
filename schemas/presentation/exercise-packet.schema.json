{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/presentation/exercise-packet.schema.json",
  "title": "Aureline presentation exercise packet",
  "description": "Canonical exercise-packet object for a teaching / classroom presentation session. An exercise packet constrains a teaching exercise to a declared set of targets (files, symbols, diffs, docs, or graph objects) and a set of expected actions, where every expected action invokes an existing command (command_id begins with cmd:) and operates on one of the packet's declared targets. The packet is authority-bounded by construction: authority_bound.all_actions_command_backed and authority_bound.constrained_to_declared_targets record whether the actions are command-backed and target-constrained, while authority_bound.opens_hidden_mutation_path and authority_bound.widens_product_authority are always false — a packet opens no mutation path outside the command and policy systems and widens no role's product authority. Diagnostics and support surfaces ingest the support-safe projection rather than this object. Adding a new enum value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "title",
    "targets",
    "expected_actions",
    "authority_bound"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "presentation_exercise_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "$ref": "#/$defs/stable_id" },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "title": { "$ref": "#/$defs/short_text" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "expected_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expected_action" }
    },
    "authority_bound": { "$ref": "#/$defs/authority_bound" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "kind"],
      "properties": {
        "target_ref": { "$ref": "#/$defs/short_text" },
        "kind": {
          "type": "string",
          "enum": ["file", "symbol", "diff", "doc", "graph"]
        }
      }
    },
    "expected_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "label", "command_id", "key_binding_ref", "target_ref"],
      "properties": {
        "action_id": { "$ref": "#/$defs/stable_id" },
        "label": { "$ref": "#/$defs/short_text" },
        "command_id": { "$ref": "#/$defs/command_id" },
        "key_binding_ref": { "$ref": "#/$defs/stable_id" },
        "target_ref": { "$ref": "#/$defs/short_text" }
      }
    },
    "authority_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_actions_command_backed",
        "constrained_to_declared_targets",
        "opens_hidden_mutation_path",
        "widens_product_authority"
      ],
      "properties": {
        "all_actions_command_backed": { "type": "boolean" },
        "constrained_to_declared_targets": { "type": "boolean" },
        "opens_hidden_mutation_path": { "type": "boolean", "const": false },
        "widens_product_authority": { "type": "boolean", "const": false }
      }
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "command_id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300,
      "pattern": "^cmd:[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  }
}
