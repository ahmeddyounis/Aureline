{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/state/materialized_view_policy.schema.json",
  "title": "Aureline materialized-view-class persistence, export, and delete policy",
  "description": "Boundary schema for the materialized_view_policy_record and materialized_view_policy_fixture_record produced by aureline-reactive-state's materialized_view_policy module. The policy record binds each of the four closed view classes (ephemeral_projection, durable_local_materialization, exportable_snapshot, managed_replicated_view) to its read authority, persistence, retention, export, delete/clear-data, hold/offboarding, and support-bundle semantics, plus a full per-class disposition matrix over the clear_data, export, support_bundle, offboarding, and restore operations. A fixture record binds one class and one operation to the expected disposition so clear-data, support, offboarding, restore, and export flows replay the same canonical behavior.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/materialized_view_policy_record" },
    { "$ref": "#/$defs/materialized_view_policy_fixture_record" }
  ],
  "$defs": {
    "schema_version": { "type": "integer", "const": 1 },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "reviewable_sentence": { "type": "string", "minLength": 1 },
    "view_class": {
      "type": "string",
      "enum": [
        "ephemeral_projection",
        "durable_local_materialization",
        "exportable_snapshot",
        "managed_replicated_view"
      ]
    },
    "read_authority": {
      "type": "string",
      "enum": ["derived_projection"]
    },
    "persistence_class": {
      "type": "string",
      "enum": [
        "memory_only",
        "local_cache_or_db",
        "saved_artifact",
        "service_or_local_mirror"
      ]
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "until_scope_change",
        "until_cache_eviction_or_clear",
        "until_artifact_deleted",
        "until_replication_lease_ends"
      ]
    },
    "export_class": {
      "type": "string",
      "enum": [
        "not_exportable",
        "metadata_only_export",
        "exportable_snapshot_artifact",
        "replica_metadata_export"
      ]
    },
    "clear_data_semantics": {
      "type": "string",
      "enum": [
        "evict_on_scope_change",
        "clear_or_rebuild",
        "preserve_saved_artifact",
        "revoke_replica_reconcile_on_reconnect"
      ]
    },
    "hold_offboarding_semantics": {
      "type": "string",
      "enum": [
        "no_persisted_state_to_hold",
        "cleared_on_offboarding",
        "retainable_under_hold",
        "governed_by_managed_retention"
      ]
    },
    "support_bundle_semantics": {
      "type": "string",
      "enum": [
        "excluded_from_bundle",
        "metadata_safe_in_bundle",
        "snapshot_eligible_with_consent",
        "replica_metadata_in_bundle"
      ]
    },
    "lifecycle_operation": {
      "type": "string",
      "enum": ["clear_data", "export", "support_bundle", "offboarding", "restore"]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "evicted_from_memory",
        "cleared_rebuildable_from_authority",
        "saved_artifact_preserved",
        "local_replica_revoked_reconcile_later",
        "excluded_no_persisted_state",
        "metadata_only_exported",
        "snapshot_artifact_exported",
        "replica_metadata_exported",
        "excluded_from_bundle",
        "metadata_safe_in_bundle",
        "snapshot_eligible_with_consent",
        "replica_metadata_in_bundle",
        "nothing_to_hold",
        "local_cache_cleared_on_offboarding",
        "retained_under_hold",
        "governed_by_managed_retention",
        "rebuilt_from_authority",
        "restored_from_saved_artifact",
        "reconciled_from_managed_source"
      ]
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/state/materialized_view_policy.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/state/materialized_view_policy.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/state/materialized_view_policy.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/state/materialized_view_policy.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/state/materialized_view_policy/manifest.yaml"
        }
      }
    },
    "materialized_view_class_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_class",
        "summary",
        "authority_on_read",
        "persistence",
        "retention",
        "export",
        "delete_semantics",
        "hold_offboarding",
        "support_bundle",
        "rebuildable_from_authority",
        "survives_clear_data",
        "example_surfaces",
        "consumer_refs",
        "notes"
      ],
      "properties": {
        "view_class": { "$ref": "#/$defs/view_class" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" },
        "authority_on_read": { "$ref": "#/$defs/read_authority" },
        "persistence": { "$ref": "#/$defs/persistence_class" },
        "retention": { "$ref": "#/$defs/retention_class" },
        "export": { "$ref": "#/$defs/export_class" },
        "delete_semantics": { "$ref": "#/$defs/clear_data_semantics" },
        "hold_offboarding": { "$ref": "#/$defs/hold_offboarding_semantics" },
        "support_bundle": { "$ref": "#/$defs/support_bundle_semantics" },
        "rebuildable_from_authority": { "type": "boolean" },
        "survives_clear_data": { "type": "boolean" },
        "example_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "consumer_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "notes": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "disposition_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_class", "operation", "disposition", "rationale"],
      "properties": {
        "view_class": { "$ref": "#/$defs/view_class" },
        "operation": { "$ref": "#/$defs/lifecycle_operation" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "rationale": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "materialized_view_policy_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "classes",
        "disposition_matrix",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "materialized_view_policy_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "classes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/materialized_view_class_row" }
        },
        "disposition_matrix": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/disposition_row" }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewable_sentence" }
        }
      }
    },
    "materialized_view_policy_fixture_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "view_class",
        "operation",
        "expected_disposition",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "materialized_view_policy_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "view_class": { "$ref": "#/$defs/view_class" },
        "operation": { "$ref": "#/$defs/lifecycle_operation" },
        "expected_disposition": { "$ref": "#/$defs/disposition" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/reviewable_sentence" }
      }
    }
  }
}
