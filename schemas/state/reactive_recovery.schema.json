{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/state/reactive_recovery.schema.json",
  "title": "Aureline consumer-side reactive recovery packet",
  "description": "Boundary schema for the checked-in reactive-recovery packet and its scenario fixtures. The packet freezes per-surface recovery strategy, epoch posture, exact-truth action gating, preserved context, and the rapid-invalidation, consumer-lag, reconnect, and provider-overlay-disappearance drills for lagging subscription consumers. Raw state payloads, credentials, raw provider responses, raw paths, raw commands, and raw traces never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "desktop_shell",
        "cli_headless",
        "ai_inspector",
        "review_workspace",
        "companion_snapshot"
      ]
    },
    "lag_condition": {
      "type": "string",
      "enum": [
        "rapid_invalidation_burst",
        "consumer_lag",
        "backpressure_overflow",
        "invalidation_gap",
        "reconnect_after_drop",
        "provider_overlay_disappeared"
      ]
    },
    "recovery_strategy": {
      "type": "string",
      "enum": [
        "coalesce_deltas",
        "request_fresh_snapshot",
        "resubscribe",
        "mark_stale_epoch"
      ]
    },
    "epoch_posture": {
      "type": "string",
      "enum": [
        "current",
        "coalescing",
        "stale_epoch",
        "resubscribe_pending",
        "snapshot_recovering"
      ]
    },
    "action_posture": {
      "type": "string",
      "enum": [
        "exact_truth_allowed",
        "revalidate_before_act",
        "narrowed_to_last_known",
        "resubscribe_required",
        "blocked"
      ]
    },
    "preserved_context": {
      "type": "string",
      "enum": [
        "layout_slot",
        "last_known_projection",
        "scope_identity",
        "freshness_cue",
        "invalidation_reason",
        "epoch_marker"
      ]
    },
    "drill_phase": {
      "type": "string",
      "enum": ["detect", "narrow_action", "recover", "verify"]
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "drills_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/state/reactive_recovery.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/state/reactive_recovery.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/state/reactive_recovery.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/state/reactive_recovery.md"
        },
        "drills_ref": {
          "type": "string",
          "const": "artifacts/state/reactive_recovery_drills.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/state/reactive_recovery/manifest.yaml"
        }
      }
    },
    "flow_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "consumer_surface",
        "lag_condition",
        "primary_strategy",
        "fallback_strategies",
        "epoch_posture",
        "action_posture",
        "offers_exact_truth_action",
        "silent_retry_allowed",
        "recovery_cue_visible",
        "support_exportable",
        "preserved_context",
        "recovery_summary",
        "truth_posture_rationale",
        "source_contract_refs",
        "consumer_refs",
        "notes"
      ],
      "properties": {
        "flow_id": { "$ref": "#/$defs/non_empty_string" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "lag_condition": { "$ref": "#/$defs/lag_condition" },
        "primary_strategy": { "$ref": "#/$defs/recovery_strategy" },
        "fallback_strategies": {
          "type": "array",
          "items": { "$ref": "#/$defs/recovery_strategy" },
          "minItems": 1,
          "uniqueItems": true
        },
        "epoch_posture": { "$ref": "#/$defs/epoch_posture" },
        "action_posture": { "$ref": "#/$defs/action_posture" },
        "offers_exact_truth_action": { "type": "boolean" },
        "silent_retry_allowed": { "type": "boolean" },
        "recovery_cue_visible": { "type": "boolean", "const": true },
        "support_exportable": { "type": "boolean", "const": true },
        "preserved_context": {
          "type": "array",
          "items": { "$ref": "#/$defs/preserved_context" },
          "minItems": 1,
          "uniqueItems": true
        },
        "recovery_summary": { "$ref": "#/$defs/non_empty_string" },
        "truth_posture_rationale": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "consumer_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "epoch_posture", "action_posture", "narration"],
      "properties": {
        "phase": { "$ref": "#/$defs/drill_phase" },
        "epoch_posture": { "$ref": "#/$defs/epoch_posture" },
        "action_posture": { "$ref": "#/$defs/action_posture" },
        "narration": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_id",
        "title",
        "lag_condition",
        "exercised_flow_id",
        "steps",
        "asserts_no_stale_exact_action",
        "asserts_recovery_visible",
        "expected_final_epoch_posture",
        "expected_final_action_posture",
        "notes"
      ],
      "properties": {
        "drill_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "lag_condition": { "$ref": "#/$defs/lag_condition" },
        "exercised_flow_id": { "$ref": "#/$defs/non_empty_string" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill_step" },
          "minItems": 1
        },
        "asserts_no_stale_exact_action": { "type": "boolean", "const": true },
        "asserts_recovery_visible": { "type": "boolean", "const": true },
        "expected_final_epoch_posture": { "$ref": "#/$defs/epoch_posture" },
        "expected_final_action_posture": { "$ref": "#/$defs/action_posture" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "flows",
        "drills",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "reactive_recovery_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/$defs/flow_row" },
          "minItems": 1
        },
        "drills": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill" },
          "minItems": 1
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "expected_flow_id",
        "consumer_surface",
        "lag_condition",
        "expected_primary_strategy",
        "expected_epoch_posture",
        "expected_action_posture",
        "expected_offers_exact_truth_action",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "reactive_recovery_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "expected_flow_id": { "$ref": "#/$defs/non_empty_string" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "lag_condition": { "$ref": "#/$defs/lag_condition" },
        "expected_primary_strategy": { "$ref": "#/$defs/recovery_strategy" },
        "expected_epoch_posture": { "$ref": "#/$defs/epoch_posture" },
        "expected_action_posture": { "$ref": "#/$defs/action_posture" },
        "expected_offers_exact_truth_action": { "type": "boolean" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
