{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/quality/diagnostic-quality-snapshot.schema.json",
  "title": "Aureline diagnostic quality snapshot",
  "description": "Export-safe snapshot of the governance state behind a finding set at one point in time. It names the active quality-profile ref and fingerprint, the rule-pack/tool versions in force, the recent collection-snapshot ids the findings were drawn from, the suppression/baseline refs and release-visible debt count, the imported scanner session refs, and the last save-participant outcomes. The snapshot keeps its own imported-versus-live origin and freshness. An imported or replayed origin is held read-only and never rendered as live local truth, and an imported-snapshot origin must cite at least one imported scanner session. Raw source bytes, raw provider payloads, provider cursors, credentials, and raw paths never cross this boundary.",
  "type": "object",
  "$ref": "#/$defs/diagnostic_quality_snapshot",
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "opaque_ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "timestamp": { "$ref": "#/$defs/non_empty_string" },
    "source_kind": {
      "type": "string",
      "enum": [
        "editor_structural",
        "language_service",
        "build_or_task",
        "runtime_or_test",
        "scanner_import",
        "policy",
        "heuristic"
      ]
    },
    "target_scope_class": {
      "type": "string",
      "enum": [
        "current_file",
        "current_selection",
        "current_root",
        "selected_workset",
        "workspace",
        "review_diff",
        "baseline_family",
        "release_candidate"
      ]
    },
    "origin_class": {
      "type": "string",
      "enum": [
        "live_local_session",
        "live_remote_session",
        "managed_provider_live",
        "imported_snapshot",
        "replayed_support_bundle",
        "local_cache"
      ]
    },
    "freshness_class": {
      "type": "string",
      "enum": [
        "current",
        "recent",
        "warm_cached",
        "degraded_cached",
        "stale",
        "superseded",
        "imported_snapshot",
        "unverified"
      ]
    },
    "save_participant_outcome_class": {
      "type": "string",
      "enum": [
        "applied_clean",
        "applied_with_followups",
        "previewed_not_applied",
        "blocked_requires_preview",
        "failed_rolled_back",
        "skipped"
      ]
    },
    "collection_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_class", "workspace_ref"],
      "properties": {
        "scope_class": { "$ref": "#/$defs/target_scope_class" },
        "workspace_ref": { "$ref": "#/$defs/non_empty_string" },
        "workset_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_or_environment_ref": { "$ref": "#/$defs/non_empty_string" },
        "active_profile_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "tool_version_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "tool_ref",
        "tool_version",
        "rule_pack_ref",
        "rule_pack_version",
        "summary"
      ],
      "properties": {
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "tool_ref": { "$ref": "#/$defs/non_empty_string" },
        "tool_version": { "$ref": "#/$defs/non_empty_string" },
        "rule_pack_ref": { "$ref": "#/$defs/non_empty_string" },
        "rule_pack_version": { "$ref": "#/$defs/non_empty_string" },
        "adapter_ref": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "save_participant_outcome_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_ref",
        "proposal_ref",
        "action_token",
        "outcome_class",
        "preview_first_required",
        "apply_blocked",
        "observed_at",
        "summary"
      ],
      "properties": {
        "participant_ref": { "$ref": "#/$defs/non_empty_string" },
        "proposal_ref": { "$ref": "#/$defs/non_empty_string" },
        "action_token": { "$ref": "#/$defs/non_empty_string" },
        "outcome_class": { "$ref": "#/$defs/save_participant_outcome_class" },
        "preview_first_required": { "type": "boolean" },
        "apply_blocked": { "type": "boolean" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "diagnostic_quality_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "diagnostic_quality_snapshot_schema_version",
        "snapshot_id",
        "snapshot_label",
        "scope",
        "origin_class",
        "freshness_class",
        "captured_at",
        "active_profile_ref",
        "profile_fingerprint",
        "tool_versions",
        "recent_collection_refs",
        "suppression_refs",
        "baseline_refs",
        "release_visible_debt_count",
        "imported_scanner_session_refs",
        "save_participant_outcomes",
        "source_descriptor_refs",
        "imported_not_shown_as_live",
        "export_safe_summary"
      ],
      "properties": {
        "record_kind": { "const": "diagnostic_quality_snapshot" },
        "diagnostic_quality_snapshot_schema_version": {
          "type": "integer",
          "const": 1
        },
        "snapshot_id": { "$ref": "#/$defs/non_empty_string" },
        "snapshot_label": { "$ref": "#/$defs/non_empty_string" },
        "scope": { "$ref": "#/$defs/collection_scope" },
        "origin_class": { "$ref": "#/$defs/origin_class" },
        "freshness_class": { "$ref": "#/$defs/freshness_class" },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "active_profile_ref": { "$ref": "#/$defs/non_empty_string" },
        "profile_fingerprint": { "$ref": "#/$defs/non_empty_string" },
        "tool_versions": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool_version_row" }
        },
        "recent_collection_refs": { "$ref": "#/$defs/opaque_ref_list" },
        "suppression_refs": { "$ref": "#/$defs/opaque_ref_list" },
        "baseline_refs": { "$ref": "#/$defs/opaque_ref_list" },
        "release_visible_debt_count": { "type": "integer", "minimum": 0 },
        "imported_scanner_session_refs": { "$ref": "#/$defs/opaque_ref_list" },
        "save_participant_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/save_participant_outcome_row" }
        },
        "source_descriptor_refs": { "$ref": "#/$defs/opaque_ref_list" },
        "imported_not_shown_as_live": { "type": "boolean" },
        "export_safe_summary": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
