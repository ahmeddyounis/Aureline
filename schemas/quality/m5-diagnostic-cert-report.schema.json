{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/quality/m5-diagnostic-cert-report.schema.json",
  "title": "Aureline M5 diagnostic record / source / collection / anchor-remap / quality-session truth certification",
  "description": "Export-safe certification binding every claimed M5 diagnostic-producing row (notebook, framework, request/data, preview/runtime, package, imported-scanner, review/support/CLI) to per-dimension evidence-quality proof over the record-identity, source-descriptor, collection-snapshot, anchor-remap, and quality-session dimensions. Each dimension certification names a proof currency and, unless the proof is missing, a reopenable proof ref keyed by a non-display fingerprint. A claimed row whose required-core dimension is uncertified, or whose certified dimension lacks current proof (stale, missing, requires-review, or imported proof standing in for a local claim), auto-narrows to an effective grade strictly below its claim, with a recorded narrow trigger and a precise narrowed label. Display clustering never erases a finding's source kind; the imported-versus-live class stays explicit; partial/streaming collection completeness stays visible; anchor remap stays append-only evidence rather than a silent repair; and every mutating fix route serializes through the typed quality-action / session lifecycle. Raw diagnostic source, raw provider payloads, raw scanner report bytes, provider cursors, credentials, and raw artifact bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "label",
    "rows",
    "guardrails",
    "consumer_projection",
    "evidence_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "certify_m5_diagnostic_record_source_collection_remap_and_quality_session_truth_packet"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/certified_diagnostic_row"
      }
    },
    "guardrails": {
      "$ref": "#/$defs/guardrails"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "evidence_freshness": {
      "$ref": "#/$defs/evidence_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "certified_diagnostic_row_kind": {
      "type": "string",
      "enum": [
        "notebook_row",
        "framework_row",
        "request_data_row",
        "preview_runtime_row",
        "package_row",
        "imported_scanner_row",
        "review_support_cli_row"
      ]
    },
    "diagnostic_evidence_dimension": {
      "type": "string",
      "enum": [
        "record_identity",
        "source_descriptor",
        "collection_snapshot",
        "anchor_remap",
        "quality_session"
      ]
    },
    "diagnostic_proof_currency": {
      "type": "string",
      "enum": [
        "verified_current",
        "cached_within_window",
        "imported_current",
        "stale_expired",
        "missing_proof",
        "requires_review"
      ]
    },
    "diagnostic_certification_grade": {
      "type": "string",
      "enum": [
        "release_certified",
        "certified",
        "provisionally_certified",
        "uncertified",
        "not_applicable"
      ]
    },
    "diagnostic_narrow_trigger": {
      "type": "string",
      "enum": [
        "missing_dimension_proof",
        "stale_dimension_proof",
        "imported_proof_on_local_row",
        "verdict_requires_review",
        "source_kind_unresolved",
        "collection_completeness_unproven",
        "anchor_remap_evidence_missing",
        "quality_session_parity_lost",
        "upstream_dependency_narrowed"
      ]
    },
    "diagnostic_source_kind": {
      "type": "string",
      "enum": [
        "editor_structural",
        "language_service",
        "build_or_task",
        "runtime_or_test",
        "scanner_import",
        "policy",
        "heuristic"
      ]
    },
    "diagnostic_origin_class": {
      "type": "string",
      "enum": [
        "live_local_session",
        "live_remote_session",
        "managed_provider_live",
        "imported_snapshot",
        "replayed_support_bundle",
        "local_cache"
      ]
    },
    "certified_diagnostic_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "source_kind",
        "origin_class",
        "subject_fingerprint_token"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_kind": {
          "$ref": "#/$defs/diagnostic_source_kind"
        },
        "origin_class": {
          "$ref": "#/$defs/diagnostic_origin_class"
        },
        "subject_fingerprint_token": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "diagnostic_dimension_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "proof_currency",
        "summary"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/diagnostic_evidence_dimension"
        },
        "proof_currency": {
          "$ref": "#/$defs/diagnostic_proof_currency"
        },
        "proof_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proof_fingerprint_token": {
          "$ref": "#/$defs/non_empty_string"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "certified_diagnostic_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "row_kind",
        "subject",
        "label_summary",
        "imported_row",
        "certifications",
        "source_kind_preserved",
        "imported_live_class_preserved",
        "collection_completeness_visible",
        "remap_history_append_only",
        "mutating_routes_use_quality_session",
        "claimed_grade",
        "effective_grade",
        "evidence_refs",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "row_kind": {
          "$ref": "#/$defs/certified_diagnostic_row_kind"
        },
        "subject": {
          "$ref": "#/$defs/certified_diagnostic_subject"
        },
        "label_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "imported_row": {
          "type": "boolean"
        },
        "certifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnostic_dimension_certification"
          }
        },
        "source_kind_preserved": {
          "type": "boolean"
        },
        "imported_live_class_preserved": {
          "type": "boolean"
        },
        "collection_completeness_visible": {
          "type": "boolean"
        },
        "remap_history_append_only": {
          "type": "boolean"
        },
        "mutating_routes_use_quality_session": {
          "type": "boolean"
        },
        "claimed_grade": {
          "$ref": "#/$defs/diagnostic_certification_grade"
        },
        "effective_grade": {
          "$ref": "#/$defs/diagnostic_certification_grade"
        },
        "narrow_trigger": {
          "$ref": "#/$defs/diagnostic_narrow_trigger"
        },
        "narrowed_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_clustering_never_erases_provenance",
        "imported_versus_live_class_stays_explicit",
        "freshness_and_remap_states_stay_explicit",
        "anchor_remap_is_append_only_evidence",
        "mutating_routes_are_typed_quality_proposals",
        "rows_auto_narrow_without_current_proof"
      ],
      "properties": {
        "display_clustering_never_erases_provenance": {
          "type": "boolean"
        },
        "imported_versus_live_class_stays_explicit": {
          "type": "boolean"
        },
        "freshness_and_remap_states_stay_explicit": {
          "type": "boolean"
        },
        "anchor_remap_is_append_only_evidence": {
          "type": "boolean"
        },
        "mutating_routes_are_typed_quality_proposals": {
          "type": "boolean"
        },
        "rows_auto_narrow_without_current_proof": {
          "type": "boolean"
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editor_ingests_certification",
        "problems_ingests_certification",
        "review_ingests_certification",
        "cli_headless_ingests_certification",
        "support_export_ingests_certification",
        "ai_evidence_ingests_certification",
        "release_debt_ingests_certification",
        "narrowed_rows_labeled_below_claim"
      ],
      "properties": {
        "editor_ingests_certification": {
          "type": "boolean"
        },
        "problems_ingests_certification": {
          "type": "boolean"
        },
        "review_ingests_certification": {
          "type": "boolean"
        },
        "cli_headless_ingests_certification": {
          "type": "boolean"
        },
        "support_export_ingests_certification": {
          "type": "boolean"
        },
        "ai_evidence_ingests_certification": {
          "type": "boolean"
        },
        "release_debt_ingests_certification": {
          "type": "boolean"
        },
        "narrowed_rows_labeled_below_claim": {
          "type": "boolean"
        }
      }
    },
    "evidence_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_freshness_slo_hours",
        "last_evidence_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "evidence_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_evidence_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
