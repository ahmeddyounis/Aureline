{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/quality/m5-diagnostic-truth-lane.schema.json",
  "title": "Aureline M5 diagnostic-record, source-descriptor, collection-snapshot, anchor-remap, and quality-session matrix",
  "description": "Export-safe matrix binding every claimed M5 diagnostic-producing surface (notebook cells, framework packs, request/API tooling, data tooling, preview runtime, package lane, language provider, editor-structural guard, imported scanner) to its canonical source kind, imported-versus-live origin class, freshness class, anchor-remap state, collection-completeness class, cluster-meaning class, and governing quality-session outcome. The matrix reuses the frozen diagnostic source-kind, origin, freshness, anchor-remap, and quality-session vocabularies and adds the matrix-level collection-completeness and cluster-meaning vocabularies it owns. A claimed row that cannot identify a source kind, origin class, proven freshness, a remap state, a collection completeness, or a governing quality session auto-downgrades to an effective qualification strictly below its claim, with a recorded downgrade trigger and a precise degraded label. Unlike sources are never flattened into synthetic findings; convenience clustering never erases source/freshness/remap provenance; anchors are never silently repaired; imported or replayed evidence never masquerades as live local truth; partial, incremental, imported, or filtered collection completeness stays disclosed and exportable; target/environment/policy refs are preserved; and every mutating fix route is a typed quality-action proposal. Raw source bytes, raw provider payloads, raw scanner reports, provider cursors, credentials, and raw artifact bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "guardrails",
    "consumer_projection",
    "evidence_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_the_m5_diagnostic_record_source_collection_snapshot_and_anchor_remap_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic_lane_row"
      }
    },
    "guardrails": {
      "$ref": "#/$defs/guardrails"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "evidence_freshness": {
      "$ref": "#/$defs/evidence_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "surface": {
      "type": "string",
      "enum": [
        "notebook_cell_diagnostics",
        "framework_pack_diagnostics",
        "request_tooling_diagnostics",
        "data_tooling_diagnostics",
        "preview_runtime_diagnostics",
        "package_lane_diagnostics",
        "language_provider_diagnostics",
        "editor_structural_diagnostics",
        "imported_scanner_diagnostics"
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "editor_structural",
        "language_service",
        "build_or_task",
        "runtime_or_test",
        "scanner_import",
        "policy",
        "heuristic"
      ]
    },
    "origin_class": {
      "type": "string",
      "enum": [
        "live_local_session",
        "live_remote_session",
        "managed_provider_live",
        "imported_snapshot",
        "replayed_support_bundle",
        "local_cache"
      ]
    },
    "freshness_class": {
      "type": "string",
      "enum": [
        "current",
        "recent",
        "warm_cached",
        "degraded_cached",
        "stale",
        "superseded",
        "imported_snapshot",
        "unverified"
      ]
    },
    "remap_state_class": {
      "type": "string",
      "enum": [
        "exact",
        "contextual",
        "stale",
        "unmapped",
        "imported_static"
      ]
    },
    "collection_completeness_class": {
      "type": "string",
      "enum": [
        "complete_enumeration",
        "partial_visible_scan",
        "incremental_since_last",
        "imported_snapshot_set",
        "filtered_view",
        "unknown_requires_review"
      ]
    },
    "cluster_meaning_class": {
      "type": "string",
      "enum": [
        "no_clustering",
        "exact_duplicate",
        "cross_source_corroboration",
        "related_by_location",
        "related_by_cause",
        "display_rollup_only"
      ]
    },
    "quality_session_outcome_class": {
      "type": "string",
      "enum": [
        "applied",
        "preview_required",
        "skipped",
        "timed_out",
        "rebase_required",
        "blocked_by_policy",
        "failed",
        "reverted"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "held",
        "preview",
        "beta",
        "stable"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "unidentified_source_kind",
        "unidentified_origin_class",
        "unproven_freshness",
        "unresolved_remap_state",
        "unknown_collection_completeness",
        "unlinked_quality_session",
        "stale_evidence_window"
      ]
    },
    "diagnostic_lane_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface",
        "label_summary",
        "cluster_meaning_class",
        "provenance_preserved_in_clustering",
        "imported_not_shown_as_live",
        "freshness_and_remap_disclosed",
        "anchor_remap_append_only",
        "collection_completeness_disclosed",
        "target_environment_refs_preserved",
        "mutating_fix_is_typed_proposal",
        "claimed_qualification",
        "effective_qualification",
        "evidence_refs",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "label_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_kind": {
          "$ref": "#/$defs/source_kind"
        },
        "origin_class": {
          "$ref": "#/$defs/origin_class"
        },
        "freshness_class": {
          "$ref": "#/$defs/freshness_class"
        },
        "remap_state_class": {
          "$ref": "#/$defs/remap_state_class"
        },
        "collection_completeness_class": {
          "$ref": "#/$defs/collection_completeness_class"
        },
        "cluster_meaning_class": {
          "$ref": "#/$defs/cluster_meaning_class"
        },
        "quality_session_outcome_class": {
          "$ref": "#/$defs/quality_session_outcome_class"
        },
        "provenance_preserved_in_clustering": {
          "type": "boolean"
        },
        "imported_not_shown_as_live": {
          "type": "boolean"
        },
        "freshness_and_remap_disclosed": {
          "type": "boolean"
        },
        "anchor_remap_append_only": {
          "type": "boolean"
        },
        "collection_completeness_disclosed": {
          "type": "boolean"
        },
        "target_environment_refs_preserved": {
          "type": "boolean"
        },
        "mutating_fix_is_typed_proposal": {
          "type": "boolean"
        },
        "claimed_qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "effective_qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "downgrade_trigger": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "degraded_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unlike_sources_never_flattened",
        "anchors_never_silently_repaired",
        "clustering_never_erases_class",
        "imported_live_class_explicit",
        "freshness_and_remap_explicit",
        "collection_completeness_exportable",
        "mutating_fixes_are_typed_proposals",
        "rows_auto_downgrade_on_unidentified_lane"
      ],
      "properties": {
        "unlike_sources_never_flattened": {
          "type": "boolean"
        },
        "anchors_never_silently_repaired": {
          "type": "boolean"
        },
        "clustering_never_erases_class": {
          "type": "boolean"
        },
        "imported_live_class_explicit": {
          "type": "boolean"
        },
        "freshness_and_remap_explicit": {
          "type": "boolean"
        },
        "collection_completeness_exportable": {
          "type": "boolean"
        },
        "mutating_fixes_are_typed_proposals": {
          "type": "boolean"
        },
        "rows_auto_downgrade_on_unidentified_lane": {
          "type": "boolean"
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editor_ingests_lane",
        "problems_ingests_lane",
        "review_ingests_lane",
        "cli_headless_ingests_lane",
        "ai_evidence_ingests_lane",
        "support_export_ingests_lane",
        "downgraded_rows_labeled_below_current"
      ],
      "properties": {
        "editor_ingests_lane": {
          "type": "boolean"
        },
        "problems_ingests_lane": {
          "type": "boolean"
        },
        "review_ingests_lane": {
          "type": "boolean"
        },
        "cli_headless_ingests_lane": {
          "type": "boolean"
        },
        "ai_evidence_ingests_lane": {
          "type": "boolean"
        },
        "support_export_ingests_lane": {
          "type": "boolean"
        },
        "downgraded_rows_labeled_below_current": {
          "type": "boolean"
        }
      }
    },
    "evidence_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_freshness_slo_hours",
        "last_evidence_refresh",
        "auto_downgrade_on_stale"
      ],
      "properties": {
        "evidence_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_evidence_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_downgrade_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
