{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/quality/quality-session-ledger.schema.json",
  "title": "Aureline M5 quality-session ledger",
  "description": "Boundary schema for the m5_quality_session_ledger packet. The ledger bundles a set of quality sessions (each carrying its own typed quality-action proposals) that span every required trigger path, action class, safety class, and outcome, then projects them onto the UI, Problems, review, CLI, and support surfaces and rolls them into a metadata-only support export. It proves every mutating quality action becomes a typed proposal inside a typed session that reports through one result vocabulary. Raw patches, raw source text, raw tool arguments, raw logs, raw paths, and raw secrets do not cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "ledger_label",
    "workspace_id",
    "sessions",
    "surface_projections",
    "coverage",
    "support_export",
    "guardrails",
    "consumer_projection",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_quality_session_ledger" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "ledger_label": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://aureline.dev/schemas/quality/quality_session.schema.json" }
    },
    "surface_projections": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_projection" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "support_export": { "$ref": "#/$defs/support_export" },
    "guardrails": { "$ref": "#/$defs/guardrails" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "source_contract_refs": { "$ref": "#/$defs/ref_list" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ref_list": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "trigger_class": {
      "type": "string",
      "enum": [
        "on_type",
        "on_save",
        "manual_command",
        "cli_headless",
        "review",
        "local_ci",
        "managed_ci",
        "support_replay",
        "import_comparison"
      ]
    },
    "outcome_class": {
      "type": "string",
      "enum": [
        "applied",
        "preview_required",
        "skipped",
        "timed_out",
        "rebase_required",
        "blocked_by_policy",
        "failed",
        "reverted"
      ]
    },
    "action_class": {
      "type": "string",
      "enum": [
        "format_range",
        "format_document",
        "organize_imports",
        "quick_fix_single",
        "fix_all_rule",
        "lint_autofix_batch",
        "suppression_proposal",
        "baseline_update",
        "scanner_read_only",
        "validation_recheck"
      ]
    },
    "safety_class": {
      "type": "string",
      "enum": [
        "trivia_safe",
        "local_syntax_safe",
        "semantic_local",
        "cross_file_semantic",
        "generated_or_protected",
        "unknown_or_unstable"
      ]
    },
    "rollback_boundary_class": {
      "type": "string",
      "enum": [
        "no_mutation",
        "current_buffer_undo",
        "single_file_checkpoint",
        "grouped_workspace_checkpoint",
        "policy_audit_only",
        "manual_recovery_required"
      ]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "save_participant_ui",
        "problems",
        "review",
        "cli_explain",
        "support_export",
        "local_ci",
        "managed_ci"
      ]
    },
    "redaction_class": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "operator_only_restricted",
        "internal_support_restricted",
        "signing_evidence_only"
      ]
    },
    "surface_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "projection_id",
        "session_id",
        "surface_class",
        "surface_token",
        "trigger_class",
        "trigger_token",
        "outcome_class",
        "outcome_token",
        "proposal_count",
        "mutating_proposal_count",
        "safety_classes",
        "rollback_boundaries",
        "any_preview_first_required",
        "any_apply_blocked",
        "validation_ref_count",
        "rollback_ref_count",
        "exposes_outcome",
        "exposes_safety_class",
        "exposes_rollback_note",
        "exposes_validation_refs",
        "raw_source_content_included",
        "raw_payload_included",
        "export_safe_summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_quality_session_surface_projection" },
        "schema_version": { "type": "integer", "const": 1 },
        "projection_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "surface_class": { "$ref": "#/$defs/surface_class" },
        "surface_token": { "$ref": "#/$defs/surface_class" },
        "trigger_class": { "$ref": "#/$defs/trigger_class" },
        "trigger_token": { "$ref": "#/$defs/trigger_class" },
        "outcome_class": { "$ref": "#/$defs/outcome_class" },
        "outcome_token": { "$ref": "#/$defs/outcome_class" },
        "proposal_count": { "type": "integer", "minimum": 0 },
        "mutating_proposal_count": { "type": "integer", "minimum": 0 },
        "safety_classes": { "type": "array", "items": { "$ref": "#/$defs/safety_class" } },
        "rollback_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/rollback_boundary_class" }
        },
        "any_preview_first_required": { "type": "boolean" },
        "any_apply_blocked": { "type": "boolean" },
        "validation_ref_count": { "type": "integer", "minimum": 0 },
        "rollback_ref_count": { "type": "integer", "minimum": 0 },
        "exposes_outcome": { "type": "boolean" },
        "exposes_safety_class": { "type": "boolean" },
        "exposes_rollback_note": { "type": "boolean" },
        "exposes_validation_refs": { "type": "boolean" },
        "raw_source_content_included": { "type": "boolean" },
        "raw_payload_included": { "type": "boolean" },
        "export_safe_summary": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger_paths", "action_classes", "safety_classes", "outcome_classes"],
      "properties": {
        "trigger_paths": { "type": "array", "items": { "$ref": "#/$defs/trigger_class" } },
        "action_classes": { "type": "array", "items": { "$ref": "#/$defs/action_class" } },
        "safety_classes": { "type": "array", "items": { "$ref": "#/$defs/safety_class" } },
        "outcome_classes": { "type": "array", "items": { "$ref": "#/$defs/outcome_class" } }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "export_id",
        "workspace_id",
        "session_refs",
        "session_trails",
        "preserves_session_proposals",
        "redaction_class",
        "raw_source_content_included",
        "raw_payload_included",
        "export_safe_summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_quality_session_ledger_support_export" },
        "schema_version": { "type": "integer", "const": 1 },
        "export_id": { "type": "string", "minLength": 1 },
        "workspace_id": { "type": "string", "minLength": 1 },
        "session_refs": { "$ref": "#/$defs/ref_list" },
        "session_trails": {
          "type": "array",
          "items": { "$ref": "#/$defs/session_trail" }
        },
        "preserves_session_proposals": { "type": "boolean" },
        "redaction_class": { "$ref": "#/$defs/redaction_class" },
        "raw_source_content_included": { "type": "boolean" },
        "raw_payload_included": { "type": "boolean" },
        "export_safe_summary": { "type": "string", "minLength": 1 }
      }
    },
    "session_trail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "trigger_class",
        "outcome_class",
        "proposal_ids",
        "action_classes",
        "validation_refs",
        "rollback_refs"
      ],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "trigger_class": { "$ref": "#/$defs/trigger_class" },
        "outcome_class": { "$ref": "#/$defs/outcome_class" },
        "proposal_ids": { "$ref": "#/$defs/ref_list" },
        "action_classes": { "type": "array", "items": { "$ref": "#/$defs/action_class" } },
        "validation_refs": { "$ref": "#/$defs/ref_list" },
        "rollback_refs": { "$ref": "#/$defs/ref_list" }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_mutating_action_is_typed_proposal",
        "every_proposal_serialized_in_session",
        "one_result_vocabulary_across_paths",
        "generated_and_protected_reuse_lifecycle",
        "rollback_notes_inspectable",
        "validation_refs_inspectable",
        "safety_classes_inspectable",
        "import_comparison_stays_read_only"
      ],
      "properties": {
        "every_mutating_action_is_typed_proposal": { "type": "boolean" },
        "every_proposal_serialized_in_session": { "type": "boolean" },
        "one_result_vocabulary_across_paths": { "type": "boolean" },
        "generated_and_protected_reuse_lifecycle": { "type": "boolean" },
        "rollback_notes_inspectable": { "type": "boolean" },
        "validation_refs_inspectable": { "type": "boolean" },
        "safety_classes_inspectable": { "type": "boolean" },
        "import_comparison_stays_read_only": { "type": "boolean" }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui_shows_proposal_and_session",
        "problems_shows_proposal_and_session",
        "review_shows_proposal_and_session",
        "cli_shows_proposal_and_session",
        "support_export_preserves_sessions"
      ],
      "properties": {
        "ui_shows_proposal_and_session": { "type": "boolean" },
        "problems_shows_proposal_and_session": { "type": "boolean" },
        "review_shows_proposal_and_session": { "type": "boolean" },
        "cli_shows_proposal_and_session": { "type": "boolean" },
        "support_export_preserves_sessions": { "type": "boolean" }
      }
    }
  }
}
