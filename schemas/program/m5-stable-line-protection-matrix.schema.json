{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-stable-line-protection-matrix.schema.json",
  "title": "Aureline M5 stable-line protection, evidence-refresh, correction-line, and LTS-readiness matrix",
  "description": "Export-safe packet freezing Aureline's concrete post-stable operating model — its stable-line taxonomy, support windows, correction-line owners, backport-decision SLAs, evidence-refresh cadences, bundle-refresh obligations, and LTS-eligibility state. The packet names every active stable or stable-candidate line — the fresh stable line, the evidence-refresh line, the correction/backport line, the launch-bundle-currentness line, and the LTS-candidate line — and binds each governed line to the claimed surface families that render it (shiproom, release-center, executive-steering, public-proof, docs/help, support-export), the widening stages it must gate (alpha, beta, release_candidate, stable, long_term_support), the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each line declares the controlled vocabularies it carries: the single controlled stable-line-protection-role vocabulary consumers bind to (support_window, correction_ownership, evidence_refresh, backport_decision, lts_eligibility, bundle_currentness, defect_ledger), plus line-specific fresh-stable-line roles, evidence-refresh-line roles, correction/backport-line roles, launch-bundle-currentness-line roles, and LTS-candidate-line roles. Hard invariants forbid widening support language without current refresh and correction evidence, drifting a shipping line on stale evidence or frozen launch bundles, relying on tribal backport memory instead of a documented correction packet, claiming LTS eligibility without current rollback and support evidence, and leaving a supported-line defect unowned or unresolved past its SLA. The matrix binds back to the already-landed claim-manifest and release-center packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "stable_line_protection_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_stable_line_protection_evidence_refresh_correction_line_and_lts_readiness_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "stable_line_protection_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/stable_line_protection_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "stable_line_protection_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stable_line_protection_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "line_class": {
      "enum": [
        "fresh_stable_line",
        "evidence_refresh_line",
        "correction_backport_line",
        "bundle_currentness_line",
        "lts_candidate_line"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "support_window",
        "correction_ownership",
        "evidence_refresh",
        "backport_decision",
        "lts_eligibility",
        "bundle_currentness",
        "defect_ledger"
      ]
    },
    "stable_line_protection_row": {
      "type": "object",
      "required": [
        "line_class",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "widening_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_support_language_without_current_refresh_and_correction_evidence",
        "drifts_a_shipping_line_on_stale_evidence_or_frozen_launch_bundles",
        "relies_on_tribal_backport_memory_instead_of_a_documented_correction_packet",
        "claims_lts_eligibility_without_current_rollback_and_support_evidence",
        "leaves_a_supported_line_defect_unowned_or_unresolved_past_its_sla"
      ],
      "properties": {
        "line_class": {
          "$ref": "#/$defs/line_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "widening_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "fresh_stable_line_roles": {
          "type": "array"
        },
        "evidence_refresh_line_roles": {
          "type": "array"
        },
        "correction_backport_line_roles": {
          "type": "array"
        },
        "bundle_currentness_line_roles": {
          "type": "array"
        },
        "lts_candidate_line_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "widens_support_language_without_current_refresh_and_correction_evidence": {
          "const": false
        },
        "drifts_a_shipping_line_on_stale_evidence_or_frozen_launch_bundles": {
          "const": false
        },
        "relies_on_tribal_backport_memory_instead_of_a_documented_correction_packet": {
          "const": false
        },
        "claims_lts_eligibility_without_current_rollback_and_support_evidence": {
          "const": false
        },
        "leaves_a_supported_line_defect_unowned_or_unresolved_past_its_sla": {
          "const": false
        }
      }
    }
  }
}
