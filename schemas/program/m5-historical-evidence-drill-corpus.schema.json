{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-historical-evidence-drill-corpus.schema.json",
  "title": "M5 Historical-Evidence Drill Corpus",
  "description": "Export-safe seeded corpus of archived-snapshot, imported / offline evidence, and live-target handoff fixtures plus regression drills over the five B149 non-live-evidence object classes (retirement snapshot, captured support / export evidence, archived runbook packet, imported / offline route evidence, review / incident snapshot). Each binding seeds one historical-reference fixture (a last-supported retirement snapshot, a captured support / export evidence bundle, a runbook / incident archived packet, or an imported / offline route packet) exercised by one of six drills (preserved live-target handoff, missing live target, retired-line reopen, stale imported evidence, expired-snapshot metadata-only fallback, or evidence-only reopen after version / schema drift) on one downstream consumer surface. Every binding names a historical-reference state, a live-target handoff outcome, and an exact blocker (none-cleared, missing-target, trust-block, route-unavailable, expired-snapshot, or imported-offline-evidence-only) so QA / support automation can mechanically separate failure modes; carries the controlled non-live grammar (historical-role, snapshot-label, capture-time, provenance, mutation-blocked-posture) identical for one fixture across surfaces; joins its provenance back to a source snapshot descriptor; records a handoff expectation with a live-target handoff, metadata-only exit, or satisfy-prerequisite ref plus a plain-words blocker note; and binds back to screenshots, an accessibility check, the CLI / support export, and the health dashboard, so the corpus is discoverable from release and support evidence rather than an ad hoc local sample set. No drill reopens a live target implicitly, dead-links an expired artifact, or presents non-live evidence as current live truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "drill_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_historical_evidence_drill_corpus"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "drill_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/drill_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "retirement_snapshot",
        "support_export_evidence",
        "archived_runbook_packet",
        "imported_offline_route_evidence",
        "review_incident_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "help_docs",
        "support",
        "review_incident",
        "runbook_archive",
        "release_center",
        "companion_export",
        "program_governance",
        "cli_export"
      ]
    },
    "drill": {
      "type": "string",
      "enum": [
        "preserved_live_target_handoff",
        "missing_live_target",
        "retired_line_reopen",
        "stale_imported_evidence",
        "expired_snapshot_metadata_only_fallback",
        "evidence_only_reopen_after_version_schema_drift"
      ]
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "preserved_live_target_joinable",
        "missing_live_target_metadata_only",
        "retired_line_no_live_counterpart",
        "stale_imported_evidence",
        "expired_snapshot_metadata_fallback",
        "imported_offline_evidence_only"
      ]
    },
    "handoff_outcome": {
      "type": "string",
      "enum": [
        "handoff_cleared",
        "blocked_needs_prerequisite",
        "blocked_target_unavailable",
        "blocked_by_policy"
      ]
    },
    "drill_blocker": {
      "type": "string",
      "enum": [
        "none_cleared",
        "missing_target",
        "trust_block",
        "route_unavailable",
        "expired_snapshot",
        "imported_offline_evidence_only"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["live_target_joined", "non_live_boundary_disclosed"]
    },
    "drill_action": {
      "type": "string",
      "enum": [
        "inspect_historical_fixture",
        "export_drill_evidence",
        "open_current_live_object"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "grammar_drift_detected",
        "mutation_blocked_posture_dropped",
        "blocker_outcome_mismatch",
        "expired_artifact_dead_linked",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "presents_non_live_evidence_as_current_live",
        "non_live_evidence_unjoined_to_capture_context",
        "corpus_evidence_bindings_missing",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_historical_reference_narrowed"
      ]
    },
    "non_live_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_role_word",
        "snapshot_label_word",
        "capture_time_word",
        "provenance_word",
        "mutation_blocked_posture_word"
      ],
      "properties": {
        "historical_role_word": { "type": "string", "minLength": 1 },
        "snapshot_label_word": { "type": "string", "minLength": 1 },
        "capture_time_word": { "type": "string", "minLength": 1 },
        "provenance_word": { "type": "string", "minLength": 1 },
        "mutation_blocked_posture_word": { "type": "string", "minLength": 1 }
      }
    },
    "provenance_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot_descriptor_ref",
        "capture_context_ref",
        "producer_build_ref",
        "provenance_lineage_ref"
      ],
      "properties": {
        "source_snapshot_descriptor_ref": { "type": "string", "minLength": 1 },
        "capture_context_ref": { "type": "string", "minLength": 1 },
        "producer_build_ref": { "type": "string", "minLength": 1 },
        "provenance_lineage_ref": { "type": "string", "minLength": 1 }
      }
    },
    "handoff_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_outcome",
        "expected_blocker",
        "live_target_handoff_ref",
        "metadata_only_exit_ref",
        "satisfy_prerequisite_ref",
        "blocker_note"
      ],
      "properties": {
        "expected_outcome": { "$ref": "#/$defs/handoff_outcome" },
        "expected_blocker": { "$ref": "#/$defs/drill_blocker" },
        "live_target_handoff_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "metadata_only_exit_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "satisfy_prerequisite_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "blocker_note": { "type": "string", "minLength": 1 }
      }
    },
    "corpus_evidence_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screenshot_ref",
        "accessibility_check_ref",
        "cli_support_export_ref",
        "health_dashboard_ref"
      ],
      "properties": {
        "screenshot_ref": { "type": "string", "minLength": 1 },
        "accessibility_check_ref": { "type": "string", "minLength": 1 },
        "cli_support_export_ref": { "type": "string", "minLength": 1 },
        "health_dashboard_ref": { "type": "string", "minLength": 1 }
      }
    },
    "drill_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "fixture_id",
        "fixture_label",
        "object_class",
        "consumer",
        "drill",
        "drill_label",
        "evidence_state",
        "expected_handoff_outcome",
        "expected_blocker",
        "non_live_grammar",
        "content_available",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "provenance_join",
        "handoff_expectation",
        "corpus_evidence",
        "non_live_boundary_explicitly_called_out",
        "looks_live_by_omission",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "dead_links_expired_or_removed_artifact",
        "non_live_evidence_unjoined_to_capture_context",
        "presents_as_current_or_reopens_through_ambiguous_route",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "fixture_id": { "type": "string", "minLength": 1 },
        "fixture_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "drill": { "$ref": "#/$defs/drill" },
        "drill_label": { "type": "string", "minLength": 1 },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "expected_handoff_outcome": { "$ref": "#/$defs/handoff_outcome" },
        "expected_blocker": { "$ref": "#/$defs/drill_blocker" },
        "non_live_grammar": { "$ref": "#/$defs/non_live_grammar" },
        "content_available": { "type": "boolean" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/drill_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "provenance_join": { "$ref": "#/$defs/provenance_join" },
        "handoff_expectation": { "$ref": "#/$defs/handoff_expectation" },
        "corpus_evidence": { "$ref": "#/$defs/corpus_evidence_bindings" },
        "non_live_boundary_explicitly_called_out": { "type": "boolean" },
        "looks_live_by_omission": { "type": "boolean" },
        "reopens_live_target_without_validating_identity_trust_route_and_authority": { "type": "boolean" },
        "dead_links_expired_or_removed_artifact": { "type": "boolean" },
        "non_live_evidence_unjoined_to_capture_context": { "type": "boolean" },
        "presents_as_current_or_reopens_through_ambiguous_route": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
