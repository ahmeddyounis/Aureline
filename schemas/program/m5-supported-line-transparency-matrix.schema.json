{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-supported-line-transparency-matrix.schema.json",
  "title": "Aureline M5 supported-line public-proof, transparency-report, migration-scoreboard, ORR-history, and correction-train-archive matrix",
  "description": "Export-safe packet freezing Aureline's durable post-launch external-proof object model — its supported-line public-proof ledgers, upstream/compatibility transparency reports, versioned migration scoreboards, supported-line ORR-history events, and correction-train archive packets, plus their public-safe versus internal-only visibility posture. The packet names every governed supported-line proof object — the public-proof ledger, the transparency report, the migration scoreboard, the ORR-history event, and the correction-train archive — and binds each object to the claimed surface families that render it (shiproom, release-center, executive-steering, public-proof, docs/help, support-export), the widening stages it must gate (alpha, beta, release_candidate, stable, long_term_support), the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show (identity, transparency_role, registry_reference, plus freshness_window, export_class, line_association). Each object declares the controlled vocabularies it carries: the single controlled transparency-role vocabulary consumers bind to (freshness_window, transparency_disclosure, migration_scoreboard_currency, orr_history_retention, correction_archive_retention, public_proof_freshness, correction_history_join), plus object-specific public-proof-ledger roles, transparency-report roles, migration-scoreboard roles, ORR-history-event roles, and correction-train-archive roles. Hard invariants forbid widening a claim because a report once existed without current freshness, staying green on stale external proof or opaque upstream health, leaking internal-only incident or security detail into public-safe feeds, leaving public-proof / migration / history unjoined to build and release-line identity, and leaving migration pain or ORR and correction history unretained. The matrix binds back to the already-landed stable-proof-index and migration-task-row packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "supported_line_transparency_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_supported_line_public_proof_transparency_migration_scoreboard_orr_history_and_correction_train_archive_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "supported_line_transparency_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/supported_line_transparency_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "supported_line_transparency_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "supported_line_transparency_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "proof_object": {
      "enum": [
        "public_proof_ledger",
        "transparency_report",
        "migration_scoreboard",
        "orr_history_event",
        "correction_train_archive"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "freshness_window",
        "transparency_disclosure",
        "migration_scoreboard_currency",
        "orr_history_retention",
        "correction_archive_retention",
        "public_proof_freshness",
        "correction_history_join"
      ]
    },
    "supported_line_transparency_row": {
      "type": "object",
      "required": [
        "proof_object",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "widening_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_claim_because_a_report_once_existed_without_current_freshness",
        "stays_green_on_stale_external_proof_or_opaque_upstream_health",
        "leaks_internal_only_incident_or_security_detail_into_public_safe_feeds",
        "leaves_public_proof_migration_or_history_unjoined_to_build_and_release_line_identity",
        "leaves_migration_pain_or_orr_and_correction_history_unretained"
      ],
      "properties": {
        "proof_object": {
          "$ref": "#/$defs/proof_object"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "widening_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "public_proof_ledger_roles": {
          "type": "array"
        },
        "transparency_report_roles": {
          "type": "array"
        },
        "migration_scoreboard_roles": {
          "type": "array"
        },
        "orr_history_event_roles": {
          "type": "array"
        },
        "correction_train_archive_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "widens_a_claim_because_a_report_once_existed_without_current_freshness": {
          "const": false
        },
        "stays_green_on_stale_external_proof_or_opaque_upstream_health": {
          "const": false
        },
        "leaks_internal_only_incident_or_security_detail_into_public_safe_feeds": {
          "const": false
        },
        "leaves_public_proof_migration_or_history_unjoined_to_build_and_release_line_identity": {
          "const": false
        },
        "leaves_migration_pain_or_orr_and_correction_history_unretained": {
          "const": false
        }
      }
    }
  }
}
