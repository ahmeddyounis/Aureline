{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-orr-review-and-rehearsal-drill-registries.schema.json",
  "title": "Aureline M5 operational-readiness-review and rehearsal-drill registries",
  "description": "Export-safe packet for the operational-readiness-review (ORR) and rehearsal-drill implement lane over the frozen M5 launch-control matrix. It exercises launch-bearing lanes before widening: it carries resolved, honest projections of the ORR / rehearsal-packet domain (how each packet kind — a monthly ORR, a release-candidate ORR, a publish/rollback drill, a mixed-version drill, an advisory/revocation drill, or a support/incident handoff drill — names its readiness scope, its release / advisory / support-room / docs-comms / backup-signer role roster, and its rehearsal-freshness expiry so a stable claim can never widen on a stale, skipped, or contradictory rehearsal packet) and the rehearsal-drill readiness domain (how a launch-bearing lane records the roster coverage — full roster, backup roster, or conditional roster — with the preserved ORR signoff, the named on-call roster state, the rehearsal-freshness state, and the authorized widening stage that justified widening) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved ORR-packet entries (naming a canonical registry token, a stable packet-binding ID, a launch-control role, a classified packet kind, a published readiness scope / role roster / rehearsal-freshness expiry, and canonical/accessible/audit resolution-form coverage while keeping its rehearsal packet current before widening and keeping a public-facing lane's support language matched to rehearsal proof) and resolved rehearsal-drill entries (naming a canonical registry token, a stable drill ref, a launch-control role, a classified roster coverage, and the complete resolved-coverage-identity / rehearsal-evidence-ledger / ORR-signoff / on-call-roster / rehearsal-freshness / widening-stage / last-rehearsal-drill-revision record). Hard invariants forbid widening a stable claim without current ORR and rehearsal evidence, letting a rehearsal packet go stale or skipped before widening, hiding the required role roster or on-call coverage, and implying green when ORR or rehearsal packets are stale. Acceptance criteria — every claimed launch-bearing lane points at current ORR and rehearsal packets; rehearsal freshness and role coverage read as first-class shiproom and release blockers; and stable/LTS promotion halts automatically on affected lanes when rehearsal state is red or stale — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_orr_review_and_rehearsal_drill_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "rehearsal_drill_control_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "rehearsal_drill_control_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "orr_review_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "orr_packet_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "orr_review_packet_kind",
        "orr_review_packet_kind_is_classified",
        "canonical_orr_review_packet_kind_mode",
        "surface_context",
        "readiness_scope_reference",
        "release_owner_reference",
        "advisory_owner_reference",
        "support_room_owner_reference",
        "docs_comms_owner_reference",
        "backup_signer_reference",
        "rehearsal_freshness_reference",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "orr_review_object_complete",
        "bound_to_registry",
        "orr_review_documented_before_widening",
        "requires_documented_exception",
        "attributable_asset_or_approved_exception",
        "degrade_reason",
        "next_action",
        "orr_review_resolves_across_classes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "orr_packet_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "orr_review_packet_kind": { "$ref": "#/$defs/non_empty_string" },
        "orr_review_packet_kind_is_classified": { "type": "boolean" },
        "canonical_orr_review_packet_kind_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "readiness_scope_reference": { "type": "string" },
        "release_owner_reference": { "type": "string" },
        "advisory_owner_reference": { "type": "string" },
        "support_room_owner_reference": { "type": "string" },
        "docs_comms_owner_reference": { "type": "string" },
        "backup_signer_reference": { "type": "string" },
        "rehearsal_freshness_reference": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "orr_review_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "orr_review_documented_before_widening": { "type": "boolean" },
        "requires_documented_exception": { "type": "boolean" },
        "attributable_asset_or_approved_exception": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "orr_review_resolves_across_classes": { "type": "boolean" }
      }
    },
    "rehearsal_drill_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "rehearsal_drill_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "rehearsal_drill_coverage",
        "rehearsal_drill_coverage_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_coverage_identity",
        "evidence_snapshot_ledger",
        "orr_signoff_reference",
        "on_call_roster_state",
        "rehearsal_drill_freshness_state",
        "widening_stage_reference",
        "last_rehearsal_drill_revision",
        "keeps_evidence_snapshot_visible",
        "rehearsal_drill_lineage_is_truthful",
        "override_without_evidence_requested",
        "blocked_until_evidence_linked",
        "lineage_gap_present",
        "lineage_gap_flagged",
        "rehearsal_drill_stays_honest",
        "provides_complete_rehearsal_drill_record",
        "degrade_reason",
        "next_action",
        "rehearsal_drill_safe_on_every_coverage"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "rehearsal_drill_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "rehearsal_drill_coverage": { "$ref": "#/$defs/non_empty_string" },
        "rehearsal_drill_coverage_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_coverage_identity": { "type": "string" },
        "evidence_snapshot_ledger": { "type": "string" },
        "orr_signoff_reference": { "type": "string" },
        "on_call_roster_state": { "type": "string" },
        "rehearsal_drill_freshness_state": { "type": "string" },
        "widening_stage_reference": { "type": "string" },
        "last_rehearsal_drill_revision": { "type": "string" },
        "keeps_evidence_snapshot_visible": { "type": "boolean" },
        "rehearsal_drill_lineage_is_truthful": { "type": "boolean" },
        "override_without_evidence_requested": { "type": "boolean" },
        "blocked_until_evidence_linked": { "type": "boolean" },
        "lineage_gap_present": { "type": "boolean" },
        "lineage_gap_flagged": { "type": "boolean" },
        "rehearsal_drill_stays_honest": { "type": "boolean" },
        "provides_complete_rehearsal_drill_record": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "rehearsal_drill_safe_on_every_coverage": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "orr_review_entries",
        "rehearsal_drill_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_stable_claim_without_current_orr_and_rehearsal_evidence",
        "lets_a_rehearsal_packet_go_stale_or_skipped_before_widening",
        "hides_the_required_role_roster_or_on_call_coverage",
        "implies_green_when_orr_or_rehearsal_packets_are_stale"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
