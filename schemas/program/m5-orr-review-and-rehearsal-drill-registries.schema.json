        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "widens_a_stable_claim_without_current_orr_and_rehearsal_evidence": { "const": false },
        "lets_a_rehearsal_packet_go_stale_or_skipped_before_widening": { "const": false },
        "hides_the_required_role_roster_or_on_call_coverage": { "const": false },
        "implies_green_when_orr_or_rehearsal_packets_are_stale": { "const": false }
      }
    }
  }
}
