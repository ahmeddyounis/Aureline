{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-stable-line-bundle-refresh-audit-and-shipping-line-drift-report-registries.schema.json",
  "title": "Aureline M5 stable-line bundle-refresh-audit and shipping-line-drift-report registries",
  "description": "Export-safe packet for the bundle-refresh-audit and shipping-line-drift-report lane over the frozen M5 stable-line-protection matrix. It keeps onboarding and migration promises honest after launch by carrying resolved, honest projections of the bundle-refresh-audit domain (how an active shipping line audits each claimed bundle it still owns — a launch bundle, an imported-user handoff bundle, or an org-approved bundle — for freshness, reversibility, missing artifacts, and unsupported drift, publishing the exact bundle age, install topology, toolchain envelope, known limits, rollback / reversibility target, and retest posture, plus the required refresh / narrow decision) and the shipping-line-drift-report domain (the machine-readable drift report emitted when a bundle-currentness audit finds shipping-line drift, recording whether the bundle went stale, became non-reversible, or drifted into an unsupported / missing-artifact state, and naming the active drift reason) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved bundle-refresh-audit entries (naming a canonical registry token, a stable line-binding ID, a stable-line-protection role, a classified bundle-refresh-audit kind, a published audit object, and canonical/accessible/audit resolution-form coverage while preserving its rollback / reversibility posture before a claim widens and keeping onboarding / migration / support language matched to a current, reversible bundle) and resolved shipping-line-drift-report entries (naming a canonical registry token, a stable drift-ref, a stable-line-protection role, a classified drift scope, and the complete line-identity / affected-claim / target-train / drift-scope / narrowed-claim / active-drift-reason / last-drift-revision report object). Hard invariants forbid keeping support / certification language ahead of a current, reversible bundle, drifting a shipping line while a claimed bundle is stale or non-reversible, hiding the rollback / reversibility posture before widening, and collapsing distinct drift classes into one lane. Acceptance criteria — a bundle refresh audit exists for each claimed launch or org-approved bundle on the active stable line with exact freshness, reversibility, drift, and missing-artifact truth; stale, unsupported, or non-reversible bundle states cannot stay invisible because they surface as stale-bundle, non-reversible-bundle, or unsupported-bundle drift narrowing the affected onboarding / migration / support claim; and consumers render shipping-line bundle drift or retest state from the audit packet rather than hand-authored prose — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_stable_line_bundle_refresh_audit_and_shipping_line_drift_report_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "bundle_refresh_audit_entry": {
      "type": "object",
      "required": [
