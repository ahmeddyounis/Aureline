{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-cross-actor-constrained-write-enforcement.schema.json",
  "title": "M5 Cross-Actor Constrained-Write Enforcement Packet",
  "description": "Export-safe record binding the six B150 constrained-current-object classes (read-only, generated, policy-locked, managed, projection, captured-snapshot) to the mutation-capable actors (direct edit / save, AI apply, automation recipe, importer, repair, code action) routed through one shared constrained-write gate, proving each actor inherits the same state-class blocked-write reason and the same safe next step (duplicate, detach, overlay, request approval, regenerate) keyed to the object class and never to the actor, that no mutation-capable actor can silently write a constrained object by bypassing direct typing, that the gate fails closed on actor-context drift or when the exact write target cannot be explained truthfully, and that every support / export trace preserves the actor, the blocked reason, and the chosen fallback path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "gate_bindings",
    "downgrade_triggers",
    "actors",
    "trust_review",
    "actor_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_cross_actor_constrained_write_enforcement_registry"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "gate_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "trust_review": { "type": "object" },
    "actor_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "read_only",
        "generated",
        "policy_locked",
        "managed",
        "projection",
        "captured_snapshot"
      ]
    },
    "actor": {
      "type": "string",
      "enum": [
        "direct_edit_save",
        "ai_apply",
        "automation_recipe",
        "importer",
        "repair",
        "code_action"
      ]
    },
    "blocked_write_reason": {
      "type": "string",
      "enum": [
        "read_only_path_not_directly_writable",
        "generated_artifact_regenerate_only",
        "policy_lock_requires_approval",
        "managed_source_requires_detach",
        "projection_requires_overlay_or_detach",
        "captured_snapshot_restore_only"
      ]
    },
    "safe_next_step": {
      "type": "string",
      "enum": [
        "duplicate_to_editable_copy",
        "detach_from_managed_source",
        "create_overlay_patch",
        "request_approval",
        "regenerate_with_preview"
      ]
    },
    "posture": {
      "type": "string",
      "enum": ["enforced_gate", "fail_closed_on_actor_drift", "export_redacted"]
    },
    "parity_state": {
      "type": "string",
      "enum": ["content_preserved", "content_disclosed_narrowed"]
    },
    "fail_closed_reason": {
      "type": "string",
      "enum": ["actor_context_drifted", "exact_write_target_not_truthfully_explainable"]
    },
    "checkpoint_undo_class": {
      "type": "string",
      "enum": [
        "new_copy_leaves_original_intact",
        "detach_checkpoint_restorable",
        "overlay_patch_revertible",
        "approval_request_withdrawable",
        "regenerate_preview_discardable"
      ]
    },
    "gate_action": {
      "type": "string",
      "enum": [
        "inspect_blocked_write_reason",
        "reveal_canonical_source_and_write_target",
        "copy_safe_next_step",
        "open_safe_next_step_review"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "blocked_reason_drift_across_actors",
        "write_disposition_dropped_for_constrained_object",
        "actor_silently_writes_constrained_object_bypassing_direct_typing",
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass",
        "uses_actor_specific_free_form_blocked_reason",
        "leaves_exact_write_target_or_canonical_source_unstated",
        "stops_failing_closed_on_actor_context_drift",
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_constrained_file_state_narrowed"
      ]
    },
    "narrow_reason": {
      "type": "string",
      "enum": ["failed_closed_on_actor_context_drift", "export_redaction_narrowed"]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["resolve_actor_context_then_retry", "open_full_gate_detail"]
    },
    "gate_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_write_reason",
        "write_disposition_word",
        "safe_next_step",
        "checkpoint_undo_class",
        "exact_write_target_word",
        "canonical_source_word",
        "structured_reason_explanation",
        "co_applicable_state_labels"
      ],
      "properties": {
        "blocked_write_reason": { "$ref": "#/$defs/blocked_write_reason" },
        "write_disposition_word": { "type": "string", "minLength": 1 },
        "safe_next_step": { "$ref": "#/$defs/safe_next_step" },
        "checkpoint_undo_class": { "$ref": "#/$defs/checkpoint_undo_class" },
        "exact_write_target_word": { "type": "string", "minLength": 1 },
        "canonical_source_word": { "type": "string", "minLength": 1 },
        "structured_reason_explanation": { "type": "string", "minLength": 1 },
        "co_applicable_state_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "actor_gate_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "blocked_write_reason", "chosen_fallback_path", "gate_posture"],
      "properties": {
        "actor": { "$ref": "#/$defs/actor" },
        "blocked_write_reason": { "$ref": "#/$defs/blocked_write_reason" },
        "chosen_fallback_path": { "$ref": "#/$defs/safe_next_step" },
        "gate_posture": { "$ref": "#/$defs/posture" }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_content_note", "next_action", "next_action_label"],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_content_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "gate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "object_profile_id",
        "object_profile_label",
        "object_class",
        "co_applicable_states",
        "actor",
        "posture",
        "resolution",
        "parity_state",
        "fail_closed_reason",
        "trace",
        "allowed_actions",
        "accessibility_routes",
        "narrow_note",
        "export_detail_note",
        "routed_through_shared_gate",
        "safe_next_step_keyed_to_state_class",
        "silently_writes_constrained_object_bypassing_direct_typing",
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass",
        "uses_actor_specific_free_form_blocked_reason",
        "leaves_exact_write_target_or_canonical_source_unstated",
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "object_profile_id": { "type": "string", "minLength": 1 },
        "object_profile_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "co_applicable_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/object_class" }
        },
        "actor": { "$ref": "#/$defs/actor" },
        "posture": { "$ref": "#/$defs/posture" },
        "resolution": { "$ref": "#/$defs/gate_resolution" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "fail_closed_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fail_closed_reason" }]
        },
        "trace": { "$ref": "#/$defs/actor_gate_trace" },
        "allowed_actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/gate_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "export_detail_note": { "type": "string" },
        "routed_through_shared_gate": { "type": "boolean" },
        "safe_next_step_keyed_to_state_class": { "type": "boolean" },
        "silently_writes_constrained_object_bypassing_direct_typing": { "type": "boolean" },
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass": { "type": "boolean" },
        "uses_actor_specific_free_form_blocked_reason": { "type": "boolean" },
        "leaves_exact_write_target_or_canonical_source_unstated": { "type": "boolean" },
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
