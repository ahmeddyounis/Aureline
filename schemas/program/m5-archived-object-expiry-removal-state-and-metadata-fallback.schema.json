{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-archived-object-expiry-removal-state-and-metadata-fallback.schema.json",
  "title": "M5 Archived-Object Expiry / Removal State and Metadata Fallback",
  "description": "Export-safe record binding the five B149 non-live-evidence object classes (retirement snapshot, captured support / export evidence, archived runbook packet, imported / offline route evidence, review / incident snapshot) to the shell / archive-viewer, help / docs, support, review / incident, runbook-archive, release-center, companion / export, program-governance, and CLI / export surfaces that render a preserved object once its retention window closes, its content is expired or removed, or its live target disappears, proving one canonical expiry / removal vocabulary: every non-available state (expired, removed, retention-window-ended, missing-live-target, metadata-only) carries a stable label and an explicit removal / expiry note that names the reason, keeps rendering capture time, provenance, and the removal / expiry reason instead of a generic dead link, and joins the outcome to a retention / deletion receipt, a retirement closure ledger, and a support packet manifest, while a reviewed remove action appears only where a safe cleanup is appropriate and the open-current-live-object action only when the archive is preserved with a live target, so an expired or removed object is never presented as live or current.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "state_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_archived_evidence_state_registry"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "state_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "retirement_snapshot",
        "support_export_evidence",
        "archived_runbook_packet",
        "imported_offline_route_evidence",
        "review_incident_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "help_docs",
        "support",
        "review_incident",
        "runbook_archive",
        "release_center",
        "companion_export",
        "program_governance",
        "cli_export"
      ]
    },
    "archived_state": {
      "type": "string",
      "enum": [
        "preserved_available",
        "expired",
        "removed",
        "retention_window_ended",
        "missing_live_target",
        "metadata_only"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["archive_state_presented", "removal_or_expiry_disclosed"]
    },
    "archive_state_action": {
      "type": "string",
      "enum": [
        "inspect_metadata",
        "export_evidence",
        "remove_archived_object",
        "open_current_live_object"
      ]
    },
    "removal_expiry_reason": {
      "type": "string",
      "enum": [
        "retention_window_elapsed",
        "manual_cleanup_requested",
        "policy_mandated_deletion",
        "source_live_target_removed",
        "storage_reclaimed",
        "legal_hold_released",
        "metadata_only_by_design"
      ]
    },
    "removal_next_action": {
      "type": "string",
      "enum": ["remove_through_reviewed_cleanup", "inspect_metadata_only"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "state_grammar_drift_detected",
        "mutation_blocked_posture_dropped",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "degrades_to_generic_dead_link",
        "removes_content_without_attribution",
        "presents_expired_or_removed_as_live_or_current",
        "drops_removal_or_expiry_vocabulary_in_export",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_historical_reference_narrowed"
      ]
    },
    "historical_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_role_word",
        "snapshot_label_word",
        "capture_time_word",
        "provenance_word",
        "mutation_blocked_posture_word"
      ],
      "properties": {
        "historical_role_word": { "type": "string", "minLength": 1 },
        "snapshot_label_word": { "type": "string", "minLength": 1 },
        "capture_time_word": { "type": "string", "minLength": 1 },
        "provenance_word": { "type": "string", "minLength": 1 },
        "mutation_blocked_posture_word": { "type": "string", "minLength": 1 }
      }
    },
    "removal_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_or_deletion_receipt_ref",
        "retirement_closure_ledger_ref",
        "support_packet_manifest_ref"
      ],
      "properties": {
        "retention_or_deletion_receipt_ref": { "type": "string", "minLength": 1 },
        "retirement_closure_ledger_ref": { "type": "string", "minLength": 1 },
        "support_packet_manifest_ref": { "type": "string", "minLength": 1 }
      }
    },
    "removal_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "explanation",
        "preserved_metadata_note",
        "removal_attribution",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/removal_expiry_reason" },
        "explanation": { "type": "string", "minLength": 1 },
        "preserved_metadata_note": { "type": "string", "minLength": 1 },
        "removal_attribution": { "$ref": "#/$defs/removal_attribution" },
        "next_action": { "$ref": "#/$defs/removal_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "state_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "snapshot_profile_id",
        "snapshot_profile_label",
        "object_class",
        "consumer",
        "state",
        "state_label",
        "historical_grammar",
        "content_bytes_present",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "removal_note",
        "historical_side_mutation_blocked",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "degrades_to_generic_dead_link",
        "removes_content_without_attribution",
        "presents_expired_or_removed_as_live_or_current",
        "drops_removal_or_expiry_vocabulary_in_export",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "snapshot_profile_id": { "type": "string", "minLength": 1 },
        "snapshot_profile_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "state": { "$ref": "#/$defs/archived_state" },
        "state_label": { "type": "string", "minLength": 1 },
        "historical_grammar": { "$ref": "#/$defs/historical_grammar" },
        "content_bytes_present": { "type": "boolean" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/archive_state_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "removal_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/removal_note" }]
        },
        "historical_side_mutation_blocked": { "type": "boolean" },
        "reopens_live_target_without_validating_identity_trust_route_and_authority": { "type": "boolean" },
        "degrades_to_generic_dead_link": { "type": "boolean" },
        "removes_content_without_attribution": { "type": "boolean" },
        "presents_expired_or_removed_as_live_or_current": { "type": "boolean" },
        "drops_removal_or_expiry_vocabulary_in_export": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
