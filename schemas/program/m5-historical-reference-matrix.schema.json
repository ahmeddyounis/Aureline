{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-historical-reference-matrix.schema.json",
  "title": "Aureline M5 historical-reference, archived-snapshot, imported/offline-evidence, and live-target-handoff matrix",
  "description": "Export-safe packet freezing Aureline's non-live-evidence object model \u2014 the retirement / last-supported snapshots, captured support / export evidence bundles, archived runbook execution packets, imported / offline route evidence, and review / incident snapshots that no longer point at live mutable state. The packet names every covered object class and binds each to the claimed surface families that render it, the capture-lifecycle stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain descriptor / handoff / imported-offline schema, the required visible state (snapshot label, capture time, provenance, live-target availability, imported / offline status, mutation-blocked posture, expiry / removed handling, and live-target handoff or metadata-only exit), and the mandatory labels it must show (identity, historical_role, canonical_reference, plus snapshot_label, capture_time, live_target_availability). The evidence_state field makes captured / archived and imported / offline evidence mechanically distinct from ordinary live objects, read-only cached current state, and restore-capable workspaces. Hard invariants forbid archived or imported / offline evidence looking live / writable / current by omission, reopening a live target from a snapshot without validating identity / trust / route / authority, dead-linking an expired / removed artifact when metadata / provenance / cleanup state can be shown, leaving non-live evidence unjoined to capture time / provenance / retention state / live-target mismatch, and presenting a snapshot or imported packet as a current live object or reopening through an ambiguous route. The matrix binds back to the already-landed stable-proof-index and migration-task-row packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "historical_reference_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_historical_reference_archived_snapshot_imported_offline_evidence_and_live_target_handoff_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "historical_reference_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/historical_reference_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "historical_reference_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "historical_reference_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "retirement_snapshot",
        "support_export_evidence",
        "archived_runbook_packet",
        "imported_offline_route_evidence",
        "review_incident_snapshot"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "evidence_state": {
      "enum": [
        "live_object",
        "cached_current_state",
        "restore_capable_workspace",
        "archived_snapshot",
        "imported_offline_evidence"
      ]
    },
    "semantic_role": {
      "enum": [
        "snapshot_labeling",
        "capture_time_attribution",
        "provenance_attribution",
        "mutation_blocked_posture",
        "live_target_handoff",
        "imported_offline_disclosure",
        "expiry_removal_handling"
      ]
    },
    "required_visible_state": {
      "type": "object",
      "required": [
        "snapshot_label",
        "capture_time",
        "provenance",
        "live_target_availability",
        "imported_offline_status",
        "mutation_blocked_posture",
        "expiry_removal_state",
        "live_target_handoff_or_exit"
      ],
      "properties": {
        "snapshot_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "capture_time": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provenance": {
          "$ref": "#/$defs/non_empty_string"
        },
        "live_target_availability": {
          "$ref": "#/$defs/non_empty_string"
        },
        "imported_offline_status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mutation_blocked_posture": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expiry_removal_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "live_target_handoff_or_exit": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "historical_reference_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "evidence_state",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "required_visible_state",
        "surface_families",
        "capture_lifecycle_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "lets_archived_or_imported_evidence_look_live_writable_or_current_by_omission",
        "reopens_a_live_target_from_a_snapshot_without_validating_identity_trust_route_and_authority",
        "dead_links_an_expired_or_removed_artifact_instead_of_showing_metadata_provenance_or_cleanup_state",
        "leaves_non_live_evidence_unjoined_to_capture_time_provenance_retention_state_or_live_target_mismatch",
        "presents_a_snapshot_or_imported_packet_as_a_current_live_object_or_reopens_through_an_ambiguous_route"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "evidence_state": {
          "$ref": "#/$defs/evidence_state"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_visible_state": {
          "$ref": "#/$defs/required_visible_state"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "capture_lifecycle_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "retirement_snapshot_roles": {
          "type": "array"
        },
        "support_export_evidence_roles": {
          "type": "array"
        },
        "archived_runbook_packet_roles": {
          "type": "array"
        },
        "imported_offline_route_evidence_roles": {
          "type": "array"
        },
        "review_incident_snapshot_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "lets_archived_or_imported_evidence_look_live_writable_or_current_by_omission": {
          "const": false
        },
        "reopens_a_live_target_from_a_snapshot_without_validating_identity_trust_route_and_authority": {
          "const": false
        },
        "dead_links_an_expired_or_removed_artifact_instead_of_showing_metadata_provenance_or_cleanup_state": {
          "const": false
        },
        "leaves_non_live_evidence_unjoined_to_capture_time_provenance_retention_state_or_live_target_mismatch": {
          "const": false
        },
        "presents_a_snapshot_or_imported_packet_as_a_current_live_object_or_reopens_through_an_ambiguous_route": {
          "const": false
        }
      }
    }
  }
}
