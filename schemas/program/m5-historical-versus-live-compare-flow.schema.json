{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-historical-versus-live-compare-flow.schema.json",
  "title": "M5 Historical-versus-Live Compare-Flow Packet",
  "description": "Export-safe record binding the five B149 non-live-evidence object classes (retirement snapshot, captured support / export evidence, archived runbook packet, imported / offline route evidence, review / incident snapshot) to the shell / archive-viewer, help / docs, support, review / incident, runbook-archive, release-center, companion / export, program-governance, and CLI / export surfaces that compare a preserved snapshot against its current live object, proving one canonical compare vocabulary that labels identity, freshness, and drift, discloses approximate / missing / policy-blocked pairings with an explicit mismatch reason instead of a dead end, and never implies that applying or syncing the historical snapshot is safe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "compare_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_historical_versus_live_compare_flow_registry"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "compare_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/compare_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "retirement_snapshot",
        "support_export_evidence",
        "archived_runbook_packet",
        "imported_offline_route_evidence",
        "review_incident_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "help_docs",
        "support",
        "review_incident",
        "runbook_archive",
        "release_center",
        "companion_export",
        "program_governance",
        "cli_export"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "live_target_paired",
        "approximate_pairing",
        "live_target_missing",
        "policy_blocked_pairing"
      ]
    },
    "identity_match_state": {
      "type": "string",
      "enum": ["same_object_identity", "approximate_identity", "identity_unverifiable"]
    },
    "freshness_drift_state": {
      "type": "string",
      "enum": [
        "in_sync_no_drift",
        "snapshot_behind_live",
        "snapshot_diverged_from_live",
        "freshness_unverifiable"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["pair_preserved", "pair_narrowed_disclosed"]
    },
    "compare_action": {
      "type": "string",
      "enum": ["inspect_historical", "export_comparison", "open_current_live_object"]
    },
    "mismatch_reason": {
      "type": "string",
      "enum": [
        "missing_live_target",
        "changed_scope",
        "changed_branch_or_worktree",
        "retired_capability",
        "unsupported_skew"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["open_approximate_pairing_detail", "inspect_historical_packet_only"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "compare_grammar_drift_detected",
        "mutation_blocked_posture_dropped",
        "implies_apply_or_sync_historical_snapshot_safe",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "dead_ends_on_missing_or_mismatched_target",
        "collapses_snapshot_and_live_into_one_ambiguous_view",
        "identity_freshness_or_drift_label_dropped",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_historical_reference_narrowed"
      ]
    },
    "historical_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_role_word",
        "snapshot_label_word",
        "capture_time_word",
        "provenance_word",
        "mutation_blocked_posture_word"
      ],
      "properties": {
        "historical_role_word": { "type": "string", "minLength": 1 },
        "snapshot_label_word": { "type": "string", "minLength": 1 },
        "capture_time_word": { "type": "string", "minLength": 1 },
        "provenance_word": { "type": "string", "minLength": 1 },
        "mutation_blocked_posture_word": { "type": "string", "minLength": 1 }
      }
    },
    "mismatch_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "explanation",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/mismatch_reason" },
        "explanation": { "type": "string", "minLength": 1 },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "reviewed_mutation_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_path_id", "reviewed_path_label"],
      "properties": {
        "reviewed_path_id": { "type": "string", "minLength": 1 },
        "reviewed_path_label": { "type": "string", "minLength": 1 }
      }
    },
    "compare_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "snapshot_profile_id",
        "snapshot_profile_label",
        "object_class",
        "consumer",
        "outcome",
        "historical_grammar",
        "identity_match_state",
        "freshness_drift_state",
        "drift_summary",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "mismatch_note",
        "reviewed_mutation_handoff",
        "historical_side_mutation_blocked",
        "collapses_snapshot_and_live_into_one_ambiguous_view",
        "implies_apply_or_sync_historical_snapshot_is_safe",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "dead_ends_on_missing_or_mismatched_target",
        "leaves_historical_side_mutable_or_unlabeled",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "snapshot_profile_id": { "type": "string", "minLength": 1 },
        "snapshot_profile_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "historical_grammar": { "$ref": "#/$defs/historical_grammar" },
        "identity_match_state": { "$ref": "#/$defs/identity_match_state" },
        "freshness_drift_state": { "$ref": "#/$defs/freshness_drift_state" },
        "drift_summary": { "type": "string", "minLength": 1 },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/compare_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "mismatch_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/mismatch_note" }]
        },
        "reviewed_mutation_handoff": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reviewed_mutation_handoff" }]
        },
        "historical_side_mutation_blocked": { "type": "boolean" },
        "collapses_snapshot_and_live_into_one_ambiguous_view": { "type": "boolean" },
        "implies_apply_or_sync_historical_snapshot_is_safe": { "type": "boolean" },
        "reopens_live_target_without_validating_identity_trust_route_and_authority": { "type": "boolean" },
        "dead_ends_on_missing_or_mismatched_target": { "type": "boolean" },
        "leaves_historical_side_mutable_or_unlabeled": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
