{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-constrained-state-drill-corpus.schema.json",
  "title": "M5 Constrained-State Drill Corpus",
  "description": "Export-safe seeded corpus of mixed-state fixtures and regression drills over the six B150 constrained-current-object classes (read-only, generated, policy-locked, managed, projection, captured-snapshot). Each binding seeds one constrained-object fixture (a read-only alias path, a generated / derived artifact, a policy-locked managed mirror, a projection / virtual view, a managed source, or a captured workspace snapshot) exercised by one of nine drills covering the problematic transitions (symlink / alias save, generated-artifact drift, policy-locked managed mirror, projection export, captured snapshot in the current workspace, managed-mirror round trip, and the read-only + generated, generated + policy-locked, and managed + captured-snapshot mixed-state combinations) on one downstream consumer surface. Every binding attempts a direct write, watches it be denied, and routes to exactly the reviewed fallback path (duplicate to an editable copy, regenerate with preview, request approval, detach from the managed source, or create an overlay patch) keyed to the object class; names the blocked-write reason, chosen fallback path, required write disposition, and checkpoint / undo class so QA / support automation can replay a denial and its chosen fallback; carries the controlled constrained-state grammar (state-role, state-class label, blocked-write reason, canonical source, exact write target, write disposition) identical for one fixture across surfaces; joins its canonical source and exact write target; and binds back to screenshots, an accessibility check, the CLI / support export, and the health dashboard so the corpus is discoverable from release and support evidence rather than an ad hoc local sample set. No drill silently falls back to a lossy direct write, lets one state class hide another, gives AI / automation / import / repair a hidden bypass, or presents a constrained object as directly writable while hiding the recovery / regenerate path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "drill_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_constrained_state_drill_corpus"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "drill_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/drill_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "read_only",
        "generated",
        "policy_locked",
        "managed",
        "projection",
        "captured_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "tab_chrome",
        "breadcrumb_trail",
        "status_bar",
        "command_palette",
        "editor_banner",
        "diff_review_header",
        "write_review_sheet",
        "ai_automation_path",
        "support_export_packet"
      ]
    },
    "drill": {
      "type": "string",
      "enum": [
        "symlink_alias_save_denied",
        "generated_artifact_drift_denied",
        "policy_locked_managed_mirror_denied",
        "projection_export_denied",
        "captured_snapshot_in_workspace_denied",
        "managed_mirror_round_trip_denied",
        "read_only_generated_overlay_denied",
        "generated_policy_locked_regen_denied",
        "managed_captured_snapshot_restore_denied"
      ]
    },
    "blocked_write_reason": {
      "type": "string",
      "enum": [
        "read_only_path_not_directly_writable",
        "generated_artifact_regenerate_only",
        "policy_lock_requires_approval",
        "managed_source_requires_detach",
        "projection_requires_overlay_or_detach",
        "captured_snapshot_restore_only"
      ]
    },
    "fallback_path": {
      "type": "string",
      "enum": [
        "duplicate_to_editable_copy",
        "detach_from_managed_source",
        "create_overlay_patch",
        "request_approval",
        "regenerate_with_preview"
      ]
    },
    "write_disposition": {
      "type": "string",
      "enum": [
        "directly_writable",
        "read_only_blocked",
        "regenerate_only",
        "approval_gated",
        "detach_required",
        "restore_only"
      ]
    },
    "checkpoint_undo_class": {
      "type": "string",
      "enum": [
        "new_copy_leaves_original_intact",
        "detach_checkpoint_restorable",
        "overlay_patch_revertible",
        "approval_request_withdrawable",
        "regenerate_preview_discardable"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["single_state_direct_write_denied", "mixed_state_both_facets_visible"]
    },
    "drill_action": {
      "type": "string",
      "enum": [
        "inspect_blocked_write_reason",
        "export_denial_evidence",
        "open_reviewed_fallback_path"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "grammar_drift_detected",
        "constrained_state_classification_dropped",
        "blocked_reason_class_mismatch",
        "fallback_reason_mismatch",
        "silent_lossy_direct_write_observed",
        "hidden_second_state_observed",
        "cross_surface_disagreement_observed",
        "canonical_source_or_write_target_missing",
        "ai_automation_bypass_observed",
        "corpus_evidence_bindings_missing",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_constrained_file_state_narrowed"
      ]
    },
    "constrained_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_role_word",
        "state_class_label_word",
        "blocked_write_reason_word",
        "canonical_source_word",
        "exact_write_target_word",
        "write_disposition_word"
      ],
      "properties": {
        "state_role_word": { "type": "string", "minLength": 1 },
        "state_class_label_word": { "type": "string", "minLength": 1 },
        "blocked_write_reason_word": { "type": "string", "minLength": 1 },
        "canonical_source_word": { "type": "string", "minLength": 1 },
        "exact_write_target_word": { "type": "string", "minLength": 1 },
        "write_disposition_word": { "type": "string", "minLength": 1 }
      }
    },
    "canonical_source_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source_ref",
        "exact_write_target_ref",
        "owning_authority_ref",
        "preserved_versus_lost_sync_ref"
      ],
      "properties": {
        "canonical_source_ref": { "type": "string", "minLength": 1 },
        "exact_write_target_ref": { "type": "string", "minLength": 1 },
        "owning_authority_ref": { "type": "string", "minLength": 1 },
        "preserved_versus_lost_sync_ref": { "type": "string", "minLength": 1 }
      }
    },
    "denial_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_write_reason",
        "chosen_fallback_path",
        "required_write_disposition",
        "checkpoint_undo_class",
        "reviewed_fallback_ref",
        "co_applicable_state_ref",
        "denial_note"
      ],
      "properties": {
        "blocked_write_reason": { "$ref": "#/$defs/blocked_write_reason" },
        "chosen_fallback_path": { "$ref": "#/$defs/fallback_path" },
        "required_write_disposition": { "$ref": "#/$defs/write_disposition" },
        "checkpoint_undo_class": { "$ref": "#/$defs/checkpoint_undo_class" },
        "reviewed_fallback_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "co_applicable_state_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "denial_note": { "type": "string", "minLength": 1 }
      }
    },
    "corpus_evidence_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screenshot_ref",
        "accessibility_check_ref",
        "cli_support_export_ref",
        "health_dashboard_ref"
      ],
      "properties": {
        "screenshot_ref": { "type": "string", "minLength": 1 },
        "accessibility_check_ref": { "type": "string", "minLength": 1 },
        "cli_support_export_ref": { "type": "string", "minLength": 1 },
        "health_dashboard_ref": { "type": "string", "minLength": 1 }
      }
    },
    "drill_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "fixture_id",
        "fixture_label",
        "object_class",
        "co_applicable_object_class",
        "consumer",
        "drill",
        "drill_label",
        "blocked_write_reason",
        "chosen_fallback_path",
        "write_disposition",
        "checkpoint_undo_class",
        "constrained_grammar",
        "is_mixed_state",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "canonical_source_join",
        "denial_expectation",
        "corpus_evidence",
        "constrained_state_explicitly_classified",
        "both_state_facets_visible_when_mixed",
        "lets_one_constrained_state_class_hide_another",
        "silently_falls_back_to_lossy_direct_write",
        "gives_ai_automation_import_or_repair_a_hidden_bypass",
        "leaves_canonical_source_or_exact_write_target_unstated",
        "presents_as_directly_writable_or_hides_recovery_path",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "fixture_id": { "type": "string", "minLength": 1 },
        "fixture_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "co_applicable_object_class": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/object_class" }]
        },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "drill": { "$ref": "#/$defs/drill" },
        "drill_label": { "type": "string", "minLength": 1 },
        "blocked_write_reason": { "$ref": "#/$defs/blocked_write_reason" },
        "chosen_fallback_path": { "$ref": "#/$defs/fallback_path" },
        "write_disposition": { "$ref": "#/$defs/write_disposition" },
        "checkpoint_undo_class": { "$ref": "#/$defs/checkpoint_undo_class" },
        "constrained_grammar": { "$ref": "#/$defs/constrained_grammar" },
        "is_mixed_state": { "type": "boolean" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/drill_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "canonical_source_join": { "$ref": "#/$defs/canonical_source_join" },
        "denial_expectation": { "$ref": "#/$defs/denial_expectation" },
        "corpus_evidence": { "$ref": "#/$defs/corpus_evidence_bindings" },
        "constrained_state_explicitly_classified": { "type": "boolean" },
        "both_state_facets_visible_when_mixed": { "type": "boolean" },
        "lets_one_constrained_state_class_hide_another": { "type": "boolean" },
        "silently_falls_back_to_lossy_direct_write": { "type": "boolean" },
        "gives_ai_automation_import_or_repair_a_hidden_bypass": { "type": "boolean" },
        "leaves_canonical_source_or_exact_write_target_unstated": { "type": "boolean" },
        "presents_as_directly_writable_or_hides_recovery_path": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
