{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-write-review-sheet-fallback-paths.schema.json",
  "title": "M5 Write-Review-Sheet Fallback-Path Packet",
  "description": "Export-safe record binding the six B150 constrained-current-object classes (read-only, generated, policy-locked, managed, projection, captured-snapshot) to the five reviewed fallback transitions (duplicate to an editable copy, detach from a managed source, create an overlay patch, request approval, regenerate with preview) and the direct-save, code-action, AI-apply, importer, repair, and batch-edit flows that reuse one write-review sheet, proving each fallback path is reviewed before commit with an exact write target, side effects, preserved-versus-lost sync or regenerate path, required approvals, checkpoint / undo class, and export-safe explanation, and that no constrained write silently mutates the current object through a lossy fallback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "review_bindings",
    "downgrade_triggers",
    "originating_flows",
    "trust_review",
    "flow_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_write_review_sheet_fallback_path_registry"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "review_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "originating_flows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/originating_flow" }
    },
    "trust_review": { "type": "object" },
    "flow_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "read_only",
        "generated",
        "policy_locked",
        "managed",
        "projection",
        "captured_snapshot"
      ]
    },
    "originating_flow": {
      "type": "string",
      "enum": [
        "direct_save",
        "code_action",
        "ai_apply",
        "importer",
        "repair",
        "batch_edit"
      ]
    },
    "fallback_action": {
      "type": "string",
      "enum": [
        "duplicate_to_editable_copy",
        "detach_from_managed_source",
        "create_overlay_patch",
        "request_approval",
        "regenerate_with_preview"
      ]
    },
    "posture": {
      "type": "string",
      "enum": ["full_review_sheet", "precondition_notice_compact", "export_redacted"]
    },
    "parity_state": {
      "type": "string",
      "enum": ["content_preserved", "content_disclosed_narrowed"]
    },
    "checkpoint_undo_class": {
      "type": "string",
      "enum": [
        "new_copy_leaves_original_intact",
        "detach_checkpoint_restorable",
        "overlay_patch_revertible",
        "approval_request_withdrawable",
        "regenerate_preview_discardable"
      ]
    },
    "write_review_action": {
      "type": "string",
      "enum": [
        "inspect_write_target",
        "copy_preserved_versus_lost",
        "reveal_canonical_source",
        "commit_reviewed_transition"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "review_content_drift_detected",
        "write_disposition_dropped_for_constrained_object",
        "silently_mutates_current_object_through_lossy_fallback",
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass",
        "leaves_exact_write_target_or_preserved_versus_lost_sync_unstated",
        "hides_recovery_or_undo_class_before_commit",
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_constrained_file_state_narrowed"
      ]
    },
    "narrow_reason": {
      "type": "string",
      "enum": ["compacted_to_precondition_notice", "export_redaction_narrowed"]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["open_full_review_sheet", "open_full_detail"]
    },
    "preserved_versus_lost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained", "lost", "sync_or_regenerate_path"],
      "properties": {
        "retained": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "lost": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sync_or_regenerate_path": { "type": "string", "minLength": 1 }
      }
    },
    "review_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "write_target_word",
        "write_disposition_word",
        "side_effect_words",
        "preserved_versus_lost",
        "required_approval_words",
        "checkpoint_undo_class",
        "canonical_source_word",
        "export_safe_explanation",
        "co_applicable_state_labels"
      ],
      "properties": {
        "write_target_word": { "type": "string", "minLength": 1 },
        "write_disposition_word": { "type": "string", "minLength": 1 },
        "side_effect_words": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "preserved_versus_lost": { "$ref": "#/$defs/preserved_versus_lost" },
        "required_approval_words": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checkpoint_undo_class": { "$ref": "#/$defs/checkpoint_undo_class" },
        "canonical_source_word": { "type": "string", "minLength": 1 },
        "export_safe_explanation": { "type": "string", "minLength": 1 },
        "co_applicable_state_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_content_note", "next_action", "next_action_label"],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_content_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "review_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "object_profile_id",
        "object_profile_label",
        "object_class",
        "co_applicable_states",
        "fallback_action",
        "originating_flow",
        "posture",
        "review_content",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "narrow_note",
        "export_detail_note",
        "reviewed_before_commit",
        "recovery_visible_before_commit",
        "silently_mutates_current_object_through_lossy_fallback",
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass",
        "leaves_exact_write_target_or_preserved_versus_lost_sync_unstated",
        "hides_recovery_or_undo_class_before_commit",
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "object_profile_id": { "type": "string", "minLength": 1 },
        "object_profile_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "co_applicable_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/object_class" }
        },
        "fallback_action": { "$ref": "#/$defs/fallback_action" },
        "originating_flow": { "$ref": "#/$defs/originating_flow" },
        "posture": { "$ref": "#/$defs/posture" },
        "review_content": { "$ref": "#/$defs/review_content" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/write_review_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "export_detail_note": { "type": "string" },
        "reviewed_before_commit": { "type": "boolean" },
        "recovery_visible_before_commit": { "type": "boolean" },
        "silently_mutates_current_object_through_lossy_fallback": { "type": "boolean" },
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass": { "type": "boolean" },
        "leaves_exact_write_target_or_preserved_versus_lost_sync_unstated": { "type": "boolean" },
        "hides_recovery_or_undo_class_before_commit": { "type": "boolean" },
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
