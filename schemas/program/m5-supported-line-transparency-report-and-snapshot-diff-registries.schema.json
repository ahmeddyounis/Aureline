{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-supported-line-transparency-report-and-snapshot-diff-registries.schema.json",
  "title": "Aureline M5 transparency-report and snapshot-diff registries",
  "description": "Export-safe packet for the transparency-report and snapshot-diff lane over the frozen M5 supported-line-transparency matrix. It turns maintainer / upstream durability into support-line-safe product truth by carrying resolved, honest projections of the transparency-report domain (the export-safe report published per active supported line — one typed section per upstream-health dimension: critical-upstream status, backup maintainer coverage, signer-quorum health, emergency-authority coverage, sustainment / sponsor posture, and unresolved red-risk dependencies — each bound to one supported-line identity with public-safe health separated from internal-only incident / security detail) and the snapshot-diff domain (the typed diff event naming whether a report section moved to a worse or better health state versus the prior published snapshot, narrowed its maintainer / signer / authority coverage, or surfaced a new or changed unresolved red-risk dependency, naming the active diff reason) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved transparency-report entries (naming a canonical registry token, a stable line-binding ID, a transparency role, a classified report section, a published report object linking critical-upstream / maintainer-coverage / signing-quorum / emergency-authority / sustainment refs, and canonical/accessible/audit resolution-form coverage while preserving its posture before a claim widens and keeping support language matched to current public proof) and resolved snapshot-diff entries (naming a canonical registry token, a stable diff-ref, a transparency role, a classified diff scope, and the complete line-identity / affected-report-section / previous-versus-current-snapshot / diff-scope / active-reason diff object). Hard invariants forbid keeping support / certification language ahead of current public proof, widening a supported line on stale health, hiding the reversibility target before widening, and collapsing distinct diff classes into one lane. Acceptance criteria — at least one export-safe transparency report exists for active supported lines linked to the critical-upstream register, maintainer coverage matrix, and signing-quorum records; a red-risk upstream or signing gap automatically surfaces on the affected line rather than staying hidden in repository-maintenance notes; and public-safe and internal-only variants share one canonical record identity and do not diverge on core supported-line facts — are proven by the resolved examples, not merely asserted. Raw secret values, private endpoints, and privileged incident / security internals never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_supported_line_transparency_report_and_snapshot_diff_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "transparency_report_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "line_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "report_section",
        "report_section_is_classified",
        "canonical_report_section_mode",
        "surface_context",
        "exact_repo_journey_rows",
        "bundle_ids",
        "install_topology",
        "toolchain_envelope",
        "known_limits",
        "rollback_target",
        "diagnostics_posture",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "transparency_report_object_complete",
        "bound_to_registry",
        "rollback_and_diagnostics_bounded",
        "is_public_facing_line",
        "support_language_matches_line_proof",
        "degrade_reason",
        "next_action",
        "transparency_report_resolves_across_lines"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "line_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "report_section": { "$ref": "#/$defs/non_empty_string" },
        "report_section_is_classified": { "type": "boolean" },
        "canonical_report_section_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exact_repo_journey_rows": { "type": "string" },
        "bundle_ids": { "type": "string" },
        "install_topology": { "type": "string" },
        "toolchain_envelope": { "type": "string" },
        "known_limits": { "type": "string" },
        "rollback_target": { "type": "string" },
        "diagnostics_posture": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "transparency_report_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "rollback_and_diagnostics_bounded": { "type": "boolean" },
        "is_public_facing_line": { "type": "boolean" },
        "support_language_matches_line_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "transparency_report_resolves_across_lines": { "type": "boolean" }
      }
    },
    "snapshot_diff_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "comparison_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "comparison_scope",
        "comparison_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_line_identity",
        "known_limits_ledger",
        "rollback_target_reference",
        "rehearsal_currency_state",
        "readiness_signoff_state",
        "support_language_reference",
        "last_widening_revision",
        "keeps_snapshot_diff_visible",
        "comparison_is_truthful",
        "support_language_present",
        "support_language_bound_to_proof",
        "known_limits_gap_present",
        "known_limits_gap_flagged",
        "snapshot_diff_stays_honest",
        "provides_complete_snapshot_diff",
        "degrade_reason",
        "next_action",
        "comparison_safe_on_every_line"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "comparison_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "comparison_scope": { "$ref": "#/$defs/non_empty_string" },
        "comparison_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_line_identity": { "type": "string" },
        "known_limits_ledger": { "type": "string" },
        "rollback_target_reference": { "type": "string" },
        "rehearsal_currency_state": { "type": "string" },
        "readiness_signoff_state": { "type": "string" },
        "support_language_reference": { "type": "string" },
        "last_widening_revision": { "type": "string" },
        "keeps_snapshot_diff_visible": { "type": "boolean" },
        "comparison_is_truthful": { "type": "boolean" },
        "support_language_present": { "type": "boolean" },
        "support_language_bound_to_proof": { "type": "boolean" },
        "known_limits_gap_present": { "type": "boolean" },
        "known_limits_gap_flagged": { "type": "boolean" },
        "snapshot_diff_stays_honest": { "type": "boolean" },
        "provides_complete_snapshot_diff": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "comparison_safe_on_every_line": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "transparency_report_entries",
        "snapshot_diff_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_line_without_current_rollback_and_diagnostics_downgrade",
        "runs_partner_or_public_support_language_ahead_of_line_proof",
        "hides_the_rollback_target_or_diagnostics_posture_before_widening",
        "collapses_distinct_snapshot_diff_classes_into_one_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "transparency_report_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transparency_report_entry" }
        },
        "snapshot_diff_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/snapshot_diff_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "widens_a_line_without_current_rollback_and_diagnostics_downgrade": { "const": false },
        "runs_partner_or_public_support_language_ahead_of_line_proof": { "const": false },
        "hides_the_rollback_target_or_diagnostics_posture_before_widening": { "const": false },
        "collapses_distinct_snapshot_diff_classes_into_one_lane": { "const": false }
      }
    }
  }
}
