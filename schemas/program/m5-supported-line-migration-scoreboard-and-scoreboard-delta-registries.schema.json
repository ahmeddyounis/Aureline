{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-supported-line-migration-scoreboard-and-scoreboard-delta-registries.schema.json",
  "title": "Aureline M5 migration-scoreboard and scoreboard-delta registries",
  "description": "Export-safe packet for the migration-scoreboard and scoreboard-delta lane over the frozen M5 supported-line-transparency matrix. It keeps post-launch migration and switching promises tied to real field outcomes rather than frozen launch-time confidence by carrying resolved, honest projections of the migration-scoreboard domain (the versioned, scored migration scoreboard published per active supported line — one typed row per importer / bridge outcome class: cleanly imported, translated to an equivalent, partially imported, shimmed through a compatibility shim, unsupported item category, and rollback-cleanliness result, tracked by source tool / version / archetype — each bound to one supported-line identity with rollback cleanliness, docs/help parity, and linked compatibility evidence, public-safe outcome classes separated from internal-only migration detail) and the scoreboard-delta domain (the typed periodic delta event naming whether post-launch field pain is clustering in an outcome class or source archetype, the unsupported-item categories are accumulating, or a docs/help gap or rollback failure is accumulating versus the last published scoreboard, naming the active delta reason) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved migration-scoreboard entries (naming a canonical registry token, a stable line-binding ID, a transparency role, a classified outcome class, a published scoreboard object linking compatibility-report / known-limits / docs-help / migration-pack refs, and canonical/accessible/audit resolution-form coverage while preserving its rollback posture before a claim widens and keeping replacement-grade language matched to current migration truth) and resolved scoreboard-delta entries (naming a canonical registry token, a stable delta-ref, a transparency role, a classified delta scope, and the complete line-identity / affected-scoreboard-section / previous-versus-current-scoreboard / delta-scope / active-reason delta object). Hard invariants forbid keeping replacement-grade / switching language ahead of current migration truth, widening a supported line on drifted migration truth, hiding the rollback target before widening, and collapsing distinct delta classes into one lane. Acceptance criteria — a versioned migration scoreboard exists for at least one active supported line showing importer/bridge outcome classes, rollback cleanliness, docs/help parity, and linked compatibility evidence; claim-state or support-language changes can cite scoreboard data instead of anecdotal support threads; and migration docs/help owners can identify concrete deltas between the last published scoreboard and the current one without reconstructing data manually — are proven by the resolved examples, not merely asserted. Raw secret values, private endpoints, and privileged incident / security internals never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_supported_line_migration_scoreboard_and_scoreboard_delta_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "migration_scoreboard_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "line_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "report_section",
        "report_section_is_classified",
        "canonical_report_section_mode",
        "surface_context",
        "exact_repo_journey_rows",
        "bundle_ids",
        "install_topology",
        "toolchain_envelope",
        "known_limits",
        "rollback_target",
        "diagnostics_posture",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "migration_scoreboard_object_complete",
        "bound_to_registry",
        "rollback_and_diagnostics_bounded",
        "is_public_facing_line",
        "support_language_matches_line_proof",
        "degrade_reason",
        "next_action",
        "migration_scoreboard_resolves_across_lines"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "line_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "report_section": { "$ref": "#/$defs/non_empty_string" },
        "report_section_is_classified": { "type": "boolean" },
        "canonical_report_section_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exact_repo_journey_rows": { "type": "string" },
        "bundle_ids": { "type": "string" },
        "install_topology": { "type": "string" },
        "toolchain_envelope": { "type": "string" },
        "known_limits": { "type": "string" },
        "rollback_target": { "type": "string" },
        "diagnostics_posture": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "migration_scoreboard_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "rollback_and_diagnostics_bounded": { "type": "boolean" },
        "is_public_facing_line": { "type": "boolean" },
        "support_language_matches_line_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "migration_scoreboard_resolves_across_lines": { "type": "boolean" }
      }
    },
    "scoreboard_delta_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "comparison_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "comparison_scope",
        "comparison_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_line_identity",
        "known_limits_ledger",
        "rollback_target_reference",
        "rehearsal_currency_state",
        "readiness_signoff_state",
        "support_language_reference",
        "last_widening_revision",
        "keeps_scoreboard_delta_visible",
        "comparison_is_truthful",
        "support_language_present",
        "support_language_bound_to_proof",
        "known_limits_gap_present",
        "known_limits_gap_flagged",
        "scoreboard_delta_stays_honest",
        "provides_complete_scoreboard_delta",
        "degrade_reason",
        "next_action",
        "comparison_safe_on_every_line"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "comparison_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "comparison_scope": { "$ref": "#/$defs/non_empty_string" },
        "comparison_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_line_identity": { "type": "string" },
        "known_limits_ledger": { "type": "string" },
        "rollback_target_reference": { "type": "string" },
        "rehearsal_currency_state": { "type": "string" },
        "readiness_signoff_state": { "type": "string" },
        "support_language_reference": { "type": "string" },
        "last_widening_revision": { "type": "string" },
        "keeps_scoreboard_delta_visible": { "type": "boolean" },
        "comparison_is_truthful": { "type": "boolean" },
        "support_language_present": { "type": "boolean" },
        "support_language_bound_to_proof": { "type": "boolean" },
        "known_limits_gap_present": { "type": "boolean" },
        "known_limits_gap_flagged": { "type": "boolean" },
        "scoreboard_delta_stays_honest": { "type": "boolean" },
        "provides_complete_scoreboard_delta": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "comparison_safe_on_every_line": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "migration_scoreboard_entries",
        "scoreboard_delta_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_line_without_current_rollback_and_diagnostics_downgrade",
        "runs_partner_or_public_support_language_ahead_of_line_proof",
        "hides_the_rollback_target_or_diagnostics_posture_before_widening",
        "collapses_distinct_scoreboard_delta_classes_into_one_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "migration_scoreboard_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/migration_scoreboard_entry" }
        },
        "scoreboard_delta_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scoreboard_delta_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "widens_a_line_without_current_rollback_and_diagnostics_downgrade": { "const": false },
        "runs_partner_or_public_support_language_ahead_of_line_proof": { "const": false },
        "hides_the_rollback_target_or_diagnostics_posture_before_widening": { "const": false },
        "collapses_distinct_scoreboard_delta_classes_into_one_lane": { "const": false }
      }
    }
  }
}
