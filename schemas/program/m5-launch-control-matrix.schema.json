{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-launch-control-matrix.schema.json",
  "title": "Aureline M5 dogfood-ring, certification-cohort, ORR, rehearsal, freeze-exception, and go/no-go control matrix",
  "description": "Export-safe packet freezing Aureline's concrete launch-control model — its cohort taxonomy, readiness events, rehearsal cadence, freeze-exception packets, and explicit go/no-go decisions. The packet names every claimed M5 launch-bearing lane — the core-team canary cohort, the design-partner preview cohort, the extension-author cohort, the public preview cohort, and the certified-archetype cohort — and binds each governed cohort to the claimed surface families that render it (shiproom, release-center, executive-steering, public-proof, docs/help, support-export), the widening stages it must gate (alpha, beta, release_candidate, stable, long_term_support), the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each cohort declares the controlled vocabularies it carries: the single controlled launch-control-role vocabulary consumers bind to (cohort_membership, readiness_event, rehearsal_currency, freeze_exception_authority, go_no_go_authority, rollback_stop, regression_asset), plus cohort-specific core-team-canary roles, design-partner-preview roles, extension-author roles, public-preview roles, and certified-archetype roles. Hard invariants forbid widening a stable claim without current cohort and rehearsal evidence, letting a freeze exception become undocumented scope widening, closing a Sev-1/Sev-2 incident without a regression asset, implying green when go/no-go records or ORR packets are stale, and maintaining partner or public support language that outruns current cohort proof. The matrix binds back to the already-landed cohort-scoreboard and freeze-exception packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "launch_control_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_dogfood_ring_certification_cohort_orr_rehearsal_freeze_exception_and_go_no_go_control_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "launch_control_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/launch_control_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "launch_control_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "launch_control_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "cohort_class": {
      "enum": [
        "core_team_canary",
        "design_partner_preview",
        "extension_author",
        "public_preview",
        "certified_archetype"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "cohort_membership",
        "readiness_event",
        "rehearsal_currency",
        "freeze_exception_authority",
        "go_no_go_authority",
        "rollback_stop",
        "regression_asset"
      ]
    },
    "launch_control_row": {
      "type": "object",
      "required": [
        "cohort_class",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "widening_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_stable_claim_without_current_cohort_and_rehearsal_evidence",
        "lets_a_freeze_exception_become_undocumented_scope_widening",
        "closes_a_sev_one_or_sev_two_incident_without_a_regression_asset",
        "implies_green_when_go_no_go_records_or_orr_packets_are_stale",
        "maintains_partner_or_public_support_language_that_outruns_current_cohort_proof"
      ],
      "properties": {
        "cohort_class": {
          "$ref": "#/$defs/cohort_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "widening_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "core_team_canary_roles": {
          "type": "array"
        },
        "design_partner_preview_roles": {
          "type": "array"
        },
        "extension_author_roles": {
          "type": "array"
        },
        "public_preview_roles": {
          "type": "array"
        },
        "certified_archetype_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "widens_a_stable_claim_without_current_cohort_and_rehearsal_evidence": {
          "const": false
        },
        "lets_a_freeze_exception_become_undocumented_scope_widening": {
          "const": false
        },
        "closes_a_sev_one_or_sev_two_incident_without_a_regression_asset": {
          "const": false
        },
        "implies_green_when_go_no_go_records_or_orr_packets_are_stale": {
          "const": false
        },
        "maintains_partner_or_public_support_language_that_outruns_current_cohort_proof": {
          "const": false
        }
      }
    }
  }
}
