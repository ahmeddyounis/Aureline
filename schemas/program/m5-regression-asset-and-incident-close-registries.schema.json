{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-regression-asset-and-incident-close-registries.schema.json",
  "title": "Aureline M5 regression-asset and incident-close registries",
  "description": "Export-safe packet for the regression-asset and incident-close implement lane over the frozen M5 launch-control matrix. It carries resolved, honest projections of the regression-asset domain (how each regression asset type — canary, broad internal dogfood, design-partner preview, public preview, and certified stable — declares its minimum entry evidence, soak-window expectation, why widening is allowed, its known-limits packet, issue-template linkage, claim-narrowing action, and the incident-close reference that immediately stops it) and the incident-close domain (how a launch-bearing lane records the incident-close condition — a crash / data-loss / trust defect, a repeated protected-metric regression, or a stale readiness packet — that halts regression asset while it is active) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved regression-asset entries (naming a canonical registry token, a stable transition-binding ID, a launch-control role, a classified regression asset type, a published minimum entry evidence / soak-window expectation / widening-allow rationale / issue-template ref / known limits / claim-narrowing action / incident-close reference, and canonical/accessible/audit resolution-form coverage while keeping its known-limits and incident-close posture visible before widening and keeping a public-facing ring's support language matched to ring proof) and resolved incident-close entries (naming a canonical registry token, a stable stop-condition ref, a launch-control role, a classified incident-close condition, and the complete transition-identity / active-stop-condition-ledger / incident-close-target / protected-metric-regression / packet-freshness / crash-data-loss-or-trust / last-ring-transition-revision incident-close object). Hard invariants forbid advancing a ring without current known-limits and incident-close evidence, running partner or public support language ahead of ring proof, hiding the known-limits or incident-close posture before widening, and collapsing distinct incident-close condition classes into one lane. Acceptance criteria — every ring transition can state why widening is allowed and what immediately stops it; known-limits and rollback posture are visible before any ring widens; and regression asset cannot advance on a claimed lane when incident-close conditions are active — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_regression_asset_and_incident_close_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "incident_control_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "incident_control_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "regression_asset_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "asset_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "regression_asset_type",
        "regression_asset_type_is_classified",
        "canonical_regression_asset_type_mode",
        "surface_context",
        "exact_build_reference",
        "affected_row_reference",
        "cohort_ring_reference",
        "workaround_lineage",
        "regression_asset_reference",
        "approved_exception_reference",
        "close_blocker_reference",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "regression_asset_object_complete",
        "bound_to_registry",
        "regression_asset_linked_before_closure",
        "is_severe_incident",
        "attributable_asset_or_approved_exception",
        "degrade_reason",
        "next_action",
        "regression_asset_resolves_across_types"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "asset_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "regression_asset_type": { "$ref": "#/$defs/non_empty_string" },
        "regression_asset_type_is_classified": { "type": "boolean" },
        "canonical_regression_asset_type_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exact_build_reference": { "type": "string" },
        "affected_row_reference": { "type": "string" },
        "cohort_ring_reference": { "type": "string" },
        "workaround_lineage": { "type": "string" },
        "regression_asset_reference": { "type": "string" },
        "approved_exception_reference": { "type": "string" },
        "close_blocker_reference": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "regression_asset_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "regression_asset_linked_before_closure": { "type": "boolean" },
        "is_severe_incident": { "type": "boolean" },
        "attributable_asset_or_approved_exception": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "regression_asset_resolves_across_types": { "type": "boolean" }
      }
    },
    "incident_close_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "incident_close_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "incident_severity",
        "incident_severity_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_incident_identity",
        "linked_regression_asset_ledger",
        "exact_build_and_row_reference",
        "cohort_ring_lineage_state",
        "close_lineage_freshness_state",
        "workaround_lineage_reference",
        "last_incident_close_revision",
        "keeps_incident_lineage_visible",
        "close_lineage_is_truthful",
        "close_without_asset_requested",
        "close_blocked_until_asset_linked",
        "lineage_gap_present",
        "lineage_gap_flagged",
        "incident_close_stays_honest",
        "provides_complete_incident_close_record",
        "degrade_reason",
        "next_action",
        "incident_close_safe_on_every_severity"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "incident_close_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "incident_severity": { "$ref": "#/$defs/non_empty_string" },
        "incident_severity_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_incident_identity": { "type": "string" },
        "linked_regression_asset_ledger": { "type": "string" },
        "exact_build_and_row_reference": { "type": "string" },
        "cohort_ring_lineage_state": { "type": "string" },
        "close_lineage_freshness_state": { "type": "string" },
        "workaround_lineage_reference": { "type": "string" },
        "last_incident_close_revision": { "type": "string" },
        "keeps_incident_lineage_visible": { "type": "boolean" },
        "close_lineage_is_truthful": { "type": "boolean" },
        "close_without_asset_requested": { "type": "boolean" },
        "close_blocked_until_asset_linked": { "type": "boolean" },
        "lineage_gap_present": { "type": "boolean" },
        "lineage_gap_flagged": { "type": "boolean" },
        "incident_close_stays_honest": { "type": "boolean" },
        "provides_complete_incident_close_record": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "incident_close_safe_on_every_severity": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "regression_asset_entries",
        "incident_close_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "closes_a_severe_incident_without_a_linked_regression_asset",
        "lets_an_approved_exception_become_an_untracked_close",
        "hides_the_build_row_or_cohort_lineage_on_the_regression_asset",
        "collapses_distinct_incident_severity_classes_into_one_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "regression_asset_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/regression_asset_entry" }
        },
        "incident_close_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/incident_close_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "closes_a_severe_incident_without_a_linked_regression_asset": { "const": false },
        "lets_an_approved_exception_become_an_untracked_close": { "const": false },
        "hides_the_build_row_or_cohort_lineage_on_the_regression_asset": { "const": false },
        "collapses_distinct_incident_severity_classes_into_one_lane": { "const": false }
      }
    }
  }
}
