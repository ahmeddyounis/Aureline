{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-archived-snapshot-viewer-consumers.schema.json",
  "title": "M5 Archived-Snapshot-Viewer Consumer Packet",
  "description": "Export-safe record binding the five B149 non-live-evidence object classes (retirement snapshot, captured support / export evidence, archived runbook packet, imported / offline route evidence, review / incident snapshot) to the shell / archive-viewer, help / docs, support, review / incident, runbook-archive, release-center, companion / export, program-governance, and CLI / export consumers that render them, proving one canonical analysis-only archive banner, action-rule set, and accessibility contract across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_archived_snapshot_viewer_analysis_only_banner_consumer_registry"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "retirement_snapshot",
        "support_export_evidence",
        "archived_runbook_packet",
        "imported_offline_route_evidence",
        "review_incident_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "help_docs",
        "support",
        "review_incident",
        "runbook_archive",
        "release_center",
        "companion_export",
        "program_governance",
        "cli_export"
      ]
    },
    "posture": {
      "type": "string",
      "enum": [
        "live_target_openable",
        "metadata_only_exit",
        "imported_offline_only",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "archive_action": {
      "type": "string",
      "enum": ["inspect", "compare", "export_evidence", "open_current_live_object"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "archive_banner_grammar_drift_detected",
        "analysis_only_posture_dropped",
        "presents_write_capable_control_as_if_current_object_open_live",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "dead_links_expired_or_removed_artifact_instead_of_showing_metadata",
        "leaves_non_live_evidence_unjoined_to_capture_context",
        "lets_archived_or_imported_evidence_look_live_writable_or_current_by_omission",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_historical_reference_narrowed"
      ]
    },
    "banner_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banner_role_word",
        "snapshot_label_word",
        "capture_time_word",
        "provenance_word",
        "analysis_only_posture_word",
        "allowed_action_set_word"
      ],
      "properties": {
        "banner_role_word": { "type": "string", "minLength": 1 },
        "snapshot_label_word": { "type": "string", "minLength": 1 },
        "capture_time_word": { "type": "string", "minLength": 1 },
        "provenance_word": { "type": "string", "minLength": 1 },
        "analysis_only_posture_word": { "type": "string", "minLength": 1 },
        "allowed_action_set_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_grammar_note", "next_action", "next_action_label"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "live_target_removed_metadata_only",
            "imported_offline_disclosed",
            "export_redaction_narrowed"
          ]
        },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": {
          "type": "string",
          "enum": ["open_metadata_only_exit", "open_import_source", "open_full_detail"]
        },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "evidence_profile_id",
        "evidence_profile_label",
        "object_class",
        "consumer",
        "posture",
        "banner_grammar",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "narrow_note",
        "import_offline_note",
        "export_detail_note",
        "presents_write_capable_control_as_if_current_object_open_live",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "dead_links_expired_or_removed_artifact_instead_of_showing_metadata",
        "leaves_non_live_evidence_unjoined_to_capture_context",
        "lets_archived_or_imported_evidence_look_live_writable_or_current_by_omission",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "evidence_profile_id": { "type": "string", "minLength": 1 },
        "evidence_profile_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "posture": { "$ref": "#/$defs/posture" },
        "banner_grammar": { "$ref": "#/$defs/banner_grammar" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/archive_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "import_offline_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "presents_write_capable_control_as_if_current_object_open_live": { "type": "boolean" },
        "reopens_live_target_without_validating_identity_trust_route_and_authority": { "type": "boolean" },
        "dead_links_expired_or_removed_artifact_instead_of_showing_metadata": { "type": "boolean" },
        "leaves_non_live_evidence_unjoined_to_capture_context": { "type": "boolean" },
        "lets_archived_or_imported_evidence_look_live_writable_or_current_by_omission": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
