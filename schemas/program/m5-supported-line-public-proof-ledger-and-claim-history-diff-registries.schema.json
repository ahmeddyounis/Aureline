{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-supported-line-public-proof-ledger-and-claim-history-diff-registries.schema.json",
  "title": "Aureline M5 public-proof-ledger and claim-history-diff registries",
  "description": "Export-safe packet for the public-proof-ledger and claim-history-diff lane over the frozen M5 supported-line-transparency matrix. It makes durable external proof operable by carrying resolved, honest projections of the public-proof-ledger domain (the ledger published per active supported line — one typed section per joined proof source: a compatibility report, a benchmark / evidence packet, a support-window statement, a known-limits set, a deprecation report, and a successor report — each bound to one supported-line identity with its freshness state, last-versus-current diff, and the exact evidence-packet refs currently backing its public claims) and the claim-history-diff domain (the typed diff event naming whether a proof source changed freshness or moved from current to retest-pending, narrowed the scope it backs, or changed the release-line identity it is associated with, naming the active diff reason) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved public-proof-ledger entries (naming a canonical registry token, a stable line-binding ID, a transparency role, a classified proof source, a published ledger object linking compatibility / benchmark / support-window / known-limits / deprecation evidence-packet refs, and canonical/accessible/audit resolution-form coverage while preserving its rollback posture before a claim widens and keeping onboarding / migration / support language matched to current public proof) and resolved claim-history-diff entries (naming a canonical registry token, a stable diff-ref, a transparency role, a classified diff scope, and the complete line-identity / affected-proof-source / previous-versus-current-claim-state / diff-scope / active-reason diff object). Hard invariants forbid keeping support / certification language ahead of current public proof, widening a supported line on stale proof, hiding the rollback target before widening, and collapsing distinct diff classes into one lane. Acceptance criteria — every active stable or LTS-candidate line exposes one machine-readable public-proof ledger with freshness state, last/current diff, and the exact evidence-packet refs backing public claims; a stale or mismatched compatibility / benchmark / known-limits / deprecation asset becomes a typed diff event rather than an implicit docs mismatch; and at least one docs / help / support / public-proof consumer renders the ledger directly showing current-versus-previous claim-state history — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_supported_line_public_proof_ledger_and_claim_history_diff_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "public_proof_ledger_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "line_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "report_section",
