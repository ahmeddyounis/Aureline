        "comparison_safe_on_every_line": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
