{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-ring-progression-and-rollback-stop-registries.schema.json",
  "title": "Aureline M5 ring-progression and rollback-stop registries",
  "description": "Export-safe packet for the ring-progression and rollback-stop implement lane over the frozen M5 launch-control matrix. It carries resolved, honest projections of the ring-progression domain (how each widening transition — canary, broad internal dogfood, design-partner preview, public preview, and certified stable — declares its minimum entry evidence, soak-window expectation, why widening is allowed, its known-limits packet, issue-template linkage, claim-narrowing action, and the rollback-stop reference that immediately stops it) and the rollback-stop domain (how a launch-bearing lane records the rollback-stop condition — a crash / data-loss / trust defect, a repeated protected-metric regression, or a stale readiness packet — that halts ring progression while it is active) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved ring-progression entries (naming a canonical registry token, a stable transition-binding ID, a launch-control role, a classified ring widening transition, a published minimum entry evidence / soak-window expectation / widening-allow rationale / issue-template ref / known limits / claim-narrowing action / rollback-stop reference, and canonical/accessible/audit resolution-form coverage while keeping its known-limits and rollback-stop posture visible before widening and keeping a public-facing ring's support language matched to ring proof) and resolved rollback-stop entries (naming a canonical registry token, a stable stop-condition ref, a launch-control role, a classified rollback-stop condition, and the complete transition-identity / active-stop-condition-ledger / rollback-stop-target / protected-metric-regression / packet-freshness / crash-data-loss-or-trust / last-ring-transition-revision rollback-stop object). Hard invariants forbid advancing a ring without current known-limits and rollback-stop evidence, running partner or public support language ahead of ring proof, hiding the known-limits or rollback-stop posture before widening, and collapsing distinct rollback-stop condition classes into one lane. Acceptance criteria — every ring transition can state why widening is allowed and what immediately stops it; known-limits and rollback posture are visible before any ring widens; and ring progression cannot advance on a claimed lane when rollback-stop conditions are active — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_ring_progression_and_rollback_stop_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "ring_control_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "ring_control_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "ring_progression_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "transition_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "ring_widening_transition",
        "ring_widening_transition_is_classified",
        "canonical_ring_widening_transition_mode",
        "surface_context",
        "entry_evidence_minimum",
        "soak_window_expectation",
        "widening_allow_rationale",
        "issue_template_ref",
        "known_limits",
        "claim_narrowing_action",
        "rollback_stop_reference",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "ring_progression_object_complete",
        "bound_to_registry",
        "stop_and_rollback_visible_before_widening",
        "is_public_facing_ring",
        "support_language_matches_ring_proof",
        "degrade_reason",
        "next_action",
        "ring_progression_resolves_across_transitions"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "transition_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "ring_widening_transition": { "$ref": "#/$defs/non_empty_string" },
        "ring_widening_transition_is_classified": { "type": "boolean" },
        "canonical_ring_widening_transition_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "entry_evidence_minimum": { "type": "string" },
        "soak_window_expectation": { "type": "string" },
        "widening_allow_rationale": { "type": "string" },
        "issue_template_ref": { "type": "string" },
        "known_limits": { "type": "string" },
        "claim_narrowing_action": { "type": "string" },
        "rollback_stop_reference": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "ring_progression_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "stop_and_rollback_visible_before_widening": { "type": "boolean" },
        "is_public_facing_ring": { "type": "boolean" },
        "support_language_matches_ring_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "ring_progression_resolves_across_transitions": { "type": "boolean" }
      }
    },
    "rollback_stop_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "stop_condition_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "rollback_stop_condition",
        "rollback_stop_condition_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_transition_identity",
        "active_stop_condition_ledger",
        "rollback_stop_target_reference",
        "protected_metric_regression_state",
        "packet_freshness_state",
        "crash_data_loss_or_trust_reference",
        "last_ring_transition_revision",
        "keeps_rollback_stop_visible",
        "stop_state_is_truthful",
        "stop_condition_active",
        "ring_progression_halted_when_stop_active",
        "protected_metric_regression_present",
        "protected_metric_regression_flagged",
        "rollback_stop_stays_honest",
        "provides_complete_rollback_stop_record",
        "degrade_reason",
        "next_action",
        "rollback_stop_safe_on_every_transition"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "stop_condition_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "rollback_stop_condition": { "$ref": "#/$defs/non_empty_string" },
        "rollback_stop_condition_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_transition_identity": { "type": "string" },
        "active_stop_condition_ledger": { "type": "string" },
        "rollback_stop_target_reference": { "type": "string" },
        "protected_metric_regression_state": { "type": "string" },
        "packet_freshness_state": { "type": "string" },
        "crash_data_loss_or_trust_reference": { "type": "string" },
        "last_ring_transition_revision": { "type": "string" },
        "keeps_rollback_stop_visible": { "type": "boolean" },
        "stop_state_is_truthful": { "type": "boolean" },
        "stop_condition_active": { "type": "boolean" },
        "ring_progression_halted_when_stop_active": { "type": "boolean" },
        "protected_metric_regression_present": { "type": "boolean" },
        "protected_metric_regression_flagged": { "type": "boolean" },
        "rollback_stop_stays_honest": { "type": "boolean" },
        "provides_complete_rollback_stop_record": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "rollback_stop_safe_on_every_transition": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "ring_progression_entries",
        "rollback_stop_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "advances_a_ring_without_current_known_limits_and_rollback_stop_evidence",
        "runs_partner_or_public_support_language_ahead_of_ring_proof",
        "hides_the_known_limits_or_rollback_stop_posture_before_widening",
        "collapses_distinct_rollback_stop_condition_classes_into_one_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "ring_progression_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ring_progression_entry" }
        },
        "rollback_stop_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rollback_stop_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "advances_a_ring_without_current_known_limits_and_rollback_stop_evidence": { "const": false },
        "runs_partner_or_public_support_language_ahead_of_ring_proof": { "const": false },
        "hides_the_known_limits_or_rollback_stop_posture_before_widening": { "const": false },
        "collapses_distinct_rollback_stop_condition_classes_into_one_lane": { "const": false }
      }
    }
  }
}
