{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-last-supported-snapshot-and-archive-export-gate-registries.schema.json",
  "title": "Aureline M5 last-supported-snapshot and archive-export-gate registries",
  "description": "Export-safe packet for the last-supported-snapshot and archive-export-gate lane over the frozen M5 retired-state matrix. It ships last-supported snapshot and retirement archive bundles for a retiring M5 line or stable-facing surface across the release-center, help / docs, support, marketplace / registry, install / update, and partner / procurement surfaces so migration, audit, procurement, and support can inspect what was retired without keeping the retired surface live forever, carrying resolved, honest projections of the last-supported-snapshot domain (one export-safe snapshot per retiring object, classifying each preserved fact as the docs / help truth, schema / contract set, known-limits snapshot, compatibility report, provenance / SBOM reference, or support-article links with a typed reason and owning team, joined to the exact build, the retirement manifest, and the review packet) and the archive-export-gate domain (the typed gate that blocks an archive bundle from handoff while it carries a live vendor dependency, would leak a secret or internal-only detail, or is not bound back to the retirement manifest and review packet, naming the active block reason) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved last-supported-snapshot entries and resolved archive-export-gate entries. Hard invariants forbid destroying the exact-build joins, running a public-facing compatibility / support claim ahead of proof, hiding the exact-build binding, and collapsing distinct archive-export classes into one lane. Acceptance criteria — at least one exact-build last-supported bundle can be produced for a seeded retirement candidate and opened without live service dependencies; historical bundles identify the final supported version / channel and the successor path without contradiction; and retirement archives exclude live secrets / internal-only detail while retaining enough evidence for support, audit, and procurement / reference use — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_last_supported_snapshot_and_archive_export_gate_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "last_supported_snapshot_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "line_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "report_section",
        "report_section_is_classified",
        "canonical_report_section_mode",
        "surface_context",
        "exact_repo_journey_rows",
        "bundle_ids",
        "install_topology",
        "toolchain_envelope",
        "known_limits",
        "rollback_target",
        "diagnostics_posture",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "last_supported_snapshot_object_complete",
        "bound_to_registry",
        "rollback_and_diagnostics_bounded",
        "is_public_facing_line",
        "support_language_matches_line_proof",
        "degrade_reason",
        "next_action",
        "last_supported_snapshot_resolves_across_lines"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "line_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "report_section": { "$ref": "#/$defs/non_empty_string" },
        "report_section_is_classified": { "type": "boolean" },
        "canonical_report_section_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exact_repo_journey_rows": { "type": "string" },
        "bundle_ids": { "type": "string" },
        "install_topology": { "type": "string" },
        "toolchain_envelope": { "type": "string" },
        "known_limits": { "type": "string" },
        "rollback_target": { "type": "string" },
        "diagnostics_posture": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "last_supported_snapshot_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "rollback_and_diagnostics_bounded": { "type": "boolean" },
        "is_public_facing_line": { "type": "boolean" },
        "support_language_matches_line_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "last_supported_snapshot_resolves_across_lines": { "type": "boolean" }
      }
    },
    "archive_export_gate_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "comparison_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "comparison_scope",
        "comparison_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_line_identity",
        "known_limits_ledger",
        "rollback_target_reference",
        "rehearsal_currency_state",
        "readiness_signoff_state",
        "support_language_reference",
        "last_widening_revision",
        "keeps_archive_export_gate_visible",
        "comparison_is_truthful",
        "support_language_present",
        "support_language_bound_to_proof",
        "known_limits_gap_present",
        "known_limits_gap_flagged",
        "archive_export_gate_stays_honest",
        "provides_complete_archive_export_gate",
        "degrade_reason",
        "next_action",
        "comparison_safe_on_every_line"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "comparison_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "comparison_scope": { "$ref": "#/$defs/non_empty_string" },
        "comparison_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_line_identity": { "type": "string" },
        "known_limits_ledger": { "type": "string" },
        "rollback_target_reference": { "type": "string" },
        "rehearsal_currency_state": { "type": "string" },
        "readiness_signoff_state": { "type": "string" },
        "support_language_reference": { "type": "string" },
        "last_widening_revision": { "type": "string" },
        "keeps_archive_export_gate_visible": { "type": "boolean" },
        "comparison_is_truthful": { "type": "boolean" },
        "support_language_present": { "type": "boolean" },
        "support_language_bound_to_proof": { "type": "boolean" },
        "known_limits_gap_present": { "type": "boolean" },
        "known_limits_gap_flagged": { "type": "boolean" },
        "archive_export_gate_stays_honest": { "type": "boolean" },
        "provides_complete_archive_export_gate": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "comparison_safe_on_every_line": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "removal_horizon_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "last_supported_snapshot_entries",
        "archive_export_gate_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_line_without_current_rollback_and_diagnostics_downgrade",
        "runs_partner_or_public_support_language_ahead_of_line_proof",
        "hides_the_rollback_target_or_diagnostics_posture_before_widening",
        "collapses_distinct_archive_export_gate_classes_into_one_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "removal_horizon_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "last_supported_snapshot_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/last_supported_snapshot_entry" }
        },
        "archive_export_gate_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/archive_export_gate_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "widens_a_line_without_current_rollback_and_diagnostics_downgrade": { "const": false },
        "runs_partner_or_public_support_language_ahead_of_line_proof": { "const": false },
        "hides_the_rollback_target_or_diagnostics_posture_before_widening": { "const": false },
        "collapses_distinct_archive_export_gate_classes_into_one_lane": { "const": false }
      }
    }
  }
}
