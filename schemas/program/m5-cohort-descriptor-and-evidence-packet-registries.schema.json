{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-cohort-descriptor-and-evidence-packet-registries.schema.json",
  "title": "Aureline M5 cohort-descriptor and cohort-evidence-packet registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 launch-control matrix. It carries resolved, honest projections of the cohort-descriptor domain (how a widening cohort declares the exact repo / archetype rows, bundle IDs, install topology, toolchain envelope, known limits, rollback target, and diagnostics posture it is auditable by) and the cohort-evidence-packet domain (how a launch-bearing lane proves which cohort evidence — dogfood-ring telemetry, current rehearsal cadence, or an explicit go/no-go signoff — backs it, keeping partner / public support language and known-limits packets bound to that proof rather than to hand-edited prose) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved cohort-descriptor entries (naming a canonical registry token, a stable cohort-binding ID, a launch-control role, a classified cohort archetype, a published exact repo / archetype rows / bundle IDs / install topology / toolchain envelope / known limits / rollback target / diagnostics posture, and canonical/accessible/audit resolution-form coverage while preserving its rollback and diagnostics posture before widening and keeping a public-facing cohort's support language matched to cohort proof) and resolved cohort-evidence-packet entries (naming a canonical registry token, a stable evidence-ref, a launch-control role, a classified evidence scope, and the complete cohort-identity / known-limits-ledger / rollback-target / rehearsal-currency / readiness-signoff / support-language / last-widening-revision cohort-evidence object). Hard invariants forbid widening a cohort without current rollback and diagnostics evidence, running partner or public support language ahead of cohort proof, hiding the rollback target or diagnostics posture before widening, and collapsing distinct cohort evidence classes into one lane. Acceptance criteria — every active cohort can be inspected by exact rows, bundles, toolchains, and deployment profiles; cohort packets preserve rollback and diagnostics posture before widening; and claim publication can prove which cohort evidence backs each launch-bearing lane — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_cohort_descriptor_and_cohort_evidence_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "cohort_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "cohort_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "cohort_descriptor_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "cohort_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "cohort_archetype",
        "cohort_archetype_is_classified",
        "canonical_cohort_archetype_mode",
        "surface_context",
        "exact_repo_archetype_rows",
        "bundle_ids",
        "install_topology",
        "toolchain_envelope",
        "known_limits",
        "rollback_target",
        "diagnostics_posture",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "cohort_descriptor_object_complete",
        "bound_to_registry",
        "rollback_and_diagnostics_bounded",
        "is_public_facing_cohort",
        "support_language_matches_cohort_proof",
        "degrade_reason",
        "next_action",
        "descriptor_resolves_across_cohorts"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "cohort_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "cohort_archetype": { "$ref": "#/$defs/non_empty_string" },
        "cohort_archetype_is_classified": { "type": "boolean" },
        "canonical_cohort_archetype_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exact_repo_archetype_rows": { "type": "string" },
        "bundle_ids": { "type": "string" },
        "install_topology": { "type": "string" },
        "toolchain_envelope": { "type": "string" },
        "known_limits": { "type": "string" },
        "rollback_target": { "type": "string" },
        "diagnostics_posture": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "cohort_descriptor_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "rollback_and_diagnostics_bounded": { "type": "boolean" },
        "is_public_facing_cohort": { "type": "boolean" },
        "support_language_matches_cohort_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "descriptor_resolves_across_cohorts": { "type": "boolean" }
      }
    },
    "cohort_evidence_packet_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "evidence_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "evidence_scope",
        "evidence_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_cohort_identity",
        "known_limits_ledger",
        "rollback_target_reference",
        "rehearsal_currency_state",
        "readiness_signoff_state",
        "support_language_reference",
        "last_widening_revision",
        "keeps_cohort_evidence_visible",
        "evidence_is_truthful",
        "support_language_present",
        "support_language_bound_to_proof",
        "known_limits_gap_present",
        "known_limits_gap_flagged",
        "cohort_evidence_stays_honest",
        "provides_complete_cohort_evidence",
        "degrade_reason",
        "next_action",
        "evidence_safe_on_every_cohort"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "evidence_scope": { "$ref": "#/$defs/non_empty_string" },
        "evidence_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_cohort_identity": { "type": "string" },
        "known_limits_ledger": { "type": "string" },
        "rollback_target_reference": { "type": "string" },
        "rehearsal_currency_state": { "type": "string" },
        "readiness_signoff_state": { "type": "string" },
        "support_language_reference": { "type": "string" },
        "last_widening_revision": { "type": "string" },
        "keeps_cohort_evidence_visible": { "type": "boolean" },
        "evidence_is_truthful": { "type": "boolean" },
        "support_language_present": { "type": "boolean" },
        "support_language_bound_to_proof": { "type": "boolean" },
        "known_limits_gap_present": { "type": "boolean" },
        "known_limits_gap_flagged": { "type": "boolean" },
        "cohort_evidence_stays_honest": { "type": "boolean" },
        "provides_complete_cohort_evidence": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "evidence_safe_on_every_cohort": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "cohort_descriptor_entries",
        "cohort_evidence_packet_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_cohort_without_current_rollback_and_diagnostics_evidence",
        "runs_partner_or_public_support_language_ahead_of_cohort_proof",
        "hides_the_rollback_target_or_diagnostics_posture_before_widening",
        "collapses_distinct_cohort_evidence_classes_into_one_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "cohort_descriptor_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cohort_descriptor_entry" }
        },
        "cohort_evidence_packet_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cohort_evidence_packet_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "widens_a_cohort_without_current_rollback_and_diagnostics_evidence": { "const": false },
        "runs_partner_or_public_support_language_ahead_of_cohort_proof": { "const": false },
        "hides_the_rollback_target_or_diagnostics_posture_before_widening": { "const": false },
        "collapses_distinct_cohort_evidence_classes_into_one_lane": { "const": false }
      }
    }
  }
}
