{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-live-target-handoff-packet-and-route-validation.schema.json",
  "title": "M5 Live-Target Handoff Packet and Route Validation",
  "description": "Export-safe record binding the five B149 non-live-evidence object classes (retirement snapshot, captured support / export evidence, archived runbook packet, imported / offline route evidence, review / incident snapshot) to the shell / archive-viewer, help / docs, support, review / incident, runbook-archive, release-center, companion / export, program-governance, and CLI / export surfaces that hand a preserved snapshot off to its current live object, proving one canonical handoff vocabulary that validates target existence, current scope / workset visibility, remote / managed route availability, trust posture, and required auth / approval before completing the pivot, never widens authority beyond a direct open, and — when a precondition is unmet — reports the exact blocker and falls back to a satisfy-prerequisite or metadata-only exit instead of a dead end.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "handoff_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_live_target_handoff_registry"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "handoff_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/handoff_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "retirement_snapshot",
        "support_export_evidence",
        "archived_runbook_packet",
        "imported_offline_route_evidence",
        "review_incident_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "help_docs",
        "support",
        "review_incident",
        "runbook_archive",
        "release_center",
        "companion_export",
        "program_governance",
        "cli_export"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "handoff_cleared",
        "blocked_needs_prerequisite",
        "blocked_target_unavailable",
        "blocked_by_policy"
      ]
    },
    "route_class": {
      "type": "string",
      "enum": [
        "in_process_workspace",
        "remote_managed_service",
        "companion_browser_surface",
        "cli_reopen_path"
      ]
    },
    "trust_posture": {
      "type": "string",
      "enum": ["trusted_current_session", "needs_trust_revalidation", "untrusted"]
    },
    "authority_class": {
      "type": "string",
      "enum": ["read_only_inspect", "scoped_edit", "elevated_admin"]
    },
    "auth_prerequisite": {
      "type": "string",
      "enum": [
        "current_session_authenticated",
        "fresh_credential_within_ttl",
        "approval_on_record_for_route",
        "authority_scope_confirmed"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["handoff_cleared_completed", "handoff_blocked_disclosed"]
    },
    "handoff_action": {
      "type": "string",
      "enum": ["inspect_historical_packet", "export_handoff_packet", "open_current_live_object"]
    },
    "blocker_reason": {
      "type": "string",
      "enum": [
        "target_does_not_exist",
        "target_outside_current_scope",
        "route_unavailable",
        "trust_posture_insufficient",
        "auth_or_approval_missing",
        "retired_capability_no_live_counterpart",
        "policy_or_lifecycle_blocked"
      ]
    },
    "blocker_next_action": {
      "type": "string",
      "enum": ["satisfy_prerequisite_then_retry", "inspect_historical_packet_only"]
    },
    "fallback_behavior": {
      "type": "string",
      "enum": [
        "open_validated_live_target",
        "offer_prerequisite_then_retry",
        "metadata_only_exit"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "handoff_grammar_drift_detected",
        "mutation_blocked_posture_dropped",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "authority_widened_beyond_direct_open",
        "dead_ends_when_target_unavailable",
        "secret_or_ambient_credential_leaked",
        "presents_snapshot_as_current_live_object",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_historical_reference_narrowed"
      ]
    },
    "historical_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_role_word",
        "snapshot_label_word",
        "capture_time_word",
        "provenance_word",
        "mutation_blocked_posture_word"
      ],
      "properties": {
        "historical_role_word": { "type": "string", "minLength": 1 },
        "snapshot_label_word": { "type": "string", "minLength": 1 },
        "capture_time_word": { "type": "string", "minLength": 1 },
        "provenance_word": { "type": "string", "minLength": 1 },
        "mutation_blocked_posture_word": { "type": "string", "minLength": 1 }
      }
    },
    "live_target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "target_label", "target_kind"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "target_label": { "type": "string", "minLength": 1 },
        "target_kind": { "type": "string", "minLength": 1 }
      }
    },
    "precondition_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_exists",
        "target_in_current_scope",
        "route_available",
        "trust_posture_satisfied",
        "auth_and_approval_satisfied"
      ],
      "properties": {
        "target_exists": { "type": "boolean" },
        "target_in_current_scope": { "type": "boolean" },
        "route_available": { "type": "boolean" },
        "trust_posture_satisfied": { "type": "boolean" },
        "auth_and_approval_satisfied": { "type": "boolean" }
      }
    },
    "handoff_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot_id",
        "target_identity",
        "required_route_class",
        "required_trust_posture",
        "required_auth_prerequisites",
        "requested_authority_class",
        "direct_open_authority_class",
        "precondition_check",
        "fallback_behavior"
      ],
      "properties": {
        "source_snapshot_id": { "type": "string", "minLength": 1 },
        "target_identity": { "$ref": "#/$defs/live_target_identity" },
        "required_route_class": { "$ref": "#/$defs/route_class" },
        "required_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "required_auth_prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/auth_prerequisite" }
        },
        "requested_authority_class": { "$ref": "#/$defs/authority_class" },
        "direct_open_authority_class": { "$ref": "#/$defs/authority_class" },
        "precondition_check": { "$ref": "#/$defs/precondition_check" },
        "fallback_behavior": { "$ref": "#/$defs/fallback_behavior" }
      }
    },
    "blocker_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "explanation",
        "preserved_historical_note",
        "fallback_behavior",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/blocker_reason" },
        "explanation": { "type": "string", "minLength": 1 },
        "preserved_historical_note": { "type": "string", "minLength": 1 },
        "fallback_behavior": { "$ref": "#/$defs/fallback_behavior" },
        "next_action": { "$ref": "#/$defs/blocker_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "reviewed_authority_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_path_id", "reviewed_path_label"],
      "properties": {
        "reviewed_path_id": { "type": "string", "minLength": 1 },
        "reviewed_path_label": { "type": "string", "minLength": 1 }
      }
    },
    "handoff_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "snapshot_profile_id",
        "snapshot_profile_label",
        "object_class",
        "consumer",
        "outcome",
        "historical_grammar",
        "handoff_request",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "blocker_note",
        "reviewed_authority_handoff",
        "historical_side_mutation_blocked",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "widens_authority_beyond_direct_open",
        "dead_ends_when_target_unavailable",
        "leaks_secret_or_ambient_credential",
        "presents_snapshot_as_current_live_object",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "snapshot_profile_id": { "type": "string", "minLength": 1 },
        "snapshot_profile_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "historical_grammar": { "$ref": "#/$defs/historical_grammar" },
        "handoff_request": { "$ref": "#/$defs/handoff_request" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/handoff_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "blocker_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/blocker_note" }]
        },
        "reviewed_authority_handoff": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reviewed_authority_handoff" }]
        },
        "historical_side_mutation_blocked": { "type": "boolean" },
        "reopens_live_target_without_validating_identity_trust_route_and_authority": { "type": "boolean" },
        "widens_authority_beyond_direct_open": { "type": "boolean" },
        "dead_ends_when_target_unavailable": { "type": "boolean" },
        "leaks_secret_or_ambient_credential": { "type": "boolean" },
        "presents_snapshot_as_current_live_object": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
