{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-file-state-badge-group-consumers.schema.json",
  "title": "M5 File-State Badge-Group & Reason-Strip Consumer Packet",
  "description": "Export-safe record binding the six B150 constrained-current-object classes (read-only, generated, policy-locked, managed, projection, captured-snapshot) to the tab-chrome, breadcrumb-trail, status-bar, command-palette, editor-banner, diff / review-header, write-review-sheet, AI / automation-path, and support / export consumers that render them, proving one canonical file-state badge group, reason strip, safe-action rule set, multi-state display, and accessibility contract across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_file_state_badge_group_and_reason_strip_consumer_registry"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "read_only",
        "generated",
        "policy_locked",
        "managed",
        "projection",
        "captured_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "tab_chrome",
        "breadcrumb_trail",
        "status_bar",
        "command_palette",
        "editor_banner",
        "diff_review_header",
        "write_review_sheet",
        "ai_automation_path",
        "support_export_packet"
      ]
    },
    "posture": {
      "type": "string",
      "enum": [
        "full_badge_group",
        "compact_status_chip",
        "palette_availability_gated",
        "export_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "badge_group_action": {
      "type": "string",
      "enum": ["inspect_state", "copy_reason", "reveal_canonical_source", "open_safe_next_step"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "badge_group_vocabulary_drift_detected",
        "write_disposition_dropped_for_constrained_object",
        "presents_constrained_object_as_directly_writable_or_hides_recovery_path",
        "lets_generated_managed_projection_or_archived_objects_silently_fall_back_to_lossy_direct_write",
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass",
        "leaves_canonical_source_exact_write_target_sync_or_recovery_path_unstated",
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_constrained_file_state_narrowed"
      ]
    },
    "badge_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_role_word",
        "state_class_label_word",
        "reason_word",
        "canonical_source_word",
        "write_disposition_word",
        "safe_next_step_word",
        "co_applicable_state_labels"
      ],
      "properties": {
        "badge_role_word": { "type": "string", "minLength": 1 },
        "state_class_label_word": { "type": "string", "minLength": 1 },
        "reason_word": { "type": "string", "minLength": 1 },
        "canonical_source_word": { "type": "string", "minLength": 1 },
        "write_disposition_word": { "type": "string", "minLength": 1 },
        "safe_next_step_word": { "type": "string", "minLength": 1 },
        "co_applicable_state_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_grammar_note", "next_action", "next_action_label"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "compacted_to_status_chip",
            "palette_availability_gated_disclosed",
            "export_redaction_narrowed"
          ]
        },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": {
          "type": "string",
          "enum": ["open_full_badge_group", "open_command_detail", "open_full_detail"]
        },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "object_profile_id",
        "object_profile_label",
        "object_class",
        "co_applicable_states",
        "consumer",
        "posture",
        "badge_grammar",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "narrow_note",
        "palette_availability_note",
        "export_detail_note",
        "presents_constrained_object_as_directly_writable_or_hides_recovery_path",
        "lets_generated_managed_projection_or_archived_objects_silently_fall_back_to_lossy_direct_write",
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass",
        "leaves_canonical_source_exact_write_target_sync_or_recovery_path_unstated",
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "object_profile_id": { "type": "string", "minLength": 1 },
        "object_profile_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "co_applicable_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/object_class" }
        },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "posture": { "$ref": "#/$defs/posture" },
        "badge_grammar": { "$ref": "#/$defs/badge_grammar" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/badge_group_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "palette_availability_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "presents_constrained_object_as_directly_writable_or_hides_recovery_path": { "type": "boolean" },
        "lets_generated_managed_projection_or_archived_objects_silently_fall_back_to_lossy_direct_write": { "type": "boolean" },
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass": { "type": "boolean" },
        "leaves_canonical_source_exact_write_target_sync_or_recovery_path_unstated": { "type": "boolean" },
        "lets_one_state_class_hide_another_when_both_materially_affect_behavior": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
