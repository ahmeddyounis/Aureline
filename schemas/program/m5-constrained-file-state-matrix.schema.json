{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-constrained-file-state-matrix.schema.json",
  "title": "Aureline M5 constrained-file-state, canonical-source-relation, and write-target-review matrix",
  "description": "Export-safe packet freezing Aureline's constrained-current-object model \u2014 the read-only, generated, policy-locked, managed, projection, and captured-snapshot objects a write-capable consumer must never treat as an ordinary directly-writable file. The packet names every covered object class and binds each to the claimed surface families that render it, the classification stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain constrained-file-state / canonical-source-relation / write-target-review schema, the required visible state (state badge, reason, canonical source or live target, exact write target, allowed actions, blocked actions, and export / retain notes), and the mandatory labels it must show (identity, constraint_role, canonical_reference, plus state_badge, exact_write_target, nearest_safe_action). The write_disposition field makes a write-constrained object mechanically distinct from an ordinary directly-writable object. Hard invariants forbid one constrained-state class hiding another when both materially affect behavior, generated / managed / projection / archived objects silently falling back to a lossy direct write, AI / automation / import / repair flows getting a hidden bypass around the constrained-state rules, leaving the canonical source / exact write target / preserved-versus-lost sync / recovery path unstated, and presenting a constrained object as directly writable or hiding the recovery / regenerate path. The matrix binds back to the already-landed stable-proof-index and migration-task-row packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "constrained_file_state_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_constrained_file_state_canonical_source_relation_and_write_target_review_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "constrained_file_state_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/constrained_file_state_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "constrained_file_state_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "constrained_file_state_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "read_only",
        "generated",
        "policy_locked",
        "managed",
        "projection",
        "captured_snapshot"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "write_disposition": {
      "enum": [
        "directly_writable",
        "read_only_blocked",
        "regenerate_only",
        "approval_gated",
        "detach_required",
        "restore_only"
      ]
    },
    "semantic_role": {
      "enum": [
        "state_badge_classification",
        "blocked_write_reason",
        "canonical_source_relation",
        "exact_write_target",
        "allowed_blocked_action_set",
        "safe_next_step_guidance",
        "export_retain_disclosure"
      ]
    },
    "required_visible_state": {
      "type": "object",
      "required": [
        "state_badge",
        "reason",
        "canonical_source_or_live_target",
        "exact_write_target",
        "allowed_actions",
        "blocked_actions",
        "export_retain_notes"
      ],
      "properties": {
        "state_badge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "canonical_source_or_live_target": {
          "$ref": "#/$defs/non_empty_string"
        },
        "exact_write_target": {
          "$ref": "#/$defs/non_empty_string"
        },
        "allowed_actions": {
          "$ref": "#/$defs/non_empty_string"
        },
        "blocked_actions": {
          "$ref": "#/$defs/non_empty_string"
        },
        "export_retain_notes": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "constrained_file_state_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "write_disposition",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "required_visible_state",
        "surface_families",
        "classification_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "lets_one_constrained_state_class_hide_another_when_both_materially_affect_behavior",
        "lets_generated_managed_projection_or_archived_objects_silently_fall_back_to_lossy_direct_write",
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass_around_constrained_state_rules",
        "leaves_canonical_source_exact_write_target_preserved_versus_lost_sync_or_recovery_path_unstated",
        "presents_a_constrained_object_as_directly_writable_or_hides_the_recovery_or_regenerate_path"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "write_disposition": {
          "$ref": "#/$defs/write_disposition"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_visible_state": {
          "$ref": "#/$defs/required_visible_state"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "classification_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "read_only_roles": {
          "type": "array"
        },
        "generated_roles": {
          "type": "array"
        },
        "policy_locked_roles": {
          "type": "array"
        },
        "managed_roles": {
          "type": "array"
        },
        "projection_roles": {
          "type": "array"
        },
        "captured_snapshot_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "lets_one_constrained_state_class_hide_another_when_both_materially_affect_behavior": {
          "const": false
        },
        "lets_generated_managed_projection_or_archived_objects_silently_fall_back_to_lossy_direct_write": {
          "const": false
        },
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass_around_constrained_state_rules": {
          "const": false
        },
        "leaves_canonical_source_exact_write_target_preserved_versus_lost_sync_or_recovery_path_unstated": {
          "const": false
        },
        "presents_a_constrained_object_as_directly_writable_or_hides_the_recovery_or_regenerate_path": {
          "const": false
        }
      }
    }
  }
}
