{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-stable-line-lts-readiness-decision-and-line-creation-gate-registries.schema.json",
  "title": "Aureline M5 91–180 day LTS-readiness-decision and line-creation-gate registries",
  "description": "Export-safe packet for the 91–180 day LTS-readiness-decision and line-creation-gate lane over the frozen M5 stable-line-protection matrix. It makes any future LTS promise evidence-bearing by carrying resolved, honest projections of the lts-readiness-decision domain (the decision packet recorded per candidate line — one typed decision section per operating proof: backport branch posture, correction-line health, rollback evidence, support-window posture, mirror/air-gap continuity proof, and advisory/revocation readiness — each bound to the named decision-forum outcome and the preserved rollback/support evidence snapshot) and the line-creation-gate domain (the record naming whether a candidate line is LTS committed on a green packet, LTS blocked because its packet is missing or its evidence is stale, or LTS narrowed back to a plain stable posture, naming the active gate reason) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved lts-readiness-decision entries (naming a canonical registry token, a stable line-binding ID, a stable-line-protection role, a classified decision section, a published decision object recording the support-window / backport / rollback / mirror-air-gap / advisory proofs and forum outcome, and canonical/accessible/audit resolution-form coverage while preserving its rollback/support posture before LTS language widens and keeping public support-window/continuity language matched to current rollback and support evidence) and resolved line-creation-gate entries (naming a canonical registry token, a stable gate-ref, a stable-line-protection role, a classified gate scope, and the complete line-identity / linked-decision / required-packet / gate-scope / narrowed-posture / active-reason / last-revision gate object). Hard invariants forbid keeping LTS/support language ahead of the current decision packet, widening a candidate line while its decision packet is unresolved, hiding the rollback target before widening, and collapsing distinct gate classes into one lane. Acceptance criteria — any candidate LTS line has an inspectable decision packet showing backport discipline, rollback evidence, support-window posture, mirror/air-gap proof, and forum outcome; no LTS label or promise can widen without a green decision packet, so blocked or missing packets force a narrower stable-line posture; and release/help/support/public-proof consumers can explain why a line is or is not LTS-ready from packet-backed facts rather than generic enterprise-language placeholders — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_stable_line_lts_readiness_decision_and_line_creation_gate_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "lts_readiness_decision_entry": {
