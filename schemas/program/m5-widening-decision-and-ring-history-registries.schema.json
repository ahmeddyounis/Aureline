{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-widening-decision-and-ring-history-registries.schema.json",
  "title": "Aureline M5 widening-decision and ring-history registries",
  "description": "Export-safe packet for the stable go/no-go widening-decision and ring-history implement lane over the frozen M5 launch-control matrix. It makes every claimed stable-widening event reconstructible after the fact: it carries resolved, honest projections of the widening-decision-record domain (how each widening event — an alpha, beta, release-candidate, stable, long-term-support, or correction-reissue widening — records its final go/no-go decision, its open risks, its narrowed claims, its named on-call and signoff roster, its exact evidence snapshot, and its decision-freshness expiry so a stable claim can never widen on tribal memory) and the ring-history-snapshot domain (how a launch-bearing lane preserves the ring history, the prior blockers, and the previous packet freshness — a ring-history, a prior-blocker, or a packet-freshness snapshot scope — with the preserved evidence snapshot, signoff, named on-call roster state, and authorized widening stage that justified widening) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved widening-decision entries (naming a canonical registry token, a stable widening-event-binding ID, a launch-control role, a classified decision kind, a preserved final-decision / open-risks / narrowed-claims / on-call / signoff / evidence-snapshot / decision-freshness record, and canonical/accessible/audit resolution-form coverage while keeping the record documented before widening and keeping a public-facing lane's support language matched to proof) and resolved ring-history entries (naming a canonical registry token, a stable ring-history ref, a launch-control role, a classified snapshot scope, and the complete resolved-coverage-identity / ring-history-ledger / signoff / on-call-roster / packet-freshness / widening-stage / last-ring-history-revision record). Hard invariants forbid widening a stable claim without a durable go/no-go record, dropping the evidence snapshot or roster from a widening record, hiding the ring history or prior blockers before widening, and implying green when go/no-go records or evidence snapshots are stale. Acceptance criteria — every claimed widening event has one durable go/no-go record tied to exact evidence and roster state; later incident or support review can reconstruct the decision without ad hoc meeting notes; and shiproom and correction-line flows consume the same record rather than duplicating decision state — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_widening_decision_and_ring_history_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "ring_history_control_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "ring_history_control_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "widening_decision_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "widening_event_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "widening_decision_packet_kind",
        "widening_decision_packet_kind_is_classified",
        "canonical_widening_decision_packet_kind_mode",
        "surface_context",
        "final_decision_reference",
        "open_risks_reference",
        "narrowed_claims_reference",
        "on_call_roster_reference",
        "signoff_roster_reference",
        "evidence_snapshot_reference",
        "decision_freshness_reference",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "widening_decision_object_complete",
        "bound_to_registry",
        "widening_decision_documented_before_widening",
        "requires_documented_exception",
        "attributable_asset_or_approved_exception",
        "degrade_reason",
        "next_action",
        "widening_decision_resolves_across_classes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "widening_event_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "widening_decision_packet_kind": { "$ref": "#/$defs/non_empty_string" },
        "widening_decision_packet_kind_is_classified": { "type": "boolean" },
        "canonical_widening_decision_packet_kind_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "final_decision_reference": { "type": "string" },
        "open_risks_reference": { "type": "string" },
        "narrowed_claims_reference": { "type": "string" },
        "on_call_roster_reference": { "type": "string" },
        "signoff_roster_reference": { "type": "string" },
        "evidence_snapshot_reference": { "type": "string" },
        "decision_freshness_reference": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "widening_decision_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "widening_decision_documented_before_widening": { "type": "boolean" },
        "requires_documented_exception": { "type": "boolean" },
        "attributable_asset_or_approved_exception": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "widening_decision_resolves_across_classes": { "type": "boolean" }
      }
    },
    "ring_history_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "ring_history_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "ring_history_coverage",
        "ring_history_coverage_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_coverage_identity",
        "evidence_snapshot_ledger",
        "orr_signoff_reference",
        "on_call_roster_state",
        "ring_history_freshness_state",
        "widening_stage_reference",
        "last_ring_history_revision",
        "keeps_evidence_snapshot_visible",
        "ring_history_lineage_is_truthful",
        "override_without_evidence_requested",
        "blocked_until_evidence_linked",
        "lineage_gap_present",
        "lineage_gap_flagged",
        "ring_history_stays_honest",
        "provides_complete_ring_history_record",
        "degrade_reason",
        "next_action",
        "ring_history_safe_on_every_coverage"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "ring_history_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "ring_history_coverage": { "$ref": "#/$defs/non_empty_string" },
        "ring_history_coverage_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_coverage_identity": { "type": "string" },
        "evidence_snapshot_ledger": { "type": "string" },
        "orr_signoff_reference": { "type": "string" },
        "on_call_roster_state": { "type": "string" },
        "ring_history_freshness_state": { "type": "string" },
        "widening_stage_reference": { "type": "string" },
        "last_ring_history_revision": { "type": "string" },
        "keeps_evidence_snapshot_visible": { "type": "boolean" },
        "ring_history_lineage_is_truthful": { "type": "boolean" },
        "override_without_evidence_requested": { "type": "boolean" },
        "blocked_until_evidence_linked": { "type": "boolean" },
        "lineage_gap_present": { "type": "boolean" },
        "lineage_gap_flagged": { "type": "boolean" },
        "ring_history_stays_honest": { "type": "boolean" },
        "provides_complete_ring_history_record": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "ring_history_safe_on_every_coverage": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "widening_decision_entries",
        "ring_history_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_stable_claim_without_a_durable_go_no_go_record",
        "drops_the_evidence_snapshot_or_roster_from_a_widening_record",
        "hides_the_ring_history_or_prior_blockers_before_widening",
        "implies_green_when_go_no_go_records_or_evidence_snapshots_are_stale"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "widening_decision_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/widening_decision_entry" }
        },
        "ring_history_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ring_history_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "widens_a_stable_claim_without_a_durable_go_no_go_record": { "const": false },
        "drops_the_evidence_snapshot_or_roster_from_a_widening_record": { "const": false },
        "hides_the_ring_history_or_prior_blockers_before_widening": { "const": false },
        "implies_green_when_go_no_go_records_or_evidence_snapshots_are_stale": { "const": false }
      }
    }
  }
}
