{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-constrained-state-export-and-review-evidence-packets.schema.json",
  "title": "M5 Constrained-State Export and Review-Evidence Packets",
  "description": "Export-safe support / export and review-evidence packets that preserve constrained-state class, canonical source-of-truth relation, exact write-target decision, and chosen reviewed fallback path outside the live UI, over the six B150 constrained-current-object classes (read-only, generated, policy-locked, managed, projection, captured-snapshot). Every binding preserves one constrained-object entry in one packet channel (support bundle, review / export packet, local-history / restore evidence, or docs / help example); the corpus covers all four channels including at least one support bundle and one review / export packet. Each binding carries a dual-form (human-readable plus machine-readable) evidence record, the blocked-write reason, chosen fallback path, resolved decision (whether the operator duplicated, detached, overlaid, requested approval, regenerated, or cancelled), required write disposition, checkpoint / undo class, and a preserved-versus-lost record naming the sync / regenerate path; carries the controlled constrained-state grammar (state-role, state-class label, blocked-write reason, canonical source, exact write target, write disposition) identical for one entry across channels; joins its canonical source and exact write target; and carries a redaction record so a redacted packet keeps the omission reason and still preserves the state class and fallback decision. No packet silently falls back to a lossy direct write, lets one state class hide another, gives AI / automation / import / repair a hidden bypass, flattens the constrained-state class into generic read-only language, or presents a constrained object as directly writable while hiding the recovery / regenerate path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "evidence_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_constrained_state_export_and_review_evidence_packets"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "evidence_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "read_only",
        "generated",
        "policy_locked",
        "managed",
        "projection",
        "captured_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "tab_chrome",
        "breadcrumb_trail",
        "status_bar",
        "command_palette",
        "editor_banner",
        "diff_review_header",
        "write_review_sheet",
        "ai_automation_path",
        "support_export_packet"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "support_bundle",
        "review_export_packet",
        "local_history_restore_evidence",
        "docs_help_example"
      ]
    },
    "blocked_write_reason": {
      "type": "string",
      "enum": [
        "read_only_path_not_directly_writable",
        "generated_artifact_regenerate_only",
        "policy_lock_requires_approval",
        "managed_source_requires_detach",
        "projection_requires_overlay_or_detach",
        "captured_snapshot_restore_only"
      ]
    },
    "fallback_path": {
      "type": "string",
      "enum": [
        "duplicate_to_editable_copy",
        "detach_from_managed_source",
        "create_overlay_patch",
        "request_approval",
        "regenerate_with_preview"
      ]
    },
    "resolved_decision": {
      "type": "string",
      "enum": [
        "duplicated_to_editable_copy",
        "detached_from_managed_source",
        "created_overlay_patch",
        "requested_approval",
        "regenerated_with_preview",
        "cancelled"
      ]
    },
    "write_disposition": {
      "type": "string",
      "enum": [
        "directly_writable",
        "read_only_blocked",
        "regenerate_only",
        "approval_gated",
        "detach_required",
        "restore_only"
      ]
    },
    "checkpoint_undo_class": {
      "type": "string",
      "enum": [
        "new_copy_leaves_original_intact",
        "detach_checkpoint_restorable",
        "overlay_patch_revertible",
        "approval_request_withdrawable",
        "regenerate_preview_discardable"
      ]
    },
    "redaction_disposition": {
      "type": "string",
      "enum": ["not_redacted", "redacted_keep_state_class_and_fallback"]
    },
    "evidence_action": {
      "type": "string",
      "enum": [
        "inspect_constrained_state_record",
        "export_evidence_packet",
        "open_reviewed_fallback_replay"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "grammar_drift_detected",
        "constrained_state_classification_dropped",
        "constrained_state_flattened_to_read_only",
        "machine_readable_record_drifted",
        "human_readable_line_dropped",
        "redaction_omission_reason_dropped",
        "redacted_state_class_or_fallback_dropped",
        "fallback_reason_mismatch",
        "resolved_decision_mismatch",
        "silent_lossy_direct_write_observed",
        "canonical_source_or_write_target_missing",
        "ai_automation_bypass_observed",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_constrained_file_state_narrowed"
      ]
    },
    "constrained_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_role_word",
        "state_class_label_word",
        "blocked_write_reason_word",
        "canonical_source_word",
        "exact_write_target_word",
        "write_disposition_word"
      ],
      "properties": {
        "state_role_word": { "type": "string", "minLength": 1 },
        "state_class_label_word": { "type": "string", "minLength": 1 },
        "blocked_write_reason_word": { "type": "string", "minLength": 1 },
        "canonical_source_word": { "type": "string", "minLength": 1 },
        "exact_write_target_word": { "type": "string", "minLength": 1 },
        "write_disposition_word": { "type": "string", "minLength": 1 }
      }
    },
    "canonical_source_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source_ref",
        "exact_write_target_ref",
        "owning_authority_ref",
        "preserved_versus_lost_sync_ref"
      ],
      "properties": {
        "canonical_source_ref": { "type": "string", "minLength": 1 },
        "exact_write_target_ref": { "type": "string", "minLength": 1 },
        "owning_authority_ref": { "type": "string", "minLength": 1 },
        "preserved_versus_lost_sync_ref": { "type": "string", "minLength": 1 }
      }
    },
    "preserved_versus_lost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained", "lost", "sync_or_regenerate_path"],
      "properties": {
        "retained": { "type": "string", "minLength": 1 },
        "lost": { "type": "string", "minLength": 1 },
        "sync_or_regenerate_path": { "type": "string", "minLength": 1 }
      }
    },
    "machine_readable_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_class_token",
        "blocked_write_reason_token",
        "canonical_source_ref",
        "exact_write_target_ref",
        "chosen_fallback_path_token",
        "resolved_decision_token",
        "write_disposition_token",
        "checkpoint_undo_class_token"
      ],
      "properties": {
        "object_class_token": { "type": "string", "minLength": 1 },
        "blocked_write_reason_token": { "type": "string", "minLength": 1 },
        "canonical_source_ref": { "type": "string", "minLength": 1 },
        "exact_write_target_ref": { "type": "string", "minLength": 1 },
        "chosen_fallback_path_token": { "type": "string", "minLength": 1 },
        "resolved_decision_token": { "type": "string", "minLength": 1 },
        "write_disposition_token": { "type": "string", "minLength": 1 },
        "checkpoint_undo_class_token": { "type": "string", "minLength": 1 }
      }
    },
    "dual_form_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_readable_line", "machine_readable"],
      "properties": {
        "human_readable_line": { "type": "string", "minLength": 1 },
        "machine_readable": { "$ref": "#/$defs/machine_readable_record" }
      }
    },
    "redaction_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "omission_reason",
        "state_class_preserved",
        "fallback_decision_preserved"
      ],
      "properties": {
        "disposition": { "$ref": "#/$defs/redaction_disposition" },
        "omission_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "state_class_preserved": { "type": "boolean" },
        "fallback_decision_preserved": { "type": "boolean" }
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "entry_id",
        "entry_label",
        "channel",
        "consumer",
        "object_class",
        "co_applicable_object_class",
        "blocked_write_reason",
        "chosen_fallback_path",
        "resolved_decision",
        "write_disposition",
        "checkpoint_undo_class",
        "constrained_grammar",
        "dual_form",
        "preserved_versus_lost",
        "redaction",
        "canonical_source_join",
        "allowed_actions",
        "accessibility_routes",
        "constrained_state_explicitly_classified",
        "preserves_state_class_and_fallback_when_redacted",
        "flattens_constrained_state_into_generic_read_only_language",
        "drops_omission_reason_when_redacted",
        "lets_one_constrained_state_class_hide_another",
        "silently_falls_back_to_lossy_direct_write",
        "gives_ai_automation_import_or_repair_a_hidden_bypass",
        "leaves_canonical_source_or_exact_write_target_unstated",
        "presents_as_directly_writable_or_hides_recovery_path",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "entry_id": { "type": "string", "minLength": 1 },
        "entry_label": { "type": "string", "minLength": 1 },
        "channel": { "$ref": "#/$defs/channel" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "object_class": { "$ref": "#/$defs/object_class" },
        "co_applicable_object_class": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/object_class" }]
        },
        "blocked_write_reason": { "$ref": "#/$defs/blocked_write_reason" },
        "chosen_fallback_path": { "$ref": "#/$defs/fallback_path" },
        "resolved_decision": { "$ref": "#/$defs/resolved_decision" },
        "write_disposition": { "$ref": "#/$defs/write_disposition" },
        "checkpoint_undo_class": { "$ref": "#/$defs/checkpoint_undo_class" },
        "constrained_grammar": { "$ref": "#/$defs/constrained_grammar" },
        "dual_form": { "$ref": "#/$defs/dual_form_evidence" },
        "preserved_versus_lost": { "$ref": "#/$defs/preserved_versus_lost" },
        "redaction": { "$ref": "#/$defs/redaction_record" },
        "canonical_source_join": { "$ref": "#/$defs/canonical_source_join" },
        "allowed_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/evidence_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "constrained_state_explicitly_classified": { "type": "boolean" },
        "preserves_state_class_and_fallback_when_redacted": { "type": "boolean" },
        "flattens_constrained_state_into_generic_read_only_language": { "type": "boolean" },
        "drops_omission_reason_when_redacted": { "type": "boolean" },
        "lets_one_constrained_state_class_hide_another": { "type": "boolean" },
        "silently_falls_back_to_lossy_direct_write": { "type": "boolean" },
        "gives_ai_automation_import_or_repair_a_hidden_bypass": { "type": "boolean" },
        "leaves_canonical_source_or_exact_write_target_unstated": { "type": "boolean" },
        "presents_as_directly_writable_or_hides_recovery_path": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
