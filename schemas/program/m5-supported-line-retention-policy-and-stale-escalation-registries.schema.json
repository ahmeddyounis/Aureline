{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-supported-line-retention-policy-and-stale-escalation-registries.schema.json",
  "title": "Aureline M5 supported-line retention-policy and stale-escalation registries",
  "description": "Export-safe packet for the supported-line retention-policy and stale-escalation lane over the frozen M5 supported-line-transparency matrix. It keeps the B147 supported-line proof artifacts alive and reviewable after they first ship, by carrying resolved, honest projections of the retention-policy domain (one typed policy per B147 artifact class — a public-proof-ledger policy, a migration-scoreboard policy, a transparency-report policy, a correction-archive policy, a truth-feed policy, and an ORR-history policy, tracked against exact build / release-line identity — each naming its accountable owner and backup, review cadence, retention window, archive class, and destruction-or-long-term-retention rule, public-safe classes separated from internal-only incident / security ones) and the stale-escalation domain (the typed blocker raised when a required scheduled snapshot is missing, a supported-line feed has gone stale, or a snapshot is mismatched with the active supported-line matrix) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved retention-policy entries (naming a canonical registry token, a stable line-binding ID, a transparency role, a classified artifact class, a published policy object with its owner, cadence, retention window, archive class, and disposition, and canonical/accessible/audit resolution-form coverage while preserving its exact-build provenance before a claim widens and keeping a public-facing class's cadence matched to current proof) and resolved stale-escalation entries (naming a canonical registry token, a stable escalation-ref, a transparency role, a classified escalation scope, and the complete affected-artifact-class / active-supported-line-matrix / active-escalation-reason blocker object). Hard invariants forbid keeping a claim ahead of current proof, letting a supported line stay green on stale proof, leaking internal-only detail into public-safe policy exports, and collapsing distinct escalation scopes into one lane. Acceptance criteria — each B147 artifact class has an owner, cadence, retention window, and stale-escalation rule inspectable in one checked-in policy packet; automation can detect a missing scheduled snapshot or a stale line feed and raise a typed blocker before supported-line claims stay green on expired evidence; and at least one consumer exposes the active snapshot age and provenance for a B147 artifact class — are proven by the resolved examples, not merely asserted. Raw secret values, private endpoints, and privileged incident / security internals never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_supported_line_retention_policy_and_stale_escalation_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
