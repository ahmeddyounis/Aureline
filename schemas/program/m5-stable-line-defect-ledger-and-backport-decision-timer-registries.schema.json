{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-stable-line-defect-ledger-and-backport-decision-timer-registries.schema.json",
  "title": "Aureline M5 supported-line defect-ledger and backport-decision-timer registries",
  "description": "Export-safe packet for the supported-line defect-ledger and backport-decision-timer lane over the frozen M5 stable-line-protection matrix. It turns supported-line servicing into measurable program truth by carrying resolved, honest projections of the defect-ledger domain (how an active supported line records every defect it owns — its affected line, defect class, yes/no/defer backport decision, decision age, rollback target, correction-packet state, and owning release / support roster) and the backport-decision-timer domain (the machine-readable alert emitted when a defect's backport decision is missing, still unrecorded past its declared SLA, or has forced a stable/LTS support claim to narrow, naming the active alert reason) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved defect-ledger entries (naming a canonical registry token, a stable line-binding ID, a stable-line-protection role, a classified defect class, a published ledger object, and canonical/accessible/audit resolution-form coverage while preserving its rollback posture before a claim widens and keeping onboarding / migration / support language matched to a recorded backport decision) and resolved backport-decision-timer entries (naming a canonical registry token, a stable alert-ref, a stable-line-protection role, a classified alert scope, and the complete line-identity / affected-claim / target-train / alert-scope / narrowed-claim / active-reason / last-revision report object). Hard invariants forbid keeping support / certification language ahead of a recorded backport decision, widening a supported line while a defect's decision is missing or overdue, hiding the rollback target before widening, and collapsing distinct alert classes into one lane. Acceptance criteria — every affected supported-line defect traces to an explicit backport decision, decision age, rollback target, and correction owner through the durable ledger; missing or overdue backport decisions raise visible alerts that can block promotion or force narrowing of the relevant stable/LTS support claim; and the first correction-packet exercise ships as a checked-in proof artifact demonstrating supported-line servicing and backport-path viability — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_stable_line_defect_ledger_and_backport_decision_timer_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "defect_ledger_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "line_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "ledger_defect",
        "ledger_defect_is_classified",
        "canonical_ledger_defect_mode",
        "surface_context",
        "exact_repo_journey_rows",
        "bundle_ids",
        "install_topology",
        "toolchain_envelope",
        "known_limits",
        "rollback_target",
        "diagnostics_posture",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "defect_ledger_object_complete",
        "bound_to_registry",
        "rollback_and_diagnostics_bounded",
        "is_public_facing_line",
        "support_language_matches_line_proof",
        "degrade_reason",
        "next_action",
        "defect_ledger_resolves_across_lines"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "line_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "ledger_defect": { "$ref": "#/$defs/non_empty_string" },
        "ledger_defect_is_classified": { "type": "boolean" },
        "canonical_ledger_defect_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exact_repo_journey_rows": { "type": "string" },
        "bundle_ids": { "type": "string" },
        "install_topology": { "type": "string" },
        "toolchain_envelope": { "type": "string" },
        "known_limits": { "type": "string" },
        "rollback_target": { "type": "string" },
        "diagnostics_posture": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "defect_ledger_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "rollback_and_diagnostics_bounded": { "type": "boolean" },
        "is_public_facing_line": { "type": "boolean" },
        "support_language_matches_line_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "defect_ledger_resolves_across_lines": { "type": "boolean" }
      }
    },
    "backport_decision_timer_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "backport_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "backport_scope",
        "backport_scope_is_classified",
        "surface_context",
