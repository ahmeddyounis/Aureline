{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-stable-line-protection-plan-and-correction-queue-registries.schema.json",
  "title": "Aureline M5 stable-line protection-plan and correction-lane queue registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 stable-line-protection matrix. It carries resolved, honest projections of the protection-plan domain (how a supported line binds each protected journey — crash recovery, rollback / update, support export, migration / import, or another named launch-bearing flow — to its regression queue, publishing the queued-regression issue IDs, release line, correction packet, rollback target, and delayed-breadth ledger it is auditable by) and the correction-lane queue domain (how a supported line proves which protected-path regression is queued for correction and which breadth work is intentionally delayed while it stays open, keeping every delayed-breadth claim bound to a recorded override or claim-narrowing action rather than to hand-edited prose) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved protection-plan entries (naming a canonical registry token, a stable line-binding ID, a stable-line-protection role, a classified protected journey, a published set of protected-journey rows / queued-regression issue IDs / release line / correction packet / delayed-breadth ledger / rollback target / diagnostics posture, and canonical/accessible/audit resolution-form coverage while preserving its rollback and diagnostics posture before breadth work resumes and keeping any delayed breadth work bound to a recorded override) and resolved correction-lane queue entries (naming a canonical registry token, a stable correction-ref, a stable-line-protection role, a classified correction scope, and the complete line-identity / queued-regression-ledger / rollback-target / correction-packet / backport-decision / delayed-breadth / last-correction-revision queue object). Hard invariants forbid letting breadth work silently outrank a crash / rollback / support-export / migration regression, running breadth ahead of an open regression, hiding the rollback target or diagnostics posture before widening, and collapsing distinct correction classes into one lane. Acceptance criteria — release operators can see which protected journeys are guarded, which regressions are queued for correction, and which breadth items are intentionally delayed; the plan preserves exact issue / release-line / correction-packet / rollback linkage; and breadth work cannot silently outrank a crash / rollback / support-export / migration regression without a recorded override or claim-narrowing action — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_stable_line_protection_plan_and_correction_lane_queue_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "protection_plan_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "line_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_correction_snapshot_and_signoff_before_widening",
        "protected_journey",
        "protected_journey_is_classified",
        "canonical_protected_journey_mode",
        "surface_context",
        "exact_repo_journey_rows",
        "bundle_ids",
        "install_topology",
        "toolchain_envelope",
        "known_limits",
        "rollback_target",
        "diagnostics_posture",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "protection_plan_object_complete",
        "bound_to_registry",
        "rollback_and_diagnostics_bounded",
        "is_public_facing_line",
        "support_language_matches_line_proof",
        "degrade_reason",
        "next_action",
        "protection_plan_resolves_across_lines"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "line_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_correction_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "protected_journey": { "$ref": "#/$defs/non_empty_string" },
        "protected_journey_is_classified": { "type": "boolean" },
        "canonical_protected_journey_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exact_repo_journey_rows": { "type": "string" },
        "bundle_ids": { "type": "string" },
        "install_topology": { "type": "string" },
        "toolchain_envelope": { "type": "string" },
        "known_limits": { "type": "string" },
        "rollback_target": { "type": "string" },
        "diagnostics_posture": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "protection_plan_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "rollback_and_diagnostics_bounded": { "type": "boolean" },
        "is_public_facing_line": { "type": "boolean" },
        "support_language_matches_line_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "protection_plan_resolves_across_lines": { "type": "boolean" }
      }
    },
    "correction_queue_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "correction_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_correction_snapshot_and_signoff_before_widening",
        "correction_scope",
        "correction_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_line_identity",
        "known_limits_ledger",
        "rollback_target_reference",
        "rehearsal_currency_state",
        "readiness_signoff_state",
        "support_language_reference",
        "last_widening_revision",
        "keeps_correction_queue_visible",
        "correction_is_truthful",
        "support_language_present",
        "support_language_bound_to_proof",
        "known_limits_gap_present",
        "known_limits_gap_flagged",
        "correction_queue_stays_honest",
        "provides_complete_correction_queue",
        "degrade_reason",
        "next_action",
        "correction_safe_on_every_line"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "correction_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_correction_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "correction_scope": { "$ref": "#/$defs/non_empty_string" },
        "correction_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_line_identity": { "type": "string" },
        "known_limits_ledger": { "type": "string" },
        "rollback_target_reference": { "type": "string" },
        "rehearsal_currency_state": { "type": "string" },
        "readiness_signoff_state": { "type": "string" },
        "support_language_reference": { "type": "string" },
        "last_widening_revision": { "type": "string" },
        "keeps_correction_queue_visible": { "type": "boolean" },
        "correction_is_truthful": { "type": "boolean" },
        "support_language_present": { "type": "boolean" },
        "support_language_bound_to_proof": { "type": "boolean" },
        "known_limits_gap_present": { "type": "boolean" },
        "known_limits_gap_flagged": { "type": "boolean" },
        "correction_queue_stays_honest": { "type": "boolean" },
        "provides_complete_correction_queue": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "correction_safe_on_every_line": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "protection_plan_entries",
        "correction_queue_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_a_line_without_current_rollback_and_diagnostics_correction",
        "runs_partner_or_public_support_language_ahead_of_line_proof",
        "hides_the_rollback_target_or_diagnostics_posture_before_widening",
        "collapses_distinct_correction_queue_classes_into_one_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "protection_plan_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/protection_plan_entry" }
        },
        "correction_queue_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/correction_queue_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "widens_a_line_without_current_rollback_and_diagnostics_correction": { "const": false },
        "runs_partner_or_public_support_language_ahead_of_line_proof": { "const": false },
        "hides_the_rollback_target_or_diagnostics_posture_before_widening": { "const": false },
        "collapses_distinct_correction_queue_classes_into_one_lane": { "const": false }
      }
    }
  }
}
