{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-freeze-exception-and-go-no-go-registries.schema.json",
  "title": "Aureline M5 freeze-exception and go-no-go registries",
  "description": "Export-safe packet for the freeze-exception and go-no-go implement lane over the frozen M5 launch-control matrix. It carries resolved, honest projections of the freeze-exception domain (how each regression asset type — canary, broad internal dogfood, design-partner preview, public preview, and certified stable — declares its minimum entry evidence, soak-window expectation, why widening is allowed, its known-limits packet, issue-template linkage, claim-narrowing action, and the go-no-go reference that immediately stops it) and the go-no-go domain (how a launch-bearing lane records the go-no-go condition — a crash / data-loss / trust defect, a repeated protected-metric regression, or a stale readiness packet — that halts regression asset while it is active) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved freeze-exception entries (naming a canonical registry token, a stable transition-binding ID, a launch-control role, a classified regression asset type, a published minimum entry evidence / soak-window expectation / widening-allow rationale / issue-template ref / known limits / claim-narrowing action / go-no-go reference, and canonical/accessible/audit resolution-form coverage while keeping its known-limits and go-no-go posture visible before widening and keeping a public-facing ring's support language matched to ring proof) and resolved go-no-go entries (naming a canonical registry token, a stable stop-condition ref, a launch-control role, a classified go-no-go condition, and the complete transition-identity / active-stop-condition-ledger / go-no-go-target / protected-metric-regression / packet-freshness / crash-data-loss-or-trust / last-ring-transition-revision go-no-go object). Hard invariants forbid advancing a ring without current known-limits and go-no-go evidence, running partner or public support language ahead of ring proof, hiding the known-limits or go-no-go posture before widening, and collapsing distinct go-no-go condition classes into one lane. Acceptance criteria — every ring transition can state why widening is allowed and what immediately stops it; known-limits and rollback posture are visible before any ring widens; and regression asset cannot advance on a claimed lane when go-no-go conditions are active — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_freeze_exception_and_go_no_go_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "go_no_go_control_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "go_no_go_control_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "freeze_exception_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "exception_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "freeze_exception_change_class",
        "freeze_exception_change_class_is_classified",
        "canonical_freeze_exception_change_class_mode",
        "surface_context",
        "exception_scope_reference",
        "rollback_or_narrowing_reference",
        "docs_support_migration_reference",
        "owner_capture_reference",
        "risk_capture_reference",
        "change_budget_reference",
        "expiry_reference",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "freeze_exception_object_complete",
        "bound_to_registry",
        "freeze_exception_documented_before_widening",
        "requires_documented_exception",
        "attributable_asset_or_approved_exception",
        "degrade_reason",
        "next_action",
        "freeze_exception_resolves_across_classes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "exception_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "freeze_exception_change_class": { "$ref": "#/$defs/non_empty_string" },
        "freeze_exception_change_class_is_classified": { "type": "boolean" },
        "canonical_freeze_exception_change_class_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exception_scope_reference": { "type": "string" },
        "rollback_or_narrowing_reference": { "type": "string" },
        "docs_support_migration_reference": { "type": "string" },
        "owner_capture_reference": { "type": "string" },
        "risk_capture_reference": { "type": "string" },
        "change_budget_reference": { "type": "string" },
        "expiry_reference": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "freeze_exception_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "freeze_exception_documented_before_widening": { "type": "boolean" },
        "requires_documented_exception": { "type": "boolean" },
        "attributable_asset_or_approved_exception": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "freeze_exception_resolves_across_classes": { "type": "boolean" }
      }
    },
    "go_no_go_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "go_no_go_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening",
        "go_no_go_decision",
        "go_no_go_decision_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_decision_identity",
        "evidence_snapshot_ledger",
        "orr_signoff_reference",
        "on_call_roster_state",
        "go_no_go_freshness_state",
        "widening_stage_reference",
        "last_go_no_go_revision",
        "keeps_evidence_snapshot_visible",
        "go_no_go_lineage_is_truthful",
        "override_without_evidence_requested",
        "blocked_until_evidence_linked",
        "lineage_gap_present",
        "lineage_gap_flagged",
        "go_no_go_stays_honest",
        "provides_complete_go_no_go_record",
        "degrade_reason",
        "next_action",
        "go_no_go_safe_on_every_decision"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "go_no_go_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "go_no_go_decision": { "$ref": "#/$defs/non_empty_string" },
        "go_no_go_decision_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_decision_identity": { "type": "string" },
        "evidence_snapshot_ledger": { "type": "string" },
        "orr_signoff_reference": { "type": "string" },
        "on_call_roster_state": { "type": "string" },
        "go_no_go_freshness_state": { "type": "string" },
        "widening_stage_reference": { "type": "string" },
        "last_go_no_go_revision": { "type": "string" },
        "keeps_evidence_snapshot_visible": { "type": "boolean" },
        "go_no_go_lineage_is_truthful": { "type": "boolean" },
        "override_without_evidence_requested": { "type": "boolean" },
        "blocked_until_evidence_linked": { "type": "boolean" },
        "lineage_gap_present": { "type": "boolean" },
        "lineage_gap_flagged": { "type": "boolean" },
        "go_no_go_stays_honest": { "type": "boolean" },
        "provides_complete_go_no_go_record": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "go_no_go_safe_on_every_decision": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "widening_stages",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "freeze_exception_entries",
        "go_no_go_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "widens_scope_without_a_documented_freeze_exception",
        "lets_a_freeze_exception_become_undocumented_scope_widening",
        "hides_the_change_budget_or_owner_risk_on_the_freeze_exception",
        "collapses_distinct_go_no_go_decision_classes_into_one_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "widening_stages": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "freeze_exception_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/freeze_exception_entry" }
        },
        "go_no_go_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/go_no_go_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "widens_scope_without_a_documented_freeze_exception": { "const": false },
        "lets_a_freeze_exception_become_undocumented_scope_widening": { "const": false },
        "hides_the_change_budget_or_owner_risk_on_the_freeze_exception": { "const": false },
        "collapses_distinct_go_no_go_decision_classes_into_one_lane": { "const": false }
      }
    }
  }
}
