{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-retired-state-matrix.schema.json",
  "title": "Aureline M5 retired-state, end-of-support closure, successor-routing, and tombstone/archive matrix",
  "description": "Export-safe packet freezing Aureline's terminal-lifecycle object model \u2014 the supported lines, stable-facing capabilities, bundles, commands / deep links, schema-bearing surfaces, registry-visible packages, and managed / new-tenant-gated features that must move from Deprecated to Retired cleanly. The packet names every covered object class and binds each to the claimed surface families that render it, the removal-horizon stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain closure-artifact schema, the required transition metadata (last supported version or channel, cutoff date, successor path, disable path, export/rollback route, archival note, migration outcome, support-note closure state), and the mandatory labels it must show (identity, retirement_role, registry_reference, plus cutoff_date, successor_path, last_supported_version). The lifecycle_state field makes Retired mechanically distinct from deprecated, disabled_by_policy, and stable_line_narrowed. Hard invariants forbid a retired surface disappearing without a tombstone / archival route / successor pointer, a retired class staying selectable in new-install / new-tenant / marketplace / upgrade flows, destroying last-supported docs / schemas / evidence before support-note closure, leaving retirement state unjoined to build and line identity, and retiring through silent disappearance / stale selection UI / orphaned support truth. The matrix binds back to the already-landed stable-proof-index and migration-task-row packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "retired_state_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_retired_state_end_of_support_closure_successor_routing_and_tombstone_archive_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "retired_state_rows": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/retired_state_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "retired_state_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retired_state_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "supported_line",
        "stable_capability",
        "bundle",
        "command_deep_link",
        "schema_bearing_surface",
        "registry_visible_package",
        "managed_tenant_feature"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "deprecated",
        "disabled_by_policy",
        "stable_line_narrowed",
        "retired"
      ]
    },
    "semantic_role": {
      "enum": [
        "last_supported_pin",
        "successor_routing",
        "disable_path",
        "export_rollback_route",
        "archival_note",
        "migration_outcome",
        "support_note_closure"
      ]
    },
    "retirement_transition": {
      "type": "object",
      "required": [
        "last_supported_version_or_channel",
        "cutoff_date",
        "successor_path",
        "disable_path",
        "export_rollback_route",
        "archival_note",
        "migration_outcome",
        "support_note_closure_state"
      ],
      "properties": {
        "last_supported_version_or_channel": {
          "$ref": "#/$defs/non_empty_string"
        },
        "cutoff_date": {
          "$ref": "#/$defs/non_empty_string"
        },
        "successor_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "disable_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "export_rollback_route": {
          "$ref": "#/$defs/non_empty_string"
        },
        "archival_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "migration_outcome": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_note_closure_state": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "retired_state_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "lifecycle_state",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "retirement_transition",
        "surface_families",
        "removal_horizon_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "lets_a_retired_surface_disappear_without_tombstone_archival_route_or_successor_pointer",
        "keeps_a_retired_class_selectable_in_new_install_new_tenant_marketplace_or_upgrade_flow",
        "destroys_last_supported_docs_schemas_or_evidence_before_support_note_closure",
        "leaves_retirement_state_unjoined_to_build_line_identity_deployment_profile_and_migration_outcome",
        "retires_a_surface_through_silent_disappearance_stale_selection_ui_or_orphaned_support_truth"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "lifecycle_state": {
          "$ref": "#/$defs/lifecycle_state"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retirement_transition": {
          "$ref": "#/$defs/retirement_transition"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "removal_horizon_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "supported_line_roles": {
          "type": "array"
        },
        "stable_capability_roles": {
          "type": "array"
        },
        "bundle_roles": {
          "type": "array"
        },
        "command_deep_link_roles": {
          "type": "array"
        },
        "schema_bearing_surface_roles": {
          "type": "array"
        },
        "registry_visible_package_roles": {
          "type": "array"
        },
        "managed_tenant_feature_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "lets_a_retired_surface_disappear_without_tombstone_archival_route_or_successor_pointer": {
          "const": false
        },
        "keeps_a_retired_class_selectable_in_new_install_new_tenant_marketplace_or_upgrade_flow": {
          "const": false
        },
        "destroys_last_supported_docs_schemas_or_evidence_before_support_note_closure": {
          "const": false
        },
        "leaves_retirement_state_unjoined_to_build_line_identity_deployment_profile_and_migration_outcome": {
          "const": false
        },
        "retires_a_surface_through_silent_disappearance_stale_selection_ui_or_orphaned_support_truth": {
          "const": false
        }
      }
    }
  }
}
