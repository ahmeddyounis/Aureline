{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/program/m5-imported-offline-evidence-lineage-propagation.schema.json",
  "title": "M5 Imported / Offline Evidence Lineage Propagation",
  "description": "Export-safe record propagating the five B149 non-live-evidence object classes (retirement snapshot, captured support / export evidence, archived runbook packet, imported / offline route evidence, review / incident snapshot) as imported / offline evidence into the first downstream consumers that can ingest archived data — the shell / archive-viewer, help / docs, support, review / incident, runbook-archive, release-center, companion / export, program-governance, and CLI / export surfaces — proving one canonical non-live vocabulary: every binding carries the controlled non-live grammar (historical-role, snapshot-label, capture-time, provenance, mutation-blocked-posture, and the shared 'Showing imported or offline evidence' label) identical for one profile across surfaces, joins its lineage back to a source snapshot descriptor plus a controlled capture-context join, and names either a live-target handoff packet (when the lineage is joinable) or a metadata-only exit, so a historical packet can never be ranked, narrated, or summarized as current route, health, or provider truth, the non-live boundary is always called out, and no live secret or stale authority leaks through the lineage metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "lineage_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_imported_offline_lineage_registry"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "lineage_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lineage_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_class": {
      "type": "string",
      "enum": [
        "retirement_snapshot",
        "support_export_evidence",
        "archived_runbook_packet",
        "imported_offline_route_evidence",
        "review_incident_snapshot"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell",
        "help_docs",
        "support",
        "review_incident",
        "runbook_archive",
        "release_center",
        "companion_export",
        "program_governance",
        "cli_export"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "live_target_joinable",
        "imported_offline_only",
        "metadata_only_exit",
        "exported_redacted_lineage"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["live_target_lineage_joined", "non_live_boundary_disclosed"]
    },
    "lineage_consumer_action": {
      "type": "string",
      "enum": ["inspect_lineage", "export_lineage", "open_current_live_object"]
    },
    "lineage_next_action": {
      "type": "string",
      "enum": [
        "open_current_live_object_through_validated_handoff",
        "inspect_lineage_metadata_only"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "high_zoom_reflow",
        "high_contrast_safe",
        "cli_exportable",
        "support_packet_present"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "grammar_drift_detected",
        "mutation_blocked_posture_dropped",
        "ranked_or_narrated_as_current_live_service_truth",
        "presents_imported_offline_as_current_route_or_provider_state",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "leaks_live_secret_or_stale_authority_through_lineage",
        "drops_non_live_vocabulary_in_export",
        "lineage_unjoined_to_source_descriptor",
        "accessibility_route_dropped",
        "canonical_registry_reference_missing",
        "upstream_historical_reference_narrowed"
      ]
    },
    "non_live_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_role_word",
        "snapshot_label_word",
        "capture_time_word",
        "provenance_word",
        "mutation_blocked_posture_word",
        "imported_offline_label_word"
      ],
      "properties": {
        "historical_role_word": { "type": "string", "minLength": 1 },
        "snapshot_label_word": { "type": "string", "minLength": 1 },
        "capture_time_word": { "type": "string", "minLength": 1 },
        "provenance_word": { "type": "string", "minLength": 1 },
        "mutation_blocked_posture_word": { "type": "string", "minLength": 1 },
        "imported_offline_label_word": { "type": "string", "minLength": 1 }
      }
    },
    "lineage_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_capture_context_ref",
        "producer_build_ref",
        "provenance_lineage_ref"
      ],
      "properties": {
        "source_capture_context_ref": { "type": "string", "minLength": 1 },
        "producer_build_ref": { "type": "string", "minLength": 1 },
        "provenance_lineage_ref": { "type": "string", "minLength": 1 }
      }
    },
    "lineage_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot_descriptor_ref",
        "lineage_join",
        "live_target_handoff_ref",
        "metadata_only_exit_ref",
        "non_live_boundary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "source_snapshot_descriptor_ref": { "type": "string", "minLength": 1 },
        "lineage_join": { "$ref": "#/$defs/lineage_join" },
        "live_target_handoff_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "metadata_only_exit_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "non_live_boundary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/lineage_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "lineage_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "lineage_profile_id",
        "lineage_profile_label",
        "object_class",
        "consumer",
        "disposition",
        "disposition_label",
        "non_live_grammar",
        "content_available",
        "parity_state",
        "allowed_actions",
        "accessibility_routes",
        "lineage_descriptor",
        "non_live_boundary_explicitly_called_out",
        "ranked_or_narrated_as_current_live_service_truth",
        "presents_imported_offline_as_current_route_or_provider_state",
        "reopens_live_target_without_validating_identity_trust_route_and_authority",
        "leaks_live_secret_or_stale_authority_through_lineage",
        "drops_non_live_vocabulary_in_export",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "lineage_profile_id": { "type": "string", "minLength": 1 },
        "lineage_profile_label": { "type": "string", "minLength": 1 },
        "object_class": { "$ref": "#/$defs/object_class" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "disposition_label": { "type": "string", "minLength": 1 },
        "non_live_grammar": { "$ref": "#/$defs/non_live_grammar" },
        "content_available": { "type": "boolean" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "allowed_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/lineage_consumer_action" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "lineage_descriptor": { "$ref": "#/$defs/lineage_descriptor" },
        "non_live_boundary_explicitly_called_out": { "type": "boolean" },
        "ranked_or_narrated_as_current_live_service_truth": { "type": "boolean" },
        "presents_imported_offline_as_current_route_or_provider_state": { "type": "boolean" },
        "reopens_live_target_without_validating_identity_trust_route_and_authority": { "type": "boolean" },
        "leaks_live_secret_or_stale_authority_through_lineage": { "type": "boolean" },
        "drops_non_live_vocabulary_in_export": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
