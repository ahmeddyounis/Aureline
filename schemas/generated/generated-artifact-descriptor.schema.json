{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/generated/generated-artifact-descriptor.schema.json",
  "title": "Aureline generated-artifact descriptor packet",
  "description": "Boundary schema for the checked-in generated-artifact descriptor packet and its scenario fixtures. Each descriptor is the per-file object the M5 file-tree, search, review, AI-context, and support/export surfaces render: it carries the artifact class, the authority/provenance class, the generator identity with version, the canonical-source reference, the regeneration route, the drift state, the declared writable-boundary posture, the reversible-checkpoint lineage reference, and the engine-computed presentation (presented authority, ordinary-source claim, narrowed edit posture, block-reason tokens, and the stable copy line). Raw generated bytes, credentials, raw generator payloads, raw paths, and raw traces never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen",
        "ai_assisted_edit",
        "support_packet"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "canonical_authoritative",
        "derived_editable",
        "derived_readonly"
      ]
    },
    "generator_kind": {
      "type": "string",
      "enum": [
        "template",
        "kernel",
        "builder",
        "runner",
        "framework",
        "composer",
        "exporter"
      ]
    },
    "canonical_source_state": {
      "type": "string",
      "enum": ["linked", "hidden", "missing"]
    },
    "drift_state": {
      "type": "string",
      "enum": ["in_sync", "drifting", "source_missing", "unknown"]
    },
    "edit_posture": {
      "type": "string",
      "enum": [
        "direct_edit_allowed",
        "reviewed_override_required",
        "regenerate_only"
      ]
    },
    "presented_authority": {
      "type": "string",
      "enum": ["ordinary_source", "derived_annotated", "provenance_withheld"]
    },
    "surface_kind": {
      "type": "string",
      "enum": [
        "file_tree",
        "search_result",
        "review_view",
        "ai_context",
        "support_export"
      ]
    },
    "generator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "$ref": "#/$defs/generator_kind" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "canonical_source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source_ref"],
      "properties": {
        "state": { "$ref": "#/$defs/canonical_source_state" },
        "source_ref": { "type": "string" }
      }
    },
    "descriptor_presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presented_authority",
        "ordinary_source_claim_allowed",
        "effective_edit_posture",
        "edit_posture_downgraded",
        "block_reason_tokens",
        "copy_line"
      ],
      "properties": {
        "presented_authority": { "$ref": "#/$defs/presented_authority" },
        "ordinary_source_claim_allowed": { "type": "boolean" },
        "effective_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "edit_posture_downgraded": { "type": "boolean" },
        "block_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "copy_line": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_id",
        "artifact_class",
        "artifact_path_label",
        "authority_class",
        "generator",
        "canonical_source",
        "regeneration_route",
        "drift_state",
        "declared_edit_posture",
        "checkpoint_lineage_ref",
        "evidence_refs",
        "why_this_artifact",
        "presentation",
        "notes"
      ],
      "properties": {
        "descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "artifact_path_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "generator": { "$ref": "#/$defs/generator_identity" },
        "canonical_source": { "$ref": "#/$defs/canonical_source_ref" },
        "regeneration_route": { "$ref": "#/$defs/non_empty_string" },
        "drift_state": { "$ref": "#/$defs/drift_state" },
        "declared_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "checkpoint_lineage_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "why_this_artifact": { "$ref": "#/$defs/non_empty_string" },
        "presentation": { "$ref": "#/$defs/descriptor_presentation" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "consumer_ref",
        "ingested_packet_id",
        "preserved_identity_fields",
        "summary"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/surface_kind" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "preserved_identity_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/generated/generated-artifact-descriptor.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/generated/generated-artifact-descriptor.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/generated/generated-artifact-descriptor-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/generated/generated-artifact-descriptor.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/generated/generated-artifact-descriptor/manifest.yaml"
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "surfaces",
        "evidence_packet_refs",
        "descriptors",
        "surface_bindings",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "generated_artifact_descriptor_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_kind" },
          "minItems": 5,
          "uniqueItems": true
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor" },
          "minItems": 7
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 5
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "scenario",
        "descriptor",
        "expected_presented_authority",
        "expected_ordinary_source_claim_allowed",
        "expected_effective_edit_posture",
        "expected_block_reason_tokens",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "generated_artifact_descriptor_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "descriptor": { "$ref": "#/$defs/descriptor" },
        "expected_presented_authority": { "$ref": "#/$defs/presented_authority" },
        "expected_ordinary_source_claim_allowed": { "type": "boolean" },
        "expected_effective_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "expected_block_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
