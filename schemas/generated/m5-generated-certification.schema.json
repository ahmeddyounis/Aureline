{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/generated/m5-generated-certification.schema.json",
  "title": "Aureline generated-artifact certification packet",
  "description": "Boundary schema for the checked-in generated-artifact certification packet and its scenario fixtures. The packet is the promotion-grade capstone over the generated-artifact governance lane: per claimed M5 publishable profile (scaffolded-project/notebook-output/preview-derivative/request-artifact/framework-codegen) it binds the profile's upstream claim-publication object and backing generated-artifact class to the four certification domains (canonical-source visibility, writable-boundary truth, regeneration path, restore/export honesty), carries the evidence backing each, and stamps the narrowed verdict, certified maturity, and promotion decision the engine reaches plus the automatic maturity-narrowing rules, failure/recovery drills, and publication-channel bindings. Raw generated bytes, credentials, raw generator payloads, raw paths, and raw traces never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "certified_profile": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen"
      ]
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen",
        "ai_assisted_edit",
        "support_packet"
      ]
    },
    "certification_domain": {
      "type": "string",
      "enum": [
        "canonical_source_visibility",
        "writable_boundary_truth",
        "regeneration_path",
        "restore_export_honesty"
      ]
    },
    "claim_maturity": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["current", "partial", "stale", "missing", "not_applicable"]
    },
    "row_verdict": {
      "type": "string",
      "enum": ["certified", "narrowed", "withheld"]
    },
    "promotion_decision": {
      "type": "string",
      "enum": ["promote", "promote_narrowed", "hold"]
    },
    "publication_channel": {
      "type": "string",
      "enum": ["release_shiproom", "support_export", "docs", "help"]
    },
    "domain_failure_class": {
      "type": "string",
      "enum": [
        "canonical_source_invisible",
        "writable_boundary_unproven",
        "regeneration_path_broken",
        "restore_export_dishonest"
      ]
    },
    "drill_phase": {
      "type": "string",
      "enum": ["inject", "observe", "narrow", "refresh", "recover", "verify"]
    },
    "domain_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "evidence_state", "evidence_refs", "rationale"],
      "properties": {
        "domain": { "$ref": "#/$defs/certification_domain" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/generated/m5-generated-certification.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/generated/m5-generated-certification.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/generated/m5-generated-certification-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/generated/m5-generated-certification.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/generated/m5-generated-certification/manifest.yaml"
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "profile",
        "profile_label",
        "claim_publication_ref",
        "backing_artifact_class",
        "governance_evidence_ref",
        "published_claim_maturity",
        "domains",
        "certified_maturity",
        "verdict",
        "narrowed",
        "promotion_decision",
        "narrow_reason_tokens",
        "stale_or_missing_domain_tokens",
        "why_certified",
        "supporting_evidence_refs",
        "consumer_refs",
        "notes"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "profile_label": { "$ref": "#/$defs/non_empty_string" },
        "claim_publication_ref": { "$ref": "#/$defs/non_empty_string" },
        "backing_artifact_class": { "$ref": "#/$defs/artifact_class" },
        "governance_evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "published_claim_maturity": { "$ref": "#/$defs/claim_maturity" },
        "domains": {
          "type": "array",
          "items": { "$ref": "#/$defs/domain_evidence" },
          "minItems": 4
        },
        "certified_maturity": { "$ref": "#/$defs/claim_maturity" },
        "verdict": { "$ref": "#/$defs/row_verdict" },
        "narrowed": { "type": "boolean" },
        "promotion_decision": { "$ref": "#/$defs/promotion_decision" },
        "narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "stale_or_missing_domain_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "why_certified": { "$ref": "#/$defs/non_empty_string" },
        "supporting_evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "consumer_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_evidence_state",
        "maturity_floor",
        "promotion_decision",
        "effect",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_evidence_state": {
          "type": "string",
          "enum": ["partial", "stale", "missing"]
        },
        "maturity_floor": { "$ref": "#/$defs/claim_maturity" },
        "promotion_decision": { "$ref": "#/$defs/promotion_decision" },
        "effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "observed_maturity",
        "observed_promotion_decision",
        "narration"
      ],
      "properties": {
        "phase": { "$ref": "#/$defs/drill_phase" },
        "observed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "observed_promotion_decision": { "$ref": "#/$defs/promotion_decision" },
        "narration": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_id",
        "title",
        "profile",
        "exercised_domain",
        "failure_class",
        "degraded_evidence_state",
        "published_claim_maturity",
        "expected_degraded_verdict",
        "expected_degraded_maturity",
        "expected_degraded_promotion_decision",
        "recovers_to_verdict",
        "steps",
        "asserts_claim_narrows_under_failure",
        "asserts_recovers_after_refresh",
        "notes"
      ],
      "properties": {
        "drill_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "exercised_domain": { "$ref": "#/$defs/certification_domain" },
        "failure_class": { "$ref": "#/$defs/domain_failure_class" },
        "degraded_evidence_state": { "$ref": "#/$defs/evidence_state" },
        "published_claim_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_degraded_verdict": { "$ref": "#/$defs/row_verdict" },
        "expected_degraded_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_degraded_promotion_decision": {
          "$ref": "#/$defs/promotion_decision"
        },
        "recovers_to_verdict": {
          "type": "string",
          "const": "certified"
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill_step" },
          "minItems": 1
        },
        "asserts_claim_narrows_under_failure": {
          "type": "boolean",
          "const": true
        },
        "asserts_recovers_after_refresh": {
          "type": "boolean",
          "const": true
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "consumer_ref",
        "ingested_packet_id",
        "required_verbatim_fields",
        "narrows_with_packet",
        "summary"
      ],
      "properties": {
        "channel": { "$ref": "#/$defs/publication_channel" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "required_verbatim_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrows_with_packet": { "type": "boolean", "const": true },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "certified_domains",
        "evidence_packet_refs",
        "rows",
        "freshness_rules",
        "drills",
        "surface_bindings",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_generated_certification_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "certified_domains": {
          "type": "array",
          "items": { "$ref": "#/$defs/certification_domain" },
          "minItems": 4,
          "uniqueItems": true
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/certification_row" },
          "minItems": 5
        },
        "freshness_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/freshness_rule" },
          "minItems": 3
        },
        "drills": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill" },
          "minItems": 1
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 4
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "profile",
        "published_claim_maturity",
        "observed_domains",
        "expected_verdict",
        "expected_certified_maturity",
        "expected_promotion_decision",
        "expected_narrow_reason_tokens",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_generated_certification_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "published_claim_maturity": { "$ref": "#/$defs/claim_maturity" },
        "observed_domains": {
          "type": "array",
          "items": { "$ref": "#/$defs/domain_evidence" },
          "minItems": 4
        },
        "expected_verdict": { "$ref": "#/$defs/row_verdict" },
        "expected_certified_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_promotion_decision": { "$ref": "#/$defs/promotion_decision" },
        "expected_narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
