{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/generated/generated-timeline-entry.schema.json",
  "title": "Aureline generated-artifact timeline packet",
  "description": "Boundary schema for the checked-in generated-artifact timeline packet and its scenario fixtures. Each entry is the per-checkpoint object the local-history timeline, compare view, restore preview, and support/export surfaces render: it records how the bytes were captured (full snapshot, metadata-plus-reference, regenerated candidate, or omitted bytes), the redaction class, the generator identity, the canonical-source reference, the divergence state, the reversible-checkpoint lineage reference, and the engine-computed outcome (restore fidelity, exact-byte-continuity claim, byte-provenance explanation, compare basis, restore availability, and block-reason tokens). Exact generated-byte continuity is claimed only when a full, unredacted snapshot was captured. Raw captured bodies, secret material, raw paths, and live authority never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen",
        "ai_assisted_edit",
        "support_packet"
      ]
    },
    "generator_kind": {
      "type": "string",
      "enum": [
        "template",
        "kernel",
        "builder",
        "runner",
        "framework",
        "composer",
        "exporter"
      ]
    },
    "canonical_source_state": {
      "type": "string",
      "enum": ["linked", "hidden", "missing"]
    },
    "drift_state": {
      "type": "string",
      "enum": ["in_sync", "drifting", "source_missing", "unknown"]
    },
    "capture_mode": {
      "type": "string",
      "enum": [
        "full_snapshot",
        "metadata_plus_reference",
        "regenerated_candidate",
        "omitted_bytes"
      ]
    },
    "redaction_class": {
      "type": "string",
      "enum": ["none", "secrets_redacted", "size_capped", "policy_withheld"]
    },
    "restore_fidelity": {
      "type": "string",
      "enum": ["exact_snapshot", "compatible_regeneration", "evidence_only"]
    },
    "compare_basis": {
      "type": "string",
      "enum": ["byte_snapshot", "regenerated_candidate", "evidence_manifest"]
    },
    "restore_availability": {
      "type": "string",
      "enum": ["available", "review_required", "disabled_export_only"]
    },
    "timeline_surface": {
      "type": "string",
      "enum": [
        "history_timeline",
        "compare_view",
        "restore_preview",
        "support_export"
      ]
    },
    "generator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "$ref": "#/$defs/generator_kind" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "canonical_source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source_ref"],
      "properties": {
        "state": { "$ref": "#/$defs/canonical_source_state" },
        "source_ref": { "type": "string" }
      }
    },
    "byte_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_directly",
        "reconstructed_from_source",
        "bytes_omitted",
        "redacted",
        "summary"
      ],
      "properties": {
        "captured_directly": { "type": "boolean" },
        "reconstructed_from_source": { "type": "boolean" },
        "bytes_omitted": { "type": "boolean" },
        "redacted": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "history_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restore_fidelity",
        "exact_byte_continuity_claimed",
        "byte_provenance",
        "compare_basis",
        "restore_availability",
        "writes_new_checkpoint_on_restore",
        "block_reason_tokens"
      ],
      "properties": {
        "restore_fidelity": { "$ref": "#/$defs/restore_fidelity" },
        "exact_byte_continuity_claimed": { "type": "boolean" },
        "byte_provenance": { "$ref": "#/$defs/byte_provenance" },
        "compare_basis": { "$ref": "#/$defs/compare_basis" },
        "restore_availability": { "$ref": "#/$defs/restore_availability" },
        "writes_new_checkpoint_on_restore": { "type": "boolean" },
        "block_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "export_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes_entry_id",
        "includes_generator_identity",
        "includes_canonical_source_ref",
        "includes_checkpoint_lineage_ref",
        "includes_capture_mode",
        "includes_restore_fidelity",
        "raw_body_excluded",
        "raw_secret_material_excluded",
        "live_authority_excluded"
      ],
      "properties": {
        "includes_entry_id": { "type": "boolean" },
        "includes_generator_identity": { "type": "boolean" },
        "includes_canonical_source_ref": { "type": "boolean" },
        "includes_checkpoint_lineage_ref": { "type": "boolean" },
        "includes_capture_mode": { "type": "boolean" },
        "includes_restore_fidelity": { "type": "boolean" },
        "raw_body_excluded": { "type": "boolean" },
        "raw_secret_material_excluded": { "type": "boolean" },
        "live_authority_excluded": { "type": "boolean" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "display_label",
        "artifact_class",
        "artifact_path_label",
        "generator",
        "canonical_source",
        "divergence_state",
        "checkpoint_lineage_ref",
        "capture_mode",
        "redaction_class",
        "captured_body_ref",
        "outcome",
        "export_projection",
        "copy_line",
        "captured_at",
        "notes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "display_label": { "$ref": "#/$defs/non_empty_string" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "artifact_path_label": { "$ref": "#/$defs/non_empty_string" },
        "generator": { "$ref": "#/$defs/generator_identity" },
        "canonical_source": { "$ref": "#/$defs/canonical_source_ref" },
        "divergence_state": { "$ref": "#/$defs/drift_state" },
        "checkpoint_lineage_ref": { "$ref": "#/$defs/non_empty_string" },
        "capture_mode": { "$ref": "#/$defs/capture_mode" },
        "redaction_class": { "$ref": "#/$defs/redaction_class" },
        "captured_body_ref": { "type": "string" },
        "outcome": { "$ref": "#/$defs/history_outcome" },
        "export_projection": { "$ref": "#/$defs/export_projection" },
        "copy_line": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "consumer_ref", "ingested_packet_id", "summary"],
      "properties": {
        "surface": { "$ref": "#/$defs/timeline_surface" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/generated/generated-history.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/generated/generated-timeline-entry.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/generated/generated-timeline-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/generated/generated-timeline.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/generated/timeline/manifest.yaml"
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "consumer_surfaces",
        "evidence_packet_refs",
        "entries",
        "surface_bindings",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "generated_timeline_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeline_surface" },
          "minItems": 4,
          "uniqueItems": true
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" },
          "minItems": 4
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 4
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "scenario",
        "entry",
        "expected_restore_fidelity",
        "expected_exact_byte_continuity_claimed",
        "expected_block_reason_tokens",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "generated_timeline_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "entry": { "$ref": "#/$defs/entry" },
        "expected_restore_fidelity": { "$ref": "#/$defs/restore_fidelity" },
        "expected_exact_byte_continuity_claimed": { "type": "boolean" },
        "expected_block_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
