{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/generated/m5-generated-governance.schema.json",
  "title": "Aureline generated-artifact governance packet",
  "description": "Boundary schema for the checked-in generated-artifact governance packet and its scenario fixtures. The packet certifies generated-artifact truth on claimed M5 scaffolded-project/notebook-output/preview-derivative/request-artifact/framework-codegen/ai-assisted-edit/support-packet classes: per class it carries the seven required provenance dimensions (canonical source, generator identity, provenance class, writable boundary, regeneration route, drift state, checkpoint lineage), the evidence backing each, the narrowed verdict and writable-boundary posture the engine reaches, the automatic maturity- and writable-boundary-narrowing rules, the failure/recovery drills, and the publication-channel bindings. Raw generated bytes, credentials, raw generator payloads, raw paths, and raw traces never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen",
        "ai_assisted_edit",
        "support_packet"
      ]
    },
    "provenance_dimension": {
      "type": "string",
      "enum": [
        "canonical_source",
        "generator_identity",
        "provenance_class",
        "writable_boundary",
        "regeneration_route",
        "drift_state",
        "checkpoint_lineage"
      ]
    },
    "claim_maturity": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "edit_posture": {
      "type": "string",
      "enum": [
        "direct_edit_allowed",
        "reviewed_override_required",
        "regenerate_only"
      ]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["current", "partial", "stale", "missing", "not_applicable"]
    },
    "row_verdict": {
      "type": "string",
      "enum": ["certified", "narrowed", "withheld"]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "canonical_authoritative",
        "derived_editable",
        "derived_readonly"
      ]
    },
    "publication_channel": {
      "type": "string",
      "enum": ["release_shiproom", "support_export", "docs", "help"]
    },
    "drill_failure_class": {
      "type": "string",
      "enum": [
        "canonical_source_unlinked",
        "generator_identity_unknown",
        "provenance_class_unclassified",
        "writable_boundary_unenforced",
        "regeneration_route_missing",
        "drift_undetected",
        "checkpoint_lineage_broken"
      ]
    },
    "drill_phase": {
      "type": "string",
      "enum": ["inject", "observe", "narrow", "refresh", "recover", "verify"]
    },
    "dimension_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "evidence_state", "evidence_refs", "rationale"],
      "properties": {
        "dimension": { "$ref": "#/$defs/provenance_dimension" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/generated/m5-generated-governance.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/generated/m5-generated-governance.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/generated/m5-generated-proof-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/generated/m5-generated-governance.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/generated/m5-generated-governance/manifest.yaml"
        }
      }
    },
    "artifact_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "artifact_class",
        "class_label",
        "authority_class",
        "claimed_maturity",
        "claimed_edit_posture",
        "backing_surface_classes",
        "dimensions",
        "effective_maturity",
        "verdict",
        "narrowed",
        "narrow_reason_tokens",
        "stale_or_missing_dimension_tokens",
        "effective_edit_posture",
        "edit_posture_downgraded",
        "edit_posture_downgrade_tokens",
        "why_this_artifact",
        "supporting_evidence_refs",
        "consumer_refs",
        "notes"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "class_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "backing_surface_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension_evidence" },
          "minItems": 7
        },
        "effective_maturity": { "$ref": "#/$defs/claim_maturity" },
        "verdict": { "$ref": "#/$defs/row_verdict" },
        "narrowed": { "type": "boolean" },
        "narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "stale_or_missing_dimension_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "effective_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "edit_posture_downgraded": { "type": "boolean" },
        "edit_posture_downgrade_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "why_this_artifact": { "$ref": "#/$defs/non_empty_string" },
        "supporting_evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "consumer_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_evidence_state",
        "maturity_floor",
        "effect",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_evidence_state": {
          "type": "string",
          "enum": ["partial", "stale", "missing"]
        },
        "maturity_floor": { "$ref": "#/$defs/claim_maturity" },
        "effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "edit_boundary_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_evidence_state",
        "edit_posture_floor",
        "effect",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_evidence_state": {
          "type": "string",
          "enum": ["partial", "stale", "missing"]
        },
        "edit_posture_floor": { "$ref": "#/$defs/edit_posture" },
        "effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "observed_maturity",
        "observed_edit_posture",
        "narration"
      ],
      "properties": {
        "phase": { "$ref": "#/$defs/drill_phase" },
        "observed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "observed_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "narration": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_id",
        "title",
        "artifact_class",
        "exercised_dimension",
        "failure_class",
        "degraded_evidence_state",
        "claimed_maturity",
        "claimed_edit_posture",
        "expected_degraded_verdict",
        "expected_degraded_maturity",
        "expected_degraded_edit_posture",
        "recovers_to_verdict",
        "steps",
        "asserts_claim_narrows_under_failure",
        "asserts_recovers_after_refresh",
        "notes"
      ],
      "properties": {
        "drill_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "exercised_dimension": { "$ref": "#/$defs/provenance_dimension" },
        "failure_class": { "$ref": "#/$defs/drill_failure_class" },
        "degraded_evidence_state": { "$ref": "#/$defs/evidence_state" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "expected_degraded_verdict": { "$ref": "#/$defs/row_verdict" },
        "expected_degraded_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_degraded_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "recovers_to_verdict": {
          "type": "string",
          "const": "certified"
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill_step" },
          "minItems": 1
        },
        "asserts_claim_narrows_under_failure": {
          "type": "boolean",
          "const": true
        },
        "asserts_recovers_after_refresh": {
          "type": "boolean",
          "const": true
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "consumer_ref",
        "ingested_packet_id",
        "required_verbatim_fields",
        "narrows_with_packet",
        "summary"
      ],
      "properties": {
        "channel": { "$ref": "#/$defs/publication_channel" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "required_verbatim_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrows_with_packet": { "type": "boolean", "const": true },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "certified_dimensions",
        "evidence_packet_refs",
        "rows",
        "freshness_rules",
        "edit_boundary_rules",
        "drills",
        "surface_bindings",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_generated_governance_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "certified_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance_dimension" },
          "minItems": 7,
          "uniqueItems": true
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_row" },
          "minItems": 7
        },
        "freshness_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/freshness_rule" },
          "minItems": 3
        },
        "edit_boundary_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/edit_boundary_rule" },
          "minItems": 3
        },
        "drills": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill" },
          "minItems": 1
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 4
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "artifact_class",
        "claimed_maturity",
        "claimed_edit_posture",
        "observed_dimensions",
        "expected_verdict",
        "expected_effective_maturity",
        "expected_edit_posture",
        "expected_narrow_reason_tokens",
        "expected_edit_posture_downgrade_tokens",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_generated_governance_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "observed_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension_evidence" },
          "minItems": 7
        },
        "expected_verdict": { "$ref": "#/$defs/row_verdict" },
        "expected_effective_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "expected_narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "expected_edit_posture_downgrade_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
