{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/generated/write-boundary.schema.json",
  "title": "Aureline generated-artifact write-boundary packet",
  "description": "Boundary schema for the checked-in write-boundary packet and its scenario fixtures. The packet models what happens when a user attempts a direct edit to a generated artifact across the claimed M5 scaffolded-project/notebook-output/preview-derivative/request-artifact/framework-codegen/ai-assisted-edit/support-packet classes: per case it carries the artifact subject (class, authority, declared writable-boundary posture, current boundary state, canonical-source linkage, generator, regeneration route, and any recorded reviewed override) and the decision the single engine reaches — the effective edit gate, the attempt outcome, the why-blocked tokens, the canonical-source jump, the three-way compare, the durable diverged-from-generator state an admitted override leaves, and the recovery path. Raw generated bytes, raw diffs, credentials, and raw paths never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen",
        "ai_assisted_edit",
        "support_packet"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "canonical_authoritative",
        "derived_editable",
        "derived_readonly"
      ]
    },
    "edit_posture": {
      "type": "string",
      "enum": [
        "direct_edit_allowed",
        "reviewed_override_required",
        "regenerate_only"
      ]
    },
    "boundary_state": {
      "type": "string",
      "enum": [
        "in_sync",
        "drift_detected",
        "source_missing",
        "generator_unavailable",
        "regeneration_blocked_by_policy"
      ]
    },
    "regeneration_availability": {
      "type": "string",
      "enum": [
        "available",
        "blocked_source_missing",
        "blocked_generator_unavailable",
        "blocked_by_policy"
      ]
    },
    "attempt_outcome": {
      "type": "string",
      "enum": [
        "direct_edit_admitted",
        "blocked_pending_review",
        "override_admitted_with_divergence",
        "blocked_regenerate_first"
      ]
    },
    "compare_leg_kind": {
      "type": "string",
      "enum": [
        "canonical_source",
        "current_artifact",
        "regenerated_candidate"
      ]
    },
    "leg_availability": {
      "type": "string",
      "enum": ["available", "unavailable"]
    },
    "recovery_class": {
      "type": "string",
      "enum": [
        "regenerate_from_source",
        "reconcile_into_source",
        "reviewed_override",
        "restore_canonical_source",
        "restore_generator",
        "resolve_regeneration_policy"
      ]
    },
    "generator_kind": {
      "type": "string",
      "enum": [
        "template",
        "kernel",
        "builder",
        "runner",
        "framework",
        "composer",
        "exporter"
      ]
    },
    "write_boundary_surface": {
      "type": "string",
      "enum": [
        "file_tree_save_gate",
        "review_override_sheet",
        "diverged_state_lineage",
        "ai_context",
        "support_export"
      ]
    },
    "generator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "$ref": "#/$defs/generator_kind" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "canonical_source_jump": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "label"],
      "properties": {
        "source_ref": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "compare_leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "availability", "provenance_ref", "unavailable_reason"],
      "properties": {
        "kind": { "$ref": "#/$defs/compare_leg_kind" },
        "availability": { "$ref": "#/$defs/leg_availability" },
        "provenance_ref": { "$ref": "#/$defs/non_empty_string" },
        "unavailable_reason": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "three_way_compare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legs", "provenance_preserved", "summary"],
      "properties": {
        "legs": {
          "type": "array",
          "items": { "$ref": "#/$defs/compare_leg" },
          "minItems": 3,
          "maxItems": 3
        },
        "provenance_preserved": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "recovery_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "action_ref", "summary"],
      "properties": {
        "class": { "$ref": "#/$defs/recovery_class" },
        "action_ref": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "diverged_from_generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "divergence_id",
        "diverged",
        "override_review_ref",
        "recovery",
        "summary"
      ],
      "properties": {
        "divergence_id": { "$ref": "#/$defs/non_empty_string" },
        "diverged": { "type": "boolean", "const": true },
        "override_review_ref": { "$ref": "#/$defs/non_empty_string" },
        "recovery": {
          "type": "array",
          "items": { "$ref": "#/$defs/recovery_step" },
          "minItems": 1
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "write_boundary_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "artifact_path_label",
        "authority_class",
        "generator",
        "declared_edit_posture",
        "boundary_state",
        "canonical_source_ref",
        "regeneration_route",
        "checkpoint_lineage_ref",
        "override_review_ref"
      ],
      "properties": {
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "artifact_path_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "generator": { "$ref": "#/$defs/generator_identity" },
        "declared_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "boundary_state": { "$ref": "#/$defs/boundary_state" },
        "canonical_source_ref": { "$ref": "#/$defs/nullable_string" },
        "regeneration_route": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_lineage_ref": { "$ref": "#/$defs/non_empty_string" },
        "override_review_ref": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "write_boundary_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_state",
        "effective_edit_gate",
        "edit_gate_downgraded",
        "attempt_outcome",
        "direct_edit_admitted",
        "why_blocked_tokens",
        "canonical_source_jump",
        "regeneration_availability",
        "three_way_compare",
        "diverged_from_generator",
        "recovery",
        "guidance_line",
        "copy_line"
      ],
      "properties": {
        "boundary_state": { "$ref": "#/$defs/boundary_state" },
        "effective_edit_gate": { "$ref": "#/$defs/edit_posture" },
        "edit_gate_downgraded": { "type": "boolean" },
        "attempt_outcome": { "$ref": "#/$defs/attempt_outcome" },
        "direct_edit_admitted": { "type": "boolean" },
        "why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "canonical_source_jump": {
          "oneOf": [
            { "$ref": "#/$defs/canonical_source_jump" },
            { "type": "null" }
          ]
        },
        "regeneration_availability": { "$ref": "#/$defs/regeneration_availability" },
        "three_way_compare": { "$ref": "#/$defs/three_way_compare" },
        "diverged_from_generator": {
          "oneOf": [
            { "$ref": "#/$defs/diverged_from_generator" },
            { "type": "null" }
          ]
        },
        "recovery": {
          "type": "array",
          "items": { "$ref": "#/$defs/recovery_step" }
        },
        "guidance_line": { "$ref": "#/$defs/non_empty_string" },
        "copy_line": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "write_boundary_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "scenario",
        "subject",
        "decision",
        "evidence_refs",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "subject": { "$ref": "#/$defs/write_boundary_subject" },
        "decision": { "$ref": "#/$defs/write_boundary_decision" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "consumer_ref", "ingested_packet_id", "summary"],
      "properties": {
        "surface": { "$ref": "#/$defs/write_boundary_surface" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/generated/write-boundary-review.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/generated/write-boundary.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/generated/write-boundary-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/generated/write-boundary.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/generated/write-boundary/manifest.yaml"
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "boundary_states",
        "evidence_packet_refs",
        "cases",
        "surface_bindings",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "write_boundary_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "boundary_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundary_state" },
          "minItems": 5,
          "uniqueItems": true
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/write_boundary_case" },
          "minItems": 7
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 5
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "scenario",
        "case",
        "expected_attempt_outcome",
        "expected_effective_edit_gate",
        "expected_boundary_state",
        "expected_why_blocked_tokens",
        "expected_leaves_divergence",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "write_boundary_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "case": { "$ref": "#/$defs/write_boundary_case" },
        "expected_attempt_outcome": { "$ref": "#/$defs/attempt_outcome" },
        "expected_effective_edit_gate": { "$ref": "#/$defs/edit_posture" },
        "expected_boundary_state": { "$ref": "#/$defs/boundary_state" },
        "expected_why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "expected_leaves_divergence": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
