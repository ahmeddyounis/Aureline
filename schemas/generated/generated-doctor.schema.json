{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/generated/generated-doctor.schema.json",
  "title": "Aureline generated-artifact Project Doctor findings packet",
  "description": "Boundary schema for the checked-in generated-artifact Project Doctor packet, its scenario fixtures, and its support-export envelope. The packet folds the canonical write-boundary decision packet into one typed findings packet so the Support Center, headless Doctor, docs/help, About, and support exports explain generated-artifact drift-detected, source-missing, generator-unavailable, regeneration-blocked, and direct-edit-denied states with one controlled vocabulary and one frozen resolution ordering. Each finding traces back to its canonical source, generator identity, and last reversible checkpoint, and offers open-details, compare, regenerate, and docs/help actions linked to the same descriptor and regeneration-plan objects the runtime surfaces use. Raw generated bytes, raw diffs, credentials, and ambient authority never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" },
    { "$ref": "#/$defs/support_export" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "finding_class": {
      "type": "string",
      "enum": [
        "source_missing",
        "generator_unavailable",
        "regeneration_blocked",
        "drift_detected",
        "direct_edit_denied"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["blocking", "warning", "notice"]
    },
    "action_kind": {
      "type": "string",
      "enum": ["open_details", "compare", "regenerate", "open_docs"]
    },
    "action_availability": {
      "type": "string",
      "enum": ["available", "unavailable"]
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen",
        "ai_assisted_edit",
        "support_packet"
      ]
    },
    "boundary_state": {
      "type": "string",
      "enum": [
        "in_sync",
        "drift_detected",
        "source_missing",
        "generator_unavailable",
        "regeneration_blocked_by_policy"
      ]
    },
    "attempt_outcome": {
      "type": "string",
      "enum": [
        "direct_edit_admitted",
        "blocked_pending_review",
        "override_admitted_with_divergence",
        "blocked_regenerate_first"
      ]
    },
    "edit_posture": {
      "type": "string",
      "enum": [
        "direct_edit_allowed",
        "reviewed_override_required",
        "regenerate_only"
      ]
    },
    "regeneration_availability": {
      "type": "string",
      "enum": [
        "available",
        "blocked_source_missing",
        "blocked_generator_unavailable",
        "blocked_by_policy"
      ]
    },
    "generator_kind": {
      "type": "string",
      "enum": [
        "template",
        "kernel",
        "builder",
        "runner",
        "framework",
        "composer",
        "exporter"
      ]
    },
    "resolution_order": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_class" },
      "minItems": 5,
      "maxItems": 5
    },
    "generator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "$ref": "#/$defs/generator_kind" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "availability", "unavailable_reason", "target_ref", "label"],
      "properties": {
        "kind": { "$ref": "#/$defs/action_kind" },
        "availability": { "$ref": "#/$defs/action_availability" },
        "unavailable_reason": { "type": ["string", "null"] },
        "target_ref": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "finding_id",
        "finding_class",
        "severity",
        "artifact_class",
        "artifact_path_label",
        "boundary_state",
        "attempt_outcome",
        "effective_edit_gate",
        "canonical_source_ref",
        "generator",
        "checkpoint_lineage_ref",
        "regeneration_route",
        "regeneration_availability",
        "why_blocked_tokens",
        "guidance_line",
        "summary",
        "next_action",
        "actions",
        "source_case_ref",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "generated_doctor_finding_record" },
        "finding_id": { "$ref": "#/$defs/non_empty_string" },
        "finding_class": { "$ref": "#/$defs/finding_class" },
        "severity": { "$ref": "#/$defs/severity" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "artifact_path_label": { "$ref": "#/$defs/non_empty_string" },
        "boundary_state": { "$ref": "#/$defs/boundary_state" },
        "attempt_outcome": { "$ref": "#/$defs/attempt_outcome" },
        "effective_edit_gate": { "$ref": "#/$defs/edit_posture" },
        "canonical_source_ref": { "type": ["string", "null"] },
        "generator": { "$ref": "#/$defs/generator_identity" },
        "checkpoint_lineage_ref": { "$ref": "#/$defs/non_empty_string" },
        "regeneration_route": { "$ref": "#/$defs/non_empty_string" },
        "regeneration_availability": { "$ref": "#/$defs/regeneration_availability" },
        "why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "guidance_line": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "next_action": { "$ref": "#/$defs/non_empty_string" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" },
          "minItems": 4,
          "maxItems": 4
        },
        "source_case_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "class_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_class", "count"],
      "properties": {
        "finding_class": { "$ref": "#/$defs/finding_class" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_ref", "schema_ref", "packet_ref", "report_ref", "fixture_manifest_ref"],
      "properties": {
        "doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "report_ref": { "$ref": "#/$defs/non_empty_string" },
        "fixture_manifest_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "finding_classes",
        "resolution_order",
        "evidence_packet_refs",
        "findings",
        "counts_by_class",
        "invariants"
      ],
      "properties": {
        "record_kind": { "const": "generated_doctor_findings_packet_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "const": "generated.generated_doctor.v1" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "finding_classes": { "$ref": "#/$defs/resolution_order" },
        "resolution_order": { "$ref": "#/$defs/resolution_order" },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" },
          "minItems": 1
        },
        "counts_by_class": {
          "type": "array",
          "items": { "$ref": "#/$defs/class_count" },
          "minItems": 5,
          "maxItems": 5
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "scenario",
        "finding",
        "expected_finding_class",
        "expected_severity",
        "expected_compare_available",
        "expected_regenerate_available",
        "expected_action_kinds"
      ],
      "properties": {
        "record_kind": { "const": "generated_doctor_fixture_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "finding": { "$ref": "#/$defs/finding" },
        "expected_finding_class": { "$ref": "#/$defs/finding_class" },
        "expected_severity": { "$ref": "#/$defs/severity" },
        "expected_compare_available": { "type": "boolean" },
        "expected_regenerate_available": { "type": "boolean" },
        "expected_action_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/action_kind" },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "envelope_id",
        "captured_at",
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "raw_payload_excluded",
        "raw_private_material_excluded",
        "ambient_authority_excluded",
        "canonical_source_lineage_preserved",
        "checkpoint_lineage_preserved",
        "packet"
      ],
      "properties": {
        "record_kind": { "const": "generated_doctor_support_export_record" },
        "envelope_id": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/non_empty_string" },
        "doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "report_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_payload_excluded": { "const": true },
        "raw_private_material_excluded": { "const": true },
        "ambient_authority_excluded": { "const": true },
        "canonical_source_lineage_preserved": { "type": "boolean" },
        "checkpoint_lineage_preserved": { "type": "boolean" },
        "packet": { "$ref": "#/$defs/packet" }
      }
    }
  }
}
