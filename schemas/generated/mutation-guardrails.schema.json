{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/generated/mutation-guardrails.schema.json",
  "title": "Aureline generated-artifact mutation-guardrails packet",
  "description": "Boundary schema for the checked-in mutation-guardrails packet and its scenario fixtures. The packet models what happens when an automated mutation route — an AI apply, a refactor, a quick fix, or an automation pass — reaches a generated artifact. Per case it carries the mutation attempt (route, source class, actor reference, mutation class, whether the target carries canonical-source boundary data, the reused write-boundary subject, and the safety envelope the route brought) and the decision the single engine reaches — the guardrail outcome, whether the mutation is admitted, whether it crosses a canonical boundary, the required and unmet safety requirements, the rollback class, the reused write-boundary decision, the recorded actor lineage, the why-blocked tokens, and a support summary. Raw generated bytes, raw diffs, credentials, and raw paths never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "mutation_route": {
      "type": "string",
      "enum": ["ai_apply", "refactor", "quick_fix", "automation"]
    },
    "mutation_source_class": {
      "type": "string",
      "enum": [
        "ai_hosted_provider",
        "ai_local_model",
        "machine_local",
        "machine_remote_agent",
        "policy_driven"
      ]
    },
    "mutation_class": {
      "type": "string",
      "enum": [
        "buffer_text",
        "filesystem",
        "semantic_tooling",
        "generated_state",
        "external_effect"
      ]
    },
    "reversal_class": {
      "type": "string",
      "enum": [
        "exact_undo",
        "compensating_undo",
        "regenerate_or_recompute",
        "restore_from_checkpoint",
        "audit_only"
      ]
    },
    "boundary_data_state": {
      "type": "string",
      "enum": ["present", "missing"]
    },
    "guardrail_outcome": {
      "type": "string",
      "enum": [
        "admitted_direct",
        "admitted_with_preview_and_override",
        "blocked_pending_review",
        "blocked_regenerate_first",
        "blocked_missing_boundary_data"
      ]
    },
    "safety_requirement": {
      "type": "string",
      "enum": [
        "preview",
        "side_effect_summary",
        "regeneration_awareness",
        "rollback_class"
      ]
    },
    "mutation_guardrail_surface": {
      "type": "string",
      "enum": [
        "ai_apply_gate",
        "refactor_transaction",
        "automation_runner",
        "mutation_journal",
        "support_export"
      ]
    },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "local_compute",
        "network_install",
        "tool_download",
        "secret_access",
        "broad_filesystem_write"
      ]
    },
    "side_effect_disclosure": {
      "type": "string",
      "enum": ["declared_reviewed", "undeclared"]
    },
    "rollback_coverage": {
      "type": "string",
      "enum": ["fully_reversible", "partially_reversible"]
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen",
        "ai_assisted_edit",
        "support_packet"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "canonical_authoritative",
        "derived_editable",
        "derived_readonly"
      ]
    },
    "edit_posture": {
      "type": "string",
      "enum": [
        "direct_edit_allowed",
        "reviewed_override_required",
        "regenerate_only"
      ]
    },
    "boundary_state": {
      "type": "string",
      "enum": [
        "in_sync",
        "drift_detected",
        "source_missing",
        "generator_unavailable",
        "regeneration_blocked_by_policy"
      ]
    },
    "regeneration_availability": {
      "type": "string",
      "enum": [
        "available",
        "blocked_source_missing",
        "blocked_generator_unavailable",
        "blocked_by_policy"
      ]
    },
    "attempt_outcome": {
      "type": "string",
      "enum": [
        "direct_edit_admitted",
        "blocked_pending_review",
        "override_admitted_with_divergence",
        "blocked_regenerate_first"
      ]
    },
    "compare_leg_kind": {
      "type": "string",
      "enum": [
        "canonical_source",
        "current_artifact",
        "regenerated_candidate"
      ]
    },
    "leg_availability": {
      "type": "string",
      "enum": ["available", "unavailable"]
    },
    "recovery_class": {
      "type": "string",
      "enum": [
        "regenerate_from_source",
        "reconcile_into_source",
        "reviewed_override",
        "restore_canonical_source",
        "restore_generator",
        "resolve_regeneration_policy"
      ]
    },
    "generator_kind": {
      "type": "string",
      "enum": [
        "template",
        "kernel",
        "builder",
        "runner",
        "framework",
        "composer",
        "exporter"
      ]
    },
    "generator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "$ref": "#/$defs/generator_kind" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "canonical_source_jump": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "label"],
      "properties": {
        "source_ref": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "compare_leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "availability", "provenance_ref", "unavailable_reason"],
      "properties": {
        "kind": { "$ref": "#/$defs/compare_leg_kind" },
        "availability": { "$ref": "#/$defs/leg_availability" },
        "provenance_ref": { "$ref": "#/$defs/non_empty_string" },
        "unavailable_reason": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "three_way_compare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legs", "provenance_preserved", "summary"],
      "properties": {
        "legs": {
          "type": "array",
          "items": { "$ref": "#/$defs/compare_leg" },
          "minItems": 3,
          "maxItems": 3
        },
        "provenance_preserved": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "recovery_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "action_ref", "summary"],
      "properties": {
        "class": { "$ref": "#/$defs/recovery_class" },
        "action_ref": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "diverged_from_generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "divergence_id",
        "diverged",
        "override_review_ref",
        "recovery",
        "summary"
      ],
      "properties": {
        "divergence_id": { "$ref": "#/$defs/non_empty_string" },
        "diverged": { "type": "boolean", "const": true },
        "override_review_ref": { "$ref": "#/$defs/non_empty_string" },
        "recovery": {
          "type": "array",
          "items": { "$ref": "#/$defs/recovery_step" },
          "minItems": 1
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "write_boundary_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "artifact_path_label",
        "authority_class",
        "generator",
        "declared_edit_posture",
        "boundary_state",
        "canonical_source_ref",
        "regeneration_route",
        "checkpoint_lineage_ref",
        "override_review_ref"
      ],
      "properties": {
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "artifact_path_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "generator": { "$ref": "#/$defs/generator_identity" },
        "declared_edit_posture": { "$ref": "#/$defs/edit_posture" },
        "boundary_state": { "$ref": "#/$defs/boundary_state" },
        "canonical_source_ref": { "$ref": "#/$defs/nullable_string" },
        "regeneration_route": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_lineage_ref": { "$ref": "#/$defs/non_empty_string" },
        "override_review_ref": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "write_boundary_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_state",
        "effective_edit_gate",
        "edit_gate_downgraded",
        "attempt_outcome",
        "direct_edit_admitted",
        "why_blocked_tokens",
        "canonical_source_jump",
        "regeneration_availability",
        "three_way_compare",
        "diverged_from_generator",
        "recovery",
        "guidance_line",
        "copy_line"
      ],
      "properties": {
        "boundary_state": { "$ref": "#/$defs/boundary_state" },
        "effective_edit_gate": { "$ref": "#/$defs/edit_posture" },
        "edit_gate_downgraded": { "type": "boolean" },
        "attempt_outcome": { "$ref": "#/$defs/attempt_outcome" },
        "direct_edit_admitted": { "type": "boolean" },
        "why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "canonical_source_jump": {
          "oneOf": [
            { "$ref": "#/$defs/canonical_source_jump" },
            { "type": "null" }
          ]
        },
        "regeneration_availability": { "$ref": "#/$defs/regeneration_availability" },
        "three_way_compare": { "$ref": "#/$defs/three_way_compare" },
        "diverged_from_generator": {
          "oneOf": [
            { "$ref": "#/$defs/diverged_from_generator" },
            { "type": "null" }
          ]
        },
        "recovery": {
          "type": "array",
          "items": { "$ref": "#/$defs/recovery_step" }
        },
        "guidance_line": { "$ref": "#/$defs/non_empty_string" },
        "copy_line": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "mutation_safety_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_ref",
        "side_effects",
        "side_effect_disclosure",
        "regeneration_acknowledged",
        "reversal_class",
        "override_review_ref"
      ],
      "properties": {
        "preview_ref": { "$ref": "#/$defs/nullable_string" },
        "side_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect_class" }
        },
        "side_effect_disclosure": { "$ref": "#/$defs/side_effect_disclosure" },
        "regeneration_acknowledged": { "type": "boolean" },
        "reversal_class": { "$ref": "#/$defs/reversal_class" },
        "override_review_ref": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "mutation_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "route",
        "source_class",
        "actor_ref",
        "mutation_class",
        "boundary_data_state",
        "artifact",
        "envelope"
      ],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/non_empty_string" },
        "route": { "$ref": "#/$defs/mutation_route" },
        "source_class": { "$ref": "#/$defs/mutation_source_class" },
        "actor_ref": { "$ref": "#/$defs/non_empty_string" },
        "mutation_class": { "$ref": "#/$defs/mutation_class" },
        "boundary_data_state": { "$ref": "#/$defs/boundary_data_state" },
        "artifact": { "$ref": "#/$defs/write_boundary_subject" },
        "envelope": { "$ref": "#/$defs/mutation_safety_envelope" }
      }
    },
    "actor_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "actor_class",
        "source_class",
        "actor_ref",
        "mutation_class",
        "reversal_class",
        "summary"
      ],
      "properties": {
        "route": { "$ref": "#/$defs/mutation_route" },
        "actor_class": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/mutation_source_class" },
        "actor_ref": { "$ref": "#/$defs/non_empty_string" },
        "mutation_class": { "$ref": "#/$defs/mutation_class" },
        "reversal_class": { "$ref": "#/$defs/reversal_class" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "mutation_guardrail_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "mutation_class",
        "boundary_data_state",
        "guardrail_outcome",
        "mutation_admitted",
        "crosses_canonical_boundary",
        "effective_edit_gate",
        "required_safety",
        "unmet_safety_requirements",
        "safety_envelope_complete",
        "rollback_coverage",
        "boundary_decision",
        "actor_lineage",
        "why_blocked_tokens",
        "guidance_line",
        "support_summary",
        "copy_line"
      ],
      "properties": {
        "route": { "$ref": "#/$defs/mutation_route" },
        "mutation_class": { "$ref": "#/$defs/mutation_class" },
        "boundary_data_state": { "$ref": "#/$defs/boundary_data_state" },
        "guardrail_outcome": { "$ref": "#/$defs/guardrail_outcome" },
        "mutation_admitted": { "type": "boolean" },
        "crosses_canonical_boundary": { "type": "boolean" },
        "effective_edit_gate": { "$ref": "#/$defs/edit_posture" },
        "required_safety": {
          "type": "array",
          "items": { "$ref": "#/$defs/safety_requirement" }
        },
        "unmet_safety_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/safety_requirement" }
        },
        "safety_envelope_complete": { "type": "boolean" },
        "rollback_coverage": { "$ref": "#/$defs/rollback_coverage" },
        "boundary_decision": { "$ref": "#/$defs/write_boundary_decision" },
        "actor_lineage": { "$ref": "#/$defs/actor_lineage" },
        "why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "guidance_line": { "$ref": "#/$defs/non_empty_string" },
        "support_summary": { "$ref": "#/$defs/non_empty_string" },
        "copy_line": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "mutation_guardrail_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "scenario",
        "attempt",
        "decision",
        "evidence_refs",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "attempt": { "$ref": "#/$defs/mutation_attempt" },
        "decision": { "$ref": "#/$defs/mutation_guardrail_decision" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "consumer_ref", "ingested_packet_id", "summary"],
      "properties": {
        "surface": { "$ref": "#/$defs/mutation_guardrail_surface" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/generated/mutation-guardrails.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/generated/mutation-guardrails.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/generated/mutation-guardrails-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/generated/mutation-guardrails.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/generated/mutation-guardrails/manifest.yaml"
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "routes",
        "guardrail_outcomes",
        "safety_requirements",
        "evidence_packet_refs",
        "cases",
        "surface_bindings",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "mutation_guardrails_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/mutation_route" },
          "minItems": 4,
          "uniqueItems": true
        },
        "guardrail_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/guardrail_outcome" },
          "minItems": 5,
          "uniqueItems": true
        },
        "safety_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/safety_requirement" },
          "minItems": 4,
          "uniqueItems": true
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/mutation_guardrail_case" },
          "minItems": 5
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 5
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "scenario",
        "case",
        "expected_guardrail_outcome",
        "expected_mutation_admitted",
        "expected_crosses_canonical_boundary",
        "expected_unmet_safety_requirements",
        "expected_why_blocked_tokens",
        "expected_leaves_divergence",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "mutation_guardrails_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "case": { "$ref": "#/$defs/mutation_guardrail_case" },
        "expected_guardrail_outcome": { "$ref": "#/$defs/guardrail_outcome" },
        "expected_mutation_admitted": { "type": "boolean" },
        "expected_crosses_canonical_boundary": { "type": "boolean" },
        "expected_unmet_safety_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/safety_requirement" }
        },
        "expected_why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "expected_leaves_divergence": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
