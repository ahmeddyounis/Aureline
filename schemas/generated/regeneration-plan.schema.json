{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/generated/regeneration-plan.schema.json",
  "title": "Aureline generated-artifact regeneration-plan packet",
  "description": "Boundary schema for the checked-in regeneration-plan packet and its scenario fixtures. The packet turns a regenerate action into a typed, reviewable plan for the claimed M5 scaffolded-project/notebook-output/preview-derivative/request-artifact/framework-codegen/ai-assisted-edit/support-packet classes: per case it carries the regeneration request (target artifacts with their canonical-source refs, generator/runtime requirements, observed precondition states, and the side effects a regeneration would perform, plus a rollback boundary) and the plan the single engine reaches — the headline readiness (ready, ready-stale-inputs, partial, policy-limited, or blocked), the per-target outcomes, the why-blocked tokens, the aggregate side-effect boundary with its declared/undeclared sensitive effects, the computed rollback coverage, and the recovery path. Raw generated bytes, raw diffs, credentials, secret bodies, and raw paths never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "scaffolded_project",
        "notebook_output",
        "preview_derivative",
        "request_artifact",
        "framework_codegen",
        "ai_assisted_edit",
        "support_packet"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "canonical_authoritative",
        "derived_editable",
        "derived_readonly"
      ]
    },
    "generator_kind": {
      "type": "string",
      "enum": [
        "template",
        "kernel",
        "builder",
        "runner",
        "framework",
        "composer",
        "exporter"
      ]
    },
    "plan_readiness": {
      "type": "string",
      "enum": [
        "ready",
        "ready_stale_inputs",
        "partial",
        "policy_limited",
        "blocked"
      ]
    },
    "target_outcome": {
      "type": "string",
      "enum": [
        "ready",
        "ready_stale_inputs",
        "blocked",
        "blocked_by_policy",
        "held_for_disclosure"
      ]
    },
    "precondition_kind": {
      "type": "string",
      "enum": [
        "canonical_source",
        "generator",
        "runtime",
        "input_freshness",
        "policy"
      ]
    },
    "precondition_state": {
      "type": "string",
      "enum": ["satisfied", "stale", "missing", "blocked_by_policy"]
    },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "local_compute",
        "network_install",
        "tool_download",
        "secret_access",
        "broad_filesystem_write"
      ]
    },
    "side_effect_disclosure": {
      "type": "string",
      "enum": ["declared_reviewed", "undeclared"]
    },
    "rollback_coverage": {
      "type": "string",
      "enum": ["fully_reversible", "partially_reversible"]
    },
    "recovery_class": {
      "type": "string",
      "enum": [
        "regenerate_ready_targets",
        "refresh_inputs",
        "restore_canonical_source",
        "restore_generator",
        "provision_runtime",
        "declare_and_review_side_effect",
        "resolve_regeneration_policy"
      ]
    },
    "regeneration_plan_surface": {
      "type": "string",
      "enum": [
        "regenerate_plan_sheet",
        "help_regeneration_guide",
        "support_export",
        "release_evidence",
        "ai_context"
      ]
    },
    "generator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "$ref": "#/$defs/generator_kind" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "side_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "disclosure", "detail"],
      "properties": {
        "class": { "$ref": "#/$defs/side_effect_class" },
        "disclosure": { "$ref": "#/$defs/side_effect_disclosure" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rollback_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_ref", "scope"],
      "properties": {
        "checkpoint_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "regeneration_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "artifact_path_label",
        "authority_class",
        "generator",
        "runtime_requirement",
        "canonical_source_ref",
        "regeneration_route",
        "source_state",
        "generator_state",
        "runtime_state",
        "input_freshness",
        "policy_state",
        "side_effects"
      ],
      "properties": {
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "artifact_path_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "generator": { "$ref": "#/$defs/generator_identity" },
        "runtime_requirement": { "$ref": "#/$defs/non_empty_string" },
        "canonical_source_ref": { "$ref": "#/$defs/nullable_string" },
        "regeneration_route": { "$ref": "#/$defs/non_empty_string" },
        "source_state": { "$ref": "#/$defs/precondition_state" },
        "generator_state": { "$ref": "#/$defs/precondition_state" },
        "runtime_state": { "$ref": "#/$defs/precondition_state" },
        "input_freshness": { "$ref": "#/$defs/precondition_state" },
        "policy_state": { "$ref": "#/$defs/precondition_state" },
        "side_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect" }
        }
      }
    },
    "regeneration_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "trigger_label", "targets", "rollback_boundary"],
      "properties": {
        "plan_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_label": { "$ref": "#/$defs/non_empty_string" },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/regeneration_target" },
          "minItems": 1
        },
        "rollback_boundary": { "$ref": "#/$defs/rollback_boundary" }
      }
    },
    "precondition_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "detail"],
      "properties": {
        "kind": { "$ref": "#/$defs/precondition_kind" },
        "state": { "$ref": "#/$defs/precondition_state" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "target_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "artifact_path_label",
        "authority_class",
        "generator",
        "runtime_requirement",
        "canonical_source_ref",
        "regeneration_route",
        "preconditions",
        "side_effects",
        "outcome",
        "why_blocked_tokens",
        "summary"
      ],
      "properties": {
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "artifact_path_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "generator": { "$ref": "#/$defs/generator_identity" },
        "runtime_requirement": { "$ref": "#/$defs/non_empty_string" },
        "canonical_source_ref": { "$ref": "#/$defs/nullable_string" },
        "regeneration_route": { "$ref": "#/$defs/non_empty_string" },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition_status" },
          "minItems": 5,
          "maxItems": 5
        },
        "side_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect" }
        },
        "outcome": { "$ref": "#/$defs/target_outcome" },
        "why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "side_effect_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classes_present",
        "effects",
        "all_sensitive_declared",
        "undeclared_sensitive_classes",
        "summary"
      ],
      "properties": {
        "classes_present": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect_class" },
          "uniqueItems": true
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect" }
        },
        "all_sensitive_declared": { "type": "boolean" },
        "undeclared_sensitive_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect_class" },
          "uniqueItems": true
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "recovery_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "action_ref", "summary"],
      "properties": {
        "class": { "$ref": "#/$defs/recovery_class" },
        "action_ref": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "regeneration_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "readiness",
        "runs_in_full",
        "partial",
        "stale_inputs",
        "runnable_target_count",
        "blocked_target_count",
        "targets",
        "side_effect_boundary",
        "rollback_coverage",
        "rollback_boundary",
        "why_blocked_tokens",
        "recovery",
        "guidance_line",
        "copy_line"
      ],
      "properties": {
        "plan_id": { "$ref": "#/$defs/non_empty_string" },
        "readiness": { "$ref": "#/$defs/plan_readiness" },
        "runs_in_full": { "type": "boolean" },
        "partial": { "type": "boolean" },
        "stale_inputs": { "type": "boolean" },
        "runnable_target_count": { "type": "integer", "minimum": 0 },
        "blocked_target_count": { "type": "integer", "minimum": 0 },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target_plan" },
          "minItems": 1
        },
        "side_effect_boundary": { "$ref": "#/$defs/side_effect_boundary" },
        "rollback_coverage": { "$ref": "#/$defs/rollback_coverage" },
        "rollback_boundary": { "$ref": "#/$defs/rollback_boundary" },
        "why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "recovery": {
          "type": "array",
          "items": { "$ref": "#/$defs/recovery_step" }
        },
        "guidance_line": { "$ref": "#/$defs/non_empty_string" },
        "copy_line": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "regeneration_plan_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "scenario",
        "request",
        "plan",
        "evidence_refs",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "request": { "$ref": "#/$defs/regeneration_request" },
        "plan": { "$ref": "#/$defs/regeneration_plan" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "consumer_ref", "ingested_packet_id", "summary"],
      "properties": {
        "surface": { "$ref": "#/$defs/regeneration_plan_surface" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/generated/regeneration-plan.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/generated/regeneration-plan.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/generated/regeneration-plan-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/generated/regeneration-plan.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/generated/regeneration-plan/manifest.yaml"
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "readiness_states",
        "side_effect_classes",
        "evidence_packet_refs",
        "cases",
        "surface_bindings",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "regeneration_plan_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "readiness_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/plan_readiness" },
          "minItems": 5,
          "uniqueItems": true
        },
        "side_effect_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect_class" },
          "minItems": 5,
          "uniqueItems": true
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/regeneration_plan_case" },
          "minItems": 7
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 5
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "scenario",
        "case",
        "expected_readiness",
        "expected_runnable_target_count",
        "expected_blocked_target_count",
        "expected_why_blocked_tokens",
        "expected_rollback_coverage",
        "expected_all_sensitive_declared",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "regeneration_plan_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/non_empty_string" },
        "case": { "$ref": "#/$defs/regeneration_plan_case" },
        "expected_readiness": { "$ref": "#/$defs/plan_readiness" },
        "expected_runnable_target_count": { "type": "integer", "minimum": 0 },
        "expected_blocked_target_count": { "type": "integer", "minimum": 0 },
        "expected_why_blocked_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "expected_rollback_coverage": { "$ref": "#/$defs/rollback_coverage" },
        "expected_all_sensitive_declared": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
