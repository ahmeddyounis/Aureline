{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/editor/m5-assist-descriptors.schema.json",
  "title": "Aureline assist-descriptor model",
  "description": "Boundary schema for the one canonical, frozen, export-safe decoration / code-lens / inlay-hint descriptor model. The model materializes a single typed descriptor shape (class, family, owning precedence layer, source/provider, freshness/confidence, target anchor/span, placement, actionability, accessibility, and density/zoom/layout-shift policy) for all three micro-surface families, plus a deterministic resolver that turns a descriptor and a render context into a visibility verdict with an explicit suppression reason and keyboard / screen-reader / non-color accessibility truth. It consumes the frozen editor-assist matrix for per-surface degraded-state policy and proves, over its own descriptor catalog, resolution scenarios, and interaction-precedence conflict cases, that editing truth always outranks advisory metadata, that every disappearance is explainable, and that every actionable or severity-bearing decoration is keyboard-reachable and not color-only. Editor, CLI/headless, support-export, and AI-evidence consumers render this verdict rather than inventing per-pane micro-behavior. No file contents, credential bodies, or raw provider payloads cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_assist_descriptors_schema_version",
    "schema_ref",
    "model_id",
    "as_of",
    "descriptor_families",
    "placement_classes",
    "actionability_classes",
    "confidence_classes",
    "freshness_classes",
    "motion_classes",
    "density_tiers",
    "zoom_tiers",
    "visibility_verdicts",
    "suppression_reasons",
    "descriptor_catalog",
    "scenarios",
    "precedence_conflicts",
    "invariants",
    "raw_payload_excluded",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_assist_descriptor_model" },
    "m5_assist_descriptors_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/editor/m5-assist-descriptors.schema.json" },
    "model_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "descriptor_families": { "$ref": "#/$defs/class_descriptor_array" },
    "placement_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "actionability_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "confidence_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "freshness_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "motion_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "density_tiers": { "$ref": "#/$defs/class_descriptor_array" },
    "zoom_tiers": { "$ref": "#/$defs/class_descriptor_array" },
    "visibility_verdicts": { "$ref": "#/$defs/class_descriptor_array" },
    "suppression_reasons": { "$ref": "#/$defs/class_descriptor_array" },
    "descriptor_catalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assist_descriptor" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resolution_scenario" }
    },
    "precedence_conflicts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/precedence_conflict_case" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model_invariant" }
    },
    "raw_payload_excluded": { "const": true },
    "summary": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "family": { "enum": ["decoration", "code_lens", "inlay_hint"] },
    "truth_tier": { "enum": ["editing_truth", "convenience_metadata"] },
    "placement": {
      "enum": [
        "gutter_glyph",
        "inline_underline",
        "inline_range",
        "line_highlight",
        "above_line",
        "inline_before",
        "inline_after"
      ]
    },
    "actionability": {
      "enum": [
        "informational",
        "severity_bearing",
        "activatable",
        "severity_bearing_activatable"
      ]
    },
    "confidence": { "enum": ["high", "probable", "low_speculative"] },
    "freshness": { "enum": ["live", "cached", "stale"] },
    "motion": { "enum": ["static", "animated_reducible"] },
    "density": { "enum": ["comfortable", "compact", "dense"] },
    "zoom": { "enum": ["standard", "high"] },
    "visibility": {
      "enum": ["rendered", "downgraded", "deferred", "suppressed"]
    },
    "suppression_reason": {
      "enum": [
        "not_suppressed",
        "source_fallback",
        "partial_index_pending",
        "reduced_decoration",
        "density_compaction",
        "high_zoom_horizontal_budget",
        "typing_budget",
        "low_confidence",
        "large_file_restricted",
        "unavailable_on_surface",
        "outranked_by_editing_truth"
      ]
    },
    "editor_layer": {
      "enum": [
        "current_debug_frame",
        "error_diagnostic",
        "merge_conflict_region",
        "review_change_marker",
        "warning_diagnostic",
        "breakpoint_marker",
        "info_hint_diagnostic",
        "search_match",
        "selection_occurrence",
        "code_lens",
        "inlay_hint",
        "inline_completion_ghost",
        "hover_card",
        "parameter_hint"
      ]
    },
    "assist_channel": {
      "enum": [
        "completion",
        "signature_help",
        "snippet_session",
        "code_lens",
        "inlay_hint",
        "hover",
        "peek",
        "inline_ai_assist",
        "decoration"
      ]
    },
    "degrade_state": {
      "enum": [
        "full_fidelity",
        "source_labeled_fallback",
        "read_only_no_apply",
        "suppressed_large_file",
        "pending_partial_index",
        "blocked_unavailable"
      ]
    },
    "editor_surface": {
      "enum": [
        "code_file",
        "config_file",
        "notebook_cell",
        "request_editor",
        "sql_editor",
        "docs_code_block",
        "generated_file",
        "protected_file",
        "partial_index_state",
        "large_file_restricted"
      ]
    },
    "source_label_class": {
      "enum": [
        "deterministic_language",
        "cached_fallback",
        "snippet_origin",
        "ai_inline_assist",
        "project_graph",
        "framework_provider",
        "tool_adapter"
      ]
    },
    "class_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_token", "label", "note"],
      "properties": {
        "class_token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "class_descriptor_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/class_descriptor" }
    },
    "text_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "start_column", "end_line", "end_column"],
      "properties": {
        "start_line": { "type": "integer", "minimum": 0 },
        "start_column": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 0 },
        "end_column": { "type": "integer", "minimum": 0 }
      }
    },
    "descriptor_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_label_class",
        "source_label",
        "provider_id",
        "freshness",
        "confidence",
        "requires_ai_label",
        "requires_visual_distinction"
      ],
      "properties": {
        "source_label_class": { "$ref": "#/$defs/source_label_class" },
        "source_label": { "$ref": "#/$defs/non_empty_string" },
        "provider_id": { "type": ["string", "null"] },
        "freshness": { "$ref": "#/$defs/freshness" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "requires_ai_label": { "type": "boolean" },
        "requires_visual_distinction": { "type": "boolean" }
      }
    },
    "accessibility_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen_reader_label",
        "non_color_differentiator",
        "keyboard_path",
        "motion_class"
      ],
      "properties": {
        "screen_reader_label": { "$ref": "#/$defs/non_empty_string" },
        "non_color_differentiator": { "$ref": "#/$defs/non_empty_string" },
        "keyboard_path": { "type": ["string", "null"] },
        "motion_class": { "$ref": "#/$defs/motion" }
      }
    },
    "assist_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_id",
        "family",
        "class_token",
        "class_label",
        "owning_layer",
        "truth_tier",
        "channel",
        "anchor",
        "placement",
        "actionability",
        "source",
        "accessibility",
        "layout_shifting",
        "density_optional",
        "zoom_optional",
        "command_ref",
        "note"
      ],
      "properties": {
        "descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "class_token": { "$ref": "#/$defs/non_empty_string" },
        "class_label": { "$ref": "#/$defs/non_empty_string" },
        "owning_layer": { "$ref": "#/$defs/editor_layer" },
        "truth_tier": { "$ref": "#/$defs/truth_tier" },
        "channel": { "$ref": "#/$defs/assist_channel" },
        "anchor": { "$ref": "#/$defs/text_anchor" },
        "placement": { "$ref": "#/$defs/placement" },
        "actionability": { "$ref": "#/$defs/actionability" },
        "source": { "$ref": "#/$defs/descriptor_source" },
        "accessibility": { "$ref": "#/$defs/accessibility_profile" },
        "layout_shifting": { "type": "boolean" },
        "density_optional": { "type": "boolean" },
        "zoom_optional": { "type": "boolean" },
        "command_ref": { "type": ["string", "null"] },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "render_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "label",
        "surface",
        "density",
        "zoom",
        "reduced_motion",
        "typing_active"
      ],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "surface": { "$ref": "#/$defs/editor_surface" },
        "density": { "$ref": "#/$defs/density" },
        "zoom": { "$ref": "#/$defs/zoom" },
        "reduced_motion": { "type": "boolean" },
        "typing_active": { "type": "boolean" }
      }
    },
    "resolved_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_id",
        "family",
        "class_token",
        "owning_layer",
        "truth_tier",
        "rank",
        "visibility",
        "effective_degrade",
        "suppression_reason",
        "reason_detail",
        "animations_enabled",
        "keyboard_reachable",
        "source_label_class"
      ],
      "properties": {
        "descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "class_token": { "$ref": "#/$defs/non_empty_string" },
        "owning_layer": { "$ref": "#/$defs/editor_layer" },
        "truth_tier": { "$ref": "#/$defs/truth_tier" },
        "rank": { "type": "integer", "minimum": 0 },
        "visibility": { "$ref": "#/$defs/visibility" },
        "effective_degrade": { "$ref": "#/$defs/degrade_state" },
        "suppression_reason": { "$ref": "#/$defs/suppression_reason" },
        "reason_detail": { "$ref": "#/$defs/non_empty_string" },
        "animations_enabled": { "type": "boolean" },
        "keyboard_reachable": { "type": "boolean" },
        "source_label_class": { "$ref": "#/$defs/source_label_class" }
      }
    },
    "resolution_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "resolved",
        "rendered_count",
        "downgraded_count",
        "deferred_count",
        "suppressed_count",
        "note"
      ],
      "properties": {
        "context": { "$ref": "#/$defs/render_context" },
        "resolved": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_descriptor" }
        },
        "rendered_count": { "type": "integer", "minimum": 0 },
        "downgraded_count": { "type": "integer", "minimum": 0 },
        "deferred_count": { "type": "integer", "minimum": 0 },
        "suppressed_count": { "type": "integer", "minimum": 0 },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "precedence_conflict_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "label",
        "editing_truth_descriptor_id",
        "editing_truth_layer",
        "convenience_descriptor_id",
        "convenience_layer",
        "shared_anchor",
        "winner_descriptor_id",
        "yielded_descriptor_id",
        "yielded_visibility",
        "yielded_reason",
        "note"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "editing_truth_descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "editing_truth_layer": { "$ref": "#/$defs/editor_layer" },
        "convenience_descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "convenience_layer": { "$ref": "#/$defs/editor_layer" },
        "shared_anchor": { "$ref": "#/$defs/text_anchor" },
        "winner_descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "yielded_descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "yielded_visibility": { "$ref": "#/$defs/visibility" },
        "yielded_reason": { "$ref": "#/$defs/suppression_reason" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "model_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    }
  }
}
