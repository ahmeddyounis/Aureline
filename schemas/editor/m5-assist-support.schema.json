{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/editor/m5-assist-support.schema.json",
  "title": "Aureline editor-assist support / provider-debug packet",
  "description": "Boundary schema for the one canonical, frozen, export-safe assist-support packet that makes completion, hint, hover, and peek decisions supportable and replayable. Each decision record pins the originating micro-surface identity, the provider / source path, the degraded / blocked reason, the partial-index and stale-doc state, the anchor mapping quality, any additional-edit / import side-effect cue, and a single derived drift class with stable ids and a correlation field id. The packet also projects per-drift-class and per-surface rollups for Project Doctor and a redaction contract. It is metadata-only: every field is a typed token, an opaque ref, a count, or a bounded sentence. No source text, prompt context, raw provider payloads, or credential bodies cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_assist_support_schema_version",
    "schema_ref",
    "packet_id",
    "as_of",
    "drift_catalog",
    "decisions",
    "drift_rollups",
    "surface_rollups",
    "support_export",
    "invariants",
    "raw_payload_excluded",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_assist_support_packet" },
    "m5_assist_support_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/editor/m5-assist-support.schema.json" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "drift_catalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/drift_descriptor" }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision_record" }
    },
    "drift_rollups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/drift_rollup" }
    },
    "surface_rollups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_rollup" }
    },
    "support_export": { "$ref": "#/$defs/support_export_contract" },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "raw_payload_excluded": { "type": "boolean", "const": true },
    "summary": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1, "maxLength": 600 },
    "decision_kind": {
      "type": "string",
      "enum": ["completion", "hint", "hover", "peek"]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "code_file",
        "config_file",
        "notebook_cell",
        "request_editor",
        "sql_editor",
        "docs_code_block",
        "generated_file",
        "protected_file",
        "partial_index_state",
        "large_file_restricted"
      ]
    },
    "source_label_class": {
      "type": "string",
      "enum": [
        "deterministic_language",
        "cached_fallback",
        "snippet_origin",
        "ai_inline_assist",
        "project_graph",
        "framework_provider",
        "tool_adapter"
      ]
    },
    "provider_posture": {
      "type": "string",
      "enum": [
        "full_semantic",
        "degraded_provider",
        "stale_partial_index",
        "restricted_mode",
        "large_file_fallback",
        "offline_cached_only"
      ]
    },
    "degrade_class": {
      "type": "string",
      "enum": [
        "full_fidelity",
        "source_labeled_fallback",
        "read_only_no_apply",
        "suppressed_large_file",
        "pending_partial_index",
        "blocked_unavailable"
      ]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "write_routes_through_generator",
        "projection_edits_route_to_source",
        "write_requires_approval",
        "write_boundary_read_only",
        "snapshot_immutable",
        "index_still_building",
        "suppressed_for_safety",
        "provider_degraded_fallback"
      ]
    },
    "mapping_quality": {
      "type": "string",
      "enum": ["exact", "approximate", "heuristic", "unresolved"]
    },
    "content_state": {
      "type": "string",
      "enum": [
        "live",
        "stale_refresh_pending",
        "partial_index_pending",
        "imported_snapshot",
        "fallback_provider",
        "policy_limited",
        "suppressed"
      ]
    },
    "index_freshness": {
      "type": "string",
      "enum": ["fresh", "partial_building", "reindex_pending", "not_indexed"]
    },
    "side_effect_cue": {
      "type": "string",
      "enum": [
        "none",
        "additional_edits_in_file",
        "adds_import",
        "adds_dependency",
        "edits_config",
        "generated_output_effect"
      ]
    },
    "next_safe_action": {
      "type": "string",
      "enum": [
        "open_generator_source",
        "regenerate_from_source",
        "duplicate_editable_copy",
        "request_approval_review",
        "edit_underlying_source",
        "wait_for_index",
        "open_in_full_editor",
        "reconnect_provider",
        "view_only_no_action"
      ]
    },
    "drift_class": {
      "type": "string",
      "enum": [
        "no_drift_authoritative",
        "provider_drift",
        "cached_local_word_fallback",
        "wrong_anchor_mapping",
        "constrained_file_narrowing",
        "partial_index_pending",
        "stale_doc_snapshot"
      ]
    },
    "drift_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_token", "label", "summary"],
      "properties": {
        "class_token": { "$ref": "#/$defs/drift_class" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "field_id",
        "kind",
        "surface_class",
        "subject_ref",
        "provider_id",
        "source_label_class",
        "provider_posture",
        "degrade_state",
        "mapping_quality",
        "content_state",
        "index_freshness",
        "side_effect_cue",
        "drift_class",
        "explanation",
        "redaction_safe"
      ],
      "properties": {
        "decision_id": { "$ref": "#/$defs/non_empty_string" },
        "field_id": { "$ref": "#/$defs/non_empty_string" },
        "kind": { "$ref": "#/$defs/decision_kind" },
        "surface_class": { "$ref": "#/$defs/surface_class" },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "provider_id": { "$ref": "#/$defs/non_empty_string" },
        "source_label_class": { "$ref": "#/$defs/source_label_class" },
        "provider_posture": { "$ref": "#/$defs/provider_posture" },
        "degrade_state": { "$ref": "#/$defs/degrade_class" },
        "narrow_reason": { "$ref": "#/$defs/narrow_reason" },
        "mapping_quality": { "$ref": "#/$defs/mapping_quality" },
        "content_state": { "$ref": "#/$defs/content_state" },
        "index_freshness": { "$ref": "#/$defs/index_freshness" },
        "side_effect_cue": { "$ref": "#/$defs/side_effect_cue" },
        "drift_class": { "$ref": "#/$defs/drift_class" },
        "next_safe_action": { "$ref": "#/$defs/next_safe_action" },
        "next_action_command": { "$ref": "#/$defs/non_empty_string" },
        "explanation": { "$ref": "#/$defs/non_empty_string" },
        "redaction_safe": { "type": "boolean", "const": true }
      }
    },
    "drift_rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_class",
        "field_id",
        "count",
        "affected_kinds",
        "affected_surfaces",
        "explanation"
      ],
      "properties": {
        "drift_class": { "$ref": "#/$defs/drift_class" },
        "field_id": { "$ref": "#/$defs/non_empty_string" },
        "count": { "type": "integer", "minimum": 1 },
        "affected_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision_kind" }
        },
        "affected_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_class" }
        },
        "explanation": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_class",
        "field_id",
        "count",
        "clean_count",
        "drifted_count"
      ],
      "properties": {
        "surface_class": { "$ref": "#/$defs/surface_class" },
        "field_id": { "$ref": "#/$defs/non_empty_string" },
        "count": { "type": "integer", "minimum": 1 },
        "clean_count": { "type": "integer", "minimum": 0 },
        "drifted_count": { "type": "integer", "minimum": 0 }
      }
    },
    "support_export_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "exported_fields",
        "redacted_classes",
        "raw_payload_excluded",
        "note"
      ],
      "properties": {
        "record_kind": { "$ref": "#/$defs/non_empty_string" },
        "exported_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "redacted_classes": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "raw_payload_excluded": { "type": "boolean", "const": true },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    }
  }
}
