{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/editor/m5-advanced-editing.schema.json",
  "title": "Aureline advanced-editing micro-surface model",
  "description": "Boundary schema for the one canonical, frozen, export-safe model that binds selection-summary strips, multi-cursor / column-edit semantics, fold-state risk markers, and minimap / overview-ruler parity into a single orientation contract across the claimed advanced editor surfaces (code, config, notebook, request, SQL, docs code-block, generated, protected, partial-index, and large-file / restricted). Each surface snapshot resolves exactly one selection-summary strip plus its fold-risk summaries and overview aids, all built from one shared vocabulary so notebook and request editors reuse rather than fork selection / fold / minimap semantics. Every selection strip names its mode, caret count, primary caret, quick detail, and whether the next operation is exact for all selections, normalized / expanded, primary-caret-only, or blocked, and explains operations that cannot apply to every caret. Every folded region advertises hidden diagnostics, conflicts, and trust warnings with a non-colour marker and a reveal route instead of falsely appearing clean. Every minimap / overview-ruler aid is an optional accelerator that pins the shared main-editor marker-semantics source, is never the sole carrier of critical state, and degrades honestly. A render-awareness policy set proves that density, high-zoom, and reduced-motion profiles compact only optional chrome and never drop severity / actionability state. The model proves these honesty invariants over its own data. No file contents, credential bodies, or raw provider payloads cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_advanced_editing_schema_version",
    "schema_ref",
    "model_id",
    "as_of",
    "selection_mode_classes",
    "selection_semantics_classes",
    "fold_risk_classes",
    "overview_aid_classes",
    "aid_availability_classes",
    "render_awareness",
    "surface_snapshots",
    "invariants",
    "raw_payload_excluded",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_advanced_editing_model" },
    "m5_advanced_editing_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/editor/m5-advanced-editing.schema.json" },
    "model_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "selection_mode_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "selection_semantics_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "fold_risk_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "overview_aid_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "aid_availability_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "render_awareness": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/render_awareness_policy" }
    },
    "surface_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_snapshot" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "raw_payload_excluded": { "const": true },
    "summary": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "selection_mode": {
      "enum": ["single_caret", "multi_cursor", "column_block"]
    },
    "selection_semantics": {
      "enum": [
        "exact_all_selections",
        "normalized_expanded",
        "primary_caret_only",
        "blocked"
      ]
    },
    "fold_risk": {
      "enum": ["clean", "hidden_informational", "hidden_critical"]
    },
    "overview_aid_kind": {
      "enum": ["minimap", "overview_ruler"]
    },
    "aid_availability": {
      "enum": [
        "available",
        "reduced",
        "disabled_large_file",
        "disabled_low_resource",
        "disabled_by_setting"
      ]
    },
    "editor_surface": {
      "enum": [
        "code_file",
        "config_file",
        "notebook_cell",
        "request_editor",
        "sql_editor",
        "docs_code_block",
        "generated_file",
        "protected_file",
        "partial_index_state",
        "large_file_restricted"
      ]
    },
    "degrade_class": {
      "enum": [
        "full_fidelity",
        "source_labeled_fallback",
        "read_only_no_apply",
        "suppressed_large_file",
        "pending_partial_index",
        "blocked_unavailable"
      ]
    },
    "density_tier": {
      "enum": ["comfortable", "compact", "dense"]
    },
    "zoom_tier": {
      "enum": ["standard", "high"]
    },
    "motion_class": {
      "enum": ["static", "animated_reducible"]
    },
    "class_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_token", "label", "note"],
      "properties": {
        "class_token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "class_descriptor_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/class_descriptor" }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    },
    "hidden_state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostics", "conflicts", "trust_warnings", "search_hits"],
      "properties": {
        "diagnostics": { "type": "integer", "minimum": 0 },
        "conflicts": { "type": "integer", "minimum": 0 },
        "trust_warnings": { "type": "integer", "minimum": 0 },
        "search_hits": { "type": "integer", "minimum": 0 }
      }
    },
    "unsupported_operation_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_label", "reason", "fallback_route_ref"],
      "properties": {
        "operation_label": { "$ref": "#/$defs/non_empty_string" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "fallback_route_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "render_awareness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "tier_token",
        "tier_label",
        "compaction_note",
        "critical_state_preserved",
        "non_color_only_preserved"
      ],
      "properties": {
        "dimension": { "enum": ["density", "zoom", "motion"] },
        "tier_token": { "$ref": "#/$defs/non_empty_string" },
        "tier_label": { "$ref": "#/$defs/non_empty_string" },
        "compaction_note": { "$ref": "#/$defs/non_empty_string" },
        "critical_state_preserved": { "const": true },
        "non_color_only_preserved": { "const": true }
      }
    },
    "selection_summary_strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "strip_id",
        "mode_class",
        "caret_count",
        "primary_caret_label",
        "quick_detail",
        "semantics_class",
        "semantics_disclosed",
        "column_edit_preview",
        "undo_grouping_class",
        "unsupported_operations",
        "keyboard_reachable",
        "inspect_command_id_ref",
        "non_color_differentiator",
        "accessibility_label"
      ],
      "properties": {
        "record_kind": { "const": "m5_selection_summary_strip" },
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "mode_class": { "$ref": "#/$defs/selection_mode" },
        "caret_count": { "type": "integer", "minimum": 0 },
        "primary_caret_label": { "$ref": "#/$defs/non_empty_string" },
        "quick_detail": { "$ref": "#/$defs/non_empty_string" },
        "semantics_class": { "$ref": "#/$defs/selection_semantics" },
        "semantics_disclosed": { "type": "boolean" },
        "column_edit_preview": { "type": ["string", "null"] },
        "undo_grouping_class": { "$ref": "#/$defs/non_empty_string" },
        "unsupported_operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/unsupported_operation_note" }
        },
        "keyboard_reachable": { "const": true },
        "inspect_command_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "non_color_differentiator": { "$ref": "#/$defs/non_empty_string" },
        "accessibility_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "fold_risk_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "fold_id",
        "label",
        "hidden_line_count",
        "hidden_state_counts",
        "risk_class",
        "advertises_hidden_state",
        "keyboard_toggle_command_id_ref",
        "reveal_detail_route_ref",
        "non_color_marker",
        "accessibility_label"
      ],
      "properties": {
        "record_kind": { "const": "m5_fold_risk_summary" },
        "fold_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "hidden_line_count": { "type": "integer", "minimum": 0 },
        "hidden_state_counts": { "$ref": "#/$defs/hidden_state_counts" },
        "risk_class": { "$ref": "#/$defs/fold_risk" },
        "advertises_hidden_state": { "type": "boolean" },
        "keyboard_toggle_command_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "reveal_detail_route_ref": { "type": ["string", "null"] },
        "non_color_marker": { "$ref": "#/$defs/non_empty_string" },
        "accessibility_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "overview_aid_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "aid_id",
        "aid_kind",
        "availability",
        "degraded_state_message",
        "marker_semantics_ref",
        "aligned_with_main_editor",
        "is_sole_carrier_of_critical_state",
        "is_optional_accelerator",
        "replacement_route_refs",
        "non_color_differentiator",
        "accessibility_label"
      ],
      "properties": {
        "record_kind": { "const": "m5_overview_aid_parity" },
        "aid_id": { "$ref": "#/$defs/non_empty_string" },
        "aid_kind": { "$ref": "#/$defs/overview_aid_kind" },
        "availability": { "$ref": "#/$defs/aid_availability" },
        "degraded_state_message": { "type": ["string", "null"] },
        "marker_semantics_ref": {
          "const": "marker-semantics:main-editor:diagnostics-conflict-trust"
        },
        "aligned_with_main_editor": { "const": true },
        "is_sole_carrier_of_critical_state": { "const": false },
        "is_optional_accelerator": { "const": true },
        "replacement_route_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "non_color_differentiator": { "$ref": "#/$defs/non_empty_string" },
        "accessibility_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "m5_advanced_editing_schema_version",
        "snapshot_id",
        "surface_class",
        "workspace_id",
        "document_ref",
        "language_id",
        "degrade_class",
        "degrade_label",
        "selection_strip",
        "fold_summaries",
        "overview_aids",
        "density_tier",
        "zoom_tier",
        "motion_class",
        "critical_state_preserved_in_profile",
        "disclosure_required",
        "accessibility_summary",
        "export_safe_summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_advanced_editing_snapshot" },
        "m5_advanced_editing_schema_version": { "type": "integer", "const": 1 },
        "snapshot_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_class": { "$ref": "#/$defs/editor_surface" },
        "workspace_id": { "$ref": "#/$defs/non_empty_string" },
        "document_ref": { "$ref": "#/$defs/non_empty_string" },
        "language_id": { "$ref": "#/$defs/non_empty_string" },
        "degrade_class": { "$ref": "#/$defs/degrade_class" },
        "degrade_label": { "$ref": "#/$defs/non_empty_string" },
        "selection_strip": { "$ref": "#/$defs/selection_summary_strip" },
        "fold_summaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/fold_risk_summary" }
        },
        "overview_aids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/overview_aid_parity" }
        },
        "density_tier": { "$ref": "#/$defs/density_tier" },
        "zoom_tier": { "$ref": "#/$defs/zoom_tier" },
        "motion_class": { "$ref": "#/$defs/motion_class" },
        "critical_state_preserved_in_profile": { "const": true },
        "disclosure_required": { "type": "boolean" },
        "accessibility_summary": { "$ref": "#/$defs/non_empty_string" },
        "export_safe_summary": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
