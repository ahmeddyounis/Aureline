{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/editor/m5-constrained-assist.schema.json",
  "title": "Aureline constrained-file and degraded-provider assist-narrowing model",
  "description": "Boundary schema for the one canonical, frozen, export-safe model that states how every editor assist micro-surface narrows, downgrades, blocks, or routes elsewhere when file state or provider certainty means Aureline cannot safely offer the same completion / hint / hover / refactor behavior it offers on an ordinary source file. Each of the claimed constrained-file state classes (read-only boundary, generated artifact, managed region, projection view, captured evidence, partial index, restricted mode, large file) resolves into a profile with exactly one narrowing cell per assist channel; each cell carries a degraded-state verdict, an inspectable reason, and a next-safe-action route, stays keyboard-reachable when offered, and never silently hides a side-effectful assist. A set of degraded-provider cases proves the same source-labeled, routed narrowing on otherwise-ordinary files, and a set of consumer-surface proofs binds the notebook, generated, request-artifact, docs-code, and protected surfaces back to the shared state vocabulary. Every profile embeds the canonical assist source/provenance descriptor. The model proves these honesty invariants over its own data. No file contents, credential bodies, or raw provider payloads cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_constrained_assist_schema_version",
    "schema_ref",
    "model_id",
    "as_of",
    "state_classes",
    "channel_classes",
    "degrade_classes",
    "reason_classes",
    "next_safe_action_classes",
    "state_profiles",
    "degraded_provider_cases",
    "consumer_proofs",
    "invariants",
    "raw_payload_excluded",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_constrained_assist_model" },
    "m5_constrained_assist_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/editor/m5-constrained-assist.schema.json" },
    "model_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "state_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "channel_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "degrade_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "reason_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "next_safe_action_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "state_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/constrained_state_profile" }
    },
    "degraded_provider_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/degraded_provider_case" }
    },
    "consumer_proofs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface_proof" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "raw_payload_excluded": { "const": true },
    "summary": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "state_class": {
      "enum": [
        "read_only_boundary",
        "generated_artifact",
        "managed_region",
        "projection_view",
        "captured_evidence",
        "partial_index",
        "restricted_mode",
        "large_file"
      ]
    },
    "assist_channel": {
      "enum": [
        "completion",
        "signature_help",
        "snippet_session",
        "code_lens",
        "inlay_hint",
        "hover",
        "peek",
        "inline_ai_assist",
        "decoration"
      ]
    },
    "degrade_class": {
      "enum": [
        "full_fidelity",
        "source_labeled_fallback",
        "read_only_no_apply",
        "suppressed_large_file",
        "pending_partial_index",
        "blocked_unavailable"
      ]
    },
    "narrow_reason": {
      "enum": [
        "write_routes_through_generator",
        "projection_edits_route_to_source",
        "write_requires_approval",
        "write_boundary_read_only",
        "snapshot_immutable",
        "index_still_building",
        "suppressed_for_safety",
        "provider_degraded_fallback"
      ]
    },
    "next_safe_action": {
      "enum": [
        "open_generator_source",
        "regenerate_from_source",
        "duplicate_editable_copy",
        "request_approval_review",
        "edit_underlying_source",
        "wait_for_index",
        "open_in_full_editor",
        "reconnect_provider",
        "view_only_no_action"
      ]
    },
    "editor_surface": {
      "enum": [
        "code_file",
        "config_file",
        "notebook_cell",
        "request_editor",
        "sql_editor",
        "docs_code_block",
        "generated_file",
        "protected_file",
        "partial_index_state",
        "large_file_restricted"
      ]
    },
    "class_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_token", "label", "note"],
      "properties": {
        "class_token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "class_descriptor_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/class_descriptor" }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    },
    "assist_source_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_descriptor_id",
        "source_family",
        "source_label_class",
        "source_label",
        "provider_id",
        "router_decision_ref",
        "source_ref",
        "support_class",
        "freshness_class",
        "scope_claim_class",
        "completeness_class",
        "scope_limit_classes",
        "locality_class",
        "degraded_state_class",
        "summary"
      ],
      "properties": {
        "source_descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "source_family": { "type": "string" },
        "source_label_class": { "type": "string" },
        "source_label": { "$ref": "#/$defs/non_empty_string" },
        "provider_id": { "type": ["string", "null"] },
        "router_decision_ref": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] },
        "support_class": { "type": "string" },
        "freshness_class": { "type": "string" },
        "scope_claim_class": { "type": "string" },
        "completeness_class": { "type": "string" },
        "scope_limit_classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "locality_class": { "type": "string" },
        "degraded_state_class": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "assist_narrowing_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "applicable",
        "degrade_class",
        "apply_blocked",
        "narrow_reason",
        "next_safe_action",
        "next_safe_action_command_ref",
        "keyboard_reachable",
        "disabled_state_diagnostic"
      ],
      "properties": {
        "channel": { "$ref": "#/$defs/assist_channel" },
        "applicable": { "type": "boolean" },
        "degrade_class": { "$ref": "#/$defs/degrade_class" },
        "apply_blocked": { "type": "boolean" },
        "narrow_reason": {
          "oneOf": [{ "$ref": "#/$defs/narrow_reason" }, { "type": "null" }]
        },
        "next_safe_action": {
          "oneOf": [{ "$ref": "#/$defs/next_safe_action" }, { "type": "null" }]
        },
        "next_safe_action_command_ref": { "type": ["string", "null"] },
        "keyboard_reachable": { "type": "boolean" },
        "disabled_state_diagnostic": { "type": "string" }
      }
    },
    "constrained_state_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "state_class",
        "label",
        "canonical_class_note",
        "blocks_direct_apply",
        "primary_next_safe_action",
        "primary_next_safe_action_command_ref",
        "provider_posture",
        "cells",
        "blocked_reason_summary",
        "accessibility_summary",
        "export_safe_summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_constrained_state_profile" },
        "state_class": { "$ref": "#/$defs/state_class" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "canonical_class_note": { "$ref": "#/$defs/non_empty_string" },
        "blocks_direct_apply": { "type": "boolean" },
        "primary_next_safe_action": { "$ref": "#/$defs/next_safe_action" },
        "primary_next_safe_action_command_ref": { "$ref": "#/$defs/non_empty_string" },
        "provider_posture": { "$ref": "#/$defs/assist_source_descriptor" },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assist_narrowing_cell" }
        },
        "blocked_reason_summary": { "$ref": "#/$defs/non_empty_string" },
        "accessibility_summary": { "$ref": "#/$defs/non_empty_string" },
        "export_safe_summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "degraded_provider_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "case_id",
        "provider_state",
        "source",
        "channel",
        "degrade_class",
        "next_safe_action",
        "next_safe_action_command_ref",
        "source_labeled_not_silent",
        "disabled_state_diagnostic",
        "note"
      ],
      "properties": {
        "record_kind": { "const": "m5_degraded_provider_case" },
        "case_id": { "$ref": "#/$defs/non_empty_string" },
        "provider_state": { "type": "string" },
        "source": { "$ref": "#/$defs/assist_source_descriptor" },
        "channel": { "$ref": "#/$defs/assist_channel" },
        "degrade_class": { "$ref": "#/$defs/degrade_class" },
        "next_safe_action": { "$ref": "#/$defs/next_safe_action" },
        "next_safe_action_command_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_labeled_not_silent": { "type": "boolean" },
        "disabled_state_diagnostic": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "consumer_surface_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "consumer_id",
        "surface_label",
        "base_editor_surface",
        "exhibited_state",
        "representative_channel",
        "resolved_degrade",
        "next_safe_action",
        "reuses_shared_vocabulary",
        "note"
      ],
      "properties": {
        "record_kind": { "const": "m5_consumer_surface_proof" },
        "consumer_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "base_editor_surface": {
          "oneOf": [{ "$ref": "#/$defs/editor_surface" }, { "type": "null" }]
        },
        "exhibited_state": { "$ref": "#/$defs/state_class" },
        "representative_channel": { "$ref": "#/$defs/assist_channel" },
        "resolved_degrade": { "$ref": "#/$defs/degrade_class" },
        "next_safe_action": {
          "oneOf": [{ "$ref": "#/$defs/next_safe_action" }, { "type": "null" }]
        },
        "reuses_shared_vocabulary": { "type": "boolean" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
