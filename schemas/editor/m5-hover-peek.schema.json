{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/editor/m5-hover-peek.schema.json",
  "title": "Aureline hover-card and documentation-peek model",
  "description": "Boundary schema for the one canonical, frozen, export-safe model that binds transient hovercards, documentation peeks, and pinned / open-in-tab / open-in-split peek promotion into a single contextual-inspection contract across the claimed inspection contexts (code, config, notebook, request, SQL, docs code-block, generated, protected, partial-index, large-file, plus diff / review surfaces and graph-linked explainers). Each context snapshot resolves exactly one representative card. Every card embeds the canonical assist source/provenance descriptor and a symbol/anchor target referenced by id with a locked identity, so it never silently retargets when a later provider answers. Every card is keyboard-invocable so pointer hover is never the only path to its content or provenance; it surfaces stale, partial, policy-limited, imported-snapshot, wrong-provider, and suppressed states inline with a non-color cue rather than styling them like live authoritative docs; it discloses any inexact mapping quality; it keeps raw and rendered forms distinguishable and offers an open-raw escape when they differ materially; and every promotion preserves the same provider/source/freshness labels and return anchor as the transient form. The model proves these honesty invariants over its own data. No file contents, credential bodies, or raw provider payloads cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_hover_peek_schema_version",
    "schema_ref",
    "model_id",
    "as_of",
    "mode_classes",
    "context_classes",
    "state_classes",
    "mapping_quality_classes",
    "raw_rendered_classes",
    "promotion_path_classes",
    "presentation_classes",
    "context_snapshots",
    "invariants",
    "raw_payload_excluded",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_hover_peek_model" },
    "m5_hover_peek_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/editor/m5-hover-peek.schema.json" },
    "model_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "mode_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "context_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "state_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "mapping_quality_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "raw_rendered_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "promotion_path_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "presentation_classes": { "$ref": "#/$defs/class_descriptor_array" },
    "context_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/context_snapshot" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "raw_payload_excluded": { "const": true },
    "summary": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "hover_peek_mode": {
      "enum": [
        "hover_quick_info",
        "hover_pinned",
        "peek_definition",
        "peek_references",
        "peek_implementations",
        "peek_type_definition",
        "peek_call_hierarchy"
      ]
    },
    "context_class": {
      "enum": [
        "code_file",
        "config_file",
        "notebook_cell",
        "request_editor",
        "sql_editor",
        "docs_code_block",
        "generated_file",
        "protected_file",
        "partial_index_state",
        "large_file_restricted",
        "diff_review_surface",
        "graph_linked_explainer"
      ]
    },
    "editor_surface": {
      "enum": [
        "code_file",
        "config_file",
        "notebook_cell",
        "request_editor",
        "sql_editor",
        "docs_code_block",
        "generated_file",
        "protected_file",
        "partial_index_state",
        "large_file_restricted"
      ]
    },
    "state_class": {
      "enum": [
        "live",
        "stale",
        "partial",
        "policy_limited",
        "imported_snapshot",
        "wrong_provider_fallback",
        "suppressed"
      ]
    },
    "mapping_quality": {
      "enum": ["exact", "approximate", "heuristic", "unresolved"]
    },
    "raw_rendered_mode": {
      "enum": [
        "raw_source_only",
        "rendered_preview_only",
        "raw_and_rendered_equivalent",
        "raw_and_rendered_distinct"
      ]
    },
    "promotion_path": {
      "enum": ["keep_open_pinned", "open_in_tab", "open_in_split", "dismiss_return"]
    },
    "presentation_class": {
      "enum": ["transient", "pinned", "promoted_tab", "promoted_split"]
    },
    "degrade_class": {
      "enum": [
        "full_fidelity",
        "source_labeled_fallback",
        "read_only_no_apply",
        "suppressed_large_file",
        "pending_partial_index",
        "blocked_unavailable"
      ]
    },
    "class_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_token", "label", "note"],
      "properties": {
        "class_token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "class_descriptor_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/class_descriptor" }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    },
    "assist_source_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_descriptor_id",
        "source_family",
        "source_label_class",
        "source_label",
        "provider_id",
        "router_decision_ref",
        "source_ref",
        "support_class",
        "freshness_class",
        "scope_claim_class",
        "completeness_class",
        "scope_limit_classes",
        "locality_class",
        "degraded_state_class",
        "summary"
      ],
      "properties": {
        "source_descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "source_family": { "type": "string" },
        "source_label_class": { "type": "string" },
        "source_label": { "$ref": "#/$defs/non_empty_string" },
        "provider_id": { "type": ["string", "null"] },
        "router_decision_ref": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] },
        "support_class": { "type": "string" },
        "freshness_class": { "type": "string" },
        "scope_claim_class": { "type": "string" },
        "completeness_class": { "type": "string" },
        "scope_limit_classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "locality_class": { "type": "string" },
        "degraded_state_class": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "hover_peek_target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol_ref",
        "source_anchor_ref",
        "navigation_target_ref",
        "return_anchor_ref",
        "identity_locked"
      ],
      "properties": {
        "symbol_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_anchor_ref": { "$ref": "#/$defs/non_empty_string" },
        "navigation_target_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_anchor_ref": { "$ref": "#/$defs/non_empty_string" },
        "identity_locked": { "const": true }
      }
    },
    "peek_promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_class",
        "command_id_ref",
        "label",
        "is_durable",
        "preserves_source_labels",
        "source_descriptor_id_ref",
        "preserves_return_anchor",
        "return_anchor_ref"
      ],
      "properties": {
        "path_class": { "$ref": "#/$defs/promotion_path" },
        "command_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "is_durable": { "type": "boolean" },
        "preserves_source_labels": { "const": true },
        "source_descriptor_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "preserves_return_anchor": { "const": true },
        "return_anchor_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "hover_peek_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "card_id",
        "mode_class",
        "context_class",
        "target",
        "source",
        "state_class",
        "mapping_quality",
        "mapping_disclosed",
        "raw_rendered_mode",
        "raw_escape_command_id_ref",
        "rendered_form_summary",
        "raw_form_summary",
        "presentation_class",
        "promotions",
        "retarget_on_later_provider",
        "keyboard_invocable",
        "keyboard_command_id_ref",
        "dismiss_command_id_ref",
        "provenance_visible",
        "inline_state_disclosed",
        "non_color_differentiator",
        "accessibility_label"
      ],
      "properties": {
        "record_kind": { "const": "m5_hover_peek_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "mode_class": { "$ref": "#/$defs/hover_peek_mode" },
        "context_class": { "$ref": "#/$defs/context_class" },
        "target": { "$ref": "#/$defs/hover_peek_target_ref" },
        "source": { "$ref": "#/$defs/assist_source_descriptor" },
        "state_class": { "$ref": "#/$defs/state_class" },
        "mapping_quality": { "$ref": "#/$defs/mapping_quality" },
        "mapping_disclosed": { "type": "boolean" },
        "raw_rendered_mode": { "$ref": "#/$defs/raw_rendered_mode" },
        "raw_escape_command_id_ref": { "type": ["string", "null"] },
        "rendered_form_summary": { "type": ["string", "null"] },
        "raw_form_summary": { "type": ["string", "null"] },
        "presentation_class": { "$ref": "#/$defs/presentation_class" },
        "promotions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/peek_promotion" }
        },
        "retarget_on_later_provider": { "const": false },
        "keyboard_invocable": { "const": true },
        "keyboard_command_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "dismiss_command_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "provenance_visible": { "const": true },
        "inline_state_disclosed": { "type": "boolean" },
        "non_color_differentiator": { "$ref": "#/$defs/non_empty_string" },
        "accessibility_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "context_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "m5_hover_peek_schema_version",
        "snapshot_id",
        "context_class",
        "base_editor_surface",
        "workspace_id",
        "document_ref",
        "language_id",
        "degrade_class",
        "degrade_label",
        "card",
        "disclosure_required",
        "accessibility_summary",
        "export_safe_summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_hover_peek_snapshot" },
        "m5_hover_peek_schema_version": { "type": "integer", "const": 1 },
        "snapshot_id": { "$ref": "#/$defs/non_empty_string" },
        "context_class": { "$ref": "#/$defs/context_class" },
        "base_editor_surface": {
          "oneOf": [{ "$ref": "#/$defs/editor_surface" }, { "type": "null" }]
        },
        "workspace_id": { "$ref": "#/$defs/non_empty_string" },
        "document_ref": { "$ref": "#/$defs/non_empty_string" },
        "language_id": { "$ref": "#/$defs/non_empty_string" },
        "degrade_class": { "$ref": "#/$defs/degrade_class" },
        "degrade_label": { "$ref": "#/$defs/non_empty_string" },
        "card": { "$ref": "#/$defs/hover_peek_card" },
        "disclosure_required": { "type": "boolean" },
        "accessibility_summary": { "$ref": "#/$defs/non_empty_string" },
        "export_safe_summary": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
