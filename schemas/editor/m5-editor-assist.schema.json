{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/editor/m5-editor-assist.schema.json",
  "title": "Aureline editor-assist micro-surface matrix",
  "description": "Boundary schema for the one canonical, frozen, export-safe editor-assist micro-surface matrix. The matrix freezes the precedence ladder (editing truth outranks convenience metadata everywhere), the closed class catalogs for decorations, code lenses, inlay hints, completion source kinds, signature-help states, snippet-session states, and hover/peek modes, the per-surface degraded-state matrix across code, config, notebook, request, SQL, docs-code, generated, protected, partial-index, and large-file / restricted surfaces, the identity and lifecycle contracts for completion sessions, hint descriptors, hover/peek cards, snippet sessions, and degraded assist states, and the support-export minimums for each micro-surface record kind. Editor, CLI/headless, support-export, and AI-evidence consumers render this verdict rather than inventing per-pane micro-behavior. No file contents, credential bodies, or raw provider payloads cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_editor_assist_schema_version",
    "schema_ref",
    "matrix_id",
    "as_of",
    "precedence_ladder",
    "decoration_classes",
    "code_lens_classes",
    "inlay_hint_classes",
    "completion_source_kinds",
    "signature_help_states",
    "snippet_session_states",
    "hover_peek_modes",
    "degrade_states",
    "identity_contracts",
    "surface_profiles",
    "support_export_minimums",
    "invariants",
    "raw_payload_excluded",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_editor_assist_matrix" },
    "m5_editor_assist_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/editor/m5-editor-assist.schema.json" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "precedence_ladder": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/precedence_layer" }
    },
    "decoration_classes": { "$ref": "#/$defs/class_catalog" },
    "code_lens_classes": { "$ref": "#/$defs/class_catalog" },
    "inlay_hint_classes": { "$ref": "#/$defs/class_catalog" },
    "completion_source_kinds": { "$ref": "#/$defs/class_catalog" },
    "signature_help_states": { "$ref": "#/$defs/class_catalog" },
    "snippet_session_states": { "$ref": "#/$defs/class_catalog" },
    "hover_peek_modes": { "$ref": "#/$defs/class_catalog" },
    "degrade_states": { "$ref": "#/$defs/class_catalog" },
    "identity_contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identity_contract" }
    },
    "surface_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_profile" }
    },
    "support_export_minimums": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/support_export_minimum" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matrix_invariant" }
    },
    "raw_payload_excluded": { "type": "boolean", "const": true },
    "summary": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1, "maxLength": 600 },
    "truth_tier": {
      "type": "string",
      "enum": ["editing_truth", "convenience_metadata"]
    },
    "editor_layer": {
      "type": "string",
      "enum": [
        "current_debug_frame",
        "error_diagnostic",
        "merge_conflict_region",
        "review_change_marker",
        "warning_diagnostic",
        "breakpoint_marker",
        "info_hint_diagnostic",
        "search_match",
        "selection_occurrence",
        "code_lens",
        "inlay_hint",
        "inline_completion_ghost",
        "hover_card",
        "parameter_hint"
      ]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "code_file",
        "config_file",
        "notebook_cell",
        "request_editor",
        "sql_editor",
        "docs_code_block",
        "generated_file",
        "protected_file",
        "partial_index_state",
        "large_file_restricted"
      ]
    },
    "channel_class": {
      "type": "string",
      "enum": [
        "completion",
        "signature_help",
        "snippet_session",
        "code_lens",
        "inlay_hint",
        "hover",
        "peek",
        "inline_ai_assist",
        "decoration"
      ]
    },
    "degrade_class": {
      "type": "string",
      "enum": [
        "full_fidelity",
        "source_labeled_fallback",
        "read_only_no_apply",
        "suppressed_large_file",
        "pending_partial_index",
        "blocked_unavailable"
      ]
    },
    "micro_surface_kind": {
      "type": "string",
      "enum": [
        "completion_session",
        "hint_descriptor",
        "hover_peek_card",
        "snippet_session",
        "degraded_assist_state"
      ]
    },
    "precedence_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "layer",
        "label",
        "truth_tier",
        "suppressible_under_constraint",
        "disclosure"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 0, "maximum": 255 },
        "layer": { "$ref": "#/$defs/editor_layer" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "truth_tier": { "$ref": "#/$defs/truth_tier" },
        "suppressible_under_constraint": { "type": "boolean" },
        "disclosure": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "class_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_token", "label", "note"],
      "properties": {
        "class_token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "class_catalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/class_descriptor" }
    },
    "surface_assist_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "degrade_state", "keyboard_reachable", "disclosure"],
      "properties": {
        "channel": { "$ref": "#/$defs/channel_class" },
        "degrade_state": { "$ref": "#/$defs/degrade_class" },
        "keyboard_reachable": { "type": "boolean" },
        "disclosure": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "label", "is_constrained", "constraint_note", "cells"],
      "properties": {
        "surface": { "$ref": "#/$defs/surface_class" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "is_constrained": { "type": "boolean" },
        "constraint_note": { "$ref": "#/$defs/non_empty_string" },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_assist_cell" }
        }
      }
    },
    "identity_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id_prefix", "required_lifecycle_fields", "note"],
      "properties": {
        "kind": { "$ref": "#/$defs/micro_surface_kind" },
        "id_prefix": { "$ref": "#/$defs/non_empty_string" },
        "required_lifecycle_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "support_export_minimum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "required_fields", "raw_payload_excluded", "note"],
      "properties": {
        "record_kind": { "$ref": "#/$defs/non_empty_string" },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "raw_payload_excluded": { "type": "boolean", "const": true },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "matrix_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    }
  }
}
