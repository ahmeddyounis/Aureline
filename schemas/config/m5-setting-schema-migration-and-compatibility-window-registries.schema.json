{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-setting-schema-migration-and-compatibility-window-registries.schema.json",
  "title": "Aureline M5 schema-migration and compatibility-window registries",
  "description": "Export-safe packet for the schema-migration + downgrade implement lane over the frozen M5 settings-governance matrix (migrate_schema family). It carries resolved, honest projections of the schema-migration-record family (how a version change declares the old key / alias, new key, transform, lossy fidelity, compatibility window, and rollback note) and the compatibility-window family (how an upgrade, import, restore, or downgrade flow discloses whether stored meaning is inside its window, deprecated but supported, or outside the window) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved schema-migration entries (naming a canonical registry token, a stable migration-target ID, a semantic role, a classified fidelity label, a published old-key / new-key / transform / compatibility-window / rollback-note / compare-before-apply-reference / migration-provenance-reference, and canonical/accessible/audit resolution-form coverage while keeping the fidelity label honest and materializing the compare-before-apply surface before a lossy or manual-review migration applies) and resolved compatibility-window entries (naming a canonical registry token, a stable window-ref, a semantic role, a classified window class, and the complete window-source / supported-version-range / deprecation-review / validation-status / review-state / docs-pointer / last-review-revision compatibility-window object). Hard invariants forbid implying full fidelity when the migration is lossy, altering stored meaning without a checked-in migration record, applying a lossy migration without a compare-before-apply surface, and hiding the compatibility window or downgrade cause behind generic copy. Acceptance criteria — configuration artifacts carry explicit migration provenance and compatibility-window truth; no downgrade/import path implies full fidelity when the migration is lossy or requires manual review; and the suite fails when a schema change alters stored meaning without a checked-in migration record and compare surface — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_setting_schema_migration_and_compatibility_window_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "settings_governance_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "settings_governance_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "schema_migration_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "migration_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "fidelity_class",
        "fidelity_class_is_classified",
        "canonical_class_mode",
        "surface_context",
        "old_key_or_alias",
        "new_key",
        "transform",
        "compatibility_window",
        "rollback_note",
        "compare_before_apply_reference",
        "migration_provenance_reference",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "schema_migration_record_complete",
        "bound_to_registry",
        "fidelity_label_honest",
        "is_lossy_or_manual_review",
        "compare_surface_materialized",
        "degrade_reason",
        "next_action",
        "migration_resolves_across_routes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "migration_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "fidelity_class": { "$ref": "#/$defs/non_empty_string" },
        "fidelity_class_is_classified": { "type": "boolean" },
        "canonical_class_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "old_key_or_alias": { "type": "string" },
        "new_key": { "type": "string" },
        "transform": { "type": "string" },
        "compatibility_window": { "type": "string" },
        "rollback_note": { "type": "string" },
        "compare_before_apply_reference": { "type": "string" },
        "migration_provenance_reference": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "schema_migration_record_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "fidelity_label_honest": { "type": "boolean" },
        "is_lossy_or_manual_review": { "type": "boolean" },
        "compare_surface_materialized": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "migration_resolves_across_routes": { "type": "boolean" }
      }
    },
    "compatibility_window_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "window_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "window_class",
        "window_class_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "window_source",
        "supported_version_range",
        "deprecation_review",
        "validation_status",
        "review_state",
        "docs_pointer",
        "last_review_revision",
        "keeps_window_source_visible",
        "window_is_truthful",
        "deprecation_present",
        "deprecation_source_disclosed",
        "unsupported_present",
        "downgrade_guidance_disclosed",
        "compatibility_window_stays_honest",
        "provides_complete_compatibility_window",
        "degrade_reason",
        "next_action",
        "window_safe_on_every_route"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "window_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "window_class": { "$ref": "#/$defs/non_empty_string" },
        "window_class_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "window_source": { "type": "string" },
        "supported_version_range": { "type": "string" },
        "deprecation_review": { "type": "string" },
        "validation_status": { "type": "string" },
        "review_state": { "type": "string" },
        "docs_pointer": { "type": "string" },
        "last_review_revision": { "type": "string" },
        "keeps_window_source_visible": { "type": "boolean" },
        "window_is_truthful": { "type": "boolean" },
        "deprecation_present": { "type": "boolean" },
        "deprecation_source_disclosed": { "type": "boolean" },
        "unsupported_present": { "type": "boolean" },
        "downgrade_guidance_disclosed": { "type": "boolean" },
        "compatibility_window_stays_honest": { "type": "boolean" },
        "provides_complete_compatibility_window": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "window_safe_on_every_route": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "schema_migration_entries",
        "compatibility_window_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "implies_full_fidelity_when_migration_is_lossy",
        "alters_stored_meaning_without_a_checked_in_migration_record",
        "applies_a_lossy_migration_without_a_compare_before_apply_surface",
        "hides_the_compatibility_window_or_downgrade_cause_behind_generic_copy"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "schema_migration_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/schema_migration_entry" }
        },
        "compatibility_window_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compatibility_window_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_full_fidelity_when_migration_is_lossy": { "const": false },
        "alters_stored_meaning_without_a_checked_in_migration_record": { "const": false },
        "applies_a_lossy_migration_without_a_compare_before_apply_surface": { "const": false },
        "hides_the_compatibility_window_or_downgrade_cause_behind_generic_copy": { "const": false }
      }
    }
  }
}
