{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-settings-resolver-matrix.schema.json",
  "title": "Aureline M5 setting-definition, write-intent, sync-conflict, and capability-lifecycle matrix",
  "description": "Export-safe packet freezing Aureline's concrete settings-resolver, sync-conflict, and capability-lifecycle runtime behavior. The packet names every claimed M5 configuration-bearing verb — resolve an effective setting from the winning scope, land a write intent in the chosen artifact and scope, sync a scope bundle across devices, migrate a settings schema across versions, and roll out a capability lifecycle — and binds each governed family to the claimed surface families that render it (settings, shell, diagnostics, admin, docs/help, support-export), the configuration contexts it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each family declares the controlled vocabularies it carries: the single controlled settings-governance-role vocabulary consumers bind to (setting_definition, effective_resolution, write_intent, policy_constraint, sync_conflict, schema_migration, capability_lifecycle), plus family-specific resolve-setting roles, write-setting roles, sync-scope roles, migrate-schema roles, and rollout-capability roles. Hard invariants forbid recycling a retired setting ID, rewriting a scoped (Workspace/Profile) write into a broader (User/Machine) scope because it is easier downstream, silently overwriting locked or machine-only state during sync, hiding a lifecycle or experiment dependency behind unpublished markers, and hiding a kill-switch or policy-disable cause behind generic unavailable copy. The matrix binds back to the already-landed effective-setting and capability-lifecycle packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "settings_governance_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_setting_definition_write_intent_sync_conflict_and_capability_lifecycle_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "settings_governance_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/settings_governance_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "settings_governance_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "settings_governance_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "settings_governance_family": {
      "enum": [
        "resolve_setting",
        "write_setting",
        "sync_scope",
        "migrate_schema",
        "rollout_capability"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "setting_definition",
        "effective_resolution",
        "write_intent",
        "policy_constraint",
        "sync_conflict",
        "schema_migration",
        "capability_lifecycle"
      ]
    },
    "settings_governance_row": {
      "type": "object",
      "required": [
        "settings_governance_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "recycles_a_retired_setting_id",
        "rewrites_a_scoped_write_into_a_broader_scope",
        "silently_overwrites_locked_or_machine_only_state_during_sync",
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers",
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy"
      ],
      "properties": {
        "settings_governance_family": {
          "$ref": "#/$defs/settings_governance_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "resolve_setting_roles": {
          "type": "array"
        },
        "write_setting_roles": {
          "type": "array"
        },
        "sync_scope_roles": {
          "type": "array"
        },
        "migrate_schema_roles": {
          "type": "array"
        },
        "rollout_capability_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "recycles_a_retired_setting_id": {
          "const": false
        },
        "rewrites_a_scoped_write_into_a_broader_scope": {
          "const": false
        },
        "silently_overwrites_locked_or_machine_only_state_during_sync": {
          "const": false
        },
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers": {
          "const": false
        },
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy": {
          "const": false
        }
      }
    }
  }
}
