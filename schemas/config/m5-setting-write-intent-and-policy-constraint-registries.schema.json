{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-setting-write-intent-and-policy-constraint-registries.schema.json",
  "title": "Aureline M5 setting-write-intent and policy-constraint registries",
  "description": "Export-safe packet for the write-pipeline implement lane over the frozen M5 settings-governance matrix (write_setting family). It carries resolved, honest projections of the setting-write-intent family (how a configuration mutation declares the scope, artifact, actor, reason, preview class, and recovery evidence it will land) and the policy / constraint family (how a locked or denied write explains itself) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved write-intent entries (naming a canonical registry token, a stable write-target ID, a semantic role, a classified preview class, a published target scope / target artifact / intended value / actor / change reason / preview reference / checkpoint-and-rollback recovery reference, and canonical/accessible/audit resolution-form coverage while landing only in the chosen scope and artifact and materializing the recovery evidence before a high-risk write applies) and resolved policy-constraint entries (naming a canonical registry token, a stable constraint-ref, a semantic role, a classified lock class, and the complete lock-source / allowed-override-classes / expiry-review / validation-status / review-state / docs-pointer / last-review-revision policy-constraint object). Hard invariants forbid rewriting a scoped write into a broader scope, landing a write in an unintended artifact or scope, applying a high-risk write without preview / checkpoint / rollback evidence, and hiding a lock or policy-disable cause behind generic unavailable copy. Acceptance criteria — high-risk changes produce preview / checkpoint / rollback evidence before apply; locked or denied writes return structured reasons and fallback guidance; and the suite fails when a route rewrites scope or artifact ownership without explicit intent — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_setting_write_intent_and_policy_constraint_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "settings_governance_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "settings_governance_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "write_intent_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "write_target_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "preview_class",
        "preview_class_is_classified",
        "canonical_class_mode",
        "surface_context",
        "target_scope",
        "target_artifact",
        "intended_value",
        "actor",
        "change_reason",
        "preview_reference",
        "recovery_reference",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "write_intent_object_complete",
        "bound_to_registry",
        "scope_ownership_preserved",
        "is_high_risk_write",
        "evidence_materialized",
        "degrade_reason",
        "next_action",
        "write_intent_lands_across_routes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "write_target_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "preview_class": { "$ref": "#/$defs/non_empty_string" },
        "preview_class_is_classified": { "type": "boolean" },
        "canonical_class_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "target_scope": { "type": "string" },
        "target_artifact": { "type": "string" },
        "intended_value": { "type": "string" },
        "actor": { "type": "string" },
        "change_reason": { "type": "string" },
        "preview_reference": { "type": "string" },
        "recovery_reference": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "write_intent_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "scope_ownership_preserved": { "type": "boolean" },
        "is_high_risk_write": { "type": "boolean" },
        "evidence_materialized": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "write_intent_lands_across_routes": { "type": "boolean" }
      }
    },
    "policy_constraint_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "constraint_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "lock_class",
        "lock_class_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "lock_source",
        "allowed_override_classes",
        "expiry_review",
        "validation_status",
        "review_state",
        "docs_pointer",
        "last_review_revision",
        "keeps_lock_source_visible",
        "constraint_is_truthful",
        "lock_present",
        "lock_source_disclosed",
        "denial_present",
        "fallback_guidance_disclosed",
        "policy_constraint_stays_honest",
        "provides_complete_policy_constraint",
        "degrade_reason",
        "next_action",
        "constraint_safe_on_every_route"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "constraint_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "lock_class": { "$ref": "#/$defs/non_empty_string" },
        "lock_class_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "lock_source": { "type": "string" },
        "allowed_override_classes": { "type": "string" },
        "expiry_review": { "type": "string" },
        "validation_status": { "type": "string" },
        "review_state": { "type": "string" },
        "docs_pointer": { "type": "string" },
        "last_review_revision": { "type": "string" },
        "keeps_lock_source_visible": { "type": "boolean" },
        "constraint_is_truthful": { "type": "boolean" },
        "lock_present": { "type": "boolean" },
        "lock_source_disclosed": { "type": "boolean" },
        "denial_present": { "type": "boolean" },
        "fallback_guidance_disclosed": { "type": "boolean" },
        "policy_constraint_stays_honest": { "type": "boolean" },
        "provides_complete_policy_constraint": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "constraint_safe_on_every_route": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "write_intent_entries",
        "policy_constraint_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewrites_a_scoped_write_into_a_broader_scope",
        "lands_a_write_in_an_unintended_artifact_or_scope",
        "applies_a_high_risk_write_without_preview_checkpoint_or_rollback",
        "hides_a_lock_or_policy_disable_cause_behind_generic_unavailable_copy"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "write_intent_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/write_intent_entry" }
        },
        "policy_constraint_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/policy_constraint_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rewrites_a_scoped_write_into_a_broader_scope": { "const": false },
        "lands_a_write_in_an_unintended_artifact_or_scope": { "const": false },
        "applies_a_high_risk_write_without_preview_checkpoint_or_rollback": { "const": false },
        "hides_a_lock_or_policy_disable_cause_behind_generic_unavailable_copy": { "const": false }
      }
    }
  }
}
