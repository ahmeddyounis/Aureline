{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-setting-sync-conflict-and-device-action-registries.schema.json",
  "title": "Aureline M5 sync-conflict and device-action registries",
  "description": "Export-safe packet for the sync / conflict engine implement lane over the frozen M5 settings-governance matrix (sync_scope family). It carries resolved, honest projections of the sync-conflict-packet family (how a sync scope bundle, session, and conflict packet declare which field diverged, the local and remote revisions, the field-level keep-local / keep-synced options, the compare surface, and the blocked-state reason a conflict class carries) and the device-action-record family (how a device action ledger records the actor, timestamp, transport and policy state, capability dependency, attribution, and last revision for a pause / resume / revoke / forget / token-rotation action) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved sync-conflict entries (naming a canonical registry token, a stable conflict-target ID, a semantic role, a classified conflict class, a published field-path / local-revision / remote-revision / keep-local-option / keep-synced-option / compare-reference / blocked-state-reason, and canonical/accessible/audit resolution-form coverage while keeping the resolution field-aware and preserving local authoritative state before a protected policy-locked / machine-only / stale-remote conflict applies) and resolved device-action entries (naming a canonical registry token, a stable device-ref, a semantic role, a classified device-action class, and the complete actor / action-timestamp / transport-state / policy-state / capability-dependency / attribution-reference / last-ledger-revision device-action-record object). Hard invariants forbid silently overwriting locked or machine-only state during sync, collapsing conflict classes into last-writer-wins, resolving a conflict without a field-level keep-local or blocked reason, and losing device action lineage in diagnostics or support. Acceptance criteria — local durable state remains authoritative when sync transport, encryption, policy, or provider state degrades; users can review and resolve conflicts at the field level with keep-local/keep-synced/compare behavior and explicit blocked-state reasons; and the suite fails when sync/import routes silently overwrite locked, machine-only, or stale-local configuration state — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_setting_sync_conflict_and_device_action_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "settings_governance_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "settings_governance_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "sync_conflict_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "conflict_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "conflict_class",
        "conflict_class_is_classified",
        "canonical_class_mode",
        "surface_context",
        "field_path",
        "local_revision",
        "remote_revision",
        "keep_local_option",
        "keep_synced_option",
        "compare_reference",
        "blocked_state_reason",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "sync_conflict_packet_complete",
        "bound_to_registry",
        "resolution_is_field_aware",
        "requires_local_authoritative",
        "local_authority_preserved",
        "degrade_reason",
        "next_action",
        "conflict_resolves_across_routes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "conflict_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "conflict_class": { "$ref": "#/$defs/non_empty_string" },
        "conflict_class_is_classified": { "type": "boolean" },
        "canonical_class_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "field_path": { "type": "string" },
        "local_revision": { "type": "string" },
        "remote_revision": { "type": "string" },
        "keep_local_option": { "type": "string" },
        "keep_synced_option": { "type": "string" },
        "compare_reference": { "type": "string" },
        "blocked_state_reason": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "sync_conflict_packet_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "resolution_is_field_aware": { "type": "boolean" },
        "requires_local_authoritative": { "type": "boolean" },
        "local_authority_preserved": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "conflict_resolves_across_routes": { "type": "boolean" }
      }
    },
    "device_action_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "device_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "device_action_class",
        "device_action_class_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "actor",
        "action_timestamp",
        "transport_state",
        "policy_state",
        "capability_dependency",
        "attribution_reference",
        "last_ledger_revision",
        "keeps_attribution_visible",
        "ledger_is_truthful",
        "revocation_present",
        "revocation_reason_disclosed",
        "degraded_transport_present",
        "local_authority_preserved_disclosed",
        "device_action_ledger_stays_reconstructable",
        "provides_complete_device_action_ledger",
        "degrade_reason",
        "next_action",
        "ledger_safe_on_every_route"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "device_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "device_action_class": { "$ref": "#/$defs/non_empty_string" },
        "device_action_class_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "actor": { "type": "string" },
        "action_timestamp": { "type": "string" },
        "transport_state": { "type": "string" },
        "policy_state": { "type": "string" },
        "capability_dependency": { "type": "string" },
        "attribution_reference": { "type": "string" },
        "last_ledger_revision": { "type": "string" },
        "keeps_attribution_visible": { "type": "boolean" },
        "ledger_is_truthful": { "type": "boolean" },
        "revocation_present": { "type": "boolean" },
        "revocation_reason_disclosed": { "type": "boolean" },
        "degraded_transport_present": { "type": "boolean" },
        "local_authority_preserved_disclosed": { "type": "boolean" },
        "device_action_ledger_stays_reconstructable": { "type": "boolean" },
        "provides_complete_device_action_ledger": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "ledger_safe_on_every_route": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "sync_conflict_entries",
        "device_action_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "silently_overwrites_locked_or_machine_only_state_during_sync",
        "collapses_conflict_classes_into_last_writer_wins",
        "resolves_a_conflict_without_a_field_level_keep_local_or_blocked_reason",
        "loses_device_action_lineage_in_diagnostics_or_support"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "sync_conflict_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sync_conflict_entry" }
