          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/device_action_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "silently_overwrites_locked_or_machine_only_state_during_sync": { "const": false },
        "collapses_conflict_classes_into_last_writer_wins": { "const": false },
        "resolves_a_conflict_without_a_field_level_keep_local_or_blocked_reason": { "const": false },
