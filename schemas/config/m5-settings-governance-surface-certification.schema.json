{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-settings-governance-surface-certification.schema.json",
  "title": "Aureline M5 settings-governance surface certification packet",
  "description": "M05-1203 closing capstone certifying that the frozen M5 configuration-runtime families (resolve setting, write setting, sync scope, migrate schema, rollout capability) hold their settings-governance truth on every claimed M5 configuration-bearing profile. Keyed on the claimed profile (live trusted settings surface, reviewable settings structure, disclosed write-intent profile, unverified sync-conflict profile, unverified capability-lifecycle profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and settings-governance-component-truth behavior — and either passes (green), auto-narrows its configuration claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted settings surface profile may certify a trusted settings surface; and every B143 hard invariant must hold (no setting ID is recycled; no scoped write is rewritten into a broader scope; no locked or machine-only state is silently overwritten during sync; no lifecycle or experiment dependency is hidden behind unpublished markers; and no kill-switch or policy-disable cause is hidden behind generic unavailable copy). Every row cites exactly one canonical settings-governance proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_settings_governance_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-settings-governance-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_settings_surface",
        "reviewable_settings_structure",
        "disclosed_write_intent_profile",
        "unverified_sync_conflict_profile",
        "unverified_capability_lifecycle_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "settings_governance_component_truth"
      ]
    },
    "settings_governance_claim": {
      "enum": [
        "trusted_settings_surface",
        "reviewable_settings_surface",
        "write_intent_disclosed_projection",
        "sync_conflict_unverified_projection",
        "capability_lifecycle_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "settings_governance_family": {
      "enum": [
        "resolve_setting",
        "write_setting",
        "sync_scope",
        "migrate_schema",
        "rollout_capability"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "recycled_a_retired_setting_id",
        "rewrote_a_scoped_write_into_a_broader_scope",
        "silently_overwrote_locked_or_machine_only_state_during_sync",
        "hid_lifecycle_or_experiment_dependency_behind_unpublished_markers",
        "hid_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy",
        "scope_boundary_drifted_by_surface",
        "winning_scope_unstated",
        "write_intent_unstated",
        "lifecycle_state_unstated",
        "registry_reference_unstated",
        "sync_conflict_rule_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recycles_a_retired_setting_id",
        "rewrites_a_scoped_write_into_a_broader_scope",
        "silently_overwrites_locked_or_machine_only_state_during_sync",
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers",
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy"
      ],
      "properties": {
        "recycles_a_retired_setting_id": { "const": false },
        "rewrites_a_scoped_write_into_a_broader_scope": { "const": false },
        "silently_overwrites_locked_or_machine_only_state_during_sync": { "const": false },
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers": { "const": false },
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/settings_governance_claim" },
        "to_claim": { "$ref": "#/$defs/settings_governance_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_settings_governance_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/settings_governance_claim" },
        "certified_claim": { "$ref": "#/$defs/settings_governance_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/settings_governance_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-settings-governance-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
