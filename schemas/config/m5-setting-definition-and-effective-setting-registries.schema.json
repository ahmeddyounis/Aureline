{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-setting-definition-and-effective-setting-registries.schema.json",
  "title": "Aureline M5 setting-definition and effective-setting registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 settings-governance matrix. It carries resolved, honest projections of the setting-definition family (how a stable setting is declared) and the effective-setting family (how its live value is resolved from the winning scope) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved setting-definition entries (naming a canonical registry token, a stable setting-binding ID, a semantic role, a classified setting-definition type, a published stable setting ID / allowed scopes / declared default / migration aliases / restart posture / sensitivity class / capability dependencies, and canonical/accessible/audit resolution-form coverage while preserving the stable setting ID as a non-recycled identity and disclosing the sensitivity posture before a sensitive setting is surfaced) and resolved effective-setting entries (naming a canonical registry token, a stable setting-ref, a semantic role, a classified winning scope, and the complete resolved-value / shadow-chain / lock-state / validation-status / restart-state / capability-availability / last-applied-revision effective-setting object). Hard invariants forbid recycling a retired setting ID, resolving an effective value without an inspectable shadow chain, hiding restart posture / lock source / sensitivity before the resolution, and collapsing distinct settings scopes into one resolution path. Acceptance criteria — every claimed setting resolves to one stable setting-definition object and one effective-setting object; users and support can inspect what is active and why another scope lost and whether restart is required; and the suite fails when a settings consumer uses a copied ID, ambiguous type, or divergent restart posture — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_setting_definition_and_effective_setting_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "settings_governance_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "settings_governance_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "setting_definition_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "setting_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "setting_definition_type",
        "setting_definition_type_is_classified",
        "canonical_type_mode",
        "surface_context",
        "stable_setting_id",
        "allowed_scopes",
        "declared_default",
        "migration_aliases",
        "restart_posture",
        "sensitivity_class",
        "capability_dependencies",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "setting_definition_object_complete",
        "bound_to_registry",
        "setting_id_preserved",
        "is_sensitive_setting",
        "sensitivity_disclosed",
        "degrade_reason",
        "next_action",
        "definition_resolves_across_settings"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "setting_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "setting_definition_type": { "$ref": "#/$defs/non_empty_string" },
        "setting_definition_type_is_classified": { "type": "boolean" },
        "canonical_type_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "stable_setting_id": { "type": "string" },
        "allowed_scopes": { "type": "string" },
        "declared_default": { "type": "string" },
        "migration_aliases": { "type": "string" },
        "restart_posture": { "type": "string" },
        "sensitivity_class": { "type": "string" },
        "capability_dependencies": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "setting_definition_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "setting_id_preserved": { "type": "boolean" },
        "is_sensitive_setting": { "type": "boolean" },
        "sensitivity_disclosed": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "definition_resolves_across_settings": { "type": "boolean" }
      }
    },
    "effective_setting_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "setting_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "winning_scope",
        "winning_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_value_summary",
        "shadow_chain",
        "lock_or_constraint_state",
        "validation_status",
        "restart_state",
        "capability_availability",
        "last_applied_revision",
        "keeps_shadow_chain_visible",
        "resolution_is_truthful",
        "lock_present",
        "lock_source_disclosed",
        "machine_only_value_present",
        "machine_only_flagged_not_portable",
        "effective_setting_stays_honest",
        "provides_complete_effective_setting",
        "degrade_reason",
        "next_action",
        "record_safe_on_every_setting"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "setting_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "winning_scope": { "$ref": "#/$defs/non_empty_string" },
        "winning_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_value_summary": { "type": "string" },
        "shadow_chain": { "type": "string" },
        "lock_or_constraint_state": { "type": "string" },
        "validation_status": { "type": "string" },
        "restart_state": { "type": "string" },
        "capability_availability": { "type": "string" },
        "last_applied_revision": { "type": "string" },
        "keeps_shadow_chain_visible": { "type": "boolean" },
        "resolution_is_truthful": { "type": "boolean" },
        "lock_present": { "type": "boolean" },
        "lock_source_disclosed": { "type": "boolean" },
        "machine_only_value_present": { "type": "boolean" },
        "machine_only_flagged_not_portable": { "type": "boolean" },
        "effective_setting_stays_honest": { "type": "boolean" },
        "provides_complete_effective_setting": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "record_safe_on_every_setting": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "setting_definition_entries",
        "effective_setting_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "recycles_a_retired_setting_id",
        "resolves_an_effective_value_without_an_inspectable_shadow_chain",
        "hides_restart_posture_lock_source_or_sensitivity_before_resolution",
        "collapses_distinct_settings_scopes_into_one_resolution_path"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "setting_definition_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/setting_definition_entry" }
        },
        "effective_setting_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effective_setting_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "recycles_a_retired_setting_id": { "const": false },
        "resolves_an_effective_value_without_an_inspectable_shadow_chain": { "const": false },
        "hides_restart_posture_lock_source_or_sensitivity_before_resolution": { "const": false },
        "collapses_distinct_settings_scopes_into_one_resolution_path": { "const": false }
      }
    }
  }
}
