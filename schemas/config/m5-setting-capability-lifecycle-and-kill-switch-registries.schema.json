{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-setting-capability-lifecycle-and-kill-switch-registries.schema.json",
  "title": "Aureline M5 capability-record and kill-switch-record registries",
  "description": "Export-safe packet for the capability-lifecycle / kill-switch implement lane over the frozen M5 settings-governance matrix (rollout_capability family). It carries resolved, honest projections of the capability-record family (how a capability record, Labs enrollment, rollout plan, and dependency marker declare the lifecycle state, the accountable owner, the scope, the review / expiry window, the enabled posture, the artifact dependency marker, the fallback, and the rollback note a capability carries) and the kill-switch-record family (how a kill-switch or policy-disable record names the disabling source, the disabled timestamp, the preserved user-authored data, the self-explanation, the capability dependency, the fallback, and the last revision for a kill-switch / policy-disable / dependency-unavailable / review-expired / manual-opt-out disable) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved capability entries (naming a canonical registry token, a stable capability-target ID, a semantic role, a classified lifecycle class, a published owner / scope / review-or-expiry / enabled-posture / dependency-marker / fallback / rollback-note, and canonical/accessible/audit resolution-form coverage while keeping the dependency marker published and publishing a fallback before a protected Labs / Preview / Beta capability is claimed) and resolved kill-switch entries (naming a canonical registry token, a stable capability-ref, a semantic role, a classified kill-switch class, and the complete disabling-source / disabled-timestamp / preserved-data-reference / explanation-reference / capability-dependency / fallback-reference / last-ledger-revision kill-switch-record object). Hard invariants forbid hiding a lifecycle or experiment dependency behind unpublished markers, hiding a kill-switch or policy-disable cause behind generic unavailable copy, letting a stable-facing surface depend on a hidden Labs or Preview capability, and losing user-authored data when a kill switch or policy disable fires. Acceptance criteria — lifecycle states, dependency markers, and kill-switch posture stay canonical across claimed M5 settings, docs, bundle, import, and export surfaces; no stable-facing surface depends on a hidden Labs/Preview capability without an explicit dependency marker and fallback; and the suite fails when two consumers describe the same capability state, dependency, or kill-switch outcome differently — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_setting_capability_lifecycle_and_kill_switch_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "settings_governance_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "settings_governance_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "capability_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "capability_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "lifecycle_class",
        "lifecycle_class_is_classified",
        "canonical_state_mode",
        "surface_context",
        "owner",
        "scope",
        "review_or_expiry",
        "enabled_posture",
        "dependency_marker",
        "fallback",
        "rollback_note",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "capability_record_complete",
        "bound_to_registry",
        "dependency_marker_published",
        "requires_dependency_marker_and_fallback",
        "fallback_published",
        "degrade_reason",
        "next_action",
        "capability_resolves_across_routes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "capability_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "lifecycle_class": { "$ref": "#/$defs/non_empty_string" },
        "lifecycle_class_is_classified": { "type": "boolean" },
        "canonical_state_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "owner": { "type": "string" },
        "scope": { "type": "string" },
        "review_or_expiry": { "type": "string" },
        "enabled_posture": { "type": "string" },
        "dependency_marker": { "type": "string" },
        "fallback": { "type": "string" },
        "rollback_note": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "capability_record_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "dependency_marker_published": { "type": "boolean" },
        "requires_dependency_marker_and_fallback": { "type": "boolean" },
        "fallback_published": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "capability_resolves_across_routes": { "type": "boolean" }
      }
    },
    "kill_switch_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "capability_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying",
        "kill_switch_class",
        "kill_switch_class_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "disabling_source",
        "disabled_timestamp",
        "preserved_data_reference",
        "explanation_reference",
        "capability_dependency",
        "fallback_reference",
        "last_ledger_revision",
        "keeps_disabling_source_visible",
        "ledger_is_truthful",
        "policy_disable_present",
        "disable_cause_disclosed",
        "user_data_present",
        "user_data_preservation_disclosed",
        "kill_switch_record_preserves_data_and_explains",
        "provides_complete_kill_switch_ledger",
        "degrade_reason",
        "next_action",
        "ledger_safe_on_every_route"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "capability_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_evidence_and_disclose_cause_before_applying": { "type": "boolean" },
        "kill_switch_class": { "$ref": "#/$defs/non_empty_string" },
        "kill_switch_class_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "disabling_source": { "type": "string" },
        "disabled_timestamp": { "type": "string" },
        "preserved_data_reference": { "type": "string" },
        "explanation_reference": { "type": "string" },
        "capability_dependency": { "type": "string" },
        "fallback_reference": { "type": "string" },
        "last_ledger_revision": { "type": "string" },
        "keeps_disabling_source_visible": { "type": "boolean" },
        "ledger_is_truthful": { "type": "boolean" },
        "policy_disable_present": { "type": "boolean" },
        "disable_cause_disclosed": { "type": "boolean" },
        "user_data_present": { "type": "boolean" },
        "user_data_preservation_disclosed": { "type": "boolean" },
        "kill_switch_record_preserves_data_and_explains": { "type": "boolean" },
        "provides_complete_kill_switch_ledger": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "ledger_safe_on_every_route": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "capability_entries",
        "kill_switch_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers",
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy",
        "lets_a_stable_surface_depend_on_a_hidden_labs_or_preview_capability",
        "loses_user_authored_data_when_a_kill_switch_or_policy_disable_fires"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "capability_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability_entry" }
        },
        "kill_switch_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/kill_switch_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers": { "const": false },
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy": { "const": false },
        "lets_a_stable_surface_depend_on_a_hidden_labs_or_preview_capability": { "const": false },
        "loses_user_authored_data_when_a_kill_switch_or_policy_disable_fires": { "const": false }
      }
    }
  }
}
