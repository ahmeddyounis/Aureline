{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-sync-conflict-packet.schema.json",
  "title": "Aureline M5 sync-conflict-packet acquisition-profile entry",
  "description": "Canonical single-entry shape of an M5 configuration-runtime family whose truth is how a scope bundle syncs across devices: the sync scope bundle and session resolved, the conflict packet surfaced rather than auto-overwritten, the local authoritative state preserved during an outage, and machine-only state never marked portable (sync scope). Every claimed M5 configuration-bearing surface references this schema or the combined m5-settings-resolver-matrix.schema.json rather than reinventing its own sync-bundle, conflict-packet, or device-action rules. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-entry shape.",
  "type": "object",
  "required": [
    "settings_governance_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "semantic_roles",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "recycles_a_retired_setting_id",
    "rewrites_a_scoped_write_into_a_broader_scope",
    "silently_overwrites_locked_or_machine_only_state_during_sync",
    "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers",
    "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy"
  ],
  "properties": {
    "settings_governance_family": {
      "$ref": "#/$defs/settings_governance_family"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "setting_definition",
          "effective_resolution",
          "write_intent",
          "policy_constraint",
          "sync_conflict",
          "schema_migration",
          "capability_lifecycle"
        ]
      }
    },
    "resolve_setting_roles": {
      "type": "array"
    },
    "write_setting_roles": {
      "type": "array"
    },
    "sync_scope_roles": {
      "type": "array"
    },
    "migrate_schema_roles": {
      "type": "array"
    },
    "rollout_capability_roles": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "recycles_a_retired_setting_id": {
      "const": false
    },
    "rewrites_a_scoped_write_into_a_broader_scope": {
      "const": false
    },
    "silently_overwrites_locked_or_machine_only_state_during_sync": {
      "const": false
    },
    "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers": {
      "const": false
    },
    "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "settings_governance_family": {
      "enum": [
        "sync_scope"
      ]
    }
  }
}
