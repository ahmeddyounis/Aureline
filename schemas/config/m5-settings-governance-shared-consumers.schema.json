{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/config/m5-settings-governance-shared-consumers.schema.json",
  "title": "M5 Settings-Governance Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the five B143 settings-governance families (resolve setting, write setting, sync scope, migrate schema, rollout capability) to the settings-resolver / shell / sync-service / policy-service / capability-service / diagnostics / docs-help / CLI-export / support-export consumers that render them, proving one shared settings-governance registry across the GUI settings, CLI / headless inspect, Project Doctor, support-export, import / export, and policy-explainer surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_settings_governance_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "settings_governance_family": {
      "type": "string",
      "enum": [
        "resolve_setting",
        "write_setting",
        "sync_scope",
        "migrate_schema",
        "rollout_capability"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "settings_resolver",
        "shell_ui",
        "sync_service",
        "policy_service",
        "capability_service",
        "diagnostics",
        "docs_help",
        "cli_export",
        "support_export"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "settings_governance_grammar_drift_detected",
        "evidence_or_cause_disclosure_dropped",
        "recycles_a_retired_setting_id",
        "rewrites_a_scoped_write_into_a_broader_scope",
        "silently_overwrites_locked_or_machine_only_state_during_sync",
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers",
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy",
        "canonical_registry_reference_missing",
        "upstream_settings_governance_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings_governance_role_word",
        "family_word",
        "registry_reference_word",
        "resolution_context_word",
        "surface_context_word",
        "evidence_continuity_word"
      ],
      "properties": {
        "settings_governance_role_word": {
          "type": "string",
          "enum": [
            "setting_definition",
            "effective_resolution",
            "write_intent",
            "policy_constraint",
            "sync_conflict",
            "schema_migration",
            "capability_lifecycle"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "resolution_context_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "evidence_continuity_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "governance_profile_id",
        "governance_profile_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "recycles_a_retired_setting_id",
        "rewrites_a_scoped_write_into_a_broader_scope",
        "silently_overwrites_locked_or_machine_only_state_during_sync",
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers",
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "governance_profile_id": { "type": "string", "minLength": 1 },
        "governance_profile_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/settings_governance_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "recycles_a_retired_setting_id": {
          "type": "boolean",
          "const": false
        },
        "rewrites_a_scoped_write_into_a_broader_scope": {
          "type": "boolean",
          "const": false
        },
        "silently_overwrites_locked_or_machine_only_state_during_sync": {
          "type": "boolean",
          "const": false
        },
        "hides_lifecycle_or_experiment_dependency_behind_unpublished_markers": {
          "type": "boolean",
          "const": false
        },
        "hides_kill_switch_or_policy_disable_cause_behind_generic_unavailable_copy": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_profile_same_settings_governance_across_surfaces",
        "settings_governance_role_words_stay_in_frozen_vocabulary",
        "trust_roles_never_widen_scope_or_hide_cause",
        "setting_id_never_recycled_across_surfaces",
        "write_never_widens_a_scoped_write_into_a_broader_scope",
        "sync_never_silently_overwrites_locked_or_machine_only_state",
        "lifecycle_dependency_never_hidden_behind_unpublished_markers",
        "kill_switch_or_policy_disable_cause_never_hidden_behind_generic_copy",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_profile_same_settings_governance_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "settings_governance_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "trust_roles_never_widen_scope_or_hide_cause": {
          "type": "boolean",
          "const": true
        },
        "setting_id_never_recycled_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "write_never_widens_a_scoped_write_into_a_broader_scope": {
          "type": "boolean",
          "const": true
        },
        "sync_never_silently_overwrites_locked_or_machine_only_state": {
          "type": "boolean",
          "const": true
        },
        "lifecycle_dependency_never_hidden_behind_unpublished_markers": {
          "type": "boolean",
          "const": true
        },
        "kill_switch_or_policy_disable_cause_never_hidden_behind_generic_copy": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings_resolver_consumes_shared_settings_governance",
        "shell_ui_consumes_shared_settings_governance",
        "sync_service_consumes_shared_settings_governance",
        "policy_service_consumes_shared_settings_governance",
        "capability_service_consumes_shared_settings_governance",
        "diagnostics_consumes_shared_settings_governance",
        "docs_help_consumes_shared_settings_governance",
        "cli_export_consumes_shared_settings_governance",
        "support_export_consumes_shared_settings_governance",
        "every_family_adopted_by_two_or_more_consumers",
        "settings_governance_identical_for_same_profile",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_settings_governance_family"
      ],
      "properties": {
        "settings_resolver_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "shell_ui_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "sync_service_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "policy_service_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "capability_service_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "docs_help_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "cli_export_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_settings_governance": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "settings_governance_identical_for_same_profile": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_settings_governance_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
