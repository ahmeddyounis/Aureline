{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/admin/m5-rollout-simulation.schema.json",
  "title": "Aureline M5 rollout-simulation bundle",
  "description": "Boundary schema for the M5 dry-run rollout-simulation bundle: the typed previews Aureline shows before a policy import, promotion, bundle rollout, mirror-source change, trust-root change, or route/egress expansion is allowed to widen privilege or feature access on its claimed managed-cloud, self-hosted, sovereign/air-gapped, and mirrored/offline profiles. Every scenario is a forward dry-run that names the impacted endpoints and features, classifies the change as tightening or widening, and states the review strength, staged-rollout requirement, and rollback path a promotion must clear before it can broaden access. Each packet binds back to the frozen admin-plane matrix (schemas/admin/m5-admin-plane.schema.json): every endpoint posture state it shows and the per-profile claim state is one the matrix declares applicable for the endpoint-posture surface. Widening is gated harder than tightening, and a profile's managed claim auto-narrows off confirmed when simulation, mirror, or endpoint-posture evidence goes stale. There is exactly one typed packet per profile, consumed identically by the shell admin center, CLI/headless inspect, Help/About, support export, and release evidence. No endpoint URLs, hostnames, credentials, raw provider payloads, or absolute paths cross this boundary; the record carries opaque object refs, stable tokens, rendered metadata-safe value summaries, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_rollout_simulation_schema_version",
    "schema_ref",
    "bundle_id",
    "as_of",
    "matrix_ref",
    "matrix_id",
    "freeze_gate_ref",
    "summary",
    "profiles",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_rollout_simulation_bundle" },
    "m5_rollout_simulation_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/admin/m5-rollout-simulation.schema.json" },
    "bundle_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "matrix_ref": { "$ref": "#/$defs/repo_ref" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/simulation_packet" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/simulation_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "safe_token": {
      "type": "string",
      "minLength": 1,
      "description": "An opaque stable token with no URL scheme or absolute path.",
      "not": { "anyOf": [{ "pattern": "://" }, { "pattern": "^/" }] }
    },
    "surface_token": {
      "enum": [
        "effective_policy_view",
        "policy_diff",
        "decision_history_timeline",
        "locked_state_explanation",
        "retention_deletion_matrix",
        "offboarding_wizard",
        "procurement_verification_packet",
        "endpoint_posture_card"
      ]
    },
    "path_token": {
      "enum": [
        "local_individual",
        "managed_cloud",
        "self_hosted",
        "sovereign_air_gapped",
        "mirrored_offline",
        "imported_snapshot"
      ]
    },
    "state_token": {
      "enum": [
        "active_enforced",
        "locked_by_policy",
        "inherited_default",
        "overridden_local",
        "unconfirmed_stale",
        "pending_managed_sync",
        "signature_unverified",
        "delete_pending",
        "delete_blocked_by_hold",
        "delete_receipted",
        "export_available_now",
        "export_deferred",
        "mirror_offline_last_known",
        "boundary_changed_recheck_required",
        "imported_snapshot_no_live",
        "unknown_requires_review"
      ]
    },
    "deployment_profile_class": {
      "enum": [
        "individual_local",
        "self_hosted",
        "enterprise_online",
        "sovereign_air_gapped",
        "managed_cloud"
      ]
    },
    "redaction_class": {
      "enum": [
        "metadata_safe_default",
        "admin_only_restricted",
        "internal_support_restricted",
        "signing_evidence_only",
        "compliance_restricted"
      ]
    },
    "consumer_class": {
      "enum": [
        "shell_admin_center",
        "cli_headless",
        "help_about",
        "support_export",
        "commercial_procurement",
        "release_evidence",
        "managed_service"
      ]
    },
    "owner_escalation_role": {
      "enum": [
        "local_user",
        "workspace_owner",
        "org_admin",
        "security_owner",
        "compliance_owner",
        "vendor_support"
      ]
    },
    "evidence_age_class": {
      "enum": ["fresh", "recent", "stale", "very_stale", "never"]
    },
    "change_kind_class": {
      "enum": [
        "policy_import",
        "policy_promotion",
        "bundle_rollout",
        "mirror_source_change",
        "trust_root_change",
        "route_egress_expansion"
      ]
    },
    "direction_class": {
      "enum": ["tightening", "widening", "mixed", "no_effect"]
    },
    "widening_dimension_class": {
      "enum": [
        "new_permission",
        "new_egress_class",
        "new_ai_provider",
        "registry_source_change",
        "trust_root_change"
      ]
    },
    "review_requirement_class": {
      "enum": [
        "self_service_local",
        "single_admin_review",
        "dual_control_review",
        "security_compliance_review",
        "blocked_pending_boundary_recheck"
      ]
    },
    "staging_class": {
      "enum": ["immediate_allowed", "staged_ring_required", "pinned_manual_signed_only"]
    },
    "rollback_class": {
      "enum": [
        "instant_local_revert",
        "staged_revert",
        "signed_rollback_bundle",
        "manual_reimport_required"
      ]
    },
    "outcome_class": {
      "enum": [
        "safe_to_promote",
        "promote_with_staged_rollout",
        "hold_for_review",
        "blocked_stale_evidence",
        "blocked_boundary_recheck"
      ]
    },
    "narrow_reason_class": {
      "enum": [
        "simulation_evidence_stale",
        "mirror_freshness_stale",
        "endpoint_posture_stale"
      ]
    },
    "impacted_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_ref", "label", "posture_before", "posture_after", "impact_note"],
      "properties": {
        "endpoint_ref": { "$ref": "#/$defs/safe_token" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "posture_before": { "$ref": "#/$defs/state_token" },
        "posture_after": { "$ref": "#/$defs/state_token" },
        "impact_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "impacted_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_family", "effect_note", "newly_widened"],
      "properties": {
        "feature_family": { "$ref": "#/$defs/non_empty_string" },
        "effect_note": { "$ref": "#/$defs/non_empty_string" },
        "newly_widened": { "type": "boolean" }
      }
    },
    "rollout_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "change_kind",
        "title",
        "summary",
        "direction",
        "widening_dimensions",
        "impacted_endpoints",
        "impacted_features",
        "review_requirement",
        "staging",
        "rollback",
        "simulation_freshness",
        "outcome",
        "owner",
        "redaction",
        "review_note",
        "dry_run"
      ],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/safe_token" },
        "change_kind": { "$ref": "#/$defs/change_kind_class" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "direction": { "$ref": "#/$defs/direction_class" },
        "widening_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/widening_dimension_class" }
        },
        "impacted_endpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/impacted_endpoint" }
        },
        "impacted_features": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/impacted_feature" }
        },
        "review_requirement": { "$ref": "#/$defs/review_requirement_class" },
        "staging": { "$ref": "#/$defs/staging_class" },
        "rollback": { "$ref": "#/$defs/rollback_class" },
        "simulation_freshness": { "$ref": "#/$defs/evidence_age_class" },
        "outcome": { "$ref": "#/$defs/outcome_class" },
        "owner": { "$ref": "#/$defs/owner_escalation_role" },
        "escalation_owner": { "$ref": "#/$defs/owner_escalation_role" },
        "redaction": { "$ref": "#/$defs/redaction_class" },
        "review_note": { "$ref": "#/$defs/non_empty_string" },
        "dry_run": { "const": true }
      }
    },
    "simulation_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profile_id",
        "deployment_profile",
        "summary",
        "consumers",
        "bound_surfaces",
        "scenarios",
        "mirror_backed",
        "mirror_freshness",
        "endpoint_posture_freshness",
        "simulation_freshness",
        "claim_state",
        "narrow_reasons",
        "claim_note"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/path_token" },
        "profile_id": { "$ref": "#/$defs/safe_token" },
        "deployment_profile": { "$ref": "#/$defs/deployment_profile_class" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_class" }
        },
        "bound_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_token" }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rollout_scenario" }
        },
        "mirror_backed": { "type": "boolean" },
        "mirror_freshness": { "$ref": "#/$defs/evidence_age_class" },
        "endpoint_posture_freshness": { "$ref": "#/$defs/evidence_age_class" },
        "simulation_freshness": { "$ref": "#/$defs/evidence_age_class" },
        "claim_state": { "$ref": "#/$defs/state_token" },
        "narrow_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason_class" }
        },
        "claim_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "simulation_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
