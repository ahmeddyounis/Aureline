{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/admin/m5-admin-plane.schema.json",
  "title": "Aureline M5 admin-plane matrix",
  "description": "Boundary schema for the M5 admin-plane matrix: the frozen, typed contract for Aureline's local admin surfaces — the effective-policy view, policy diff, decision-history timeline / audit-event explorer, locked-state explanation, retention/deletion matrix, offboarding wizard, procurement/verification packet, and endpoint-posture card. The matrix names each surface family, cites the canonical boundary schema(s) and producing crate(s) it binds, maps each one to the proof packet that keeps it current, pins one shared state vocabulary, defines the controlled vocabulary spanning policy source state, verification/signature posture, delete/export state, managed-copy versus local-only data residency, and owner/escalation semantics, and covers the local-individual, managed-cloud, self-hosted, sovereign/air-gapped, mirrored/offline, and imported-snapshot admin paths. Stable surface ids, path ids, state tokens, ownership fields, freshness rules, redaction classes, local-versus-shared scope, and live-versus-snapshot labels are defined once and reused by shell admin center, CLI/headless, Help/About, support export, commercial/procurement, release-evidence, and managed-service consumers. No endpoint URLs, hostnames, credentials, raw provider payloads, or absolute paths cross this boundary; the record carries opaque object refs, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_admin_plane_schema_version",
    "schema_ref",
    "matrix_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "shared_vocabulary",
    "state_vocabulary",
    "surfaces",
    "admin_paths",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_admin_plane_matrix" },
    "m5_admin_plane_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/admin/m5-admin-plane.schema.json" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "shared_vocabulary": { "$ref": "#/$defs/shared_vocabulary" },
    "state_vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state_term" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/admin_surface_entry" }
    },
    "admin_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/admin_path_entry" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matrix_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "surface_token": {
      "enum": [
        "effective_policy_view",
        "policy_diff",
        "decision_history_timeline",
        "locked_state_explanation",
        "retention_deletion_matrix",
        "offboarding_wizard",
        "procurement_verification_packet",
        "endpoint_posture_card"
      ]
    },
    "state_token": {
      "enum": [
        "active_enforced",
        "locked_by_policy",
        "inherited_default",
        "overridden_local",
        "unconfirmed_stale",
        "pending_managed_sync",
        "signature_unverified",
        "delete_pending",
        "delete_blocked_by_hold",
        "delete_receipted",
        "export_available_now",
        "export_deferred",
        "mirror_offline_last_known",
        "boundary_changed_recheck_required",
        "imported_snapshot_no_live",
        "unknown_requires_review"
      ]
    },
    "path_token": {
      "enum": [
        "local_individual",
        "managed_cloud",
        "self_hosted",
        "sovereign_air_gapped",
        "mirrored_offline",
        "imported_snapshot"
      ]
    },
    "controlled_vocabulary_token": {
      "enum": [
        "policy_source_state",
        "verification_signature_posture",
        "delete_export_state",
        "data_residency_class",
        "owner_escalation"
      ]
    },
    "deployment_profile_class": {
      "enum": [
        "individual_local",
        "self_hosted",
        "enterprise_online",
        "sovereign_air_gapped",
        "managed_cloud"
      ]
    },
    "redaction_class": {
      "enum": [
        "metadata_safe_default",
        "admin_only_restricted",
        "internal_support_restricted",
        "signing_evidence_only",
        "compliance_restricted"
      ]
    },
    "scope_class": {
      "enum": ["local_private", "shared_workspace", "managed_org"]
    },
    "live_snapshot_class": {
      "enum": ["live_only", "snapshot_capable", "snapshot_only"]
    },
    "consumer_class": {
      "enum": [
        "shell_admin_center",
        "cli_headless",
        "help_about",
        "support_export",
        "commercial_procurement",
        "release_evidence",
        "managed_service"
      ]
    },
    "write_posture_class": {
      "enum": [
        "writes_live",
        "publish_later_queued",
        "local_draft_preserved",
        "read_only_replay",
        "blocked_pending_boundary_recheck"
      ]
    },
    "token_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "label"],
      "properties": {
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "shared_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_profiles",
        "redaction_classes",
        "policy_source_states",
        "verification_postures",
        "delete_export_states",
        "data_residency_classes",
        "owner_escalation_roles",
        "scope_classes",
        "live_snapshot_classes",
        "consumer_classes",
        "boundary_axes",
        "source_schema_refs"
      ],
      "properties": {
        "deployment_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "redaction_classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "policy_source_states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "verification_postures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "delete_export_states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "data_residency_classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "owner_escalation_roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "scope_classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "live_snapshot_classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "consumer_classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "boundary_axes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token_def" } },
        "source_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        }
      }
    },
    "state_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "token", "label", "blocking_default", "stale_downgrade", "derived_from_refs"],
      "properties": {
        "state": { "$ref": "#/$defs/state_token" },
        "token": { "$ref": "#/$defs/state_token" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "blocking_default": { "type": "boolean" },
        "stale_downgrade": { "type": "boolean" },
        "derived_from_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        }
      }
    },
    "ownership_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "label", "required"],
      "properties": {
        "field_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "required": { "type": "boolean" }
      }
    },
    "freshness_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age_tokens", "downgrades_green", "rule"],
      "properties": {
        "age_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "downgrades_green": { "type": "boolean" },
        "rule": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "admin_surface_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "surface_id",
        "label",
        "summary",
        "canonical_schema_refs",
        "produced_by_refs",
        "proof_packet_ref",
        "consumed_by",
        "applicable_states",
        "controlled_vocabularies",
        "ownership_fields",
        "freshness_rule",
        "default_redaction",
        "scope",
        "live_vs_snapshot",
        "captures_user_writes",
        "local_safe_actions",
        "publish_later_capture",
        "locally_explainable",
        "boundary_note",
        "typed_not_portal_only"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/surface_token" },
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "canonical_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "produced_by_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "consumed_by": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_class" }
        },
        "applicable_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_token" }
        },
        "controlled_vocabularies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/controlled_vocabulary_token" }
        },
        "ownership_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ownership_field" }
        },
        "freshness_rule": { "$ref": "#/$defs/freshness_rule" },
        "default_redaction": { "$ref": "#/$defs/redaction_class" },
        "scope": { "$ref": "#/$defs/scope_class" },
        "live_vs_snapshot": { "$ref": "#/$defs/live_snapshot_class" },
        "captures_user_writes": { "type": "boolean" },
        "local_safe_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "publish_later_capture": { "type": "boolean" },
        "locally_explainable": { "type": "boolean" },
        "boundary_note": { "$ref": "#/$defs/non_empty_string" },
        "typed_not_portal_only": { "type": "boolean" }
      }
    },
    "admin_path_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "path_id",
        "label",
        "summary",
        "deployment_profiles",
        "default_live_vs_snapshot",
        "write_posture",
        "boundary_recheck_required",
        "local_safe_baseline_ref",
        "notes"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path_token" },
        "path_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_profile_class" }
        },
        "default_live_vs_snapshot": { "$ref": "#/$defs/live_snapshot_class" },
        "write_posture": { "$ref": "#/$defs/write_posture_class" },
        "boundary_recheck_required": { "type": "boolean" },
        "local_safe_baseline_ref": { "$ref": "#/$defs/repo_ref" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "matrix_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
