{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/admin/m5-admin-certification.schema.json",
  "title": "Aureline M5 admin-certification bundle",
  "description": "Boundary schema for the M5 admin-certification bundle: the qualification capstone that binds the local admin plane's effective-policy, decision-history, endpoint-posture, retention/deletion, offboarding, and procurement/admin-packet truth into M5 promotion. Each certified family cites the upstream proof lane that already produces it (its boundary schema, worked fixture, and freeze gate) and reads that lane's freshness and pass/fail result into a single per-profile qualification row across the managed-cloud, self-hosted, sovereign/air-gapped, and mirrored/offline profiles. A family qualifies only when its proof is bound, fresh, and passing; the moment the proof is stale, failing, or unproven the row narrows off qualified and names why, and the profile's managed claim auto-narrows off confirmed. Each family binds back to the frozen admin-plane matrix (schemas/admin/m5-admin-plane.schema.json): every surface it certifies is one the matrix declares, and every claim state is one the matrix's unified vocabulary defines. The bundle publishes an explicit release-evidence row for each named dimension — policy source/verification, audit history, delete/export honesty, offboarding continuity, and procurement/support/admin-packet fidelity — each reflecting the worst qualification across all profiles. There is exactly one typed packet per profile, consumed identically by the shell admin center, CLI/headless inspect, Help/About, support export, commercial/procurement, and release evidence. No endpoint URLs, hostnames, credentials, raw provider payloads, or absolute paths cross this boundary; the record carries opaque object refs, stable tokens, rendered metadata-safe value summaries, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_admin_certification_schema_version",
    "schema_ref",
    "bundle_id",
    "as_of",
    "matrix_ref",
    "matrix_id",
    "freeze_gate_ref",
    "summary",
    "profiles",
    "release_evidence",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_admin_certification_bundle" },
    "m5_admin_certification_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/admin/m5-admin-certification.schema.json" },
    "bundle_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "matrix_ref": { "$ref": "#/$defs/repo_ref" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certification_packet" }
    },
    "release_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release_evidence_row" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certification_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "safe_token": {
      "type": "string",
      "minLength": 1,
      "description": "An opaque stable token with no URL scheme or absolute path.",
      "not": { "anyOf": [{ "pattern": "://" }, { "pattern": "^/" }] }
    },
    "surface_token": {
      "enum": [
        "effective_policy_view",
        "policy_diff",
        "decision_history_timeline",
        "locked_state_explanation",
        "retention_deletion_matrix",
        "offboarding_wizard",
        "procurement_verification_packet",
        "endpoint_posture_card"
      ]
    },
    "path_token": {
      "enum": [
        "local_individual",
        "managed_cloud",
        "self_hosted",
        "sovereign_air_gapped",
        "mirrored_offline",
        "imported_snapshot"
      ]
    },
    "state_token": {
      "enum": [
        "active_enforced",
        "locked_by_policy",
        "inherited_default",
        "overridden_local",
        "unconfirmed_stale",
        "pending_managed_sync",
        "signature_unverified",
        "delete_pending",
        "delete_blocked_by_hold",
        "delete_receipted",
        "export_available_now",
        "export_deferred",
        "mirror_offline_last_known",
        "boundary_changed_recheck_required",
        "imported_snapshot_no_live",
        "unknown_requires_review"
      ]
    },
    "deployment_profile_class": {
      "enum": [
        "individual_local",
        "self_hosted",
        "enterprise_online",
        "sovereign_air_gapped",
        "managed_cloud"
      ]
    },
    "redaction_class": {
      "enum": [
        "metadata_safe_default",
        "admin_only_restricted",
        "internal_support_restricted",
        "signing_evidence_only",
        "compliance_restricted"
      ]
    },
    "consumer_class": {
      "enum": [
        "shell_admin_center",
        "cli_headless",
        "help_about",
        "support_export",
        "commercial_procurement",
        "release_evidence",
        "managed_service"
      ]
    },
    "owner_escalation_role": {
      "enum": [
        "local_user",
        "workspace_owner",
        "org_admin",
        "security_owner",
        "compliance_owner",
        "vendor_support"
      ]
    },
    "evidence_age_class": {
      "enum": ["fresh", "recent", "stale", "very_stale", "never"]
    },
    "family_token": {
      "enum": [
        "policy_explainability",
        "decision_history",
        "endpoint_posture",
        "retention_delete",
        "offboarding",
        "procurement_admin_packet"
      ]
    },
    "qualification_class": {
      "enum": [
        "qualified",
        "narrowed_stale_evidence",
        "narrowed_failing_proof",
        "narrowed_unproven"
      ]
    },
    "narrow_reason_class": {
      "enum": [
        "family_evidence_stale",
        "mirror_evidence_stale",
        "family_proof_failing",
        "family_proof_missing"
      ]
    },
    "release_dimension_class": {
      "enum": [
        "policy_source_verification",
        "audit_history",
        "delete_export_honesty",
        "offboarding_continuity",
        "procurement_support_admin_packet"
      ]
    },
    "proof_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "record_kind",
        "schema_ref",
        "fixture_ref",
        "freeze_gate_ref",
        "doc_ref",
        "produced_by_ref"
      ],
      "properties": {
        "lane_id": { "$ref": "#/$defs/safe_token" },
        "record_kind": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/repo_ref" },
        "fixture_ref": { "$ref": "#/$defs/repo_ref" },
        "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
        "doc_ref": { "$ref": "#/$defs/repo_ref" },
        "produced_by_ref": { "$ref": "#/$defs/repo_ref" }
      }
    },
    "family_qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "row_id",
        "label",
        "summary",
        "bound_surfaces",
        "proof_lane",
        "claimed",
        "mirror_backed",
        "proof_freshness",
        "proof_failing",
        "qualification",
        "claim_state",
        "owner",
        "escalation_owner",
        "locally_explainable",
        "redaction",
        "evidence_note"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/family_token" },
        "row_id": { "$ref": "#/$defs/safe_token" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "bound_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_token" }
        },
        "proof_lane": { "$ref": "#/$defs/proof_lane" },
        "claimed": { "type": "boolean" },
        "mirror_backed": { "type": "boolean" },
        "proof_freshness": { "$ref": "#/$defs/evidence_age_class" },
        "proof_failing": { "type": "boolean" },
        "qualification": { "$ref": "#/$defs/qualification_class" },
        "claim_state": { "$ref": "#/$defs/state_token" },
        "narrow_reason": { "$ref": "#/$defs/narrow_reason_class" },
        "owner": { "$ref": "#/$defs/owner_escalation_role" },
        "escalation_owner": { "$ref": "#/$defs/owner_escalation_role" },
        "locally_explainable": { "const": true },
        "redaction": { "$ref": "#/$defs/redaction_class" },
        "evidence_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "certification_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profile_id",
        "deployment_profile",
        "summary",
        "consumers",
        "families",
        "proof_freshness",
        "claim_state",
        "narrow_reasons",
        "claim_note"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/path_token" },
        "profile_id": { "$ref": "#/$defs/safe_token" },
        "deployment_profile": { "$ref": "#/$defs/deployment_profile_class" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_class" }
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/family_qualification_row" }
        },
        "proof_freshness": { "$ref": "#/$defs/evidence_age_class" },
        "claim_state": { "$ref": "#/$defs/state_token" },
        "narrow_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason_class" }
        },
        "claim_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "release_evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "row_id",
        "label",
        "statement",
        "families",
        "worst_qualification",
        "claim_state",
        "note"
      ],
      "properties": {
        "dimension": { "$ref": "#/$defs/release_dimension_class" },
        "row_id": { "$ref": "#/$defs/safe_token" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/family_token" }
        },
        "worst_qualification": { "$ref": "#/$defs/qualification_class" },
        "claim_state": { "$ref": "#/$defs/state_token" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "certification_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
