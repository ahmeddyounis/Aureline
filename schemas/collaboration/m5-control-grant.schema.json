{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-control-grant.schema.json",
  "title": "Aureline M5 control grant",
  "description": "Canonical per-domain descriptor for one explicit grant of terminal / debug write control. Names the granted authority, the single active driver, the grant scope and expiry, and the revoke / reclaim path so control is never acquired from presence or follow alone and never more than one active driver holds a sensitive surface. Raw secrets and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "collaboration_control_association",
    "control_authority_source",
    "active_driver",
    "session_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "control_grant"
      ]
    },
    "collaboration_control_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "control_authority_source": {
      "$ref": "#/$defs/control_authority_source"
    },
    "active_driver": {
      "$ref": "#/$defs/non_empty_string"
    },
    "grant_scope_and_expiry": {
      "type": "object"
    },
    "revoke_and_reclaim_path": {
      "$ref": "#/$defs/non_empty_string"
    },
    "session_state": {
      "$ref": "#/$defs/session_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "control_authority_source": {
      "enum": [
        "granted_by_explicit_control_grant",
        "delegated_by_presenter_token",
        "inferred_from_presence_or_follow",
        "expired_or_revoked_grant"
      ]
    },
    "session_state": {
      "enum": [
        "viewer",
        "commenter",
        "editor",
        "driver",
        "navigator",
        "presenter_moderator",
        "live_only",
        "metadata_audit",
        "replayable_text_comment_timeline",
        "elevated_support_evidence",
        "control_requested",
        "control_granted",
        "control_expired",
        "recording_active",
        "consent_renewal_required",
        "restore_view_only"
      ]
    }
  }
}
