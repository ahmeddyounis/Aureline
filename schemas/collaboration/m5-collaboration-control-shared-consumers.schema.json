{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-control-shared-consumers.schema.json",
  "title": "M5 Collaboration-Control Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the six B155 collaboration-control objects (shared terminal / debug view, control grant, presenter token, consent envelope, retention review, session-restore view) to the shared-terminal-debug-view / collaboration-join-review-sheet / control-grant-prompt / presenter-handoff-sheet / paste-secret-guard / collaboration-retention-sheet / session-restore-view / support-export / help-docs consumers that render them, proving one shared collaboration-control vocabulary across the desktop-collaboration, browser / mobile companion, incident / support, audit-export, and help / docs surfaces and enforcing that no surface acquires terminal / debug control from presence without an explicit grant, allows more than one active driver on a sensitive surface, starts recording / retention / guest-scope widening silently, replays prior input on join or restore, or reveals raw secrets, command text, variable bodies, or clipboard contents without a guard, and that no deferred-intent or outbox system silently queues a control grant, presenter handoff, or terminal input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_collaboration_control_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "collaboration_control_object": {
      "type": "string",
      "enum": [
        "shared_terminal_debug_view",
        "control_grant",
        "presenter_token",
        "consent_envelope",
        "retention_review",
        "session_restore_view"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shared_terminal_debug_view",
        "collaboration_join_review_sheet",
        "control_grant_prompt",
        "presenter_handoff_sheet",
        "paste_secret_guard",
        "collaboration_retention_sheet",
        "session_restore_view",
        "support_export_packet",
        "help_docs"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "vocabulary_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "collaboration_control_vocabulary_drift_detected",
        "authority_source_or_session_state_disclosure_dropped",
        "acquires_terminal_or_debug_control_from_presence_without_an_explicit_grant",
        "allows_more_than_one_active_driver_on_a_sensitive_surface",
        "starts_recording_retention_or_guest_scope_widening_silently",
        "replays_prior_terminal_or_debug_input_on_join_or_restore",
        "reveals_raw_secrets_command_text_variable_bodies_or_clipboard_contents_without_a_guard",
        "deferred_intent_queued_a_sensitive_control_action_without_a_fresh_live_review",
        "canonical_registry_reference_missing",
        "upstream_collaboration_control_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collaboration_control_role_word",
        "object_word",
        "registry_reference_word",
        "session_state_word",
        "surface_context_word",
        "authority_source_word"
      ],
      "properties": {
        "collaboration_control_role_word": {
          "type": "string",
          "enum": [
            "control_authority_disclosure",
            "active_driver_disclosure",
            "view_first_default_disclosure",
            "consent_scope_disclosure",
            "recording_retention_state_disclosure",
            "paste_secret_guard_disclosure",
            "replay_free_restore_disclosure"
          ]
        },
        "object_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "session_state_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "authority_source_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "subject_id",
        "subject_label",
        "object",
        "consumer",
        "representation",
        "state_facets",
        "vocabulary_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "acquires_terminal_or_debug_control_from_presence_without_an_explicit_grant",
        "allows_more_than_one_active_driver_on_a_sensitive_surface",
        "starts_recording_retention_or_guest_scope_widening_silently",
        "replays_prior_terminal_or_debug_input_on_join_or_restore",
        "reveals_raw_secrets_command_text_variable_bodies_or_clipboard_contents_without_a_guard",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "subject_label": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/collaboration_control_object" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "vocabulary_state": { "$ref": "#/$defs/vocabulary_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "acquires_terminal_or_debug_control_from_presence_without_an_explicit_grant": {
          "type": "boolean",
          "const": false
        },
        "allows_more_than_one_active_driver_on_a_sensitive_surface": {
          "type": "boolean",
          "const": false
        },
        "starts_recording_retention_or_guest_scope_widening_silently": {
          "type": "boolean",
          "const": false
        },
        "replays_prior_terminal_or_debug_input_on_join_or_restore": {
          "type": "boolean",
          "const": false
        },
        "reveals_raw_secrets_command_text_variable_bodies_or_clipboard_contents_without_a_guard": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "vocabulary_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "vocabulary_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_reuse_proven_by_fixtures",
        "same_subject_same_collaboration_control_vocabulary_across_surfaces",
        "collaboration_control_role_words_stay_in_frozen_vocabulary",
        "gate_roles_never_let_presence_read_as_control_authority",
        "never_more_than_one_active_driver_on_a_sensitive_surface",
        "recording_retention_and_guest_scope_never_widened_silently",
        "prior_terminal_debug_input_never_replayed_on_join_or_restore",
        "raw_secrets_command_text_and_clipboard_never_revealed_without_a_guard",
        "deferred_intent_never_queues_control_grants_presenter_handoffs_or_terminal_input",
        "refused_control_actions_explain_instead_of_replaying_as_idempotent_background_writes",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "copy_export_open_provider_preserve_one_payload",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "object_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_subject_same_collaboration_control_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "collaboration_control_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "gate_roles_never_let_presence_read_as_control_authority": {
          "type": "boolean",
          "const": true
        },
        "never_more_than_one_active_driver_on_a_sensitive_surface": {
          "type": "boolean",
          "const": true
        },
        "recording_retention_and_guest_scope_never_widened_silently": {
          "type": "boolean",
          "const": true
        },
        "prior_terminal_debug_input_never_replayed_on_join_or_restore": {
          "type": "boolean",
          "const": true
        },
        "raw_secrets_command_text_and_clipboard_never_revealed_without_a_guard": {
          "type": "boolean",
          "const": true
        },
        "deferred_intent_never_queues_control_grants_presenter_handoffs_or_terminal_input": {
          "type": "boolean",
          "const": true
        },
        "refused_control_actions_explain_instead_of_replaying_as_idempotent_background_writes": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "copy_export_open_provider_preserve_one_payload": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared_terminal_debug_view_consumes_shared_collaboration_control_vocabulary",
        "collaboration_join_review_sheet_consumes_shared_collaboration_control_vocabulary",
        "control_grant_prompt_consumes_shared_collaboration_control_vocabulary",
        "presenter_handoff_sheet_consumes_shared_collaboration_control_vocabulary",
        "paste_secret_guard_consumes_shared_collaboration_control_vocabulary",
        "collaboration_retention_sheet_consumes_shared_collaboration_control_vocabulary",
        "session_restore_view_consumes_shared_collaboration_control_vocabulary",
        "support_export_packet_consumes_shared_collaboration_control_vocabulary",
        "help_docs_consumes_shared_collaboration_control_vocabulary",
        "every_object_adopted_by_two_or_more_consumers",
        "collaboration_control_vocabulary_identical_for_same_subject",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_collaboration_control_object",
        "deferred_intent_and_outbox_systems_blocked_from_queueing_sensitive_control_actions"
      ],
      "properties": {
        "shared_terminal_debug_view_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "collaboration_join_review_sheet_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "control_grant_prompt_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "presenter_handoff_sheet_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "paste_secret_guard_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "collaboration_retention_sheet_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "session_restore_view_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "support_export_packet_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "help_docs_consumes_shared_collaboration_control_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "every_object_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "collaboration_control_vocabulary_identical_for_same_subject": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_collaboration_control_object": {
          "type": "boolean",
          "const": true
        },
        "deferred_intent_and_outbox_systems_blocked_from_queueing_sensitive_control_actions": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
