{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-session-compaction-manifest.schema.json",
  "title": "Aureline M5 session compaction manifest (sealed session archive)",
  "description": "Canonical per-domain descriptor for one sealed session archive and its bounded compaction lineage. Names the archive identity, its authority model, its convergence state, the bounded compaction lineage it descended from, its retention and export posture, its actor lineage, and its policy-labeled redaction so no op-log, snapshot, or archive is ever exported without policy-labeled redaction and actor lineage. Raw snapshots and unredacted archive contents never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "archive_id",
    "object_class",
    "authority_model",
    "convergence_state",
    "policy_labeled_redaction",
    "actor_lineage"
  ],
  "properties": {
    "archive_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "sealed_session_archive"
      ]
    },
    "authority_model": {
      "$ref": "#/$defs/authority_model"
    },
    "convergence_state": {
      "$ref": "#/$defs/convergence_state"
    },
    "compaction_lineage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "retention_and_export_posture": {
      "$ref": "#/$defs/non_empty_string"
    },
    "policy_labeled_redaction": {
      "type": "boolean"
    },
    "actor_lineage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "authority_model": {
      "enum": [
        "crdt_convergent_replica",
        "server_ordered_sequence",
        "host_authoritative_state",
        "local_canonical_never_replaced"
      ]
    },
    "convergence_state": {
      "enum": [
        "converged",
        "converging_pending_ops",
        "server_ordered",
        "host_authoritative",
        "locally_pending_unsent",
        "convergence_degraded",
        "awareness_degraded",
        "anchor_unresolved",
        "anchor_rebound_append_only",
        "relay_partitioned",
        "reconciliation_required",
        "compaction_pending",
        "sealed_archived",
        "local_canonical_preserved",
        "sampled_presence_only",
        "provenance_stale"
      ]
    }
  }
}
