{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-state-surface-certification.schema.json",
  "title": "Aureline M5 collaboration-state surface certification packet",
  "description": "M05-1323 closing B156 capstone certifying that the frozen M5 collaboration-state shared-object classes (CRDT-backed shared text, sampled presence / cursors / selections, server-ordered comments / annotations / review pins, presenter / follow state, higher-risk control plane, sealed session archive) hold their collaboration-state authority, convergence, anchor-drift, compaction, and degradation truth on every claimed M5 desktop, browser-companion, review, incident / support, and audit / export surface. Keyed on the claimed consumer profile (fully-certified collaboration-state lane, reviewable collaboration-state record structure, unproven-authority-model profile, unconfirmed-convergence-state profile, unpreserved-local-truth profile, unresolved-anchor-drift profile, undisclosed-export-posture profile, unproven-provenance-freshness profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and collaboration-state-truth behavior — and either passes (green), auto-narrows its collaboration-state claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a fully-certified collaboration-state lane whose authority model, local-truth preservation, merge / drift semantics, downgrade behavior, anchor-drift history, export posture, and session provenance / freshness all converge on one export-safe, provider-authoritative, internally consistent record may certify a certified collaboration-state record; and every B156 hard invariant must hold (a collaboration replica never overwrites the canonical local buffer, VFS, or Git truth; unsent local edits are never discarded on a permission downgrade, relay failure, or leave-session flow; a comment, annotation, or review pin is never silently rebound without append-only drift history; a convergence-degraded, awareness-degraded, or anchor-unresolved state is never collapsed into a generic stale badge; and an op-log, snapshot, or archive is never exported without policy-labeled redaction and actor lineage). Every row cites exactly one canonical collaboration-state convergence matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_collaboration_state_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-collaboration-convergence-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "certified_collaboration_state_lane",
        "reviewable_collaboration_state_record_structure",
        "unproven_authority_model_profile",
        "unconfirmed_convergence_state_profile",
        "unpreserved_local_truth_profile",
        "unresolved_anchor_drift_profile",
        "undisclosed_export_posture_profile",
        "unproven_provenance_freshness_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "collaboration_state_truth"
      ]
    },
    "collaboration_state_claim": {
      "enum": [
        "certified_collaboration_state_truth",
        "reviewable_collaboration_state_record",
        "authority_model_unverified_projection",
        "convergence_state_unverified_projection",
        "local_truth_preservation_unverified_projection",
        "anchor_drift_unverified_projection",
        "export_posture_unverified_projection",
        "provenance_freshness_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "crdt_backed_shared_text",
        "sampled_presence_cursors_selections",
        "server_ordered_comments_annotations_review_pins",
        "presenter_follow_state",
        "higher_risk_control_plane",
        "sealed_session_archive"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "replica_overwrote_local_canonical_truth",
        "unsent_local_edits_discarded_on_downgrade",
        "comment_or_pin_rebound_without_drift_history",
        "convergence_or_awareness_degraded_collapsed_into_generic_stale",
        "op_log_or_archive_exported_without_redaction_or_lineage",
        "authority_model_unstated",
        "convergence_state_unstated",
        "local_truth_preservation_unstated",
        "anchor_drift_history_unstated",
        "export_posture_unstated",
        "provenance_or_freshness_unstated",
        "collaboration_state_matrix_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replica_overwrote_local_canonical_buffer_vfs_or_git_truth",
        "discarded_unsent_local_edits_on_downgrade_relay_or_leave",
        "silently_rebound_comments_annotations_or_review_pins_without_drift_history",
        "collapsed_convergence_awareness_or_anchor_unresolved_into_generic_stale",
        "exported_op_logs_snapshots_or_archives_without_redaction_or_actor_lineage"
      ],
      "properties": {
        "replica_overwrote_local_canonical_buffer_vfs_or_git_truth": { "const": false },
        "discarded_unsent_local_edits_on_downgrade_relay_or_leave": { "const": false },
        "silently_rebound_comments_annotations_or_review_pins_without_drift_history": { "const": false },
        "collapsed_convergence_awareness_or_anchor_unresolved_into_generic_stale": { "const": false },
        "exported_op_logs_snapshots_or_archives_without_redaction_or_actor_lineage": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/collaboration_state_claim" },
        "to_claim": { "$ref": "#/$defs/collaboration_state_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_collaboration_state_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/collaboration_state_claim" },
        "certified_claim": { "$ref": "#/$defs/collaboration_state_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-collaboration-convergence-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
