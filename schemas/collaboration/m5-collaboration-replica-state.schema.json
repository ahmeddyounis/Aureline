{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-replica-state.schema.json",
  "title": "Aureline M5 collaboration replica state (CRDT-backed shared text)",
  "description": "Canonical per-domain descriptor for one CRDT-backed shared-text replica. Names the replica identity, its authority model, its convergence state, the canonical local buffer / VFS / Git truth it never replaces, its merge semantics, and how unsent local edits are preserved on downgrade. Raw buffer bodies and raw op-log payloads never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "authority_model",
    "convergence_state",
    "local_canonical_truth_preserved"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "crdt_backed_shared_text"
      ]
    },
    "authority_model": {
      "$ref": "#/$defs/authority_model"
    },
    "convergence_state": {
      "$ref": "#/$defs/convergence_state"
    },
    "local_canonical_truth_preserved": {
      "type": "boolean"
    },
    "merge_semantics": {
      "$ref": "#/$defs/non_empty_string"
    },
    "unsent_local_edits_preserved_on_downgrade": {
      "type": "boolean"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "authority_model": {
      "enum": [
        "crdt_convergent_replica",
        "server_ordered_sequence",
        "host_authoritative_state",
        "local_canonical_never_replaced"
      ]
    },
    "convergence_state": {
      "enum": [
        "converged",
        "converging_pending_ops",
        "server_ordered",
        "host_authoritative",
        "locally_pending_unsent",
        "convergence_degraded",
        "awareness_degraded",
        "anchor_unresolved",
        "anchor_rebound_append_only",
        "relay_partitioned",
        "reconciliation_required",
        "compaction_pending",
        "sealed_archived",
        "local_canonical_preserved",
        "sampled_presence_only",
        "provenance_stale"
      ]
    }
  }
}
