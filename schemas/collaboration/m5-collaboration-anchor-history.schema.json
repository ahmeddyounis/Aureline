{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-anchor-history.schema.json",
  "title": "Aureline M5 collaboration anchor history (server-ordered comments / annotations / review pins)",
  "description": "Canonical per-domain descriptor for one server-ordered comment / annotation / review-pin object and its append-only anchor-drift history. Names the object identity, its authority model, its convergence state, the server ordering, and the append-only anchor-drift entries so a rebind is always reviewable and never silent. Raw comment bodies never cross this boundary; only anchor positions, drift entries, and actor lineage.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "authority_model",
    "convergence_state",
    "anchor_drift_history_append_only"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "server_ordered_comments_annotations_review_pins"
      ]
    },
    "authority_model": {
      "$ref": "#/$defs/authority_model"
    },
    "convergence_state": {
      "$ref": "#/$defs/convergence_state"
    },
    "anchor_drift_history_append_only": {
      "type": "boolean"
    },
    "server_ordering_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "anchor_drift_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_position",
          "to_position",
          "actor",
          "at"
        ],
        "properties": {
          "from_position": {
            "$ref": "#/$defs/non_empty_string"
          },
          "to_position": {
            "$ref": "#/$defs/non_empty_string"
          },
          "actor": {
            "$ref": "#/$defs/non_empty_string"
          },
          "at": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "authority_model": {
      "enum": [
        "crdt_convergent_replica",
        "server_ordered_sequence",
        "host_authoritative_state",
        "local_canonical_never_replaced"
      ]
    },
    "convergence_state": {
      "enum": [
        "converged",
        "converging_pending_ops",
        "server_ordered",
        "host_authoritative",
        "locally_pending_unsent",
        "convergence_degraded",
        "awareness_degraded",
        "anchor_unresolved",
        "anchor_rebound_append_only",
        "relay_partitioned",
        "reconciliation_required",
        "compaction_pending",
        "sealed_archived",
        "local_canonical_preserved",
        "sampled_presence_only",
        "provenance_stale"
      ]
    }
  }
}
