{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-control-accessibility-parity.schema.json",
  "title": "Aureline M5 collaboration-control accessibility & auto-narrowing parity",
  "description": "Export-safe packet for the M05-1312 keyboard / screen-reader / high-zoom / high-contrast / CLI / export parity and honest auto-narrowing capstone over the frozen M5 shared terminal / debug control-grant, presenter, consent, retention, and session-restore matrix. Each row certifies one of the six canonical collaboration-control objects (shared_terminal_debug_view, control_grant, presenter_token, consent_envelope, retention_review, session_restore_view) as keyboard-complete, assistive-tech-reachable, high-zoom / high-contrast-safe, CLI/export-safe, and self-narrowing. When a shared terminal / debug view's control authority is unresolved or presence-implied, a control grant's single active driver is unprovable or contended, a presenter token's handoff is unprovable or contested, a consent envelope's join-time scope is undisclosed or would widen silently, a retention review's recording / retention state is stale or would broaden silently, or a session-restore view's replay-free restore safety is unprovable, the object's claim auto-narrows from explicitly_granted_control_surface / view_first_observable_surface to a control-authority-unverified / active-driver-unverified / presenter-handoff-unverified / consent-scope-unverified / retention-state-unverified / restore-replay-safety-unverified projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical object identity / last-known state. Presence never masquerades as control, no second active driver is shown on a sensitive surface, and no prior terminal / debug input is replayed on join or restore. The packet is metadata-only: raw secrets, command text, variable bodies, clipboard contents, and endpoint refs never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_collaboration_control_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 6
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "object": {
      "type": "string",
      "enum": [
        "shared_terminal_debug_view",
        "control_grant",
        "presenter_token",
        "consent_envelope",
        "retention_review",
        "session_restore_view"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "collaboration_control_claim": {
      "type": "string",
      "enum": [
        "explicitly_granted_control_surface",
        "view_first_observable_surface",
        "control_authority_unverified_projection",
        "active_driver_unverified_projection",
        "presenter_handoff_unverified_projection",
        "consent_scope_unverified_projection",
        "retention_state_unverified_projection",
        "restore_replay_safety_unverified_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "control_authority_clarity",
        "active_driver_clarity",
        "presenter_handoff_clarity",
        "consent_scope_clarity",
        "retention_state_clarity",
        "restore_replay_safety_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "fully_qualified",
        "control_authority_unresolved_or_presence_implied",
        "active_driver_unprovable_or_multi_driver",
        "presenter_handoff_unprovable_or_contested",
        "consent_scope_undisclosed_or_widened",
        "retention_state_stale_or_broadened_silently",
        "restore_replay_safety_unprovable"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "control_acquired_without_explicit_grant",
        "more_than_one_active_driver_on_a_sensitive_surface",
        "recording_or_retention_started_silently",
        "prior_input_replayed_on_join_or_restore",
        "raw_secret_or_clipboard_revealed_without_guard",
        "control_authority_unstated",
        "active_driver_unstated",
        "view_first_default_unstated",
        "consent_scope_unstated",
        "retention_state_unstated",
        "restore_replay_safety_unstated",
        "collaboration_control_matrix_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "lifecycle_role",
        "canonical_reference",
        "session_state",
        "control_authority_source",
        "consent_retention_gate"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shared_terminal_debug_view",
        "collaboration_join_review_sheet",
        "control_grant_prompt",
        "presenter_handoff_sheet",
        "paste_secret_guard",
        "collaboration_retention_sheet",
        "session_restore_view",
        "support_export_packet",
        "help_docs"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_truth_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/collaboration_control_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_truth_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "object",
        "source_object_schema_ref",
        "object_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "high_zoom_reach",
        "high_contrast_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_ready_claim",
        "claim_conditions",
        "truth_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_collaboration_control_accessibility_parity_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/object" },
        "source_object_schema_ref": { "type": "string", "minLength": 1 },
        "object_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_zoom_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_contrast_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_ready_claim": { "$ref": "#/$defs/collaboration_control_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "truth_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "object_count",
        "structure_heavy_object_count",
        "all_structure_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_trusted_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_truth_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "object_count": { "type": "integer", "minimum": 0 },
        "structure_heavy_object_count": { "type": "integer", "minimum": 0 },
        "all_structure_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_trusted_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_truth_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
