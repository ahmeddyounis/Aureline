{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-shared-object-descriptor.schema.json",
  "title": "Aureline M5 shared object descriptor (sampled presence / cursors / selections)",
  "description": "Canonical per-domain descriptor for one sampled presence / cursors / selections shared object. Names the object identity, its authority model, its convergence state, the sampling rate, that presence is non-authoritative and never edits the buffer, and the stale-presence expiry. Raw cursor payloads and raw selection contents never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "authority_model",
    "convergence_state",
    "presence_is_non_authoritative"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "sampled_presence_cursors_selections"
      ]
    },
    "authority_model": {
      "$ref": "#/$defs/authority_model"
    },
    "convergence_state": {
      "$ref": "#/$defs/convergence_state"
    },
    "presence_is_non_authoritative": {
      "type": "boolean"
    },
    "sampling_rate_hint": {
      "$ref": "#/$defs/non_empty_string"
    },
    "presence_never_edits_buffer": {
      "type": "boolean"
    },
    "stale_presence_expiry_hint": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "authority_model": {
      "enum": [
        "crdt_convergent_replica",
        "server_ordered_sequence",
        "host_authoritative_state",
        "local_canonical_never_replaced"
      ]
    },
    "convergence_state": {
      "enum": [
        "converged",
        "converging_pending_ops",
        "server_ordered",
        "host_authoritative",
        "locally_pending_unsent",
        "convergence_degraded",
        "awareness_degraded",
        "anchor_unresolved",
        "anchor_rebound_append_only",
        "relay_partitioned",
        "reconciliation_required",
        "compaction_pending",
        "sealed_archived",
        "local_canonical_preserved",
        "sampled_presence_only",
        "provenance_stale"
      ]
    }
  }
}
