{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-convergence-state.schema.json",
  "title": "Aureline M5 collaboration convergence state (presenter / follow state)",
  "description": "Canonical per-domain descriptor for one presenter / follow state and its convergence posture. Names the object identity, its authority model, its convergence state, the current presenter holder, the follow target, that following is view-only, and the presenter-handoff provenance so follow never implies control or convergence. Raw followed-viewport contents never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "authority_model",
    "convergence_state",
    "follow_is_view_only"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "presenter_follow_state"
      ]
    },
    "authority_model": {
      "$ref": "#/$defs/authority_model"
    },
    "convergence_state": {
      "$ref": "#/$defs/convergence_state"
    },
    "follow_is_view_only": {
      "type": "boolean"
    },
    "presenter_holder": {
      "$ref": "#/$defs/non_empty_string"
    },
    "follow_target": {
      "$ref": "#/$defs/non_empty_string"
    },
    "presenter_handoff_provenance": {
      "type": "array"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "authority_model": {
      "enum": [
        "crdt_convergent_replica",
        "server_ordered_sequence",
        "host_authoritative_state",
        "local_canonical_never_replaced"
      ]
    },
    "convergence_state": {
      "enum": [
        "converged",
        "converging_pending_ops",
        "server_ordered",
        "host_authoritative",
        "locally_pending_unsent",
        "convergence_degraded",
        "awareness_degraded",
        "anchor_unresolved",
        "anchor_rebound_append_only",
        "relay_partitioned",
        "reconciliation_required",
        "compaction_pending",
        "sealed_archived",
        "local_canonical_preserved",
        "sampled_presence_only",
        "provenance_stale"
      ]
    }
  }
}
