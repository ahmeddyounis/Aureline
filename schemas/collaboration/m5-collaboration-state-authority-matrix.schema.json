{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-state-authority-matrix.schema.json",
  "title": "Aureline M5 collaboration-replica, shared-object-authority, anchor-drift, convergence-state, and session-archive matrix",
  "description": "Export-safe packet freezing Aureline's collaboration-state model — the CRDT-backed shared text, the sampled presence / cursors / selections, the server-ordered comments / annotations / review pins, the presenter / follow state, the separate higher-risk control plane, and the sealed session archive that a claimed M5 session surface must treat as governed shared-object classes rather than emergent session state. The packet names every covered object class and binds each to its authority model, its convergence state, its merge / drift semantics, its downgrade behavior, its export posture, the claimed surface families that render it, the classification stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain schema, the required visible state (surface label, authority model, convergence state, local-truth disposition, merge / drift summary, export posture, and provenance / freshness), and the mandatory labels it must show (identity, lifecycle_role, canonical_reference, plus authority_model, convergence_state, export_posture). The convergence_state field makes a converged object mechanically distinct from a converging, server-ordered, host-authoritative, locally-pending, convergence-degraded, awareness-degraded, anchor-unresolved, anchor-rebound, relay-partitioned, reconciliation-required, compaction-pending, sealed / archived, local-canonical-preserved, sampled-presence-only, or provenance-stale object. Hard invariants forbid letting a replica overwrite the canonical local buffer, VFS, or Git truth implicitly, discarding unsent local edits on a permission downgrade, relay failure, or leave-session flow, rebinding comments, annotations, or review pins without append-only drift history, collapsing a convergence-degraded or awareness-degraded state into a generic stale or broken badge, and exporting op-logs, snapshots, or archives without policy-labeled redaction and actor lineage. The matrix binds back to the already-frozen collaboration-control component matrix, the stable-proof-index, and the migration-task-row packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "collaboration_state_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_collaboration_replica_shared_object_authority_anchor_drift_convergence_and_session_archive_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "collaboration_state_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/collaboration_state_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "collaboration_state_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "collaboration_state_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "crdt_backed_shared_text",
        "sampled_presence_cursors_selections",
        "server_ordered_comments_annotations_review_pins",
        "presenter_follow_state",
        "higher_risk_control_plane",
        "sealed_session_archive"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "convergence_state": {
      "enum": [
        "converged",
        "converging_pending_ops",
        "server_ordered",
        "host_authoritative",
        "locally_pending_unsent",
        "convergence_degraded",
        "awareness_degraded",
        "anchor_unresolved",
        "anchor_rebound_append_only",
        "relay_partitioned",
        "reconciliation_required",
        "compaction_pending",
        "sealed_archived",
        "local_canonical_preserved",
        "sampled_presence_only",
        "provenance_stale"
      ]
    },
    "semantic_role": {
      "enum": [
        "authority_model_disclosure",
        "local_truth_preservation_disclosure",
        "merge_and_drift_semantics_disclosure",
        "downgrade_behavior_disclosure",
        "anchor_drift_history_disclosure",
        "export_posture_disclosure",
        "provenance_and_freshness_disclosure"
      ]
    },
    "required_visible_state": {
      "type": "object",
      "required": [
        "surface_label",
        "authority_model",
        "convergence_state",
        "local_truth_disposition",
        "merge_and_drift_summary",
        "export_posture",
        "provenance_and_freshness"
      ],
      "properties": {
        "surface_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "authority_model": {
          "$ref": "#/$defs/non_empty_string"
        },
        "convergence_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "local_truth_disposition": {
          "$ref": "#/$defs/non_empty_string"
        },
        "merge_and_drift_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "export_posture": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provenance_and_freshness": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "collaboration_state_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "convergence_state",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "required_visible_state",
        "surface_families",
        "classification_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "lets_a_replica_overwrite_local_buffer_vfs_or_git_truth_implicitly",
        "discards_unsent_local_edits_on_permission_downgrade_relay_failure_or_leave",
        "rebinds_comments_annotations_or_review_pins_without_drift_history",
        "collapses_convergence_or_awareness_degraded_state_into_a_generic_stale_badge",
        "exports_op_logs_snapshots_or_archives_without_policy_labeled_redaction_and_lineage"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "convergence_state": {
          "$ref": "#/$defs/convergence_state"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_visible_state": {
          "$ref": "#/$defs/required_visible_state"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "classification_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "crdt_backed_shared_text_roles": {
          "type": "array"
        },
        "sampled_presence_cursors_selections_roles": {
          "type": "array"
        },
        "server_ordered_comments_annotations_review_pins_roles": {
          "type": "array"
        },
        "presenter_follow_state_roles": {
          "type": "array"
        },
        "higher_risk_control_plane_roles": {
          "type": "array"
        },
        "sealed_session_archive_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "lets_a_replica_overwrite_local_buffer_vfs_or_git_truth_implicitly": {
          "const": false
        },
        "discards_unsent_local_edits_on_permission_downgrade_relay_failure_or_leave": {
          "const": false
        },
        "rebinds_comments_annotations_or_review_pins_without_drift_history": {
          "const": false
        },
        "collapses_convergence_or_awareness_degraded_state_into_a_generic_stale_badge": {
          "const": false
        },
        "exports_op_logs_snapshots_or_archives_without_policy_labeled_redaction_and_lineage": {
          "const": false
        }
      }
    }
  }
}
