{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-state-headless-inspect-and-support-bundle-parity-registries.schema.json",
  "title": "Aureline M5 collaboration-state headless-inspect and support-bundle parity registries",
  "description": "Export-safe packet for the CLI / headless inspect and support-bundle parity lane over the frozen M5 collaboration-state authority matrix (m5_collaboration_replica_shared_object_authority_anchor_drift_convergence_and_session_archive_matrix). It makes collaboration-state truth inspectable outside the live desktop UI — collaboration replica descriptors, shared-object records, anchor history, degraded session states, compaction manifests, and archive-finalization descriptors — by carrying resolved, honest projections of two registries so the claimed M5 shared editor replica view, presence / cursor layer, comment / annotation / review-pin layer, collaboration degradation banner, support / export, and help / docs surfaces inherit one canonical headless-inspect descriptor and one support-bundle export disposition per collaboration-state object rather than leaving convergence, drift, and archive facts as UI-only knowledge. Registry-A resolves the headless-inspect descriptor over each collaboration-state object (its object class — collaboration replica descriptor, shared-object record, anchor-history entry, degraded-session state, compaction manifest, or archive-finalization descriptor — the state class it carries — the convergence / drift / archive facts and the actor / source labels — the authority model those facts imply, and that the CLI / headless projection carries the same state vocabulary the desktop UI shows, each bound to the object so a headless view never reads as a reduced UI-only summary). Registry-B resolves the support-bundle export disposition offered before a collaboration-state fact is emitted into a CLI export or support bundle (include-in-support-bundle, headless-inspect-only, redact-and-export, block-export, or defer — plus its actor / time provenance, its compaction / redaction facts, and its policy-labeled redaction lineage). Each registry row binds a consumer surface to resolved headless-inspect descriptors and resolved support-bundle export dispositions. Hard invariants forbid a clean projection from reading as trustworthy while a headless or support projection drops the state vocabulary the UI shows, an export omits a policy-labeled redaction and actor lineage, a distinct convergence-degraded / awareness-degraded / anchor-unresolved / compaction-lineage class collapses into a generic stale or shareable badge, or a disposition acts without actor / time provenance or drops its redaction lineage. Acceptance criteria (headless and support paths can inspect the same collaboration-state vocabulary the desktop UI shows; and collaboration convergence, drift, and archive facts are no longer UI-only knowledge) are proven by the resolved examples, not merely asserted. Raw secrets, raw command text, variable bodies, clipboard contents, and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_collaboration_state_headless_inspect_and_support_bundle_parity_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "review_pack_record_entry": {
