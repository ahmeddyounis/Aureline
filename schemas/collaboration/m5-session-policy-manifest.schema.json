{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-session-policy-manifest.schema.json",
  "title": "Aureline M5 session-policy manifest / session-restore view",
  "description": "Canonical per-domain descriptor for the frozen session policy manifest governing the replay-free session-restore view. Names the restore posture (reattaches read-only, replays no prior input, preserves retention scope, requires a fresh control grant before write control resumes) so a restored or reattached session never replays prior terminal / debug input and never widens retention. Raw secrets and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "collaboration_control_association",
    "control_authority_source",
    "replay_free_restore",
    "session_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "session_restore_view"
      ]
    },
    "collaboration_control_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "control_authority_source": {
      "$ref": "#/$defs/control_authority_source"
    },
    "replay_free_restore": {
      "type": "boolean"
    },
    "retention_scope_preserved_on_restore": {
      "type": "boolean"
    },
    "reattach_requires_fresh_control_grant": {
      "type": "boolean"
    },
    "session_state": {
      "$ref": "#/$defs/session_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "control_authority_source": {
      "enum": [
        "granted_by_explicit_control_grant",
        "delegated_by_presenter_token",
        "inferred_from_presence_or_follow",
        "expired_or_revoked_grant"
      ]
    },
    "session_state": {
      "enum": [
        "viewer",
        "commenter",
        "editor",
        "driver",
        "navigator",
        "presenter_moderator",
        "live_only",
        "metadata_audit",
        "replayable_text_comment_timeline",
        "elevated_support_evidence",
        "control_requested",
        "control_granted",
        "control_expired",
        "recording_active",
        "consent_renewal_required",
        "restore_view_only"
      ]
    }
  }
}
