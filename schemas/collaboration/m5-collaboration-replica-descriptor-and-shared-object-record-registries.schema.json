{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-replica-descriptor-and-shared-object-record-registries.schema.json",
  "title": "Aureline M5 collaboration-replica-descriptor and shared-object-record registries",
  "description": "Export-safe packet for the collaboration-replica-descriptor and shared-object-record lane over the frozen M5 collaboration-state authority matrix (m5_collaboration_replica_shared_object_authority_anchor_drift_convergence_and_session_archive_matrix). It makes the collaboration replica descriptor and the per-class shared-object record operable by carrying resolved, honest projections of two registries so the claimed M5 shared editor replica view, presence / cursor layer, comment / annotation / review-pin layer, collaboration degradation banner, support / export, and help / docs surfaces inherit one canonical replica descriptor and one declared authority model per shared object rather than a hand-authored parallel prose that has to be kept consistent. Registry-A resolves the collaboration replica descriptor (workspace-root identity, buffer / object identity, revision / session epoch, trust / policy epoch, and export posture, each bound to the local canonical truth it never replaces). Registry-B resolves the per-class shared-object record (which authority model each object holds — CRDT-convergent shared editable text, sampled presence / cursor / selection samples, server-ordered comments / annotations / review pins, presenter / follow state, linked higher-risk control objects, or immutable sealed-archive evidence — plus its convergence and merge-drift posture, its append-only anchor-drift history, and its policy-labeled export lineage). Each registry row binds a consumer surface to resolved replica-descriptor entries and resolved shared-object-record entries. Hard invariants forbid a clean projection from reading as trustworthy while a replica overwrites local buffer / VFS / Git canonical truth, unsent local edits are discarded on a permission or relay downgrade, a comment or pin is rebound without drift history, convergence- or awareness-degraded state is collapsed into a generic stale badge, or an op-log / snapshot / archive is exported without policy-labeled redaction and actor lineage. Acceptance criteria (entering share mode creates explicit collaboration replica records rather than replacing local buffer authority outright; and inspect surfaces can tell which object class is CRDT-convergent, server-ordered, host-authoritative, or immutable evidence) are proven by the resolved examples, not merely asserted. Raw secrets, raw command text, variable bodies, clipboard contents, and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_collaboration_replica_descriptor_and_shared_object_record_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "review_pack_record_entry": {
      "type": "object",
