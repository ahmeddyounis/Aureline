{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-control-surface-certification.schema.json",
  "title": "Aureline M5 collaboration-control surface certification packet",
  "description": "M05-1313 closing B155 capstone certifying that the frozen M5 collaboration-control object classes (shared terminal / debug view, control grant, presenter / moderator token, consent envelope, retention review, session-restore view) hold their collaboration-control truth on every claimed M5 desktop, browser-companion, incident / support, and audit / export surface. Keyed on the claimed consumer profile (fully-certified collaboration-control lane, reviewable collaboration-control record structure, unproven-control-authority profile, inferred-active-driver profile, silently-transferred-presenter profile, undisclosed-consent-scope profile, stale-retention-state profile, unproven-replay-free-restore profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and collaboration-control-truth behavior — and either passes (green), auto-narrows its collaboration-control claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a fully-certified collaboration-control lane whose control authority, single active driver, presenter handoff, join-time consent scope, recording / retention state, and replay-free restore safety all converge on one export-safe, provider-authoritative, internally consistent record may certify a certified collaboration-control record; and every B155 hard invariant must hold (terminal / debug control is never acquired from presence, reconnect, or follow without an explicit grant; more than one active driver is never allowed on a sensitive surface; recording, transcript retention, or guest-scope widening never starts silently; prior terminal / debug input is never replayed on join or restore; and raw secrets, command text, variable bodies, or clipboard contents are never revealed without an explicit consent posture and visible guardrail). Every row cites exactly one canonical collaboration-control matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_collaboration_control_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-collaboration-control-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "certified_collaboration_control_lane",
        "reviewable_collaboration_control_record_structure",
        "unproven_control_authority_profile",
        "inferred_active_driver_profile",
        "silently_transferred_presenter_profile",
        "undisclosed_consent_scope_profile",
        "stale_retention_state_profile",
        "unproven_replay_free_restore_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "collaboration_control_truth"
      ]
    },
    "collaboration_control_claim": {
      "enum": [
        "certified_collaboration_control_truth",
        "reviewable_collaboration_control_record",
        "control_authority_unverified_projection",
        "active_driver_unverified_projection",
        "presenter_handoff_unverified_projection",
        "consent_scope_unverified_projection",
        "retention_state_unverified_projection",
        "restore_replay_safety_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "shared_terminal_debug_view",
        "control_grant",
        "presenter_token",
        "consent_envelope",
        "retention_review",
        "session_restore_view"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "control_acquired_without_explicit_grant",
        "more_than_one_active_driver_on_a_sensitive_surface",
        "recording_or_retention_started_silently",
        "prior_input_replayed_on_join_or_restore",
        "raw_secret_or_clipboard_revealed_without_guard",
        "control_authority_unstated",
        "active_driver_unstated",
        "view_first_default_unstated",
        "consent_scope_unstated",
        "retention_state_unstated",
        "restore_replay_safety_unstated",
        "collaboration_control_matrix_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquires_terminal_or_debug_control_from_presence_or_follow_without_grant",
        "allows_more_than_one_active_driver_on_a_sensitive_surface",
        "starts_recording_retention_or_guest_scope_widening_silently",
        "replays_prior_terminal_or_debug_input_on_join_or_restore",
        "reveals_raw_secrets_or_clipboard_without_an_explicit_consent_and_visible_guard"
      ],
      "properties": {
        "acquires_terminal_or_debug_control_from_presence_or_follow_without_grant": { "const": false },
        "allows_more_than_one_active_driver_on_a_sensitive_surface": { "const": false },
        "starts_recording_retention_or_guest_scope_widening_silently": { "const": false },
        "replays_prior_terminal_or_debug_input_on_join_or_restore": { "const": false },
        "reveals_raw_secrets_or_clipboard_without_an_explicit_consent_and_visible_guard": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/collaboration_control_claim" },
        "to_claim": { "$ref": "#/$defs/collaboration_control_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_collaboration_control_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/collaboration_control_claim" },
        "certified_claim": { "$ref": "#/$defs/collaboration_control_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-collaboration-control-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
