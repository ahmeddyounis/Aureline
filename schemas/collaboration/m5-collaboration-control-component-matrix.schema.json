{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/collaboration/m5-collaboration-control-component-matrix.schema.json",
  "title": "Aureline M5 shared-terminal/debug-view, control-grant, presenter-token, consent-envelope, retention-review, and session-restore-view matrix",
  "description": "Export-safe packet freezing Aureline's explicit collaboration-control model — the shared terminal / debug view, the control grant, the presenter / moderator token, the join-time consent envelope, the recording / retention review, and the replay-free session-restore view a desktop, companion-browser, or support / incident collaboration consumer must treat as first-class, grant-gated, consent-bound objects. The packet names every covered object class and binds each to the claimed surface families that render it, the classification stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain schema, the required visible state (surface label, control authority, active driver, participant roster and roles, session-state summary, consent / retention state, and guard / restore evidence), and the mandatory labels it must show (identity, lifecycle_role, canonical_reference, plus session_state, control_authority_source, consent_retention_gate). The session_state field makes an active driver mechanically distinct from a viewer, commenter, editor, navigator, presenter / moderator, live-only session, metadata-audit view, replayable text / comment timeline, elevated-support-evidence view, and the control-requested / control-granted / control-expired / recording-active / consent-renewal-required / restore-view-only states. Hard invariants forbid acquiring terminal / debug control from presence or follow without an explicit grant, allowing more than one active driver on a sensitive surface, starting recording / transcript retention / replayable archives / guest-scope or route widening silently, replaying prior terminal / debug input on join or restore, and revealing raw secrets, command text, variable bodies, or clipboard contents without a guard and consent posture. The matrix binds back to the already-landed paste / secret guard, stable-proof-index, and migration-task-row packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "collaboration_control_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_shared_terminal_debug_control_grant_presenter_consent_retention_and_session_restore_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "collaboration_control_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/collaboration_control_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "collaboration_control_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "collaboration_control_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "shared_terminal_debug_view",
        "control_grant",
        "presenter_token",
        "consent_envelope",
        "retention_review",
        "session_restore_view"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "session_state": {
      "enum": [
        "viewer",
        "commenter",
        "editor",
        "driver",
        "navigator",
        "presenter_moderator",
        "live_only",
        "metadata_audit",
        "replayable_text_comment_timeline",
        "elevated_support_evidence",
        "control_requested",
        "control_granted",
        "control_expired",
        "recording_active",
        "consent_renewal_required",
        "restore_view_only"
      ]
    },
    "semantic_role": {
      "enum": [
        "control_authority_disclosure",
        "active_driver_disclosure",
        "view_first_default_disclosure",
        "consent_scope_disclosure",
        "recording_retention_state_disclosure",
        "paste_secret_guard_disclosure",
        "replay_free_restore_disclosure"
      ]
    },
    "required_visible_state": {
      "type": "object",
      "required": [
        "surface_label",
        "control_authority",
        "active_driver",
        "participant_roster_and_roles",
        "session_state_summary",
        "consent_and_retention_state",
        "guard_and_restore_evidence"
      ],
      "properties": {
        "surface_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "control_authority": {
          "$ref": "#/$defs/non_empty_string"
        },
        "active_driver": {
          "$ref": "#/$defs/non_empty_string"
        },
        "participant_roster_and_roles": {
          "$ref": "#/$defs/non_empty_string"
        },
        "session_state_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "consent_and_retention_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "guard_and_restore_evidence": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "collaboration_control_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "session_state",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "required_visible_state",
        "surface_families",
        "classification_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "acquires_control_from_presence_or_follow_without_an_explicit_grant",
        "allows_more_than_one_active_driver_on_a_sensitive_surface",
        "starts_recording_transcript_retention_or_guest_scope_widening_silently",
        "replays_prior_terminal_or_debug_input_on_join_or_restore",
        "reveals_raw_secrets_command_text_or_clipboard_without_a_guard_and_consent_posture"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "session_state": {
          "$ref": "#/$defs/session_state"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_visible_state": {
          "$ref": "#/$defs/required_visible_state"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "classification_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "shared_terminal_debug_view_roles": {
          "type": "array"
        },
        "control_grant_roles": {
          "type": "array"
        },
        "presenter_token_roles": {
          "type": "array"
        },
        "consent_envelope_roles": {
          "type": "array"
        },
        "retention_review_roles": {
          "type": "array"
        },
        "session_restore_view_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "acquires_control_from_presence_or_follow_without_an_explicit_grant": {
          "const": false
        },
        "allows_more_than_one_active_driver_on_a_sensitive_surface": {
          "const": false
        },
        "starts_recording_transcript_retention_or_guest_scope_widening_silently": {
          "const": false
        },
        "replays_prior_terminal_or_debug_input_on_join_or_restore": {
          "const": false
        },
        "reveals_raw_secrets_command_text_or_clipboard_without_a_guard_and_consent_posture": {
          "const": false
        }
      }
    }
  }
}
