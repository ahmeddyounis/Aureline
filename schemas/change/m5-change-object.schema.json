{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/change/m5-change-object.schema.json",
  "title": "Aureline M5 change object",
  "description": "Canonical per-domain descriptor for one explicit change object: the durable object a non-trivial multi-file change binds to. Names the object class, its change-orchestration association, the selected worktree / base identity, whether it is a working-set patch or a side-branch work unit, its stack membership, and its validation freshness so ambient branch state is never treated as a reviewed change and no worktree is mutated without an explicit selected change object and binding. Raw paths, raw provider payloads, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "change_orchestration_association",
    "selected_worktree_base_identity",
    "change_object_kind",
    "landing_state",
    "validation_freshness"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "change_object"
      ]
    },
    "change_orchestration_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "selected_worktree_base_identity": {
      "type": "string",
      "minLength": 1
    },
    "change_object_kind": {
      "enum": [
        "working_set_patch",
        "side_branch_work_unit"
      ]
    },
    "stack_membership_source": {
      "enum": [
        "declared_in_change_object",
        "declared_locally",
        "inferred_from_branch_name",
        "stale_or_broken_membership"
      ]
    },
    "landing_state": {
      "enum": [
        "selected_change",
        "stale_validation",
        "restack_required",
        "queue_eligible",
        "queue_blocked",
        "protected_branch_blocked",
        "orphaned",
        "abandoned",
        "exported",
        "imported_reopened"
      ]
    },
    "validation_freshness": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
