{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/change/m5-portable-shelf.schema.json",
  "title": "Aureline M5 portable shelf / bundle",
  "description": "Canonical per-domain descriptor for a portable shelf / bundle. Names the export bundle contents, the import / reopen lineage, the shelf state (exported, imported, reopened), and the recovery checkpoint so a change object survives export / import / reopen and shelf contents are never dropped on an export failure. Raw paths, raw provider payloads, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "change_orchestration_association",
    "export_bundle_contents",
    "landing_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "portable_shelf"
      ]
    },
    "change_orchestration_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "export_bundle_contents": {
      "type": "array"
    },
    "import_reopen_lineage": {
      "type": "string",
      "minLength": 1
    },
    "recovery_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "landing_state": {
      "enum": [
        "selected_change",
        "stale_validation",
        "restack_required",
        "queue_eligible",
        "queue_blocked",
        "protected_branch_blocked",
        "orphaned",
        "abandoned",
        "exported",
        "imported_reopened"
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
