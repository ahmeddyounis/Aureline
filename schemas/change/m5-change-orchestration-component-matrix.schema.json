{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/change/m5-change-orchestration-component-matrix.schema.json",
  "title": "Aureline M5 change-object, patch-stack/queue, stack-edit-review, landing-candidate, portable-shelf, and worktree-cleanup-preview matrix",
  "description": "Export-safe packet freezing Aureline's explicit change-orchestration model \u2014 the change object, the patch stack / queue, the stack-edit / review sheet, the landing-candidate sheet, the portable shelf / bundle, and the worktree cleanup preview a Git / review / AI / provider-backed consumer must treat as first-class, worktree-bound, landing-aware engineering objects. The packet names every covered object class and binds each to the claimed surface families that render it, the classification stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain schema, the required visible state (surface label, selected change object, worktree / base identity, stack membership and order, landing-state summary, cleanup safety, and validation freshness), and the mandatory labels it must show (identity, lifecycle_role, canonical_reference, plus landing_state, stack_membership_source, cleanup_safety). The landing_state field makes a queue-eligible landing candidate mechanically distinct from a selected change, a stale-validation view, a restack-required stack, a queue-blocked or protected-branch-blocked candidate, and an orphaned / abandoned / exported / imported-reopened object. Hard invariants forbid inferring stack membership from branch names alone, mutating files in another worktree without an explicit selected change object and worktree binding, silently reordering / collapsing / retargeting stack members, landing from ambient branch state without a reviewed landing candidate, and deleting orphaned worktrees or stale stack members without previewing running work and export-safe evidence. The matrix binds back to the already-landed stable-proof-index, migration-task-row, and portable-bundle packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "change_orchestration_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_change_object_patch_stack_landing_candidate_shelf_and_worktree_cleanup_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "change_orchestration_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/change_orchestration_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "change_orchestration_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "change_orchestration_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "change_object",
        "patch_stack_queue",
        "stack_edit_review_sheet",
        "landing_candidate_sheet",
        "portable_shelf",
        "worktree_cleanup_preview"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "landing_state": {
      "enum": [
        "selected_change",
        "stale_validation",
        "restack_required",
        "queue_eligible",
        "queue_blocked",
        "protected_branch_blocked",
        "orphaned",
        "abandoned",
        "exported",
        "imported_reopened"
      ]
    },
    "semantic_role": {
      "enum": [
        "selected_change_object_disclosure",
        "worktree_binding_disclosure",
        "stack_membership_disclosure",
        "landing_state_disclosure",
        "validation_freshness_disclosure",
        "rollback_export_fallback_disclosure",
        "cleanup_safety_disclosure"
      ]
    },
    "required_visible_state": {
      "type": "object",
      "required": [
        "surface_label",
        "selected_change_object",
        "worktree_base_identity",
        "stack_membership_and_order",
        "landing_state_summary",
        "cleanup_safety",
        "validation_evidence"
      ],
      "properties": {
        "surface_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "selected_change_object": {
          "$ref": "#/$defs/non_empty_string"
        },
        "worktree_base_identity": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stack_membership_and_order": {
          "$ref": "#/$defs/non_empty_string"
        },
        "landing_state_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "cleanup_safety": {
          "$ref": "#/$defs/non_empty_string"
        },
        "validation_evidence": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "change_orchestration_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "landing_state",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "required_visible_state",
        "surface_families",
        "classification_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "infers_stack_membership_from_branch_names_alone",
        "mutates_files_in_another_worktree_without_an_explicit_selected_change_object_and_worktree_binding",
        "silently_reorders_collapses_or_retargets_stack_members",
        "lands_from_ambient_branch_state_without_a_reviewed_landing_candidate",
        "deletes_orphaned_worktrees_or_stale_stack_members_without_previewing_running_work_and_export_safe_evidence"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "landing_state": {
          "$ref": "#/$defs/landing_state"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_visible_state": {
          "$ref": "#/$defs/required_visible_state"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "classification_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "change_object_roles": {
          "type": "array"
        },
        "patch_stack_queue_roles": {
          "type": "array"
        },
        "stack_edit_review_roles": {
          "type": "array"
        },
        "landing_candidate_roles": {
          "type": "array"
        },
        "portable_shelf_roles": {
          "type": "array"
        },
        "worktree_cleanup_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "infers_stack_membership_from_branch_names_alone": {
          "const": false
        },
        "mutates_files_in_another_worktree_without_an_explicit_selected_change_object_and_worktree_binding": {
          "const": false
        },
        "silently_reorders_collapses_or_retargets_stack_members": {
          "const": false
        },
        "lands_from_ambient_branch_state_without_a_reviewed_landing_candidate": {
          "const": false
        },
        "deletes_orphaned_worktrees_or_stale_stack_members_without_previewing_running_work_and_export_safe_evidence": {
          "const": false
        }
      }
    }
  }
}
