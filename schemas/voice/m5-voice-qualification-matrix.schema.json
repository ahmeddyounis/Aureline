{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/voice/m5-voice-qualification-matrix.schema.json",
  "title": "Aureline M5 voice-mode provider / transcript-retention / command-parity qualification matrix",
  "description": "Frozen, export-safe matrix binding every claimed M5 voice profile (command overlay, dictation input, transcript correction, provider/privacy settings, unavailable fallback, high-impact action review) to its versioned provider descriptor, voice-session state, transcript-retention posture, and command-parity guarantees, plus a claimed and effective qualification grade. Each row is verification-bound: it names a proof currency and, unless the proof is missing, a reopenable proof ref keyed by a non-display fingerprint. A claimed row that conflates or blocks its mode, defaults to continuous/wake activation without opt-in, leaves hosted/enterprise processing undisclosed, ships incomplete command parity, or carries stale, missing, or imported-on-local proof, auto-downgrades to an effective grade strictly below its claim, with a recorded trigger and a precise label. A keyboard fallback is always available, raw transcripts are excluded by default, background listening is never on by default, and provider-linked profiles never read as locally verified. Unclaimed Labs/unadvertised profiles are kept clearly separate from claimed scope. Raw audio, raw transcripts, raw provider payloads, private paths, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "label",
    "rows",
    "guardrails",
    "consumer_projection",
    "verification_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_voice_mode_provider_transcript_retention_command_parity_matrix_packet"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "label": { "$ref": "#/$defs/non_empty_string" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/voice_claimed_profile_row" }
    },
    "guardrails": { "$ref": "#/$defs/guardrails" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "verification_freshness": { "$ref": "#/$defs/verification_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "voice_surface_kind": {
      "type": "string",
      "enum": [
        "command_overlay",
        "dictation_input",
        "transcript_correction",
        "provider_privacy_settings",
        "unavailable_fallback",
        "high_impact_action_review"
      ]
    },
    "voice_profile_origin_class": {
      "type": "string",
      "enum": [
        "first_party_local_profile",
        "enterprise_managed_profile",
        "provider_linked_profile",
        "imported_read_only_profile"
      ]
    },
    "voice_claim_posture": {
      "type": "string",
      "enum": ["claimed_beta", "claimed_preview", "labs_unadvertised"]
    },
    "voice_qualification_grade": {
      "type": "string",
      "enum": [
        "qualified_claimed_profile",
        "qualified_narrowed_profile",
        "labs_unadvertised_profile",
        "qualification_withdrawn",
        "not_applicable"
      ]
    },
    "voice_proof_currency": {
      "type": "string",
      "enum": [
        "verified_current",
        "cached_within_window",
        "imported_current",
        "stale_expired",
        "requires_review",
        "missing_proof"
      ]
    },
    "voice_qualification_downgrade_trigger": {
      "type": "string",
      "enum": [
        "mode_separation_unverified",
        "push_to_talk_default_missing",
        "provider_locality_undisclosed",
        "transcript_retention_unbounded",
        "command_parity_incomplete",
        "keyboard_fallback_missing",
        "provider_unavailable_downgraded",
        "stale_verification_proof",
        "imported_proof_on_local_profile"
      ]
    },
    "voice_unavailable_reason": {
      "type": "string",
      "enum": [
        "offline_no_local_engine",
        "provider_unavailable",
        "no_microphone",
        "noisy_environment",
        "policy_locked_or_blocked",
        "local_pack_unverified",
        "trust_restricted"
      ]
    },
    "voice_provider_class": {
      "type": "string",
      "enum": [
        "on_device_local",
        "approved_remote_disclosed",
        "enterprise_relay_managed",
        "mocked_test_provider",
        "provider_disabled"
      ]
    },
    "processing_locality_cue": {
      "type": "string",
      "enum": [
        "local_on_device",
        "hosted_remote_disclosed",
        "processing_unavailable"
      ]
    },
    "voice_transport_class": {
      "type": "string",
      "enum": [
        "local_in_process_only",
        "policy_bounded_disclosed_endpoint",
        "explicit_opt_in_disclosed_endpoint",
        "transport_blocked"
      ]
    },
    "background_listening_state": {
      "type": "string",
      "enum": ["off_default", "on_user_opted_in", "blocked_by_policy"]
    },
    "retention_mode": {
      "type": "string",
      "enum": [
        "no_audio_no_transcript_retained",
        "ephemeral_audio_local_only_no_transcript_retained",
        "transcript_retained_local_only",
        "transcript_retained_redacted_in_support_bundle",
        "transcript_retained_provider_per_contract",
        "retention_blocked_by_policy",
        "retention_unavailable_in_envelope"
      ]
    },
    "audio_retention_class": {
      "type": "string",
      "enum": [
        "no_audio_retained",
        "ephemeral_audio_local_only",
        "bounded_audio_local_window",
        "audio_retained_provider_per_contract",
        "audio_capture_blocked"
      ]
    },
    "transcript_export_posture": {
      "type": "string",
      "enum": [
        "no_transcript_export",
        "explicit_user_export_redacted",
        "metadata_only_support_export",
        "provider_contract_retained",
        "export_blocked_by_policy"
      ]
    },
    "voice_mode_class": {
      "type": "string",
      "enum": [
        "idle_microphone_off",
        "dictation_mode_active",
        "command_mode_active",
        "continuous_listening_active_user_opted_in",
        "voice_mode_blocked_by_policy",
        "voice_mode_blocked_by_envelope"
      ]
    },
    "voice_activation_class": {
      "type": "string",
      "enum": [
        "push_to_talk_held",
        "push_to_talk_toggle",
        "wake_phrase_continuous_user_opted_in",
        "manual_command_activation",
        "activation_blocked_by_policy",
        "activation_unavailable_in_envelope"
      ]
    },
    "mic_indicator_class": {
      "type": "string",
      "enum": [
        "persistent_indicator_visible_capture_active",
        "persistent_indicator_visible_capture_idle",
        "persistent_indicator_hidden_capture_disabled",
        "persistent_indicator_unavailable_degraded"
      ]
    },
    "command_preview_class": {
      "type": "string",
      "enum": [
        "preview_required_for_privileged_actions",
        "preview_optional_for_reversible_local_actions",
        "preview_skipped_for_inert_metadata_only",
        "preview_blocked_by_envelope"
      ]
    },
    "transcript_correction_posture": {
      "type": "string",
      "enum": [
        "correction_required_before_commit",
        "correction_optional_before_commit",
        "correction_unavailable_capture_only",
        "correction_blocked_by_envelope"
      ]
    },
    "voice_policy_state": {
      "type": "string",
      "enum": ["user_controlled", "enterprise_policy_managed", "policy_blocked"]
    },
    "capability_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supports_command_mode",
        "supports_dictation_mode",
        "supports_correction_review",
        "continuous_listening_requires_opt_in",
        "wake_word_requires_opt_in",
        "background_listening_default_off"
      ],
      "properties": {
        "supports_command_mode": { "type": "boolean" },
        "supports_dictation_mode": { "type": "boolean" },
        "supports_correction_review": { "type": "boolean" },
        "continuous_listening_requires_opt_in": { "type": "boolean" },
        "wake_word_requires_opt_in": { "type": "boolean" },
        "background_listening_default_off": { "type": "boolean" }
      }
    },
    "transcript_retention_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_mode",
        "audio_retention",
        "transcript_export",
        "bounded_correction_buffer",
        "raw_transcripts_excluded_by_default",
        "redaction_before_support_export"
      ],
      "properties": {
        "retention_mode": { "$ref": "#/$defs/retention_mode" },
        "audio_retention": { "$ref": "#/$defs/audio_retention_class" },
        "transcript_export": { "$ref": "#/$defs/transcript_export_posture" },
        "bounded_correction_buffer": { "type": "boolean" },
        "raw_transcripts_excluded_by_default": { "type": "boolean" },
        "redaction_before_support_export": { "type": "boolean" }
      }
    },
    "voice_provider_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "provider_id",
        "provider_fingerprint_token",
        "provider_class",
        "processing_locality",
        "transport_class",
        "background_listening_state",
        "capability_disclosure",
        "retention_posture",
        "data_class_label",
        "audit_capable",
        "keyboard_fallback_available"
      ],
      "properties": {
        "record_kind": { "const": "voice_provider_descriptor" },
        "schema_version": { "const": 1 },
        "provider_id": { "$ref": "#/$defs/non_empty_string" },
        "provider_fingerprint_token": { "$ref": "#/$defs/non_empty_string" },
        "provider_class": { "$ref": "#/$defs/voice_provider_class" },
        "processing_locality": { "$ref": "#/$defs/processing_locality_cue" },
        "transport_class": { "$ref": "#/$defs/voice_transport_class" },
        "background_listening_state": { "$ref": "#/$defs/background_listening_state" },
        "capability_disclosure": { "$ref": "#/$defs/capability_disclosure" },
        "retention_posture": { "$ref": "#/$defs/transcript_retention_posture" },
        "data_class_label": { "$ref": "#/$defs/non_empty_string" },
        "audit_capable": { "type": "boolean" },
        "keyboard_fallback_available": { "type": "boolean" },
        "fallback_provider_id": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "voice_session_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "session_id",
        "mode_class",
        "activation_class",
        "mic_indicator_class",
        "processing_locality",
        "provider_id",
        "background_listening_state",
        "command_preview_class",
        "transcript_correction_posture",
        "policy_state",
        "keyboard_fallback_available",
        "accessibility_announced"
      ],
      "properties": {
        "record_kind": { "const": "voice_session_state" },
        "schema_version": { "const": 1 },
        "session_id": { "$ref": "#/$defs/non_empty_string" },
        "mode_class": { "$ref": "#/$defs/voice_mode_class" },
        "activation_class": { "$ref": "#/$defs/voice_activation_class" },
        "mic_indicator_class": { "$ref": "#/$defs/mic_indicator_class" },
        "processing_locality": { "$ref": "#/$defs/processing_locality_cue" },
        "provider_id": { "$ref": "#/$defs/non_empty_string" },
        "background_listening_state": { "$ref": "#/$defs/background_listening_state" },
        "command_preview_class": { "$ref": "#/$defs/command_preview_class" },
        "transcript_correction_posture": { "$ref": "#/$defs/transcript_correction_posture" },
        "policy_state": { "$ref": "#/$defs/voice_policy_state" },
        "keyboard_fallback_available": { "type": "boolean" },
        "accessibility_announced": { "type": "boolean" }
      }
    },
    "command_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_command_ids",
        "disabled_with_reason",
        "preview_apply_revert",
        "approval_requirements",
        "undo_grouping",
        "audit_support_lineage",
        "high_impact_review",
        "keyboard_fallback_parity"
      ],
      "properties": {
        "stable_command_ids": { "type": "boolean" },
        "disabled_with_reason": { "type": "boolean" },
        "preview_apply_revert": { "type": "boolean" },
        "approval_requirements": { "type": "boolean" },
        "undo_grouping": { "type": "boolean" },
        "audit_support_lineage": { "type": "boolean" },
        "high_impact_review": { "type": "boolean" },
        "keyboard_fallback_parity": { "type": "boolean" }
      }
    },
    "voice_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_currency", "summary"],
      "properties": {
        "proof_currency": { "$ref": "#/$defs/voice_proof_currency" },
        "proof_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_fingerprint_token": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "voice_claimed_profile_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "surface_kind",
        "origin_class",
        "profile_fingerprint_token",
        "label_summary",
        "claim_posture",
        "provider",
        "session",
        "command_parity",
        "verification",
        "claimed_grade",
        "effective_grade",
        "evidence_refs",
        "source_contract_refs"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_kind": { "$ref": "#/$defs/voice_surface_kind" },
        "origin_class": { "$ref": "#/$defs/voice_profile_origin_class" },
        "profile_fingerprint_token": { "$ref": "#/$defs/non_empty_string" },
        "label_summary": { "$ref": "#/$defs/non_empty_string" },
        "claim_posture": { "$ref": "#/$defs/voice_claim_posture" },
        "provider": { "$ref": "#/$defs/voice_provider_descriptor" },
        "session": { "$ref": "#/$defs/voice_session_state" },
        "command_parity": { "$ref": "#/$defs/command_parity" },
        "verification": { "$ref": "#/$defs/voice_verification" },
        "claimed_grade": { "$ref": "#/$defs/voice_qualification_grade" },
        "effective_grade": { "$ref": "#/$defs/voice_qualification_grade" },
        "downgrade_trigger": { "$ref": "#/$defs/voice_qualification_downgrade_trigger" },
        "downgraded_label": { "$ref": "#/$defs/non_empty_string" },
        "unavailable_reason": { "$ref": "#/$defs/voice_unavailable_reason" },
        "evidence_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_and_dictation_modes_never_conflated",
        "push_to_talk_or_explicit_activation_is_default",
        "provider_locality_and_retention_always_disclosed",
        "transcripts_bounded_and_raw_excluded_by_default",
        "voice_actions_reuse_command_undo_policy_parity",
        "keyboard_fallback_always_available",
        "background_listening_never_default_on",
        "claimed_profiles_separated_from_future_voice_ambitions",
        "rows_auto_downgrade_without_current_proof"
      ],
      "properties": {
        "command_and_dictation_modes_never_conflated": { "type": "boolean" },
        "push_to_talk_or_explicit_activation_is_default": { "type": "boolean" },
        "provider_locality_and_retention_always_disclosed": { "type": "boolean" },
        "transcripts_bounded_and_raw_excluded_by_default": { "type": "boolean" },
        "voice_actions_reuse_command_undo_policy_parity": { "type": "boolean" },
        "keyboard_fallback_always_available": { "type": "boolean" },
        "background_listening_never_default_on": { "type": "boolean" },
        "claimed_profiles_separated_from_future_voice_ambitions": { "type": "boolean" },
        "rows_auto_downgrade_without_current_proof": { "type": "boolean" }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ingests_matrix",
        "command_help_ingests_matrix",
        "accessibility_ingests_matrix",
        "diagnostics_ingests_matrix",
        "support_export_ingests_matrix",
        "release_control_ingests_matrix",
        "downgraded_profiles_labeled_below_claim"
      ],
      "properties": {
        "product_ingests_matrix": { "type": "boolean" },
        "command_help_ingests_matrix": { "type": "boolean" },
        "accessibility_ingests_matrix": { "type": "boolean" },
        "diagnostics_ingests_matrix": { "type": "boolean" },
        "support_export_ingests_matrix": { "type": "boolean" },
        "release_control_ingests_matrix": { "type": "boolean" },
        "downgraded_profiles_labeled_below_claim": { "type": "boolean" }
      }
    },
    "verification_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_freshness_slo_hours",
        "last_verification_refresh",
        "auto_downgrade_on_stale"
      ],
      "properties": {
        "verification_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_verification_refresh": { "type": "string", "format": "date-time" },
        "auto_downgrade_on_stale": { "type": "boolean" }
      }
    }
  }
}
