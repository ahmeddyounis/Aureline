{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/voice/voice-session.schema.json",
  "title": "Aureline voice session state",
  "description": "Versioned, export-safe voice-session state: the canonical truth for a session's mode (command vs dictation vs idle vs blocked), activation (push-to-talk default vs opted-in continuous/wake), persistent mic-indicator class, processing locality, bound provider id, background-listening state, command-preview posture, transcript-correction posture, policy state, and keyboard-fallback availability. Command mode and dictation mode are always distinct, explicit states; the session never carries raw audio, raw transcript text, private paths, or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "session_id",
    "mode_class",
    "activation_class",
    "mic_indicator_class",
    "processing_locality",
    "provider_id",
    "background_listening_state",
    "command_preview_class",
    "transcript_correction_posture",
    "policy_state",
    "keyboard_fallback_available",
    "accessibility_announced"
  ],
  "properties": {
    "record_kind": {
      "const": "voice_session_state"
    },
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "mode_class": {
      "$ref": "#/$defs/voice_mode_class"
    },
    "activation_class": {
      "$ref": "#/$defs/voice_activation_class"
    },
    "mic_indicator_class": {
      "$ref": "#/$defs/mic_indicator_class"
    },
    "processing_locality": {
      "$ref": "#/$defs/processing_locality_cue"
    },
    "provider_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "background_listening_state": {
      "$ref": "#/$defs/background_listening_state"
    },
    "command_preview_class": {
      "$ref": "#/$defs/command_preview_class"
    },
    "transcript_correction_posture": {
      "$ref": "#/$defs/transcript_correction_posture"
    },
    "policy_state": {
      "$ref": "#/$defs/voice_policy_state"
    },
    "keyboard_fallback_available": {
      "type": "boolean"
    },
    "accessibility_announced": {
      "type": "boolean"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "voice_mode_class": {
      "type": "string",
      "enum": [
        "idle_microphone_off",
        "dictation_mode_active",
        "command_mode_active",
        "continuous_listening_active_user_opted_in",
        "voice_mode_blocked_by_policy",
        "voice_mode_blocked_by_envelope"
      ]
    },
    "voice_activation_class": {
      "type": "string",
      "enum": [
        "push_to_talk_held",
        "push_to_talk_toggle",
        "wake_phrase_continuous_user_opted_in",
        "manual_command_activation",
        "activation_blocked_by_policy",
        "activation_unavailable_in_envelope"
      ]
    },
    "mic_indicator_class": {
      "type": "string",
      "enum": [
        "persistent_indicator_visible_capture_active",
        "persistent_indicator_visible_capture_idle",
        "persistent_indicator_hidden_capture_disabled",
        "persistent_indicator_unavailable_degraded"
      ]
    },
    "processing_locality_cue": {
      "type": "string",
      "enum": [
        "local_on_device",
        "hosted_remote_disclosed",
        "processing_unavailable"
      ]
    },
    "background_listening_state": {
      "type": "string",
      "enum": [
        "off_default",
        "on_user_opted_in",
        "blocked_by_policy"
      ]
    },
    "command_preview_class": {
      "type": "string",
      "enum": [
        "preview_required_for_privileged_actions",
        "preview_optional_for_reversible_local_actions",
        "preview_skipped_for_inert_metadata_only",
        "preview_blocked_by_envelope"
      ]
    },
    "transcript_correction_posture": {
      "type": "string",
      "enum": [
        "correction_required_before_commit",
        "correction_optional_before_commit",
        "correction_unavailable_capture_only",
        "correction_blocked_by_envelope"
      ]
    },
    "voice_policy_state": {
      "type": "string",
      "enum": [
        "user_controlled",
        "enterprise_policy_managed",
        "policy_blocked"
      ]
    }
  }
}
