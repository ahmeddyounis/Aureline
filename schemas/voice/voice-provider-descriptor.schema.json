{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/voice/voice-provider-descriptor.schema.json",
  "title": "Aureline voice provider descriptor",
  "description": "Versioned, export-safe descriptor for a speech provider backing a claimed voice profile. Pins the provider class, processing locality, transport class, capability disclosure (with opt-in guards for continuous listening, wake-word, and background listening), and the bounded transcript-retention posture (retention mode, audio-retention class, and transcript-export posture). Raw audio, raw transcripts, raw provider payloads, private paths, and credentials never cross this boundary; the descriptor carries only typed class tokens, booleans, opaque ids, fingerprint digests, and redaction-aware labels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "provider_id",
    "provider_fingerprint_token",
    "provider_class",
    "processing_locality",
    "transport_class",
    "background_listening_state",
    "capability_disclosure",
    "retention_posture",
    "data_class_label",
    "audit_capable",
    "keyboard_fallback_available"
  ],
  "properties": {
    "record_kind": {
      "const": "voice_provider_descriptor"
    },
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "provider_fingerprint_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "provider_class": {
      "$ref": "#/$defs/voice_provider_class"
    },
    "processing_locality": {
      "$ref": "#/$defs/processing_locality_cue"
    },
    "transport_class": {
      "$ref": "#/$defs/voice_transport_class"
    },
    "background_listening_state": {
      "$ref": "#/$defs/background_listening_state"
    },
    "capability_disclosure": {
      "$ref": "#/$defs/capability_disclosure"
    },
    "retention_posture": {
      "$ref": "#/$defs/transcript_retention_posture"
    },
    "data_class_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "audit_capable": {
      "type": "boolean"
    },
    "keyboard_fallback_available": {
      "type": "boolean"
    },
    "fallback_provider_id": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "voice_provider_class": {
      "type": "string",
      "enum": [
        "on_device_local",
        "approved_remote_disclosed",
        "enterprise_relay_managed",
        "mocked_test_provider",
        "provider_disabled"
      ]
    },
    "processing_locality_cue": {
      "type": "string",
      "enum": [
        "local_on_device",
        "hosted_remote_disclosed",
        "processing_unavailable"
      ]
    },
    "voice_transport_class": {
      "type": "string",
      "enum": [
        "local_in_process_only",
        "policy_bounded_disclosed_endpoint",
        "explicit_opt_in_disclosed_endpoint",
        "transport_blocked"
      ]
    },
    "background_listening_state": {
      "type": "string",
      "enum": [
        "off_default",
        "on_user_opted_in",
        "blocked_by_policy"
      ]
    },
    "retention_mode": {
      "type": "string",
      "enum": [
        "no_audio_no_transcript_retained",
        "ephemeral_audio_local_only_no_transcript_retained",
        "transcript_retained_local_only",
        "transcript_retained_redacted_in_support_bundle",
        "transcript_retained_provider_per_contract",
        "retention_blocked_by_policy",
        "retention_unavailable_in_envelope"
      ]
    },
    "audio_retention_class": {
      "type": "string",
      "enum": [
        "no_audio_retained",
        "ephemeral_audio_local_only",
        "bounded_audio_local_window",
        "audio_retained_provider_per_contract",
        "audio_capture_blocked"
      ]
    },
    "transcript_export_posture": {
      "type": "string",
      "enum": [
        "no_transcript_export",
        "explicit_user_export_redacted",
        "metadata_only_support_export",
        "provider_contract_retained",
        "export_blocked_by_policy"
      ]
    },
    "capability_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supports_command_mode",
        "supports_dictation_mode",
        "supports_correction_review",
        "continuous_listening_requires_opt_in",
        "wake_word_requires_opt_in",
        "background_listening_default_off"
      ],
      "properties": {
        "supports_command_mode": { "type": "boolean" },
        "supports_dictation_mode": { "type": "boolean" },
        "supports_correction_review": { "type": "boolean" },
        "continuous_listening_requires_opt_in": { "type": "boolean" },
        "wake_word_requires_opt_in": { "type": "boolean" },
        "background_listening_default_off": { "type": "boolean" }
      }
    },
    "transcript_retention_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_mode",
        "audio_retention",
        "transcript_export",
        "bounded_correction_buffer",
        "raw_transcripts_excluded_by_default",
        "redaction_before_support_export"
      ],
      "properties": {
        "retention_mode": { "$ref": "#/$defs/retention_mode" },
        "audio_retention": { "$ref": "#/$defs/audio_retention_class" },
        "transcript_export": { "$ref": "#/$defs/transcript_export_posture" },
        "bounded_correction_buffer": { "type": "boolean" },
        "raw_transcripts_excluded_by_default": { "type": "boolean" },
        "redaction_before_support_export": { "type": "boolean" }
      }
    }
  }
}
