{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-update-lifecycle-certification.schema.json",
  "title": "Aureline M5 update / support-lifecycle certification",
  "description": "Per-channel / per-profile qualification of the M5 update / support-lifecycle contract. The certification projects the update / support-lifecycle governance matrix onto the claimed channel × deployment-profile grid and qualifies each pair along four proof dimensions drawn from the governed facets: update communication (update availability, change impact, release-note evidence), migration guidance (the migration assistant), lifecycle windows (support window, compatibility window, end-of-support), and stale-data behavior (service health). For one pair and one dimension it gathers the governed facets that back the dimension and scope to that channel and profile: a dimension no facet covers for the pair is honestly labeled not-applicable, otherwise the cell takes the worst proof freshness and worst lifecycle-state gate among the covering facets so a downgraded copy can never read as live. A claim's gate is the worst of its applicable cells and its effective qualification is the claimed class narrowed down that gate — governed keeps the claim, narrowed floors it at Beta, blocked floors it at Unavailable. The claimed consumer surfaces (release center, update center, Help/About, docs/help, support exports, shiproom) each bind the dimensions they surface and derive their posture and the exact channel/profile pairs they must narrow or block, so release, help, support, and shiproom read one certification rather than parallel channel inventories. The packet is metadata-only: it carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "governance_packet_id",
    "governance_ref",
    "claims",
    "consumers",
    "consumer_tokens",
    "disclosure",
    "summary",
    "release_gate",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_update_lifecycle_certification"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "governance_packet_id": { "type": "string", "minLength": 1 },
    "governance_ref": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel_profile_claim" }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "consumer_tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer" }
    },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "summary": { "$ref": "#/$defs/summary" },
    "release_gate": { "$ref": "#/$defs/release_gate" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "nightly", "lts"]
    },
    "profile": {
      "type": "string",
      "enum": ["managed", "self_hosted"]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "dimension": {
      "type": "string",
      "enum": ["update_communication", "migration_guidance", "lifecycle_windows", "stale_data_behavior"]
    },
    "outcome": {
      "type": "string",
      "enum": ["certified", "narrowed", "blocked", "not_applicable"]
    },
    "gate": {
      "type": "string",
      "enum": ["governed", "narrowed", "blocked"]
    },
    "status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "gap_kind": {
      "type": "string",
      "enum": ["proof_stale", "proof_expired", "proof_missing", "lifecycle_state_narrowed", "lifecycle_state_blocked"]
    },
    "facet": {
      "type": "string",
      "enum": ["update_availability", "change_impact", "release_note_evidence", "migration_assistant", "service_health", "support_window", "compatibility_window", "end_of_support"]
    },
    "freshness": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "stale_data_behavior": {
      "type": "string",
      "enum": ["live_verified", "mirrored_labelled", "offline_cached", "stale_banner_shown", "local_only_no_live_data"]
    },
    "consumer": {
      "type": "string",
      "enum": ["release_center", "update_center", "help_about", "docs_help", "support_export", "shiproom"]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "dimension_label",
        "outcome",
        "backing_facets",
        "proof_refs",
        "proof_freshness",
        "lifecycle_gate",
        "stale_data_behavior",
        "gate",
        "status",
        "signal",
        "gap_kind",
        "detail_message_id"
      ],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "dimension_label": { "type": "string", "minLength": 1 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "backing_facets": {
          "type": "array",
          "items": { "$ref": "#/$defs/facet" }
        },
        "proof_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "proof_freshness": {
          "anyOf": [{ "$ref": "#/$defs/freshness" }, { "type": "null" }]
        },
        "lifecycle_gate": {
          "anyOf": [{ "$ref": "#/$defs/gate" }, { "type": "null" }]
        },
        "stale_data_behavior": {
          "anyOf": [{ "$ref": "#/$defs/stale_data_behavior" }, { "type": "null" }]
        },
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gap_kind": {
          "anyOf": [{ "$ref": "#/$defs/gap_kind" }, { "type": "null" }]
        },
        "detail_message_id": {
          "type": "string",
          "pattern": "^release_update_lifecycle_certification\\."
        }
      },
      "allOf": [
        {
          "comment": "A not-applicable cell carries no backing facets and no gap.",
          "if": { "properties": { "outcome": { "const": "not_applicable" } } },
          "then": {
            "properties": {
              "backing_facets": { "maxItems": 0 },
              "proof_freshness": { "type": "null" },
              "lifecycle_gate": { "type": "null" },
              "gate": { "const": "governed" },
              "gap_kind": { "type": "null" }
            }
          }
        },
        {
          "comment": "An applicable, non-certified cell names why it narrowed or blocked.",
          "if": {
            "anyOf": [
              { "properties": { "outcome": { "const": "narrowed" } } },
              { "properties": { "outcome": { "const": "blocked" } } }
            ]
          },
          "then": {
            "required": ["gap_kind"],
            "properties": {
              "gap_kind": { "$ref": "#/$defs/gap_kind" },
              "proof_freshness": { "$ref": "#/$defs/freshness" }
            }
          }
        }
      ]
    },
    "channel_profile_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "profile",
        "claim_label",
        "claim_ref",
        "claimed_qualification",
        "cells",
        "applicable_dimensions",
        "effective_qualification",
        "gate",
        "status",
        "signal",
        "verdict_message_id"
      ],
      "properties": {
        "channel": { "$ref": "#/$defs/channel" },
        "profile": { "$ref": "#/$defs/profile" },
        "claim_label": { "type": "string", "minLength": 1 },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claimed_qualification": { "$ref": "#/$defs/qualification" },
        "cells": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/cell" }
        },
        "applicable_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "effective_qualification": { "$ref": "#/$defs/qualification" },
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "verdict_message_id": {
          "type": "string",
          "pattern": "^release_update_lifecycle_certification\\."
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "owner_role",
        "read_dimensions",
        "gate",
        "status",
        "signal",
        "narrowed_claim_refs",
        "blocked_claim_refs",
        "status_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "read_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "narrowed_claim_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_claim_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "status_message_id": {
          "type": "string",
          "pattern": "^release_update_lifecycle_certification\\."
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "one_certification_across_surfaces"],
      "properties": {
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer" }
        },
        "one_certification_across_surfaces": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_claims",
        "certified_claims",
        "narrowed_claims",
        "blocked_claims",
        "total_consumers",
        "certified_consumers",
        "narrowed_consumers",
        "blocked_consumers",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_claims": { "type": "integer", "minimum": 0 },
        "certified_claims": { "type": "integer", "minimum": 0 },
        "narrowed_claims": { "type": "integer", "minimum": 0 },
        "blocked_claims": { "type": "integer", "minimum": 0 },
        "total_consumers": { "type": "integer", "minimum": 0 },
        "certified_consumers": { "type": "integer", "minimum": 0 },
        "narrowed_consumers": { "type": "integer", "minimum": 0 },
        "blocked_consumers": { "type": "integer", "minimum": 0 },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "blocks_stable_promotion",
        "narrowed_claim_refs",
        "blocked_claim_refs",
        "drifted_dimensions",
        "gate_message_id"
      ],
      "properties": {
        "gate": { "$ref": "#/$defs/gate" },
        "blocks_stable_promotion": { "type": "boolean" },
        "narrowed_claim_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_claim_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "drifted_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "gate_message_id": {
          "type": "string",
          "pattern": "^release_update_lifecycle_certification\\."
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "profiles", "dimensions", "outcomes", "gap_kinds", "consumers"],
      "properties": {
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } },
        "gap_kinds": { "type": "array", "items": { "$ref": "#/$defs/gap_kind" } },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_claim_mapped_to_proof",
        "stale_proof_narrows_deterministically",
        "narrowing_is_per_claim",
        "surfaces_consume_one_certification",
        "generated_from_governance_matrix",
        "controlled_enums_frozen",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "every_claim_mapped_to_proof": { "const": true },
        "stale_proof_narrows_deterministically": { "const": true },
        "narrowing_is_per_claim": { "const": true },
        "surfaces_consume_one_certification": { "const": true },
        "generated_from_governance_matrix": { "const": true },
        "controlled_enums_frozen": { "const": true },
        "export_carries_no_raw_material": { "const": true }
      }
    }
  }
}
