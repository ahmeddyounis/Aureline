{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-stable-line-surface-certification.schema.json",
  "title": "Aureline M5 stable-line surface certification packet",
  "description": "M05-1228 closing B146 capstone certifying that the frozen M5 supported lines (fresh stable line, evidence-refresh line, correction/backport line, bundle-currentness line, lts-candidate line) hold their stable-line operating truth on every claimed M5 supported line. Keyed on the claimed profile (live supported-line operating lane, reviewable stable-line structure, disclosed correction-ownership profile, unverified bundle-currentness profile, unverified LTS-readiness profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and stable-line-component-truth behavior — and either passes (green), auto-narrows its operating claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party supported-line operating lane with current refresh, correction, bundle-currentness, and LTS-readiness evidence may certify a certified operating line; and every B146 hard invariant must hold (no support language widens without current refresh and correction evidence; no shipping line drifts on stale evidence or frozen launch bundles; no backport rests on tribal memory instead of a documented correction packet; no line claims LTS eligibility without current rollback and support evidence; and no supported-line defect is left unowned or unresolved past its SLA). Every row cites exactly one canonical stable-line proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_stable_line_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-stable-line-correction-reports/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_supported_line_operating_lane",
        "reviewable_stable_line_structure",
        "disclosed_correction_ownership_profile",
        "unverified_bundle_currentness_profile",
        "unverified_lts_readiness_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "stable_line_component_truth"
      ]
    },
    "stable_line_claim": {
      "enum": [
        "certified_operating_line",
        "reviewable_stable_line_surface",
        "correction_ownership_disclosed_projection",
        "bundle_currentness_unverified_projection",
        "lts_readiness_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "stable_line": {
      "enum": [
        "fresh_stable_line",
        "evidence_refresh_line",
        "correction_backport_line",
        "bundle_currentness_line",
        "lts_candidate_line"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "widened_support_without_current_refresh_evidence",
        "widened_support_without_current_correction_evidence",
        "relied_on_tribal_backport_memory",
        "left_a_supported_line_defect_unowned_past_sla",
        "implied_green_while_refresh_or_ledger_was_stale",
        "ran_support_language_ahead_of_refresh_proof",
        "support_window_unstated",
        "refresh_state_unstated",
        "lts_posture_unstated",
        "registry_reference_unstated",
        "bundle_currentness_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widens_support_language_without_current_refresh_and_correction_evidence",
        "drifts_a_shipping_line_on_stale_evidence_or_frozen_launch_bundles",
        "relies_on_tribal_backport_memory_instead_of_a_documented_correction_packet",
        "claims_lts_eligibility_without_current_rollback_and_support_evidence",
        "leaves_a_supported_line_defect_unowned_or_unresolved_past_its_sla"
      ],
      "properties": {
        "widens_support_language_without_current_refresh_and_correction_evidence": { "const": false },
        "drifts_a_shipping_line_on_stale_evidence_or_frozen_launch_bundles": { "const": false },
        "relies_on_tribal_backport_memory_instead_of_a_documented_correction_packet": { "const": false },
        "claims_lts_eligibility_without_current_rollback_and_support_evidence": { "const": false },
        "leaves_a_supported_line_defect_unowned_or_unresolved_past_its_sla": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/stable_line_claim" },
        "to_claim": { "$ref": "#/$defs/stable_line_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_stable_line_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/stable_line_claim" },
        "certified_claim": { "$ref": "#/$defs/stable_line_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stable_line" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-stable-line-correction-reports/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
