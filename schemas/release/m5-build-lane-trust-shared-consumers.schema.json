{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-build-lane-trust-shared-consumers.schema.json",
  "title": "M5 Build-Lane-Trust Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the four B144 build-lane-trust families (contributor / PR lane, protected-merge lane, release lane, emergency-hotfix lane) to the build-farm / cache-service / release-center / shiproom / provenance-service / diagnostics / docs-help / CLI-export / support-export consumers that render them, proving one shared build-lane-trust registry across the About / provenance, Help, service-health, release-center, and support-export surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_build_lane_trust_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "build_lane_family": {
      "type": "string",
      "enum": [
        "contributor_pr",
        "protected_merge",
        "release",
        "emergency_hotfix"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "build_farm",
        "cache_service",
        "release_center",
        "shiproom",
        "provenance_service",
        "diagnostics",
        "docs_help",
        "cli_export",
        "support_export"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "build_lane_trust_grammar_drift_detected",
        "replay_or_build_identity_disclosure_dropped",
        "pr_caches_publish_release_artifacts",
        "treats_remote_cache_hits_as_reproducibility_proof",
        "lets_docs_schema_sbom_or_symbol_sidecars_drift_from_binary_build_identity",
        "overclaims_clean_room_parity_when_only_partial_artifact_classes_were_rebuilt",
        "hides_non_hermetic_inputs_cache_poisoning_or_unreplayable_artifacts_behind_green_publication_rows",
        "canonical_registry_reference_missing",
        "upstream_build_lane_trust_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_lane_trust_role_word",
        "family_word",
        "registry_reference_word",
        "build_context_word",
        "surface_context_word",
        "replay_continuity_word"
      ],
      "properties": {
        "build_lane_trust_role_word": {
          "type": "string",
          "enum": [
            "cache_posture",
            "publication_authority",
            "credential_boundary",
            "hermetic_input",
            "reproducibility_proof",
            "artifact_convergence",
            "support_identity"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "build_context_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "replay_continuity_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "build_profile_id",
        "build_profile_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "pr_caches_publish_release_artifacts",
        "treats_remote_cache_hits_as_reproducibility_proof",
        "lets_docs_schema_sbom_or_symbol_sidecars_drift_from_binary_build_identity",
        "overclaims_clean_room_parity_when_only_partial_artifact_classes_were_rebuilt",
        "hides_non_hermetic_inputs_cache_poisoning_or_unreplayable_artifacts_behind_green_publication_rows",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "build_profile_id": { "type": "string", "minLength": 1 },
        "build_profile_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/build_lane_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "pr_caches_publish_release_artifacts": {
          "type": "boolean",
          "const": false
        },
        "treats_remote_cache_hits_as_reproducibility_proof": {
          "type": "boolean",
          "const": false
        },
        "lets_docs_schema_sbom_or_symbol_sidecars_drift_from_binary_build_identity": {
          "type": "boolean",
          "const": false
        },
        "overclaims_clean_room_parity_when_only_partial_artifact_classes_were_rebuilt": {
          "type": "boolean",
          "const": false
        },
        "hides_non_hermetic_inputs_cache_poisoning_or_unreplayable_artifacts_behind_green_publication_rows": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_profile_same_build_lane_trust_across_surfaces",
        "build_lane_trust_role_words_stay_in_frozen_vocabulary",
        "trust_roles_never_publish_untrusted_or_treat_cache_as_proof",
        "pr_cache_never_publishes_release_artifacts",
        "remote_cache_hit_never_treated_as_reproducibility_proof",
        "sidecars_never_drift_from_binary_build_identity",
        "clean_room_parity_never_overclaimed_on_partial_rebuild",
        "non_hermetic_inputs_cache_poisoning_or_unreplayable_artifacts_never_hidden",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_profile_same_build_lane_trust_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "build_lane_trust_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "trust_roles_never_publish_untrusted_or_treat_cache_as_proof": {
          "type": "boolean",
          "const": true
        },
        "pr_cache_never_publishes_release_artifacts": {
          "type": "boolean",
          "const": true
        },
        "remote_cache_hit_never_treated_as_reproducibility_proof": {
          "type": "boolean",
          "const": true
        },
        "sidecars_never_drift_from_binary_build_identity": {
          "type": "boolean",
          "const": true
        },
        "clean_room_parity_never_overclaimed_on_partial_rebuild": {
          "type": "boolean",
          "const": true
        },
        "non_hermetic_inputs_cache_poisoning_or_unreplayable_artifacts_never_hidden": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_farm_consumes_shared_build_lane_trust",
        "cache_service_consumes_shared_build_lane_trust",
        "release_center_consumes_shared_build_lane_trust",
        "shiproom_consumes_shared_build_lane_trust",
        "provenance_service_consumes_shared_build_lane_trust",
        "diagnostics_consumes_shared_build_lane_trust",
        "docs_help_consumes_shared_build_lane_trust",
        "cli_export_consumes_shared_build_lane_trust",
        "support_export_consumes_shared_build_lane_trust",
        "every_family_adopted_by_two_or_more_consumers",
        "build_lane_trust_identical_for_same_profile",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_build_lane_family"
      ],
      "properties": {
        "build_farm_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "cache_service_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "release_center_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "shiproom_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "provenance_service_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "docs_help_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "cli_export_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_build_lane_trust": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "build_lane_trust_identical_for_same_profile": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_build_lane_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
