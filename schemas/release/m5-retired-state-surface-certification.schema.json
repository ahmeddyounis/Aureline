{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-retired-state-surface-certification.schema.json",
  "title": "Aureline M5 retired-state surface certification packet",
  "description": "M05-1246 closing B148 capstone certifying that the frozen M5 retirement object classes (supported line, stable capability, bundle, command / deep link, schema-bearing surface, registry-visible package, managed / new-tenant feature) hold their retired-state truth on every claimed M5 supported line and stable-facing surface. Keyed on the claimed profile (live retired-state closure lane, reviewable retirement-record structure, disclosed archive-partial profile, unverified propagation profile, unverified closure-ledger profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and retired-state-truth behavior — and either passes (green), auto-narrows its closure claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live, fully closed retired-state closure lane whose retirement manifest, last-supported snapshot, tombstone, closure ledger, and deployment-profile propagation all converge on one current, export-safe, internally consistent retired-state record may certify a certified retired closure; and every B148 hard invariant must hold (no retired surface disappears without a tombstone, archival route, or successor pointer; no retired class stays selectable in a new-install / new-tenant / marketplace / upgrade flow; no last-supported docs / schemas / evidence are destroyed before support-note closure; no retirement state is left unjoined to exact build, line identity, deployment profile, and migration outcome; and no surface is retired through silent disappearance, stale selection UI, or orphaned support / docs truth). Every row cites exactly one canonical retired-state matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_retired_state_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-retirements/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_retired_state_closure_lane",
        "reviewable_retirement_record_structure",
        "disclosed_archive_partial_profile",
        "unverified_propagation_profile",
        "unverified_closure_ledger_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "retired_state_truth"
      ]
    },
    "retired_state_claim": {
      "enum": [
        "certified_retired_closure",
        "reviewable_retirement_record",
        "archive_disclosed_projection",
        "propagation_unverified_projection",
        "closure_ledger_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "supported_line",
        "stable_capability",
        "bundle",
        "command_deep_link",
        "schema_bearing_surface",
        "registry_visible_package",
        "managed_tenant_feature"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "retired_surface_disappeared_without_tombstone",
        "retired_class_stayed_selectable_in_new_install",
        "retired_class_stayed_selectable_for_new_tenant",
        "last_supported_snapshot_missing",
        "successor_path_unnamed",
        "disable_path_unnamed",
        "cutoff_date_unstated",
        "archival_note_missing",
        "support_note_closure_incomplete",
        "registry_reference_unstated",
        "retirement_unjoined_from_build_identity",
        "retirement_manifest_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lets_a_retired_surface_disappear_without_tombstone_archival_route_or_successor_pointer",
        "keeps_a_retired_class_selectable_in_new_install_new_tenant_marketplace_or_upgrade_flow",
        "destroys_last_supported_docs_schemas_or_evidence_before_support_note_closure",
        "leaves_retirement_state_unjoined_to_build_line_identity_deployment_profile_and_migration_outcome",
        "retires_a_surface_through_silent_disappearance_stale_selection_ui_or_orphaned_support_truth"
      ],
      "properties": {
        "lets_a_retired_surface_disappear_without_tombstone_archival_route_or_successor_pointer": { "const": false },
        "keeps_a_retired_class_selectable_in_new_install_new_tenant_marketplace_or_upgrade_flow": { "const": false },
        "destroys_last_supported_docs_schemas_or_evidence_before_support_note_closure": { "const": false },
        "leaves_retirement_state_unjoined_to_build_line_identity_deployment_profile_and_migration_outcome": { "const": false },
        "retires_a_surface_through_silent_disappearance_stale_selection_ui_or_orphaned_support_truth": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/retired_state_claim" },
        "to_claim": { "$ref": "#/$defs/retired_state_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_retired_state_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/retired_state_claim" },
        "certified_claim": { "$ref": "#/$defs/retired_state_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-retirements/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
