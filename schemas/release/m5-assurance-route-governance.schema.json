{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-assurance-route-governance.schema.json",
  "title": "Aureline M5 assurance / governance / route-provenance governance matrix",
  "description": "One frozen governance baseline every claimed M5 assurance-center, governance-dashboard, capability-boundary, route-hop, approval-ticket, and event-provenance surface qualifies against before deeper implementation widens a regulated, sovereign, self-hosted, or managed claim. The matrix has three parts: canonical, gate-bound state families (assurance-claim, governance, capability-boundary, route-hop, approval, provenance) whose tokens each bind a gate posture and an effective qualification floor; the governed facets (assurance claim, control proof, exception / waiver, governance freshness, service ownership, capability boundary, route hop, approval ticket, event provenance), each naming its dimension, state family, evidence classes, claimed posture lines, trust boundaries, degraded-data behavior, owner role, proof path, and proof freshness; and the claimed consumer surfaces (assurance center, governance dashboard, capability inspector, route inspector, admin console, About/help, procurement / evaluation, support export), each binding the facets it reads and deriving its coverage gaps, gate decision, and effective qualification from those facets' proof freshness and current assurance state. A stale facet proof narrows every consumer that reads it; an expired / missing / ungoverned facet proof, or a facet in a blocking assurance state, blocks that consumer from Stable promotion, with the gap named per consumer and its drifted dimension. The packet is metadata-only: it preserves route / evidence lineage as refs and carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "state_families",
    "facets",
    "consumers",
    "consumer_tokens",
    "disclosure",
    "summary",
    "release_gate",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "m5_assurance_route_governance" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "state_families": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/state_family" }
    },
    "facets": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/facet_row" }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "consumer_tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer" }
    },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "summary": { "$ref": "#/$defs/summary" },
    "release_gate": { "$ref": "#/$defs/release_gate" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "dimension": {
      "type": "string",
      "enum": ["claim_assurance", "governance_posture", "route_provenance"]
    },
    "facet": {
      "type": "string",
      "enum": [
        "assurance_claim",
        "control_proof",
        "exception_waiver",
        "governance_freshness",
        "service_ownership",
        "capability_boundary",
        "route_hop",
        "approval_ticket",
        "event_provenance"
      ]
    },
    "state_family_token": {
      "type": "string",
      "enum": [
        "assurance_claim",
        "governance",
        "capability_boundary",
        "route_hop",
        "approval",
        "provenance"
      ]
    },
    "gate": { "type": "string", "enum": ["governed", "narrowed", "blocked"] },
    "qualification_class": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "consumer_status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": { "type": "string", "enum": ["green", "yellow", "red"] },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "claimed_posture": {
      "type": "string",
      "enum": ["managed", "self_hosted", "regulated", "sovereign"]
    },
    "trust_boundary": {
      "type": "string",
      "enum": ["local_first", "control_plane"]
    },
    "degraded_data_behavior": {
      "type": "string",
      "enum": [
        "live_attested",
        "mirrored_labelled",
        "offline_cached",
        "stale_banner_shown",
        "local_lineage_only"
      ]
    },
    "consumer": {
      "type": "string",
      "enum": [
        "assurance_center",
        "governance_dashboard",
        "capability_inspector",
        "route_inspector",
        "admin_console",
        "help_about",
        "procurement_evaluation",
        "support_export"
      ]
    },
    "gap_kind": {
      "type": "string",
      "enum": [
        "facet_ungoverned",
        "proof_stale",
        "proof_expired",
        "proof_missing",
        "assurance_state_narrowed",
        "assurance_state_blocked"
      ]
    },
    "state_token_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "label", "gate_posture", "effective_floor", "message_id"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "gate_posture": { "$ref": "#/$defs/gate" },
        "effective_floor": { "$ref": "#/$defs/qualification_class" },
        "message_id": { "type": "string", "minLength": 1 }
      }
    },
    "state_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "family_label", "states"],
      "properties": {
        "family": { "$ref": "#/$defs/state_family_token" },
        "family_label": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_token_def" }
        }
      }
    },
    "facet_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet",
        "facet_label",
        "dimension",
        "state_family",
        "current_state_token",
        "current_state_label",
        "state_gate",
        "state_floor",
        "evidence_classes",
        "claimed_postures",
        "trust_boundaries",
        "degraded_data_behavior",
        "owner_role",
        "proof_ref",
        "proof_freshness",
        "status",
        "signal",
        "detail_message_id"
      ],
      "properties": {
        "facet": { "$ref": "#/$defs/facet" },
        "facet_label": { "type": "string", "minLength": 1 },
        "dimension": { "$ref": "#/$defs/dimension" },
        "state_family": { "$ref": "#/$defs/state_family_token" },
        "current_state_token": { "type": "string", "minLength": 1 },
        "current_state_label": { "type": "string", "minLength": 1 },
        "state_gate": { "$ref": "#/$defs/gate" },
        "state_floor": { "$ref": "#/$defs/qualification_class" },
        "evidence_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_class" }
        },
        "claimed_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimed_posture" }
        },
        "trust_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/trust_boundary" }
        },
        "degraded_data_behavior": { "$ref": "#/$defs/degraded_data_behavior" },
        "owner_role": { "type": "string", "minLength": 1 },
        "proof_ref": { "type": "string", "minLength": 1 },
        "proof_freshness": { "$ref": "#/$defs/freshness_state" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "detail_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "facet", "dimension", "gap_kind", "cause_message_id"],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "facet": { "$ref": "#/$defs/facet" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "cause_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "owner_role",
        "claimed_qualification",
        "read_facets",
        "covered_dimensions",
        "disclosed_evidence_classes",
        "claimed_postures",
        "trust_boundaries",
        "proof_refs",
        "effective_qualification",
        "status",
        "signal",
        "gate_decision",
        "gaps",
        "status_message_id",
        "gate_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "claimed_qualification": { "$ref": "#/$defs/qualification_class" },
        "read_facets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/facet" }
        },
        "covered_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "disclosed_evidence_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_class" }
        },
        "claimed_postures": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimed_posture" }
        },
        "trust_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/trust_boundary" }
        },
        "proof_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gate_decision": { "$ref": "#/$defs/gate" },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap" }
        },
        "status_message_id": { "type": "string", "minLength": 1 },
        "gate_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assurance_center_consumes_matrix",
        "governance_dashboard_consumes_matrix",
        "capability_inspector_consumes_matrix",
        "route_inspector_consumes_matrix",
        "admin_console_consumes_matrix",
        "help_about_consumes_matrix",
        "procurement_evaluation_consumes_matrix",
        "support_export_consumes_matrix"
      ],
      "properties": {
        "assurance_center_consumes_matrix": { "type": "boolean" },
        "governance_dashboard_consumes_matrix": { "type": "boolean" },
        "capability_inspector_consumes_matrix": { "type": "boolean" },
        "route_inspector_consumes_matrix": { "type": "boolean" },
        "admin_console_consumes_matrix": { "type": "boolean" },
        "help_about_consumes_matrix": { "type": "boolean" },
        "procurement_evaluation_consumes_matrix": { "type": "boolean" },
        "support_export_consumes_matrix": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_facets",
        "current_facets",
        "stale_facets",
        "expired_facets",
        "missing_facets",
        "total_state_families",
        "total_consumers",
        "certified_consumer_count",
        "narrowed_consumer_count",
        "blocked_consumer_count",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_facets": { "type": "integer", "minimum": 0 },
        "current_facets": { "type": "integer", "minimum": 0 },
        "stale_facets": { "type": "integer", "minimum": 0 },
        "expired_facets": { "type": "integer", "minimum": 0 },
        "missing_facets": { "type": "integer", "minimum": 0 },
        "total_state_families": { "type": "integer", "minimum": 0 },
        "total_consumers": { "type": "integer", "minimum": 0 },
        "certified_consumer_count": { "type": "integer", "minimum": 0 },
        "narrowed_consumer_count": { "type": "integer", "minimum": 0 },
        "blocked_consumer_count": { "type": "integer", "minimum": 0 },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_stable_promotion",
        "blocked_consumers",
        "narrowed_consumers",
        "certified_consumers",
        "drifted_dimensions",
        "gate_message_id"
      ],
      "properties": {
        "blocks_stable_promotion": { "type": "boolean" },
        "blocked_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "narrowed_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "certified_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "drifted_dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
        "gate_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "facets",
        "state_families",
        "evidence_classes",
        "claimed_postures",
        "trust_boundaries",
        "degraded_data_behaviors",
        "consumers",
        "gap_kinds",
        "gate_decisions",
        "freshness_states",
        "qualification_classes"
      ],
      "properties": {
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
        "facets": { "type": "array", "items": { "$ref": "#/$defs/facet" } },
        "state_families": { "type": "array", "items": { "$ref": "#/$defs/state_family_token" } },
        "evidence_classes": { "type": "array", "items": { "$ref": "#/$defs/evidence_class" } },
        "claimed_postures": { "type": "array", "items": { "$ref": "#/$defs/claimed_posture" } },
        "trust_boundaries": { "type": "array", "items": { "$ref": "#/$defs/trust_boundary" } },
        "degraded_data_behaviors": {
          "type": "array",
          "items": { "$ref": "#/$defs/degraded_data_behavior" }
        },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "gap_kinds": { "type": "array", "items": { "$ref": "#/$defs/gap_kind" } },
        "gate_decisions": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness_state" } },
        "qualification_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualification_class" }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_facet_governed_with_proof",
        "every_dimension_covered",
        "every_state_family_referenced",
        "every_consumer_maps_to_facets_and_proof",
        "every_consumer_reads_at_least_one_facet",
        "stale_proof_narrows_deterministically",
        "missing_proof_blocks_stable_promotion",
        "exact_gaps_named_per_consumer",
        "state_vocabulary_bound_to_gate",
        "surfaces_consume_one_matrix",
        "generated_from_checked_in_proofs",
        "controlled_enums_frozen",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "every_facet_governed_with_proof": { "type": "boolean" },
        "every_dimension_covered": { "type": "boolean" },
        "every_state_family_referenced": { "type": "boolean" },
        "every_consumer_maps_to_facets_and_proof": { "type": "boolean" },
        "every_consumer_reads_at_least_one_facet": { "type": "boolean" },
        "stale_proof_narrows_deterministically": { "type": "boolean" },
        "missing_proof_blocks_stable_promotion": { "type": "boolean" },
        "exact_gaps_named_per_consumer": { "type": "boolean" },
        "state_vocabulary_bound_to_gate": { "type": "boolean" },
        "surfaces_consume_one_matrix": { "type": "boolean" },
        "generated_from_checked_in_proofs": { "type": "boolean" },
        "controlled_enums_frozen": { "type": "boolean" },
        "export_carries_no_raw_material": { "type": "boolean" }
      }
    }
  }
}
