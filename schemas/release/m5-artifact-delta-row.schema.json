{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-artifact-delta-row.schema.json",
  "title": "Aureline M5 artifact-class delta row",
  "description": "One artifact-class delta row inside an M5 update-center summary entry. It records, for a single artifact class an update touches, the change kind, the version delta, the signature/provenance verification state, the restart impact, and how live the backing release data is, plus the derived gate and signal those inputs imply. An update-center summary entry carries one row per artifact class it changes so the disclosed artifact classes are never narrower than what the update actually changes. The row carries metadata and refs only: no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "nullable_version": { "type": ["string", "null"] },
    "message_id": {
      "type": "string",
      "pattern": "^release_update_summary\\."
    },
    "artifact_class": {
      "enum": [
        "core_runtime",
        "extension_packs",
        "schema_contracts",
        "workspace_state",
        "configuration",
        "language_runtimes",
        "docs_help_content"
      ]
    },
    "change_kind": { "enum": ["added", "updated", "removed", "unchanged"] },
    "verification_state": {
      "enum": ["verified", "pending", "unverified", "failed", "not_provided"]
    },
    "restart_impact": {
      "enum": ["none", "reload_window", "restart_app", "restart_host"]
    },
    "release_data_state": {
      "enum": ["live", "mirrored", "offline", "stale", "not_provided"]
    },
    "gate": { "enum": ["governed", "narrowed", "blocked"] },
    "signal": { "enum": ["green", "yellow", "red"] }
  },
  "required": [
    "artifact_class",
    "artifact_class_label",
    "change_kind",
    "from_version",
    "to_version",
    "verification_state",
    "restart_impact",
    "release_data_state",
    "gate",
    "signal",
    "detail_message_id"
  ],
  "properties": {
    "artifact_class": { "$ref": "#/$defs/artifact_class" },
    "artifact_class_label": { "$ref": "#/$defs/non_empty_string" },
    "change_kind": { "$ref": "#/$defs/change_kind" },
    "from_version": { "$ref": "#/$defs/nullable_version" },
    "to_version": { "$ref": "#/$defs/nullable_version" },
    "verification_state": { "$ref": "#/$defs/verification_state" },
    "restart_impact": { "$ref": "#/$defs/restart_impact" },
    "release_data_state": { "$ref": "#/$defs/release_data_state" },
    "gate": { "$ref": "#/$defs/gate" },
    "signal": { "$ref": "#/$defs/signal" },
    "detail_message_id": { "$ref": "#/$defs/message_id" }
  }
}
