{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-update-center-summary-object.schema.json",
  "title": "Aureline M5 update-center summary objects",
  "description": "The typed update-center summary objects the release center, update center, and Help/About panel inspect before and after a download. Each artifact family — desktop app, extension, docs pack, policy bundle, framework pack, runtime/toolchain — is summarized in its own entry with the current and target version, an update posture, the rolled-up verification/restart/rollback truth, and the release-data state, plus one artifact-class delta row per artifact class the update touches so the disclosed classes are never narrower than what changes. Rollback is disclosed only for a genuine version rollback, never for a side-by-side fallback or reinstall-only path; mirrored/offline/stale/not-provided release data is labeled explicitly rather than masquerading as live channel truth. The bound consumers derive their effective qualification, gate decision, and coverage gaps from those entries, so all three read this one packet rather than cloning fields locally: a stale entry narrows every consumer that reads it; a not-provided (no live data) or verification-failed entry blocks Stable promotion, with the gap named per family. The packet carries metadata and refs only: no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "channel",
    "entries",
    "families",
    "consumers",
    "consumer_tokens",
    "disclosure",
    "summary",
    "release_gate",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "nullable_version": { "type": ["string", "null"] },
    "message_id": { "type": "string", "pattern": "^release_update_summary\\." },
    "family": {
      "enum": [
        "desktop_app",
        "extension",
        "docs_pack",
        "policy_bundle",
        "framework_pack",
        "runtime_toolchain"
      ]
    },
    "artifact_class": {
      "enum": [
        "core_runtime",
        "extension_packs",
        "schema_contracts",
        "workspace_state",
        "configuration",
        "language_runtimes",
        "docs_help_content"
      ]
    },
    "posture": {
      "enum": ["up_to_date", "available", "downloaded", "staged", "applied", "failed"]
    },
    "verification_state": {
      "enum": ["verified", "pending", "unverified", "failed", "not_provided"]
    },
    "restart_impact": {
      "enum": ["none", "reload_window", "restart_app", "restart_host"]
    },
    "rollback": {
      "enum": [
        "rollback_supported",
        "side_by_side_fallback",
        "reinstall_only",
        "no_rollback"
      ]
    },
    "release_data_state": {
      "enum": ["live", "mirrored", "offline", "stale", "not_provided"]
    },
    "change_kind": { "enum": ["added", "updated", "removed", "unchanged"] },
    "channel": { "enum": ["stable", "beta", "preview", "nightly", "lts"] },
    "profile": { "enum": ["managed", "self_hosted"] },
    "consumer": { "enum": ["release_center", "update_center", "help_about"] },
    "gap_kind": {
      "enum": [
        "verification_pending",
        "verification_unverified",
        "verification_failed",
        "data_stale",
        "data_not_provided"
      ]
    },
    "gate": { "enum": ["governed", "narrowed", "blocked"] },
    "status": { "enum": ["mapped", "provisional", "unmapped"] },
    "signal": { "enum": ["green", "yellow", "red"] },
    "qualification_class": {
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "token_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "delta_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "artifact_class_label",
        "change_kind",
        "from_version",
        "to_version",
        "verification_state",
        "restart_impact",
        "release_data_state",
        "gate",
        "signal",
        "detail_message_id"
      ],
      "properties": {
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "artifact_class_label": { "$ref": "#/$defs/non_empty_string" },
        "change_kind": { "$ref": "#/$defs/change_kind" },
        "from_version": { "$ref": "#/$defs/nullable_version" },
        "to_version": { "$ref": "#/$defs/nullable_version" },
        "verification_state": { "$ref": "#/$defs/verification_state" },
        "restart_impact": { "$ref": "#/$defs/restart_impact" },
        "release_data_state": { "$ref": "#/$defs/release_data_state" },
        "gate": { "$ref": "#/$defs/gate" },
        "signal": { "$ref": "#/$defs/signal" },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "family_label",
        "primary_artifact_class",
        "owner_role",
        "channel",
        "profiles",
        "current_version",
        "target_version",
        "update_available",
        "posture",
        "verification_state",
        "restart_impact",
        "rollback",
        "rollback_disclosed",
        "release_data_state",
        "delta_rows",
        "affected_artifact_classes",
        "gate",
        "status",
        "signal",
        "apply_ready",
        "summary_message_id",
        "detail_message_id"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/family" },
        "family_label": { "$ref": "#/$defs/non_empty_string" },
        "primary_artifact_class": { "$ref": "#/$defs/artifact_class" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "channel": { "$ref": "#/$defs/channel" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/profile" }
        },
        "current_version": { "$ref": "#/$defs/non_empty_string" },
        "target_version": { "$ref": "#/$defs/non_empty_string" },
        "update_available": { "type": "boolean" },
        "posture": { "$ref": "#/$defs/posture" },
        "verification_state": { "$ref": "#/$defs/verification_state" },
        "restart_impact": { "$ref": "#/$defs/restart_impact" },
        "rollback": { "$ref": "#/$defs/rollback" },
        "rollback_disclosed": { "type": "boolean" },
        "release_data_state": { "$ref": "#/$defs/release_data_state" },
        "delta_rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/delta_row" }
        },
        "affected_artifact_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_class" }
        },
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "apply_ready": { "type": "boolean" },
        "summary_message_id": { "$ref": "#/$defs/message_id" },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "family", "artifact_class", "gap_kind", "cause_message_id"],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "family": { "$ref": "#/$defs/family" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "cause_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "owner_role",
        "claimed_qualification",
        "read_families",
        "disclosed_artifact_classes",
        "channels",
        "profiles",
        "effective_qualification",
        "status",
        "signal",
        "gate_decision",
        "gaps",
        "status_message_id",
        "gate_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "claimed_qualification": { "$ref": "#/$defs/qualification_class" },
        "read_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/family" }
        },
        "disclosed_artifact_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_class" }
        },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gate_decision": { "$ref": "#/$defs/gate" },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
        "status_message_id": { "$ref": "#/$defs/message_id" },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    }
  },
  "properties": {
    "record_kind": { "const": "m5_update_center_summary" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "$ref": "#/$defs/non_empty_string" },
    "channel": { "$ref": "#/$defs/channel" },
    "entries": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/entry" }
    },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "consumer_tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer" }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_center_consumes_summary",
        "update_center_consumes_summary",
        "help_about_consumes_summary"
      ],
      "properties": {
        "release_center_consumes_summary": { "const": true },
        "update_center_consumes_summary": { "const": true },
        "help_about_consumes_summary": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_entries",
        "update_available_count",
        "up_to_date_count",
        "governed_entries",
        "narrowed_entries",
        "blocked_entries",
        "total_delta_rows",
        "total_consumers",
        "certified_consumer_count",
        "narrowed_consumer_count",
        "blocked_consumer_count",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_entries": { "type": "integer", "minimum": 0 },
        "update_available_count": { "type": "integer", "minimum": 0 },
        "up_to_date_count": { "type": "integer", "minimum": 0 },
        "governed_entries": { "type": "integer", "minimum": 0 },
        "narrowed_entries": { "type": "integer", "minimum": 0 },
        "blocked_entries": { "type": "integer", "minimum": 0 },
        "total_delta_rows": { "type": "integer", "minimum": 0 },
        "total_consumers": { "type": "integer", "minimum": 0 },
        "certified_consumer_count": { "type": "integer", "minimum": 0 },
        "narrowed_consumer_count": { "type": "integer", "minimum": 0 },
        "blocked_consumer_count": { "type": "integer", "minimum": 0 },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_stable_promotion",
        "blocked_consumers",
        "narrowed_consumers",
        "certified_consumers",
        "affected_families",
        "gate_message_id"
      ],
      "properties": {
        "blocks_stable_promotion": { "type": "boolean" },
        "blocked_consumers": { "$ref": "#/$defs/token_array" },
        "narrowed_consumers": { "$ref": "#/$defs/token_array" },
        "certified_consumers": { "$ref": "#/$defs/token_array" },
        "affected_families": { "$ref": "#/$defs/token_array" },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families",
        "artifact_classes",
        "postures",
        "verification_states",
        "restart_impacts",
        "rollback_availabilities",
        "release_data_states",
        "channels",
        "profiles",
        "consumers",
        "gap_kinds",
        "gate_decisions"
      ],
      "properties": {
        "families": { "$ref": "#/$defs/token_array" },
        "artifact_classes": { "$ref": "#/$defs/token_array" },
        "postures": { "$ref": "#/$defs/token_array" },
        "verification_states": { "$ref": "#/$defs/token_array" },
        "restart_impacts": { "$ref": "#/$defs/token_array" },
        "rollback_availabilities": { "$ref": "#/$defs/token_array" },
        "release_data_states": { "$ref": "#/$defs/token_array" },
        "channels": { "$ref": "#/$defs/token_array" },
        "profiles": { "$ref": "#/$defs/token_array" },
        "consumers": { "$ref": "#/$defs/token_array" },
        "gap_kinds": { "$ref": "#/$defs/token_array" },
        "gate_decisions": { "$ref": "#/$defs/token_array" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_family_summarized",
        "every_entry_discloses_its_delta_rows",
        "affected_classes_match_delta_rows",
        "verification_state_disclosed_per_class",
        "restart_and_rollback_truth_disclosed",
        "rollback_never_overclaimed",
        "stale_or_mirrored_data_labelled_not_masqueraded",
        "not_provided_data_blocks_stable_promotion",
        "consumers_read_one_summary",
        "consumer_verdict_derived_from_entries",
        "controlled_enums_frozen",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "every_family_summarized": { "const": true },
        "every_entry_discloses_its_delta_rows": { "const": true },
        "affected_classes_match_delta_rows": { "const": true },
        "verification_state_disclosed_per_class": { "const": true },
        "restart_and_rollback_truth_disclosed": { "const": true },
        "rollback_never_overclaimed": { "const": true },
        "stale_or_mirrored_data_labelled_not_masqueraded": { "const": true },
        "not_provided_data_blocks_stable_promotion": { "const": true },
        "consumers_read_one_summary": { "const": true },
        "consumer_verdict_derived_from_entries": { "const": true },
        "controlled_enums_frozen": { "const": true },
        "export_carries_no_raw_material": { "const": true }
      }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  }
}
