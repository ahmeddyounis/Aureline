{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-historical-evidence-surface-certification.schema.json",
  "title": "Aureline M5 historical-evidence surface certification packet",
  "description": "M05-1255 closing B149 capstone certifying that the frozen M5 non-live-evidence object classes (retirement snapshot, support / export evidence, archived runbook packet, imported / offline route evidence, review / incident snapshot) hold their non-live-evidence truth on every claimed M5 support, retirement, incident, review, and export surface. Keyed on the claimed profile (current non-live-evidence lane, reviewable snapshot-record structure, disclosed imported / offline-partial profile, unverified live-target profile, unverified expiry / removal-ledger profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and non-live-evidence-truth behavior — and either passes (green), auto-narrows its non-live-evidence claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a current, fully-attributed non-live-evidence lane whose snapshot label, capture time, provenance, mutation-blocked posture, and validated live-target handoff (or metadata-only exit) all converge on one current, export-safe, internally consistent non-live-evidence record may certify a certified non-live-evidence record; and every B149 hard invariant must hold (no archived or imported / offline evidence looks live, writable, or current by omission; no live target is reopened from a snapshot without validating identity, trust, route, and authority; no expired / removed artifact is dead-linked when metadata, provenance, or cleanup state can be shown; no non-live evidence is left unjoined to capture time, provenance, retention / removal state, or any current live-target mismatch; and no snapshot or imported / offline packet is presented as a current live object or reopened through an ambiguous route). Every row cites exactly one canonical historical-reference matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_historical_evidence_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/support/m5-historical-evidence/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "current_non_live_evidence_lane",
        "reviewable_snapshot_record_structure",
        "disclosed_imported_offline_partial_profile",
        "unverified_live_target_profile",
        "unverified_expiry_removal_ledger_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "non_live_evidence_truth"
      ]
    },
    "historical_evidence_claim": {
      "enum": [
        "certified_non_live_evidence",
        "reviewable_snapshot_record",
        "imported_offline_disclosed_projection",
        "live_target_unverified_projection",
        "expiry_removal_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "retirement_snapshot",
        "support_export_evidence",
        "archived_runbook_packet",
        "imported_offline_route_evidence",
        "review_incident_snapshot"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "archived_snapshot_shown_as_live",
        "imported_offline_evidence_shown_as_current",
        "mutation_allowed_on_non_live_evidence",
        "live_target_reopened_without_validation",
        "snapshot_label_missing",
        "capture_time_missing",
        "provenance_unattributed",
        "live_target_availability_unstated",
        "expired_artifact_dead_linked",
        "removal_state_unstated",
        "evidence_unjoined_from_capture_context",
        "historical_reference_descriptor_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lets_archived_or_imported_evidence_look_live_writable_or_current_by_omission",
        "reopens_a_live_target_from_a_snapshot_without_validating_identity_trust_route_and_authority",
        "dead_links_an_expired_or_removed_artifact_instead_of_showing_metadata_provenance_or_cleanup_state",
        "leaves_non_live_evidence_unjoined_to_capture_time_provenance_retention_state_or_live_target_mismatch",
        "presents_a_snapshot_or_imported_packet_as_a_current_live_object_or_reopens_through_an_ambiguous_route"
      ],
      "properties": {
        "lets_archived_or_imported_evidence_look_live_writable_or_current_by_omission": { "const": false },
        "reopens_a_live_target_from_a_snapshot_without_validating_identity_trust_route_and_authority": { "const": false },
        "dead_links_an_expired_or_removed_artifact_instead_of_showing_metadata_provenance_or_cleanup_state": { "const": false },
        "leaves_non_live_evidence_unjoined_to_capture_time_provenance_retention_state_or_live_target_mismatch": { "const": false },
        "presents_a_snapshot_or_imported_packet_as_a_current_live_object_or_reopens_through_an_ambiguous_route": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/historical_evidence_claim" },
        "to_claim": { "$ref": "#/$defs/historical_evidence_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_historical_evidence_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/historical_evidence_claim" },
        "certified_claim": { "$ref": "#/$defs/historical_evidence_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/support/m5-historical-evidence/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
