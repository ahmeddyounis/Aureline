{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-supported-line-surface-certification.schema.json",
  "title": "Aureline M5 supported-line surface certification packet",
  "description": "M05-1237 closing B147 capstone certifying that the frozen M5 supported-line proof objects (public-proof ledger, transparency report, migration scoreboard, ORR-history event, correction-train archive) hold their durable-proof truth on every claimed M5 supported line. Keyed on the claimed profile (live supported-line operating lane, reviewable transparency structure, disclosed correction-archive profile, unverified migration-scoreboard profile, unverified ORR-history profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and supported-line-proof-truth behavior — and either passes (green), auto-narrows its operating claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party supported-line operating lane with current, export-safe, and internally consistent durable proof may certify a certified operating line; and every B147 hard invariant must hold (no claim widens because a report once existed without current freshness; no line stays green on stale external proof or opaque upstream health; no internal-only incident or security detail leaks into a public-safe feed; no public-proof / migration / history is left unjoined to build and release-line identity; and no migration pain / ORR / correction history is left unretained). Every row cites exactly one canonical supported-line-transparency proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_supported_line_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-supported-line-transparency/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_supported_line_operating_lane",
        "reviewable_transparency_structure",
        "disclosed_correction_archive_profile",
        "unverified_migration_scoreboard_profile",
        "unverified_orr_history_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "supported_line_proof_truth"
      ]
    },
    "supported_line_claim": {
      "enum": [
        "certified_operating_line",
        "reviewable_transparency_surface",
        "correction_archive_disclosed_projection",
        "migration_scoreboard_unverified_projection",
        "orr_history_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "proof_object": {
      "enum": [
        "public_proof_ledger",
        "transparency_report",
        "migration_scoreboard",
        "orr_history_event",
        "correction_train_archive"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "widened_claim_on_stale_public_proof",
        "widened_claim_without_current_transparency_report",
        "leaked_internal_detail_into_public_proof",
        "left_migration_pain_unscored",
        "implied_green_while_proof_or_archive_was_stale",
        "ran_support_language_ahead_of_public_proof",
        "freshness_window_unstated",
        "export_class_unstated",
        "line_association_unstated",
        "registry_reference_unstated",
        "orr_history_unretained",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widens_a_claim_because_a_report_once_existed_without_current_freshness",
        "stays_green_on_stale_external_proof_or_opaque_upstream_health",
        "leaks_internal_only_incident_or_security_detail_into_public_safe_feeds",
        "leaves_public_proof_migration_or_history_unjoined_to_build_and_release_line_identity",
        "leaves_migration_pain_or_orr_and_correction_history_unretained"
      ],
      "properties": {
        "widens_a_claim_because_a_report_once_existed_without_current_freshness": { "const": false },
        "stays_green_on_stale_external_proof_or_opaque_upstream_health": { "const": false },
        "leaks_internal_only_incident_or_security_detail_into_public_safe_feeds": { "const": false },
        "leaves_public_proof_migration_or_history_unjoined_to_build_and_release_line_identity": { "const": false },
        "leaves_migration_pain_or_orr_and_correction_history_unretained": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/supported_line_claim" },
        "to_claim": { "$ref": "#/$defs/supported_line_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_supported_line_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/supported_line_claim" },
        "certified_claim": { "$ref": "#/$defs/supported_line_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/proof_object" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-supported-line-transparency/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
