{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-verified-input-manifest-and-sidecar-completeness-registries.schema.json",
  "title": "Aureline M5 verified-input-manifest and sidecar-completeness-manifest registries",
  "description": "Export-safe packet for the input-materialization and sidecar-completeness implement lane over the frozen M5 build-lane-trust matrix. It carries resolved, honest projections of the verified-input-manifest domain (how a lane captures the build-config digest, the materialized-input receipt, the input provenance ledger, the verification authority it is bounded to, the artifact families it expects, the hermetic-input posture, and the re-materialization rule so an unverified or non-materialized input never silently enters a protected lane) and the sidecar-completeness-manifest domain (how a release or emergency-hotfix lane proves that binaries, packages, docs packs, schemas, SBOMs, symbols, source maps, and rollback metadata are all present and bound to one exact build identity, so a missing or mismatched sidecar is a blocker rather than a warning) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved verified-input-manifest entries (naming a canonical registry token, a stable lane-binding ID, a build-lane-trust role, a classified input source, a published build-config digest / materialized-input receipt / input provenance ledger / verification authority / expected artifact families / hermetic-input posture / re-materialization rule, and canonical/accessible/audit resolution-form coverage while bounding its verification authority so an unverified input never enters a protected lane and disclosing the input-trust marker before a trust-risk input is admitted) and resolved sidecar-completeness-manifest entries (naming a canonical registry token, a stable manifest-ref, a build-lane-trust role, a classified convergence scope, and the complete build-identity / claimed-families / sidecar-ledger / binding-identity / missing-or-mismatched / attestation / last-convergence-revision sidecar-completeness object). Hard invariants forbid letting a green build omit a claimed artifact family or sidecar, binding a claimed sidecar to a different build identity, treating a missing or mismatched sidecar as warning-only, and admitting an unverified or non-materialized input into a protected lane. Acceptance criteria — every lane exposes a typed manifest with build-config-digest, receipt, and verification boundaries; attempting to admit an unverified input into a protected lane fails with a structured blocker reason; and claimed release artifacts and required sidecars converge on one exact-build descriptor — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_verified_input_manifest_and_sidecar_completeness_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "build_lane_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "build_lane_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "verified_input_manifest_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "lane_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion",
        "input_source",
        "input_source_is_classified",
        "canonical_input_source_mode",
        "surface_context",
        "build_config_digest",
        "materialized_input_receipt",
        "input_provenance_ledger",
        "verification_authority",
        "expected_artifact_families",
        "hermetic_input_posture",
        "re_materialization_rule",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "verified_input_manifest_object_complete",
        "bound_to_registry",
        "input_admission_bounded",
        "is_trust_risk_source",
        "input_trust_disclosed",
        "degrade_reason",
        "next_action",
        "manifest_resolves_across_lanes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "lane_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion": { "type": "boolean" },
        "input_source": { "$ref": "#/$defs/non_empty_string" },
        "input_source_is_classified": { "type": "boolean" },
        "canonical_input_source_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "build_config_digest": { "type": "string" },
        "materialized_input_receipt": { "type": "string" },
        "input_provenance_ledger": { "type": "string" },
        "verification_authority": { "type": "string" },
        "expected_artifact_families": { "type": "string" },
        "hermetic_input_posture": { "type": "string" },
        "re_materialization_rule": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "verified_input_manifest_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "input_admission_bounded": { "type": "boolean" },
        "is_trust_risk_source": { "type": "boolean" },
        "input_trust_disclosed": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "manifest_resolves_across_lanes": { "type": "boolean" }
      }
    },
    "sidecar_completeness_manifest_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "manifest_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion",
        "convergence_scope",
        "convergence_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_build_identity",
        "claimed_artifact_families",
        "sidecar_family_ledger",
        "binding_identity_check",
        "missing_or_mismatched_reference",
        "attestation_state",
        "last_convergence_revision",
        "keeps_family_ledger_visible",
        "manifest_is_truthful",
        "missing_family_present",
        "missing_family_flagged",
        "mismatched_identity_present",
        "mismatched_identity_flagged",
        "sidecar_family_stays_converged",
        "provides_complete_sidecar_completeness",
        "degrade_reason",
        "next_action",
        "manifest_safe_on_every_lane"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "manifest_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion": { "type": "boolean" },
        "convergence_scope": { "$ref": "#/$defs/non_empty_string" },
        "convergence_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_build_identity": { "type": "string" },
        "claimed_artifact_families": { "type": "string" },
        "sidecar_family_ledger": { "type": "string" },
        "binding_identity_check": { "type": "string" },
        "missing_or_mismatched_reference": { "type": "string" },
        "attestation_state": { "type": "string" },
        "last_convergence_revision": { "type": "string" },
        "keeps_family_ledger_visible": { "type": "boolean" },
        "manifest_is_truthful": { "type": "boolean" },
        "missing_family_present": { "type": "boolean" },
        "missing_family_flagged": { "type": "boolean" },
        "mismatched_identity_present": { "type": "boolean" },
        "mismatched_identity_flagged": { "type": "boolean" },
        "sidecar_family_stays_converged": { "type": "boolean" },
        "provides_complete_sidecar_completeness": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "manifest_safe_on_every_lane": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "verified_input_manifest_entries",
        "sidecar_completeness_manifest_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "lets_a_green_build_omit_a_claimed_artifact_family_or_sidecar",
        "binds_a_claimed_sidecar_to_a_different_build_identity",
        "treats_a_missing_or_mismatched_sidecar_as_warning_only",
        "admits_an_unverified_or_non_materialized_input_into_a_protected_lane"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
