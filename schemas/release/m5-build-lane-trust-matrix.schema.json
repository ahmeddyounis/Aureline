{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-build-lane-trust-matrix.schema.json",
  "title": "Aureline M5 build-farm, cache-trust, clean-room-rebuild, and exact-build-supportability matrix",
  "description": "Export-safe packet freezing Aureline's concrete build-lane trust domains, remote-cache discipline, clean-room rebuild proof, and exact-build supportability. The packet names every claimed M5 release lane — the contributor / PR lane, the protected-merge lane, the release lane, and the emergency-hotfix lane — and binds each governed lane to the claimed surface families that render it (release-center, shiproom, diagnostics, admin, docs/help, support-export), the build contexts it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each lane declares the controlled vocabularies it carries: the single controlled build-lane-trust-role vocabulary consumers bind to (cache_posture, publication_authority, credential_boundary, hermetic_input, reproducibility_proof, artifact_convergence, support_identity), plus lane-specific contributor / PR roles, protected-merge roles, release roles, and emergency-hotfix roles. Hard invariants forbid letting a PR cache publish release artifacts, treating a remote-cache hit as reproducibility proof, letting docs / schema / SBOM / symbol sidecars drift from the binary build identity, overclaiming clean-room parity when only partial artifact classes were rebuilt, and hiding non-hermetic inputs, cache poisoning, or unreplayable artifacts behind green publication rows. The matrix binds back to the already-landed artifact-publication and reproducible-RC packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "build_lane_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_build_farm_cache_trust_clean_room_rebuild_and_exact_build_supportability_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "build_lane_rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/build_lane_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "build_lane_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "build_lane_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "build_lane_family": {
      "enum": [
        "contributor_pr",
        "protected_merge",
        "release",
        "emergency_hotfix"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "cache_posture",
        "publication_authority",
        "credential_boundary",
        "hermetic_input",
        "reproducibility_proof",
        "artifact_convergence",
        "support_identity"
      ]
    },
    "build_lane_row": {
      "type": "object",
      "required": [
        "build_lane_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "pr_caches_publish_release_artifacts",
        "treats_remote_cache_hits_as_reproducibility_proof",
        "lets_docs_schema_sbom_or_symbol_sidecars_drift_from_binary_build_identity",
        "overclaims_clean_room_parity_when_only_partial_artifact_classes_were_rebuilt",
        "hides_non_hermetic_inputs_cache_poisoning_or_unreplayable_artifacts_behind_green_publication_rows"
      ],
      "properties": {
        "build_lane_family": {
          "$ref": "#/$defs/build_lane_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "contributor_pr_roles": {
          "type": "array"
        },
        "protected_merge_roles": {
          "type": "array"
        },
        "release_roles": {
          "type": "array"
        },
        "emergency_hotfix_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "pr_caches_publish_release_artifacts": {
          "const": false
        },
        "treats_remote_cache_hits_as_reproducibility_proof": {
          "const": false
        },
        "lets_docs_schema_sbom_or_symbol_sidecars_drift_from_binary_build_identity": {
          "const": false
        },
        "overclaims_clean_room_parity_when_only_partial_artifact_classes_were_rebuilt": {
          "const": false
        },
        "hides_non_hermetic_inputs_cache_poisoning_or_unreplayable_artifacts_behind_green_publication_rows": {
          "const": false
        }
      }
    }
  }
}
