{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-clean-room-rebuild-lane-and-artifact-diff-packet-registries.schema.json",
  "title": "Aureline M5 clean-room-rebuild-lane and artifact-diff-packet registries",
  "description": "Export-safe packet for the input-materialization and artifact-diff implement lane over the frozen M5 build-lane-trust matrix. It carries resolved, honest projections of the clean-room-rebuild-lane domain (how a lane captures the build-config digest, the materialized-input receipt, the input provenance ledger, the verification authority it is bounded to, the artifact families it expects, the hermetic-input posture, and the re-materialization rule so an unverified or non-materialized input never silently enters a protected lane) and the artifact-diff-packet domain (how a release or emergency-hotfix lane proves that binaries, packages, docs packs, schemas, SBOMs, symbols, source maps, and rollback metadata are all present and bound to one exact build identity, so a missing or mismatched sidecar is a blocker rather than a warning) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved clean-room-rebuild-lane entries (naming a canonical registry token, a stable lane-binding ID, a build-lane-trust role, a classified input source, a published build-config digest / materialized-input receipt / input provenance ledger / verification authority / expected artifact families / hermetic-input posture / re-materialization rule, and canonical/accessible/audit resolution-form coverage while bounding its verification authority so an unverified input never enters a protected lane and disclosing the input-trust marker before a trust-risk input is admitted) and resolved artifact-diff-packet entries (naming a canonical registry token, a stable manifest-ref, a build-lane-trust role, a classified convergence scope, and the complete build-identity / claimed-families / sidecar-ledger / binding-identity / missing-or-mismatched / attestation / last-convergence-revision artifact-diff object). Hard invariants forbid letting a green build omit a claimed artifact family or sidecar, binding a claimed sidecar to a different build identity, treating a missing or mismatched sidecar as warning-only, and admitting an unverified or non-materialized input into a protected lane. Acceptance criteria — every lane exposes a typed manifest with build-config-digest, receipt, and verification boundaries; attempting to admit an unverified input into a protected lane fails with a structured blocker reason; and claimed release artifacts and required sidecars converge on one exact-build descriptor — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_clean_room_rebuild_lane_and_artifact_diff_packet_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "build_lane_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "build_lane_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "clean_room_rebuild_lane_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "lane_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion",
