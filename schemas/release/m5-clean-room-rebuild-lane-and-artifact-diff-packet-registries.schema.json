        "clean_room_rebuild_lane_entries",
        "artifact_diff_packet_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "overclaims_clean_room_parity_on_a_partial_artifact_family_rebuild",
        "lets_a_clean_room_rebuild_rely_on_a_shared_remote_cache_as_authority",
