        "candidate_vs_rebuild_check",
        "divergence_or_missing_reference",
        "attestation_state",
        "last_diff_revision",
        "keeps_diff_ledger_visible",
        "packet_is_truthful",
        "omitted_family_present",
        "omitted_family_flagged",
        "material_divergence_present",
        "material_divergence_flagged",
        "artifact_diff_stays_deterministic",
        "provides_complete_artifact_diff",
        "degrade_reason",
        "next_action",
        "packet_safe_on_every_lane"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "diff_packet_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion": { "type": "boolean" },
        "diff_scope": { "$ref": "#/$defs/non_empty_string" },
        "diff_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_build_identity": { "type": "string" },
        "compared_artifact_families": { "type": "string" },
        "deterministic_diff_ledger": { "type": "string" },
        "candidate_vs_rebuild_check": { "type": "string" },
        "divergence_or_missing_reference": { "type": "string" },
        "attestation_state": { "type": "string" },
        "last_diff_revision": { "type": "string" },
        "keeps_diff_ledger_visible": { "type": "boolean" },
        "packet_is_truthful": { "type": "boolean" },
        "omitted_family_present": { "type": "boolean" },
        "omitted_family_flagged": { "type": "boolean" },
        "material_divergence_present": { "type": "boolean" },
        "material_divergence_flagged": { "type": "boolean" },
        "artifact_diff_stays_deterministic": { "type": "boolean" },
        "provides_complete_artifact_diff": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
