        "expected_artifact_families",
        "hermetic_rebuild_posture",
        "shared_cache_isolation_rule",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "clean_room_rebuild_lane_object_complete",
        "bound_to_registry",
        "rebuild_authority_bounded",
        "is_replay_trust_risk_source",
        "cache_trust_disclosed",
        "degrade_reason",
        "next_action",
        "lane_resolves_across_lanes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "lane_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion": { "type": "boolean" },
        "rebuild_source": { "$ref": "#/$defs/non_empty_string" },
        "rebuild_source_is_classified": { "type": "boolean" },
        "canonical_rebuild_source_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "rebuild_config_digest": { "type": "string" },
        "replay_receipt": { "type": "string" },
        "protected_input_ledger": { "type": "string" },
        "rebuild_authority": { "type": "string" },
        "expected_artifact_families": { "type": "string" },
        "hermetic_rebuild_posture": { "type": "string" },
        "shared_cache_isolation_rule": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "clean_room_rebuild_lane_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "rebuild_authority_bounded": { "type": "boolean" },
        "is_replay_trust_risk_source": { "type": "boolean" },
        "cache_trust_disclosed": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "lane_resolves_across_lanes": { "type": "boolean" }
      }
    },
    "artifact_diff_packet_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "diff_packet_ref",
        "token_name",
        "semantic_role",
