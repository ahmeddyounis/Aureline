{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-constrained-object-surface-certification.schema.json",
  "title": "Aureline M5 constrained-object surface certification packet",
  "description": "M05-1264 closing B150 capstone certifying that the frozen M5 constrained-current-object classes (read-only, generated, policy-locked, managed, projection, captured-snapshot) hold their constrained-object truth on every claimed M5 editor, review, save, AI, repair, and export surface. Keyed on the claimed consumer profile (fully-classified constrained-object lane, reviewable constrained-state record structure, disclosed generated-divergence-partial profile, unverified canonical-source profile, unverified write-target-review profile, unverified actor-parity profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and constrained-object-truth behavior — and either passes (green), auto-narrows its constrained-object claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a fully-classified constrained-object lane whose state badge, blocked-write reason, canonical-source relation, exact write target, and reviewed safe-next-step all converge on one export-safe, internally consistent record may certify a certified constrained-object record; and every B150 hard invariant must hold (no constrained-state class hides another when both materially affect behavior; no generated, managed, projection, or archived object silently falls back to a lossy direct write; no AI, automation, import, or repair flow gets a hidden bypass around the constrained-state rules; the canonical source, exact write target, preserved-versus-lost sync, and recovery / regenerate path stay stated; and no constrained object is presented as directly writable or has its recovery / regenerate path hidden). Every row cites exactly one canonical constrained-file-state matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_constrained_object_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/support/m5-constrained-object-state/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "certified_constrained_object_lane",
        "reviewable_constrained_record_structure",
        "disclosed_generated_divergence_partial_profile",
        "unverified_canonical_source_profile",
        "unverified_write_target_review_profile",
        "unverified_actor_parity_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "constrained_object_truth"
      ]
    },
    "constrained_object_claim": {
      "enum": [
        "certified_constrained_object_truth",
        "reviewable_constrained_state_record",
        "generated_divergence_disclosed_projection",
        "canonical_source_unverified_projection",
        "write_target_review_unverified_projection",
        "actor_parity_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "read_only",
        "generated",
        "policy_locked",
        "managed",
        "projection",
        "captured_snapshot"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "constrained_object_shown_as_writable",
        "one_state_class_hides_another",
        "silent_lossy_direct_write_fallback",
        "ai_automation_bypassed_constraint",
        "state_badge_missing",
        "blocked_write_reason_missing",
        "canonical_source_unstated",
        "exact_write_target_unstated",
        "nearest_safe_action_missing",
        "preserved_versus_lost_sync_unstated",
        "recovery_or_regenerate_path_missing",
        "constrained_file_state_descriptor_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lets_one_constrained_state_class_hide_another_when_both_materially_affect_behavior",
        "lets_generated_managed_projection_or_archived_objects_silently_fall_back_to_lossy_direct_write",
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass_around_constrained_state_rules",
        "leaves_canonical_source_exact_write_target_preserved_versus_lost_sync_or_recovery_path_unstated",
        "presents_a_constrained_object_as_directly_writable_or_hides_the_recovery_or_regenerate_path"
      ],
      "properties": {
        "lets_one_constrained_state_class_hide_another_when_both_materially_affect_behavior": { "const": false },
        "lets_generated_managed_projection_or_archived_objects_silently_fall_back_to_lossy_direct_write": { "const": false },
        "gives_ai_automation_import_or_repair_flows_a_hidden_bypass_around_constrained_state_rules": { "const": false },
        "leaves_canonical_source_exact_write_target_preserved_versus_lost_sync_or_recovery_path_unstated": { "const": false },
        "presents_a_constrained_object_as_directly_writable_or_hides_the_recovery_or_regenerate_path": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/constrained_object_claim" },
        "to_claim": { "$ref": "#/$defs/constrained_object_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_constrained_object_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/constrained_object_claim" },
        "certified_claim": { "$ref": "#/$defs/constrained_object_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/support/m5-constrained-object-state/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
