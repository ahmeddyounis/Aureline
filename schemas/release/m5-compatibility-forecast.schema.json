{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-compatibility-forecast.schema.json",
  "title": "Aureline M5 compatibility-forecast sheet",
  "description": "The typed per-subject compatibility forecast the update center, migration assistant, release center, admin console, and support export inspect before restart or rollout widening to see how a staged M5 update drifts the qualified subjects — certified archetypes, extension SDK / manifest ranges, remote-agent skew, and public export / schema readers — on the stable / beta / preview / LTS lines. Each subject gets one forecast carrying one line forecast per compatibility line, each with a drift class (that deliberately distinguishes a compatible-within-window forecast from a breaking drift) and a forecast confidence that labels unknown inputs and — the lane's guardrail — subjects outside Aureline's claimed window honestly: a line's gate is the drift gate capped by its confidence, so a breaking drift forecast on speculative or out-of-window inputs is flagged for review rather than raised as a hard failure. Every narrowed or held subject carries at least one actionable migration-assistant task row, suppressible only with a recorded rationale where its policy requires one. The bound consumers derive their review readiness and gaps from those forecasts, so all of them read this one sheet rather than cloning drift fields locally. The packet carries metadata, refs, and message ids only: no credential bodies or raw provider payloads, so it is exportable and reviewable outside the app without forcing an immediate restart.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "target",
    "subjects",
    "subject_families",
    "migration_tasks",
    "consumers",
    "consumer_tokens",
    "disclosure",
    "summary",
    "coverage",
    "release_gate",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "nullable_string": { "type": ["string", "null"] },
    "message_id": { "type": "string", "pattern": "^release_compat_forecast\\." },
    "nullable_message_id": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/message_id" }]
    },
    "subject": {
      "enum": [
        "certified_archetype",
        "extension_sdk_range",
        "extension_manifest_range",
        "remote_agent_skew",
        "public_export_reader",
        "public_schema_reader"
      ]
    },
    "line": { "enum": ["stable", "beta", "preview", "lts"] },
    "channel": { "enum": ["stable", "beta", "preview", "nightly", "lts"] },
    "artifact_class": {
      "enum": [
        "core_runtime",
        "extension_packs",
        "schema_contracts",
        "workspace_state",
        "configuration",
        "language_runtimes",
        "docs_help_content"
      ]
    },
    "profile": { "enum": ["managed", "self_hosted"] },
    "drift_class": {
      "enum": [
        "no_drift",
        "compatible_within_window",
        "deprecation_scheduled",
        "migration_required",
        "breaking_drift"
      ]
    },
    "confidence": {
      "enum": [
        "qualified",
        "likely",
        "estimated",
        "unknown",
        "outside_claimed_window",
        "not_applicable"
      ]
    },
    "task_class": {
      "enum": [
        "no_action_required",
        "archetype_revalidation",
        "extension_sdk_range_bump",
        "extension_manifest_update",
        "remote_helper_upgrade",
        "export_reader_migration",
        "schema_reader_migration"
      ]
    },
    "auto_fix": {
      "enum": [
        "not_applicable",
        "auto_fix_available",
        "assisted_fix",
        "manual_only",
        "admin_required"
      ]
    },
    "due_boundary": {
      "enum": [
        "not_required",
        "before_apply",
        "before_restart",
        "before_rollout_widening",
        "before_next_stable_line",
        "before_end_of_support"
      ]
    },
    "skip_policy": {
      "enum": [
        "auto_resolved",
        "optional_recommended",
        "skippable_with_rationale",
        "not_skippable"
      ]
    },
    "rollback_guidance": {
      "enum": [
        "not_applicable",
        "rollback_supported",
        "pin_current_version",
        "side_by_side_fallback",
        "reinstall_only",
        "no_rollback"
      ]
    },
    "action": { "enum": ["pin", "postpone", "side_by_side", "validator", "repair"] },
    "review_readiness": {
      "enum": ["clear_to_widen", "review_before_widening", "hold_before_widening"]
    },
    "gap_kind": {
      "enum": [
        "review_before_widening",
        "forecast_input_unknown",
        "outside_claimed_window",
        "resolve_before_widening",
        "subject_not_forecast"
      ]
    },
    "gate": { "enum": ["governed", "narrowed", "blocked"] },
    "status": { "enum": ["mapped", "provisional", "unmapped"] },
    "signal": { "enum": ["green", "yellow", "red"] },
    "forecast_basis": {
      "enum": [
        "release_evidence_only",
        "release_and_local_scan",
        "local_scan_only",
        "mirror_import_preflight",
        "support_reconstruction"
      ]
    },
    "ref_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "token_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "line_forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "drift_class",
        "confidence",
        "speculative",
        "outside_claimed_window",
        "supported_from",
        "supported_to",
        "gate",
        "readiness",
        "signal",
        "forecast_message_id"
      ],
      "properties": {
        "line": { "$ref": "#/$defs/line" },
        "drift_class": { "$ref": "#/$defs/drift_class" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "speculative": { "type": "boolean" },
        "outside_claimed_window": { "type": "boolean" },
        "supported_from": { "$ref": "#/$defs/nullable_string" },
        "supported_to": { "$ref": "#/$defs/nullable_string" },
        "gate": { "$ref": "#/$defs/gate" },
        "readiness": { "$ref": "#/$defs/review_readiness" },
        "signal": { "$ref": "#/$defs/signal" },
        "forecast_message_id": { "$ref": "#/$defs/message_id" }
      },
      "allOf": [
        {
          "comment": "Guardrail: a speculative / out-of-window line forecast is never a hard failure.",
          "if": {
            "properties": {
              "confidence": {
                "enum": ["estimated", "unknown", "outside_claimed_window"]
              }
            },
            "required": ["confidence"]
          },
          "then": { "properties": { "gate": { "not": { "const": "blocked" } } } }
        }
      ]
    },
    "subject_forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "subject_label",
        "subject_id",
        "primary_artifact_class",
        "owner_role",
        "within_claimed_window",
        "line_forecasts",
        "affected_artifact_classes",
        "affected_profiles",
        "evidence_refs",
        "speculative",
        "worst_gate",
        "readiness",
        "status",
        "signal",
        "requires_pre_rollout_resolution",
        "requires_migration_task",
        "out_of_window_message_id",
        "summary_message_id",
        "detail_message_id"
      ],
      "properties": {
        "subject": { "$ref": "#/$defs/subject" },
        "subject_label": { "$ref": "#/$defs/non_empty_string" },
        "subject_id": { "$ref": "#/$defs/non_empty_string" },
        "primary_artifact_class": { "$ref": "#/$defs/artifact_class" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "within_claimed_window": { "type": "boolean" },
        "line_forecasts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line_forecast" }
        },
        "affected_artifact_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_class" }
        },
        "affected_profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
        "evidence_refs": { "$ref": "#/$defs/ref_array" },
        "speculative": { "type": "boolean" },
        "worst_gate": { "$ref": "#/$defs/gate" },
        "readiness": { "$ref": "#/$defs/review_readiness" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "requires_pre_rollout_resolution": { "type": "boolean" },
        "requires_migration_task": { "type": "boolean" },
        "out_of_window_message_id": { "$ref": "#/$defs/nullable_message_id" },
        "summary_message_id": { "$ref": "#/$defs/message_id" },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["waived", "rationale", "waived_by_role", "waiver_message_id"],
          "properties": {
            "waived": { "type": "boolean" },
            "rationale": { "$ref": "#/$defs/nullable_string" },
            "waived_by_role": { "$ref": "#/$defs/nullable_string" },
            "waiver_message_id": { "$ref": "#/$defs/message_id" }
          }
        }
      ]
    },
    "migration_task_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "subject",
        "subject_label",
        "task_class",
        "owner_role",
        "addresses_drift",
        "confidence",
        "speculative",
        "affected_artifact_classes",
        "affected_profiles",
        "affected_lines",
        "auto_fix",
        "due_before",
        "skip_policy",
        "requires_recorded_rationale",
        "rollback_guidance",
        "available_actions",
        "waiver",
        "evidence_refs",
        "gate",
        "readiness",
        "signal",
        "summary_message_id",
        "detail_message_id"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/non_empty_string" },
        "subject": { "$ref": "#/$defs/subject" },
        "subject_label": { "$ref": "#/$defs/non_empty_string" },
        "task_class": { "$ref": "#/$defs/task_class" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "addresses_drift": { "$ref": "#/$defs/drift_class" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "speculative": { "type": "boolean" },
        "affected_artifact_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_class" }
        },
        "affected_profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
        "affected_lines": { "type": "array", "items": { "$ref": "#/$defs/line" } },
        "auto_fix": { "$ref": "#/$defs/auto_fix" },
        "due_before": { "$ref": "#/$defs/due_boundary" },
        "skip_policy": { "$ref": "#/$defs/skip_policy" },
        "requires_recorded_rationale": { "type": "boolean" },
        "rollback_guidance": { "$ref": "#/$defs/rollback_guidance" },
        "available_actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "waiver": { "$ref": "#/$defs/waiver" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" },
        "gate": { "$ref": "#/$defs/gate" },
        "readiness": { "$ref": "#/$defs/review_readiness" },
        "signal": { "$ref": "#/$defs/signal" },
        "summary_message_id": { "$ref": "#/$defs/message_id" },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      },
      "allOf": [
        {
          "comment": "Guardrail: a task addressing drift on speculative / out-of-window inputs is never a hard failure.",
          "if": {
            "properties": {
              "confidence": {
                "enum": ["estimated", "unknown", "outside_claimed_window"]
              }
            },
            "required": ["confidence"]
          },
          "then": { "properties": { "gate": { "not": { "const": "blocked" } } } }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "subject", "artifact_class", "gap_kind", "cause_message_id"],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "subject": { "$ref": "#/$defs/subject" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "cause_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "consumer": {
      "enum": [
        "update_center",
        "migration_assistant",
        "release_center",
        "admin_console",
        "support_export"
      ]
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "owner_role",
        "read_subjects",
        "disclosed_artifact_classes",
        "profiles",
        "readiness",
        "status",
        "signal",
        "gate_decision",
        "requires_pre_rollout_resolution",
        "gaps",
        "status_message_id",
        "decision_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "read_subjects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subject" }
        },
        "disclosed_artifact_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_class" }
        },
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
        "readiness": { "$ref": "#/$defs/review_readiness" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gate_decision": { "$ref": "#/$defs/gate" },
        "requires_pre_rollout_resolution": { "type": "boolean" },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
        "status_message_id": { "$ref": "#/$defs/message_id" },
        "decision_message_id": { "$ref": "#/$defs/message_id" }
      }
    }
  },
  "properties": {
    "record_kind": { "const": "m5_compatibility_forecast_sheet" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "$ref": "#/$defs/non_empty_string" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "lines", "profiles", "current_version", "target_version", "forecast_basis"],
      "properties": {
        "channel": { "$ref": "#/$defs/channel" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/profile" }
        },
        "current_version": { "$ref": "#/$defs/non_empty_string" },
        "target_version": { "$ref": "#/$defs/non_empty_string" },
        "forecast_basis": { "$ref": "#/$defs/forecast_basis" }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/subject_forecast" }
    },
    "subject_families": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
    "migration_tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/migration_task_row" }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "consumer_tokens": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_center_consumes_sheet",
        "migration_assistant_consumes_sheet",
        "release_center_consumes_sheet",
        "admin_console_consumes_sheet",
        "support_export_consumes_sheet"
      ],
      "properties": {
        "update_center_consumes_sheet": { "const": true },
        "migration_assistant_consumes_sheet": { "const": true },
        "release_center_consumes_sheet": { "const": true },
        "admin_console_consumes_sheet": { "const": true },
        "support_export_consumes_sheet": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_subjects",
        "clear_subjects",
        "review_subjects",
        "hold_subjects",
        "out_of_window_subjects",
        "speculative_subjects",
        "total_tasks",
        "automatable_tasks",
        "manual_tasks",
        "rationale_gated_tasks",
        "waived_tasks",
        "total_consumers",
        "clear_consumers",
        "review_consumers",
        "hold_consumers",
        "requires_pre_rollout_resolution"
      ],
      "properties": {
        "total_subjects": { "type": "integer", "minimum": 0 },
        "clear_subjects": { "type": "integer", "minimum": 0 },
        "review_subjects": { "type": "integer", "minimum": 0 },
        "hold_subjects": { "type": "integer", "minimum": 0 },
        "out_of_window_subjects": { "type": "integer", "minimum": 0 },
        "speculative_subjects": { "type": "integer", "minimum": 0 },
        "total_tasks": { "type": "integer", "minimum": 0 },
        "automatable_tasks": { "type": "integer", "minimum": 0 },
        "manual_tasks": { "type": "integer", "minimum": 0 },
        "rationale_gated_tasks": { "type": "integer", "minimum": 0 },
        "waived_tasks": { "type": "integer", "minimum": 0 },
        "total_consumers": { "type": "integer", "minimum": 0 },
        "clear_consumers": { "type": "integer", "minimum": 0 },
        "review_consumers": { "type": "integer", "minimum": 0 },
        "hold_consumers": { "type": "integer", "minimum": 0 },
        "requires_pre_rollout_resolution": { "type": "boolean" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_lines",
        "estimated_lines",
        "unknown_lines",
        "outside_window_lines",
        "not_applicable_lines",
        "has_partial_coverage"
      ],
      "properties": {
        "qualified_lines": { "type": "integer", "minimum": 0 },
        "estimated_lines": { "type": "integer", "minimum": 0 },
        "unknown_lines": { "type": "integer", "minimum": 0 },
        "outside_window_lines": { "type": "integer", "minimum": 0 },
        "not_applicable_lines": { "type": "integer", "minimum": 0 },
        "has_partial_coverage": { "type": "boolean" }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_pre_rollout_resolution",
        "hold_consumers",
        "review_consumers",
        "clear_consumers",
        "affected_subjects",
        "gate_message_id"
      ],
      "properties": {
        "requires_pre_rollout_resolution": { "type": "boolean" },
        "hold_consumers": { "$ref": "#/$defs/token_array" },
        "review_consumers": { "$ref": "#/$defs/token_array" },
        "clear_consumers": { "$ref": "#/$defs/token_array" },
        "affected_subjects": { "$ref": "#/$defs/token_array" },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjects",
        "lines",
        "drift_classes",
        "confidence_levels",
        "review_readiness",
        "task_classes",
        "auto_fix_levels",
        "due_boundaries",
        "skip_policies",
        "rollback_guidances",
        "actions",
        "artifact_classes",
        "profiles",
        "consumers",
        "gap_kinds",
        "gate_decisions",
        "forecast_bases"
      ],
      "properties": {
        "subjects": { "$ref": "#/$defs/token_array" },
        "lines": { "$ref": "#/$defs/token_array" },
        "drift_classes": { "$ref": "#/$defs/token_array" },
        "confidence_levels": { "$ref": "#/$defs/token_array" },
        "review_readiness": { "$ref": "#/$defs/token_array" },
        "task_classes": { "$ref": "#/$defs/token_array" },
        "auto_fix_levels": { "$ref": "#/$defs/token_array" },
        "due_boundaries": { "$ref": "#/$defs/token_array" },
        "skip_policies": { "$ref": "#/$defs/token_array" },
        "rollback_guidances": { "$ref": "#/$defs/token_array" },
        "actions": { "$ref": "#/$defs/token_array" },
        "artifact_classes": { "$ref": "#/$defs/token_array" },
        "profiles": { "$ref": "#/$defs/token_array" },
        "consumers": { "$ref": "#/$defs/token_array" },
        "gap_kinds": { "$ref": "#/$defs/token_array" },
        "gate_decisions": { "$ref": "#/$defs/token_array" },
        "forecast_bases": { "$ref": "#/$defs/token_array" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_subject_forecast",
        "drift_class_disclosed_per_line",
        "compatible_distinguished_from_breaking",
        "forecast_confidence_labelled",
        "out_of_window_labelled_not_failed",
        "speculative_inputs_labelled_not_failed",
        "narrowed_subjects_have_migration_task",
        "migration_tasks_actionable",
        "waivers_require_recorded_rationale",
        "rollback_guidance_disclosed",
        "affected_scope_disclosed",
        "visible_before_rollout_widening",
        "exportable_outside_app",
        "consumers_read_one_sheet",
        "consumer_verdict_derived_from_subjects",
        "controlled_enums_frozen",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "every_subject_forecast": { "const": true },
        "drift_class_disclosed_per_line": { "const": true },
        "compatible_distinguished_from_breaking": { "const": true },
        "forecast_confidence_labelled": { "const": true },
        "out_of_window_labelled_not_failed": { "const": true },
        "speculative_inputs_labelled_not_failed": { "const": true },
        "narrowed_subjects_have_migration_task": { "const": true },
        "migration_tasks_actionable": { "const": true },
        "waivers_require_recorded_rationale": { "const": true },
        "rollback_guidance_disclosed": { "const": true },
        "affected_scope_disclosed": { "const": true },
        "visible_before_rollout_widening": { "const": true },
        "exportable_outside_app": { "const": true },
        "consumers_read_one_sheet": { "const": true },
        "consumer_verdict_derived_from_subjects": { "const": true },
        "controlled_enums_frozen": { "const": true },
        "export_carries_no_raw_material": { "const": true }
      }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  }
}
