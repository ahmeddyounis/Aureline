{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/release/m5-build-lane-descriptor-and-reproducibility-proof-registries.schema.json",
  "title": "Aureline M5 build-lane-descriptor and reproducibility-proof registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 build-lane-trust matrix. It carries resolved, honest projections of the build-lane-descriptor domain (how a lane declares its allowed cache reads / writes, its controlled credential class, its publication rights, and the artifact families it is expected to produce) and the reproducibility-proof domain (how a release or emergency-hotfix lane proves its inputs came from a verified cache or were re-materialized and that binaries, packages, SBOMs, symbols, docs, and rollback metadata converge on one exact build identity) across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved build-lane-descriptor entries (naming a canonical registry token, a stable lane-binding ID, a build-lane-trust role, a classified cache posture, a published cache read scope / cache write scope / credential class / publication rights / expected artifact families / hermetic-input posture / clean-room rebuild rule, and canonical/accessible/audit resolution-form coverage while bounding its publication authority so a contributor / PR lane never publishes a release artifact and disclosing the cache-trust marker before a trust-risk cache is read) and resolved reproducibility-proof entries (naming a canonical registry token, a stable proof-ref, a build-lane-trust role, a classified convergence scope, and the complete build-identity / input-source-ledger / clean-room-diff / sidecar-convergence / attestation / rollback-metadata / last-rebuild-revision reproducibility-proof object). Hard invariants forbid letting a PR / contributor lane publish release artifacts, treating a remote-cache hit as reproducibility proof, hiding the cache / credential / publication boundary before promotion, and collapsing distinct build-lane input sources into one path. Acceptance criteria — every lane exposes a typed descriptor with cache, credential, and publication boundaries; attempting to publish from an untrusted lane fails with a structured blocker reason; and release packets can prove which lane produced each claimed artifact family — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_build_lane_descriptor_and_reproducibility_proof_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "build_lane_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "build_lane_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "build_lane_descriptor_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "lane_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion",
        "cache_posture",
        "cache_posture_is_classified",
        "canonical_cache_posture_mode",
        "surface_context",
        "cache_read_scope",
        "cache_write_scope",
        "credential_class",
        "publication_rights",
        "expected_artifact_families",
        "hermetic_input_posture",
        "clean_room_rebuild_rule",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "build_lane_descriptor_object_complete",
        "bound_to_registry",
        "publication_authority_bounded",
        "is_trust_risk_posture",
        "cache_trust_disclosed",
        "degrade_reason",
        "next_action",
        "descriptor_resolves_across_lanes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "lane_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion": { "type": "boolean" },
        "cache_posture": { "$ref": "#/$defs/non_empty_string" },
        "cache_posture_is_classified": { "type": "boolean" },
        "canonical_cache_posture_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "cache_read_scope": { "type": "string" },
        "cache_write_scope": { "type": "string" },
        "credential_class": { "type": "string" },
        "publication_rights": { "type": "string" },
        "expected_artifact_families": { "type": "string" },
        "hermetic_input_posture": { "type": "string" },
        "clean_room_rebuild_rule": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "build_lane_descriptor_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "publication_authority_bounded": { "type": "boolean" },
        "is_trust_risk_posture": { "type": "boolean" },
        "cache_trust_disclosed": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "descriptor_resolves_across_lanes": { "type": "boolean" }
      }
    },
    "reproducibility_proof_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "proof_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion",
        "convergence_scope",
        "convergence_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_build_identity",
        "input_source_ledger",
        "clean_room_diff_reference",
        "sidecar_convergence_state",
        "attestation_state",
        "rollback_metadata_reference",
        "last_rebuild_revision",
        "keeps_input_source_visible",
        "proof_is_truthful",
        "remote_cache_hit_present",
        "remote_cache_hit_marked_not_proof",
        "non_hermetic_input_present",
        "non_hermetic_input_flagged",
        "reproducibility_proof_stays_honest",
        "provides_complete_reproducibility_proof",
        "degrade_reason",
        "next_action",
        "proof_safe_on_every_lane"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "proof_ref": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_verify_inputs_and_prove_replay_before_promotion": { "type": "boolean" },
        "convergence_scope": { "$ref": "#/$defs/non_empty_string" },
        "convergence_scope_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "resolved_build_identity": { "type": "string" },
        "input_source_ledger": { "type": "string" },
        "clean_room_diff_reference": { "type": "string" },
        "sidecar_convergence_state": { "type": "string" },
        "attestation_state": { "type": "string" },
        "rollback_metadata_reference": { "type": "string" },
        "last_rebuild_revision": { "type": "string" },
        "keeps_input_source_visible": { "type": "boolean" },
        "proof_is_truthful": { "type": "boolean" },
        "remote_cache_hit_present": { "type": "boolean" },
        "remote_cache_hit_marked_not_proof": { "type": "boolean" },
        "non_hermetic_input_present": { "type": "boolean" },
        "non_hermetic_input_flagged": { "type": "boolean" },
        "reproducibility_proof_stays_honest": { "type": "boolean" },
        "provides_complete_reproducibility_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "proof_safe_on_every_lane": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "build_lane_descriptor_entries",
        "reproducibility_proof_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "lets_a_pr_or_contributor_lane_publish_release_artifacts",
        "treats_a_remote_cache_hit_as_reproducibility_proof",
        "hides_the_cache_credential_or_publication_boundary_before_promotion",
        "collapses_distinct_build_lane_input_sources_into_one_path"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "build_lane_descriptor_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/build_lane_descriptor_entry" }
        },
        "reproducibility_proof_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reproducibility_proof_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "lets_a_pr_or_contributor_lane_publish_release_artifacts": { "const": false },
        "treats_a_remote_cache_hit_as_reproducibility_proof": { "const": false },
        "hides_the_cache_credential_or_publication_boundary_before_promotion": { "const": false },
        "collapses_distinct_build_lane_input_sources_into_one_path": { "const": false }
      }
    }
  }
}
