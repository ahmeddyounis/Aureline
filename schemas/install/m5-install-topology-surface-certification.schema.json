{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/install/m5-install-topology-surface-certification.schema.json",
  "title": "Aureline M5 install-topology surface certification packet",
  "description": "M05-1179 closing capstone certifying that the frozen M5 delivery-topology families (per-user managed, per-machine managed, side-by-side stable/preview, portable mode, offline / air-gap bundle) hold their install-topology truth on every claimed M5 delivery profile. Keyed on the claimed profile (live trusted delivery surface, reviewable delivery structure, disclosed state-boundary profile, unverified repair-verify profile, unverified rollout-evidence profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and install-topology-component-truth behavior — and either passes (green), auto-narrows its delivery claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted delivery profile may certify a trusted delivery surface; and every B140 hard invariant must hold (portable mode never writes hidden machine-global durable state; a preview channel never reuses a stable state namespace without handoff; a rollback never targets only the primary executable while sidecars drift; updater ownership or admin control is never hidden in a managed flow; and no deployment claim outpaces ring or repair/verify evidence). Every row cites exactly one canonical install-topology proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_install_topology_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-install-topology-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_delivery_surface",
        "reviewable_delivery_structure",
        "disclosed_state_boundary_profile",
        "unverified_repair_verify_profile",
        "unverified_rollout_evidence_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "install_topology_component_truth"
      ]
    },
    "install_topology_claim": {
      "enum": [
        "trusted_delivery_surface",
        "reviewable_delivery_surface",
        "state_boundary_disclosed_projection",
        "repair_verify_unverified_projection",
        "rollout_evidence_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "install_topology_family": {
      "enum": [
        "per_user_managed",
        "per_machine_managed",
        "side_by_side_stable_preview",
        "portable_mode",
        "offline_airgap_bundle"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "portable_mode_wrote_hidden_machine_global_durable_state",
        "preview_channel_reused_stable_state_namespace_without_handoff",
        "rollback_targeted_primary_executable_while_sidecars_drifted",
        "updater_ownership_or_admin_control_hidden_in_managed_flow",
        "deployment_claim_outpaced_ring_or_repair_verify_evidence",
        "state_root_boundary_drifted_by_topology",
        "install_mode_unstated",
        "state_root_unstated",
        "rollback_target_unstated",
        "registry_reference_unstated",
        "updater_owner_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portable_mode_writes_hidden_machine_global_durable_state",
        "preview_channel_reuses_stable_state_namespace_without_handoff",
        "rollback_targets_primary_executable_while_sidecars_drift",
        "hides_updater_ownership_or_admin_control_in_managed_flow",
        "publishes_deployment_claim_outpacing_ring_or_repair_verify_evidence"
      ],
      "properties": {
        "portable_mode_writes_hidden_machine_global_durable_state": { "const": false },
        "preview_channel_reuses_stable_state_namespace_without_handoff": { "const": false },
        "rollback_targets_primary_executable_while_sidecars_drift": { "const": false },
        "hides_updater_ownership_or_admin_control_in_managed_flow": { "const": false },
        "publishes_deployment_claim_outpacing_ring_or_repair_verify_evidence": {
          "const": false
        }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/install_topology_claim" },
        "to_claim": { "$ref": "#/$defs/install_topology_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_install_topology_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/install_topology_claim" },
        "certified_claim": { "$ref": "#/$defs/install_topology_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/install_topology_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-install-topology-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
