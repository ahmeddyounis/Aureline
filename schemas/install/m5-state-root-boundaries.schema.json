{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/install/m5-state-root-boundaries.schema.json",
  "title": "Aureline M5 state-root-boundaries delivery-profile entry",
  "description": "Canonical single-entry shape of an M5 install-topology family whose truth is writable-state-root and policy-root isolation (portable mode and offline / air-gap bundles). Every claimed M5 delivery surface references this schema or the combined m5-install-topology-matrix.schema.json rather than reinventing its own state-root boundaries, spill rules, or bundled-artifact rollback set. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-entry shape.",
  "type": "object",
  "required": [
    "install_topology_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "semantic_roles",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "portable_mode_writes_hidden_machine_global_durable_state",
    "preview_channel_reuses_stable_state_namespace_without_handoff",
    "rollback_targets_primary_executable_while_sidecars_drift",
    "hides_updater_ownership_or_admin_control_in_managed_flow",
    "publishes_deployment_claim_outpacing_ring_or_repair_verify_evidence"
  ],
  "properties": {
    "install_topology_family": {
      "$ref": "#/$defs/install_topology_family"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "install_mode",
          "updater_owner",
          "binary_root",
          "writable_state_roots",
          "policy_roots",
          "rollback_target",
          "rollout_ring"
        ]
      }
    },
    "per_user_managed_install_roles": {
      "type": "array"
    },
    "per_machine_managed_install_roles": {
      "type": "array"
    },
    "side_by_side_channel_roles": {
      "type": "array"
    },
    "portable_mode_roles": {
      "type": "array"
    },
    "offline_airgap_bundle_roles": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "portable_mode_writes_hidden_machine_global_durable_state": {
      "const": false
    },
    "preview_channel_reuses_stable_state_namespace_without_handoff": {
      "const": false
    },
    "rollback_targets_primary_executable_while_sidecars_drift": {
      "const": false
    },
    "hides_updater_ownership_or_admin_control_in_managed_flow": {
      "const": false
    },
    "publishes_deployment_claim_outpacing_ring_or_repair_verify_evidence": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "install_topology_family": {
      "enum": [
        "portable_mode",
        "offline_airgap_bundle"
      ]
    }
  }
}
