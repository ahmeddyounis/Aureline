{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/install/m5-install-topology-shared-consumers.schema.json",
  "title": "M5 Install-Topology Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the five B140 install-topology families (per-user managed, per-machine managed, side-by-side stable-plus-preview, portable mode, offline / air-gap bundle) to the installer / package-manager / About / update-center / diagnostics / admin / docs-help / CLI-export / support-export / product consumers that render them, proving one shared install-topology registry across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_install_topology_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "install_topology_family": {
      "type": "string",
      "enum": [
        "per_user_managed",
        "per_machine_managed",
        "side_by_side_stable_preview",
        "portable_mode",
        "offline_airgap_bundle"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "updater_service",
        "shell_ui",
        "diagnostics",
        "admin",
        "installer",
        "docs_help",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "install_topology_grammar_drift_detected",
        "ownership_identity_or_state_isolation_dropped",
        "portable_mode_wrote_hidden_machine_global_durable_state",
        "preview_channel_reused_stable_state_namespace_without_handoff",
        "rollback_targeted_primary_executable_while_sidecars_drifted",
        "updater_ownership_or_admin_control_hidden_in_managed_flow",
        "deployment_claim_outpaced_ring_or_repair_verify_evidence",
        "canonical_registry_reference_missing",
        "upstream_install_topology_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install_topology_role_word",
        "family_word",
        "registry_reference_word",
        "channel_word",
        "surface_context_word",
        "ownership_identity_word"
      ],
      "properties": {
        "install_topology_role_word": {
          "type": "string",
          "enum": [
            "install_mode",
            "updater_owner",
            "binary_root",
            "writable_state_roots",
            "policy_roots",
            "rollback_target",
            "rollout_ring"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "channel_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "ownership_identity_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "delivery_profile_id",
        "delivery_profile_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "portable_mode_writes_hidden_machine_global_durable_state",
        "preview_channel_reuses_stable_state_namespace_without_handoff",
        "rollback_targets_primary_executable_while_sidecars_drift",
        "hides_updater_ownership_or_admin_control_in_managed_flow",
        "publishes_deployment_claim_outpacing_ring_or_repair_verify_evidence",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "delivery_profile_id": { "type": "string", "minLength": 1 },
        "delivery_profile_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/install_topology_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "portable_mode_writes_hidden_machine_global_durable_state": {
          "type": "boolean",
          "const": false
        },
        "preview_channel_reuses_stable_state_namespace_without_handoff": {
          "type": "boolean",
          "const": false
        },
        "rollback_targets_primary_executable_while_sidecars_drift": {
          "type": "boolean",
          "const": false
        },
        "hides_updater_ownership_or_admin_control_in_managed_flow": {
          "type": "boolean",
          "const": false
        },
        "publishes_deployment_claim_outpacing_ring_or_repair_verify_evidence": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_profile_same_install_topology_across_surfaces",
        "install_topology_role_words_stay_in_frozen_vocabulary",
        "ownership_roles_never_hide_owner_or_spill_state",
        "portable_mode_never_spills_hidden_machine_global_durable_state",
        "preview_channel_never_reuses_stable_state_namespace_without_handoff",
        "rollback_never_targets_primary_executable_while_sidecars_drift",
        "updater_ownership_or_admin_control_never_hidden_in_managed_flow",
        "deployment_claims_never_outpace_ring_or_repair_verify_evidence",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_profile_same_install_topology_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "install_topology_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "ownership_roles_never_hide_owner_or_spill_state": {
          "type": "boolean",
          "const": true
        },
        "portable_mode_never_spills_hidden_machine_global_durable_state": {
          "type": "boolean",
          "const": true
        },
        "preview_channel_never_reuses_stable_state_namespace_without_handoff": {
          "type": "boolean",
          "const": true
        },
        "rollback_never_targets_primary_executable_while_sidecars_drift": {
          "type": "boolean",
          "const": true
        },
        "updater_ownership_or_admin_control_never_hidden_in_managed_flow": {
          "type": "boolean",
          "const": true
        },
        "deployment_claims_never_outpace_ring_or_repair_verify_evidence": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updater_service_consumes_shared_install_topology",
        "shell_about_consumes_shared_install_topology",
        "diagnostics_consumes_shared_install_topology",
        "admin_consumes_shared_install_topology",
        "installer_consumes_shared_install_topology",
        "docs_help_consumes_shared_install_topology",
        "cli_export_consumes_shared_install_topology",
        "support_export_consumes_shared_install_topology",
        "product_ui_consumes_shared_install_topology",
        "every_family_adopted_by_two_or_more_consumers",
        "install_topology_identical_for_same_profile",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_install_topology_family"
      ],
      "properties": {
        "updater_service_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "shell_about_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "admin_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "installer_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "docs_help_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "cli_export_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "product_ui_consumes_shared_install_topology": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "install_topology_identical_for_same_profile": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_install_topology_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
