{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/install/m5-managed-deployment-operations-and-policy-bootstrap-injection.schema.json",
  "title": "Aureline M5 managed-deployment operations and policy-bootstrap-injection registries",
  "description": "Export-safe packet for the managed-deployment execution lane over the frozen M5 install-topology matrix. It makes 'managed deployment' a contract by resolving every claimed managed profile across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved managed-operation entries (naming a canonical registry token, a stable profile ID, a semantic role, a classified operation that is silent-install / silent-uninstall / repair-or-verify / channel-pin / update-defer, an operation-target root, a receipt root, a failure-diagnostics root, the complete copyable receipt inventory of install ID / timestamp / failure summary / repair-verify receipt, a disclosed admin-versus-user ownership, canonical/accessible/audit presentation-form coverage, and proof that the managed installer was never presented as user-controlled) and resolved policy-bootstrap-injection entries (naming a canonical registry token, a stable profile ID, a semantic role, a classified injection surface, the disclosed policy-bundle source / bootstrap target / applied settings / admin owner / deferral window, and documented channel-pin / update-deferral continuity). Hard invariants forbid a managed installer being presented as user-controlled, a managed failure stranding the user without actionable diagnostics, channel pinning or repair/verify drifting from the published matrix, and policy-bootstrap injection ownership left undisclosed. Acceptance criteria — claimed managed profiles expose install / uninstall / repair-verify / pinning / deferral through one inspectable contract; managed-install failures preserve actionable diagnostics and do not strand the user in ambiguous ownership state; and enterprise rollout drills fail when bootstrap-policy injection, channel pinning, or repair/verify semantics drift from the published matrix — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary; roots are filesystem paths. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_managed_deployment_operations_and_policy_bootstrap_injection"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "managed_operations_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "managed_operations_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "managed_operation_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "profile_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence",
        "operation",
        "operation_is_supported",
        "surface_context",
        "operation_target_root",
        "receipt_root",
        "failure_diagnostics_root",
        "receipt_fields_covered",
        "ownership",
        "ownership_is_disclosed",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "managed_receipt_complete",
        "operation_is_accountable",
        "bound_to_registry",
        "ownership_misrepresented_used",
        "ownership_disclosure_enforced",
        "degrade_reason",
        "next_action",
        "operation_resolves_across_profiles"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "profile_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence": { "type": "boolean" },
        "operation": { "$ref": "#/$defs/non_empty_string" },
        "operation_is_supported": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "operation_target_root": { "type": "string" },
        "receipt_root": { "type": "string" },
        "failure_diagnostics_root": { "type": "string" },
        "receipt_fields_covered": { "type": "array" },
        "ownership": { "type": "string" },
        "ownership_is_disclosed": { "type": "boolean" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "managed_receipt_complete": { "type": "boolean" },
        "operation_is_accountable": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "ownership_misrepresented_used": { "type": "boolean" },
        "ownership_disclosure_enforced": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "operation_resolves_across_profiles": { "type": "boolean" }
      }
    },
    "policy_injection_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "profile_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence",
        "injection_surface",
        "injection_surface_is_classified",
        "surface_context",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "policy_bundle_source",
        "bootstrap_target",
        "disclosed_fields",
        "pin_deferral_posture",
        "pin_deferral_posture_is_classified",
        "pin_and_deferral_continuity_documented",
        "admin_control_disclosed",
        "injection_is_disclosed",
        "pin_and_deferral_is_continuous",
        "degrade_reason",
        "next_action",
        "injection_discoverable_on_every_profile"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "profile_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence": { "type": "boolean" },
        "injection_surface": { "$ref": "#/$defs/non_empty_string" },
        "injection_surface_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "policy_bundle_source": { "type": "string" },
        "bootstrap_target": { "type": "string" },
        "disclosed_fields": { "type": "array" },
        "pin_deferral_posture": { "type": "string" },
        "pin_deferral_posture_is_classified": { "type": "boolean" },
        "pin_and_deferral_continuity_documented": { "type": "boolean" },
        "admin_control_disclosed": { "type": "boolean" },
        "injection_is_disclosed": { "type": "boolean" },
        "pin_and_deferral_is_continuous": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "injection_discoverable_on_every_profile": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "managed_operation_entries",
        "policy_injection_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "managed_installer_presented_as_user_controlled",
        "managed_failure_stranded_user_without_diagnostics",
        "channel_pinning_or_repair_verify_drifted_from_matrix",
        "policy_bootstrap_injection_ownership_left_undisclosed"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "managed_operation_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/managed_operation_entry" }
        },
        "policy_injection_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/policy_injection_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "managed_installer_presented_as_user_controlled": { "const": false },
        "managed_failure_stranded_user_without_diagnostics": { "const": false },
        "channel_pinning_or_repair_verify_drifted_from_matrix": { "const": false },
        "policy_bootstrap_injection_ownership_left_undisclosed": { "const": false }
      }
