{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/install/m5-install-topology-and-state-root-registries.schema.json",
  "title": "Aureline M5 install-topology and state-root registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 install-topology matrix. It carries resolved, honest projections of the delivery-topology and state-root-boundary families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved install-topology entries (naming a canonical registry token, a stable profile ID, a semantic role, a classified delivery scope, a published install mode / channel / updater owner / binary root / writable state roots / policy roots / rollback target, and canonical/accessible/audit resolution-form coverage while keeping managed-versus-user scopes and side-by-side channels on explicitly isolated state namespaces and explaining any coexistence handoff) and resolved state-root-boundary entries (naming a canonical registry token, a stable profile ID, a semantic role, a classified state-root surface, published writable state roots / policy roots / rollback target, and the writable-state-root / policy-root / rollback-target disclosure triple). Hard invariants forbid portable mode writing hidden machine-global durable state, a preview channel reusing a stable state namespace without an explicit handoff, a rollback targeting only the primary executable while sidecars drift, and updater ownership or admin control hidden in a managed flow. Acceptance criteria — every claimed delivery profile resolves to one stable install-topology object; diagnostics and support packets report install topology and state-root boundaries without manual reconstruction; and the suite fails when a platform cannot explain shared-versus-isolated state for the active profile — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_install_topology_and_state_root_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "install_topology_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "install_topology_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "install_topology_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "profile_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence",
        "delivery_scope",
        "delivery_scope_is_classified",
        "canonical_install_mode",
        "surface_context",
        "channel",
        "updater_owner",
        "binary_root",
        "writable_state_roots",
        "policy_roots",
        "rollback_target",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "install_topology_object_complete",
        "bound_to_registry",
        "state_namespaces_isolated",
        "coexists_with_sibling_channel",
        "coexistence_handoff_explained",
        "degrade_reason",
        "next_action",
        "topology_resolves_across_profiles"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "profile_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence": { "type": "boolean" },
        "delivery_scope": { "$ref": "#/$defs/non_empty_string" },
        "delivery_scope_is_classified": { "type": "boolean" },
        "canonical_install_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "channel": { "type": "string" },
        "updater_owner": { "type": "string" },
        "binary_root": { "type": "string" },
        "writable_state_roots": { "type": "string" },
        "policy_roots": { "type": "string" },
        "rollback_target": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "install_topology_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "state_namespaces_isolated": { "type": "boolean" },
        "coexists_with_sibling_channel": { "type": "boolean" },
        "coexistence_handoff_explained": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "topology_resolves_across_profiles": { "type": "boolean" }
      }
    },
    "state_root_boundary_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "profile_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence",
        "state_root_surface",
        "state_root_surface_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "writable_state_roots",
        "policy_roots",
        "rollback_target",
        "rollback_targets_full_graph",
        "boundary_is_truthful",
        "machine_global_spill_used",
        "machine_global_spill_disclosed",
        "narrower_scope_asserted",
        "narrower_scope_explained",
        "boundary_stays_truthful",
        "provides_complete_disclosure_triple",
        "degrade_reason",
        "next_action",
        "boundary_truthful_on_every_profile"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "profile_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence": { "type": "boolean" },
        "state_root_surface": { "$ref": "#/$defs/non_empty_string" },
        "state_root_surface_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "writable_state_roots": { "type": "string" },
        "policy_roots": { "type": "string" },
        "rollback_target": { "type": "string" },
        "rollback_targets_full_graph": { "type": "boolean" },
        "boundary_is_truthful": { "type": "boolean" },
        "machine_global_spill_used": { "type": "boolean" },
        "machine_global_spill_disclosed": { "type": "boolean" },
        "narrower_scope_asserted": { "type": "boolean" },
        "narrower_scope_explained": { "type": "boolean" },
        "boundary_stays_truthful": { "type": "boolean" },
        "provides_complete_disclosure_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "boundary_truthful_on_every_profile": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "install_topology_entries",
        "state_root_boundary_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "portable_mode_writes_hidden_machine_global_durable_state",
        "preview_channel_reuses_stable_state_namespace_without_handoff",
        "rollback_targets_primary_executable_while_sidecars_drift",
        "hides_updater_ownership_or_admin_control_in_managed_flow"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "install_topology_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/install_topology_entry" }
        },
        "state_root_boundary_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_root_boundary_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "portable_mode_writes_hidden_machine_global_durable_state": { "const": false },
        "preview_channel_reuses_stable_state_namespace_without_handoff": { "const": false },
        "rollback_targets_primary_executable_while_sidecars_drift": { "const": false },
        "hides_updater_ownership_or_admin_control_in_managed_flow": { "const": false }
      }
    }
  }
}
