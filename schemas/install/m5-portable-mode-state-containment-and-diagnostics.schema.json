{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/install/m5-portable-mode-state-containment-and-diagnostics.schema.json",
  "title": "Aureline M5 portable-mode state-containment and diagnostics registries",
  "description": "Export-safe packet for the portable-mode runtime-enforcement lane over the frozen M5 install-topology matrix. It makes 'portable' a contract by resolving every claimed portable profile across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved portable-state-layout entries (naming a canonical registry token, a stable profile ID, a semantic role, a classified containment layout that is colocated-under-executable or an explicitly named sibling, an executable root, a colocated state root, a log-and-crash root, the complete durable-class inventory of settings / secrets / services / shell hooks, a distinguishable state origin, canonical/accessible/audit presentation-form coverage, and proof that hidden machine-global durable writes are absent or explicitly blocked) and resolved portable-diagnostics entries (naming a canonical registry token, a stable profile ID, a semantic role, a classified diagnostics surface, the disclosed executable root / state roots / log-and-crash locations / update posture / unsupported shell-integration paths, and documented retained-versus-replaced update continuity). Hard invariants forbid portable mode writing hidden machine-global durable state, portable state being indistinguishable from ordinary installed state, a portable update dropping retained state without notice, and an unsupported shell-integration path left undisclosed. Acceptance criteria — portable mode can identify all durable roots and prove hidden machine-global mutation is absent or explicitly blocked; support/export paths distinguish portable state from ordinary installed state without guessing; and the suite fails when durable settings, secrets, or services spill outside documented portable roots — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary; portable roots are filesystem paths. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_portable_mode_state_containment_and_diagnostics"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "portable_diagnostics_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "portable_diagnostics_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "portable_state_layout_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "profile_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence",
        "containment",
        "containment_is_colocated_or_sibling",
        "surface_context",
        "executable_root",
        "colocated_state_root",
        "log_and_crash_root",
        "durable_classes_covered",
        "state_origin",
        "state_origin_is_distinguishable",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "durable_root_inventory_complete",
        "layout_is_contained",
        "bound_to_registry",
        "hidden_machine_global_write_used",
        "hidden_machine_global_write_blocked",
        "degrade_reason",
        "next_action",
        "layout_resolves_across_profiles"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "profile_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence": { "type": "boolean" },
        "containment": { "$ref": "#/$defs/non_empty_string" },
        "containment_is_colocated_or_sibling": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "executable_root": { "type": "string" },
        "colocated_state_root": { "type": "string" },
        "log_and_crash_root": { "type": "string" },
        "durable_classes_covered": { "type": "array" },
        "state_origin": { "type": "string" },
        "state_origin_is_distinguishable": { "type": "boolean" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "durable_root_inventory_complete": { "type": "boolean" },
        "layout_is_contained": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "hidden_machine_global_write_used": { "type": "boolean" },
        "hidden_machine_global_write_blocked": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "layout_resolves_across_profiles": { "type": "boolean" }
      }
    },
    "portable_diagnostics_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "profile_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence",
        "diagnostics_surface",
        "diagnostics_surface_is_classified",
        "surface_context",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "executable_root",
        "state_roots",
        "disclosed_fields",
        "update_posture",
        "update_posture_is_classified",
        "update_continuity_documented",
        "unsupported_shell_paths_disclosed",
        "diagnostics_is_discoverable",
        "update_is_continuous",
        "degrade_reason",
        "next_action",
        "diagnostics_discoverable_on_every_profile"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "profile_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence": { "type": "boolean" },
        "diagnostics_surface": { "$ref": "#/$defs/non_empty_string" },
        "diagnostics_surface_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "executable_root": { "type": "string" },
        "state_roots": { "type": "string" },
        "disclosed_fields": { "type": "array" },
        "update_posture": { "type": "string" },
        "update_posture_is_classified": { "type": "boolean" },
        "update_continuity_documented": { "type": "boolean" },
        "unsupported_shell_paths_disclosed": { "type": "boolean" },
        "diagnostics_is_discoverable": { "type": "boolean" },
        "update_is_continuous": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "diagnostics_discoverable_on_every_profile": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "portable_state_layout_entries",
        "portable_diagnostics_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "portable_mode_writes_hidden_machine_global_durable_state",
        "portable_state_indistinguishable_from_installed_state",
        "portable_update_drops_retained_state_without_notice",
        "unsupported_shell_integration_path_left_undisclosed"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "portable_state_layout_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/portable_state_layout_entry" }
        },
        "portable_diagnostics_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/portable_diagnostics_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "portable_mode_writes_hidden_machine_global_durable_state": { "const": false },
        "portable_state_indistinguishable_from_installed_state": { "const": false },
        "portable_update_drops_retained_state_without_notice": { "const": false },
        "unsupported_shell_integration_path_left_undisclosed": { "const": false }
      }
    }
  }
}
