{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/install/m5-channel-isolation-precedence-review-and-rollback-targets.schema.json",
  "title": "Aureline M5 channel-isolation, precedence-review, and rollback-target registries",
  "description": "Export-safe packet for the side-by-side coexistence-execution lane over the frozen M5 install-topology matrix. It makes 'side-by-side channel isolation' a contract by resolving every claimed side-by-side profile across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved channel-isolation entries (naming a canonical registry token, a stable profile ID, a semantic role, a classified channel that is stable / preview / beta / lts, a channel root, a state-namespace root, a secrets-namespace root, the complete isolation inventory of channel root / state namespace / secrets namespace / services namespace, a disclosed isolated-versus-governed-handoff containment, canonical/accessible/audit presentation-form coverage, and proof that no preview / beta channel reused the stable state namespace without a governed handoff) and resolved precedence-rollback entries (naming a canonical registry token, a stable profile ID, a semantic role, a classified precedence domain of file-association / protocol-handler / deep-link / default-open, the disclosed owner channel / precedence rank / conflict resolution / rollback artifact graph / inspectable-before-and-after, and a rollback-completeness posture bound to the full artifact graph). Hard invariants forbid a preview / beta channel reusing the stable state namespace, handler ownership becoming a last-writer-wins accident, a rollback targeting only the primary executable while sidecars drift, and channel precedence / rollback drifting from the published matrix. Acceptance criteria — preview and stable installs coexist without corrupting one another's durable state unless the user chooses a governed handoff; handler ownership and channel precedence are inspectable before and after update / import flows; and rollback validation fails when a target lacks compatible sidecars, metadata, or association state — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary; roots are filesystem paths. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_channel_isolation_precedence_review_and_rollback_targets"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "channel_isolation_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "channel_isolation_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "channel_isolation_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "profile_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence",
        "channel",
        "channel_is_isolatable",
        "surface_context",
        "channel_root",
        "state_namespace_root",
        "secrets_namespace_root",
        "isolation_fields_covered",
        "containment",
        "containment_is_disclosed",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "channel_isolation_complete",
        "channel_state_isolated",
        "bound_to_registry",
        "namespace_reuse_used",
        "namespace_isolation_enforced",
        "degrade_reason",
        "next_action",
        "channel_resolves_across_profiles"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "profile_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence": { "type": "boolean" },
        "channel": { "$ref": "#/$defs/non_empty_string" },
        "channel_is_isolatable": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "channel_root": { "type": "string" },
        "state_namespace_root": { "type": "string" },
        "secrets_namespace_root": { "type": "string" },
        "isolation_fields_covered": { "type": "array" },
        "containment": { "type": "string" },
        "containment_is_disclosed": { "type": "boolean" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "channel_isolation_complete": { "type": "boolean" },
        "channel_state_isolated": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "namespace_reuse_used": { "type": "boolean" },
        "namespace_isolation_enforced": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "channel_resolves_across_profiles": { "type": "boolean" }
      }
    },
    "precedence_rollback_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "profile_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence",
        "precedence_domain",
        "precedence_domain_is_classified",
        "surface_context",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "association_owner",
        "rollback_artifact_graph_root",
        "disclosed_fields",
        "rollback_posture",
        "rollback_posture_is_classified",
        "rollback_artifact_graph_continuity_documented",
        "precedence_ownership_disclosed",
        "handler_precedence_inspectable",
        "rollback_full_artifact_graph",
        "degrade_reason",
        "next_action",
        "precedence_and_rollback_inspectable_on_every_profile"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "profile_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_state_isolation_and_ownership_under_coexistence": { "type": "boolean" },
        "precedence_domain": { "$ref": "#/$defs/non_empty_string" },
        "precedence_domain_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "association_owner": { "type": "string" },
        "rollback_artifact_graph_root": { "type": "string" },
        "disclosed_fields": { "type": "array" },
        "rollback_posture": { "type": "string" },
        "rollback_posture_is_classified": { "type": "boolean" },
        "rollback_artifact_graph_continuity_documented": { "type": "boolean" },
        "precedence_ownership_disclosed": { "type": "boolean" },
        "handler_precedence_inspectable": { "type": "boolean" },
        "rollback_full_artifact_graph": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "precedence_and_rollback_inspectable_on_every_profile": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "channel_isolation_entries",
        "precedence_rollback_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "preview_or_beta_reused_stable_state_namespace",
        "handler_ownership_became_last_writer_wins",
        "rollback_targeted_primary_executable_only",
        "channel_precedence_or_rollback_drifted_from_matrix"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "channel_isolation_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/channel_isolation_entry" }
        },
        "precedence_rollback_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/precedence_rollback_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "preview_or_beta_reused_stable_state_namespace": { "const": false },
        "handler_ownership_became_last_writer_wins": { "const": false },
        "rollback_targeted_primary_executable_only": { "const": false },
        "channel_precedence_or_rollback_drifted_from_matrix": { "const": false }
      }
    }
  }
}
