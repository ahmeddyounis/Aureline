{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/install/m5-install-topology-matrix.schema.json",
  "title": "Aureline M5 install-topology, mutable-state-boundary, portable-update, and fleet-rollout execution matrix",
  "description": "Export-safe packet freezing Aureline's concrete delivery-topology behavior. The packet names every claimed M5 delivery profile — per-user managed install, per-machine managed install, side-by-side stable-plus-preview, portable mode, and offline / air-gap bundles — and binds each governed family to the claimed surface families that render it (About, update, diagnostics, admin, docs/help, support-export), the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each family declares the controlled vocabularies it carries: the single controlled install-topology-role vocabulary consumers bind to (install_mode, updater_owner, binary_root, writable_state_roots, policy_roots, rollback_target, rollout_ring), plus family-specific per-user-managed-install roles, per-machine-managed-install roles, side-by-side-channel roles, portable-mode roles, and offline / air-gap-bundle roles. Hard invariants forbid portable mode writing hidden machine-global durable state, a preview channel reusing a stable state namespace without an explicit handoff, a rollback targeting only the primary executable while sidecars or metadata drift, hiding updater ownership or admin control in a managed flow, and publishing a deployment claim that outpaces ring or repair / verify evidence. The matrix binds back to the already-landed coexistence / fleet-rollout and native-desktop matrix packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "install_topology_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_install_topology_mutable_state_boundary_portable_update_and_fleet_rollout_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "install_topology_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/install_topology_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "install_topology_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "install_topology_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "install_topology_family": {
      "enum": [
        "per_user_managed",
        "per_machine_managed",
        "side_by_side_stable_preview",
        "portable_mode",
        "offline_airgap_bundle"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "install_mode",
        "updater_owner",
        "binary_root",
        "writable_state_roots",
        "policy_roots",
        "rollback_target",
        "rollout_ring"
      ]
    },
    "install_topology_row": {
      "type": "object",
      "required": [
        "install_topology_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "portable_mode_writes_hidden_machine_global_durable_state",
        "preview_channel_reuses_stable_state_namespace_without_handoff",
        "rollback_targets_primary_executable_while_sidecars_drift",
        "hides_updater_ownership_or_admin_control_in_managed_flow",
        "publishes_deployment_claim_outpacing_ring_or_repair_verify_evidence"
      ],
      "properties": {
        "install_topology_family": {
          "$ref": "#/$defs/install_topology_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "per_user_managed_install_roles": {
          "type": "array"
        },
        "per_machine_managed_install_roles": {
          "type": "array"
        },
        "side_by_side_channel_roles": {
          "type": "array"
        },
        "portable_mode_roles": {
          "type": "array"
        },
        "offline_airgap_bundle_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "portable_mode_writes_hidden_machine_global_durable_state": {
          "const": false
        },
        "preview_channel_reuses_stable_state_namespace_without_handoff": {
          "const": false
        },
        "rollback_targets_primary_executable_while_sidecars_drift": {
          "const": false
        },
        "hides_updater_ownership_or_admin_control_in_managed_flow": {
          "const": false
        },
        "publishes_deployment_claim_outpacing_ring_or_repair_verify_evidence": {
          "const": false
        }
      }
    }
  }
}
