{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/data/implement-request-origin-truth-for-local-desktop-ssh-container-managed-workspace-and-browser-companion-execution-paths-with-drift-review.schema.json",
  "title": "Aureline request-origin truth and rerun drift-review packet",
  "description": "Boundary schema for the request-origin truth and rerun drift-review qualification record. Each resolved-origin row keeps the execution path (local desktop, SSH, container, managed workspace, browser companion), the canonical origin lane, the opaque target identity, the trust boundary, and the drift state inspectable so localhost, container service names, and private DNS never silently mean the same thing across lanes. Rerun-review sheets distinguish rerun-exactly from rerun-with-current-context and enumerate every origin change before dispatch. Managed and browser-companion origins never inherit desktop-local trust; silent retargeting is always blocked. Raw endpoint URLs, raw secrets, raw request bodies, raw headers, and raw cookie or token values do not appear in this packet.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "release_doc_ref",
    "help_doc_ref",
    "schema_ref",
    "surfaces",
    "origins",
    "rerun_sheets",
    "origin_changes",
    "upstream_refs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "implement_request_origin_truth_for_local_desktop_ssh_container_managed_workspace_and_browser_companion_execution_paths_with_drift_review"
    },
    "packet_id": { "$ref": "#/$defs/opaque_id" },
    "as_of": { "type": "string", "format": "date" },
    "release_doc_ref": { "$ref": "#/$defs/path_ref" },
    "help_doc_ref": { "$ref": "#/$defs/path_ref" },
    "schema_ref": { "$ref": "#/$defs/path_ref" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/origin_truth_surface_qualification_row" }
    },
    "origins": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolved_origin_row" }
    },
    "rerun_sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/rerun_review_sheet_row" }
    },
    "origin_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/origin_change_row" }
    },
    "upstream_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/origin_truth_upstream_ref_row" }
    },
    "summary": { "$ref": "#/$defs/origin_truth_qualification_summary" }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[_.:-][a-z0-9]+)*$"
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "origin_truth_qualification_label": {
      "type": "string",
      "enum": ["stable", "preview", "labs", "inspect_only", "import_only"]
    },
    "origin_truth_surface_kind": {
      "type": "string",
      "enum": [
        "request_composer",
        "rerun_review_sheet",
        "request_list",
        "browser_companion_surface",
        "cli_headless_output",
        "support_export",
        "help_about"
      ]
    },
    "origin_execution_path": {
      "type": "string",
      "enum": ["local_desktop", "ssh", "container", "managed_workspace", "browser_companion"]
    },
    "request_origin_kind": {
      "type": "string",
      "enum": ["local_host", "remote", "container", "managed", "browser_companion"]
    },
    "origin_trust_boundary_class": {
      "type": "string",
      "enum": [
        "desktop_local_trust",
        "remote_host_trust",
        "container_scoped_trust",
        "managed_tenant_trust",
        "browser_companion_trust"
      ]
    },
    "request_origin_drift_state": {
      "type": "string",
      "enum": ["origin_stable", "origin_changed"]
    },
    "rerun_review_mode": {
      "type": "string",
      "enum": ["rerun_exactly", "rerun_with_current_context"]
    },
    "origin_change_kind": {
      "type": "string",
      "enum": [
        "host_identity_changed",
        "origin_lane_changed",
        "trust_boundary_changed",
        "port_or_service_changed",
        "private_dns_rebound"
      ]
    },
    "retention_mode": {
      "type": "string",
      "enum": ["text_first_versioned", "metadata_only", "redacted_replayable", "opt_in_full_capture"]
    },
    "origin_truth_qualification_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "captured_at", "evidence_refs"],
      "properties": {
        "packet_id": { "type": "string" },
        "packet_ref": { "type": "string" },
        "proof_index_ref": { "type": "string" },
        "captured_at": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "origin_truth_surface_guard_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_class_visible",
        "target_identity_visible",
        "origin_changed_warning_visible",
        "trust_boundary_visible",
        "rerun_modes_distinguished",
        "changes_enumerated_before_dispatch",
        "no_silent_retarget",
        "trust_isolated",
        "local_request_context_preserved",
        "no_unsafe_retention_for_compare"
      ],
      "properties": {
        "origin_class_visible": { "type": "boolean" },
        "target_identity_visible": { "type": "boolean" },
        "origin_changed_warning_visible": { "type": "boolean" },
        "trust_boundary_visible": { "type": "boolean" },
        "rerun_modes_distinguished": { "type": "boolean" },
        "changes_enumerated_before_dispatch": { "type": "boolean" },
        "no_silent_retarget": { "type": "boolean" },
        "trust_isolated": { "type": "boolean" },
        "local_request_context_preserved": { "type": "boolean" },
        "no_unsafe_retention_for_compare": { "type": "boolean" }
      }
    },
    "origin_truth_surface_qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "surface_kind",
        "promoted_build_surface",
        "claim_label",
        "displayed_label",
        "qualification_packet",
        "guards",
        "downgrade_if_missing",
        "rationale"
      ],
      "properties": {
        "surface_id": { "type": "string" },
        "title": { "type": "string" },
        "surface_kind": { "$ref": "#/$defs/origin_truth_surface_kind" },
        "promoted_build_surface": { "type": "boolean" },
        "claim_label": { "$ref": "#/$defs/origin_truth_qualification_label" },
        "displayed_label": { "$ref": "#/$defs/origin_truth_qualification_label" },
        "qualification_packet": { "oneOf": [{ "$ref": "#/$defs/origin_truth_qualification_proof" }, { "type": "null" }] },
        "guards": { "$ref": "#/$defs/origin_truth_surface_guard_set" },
        "downgrade_if_missing": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "resolved_origin_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "surface_ref",
        "execution_path",
        "origin_kind",
        "matrix_origin_ref",
        "target_identity_label",
        "trust_boundary",
        "drift_state",
        "inherits_local_trust",
        "explicit_target_identity",
        "retarget_requires_ack",
        "silent_retarget_blocked",
        "origin_class_visible",
        "target_identity_visible",
        "drift_warning_visible",
        "trust_boundary_visible",
        "rationale"
      ],
      "properties": {
        "origin_id": { "type": "string" },
        "surface_ref": { "type": "string" },
        "execution_path": { "$ref": "#/$defs/origin_execution_path" },
        "origin_kind": { "$ref": "#/$defs/request_origin_kind" },
        "matrix_origin_ref": { "type": "string" },
        "target_identity_label": { "type": "string" },
        "trust_boundary": { "$ref": "#/$defs/origin_trust_boundary_class" },
        "drift_state": { "$ref": "#/$defs/request_origin_drift_state" },
        "inherits_local_trust": { "type": "boolean" },
        "explicit_target_identity": { "type": "boolean" },
        "retarget_requires_ack": { "type": "boolean" },
        "silent_retarget_blocked": { "type": "boolean" },
        "origin_class_visible": { "type": "boolean" },
        "target_identity_visible": { "type": "boolean" },
        "drift_warning_visible": { "type": "boolean" },
        "trust_boundary_visible": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "rerun_review_sheet_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheet_id",
        "origin_ref",
        "rerun_mode",
        "prior_origin_label",
        "resolved_origin_label",
        "drift_state",
        "distinguishes_rerun_modes",
        "enumerates_changes_before_dispatch",
        "requires_review_before_dispatch",
        "dispatch_blocked_until_reviewed",
        "history_retention_mode",
        "forces_unsafe_body_header_retention",
        "rationale"
      ],
      "properties": {
        "sheet_id": { "type": "string" },
        "origin_ref": { "type": "string" },
        "rerun_mode": { "$ref": "#/$defs/rerun_review_mode" },
        "prior_origin_label": { "type": "string" },
        "resolved_origin_label": { "type": "string" },
        "drift_state": { "$ref": "#/$defs/request_origin_drift_state" },
        "distinguishes_rerun_modes": { "type": "boolean" },
        "enumerates_changes_before_dispatch": { "type": "boolean" },
        "requires_review_before_dispatch": { "type": "boolean" },
        "dispatch_blocked_until_reviewed": { "type": "boolean" },
        "history_retention_mode": { "$ref": "#/$defs/retention_mode" },
        "forces_unsafe_body_header_retention": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "origin_change_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "sheet_ref",
        "change_kind",
        "from_label",
        "to_label",
        "requires_ack",
        "rationale"
      ],
      "properties": {
        "change_id": { "type": "string" },
        "sheet_ref": { "type": "string" },
        "change_kind": { "$ref": "#/$defs/origin_change_kind" },
        "from_label": { "type": "string" },
        "to_label": { "type": "string" },
        "requires_ack": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "origin_truth_upstream_ref_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "upstream_record_kind", "upstream_packet_path", "upstream_schema_path", "integration_verified", "rationale"],
      "properties": {
        "ref_id": { "type": "string" },
        "upstream_record_kind": { "type": "string" },
        "upstream_packet_path": { "type": "string" },
        "upstream_schema_path": { "type": "string" },
        "integration_verified": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "origin_truth_qualification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoted_surface_count",
        "stable_surface_count",
        "narrowed_surface_count",
        "origin_count",
        "changed_origin_count",
        "rerun_sheet_count",
        "origin_change_count",
        "upstream_ref_count",
        "integration_pass_count"
      ],
      "properties": {
        "promoted_surface_count": { "type": "integer", "minimum": 0 },
        "stable_surface_count": { "type": "integer", "minimum": 0 },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "origin_count": { "type": "integer", "minimum": 0 },
        "changed_origin_count": { "type": "integer", "minimum": 0 },
        "rerun_sheet_count": { "type": "integer", "minimum": 0 },
        "origin_change_count": { "type": "integer", "minimum": 0 },
        "upstream_ref_count": { "type": "integer", "minimum": 0 },
        "integration_pass_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
