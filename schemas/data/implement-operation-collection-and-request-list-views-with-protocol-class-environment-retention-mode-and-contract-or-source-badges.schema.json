{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/data/implement-operation-collection-and-request-list-views-with-protocol-class-environment-retention-mode-and-contract-or-source-badges.schema.json",
  "title": "Aureline operation-collection and request-list view packet",
  "description": "Boundary schema for the operation-collection and request-list view qualification record. Each collection-view and request-list-view row keeps protocol class, environment identity, contract-source and freshness badge, last-run state, retention mode, provenance, and open-detail/inspect/export actions inspectable on top of the frozen API-collection matrix. Raw endpoint URLs, raw secrets, raw request bodies, raw headers, and raw schema payloads do not appear in this packet; saved views carry no opaque binary state.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "release_doc_ref",
    "help_doc_ref",
    "schema_ref",
    "surfaces",
    "collection_views",
    "request_views",
    "environment_views",
    "saved_views",
    "upstream_refs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "implement_operation_collection_and_request_list_views_with_protocol_class_environment_retention_mode_and_contract_or_source_badges"
    },
    "packet_id": { "$ref": "#/$defs/opaque_id" },
    "as_of": { "type": "string", "format": "date" },
    "release_doc_ref": { "$ref": "#/$defs/path_ref" },
    "help_doc_ref": { "$ref": "#/$defs/path_ref" },
    "schema_ref": { "$ref": "#/$defs/path_ref" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/request_views_surface_qualification_row" }
    },
    "collection_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection_view_row" }
    },
    "request_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/request_list_view_row" }
    },
    "environment_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/environment_view_row" }
    },
    "saved_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/saved_view_row" }
    },
    "upstream_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/request_views_upstream_ref_row" }
    },
    "summary": { "$ref": "#/$defs/request_views_qualification_summary" }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[_.:-][a-z0-9]+)*$"
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "request_views_qualification_label": {
      "type": "string",
      "enum": ["stable", "preview", "labs", "inspect_only", "import_only"]
    },
    "request_views_surface_kind": {
      "type": "string",
      "enum": [
        "request_workspace_tree",
        "command_palette_list",
        "cli_headless_list",
        "support_export_view",
        "help_about_view"
      ]
    },
    "protocol_class": {
      "type": "string",
      "enum": ["rest", "graphql", "grpc", "websocket"]
    },
    "environment_class": {
      "type": "string",
      "enum": ["local", "development", "staging", "production", "managed"]
    },
    "last_run_state": {
      "type": "string",
      "enum": ["never_run", "succeeded", "failed", "blocked_pending_review", "stale_needs_resend"]
    },
    "request_provenance_class": {
      "type": "string",
      "enum": [
        "local_only_history",
        "imported_snapshot",
        "provider_linked_contract",
        "managed_shared_artifact"
      ]
    },
    "saved_view_visibility": {
      "type": "string",
      "enum": ["private_local", "workspace_shared"]
    },
    "contract_source_class": {
      "type": "string",
      "enum": [
        "live_contract",
        "cached_schema",
        "imported_snapshot",
        "plugin_provided",
        "contract_unavailable"
      ]
    },
    "contract_freshness_state": {
      "type": "string",
      "enum": [
        "live_contract",
        "cached_schema",
        "schema_stale",
        "imported_snapshot",
        "contract_unavailable"
      ]
    },
    "retention_mode": {
      "type": "string",
      "enum": ["text_first_versioned", "metadata_only", "redacted_replayable", "opt_in_full_capture"]
    },
    "export_redaction_class": {
      "type": "string",
      "enum": ["full_redaction", "metadata_only", "safe_preview", "unredacted_local_only"]
    },
    "request_views_qualification_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "captured_at", "evidence_refs"],
      "properties": {
        "packet_id": { "type": "string" },
        "packet_ref": { "type": "string" },
        "proof_index_ref": { "type": "string" },
        "captured_at": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "request_views_surface_guard_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_class_visible",
        "environment_visible",
        "contract_source_badge_visible",
        "last_run_state_visible",
        "retention_mode_visible",
        "provenance_visible",
        "keyboard_navigable",
        "stable_ids",
        "detail_inspect_export_actions",
        "identity_not_friendly_name_only",
        "drift_not_hidden_by_green_send",
        "shared_view_trust_isolated",
        "text_first_diffable"
      ],
      "properties": {
        "protocol_class_visible": { "type": "boolean" },
        "environment_visible": { "type": "boolean" },
        "contract_source_badge_visible": { "type": "boolean" },
        "last_run_state_visible": { "type": "boolean" },
        "retention_mode_visible": { "type": "boolean" },
        "provenance_visible": { "type": "boolean" },
        "keyboard_navigable": { "type": "boolean" },
        "stable_ids": { "type": "boolean" },
        "detail_inspect_export_actions": { "type": "boolean" },
        "identity_not_friendly_name_only": { "type": "boolean" },
        "drift_not_hidden_by_green_send": { "type": "boolean" },
        "shared_view_trust_isolated": { "type": "boolean" },
        "text_first_diffable": { "type": "boolean" }
      }
    },
    "request_views_surface_qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "surface_kind",
        "promoted_build_surface",
        "claim_label",
        "displayed_label",
        "qualification_packet",
        "guards",
        "downgrade_if_missing",
        "rationale"
      ],
      "properties": {
        "surface_id": { "type": "string" },
        "title": { "type": "string" },
        "surface_kind": { "$ref": "#/$defs/request_views_surface_kind" },
        "promoted_build_surface": { "type": "boolean" },
        "claim_label": { "$ref": "#/$defs/request_views_qualification_label" },
        "displayed_label": { "$ref": "#/$defs/request_views_qualification_label" },
        "qualification_packet": { "oneOf": [{ "$ref": "#/$defs/request_views_qualification_proof" }, { "type": "null" }] },
        "guards": { "$ref": "#/$defs/request_views_surface_guard_set" },
        "downgrade_if_missing": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "collection_view_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_view_id",
        "title",
        "matrix_collection_ref",
        "request_view_refs",
        "protocol_classes",
        "environment_refs",
        "keyboard_navigable",
        "stable_id",
        "open_detail_available",
        "export_available",
        "export_redaction",
        "text_first_versioned",
        "diffable",
        "hides_protocol_or_environment_identity",
        "rationale"
      ],
      "properties": {
        "collection_view_id": { "type": "string" },
        "title": { "type": "string" },
        "matrix_collection_ref": { "type": "string" },
        "request_view_refs": { "type": "array", "items": { "type": "string" } },
        "protocol_classes": { "type": "array", "items": { "$ref": "#/$defs/protocol_class" } },
        "environment_refs": { "type": "array", "items": { "type": "string" } },
        "keyboard_navigable": { "type": "boolean" },
        "stable_id": { "type": "boolean" },
        "open_detail_available": { "type": "boolean" },
        "export_available": { "type": "boolean" },
        "export_redaction": { "$ref": "#/$defs/export_redaction_class" },
        "text_first_versioned": { "type": "boolean" },
        "diffable": { "type": "boolean" },
        "hides_protocol_or_environment_identity": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "request_list_view_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_view_id",
        "collection_view_ref",
        "matrix_request_ref",
        "protocol_class",
        "environment_ref",
        "provenance_class",
        "contract_source_class",
        "contract_freshness_state",
        "last_run_state",
        "retention_mode",
        "contract_source_badge_visible",
        "last_run_state_visible",
        "retention_mode_visible",
        "inspect_available",
        "export_available",
        "export_redaction",
        "drift_hidden_by_green_send",
        "friendly_name_only_identity",
        "stable_id",
        "rationale"
      ],
      "properties": {
        "request_view_id": { "type": "string" },
        "collection_view_ref": { "type": "string" },
        "matrix_request_ref": { "type": "string" },
        "protocol_class": { "$ref": "#/$defs/protocol_class" },
        "environment_ref": { "type": "string" },
        "provenance_class": { "$ref": "#/$defs/request_provenance_class" },
        "contract_source_class": { "$ref": "#/$defs/contract_source_class" },
        "contract_freshness_state": { "$ref": "#/$defs/contract_freshness_state" },
        "last_run_state": { "$ref": "#/$defs/last_run_state" },
        "retention_mode": { "$ref": "#/$defs/retention_mode" },
        "contract_source_badge_visible": { "type": "boolean" },
        "last_run_state_visible": { "type": "boolean" },
        "retention_mode_visible": { "type": "boolean" },
        "inspect_available": { "type": "boolean" },
        "export_available": { "type": "boolean" },
        "export_redaction": { "$ref": "#/$defs/export_redaction_class" },
        "drift_hidden_by_green_send": { "type": "boolean" },
        "friendly_name_only_identity": { "type": "boolean" },
        "stable_id": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "environment_view_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_view_id",
        "friendly_name",
        "environment_class",
        "resolved_target_label",
        "matrix_origin_ref",
        "inherits_local_trust",
        "explicit_identity_visible",
        "rationale"
      ],
      "properties": {
        "environment_view_id": { "type": "string" },
        "friendly_name": { "type": "string" },
        "environment_class": { "$ref": "#/$defs/environment_class" },
        "resolved_target_label": { "type": "string" },
        "matrix_origin_ref": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "inherits_local_trust": { "type": "boolean" },
        "explicit_identity_visible": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "saved_view_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved_view_id",
        "title",
        "visibility",
        "collection_view_refs",
        "filter_summary",
        "opaque_binary_state",
        "inherits_local_trust",
        "diffable",
        "rationale"
      ],
      "properties": {
        "saved_view_id": { "type": "string" },
        "title": { "type": "string" },
        "visibility": { "$ref": "#/$defs/saved_view_visibility" },
        "collection_view_refs": { "type": "array", "items": { "type": "string" } },
        "filter_summary": { "type": "string" },
        "opaque_binary_state": { "type": "boolean" },
        "inherits_local_trust": { "type": "boolean" },
        "diffable": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "request_views_upstream_ref_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "upstream_record_kind", "upstream_packet_path", "upstream_schema_path", "integration_verified", "rationale"],
      "properties": {
        "ref_id": { "type": "string" },
        "upstream_record_kind": { "type": "string" },
        "upstream_packet_path": { "type": "string" },
        "upstream_schema_path": { "type": "string" },
        "integration_verified": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "request_views_qualification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoted_surface_count",
        "stable_surface_count",
        "narrowed_surface_count",
        "collection_view_count",
        "request_view_count",
        "environment_view_count",
        "saved_view_count",
        "upstream_ref_count",
        "integration_pass_count"
      ],
      "properties": {
        "promoted_surface_count": { "type": "integer", "minimum": 0 },
        "stable_surface_count": { "type": "integer", "minimum": 0 },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "collection_view_count": { "type": "integer", "minimum": 0 },
        "request_view_count": { "type": "integer", "minimum": 0 },
        "environment_view_count": { "type": "integer", "minimum": 0 },
        "saved_view_count": { "type": "integer", "minimum": 0 },
        "upstream_ref_count": { "type": "integer", "minimum": 0 },
        "integration_pass_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
