{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/data/ship-contract-freshness-banners-imported-snapshot-labels-and-refresh-diff-or-open-spec-flows.schema.json",
  "title": "Aureline contract freshness banner and refresh/diff/open-spec flow packet",
  "description": "Boundary schema for the contract freshness banner, imported-snapshot label, and refresh/diff/open-spec flow qualification record. Each banner keeps source service, snapshot date, freshness state, mirror/offline note, and refresh/open-details actions inspectable wherever validation or completion depends on a contract snapshot. Stale and imported snapshots are always labeled and never appear equivalent to live contracts; companion and managed origins never inherit desktop-local trust. Raw endpoint URLs, raw secrets, raw request bodies, raw headers, and raw schema payloads do not appear in this packet.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "release_doc_ref",
    "help_doc_ref",
    "schema_ref",
    "surfaces",
    "banners",
    "refresh_flows",
    "diff_flows",
    "open_spec_flows",
    "upstream_refs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "ship_contract_freshness_banners_imported_snapshot_labels_and_refresh_diff_or_open_spec_flows"
    },
    "packet_id": { "$ref": "#/$defs/opaque_id" },
    "as_of": { "type": "string", "format": "date" },
    "release_doc_ref": { "$ref": "#/$defs/path_ref" },
    "help_doc_ref": { "$ref": "#/$defs/path_ref" },
    "schema_ref": { "$ref": "#/$defs/path_ref" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/freshness_banner_surface_qualification_row" }
    },
    "banners": {
      "type": "array",
      "items": { "$ref": "#/$defs/freshness_banner_row" }
    },
    "refresh_flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/refresh_flow_row" }
    },
    "diff_flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/diff_flow_row" }
    },
    "open_spec_flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/open_spec_flow_row" }
    },
    "upstream_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/freshness_banner_upstream_ref_row" }
    },
    "summary": { "$ref": "#/$defs/freshness_banner_qualification_summary" }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[_.:-][a-z0-9]+)*$"
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "freshness_banner_qualification_label": {
      "type": "string",
      "enum": ["stable", "preview", "labs", "inspect_only", "import_only"]
    },
    "freshness_banner_surface_kind": {
      "type": "string",
      "enum": [
        "request_composer",
        "completion_provider",
        "browser_companion_surface",
        "cli_headless_output",
        "support_export",
        "help_about"
      ]
    },
    "contract_kind": {
      "type": "string",
      "enum": ["rest", "graphql", "plugin_owned"]
    },
    "contract_source_class": {
      "type": "string",
      "enum": [
        "live_contract",
        "cached_schema",
        "imported_snapshot",
        "plugin_provided",
        "contract_unavailable"
      ]
    },
    "contract_freshness_state": {
      "type": "string",
      "enum": [
        "live_contract",
        "cached_schema",
        "schema_stale",
        "imported_snapshot",
        "contract_unavailable"
      ]
    },
    "banner_severity_class": {
      "type": "string",
      "enum": [
        "informational",
        "advisory",
        "stale_warning",
        "imported_notice",
        "unavailable_block"
      ]
    },
    "request_origin_kind": {
      "type": "string",
      "enum": ["local_host", "remote", "container", "managed", "browser_companion"]
    },
    "offline_mirror_behavior": {
      "type": "string",
      "enum": ["mirror_maintained", "offline_degraded", "no_mirror"]
    },
    "freshness_banner_action": {
      "type": "string",
      "enum": ["refresh", "diff", "open_spec", "open_details"]
    },
    "refresh_mode": {
      "type": "string",
      "enum": ["fetch_live", "revalidate_cache", "reimport_snapshot"]
    },
    "spec_target_kind": {
      "type": "string",
      "enum": ["inline_schema_view", "external_spec_doc", "provider_console"]
    },
    "retention_mode": {
      "type": "string",
      "enum": ["text_first_versioned", "metadata_only", "redacted_replayable", "opt_in_full_capture"]
    },
    "export_redaction_class": {
      "type": "string",
      "enum": ["full_redaction", "metadata_only", "safe_preview", "unredacted_local_only"]
    },
    "freshness_banner_qualification_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "captured_at", "evidence_refs"],
      "properties": {
        "packet_id": { "type": "string" },
        "packet_ref": { "type": "string" },
        "proof_index_ref": { "type": "string" },
        "captured_at": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "freshness_banner_surface_guard_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness_banner_visible",
        "source_service_visible",
        "snapshot_date_visible",
        "freshness_state_visible",
        "mirror_offline_note_visible",
        "refresh_action_available",
        "open_details_action_available",
        "imported_snapshot_labeled",
        "stale_not_equivalent_to_live",
        "companion_managed_freshness_not_hidden",
        "no_silent_raw_fallback",
        "local_request_context_preserved",
        "trust_isolated"
      ],
      "properties": {
        "freshness_banner_visible": { "type": "boolean" },
        "source_service_visible": { "type": "boolean" },
        "snapshot_date_visible": { "type": "boolean" },
        "freshness_state_visible": { "type": "boolean" },
        "mirror_offline_note_visible": { "type": "boolean" },
        "refresh_action_available": { "type": "boolean" },
        "open_details_action_available": { "type": "boolean" },
        "imported_snapshot_labeled": { "type": "boolean" },
        "stale_not_equivalent_to_live": { "type": "boolean" },
        "companion_managed_freshness_not_hidden": { "type": "boolean" },
        "no_silent_raw_fallback": { "type": "boolean" },
        "local_request_context_preserved": { "type": "boolean" },
        "trust_isolated": { "type": "boolean" }
      }
    },
    "freshness_banner_surface_qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "surface_kind",
        "promoted_build_surface",
        "claim_label",
        "displayed_label",
        "qualification_packet",
        "guards",
        "downgrade_if_missing",
        "rationale"
      ],
      "properties": {
        "surface_id": { "type": "string" },
        "title": { "type": "string" },
        "surface_kind": { "$ref": "#/$defs/freshness_banner_surface_kind" },
        "promoted_build_surface": { "type": "boolean" },
        "claim_label": { "$ref": "#/$defs/freshness_banner_qualification_label" },
        "displayed_label": { "$ref": "#/$defs/freshness_banner_qualification_label" },
        "qualification_packet": { "oneOf": [{ "$ref": "#/$defs/freshness_banner_qualification_proof" }, { "type": "null" }] },
        "guards": { "$ref": "#/$defs/freshness_banner_surface_guard_set" },
        "downgrade_if_missing": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "freshness_banner_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banner_id",
        "surface_ref",
        "contract_kind",
        "matrix_contract_ref",
        "source_service_label",
        "source_class",
        "freshness_state",
        "severity",
        "snapshot_date",
        "origin_kind",
        "mirror_offline_behavior",
        "mirror_offline_note",
        "validation_or_completion_dependent",
        "available_actions",
        "source_service_visible",
        "snapshot_date_visible",
        "freshness_state_visible",
        "mirror_offline_note_visible",
        "imported_snapshot_labeled",
        "may_appear_equivalent_to_live",
        "hidden_on_companion_or_managed",
        "inherits_local_trust",
        "rationale"
      ],
      "properties": {
        "banner_id": { "type": "string" },
        "surface_ref": { "type": "string" },
        "contract_kind": { "$ref": "#/$defs/contract_kind" },
        "matrix_contract_ref": { "type": "string" },
        "source_service_label": { "type": "string" },
        "source_class": { "$ref": "#/$defs/contract_source_class" },
        "freshness_state": { "$ref": "#/$defs/contract_freshness_state" },
        "severity": { "$ref": "#/$defs/banner_severity_class" },
        "snapshot_date": { "type": "string" },
        "origin_kind": { "$ref": "#/$defs/request_origin_kind" },
        "mirror_offline_behavior": { "$ref": "#/$defs/offline_mirror_behavior" },
        "mirror_offline_note": { "type": "string" },
        "validation_or_completion_dependent": { "type": "boolean" },
        "available_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/freshness_banner_action" }
        },
        "source_service_visible": { "type": "boolean" },
        "snapshot_date_visible": { "type": "boolean" },
        "freshness_state_visible": { "type": "boolean" },
        "mirror_offline_note_visible": { "type": "boolean" },
        "imported_snapshot_labeled": { "type": "boolean" },
        "may_appear_equivalent_to_live": { "type": "boolean" },
        "hidden_on_companion_or_managed": { "type": "boolean" },
        "inherits_local_trust": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "refresh_flow_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "banner_ref",
        "from_freshness",
        "refresh_mode",
        "result_freshness",
        "preserves_local_request_context",
        "local_edits_preserved",
        "requires_origin_ack_on_retarget",
        "falls_back_to_raw_on_failure",
        "drift_blocks_silent_raw_fallback",
        "rationale"
      ],
      "properties": {
        "flow_id": { "type": "string" },
        "banner_ref": { "type": "string" },
        "from_freshness": { "$ref": "#/$defs/contract_freshness_state" },
        "refresh_mode": { "$ref": "#/$defs/refresh_mode" },
        "result_freshness": { "$ref": "#/$defs/contract_freshness_state" },
        "preserves_local_request_context": { "type": "boolean" },
        "local_edits_preserved": { "type": "boolean" },
        "requires_origin_ack_on_retarget": { "type": "boolean" },
        "falls_back_to_raw_on_failure": { "type": "boolean" },
        "drift_blocks_silent_raw_fallback": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "diff_flow_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "banner_ref",
        "base_snapshot_ref",
        "compare_snapshot_ref",
        "base_version_label",
        "compare_version_label",
        "preserves_version_identity",
        "preserves_snapshot_identity",
        "support_export_parity",
        "export_redaction",
        "history_retention_mode",
        "forces_unsafe_body_header_retention",
        "drops_local_request_context",
        "rationale"
      ],
      "properties": {
        "flow_id": { "type": "string" },
        "banner_ref": { "type": "string" },
        "base_snapshot_ref": { "type": "string" },
        "compare_snapshot_ref": { "type": "string" },
        "base_version_label": { "type": "string" },
        "compare_version_label": { "type": "string" },
        "preserves_version_identity": { "type": "boolean" },
        "preserves_snapshot_identity": { "type": "boolean" },
        "support_export_parity": { "type": "boolean" },
        "export_redaction": { "$ref": "#/$defs/export_redaction_class" },
        "history_retention_mode": { "$ref": "#/$defs/retention_mode" },
        "forces_unsafe_body_header_retention": { "type": "boolean" },
        "drops_local_request_context": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "open_spec_flow_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "banner_ref",
        "spec_target",
        "snapshot_ref",
        "preserves_snapshot_identity",
        "opens_live_when_available",
        "support_export_parity",
        "drops_local_request_context",
        "rationale"
      ],
      "properties": {
        "flow_id": { "type": "string" },
        "banner_ref": { "type": "string" },
        "spec_target": { "$ref": "#/$defs/spec_target_kind" },
        "snapshot_ref": { "type": "string" },
        "preserves_snapshot_identity": { "type": "boolean" },
        "opens_live_when_available": { "type": "boolean" },
        "support_export_parity": { "type": "boolean" },
        "drops_local_request_context": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "freshness_banner_upstream_ref_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "upstream_record_kind", "upstream_packet_path", "upstream_schema_path", "integration_verified", "rationale"],
      "properties": {
        "ref_id": { "type": "string" },
        "upstream_record_kind": { "type": "string" },
        "upstream_packet_path": { "type": "string" },
        "upstream_schema_path": { "type": "string" },
        "integration_verified": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "freshness_banner_qualification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoted_surface_count",
        "stable_surface_count",
        "narrowed_surface_count",
        "banner_count",
        "refresh_flow_count",
        "diff_flow_count",
        "open_spec_flow_count",
        "upstream_ref_count",
        "integration_pass_count"
      ],
      "properties": {
        "promoted_surface_count": { "type": "integer", "minimum": 0 },
        "stable_surface_count": { "type": "integer", "minimum": 0 },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "banner_count": { "type": "integer", "minimum": 0 },
        "refresh_flow_count": { "type": "integer", "minimum": 0 },
        "diff_flow_count": { "type": "integer", "minimum": 0 },
        "open_spec_flow_count": { "type": "integer", "minimum": 0 },
        "upstream_ref_count": { "type": "integer", "minimum": 0 },
        "integration_pass_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
