{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/data/certify-api-collections-graphql-freshness-request-origin-truth-and-persisted-operation-continuity-across-request-profiles.schema.json",
  "title": "Aureline API request-profile certification packet for collections, GraphQL freshness, request-origin truth, and persisted-operation continuity",
  "description": "Boundary schema for request-profile certification records that certify API collections, contract/GraphQL freshness, request-origin truth, and persisted-operation continuity across desktop-local, CLI, remote, container, managed-workspace, browser-companion, and mirror/offline profiles. Raw endpoint URLs, raw secrets, raw credential bodies, and raw request or response payloads do not appear in this packet; cases reference fixtures rather than inline payloads.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "release_doc_ref",
    "help_doc_ref",
    "schema_ref",
    "surfaces",
    "profiles",
    "cases",
    "downgrade_rules",
    "upstream_refs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "certify_api_collections_graphql_freshness_request_origin_truth_and_persisted_operation_continuity_across_request_profiles"
    },
    "packet_id": { "$ref": "#/$defs/opaque_id" },
    "as_of": { "type": "string", "format": "date" },
    "release_doc_ref": { "$ref": "#/$defs/path_ref" },
    "help_doc_ref": { "$ref": "#/$defs/path_ref" },
    "schema_ref": { "$ref": "#/$defs/path_ref" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_qualification_row" }
    },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/request_profile_row" }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile_certification_case_row" }
    },
    "downgrade_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_rule_row" }
    },
    "upstream_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/upstream_ref_row" }
    },
    "summary": { "$ref": "#/$defs/qualification_summary" }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[_.:-][a-z0-9]+)*$"
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "reviewable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480
    },
    "qualification_label": {
      "type": "string",
      "enum": ["stable", "preview", "labs", "inspect_only", "import_only"]
    },
    "request_profile_class": {
      "type": "string",
      "enum": [
        "desktop_local",
        "cli",
        "remote",
        "container",
        "managed",
        "browser_companion",
        "mirror_offline"
      ]
    },
    "certification_dimension": {
      "type": "string",
      "enum": [
        "api_collections",
        "contract_freshness",
        "request_origin_truth",
        "persisted_operation_continuity",
        "history_retention",
        "auth_source_labeling"
      ]
    },
    "certification_corpus_class": {
      "type": "string",
      "enum": [
        "schema_stale",
        "origin_changed_rerun",
        "persisted_operation_drift",
        "persisted_operation_deprecation",
        "mirror_offline_snapshot",
        "export_redaction"
      ]
    },
    "certification_outcome": {
      "type": "string",
      "enum": ["certified", "narrowed_claim", "blocked"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "missing_proof",
        "schema_stale",
        "origin_changed",
        "persisted_operation_drift",
        "persisted_operation_deprecation",
        "mirror_offline_unavailable",
        "overclaimed_validation_confidence",
        "overclaimed_origin_stability"
      ]
    },
    "surface_kind": {
      "type": "string",
      "enum": [
        "profile_certification_scorecard",
        "compatibility_report",
        "downgrade_automation",
        "release_center",
        "service_health",
        "support_export",
        "help_about"
      ]
    },
    "qualification_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "captured_at", "evidence_refs"],
      "properties": {
        "packet_id": { "type": "string" },
        "packet_ref": { "type": "string" },
        "proof_index_ref": { "type": "string" },
        "captured_at": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "surface_guard_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles_visible",
        "collections_visible",
        "contract_freshness_visible",
        "request_origin_visible",
        "persisted_operation_visible",
        "retention_posture_visible",
        "corpus_coverage_visible",
        "origin_trust_isolated",
        "no_silent_raw_fallback",
        "downgrade_rules_visible",
        "upstream_refs_visible"
      ],
      "properties": {
        "profiles_visible": { "type": "boolean" },
        "collections_visible": { "type": "boolean" },
        "contract_freshness_visible": { "type": "boolean" },
        "request_origin_visible": { "type": "boolean" },
        "persisted_operation_visible": { "type": "boolean" },
        "retention_posture_visible": { "type": "boolean" },
        "corpus_coverage_visible": { "type": "boolean" },
        "origin_trust_isolated": { "type": "boolean" },
        "no_silent_raw_fallback": { "type": "boolean" },
        "downgrade_rules_visible": { "type": "boolean" },
        "upstream_refs_visible": { "type": "boolean" }
      }
    },
    "surface_qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "surface_kind",
        "promoted_build_surface",
        "claim_label",
        "displayed_label",
        "qualification_packet",
        "guards",
        "downgrade_if_missing",
        "rationale"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/opaque_id" },
        "title": { "type": "string" },
        "surface_kind": { "$ref": "#/$defs/surface_kind" },
        "promoted_build_surface": { "type": "boolean" },
        "claim_label": { "$ref": "#/$defs/qualification_label" },
        "displayed_label": { "$ref": "#/$defs/qualification_label" },
        "qualification_packet": { "oneOf": [{ "$ref": "#/$defs/qualification_proof" }, { "type": "null" }] },
        "guards": { "$ref": "#/$defs/surface_guard_set" },
        "downgrade_if_missing": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/reviewable" }
      }
    },
    "request_profile_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "title",
        "profile_class",
        "claim_label",
        "displayed_label",
        "certified_dimensions",
        "live_online_only_fixtures",
        "trust_isolated_from_desktop_local",
        "downgrade_if_missing",
        "rationale"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/opaque_id" },
        "title": { "type": "string" },
        "profile_class": { "$ref": "#/$defs/request_profile_class" },
        "claim_label": { "$ref": "#/$defs/qualification_label" },
        "displayed_label": { "$ref": "#/$defs/qualification_label" },
        "certified_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certification_dimension" }
        },
        "live_online_only_fixtures": { "type": "boolean" },
        "trust_isolated_from_desktop_local": { "type": "boolean" },
        "downgrade_if_missing": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/reviewable" }
      }
    },
    "profile_certification_case_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "profile_ref",
        "dimension",
        "corpus_class",
        "outcome",
        "claim_label",
        "displayed_label",
        "blocks_unsafe_fallback",
        "preserves_safe_retention_default",
        "trust_isolated_from_desktop_local",
        "downgrade_if_missing",
        "evidence_ref",
        "rationale"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/opaque_id" },
        "profile_ref": { "$ref": "#/$defs/opaque_id" },
        "dimension": { "$ref": "#/$defs/certification_dimension" },
        "corpus_class": { "$ref": "#/$defs/certification_corpus_class" },
        "outcome": { "$ref": "#/$defs/certification_outcome" },
        "claim_label": { "$ref": "#/$defs/qualification_label" },
        "displayed_label": { "$ref": "#/$defs/qualification_label" },
        "blocks_unsafe_fallback": { "type": "boolean" },
        "preserves_safe_retention_default": { "type": "boolean" },
        "trust_isolated_from_desktop_local": { "type": "boolean" },
        "downgrade_if_missing": { "type": "boolean" },
        "evidence_ref": { "$ref": "#/$defs/path_ref" },
        "rationale": { "$ref": "#/$defs/reviewable" }
      }
    },
    "downgrade_rule_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "trigger", "target_ref", "narrows_to", "automatic", "rationale"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/opaque_id" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "target_ref": { "$ref": "#/$defs/opaque_id" },
        "narrows_to": { "$ref": "#/$defs/qualification_label" },
        "automatic": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/reviewable" }
      }
    },
    "upstream_ref_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "upstream_record_kind", "upstream_packet_path", "upstream_schema_path", "integration_verified", "rationale"],
      "properties": {
        "ref_id": { "$ref": "#/$defs/opaque_id" },
        "upstream_record_kind": { "type": "string" },
        "upstream_packet_path": { "$ref": "#/$defs/path_ref" },
        "upstream_schema_path": { "$ref": "#/$defs/path_ref" },
        "integration_verified": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/reviewable" }
      }
    },
    "qualification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoted_surface_count",
        "stable_surface_count",
        "narrowed_surface_count",
        "profile_count",
        "stable_profile_count",
        "case_count",
        "certified_case_count",
        "downgrade_rule_count",
        "upstream_ref_count",
        "integration_pass_count"
      ],
      "properties": {
        "promoted_surface_count": { "type": "integer", "minimum": 0 },
        "stable_surface_count": { "type": "integer", "minimum": 0 },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "stable_profile_count": { "type": "integer", "minimum": 0 },
        "case_count": { "type": "integer", "minimum": 0 },
        "certified_case_count": { "type": "integer", "minimum": 0 },
        "downgrade_rule_count": { "type": "integer", "minimum": 0 },
        "upstream_ref_count": { "type": "integer", "minimum": 0 },
        "integration_pass_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
