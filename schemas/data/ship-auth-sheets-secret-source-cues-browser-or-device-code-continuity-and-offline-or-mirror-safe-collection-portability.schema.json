{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/data/ship-auth-sheets-secret-source-cues-browser-or-device-code-continuity-and-offline-or-mirror-safe-collection-portability.schema.json",
  "title": "Aureline auth sheets, secret-source cues, browser/device-code continuity, and offline or mirror-safe collection portability packet",
  "description": "Boundary schema for the auth/portability qualification record. Each auth sheet states the auth scheme, secret source mode, token lifetime, expiry label, browser/device-code continuity state, and policy note without persisting a raw secret. Each secret-source cue names where a credential resolves from and its provenance without exposing the value. Each browser/device-code continuity row keeps an interrupted browser or device-code flow resumable behind a non-secret verification handle and a user-action prompt. Each collection-portability row preserves contract source, retention mode, and redaction posture across export/import and labels contract freshness honestly when a collection reopens offline or from a mirror, never masquerading stale or imported truth as live. Raw secrets, raw tokens, raw credential bodies, raw cookies, and raw certificate keys do not appear in this packet.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "release_doc_ref",
    "help_doc_ref",
    "schema_ref",
    "surfaces",
    "auth_sheets",
    "secret_source_cues",
    "continuities",
    "collection_portabilities",
    "upstream_refs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "ship_auth_sheets_secret_source_cues_browser_or_device_code_continuity_and_offline_or_mirror_safe_collection_portability"
    },
    "packet_id": { "$ref": "#/$defs/opaque_id" },
    "as_of": { "type": "string", "format": "date" },
    "release_doc_ref": { "$ref": "#/$defs/path_ref" },
    "help_doc_ref": { "$ref": "#/$defs/path_ref" },
    "schema_ref": { "$ref": "#/$defs/path_ref" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/auth_portability_surface_qualification_row" }
    },
    "auth_sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/auth_sheet_row" }
    },
    "secret_source_cues": {
      "type": "array",
      "items": { "$ref": "#/$defs/secret_source_cue_row" }
    },
    "continuities": {
      "type": "array",
      "items": { "$ref": "#/$defs/browser_device_code_continuity_row" }
    },
    "collection_portabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection_portability_row" }
    },
    "upstream_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/auth_portability_upstream_ref_row" }
    },
    "summary": { "$ref": "#/$defs/auth_portability_qualification_summary" }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[_.:-][a-z0-9]+)*$"
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "auth_portability_qualification_label": {
      "type": "string",
      "enum": ["stable", "preview", "labs", "inspect_only", "import_only"]
    },
    "auth_portability_surface_kind": {
      "type": "string",
      "enum": [
        "auth_sheet_panel",
        "secret_source_cue",
        "browser_device_code_flow",
        "collection_portability",
        "cli_headless_output",
        "support_export",
        "help_about"
      ]
    },
    "auth_scheme_class": {
      "type": "string",
      "enum": [
        "no_auth",
        "basic",
        "bearer",
        "api_key",
        "o_auth2_authorization_code",
        "o_auth2_client_credentials",
        "o_auth2_device_code",
        "browser_session",
        "mtls"
      ]
    },
    "token_lifetime_class": {
      "type": "string",
      "enum": ["no_expiry", "short_lived", "refreshable", "expired", "session_bound", "unknown"]
    },
    "browser_device_code_state": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending",
        "awaiting_user_authorization",
        "authorized",
        "expired",
        "denied"
      ]
    },
    "portability_direction": {
      "type": "string",
      "enum": ["export", "import"]
    },
    "request_origin_kind": {
      "type": "string",
      "enum": ["local_host", "remote", "container", "managed", "browser_companion"]
    },
    "auth_source_mode": {
      "type": "string",
      "enum": [
        "no_auth",
        "secret_broker_handle",
        "delegated_identity",
        "policy_injected_credential",
        "managed_service_identity",
        "mtls",
        "imported_no_live_auth",
        "policy_blocked"
      ]
    },
    "auth_source_provenance": {
      "type": "string",
      "enum": ["request_file", "workspace_default", "policy_injection", "ad_hoc_override", "secret_broker"]
    },
    "secret_safe_auth_storage_mode": {
      "type": "string",
      "enum": ["local_encrypted", "secret_broker_only", "managed_rotation", "policy_locked"]
    },
    "contract_source_class": {
      "type": "string",
      "enum": ["live_contract", "cached_schema", "imported_snapshot", "plugin_provided", "contract_unavailable"]
    },
    "contract_freshness_state": {
      "type": "string",
      "enum": ["live_contract", "cached_schema", "schema_stale", "imported_snapshot", "contract_unavailable"]
    },
    "retention_mode": {
      "type": "string",
      "enum": ["text_first_versioned", "metadata_only", "redacted_replayable", "opt_in_full_capture"]
    },
    "export_redaction_class": {
      "type": "string",
      "enum": ["full_redaction", "metadata_only", "safe_preview", "unredacted_local_only"]
    },
    "offline_mirror_behavior": {
      "type": "string",
      "enum": ["mirror_maintained", "offline_degraded", "no_mirror"]
    },
    "mirror_or_offline_state_class": {
      "type": "string",
      "enum": ["online_default", "online_replica", "offline_grace_window", "offline_local_only", "network_disabled"]
    },
    "auth_portability_qualification_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "captured_at", "evidence_refs"],
      "properties": {
        "packet_id": { "type": "string" },
        "packet_ref": { "type": "string" },
        "proof_index_ref": { "type": "string" },
        "captured_at": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "auth_portability_surface_guard_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_scheme_visible",
        "secret_source_visible",
        "expiry_visible",
        "browser_device_code_visible",
        "policy_note_visible",
        "no_raw_secret_persistence",
        "contract_source_preserved",
        "retention_mode_preserved",
        "redaction_posture_preserved",
        "contract_freshness_labeled",
        "offline_mirror_honest",
        "origin_trust_isolated",
        "text_first_versionable"
      ],
      "properties": {
        "auth_scheme_visible": { "type": "boolean" },
        "secret_source_visible": { "type": "boolean" },
        "expiry_visible": { "type": "boolean" },
        "browser_device_code_visible": { "type": "boolean" },
        "policy_note_visible": { "type": "boolean" },
        "no_raw_secret_persistence": { "type": "boolean" },
        "contract_source_preserved": { "type": "boolean" },
        "retention_mode_preserved": { "type": "boolean" },
        "redaction_posture_preserved": { "type": "boolean" },
        "contract_freshness_labeled": { "type": "boolean" },
        "offline_mirror_honest": { "type": "boolean" },
        "origin_trust_isolated": { "type": "boolean" },
        "text_first_versionable": { "type": "boolean" }
      }
    },
    "auth_portability_surface_qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "surface_kind",
        "promoted_build_surface",
        "claim_label",
        "displayed_label",
        "qualification_packet",
        "guards",
        "downgrade_if_missing",
        "rationale"
      ],
      "properties": {
        "surface_id": { "type": "string" },
        "title": { "type": "string" },
        "surface_kind": { "$ref": "#/$defs/auth_portability_surface_kind" },
        "promoted_build_surface": { "type": "boolean" },
        "claim_label": { "$ref": "#/$defs/auth_portability_qualification_label" },
        "displayed_label": { "$ref": "#/$defs/auth_portability_qualification_label" },
        "qualification_packet": { "oneOf": [{ "$ref": "#/$defs/auth_portability_qualification_proof" }, { "type": "null" }] },
        "guards": { "$ref": "#/$defs/auth_portability_surface_guard_set" },
        "downgrade_if_missing": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "auth_sheet_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_sheet_id",
        "surface_ref",
        "request_identity_ref",
        "auth_scheme",
        "origin_scope",
        "secret_source_mode",
        "secret_cue_ref",
        "token_lifetime",
        "expiry_label",
        "browser_device_code_state",
        "policy_note",
        "auth_scheme_visible",
        "secret_source_visible",
        "expiry_visible",
        "browser_device_code_visible",
        "policy_note_visible",
        "includes_raw_secret",
        "persists_secret_in_request_file",
        "local_trust_isolated",
        "rationale"
      ],
      "properties": {
        "auth_sheet_id": { "type": "string" },
        "surface_ref": { "type": "string" },
        "request_identity_ref": { "type": "string" },
        "auth_scheme": { "$ref": "#/$defs/auth_scheme_class" },
        "origin_scope": { "$ref": "#/$defs/request_origin_kind" },
        "secret_source_mode": { "$ref": "#/$defs/auth_source_mode" },
        "secret_cue_ref": { "type": "string" },
        "token_lifetime": { "$ref": "#/$defs/token_lifetime_class" },
        "expiry_label": { "type": "string" },
        "browser_device_code_state": { "$ref": "#/$defs/browser_device_code_state" },
        "policy_note": { "type": "string" },
        "auth_scheme_visible": { "type": "boolean" },
        "secret_source_visible": { "type": "boolean" },
        "expiry_visible": { "type": "boolean" },
        "browser_device_code_visible": { "type": "boolean" },
        "policy_note_visible": { "type": "boolean" },
        "includes_raw_secret": { "type": "boolean" },
        "persists_secret_in_request_file": { "type": "boolean" },
        "local_trust_isolated": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "secret_source_cue_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_id",
        "auth_sheet_ref",
        "storage_mode",
        "provenance",
        "handle_ref",
        "cue_label",
        "visible_without_secret",
        "includes_raw_secret",
        "persists_secret_in_repo",
        "rationale"
      ],
      "properties": {
        "cue_id": { "type": "string" },
        "auth_sheet_ref": { "type": "string" },
        "storage_mode": { "$ref": "#/$defs/secret_safe_auth_storage_mode" },
        "provenance": { "$ref": "#/$defs/auth_source_provenance" },
        "handle_ref": { "type": "string" },
        "cue_label": { "type": "string" },
        "visible_without_secret": { "type": "boolean" },
        "includes_raw_secret": { "type": "boolean" },
        "persists_secret_in_repo": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "browser_device_code_continuity_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuity_id",
        "auth_sheet_ref",
        "flow_scheme",
        "state",
        "resumable",
        "user_action_label",
        "verification_handle_ref",
        "expiry_label",
        "origin_scope",
        "local_trust_isolated",
        "includes_raw_token",
        "rationale"
      ],
      "properties": {
        "continuity_id": { "type": "string" },
        "auth_sheet_ref": { "type": "string" },
        "flow_scheme": { "$ref": "#/$defs/auth_scheme_class" },
        "state": { "$ref": "#/$defs/browser_device_code_state" },
        "resumable": { "type": "boolean" },
        "user_action_label": { "type": "string" },
        "verification_handle_ref": { "type": "string" },
        "expiry_label": { "type": "string" },
        "origin_scope": { "$ref": "#/$defs/request_origin_kind" },
        "local_trust_isolated": { "type": "boolean" },
        "includes_raw_token": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "collection_portability_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portability_id",
        "surface_ref",
        "collection_ref",
        "direction",
        "contract_source",
        "contract_freshness",
        "retention_mode",
        "export_redaction_class",
        "offline_mirror_behavior",
        "mirror_state",
        "preserves_contract_source",
        "preserves_retention_mode",
        "preserves_redaction_posture",
        "contract_freshness_labeled",
        "includes_raw_secret",
        "persists_secret_in_export",
        "text_first",
        "rationale"
      ],
      "properties": {
        "portability_id": { "type": "string" },
        "surface_ref": { "type": "string" },
        "collection_ref": { "type": "string" },
        "direction": { "$ref": "#/$defs/portability_direction" },
        "contract_source": { "$ref": "#/$defs/contract_source_class" },
        "contract_freshness": { "$ref": "#/$defs/contract_freshness_state" },
        "retention_mode": { "$ref": "#/$defs/retention_mode" },
        "export_redaction_class": { "$ref": "#/$defs/export_redaction_class" },
        "offline_mirror_behavior": { "$ref": "#/$defs/offline_mirror_behavior" },
        "mirror_state": { "$ref": "#/$defs/mirror_or_offline_state_class" },
        "preserves_contract_source": { "type": "boolean" },
        "preserves_retention_mode": { "type": "boolean" },
        "preserves_redaction_posture": { "type": "boolean" },
        "contract_freshness_labeled": { "type": "boolean" },
        "includes_raw_secret": { "type": "boolean" },
        "persists_secret_in_export": { "type": "boolean" },
        "text_first": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "auth_portability_upstream_ref_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "upstream_record_kind", "upstream_packet_path", "upstream_schema_path", "integration_verified", "rationale"],
      "properties": {
        "ref_id": { "type": "string" },
        "upstream_record_kind": { "type": "string" },
        "upstream_packet_path": { "type": "string" },
        "upstream_schema_path": { "type": "string" },
        "integration_verified": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "auth_portability_qualification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoted_surface_count",
        "stable_surface_count",
        "narrowed_surface_count",
        "auth_sheet_count",
        "device_code_auth_sheet_count",
        "trust_isolated_auth_sheet_count",
        "secret_source_cue_count",
        "continuity_count",
        "resumable_continuity_count",
        "collection_portability_count",
        "offline_safe_portability_count",
        "upstream_ref_count",
        "integration_pass_count"
      ],
      "properties": {
        "promoted_surface_count": { "type": "integer", "minimum": 0 },
        "stable_surface_count": { "type": "integer", "minimum": 0 },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "auth_sheet_count": { "type": "integer", "minimum": 0 },
        "device_code_auth_sheet_count": { "type": "integer", "minimum": 0 },
        "trust_isolated_auth_sheet_count": { "type": "integer", "minimum": 0 },
        "secret_source_cue_count": { "type": "integer", "minimum": 0 },
        "continuity_count": { "type": "integer", "minimum": 0 },
        "resumable_continuity_count": { "type": "integer", "minimum": 0 },
        "collection_portability_count": { "type": "integer", "minimum": 0 },
        "offline_safe_portability_count": { "type": "integer", "minimum": 0 },
        "upstream_ref_count": { "type": "integer", "minimum": 0 },
        "integration_pass_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
