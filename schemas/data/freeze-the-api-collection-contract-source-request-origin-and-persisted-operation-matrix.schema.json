{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/data/freeze-the-api-collection-contract-source-request-origin-and-persisted-operation-matrix.schema.json",
  "title": "Aureline API-collection, contract-source, request-origin, and persisted-operation matrix packet",
  "description": "Boundary schema for the API-collection matrix qualification record covering operation collections, request lists, contract-source badges, schema freshness, request origins, persisted-operation bindings, and retention modes across REST, GraphQL, and plugin-owned contract rows and local/remote/container/managed/browser-companion origins. Raw endpoint URLs, raw secrets, raw request bodies, raw headers, and raw schema payloads do not appear in this packet; they require explicit drill-down or export review.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "release_doc_ref",
    "help_doc_ref",
    "schema_ref",
    "surfaces",
    "contracts",
    "collections",
    "requests",
    "origins",
    "persisted_operations",
    "retention_classes",
    "upstream_refs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "freeze_the_api_collection_contract_source_request_origin_and_persisted_operation_matrix" },
    "packet_id": { "$ref": "#/$defs/opaque_id" },
    "as_of": { "type": "string", "format": "date" },
    "release_doc_ref": { "$ref": "#/$defs/path_ref" },
    "help_doc_ref": { "$ref": "#/$defs/path_ref" },
    "schema_ref": { "$ref": "#/$defs/path_ref" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/api_matrix_surface_qualification_row" }
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract_row" }
    },
    "collections": {
      "type": "array",
      "items": { "$ref": "#/$defs/api_collection_row" }
    },
    "requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/request_list_row" }
    },
    "origins": {
      "type": "array",
      "items": { "$ref": "#/$defs/request_origin_row" }
    },
    "persisted_operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/persisted_operation_binding_row" }
    },
    "retention_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/retention_class_row" }
    },
    "upstream_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/upstream_ref_row" }
    },
    "summary": { "$ref": "#/$defs/api_matrix_qualification_summary" }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[_.:-][a-z0-9]+)*$"
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "api_matrix_qualification_label": {
      "type": "string",
      "enum": ["stable", "preview", "labs", "inspect_only", "import_only"]
    },
    "api_matrix_surface_kind": {
      "type": "string",
      "enum": [
        "request_workspace",
        "cli_headless_output",
        "diagnostics_surface",
        "support_export",
        "certification_scorecard"
      ]
    },
    "contract_kind": {
      "type": "string",
      "enum": ["rest", "graphql", "plugin_owned"]
    },
    "contract_source_class": {
      "type": "string",
      "enum": [
        "live_contract",
        "cached_schema",
        "imported_snapshot",
        "plugin_provided",
        "contract_unavailable"
      ]
    },
    "contract_freshness_state": {
      "type": "string",
      "enum": [
        "live_contract",
        "cached_schema",
        "schema_stale",
        "imported_snapshot",
        "contract_unavailable"
      ]
    },
    "request_origin_kind": {
      "type": "string",
      "enum": ["local_host", "remote", "container", "managed", "browser_companion"]
    },
    "request_origin_drift_state": {
      "type": "string",
      "enum": ["origin_stable", "origin_changed"]
    },
    "persisted_operation_binding_state": {
      "type": "string",
      "enum": ["not_persisted", "bound_current", "persisted_operation_drift"]
    },
    "request_binding_kind": {
      "type": "string",
      "enum": ["raw_local_text", "persisted_operation"]
    },
    "retention_scope": {
      "type": "string",
      "enum": ["collection", "history"]
    },
    "retention_mode": {
      "type": "string",
      "enum": ["text_first_versioned", "metadata_only", "redacted_replayable", "opt_in_full_capture"]
    },
    "offline_mirror_behavior": {
      "type": "string",
      "enum": ["mirror_maintained", "offline_degraded", "no_mirror"]
    },
    "api_matrix_qualification_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "captured_at", "evidence_refs"],
      "properties": {
        "packet_id": { "type": "string" },
        "packet_ref": { "type": "string" },
        "proof_index_ref": { "type": "string" },
        "captured_at": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "api_matrix_surface_guard_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_visible",
        "request_list_visible",
        "contract_source_visible",
        "schema_freshness_visible",
        "request_origin_visible",
        "persisted_operation_visible",
        "retention_posture_visible",
        "origin_trust_isolated",
        "no_silent_raw_fallback"
      ],
      "properties": {
        "collection_visible": { "type": "boolean" },
        "request_list_visible": { "type": "boolean" },
        "contract_source_visible": { "type": "boolean" },
        "schema_freshness_visible": { "type": "boolean" },
        "request_origin_visible": { "type": "boolean" },
        "persisted_operation_visible": { "type": "boolean" },
        "retention_posture_visible": { "type": "boolean" },
        "origin_trust_isolated": { "type": "boolean" },
        "no_silent_raw_fallback": { "type": "boolean" }
      }
    },
    "api_matrix_surface_qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "surface_kind",
        "promoted_build_surface",
        "claim_label",
        "displayed_label",
        "qualification_packet",
        "guards",
        "downgrade_if_missing",
        "rationale"
      ],
      "properties": {
        "surface_id": { "type": "string" },
        "title": { "type": "string" },
        "surface_kind": { "$ref": "#/$defs/api_matrix_surface_kind" },
        "promoted_build_surface": { "type": "boolean" },
        "claim_label": { "$ref": "#/$defs/api_matrix_qualification_label" },
        "displayed_label": { "$ref": "#/$defs/api_matrix_qualification_label" },
        "qualification_packet": { "oneOf": [{ "$ref": "#/$defs/api_matrix_qualification_proof" }, { "type": "null" }] },
        "guards": { "$ref": "#/$defs/api_matrix_surface_guard_set" },
        "downgrade_if_missing": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "contract_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_kind",
        "source_class",
        "freshness_state",
        "digest_ref",
        "origin_ref",
        "persisted_operation_ref",
        "source_badge_visible",
        "freshness_visible",
        "stale_labeled",
        "may_masquerade_as_live",
        "rationale"
      ],
      "properties": {
        "contract_id": { "type": "string" },
        "contract_kind": { "$ref": "#/$defs/contract_kind" },
        "source_class": { "$ref": "#/$defs/contract_source_class" },
        "freshness_state": { "$ref": "#/$defs/contract_freshness_state" },
        "digest_ref": { "type": "string" },
        "origin_ref": { "type": "string" },
        "persisted_operation_ref": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "source_badge_visible": { "type": "boolean" },
        "freshness_visible": { "type": "boolean" },
        "stale_labeled": { "type": "boolean" },
        "may_masquerade_as_live": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "api_collection_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_id",
        "title",
        "request_refs",
        "contract_refs",
        "retention_class_ref",
        "text_first_versioned",
        "diffable",
        "cli_reusable"
      ],
      "properties": {
        "collection_id": { "type": "string" },
        "title": { "type": "string" },
        "request_refs": { "type": "array", "items": { "type": "string" } },
        "contract_refs": { "type": "array", "items": { "type": "string" } },
        "retention_class_ref": { "type": "string" },
        "text_first_versioned": { "type": "boolean" },
        "diffable": { "type": "boolean" },
        "cli_reusable": { "type": "boolean" }
      }
    },
    "request_list_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "collection_ref",
        "contract_kind",
        "origin_ref",
        "binding_kind",
        "persisted_operation_ref",
        "raw_local_text",
        "method_or_operation_label",
        "diffable"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "collection_ref": { "type": "string" },
        "contract_kind": { "$ref": "#/$defs/contract_kind" },
        "origin_ref": { "type": "string" },
        "binding_kind": { "$ref": "#/$defs/request_binding_kind" },
        "persisted_operation_ref": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "raw_local_text": { "type": "boolean" },
        "method_or_operation_label": { "type": "string" },
        "diffable": { "type": "boolean" }
      }
    },
    "request_origin_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "origin_kind",
        "target_label",
        "drift_state",
        "inherits_local_trust",
        "explicit_naming",
        "retarget_requires_ack",
        "trust_class_ref",
        "rationale"
      ],
      "properties": {
        "origin_id": { "type": "string" },
        "origin_kind": { "$ref": "#/$defs/request_origin_kind" },
        "target_label": { "type": "string" },
        "drift_state": { "$ref": "#/$defs/request_origin_drift_state" },
        "inherits_local_trust": { "type": "boolean" },
        "explicit_naming": { "type": "boolean" },
        "retarget_requires_ack": { "type": "boolean" },
        "trust_class_ref": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "rationale": { "type": "string" }
      }
    },
    "persisted_operation_binding_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "operation_ref",
        "persisted_id_ref",
        "binding_state",
        "contract_ref",
        "drift_blocks_silent_raw_fallback",
        "falls_back_to_raw_silently",
        "rationale"
      ],
      "properties": {
        "binding_id": { "type": "string" },
        "operation_ref": { "type": "string" },
        "persisted_id_ref": { "type": "string" },
        "binding_state": { "$ref": "#/$defs/persisted_operation_binding_state" },
        "contract_ref": { "type": "string" },
        "drift_blocks_silent_raw_fallback": { "type": "boolean" },
        "falls_back_to_raw_silently": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "retention_class_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_id",
        "scope",
        "mode",
        "default_excludes_bodies",
        "default_excludes_headers",
        "opt_in_required_for_full_capture",
        "offline_mirror_behavior",
        "mirror_maintained",
        "rationale"
      ],
      "properties": {
        "retention_id": { "type": "string" },
        "scope": { "$ref": "#/$defs/retention_scope" },
        "mode": { "$ref": "#/$defs/retention_mode" },
        "default_excludes_bodies": { "type": "boolean" },
        "default_excludes_headers": { "type": "boolean" },
        "opt_in_required_for_full_capture": { "type": "boolean" },
        "offline_mirror_behavior": { "$ref": "#/$defs/offline_mirror_behavior" },
        "mirror_maintained": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "upstream_ref_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "upstream_record_kind", "upstream_packet_path", "upstream_schema_path", "integration_verified", "rationale"],
      "properties": {
        "ref_id": { "type": "string" },
        "upstream_record_kind": { "type": "string" },
        "upstream_packet_path": { "type": "string" },
        "upstream_schema_path": { "type": "string" },
        "integration_verified": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "api_matrix_qualification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoted_surface_count",
        "stable_surface_count",
        "narrowed_surface_count",
        "contract_count",
        "collection_count",
        "request_count",
        "origin_count",
        "persisted_operation_count",
        "retention_class_count",
        "upstream_ref_count",
        "integration_pass_count"
      ],
      "properties": {
        "promoted_surface_count": { "type": "integer", "minimum": 0 },
        "stable_surface_count": { "type": "integer", "minimum": 0 },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "contract_count": { "type": "integer", "minimum": 0 },
        "collection_count": { "type": "integer", "minimum": 0 },
        "request_count": { "type": "integer", "minimum": 0 },
        "origin_count": { "type": "integer", "minimum": 0 },
        "persisted_operation_count": { "type": "integer", "minimum": 0 },
        "retention_class_count": { "type": "integer", "minimum": 0 },
        "upstream_ref_count": { "type": "integer", "minimum": 0 },
        "integration_pass_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
