{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/data/add-persisted-operation-detail-hash-or-id-drift-checks-contract-version-review-and-no-unsafe-fallback-send-rules.schema.json",
  "title": "Aureline persisted-operation detail, drift-check, and no-unsafe-fallback send-rule packet",
  "description": "Boundary schema for the persisted-operation detail, hash/id drift-check, contract-version-review, and no-unsafe-fallback send-rule qualification record. Each detail row keeps the local operation name, the opaque remote id or hash, the contract version, the breaking-risk note, the binding/drift class, and the open-contract action inspectable so a persisted-operation binding is never hidden metadata. Drift-review sheets surface rerun, regenerate, and cancel choices and block the send until a material mismatch is reviewed; a raw send after a mismatch is only reachable through an explicit, acknowledged reviewed-downgrade choice. Raw operation text, raw secrets, raw request bodies, raw headers, and raw schema payloads do not appear in this packet.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "release_doc_ref",
    "help_doc_ref",
    "schema_ref",
    "surfaces",
    "details",
    "review_sheets",
    "review_choices",
    "upstream_refs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "add_persisted_operation_detail_hash_or_id_drift_checks_contract_version_review_and_no_unsafe_fallback_send_rules"
    },
    "packet_id": { "$ref": "#/$defs/opaque_id" },
    "as_of": { "type": "string", "format": "date" },
    "release_doc_ref": { "$ref": "#/$defs/path_ref" },
    "help_doc_ref": { "$ref": "#/$defs/path_ref" },
    "schema_ref": { "$ref": "#/$defs/path_ref" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/persisted_op_surface_qualification_row" }
    },
    "details": {
      "type": "array",
      "items": { "$ref": "#/$defs/persisted_op_detail_row" }
    },
    "review_sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/persisted_op_drift_review_sheet_row" }
    },
    "review_choices": {
      "type": "array",
      "items": { "$ref": "#/$defs/persisted_op_review_choice_row" }
    },
    "upstream_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/persisted_op_upstream_ref_row" }
    },
    "summary": { "$ref": "#/$defs/persisted_op_qualification_summary" }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[_.:-][a-z0-9]+)*$"
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "persisted_op_qualification_label": {
      "type": "string",
      "enum": ["stable", "preview", "labs", "inspect_only", "import_only"]
    },
    "persisted_op_surface_kind": {
      "type": "string",
      "enum": [
        "persisted_operation_detail",
        "drift_review_sheet",
        "request_composer",
        "cli_headless_output",
        "support_export",
        "help_about"
      ]
    },
    "contract_kind": {
      "type": "string",
      "enum": ["rest", "graphql", "plugin_owned"]
    },
    "persisted_operation_binding_state": {
      "type": "string",
      "enum": ["not_persisted", "bound_current", "persisted_operation_drift"]
    },
    "persisted_operation_drift_class": {
      "type": "string",
      "enum": ["current", "deprecated", "hash_drift", "id_drift", "removed"]
    },
    "send_decision_class": {
      "type": "string",
      "enum": ["send_persisted_bound", "block_pending_review"]
    },
    "review_choice_kind": {
      "type": "string",
      "enum": [
        "rerun_reviewed_binding",
        "regenerate_persisted_id",
        "cancel",
        "reviewed_raw_downgrade"
      ]
    },
    "retention_mode": {
      "type": "string",
      "enum": ["text_first_versioned", "metadata_only", "redacted_replayable", "opt_in_full_capture"]
    },
    "persisted_op_qualification_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_ref", "proof_index_ref", "captured_at", "evidence_refs"],
      "properties": {
        "packet_id": { "type": "string" },
        "packet_ref": { "type": "string" },
        "proof_index_ref": { "type": "string" },
        "captured_at": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "persisted_op_surface_guard_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_name_visible",
        "server_bound_id_visible",
        "contract_version_visible",
        "breaking_risk_visible",
        "open_contract_action_visible",
        "drift_state_visible",
        "review_choices_visible",
        "no_silent_raw_fallback",
        "no_unsafe_retention_for_compare",
        "server_bound_identity_never_hidden"
      ],
      "properties": {
        "local_name_visible": { "type": "boolean" },
        "server_bound_id_visible": { "type": "boolean" },
        "contract_version_visible": { "type": "boolean" },
        "breaking_risk_visible": { "type": "boolean" },
        "open_contract_action_visible": { "type": "boolean" },
        "drift_state_visible": { "type": "boolean" },
        "review_choices_visible": { "type": "boolean" },
        "no_silent_raw_fallback": { "type": "boolean" },
        "no_unsafe_retention_for_compare": { "type": "boolean" },
        "server_bound_identity_never_hidden": { "type": "boolean" }
      }
    },
    "persisted_op_surface_qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "surface_kind",
        "promoted_build_surface",
        "claim_label",
        "displayed_label",
        "qualification_packet",
        "guards",
        "downgrade_if_missing",
        "rationale"
      ],
      "properties": {
        "surface_id": { "type": "string" },
        "title": { "type": "string" },
        "surface_kind": { "$ref": "#/$defs/persisted_op_surface_kind" },
        "promoted_build_surface": { "type": "boolean" },
        "claim_label": { "$ref": "#/$defs/persisted_op_qualification_label" },
        "displayed_label": { "$ref": "#/$defs/persisted_op_qualification_label" },
        "qualification_packet": { "oneOf": [{ "$ref": "#/$defs/persisted_op_qualification_proof" }, { "type": "null" }] },
        "guards": { "$ref": "#/$defs/persisted_op_surface_guard_set" },
        "downgrade_if_missing": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "persisted_op_detail_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail_id",
        "surface_ref",
        "contract_kind",
        "matrix_binding_ref",
        "contract_ref",
        "local_name",
        "remote_id_or_hash_ref",
        "contract_version_label",
        "drift_class",
        "binding_state",
        "breaking_risk_note",
        "send_decision",
        "local_name_visible",
        "server_bound_id_visible",
        "contract_version_visible",
        "breaking_risk_visible",
        "open_contract_action_available",
        "drift_state_visible",
        "no_silent_raw_fallback",
        "rationale"
      ],
      "properties": {
        "detail_id": { "type": "string" },
        "surface_ref": { "type": "string" },
        "contract_kind": { "$ref": "#/$defs/contract_kind" },
        "matrix_binding_ref": { "type": "string" },
        "contract_ref": { "type": "string" },
        "local_name": { "type": "string" },
        "remote_id_or_hash_ref": { "type": "string" },
        "contract_version_label": { "type": "string" },
        "drift_class": { "$ref": "#/$defs/persisted_operation_drift_class" },
        "binding_state": { "$ref": "#/$defs/persisted_operation_binding_state" },
        "breaking_risk_note": { "type": "string" },
        "send_decision": { "$ref": "#/$defs/send_decision_class" },
        "local_name_visible": { "type": "boolean" },
        "server_bound_id_visible": { "type": "boolean" },
        "contract_version_visible": { "type": "boolean" },
        "breaking_risk_visible": { "type": "boolean" },
        "open_contract_action_available": { "type": "boolean" },
        "drift_state_visible": { "type": "boolean" },
        "no_silent_raw_fallback": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "persisted_op_drift_review_sheet_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheet_id",
        "detail_ref",
        "drift_class",
        "prior_id_or_hash_label",
        "resolved_id_or_hash_label",
        "contract_version_from_label",
        "contract_version_to_label",
        "offers_rerun_choice",
        "offers_regenerate_choice",
        "offers_cancel_choice",
        "requires_review_before_send",
        "send_blocked_until_reviewed",
        "no_silent_raw_fallback",
        "history_retention_mode",
        "forces_unsafe_body_header_retention",
        "rationale"
      ],
      "properties": {
        "sheet_id": { "type": "string" },
        "detail_ref": { "type": "string" },
        "drift_class": { "$ref": "#/$defs/persisted_operation_drift_class" },
        "prior_id_or_hash_label": { "type": "string" },
        "resolved_id_or_hash_label": { "type": "string" },
        "contract_version_from_label": { "type": "string" },
        "contract_version_to_label": { "type": "string" },
        "offers_rerun_choice": { "type": "boolean" },
        "offers_regenerate_choice": { "type": "boolean" },
        "offers_cancel_choice": { "type": "boolean" },
        "requires_review_before_send": { "type": "boolean" },
        "send_blocked_until_reviewed": { "type": "boolean" },
        "no_silent_raw_fallback": { "type": "boolean" },
        "history_retention_mode": { "$ref": "#/$defs/retention_mode" },
        "forces_unsafe_body_header_retention": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "persisted_op_review_choice_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice_id",
        "sheet_ref",
        "choice_kind",
        "requires_ack",
        "results_in_raw_execution",
        "rationale"
      ],
      "properties": {
        "choice_id": { "type": "string" },
        "sheet_ref": { "type": "string" },
        "choice_kind": { "$ref": "#/$defs/review_choice_kind" },
        "requires_ack": { "type": "boolean" },
        "results_in_raw_execution": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "persisted_op_upstream_ref_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "upstream_record_kind", "upstream_packet_path", "upstream_schema_path", "integration_verified", "rationale"],
      "properties": {
        "ref_id": { "type": "string" },
        "upstream_record_kind": { "type": "string" },
        "upstream_packet_path": { "type": "string" },
        "upstream_schema_path": { "type": "string" },
        "integration_verified": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "persisted_op_qualification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoted_surface_count",
        "stable_surface_count",
        "narrowed_surface_count",
        "detail_count",
        "drifted_detail_count",
        "material_mismatch_count",
        "review_sheet_count",
        "send_blocked_sheet_count",
        "review_choice_count",
        "explicit_downgrade_count",
        "upstream_ref_count",
        "integration_pass_count"
      ],
      "properties": {
        "promoted_surface_count": { "type": "integer", "minimum": 0 },
        "stable_surface_count": { "type": "integer", "minimum": 0 },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "detail_count": { "type": "integer", "minimum": 0 },
        "drifted_detail_count": { "type": "integer", "minimum": 0 },
        "material_mismatch_count": { "type": "integer", "minimum": 0 },
        "review_sheet_count": { "type": "integer", "minimum": 0 },
        "send_blocked_sheet_count": { "type": "integer", "minimum": 0 },
        "review_choice_count": { "type": "integer", "minimum": 0 },
        "explicit_downgrade_count": { "type": "integer", "minimum": 0 },
        "upstream_ref_count": { "type": "integer", "minimum": 0 },
        "integration_pass_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
