{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/deps/operation-history.schema.json",
  "title": "Aureline package operation history",
  "description": "Schema for the package_operation_history packet. Each entry is a durable, export-safe receipt for one completed or attempted package mutation (install, update, remove, regenerate), shared by the desktop history surface, the CLI/headless listing, AI and recipe follow-ups, and support/export packets. A receipt preserves the manifest scope, the origin and a precise result class, the manifest/lockfile identity before and after as redacted digests, the resolver state, the direct-versus-transitive impact chain, the validation outcome, and a rollback handle with revert/open-diff/export-patch recovery actions and evidence refs. references_matrix_id binds every label to the frozen package-state matrix, and the retention posture proves history retains neither raw credentials nor full manifest bodies. The model is metadata-only and carries no credential bodies, registry tokens, raw provider payloads, full manifest content, or private registry URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "references_matrix_id",
    "surface_contract",
    "operation_kinds",
    "operation_origins",
    "result_classes",
    "validation_results",
    "impact_change_kinds",
    "evidence_kinds",
    "revert_action_kinds",
    "retention_subject",
    "entries",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "package_operation_history" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "references_matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_contract": { "$ref": "#/$defs/surface_contract" },
    "operation_kinds": { "type": "array", "items": { "$ref": "#/$defs/operation_kind" } },
    "operation_origins": { "type": "array", "items": { "$ref": "#/$defs/operation_origin" } },
    "result_classes": { "type": "array", "items": { "$ref": "#/$defs/result_class" } },
    "validation_results": { "type": "array", "items": { "$ref": "#/$defs/validation_result" } },
    "impact_change_kinds": { "type": "array", "items": { "$ref": "#/$defs/impact_change_kind" } },
    "evidence_kinds": { "type": "array", "items": { "$ref": "#/$defs/evidence_kind" } },
    "revert_action_kinds": { "type": "array", "items": { "$ref": "#/$defs/revert_action_kind" } },
    "retention_subject": { "$ref": "#/$defs/retention_subject" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "redacted_string": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "://" }
    },
    "redactable_string": {
      "type": "string",
      "not": { "pattern": "://" }
    },
    "redacted_version": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/redacted_string" }]
    },
    "ecosystem_kind": {
      "enum": ["cargo", "node_pnpm", "python_pip", "other"]
    },
    "operation_kind": {
      "enum": ["install", "update", "remove", "regenerate"]
    },
    "operation_origin": {
      "enum": ["desktop_manual", "cli_headless", "ai_proposal", "recipe_proposal"]
    },
    "result_class": {
      "enum": [
        "applied",
        "no_change_needed",
        "partially_applied",
        "rolled_back",
        "failed_no_change",
        "blocked_by_policy",
        "blocked_by_auth"
      ]
    },
    "validation_result": {
      "enum": ["passed", "passed_with_warnings", "failed", "skipped", "not_run"]
    },
    "impact_change_kind": {
      "enum": ["added", "removed", "upgraded", "downgraded", "repinned", "unchanged"]
    },
    "evidence_kind": {
      "enum": ["validation_log", "lockfile_diff", "rollback_checkpoint", "resolver_trace", "support_bundle"]
    },
    "revert_action_kind": {
      "enum": ["revert", "open_diff", "export_patch"]
    },
    "manifest_scope_class": {
      "enum": ["whole_workspace", "selected_manifest", "workset_slice", "workspace_member", "path_or_vcs_target"]
    },
    "registry_source_authority": {
      "enum": ["public_registry", "private_registry", "enterprise_mirror", "local_cache", "offline_snapshot"]
    },
    "auth_mode": {
      "enum": [
        "anonymous",
        "os_store_credential",
        "token_credential",
        "browser_or_device_sign_in",
        "policy_inherited_credential",
        "auth_required_unsatisfied"
      ]
    },
    "lockfile_authority": {
      "enum": [
        "exact_lockfile_pinned",
        "manifest_range_governed",
        "frozen_by_policy",
        "lockfile_missing",
        "lockfile_divergent",
        "authority_unknown"
      ]
    },
    "resolver_identity": {
      "enum": [
        "first_party_resolver",
        "ecosystem_native_resolver",
        "mirror_backed_resolver",
        "offline_cache_resolver",
        "resolver_unknown"
      ]
    },
    "rollback_class": {
      "enum": [
        "reversible_checkpointed",
        "reversible_manifest_only",
        "compensating_only",
        "irreversible",
        "not_applicable"
      ]
    },
    "dependency_relation": {
      "enum": ["direct", "transitive", "workspace_local", "path_or_vcs"]
    },
    "requested_source_kind": {
      "enum": ["registry_range", "workspace_local_path", "filesystem_path", "version_control_ref"]
    },
    "retention_subject": {
      "enum": ["operation_history", "registry_credentials", "support_export_packet"]
    },
    "retention_class": {
      "enum": ["bounded_local_history", "broker_resolved_never_persisted", "redaction_required_export"]
    },
    "package_state_label": {
      "enum": [
        "direct",
        "transitive",
        "workspace_local",
        "path_or_vcs_source",
        "resolved_exact",
        "policy_pinned",
        "advisory_open",
        "suppressed_until",
        "license_review_required",
        "offline_snapshot_only",
        "auth_required",
        "unknown_or_stale"
      ]
    },
    "surface_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktop_history_surface",
        "cli_history_surface",
        "ai_recipe_surface",
        "rollback_surface",
        "help_page",
        "support_export_surface"
      ],
      "properties": {
        "desktop_history_surface": { "$ref": "#/$defs/non_empty_string" },
        "cli_history_surface": { "$ref": "#/$defs/non_empty_string" },
        "ai_recipe_surface": { "$ref": "#/$defs/non_empty_string" },
        "rollback_surface": { "$ref": "#/$defs/non_empty_string" },
        "help_page": { "$ref": "#/$defs/non_empty_string" },
        "support_export_surface": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "manifest_scope_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_class", "ecosystem", "scope_label", "redacted_manifest_path", "affected_manifest_ids"],
      "properties": {
        "scope_class": { "$ref": "#/$defs/manifest_scope_class" },
        "ecosystem": { "$ref": "#/$defs/ecosystem_kind" },
        "scope_label": { "$ref": "#/$defs/non_empty_string" },
        "redacted_manifest_path": { "$ref": "#/$defs/redacted_string" },
        "affected_manifest_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "requested_operation_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "package_name", "requested_ref", "requested_source"],
      "properties": {
        "ecosystem": { "$ref": "#/$defs/ecosystem_kind" },
        "package_name": { "$ref": "#/$defs/non_empty_string" },
        "requested_ref": { "$ref": "#/$defs/redacted_string" },
        "requested_source": { "$ref": "#/$defs/requested_source_kind" },
        "policy_pinned": { "type": "boolean" }
      }
    },
    "manifest_lockfile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockfile_authority",
        "lockfile_identity_before",
        "lockfile_identity_after",
        "manifest_digest_before",
        "manifest_digest_after"
      ],
      "properties": {
        "lockfile_authority": { "$ref": "#/$defs/lockfile_authority" },
        "affected_lockfile_ids": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "lockfile_identity_before": { "$ref": "#/$defs/redacted_string" },
        "lockfile_identity_after": { "$ref": "#/$defs/redacted_string" },
        "manifest_digest_before": { "$ref": "#/$defs/redacted_string" },
        "manifest_digest_after": { "$ref": "#/$defs/redacted_string" }
      }
    },
    "resolver_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolver_class", "resolver_version"],
      "properties": {
        "resolver_class": { "$ref": "#/$defs/resolver_identity" },
        "resolver_version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "operation_registry_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_class", "auth_mode", "redacted_source_label"],
      "properties": {
        "source_class": { "$ref": "#/$defs/registry_source_authority" },
        "auth_mode": { "$ref": "#/$defs/auth_mode" },
        "redacted_source_label": { "$ref": "#/$defs/redacted_string" }
      }
    },
    "impact_chain_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "package_name", "relation", "change_kind", "depth", "registry_source"],
      "properties": {
        "link_id": { "$ref": "#/$defs/non_empty_string" },
        "package_name": { "$ref": "#/$defs/redacted_string" },
        "relation": { "$ref": "#/$defs/dependency_relation" },
        "change_kind": { "$ref": "#/$defs/impact_change_kind" },
        "depth": { "type": "integer", "minimum": 0 },
        "parent_link_ids": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "version_before": { "$ref": "#/$defs/redacted_version" },
        "version_after": { "$ref": "#/$defs/redacted_version" },
        "registry_source": { "$ref": "#/$defs/registry_source_authority" }
      }
    },
    "validation_outcome_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "redacted_evidence_ref", "summary"],
      "properties": {
        "result": { "$ref": "#/$defs/validation_result" },
        "checks_run": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "redacted_evidence_ref": { "$ref": "#/$defs/redacted_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "revert_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "redacted_target_ref"],
      "properties": {
        "kind": { "$ref": "#/$defs/revert_action_kind" },
        "redacted_target_ref": { "$ref": "#/$defs/redacted_string" }
      }
    },
    "rollback_handle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollback_class", "revert_available", "note"],
      "properties": {
        "rollback_class": { "$ref": "#/$defs/rollback_class" },
        "checkpoint_ref": { "$ref": "#/$defs/redactable_string" },
        "revert_available": { "type": "boolean" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/revert_action" } },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "redacted_ref", "label"],
      "properties": {
        "kind": { "$ref": "#/$defs/evidence_kind" },
        "redacted_ref": { "$ref": "#/$defs/redacted_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "retention_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "retention_class", "full_manifest_body_retained", "raw_credentials_retained"],
      "properties": {
        "subject": { "$ref": "#/$defs/retention_subject" },
        "retention_class": { "$ref": "#/$defs/retention_class" },
        "full_manifest_body_retained": { "type": "boolean" },
        "raw_credentials_retained": { "type": "boolean" }
      }
    },
    "surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop", "cli_headless", "support_export"],
      "properties": {
        "desktop": { "type": "boolean" },
        "cli_headless": { "type": "boolean" },
        "support_export": { "type": "boolean" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "operation_kind",
        "origin",
        "result_class",
        "entry_label",
        "occurred_on",
        "scope",
        "requested",
        "identity",
        "resolver",
        "registry_source",
        "validation",
        "rollback",
        "retention",
        "surface_parity",
        "note"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/non_empty_string" },
        "operation_kind": { "$ref": "#/$defs/operation_kind" },
        "origin": { "$ref": "#/$defs/operation_origin" },
        "result_class": { "$ref": "#/$defs/result_class" },
        "entry_label": { "$ref": "#/$defs/non_empty_string" },
        "occurred_on": { "type": "string", "format": "date" },
        "scope": { "$ref": "#/$defs/manifest_scope_record" },
        "requested": { "$ref": "#/$defs/requested_operation_identity" },
        "identity": { "$ref": "#/$defs/manifest_lockfile_identity" },
        "resolver": { "$ref": "#/$defs/resolver_state" },
        "registry_source": { "$ref": "#/$defs/operation_registry_source" },
        "impact_chain": { "type": "array", "items": { "$ref": "#/$defs/impact_chain_link" } },
        "validation": { "$ref": "#/$defs/validation_outcome_record" },
        "rollback": { "$ref": "#/$defs/rollback_handle" },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } },
        "retention": { "$ref": "#/$defs/retention_posture" },
        "surface_parity": { "$ref": "#/$defs/surface_parity" },
        "applicable_labels": { "type": "array", "items": { "$ref": "#/$defs/package_state_label" } },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_operations",
        "install_operations",
        "update_operations",
        "remove_operations",
        "regenerate_operations",
        "applied_operations",
        "no_change_operations",
        "partially_applied_operations",
        "rolled_back_operations",
        "failed_operations",
        "policy_blocked_operations",
        "auth_blocked_operations",
        "recoverable_operations",
        "direct_impact_links",
        "transitive_impact_links",
        "validation_failed_operations"
      ],
      "properties": {
        "total_operations": { "type": "integer", "minimum": 0 },
        "install_operations": { "type": "integer", "minimum": 0 },
        "update_operations": { "type": "integer", "minimum": 0 },
        "remove_operations": { "type": "integer", "minimum": 0 },
        "regenerate_operations": { "type": "integer", "minimum": 0 },
        "applied_operations": { "type": "integer", "minimum": 0 },
        "no_change_operations": { "type": "integer", "minimum": 0 },
        "partially_applied_operations": { "type": "integer", "minimum": 0 },
        "rolled_back_operations": { "type": "integer", "minimum": 0 },
        "failed_operations": { "type": "integer", "minimum": 0 },
        "policy_blocked_operations": { "type": "integer", "minimum": 0 },
        "auth_blocked_operations": { "type": "integer", "minimum": 0 },
        "recoverable_operations": { "type": "integer", "minimum": 0 },
        "direct_impact_links": { "type": "integer", "minimum": 0 },
        "transitive_impact_links": { "type": "integer", "minimum": 0 },
        "validation_failed_operations": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
