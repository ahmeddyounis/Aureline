{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/deps/reviewed-mutation-flows.schema.json",
  "title": "Aureline reviewed mutation flows",
  "description": "Schema for the reviewed_mutation_flows packet. Each sheet is the canonical preview-first review object shared by the four package-mutation flows (install, update, remove, regenerate) across the desktop review surface, the CLI/headless dry run, AI and recipe proposals, and support/export packets. A sheet makes the manifest scope, a script/native-build label that keeps no-scripts, known-install-scripts, native-build-required, unknown-hook-risk, and policy-blocked states distinct, the resolver identity and version, a lockfile diff class with quantified blast radius and exact-restore authority, and a durable rollback checkpoint explicit before commit. references_matrix_id binds every label to the frozen package-state matrix. The model is metadata-only and carries no credential bodies, registry tokens, raw provider payloads, or private registry URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "references_matrix_id",
    "surface_contract",
    "flow_classes",
    "script_build_labels",
    "lockfile_diff_classes",
    "proposal_sources",
    "review_dispositions",
    "checkpoint_states",
    "recovery_action_kinds",
    "sheets",
    "checkpoints",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "reviewed_mutation_flows" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "references_matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_contract": { "$ref": "#/$defs/surface_contract" },
    "flow_classes": { "type": "array", "items": { "$ref": "#/$defs/flow_class" } },
    "script_build_labels": { "type": "array", "items": { "$ref": "#/$defs/script_build_label" } },
    "lockfile_diff_classes": { "type": "array", "items": { "$ref": "#/$defs/lockfile_diff_class" } },
    "proposal_sources": { "type": "array", "items": { "$ref": "#/$defs/proposal_source" } },
    "review_dispositions": { "type": "array", "items": { "$ref": "#/$defs/review_disposition" } },
    "checkpoint_states": { "type": "array", "items": { "$ref": "#/$defs/checkpoint_state" } },
    "recovery_action_kinds": { "type": "array", "items": { "$ref": "#/$defs/recovery_action_kind" } },
    "sheets": { "type": "array", "items": { "$ref": "#/$defs/sheet" } },
    "checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "redacted_string": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "://" }
    },
    "ecosystem_kind": {
      "enum": ["cargo", "node_pnpm", "python_pip", "other"]
    },
    "flow_class": {
      "enum": ["install", "update", "remove", "regenerate"]
    },
    "script_build_label": {
      "enum": [
        "no_scripts",
        "known_install_scripts",
        "native_build_required",
        "unknown_hook_risk",
        "policy_blocked"
      ]
    },
    "lockfile_diff_class": {
      "enum": [
        "no_lockfile_change",
        "entries_added",
        "entries_removed",
        "entries_repinned",
        "lockfile_created",
        "full_regeneration"
      ]
    },
    "proposal_source": {
      "enum": ["desktop_manual", "cli_headless_dry_run", "ai_proposal", "recipe_proposal"]
    },
    "review_disposition": {
      "enum": [
        "pending_review",
        "reviewed_ready",
        "blocked_until_resolved",
        "committed_after_review",
        "rolled_back"
      ]
    },
    "checkpoint_state": {
      "enum": [
        "captured",
        "applied_reversible",
        "partial_recovery_pending",
        "reverted",
        "superseded"
      ]
    },
    "recovery_action_kind": {
      "enum": ["revert", "open_diff", "export_patch"]
    },
    "manifest_scope_class": {
      "enum": ["whole_workspace", "selected_manifest", "workset_slice", "workspace_member", "path_or_vcs_target"]
    },
    "registry_source_authority": {
      "enum": ["public_registry", "private_registry", "enterprise_mirror", "local_cache", "offline_snapshot"]
    },
    "auth_mode": {
      "enum": [
        "anonymous",
        "os_store_credential",
        "token_credential",
        "browser_or_device_sign_in",
        "policy_inherited_credential",
        "auth_required_unsatisfied"
      ]
    },
    "lockfile_authority": {
      "enum": [
        "exact_lockfile_pinned",
        "manifest_range_governed",
        "frozen_by_policy",
        "lockfile_missing",
        "lockfile_divergent",
        "authority_unknown"
      ]
    },
    "resolver_identity": {
      "enum": [
        "first_party_resolver",
        "ecosystem_native_resolver",
        "mirror_backed_resolver",
        "offline_cache_resolver",
        "resolver_unknown"
      ]
    },
    "rollback_class": {
      "enum": [
        "reversible_checkpointed",
        "reversible_manifest_only",
        "compensating_only",
        "irreversible",
        "not_applicable"
      ]
    },
    "dependency_relation": {
      "enum": ["direct", "transitive", "workspace_local", "path_or_vcs"]
    },
    "requested_source_kind": {
      "enum": ["registry_range", "workspace_local_path", "filesystem_path", "version_control_ref"]
    },
    "package_state_label": {
      "enum": [
        "direct",
        "transitive",
        "workspace_local",
        "path_or_vcs_source",
        "resolved_exact",
        "policy_pinned",
        "advisory_open",
        "suppressed_until",
        "license_review_required",
        "offline_snapshot_only",
        "auth_required",
        "unknown_or_stale"
      ]
    },
    "surface_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_sheet_surface",
        "cli_dry_run_surface",
        "ai_recipe_surface",
        "rollback_surface",
        "help_page",
        "support_export_surface"
      ],
      "properties": {
        "review_sheet_surface": { "$ref": "#/$defs/non_empty_string" },
        "cli_dry_run_surface": { "$ref": "#/$defs/non_empty_string" },
        "ai_recipe_surface": { "$ref": "#/$defs/non_empty_string" },
        "rollback_surface": { "$ref": "#/$defs/non_empty_string" },
        "help_page": { "$ref": "#/$defs/non_empty_string" },
        "support_export_surface": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "manifest_scope_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_class",
        "ecosystem",
        "scope_label",
        "redacted_manifest_path",
        "affected_manifest_ids"
      ],
      "properties": {
        "scope_class": { "$ref": "#/$defs/manifest_scope_class" },
        "ecosystem": { "$ref": "#/$defs/ecosystem_kind" },
        "scope_label": { "$ref": "#/$defs/non_empty_string" },
        "redacted_manifest_path": { "$ref": "#/$defs/redacted_string" },
        "affected_manifest_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "confirmed_explicitly": { "type": "boolean" }
      }
    },
    "requested_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "package_name", "requested_ref", "requested_source"],
      "properties": {
        "ecosystem": { "$ref": "#/$defs/ecosystem_kind" },
        "package_name": { "$ref": "#/$defs/non_empty_string" },
        "requested_ref": { "$ref": "#/$defs/redacted_string" },
        "requested_source": { "$ref": "#/$defs/requested_source_kind" },
        "policy_pinned": { "type": "boolean" }
      }
    },
    "resolved_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "resolved_ref", "registry_source"],
      "properties": {
        "relation": { "$ref": "#/$defs/dependency_relation" },
        "resolved_ref": { "$ref": "#/$defs/redacted_string" },
        "registry_source": { "$ref": "#/$defs/registry_source_authority" }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolver_class", "resolver_version"],
      "properties": {
        "resolver_class": { "$ref": "#/$defs/resolver_identity" },
        "resolver_version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "registry_source_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_class", "auth_mode", "redacted_source_label"],
      "properties": {
        "source_class": { "$ref": "#/$defs/registry_source_authority" },
        "auth_mode": { "$ref": "#/$defs/auth_mode" },
        "redacted_source_label": { "$ref": "#/$defs/redacted_string" }
      }
    },
    "script_build_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "policy_allows", "requires_explicit_ack", "disclosure_note"],
      "properties": {
        "label": { "$ref": "#/$defs/script_build_label" },
        "source_package_refs": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "required_toolchain_refs": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "policy_allows": { "type": "boolean" },
        "requires_explicit_ack": { "type": "boolean" },
        "disclosure_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "lockfile_blast_radius": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_class",
        "lockfile_authority",
        "entries_added",
        "entries_removed",
        "entries_repinned",
        "exact_restore_supported",
        "note"
      ],
      "properties": {
        "diff_class": { "$ref": "#/$defs/lockfile_diff_class" },
        "lockfile_authority": { "$ref": "#/$defs/lockfile_authority" },
        "affected_lockfile_ids": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "entries_added": { "type": "integer", "minimum": 0 },
        "entries_removed": { "type": "integer", "minimum": 0 },
        "entries_repinned": { "type": "integer", "minimum": 0 },
        "exact_restore_supported": { "type": "boolean" },
        "broad_churn_disclosed": { "type": "boolean" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop", "cli_headless_dry_run", "support_export"],
      "properties": {
        "desktop": { "type": "boolean" },
        "cli_headless_dry_run": { "type": "boolean" },
        "support_export": { "type": "boolean" }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheet_id",
        "flow_class",
        "proposal_source",
        "review_disposition",
        "sheet_label",
        "manifest_scope",
        "requested",
        "resolver",
        "registry_source",
        "script_build",
        "lockfile",
        "rollback_checkpoint_id",
        "surface_parity",
        "note"
      ],
      "properties": {
        "sheet_id": { "$ref": "#/$defs/non_empty_string" },
        "flow_class": { "$ref": "#/$defs/flow_class" },
        "proposal_source": { "$ref": "#/$defs/proposal_source" },
        "review_disposition": { "$ref": "#/$defs/review_disposition" },
        "sheet_label": { "$ref": "#/$defs/non_empty_string" },
        "manifest_scope": { "$ref": "#/$defs/manifest_scope_target" },
        "requested": { "$ref": "#/$defs/requested_identity" },
        "resolved": { "$ref": "#/$defs/resolved_identity" },
        "resolver": { "$ref": "#/$defs/resolver" },
        "registry_source": { "$ref": "#/$defs/registry_source_cue" },
        "script_build": { "$ref": "#/$defs/script_build_review" },
        "lockfile": { "$ref": "#/$defs/lockfile_blast_radius" },
        "rollback_checkpoint_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_parity": { "$ref": "#/$defs/surface_parity" },
        "applicable_labels": { "type": "array", "items": { "$ref": "#/$defs/package_state_label" } },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "recovery_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_ref"],
      "properties": {
        "kind": { "$ref": "#/$defs/recovery_action_kind" },
        "target_ref": { "$ref": "#/$defs/redacted_string" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "sheet_id",
        "rollback_class",
        "state",
        "durable",
        "affected_manifest_ids",
        "lockfile_identity_before",
        "lockfile_identity_after",
        "resulting_state",
        "receipt_label",
        "recovery_actions"
      ],
      "properties": {
        "checkpoint_id": { "$ref": "#/$defs/non_empty_string" },
        "sheet_id": { "$ref": "#/$defs/non_empty_string" },
        "rollback_class": { "$ref": "#/$defs/rollback_class" },
        "state": { "$ref": "#/$defs/checkpoint_state" },
        "durable": { "type": "boolean" },
        "affected_manifest_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "lockfile_identity_before": { "$ref": "#/$defs/redacted_string" },
        "lockfile_identity_after": { "$ref": "#/$defs/redacted_string" },
        "resulting_state": { "$ref": "#/$defs/non_empty_string" },
        "receipt_label": { "$ref": "#/$defs/non_empty_string" },
        "recovery_actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/recovery_action" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_sheets",
        "install_sheets",
        "update_sheets",
        "remove_sheets",
        "regenerate_sheets",
        "script_risk_sheets",
        "native_build_sheets",
        "policy_blocked_sheets",
        "commit_blocked_sheets",
        "automated_proposal_sheets",
        "broad_churn_sheets",
        "total_checkpoints",
        "durable_checkpoints",
        "recovery_pending_checkpoints",
        "reverted_checkpoints"
      ],
      "properties": {
        "total_sheets": { "type": "integer", "minimum": 0 },
        "install_sheets": { "type": "integer", "minimum": 0 },
        "update_sheets": { "type": "integer", "minimum": 0 },
        "remove_sheets": { "type": "integer", "minimum": 0 },
        "regenerate_sheets": { "type": "integer", "minimum": 0 },
        "script_risk_sheets": { "type": "integer", "minimum": 0 },
        "native_build_sheets": { "type": "integer", "minimum": 0 },
        "policy_blocked_sheets": { "type": "integer", "minimum": 0 },
        "commit_blocked_sheets": { "type": "integer", "minimum": 0 },
        "automated_proposal_sheets": { "type": "integer", "minimum": 0 },
        "broad_churn_sheets": { "type": "integer", "minimum": 0 },
        "total_checkpoints": { "type": "integer", "minimum": 0 },
        "durable_checkpoints": { "type": "integer", "minimum": 0 },
        "recovery_pending_checkpoints": { "type": "integer", "minimum": 0 },
        "reverted_checkpoints": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
