{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/deps/package-state-descriptors.schema.json",
  "title": "Aureline cross-ecosystem package-state descriptors",
  "description": "Schema for the package_state_descriptors packet. Each descriptor is the canonical product object that carries one package's requested identity, resolved identity, source provenance, effective policy, and finding/suppression linkage, reused across package detail, the dependency tree, advisories, license/compliance views, update proposals, the CLI inspect surface, and support/export packets. Requested and resolved identity are kept in separate fields; direct, transitive, workspace-local, and path/VCS relations stay distinct; a resolution confidence records when a state is auth-gated, offline-snapshot only, or stale so the descriptor never overclaims an exact resolution; and references_matrix_id binds every descriptor to the frozen package-state matrix. The model is metadata-only and carries no credential bodies, registry tokens, raw provider payloads, or private registry URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "references_matrix_id",
    "ecosystems",
    "descriptors",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "package_state_descriptors" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "references_matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "ecosystems": { "type": "array", "items": { "$ref": "#/$defs/ecosystem_kind" } },
    "descriptors": { "type": "array", "items": { "$ref": "#/$defs/descriptor" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "redacted_string": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "://" }
    },
    "ecosystem_kind": {
      "enum": ["cargo", "node_pnpm", "python_pip", "other"]
    },
    "dependency_relation": {
      "enum": ["direct", "transitive", "workspace_local", "path_or_vcs"]
    },
    "requested_source_kind": {
      "enum": ["registry_range", "workspace_local_path", "filesystem_path", "version_control_ref"]
    },
    "resolution_confidence": {
      "enum": [
        "resolved_authoritative",
        "resolved_from_cache_or_mirror",
        "offline_snapshot_only",
        "auth_gated_unresolved",
        "stale_or_unknown"
      ]
    },
    "finding_kind": {
      "enum": ["advisory_open", "suppressed_until", "license_review_required"]
    },
    "manifest_scope_class": {
      "enum": [
        "whole_workspace",
        "selected_manifest",
        "workset_slice",
        "workspace_member",
        "path_or_vcs_target"
      ]
    },
    "registry_source_authority": {
      "enum": ["public_registry", "private_registry", "enterprise_mirror", "local_cache", "offline_snapshot"]
    },
    "auth_mode": {
      "enum": [
        "anonymous",
        "os_store_credential",
        "token_credential",
        "browser_or_device_sign_in",
        "policy_inherited_credential",
        "auth_required_unsatisfied"
      ]
    },
    "lockfile_authority": {
      "enum": [
        "exact_lockfile_pinned",
        "manifest_range_governed",
        "frozen_by_policy",
        "lockfile_missing",
        "lockfile_divergent",
        "authority_unknown"
      ]
    },
    "resolver_identity": {
      "enum": [
        "first_party_resolver",
        "ecosystem_native_resolver",
        "mirror_backed_resolver",
        "offline_cache_resolver",
        "resolver_unknown"
      ]
    },
    "rollback_class": {
      "enum": ["reversible_checkpointed", "reversible_manifest_only", "compensating_only", "irreversible", "not_applicable"]
    },
    "requested_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "package_name",
        "requested_ref",
        "requested_source",
        "manifest_scope",
        "policy_pinned"
      ],
      "properties": {
        "ecosystem": { "$ref": "#/$defs/ecosystem_kind" },
        "package_name": { "$ref": "#/$defs/non_empty_string" },
        "requested_ref": { "$ref": "#/$defs/redacted_string" },
        "requested_source": { "$ref": "#/$defs/requested_source_kind" },
        "manifest_scope": { "$ref": "#/$defs/manifest_scope_class" },
        "policy_pinned": { "type": "boolean" }
      }
    },
    "resolved_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "resolved_ref", "resolver_identity", "lockfile_authority"],
      "properties": {
        "relation": { "$ref": "#/$defs/dependency_relation" },
        "resolved_ref": { "$ref": "#/$defs/redacted_string" },
        "registry_source": { "$ref": "#/$defs/registry_source_authority" },
        "resolver_identity": { "$ref": "#/$defs/resolver_identity" },
        "lockfile_authority": { "$ref": "#/$defs/lockfile_authority" }
      }
    },
    "finding_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "finding_ref"],
      "properties": {
        "kind": { "$ref": "#/$defs/finding_kind" },
        "finding_ref": { "$ref": "#/$defs/non_empty_string" },
        "suppression_ref": { "$ref": "#/$defs/non_empty_string" },
        "expiry_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_id",
        "requested",
        "auth_mode",
        "confidence",
        "rollback_class",
        "redacted_source_label",
        "note"
      ],
      "properties": {
        "descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "requested": { "$ref": "#/$defs/requested_identity" },
        "resolved": { "$ref": "#/$defs/resolved_identity" },
        "auth_mode": { "$ref": "#/$defs/auth_mode" },
        "confidence": { "$ref": "#/$defs/resolution_confidence" },
        "rollback_class": { "$ref": "#/$defs/rollback_class" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding_overlay" } },
        "redacted_source_label": { "$ref": "#/$defs/redacted_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_descriptors",
        "ecosystems_represented",
        "direct_descriptors",
        "transitive_descriptors",
        "workspace_local_descriptors",
        "path_or_vcs_descriptors",
        "resolved_descriptors",
        "exact_claimable_descriptors",
        "environment_disclosed_descriptors",
        "policy_pinned_descriptors",
        "auth_gated_descriptors",
        "descriptors_with_open_findings"
      ],
      "properties": {
        "total_descriptors": { "type": "integer", "minimum": 0 },
        "ecosystems_represented": { "type": "integer", "minimum": 0 },
        "direct_descriptors": { "type": "integer", "minimum": 0 },
        "transitive_descriptors": { "type": "integer", "minimum": 0 },
        "workspace_local_descriptors": { "type": "integer", "minimum": 0 },
        "path_or_vcs_descriptors": { "type": "integer", "minimum": 0 },
        "resolved_descriptors": { "type": "integer", "minimum": 0 },
        "exact_claimable_descriptors": { "type": "integer", "minimum": 0 },
        "environment_disclosed_descriptors": { "type": "integer", "minimum": 0 },
        "policy_pinned_descriptors": { "type": "integer", "minimum": 0 },
        "auth_gated_descriptors": { "type": "integer", "minimum": 0 },
        "descriptors_with_open_findings": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
