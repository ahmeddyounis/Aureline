{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/deps/freeze-the-m5-package-state-manifest-scope-registry-auth-and-lockfile-authority-matrix.schema.json",
  "title": "Aureline M5 package-state, manifest-scope, registry-auth, and lockfile-authority matrix",
  "description": "Schema for the m5_package_state_mutation_matrix packet. The packet freezes the cross-ecosystem package vocabulary the whole M5 mutation lane references: the canonical package-state labels (direct, transitive, workspace-local, path/VCS source, resolved-exact, policy-pinned, advisory-open, suppressed-until, license-review-required, offline-snapshot-only, auth-required, unknown/stale), the manifest-scope, registry-source, auth-mode, lockfile-authority, resolver-identity, and rollback-class control objects, and the privacy/retention rules for operation history, registry credentials, and support/export packets. Three recomputed invariants keep it honest: every package-state label declares an identity side and never describes both the requested and resolved identity at once; every state row and registry-source cell renders a specific message class and never the forbidden generic_package_not_found or generic_install_failed; and every claimed marketed surface binds to this packet's id with a pinned write authority. The recorded identity side, message class, guard flag, write authority, and retention bindings must equal the recomputed contract or validation fails.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "package_state_labels",
    "identity_sides",
    "message_classes",
    "manifest_scope_classes",
    "registry_source_classes",
    "auth_modes",
    "lockfile_authorities",
    "resolver_identities",
    "rollback_classes",
    "retention_subjects",
    "retention_classes",
    "package_surfaces",
    "surface_write_authorities",
    "state_rows",
    "registry_source_cells",
    "surface_bindings",
    "retention_rules",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_package_state_mutation_matrix" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "package_state_labels": { "type": "array", "items": { "$ref": "#/$defs/package_state_label" } },
    "identity_sides": { "type": "array", "items": { "$ref": "#/$defs/identity_side" } },
    "message_classes": { "type": "array", "items": { "$ref": "#/$defs/message_class" } },
    "manifest_scope_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifest_scope_class" }
    },
    "registry_source_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/registry_source_authority" }
    },
    "auth_modes": { "type": "array", "items": { "$ref": "#/$defs/auth_mode" } },
    "lockfile_authorities": {
      "type": "array",
      "items": { "$ref": "#/$defs/lockfile_authority" }
    },
    "resolver_identities": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolver_identity" }
    },
    "rollback_classes": { "type": "array", "items": { "$ref": "#/$defs/rollback_class" } },
    "retention_subjects": { "type": "array", "items": { "$ref": "#/$defs/retention_subject" } },
    "retention_classes": { "type": "array", "items": { "$ref": "#/$defs/retention_class" } },
    "package_surfaces": { "type": "array", "items": { "$ref": "#/$defs/package_surface" } },
    "surface_write_authorities": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_write_authority" }
    },
    "state_rows": { "type": "array", "items": { "$ref": "#/$defs/state_row" } },
    "registry_source_cells": {
      "type": "array",
      "items": { "$ref": "#/$defs/registry_source_cell" }
    },
    "surface_bindings": { "type": "array", "items": { "$ref": "#/$defs/surface_binding" } },
    "retention_rules": { "type": "array", "items": { "$ref": "#/$defs/retention_rule" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "package_state_label": {
      "enum": [
        "direct",
        "transitive",
        "workspace_local",
        "path_or_vcs_source",
        "resolved_exact",
        "policy_pinned",
        "advisory_open",
        "suppressed_until",
        "license_review_required",
        "offline_snapshot_only",
        "auth_required",
        "unknown_or_stale"
      ]
    },
    "identity_side": {
      "enum": [
        "requested_constraint",
        "resolved_identity",
        "finding_overlay",
        "resolution_environment",
        "indeterminate_state"
      ]
    },
    "message_class": {
      "enum": [
        "direct_dependency",
        "transitive_dependency",
        "workspace_local_source",
        "path_or_vcs_source",
        "resolved_exact_pin",
        "policy_pinned_constraint",
        "advisory_open_finding",
        "suppressed_until_finding",
        "license_review_required_finding",
        "offline_snapshot_disclosure",
        "auth_required_disclosure",
        "unknown_or_stale_disclosure",
        "public_registry_source",
        "private_registry_source",
        "mirror_backed_source",
        "cache_only_source",
        "generic_package_not_found",
        "generic_install_failed"
      ]
    },
    "manifest_scope_class": {
      "enum": [
        "whole_workspace",
        "selected_manifest",
        "workset_slice",
        "workspace_member",
        "path_or_vcs_target"
      ]
    },
    "registry_source_authority": {
      "enum": ["public_registry", "private_registry", "enterprise_mirror", "local_cache", "offline_snapshot"]
    },
    "auth_mode": {
      "enum": [
        "anonymous",
        "os_store_credential",
        "token_credential",
        "browser_or_device_sign_in",
        "policy_inherited_credential",
        "auth_required_unsatisfied"
      ]
    },
    "lockfile_authority": {
      "enum": [
        "exact_lockfile_pinned",
        "manifest_range_governed",
        "frozen_by_policy",
        "lockfile_missing",
        "lockfile_divergent",
        "authority_unknown"
      ]
    },
    "resolver_identity": {
      "enum": [
        "first_party_resolver",
        "ecosystem_native_resolver",
        "mirror_backed_resolver",
        "offline_cache_resolver",
        "resolver_unknown"
      ]
    },
    "rollback_class": {
      "enum": [
        "reversible_checkpointed",
        "reversible_manifest_only",
        "compensating_only",
        "irreversible",
        "not_applicable"
      ]
    },
    "retention_subject": {
      "enum": ["operation_history", "registry_credentials", "support_export_packet"]
    },
    "retention_class": {
      "enum": ["bounded_local_history", "broker_resolved_never_persisted", "redaction_required_export"]
    },
    "package_surface": {
      "enum": [
        "desktop_package_workspace",
        "cli_headless",
        "ai_context",
        "review_workspace",
        "support_export",
        "release_public_truth"
      ]
    },
    "surface_write_authority": {
      "enum": ["mutates", "stages", "inspect_only", "redacted_export"]
    },
    "state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "label",
        "identity_side",
        "message_class",
        "non_collapse_guarded",
        "doc_anchor",
        "note"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/package_state_label" },
        "identity_side": { "$ref": "#/$defs/identity_side" },
        "message_class": { "$ref": "#/$defs/message_class" },
        "non_collapse_guarded": { "type": "boolean" },
        "doc_anchor": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": { "$ref": "#/$defs/string_array" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "registry_source_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "message_class",
        "requires_specific_disclosure",
        "redacted_source_label",
        "note"
      ],
      "properties": {
        "source": { "$ref": "#/$defs/registry_source_authority" },
        "message_class": { "$ref": "#/$defs/message_class" },
        "requires_specific_disclosure": { "type": "boolean" },
        "redacted_source_label": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "write_authority",
        "references_matrix_id",
        "surface_ref",
        "note"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/package_surface" },
        "write_authority": { "$ref": "#/$defs/surface_write_authority" },
        "references_matrix_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_ref": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "retention_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "retention_class",
        "stores_credential_body",
        "redaction_required",
        "retention_window_label",
        "note"
      ],
      "properties": {
        "subject": { "$ref": "#/$defs/retention_subject" },
        "retention_class": { "$ref": "#/$defs/retention_class" },
        "stores_credential_body": { "type": "boolean", "const": false },
        "redaction_required": { "type": "boolean" },
        "retention_window_label": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_state_rows",
        "total_registry_cells",
        "total_surface_bindings",
        "total_retention_rules",
        "state_label_count",
        "non_collapse_guarded_states",
        "requested_identity_states",
        "resolved_identity_states",
        "finding_overlay_states",
        "resolution_environment_states",
        "specific_disclosure_sources",
        "mutating_surfaces",
        "redacted_export_surfaces",
        "redaction_required_subjects"
      ],
      "properties": {
        "total_state_rows": { "type": "integer", "minimum": 0 },
        "total_registry_cells": { "type": "integer", "minimum": 0 },
        "total_surface_bindings": { "type": "integer", "minimum": 0 },
        "total_retention_rules": { "type": "integer", "minimum": 0 },
        "state_label_count": { "type": "integer", "minimum": 0 },
        "non_collapse_guarded_states": { "type": "integer", "minimum": 0 },
        "requested_identity_states": { "type": "integer", "minimum": 0 },
        "resolved_identity_states": { "type": "integer", "minimum": 0 },
        "finding_overlay_states": { "type": "integer", "minimum": 0 },
        "resolution_environment_states": { "type": "integer", "minimum": 0 },
        "specific_disclosure_sources": { "type": "integer", "minimum": 0 },
        "mutating_surfaces": { "type": "integer", "minimum": 0 },
        "redacted_export_surfaces": { "type": "integer", "minimum": 0 },
        "redaction_required_subjects": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
