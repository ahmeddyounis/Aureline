{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/deps/automation-governance.schema.json",
  "title": "Aureline AI/recipe/CLI package-mutation governance",
  "description": "Schema for the automation_governance packet. Each GovernedMutationProposal is the object an AI proposal, a recipe step, a CLI/headless invocation, and the desktop baseline all produce, reusing the canonical reviewed-mutation contract and the frozen package-state matrix. A proposal pins a manifest/lockfile impact preview (reviewed_sheet), a selected validation-task set (validation), an ecosystem-capability posture (capability), a governed execution decision, a cross-surface-identical result class and rollback handle, and a parity attestation. The no-unsafe-fallback rule: a proposal whose ecosystem cannot deliver the promised review preview, deterministic resolver, durable rollback, or validation execution — or that carries any intrinsic safety blocker — must narrow to inspect-only, export, or a browser/CLI handoff rather than proceeding to execution. references_matrix_id binds every label to the frozen matrix and references_reviewed_flows_id binds to the reviewed-mutation contract. The model is metadata-only and carries no credential bodies, registry tokens, raw provider payloads, or private registry URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "references_matrix_id",
    "references_reviewed_flows_id",
    "surface_contract",
    "automation_surfaces",
    "validation_task_kinds",
    "execution_decisions",
    "result_classes",
    "proposals",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "automation_governance" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "references_matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "references_reviewed_flows_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_contract": { "$ref": "#/$defs/surface_contract" },
    "automation_surfaces": { "type": "array", "items": { "$ref": "#/$defs/automation_surface" } },
    "validation_task_kinds": { "type": "array", "items": { "$ref": "#/$defs/validation_task_kind" } },
    "execution_decisions": { "type": "array", "items": { "$ref": "#/$defs/execution_decision" } },
    "result_classes": { "type": "array", "items": { "$ref": "#/$defs/result_class" } },
    "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "automation_surface": {
      "enum": ["desktop_manual", "cli_headless_dry_run", "ai_proposal", "recipe_proposal"]
    },
    "validation_task_kind": {
      "enum": ["build", "test", "lint", "typecheck", "security_audit", "license_review", "lockfile_verify"]
    },
    "execution_decision": {
      "enum": [
        "proceed_after_review",
        "narrow_to_inspect_only",
        "narrow_to_export_only",
        "handoff_to_browser",
        "handoff_to_cli",
        "blocked_no_safe_path"
      ]
    },
    "result_class": {
      "enum": [
        "preview_pending",
        "reviewed_ready",
        "blocked_unsafe",
        "narrowed_inspect_only",
        "handed_off",
        "committed_reviewed",
        "rolled_back"
      ]
    },
    "flow_class": { "enum": ["install", "update", "remove", "regenerate"] },
    "ecosystem": { "enum": ["cargo", "node_pnpm", "python_pip", "other"] },
    "manifest_scope_class": {
      "enum": ["whole_workspace", "selected_manifest", "workset_slice", "workspace_member", "path_or_vcs_target"]
    },
    "script_label": {
      "enum": ["no_scripts", "known_install_scripts", "native_build_required", "unknown_hook_risk", "policy_blocked"]
    },
    "resolver_class": {
      "enum": [
        "first_party_resolver",
        "ecosystem_native_resolver",
        "mirror_backed_resolver",
        "offline_cache_resolver",
        "resolver_unknown"
      ]
    },
    "registry_source": {
      "enum": ["public_registry", "private_registry", "enterprise_mirror", "local_cache", "offline_snapshot"]
    },
    "auth_mode": {
      "enum": [
        "anonymous",
        "os_store_credential",
        "token_credential",
        "browser_or_device_sign_in",
        "policy_inherited_credential",
        "auth_required_unsatisfied"
      ]
    },
    "lockfile_diff": {
      "enum": [
        "no_lockfile_change",
        "entries_added",
        "entries_removed",
        "entries_repinned",
        "lockfile_created",
        "full_regeneration"
      ]
    },
    "lockfile_authority": {
      "enum": [
        "exact_lockfile_pinned",
        "manifest_range_governed",
        "frozen_by_policy",
        "lockfile_missing",
        "lockfile_divergent",
        "authority_unknown"
      ]
    },
    "rollback_class": {
      "enum": ["reversible_checkpointed", "reversible_manifest_only", "compensating_only", "irreversible", "not_applicable"]
    },
    "recovery_action_kind": { "enum": ["revert", "open_diff", "export_patch"] },
    "package_state_label": {
      "enum": [
        "direct",
        "transitive",
        "workspace_local",
        "path_or_vcs_source",
        "resolved_exact",
        "policy_pinned",
        "advisory_open",
        "suppressed_until",
        "license_review_required",
        "offline_snapshot_only",
        "auth_required",
        "unknown_or_stale"
      ]
    },
    "surface_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_proposal_surface",
        "recipe_surface",
        "cli_headless_surface",
        "desktop_baseline_surface",
        "reviewed_sheet_surface",
        "help_page",
        "support_export_surface"
      ],
      "properties": {
        "ai_proposal_surface": { "$ref": "#/$defs/non_empty_string" },
        "recipe_surface": { "$ref": "#/$defs/non_empty_string" },
        "cli_headless_surface": { "$ref": "#/$defs/non_empty_string" },
        "desktop_baseline_surface": { "$ref": "#/$defs/non_empty_string" },
        "reviewed_sheet_surface": { "$ref": "#/$defs/non_empty_string" },
        "help_page": { "$ref": "#/$defs/non_empty_string" },
        "support_export_surface": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "reviewed_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheet_ref",
        "flow_class",
        "ecosystem",
        "manifest_scope_class",
        "redacted_manifest_path",
        "script_label",
        "script_disclosure_note",
        "resolver_class",
        "resolver_version",
        "registry_source",
        "auth_mode",
        "lockfile_diff",
        "lockfile_authority"
      ],
      "properties": {
        "sheet_ref": { "$ref": "#/$defs/non_empty_string" },
        "flow_class": { "$ref": "#/$defs/flow_class" },
        "ecosystem": { "$ref": "#/$defs/ecosystem" },
        "manifest_scope_class": { "$ref": "#/$defs/manifest_scope_class" },
        "scope_confirmed": { "type": "boolean" },
        "redacted_manifest_path": { "$ref": "#/$defs/non_empty_string" },
        "script_label": { "$ref": "#/$defs/script_label" },
        "script_disclosure_note": { "type": "string" },
        "resolver_class": { "$ref": "#/$defs/resolver_class" },
        "resolver_version": { "type": "string" },
        "registry_source": { "$ref": "#/$defs/registry_source" },
        "auth_mode": { "$ref": "#/$defs/auth_mode" },
        "lockfile_diff": { "$ref": "#/$defs/lockfile_diff" },
        "lockfile_authority": { "$ref": "#/$defs/lockfile_authority" }
      }
    },
    "validation_task_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "required_before_commit", "selected", "rationale"],
      "properties": {
        "kind": { "$ref": "#/$defs/validation_task_kind" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "required_before_commit": { "type": "boolean" },
        "selected": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_id"],
      "properties": {
        "selection_id": { "$ref": "#/$defs/non_empty_string" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/validation_task_row" } }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "provides_review_preview",
        "provides_deterministic_resolver",
        "provides_durable_rollback",
        "provides_validation_execution",
        "note"
      ],
      "properties": {
        "ecosystem": { "$ref": "#/$defs/ecosystem" },
        "provides_review_preview": { "type": "boolean" },
        "provides_deterministic_resolver": { "type": "boolean" },
        "provides_durable_rollback": { "type": "boolean" },
        "provides_validation_execution": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reuses_review_contract",
        "preserves_script_disclosure",
        "preserves_registry_auth_posture",
        "preserves_validation_selection",
        "preserves_rollback_packet",
        "not_a_bypass_lane",
        "no_hidden_scripting",
        "no_silent_scope_broadening"
      ],
      "properties": {
        "reuses_review_contract": { "type": "boolean" },
        "preserves_script_disclosure": { "type": "boolean" },
        "preserves_registry_auth_posture": { "type": "boolean" },
        "preserves_validation_selection": { "type": "boolean" },
        "preserves_rollback_packet": { "type": "boolean" },
        "not_a_bypass_lane": { "type": "boolean" },
        "no_hidden_scripting": { "type": "boolean" },
        "no_silent_scope_broadening": { "type": "boolean" }
      }
    },
    "rollback_handle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_ref", "rollback_class", "durable", "resulting_state"],
      "properties": {
        "checkpoint_ref": { "$ref": "#/$defs/non_empty_string" },
        "rollback_class": { "$ref": "#/$defs/rollback_class" },
        "durable": { "type": "boolean" },
        "recovery_actions": { "type": "array", "items": { "$ref": "#/$defs/recovery_action_kind" } },
        "resulting_state": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop", "cli_headless", "ai_context", "support_export"],
      "properties": {
        "desktop": { "type": "boolean" },
        "cli_headless": { "type": "boolean" },
        "ai_context": { "type": "boolean" },
        "support_export": { "type": "boolean" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "automation_surface",
        "governed_label",
        "reviewed_sheet",
        "validation",
        "capability",
        "execution_decision",
        "result_class",
        "parity",
        "rollback_handle",
        "surface_parity",
        "note"
      ],
      "properties": {
        "proposal_id": { "$ref": "#/$defs/non_empty_string" },
        "automation_surface": { "$ref": "#/$defs/automation_surface" },
        "governed_label": { "$ref": "#/$defs/non_empty_string" },
        "reviewed_sheet": { "$ref": "#/$defs/reviewed_sheet" },
        "validation": { "$ref": "#/$defs/validation" },
        "capability": { "$ref": "#/$defs/capability" },
        "execution_decision": { "$ref": "#/$defs/execution_decision" },
        "result_class": { "$ref": "#/$defs/result_class" },
        "parity": { "$ref": "#/$defs/parity" },
        "rollback_handle": { "$ref": "#/$defs/rollback_handle" },
        "surface_parity": { "$ref": "#/$defs/surface_parity" },
        "applicable_labels": { "type": "array", "items": { "$ref": "#/$defs/package_state_label" } },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_proposals",
        "ai_proposals",
        "recipe_proposals",
        "cli_proposals",
        "desktop_proposals",
        "proceed_proposals",
        "narrowed_inspect_proposals",
        "handoff_proposals",
        "blocked_proposals",
        "committed_proposals",
        "rolled_back_proposals",
        "capability_gap_proposals",
        "commit_blocked_proposals"
      ],
      "properties": {
        "total_proposals": { "type": "integer", "minimum": 0 },
        "ai_proposals": { "type": "integer", "minimum": 0 },
        "recipe_proposals": { "type": "integer", "minimum": 0 },
        "cli_proposals": { "type": "integer", "minimum": 0 },
        "desktop_proposals": { "type": "integer", "minimum": 0 },
        "proceed_proposals": { "type": "integer", "minimum": 0 },
        "narrowed_inspect_proposals": { "type": "integer", "minimum": 0 },
        "handoff_proposals": { "type": "integer", "minimum": 0 },
        "blocked_proposals": { "type": "integer", "minimum": 0 },
        "committed_proposals": { "type": "integer", "minimum": 0 },
        "rolled_back_proposals": { "type": "integer", "minimum": 0 },
        "capability_gap_proposals": { "type": "integer", "minimum": 0 },
        "commit_blocked_proposals": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
