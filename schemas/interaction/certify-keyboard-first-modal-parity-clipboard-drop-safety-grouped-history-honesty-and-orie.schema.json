{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/interaction/certify-keyboard-first-modal-parity-clipboard-drop-safety-grouped-history-honesty-and-orie.schema.json",
  "title": "Aureline M5 keyboard-first modal parity, clipboard-drop safety, grouped-history honesty, and orientation-aid continuity certification",
  "description": "Release-bearing certification binding every claimed M5 switching / power-user surface row (editor core, notebook, data/API, preview, docs, review, runtime, companion) to per-dimension interaction-safety proof over the modal-keyboard-parity, clipboard-drop-safety, grouped-history-continuity, orientation-aid-continuity, and macro-replay-safety dimensions. Each dimension certification names a proof currency and, unless the proof is missing, a reopenable proof ref keyed by a non-display fingerprint. A claimed row whose required-core dimension is uncertified, or whose certified dimension lacks current proof (stale, missing, requires-review, or imported proof standing in for a local claim), auto-narrows to an effective grade strictly below its claim, with a recorded narrow trigger and a precise narrowed label. Unsupported modal sequences are never silently approximated; rich text is never the only copy representation; drag/drop verbs and scope are always disclosed; the exact / compensating / checkpoint undo classes are never flattened; orientation aids degrade honestly rather than disappearing; and a provider-linked surface never reads as a locally verified result. Raw provider payloads, file contents, raw clipboard / drag payload bodies, credentials, and absolute private paths never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "label",
    "rows",
    "guardrails",
    "consumer_projection",
    "evidence_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "certify_keyboard_first_modal_parity_clipboard_drop_grouped_history_orientation_packet"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/certified_surface_row"
      }
    },
    "guardrails": {
      "$ref": "#/$defs/guardrails"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "evidence_freshness": {
      "$ref": "#/$defs/evidence_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "surface_kind": {
      "type": "string",
      "enum": [
        "editor_core",
        "notebook_surface",
        "data_api_surface",
        "preview_surface",
        "docs_surface",
        "review_surface",
        "runtime_surface",
        "companion_surface"
      ]
    },
    "origin_class": {
      "type": "string",
      "enum": [
        "first_party_surface",
        "embedded_runtime_surface",
        "provider_linked_surface",
        "imported_read_only_surface"
      ]
    },
    "parity_dimension": {
      "type": "string",
      "enum": [
        "modal_keyboard_parity",
        "clipboard_drop_safety",
        "grouped_history_continuity",
        "orientation_aid_continuity",
        "macro_replay_safety"
      ]
    },
    "proof_currency": {
      "type": "string",
      "enum": [
        "verified_current",
        "cached_within_window",
        "imported_current",
        "stale_expired",
        "requires_review",
        "missing_proof"
      ]
    },
    "parity_grade": {
      "type": "string",
      "enum": [
        "switching_certified",
        "parity_complete",
        "parity_partial",
        "parity_unverified",
        "not_applicable"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "mode_state_unidentified",
        "unsupported_sequence_downgraded",
        "clipboard_plain_text_unavailable",
        "drag_drop_verb_ambiguous",
        "history_class_unidentified",
        "reopen_path_unverified",
        "orientation_aids_collapsed",
        "stale_verification_proof",
        "imported_proof_on_local_surface",
        "upstream_surface_downgraded"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "origin_class", "surface_fingerprint_token"],
      "properties": {
        "surface_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "origin_class": {
          "$ref": "#/$defs/origin_class"
        },
        "surface_fingerprint_token": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_currency", "summary"],
      "properties": {
        "proof_currency": {
          "$ref": "#/$defs/proof_currency"
        },
        "proof_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proof_fingerprint_token": {
          "$ref": "#/$defs/non_empty_string"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "dimension_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "verification"],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/parity_dimension"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "certified_surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface_kind",
        "subject",
        "label_summary",
        "imported_surface",
        "certifications",
        "modal_sequences_never_silently_approximated",
        "plain_text_copy_preserved",
        "drag_drop_verbs_and_scope_disclosed",
        "undo_classes_distinct",
        "orientation_aids_degrade_honestly",
        "claimed_grade",
        "effective_grade",
        "evidence_refs",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_kind": {
          "$ref": "#/$defs/surface_kind"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "label_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "imported_surface": {
          "type": "boolean"
        },
        "certifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dimension_certification"
          }
        },
        "modal_sequences_never_silently_approximated": {
          "type": "boolean"
        },
        "plain_text_copy_preserved": {
          "type": "boolean"
        },
        "drag_drop_verbs_and_scope_disclosed": {
          "type": "boolean"
        },
        "undo_classes_distinct": {
          "type": "boolean"
        },
        "orientation_aids_degrade_honestly": {
          "type": "boolean"
        },
        "claimed_grade": {
          "$ref": "#/$defs/parity_grade"
        },
        "effective_grade": {
          "$ref": "#/$defs/parity_grade"
        },
        "narrow_trigger": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "narrowed_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modal_sequences_never_silently_approximated",
        "plain_text_copy_never_lost",
        "drag_drop_never_destructive_or_ambiguous",
        "undo_classes_never_flattened",
        "orientation_aids_degrade_honestly",
        "rows_auto_narrow_without_current_proof",
        "no_new_macro_language_or_editor_core"
      ],
      "properties": {
        "modal_sequences_never_silently_approximated": {
          "type": "boolean"
        },
        "plain_text_copy_never_lost": {
          "type": "boolean"
        },
        "drag_drop_never_destructive_or_ambiguous": {
          "type": "boolean"
        },
        "undo_classes_never_flattened": {
          "type": "boolean"
        },
        "orientation_aids_degrade_honestly": {
          "type": "boolean"
        },
        "rows_auto_narrow_without_current_proof": {
          "type": "boolean"
        },
        "no_new_macro_language_or_editor_core": {
          "type": "boolean"
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ingests_certification",
        "help_migration_ingests_certification",
        "accessibility_ingests_certification",
        "support_ingests_certification",
        "release_control_ingests_certification",
        "narrowed_rows_labeled_below_claim"
      ],
      "properties": {
        "product_ingests_certification": {
          "type": "boolean"
        },
        "help_migration_ingests_certification": {
          "type": "boolean"
        },
        "accessibility_ingests_certification": {
          "type": "boolean"
        },
        "support_ingests_certification": {
          "type": "boolean"
        },
        "release_control_ingests_certification": {
          "type": "boolean"
        },
        "narrowed_rows_labeled_below_claim": {
          "type": "boolean"
        }
      }
    },
    "evidence_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_freshness_slo_hours",
        "last_evidence_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "evidence_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_evidence_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
