{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/commands/m5-command-explainers.schema.json",
  "title": "M5 command-explainer certification packet",
  "description": "Per-family green/yellow/red certification that every claimed M5 command surface (menu item, menu group, context menu, command bar, keybinding resolver layer, conflict review sheet, import-bridge row, disabled-command explainer, leader/sequence help overlay, and command-documentation surface) can explain blocked or in-progress keyboard-first intent: a leader/partial-sequence overlay narrating the typed prefix, current mode, available next keys, resulting command labels/ids, and timeout/cancel posture; a disabled-command/why-unavailable explainer naming the blocker class, next safe action, and copy-command-id/open-help actions; the same reason packet and remediation language reused across palette, menu, keybinding UI, onboarding, and support/export flows; and a copy-safe diffable export that reconstructs the blocker reason and command id. Certifies the frozen M5 menu/keybinding-resolver/command-documentation matrix; mints no parallel command vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "matrix_doc_ref",
    "command_descriptor_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_explainer_dimensions",
    "required_leader_overlay_fields",
    "required_blocker_classes",
    "required_remediation_actions",
    "required_reach_modes",
    "required_surface_families",
    "rows",
    "covered_surface_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "conformance_causes",
    "blocking_findings",
    "report_clean",
    "command_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": {
      "const": "commands_m5_command_explainers_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "command_descriptor_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_explainer_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "leader_overlay",
          "blocked_explainer",
          "remediation_parity",
          "explainer_export"
        ]
      }
    },
    "required_leader_overlay_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/leader_overlay_field" }
    },
    "required_blocker_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker_class" }
    },
    "required_remediation_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/remediation_action" }
    },
    "required_reach_modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/reach_mode" }
    },
    "required_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "conformance_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": { "type": "array", "items": { "type": "object" } },
    "report_clean": { "type": "boolean" },
    "command_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface_family": {
      "type": "string",
      "enum": [
        "menu_item",
        "menu_group",
        "context_menu",
        "command_bar",
        "keybinding_resolver_layer",
        "conflict_review_sheet",
        "import_bridge_row",
        "disabled_command_explainer",
        "leader_sequence_help",
        "command_documentation_surface"
      ]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "lifecycle_label": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "leader_overlay_field": {
      "type": "string",
      "enum": [
        "typed_prefix",
        "current_mode",
        "available_next_keys",
        "resulting_command_label_and_id",
        "timeout_cancel_posture",
        "surface_unsupported_note"
      ]
    },
    "blocker_class": {
      "type": "string",
      "enum": [
        "context",
        "trust",
        "policy",
        "lifecycle",
        "missing_dependency",
        "stale_target",
        "mode_overlay"
      ]
    },
    "remediation_action": {
      "type": "string",
      "enum": ["next_safe_action", "copy_command_id", "open_help"]
    },
    "reach_mode": {
      "type": "string",
      "enum": [
        "pointer_default",
        "keyboard_only",
        "screen_reader",
        "compact_layout",
        "touch_context_action"
      ]
    },
    "unavailable_reason": {
      "type": "string",
      "enum": [
        "no_active_selection",
        "focus_required_elsewhere",
        "preview_approval_required",
        "policy_blocked",
        "capability_missing",
        "higher_scope_required",
        "experimental_not_claimed",
        "deprecated_use_replacement",
        "upstream_dependency_unavailable"
      ]
    },
    "leader_overlay_state": {
      "type": "string",
      "enum": [
        "typed_prefix_next_keys_and_timeout_narrated",
        "disclosed_reduced_sequence_overlay",
        "sequence_availability_requires_hidden_knowledge"
      ]
    },
    "blocked_explainer_state": {
      "type": "string",
      "enum": [
        "blocker_class_next_action_and_actions_certified",
        "disclosed_reduced_explainer_detail",
        "blocked_command_fails_silently_or_generic"
      ]
    },
    "remediation_parity_state": {
      "type": "string",
      "enum": [
        "shared_reason_packet_across_all_surfaces",
        "disclosed_surface_local_remediation_note",
        "surface_local_error_prose_invented"
      ]
    },
    "explainer_export_state": {
      "type": "string",
      "enum": [
        "blocker_and_command_id_reconstructable",
        "disclosed_partial_capture",
        "blocker_reason_absent_from_capture"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "surface_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "trigger", "disclosed", "detail"],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "trigger": {
          "type": "string",
          "enum": [
            "alternate_label_invented",
            "command_id_missing",
            "source_layer_hidden",
            "disabled_reason_hidden",
            "lifecycle_or_deprecation_hidden",
            "preview_approval_masked",
            "authority_widened",
            "conflict_winner_ambiguous",
            "stale_target_not_invalidated",
            "import_translation_untruthful",
            "parity_surface_dropped",
            "proof_stale"
          ]
        },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "surface_label",
        "qualification",
        "owner_role",
        "scope_summary",
        "canonical_command_binding",
        "lifecycle_label",
        "required_labels",
        "feature_families",
        "covered_unavailable_reasons",
        "certified_leader_overlay_fields",
        "certified_blocker_classes",
        "certified_remediation_actions",
        "certified_reach_modes",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "leader_overlay",
        "blocked_explainer",
        "remediation_parity",
        "explainer_export",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "conformance_causes",
        "narrowing_reason"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "qualification": {
          "type": "string",
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "canonical_command_binding": { "type": "object" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "feature_families": { "type": "array", "items": { "type": "string" } },
        "covered_unavailable_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/unavailable_reason" }
        },
        "certified_leader_overlay_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/leader_overlay_field" }
        },
        "certified_blocker_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker_class" }
        },
        "certified_remediation_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/remediation_action" }
        },
        "certified_reach_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reach_mode" }
        },
        "required_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "evaluated_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "leader_overlay": { "$ref": "#/$defs/leader_overlay_state" },
        "blocked_explainer": { "$ref": "#/$defs/blocked_explainer_state" },
        "remediation_parity": { "$ref": "#/$defs/remediation_parity_state" },
        "explainer_export": { "$ref": "#/$defs/explainer_export_state" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "conformance_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  }
}
