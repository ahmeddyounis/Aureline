{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/commands/m5-discoverability-affordance-parity.schema.json",
  "title": "M5 discoverability-affordance-parity certification packet",
  "description": "Per-affordance green/yellow/red certification that every claimed M5 convenience affordance (primary/action button, inline quick-action affordance, tooltip/hovercard, onboarding tip, AI hint, voice hint, and companion/browser handoff) reuses one command record rather than inventing a convenience-specific label, lifecycle language, side-effect story, or authority shortcut: each affordance reuses the canonical label/alias/shortcut-hint/lifecycle-badge; preserves the side-effect class and preview/approval requirement; keeps a focus/context-action equivalent within the canonical authority; and reconstructs its originating command identity from a copy-safe diffable export. Each affordance drives one governed matrix surface family and pulls its canonical binding from that family's frozen row; certifies the frozen M5 menu/keybinding-resolver/command-documentation matrix and mints no parallel command vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "matrix_doc_ref",
    "command_descriptor_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_parity_dimensions",
    "required_record_fields",
    "required_reach_modes",
    "required_affordances",
    "rows",
    "covered_affordances",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "conformance_causes",
    "blocking_findings",
    "report_clean",
    "command_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": {
      "const": "commands_m5_discoverability_affordance_parity_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "command_descriptor_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_parity_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "label_reuse",
          "side_effect_truth",
          "authority_reach",
          "origin_export"
        ]
      }
    },
    "required_record_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/record_field" }
    },
    "required_reach_modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/reach_mode" }
    },
    "required_affordances": {
      "type": "array",
      "items": { "$ref": "#/$defs/affordance" }
    },
    "rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_affordances": {
      "type": "array",
      "items": { "$ref": "#/$defs/affordance" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "conformance_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": { "type": "array", "items": { "type": "object" } },
    "report_clean": { "type": "boolean" },
    "command_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "affordance": {
      "type": "string",
      "enum": [
        "button",
        "inline_affordance",
        "tooltip",
        "onboarding_tip",
        "ai_hint",
        "voice_hint",
        "companion_handoff"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "menu_item",
        "menu_group",
        "context_menu",
        "command_bar",
        "keybinding_resolver_layer",
        "conflict_review_sheet",
        "import_bridge_row",
        "disabled_command_explainer",
        "leader_sequence_help",
        "command_documentation_surface"
      ]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "lifecycle_label": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "preview_class": {
      "type": "string",
      "enum": [
        "no_preview_required",
        "structured_diff_preview",
        "destructive_bulk_mutation_preview",
        "policy_authoring_or_waiver_preview",
        "irreversible_publish_preview"
      ]
    },
    "disabled_reason_mode": {
      "type": "string",
      "enum": ["always_invokable", "typed_reason_required_when_unavailable"]
    },
    "record_field": {
      "type": "string",
      "enum": [
        "canonical_label",
        "alias_set",
        "shortcut_hint",
        "side_effect_class",
        "preview_requirement",
        "lifecycle_badge"
      ]
    },
    "reach_mode": {
      "type": "string",
      "enum": [
        "pointer_default",
        "keyboard_focus",
        "screen_reader",
        "compact_layout",
        "touch_context_action"
      ]
    },
    "label_reuse_state": {
      "type": "string",
      "enum": [
        "canonical_label_alias_and_lifecycle_reused",
        "disclosed_shortened_affordance_label",
        "private_label_or_lifecycle_invented"
      ]
    },
    "side_effect_truth_state": {
      "type": "string",
      "enum": [
        "side_effect_and_preview_truth_preserved",
        "disclosed_summarized_side_effect_note",
        "side_effect_or_preview_truth_weakened"
      ]
    },
    "authority_reach_state": {
      "type": "string",
      "enum": [
        "focus_equivalent_and_bounded_authority",
        "disclosed_reduced_hover_fallback",
        "hover_only_or_authority_overreach"
      ]
    },
    "origin_export_state": {
      "type": "string",
      "enum": [
        "origin_command_identity_reconstructable",
        "disclosed_partial_capture",
        "originating_command_absent_from_capture"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "affordance", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "affordance": { "$ref": "#/$defs/affordance" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affordance", "trigger", "disclosed", "detail"],
      "properties": {
        "affordance": { "$ref": "#/$defs/affordance" },
        "trigger": {
          "type": "string",
          "enum": [
            "alternate_label_invented",
            "command_id_missing",
            "source_layer_hidden",
            "disabled_reason_hidden",
            "lifecycle_or_deprecation_hidden",
            "preview_approval_masked",
            "authority_widened",
            "conflict_winner_ambiguous",
            "stale_target_not_invalidated",
            "import_translation_untruthful",
            "parity_surface_dropped",
            "proof_stale"
          ]
        },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affordance",
        "affordance_label",
        "driving_surface_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "canonical_command_binding",
        "lifecycle_label",
        "preview_class",
        "disabled_reason_mode",
        "required_labels",
        "feature_families",
        "certified_record_fields",
        "certified_reach_modes",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "label_reuse",
        "side_effect_truth",
        "authority_reach",
        "origin_export",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "conformance_causes",
        "narrowing_reason"
      ],
      "properties": {
        "affordance": { "$ref": "#/$defs/affordance" },
        "affordance_label": { "type": "string", "minLength": 1 },
        "driving_surface_family": { "$ref": "#/$defs/surface_family" },
        "qualification": {
          "type": "string",
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "canonical_command_binding": { "type": "object" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "preview_class": { "$ref": "#/$defs/preview_class" },
        "disabled_reason_mode": { "$ref": "#/$defs/disabled_reason_mode" },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "feature_families": { "type": "array", "items": { "type": "string" } },
        "certified_record_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/record_field" }
        },
        "certified_reach_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reach_mode" }
        },
        "required_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "evaluated_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "label_reuse": { "$ref": "#/$defs/label_reuse_state" },
        "side_effect_truth": { "$ref": "#/$defs/side_effect_truth_state" },
        "authority_reach": { "$ref": "#/$defs/authority_reach_state" },
        "origin_export": { "$ref": "#/$defs/origin_export_state" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "conformance_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  }
}
