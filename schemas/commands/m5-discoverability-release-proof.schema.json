{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/commands/m5-discoverability-release-proof.schema.json",
  "title": "M5 discoverability-release-proof certification packet",
  "description": "Per-family green/yellow/red release-evidence proof that bundles the menu-affordance, keybinding-resolver, leader-help, and command-documentation truth for every claimed M5 command surface (menu item, menu group, context menu, command bar, keybinding resolver layer, conflict review sheet, import-bridge row, disabled-command explainer, leader/sequence help overlay, and command-documentation surface) into one release-evidence proof: the canonical label, shortcut hint, blocked-state reason, and authority posture project identically across every reach; shortcut resolution stays inspectable; leader/partial-sequence overlays and disabled-command/why-unavailable explainers narrate blocked and in-progress intent; and the command id, aliases, lifecycle/deprecation state, supported surfaces, and canonical examples stay fresh across every reach; certified across every declared consumer surface and every claimed desktop profile, with the same proof preserved in headless/CLI execution, so a discoverability regression auto-narrows the claim before it widens. Certifies the frozen M5 menu/keybinding-resolver/command-documentation matrix; mints no parallel command vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "matrix_doc_ref",
    "command_descriptor_ref",
    "build_identity_ref",
    "release_channel_class",
    "release_evidence_index_ref",
    "linked_proof_lane_refs",
    "required_proof_dimensions",
    "required_profiles",
    "required_surface_families",
    "rows",
    "covered_surface_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "conformance_causes",
    "blocking_findings",
    "report_clean",
    "command_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": {
      "const": "commands_m5_discoverability_release_proof_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "command_descriptor_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "release_evidence_index_ref": { "type": "string", "minLength": 1 },
    "linked_proof_lane_refs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/desktop_profile" }
    },
    "required_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "conformance_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": { "type": "array", "items": { "type": "object" } },
    "report_clean": { "type": "boolean" },
    "command_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface_family": {
      "type": "string",
      "enum": [
        "menu_item",
        "menu_group",
        "context_menu",
        "command_bar",
        "keybinding_resolver_layer",
        "conflict_review_sheet",
        "import_bridge_row",
        "disabled_command_explainer",
        "leader_sequence_help",
        "command_documentation_surface"
      ]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "lifecycle_label": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "menu_affordance",
        "keybinding_resolver",
        "leader_help",
        "command_documentation"
      ]
    },
    "desktop_profile": {
      "type": "string",
      "enum": [
        "compact_desktop",
        "standard_desktop",
        "expanded_desktop",
        "mixed_dpi",
        "multi_monitor",
        "dependency_missing_restore"
      ]
    },
    "menu_affordance_truth_state": {
      "type": "string",
      "enum": [
        "menu_affordance_parity_certified",
        "disclosed_reduced_affordance_hint",
        "alternate_label_or_authority_invented"
      ]
    },
    "keybinding_resolver_truth_state": {
      "type": "string",
      "enum": [
        "shortcut_resolution_inspectable",
        "disclosed_reduced_resolver_detail",
        "winning_or_shadowed_binding_hidden"
      ]
    },
    "leader_help_truth_state": {
      "type": "string",
      "enum": [
        "leader_and_blocked_explainer_certified",
        "disclosed_reduced_explainer_detail",
        "blocked_intent_silent_or_generic"
      ]
    },
    "command_documentation_truth_state": {
      "type": "string",
      "enum": [
        "command_doc_record_certified",
        "disclosed_reduced_doc_detail",
        "doc_record_stale_or_mismatched"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "surface_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "trigger", "disclosed", "detail"],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "trigger": {
          "type": "string",
          "enum": [
            "alternate_label_invented",
            "command_id_missing",
            "source_layer_hidden",
            "disabled_reason_hidden",
            "lifecycle_or_deprecation_hidden",
            "preview_approval_masked",
            "authority_widened",
            "conflict_winner_ambiguous",
            "stale_target_not_invalidated",
            "import_translation_untruthful",
            "parity_surface_dropped",
            "proof_stale"
          ]
        },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "surface_label",
        "qualification",
        "owner_role",
        "scope_summary",
        "canonical_command_binding",
        "lifecycle_label",
        "preview_class",
        "disabled_reason_mode",
        "required_labels",
        "feature_families",
        "certified_proof_dimensions",
        "certified_profiles",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "menu_affordance_truth",
        "keybinding_resolver_truth",
        "leader_help_truth",
        "command_documentation_truth",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "conformance_causes",
        "narrowing_reason"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "qualification": {
          "type": "string",
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "canonical_command_binding": { "type": "object" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "preview_class": { "type": "string" },
        "disabled_reason_mode": { "type": "string" },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "feature_families": { "type": "array", "items": { "type": "string" } },
        "certified_proof_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/proof_dimension" }
        },
        "certified_profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/desktop_profile" }
        },
        "required_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "evaluated_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "menu_affordance_truth": { "$ref": "#/$defs/menu_affordance_truth_state" },
        "keybinding_resolver_truth": { "$ref": "#/$defs/keybinding_resolver_truth_state" },
        "leader_help_truth": { "$ref": "#/$defs/leader_help_truth_state" },
        "command_documentation_truth": { "$ref": "#/$defs/command_documentation_truth_state" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "conformance_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  }
}
