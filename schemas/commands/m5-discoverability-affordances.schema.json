{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/commands/m5-discoverability-affordances.schema.json",
  "title": "M5 menu-affordance, keybinding-resolver, and command-documentation matrix",
  "description": "Frozen matrix binding every claimed M5 discoverability surface family (menus, context menus, command bars, keybinding resolver layers, conflict review sheets, import-bridge rows, disabled-command explainers, leader/sequence help, command-documentation surfaces) back to one canonical command record. Reuses the frozen command-descriptor vocabulary (lifecycle label, preview class, disabled-reason mode, discovery channel, feature family) rather than minting parallel terms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_menu_keybinding_resolver_and_command_documentation_matrix"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface_family": {
      "type": "string",
      "enum": [
        "menu_item",
        "menu_group",
        "context_menu",
        "command_bar",
        "keybinding_resolver_layer",
        "conflict_review_sheet",
        "import_bridge_row",
        "disabled_command_explainer",
        "leader_sequence_help",
        "command_documentation_surface"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "preview_class": {
      "type": "string",
      "enum": [
        "no_preview_required",
        "structured_diff_preview",
        "destructive_bulk_mutation_preview",
        "policy_authoring_or_waiver_preview",
        "irreversible_publish_preview"
      ]
    },
    "disabled_reason_mode": {
      "type": "string",
      "enum": ["always_invokable", "typed_reason_required_when_unavailable"]
    },
    "shortcut_source_class": {
      "type": "string",
      "enum": [
        "default_keymap",
        "platform_default",
        "imported_keymap",
        "extension_keybinding",
        "workspace_keybinding",
        "user_keybinding",
        "leader_sequence"
      ]
    },
    "conflict_reason": {
      "type": "string",
      "enum": [
        "same_chord_different_command",
        "higher_layer_shadowed",
        "sequence_prefix_collision",
        "context_scope_overlap",
        "imported_binding_collision",
        "platform_reserved_chord"
      ]
    },
    "import_translation_state": {
      "type": "string",
      "enum": [
        "translated_exact",
        "translated_approximated",
        "unmapped_source_key",
        "conflict_with_existing",
        "rejected_unsafe",
        "requires_manual_review"
      ]
    },
    "stale_target_state": {
      "type": "string",
      "enum": [
        "target_live",
        "target_moved_rebound",
        "target_removed_unavailable",
        "target_context_lost",
        "target_replaced_by_deprecation"
      ]
    },
    "unavailable_reason": {
      "type": "string",
      "enum": [
        "no_active_selection",
        "focus_required_elsewhere",
        "preview_approval_required",
        "policy_blocked",
        "capability_missing",
        "higher_scope_required",
        "experimental_not_claimed",
        "deprecated_use_replacement",
        "upstream_dependency_unavailable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "command_id",
        "source_layer",
        "disabled_reason",
        "lifecycle_or_deprecation",
        "primary_label",
        "preview_or_approval"
      ]
    },
    "parity_surface": {
      "type": "string",
      "enum": ["keyboard", "screen_reader", "pointer", "touch", "cli_help", "support_export"]
    },
    "feature_family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_api",
        "profiler",
        "trace_replay",
        "docs_browser",
        "framework_pack",
        "review_pipeline",
        "preview",
        "companion",
        "incident",
        "sync",
        "offboarding",
        "secret_broker",
        "infrastructure"
      ]
    },
    "discovery_channel": {
      "type": "string",
      "enum": [
        "command_palette",
        "keybinding_help",
        "help_search",
        "onboarding_tour",
        "cli_headless",
        "ai_automation"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "alternate_label_invented",
        "command_id_missing",
        "source_layer_hidden",
        "disabled_reason_hidden",
        "lifecycle_or_deprecation_hidden",
        "preview_approval_masked",
        "authority_widened",
        "conflict_winner_ambiguous",
        "stale_target_not_invalidated",
        "import_translation_untruthful",
        "parity_surface_dropped",
        "proof_stale"
      ]
    },
    "canonical_command_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id_field",
        "primary_label_ref",
        "help_anchor_ref",
        "descriptor_revision_ref",
        "lifecycle_label",
        "preview_class",
        "disabled_reason_mode"
      ],
      "properties": {
        "command_id_field": { "type": "string", "minLength": 1 },
        "primary_label_ref": { "type": "string", "minLength": 1 },
        "help_anchor_ref": { "type": "string", "minLength": 1 },
        "descriptor_revision_ref": { "type": "string", "minLength": 1 },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "preview_class": { "$ref": "#/$defs/preview_class" },
        "disabled_reason_mode": { "$ref": "#/$defs/disabled_reason_mode" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "canonical_command_binding",
        "required_labels",
        "shortcut_source_classes",
        "conflict_reasons",
        "import_translation_states",
        "stale_target_states",
        "unavailable_reasons",
        "feature_families",
        "parity_surfaces",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "invents_alternate_label",
        "masks_preview_or_approval",
        "widens_authority",
        "hides_disabled_reason"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "canonical_command_binding": { "$ref": "#/$defs/canonical_command_binding" },
        "required_labels": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "shortcut_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/shortcut_source_class" }
        },
        "conflict_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/conflict_reason" }
        },
        "import_translation_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/import_translation_state" }
        },
        "stale_target_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stale_target_state" }
        },
        "unavailable_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/unavailable_reason" }
        },
        "feature_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/feature_family" }
        },
        "parity_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parity_surface" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/discovery_channel" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "invents_alternate_label": { "type": "boolean", "const": false },
        "masks_preview_or_approval": { "type": "boolean", "const": false },
        "widens_authority": { "type": "boolean", "const": false },
        "hides_disabled_reason": { "type": "boolean", "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "shortcut_source_classes",
        "conflict_reasons",
        "import_translation_states",
        "stale_target_states",
        "unavailable_reasons",
        "required_labels",
        "parity_surfaces"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "shortcut_source_classes": { "type": "array", "items": { "type": "string" } },
        "conflict_reasons": { "type": "array", "items": { "type": "string" } },
        "import_translation_states": { "type": "array", "items": { "type": "string" } },
        "stale_target_states": { "type": "array", "items": { "type": "string" } },
        "unavailable_reasons": { "type": "array", "items": { "type": "string" } },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "parity_surfaces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_surfaces_project_one_command_record",
        "no_surface_invents_alternate_label",
        "no_surface_widens_authority",
        "no_surface_hides_disabled_reason",
        "no_surface_masks_preview_or_approval",
        "every_surface_shows_mandatory_labels",
        "keybinding_winners_and_losers_named",
        "import_bridge_outcomes_controlled",
        "stale_targets_invalidated",
        "cross_modality_parity_preserved",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "all_surfaces_project_one_command_record": { "type": "boolean", "const": true },
        "no_surface_invents_alternate_label": { "type": "boolean", "const": true },
        "no_surface_widens_authority": { "type": "boolean", "const": true },
        "no_surface_hides_disabled_reason": { "type": "boolean", "const": true },
        "no_surface_masks_preview_or_approval": { "type": "boolean", "const": true },
        "every_surface_shows_mandatory_labels": { "type": "boolean", "const": true },
        "keybinding_winners_and_losers_named": { "type": "boolean", "const": true },
        "import_bridge_outcomes_controlled": { "type": "boolean", "const": true },
        "stale_targets_invalidated": { "type": "boolean", "const": true },
        "cross_modality_parity_preserved": { "type": "boolean", "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "type": "boolean", "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_palette_consumes_matrix",
        "keybinding_help_shows_source_and_conflicts",
        "help_search_uses_controlled_vocabulary",
        "onboarding_tour_quotes_command_ids",
        "cli_headless_explains_same_semantics",
        "ai_automation_reads_single_source"
      ],
      "properties": {
        "command_palette_consumes_matrix": { "type": "boolean", "const": true },
        "keybinding_help_shows_source_and_conflicts": { "type": "boolean", "const": true },
        "help_search_uses_controlled_vocabulary": { "type": "boolean", "const": true },
        "onboarding_tour_quotes_command_ids": { "type": "boolean", "const": true },
        "cli_headless_explains_same_semantics": { "type": "boolean", "const": true },
        "ai_automation_reads_single_source": { "type": "boolean", "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "command_parity_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "command_parity_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean", "const": true },
        "accessibility_parity_required": { "type": "boolean", "const": true }
      }
    }
  }
}
