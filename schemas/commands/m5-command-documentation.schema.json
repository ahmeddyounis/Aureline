{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/commands/m5-command-documentation.schema.json",
  "title": "M5 command-documentation certification packet",
  "description": "Per-family green/yellow/red certification that every claimed M5 command surface (menu item, menu group, context menu, command bar, keybinding resolver layer, conflict review sheet, import-bridge row, disabled-command explainer, leader/sequence help overlay, and command-documentation surface) publishes documentation truth: the same command id, primary label, aliases, lifecycle/deprecation state, supported surfaces, invocation-schema summary, side-effect/risk class, and result/rollback semantics that the shipped command record carries, with canonical examples that stay fresh and never alias-only, parity cards across every reach, derivation anchors derived from the shared record, and a copy-safe diffable export that reconstructs the command id and replacement guidance. Certifies the frozen M5 menu/keybinding-resolver/command-documentation matrix; mints no parallel command vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "matrix_doc_ref",
    "command_descriptor_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_doc_dimensions",
    "required_doc_fields",
    "required_parity_cards",
    "required_derivation_anchors",
    "required_surface_families",
    "rows",
    "covered_surface_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "conformance_causes",
    "blocking_findings",
    "report_clean",
    "command_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": {
      "const": "commands_m5_command_documentation_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "command_descriptor_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_doc_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "documentation_record",
          "cross_surface_naming",
          "example_freshness",
          "doc_export_parity"
        ]
      }
    },
    "required_doc_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/doc_field" }
    },
    "required_parity_cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/parity_card" }
    },
    "required_derivation_anchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/derivation_anchor" }
    },
    "required_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "conformance_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": { "type": "array", "items": { "type": "object" } },
    "report_clean": { "type": "boolean" },
    "command_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface_family": {
      "type": "string",
      "enum": [
        "menu_item",
        "menu_group",
        "context_menu",
        "command_bar",
        "keybinding_resolver_layer",
        "conflict_review_sheet",
        "import_bridge_row",
        "disabled_command_explainer",
        "leader_sequence_help",
        "command_documentation_surface"
      ]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "lifecycle_label": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "doc_field": {
      "type": "string",
      "enum": [
        "command_id",
        "primary_label",
        "aliases",
        "lifecycle_state",
        "supported_surfaces",
        "invocation_schema_summary",
        "side_effect_risk_class",
        "result_rollback_semantics"
      ]
    },
    "parity_card": {
      "type": "string",
      "enum": [
        "menu",
        "button",
        "palette",
        "cli_headless",
        "ai_tool",
        "recipe",
        "voice_companion_hint"
      ]
    },
    "derivation_anchor": {
      "type": "string",
      "enum": [
        "docs_help_anchor",
        "shortcut_notation",
        "accessibility_narration_hint"
      ]
    },
    "documentation_record": {
      "type": "string",
      "enum": [
        "command_record_examples_and_lifecycle_certified",
        "disclosed_reduced_doc_detail",
        "doc_record_missing_or_mismatched"
      ]
    },
    "cross_surface_naming": {
      "type": "string",
      "enum": [
        "canonical_naming_and_replacement_stable",
        "disclosed_surface_paraphrase",
        "naming_or_replacement_drifted"
      ]
    },
    "example_freshness": {
      "type": "string",
      "enum": [
        "canonical_examples_fresh_and_not_alias_only",
        "disclosed_partial_example_refresh",
        "stale_or_alias_only_example_shipped"
      ]
    },
    "doc_export_parity": {
      "type": "string",
      "enum": [
        "command_id_and_replacement_reconstructable",
        "disclosed_partial_capture",
        "doc_truth_absent_from_capture"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "surface_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "trigger", "disclosed", "detail"],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "trigger": {
          "type": "string",
          "enum": [
            "alternate_label_invented",
            "command_id_missing",
            "source_layer_hidden",
            "disabled_reason_hidden",
            "lifecycle_or_deprecation_hidden",
            "preview_approval_masked",
            "authority_widened",
            "conflict_winner_ambiguous",
            "stale_target_not_invalidated",
            "import_translation_untruthful",
            "parity_surface_dropped",
            "proof_stale"
          ]
        },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "surface_label",
        "qualification",
        "owner_role",
        "scope_summary",
        "canonical_command_binding",
        "lifecycle_label",
        "required_labels",
        "feature_families",
        "certified_doc_fields",
        "certified_parity_cards",
        "certified_derivation_anchors",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "documentation_record",
        "cross_surface_naming",
        "example_freshness",
        "doc_export_parity",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "conformance_causes",
        "narrowing_reason"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "qualification": {
          "type": "string",
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "canonical_command_binding": { "type": "object" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "feature_families": { "type": "array", "items": { "type": "string" } },
        "certified_doc_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/doc_field" }
        },
        "certified_parity_cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/parity_card" }
        },
        "certified_derivation_anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/derivation_anchor" }
        },
        "required_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "evaluated_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "documentation_record": { "$ref": "#/$defs/documentation_record" },
        "cross_surface_naming": { "$ref": "#/$defs/cross_surface_naming" },
        "example_freshness": { "$ref": "#/$defs/example_freshness" },
        "doc_export_parity": { "$ref": "#/$defs/doc_export_parity" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "conformance_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  }
}
