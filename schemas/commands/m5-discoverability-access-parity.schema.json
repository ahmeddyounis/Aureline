{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/commands/m5-discoverability-access-parity.schema.json",
  "title": "M5 discoverability-access-parity certification packet",
  "description": "Per-family green/yellow/red certification that every claimed M5 command surface (menu item, menu group, context menu, command bar, keybinding resolver layer, conflict review sheet, import-bridge row, disabled-command explainer, leader/sequence help overlay, and command-documentation surface) stays usable without pointer hover and diagnosable after the fact: the surface is fully keyboard- and screen-reader-addressable with a focus-return and touch/context-action equivalent; a structured copy-safe support-export reconstructs the command id, source layer, conflict/blocker reason, lifecycle state, and help-anchor references without a screenshot; the surface stays reachable and stable across the reduced-motion, high-zoom, compact-layout, and multi-window desktop profiles; and the parity checks gate release evidence so a stale help anchor, missing narration, or hover-only regression auto-narrows the claim. Certifies the frozen M5 menu/keybinding-resolver/command-documentation matrix; mints no parallel command vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "matrix_doc_ref",
    "command_descriptor_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_access_dimensions",
    "required_reach_channels",
    "required_incident_fields",
    "required_access_profiles",
    "required_surface_families",
    "rows",
    "covered_surface_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "conformance_causes",
    "blocking_findings",
    "report_clean",
    "command_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": {
      "const": "commands_m5_discoverability_access_parity_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "command_descriptor_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_access_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "non_pointer_reach",
          "support_export_evidence",
          "profile_stability",
          "release_evidence"
        ]
      }
    },
    "required_reach_channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/reach_channel" }
    },
    "required_incident_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/incident_field" }
    },
    "required_access_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/access_profile" }
    },
    "required_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "conformance_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": { "type": "array", "items": { "type": "object" } },
    "report_clean": { "type": "boolean" },
    "command_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface_family": {
      "type": "string",
      "enum": [
        "menu_item",
        "menu_group",
        "context_menu",
        "command_bar",
        "keybinding_resolver_layer",
        "conflict_review_sheet",
        "import_bridge_row",
        "disabled_command_explainer",
        "leader_sequence_help",
        "command_documentation_surface"
      ]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "lifecycle_label": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "reach_channel": {
      "type": "string",
      "enum": [
        "pointer_default",
        "keyboard_path",
        "screen_reader_narration",
        "focus_return",
        "touch_context_action"
      ]
    },
    "incident_field": {
      "type": "string",
      "enum": [
        "command_id",
        "source_layer",
        "conflict_or_blocker_reason",
        "lifecycle_state",
        "help_anchor_ref"
      ]
    },
    "access_profile": {
      "type": "string",
      "enum": ["reduced_motion", "high_zoom", "compact_layout", "multi_window"]
    },
    "non_pointer_reach_state": {
      "type": "string",
      "enum": [
        "keyboard_screen_reader_and_touch_parity_certified",
        "disclosed_reduced_touch_fallback",
        "hover_only_or_narration_missing"
      ]
    },
    "support_export_evidence_state": {
      "type": "string",
      "enum": [
        "structured_incident_evidence_reconstructable",
        "disclosed_partial_capture",
        "blocked_state_absent_from_capture"
      ]
    },
    "profile_stability_state": {
      "type": "string",
      "enum": [
        "reachable_and_stable_across_all_profiles",
        "disclosed_reduced_profile_coverage",
        "surface_unreachable_or_unstable_in_profile"
      ]
    },
    "release_evidence_state": {
      "type": "string",
      "enum": [
        "parity_checks_gate_release_evidence",
        "disclosed_partial_evidence_refresh",
        "stale_anchor_or_regression_unblocked"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "surface_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "trigger", "disclosed", "detail"],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "trigger": {
          "type": "string",
          "enum": [
            "alternate_label_invented",
            "command_id_missing",
            "source_layer_hidden",
            "disabled_reason_hidden",
            "lifecycle_or_deprecation_hidden",
            "preview_approval_masked",
            "authority_widened",
            "conflict_winner_ambiguous",
            "stale_target_not_invalidated",
            "import_translation_untruthful",
            "parity_surface_dropped",
            "proof_stale"
          ]
        },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "surface_label",
        "qualification",
        "owner_role",
        "scope_summary",
        "canonical_command_binding",
        "lifecycle_label",
        "preview_class",
        "disabled_reason_mode",
        "required_labels",
        "feature_families",
        "certified_reach_channels",
        "certified_incident_fields",
        "certified_access_profiles",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "non_pointer_reach",
        "support_export_evidence",
        "profile_stability",
        "release_evidence",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "conformance_causes",
        "narrowing_reason"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "qualification": {
          "type": "string",
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "canonical_command_binding": { "type": "object" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "preview_class": { "type": "string" },
        "disabled_reason_mode": { "type": "string" },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "feature_families": { "type": "array", "items": { "type": "string" } },
        "certified_reach_channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/reach_channel" }
        },
        "certified_incident_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/incident_field" }
        },
        "certified_access_profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/access_profile" }
        },
        "required_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "evaluated_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "non_pointer_reach": { "$ref": "#/$defs/non_pointer_reach_state" },
        "support_export_evidence": { "$ref": "#/$defs/support_export_evidence_state" },
        "profile_stability": { "$ref": "#/$defs/profile_stability_state" },
        "release_evidence": { "$ref": "#/$defs/release_evidence_state" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "conformance_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  }
}
