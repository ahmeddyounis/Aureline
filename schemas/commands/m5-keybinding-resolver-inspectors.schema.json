{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/commands/m5-keybinding-resolver-inspectors.schema.json",
  "title": "M5 keybinding resolver inspection certification packet",
  "description": "Per-family green/yellow/red certification that every claimed M5 command surface (menu item, menu group, context menu, command bar, keybinding resolver layer, conflict review sheet, import-bridge row, disabled-command explainer, leader/sequence help overlay, and command-documentation surface) makes shortcut resolution inspectable: a user, doc, automation, or support reviewer can see which binding wins, why it wins, what lost, how an imported shortcut translated with one of the controlled bridge-outcome states, and how a leader/multi-stroke shortcut resolves. Certifies the frozen M5 menu/keybinding-resolver/command-documentation matrix; mints no parallel command vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "matrix_doc_ref",
    "keybinding_resolver_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_inspection_dimensions",
    "required_inspector_fields",
    "required_bridge_outcomes",
    "required_migration_actions",
    "required_surface_families",
    "rows",
    "covered_surface_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "conformance_causes",
    "blocking_findings",
    "report_clean",
    "command_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": {
      "const": "commands_m5_keybinding_resolver_inspectors_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "keybinding_resolver_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_inspection_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "resolver_inspection",
          "bridge_outcome",
          "leader_sequence_inspection",
          "resolver_export"
        ]
      }
    },
    "required_inspector_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/inspector_field" }
    },
    "required_bridge_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/bridge_outcome_state" }
    },
    "required_migration_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/migration_action" }
    },
    "required_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_surface_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "conformance_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": { "type": "array", "items": { "type": "object" } },
    "report_clean": { "type": "boolean" },
    "command_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface_family": {
      "type": "string",
      "enum": [
        "menu_item",
        "menu_group",
        "context_menu",
        "command_bar",
        "keybinding_resolver_layer",
        "conflict_review_sheet",
        "import_bridge_row",
        "disabled_command_explainer",
        "leader_sequence_help",
        "command_documentation_surface"
      ]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "shortcut_source_class": {
      "type": "string",
      "enum": [
        "default_keymap",
        "platform_default",
        "imported_keymap",
        "extension_keybinding",
        "workspace_keybinding",
        "user_keybinding",
        "leader_sequence"
      ]
    },
    "inspector_field": {
      "type": "string",
      "enum": [
        "source_layer",
        "scope",
        "current_mode",
        "active_winner",
        "losing_candidates",
        "reserved_unavailable_state",
        "fallback_command_path"
      ]
    },
    "bridge_outcome_state": {
      "type": "string",
      "enum": [
        "exact",
        "translated",
        "alias_only",
        "partial",
        "shimmed",
        "unsupported"
      ]
    },
    "migration_action": {
      "type": "string",
      "enum": ["open_docs", "manual_fix", "no_action_needed"]
    },
    "resolver_inspection": {
      "type": "string",
      "enum": [
        "winner_shadowed_source_and_fallback_certified",
        "disclosed_reduced_inspector_detail",
        "winning_or_shadowed_binding_hidden"
      ]
    },
    "bridge_outcome": {
      "type": "string",
      "enum": [
        "controlled_states_and_migration_actions_certified",
        "disclosed_partial_bridge_coverage",
        "generic_imported_wording_used"
      ]
    },
    "leader_sequence_inspection": {
      "type": "string",
      "enum": [
        "precedence_timeout_cancel_narration_certified",
        "disclosed_reduced_sequence_hint",
        "sequence_availability_requires_hidden_knowledge"
      ]
    },
    "resolver_export": {
      "type": "string",
      "enum": [
        "command_id_and_winning_source_reconstructable",
        "disclosed_partial_capture",
        "winning_source_absent_from_capture"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "surface_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "trigger", "disclosed", "detail"],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "trigger": {
          "type": "string",
          "enum": [
            "alternate_label_invented",
            "command_id_missing",
            "source_layer_hidden",
            "disabled_reason_hidden",
            "lifecycle_or_deprecation_hidden",
            "preview_approval_masked",
            "authority_widened",
            "conflict_winner_ambiguous",
            "stale_target_not_invalidated",
            "import_translation_untruthful",
            "parity_surface_dropped",
            "proof_stale"
          ]
        },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "surface_label",
        "qualification",
        "owner_role",
        "scope_summary",
        "canonical_command_binding",
        "required_labels",
        "shortcut_source_classes",
        "winning_source_class",
        "shadowed_source_classes",
        "conflict_reasons",
        "import_translation_states",
        "stale_target_states",
        "unavailable_reasons",
        "feature_families",
        "certified_inspector_fields",
        "certified_bridge_outcomes",
        "certified_migration_actions",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "resolver_inspection",
        "bridge_outcome",
        "leader_sequence_inspection",
        "resolver_export",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "conformance_causes",
        "narrowing_reason"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "qualification": {
          "type": "string",
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "canonical_command_binding": { "type": "object" },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "shortcut_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/shortcut_source_class" }
        },
        "winning_source_class": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shortcut_source_class" }]
        },
        "shadowed_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/shortcut_source_class" }
        },
        "conflict_reasons": { "type": "array", "items": { "type": "string" } },
        "import_translation_states": { "type": "array", "items": { "type": "string" } },
        "stale_target_states": { "type": "array", "items": { "type": "string" } },
        "unavailable_reasons": { "type": "array", "items": { "type": "string" } },
        "feature_families": { "type": "array", "items": { "type": "string" } },
        "certified_inspector_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/inspector_field" }
        },
        "certified_bridge_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/bridge_outcome_state" }
        },
        "certified_migration_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/migration_action" }
        },
        "required_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "evaluated_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "resolver_inspection": { "$ref": "#/$defs/resolver_inspection" },
        "bridge_outcome": { "$ref": "#/$defs/bridge_outcome" },
        "leader_sequence_inspection": { "$ref": "#/$defs/leader_sequence_inspection" },
        "resolver_export": { "$ref": "#/$defs/resolver_export" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "conformance_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  }
}
