{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/runbooks/m5-runbook-companion-register.schema.json",
  "title": "Aureline M5 runbook companion-scoped surface register",
  "description": "The governed inventory of companion-scoped runbook surfaces. Each surface narrows one governed executable step to the companion client scope: a browser/mobile companion may follow, acknowledge, and comment within a step's declared scope, may act in scope on a step it is permitted to run — reusing the same shared approval-authority and action-envelope refs the desktop path uses, so a companion approval creates the same durable audit/approval objects — but may never become a hidden privileged mutate channel. Any step whose approval or mutation the companion may not grant has its privileged mutate channel explicitly blocked and degrades to a clear desktop handoff state, never a silent failure or a misleading claim of parity. The register embeds the same checked-in step objects, derives one companion surface per step, and exposes the same truth identically across the companion app, the desktop handoff target, and support exports. The register carries metadata and refs only: no credential bodies or raw provider/console payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "register_id",
    "report_label",
    "evaluated_at",
    "steps",
    "surfaces",
    "surface_exposure",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_runbook_companion_register" },
    "schema_version": { "const": 1 },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "$ref": "#/$defs/non_empty_string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executable_step" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/companion_surface" }
    },
    "surface_exposure": { "$ref": "#/$defs/surface_exposure" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "companion_message_id": { "type": "string", "pattern": "^runbooks_companion\\." },
    "step_message_id": { "type": "string", "pattern": "^runbooks_steps\\." },
    "step_class": {
      "enum": [
        "inspect",
        "diagnose",
        "mitigate",
        "rollback",
        "console_handoff",
        "approval",
        "annotate"
      ]
    },
    "approval_scope": {
      "enum": [
        "no_approval_read_only",
        "scoped_self_approve",
        "requires_human_approval",
        "requires_privileged_approval",
        "prohibited_hidden_mutate"
      ]
    },
    "execution_mode": {
      "enum": ["view_only", "in_product_executable", "handoff_only"]
    },
    "target_selector_breadth": {
      "enum": [
        "no_target",
        "single_target",
        "scoped_set",
        "environment_wide",
        "external_target"
      ]
    },
    "control_plane_boundary": {
      "enum": [
        "in_app_governed",
        "browser_handoff",
        "vendor_console_handoff",
        "auth_boundary_cross"
      ]
    },
    "companion_action_class": {
      "enum": [
        "follow",
        "acknowledge",
        "comment",
        "execute_in_scope",
        "grant_scoped_approval",
        "request_approval",
        "handoff_to_desktop"
      ]
    },
    "scope_disposition": {
      "enum": ["follow_in_scope", "act_in_scope", "desktop_handoff_required"]
    },
    "surface_kind": {
      "enum": ["companion_app", "desktop_handoff_target", "support_export"]
    },
    "target_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector_ref", "breadth", "crosses_environment"],
      "properties": {
        "selector_ref": { "$ref": "#/$defs/non_empty_string" },
        "breadth": { "$ref": "#/$defs/target_selector_breadth" },
        "crosses_environment": { "type": "boolean" }
      }
    },
    "command_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_envelope_ref",
        "approval_authority_ref",
        "binds_shared_envelope",
        "uses_runbook_local_bypass"
      ],
      "properties": {
        "action_envelope_ref": { "type": "string" },
        "approval_authority_ref": { "type": "string" },
        "binds_shared_envelope": { "type": "boolean" },
        "uses_runbook_local_bypass": { "const": false }
      }
    },
    "executable_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "step_id",
        "step_label",
        "step_class",
        "target_selector",
        "approval_scope",
        "execution_mode",
        "control_plane_boundary",
        "command_binding",
        "mutating",
        "expected_evidence_outputs",
        "companion_permitted",
        "detail_message_id"
      ],
      "properties": {
        "record_kind": { "const": "m5_runbook_executable_step" },
        "schema_version": { "const": 1 },
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "step_label": { "$ref": "#/$defs/non_empty_string" },
        "step_class": { "$ref": "#/$defs/step_class" },
        "target_selector": { "$ref": "#/$defs/target_selector" },
        "approval_scope": { "$ref": "#/$defs/approval_scope" },
        "execution_mode": { "$ref": "#/$defs/execution_mode" },
        "control_plane_boundary": { "$ref": "#/$defs/control_plane_boundary" },
        "command_binding": { "$ref": "#/$defs/command_binding" },
        "mutating": { "type": "boolean" },
        "expected_evidence_outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "companion_permitted": { "type": "boolean" },
        "detail_message_id": { "$ref": "#/$defs/step_message_id" }
      }
    },
    "companion_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "step_id",
        "step_label",
        "step_class",
        "approval_scope",
        "execution_mode",
        "control_plane_boundary",
        "scope_disposition",
        "available_actions",
        "blocked_actions",
        "companion_may_execute",
        "companion_may_grant_approval",
        "companion_may_request",
        "privileged_mutate_blocked_on_companion",
        "creates_hidden_mutate_channel",
        "detail_message_id"
      ],
      "properties": {
        "record_kind": { "const": "m5_runbook_companion_surface" },
        "schema_version": { "const": 1 },
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "step_label": { "$ref": "#/$defs/non_empty_string" },
        "step_class": { "$ref": "#/$defs/step_class" },
        "approval_scope": { "$ref": "#/$defs/approval_scope" },
        "execution_mode": { "$ref": "#/$defs/execution_mode" },
        "control_plane_boundary": { "$ref": "#/$defs/control_plane_boundary" },
        "scope_disposition": { "$ref": "#/$defs/scope_disposition" },
        "available_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/companion_action_class" }
        },
        "blocked_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/companion_action_class" }
        },
        "reused_approval_authority_ref": { "$ref": "#/$defs/non_empty_string" },
        "reused_action_envelope_ref": { "$ref": "#/$defs/non_empty_string" },
        "desktop_approval_authority_ref": { "$ref": "#/$defs/non_empty_string" },
        "desktop_handoff_message_id": { "$ref": "#/$defs/companion_message_id" },
        "companion_may_execute": { "type": "boolean" },
        "companion_may_grant_approval": { "type": "boolean" },
        "companion_may_request": { "type": "boolean" },
        "privileged_mutate_blocked_on_companion": { "type": "boolean" },
        "creates_hidden_mutate_channel": { "const": false },
        "detail_message_id": { "$ref": "#/$defs/companion_message_id" }
      }
    },
    "surface_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companion_app_exposes_surfaces",
        "desktop_handoff_target_exposes_surfaces",
        "support_export_exposes_surfaces"
      ],
      "properties": {
        "companion_app_exposes_surfaces": { "const": true },
        "desktop_handoff_target_exposes_surfaces": { "const": true },
        "support_export_exposes_surfaces": { "const": true }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_classes",
        "scope_dispositions",
        "step_classes",
        "approval_scopes",
        "execution_modes",
        "control_plane_boundaries",
        "surfaces"
      ],
      "properties": {
        "action_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/companion_action_class" }
        },
        "scope_dispositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/scope_disposition" }
        },
        "step_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/step_class" }
        },
        "approval_scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/approval_scope" }
        },
        "execution_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/execution_mode" }
        },
        "control_plane_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/control_plane_boundary" }
        },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_kind" }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "follow_acknowledge_available_within_scope",
        "companion_never_mutates_beyond_scope",
        "companion_approval_reuses_desktop_objects",
        "blocked_actions_degrade_to_desktop_handoff",
        "no_companion_surface_mints_hidden_mutate_channel",
        "surfaces_derived_from_checked_in_steps",
        "export_carries_no_raw_boundary_material"
      ],
      "properties": {
        "follow_acknowledge_available_within_scope": { "const": true },
        "companion_never_mutates_beyond_scope": { "const": true },
        "companion_approval_reuses_desktop_objects": { "const": true },
        "blocked_actions_degrade_to_desktop_handoff": { "const": true },
        "no_companion_surface_mints_hidden_mutate_channel": { "const": true },
        "surfaces_derived_from_checked_in_steps": { "const": true },
        "export_carries_no_raw_boundary_material": { "const": true }
      }
    }
  }
}
