{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/runbooks/m5-runbook-step.schema.json",
  "title": "Aureline M5 runbook step descriptor",
  "description": "A governed executable runbook step declaring what class of step is being run, what scope or approval it requires, the control-plane boundary it sits on, whether it mutates target state, the evidence outputs it is expected to produce, and whether a companion may execute it within declared scope. A mutating step that requires no approval, or a companion-permitted step outside read-only/self-approve scope, would be a hidden privileged mutate channel and is rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "step_id",
    "step_label",
    "step_class",
    "approval_scope",
    "control_plane_boundary",
    "mutating",
    "expected_evidence_outputs",
    "companion_permitted",
    "detail_message_id"
  ],
  "properties": {
    "record_kind": { "const": "m5_runbook_step_descriptor" },
    "schema_version": { "const": 1 },
    "step_id": { "$ref": "#/$defs/non_empty_string" },
    "step_label": { "$ref": "#/$defs/non_empty_string" },
    "step_class": { "$ref": "#/$defs/step_class" },
    "approval_scope": { "$ref": "#/$defs/approval_scope" },
    "control_plane_boundary": { "$ref": "#/$defs/control_plane_boundary" },
    "mutating": { "type": "boolean" },
    "expected_evidence_outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "companion_permitted": { "type": "boolean" },
    "detail_message_id": { "$ref": "#/$defs/message_id" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "pattern": "^runbooks_governance\\." },
    "step_class": {
      "enum": [
        "inspect",
        "diagnose",
        "mitigate",
        "rollback",
        "console_handoff",
        "approval",
        "annotate"
      ]
    },
    "approval_scope": {
      "enum": [
        "no_approval_read_only",
        "scoped_self_approve",
        "requires_human_approval",
        "requires_privileged_approval",
        "prohibited_hidden_mutate"
      ]
    },
    "control_plane_boundary": {
      "enum": [
        "in_app_governed",
        "browser_handoff",
        "vendor_console_handoff",
        "auth_boundary_cross"
      ]
    }
  }
}
