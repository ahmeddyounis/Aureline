{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/runbooks/m5-runbook-source.schema.json",
  "title": "Aureline M5 runbook source descriptor",
  "description": "A governed runbook source descriptor declaring where a runbook's authority comes from (its source class), who owns it, the default approval scope its steps inherit, whether a companion may request execution within declared scope, and its export/redaction posture. Imported vendor-console references and companion drafts carry no standing execution authority and must not self-approve by default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "source_id",
    "source_label",
    "source_class",
    "authority_ref",
    "owner_role",
    "default_approval_scope",
    "companion_may_request",
    "exportable",
    "redaction_class",
    "detail_message_id"
  ],
  "properties": {
    "record_kind": { "const": "m5_runbook_source_descriptor" },
    "schema_version": { "const": 1 },
    "source_id": { "$ref": "#/$defs/non_empty_string" },
    "source_label": { "$ref": "#/$defs/non_empty_string" },
    "source_class": { "$ref": "#/$defs/source_class" },
    "authority_ref": { "$ref": "#/$defs/non_empty_string" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "default_approval_scope": { "$ref": "#/$defs/approval_scope" },
    "companion_may_request": { "type": "boolean" },
    "exportable": { "type": "boolean" },
    "redaction_class": { "$ref": "#/$defs/non_empty_string" },
    "detail_message_id": { "$ref": "#/$defs/message_id" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "pattern": "^runbooks_governance\\." },
    "source_class": {
      "enum": [
        "vendored_first_party",
        "organization_authored",
        "imported_vendor_console",
        "companion_drafted",
        "archived_execution"
      ]
    },
    "approval_scope": {
      "enum": [
        "no_approval_read_only",
        "scoped_self_approve",
        "requires_human_approval",
        "requires_privileged_approval",
        "prohibited_hidden_mutate"
      ]
    }
  }
}
