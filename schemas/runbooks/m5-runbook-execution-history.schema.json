{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/runbooks/m5-runbook-execution-history.schema.json",
  "title": "Aureline M5 runbook execution history",
  "description": "A governed inventory of runbook execution records and one mechanically-derived reuse projection per executed-step row. Each row records the actor accountable for it, the target it acted on, its outcome, the deviation lineage, and — crucially — whether it reused the shared command/action-envelope preview hash and the shared approval authority. A mutating row must reuse both; an observe/verify/communicate row carries no preview hash and no approval ref unless its scope requires one, so a runbook is never a privileged exception path. The history is exposed identically on operator history, support exports, and incident packets, so a row reads the same wherever it is rendered. The packet carries metadata and refs only: no credential bodies or raw provider/console payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "history_id",
    "report_label",
    "evaluated_at",
    "executions",
    "row_projections",
    "archival_lineage",
    "surface_exposure",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_runbook_execution_history" },
    "schema_version": { "const": 1 },
    "history_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "$ref": "#/$defs/non_empty_string" },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aureline.dev/schemas/runbooks/m5-runbook-execution.schema.json"
      }
    },
    "row_projections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row_projection" }
    },
    "archival_lineage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/archival_lineage_projection" }
    },
    "surface_exposure": { "$ref": "#/$defs/surface_exposure" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "nullable_string": { "type": ["string", "null"] },
    "step_class": {
      "enum": [
        "inspect",
        "diagnose",
        "mitigate",
        "rollback",
        "console_handoff",
        "approval",
        "annotate"
      ]
    },
    "approval_scope": {
      "enum": [
        "no_approval_read_only",
        "scoped_self_approve",
        "requires_human_approval",
        "requires_privileged_approval",
        "prohibited_hidden_mutate"
      ]
    },
    "control_plane_boundary": {
      "enum": [
        "in_app_governed",
        "browser_handoff",
        "vendor_console_handoff",
        "auth_boundary_cross"
      ]
    },
    "deviation_class": {
      "enum": [
        "no_deviation",
        "parameter_adjusted",
        "step_skipped",
        "step_added_ad_hoc",
        "aborted_mid_step",
        "console_pivot_unplanned"
      ]
    },
    "step_outcome": {
      "enum": [
        "completed",
        "skipped",
        "handed_off",
        "awaiting_approval",
        "aborted_requires_review"
      ]
    },
    "preview_disposition": {
      "enum": ["read_only_preview", "diff_then_confirm", "handoff_preview"]
    },
    "surface": {
      "enum": ["operator_history", "support_export", "incident_packet"]
    },
    "row_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "step_id",
        "step_label",
        "step_class",
        "actor_ref",
        "target_ref",
        "outcome",
        "mutating",
        "preview_disposition",
        "reuses_shared_preview",
        "requires_approval",
        "requires_explicit_human_approval",
        "approval_scope",
        "reuses_shared_approval",
        "audit_expects_evidence",
        "evidence_refs",
        "deviation_class",
        "handed_off",
        "attributable",
        "creates_hidden_mutate_channel"
      ],
      "properties": {
        "execution_id": { "$ref": "#/$defs/non_empty_string" },
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "step_label": { "$ref": "#/$defs/non_empty_string" },
        "step_class": { "$ref": "#/$defs/step_class" },
        "actor_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_ref": { "type": "string" },
        "outcome": { "$ref": "#/$defs/step_outcome" },
        "mutating": { "type": "boolean" },
        "preview_disposition": { "$ref": "#/$defs/preview_disposition" },
        "reuses_shared_preview": { "type": "boolean" },
        "preview_hash": { "$ref": "#/$defs/nullable_string" },
        "requires_approval": { "type": "boolean" },
        "requires_explicit_human_approval": { "type": "boolean" },
        "approval_scope": { "$ref": "#/$defs/approval_scope" },
        "reuses_shared_approval": { "type": "boolean" },
        "approval_ref": { "$ref": "#/$defs/nullable_string" },
        "audit_expects_evidence": { "type": "boolean" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "deviation_class": { "$ref": "#/$defs/deviation_class" },
        "handed_off": { "type": "boolean" },
        "attributable": { "type": "boolean" },
        "creates_hidden_mutate_channel": { "const": false }
      }
    },
    "deviation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviation_id",
        "deviation_class",
        "from_step_id",
        "affected_step_ids",
        "actor_ref",
        "approver_role",
        "recorded_at",
        "summary_message_id",
        "rationale_message_id",
        "attributable"
      ],
      "properties": {
        "deviation_id": { "$ref": "#/$defs/non_empty_string" },
        "deviation_class": { "$ref": "#/$defs/deviation_class" },
        "from_step_id": { "$ref": "#/$defs/non_empty_string" },
        "affected_step_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "actor_ref": { "type": "string" },
        "approver_role": { "type": "string" },
        "recorded_at": { "$ref": "#/$defs/non_empty_string" },
        "summary_message_id": { "type": "string", "pattern": "^runbooks_governance\\." },
        "rationale_message_id": { "type": "string", "pattern": "^runbooks_governance\\." },
        "attributable": { "type": "boolean" }
      }
    },
    "archival_lineage_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "execution_label",
        "archival_id",
        "archived",
        "archived_at",
        "retention_class",
        "support_pack_item_id",
        "joined_families",
        "deviations",
        "lineage_recoverable_from_metadata_only"
      ],
      "properties": {
        "execution_id": { "$ref": "#/$defs/non_empty_string" },
        "execution_label": { "$ref": "#/$defs/non_empty_string" },
        "archival_id": { "$ref": "#/$defs/non_empty_string" },
        "archived": { "type": "boolean" },
        "archived_at": { "$ref": "#/$defs/non_empty_string" },
        "retention_class": { "$ref": "#/$defs/non_empty_string" },
        "support_pack_item_id": { "$ref": "#/$defs/non_empty_string" },
        "joined_families": {
          "type": "array",
          "items": {
            "enum": ["incident", "rollout", "review", "support_bundle"]
          }
        },
        "incident_ref": { "$ref": "#/$defs/non_empty_string" },
        "rollout_ref": { "$ref": "#/$defs/non_empty_string" },
        "review_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_bundle_ref": { "$ref": "#/$defs/non_empty_string" },
        "deviations": {
          "type": "array",
          "items": { "$ref": "#/$defs/deviation_summary" }
        },
        "lineage_recoverable_from_metadata_only": { "const": true }
      }
    },
    "surface_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_history_exposes_executions",
        "support_export_exposes_executions",
        "incident_packet_exposes_executions"
      ],
      "properties": {
        "operator_history_exposes_executions": { "const": true },
        "support_export_exposes_executions": { "const": true },
        "incident_packet_exposes_executions": { "const": true }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_classes",
        "approval_scopes",
        "control_plane_boundaries",
        "deviation_classes",
        "step_outcomes",
        "preview_dispositions",
        "surfaces"
      ],
      "properties": {
        "step_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/step_class" }
        },
        "approval_scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/approval_scope" }
        },
        "control_plane_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/control_plane_boundary" }
        },
        "deviation_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/deviation_class" }
        },
        "step_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/step_outcome" }
        },
        "preview_dispositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/preview_disposition" }
        },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_row_attributable",
        "mutating_rows_reuse_shared_preview_and_approval",
        "observe_verify_communicate_rows_have_no_fake_mutation",
        "no_row_mints_hidden_privileged_mutate_channel",
        "history_export_safe_across_step_classes",
        "one_vocabulary_across_operator_history_support_and_incident",
        "deviations_durable_and_inspectable",
        "archived_history_joinable_after_session",
        "lineage_reconstructable_from_metadata_only",
        "generated_from_checked_in_executions"
      ],
      "properties": {
        "every_row_attributable": { "const": true },
        "mutating_rows_reuse_shared_preview_and_approval": { "const": true },
        "observe_verify_communicate_rows_have_no_fake_mutation": { "const": true },
        "no_row_mints_hidden_privileged_mutate_channel": { "const": true },
        "history_export_safe_across_step_classes": { "const": true },
        "one_vocabulary_across_operator_history_support_and_incident": { "const": true },
        "deviations_durable_and_inspectable": { "const": true },
        "archived_history_joinable_after_session": { "const": true },
        "lineage_reconstructable_from_metadata_only": { "const": true },
        "generated_from_checked_in_executions": { "const": true }
      }
    }
  }
}
