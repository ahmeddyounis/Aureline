{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/runbooks/m5-runbook-execution.schema.json",
  "title": "Aureline M5 runbook execution record",
  "description": "A governed runbook execution record: the source descriptor whose authority the execution ran under, the executed-step rows that ran (each naming the actor accountable for it, the target it acted on, its outcome, the shared command/action-envelope preview hash and approval ref it reused, and the evidence it produced), the deviation lineage (every departure from declared guidance, attributable), any console/browser control-plane handoff packets, and the archival/export object for the retained history. A mutating row reuses the same shared preview and approval any governed mutation uses; an observe/verify/communicate row carries no preview hash and no approval ref unless its scope requires one. The record asserts that every step, deviation, and handoff is attributable and that no step or handoff minted a hidden privileged mutate channel. It carries metadata and refs only — no raw provider/console payloads or credential bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "execution_id",
    "execution_label",
    "source",
    "operator_role",
    "companion_driven",
    "executed_steps",
    "deviation_lineage",
    "archival_export",
    "attributable",
    "no_hidden_mutate_channel",
    "redaction_class",
    "detail_message_id"
  ],
  "properties": {
    "record_kind": { "const": "m5_runbook_execution_record" },
    "schema_version": { "const": 1 },
    "execution_id": { "$ref": "#/$defs/non_empty_string" },
    "execution_label": { "$ref": "#/$defs/non_empty_string" },
    "source": { "$ref": "#/$defs/source_descriptor" },
    "operator_role": { "$ref": "#/$defs/non_empty_string" },
    "companion_driven": { "type": "boolean" },
    "executed_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executed_step_result" }
    },
    "deviation_lineage": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation_note" }
    },
    "archival_export": { "$ref": "#/$defs/archival_export" },
    "attributable": { "type": "boolean" },
    "no_hidden_mutate_channel": { "type": "boolean" },
    "redaction_class": { "$ref": "#/$defs/non_empty_string" },
    "detail_message_id": { "$ref": "#/$defs/message_id" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "pattern": "^runbooks_governance\\." },
    "source_class": {
      "enum": [
        "vendored_first_party",
        "organization_authored",
        "imported_vendor_console",
        "companion_drafted",
        "archived_execution"
      ]
    },
    "step_class": {
      "enum": [
        "inspect",
        "diagnose",
        "mitigate",
        "rollback",
        "console_handoff",
        "approval",
        "annotate"
      ]
    },
    "approval_scope": {
      "enum": [
        "no_approval_read_only",
        "scoped_self_approve",
        "requires_human_approval",
        "requires_privileged_approval",
        "prohibited_hidden_mutate"
      ]
    },
    "control_plane_boundary": {
      "enum": [
        "in_app_governed",
        "browser_handoff",
        "vendor_console_handoff",
        "auth_boundary_cross"
      ]
    },
    "handoff_destination_class": {
      "enum": [
        "vendor_console",
        "browser_reference_doc",
        "browser_app_surface",
        "external_auth_authority"
      ]
    },
    "handoff_reason_class": {
      "enum": [
        "execute_out_of_plane_action",
        "consult_reference_documentation",
        "inspect_vendor_state",
        "complete_auth_challenge",
        "retrieve_export_artifact"
      ]
    },
    "reference_plane_state": {
      "enum": ["governed_in_app", "handoff_required", "reference_only"]
    },
    "return_anchor_object_class": {
      "enum": ["runbook_execution", "runbook_step", "incident_workspace"]
    },
    "return_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiating_object_class",
        "initiating_object_ref",
        "target_continuity_ref",
        "evidence_continuity_ref",
        "return_message_id"
      ],
      "properties": {
        "initiating_object_class": { "$ref": "#/$defs/return_anchor_object_class" },
        "initiating_object_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_continuity_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_continuity_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "deviation_class": {
      "enum": [
        "no_deviation",
        "parameter_adjusted",
        "step_skipped",
        "step_added_ad_hoc",
        "aborted_mid_step",
        "console_pivot_unplanned"
      ]
    },
    "step_outcome": {
      "enum": [
        "completed",
        "skipped",
        "handed_off",
        "awaiting_approval",
        "aborted_requires_review"
      ]
    },
    "source_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "source_id",
        "source_label",
        "source_class",
        "authority_ref",
        "owner_role",
        "default_approval_scope",
        "companion_may_request",
        "exportable",
        "redaction_class",
        "detail_message_id"
      ],
      "properties": {
        "record_kind": { "const": "m5_runbook_source_descriptor" },
        "schema_version": { "const": 1 },
        "source_id": { "$ref": "#/$defs/non_empty_string" },
        "source_label": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "authority_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "default_approval_scope": { "$ref": "#/$defs/approval_scope" },
        "companion_may_request": { "type": "boolean" },
        "exportable": { "type": "boolean" },
        "redaction_class": { "$ref": "#/$defs/non_empty_string" },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "step_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "step_id",
        "step_label",
        "step_class",
        "approval_scope",
        "control_plane_boundary",
        "mutating",
        "expected_evidence_outputs",
        "companion_permitted",
        "detail_message_id"
      ],
      "properties": {
        "record_kind": { "const": "m5_runbook_step_descriptor" },
        "schema_version": { "const": 1 },
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "step_label": { "$ref": "#/$defs/non_empty_string" },
        "step_class": { "$ref": "#/$defs/step_class" },
        "approval_scope": { "$ref": "#/$defs/approval_scope" },
        "control_plane_boundary": { "$ref": "#/$defs/control_plane_boundary" },
        "mutating": { "type": "boolean" },
        "expected_evidence_outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "companion_permitted": { "type": "boolean" },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "deviation_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviation_id",
        "deviation_class",
        "from_step_id",
        "affected_step_ids",
        "actor_ref",
        "approver_role",
        "recorded_at",
        "rationale_message_id",
        "summary_message_id",
        "attributable"
      ],
      "properties": {
        "deviation_id": { "$ref": "#/$defs/non_empty_string" },
        "deviation_class": { "$ref": "#/$defs/deviation_class" },
        "from_step_id": { "$ref": "#/$defs/non_empty_string" },
        "affected_step_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "actor_ref": { "type": "string" },
        "approver_role": { "type": "string" },
        "recorded_at": { "$ref": "#/$defs/non_empty_string" },
        "rationale_message_id": { "$ref": "#/$defs/message_id" },
        "summary_message_id": { "$ref": "#/$defs/message_id" },
        "attributable": { "type": "boolean" }
      }
    },
    "archival_lineage_joins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_ref",
        "rollout_ref",
        "review_ref",
        "support_bundle_ref"
      ],
      "properties": {
        "incident_ref": { "$ref": "#/$defs/nullable_string" },
        "rollout_ref": { "$ref": "#/$defs/nullable_string" },
        "review_ref": { "$ref": "#/$defs/nullable_string" },
        "support_bundle_ref": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "control_plane_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "boundary_class",
        "destination_class",
        "reason_class",
        "reference_plane_state",
        "target_ref",
        "destination_object_ref",
        "attribution_ref",
        "return_anchor",
        "returns_to_governed_plane",
        "creates_hidden_mutate_channel",
        "detail_message_id"
      ],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/non_empty_string" },
        "boundary_class": { "$ref": "#/$defs/control_plane_boundary" },
        "destination_class": { "$ref": "#/$defs/handoff_destination_class" },
        "reason_class": { "$ref": "#/$defs/handoff_reason_class" },
        "reference_plane_state": { "$ref": "#/$defs/reference_plane_state" },
        "target_ref": { "$ref": "#/$defs/non_empty_string" },
        "destination_object_ref": { "$ref": "#/$defs/non_empty_string" },
        "attribution_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_anchor": { "$ref": "#/$defs/return_anchor" },
        "narrowed_authority_message_id": { "$ref": "#/$defs/message_id" },
        "returns_to_governed_plane": { "type": "boolean" },
        "creates_hidden_mutate_channel": { "const": false },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "archival_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archival_id",
        "archived",
        "archived_at",
        "export_safe",
        "retention_class",
        "support_pack_item_id",
        "lineage_joins",
        "lineage_recoverable_from_metadata_only",
        "raw_content_exported"
      ],
      "properties": {
        "archival_id": { "$ref": "#/$defs/non_empty_string" },
        "archived": { "type": "boolean" },
        "archived_at": { "$ref": "#/$defs/non_empty_string" },
        "export_safe": { "type": "boolean" },
        "retention_class": { "$ref": "#/$defs/non_empty_string" },
        "support_pack_item_id": { "$ref": "#/$defs/non_empty_string" },
        "lineage_joins": { "$ref": "#/$defs/archival_lineage_joins" },
        "lineage_recoverable_from_metadata_only": { "const": true },
        "raw_content_exported": { "const": false }
      }
    },
    "nullable_string": { "type": ["string", "null"] },
    "executed_step_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "actor_ref",
        "target_ref",
        "outcome",
        "preview_hash",
        "approval_ref",
        "deviation",
        "evidence_refs"
      ],
      "properties": {
        "step": { "$ref": "#/$defs/step_descriptor" },
        "actor_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_ref": { "type": "string" },
        "outcome": { "$ref": "#/$defs/step_outcome" },
        "preview_hash": { "$ref": "#/$defs/nullable_string" },
        "approval_ref": { "$ref": "#/$defs/nullable_string" },
        "deviation": { "$ref": "#/$defs/deviation_note" },
        "handoff": { "$ref": "#/$defs/control_plane_handoff" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    }
  }
}
