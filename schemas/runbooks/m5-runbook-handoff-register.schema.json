{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/runbooks/m5-runbook-handoff-register.schema.json",
  "title": "Aureline M5 runbook control-plane handoff register",
  "description": "The governed inventory of runbook control-plane handoffs. Every console/browser pivot is a first-class, attributable transition: it names a destination class (vendor console, browser reference doc, browser app surface, or external auth authority), the reason for the pivot, the object identity it crosses to, a return anchor that preserves the initiating target and evidence identity, and any narrowed far-side authority. Every destination carries a reference-plane state, so a browser reference doc stays reference-only and can never present itself as executable in-product control, while a provider console is named as the true external control plane that Aureline explicitly hands off to. The register projects every governed handoff — including the live ones embedded in execution records — into one surface-independent projection and publishes a reference-plane catalog. The incident workspace, operator history, support exports, and docs/help all render the same truth. The register carries no credential bodies or raw console/browser payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "register_id",
    "report_label",
    "evaluated_at",
    "handoffs",
    "projections",
    "reference_plane",
    "surface_exposure",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_runbook_handoff_register" },
    "schema_version": { "const": 1 },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "$ref": "#/$defs/non_empty_string" },
    "handoffs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control_plane_handoff" }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/handoff_projection" }
    },
    "reference_plane": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference_plane_entry" }
    },
    "surface_exposure": { "$ref": "#/$defs/surface_exposure" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "governance_message_id": { "type": "string", "pattern": "^runbooks_governance\\." },
    "register_message_id": { "type": "string", "pattern": "^runbooks_handoffs\\." },
    "control_plane_boundary": {
      "enum": [
        "in_app_governed",
        "browser_handoff",
        "vendor_console_handoff",
        "auth_boundary_cross"
      ]
    },
    "handoff_destination_class": {
      "enum": [
        "vendor_console",
        "browser_reference_doc",
        "browser_app_surface",
        "external_auth_authority"
      ]
    },
    "handoff_reason_class": {
      "enum": [
        "execute_out_of_plane_action",
        "consult_reference_documentation",
        "inspect_vendor_state",
        "complete_auth_challenge",
        "retrieve_export_artifact"
      ]
    },
    "reference_plane_state": {
      "enum": ["governed_in_app", "handoff_required", "reference_only"]
    },
    "return_anchor_object_class": {
      "enum": ["runbook_execution", "runbook_step", "incident_workspace"]
    },
    "surface": {
      "enum": ["incident_workspace", "operator_history", "support_export", "docs_help"]
    },
    "return_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiating_object_class",
        "initiating_object_ref",
        "target_continuity_ref",
        "evidence_continuity_ref",
        "return_message_id"
      ],
      "properties": {
        "initiating_object_class": { "$ref": "#/$defs/return_anchor_object_class" },
        "initiating_object_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_continuity_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_continuity_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_message_id": { "$ref": "#/$defs/governance_message_id" }
      }
    },
    "control_plane_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "boundary_class",
        "destination_class",
        "reason_class",
        "reference_plane_state",
        "target_ref",
        "destination_object_ref",
        "attribution_ref",
        "return_anchor",
        "returns_to_governed_plane",
        "creates_hidden_mutate_channel",
        "detail_message_id"
      ],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/non_empty_string" },
        "boundary_class": { "$ref": "#/$defs/control_plane_boundary" },
        "destination_class": { "$ref": "#/$defs/handoff_destination_class" },
        "reason_class": { "$ref": "#/$defs/handoff_reason_class" },
        "reference_plane_state": { "$ref": "#/$defs/reference_plane_state" },
        "target_ref": { "$ref": "#/$defs/non_empty_string" },
        "destination_object_ref": { "$ref": "#/$defs/non_empty_string" },
        "attribution_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_anchor": { "$ref": "#/$defs/return_anchor" },
        "narrowed_authority_message_id": { "$ref": "#/$defs/governance_message_id" },
        "returns_to_governed_plane": { "type": "boolean" },
        "creates_hidden_mutate_channel": { "const": false },
        "detail_message_id": { "$ref": "#/$defs/governance_message_id" }
      }
    },
    "handoff_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "destination_class",
        "reason_class",
        "boundary_class",
        "reference_plane_state",
        "target_ref",
        "destination_object_ref",
        "attribution_ref",
        "return_initiating_object_class",
        "return_initiating_object_ref",
        "return_target_continuity_ref",
        "return_evidence_continuity_ref",
        "return_message_id",
        "returns_to_governed_plane",
        "is_true_control_plane",
        "is_reference_only",
        "executable_in_product",
        "attributable",
        "creates_hidden_mutate_channel",
        "detail_message_id"
      ],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/non_empty_string" },
        "destination_class": { "$ref": "#/$defs/handoff_destination_class" },
        "reason_class": { "$ref": "#/$defs/handoff_reason_class" },
        "boundary_class": { "$ref": "#/$defs/control_plane_boundary" },
        "reference_plane_state": { "$ref": "#/$defs/reference_plane_state" },
        "target_ref": { "$ref": "#/$defs/non_empty_string" },
        "destination_object_ref": { "$ref": "#/$defs/non_empty_string" },
        "attribution_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_initiating_object_class": { "$ref": "#/$defs/return_anchor_object_class" },
        "return_initiating_object_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_target_continuity_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_evidence_continuity_ref": { "$ref": "#/$defs/non_empty_string" },
        "return_message_id": { "$ref": "#/$defs/governance_message_id" },
        "narrowed_authority_message_id": { "$ref": "#/$defs/governance_message_id" },
        "returns_to_governed_plane": { "type": "boolean" },
        "is_true_control_plane": { "type": "boolean" },
        "is_reference_only": { "type": "boolean" },
        "executable_in_product": { "const": false },
        "attributable": { "type": "boolean" },
        "creates_hidden_mutate_channel": { "const": false },
        "detail_message_id": { "$ref": "#/$defs/governance_message_id" }
      }
    },
    "reference_plane_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "entry_id",
        "entry_label",
        "destination_class",
        "reference_plane_state",
        "is_true_control_plane",
        "is_reference_only",
        "executable_in_product",
        "authority_note_message_id",
        "detail_message_id"
      ],
      "properties": {
        "record_kind": { "const": "m5_runbook_reference_plane_entry" },
        "schema_version": { "const": 1 },
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "entry_label": { "$ref": "#/$defs/non_empty_string" },
        "destination_class": { "$ref": "#/$defs/handoff_destination_class" },
        "reference_plane_state": { "$ref": "#/$defs/reference_plane_state" },
        "is_true_control_plane": { "type": "boolean" },
        "is_reference_only": { "type": "boolean" },
        "executable_in_product": { "const": false },
        "authority_note_message_id": { "$ref": "#/$defs/register_message_id" },
        "detail_message_id": { "$ref": "#/$defs/register_message_id" }
      }
    },
    "surface_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_workspace_exposes_handoffs",
        "operator_history_exposes_handoffs",
        "support_export_exposes_handoffs",
        "docs_help_exposes_handoffs"
      ],
      "properties": {
        "incident_workspace_exposes_handoffs": { "const": true },
        "operator_history_exposes_handoffs": { "const": true },
        "support_export_exposes_handoffs": { "const": true },
        "docs_help_exposes_handoffs": { "const": true }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_classes",
        "reason_classes",
        "reference_plane_states",
        "control_plane_boundaries",
        "return_anchor_object_classes",
        "surfaces"
      ],
      "properties": {
        "destination_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/handoff_destination_class" }
        },
        "reason_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/handoff_reason_class" }
        },
        "reference_plane_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference_plane_state" }
        },
        "control_plane_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/control_plane_boundary" }
        },
        "return_anchor_object_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/return_anchor_object_class" }
        },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_handoff_names_destination_reason_and_object_identity",
        "every_handoff_carries_return_anchor_preserving_target_and_evidence",
        "reference_only_destinations_never_present_as_in_product_control",
        "console_browser_pivots_are_attributable_transitions",
        "no_handoff_mints_a_hidden_mutate_channel",
        "operator_scenario_handoffs_are_represented",
        "generated_from_checked_in_handoffs",
        "export_carries_no_raw_boundary_material"
      ],
      "properties": {
        "every_handoff_names_destination_reason_and_object_identity": { "const": true },
        "every_handoff_carries_return_anchor_preserving_target_and_evidence": { "const": true },
        "reference_only_destinations_never_present_as_in_product_control": { "const": true },
        "console_browser_pivots_are_attributable_transitions": { "const": true },
        "no_handoff_mints_a_hidden_mutate_channel": { "const": true },
        "operator_scenario_handoffs_are_represented": { "const": true },
        "generated_from_checked_in_handoffs": { "const": true },
        "export_carries_no_raw_boundary_material": { "const": true }
      }
    }
  }
}
