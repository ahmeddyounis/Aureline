{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/runbooks/m5-runbook-governance.schema.json",
  "title": "Aureline M5 runbook governance matrix packet",
  "description": "The contract inventory that freezes Aureline's runbook object model. It names the six governed runbook object classes — the source descriptor, the step descriptor, the execution record, the deviation note, the control-plane handoff packet, and the archival/export object — and for each names its owner, its first consumer, the schema that is its source of truth, and the proof packet that keeps it current. Each claimed runbook-backed surface binds the governed objects it depends on; a surface that binds an object the matrix does not govern, or whose proof is missing, is blocked from Stable promotion (and named, never hidden), while a surface whose proof is stale auto-narrows below Stable. Blocking gaps may be accepted only under a disclosed, time-bounded waiver scoped to a single object, which ships the surface at the waived claim while its true status stays red. Incident workspaces, operator dashboards, docs/help, companions, support exports, and the release center consume this one inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "object_contracts",
    "surface_claims",
    "vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "release_gate",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_runbook_governance" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "object_contracts": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/object_contract" }
    },
    "surface_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_claim" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "conformance_review": { "$ref": "#/$defs/conformance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_gate": { "$ref": "#/$defs/release_gate" },
    "source_contract_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "pattern": "^runbooks_governance\\." },
    "string_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "object_class": {
      "enum": [
        "source_descriptor",
        "step_descriptor",
        "execution_record",
        "deviation_note",
        "control_plane_handoff",
        "archival_export"
      ]
    },
    "consumer": {
      "enum": [
        "incident_workspace",
        "operator_dashboard",
        "docs_help",
        "companion",
        "support_bundle",
        "release_center"
      ]
    },
    "proof_freshness": { "enum": ["current", "stale", "missing"] },
    "surface_status": { "enum": ["mapped", "provisional", "unmapped"] },
    "signal": { "enum": ["green", "yellow", "red"] },
    "gate_decision": { "enum": ["governed", "narrowed", "blocked"] },
    "gap_kind": {
      "enum": ["object_mapping_missing", "proof_stale", "proof_missing"]
    },
    "claim_class": {
      "enum": ["stable", "beta", "preview", "held", "unavailable"]
    },
    "object_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_class",
        "object_label",
        "owner_role",
        "first_consumer",
        "schema_ref",
        "proof_ref",
        "proof_freshness",
        "governed_vocab",
        "detail_message_id"
      ],
      "properties": {
        "object_class": { "$ref": "#/$defs/object_class" },
        "object_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "first_consumer": { "$ref": "#/$defs/consumer" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
        "governed_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiver_id",
        "gap_kind",
        "object_class",
        "reason_message_id",
        "owner_role",
        "expires_at",
        "narrowed_to"
      ],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "gap_kind": { "enum": ["object_mapping_missing", "proof_missing"] },
        "object_class": { "$ref": "#/$defs/object_class" },
        "reason_message_id": { "$ref": "#/$defs/message_id" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "narrowed_to": { "$ref": "#/$defs/claim_class" }
      }
    },
    "surface_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "object_class", "gap_kind", "waived", "cause_message_id"],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "object_class": { "$ref": "#/$defs/object_class" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "waived": { "type": "boolean" },
        "cause_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "surface_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_label",
        "consumer",
        "owner_role",
        "claimed_class",
        "bound_object_classes",
        "effective_class",
        "status",
        "signal",
        "gate_decision",
        "waivers",
        "gaps",
        "status_message_id",
        "gate_message_id"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "consumer": { "$ref": "#/$defs/consumer" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "claimed_class": { "$ref": "#/$defs/claim_class" },
        "bound_object_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "effective_class": { "$ref": "#/$defs/claim_class" },
        "status": { "$ref": "#/$defs/surface_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gate_decision": { "$ref": "#/$defs/gate_decision" },
        "waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/surface_gap" } },
        "status_message_id": { "$ref": "#/$defs/message_id" },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_classes",
        "source_classes",
        "step_classes",
        "approval_scopes",
        "deviation_classes",
        "control_plane_boundaries",
        "step_outcomes",
        "consumers",
        "proof_freshness_states",
        "surface_statuses",
        "signals",
        "gate_decisions",
        "gap_kinds",
        "claim_classes"
      ],
      "properties": {
        "object_classes": { "$ref": "#/$defs/string_array" },
        "source_classes": { "$ref": "#/$defs/string_array" },
        "step_classes": { "$ref": "#/$defs/string_array" },
        "approval_scopes": { "$ref": "#/$defs/string_array" },
        "deviation_classes": { "$ref": "#/$defs/string_array" },
        "control_plane_boundaries": { "$ref": "#/$defs/string_array" },
        "step_outcomes": { "$ref": "#/$defs/string_array" },
        "consumers": { "$ref": "#/$defs/string_array" },
        "proof_freshness_states": { "$ref": "#/$defs/string_array" },
        "surface_statuses": { "$ref": "#/$defs/string_array" },
        "signals": { "$ref": "#/$defs/string_array" },
        "gate_decisions": { "$ref": "#/$defs/string_array" },
        "gap_kinds": { "$ref": "#/$defs/string_array" },
        "claim_classes": { "$ref": "#/$defs/string_array" }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_object_class_governed",
        "every_object_names_owner_consumer_and_proof",
        "every_surface_binds_governed_objects",
        "missing_object_blocks_stable_promotion",
        "stale_or_missing_proof_gates_before_stable",
        "waivers_disclosed_with_scope_owner_and_expiry",
        "exact_gaps_named",
        "runbooks_declare_authority_step_scope_and_evidence",
        "console_pivots_and_archives_stay_attributable",
        "companions_bounded_no_hidden_mutate_channels",
        "generated_from_checked_in_contracts",
        "support_export_carries_no_raw_boundary_material"
      ],
      "properties": {
        "every_object_class_governed": { "const": true },
        "every_object_names_owner_consumer_and_proof": { "const": true },
        "every_surface_binds_governed_objects": { "const": true },
        "missing_object_blocks_stable_promotion": { "const": true },
        "stale_or_missing_proof_gates_before_stable": { "const": true },
        "waivers_disclosed_with_scope_owner_and_expiry": { "const": true },
        "exact_gaps_named": { "const": true },
        "runbooks_declare_authority_step_scope_and_evidence": { "const": true },
        "console_pivots_and_archives_stay_attributable": { "const": true },
        "companions_bounded_no_hidden_mutate_channels": { "const": true },
        "generated_from_checked_in_contracts": { "const": true },
        "support_export_carries_no_raw_boundary_material": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_workspace_references_inventory",
        "operator_dashboard_references_inventory",
        "docs_help_references_inventory",
        "companion_follows_within_declared_scope",
        "support_export_ships_runbook_objects",
        "release_center_gates_on_matrix"
      ],
      "properties": {
        "incident_workspace_references_inventory": { "const": true },
        "operator_dashboard_references_inventory": { "const": true },
        "docs_help_references_inventory": { "const": true },
        "companion_follows_within_declared_scope": { "const": true },
        "support_export_ships_runbook_objects": { "const": true },
        "release_center_gates_on_matrix": { "const": true }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_stable_promotion",
        "blocked_surface_ids",
        "narrowed_surface_ids",
        "governed_surface_ids",
        "waived_surface_ids",
        "gate_message_id"
      ],
      "properties": {
        "blocks_stable_promotion": { "type": "boolean" },
        "blocked_surface_ids": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "narrowed_surface_ids": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "governed_surface_ids": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "waived_surface_ids": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    }
  }
}
