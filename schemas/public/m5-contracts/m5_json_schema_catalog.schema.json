{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_json_schema_catalog.schema.json",
  "title": "Aureline M5 JSON Schema catalog",
  "description": "Boundary schema for the canonical M5 JSON Schema catalog (artifacts/contracts/m5-json-schema-catalog.json) and its negative fixtures (fixtures/contracts/m5-json-catalog/). The catalog publishes one checked-in JSON Schema package per durable M5 artifact family the publication matrix puts forward as a JSON-Schema-backed contract, each with an explicit in-band schema version field, a lifecycle/stability label, a field-level compatibility contract (additive-field rule, required-field policy, unknown-field preservation, downgrade behavior, and migration-note hooks), an example payload, and a round-trip fixture. The catalog reuses the existing contract-family registry and the public-contract publication matrix rather than minting a new lifecycle lexicon. It is metadata-only: every field is a typed state or an opaque repo-relative ref or URI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "catalog_id",
    "status",
    "as_of",
    "overview_page",
    "sdk_catalog_page",
    "publication_matrix_ref",
    "contract_family_registry_ref",
    "evidence_index_ref",
    "schema_base_uri",
    "schema_home",
    "json_schema_dialect",
    "lifecycle_labels",
    "maturity_lanes",
    "contract_forms",
    "additive_field_rules",
    "required_field_policies",
    "unknown_field_policies",
    "downgrade_behaviors",
    "resolution_surfaces",
    "offline_bundle",
    "packages",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_json_schema_catalog" },
    "catalog_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "sdk_catalog_page": { "$ref": "#/$defs/path_ref" },
    "publication_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "contract_family_registry_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "schema_base_uri": { "type": "string", "format": "uri", "pattern": "^https://" },
    "schema_home": { "$ref": "#/$defs/path_ref" },
    "json_schema_dialect": { "type": "string", "format": "uri" },
    "lifecycle_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "maturity_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/maturity_lane" }
    },
    "contract_forms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contract_form" }
    },
    "additive_field_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/additive_field_rule" }
    },
    "required_field_policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/required_field_policy" }
    },
    "unknown_field_policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unknown_field_policy" }
    },
    "downgrade_behaviors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/downgrade_behavior" }
    },
    "resolution_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resolution_surface" }
    },
    "offline_bundle": { "$ref": "#/$defs/offline_bundle" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$"
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "maturity_lane": {
      "type": "string",
      "enum": ["stable", "beta", "experimental", "internal"]
    },
    "contract_form": {
      "type": "string",
      "enum": [
        "json_schema_backed_contract_doc",
        "record_registry",
        "event_envelope_schema",
        "cli_structured_output",
        "asset_package_manifest",
        "teaching_content_pack",
        "openapi_family"
      ]
    },
    "additive_field_rule": {
      "type": "string",
      "enum": ["additive_minor_optional_only"]
    },
    "required_field_policy": {
      "type": "string",
      "enum": ["frozen_required_set"]
    },
    "unknown_field_policy": {
      "type": "string",
      "enum": ["preserve", "reject_unknown"]
    },
    "downgrade_behavior": {
      "type": "string",
      "enum": ["narrow_below_cutline", "reject"]
    },
    "resolution_surface": {
      "type": "string",
      "enum": ["export_import", "support_export", "docs_help", "cli_inspect"]
    },
    "schema_id_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://aureline\\.dev/schemas/public/m5-json/[A-Za-z0-9_]+\\.schema\\.json$"
    },
    "field_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additive_field_rule",
        "required_field_policy",
        "unknown_field_policy",
        "downgrade_behavior",
        "migration_note_hooks"
      ],
      "properties": {
        "additive_field_rule": { "$ref": "#/$defs/additive_field_rule" },
        "required_field_policy": { "$ref": "#/$defs/required_field_policy" },
        "unknown_field_policy": { "$ref": "#/$defs/unknown_field_policy" },
        "downgrade_behavior": { "$ref": "#/$defs/downgrade_behavior" },
        "migration_note_hooks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "family_id",
        "registry_family_id",
        "title",
        "summary",
        "contract_form",
        "maturity_lane",
        "lifecycle_label",
        "schema_id",
        "schema_path",
        "record_kind_field",
        "primary_version_field",
        "version_field_names",
        "primary_identifier_field",
        "field_contract",
        "compatibility_note",
        "compatibility_note_ref",
        "example_payload_ref",
        "roundtrip_fixture_ref",
        "matrix_row_ref",
        "contract_family_ref",
        "validator_suite_refs",
        "resolution_surfaces"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^m5\\.[a-z0-9_]+$"
        },
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "registry_family_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "contract_form": { "$ref": "#/$defs/contract_form" },
        "maturity_lane": { "$ref": "#/$defs/maturity_lane" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "schema_id": { "$ref": "#/$defs/schema_id_uri" },
        "schema_path": { "$ref": "#/$defs/path_ref" },
        "record_kind_field": { "$ref": "#/$defs/non_empty_string" },
        "primary_version_field": { "$ref": "#/$defs/non_empty_string" },
        "version_field_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "primary_identifier_field": { "$ref": "#/$defs/non_empty_string" },
        "field_contract": { "$ref": "#/$defs/field_contract" },
        "compatibility_note": { "$ref": "#/$defs/non_empty_string" },
        "compatibility_note_ref": { "$ref": "#/$defs/path_ref" },
        "example_payload_ref": { "$ref": "#/$defs/path_ref" },
        "roundtrip_fixture_ref": { "$ref": "#/$defs/path_ref" },
        "matrix_row_ref": { "$ref": "#/$defs/path_ref" },
        "contract_family_ref": { "$ref": "#/$defs/path_ref" },
        "validator_suite_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "resolution_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resolution_surface" }
        }
      }
    },
    "offline_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirrorable", "requires_runtime_service", "bundle_members", "note"],
      "properties": {
        "mirrorable": { "type": "boolean" },
        "requires_runtime_service": { "type": "boolean" },
        "bundle_members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_packages",
        "stable_label_packages",
        "beta_label_packages",
        "preserve_unknown_packages",
        "packages_with_migration_hooks",
        "packages_with_roundtrip_fixture",
        "schema_files",
        "example_payloads",
        "roundtrip_fixtures"
      ],
      "properties": {
        "total_packages": { "type": "integer", "minimum": 0 },
        "stable_label_packages": { "type": "integer", "minimum": 0 },
        "beta_label_packages": { "type": "integer", "minimum": 0 },
        "preserve_unknown_packages": { "type": "integer", "minimum": 0 },
        "packages_with_migration_hooks": { "type": "integer", "minimum": 0 },
        "packages_with_roundtrip_fixture": { "type": "integer", "minimum": 0 },
        "schema_files": { "type": "integer", "minimum": 0 },
        "example_payloads": { "type": "integer", "minimum": 0 },
        "roundtrip_fixtures": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
