{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_contract_health.schema.json",
  "title": "Aureline M5 contract-health register",
  "description": "Boundary schema for the canonical M5 contract-health register (artifacts/release/m5-contract-health.json). The register is the enforcement layer that ties every published M5 contract family the publication matrix tracks to the CI gates guarding its contract packages, the exact release artifact graph and build identity the candidate ships, and the shiproom blocker decision those signals produce. Each row's lifecycle_label equals the publication matrix's published label after narrowing, and a release-blocking family with a failing required contract gate sets the register's promotion decision to hold. It is metadata-plus-state only: every field is a typed state, an opaque repo-relative ref or URI, or a copy/export-safe summary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "as_of",
    "overview_page",
    "evidence_page",
    "help_page",
    "shiproom_dashboard_page",
    "gate_manifest_ref",
    "contract_catalog_ref",
    "publication_matrix_ref",
    "evidence_index_ref",
    "build_identity",
    "lifecycle_labels",
    "gate_kinds",
    "gate_outcomes",
    "freshness_states",
    "health_states",
    "blocker_decisions",
    "mirror_parity_states",
    "gap_reasons",
    "remediation_actions",
    "launch_cutline",
    "gate_catalog",
    "rows",
    "blockers",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_contract_health_register" },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "evidence_page": { "$ref": "#/$defs/path_ref" },
    "help_page": { "$ref": "#/$defs/path_ref" },
    "shiproom_dashboard_page": { "$ref": "#/$defs/path_ref" },
    "gate_manifest_ref": { "$ref": "#/$defs/path_ref" },
    "contract_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "publication_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "lifecycle_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "gate_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate_kind" }
    },
    "gate_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate_outcome" }
    },
    "freshness_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/freshness_state" }
    },
    "health_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/health_state" }
    },
    "blocker_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker_decision" }
    },
    "mirror_parity_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/mirror_parity_state" }
    },
    "gap_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "remediation_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "gate_catalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate_descriptor" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "blockers": { "$ref": "#/$defs/blockers" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._.-]+)?$"
    },
    "ref_or_uri": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "gate_kind": {
      "type": "string",
      "enum": [
        "schema_spec_package",
        "example_corpus",
        "validator_coverage",
        "compatibility_report",
        "release_packet_linkage"
      ]
    },
    "gate_outcome": {
      "type": "string",
      "enum": ["pass", "downgrade", "fail"]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "due_for_refresh", "breached", "missing"]
    },
    "health_state": {
      "type": "string",
      "enum": ["healthy", "narrowed", "blocked"]
    },
    "blocker_decision": {
      "type": "string",
      "enum": ["clear", "hold"]
    },
    "mirror_parity_state": {
      "type": "string",
      "enum": ["current", "stale", "unpublished", "not_applicable"]
    },
    "package_kind": {
      "type": "string",
      "enum": ["json_schema", "openapi_spec", "wit_world"]
    },
    "identity_kind": {
      "type": "string",
      "enum": ["json_schema", "openapi_spec", "wit_world"]
    },
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_identity_ref",
        "release_candidate_ref",
        "artifact_graph_ref",
        "toolchain_channel",
        "note"
      ],
      "properties": {
        "build_identity_ref": { "$ref": "#/$defs/path_ref" },
        "release_candidate_ref": { "$ref": "#/$defs/non_empty_string" },
        "artifact_graph_ref": { "$ref": "#/$defs/non_empty_string" },
        "toolchain_channel": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "gate_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_kind",
        "title",
        "description",
        "guards_artifact_kinds",
        "gap_reasons",
        "remediation_actions",
        "fail_outcome",
        "blocks_when_release_blocking",
        "descriptor_ref"
      ],
      "properties": {
        "gate_id": { "$ref": "#/$defs/non_empty_string" },
        "gate_kind": { "$ref": "#/$defs/gate_kind" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "description": { "$ref": "#/$defs/non_empty_string" },
        "guards_artifact_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "gap_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "remediation_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "fail_outcome": { "$ref": "#/$defs/gate_outcome" },
        "blocks_when_release_blocking": { "type": "boolean" },
        "descriptor_ref": { "$ref": "#/$defs/path_ref" }
      }
    },
    "package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_kind",
        "schema_or_spec_id",
        "schema_or_spec_ref",
        "package_kind",
        "package_version",
        "in_band_version_field"
      ],
      "properties": {
        "identity_kind": { "$ref": "#/$defs/identity_kind" },
        "schema_or_spec_id": { "$ref": "#/$defs/ref_or_uri" },
        "schema_or_spec_ref": { "$ref": "#/$defs/path_ref" },
        "package_kind": { "$ref": "#/$defs/package_kind" },
        "package_version": { "type": "integer", "minimum": 1 },
        "in_band_version_field": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "graph_linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_candidate_ref",
        "release_packet_ref",
        "build_identity_ref",
        "artifact_graph_node_ref",
        "mirror_parity",
        "offline_verifiable"
      ],
      "properties": {
        "release_candidate_ref": { "$ref": "#/$defs/non_empty_string" },
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "build_identity_ref": { "$ref": "#/$defs/path_ref" },
        "artifact_graph_node_ref": { "$ref": "#/$defs/non_empty_string" },
        "mirror_parity": { "$ref": "#/$defs/mirror_parity_state" },
        "offline_verifiable": { "type": "boolean" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_kind",
        "required",
        "freshness",
        "outcome",
        "evidence_refs",
        "detail"
      ],
      "properties": {
        "gate_id": { "$ref": "#/$defs/non_empty_string" },
        "gate_kind": { "$ref": "#/$defs/gate_kind" },
        "required": { "type": "boolean" },
        "freshness": { "$ref": "#/$defs/freshness_state" },
        "outcome": { "$ref": "#/$defs/gate_outcome" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blocking_gate_ids",
        "retest_needed",
        "stale_reasons",
        "summary"
      ],
      "properties": {
        "decision": { "$ref": "#/$defs/blocker_decision" },
        "blocking_gate_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "retest_needed": { "type": "boolean" },
        "stale_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "title",
        "contract_form",
        "owning_package",
        "claim_label",
        "published_label",
        "lifecycle_label",
        "narrowed",
        "release_blocking",
        "package_identity",
        "graph_linkage",
        "gates",
        "active_gap_reasons",
        "remediation_actions",
        "health_state",
        "catalog_entry_ref",
        "matrix_row_ref",
        "blocker"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "contract_form": { "$ref": "#/$defs/non_empty_string" },
        "owning_package": { "$ref": "#/$defs/non_empty_string" },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "narrowed": { "type": "boolean" },
        "release_blocking": { "type": "boolean" },
        "package_identity": { "$ref": "#/$defs/package_identity" },
        "graph_linkage": { "$ref": "#/$defs/graph_linkage" },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gate" }
        },
        "active_gap_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "remediation_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "health_state": { "$ref": "#/$defs/health_state" },
        "catalog_entry_ref": { "$ref": "#/$defs/path_ref" },
        "matrix_row_ref": { "$ref": "#/$defs/path_ref" },
        "blocker": { "$ref": "#/$defs/blocker" }
      }
    },
    "blockers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blocking_family_ids",
        "blocking_gate_kinds",
        "retest_needed_family_ids",
        "rationale"
      ],
      "properties": {
        "decision": { "$ref": "#/$defs/blocker_decision" },
        "blocking_family_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "blocking_gate_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate_kind" }
        },
        "retest_needed_family_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_families",
        "release_blocking_families",
        "healthy_families",
        "narrowed_families",
        "blocked_families",
        "families_held",
        "families_retest_needed",
        "mirror_publishable_families",
        "total_gates_evaluated",
        "gates_passing",
        "gates_downgrading",
        "gates_failing"
      ],
      "properties": {
        "total_families": { "type": "integer", "minimum": 0 },
        "release_blocking_families": { "type": "integer", "minimum": 0 },
        "healthy_families": { "type": "integer", "minimum": 0 },
        "narrowed_families": { "type": "integer", "minimum": 0 },
        "blocked_families": { "type": "integer", "minimum": 0 },
        "families_held": { "type": "integer", "minimum": 0 },
        "families_retest_needed": { "type": "integer", "minimum": 0 },
        "mirror_publishable_families": { "type": "integer", "minimum": 0 },
        "total_gates_evaluated": { "type": "integer", "minimum": 0 },
        "gates_passing": { "type": "integer", "minimum": 0 },
        "gates_downgrading": { "type": "integer", "minimum": 0 },
        "gates_failing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
