{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_reader_writer_compat_suite.schema.json",
  "title": "Aureline M5 reader/writer compatibility suite",
  "description": "Boundary schema for the canonical M5 reader/writer compatibility suite (artifacts/contracts/m5-reader-writer-compat-suite.json) and its negative fixtures (fixtures/contracts/m5-compat-suite/). For every durable M5 artifact family the JSON Schema catalog publishes, the suite carries checked-in prior/current/unsupported fixtures and a migration-diff report proving forward-read, back-read, round-trip, migration-diff, unknown-field preservation, additive-field tolerance, downgrade narrowing, and the compare-only fallback. The suite reuses the JSON Schema catalog's family list and the publication matrix's reader/writer posture rather than minting a new family set or posture lexicon. It is metadata-only: every field is a typed state or an opaque repo-relative ref or URI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "suite_id",
    "status",
    "as_of",
    "overview_page",
    "evidence_page",
    "sdk_catalog_page",
    "json_schema_catalog_ref",
    "publication_matrix_ref",
    "contract_family_registry_ref",
    "evidence_index_ref",
    "fixture_home",
    "migration_diff_report_home",
    "operator_report_ref",
    "case_kinds",
    "expected_outcomes",
    "reader_writer_postures",
    "write_back_postures",
    "change_classes",
    "downgrade_behaviors",
    "resolution_surfaces",
    "offline_bundle",
    "suites",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_reader_writer_compat_suite" },
    "suite_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "evidence_page": { "$ref": "#/$defs/path_ref" },
    "sdk_catalog_page": { "$ref": "#/$defs/path_ref" },
    "json_schema_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "publication_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "contract_family_registry_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "fixture_home": { "$ref": "#/$defs/path_ref" },
    "migration_diff_report_home": { "$ref": "#/$defs/path_ref" },
    "operator_report_ref": { "$ref": "#/$defs/path_ref" },
    "case_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/case_kind" }
    },
    "expected_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/expected_outcome" }
    },
    "reader_writer_postures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reader_writer_posture" }
    },
    "write_back_postures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/write_back_posture" }
    },
    "change_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/change_class" }
    },
    "downgrade_behaviors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/downgrade_behavior" }
    },
    "resolution_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resolution_surface" }
    },
    "offline_bundle": { "$ref": "#/$defs/offline_bundle" },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/suite" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$"
    },
    "schema_id_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://aureline\\.dev/schemas/public/m5-json/[A-Za-z0-9_]+\\.schema\\.json$"
    },
    "case_kind": {
      "type": "string",
      "enum": [
        "forward_read",
        "back_read",
        "round_trip",
        "migration_diff",
        "unknown_field_preservation",
        "additive_field",
        "downgrade",
        "compare_only"
      ]
    },
    "expected_outcome": {
      "type": "string",
      "enum": ["compatible", "compatible_compare_only", "narrowed", "rejected"]
    },
    "reader_writer_posture": {
      "type": "string",
      "enum": ["reader_only", "writer_only", "read_write", "bidirectional_interchange"]
    },
    "write_back_posture": {
      "type": "string",
      "enum": ["compare_only", "backup_then_write"]
    },
    "change_class": {
      "type": "string",
      "enum": ["unchanged", "additive", "behavioral", "breaking"]
    },
    "downgrade_behavior": {
      "type": "string",
      "enum": ["narrow_below_cutline", "reject"]
    },
    "contract_form": {
      "type": "string",
      "enum": [
        "json_schema_backed_contract_doc",
        "record_registry",
        "event_envelope_schema",
        "cli_structured_output",
        "asset_package_manifest",
        "teaching_content_pack",
        "openapi_family"
      ]
    },
    "maturity_lane": {
      "type": "string",
      "enum": ["stable", "beta", "experimental", "internal"]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "resolution_surface": {
      "type": "string",
      "enum": ["export_import", "support_export", "docs_help", "cli_inspect"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_kind",
        "reader_version",
        "writer_version",
        "input_fixture_ref",
        "expected_outcome",
        "preserves_unknown_fields",
        "writes_back",
        "backup_first",
        "note"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/non_empty_string" },
        "case_kind": { "$ref": "#/$defs/case_kind" },
        "reader_version": { "type": "integer", "minimum": 1 },
        "writer_version": { "type": "integer", "minimum": 1 },
        "input_fixture_ref": { "$ref": "#/$defs/path_ref" },
        "expected_outcome": { "$ref": "#/$defs/expected_outcome" },
        "preserves_unknown_fields": { "type": "boolean" },
        "writes_back": { "type": "boolean" },
        "backup_first": { "type": "boolean" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "migration_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_version",
        "to_version",
        "change_class",
        "compatible",
        "added_fields",
        "removed_fields",
        "changed_fields",
        "report_ref"
      ],
      "properties": {
        "from_version": { "type": "integer", "minimum": 1 },
        "to_version": { "type": "integer", "minimum": 1 },
        "change_class": { "$ref": "#/$defs/change_class" },
        "compatible": { "type": "boolean" },
        "added_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "removed_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "changed_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "report_ref": { "$ref": "#/$defs/path_ref" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "package_id",
        "registry_family_id",
        "title",
        "summary",
        "contract_form",
        "maturity_lane",
        "lifecycle_label",
        "published_label",
        "reader_writer_posture",
        "write_back_posture",
        "downgrade_behavior",
        "record_kind_value",
        "primary_version_field",
        "version_field_names",
        "primary_identifier_field",
        "prior_version",
        "current_version",
        "unsupported_version",
        "added_field",
        "fixture_dir",
        "prior_fixture_ref",
        "current_fixture_ref",
        "unsupported_fixture_ref",
        "migration_diff",
        "schema_id",
        "schema_path",
        "catalog_package_ref",
        "matrix_row_ref",
        "contract_family_ref",
        "compatibility_note_ref",
        "validator_suite_refs",
        "resolution_surfaces",
        "cases"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "package_id": { "type": "string", "pattern": "^m5\\.[a-z0-9_]+$" },
        "registry_family_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "contract_form": { "$ref": "#/$defs/contract_form" },
        "maturity_lane": { "$ref": "#/$defs/maturity_lane" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "reader_writer_posture": { "$ref": "#/$defs/reader_writer_posture" },
        "write_back_posture": { "$ref": "#/$defs/write_back_posture" },
        "downgrade_behavior": { "$ref": "#/$defs/downgrade_behavior" },
        "record_kind_value": { "$ref": "#/$defs/non_empty_string" },
        "primary_version_field": { "$ref": "#/$defs/non_empty_string" },
        "version_field_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "primary_identifier_field": { "$ref": "#/$defs/non_empty_string" },
        "prior_version": { "type": "integer", "minimum": 1 },
        "current_version": { "type": "integer", "minimum": 1 },
        "unsupported_version": { "type": "integer", "minimum": 1 },
        "added_field": { "$ref": "#/$defs/non_empty_string" },
        "fixture_dir": { "$ref": "#/$defs/path_ref" },
        "prior_fixture_ref": { "$ref": "#/$defs/path_ref" },
        "current_fixture_ref": { "$ref": "#/$defs/path_ref" },
        "unsupported_fixture_ref": { "$ref": "#/$defs/path_ref" },
        "migration_diff": { "$ref": "#/$defs/migration_diff" },
        "schema_id": { "$ref": "#/$defs/schema_id_uri" },
        "schema_path": { "$ref": "#/$defs/path_ref" },
        "catalog_package_ref": { "$ref": "#/$defs/path_ref" },
        "matrix_row_ref": { "$ref": "#/$defs/path_ref" },
        "contract_family_ref": { "$ref": "#/$defs/path_ref" },
        "compatibility_note_ref": { "$ref": "#/$defs/path_ref" },
        "validator_suite_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "resolution_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resolution_surface" }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case" }
        }
      }
    },
    "offline_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirrorable", "requires_runtime_service", "bundle_members", "note"],
      "properties": {
        "mirrorable": { "type": "boolean" },
        "requires_runtime_service": { "type": "boolean" },
        "bundle_members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_suites",
        "write_back_suites",
        "compare_only_suites",
        "total_cases",
        "forward_read_cases",
        "back_read_cases",
        "round_trip_cases",
        "migration_diff_cases",
        "unknown_field_cases",
        "additive_field_cases",
        "downgrade_cases",
        "compare_only_cases",
        "narrowing_cases",
        "migration_diff_reports",
        "families_with_additive_change",
        "suites_preserving_unknown",
        "fixtures_total"
      ],
      "properties": {
        "total_suites": { "type": "integer", "minimum": 0 },
        "write_back_suites": { "type": "integer", "minimum": 0 },
        "compare_only_suites": { "type": "integer", "minimum": 0 },
        "total_cases": { "type": "integer", "minimum": 0 },
        "forward_read_cases": { "type": "integer", "minimum": 0 },
        "back_read_cases": { "type": "integer", "minimum": 0 },
        "round_trip_cases": { "type": "integer", "minimum": 0 },
        "migration_diff_cases": { "type": "integer", "minimum": 0 },
        "unknown_field_cases": { "type": "integer", "minimum": 0 },
        "additive_field_cases": { "type": "integer", "minimum": 0 },
        "downgrade_cases": { "type": "integer", "minimum": 0 },
        "compare_only_cases": { "type": "integer", "minimum": 0 },
        "narrowing_cases": { "type": "integer", "minimum": 0 },
        "migration_diff_reports": { "type": "integer", "minimum": 0 },
        "families_with_additive_change": { "type": "integer", "minimum": 0 },
        "suites_preserving_unknown": { "type": "integer", "minimum": 0 },
        "fixtures_total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
