{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_public_contract_matrix.schema.json",
  "title": "Aureline M5 public-contract publication matrix",
  "description": "Boundary schema for the canonical M5 public-contract publication matrix (artifacts/contracts/m5-stability-lifecycle-map.json) and its negative fixtures (fixtures/contracts/m5/). The matrix inventories every M5 artifact family the source docs treat as a published contract, classifies each by contract form, stability/maturity lane, reader/writer posture, and packaging need, and freezes which contract forms (JSON Schema, WIT, OpenAPI, Markdown summary, example payloads, migration notes), validator suite, and release-packet linkage each family MUST publish before it can hold a Stable contract claim. A family missing any required publication evidence narrows below the cutline. The matrix reuses the existing contract-family registry, compatibility-surface inventory, qualification matrix, and stability/lifecycle vocabulary rather than minting a new contract-status lexicon. It is metadata-only: every field is a typed state or an opaque repo-relative ref.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "matrix_id",
    "status",
    "overview_page",
    "as_of",
    "claim_manifest_ref",
    "contract_family_registry_ref",
    "compatibility_surface_inventory_ref",
    "qualification_matrix_ref",
    "evidence_index_ref",
    "contract_forms",
    "contract_categories",
    "maturity_lanes",
    "lifecycle_labels",
    "reader_writer_postures",
    "packaging_needs",
    "publication_artifact_kinds",
    "publication_states",
    "gap_reasons",
    "remediation_actions",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "rows",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_public_contract_matrix" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "claim_manifest_ref": { "$ref": "#/$defs/path_ref" },
    "contract_family_registry_ref": { "$ref": "#/$defs/path_ref" },
    "compatibility_surface_inventory_ref": { "$ref": "#/$defs/path_ref" },
    "qualification_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "contract_forms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract_form" },
      "uniqueItems": true
    },
    "contract_categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract_category" },
      "uniqueItems": true
    },
    "maturity_lanes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/maturity_lane" },
      "uniqueItems": true
    },
    "lifecycle_labels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lifecycle_label" },
      "uniqueItems": true
    },
    "reader_writer_postures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reader_writer_posture" },
      "uniqueItems": true
    },
    "packaging_needs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packaging_need" },
      "uniqueItems": true
    },
    "publication_artifact_kinds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/publication_artifact_kind" },
      "uniqueItems": true
    },
    "publication_states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/publication_state" },
      "uniqueItems": true
    },
    "gap_reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gap_reason" },
      "uniqueItems": true
    },
    "remediation_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/remediation_action" },
      "uniqueItems": true
    },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/stable_token" },
      "uniqueItems": true
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop_rule" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative path or anchored reference. Consumers treat it as opaque text."
    },
    "stable_token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable lower_snake identifier."
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "maturity_lane": {
      "type": "string",
      "enum": ["stable", "beta", "experimental", "internal"]
    },
    "contract_form": {
      "type": "string",
      "enum": [
        "json_schema_backed_contract_doc",
        "json_schema_registry",
        "record_registry",
        "event_envelope_schema",
        "wit_world_package",
        "openapi_family",
        "field_set",
        "cli_structured_output",
        "textual_interchange_contract",
        "asset_package_manifest",
        "teaching_content_pack"
      ]
    },
    "contract_category": {
      "type": "string",
      "enum": [
        "settings_and_profile",
        "workspace_and_state",
        "extensions_and_host",
        "command_and_automation",
        "ai_and_language",
        "editor_and_text",
        "terminal_and_run",
        "debug_and_diagnostics",
        "merge_and_history",
        "portability_and_migration",
        "locale_and_translation",
        "design_and_theme",
        "accessibility_and_input",
        "voice_and_consent",
        "service_and_api",
        "review_and_hosted",
        "release_and_build",
        "support_and_export",
        "governance_and_policy",
        "docs_and_teaching",
        "notification_and_attention",
        "certification_and_reference"
      ]
    },
    "reader_writer_posture": {
      "type": "string",
      "enum": ["reader_only", "writer_only", "read_write", "bidirectional_interchange"]
    },
    "packaging_need": {
      "type": "string",
      "enum": ["local_only", "mirrored", "managed", "browser_handoff"]
    },
    "publication_artifact_kind": {
      "type": "string",
      "enum": [
        "json_schema",
        "wit_world",
        "openapi_spec",
        "markdown_summary",
        "example_payloads",
        "migration_notes",
        "validator_suite"
      ]
    },
    "publication_state": {
      "type": "string",
      "enum": ["published", "partial", "missing", "not_applicable"]
    },
    "gap_reason": {
      "type": "string",
      "enum": [
        "json_schema_unpublished",
        "wit_world_unpublished",
        "openapi_spec_unpublished",
        "markdown_summary_unpublished",
        "example_payloads_unpublished",
        "migration_notes_unpublished",
        "validator_suite_unpublished",
        "release_packet_unlinked"
      ]
    },
    "remediation_action": {
      "type": "string",
      "enum": [
        "hold_promotion",
        "narrow_label",
        "publish_contract_form",
        "publish_example_payloads",
        "wire_validator_suite",
        "link_release_packet"
      ]
    },
    "row_state": {
      "type": "string",
      "enum": ["published", "narrowed"]
    },
    "publication_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "required", "state", "refs"],
      "properties": {
        "artifact_kind": { "$ref": "#/$defs/publication_artifact_kind" },
        "required": { "type": "boolean" },
        "state": { "$ref": "#/$defs/publication_state" },
        "refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/path_ref" }
        }
      }
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/gap_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/remediation_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "title",
        "summary",
        "owning_package",
        "owner_dri",
        "category",
        "contract_form",
        "maturity_lane",
        "reader_writer_posture",
        "packaging_need",
        "claim_label",
        "published_label",
        "row_state",
        "release_blocking",
        "contract_family_ref",
        "compatibility_surface_ref",
        "qualification_row_ref",
        "release_packet_ref",
        "example_corpus_refs",
        "validator_suite_refs",
        "publication_requirements",
        "active_gap_reasons",
        "publication_destinations",
        "rationale"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/stable_token" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "owning_package": { "$ref": "#/$defs/non_empty_string" },
        "owner_dri": { "type": "string", "minLength": 2 },
        "category": { "$ref": "#/$defs/contract_category" },
        "contract_form": { "$ref": "#/$defs/contract_form" },
        "maturity_lane": { "$ref": "#/$defs/maturity_lane" },
        "reader_writer_posture": { "$ref": "#/$defs/reader_writer_posture" },
        "packaging_need": { "$ref": "#/$defs/packaging_need" },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "published_label": { "$ref": "#/$defs/lifecycle_label" },
        "row_state": { "$ref": "#/$defs/row_state" },
        "release_blocking": { "type": "boolean" },
        "contract_family_ref": { "$ref": "#/$defs/path_ref" },
        "compatibility_surface_ref": { "$ref": "#/$defs/path_ref" },
        "qualification_row_ref": {
          "type": ["string", "null"],
          "description": "compat_row reference into the qualification matrix, or null."
        },
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "example_corpus_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "validator_suite_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "publication_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publication_requirement" }
        },
        "active_gap_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap_reason" },
          "uniqueItems": true
        },
        "publication_destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_gate",
        "decision",
        "blocking_rule_ids",
        "blocking_claim_ids",
        "rationale"
      ],
      "properties": {
        "promotion_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "blocking_claim_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "total_families",
        "rows_published",
        "rows_narrowed",
        "release_blocking_total",
        "release_blocking_published",
        "release_blocking_narrowed",
        "stable_lane_rows",
        "beta_lane_rows",
        "experimental_lane_rows",
        "internal_lane_rows",
        "rows_requiring_json_schema",
        "rows_requiring_wit_world",
        "rows_requiring_openapi_spec",
        "rows_requiring_markdown_summary",
        "rows_requiring_example_payloads",
        "rows_requiring_migration_notes",
        "rows_requiring_validator_suite",
        "total_required_publications",
        "total_published_publications",
        "total_active_gap_reasons",
        "rows_with_active_gap",
        "rules_firing"
      ],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "total_families": { "type": "integer", "minimum": 0 },
        "rows_published": { "type": "integer", "minimum": 0 },
        "rows_narrowed": { "type": "integer", "minimum": 0 },
        "release_blocking_total": { "type": "integer", "minimum": 0 },
        "release_blocking_published": { "type": "integer", "minimum": 0 },
        "release_blocking_narrowed": { "type": "integer", "minimum": 0 },
        "stable_lane_rows": { "type": "integer", "minimum": 0 },
        "beta_lane_rows": { "type": "integer", "minimum": 0 },
        "experimental_lane_rows": { "type": "integer", "minimum": 0 },
        "internal_lane_rows": { "type": "integer", "minimum": 0 },
        "rows_requiring_json_schema": { "type": "integer", "minimum": 0 },
        "rows_requiring_wit_world": { "type": "integer", "minimum": 0 },
        "rows_requiring_openapi_spec": { "type": "integer", "minimum": 0 },
        "rows_requiring_markdown_summary": { "type": "integer", "minimum": 0 },
        "rows_requiring_example_payloads": { "type": "integer", "minimum": 0 },
        "rows_requiring_migration_notes": { "type": "integer", "minimum": 0 },
        "rows_requiring_validator_suite": { "type": "integer", "minimum": 0 },
        "total_required_publications": { "type": "integer", "minimum": 0 },
        "total_published_publications": { "type": "integer", "minimum": 0 },
        "total_active_gap_reasons": { "type": "integer", "minimum": 0 },
        "rows_with_active_gap": { "type": "integer", "minimum": 0 },
        "rules_firing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
