{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_openapi_catalog.schema.json",
  "title": "Aureline M5 OpenAPI publication catalog",
  "description": "Boundary schema for the canonical M5 OpenAPI publication catalog (artifacts/contracts/m5-openapi-catalog.json). The catalog turns the optional managed-service OpenAPI document (openapi/service_api_seed.yaml) into a published contract family: every service-API operation the product or SDK exposes is bound to a lifecycle label, an auth-source class, an entitlement and policy-override posture, a mutability posture, a preview/dry-run support class, an offline/cache behaviour, a deprecation lane and sunset posture, a compatibility note, and a checked-in example request/response pack. The auth-source, entitlement, policy-override, offline, deprecation, and sunset vocabularies are drawn verbatim from artifacts/service/api_surface_rows.yaml. It is metadata-only: every field is a typed state or an opaque repo-relative ref; it carries no raw request/response bytes, credential material, signatures, or live service URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "catalog_id",
    "status",
    "as_of",
    "overview_page",
    "sdk_doc_page",
    "openapi_readme_ref",
    "json_schema_catalog_ref",
    "publication_matrix_ref",
    "api_surface_rows_ref",
    "slo_rows_ref",
    "evidence_index_ref",
    "family_id",
    "family_lifecycle_label",
    "primary_openapi_document_ref",
    "example_pack_home",
    "http_methods",
    "auth_source_classes",
    "entitlement_classes",
    "policy_override_postures",
    "mutability_postures",
    "preview_support_classes",
    "offline_behavior_classes",
    "deprecation_lane_classes",
    "sunset_postures",
    "lifecycle_labels",
    "maturity_lanes",
    "downgrade_behaviors",
    "offline_bundle",
    "endpoints",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_openapi_catalog" },
    "catalog_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "sdk_doc_page": { "$ref": "#/$defs/path_ref" },
    "openapi_readme_ref": { "$ref": "#/$defs/path_ref" },
    "json_schema_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "publication_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "api_surface_rows_ref": { "$ref": "#/$defs/path_ref" },
    "slo_rows_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "family_id": { "$ref": "#/$defs/non_empty_string" },
    "family_lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
    "primary_openapi_document_ref": { "$ref": "#/$defs/path_ref" },
    "example_pack_home": { "$ref": "#/$defs/path_ref" },
    "http_methods": { "$ref": "#/$defs/http_method_list" },
    "auth_source_classes": { "$ref": "#/$defs/auth_source_class_list" },
    "entitlement_classes": { "$ref": "#/$defs/entitlement_class_list" },
    "policy_override_postures": { "$ref": "#/$defs/policy_override_posture_list" },
    "mutability_postures": { "$ref": "#/$defs/mutability_posture_list" },
    "preview_support_classes": { "$ref": "#/$defs/preview_support_class_list" },
    "offline_behavior_classes": { "$ref": "#/$defs/offline_behavior_class_list" },
    "deprecation_lane_classes": { "$ref": "#/$defs/deprecation_lane_class_list" },
    "sunset_postures": { "$ref": "#/$defs/sunset_posture_list" },
    "lifecycle_labels": { "$ref": "#/$defs/lifecycle_label_list" },
    "maturity_lanes": { "$ref": "#/$defs/maturity_lane_list" },
    "downgrade_behaviors": { "$ref": "#/$defs/downgrade_behavior_list" },
    "offline_bundle": { "$ref": "#/$defs/offline_bundle" },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$"
    },
    "component_schema_ref": {
      "type": "string",
      "pattern": "^openapi/service_api_seed\\.yaml#/components/schemas/[A-Za-z0-9]+$"
    },
    "stable_dot_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "http_path": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9_/.-]*$"
    },
    "success_status": {
      "type": "string",
      "pattern": "^[1-5][0-9][0-9]$"
    },
    "http_method": { "type": "string", "enum": ["get", "put", "post"] },
    "auth_source_class": {
      "type": "string",
      "enum": [
        "open_no_auth",
        "bearer_token_short_lived",
        "oidc_session_token",
        "mtls_client_cert",
        "oidc_plus_mtls_dual_factor",
        "scim_bearer_token",
        "customer_byok_passthrough_no_broker_auth",
        "signed_mirror_snapshot_only_no_live_auth",
        "destruction_receipt_ledger_signed_append_only"
      ]
    },
    "entitlement_class": {
      "type": "string",
      "enum": [
        "no_entitlement_required",
        "account_required",
        "organization_entitlement",
        "support_case_entitlement",
        "admin_scope_entitlement",
        "destruction_receipt_scope"
      ]
    },
    "policy_override_posture": {
      "type": "string",
      "enum": [
        "narrow_only_no_widen",
        "narrow_only_with_emergency_disable",
        "policy_immutable_no_override"
      ]
    },
    "mutability_posture": {
      "type": "string",
      "enum": [
        "read_only",
        "mutating_create",
        "mutating_replace",
        "mutating_append_only",
        "mutating_action_no_durable_resource"
      ]
    },
    "preview_support_class": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "dry_run_and_preview_supported",
        "action_atomic_no_preview"
      ]
    },
    "offline_behavior_class": {
      "type": "string",
      "enum": [
        "no_network_required_local_only",
        "last_known_good_local_cache_resolves",
        "bundled_mirror_snapshot_resolves",
        "queued_for_replay_on_recovery",
        "read_only_when_reachable_and_narrows_on_unreachable"
      ]
    },
    "deprecation_lane_class": {
      "type": "string",
      "enum": [
        "pre_release_no_deprecation_yet",
        "additive_only_no_removal_window",
        "standard_overlap_with_sunset_header",
        "emergency_sunset_with_explicit_advisory"
      ]
    },
    "sunset_posture": {
      "type": "string",
      "enum": [
        "no_sunset_yet",
        "named_overlap_window_then_remove",
        "named_overlap_window_then_mirror_only",
        "immediate_sunset_on_advisory"
      ]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "maturity_lane": {
      "type": "string",
      "enum": ["stable", "beta", "experimental", "internal"]
    },
    "downgrade_behavior": {
      "type": "string",
      "enum": ["narrow_below_cutline", "reject"]
    },
    "http_method_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/http_method" }
    },
    "auth_source_class_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/auth_source_class" }
    },
    "entitlement_class_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/entitlement_class" }
    },
    "policy_override_posture_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/policy_override_posture" }
    },
    "mutability_posture_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/mutability_posture" }
    },
    "preview_support_class_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/preview_support_class" }
    },
    "offline_behavior_class_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/offline_behavior_class" }
    },
    "deprecation_lane_class_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/deprecation_lane_class" }
    },
    "sunset_posture_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/sunset_posture" }
    },
    "lifecycle_label_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "maturity_lane_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/maturity_lane" }
    },
    "downgrade_behavior_list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/downgrade_behavior" }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_id",
        "title",
        "summary",
        "api_surface_id",
        "service_tag",
        "api_family_class",
        "openapi_document_ref",
        "http_method",
        "path",
        "operation_id",
        "success_status",
        "auth_source_class",
        "entitlement_class",
        "policy_override_posture",
        "mutability_posture",
        "preview_support_class",
        "offline_behavior_class",
        "deprecation_lane_class",
        "sunset_posture",
        "maturity_lane",
        "lifecycle_label",
        "request_schema_ref",
        "response_schema_ref",
        "example_pack_ref",
        "compatibility_note",
        "compatibility_note_ref",
        "downgrade_behavior",
        "matrix_row_ref",
        "surface_row_ref",
        "validator_suite_refs"
      ],
      "properties": {
        "endpoint_id": { "$ref": "#/$defs/operation_id" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "api_surface_id": { "$ref": "#/$defs/stable_dot_id" },
        "service_tag": { "$ref": "#/$defs/operation_id" },
        "api_family_class": { "$ref": "#/$defs/operation_id" },
        "openapi_document_ref": { "$ref": "#/$defs/path_ref" },
        "http_method": { "$ref": "#/$defs/http_method" },
        "path": { "$ref": "#/$defs/http_path" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "success_status": { "$ref": "#/$defs/success_status" },
        "auth_source_class": { "$ref": "#/$defs/auth_source_class" },
        "entitlement_class": { "$ref": "#/$defs/entitlement_class" },
        "policy_override_posture": { "$ref": "#/$defs/policy_override_posture" },
        "mutability_posture": { "$ref": "#/$defs/mutability_posture" },
        "preview_support_class": { "$ref": "#/$defs/preview_support_class" },
        "offline_behavior_class": { "$ref": "#/$defs/offline_behavior_class" },
        "deprecation_lane_class": { "$ref": "#/$defs/deprecation_lane_class" },
        "sunset_posture": { "$ref": "#/$defs/sunset_posture" },
        "maturity_lane": { "$ref": "#/$defs/maturity_lane" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "request_schema_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/component_schema_ref" }]
        },
        "response_schema_ref": { "$ref": "#/$defs/component_schema_ref" },
        "example_pack_ref": { "$ref": "#/$defs/path_ref" },
        "compatibility_note": { "$ref": "#/$defs/non_empty_string" },
        "compatibility_note_ref": { "$ref": "#/$defs/path_ref" },
        "downgrade_behavior": { "$ref": "#/$defs/downgrade_behavior" },
        "matrix_row_ref": { "$ref": "#/$defs/path_ref" },
        "surface_row_ref": { "$ref": "#/$defs/path_ref" },
        "validator_suite_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mutability_posture": { "const": "read_only" } } },
          "then": {
            "properties": {
              "request_schema_ref": { "type": "null" },
              "preview_support_class": { "const": "read_only_no_mutation" }
            }
          }
        }
      ]
    },
    "offline_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirrorable", "requires_runtime_service", "bundle_members", "note"],
      "properties": {
        "mirrorable": { "type": "boolean" },
        "requires_runtime_service": { "type": "boolean" },
        "bundle_members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_endpoints",
        "read_only_endpoints",
        "mutating_endpoints",
        "append_only_endpoints",
        "endpoints_with_request_example",
        "endpoints_with_dry_run_or_preview",
        "open_no_auth_endpoints",
        "auth_required_endpoints",
        "service_surface_count",
        "distinct_api_families"
      ],
      "properties": {
        "total_endpoints": { "type": "integer", "minimum": 0 },
        "read_only_endpoints": { "type": "integer", "minimum": 0 },
        "mutating_endpoints": { "type": "integer", "minimum": 0 },
        "append_only_endpoints": { "type": "integer", "minimum": 0 },
        "endpoints_with_request_example": { "type": "integer", "minimum": 0 },
        "endpoints_with_dry_run_or_preview": { "type": "integer", "minimum": 0 },
        "open_no_auth_endpoints": { "type": "integer", "minimum": 0 },
        "auth_required_endpoints": { "type": "integer", "minimum": 0 },
        "service_surface_count": { "type": "integer", "minimum": 0 },
        "distinct_api_families": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
