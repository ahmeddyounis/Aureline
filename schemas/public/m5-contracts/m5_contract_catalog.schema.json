{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_contract_catalog.schema.json",
  "title": "Aureline M5 contract catalog",
  "description": "Boundary schema for the canonical M5 contract catalog (artifacts/contracts/m5-contract-catalog.json). The catalog is the consuming index that joins every published M5 contract family the public-contract publication matrix tracks to its lifecycle label, canonical schema/spec identifier, compatibility note, offline/mirror posture, and a checked-in sample payload gallery (nominal plus partial/not-provided samples with field-by-field notes). Each entry's lifecycle_label is the label the publication matrix publishes after narrowing, and each entry points back to the canonical schema/spec identifier so the catalog is never the only source of truth. It is metadata-plus-sample only: every field is a typed state, an opaque repo-relative ref or URI, or a copy/export-safe sample reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "catalog_id",
    "status",
    "as_of",
    "overview_page",
    "evidence_page",
    "help_catalog_page",
    "sdk_samples_page",
    "publication_matrix_ref",
    "json_schema_catalog_ref",
    "openapi_catalog_ref",
    "wit_publication_ref",
    "contract_family_registry_ref",
    "evidence_index_ref",
    "gallery_home",
    "lifecycle_labels",
    "maturity_lanes",
    "contract_forms",
    "identity_kinds",
    "sample_classes",
    "packaging_needs",
    "catalog_surfaces",
    "offline_bundle",
    "families",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_contract_catalog" },
    "catalog_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "evidence_page": { "$ref": "#/$defs/path_ref" },
    "help_catalog_page": { "$ref": "#/$defs/path_ref" },
    "sdk_samples_page": { "$ref": "#/$defs/path_ref" },
    "publication_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "json_schema_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "openapi_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "wit_publication_ref": { "$ref": "#/$defs/path_ref" },
    "contract_family_registry_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "gallery_home": { "$ref": "#/$defs/path_ref" },
    "lifecycle_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "maturity_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/maturity_lane" }
    },
    "contract_forms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contract_form" }
    },
    "identity_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identity_kind" }
    },
    "sample_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sample_class" }
    },
    "packaging_needs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/packaging_need" }
    },
    "catalog_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/catalog_surface" }
    },
    "offline_bundle": { "$ref": "#/$defs/offline_bundle" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family_entry" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$"
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "maturity_lane": {
      "type": "string",
      "enum": ["stable", "beta", "experimental", "internal"]
    },
    "contract_form": {
      "type": "string",
      "enum": [
        "json_schema_backed_contract_doc",
        "json_schema_registry",
        "record_registry",
        "event_envelope_schema",
        "wit_world_package",
        "openapi_family",
        "field_set",
        "cli_structured_output",
        "textual_interchange_contract",
        "asset_package_manifest",
        "teaching_content_pack"
      ]
    },
    "identity_kind": {
      "type": "string",
      "enum": ["json_schema", "openapi_spec", "wit_world"]
    },
    "sample_class": {
      "type": "string",
      "enum": ["nominal", "partial_or_not_provided"]
    },
    "packaging_need": {
      "type": "string",
      "enum": ["local_only", "mirrored", "managed", "browser_handoff"]
    },
    "catalog_surface": {
      "type": "string",
      "enum": ["help_about", "sdk_docs", "docs_center", "support_export", "cli_inspect"]
    },
    "contract_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_kind", "schema_or_spec_id", "schema_or_spec_ref", "form_catalog_ref"],
      "properties": {
        "identity_kind": { "$ref": "#/$defs/identity_kind" },
        "schema_or_spec_id": { "$ref": "#/$defs/non_empty_string" },
        "schema_or_spec_ref": { "$ref": "#/$defs/path_ref" },
        "form_catalog_ref": { "$ref": "#/$defs/path_ref" }
      }
    },
    "offline_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirror_inspectable", "requires_runtime_service", "packaging_need"],
      "properties": {
        "mirror_inspectable": { "type": "boolean" },
        "requires_runtime_service": { "type": "boolean" },
        "packaging_need": { "$ref": "#/$defs/packaging_need" }
      }
    },
    "family_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "title",
        "summary",
        "owning_package",
        "category",
        "contract_form",
        "maturity_lane",
        "claim_label",
        "lifecycle_label",
        "narrowed",
        "release_blocking",
        "active_gap_reasons",
        "contract_identity",
        "json_schema_validation_ref",
        "compatibility_note",
        "compatibility_note_ref",
        "example_gallery_ref",
        "sample_count",
        "sample_classes",
        "offline_parity",
        "matrix_row_ref",
        "contract_family_ref",
        "publication_destinations",
        "catalog_surfaces"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "owning_package": { "$ref": "#/$defs/non_empty_string" },
        "category": { "$ref": "#/$defs/non_empty_string" },
        "contract_form": { "$ref": "#/$defs/contract_form" },
        "maturity_lane": { "$ref": "#/$defs/maturity_lane" },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "narrowed": { "type": "boolean" },
        "release_blocking": { "type": "boolean" },
        "active_gap_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "contract_identity": { "$ref": "#/$defs/contract_identity" },
        "json_schema_validation_ref": {
          "anyOf": [{ "$ref": "#/$defs/path_ref" }, { "type": "null" }]
        },
        "compatibility_note": { "$ref": "#/$defs/non_empty_string" },
        "compatibility_note_ref": { "$ref": "#/$defs/path_ref" },
        "example_gallery_ref": { "$ref": "#/$defs/path_ref" },
        "sample_count": { "type": "integer", "minimum": 1 },
        "sample_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sample_class" }
        },
        "offline_parity": { "$ref": "#/$defs/offline_parity" },
        "matrix_row_ref": { "$ref": "#/$defs/path_ref" },
        "contract_family_ref": { "$ref": "#/$defs/path_ref" },
        "publication_destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "catalog_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/catalog_surface" }
        }
      }
    },
    "offline_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirrorable", "requires_runtime_service", "bundle_members", "note"],
      "properties": {
        "mirrorable": { "type": "boolean" },
        "requires_runtime_service": { "type": "boolean" },
        "bundle_members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_families",
        "families_stable_label",
        "families_beta_label",
        "families_narrowed",
        "release_blocking_families",
        "json_schema_identity_families",
        "openapi_identity_families",
        "wit_identity_families",
        "families_with_json_schema_validation",
        "families_with_partial_sample",
        "total_samples",
        "gallery_files"
      ],
      "properties": {
        "total_families": { "type": "integer", "minimum": 0 },
        "families_stable_label": { "type": "integer", "minimum": 0 },
        "families_beta_label": { "type": "integer", "minimum": 0 },
        "families_narrowed": { "type": "integer", "minimum": 0 },
        "release_blocking_families": { "type": "integer", "minimum": 0 },
        "json_schema_identity_families": { "type": "integer", "minimum": 0 },
        "openapi_identity_families": { "type": "integer", "minimum": 0 },
        "wit_identity_families": { "type": "integer", "minimum": 0 },
        "families_with_json_schema_validation": { "type": "integer", "minimum": 0 },
        "families_with_partial_sample": { "type": "integer", "minimum": 0 },
        "total_samples": { "type": "integer", "minimum": 0 },
        "gallery_files": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
