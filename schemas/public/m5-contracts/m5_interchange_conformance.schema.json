{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_interchange_conformance.schema.json",
  "title": "Aureline M5 interchange-conformance register",
  "description": "Boundary schema for the canonical M5 interchange-conformance register (artifacts/contracts/m5-interchange-conformance.json). The register ties every named M5 import/export family to the import/export validator that guards it, the cross-surface conformance runner that exercises a real emitted artifact, the contract version and lifecycle label the desktop, CLI/headless, and support/export consumers agree on, the degraded-state vocabulary they share, and the stable, copy-safe reason codes an interchange failure reports. A catalog-linked family's lifecycle_label equals the published contract family's label, and a release-blocking family with a failing required conformance dimension sets the register's decision to hold. It is metadata-plus-state only: every field is a typed state, an opaque repo-relative ref or URI, or a copy/export-safe summary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "as_of",
    "overview_page",
    "evidence_page",
    "help_page",
    "conformance_report_ref",
    "validator_manifest_ref",
    "validators_home",
    "contract_catalog_ref",
    "publication_matrix_ref",
    "reader_writer_compat_ref",
    "evidence_index_ref",
    "build_identity_ref",
    "lifecycle_labels",
    "interchange_directions",
    "conformance_classes",
    "consumer_surfaces",
    "dimension_kinds",
    "dimension_outcomes",
    "conformance_states",
    "decision_states",
    "degraded_states",
    "reason_codes",
    "rows",
    "blockers",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_interchange_conformance_register" },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "evidence_page": { "$ref": "#/$defs/path_ref" },
    "help_page": { "$ref": "#/$defs/path_ref" },
    "conformance_report_ref": { "$ref": "#/$defs/path_ref" },
    "validator_manifest_ref": { "$ref": "#/$defs/path_ref" },
    "validators_home": { "$ref": "#/$defs/path_ref" },
    "contract_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "publication_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "reader_writer_compat_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "build_identity_ref": { "$ref": "#/$defs/path_ref" },
    "lifecycle_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "interchange_directions": {
      "type": "array",
      "items": { "$ref": "#/$defs/interchange_direction" }
    },
    "conformance_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/conformance_class" }
    },
    "consumer_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "dimension_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimension_kind" }
    },
    "dimension_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimension_outcome" }
    },
    "conformance_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/conformance_state" }
    },
    "decision_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision_state" }
    },
    "degraded_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/degraded_state" }
    },
    "reason_codes": {
      "type": "array",
      "items": { "$ref": "#/$defs/reason_code" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "blockers": { "$ref": "#/$defs/blockers" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._.-]+)?$"
    },
    "ref_or_uri": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "interchange_direction": {
      "type": "string",
      "enum": ["export_only", "import_validation", "round_trip"]
    },
    "conformance_class": {
      "type": "string",
      "enum": ["round_trip_write_back", "import_validation_only", "compare_only"]
    },
    "consumer_surface": {
      "type": "string",
      "enum": ["desktop", "cli_headless", "support_export"]
    },
    "dimension_kind": {
      "type": "string",
      "enum": [
        "emitted_artifact_present",
        "import_export_validator",
        "round_trip_or_compare",
        "provenance_preserved",
        "trust_not_widened",
        "cross_surface_agreement",
        "stable_reason_codes"
      ]
    },
    "dimension_outcome": {
      "type": "string",
      "enum": ["pass", "downgrade", "fail"]
    },
    "conformance_state": {
      "type": "string",
      "enum": ["conformant", "narrowed", "failed"]
    },
    "decision_state": {
      "type": "string",
      "enum": ["clear", "hold"]
    },
    "degraded_state": {
      "type": "string",
      "enum": ["partial", "not_provided", "compare_only", "degraded", "unavailable"]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "unsupported_contract_version",
        "missing_required_provenance",
        "schema_validation_failed",
        "trust_widening_blocked",
        "round_trip_mismatch",
        "corrupt_or_truncated_payload",
        "unknown_field_unpreserved",
        "redaction_class_conflict"
      ]
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_id", "descriptor_ref", "kind", "reason_codes_emitted"],
      "properties": {
        "validator_id": { "$ref": "#/$defs/non_empty_string" },
        "descriptor_ref": { "$ref": "#/$defs/path_ref" },
        "kind": { "type": "string", "enum": ["import_export_validator"] },
        "reason_codes_emitted": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reason_code" }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_id",
        "artifact_ref",
        "artifact_record_kind",
        "emitted_record_kind",
        "surfaces_exercised",
        "result"
      ],
      "properties": {
        "runner_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_ref": { "$ref": "#/$defs/path_ref" },
        "artifact_record_kind": { "$ref": "#/$defs/non_empty_string" },
        "emitted_record_kind": { "$ref": "#/$defs/non_empty_string" },
        "surfaces_exercised": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "result": { "type": "string", "enum": ["pass", "downgrade", "fail"] }
      }
    },
    "consumer_agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces",
        "agreed_contract_version",
        "agreed_lifecycle_label",
        "agreed_degraded_states",
        "agrees"
      ],
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "agreed_contract_version": { "type": "integer", "minimum": 1 },
        "agreed_lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "agreed_degraded_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/degraded_state" }
        },
        "agrees": { "type": "boolean" }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_kind", "required", "outcome", "evidence_refs", "detail"],
      "properties": {
        "dimension_kind": { "$ref": "#/$defs/dimension_kind" },
        "required": { "type": "boolean" },
        "outcome": { "$ref": "#/$defs/dimension_outcome" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "title",
        "summary",
        "owning_package",
        "contract_form",
        "interchange_direction",
        "conformance_class",
        "claim_label",
        "lifecycle_label",
        "narrowed",
        "release_blocking",
        "contract_version",
        "contract_version_field",
        "validator",
        "runner",
        "consumer_agreement",
        "dimensions",
        "degraded_states_supported",
        "active_reason_codes",
        "catalog_family_id",
        "conformance_state",
        "decision"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "owning_package": { "$ref": "#/$defs/non_empty_string" },
        "contract_form": { "$ref": "#/$defs/non_empty_string" },
        "interchange_direction": { "$ref": "#/$defs/interchange_direction" },
        "conformance_class": { "$ref": "#/$defs/conformance_class" },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "narrowed": { "type": "boolean" },
        "release_blocking": { "type": "boolean" },
        "contract_version": { "type": "integer", "minimum": 1 },
        "contract_version_field": { "$ref": "#/$defs/non_empty_string" },
        "validator": { "$ref": "#/$defs/validator" },
        "runner": { "$ref": "#/$defs/runner" },
        "consumer_agreement": { "$ref": "#/$defs/consumer_agreement" },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "degraded_states_supported": {
          "type": "array",
          "items": { "$ref": "#/$defs/degraded_state" }
        },
        "active_reason_codes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason_code" }
        },
        "catalog_family_id": { "type": "string" },
        "catalog_entry_ref": { "$ref": "#/$defs/path_ref" },
        "matrix_row_ref": { "$ref": "#/$defs/path_ref" },
        "conformance_state": { "$ref": "#/$defs/conformance_state" },
        "decision": { "$ref": "#/$defs/decision_state" }
      }
    },
    "blockers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blocking_family_ids",
        "blocking_dimension_kinds",
        "narrowed_family_ids",
        "rationale"
      ],
      "properties": {
        "decision": { "$ref": "#/$defs/decision_state" },
        "blocking_family_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "blocking_dimension_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension_kind" }
        },
        "narrowed_family_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_families",
        "release_blocking_families",
        "conformant_families",
        "narrowed_families",
        "failed_families",
        "families_held",
        "catalog_linked_families",
        "round_trip_families",
        "compare_or_validate_only_families",
        "total_dimensions_evaluated",
        "dimensions_passing",
        "dimensions_downgrading",
        "dimensions_failing"
      ],
      "properties": {
        "total_families": { "type": "integer", "minimum": 0 },
        "release_blocking_families": { "type": "integer", "minimum": 0 },
        "conformant_families": { "type": "integer", "minimum": 0 },
        "narrowed_families": { "type": "integer", "minimum": 0 },
        "failed_families": { "type": "integer", "minimum": 0 },
        "families_held": { "type": "integer", "minimum": 0 },
        "catalog_linked_families": { "type": "integer", "minimum": 0 },
        "round_trip_families": { "type": "integer", "minimum": 0 },
        "compare_or_validate_only_families": { "type": "integer", "minimum": 0 },
        "total_dimensions_evaluated": { "type": "integer", "minimum": 0 },
        "dimensions_passing": { "type": "integer", "minimum": 0 },
        "dimensions_downgrading": { "type": "integer", "minimum": 0 },
        "dimensions_failing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
