{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_wit_contract_publication.schema.json",
  "title": "Aureline M5 extension-host WIT contract publication packet",
  "description": "Boundary schema for the canonical M5 extension-host WIT contract publication packet (artifacts/contracts/m5-wit-contract-publication.json) and its host/guest negotiation fixtures (fixtures/contracts/m5-wit-negotiation/). The packet publishes every reserved capability-world WIT package as a versioned entry with lifecycle metadata and a compatibility note, records the negotiation fixtures (supported, downgraded, deprecated, unsupported-skew) that prove capability narrowing, deprecated-world handling, and fail-closed unsupported-skew behaviour, and records the capability diffs between published versions. It reuses the ADR-0019 capability-world registry and host-negotiation vocabulary and the M5 public-contract matrix rather than minting a new contract lexicon. It is metadata-only: every field is a typed state or an opaque repo-relative ref / world identity; it carries no raw component bytes, bridge-shim payloads, signing-key material, or policy-bundle bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "as_of",
    "family_id",
    "overview_page",
    "evidence_page",
    "schema_ref",
    "contract_matrix_ref",
    "contract_matrix_row",
    "capability_world_registry_ref",
    "negotiation_schema_ref",
    "adr_ref",
    "root_package_ref",
    "wit_index_ref",
    "capability_diff_report_ref",
    "lifecycle_labels",
    "registry_statuses",
    "reader_writer_postures",
    "trust_state_postures",
    "publication_states",
    "negotiation_outcomes",
    "change_classes",
    "compatibility_verdicts",
    "guest_actions",
    "narrowing_reasons",
    "unsupported_world_reasons",
    "consuming_surfaces",
    "packages",
    "capability_diffs",
    "negotiation_fixtures",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_wit_contract_publication" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["published", "draft"] },
    "as_of": { "$ref": "#/$defs/non_empty_string" },
    "family_id": { "type": "string", "const": "extension_host_wit_world" },
    "overview_page": { "$ref": "#/$defs/repo_ref" },
    "evidence_page": { "$ref": "#/$defs/repo_ref" },
    "schema_ref": { "$ref": "#/$defs/repo_ref" },
    "contract_matrix_ref": { "$ref": "#/$defs/repo_ref" },
    "contract_matrix_row": { "$ref": "#/$defs/non_empty_string" },
    "capability_world_registry_ref": { "$ref": "#/$defs/repo_ref" },
    "negotiation_schema_ref": { "$ref": "#/$defs/repo_ref" },
    "adr_ref": { "$ref": "#/$defs/repo_ref" },
    "root_package_ref": { "$ref": "#/$defs/repo_ref" },
    "wit_index_ref": { "$ref": "#/$defs/repo_ref" },
    "capability_diff_report_ref": { "$ref": "#/$defs/repo_ref" },
    "lifecycle_labels": { "$ref": "#/$defs/string_array" },
    "registry_statuses": { "$ref": "#/$defs/string_array" },
    "reader_writer_postures": { "$ref": "#/$defs/string_array" },
    "trust_state_postures": { "$ref": "#/$defs/string_array" },
    "publication_states": { "$ref": "#/$defs/string_array" },
    "negotiation_outcomes": { "$ref": "#/$defs/string_array" },
    "change_classes": { "$ref": "#/$defs/string_array" },
    "compatibility_verdicts": { "$ref": "#/$defs/string_array" },
    "guest_actions": { "$ref": "#/$defs/string_array" },
    "narrowing_reasons": { "$ref": "#/$defs/string_array" },
    "unsupported_world_reasons": { "$ref": "#/$defs/string_array" },
    "consuming_surfaces": { "$ref": "#/$defs/string_array" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/wit_package" }
    },
    "capability_diffs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability_diff" }
    },
    "negotiation_fixtures": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/negotiation_fixture" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": { "type": "string", "minLength": 1 },
    "world_identity": {
      "type": "string",
      "pattern": "^aureline:[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["stable", "beta", "experimental", "deprecated", "retired"]
    },
    "registry_status": {
      "type": "string",
      "enum": ["active", "deprecated", "retired"]
    },
    "reader_writer_posture": {
      "type": "string",
      "enum": ["reader_only", "writer_only", "read_write", "bidirectional_interchange"]
    },
    "trust_state_posture": {
      "type": "string",
      "enum": ["admitted_in_restricted", "blocked_in_restricted"]
    },
    "publication_state": {
      "type": "string",
      "enum": ["published", "partial", "missing", "not_applicable"]
    },
    "negotiation_outcome": {
      "type": "string",
      "enum": ["supported", "downgraded", "deprecated", "unsupported_skew"]
    },
    "change_class": {
      "type": "string",
      "enum": ["additive_minor", "deprecation", "breaking_major", "retirement"]
    },
    "compatibility_verdict": {
      "type": "string",
      "enum": ["backward_compatible", "deprecated_superseded", "breaking"]
    },
    "guest_action": {
      "type": "string",
      "enum": ["none", "upgrade_recommended", "upgrade_required"]
    },
    "narrowing_reason_kind": {
      "type": "string",
      "enum": [
        "workspace_trust_restricted",
        "admin_policy_deny_list",
        "admin_policy_permission_floor",
        "admin_policy_egress_host_narrowing",
        "capability_lifecycle_degraded",
        "world_vocabulary_version_unknown",
        "host_abi_range_mismatch",
        "guest_abi_range_mismatch",
        "compatibility_bridge_profile_unbound",
        "budget_declaration_unacceptable"
      ]
    },
    "unsupported_world_reason_kind": {
      "type": "string",
      "enum": [
        "world_retired",
        "world_not_shipped_on_host",
        "bridge_refused",
        "host_abi_range_mismatch",
        "guest_abi_range_mismatch",
        "world_vocabulary_version_unknown"
      ]
    },
    "wit_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_identity",
        "world_slug",
        "world_semver",
        "wit_package_ref",
        "lifecycle_label",
        "registry_status",
        "reader_writer_posture",
        "trust_state_gating_posture",
        "permission_scope_projection",
        "supported_host_families",
        "registry_row_ref",
        "predecessor_package_ref",
        "successor_package_ref",
        "publication_state",
        "compatibility_note"
      ],
      "properties": {
        "package_identity": { "$ref": "#/$defs/world_identity" },
        "world_slug": { "$ref": "#/$defs/non_empty_string" },
        "world_semver": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "wit_package_ref": { "$ref": "#/$defs/repo_ref" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "registry_status": { "$ref": "#/$defs/registry_status" },
        "reader_writer_posture": { "$ref": "#/$defs/reader_writer_posture" },
        "trust_state_gating_posture": { "$ref": "#/$defs/trust_state_posture" },
        "permission_scope_projection": { "$ref": "#/$defs/string_array" },
        "supported_host_families": { "$ref": "#/$defs/string_array" },
        "registry_row_ref": { "$ref": "#/$defs/repo_ref" },
        "predecessor_package_ref": {
          "oneOf": [{ "$ref": "#/$defs/world_identity" }, { "type": "null" }]
        },
        "successor_package_ref": {
          "oneOf": [{ "$ref": "#/$defs/world_identity" }, { "type": "null" }]
        },
        "publication_state": { "$ref": "#/$defs/publication_state" },
        "compatibility_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "capability_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_id",
        "world_slug",
        "from_package_ref",
        "to_package_ref",
        "from_version",
        "to_version",
        "change_class",
        "compatibility_verdict",
        "guest_action_required",
        "added_capabilities",
        "removed_capabilities",
        "changed_capabilities",
        "notes"
      ],
      "properties": {
        "diff_id": { "$ref": "#/$defs/non_empty_string" },
        "world_slug": { "$ref": "#/$defs/non_empty_string" },
        "from_package_ref": { "$ref": "#/$defs/world_identity" },
        "to_package_ref": { "$ref": "#/$defs/world_identity" },
        "from_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "to_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "change_class": { "$ref": "#/$defs/change_class" },
        "compatibility_verdict": { "$ref": "#/$defs/compatibility_verdict" },
        "guest_action_required": { "$ref": "#/$defs/guest_action" },
        "added_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "removed_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "changed_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "narrowing_reason_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "reason", "repair_affordance_label"],
      "properties": {
        "world": { "$ref": "#/$defs/world_identity" },
        "reason": { "$ref": "#/$defs/narrowing_reason_kind" },
        "repair_affordance_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "unsupported_world_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_world_ref",
        "unsupported_reason",
        "successor_world_ref",
        "repair_affordance_label"
      ],
      "properties": {
        "declared_world_ref": { "$ref": "#/$defs/world_identity" },
        "unsupported_reason": { "$ref": "#/$defs/unsupported_world_reason_kind" },
        "successor_world_ref": {
          "oneOf": [{ "$ref": "#/$defs/world_identity" }, { "type": "null" }]
        },
        "repair_affordance_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "deprecated_world_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "successor_world_ref", "repair_affordance_label"],
      "properties": {
        "world": { "$ref": "#/$defs/world_identity" },
        "successor_world_ref": { "$ref": "#/$defs/world_identity" },
        "repair_affordance_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "negotiation_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "fixture_id",
        "outcome",
        "title",
        "negotiation_id",
        "extension_identity_ref",
        "extension_version",
        "host_contract_family",
        "host_abi_range",
        "guest_abi_range",
        "world_vocabulary_version",
        "trust_state",
        "declared_capability_worlds",
        "offered_capability_worlds",
        "negotiated_capability_worlds",
        "narrowing_reasons",
        "unsupported_world_decisions",
        "deprecated_world_notices",
        "fail_closed",
        "guest_authority_widened",
        "expected_audit_events",
        "narrative"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "record_kind": { "type": "string", "const": "m5_wit_negotiation_fixture" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "outcome": { "$ref": "#/$defs/negotiation_outcome" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "negotiation_id": { "$ref": "#/$defs/non_empty_string" },
        "extension_identity_ref": { "$ref": "#/$defs/non_empty_string" },
        "extension_version": { "$ref": "#/$defs/non_empty_string" },
        "host_contract_family": { "$ref": "#/$defs/non_empty_string" },
        "host_abi_range": { "$ref": "#/$defs/non_empty_string" },
        "guest_abi_range": { "$ref": "#/$defs/non_empty_string" },
        "world_vocabulary_version": { "type": "integer", "minimum": 1 },
        "trust_state": {
          "type": "string",
          "enum": ["trusted", "restricted", "blocked"]
        },
        "declared_capability_worlds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/world_identity" }
        },
        "offered_capability_worlds": {
          "type": "array",
          "items": { "$ref": "#/$defs/world_identity" }
        },
        "negotiated_capability_worlds": {
          "type": "array",
          "items": { "$ref": "#/$defs/world_identity" }
        },
        "narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_reason_entry" }
        },
        "unsupported_world_decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/unsupported_world_decision" }
        },
        "deprecated_world_notices": {
          "type": "array",
          "items": { "$ref": "#/$defs/deprecated_world_notice" }
        },
        "fail_closed": { "type": "boolean" },
        "guest_authority_widened": { "type": "boolean", "const": false },
        "expected_audit_events": { "$ref": "#/$defs/string_array" },
        "narrative": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_count",
        "published_package_count",
        "deprecated_package_count",
        "negotiation_fixture_count",
        "outcomes_covered",
        "fail_closed_fixture_count",
        "capability_diff_count",
        "all_fixtures_conform",
        "all_diffs_conform"
      ],
      "properties": {
        "package_count": { "type": "integer", "minimum": 1 },
        "published_package_count": { "type": "integer", "minimum": 0 },
        "deprecated_package_count": { "type": "integer", "minimum": 0 },
        "negotiation_fixture_count": { "type": "integer", "minimum": 4 },
        "outcomes_covered": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/negotiation_outcome" }
        },
        "fail_closed_fixture_count": { "type": "integer", "minimum": 0 },
        "capability_diff_count": { "type": "integer", "minimum": 1 },
        "all_fixtures_conform": { "type": "boolean", "const": true },
        "all_diffs_conform": { "type": "boolean", "const": true }
      }
    }
  }
}
