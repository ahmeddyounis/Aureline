{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-contracts/m5_public_contract_certification.schema.json",
  "title": "Aureline M5 public-contract certification register",
  "description": "Boundary schema for the canonical M5 public-contract certification register (artifacts/certification/m5-public-contract-certification.json) and its negative fixtures (fixtures/contracts/m5-public-contract-certification/). This is the closeout certification join for the whole M5 public-contract publication lane: for every claimed M5 public artifact family it binds the published contract form, the lifecycle metadata (version + label), the example corpus, the validator coverage, the compatibility report, and the release-graph linkage into one certification verdict. It reuses the contract-health register's per-family gate evaluation and the publication matrix's lifecycle labels rather than minting a new certification vocabulary: a family certifies only when every required pillar is current and its published label matches its public claim; a family may never certify a greener label than its public claim; a family whose public claim already narrowed inherits that narrowing; and a release-blocking family missing a required pillar withholds certification and holds promotion. It is metadata-plus-state only: every field is a typed state, an opaque repo-relative ref or URI, or a copy/export-safe summary, and it carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "register_id",
    "status",
    "as_of",
    "overview_page",
    "evidence_page",
    "help_page",
    "report_page",
    "shiproom_dashboard_page",
    "contract_health_ref",
    "publication_matrix_ref",
    "contract_catalog_ref",
    "json_schema_catalog_ref",
    "openapi_catalog_ref",
    "wit_publication_ref",
    "reader_writer_compat_ref",
    "interchange_conformance_ref",
    "evidence_index_ref",
    "build_identity_ref",
    "build_identity",
    "lifecycle_labels",
    "contract_forms",
    "pillar_kinds",
    "evidence_states",
    "certification_states",
    "certification_reasons",
    "stop_actions",
    "mirror_parity_states",
    "consumer_surfaces",
    "decision_states",
    "launch_cutline",
    "release_blocking_family_refs",
    "stop_rules",
    "rows",
    "promotion",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_public_contract_certification" },
    "register_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "evidence_page": { "$ref": "#/$defs/path_ref" },
    "help_page": { "$ref": "#/$defs/path_ref" },
    "report_page": { "$ref": "#/$defs/path_ref" },
    "shiproom_dashboard_page": { "$ref": "#/$defs/path_ref" },
    "contract_health_ref": { "$ref": "#/$defs/path_ref" },
    "publication_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "contract_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "json_schema_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "openapi_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "wit_publication_ref": { "$ref": "#/$defs/path_ref" },
    "reader_writer_compat_ref": { "$ref": "#/$defs/path_ref" },
    "interchange_conformance_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "build_identity_ref": { "$ref": "#/$defs/path_ref" },
    "build_identity": { "$ref": "#/$defs/build_identity" },
    "lifecycle_labels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lifecycle_label" },
      "uniqueItems": true
    },
    "contract_forms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract_form" },
      "uniqueItems": true
    },
    "pillar_kinds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pillar_kind" },
      "uniqueItems": true
    },
    "evidence_states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_state" },
      "uniqueItems": true
    },
    "certification_states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certification_state" },
      "uniqueItems": true
    },
    "certification_reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certification_reason" },
      "uniqueItems": true
    },
    "stop_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop_action" },
      "uniqueItems": true
    },
    "mirror_parity_states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mirror_parity_state" },
      "uniqueItems": true
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" },
      "uniqueItems": true
    },
    "decision_states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision_state" },
      "uniqueItems": true
    },
    "launch_cutline": { "$ref": "#/$defs/launch_cutline" },
    "release_blocking_family_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/stable_token" },
      "uniqueItems": true
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop_rule" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "promotion": { "$ref": "#/$defs/promotion" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._.-]+)?$"
    },
    "ref_or_uri": { "type": "string", "minLength": 1 },
    "stable_token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "contract_form": {
      "type": "string",
      "enum": [
        "json_schema_backed_contract_doc",
        "json_schema_registry",
        "record_registry",
        "event_envelope_schema",
        "wit_world_package",
        "openapi_family",
        "field_set",
        "cli_structured_output",
        "textual_interchange_contract",
        "asset_package_manifest",
        "teaching_content_pack"
      ]
    },
    "pillar_kind": {
      "type": "string",
      "enum": [
        "published_contract_form",
        "lifecycle_metadata",
        "example_corpus",
        "validator_coverage",
        "compatibility_report",
        "release_graph_linkage"
      ]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["current", "stale", "missing"]
    },
    "certification_state": {
      "type": "string",
      "enum": [
        "certified",
        "narrowed_row_downgraded",
        "narrowed_stale",
        "narrowed_retest_pending",
        "withheld"
      ]
    },
    "certification_reason": {
      "type": "string",
      "enum": [
        "row_downgraded",
        "schema_spec_package_missing",
        "lifecycle_metadata_missing",
        "example_corpus_missing",
        "validator_coverage_missing",
        "compatibility_report_missing",
        "release_packet_unlinked",
        "evidence_stale",
        "evidence_missing",
        "retest_pending",
        "mirror_parity_incomplete"
      ]
    },
    "stop_action": {
      "type": "string",
      "enum": [
        "hold_certification",
        "hold_promotion",
        "narrow_claim",
        "publish_contract_form",
        "publish_lifecycle_metadata",
        "publish_example_corpus",
        "wire_validator_coverage",
        "publish_compatibility_report",
        "link_release_packet",
        "refresh_evidence",
        "schedule_retest",
        "republish_mirror_bundle"
      ]
    },
    "mirror_parity_state": {
      "type": "string",
      "enum": ["current", "stale", "unpublished", "not_applicable"]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "claim_publication",
        "release_center",
        "support_center",
        "sdk_docs_publication"
      ]
    },
    "decision_state": {
      "type": "string",
      "enum": ["proceed", "hold"]
    },
    "identity_kind": {
      "type": "string",
      "enum": ["json_schema", "openapi_spec", "wit_world"]
    },
    "package_kind": {
      "type": "string",
      "enum": ["json_schema", "openapi_spec", "wit_world"]
    },
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_identity_ref",
        "release_candidate_ref",
        "artifact_graph_ref",
        "toolchain_channel",
        "note"
      ],
      "properties": {
        "build_identity_ref": { "$ref": "#/$defs/path_ref" },
        "release_candidate_ref": { "$ref": "#/$defs/non_empty_string" },
        "artifact_graph_ref": { "$ref": "#/$defs/non_empty_string" },
        "toolchain_channel": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "launch_cutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutline_level",
        "above_cutline_levels",
        "below_cutline_levels",
        "description"
      ],
      "properties": {
        "cutline_level": { "$ref": "#/$defs/lifecycle_label" },
        "above_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "below_cutline_levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "trigger_reason",
        "applies_to_labels",
        "default_action",
        "blocks_promotion",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "trigger_reason": { "$ref": "#/$defs/certification_reason" },
        "applies_to_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_label" }
        },
        "default_action": { "$ref": "#/$defs/stop_action" },
        "blocks_promotion": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_kind",
        "schema_or_spec_id",
        "schema_or_spec_ref",
        "package_kind",
        "package_version",
        "in_band_version_field"
      ],
      "properties": {
        "identity_kind": { "$ref": "#/$defs/identity_kind" },
        "schema_or_spec_id": { "$ref": "#/$defs/ref_or_uri" },
        "schema_or_spec_ref": { "$ref": "#/$defs/path_ref" },
        "package_kind": { "$ref": "#/$defs/package_kind" },
        "package_version": { "type": "integer", "minimum": 1 },
        "in_band_version_field": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "graph_linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_candidate_ref",
        "release_packet_ref",
        "build_identity_ref",
        "artifact_graph_node_ref",
        "mirror_parity",
        "offline_verifiable"
      ],
      "properties": {
        "release_candidate_ref": { "$ref": "#/$defs/non_empty_string" },
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "build_identity_ref": { "$ref": "#/$defs/path_ref" },
        "artifact_graph_node_ref": { "$ref": "#/$defs/non_empty_string" },
        "mirror_parity": { "$ref": "#/$defs/mirror_parity_state" },
        "offline_verifiable": { "type": "boolean" }
      }
    },
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pillar_kind",
        "title",
        "required",
        "evidence_state",
        "certifying_artifact_ref",
        "source_refs",
        "detail"
      ],
      "properties": {
        "pillar_kind": { "$ref": "#/$defs/pillar_kind" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "required": { "type": "boolean" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "certifying_artifact_ref": { "$ref": "#/$defs/path_ref" },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_row_ref",
        "matrix_row_ref",
        "catalog_entry_ref",
        "contract_form_catalog_ref",
        "compatibility_report_ref",
        "release_packet_ref"
      ],
      "properties": {
        "health_row_ref": { "$ref": "#/$defs/path_ref" },
        "matrix_row_ref": { "$ref": "#/$defs/path_ref" },
        "catalog_entry_ref": { "$ref": "#/$defs/path_ref" },
        "contract_form_catalog_ref": { "$ref": "#/$defs/path_ref" },
        "compatibility_report_ref": { "$ref": "#/$defs/path_ref" },
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cert_blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blocking_pillar_kinds",
        "retest_needed",
        "summary"
      ],
      "properties": {
        "decision": { "type": "string", "enum": ["clear", "hold"] },
        "blocking_pillar_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/pillar_kind" }
        },
        "retest_needed": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "title",
        "summary",
        "owning_package",
        "owner_dri",
        "category",
        "contract_form",
        "release_blocking",
        "claim_label",
        "source_published_label",
        "certified_label",
        "contract_version",
        "package_identity",
        "graph_linkage",
        "mirror_parity",
        "pillars",
        "certification_state",
        "active_certification_reasons",
        "stop_actions",
        "proof",
        "blocker",
        "rationale"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/stable_token" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "owning_package": { "$ref": "#/$defs/non_empty_string" },
        "owner_dri": { "type": "string", "minLength": 2 },
        "category": { "$ref": "#/$defs/non_empty_string" },
        "contract_form": { "$ref": "#/$defs/contract_form" },
        "release_blocking": { "type": "boolean" },
        "claim_label": { "$ref": "#/$defs/lifecycle_label" },
        "source_published_label": { "$ref": "#/$defs/lifecycle_label" },
        "certified_label": { "$ref": "#/$defs/lifecycle_label" },
        "contract_version": { "type": "integer", "minimum": 1 },
        "package_identity": { "$ref": "#/$defs/package_identity" },
        "graph_linkage": { "$ref": "#/$defs/graph_linkage" },
        "mirror_parity": { "$ref": "#/$defs/mirror_parity_state" },
        "pillars": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pillar" }
        },
        "certification_state": { "$ref": "#/$defs/certification_state" },
        "active_certification_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/certification_reason" },
          "uniqueItems": true
        },
        "stop_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/stop_action" },
          "uniqueItems": true
        },
        "proof": { "$ref": "#/$defs/proof" },
        "blocker": { "$ref": "#/$defs/cert_blocker" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_gate",
        "decision",
        "blocking_family_ids",
        "rationale"
      ],
      "properties": {
        "promotion_gate": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/decision_state" },
        "blocking_family_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_token" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_families",
        "release_blocking_families",
        "certified_families",
        "narrowed_families",
        "withheld_families",
        "families_held",
        "families_narrowed_below_claim",
        "mirror_publishable_families",
        "total_pillars_evaluated",
        "pillars_current",
        "pillars_stale",
        "pillars_missing"
      ],
      "properties": {
        "total_families": { "type": "integer", "minimum": 0 },
        "release_blocking_families": { "type": "integer", "minimum": 0 },
        "certified_families": { "type": "integer", "minimum": 0 },
        "narrowed_families": { "type": "integer", "minimum": 0 },
        "withheld_families": { "type": "integer", "minimum": 0 },
        "families_held": { "type": "integer", "minimum": 0 },
        "families_narrowed_below_claim": { "type": "integer", "minimum": 0 },
        "mirror_publishable_families": { "type": "integer", "minimum": 0 },
        "total_pillars_evaluated": { "type": "integer", "minimum": 0 },
        "pillars_current": { "type": "integer", "minimum": 0 },
        "pillars_stale": { "type": "integer", "minimum": 0 },
        "pillars_missing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
