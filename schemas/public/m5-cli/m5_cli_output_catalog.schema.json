{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public/m5-cli/m5_cli_output_catalog.schema.json",
  "title": "Aureline M5 CLI/headless structured-output and result-code catalog",
  "description": "Boundary schema for the canonical M5 CLI/headless structured-output and result-code catalog (artifacts/contracts/m5-cli-output-catalog.json) and its negative fixtures (fixtures/contracts/m5-cli-catalog/). The catalog gives every new M5 CLI/headless inspect, export, report, and health surface a stable structured-output schema reference (resolved from the M5 JSON Schema catalog), a result-code catalog drawn from the closed exit_code_class vocabulary frozen in schemas/automation/cli_output_registry_entry.schema.json, a lifecycle label equal to the publication matrix's effective published label, an explicit partial-result and freshness vocabulary, and a UI/CLI parity declaration with fixtures that prove the lifecycle/degraded-state vocabulary is identical on both surfaces. It is metadata-only: every field is a typed state or an opaque repo-relative ref or URI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "catalog_id",
    "status",
    "as_of",
    "overview_page",
    "cli_doc_page",
    "json_schema_catalog_ref",
    "publication_matrix_ref",
    "cli_surface_contract_ref",
    "cli_output_registry_schema_ref",
    "evidence_index_ref",
    "schema_home",
    "surface_kinds",
    "lifecycle_labels",
    "machine_output_stability_classes",
    "output_envelope_classes",
    "result_codes",
    "partial_result_states",
    "freshness_states",
    "parity_match_modes",
    "downgrade_behaviors",
    "offline_bundle",
    "surfaces",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_cli_output_catalog" },
    "catalog_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "type": "string", "enum": ["seeded", "published", "deprecated"] },
    "as_of": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "overview_page": { "$ref": "#/$defs/path_ref" },
    "cli_doc_page": { "$ref": "#/$defs/path_ref" },
    "json_schema_catalog_ref": { "$ref": "#/$defs/path_ref" },
    "publication_matrix_ref": { "$ref": "#/$defs/path_ref" },
    "cli_surface_contract_ref": { "$ref": "#/$defs/path_ref" },
    "cli_output_registry_schema_ref": { "$ref": "#/$defs/path_ref" },
    "evidence_index_ref": { "$ref": "#/$defs/path_ref" },
    "schema_home": { "$ref": "#/$defs/path_ref" },
    "surface_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/surface_kind" }
    },
    "lifecycle_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lifecycle_label" }
    },
    "machine_output_stability_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/machine_output_stability_class" }
    },
    "output_envelope_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/output_envelope_class" }
    },
    "result_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/result_code" }
    },
    "partial_result_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/partial_result_state" }
    },
    "freshness_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/freshness_state" }
    },
    "parity_match_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/parity_match_mode" }
    },
    "downgrade_behaviors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/downgrade_behavior" }
    },
    "offline_bundle": { "$ref": "#/$defs/offline_bundle" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "path_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$"
    },
    "schema_id_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://aureline\\.dev/schemas/public/m5-json/[A-Za-z0-9_]+\\.schema\\.json$"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*$"
    },
    "stable_dot_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*$"
    },
    "surface_kind": {
      "type": "string",
      "enum": ["inspect", "export", "report", "health"]
    },
    "lifecycle_label": {
      "type": "string",
      "enum": ["lts", "stable", "beta", "preview", "withdrawn"]
    },
    "machine_output_stability_class": {
      "type": "string",
      "enum": [
        "stable_schema_governed",
        "preview_schema_governed_additive_minor_only",
        "experimental_schema_governed_may_break",
        "internal_no_stability_promise"
      ]
    },
    "output_envelope_class": {
      "type": "string",
      "enum": [
        "json_document_single",
        "jsonl_line_stream",
        "ndjson_event_stream",
        "sarif_2_1_0_document",
        "junit_xml_document"
      ]
    },
    "result_code": {
      "type": "string",
      "enum": [
        "success",
        "success_no_action_taken",
        "partial_success_with_warnings",
        "usage_error",
        "input_validation_error",
        "policy_or_trust_denied",
        "credential_broker_denied",
        "preview_required_not_shown",
        "approval_required_not_granted",
        "dry_run_would_have_applied",
        "timeout_or_deadline_exceeded",
        "network_or_remote_unavailable",
        "kill_switch_active",
        "dependency_missing_or_stale",
        "unsupported_on_headless",
        "cancelled_by_user",
        "unrecoverable_internal_error"
      ],
      "description": "Drawn verbatim from the exit_code_class vocabulary frozen in schemas/automation/cli_output_registry_entry.schema.json so CLI, desktop, and support surfaces key off one set of stable enums."
    },
    "partial_result_state": {
      "type": "string",
      "enum": ["complete", "partial", "degraded", "unavailable", "stale_retest_needed"]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["fresh", "stale", "retest_needed", "unknown"]
    },
    "parity_match_mode": {
      "type": "string",
      "enum": ["exact_match_required", "projection_match_required", "informational_only"]
    },
    "downgrade_behavior": {
      "type": "string",
      "enum": ["narrow_below_cutline", "reject"]
    },
    "result_code_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_code", "numeric_code", "meaning", "partial_result"],
      "properties": {
        "result_code": { "$ref": "#/$defs/result_code" },
        "numeric_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "meaning": { "$ref": "#/$defs/non_empty_string" },
        "partial_result": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "result_code": { "const": "success" } } },
          "then": { "properties": { "numeric_code": { "const": 0 } } }
        },
        {
          "if": { "properties": { "result_code": { "const": "success_no_action_taken" } } },
          "then": { "properties": { "numeric_code": { "const": 0 } } }
        },
        {
          "if": { "properties": { "result_code": { "const": "partial_success_with_warnings" } } },
          "then": { "properties": { "partial_result": { "const": true } } }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "summary",
        "surface_kind",
        "family_id",
        "command_id",
        "lifecycle_label",
        "machine_output_stability_class",
        "output_envelope_class",
        "structured_output_schema_ref",
        "structured_output_schema_id",
        "result_code_catalog",
        "partial_result_states",
        "freshness_states",
        "downgrade_behavior",
        "compatibility_note",
        "compatibility_note_ref",
        "ui_inspect_surface",
        "parity_match_mode",
        "cli_parity_fixture_ref",
        "ui_parity_fixture_ref",
        "json_schema_catalog_ref",
        "matrix_row_ref",
        "validator_suite_refs"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/stable_dot_id" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_kind": { "$ref": "#/$defs/surface_kind" },
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "$ref": "#/$defs/command_id" },
        "lifecycle_label": { "$ref": "#/$defs/lifecycle_label" },
        "machine_output_stability_class": { "$ref": "#/$defs/machine_output_stability_class" },
        "output_envelope_class": { "$ref": "#/$defs/output_envelope_class" },
        "structured_output_schema_ref": { "$ref": "#/$defs/path_ref" },
        "structured_output_schema_id": { "$ref": "#/$defs/schema_id_uri" },
        "result_code_catalog": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/result_code_row" }
        },
        "partial_result_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/partial_result_state" }
        },
        "freshness_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/freshness_state" }
        },
        "downgrade_behavior": { "$ref": "#/$defs/downgrade_behavior" },
        "compatibility_note": { "$ref": "#/$defs/non_empty_string" },
        "compatibility_note_ref": { "$ref": "#/$defs/path_ref" },
        "ui_inspect_surface": { "$ref": "#/$defs/stable_dot_id" },
        "parity_match_mode": { "$ref": "#/$defs/parity_match_mode" },
        "cli_parity_fixture_ref": { "$ref": "#/$defs/path_ref" },
        "ui_parity_fixture_ref": { "$ref": "#/$defs/path_ref" },
        "json_schema_catalog_ref": { "$ref": "#/$defs/path_ref" },
        "matrix_row_ref": { "$ref": "#/$defs/path_ref" },
        "validator_suite_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        }
      }
    },
    "offline_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirrorable", "requires_runtime_service", "bundle_members", "note"],
      "properties": {
        "mirrorable": { "type": "boolean" },
        "requires_runtime_service": { "type": "boolean" },
        "bundle_members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path_ref" }
        },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_surfaces",
        "inspect_surfaces",
        "export_surfaces",
        "report_surfaces",
        "health_surfaces",
        "stable_label_surfaces",
        "beta_label_surfaces",
        "surfaces_with_partial_result_carrier",
        "surfaces_with_parity_fixtures"
      ],
      "properties": {
        "total_surfaces": { "type": "integer", "minimum": 0 },
        "inspect_surfaces": { "type": "integer", "minimum": 0 },
        "export_surfaces": { "type": "integer", "minimum": 0 },
        "report_surfaces": { "type": "integer", "minimum": 0 },
        "health_surfaces": { "type": "integer", "minimum": 0 },
        "stable_label_surfaces": { "type": "integer", "minimum": 0 },
        "beta_label_surfaces": { "type": "integer", "minimum": 0 },
        "surfaces_with_partial_result_carrier": { "type": "integer", "minimum": 0 },
        "surfaces_with_parity_fixtures": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
