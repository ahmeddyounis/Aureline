{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/activity/m5-attention-routing.schema.json",
  "title": "Aureline M5 attention-routing matrix",
  "description": "Boundary schema for the M5 attention-routing matrix: the frozen, typed contract for Aureline's notification envelopes, durable activity objects, badge aggregates, fanout receipts, routing context, privacy classes, and action/retention semantics. The matrix names each governed attention object family, cites the canonical boundary schema(s) and producing crate(s) it binds, maps each one to the proof packet that keeps it current, pins one shared state vocabulary, defines the controlled vocabulary spanning severity, scope, privacy class, dedupe rule, suppression, quiet-hours, stale/undelivered fanout, and reopen/authoritative-object routing, and covers the in-app activity center, OS notification, dock/taskbar badge, browser and mobile companion, and operator dashboard fanout channels. Stable object ids, channel ids, state tokens, required fields, retention rules, redaction classes, and privacy classes are defined once and reused by the shell activity center, OS notifications, companion/cross-client surfaces, operator dashboards, support export, Help/About, and CLI/headless consumers. No message bodies, credentials, raw provider payloads, hostnames, or absolute paths cross this boundary; the record carries opaque object refs, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_attention_routing_schema_version",
    "schema_ref",
    "matrix_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "shared_vocabulary",
    "state_vocabulary",
    "objects",
    "channels",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_attention_routing_matrix" },
    "m5_attention_routing_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/activity/m5-attention-routing.schema.json" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "shared_vocabulary": { "$ref": "#/$defs/shared_vocabulary" },
    "state_vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state_term" }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/object_entry" }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel_entry" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matrix_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "object_class": {
      "type": "string",
      "enum": [
        "notification_envelope",
        "activity_object",
        "badge_aggregate",
        "fanout_receipt",
        "routing_context",
        "privacy_class",
        "action_retention_semantics"
      ]
    },
    "channel_class": {
      "type": "string",
      "enum": [
        "in_app_activity_center",
        "os_native_notification",
        "dock_taskbar_badge",
        "browser_companion",
        "mobile_companion",
        "operator_dashboard"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "pending",
        "routed",
        "shown",
        "acknowledged",
        "snoozed",
        "quiet_hours_deferred",
        "suppressed",
        "running",
        "queued_waiting",
        "partially_completed",
        "failed",
        "completed",
        "resolved",
        "dismissed",
        "archived",
        "fanout_stale",
        "fanout_undelivered",
        "unknown_requires_review"
      ]
    },
    "controlled_vocabulary": {
      "type": "string",
      "enum": [
        "severity",
        "scope",
        "privacy_class",
        "dedupe_rule",
        "suppression",
        "quiet_hours",
        "fanout_delivery",
        "reopen_routing"
      ]
    },
    "privacy_class": {
      "type": "string",
      "enum": [
        "summary_safe",
        "workspace_sensitive",
        "security_critical",
        "managed_sensitive"
      ]
    },
    "scope_class": {
      "type": "string",
      "enum": ["app_global", "window", "workspace", "session", "collaboration", "tenant_org"]
    },
    "redaction_class": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "summary_only",
        "redacted_payload",
        "count_only",
        "internal_support_restricted"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "shell_activity_center",
        "os_notification",
        "companion_cross_client",
        "operator_dashboard",
        "support_export",
        "help_about",
        "cli_headless"
      ]
    },
    "reopen_target": {
      "type": "string",
      "enum": [
        "activity_job_row",
        "evidence_packet",
        "policy_diff",
        "review_request",
        "incident_thread",
        "route_object",
        "audit_event"
      ]
    },
    "delivery_posture": {
      "type": "string",
      "enum": [
        "durable_in_product",
        "out_of_window_mirror",
        "coarse_count_only",
        "scoped_mirror",
        "read_only_operator"
      ]
    },
    "token_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "label"],
      "properties": {
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "token_def_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/token_def" }
    },
    "shared_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severities",
        "scopes",
        "privacy_classes",
        "dedupe_rules",
        "suppression_reasons",
        "quiet_hours_behaviors",
        "fanout_delivery_states",
        "reopen_targets",
        "action_semantics",
        "retention_classes",
        "redaction_classes",
        "consumer_classes",
        "source_schema_refs"
      ],
      "properties": {
        "severities": { "$ref": "#/$defs/token_def_array" },
        "scopes": { "$ref": "#/$defs/token_def_array" },
        "privacy_classes": { "$ref": "#/$defs/token_def_array" },
        "dedupe_rules": { "$ref": "#/$defs/token_def_array" },
        "suppression_reasons": { "$ref": "#/$defs/token_def_array" },
        "quiet_hours_behaviors": { "$ref": "#/$defs/token_def_array" },
        "fanout_delivery_states": { "$ref": "#/$defs/token_def_array" },
        "reopen_targets": { "$ref": "#/$defs/token_def_array" },
        "action_semantics": { "$ref": "#/$defs/token_def_array" },
        "retention_classes": { "$ref": "#/$defs/token_def_array" },
        "redaction_classes": { "$ref": "#/$defs/token_def_array" },
        "consumer_classes": { "$ref": "#/$defs/token_def_array" },
        "source_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        }
      }
    },
    "state_term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "token",
        "label",
        "requires_durable_object",
        "is_delivery_gap",
        "is_suppression",
        "derived_from_refs"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/state_class" },
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "requires_durable_object": { "type": "boolean" },
        "is_delivery_gap": { "type": "boolean" },
        "is_suppression": { "type": "boolean" },
        "derived_from_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        }
      }
    },
    "field_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "label", "required"],
      "properties": {
        "field_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "required": { "type": "boolean" }
      }
    },
    "retention_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_class", "separate_from_audit_history", "rule"],
      "properties": {
        "retention_class": { "$ref": "#/$defs/non_empty_string" },
        "separate_from_audit_history": { "type": "boolean" },
        "rule": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "object_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "object_id",
        "label",
        "summary",
        "canonical_schema_refs",
        "produced_by_refs",
        "proof_packet_ref",
        "consumed_by",
        "applicable_states",
        "controlled_vocabularies",
        "required_fields",
        "retention_rule",
        "default_privacy",
        "default_redaction",
        "scope_default",
        "carries_durable_record",
        "reopen_targets",
        "locally_inspectable",
        "boundary_note",
        "typed_not_toast_only"
      ],
      "properties": {
        "object": { "$ref": "#/$defs/object_class" },
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "canonical_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "produced_by_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "consumed_by": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_class" }
        },
        "applicable_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_class" }
        },
        "controlled_vocabularies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/controlled_vocabulary" }
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field_def" }
        },
        "retention_rule": { "$ref": "#/$defs/retention_rule" },
        "default_privacy": { "$ref": "#/$defs/privacy_class" },
        "default_redaction": { "$ref": "#/$defs/redaction_class" },
        "scope_default": { "$ref": "#/$defs/scope_class" },
        "carries_durable_record": { "type": "boolean" },
        "reopen_targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reopen_target" }
        },
        "locally_inspectable": { "type": "boolean" },
        "boundary_note": { "$ref": "#/$defs/non_empty_string" },
        "typed_not_toast_only": { "type": "boolean" }
      }
    },
    "channel_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "channel_id",
        "label",
        "summary",
        "delivery_posture",
        "privacy_ceiling",
        "can_bypass_preview_approval",
        "carries_durable_reopen",
        "mirrors_authoritative",
        "default_redaction",
        "quiet_hours_respected",
        "notes"
      ],
      "properties": {
        "channel": { "$ref": "#/$defs/channel_class" },
        "channel_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "delivery_posture": { "$ref": "#/$defs/delivery_posture" },
        "privacy_ceiling": { "$ref": "#/$defs/privacy_class" },
        "can_bypass_preview_approval": { "const": false },
        "carries_durable_reopen": { "type": "boolean" },
        "mirrors_authoritative": { "type": "boolean" },
        "default_redaction": { "$ref": "#/$defs/redaction_class" },
        "quiet_hours_respected": { "const": true },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "matrix_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
