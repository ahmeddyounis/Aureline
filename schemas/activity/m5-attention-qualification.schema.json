{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/activity/m5-attention-qualification.schema.json",
  "title": "Aureline M5 attention-qualification bundle",
  "description": "Boundary schema for the M5 attention-qualification bundle: the frozen certification that binds every claimed attention family — notification envelopes, durable activity objects, action/retention semantics, quiet-hours and suppression, badge aggregates, and fanout receipts, all on the attention-routing matrix spine — to the shell, companion, and operator profiles that advertise it. Each family carries the proof packet (schema, checked-in fixture, and freeze gate) that keeps it current and the release-evidence rows it covers; each profile declares the families it depends on and carries a claim state derived from those families' evidence, so a stale proof narrows the claim and a failing or missing proof withdraws it, automatically and per profile. About/Help, the activity center, support export, the compatibility report, and release and public-truth surfaces read the published projection instead of restating attention quality claims. No message bodies, credentials, raw provider payloads, hostnames, or absolute paths cross this boundary; the record carries opaque object refs, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_attention_qualification_schema_version",
    "schema_ref",
    "bundle_id",
    "as_of",
    "matrix_ref",
    "matrix_id",
    "freeze_gate_ref",
    "summary",
    "proof_check_catalog",
    "families",
    "profiles",
    "consumers",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_attention_qualification_bundle" },
    "m5_attention_qualification_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/activity/m5-attention-qualification.schema.json" },
    "bundle_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "matrix_ref": { "$ref": "#/$defs/repo_ref" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "proof_check_catalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proof_check_def" }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family_row" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile_row" }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bundle_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "family_class": {
      "type": "string",
      "enum": [
        "notification_envelope",
        "activity_object",
        "attention_action",
        "quiet_hours_suppression",
        "badge_aggregate",
        "fanout_receipt",
        "attention_routing_matrix"
      ]
    },
    "profile_class": {
      "type": "string",
      "enum": ["shell_attention", "companion_attention", "operator_attention"]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "in_app_activity_center",
        "os_native_notification",
        "dock_taskbar_badge",
        "browser_companion",
        "mobile_companion",
        "operator_dashboard",
        "chronology_reuse"
      ]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["fresh", "stale", "failing", "missing"]
    },
    "claim_state": {
      "type": "string",
      "enum": ["full", "narrowed", "withdrawn"]
    },
    "proof_check_tag": {
      "type": "string",
      "enum": [
        "notification_envelopes",
        "durable_activity_objects",
        "action_semantics",
        "quiet_hours_suppression",
        "badge_dedupe_fidelity",
        "fanout_privacy_reopen_parity",
        "reopen_authoritative",
        "routing_object_model"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "release_evidence",
        "about_help",
        "activity_center",
        "support_export",
        "compatibility_report",
        "public_truth"
      ]
    },
    "proof_check_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "token", "label"],
      "properties": {
        "tag": { "$ref": "#/$defs/proof_check_tag" },
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "family_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "family_token", "evidence_state"],
      "properties": {
        "family": { "$ref": "#/$defs/family_class" },
        "family_token": { "$ref": "#/$defs/non_empty_string" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" }
      }
    },
    "family_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "family_id",
        "label",
        "summary",
        "record_kind",
        "source_object_id",
        "schema_ref",
        "fixture_ref",
        "freeze_gate_ref",
        "as_of",
        "evidence_state",
        "proof_checks",
        "preserves_security_escalation",
        "narrowing_note"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/family_class" },
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "record_kind": { "$ref": "#/$defs/non_empty_string" },
        "source_object_id": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/repo_ref" },
        "fixture_ref": { "$ref": "#/$defs/repo_ref" },
        "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
        "as_of": { "type": "string", "format": "date-time" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "proof_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/proof_check_tag" }
        },
        "preserves_security_escalation": { "const": true },
        "narrowing_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "profile_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profile_id",
        "label",
        "summary",
        "depends_on",
        "claimed_surfaces",
        "claim_state",
        "narrowed_by",
        "published_claim"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/profile_class" },
        "profile_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "depends_on": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/family_class" }
        },
        "claimed_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_class" }
        },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "narrowed_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/family_evidence_ref" }
        },
        "published_claim": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "consumer_id", "label", "reuses_projection", "note"],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "consumer_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "reuses_projection": { "const": true },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "bundle_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
