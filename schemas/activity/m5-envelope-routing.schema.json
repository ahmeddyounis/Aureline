{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/activity/m5-envelope-routing.schema.json",
  "title": "Aureline M5 envelope-routing bundle",
  "description": "Boundary schema for the M5 envelope-routing bundle: the working typed notification-envelope path every M5 producer emits and the deterministic engine that routes it. The bundle freezes the producer registry (every M5 subsystem that can request attention, each routing the typed envelope path instead of surface-local toast/banner/badge logic), the envelope corpus (each carrying a source subsystem, scope, privacy class, severity, dedupe key, recommended surface set, and a stable action target, with localizable copy keys rather than raw bodies), the representative routing contexts (active window, focus mode, do-not-disturb, presentation/follow mode, screen-reader posture, collaboration role, and user/admin notification policy), and every routing decision (one per envelope per context, with one outcome per handled surface). Routing keeps a durable in-product record on every decision, shares one stable action target across the activity center, OS notification, companion, and badge, never widens privacy on fanout, and never lets an out-of-window surface bypass the in-product preview/approval flow. Every severity, scope, privacy class, dedupe rule, channel, and reopen target binds back to the attention-routing matrix. No message bodies, credentials, raw provider payloads, hostnames, or absolute paths cross this boundary; the record carries opaque object refs, localizable copy keys, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_envelope_routing_schema_version",
    "schema_ref",
    "bundle_id",
    "as_of",
    "matrix_ref",
    "matrix_id",
    "freeze_gate_ref",
    "summary",
    "producers",
    "envelopes",
    "contexts",
    "decisions",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_envelope_routing_bundle" },
    "m5_envelope_routing_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/activity/m5-envelope-routing.schema.json" },
    "bundle_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "matrix_ref": { "$ref": "#/$defs/repo_ref" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "producers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/producer_entry" }
    },
    "envelopes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/notification_envelope" }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routing_context" }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routing_decision" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bundle_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "localizable_key": {
      "type": "string",
      "minLength": 1,
      "description": "A localizable copy key, never raw user-facing text.",
      "pattern": "^notify\\."
    },
    "source_subsystem": {
      "enum": [
        "shell",
        "notebook",
        "task_runner",
        "ai",
        "collaboration",
        "incident",
        "operator",
        "managed_policy",
        "companion",
        "security",
        "sync",
        "support"
      ]
    },
    "severity": {
      "enum": [
        "minor_success",
        "informational",
        "progress",
        "degraded",
        "handoff_actionable",
        "security_advisory"
      ]
    },
    "scope": {
      "enum": [
        "app_global",
        "window",
        "workspace",
        "session",
        "collaboration",
        "tenant_org"
      ]
    },
    "privacy_class": {
      "enum": [
        "summary_safe",
        "workspace_sensitive",
        "security_critical",
        "managed_sensitive"
      ]
    },
    "dedupe_strategy": {
      "enum": [
        "canonical_key_coalesce",
        "root_cause_collapse",
        "latest_supersedes",
        "count_rollup",
        "no_dedupe"
      ]
    },
    "redaction": {
      "enum": [
        "metadata_safe_default",
        "summary_only",
        "redacted_payload",
        "count_only",
        "internal_support_restricted"
      ]
    },
    "reopen_target": {
      "enum": [
        "activity_job_row",
        "evidence_packet",
        "policy_diff",
        "review_request",
        "incident_thread",
        "route_object",
        "audit_event"
      ]
    },
    "action_verb": {
      "enum": ["open", "review_approve", "retry", "acknowledge", "resolve"]
    },
    "surface": {
      "enum": [
        "in_app_activity_center",
        "os_native_notification",
        "dock_taskbar_badge",
        "browser_companion",
        "mobile_companion",
        "operator_dashboard"
      ]
    },
    "disposition": {
      "enum": [
        "deliver",
        "deliver_redacted",
        "defer_quiet_hours",
        "defer_focus",
        "route_to_in_product",
        "suppressed_by_user_policy",
        "suppressed_by_admin_policy"
      ]
    },
    "active_window": {
      "enum": [
        "app_foreground_focused",
        "app_foreground_unfocused",
        "app_background",
        "app_minimized_hidden",
        "screen_locked"
      ]
    },
    "focus_mode": { "enum": ["off", "focus_assist_on"] },
    "do_not_disturb": { "enum": ["off", "on"] },
    "presentation_mode": { "enum": ["off", "presenting", "follow_mode"] },
    "screen_reader": { "enum": ["off", "on"] },
    "collaboration_role": {
      "enum": ["solo", "owner", "reviewer", "viewer", "guest"]
    },
    "user_policy": { "enum": ["all_allowed", "important_only", "muted"] },
    "admin_policy": {
      "enum": ["unmanaged", "managed_default", "managed_restricted", "managed_locked"]
    },
    "action_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_target_id",
        "primary_action",
        "reopen_target",
        "object_ref",
        "label_key",
        "routes_through_preview_approval"
      ],
      "properties": {
        "action_target_id": { "$ref": "#/$defs/non_empty_string" },
        "primary_action": { "$ref": "#/$defs/action_verb" },
        "reopen_target": { "$ref": "#/$defs/reopen_target" },
        "object_ref": { "$ref": "#/$defs/repo_ref" },
        "label_key": { "$ref": "#/$defs/localizable_key" },
        "routes_through_preview_approval": { "type": "boolean" }
      }
    },
    "producer_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "source_subsystem",
        "label",
        "summary",
        "produced_by_refs",
        "emits_envelope_id",
        "routes_through_typed_envelope",
        "retains_surface_local_logic"
      ],
      "properties": {
        "producer_id": { "$ref": "#/$defs/non_empty_string" },
        "source_subsystem": { "$ref": "#/$defs/source_subsystem" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "produced_by_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "emits_envelope_id": { "$ref": "#/$defs/non_empty_string" },
        "routes_through_typed_envelope": { "const": true },
        "retains_surface_local_logic": { "const": false }
      }
    },
    "notification_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notification_envelope_id",
        "canonical_event_id",
        "source_subsystem",
        "producer_id",
        "severity",
        "scope",
        "scope_ref",
        "privacy_class",
        "dedupe_strategy",
        "dedupe_key",
        "recommended_surfaces",
        "action_target",
        "reopen_targets",
        "title_key",
        "body_key",
        "default_redaction",
        "carries_durable_record",
        "carries_localizable_copy",
        "created_at"
      ],
      "properties": {
        "notification_envelope_id": { "$ref": "#/$defs/non_empty_string" },
        "canonical_event_id": { "$ref": "#/$defs/non_empty_string" },
        "source_subsystem": { "$ref": "#/$defs/source_subsystem" },
        "producer_id": { "$ref": "#/$defs/non_empty_string" },
        "severity": { "$ref": "#/$defs/severity" },
        "scope": { "$ref": "#/$defs/scope" },
        "scope_ref": { "$ref": "#/$defs/repo_ref" },
        "privacy_class": { "$ref": "#/$defs/privacy_class" },
        "dedupe_strategy": { "$ref": "#/$defs/dedupe_strategy" },
        "dedupe_key": { "$ref": "#/$defs/non_empty_string" },
        "recommended_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface" }
        },
        "action_target": { "$ref": "#/$defs/action_target" },
        "reopen_targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reopen_target" }
        },
        "title_key": { "$ref": "#/$defs/localizable_key" },
        "body_key": { "$ref": "#/$defs/localizable_key" },
        "default_redaction": { "$ref": "#/$defs/redaction" },
        "carries_durable_record": { "const": true },
        "carries_localizable_copy": { "const": true },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "routing_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "summary",
        "active_window",
        "focus_mode",
        "do_not_disturb",
        "presentation_mode",
        "screen_reader",
        "collaboration_role",
        "user_policy",
        "admin_policy",
        "quiet_hours_active"
      ],
      "properties": {
        "context_id": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "active_window": { "$ref": "#/$defs/active_window" },
        "focus_mode": { "$ref": "#/$defs/focus_mode" },
        "do_not_disturb": { "$ref": "#/$defs/do_not_disturb" },
        "presentation_mode": { "$ref": "#/$defs/presentation_mode" },
        "screen_reader": { "$ref": "#/$defs/screen_reader" },
        "collaboration_role": { "$ref": "#/$defs/collaboration_role" },
        "user_policy": { "$ref": "#/$defs/user_policy" },
        "admin_policy": { "$ref": "#/$defs/admin_policy" },
        "quiet_hours_active": { "type": "boolean" }
      }
    },
    "surface_route_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "surface_id",
        "disposition",
        "reason_token",
        "reason",
        "applied_redaction",
        "action_target_id",
        "delivers_durable_record",
        "mirrors_authoritative",
        "dangerous_action_handoff_to_in_product",
        "requires_accessible_affordance"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/surface" },
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "reason_token": { "$ref": "#/$defs/non_empty_string" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "applied_redaction": { "$ref": "#/$defs/redaction" },
        "action_target_id": { "$ref": "#/$defs/non_empty_string" },
        "delivers_durable_record": { "type": "boolean" },
        "mirrors_authoritative": { "type": "boolean" },
        "dangerous_action_handoff_to_in_product": { "type": "boolean" },
        "requires_accessible_affordance": { "type": "boolean" }
      }
    },
    "routing_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "envelope_id",
        "context_id",
        "source_subsystem",
        "action_target_id",
        "durable_record_present",
        "outcomes"
      ],
      "properties": {
        "decision_id": { "$ref": "#/$defs/non_empty_string" },
        "envelope_id": { "$ref": "#/$defs/non_empty_string" },
        "context_id": { "$ref": "#/$defs/non_empty_string" },
        "source_subsystem": { "$ref": "#/$defs/source_subsystem" },
        "action_target_id": { "$ref": "#/$defs/non_empty_string" },
        "durable_record_present": { "const": true },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_route_outcome" }
        }
      }
    },
    "bundle_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    }
  }
}
