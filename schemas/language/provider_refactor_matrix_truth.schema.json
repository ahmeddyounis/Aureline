{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/language/provider_refactor_matrix_truth.schema.json",
  "title": "Aureline provider, diagnostic-cluster, and refactor-transaction matrix truth packet",
  "description": "Boundary schema for the stable provider/refactor matrix truth packet. The packet freezes which M5 framework-pack, notebook-cell, generated-source, structured-artifact, and code-understanding-graph lanes may claim semantic rename, previewable refactor, code-action mutation, text fallback, notebook/generated bridging, or compare-only posture — each bound to a language-provider family, capability-negotiation outcome, provider-conflict class, diagnostic source class, result-provenance state, refactor-transaction class, preview-completeness label, generated-artifact policy, allowed downgrade label, and rollback path. It extends, and never weakens, the launch-language refactor transaction model. The packet is the single truth that the framework-pack panel, notebook surface, request runner, preview surface, docs surface, generated-artifact surface, support export, release proof index, Help/About proof card, and the conformance dashboard all read; surfaces MUST NOT mint local copies or paraphrase matrix posture.",
  "type": "object",
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "workflow_or_surface_id",
    "generated_at",
    "covered_lanes",
    "rows",
    "consumer_projections",
    "promotion_state",
    "validation_findings"
  ],
  "properties": {
    "record_kind": { "const": "provider_refactor_matrix_truth_stable_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "workflow_or_surface_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" },
    "covered_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact_family_lane_class" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matrix_row" }
    },
    "consumer_projections": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "source_contract_refs": { "$ref": "#/$defs/ref_array" },
    "promotion_state": { "$ref": "#/$defs/promotion_state" },
    "validation_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_finding" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "uniqueItems": true
    },
    "artifact_family_lane_class": {
      "enum": [
        "framework_pack_lane",
        "notebook_cell_lane",
        "generated_source_lane",
        "structured_artifact_lane",
        "code_understanding_graph_lane"
      ]
    },
    "matrix_row_class": {
      "enum": [
        "matrix_lane_quality",
        "capability_negotiation_admission",
        "conflict_arbitration_admission",
        "diagnostic_source_admission",
        "result_provenance_admission",
        "semantic_layer_mode_admission",
        "refactor_transaction_admission",
        "generated_artifact_policy_admission",
        "downgrade_label_admission",
        "unsupported_gap",
        "known_limit",
        "downgrade_automation"
      ]
    },
    "support_class": {
      "enum": [
        "certified",
        "certified_below",
        "beta_grade_only",
        "preview_only",
        "unsupported",
        "support_unbound"
      ]
    },
    "provider_family_class": {
      "enum": [
        "lsp_provider",
        "framework_analyzer",
        "semantic_graph_lane",
        "notebook_adapter",
        "generated_source_bridge",
        "ai_overlay",
        "text_fallback",
        "not_applicable",
        "provider_unbound"
      ]
    },
    "capability_negotiation_class": {
      "enum": [
        "full_semantic_negotiated",
        "partial_semantic_negotiated",
        "text_fallback_negotiated",
        "capability_declined",
        "negotiation_pending",
        "not_applicable",
        "negotiation_unbound"
      ]
    },
    "conflict_class": {
      "enum": [
        "single_provider_no_conflict",
        "arbitrated_winner_loser_preserved",
        "unresolved_disagreement_surfaced",
        "policy_override_recorded",
        "not_applicable",
        "conflict_unbound"
      ]
    },
    "diagnostic_source_class": {
      "enum": [
        "compiler_build",
        "lsp",
        "linter_formatter",
        "framework_schema",
        "runtime_test_debug",
        "policy_trust",
        "generated_artifact_validation",
        "notebook_kernel",
        "not_applicable",
        "source_unbound"
      ]
    },
    "result_provenance_class": {
      "enum": [
        "live_semantic",
        "cached_semantic",
        "partial_semantic",
        "text_heuristic",
        "imported_scan",
        "stale_pending_refresh",
        "not_applicable",
        "provenance_unbound"
      ]
    },
    "semantic_layer_mode_class": {
      "enum": [
        "semantic_rename",
        "previewable_refactor",
        "code_action_mutation",
        "text_fallback",
        "notebook_generated_bridge",
        "compare_only",
        "unsupported",
        "not_applicable",
        "mode_unbound"
      ]
    },
    "refactor_transaction_class": {
      "enum": [
        "rename",
        "extract",
        "inline",
        "move",
        "organize_imports",
        "schema_codegen_rewrite",
        "ai_planned_transform",
        "notebook_generated_edit",
        "compare_only_no_mutation",
        "not_applicable",
        "refactor_unbound"
      ]
    },
    "completeness_class": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "unsupported",
        "not_applicable",
        "completeness_unbound"
      ]
    },
    "generated_artifact_policy_class": {
      "enum": [
        "not_generated",
        "regenerate_before_edit",
        "edit_with_regeneration_replay",
        "edit_blocked_generated_source",
        "compare_only_generated",
        "not_applicable",
        "policy_unbound"
      ]
    },
    "downgrade_label_class": {
      "enum": [
        "none",
        "semantic_to_text_fallback",
        "full_to_partial_completeness",
        "previewable_to_compare_only",
        "mutation_to_preview_only",
        "provider_unavailable_text_only",
        "generated_edit_to_regenerate_first",
        "not_applicable",
        "label_unbound"
      ]
    },
    "rollback_path_class": {
      "enum": [
        "exact_undo_via_local_history_checkpoint",
        "compensating_revert_via_workspace_diff",
        "grouped_mutation_journal_revert",
        "regenerate_first_then_replay",
        "manual_review_required_no_automatic_path",
        "no_safe_rollback_available",
        "not_applicable",
        "rollback_unbound"
      ]
    },
    "evidence_class": {
      "enum": [
        "archetype_repo_evidence",
        "framework_migration_evidence",
        "design_partner_evidence",
        "fixture_repo_evidence",
        "conformance_suite_evidence",
        "benchmark_evidence",
        "docs_disclosure_evidence",
        "evidence_unbound"
      ]
    },
    "known_limit_class": {
      "enum": [
        "none_declared",
        "provider_family_subset_only",
        "artifact_family_subset_only",
        "semantic_mode_subset_only",
        "refactor_class_subset_only",
        "generated_policy_subset_only",
        "diagnostic_source_subset_only",
        "compare_only_no_mutation_limit",
        "unsupported_runtime_target",
        "beta_capability_sample_only",
        "limit_unbound"
      ]
    },
    "downgrade_automation_class": {
      "enum": [
        "none",
        "auto_narrow_on_missing_fixture",
        "auto_narrow_on_provider_unavailable",
        "auto_narrow_on_conflict_unresolved",
        "auto_narrow_on_preview_partial",
        "auto_narrow_on_stale_provenance",
        "auto_demote_on_low_confidence",
        "auto_block_on_missing_evidence",
        "manual_only_pending_review",
        "automation_unbound"
      ]
    },
    "confidence_class": {
      "enum": ["high_confidence", "medium_confidence", "low_confidence"]
    },
    "promotion_state": {
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "finding_severity": { "enum": ["info", "warning", "blocker"] },
    "finding_kind": {
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_identity",
        "missing_artifact_family_lane_coverage",
        "missing_capability_negotiation_coverage",
        "missing_conflict_arbitration_coverage",
        "missing_diagnostic_source_coverage",
        "missing_result_provenance_coverage",
        "missing_semantic_layer_mode_coverage",
        "missing_refactor_transaction_coverage",
        "missing_generated_artifact_policy_coverage",
        "missing_downgrade_label_coverage",
        "missing_support_class",
        "missing_provider_family",
        "missing_known_limit",
        "missing_downgrade_automation",
        "missing_evidence_class",
        "missing_capability_negotiation_class",
        "missing_conflict_class",
        "missing_diagnostic_source_class",
        "missing_result_provenance_class",
        "missing_semantic_layer_mode_class",
        "missing_refactor_transaction_class",
        "missing_completeness_class",
        "missing_generated_artifact_policy_class",
        "missing_downgrade_label_class",
        "missing_rollback_path_class",
        "certified_with_unbound_binding",
        "narrowed_row_missing_disclosure_ref",
        "known_limit_missing_disclosure_ref",
        "downgrade_automation_missing_disclosure_ref",
        "missing_evidence_refs",
        "capability_negotiation_not_applicable",
        "capability_negotiation_not_permitted_on_row_class",
        "conflict_not_applicable",
        "conflict_not_permitted_on_row_class",
        "diagnostic_source_not_applicable",
        "diagnostic_source_not_permitted_on_row_class",
        "result_provenance_not_applicable",
        "result_provenance_not_permitted_on_row_class",
        "semantic_layer_mode_not_applicable",
        "semantic_layer_mode_not_permitted_on_row_class",
        "refactor_transaction_not_applicable",
        "refactor_transaction_not_permitted_on_row_class",
        "completeness_not_applicable",
        "completeness_not_permitted_on_row_class",
        "generated_artifact_policy_not_applicable",
        "generated_artifact_policy_not_permitted_on_row_class",
        "downgrade_label_not_applicable",
        "downgrade_label_not_permitted_on_row_class",
        "rollback_path_not_applicable",
        "rollback_path_not_permitted_on_row_class",
        "mutation_bypasses_preview_or_rollback",
        "raw_source_material_present",
        "secrets_present",
        "ambient_authority_present",
        "missing_consumer_projection",
        "consumer_projection_drift",
        "lane_vocabulary_collapsed",
        "row_class_vocabulary_collapsed",
        "support_class_vocabulary_collapsed",
        "provider_family_vocabulary_collapsed",
        "capability_negotiation_vocabulary_collapsed",
        "conflict_vocabulary_collapsed",
        "diagnostic_source_vocabulary_collapsed",
        "result_provenance_vocabulary_collapsed",
        "semantic_layer_mode_vocabulary_collapsed",
        "refactor_transaction_vocabulary_collapsed",
        "completeness_vocabulary_collapsed",
        "generated_artifact_policy_vocabulary_collapsed",
        "downgrade_label_vocabulary_collapsed",
        "rollback_path_vocabulary_collapsed",
        "known_limit_vocabulary_collapsed",
        "downgrade_automation_vocabulary_collapsed",
        "evidence_class_vocabulary_collapsed",
        "promotion_state_mismatch"
      ]
    },
    "matrix_row": {
      "type": "object",
      "required": [
        "row_id",
        "lane_class",
        "row_class",
        "support_class",
        "provider_family_class",
        "capability_negotiation_class",
        "conflict_class",
        "diagnostic_source_class",
        "result_provenance_class",
        "semantic_layer_mode_class",
        "refactor_transaction_class",
        "completeness_class",
        "generated_artifact_policy_class",
        "downgrade_label_class",
        "rollback_path_class",
        "evidence_class",
        "known_limit_class",
        "downgrade_automation_class",
        "confidence_class",
        "evidence_refs",
        "raw_source_material_excluded",
        "secrets_excluded",
        "ambient_authority_excluded",
        "captured_at"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "lane_class": { "$ref": "#/$defs/artifact_family_lane_class" },
        "row_class": { "$ref": "#/$defs/matrix_row_class" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "provider_family_class": { "$ref": "#/$defs/provider_family_class" },
        "capability_negotiation_class": { "$ref": "#/$defs/capability_negotiation_class" },
        "conflict_class": { "$ref": "#/$defs/conflict_class" },
        "diagnostic_source_class": { "$ref": "#/$defs/diagnostic_source_class" },
        "result_provenance_class": { "$ref": "#/$defs/result_provenance_class" },
        "semantic_layer_mode_class": { "$ref": "#/$defs/semantic_layer_mode_class" },
        "refactor_transaction_class": { "$ref": "#/$defs/refactor_transaction_class" },
        "completeness_class": { "$ref": "#/$defs/completeness_class" },
        "generated_artifact_policy_class": { "$ref": "#/$defs/generated_artifact_policy_class" },
        "downgrade_label_class": { "$ref": "#/$defs/downgrade_label_class" },
        "rollback_path_class": { "$ref": "#/$defs/rollback_path_class" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "known_limit_class": { "$ref": "#/$defs/known_limit_class" },
        "downgrade_automation_class": { "$ref": "#/$defs/downgrade_automation_class" },
        "confidence_class": { "$ref": "#/$defs/confidence_class" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" },
        "disclosure_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_source_material_excluded": { "type": "boolean" },
        "secrets_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" },
        "captured_at": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "consumer_projection": {
      "type": "object",
      "required": [
        "consumer_surface",
        "projection_ref",
        "matrix_packet_id_ref",
        "rendered_at",
        "preserves_same_packet",
        "preserves_lane_vocabulary",
        "preserves_row_class_vocabulary",
        "preserves_support_class_vocabulary",
        "preserves_provider_family_vocabulary",
        "preserves_capability_negotiation_vocabulary",
        "preserves_conflict_vocabulary",
        "preserves_diagnostic_source_vocabulary",
        "preserves_result_provenance_vocabulary",
        "preserves_semantic_layer_mode_vocabulary",
        "preserves_refactor_transaction_vocabulary",
        "preserves_completeness_vocabulary",
        "preserves_generated_artifact_policy_vocabulary",
        "preserves_downgrade_label_vocabulary",
        "preserves_rollback_path_vocabulary",
        "preserves_known_limit_vocabulary",
        "preserves_downgrade_automation_vocabulary",
        "preserves_evidence_class_vocabulary",
        "supports_json_export",
        "raw_private_material_excluded",
        "ambient_authority_excluded"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "framework_pack_panel",
            "notebook_surface",
            "request_runner",
            "preview_surface",
            "docs_surface",
            "generated_artifact_surface",
            "support_export",
            "release_proof_index",
            "help_about",
            "conformance_dashboard"
          ]
        },
        "projection_ref": { "$ref": "#/$defs/non_empty_string" },
        "matrix_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "rendered_at": { "$ref": "#/$defs/non_empty_string" },
        "preserves_same_packet": { "type": "boolean" },
        "preserves_lane_vocabulary": { "type": "boolean" },
        "preserves_row_class_vocabulary": { "type": "boolean" },
        "preserves_support_class_vocabulary": { "type": "boolean" },
        "preserves_provider_family_vocabulary": { "type": "boolean" },
        "preserves_capability_negotiation_vocabulary": { "type": "boolean" },
        "preserves_conflict_vocabulary": { "type": "boolean" },
        "preserves_diagnostic_source_vocabulary": { "type": "boolean" },
        "preserves_result_provenance_vocabulary": { "type": "boolean" },
        "preserves_semantic_layer_mode_vocabulary": { "type": "boolean" },
        "preserves_refactor_transaction_vocabulary": { "type": "boolean" },
        "preserves_completeness_vocabulary": { "type": "boolean" },
        "preserves_generated_artifact_policy_vocabulary": { "type": "boolean" },
        "preserves_downgrade_label_vocabulary": { "type": "boolean" },
        "preserves_rollback_path_vocabulary": { "type": "boolean" },
        "preserves_known_limit_vocabulary": { "type": "boolean" },
        "preserves_downgrade_automation_vocabulary": { "type": "boolean" },
        "preserves_evidence_class_vocabulary": { "type": "boolean" },
        "supports_json_export": { "type": "boolean" },
        "raw_private_material_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "validation_finding": {
      "type": "object",
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/finding_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    }
  }
}
