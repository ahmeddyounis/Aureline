{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/language/semantic_result_arbitration_truth.schema.json",
  "title": "Aureline semantic-result arbitration truth packet",
  "description": "Boundary schema for the semantic_result_arbitration_truth_stable_packet produced by the per-answer arbitration inspector. One packet binds, for the definition / references / hierarchy / completion result lanes on the M5 search, docs, framework, notebook, and generated-source surfaces: the acting (winning) provider family and the basis it won on, whether the alternate (losing) providers stay inspectable, the route that opens the arbitration / disagreement / provenance detail, the conflict class, what the disagreement changes (target identity, scope coverage, refactor safety, or freshness), how that disagreement is made visible, the result tier, the fallback banner shown when a semantic answer degraded, the guarantee that remains, the guarantee that was lost, the scope the surface may still claim, any skipped-coverage gap, and (for a mutating follow-up) the typed preview completeness and rollback checkpoint that the launch-language refactor safety model still requires. Raw source bodies, raw notebook outputs, raw generated artifacts, provider payloads, secrets, and ambient credentials never cross this boundary; the packet carries opaque ids, closed vocabulary tokens, and export-safe refs only. Adding a new surface, lane, basis, visibility, route, impact, tier, banner, guarantee, scope, gap, anchor, or finding value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking.",
  "type": "object",
  "$ref": "#/$defs/semantic_result_arbitration_truth_packet",
  "$defs": {
    "opaque_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "reviewable_summary": { "type": "string", "minLength": 1, "maxLength": 4000 },

    "result_surface_class": {
      "type": "string",
      "enum": [
        "search_surface",
        "docs_surface",
        "framework_surface",
        "notebook_surface",
        "generated_source_surface"
      ]
    },
    "result_lane_class": {
      "type": "string",
      "enum": ["definition", "references", "hierarchy", "completion"]
    },
    "support_class": {
      "type": "string",
      "enum": [
        "certified",
        "certified_below",
        "beta_grade_only",
        "preview_only",
        "unsupported",
        "support_unbound"
      ]
    },
    "provider_family_class": {
      "type": "string",
      "enum": [
        "lsp_provider",
        "framework_analyzer",
        "semantic_graph_lane",
        "notebook_adapter",
        "generated_source_bridge",
        "ai_overlay",
        "text_fallback",
        "not_applicable",
        "provider_unbound"
      ]
    },
    "arbitration_basis_class": {
      "type": "string",
      "enum": [
        "single_provider_authoritative",
        "highest_semantic_authority",
        "framework_overlay_precedence",
        "policy_trust_override",
        "freshness_recency",
        "only_admissible_provider",
        "narrowed_no_semantic_winner",
        "not_applicable",
        "basis_unbound"
      ]
    },
    "alternate_provider_visibility_class": {
      "type": "string",
      "enum": [
        "not_applicable_single_provider",
        "alternates_preserved_inspectable",
        "alternates_collapsed_ranking_only",
        "no_alternates_exposed"
      ]
    },
    "inspector_route_class": {
      "type": "string",
      "enum": [
        "not_applicable",
        "open_arbitration_inspector",
        "open_disagreement_detail",
        "open_provenance_pill",
        "opaque_spinner"
      ]
    },
    "conflict_class": {
      "type": "string",
      "enum": [
        "single_provider_no_conflict",
        "arbitrated_winner_loser_preserved",
        "unresolved_disagreement_surfaced",
        "policy_override_recorded",
        "not_applicable",
        "conflict_unbound"
      ]
    },
    "disagreement_impact_class": {
      "type": "string",
      "enum": [
        "none",
        "target_identity_changed",
        "scope_coverage_changed",
        "refactor_safety_changed",
        "freshness_only"
      ]
    },
    "disagreement_visibility_class": {
      "type": "string",
      "enum": [
        "none",
        "inline_conflict_panel",
        "side_panel_inspector",
        "blocked_until_review"
      ]
    },
    "result_tier_class": {
      "type": "string",
      "enum": [
        "exact_semantic",
        "cached_semantic",
        "partial_semantic",
        "heuristic_structural",
        "text_lexical",
        "unavailable"
      ]
    },
    "fallback_banner_class": {
      "type": "string",
      "enum": [
        "none",
        "semantic_to_text_fallback",
        "semantic_to_heuristic_fallback",
        "semantic_to_file_local_fallback",
        "cached_semantic_reuse",
        "unavailable_banner"
      ]
    },
    "retained_guarantee_class": {
      "type": "string",
      "enum": [
        "full_semantic_guarantee",
        "file_local_semantic",
        "structural_match_only",
        "lexical_match_only",
        "none_retained"
      ]
    },
    "lost_guarantee_class": {
      "type": "string",
      "enum": [
        "none_lost",
        "lost_cross_file_semantic",
        "lost_whole_workspace_scope",
        "lost_safe_rename_guarantee",
        "lost_all_references_guarantee",
        "lost_semantic_target_identity"
      ]
    },
    "claim_scope_class": {
      "type": "string",
      "enum": [
        "whole_workspace_all_results",
        "loaded_slice_results",
        "active_file_results",
        "open_cells_results",
        "generated_excluded_results",
        "single_target"
      ]
    },
    "coverage_gap_class": {
      "type": "string",
      "enum": [
        "none",
        "excluded_roots_skipped",
        "unloaded_slices_skipped",
        "generated_only_edges_skipped",
        "notebook_cells_unscanned"
      ]
    },
    "anchor_action_class": {
      "type": "string",
      "enum": [
        "result_only",
        "navigation_only",
        "completion_insert",
        "mutating_followup_preview"
      ]
    },
    "completeness_class": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "blocked",
        "unsupported",
        "not_applicable",
        "completeness_unbound"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "archetype_repo_evidence",
        "framework_migration_evidence",
        "design_partner_evidence",
        "fixture_repo_evidence",
        "conformance_suite_evidence",
        "benchmark_evidence",
        "docs_disclosure_evidence",
        "evidence_unbound"
      ]
    },
    "known_limit_class": {
      "type": "string",
      "enum": [
        "none_declared",
        "provider_family_subset_only",
        "artifact_family_subset_only",
        "semantic_mode_subset_only",
        "refactor_class_subset_only",
        "generated_policy_subset_only",
        "diagnostic_source_subset_only",
        "compare_only_no_mutation_limit",
        "unsupported_runtime_target",
        "beta_capability_sample_only",
        "limit_unbound"
      ]
    },
    "downgrade_automation_class": {
      "type": "string",
      "enum": [
        "none",
        "auto_narrow_on_missing_fixture",
        "auto_narrow_on_provider_unavailable",
        "auto_narrow_on_conflict_unresolved",
        "auto_narrow_on_preview_partial",
        "auto_narrow_on_stale_provenance",
        "auto_demote_on_low_confidence",
        "auto_block_on_missing_evidence",
        "manual_only_pending_review",
        "automation_unbound"
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": ["high_confidence", "medium_confidence", "low_confidence"]
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "finding_severity": {
      "type": "string",
      "enum": ["info", "warning", "blocker"]
    },
    "finding_kind": {
      "type": "string",
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_identity",
        "missing_surface_coverage",
        "missing_lane_coverage",
        "raw_source_material_present",
        "secrets_present",
        "ambient_authority_present",
        "missing_support_class",
        "missing_known_limit",
        "missing_downgrade_automation",
        "missing_evidence_class",
        "missing_provider_family",
        "missing_arbitration_basis",
        "missing_evidence_refs",
        "certified_with_unbound_binding",
        "narrowed_row_missing_disclosure_ref",
        "known_limit_missing_disclosure_ref",
        "downgrade_automation_missing_disclosure_ref",
        "missing_consumer_projection",
        "losing_provider_collapsed",
        "disagreement_detail_path_missing",
        "opaque_inspector_route",
        "silent_fusion_of_conflict",
        "fallback_banner_missing",
        "fallback_banner_on_exact_result",
        "overclaimed_scope_on_lexical_evidence",
        "whole_workspace_wording_with_coverage_gap",
        "mutating_anchor_bypasses_preview",
        "retained_guarantee_overstated",
        "certified_at_low_confidence",
        "promotion_state_mismatch"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "framework_pack_panel",
        "notebook_surface",
        "request_runner",
        "preview_surface",
        "docs_surface",
        "generated_artifact_surface",
        "support_export",
        "release_proof_index",
        "help_about",
        "conformance_dashboard"
      ]
    },

    "validation_finding": {
      "type": "object",
      "required": ["finding_kind", "severity", "summary"],
      "additionalProperties": false,
      "properties": {
        "finding_kind": { "$ref": "#/$defs/finding_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "summary": { "$ref": "#/$defs/reviewable_summary" }
      }
    },

    "result_arbitration_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "result_surface_class",
        "result_lane_class",
        "support_class",
        "acting_provider_family_class",
        "arbitration_basis_class",
        "alternate_provider_visibility_class",
        "inspector_route_class",
        "conflict_class",
        "disagreement_impact_class",
        "disagreement_visibility_class",
        "result_tier_class",
        "fallback_banner_class",
        "retained_guarantee_class",
        "lost_guarantee_class",
        "claim_scope_class",
        "coverage_gap_class",
        "anchor_action_class",
        "preview_completeness_class",
        "evidence_class",
        "known_limit_class",
        "downgrade_automation_class",
        "confidence_class",
        "evidence_refs",
        "raw_source_material_excluded",
        "secrets_excluded",
        "ambient_authority_excluded",
        "captured_at"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "result_surface_class": { "$ref": "#/$defs/result_surface_class" },
        "result_lane_class": { "$ref": "#/$defs/result_lane_class" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "acting_provider_family_class": { "$ref": "#/$defs/provider_family_class" },
        "arbitration_basis_class": { "$ref": "#/$defs/arbitration_basis_class" },
        "alternate_provider_visibility_class": {
          "$ref": "#/$defs/alternate_provider_visibility_class"
        },
        "inspector_route_class": { "$ref": "#/$defs/inspector_route_class" },
        "conflict_class": { "$ref": "#/$defs/conflict_class" },
        "disagreement_impact_class": { "$ref": "#/$defs/disagreement_impact_class" },
        "disagreement_visibility_class": { "$ref": "#/$defs/disagreement_visibility_class" },
        "result_tier_class": { "$ref": "#/$defs/result_tier_class" },
        "fallback_banner_class": { "$ref": "#/$defs/fallback_banner_class" },
        "retained_guarantee_class": { "$ref": "#/$defs/retained_guarantee_class" },
        "lost_guarantee_class": { "$ref": "#/$defs/lost_guarantee_class" },
        "claim_scope_class": { "$ref": "#/$defs/claim_scope_class" },
        "coverage_gap_class": { "$ref": "#/$defs/coverage_gap_class" },
        "anchor_action_class": { "$ref": "#/$defs/anchor_action_class" },
        "preview_completeness_class": { "$ref": "#/$defs/completeness_class" },
        "rollback_checkpoint_ref": { "$ref": "#/$defs/opaque_id" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "known_limit_class": { "$ref": "#/$defs/known_limit_class" },
        "downgrade_automation_class": { "$ref": "#/$defs/downgrade_automation_class" },
        "confidence_class": { "$ref": "#/$defs/confidence_class" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "disclosure_ref": { "type": "string", "minLength": 1 },
        "raw_source_material_excluded": { "type": "boolean" },
        "secrets_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" },
        "captured_at": { "$ref": "#/$defs/timestamp" }
      }
    },

    "result_arbitration_consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "projection_ref",
        "surface_packet_id_ref",
        "rendered_at",
        "preserves_same_packet",
        "preserves_result_surface_vocabulary",
        "preserves_result_lane_vocabulary",
        "preserves_support_class_vocabulary",
        "preserves_provider_family_vocabulary",
        "preserves_arbitration_basis_vocabulary",
        "preserves_alternate_provider_visibility_vocabulary",
        "preserves_inspector_route_vocabulary",
        "preserves_conflict_vocabulary",
        "preserves_disagreement_impact_vocabulary",
        "preserves_disagreement_visibility_vocabulary",
        "preserves_result_tier_vocabulary",
        "preserves_fallback_banner_vocabulary",
        "preserves_retained_guarantee_vocabulary",
        "preserves_lost_guarantee_vocabulary",
        "preserves_claim_scope_vocabulary",
        "preserves_coverage_gap_vocabulary",
        "preserves_anchor_action_vocabulary",
        "preserves_completeness_vocabulary",
        "preserves_evidence_class_vocabulary",
        "preserves_known_limit_vocabulary",
        "preserves_downgrade_automation_vocabulary",
        "supports_json_export",
        "raw_private_material_excluded",
        "ambient_authority_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "projection_ref": { "$ref": "#/$defs/opaque_id" },
        "surface_packet_id_ref": { "$ref": "#/$defs/opaque_id" },
        "rendered_at": { "$ref": "#/$defs/timestamp" },
        "preserves_same_packet": { "type": "boolean" },
        "preserves_result_surface_vocabulary": { "type": "boolean" },
        "preserves_result_lane_vocabulary": { "type": "boolean" },
        "preserves_support_class_vocabulary": { "type": "boolean" },
        "preserves_provider_family_vocabulary": { "type": "boolean" },
        "preserves_arbitration_basis_vocabulary": { "type": "boolean" },
        "preserves_alternate_provider_visibility_vocabulary": { "type": "boolean" },
        "preserves_inspector_route_vocabulary": { "type": "boolean" },
        "preserves_conflict_vocabulary": { "type": "boolean" },
        "preserves_disagreement_impact_vocabulary": { "type": "boolean" },
        "preserves_disagreement_visibility_vocabulary": { "type": "boolean" },
        "preserves_result_tier_vocabulary": { "type": "boolean" },
        "preserves_fallback_banner_vocabulary": { "type": "boolean" },
        "preserves_retained_guarantee_vocabulary": { "type": "boolean" },
        "preserves_lost_guarantee_vocabulary": { "type": "boolean" },
        "preserves_claim_scope_vocabulary": { "type": "boolean" },
        "preserves_coverage_gap_vocabulary": { "type": "boolean" },
        "preserves_anchor_action_vocabulary": { "type": "boolean" },
        "preserves_completeness_vocabulary": { "type": "boolean" },
        "preserves_evidence_class_vocabulary": { "type": "boolean" },
        "preserves_known_limit_vocabulary": { "type": "boolean" },
        "preserves_downgrade_automation_vocabulary": { "type": "boolean" },
        "supports_json_export": { "type": "boolean" },
        "raw_private_material_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" }
      }
    },

    "semantic_result_arbitration_truth_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "workflow_or_surface_id",
        "generated_at",
        "covered_surfaces",
        "rows",
        "consumer_projections",
        "source_contract_refs",
        "promotion_state"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "semantic_result_arbitration_truth_stable_packet"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "workflow_or_surface_id": { "$ref": "#/$defs/opaque_id" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "covered_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/result_surface_class" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/result_arbitration_row" }
        },
        "consumer_projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/result_arbitration_consumer_projection" }
        },
        "source_contract_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "validation_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    }
  }
}
