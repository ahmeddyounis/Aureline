{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/language/provider_status_surface_truth.schema.json",
  "title": "Aureline provider-status strip, capability-negotiation drawer, and result-provenance pill surface truth packet",
  "description": "Boundary schema for the stable provider-status surface truth packet. The packet binds the three reusable code-understanding UI objects — a provider-status strip (which provider lane is active, where it runs, what lifecycle state it is in, and the inspectable capability-detail route), a capability-negotiation drawer (participating providers with the losing provider preserved, the selected winner / fused result, scope limit, freshness, and retry / restart recovery action), and a result-provenance pill (provenance attached to definitions, references, completions, rename previews, and framework-aware results) — across the M5 framework, notebook, generated-source, preview, docs-linked, and structured-artifact surfaces. It reads the closed provider-family, capability-negotiation, conflict, result-provenance, completeness, and downgrade-label vocabularies frozen by the provider/refactor matrix packet, and never weakens the launch-language refactor safety model: a rename-preview pill must still bind a typed preview completeness. Surfaces MUST NOT mint local copies or paraphrase surface posture; they read this packet verbatim.",
  "type": "object",
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "workflow_or_surface_id",
    "generated_at",
    "covered_surfaces",
    "rows",
    "consumer_projections",
    "promotion_state",
    "validation_findings"
  ],
  "properties": {
    "record_kind": { "const": "provider_status_surface_truth_stable_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "workflow_or_surface_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" },
    "covered_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/surface_class" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_object_row" }
    },
    "consumer_projections": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "source_contract_refs": { "$ref": "#/$defs/ref_array" },
    "promotion_state": { "$ref": "#/$defs/promotion_state" },
    "validation_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_finding" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "uniqueItems": true
    },
    "surface_class": {
      "enum": [
        "framework_surface",
        "notebook_surface",
        "generated_source_surface",
        "preview_surface",
        "docs_linked_surface",
        "structured_artifact_surface"
      ]
    },
    "object_kind": {
      "enum": [
        "provider_status_strip",
        "capability_negotiation_drawer",
        "result_provenance_pill",
        "not_applicable"
      ]
    },
    "object_row_class": {
      "enum": [
        "surface_object_presence",
        "provider_lane_state_admission",
        "capability_detail_route_admission",
        "participating_provider_admission",
        "negotiation_result_admission",
        "scope_and_freshness_admission",
        "drawer_recovery_action_admission",
        "provenance_anchor_admission",
        "provenance_downgrade_admission",
        "unsupported_gap",
        "known_limit",
        "downgrade_automation"
      ]
    },
    "support_class": {
      "enum": [
        "certified",
        "certified_below",
        "beta_grade_only",
        "preview_only",
        "unsupported",
        "support_unbound"
      ]
    },
    "provider_family_class": {
      "enum": [
        "lsp_provider",
        "framework_analyzer",
        "semantic_graph_lane",
        "notebook_adapter",
        "generated_source_bridge",
        "ai_overlay",
        "text_fallback",
        "not_applicable",
        "provider_unbound"
      ]
    },
    "provider_locality_class": {
      "enum": [
        "in_process_engine",
        "local_host_subprocess",
        "workspace_local_process",
        "notebook_kernel_session",
        "remote_managed_service",
        "not_applicable",
        "locality_unbound"
      ]
    },
    "provider_lifecycle_state_class": {
