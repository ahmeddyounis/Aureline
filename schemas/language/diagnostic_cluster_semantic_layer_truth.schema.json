{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/language/diagnostic_cluster_semantic_layer_truth.schema.json",
  "title": "Aureline diagnostic-cluster semantic-layer truth packet",
  "description": "Boundary schema for the diagnostic_cluster_semantic_layer_truth_stable_packet produced by the clustered diagnostic surface. One packet binds, for the compiler / linter / language-server / framework / runtime / notebook / policy cluster lanes on the M5 notebook, framework, preview, and generated-code surfaces: the diagnostic source families that converged into one cluster, whether deduplication preserved per-provider detail, timestamps/epochs, suppression/baseline state, and related symbol/file evidence, whether the source families stayed differentiated rather than fusing into one undifferentiated row, the route that opens the cluster detail sheet, the acting provider family, whether a provider disagreement kept the losing provider inspectable, the semantic-layer banner the surface may show (semantic, graph-warm, syntax-only, cached, runtime-only, or partial), the freshness and scope labels the cluster may claim, and — when a fix is offered — the acting provider, freshness/scope posture, and (for a mutating fix) the typed preview completeness and rollback checkpoint the launch-language refactor safety model still requires. Raw source bodies, raw notebook outputs, raw generated artifacts, provider payloads, secrets, and ambient credentials never cross this boundary; the packet carries opaque ids, closed vocabulary tokens, and export-safe refs only. Adding a new surface, lane, banner, freshness, scope, provenance, differentiation, detail-route, disagreement-visibility, fix, or finding value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking.",
  "type": "object",
  "$ref": "#/$defs/diagnostic_cluster_semantic_layer_truth_packet",
  "$defs": {
    "opaque_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "reviewable_summary": { "type": "string", "minLength": 1, "maxLength": 4000 },

    "surface_class": {
      "type": "string",
      "enum": [
        "notebook_surface",
        "framework_surface",
        "preview_surface",
        "generated_code_surface"
      ]
    },
    "cluster_lane_class": {
      "type": "string",
      "enum": [
        "compiler",
        "linter",
        "language_server",
        "framework",
        "runtime",
        "notebook",
        "policy"
      ]
    },
    "support_class": {
      "type": "string",
      "enum": [
        "certified",
        "certified_below",
        "beta_grade_only",
        "preview_only",
        "unsupported",
        "support_unbound"
      ]
    },
    "diagnostic_source_class": {
      "type": "string",
      "enum": [
        "compiler_build",
        "lsp",
        "linter_formatter",
        "framework_schema",
        "runtime_test_debug",
        "policy_trust",
        "generated_artifact_validation",
        "notebook_kernel",
        "not_applicable",
        "source_unbound"
      ]
    },
    "cluster_provenance_class": {
      "type": "string",
      "enum": [
        "single_provider_cluster",
        "per_provider_preserved",
        "collapsed_lossy"
      ]
    },
    "source_differentiation_class": {
      "type": "string",
      "enum": [
        "single_source_not_applicable",
        "differentiated_by_source",
        "fused_undifferentiated"
      ]
    },
    "detail_sheet_route_class": {
      "type": "string",
      "enum": [
        "not_applicable",
        "open_cluster_detail_sheet",
        "open_provider_breakdown",
        "opaque_spinner"
      ]
    },
    "semantic_layer_banner_class": {
      "type": "string",
      "enum": [
        "semantic",
        "graph_warm",
        "syntax_only",
        "cached",
        "runtime_only",
        "partial",
        "banner_unbound"
      ]
    },
    "freshness_class": {
      "type": "string",
      "enum": ["live", "warm", "cached", "stale", "freshness_unbound"]
    },
    "scope_label_class": {
      "type": "string",
      "enum": [
        "whole_workspace",
        "loaded_slice",
        "active_file",
        "open_cells",
        "single_artifact",
        "generated_excluded",
        "scope_unbound"
      ]
    },
    "provider_family_class": {
      "type": "string",
      "enum": [
        "lsp_provider",
        "framework_analyzer",
        "semantic_graph_lane",
        "notebook_adapter",
        "generated_source_bridge",
        "ai_overlay",
        "text_fallback",
        "not_applicable",
        "provider_unbound"
      ]
    },
    "conflict_class": {
      "type": "string",
      "enum": [
        "single_provider_no_conflict",
        "arbitrated_winner_loser_preserved",
        "unresolved_disagreement_surfaced",
        "policy_override_recorded",
        "not_applicable",
        "conflict_unbound"
      ]
    },
    "provider_disagreement_visibility_class": {
      "type": "string",
      "enum": [
        "not_applicable_single_provider",
        "losers_preserved_inspectable",
        "losers_collapsed_ranking_only",
        "no_losers_exposed"
      ]
    },
    "fix_offer_class": {
      "type": "string",
      "enum": [
        "no_fix_offered",
        "non_mutating_fix",
        "mutating_quick_fix",
        "organize_imports_fix",
        "schema_codegen_fix",
        "ai_planned_fix",
        "notebook_generated_fix"
      ]
    },
    "completeness_class": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "blocked",
        "unsupported",
        "not_applicable",
        "completeness_unbound"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "archetype_repo_evidence",
        "framework_migration_evidence",
        "design_partner_evidence",
        "fixture_repo_evidence",
        "conformance_suite_evidence",
        "benchmark_evidence",
        "docs_disclosure_evidence",
        "evidence_unbound"
      ]
    },
    "known_limit_class": {
      "type": "string",
      "enum": [
        "none_declared",
        "provider_family_subset_only",
        "artifact_family_subset_only",
        "semantic_mode_subset_only",
        "refactor_class_subset_only",
        "generated_policy_subset_only",
        "diagnostic_source_subset_only",
        "compare_only_no_mutation_limit",
        "unsupported_runtime_target",
        "beta_capability_sample_only",
        "limit_unbound"
      ]
    },
    "downgrade_automation_class": {
      "type": "string",
      "enum": [
        "none",
        "auto_narrow_on_missing_fixture",
        "auto_narrow_on_provider_unavailable",
        "auto_narrow_on_conflict_unresolved",
        "auto_narrow_on_preview_partial",
        "auto_narrow_on_stale_provenance",
        "auto_demote_on_low_confidence",
        "auto_block_on_missing_evidence",
        "manual_only_pending_review",
        "automation_unbound"
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": ["high_confidence", "medium_confidence", "low_confidence"]
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "finding_severity": {
      "type": "string",
      "enum": ["info", "warning", "blocker"]
    },
    "finding_kind": {
      "type": "string",
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_identity",
        "missing_surface_coverage",
        "missing_cluster_lane_coverage",
        "raw_source_material_present",
        "secrets_present",
        "ambient_authority_present",
        "missing_support_class",
        "missing_known_limit",
        "missing_downgrade_automation",
        "missing_evidence_class",
        "missing_provider_family",
        "missing_diagnostic_sources",
        "missing_semantic_layer_banner",
        "missing_freshness_label",
        "missing_scope_label",
        "missing_evidence_refs",
        "certified_with_unbound_binding",
        "narrowed_row_missing_disclosure_ref",
        "known_limit_missing_disclosure_ref",
        "downgrade_automation_missing_disclosure_ref",
        "missing_consumer_projection",
        "cluster_provenance_collapsed",
        "sources_fused_undifferentiated",
        "losing_provider_collapsed",
        "opaque_detail_sheet_route",
        "detail_sheet_route_missing",
        "semantic_layer_overclaimed",
        "overclaimed_scope_on_stale_evidence",
        "fix_offered_without_provider_or_freshness",
        "mutating_fix_bypasses_preview",
        "certified_at_low_confidence",
        "promotion_state_mismatch"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "framework_pack_panel",
        "notebook_surface",
        "request_runner",
        "preview_surface",
        "docs_surface",
        "generated_artifact_surface",
        "support_export",
        "release_proof_index",
        "help_about",
        "conformance_dashboard"
      ]
    },

    "validation_finding": {
      "type": "object",
      "required": ["finding_kind", "severity", "summary"],
      "additionalProperties": false,
      "properties": {
        "finding_kind": { "$ref": "#/$defs/finding_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "summary": { "$ref": "#/$defs/reviewable_summary" }
      }
    },

    "diagnostic_cluster_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface_class",
        "cluster_lane_class",
        "support_class",
        "diagnostic_source_classes",
        "cluster_provenance_class",
        "source_differentiation_class",
        "preserves_per_provider_detail",
        "preserves_timestamps_epochs",
        "preserves_suppression_baseline",
        "preserves_related_evidence",
        "detail_sheet_route_class",
        "semantic_layer_banner_class",
        "freshness_class",
        "scope_label_class",
        "acting_provider_family_class",
        "conflict_class",
        "provider_disagreement_visibility_class",
        "fix_offer_class",
        "preview_completeness_class",
        "evidence_class",
        "known_limit_class",
        "downgrade_automation_class",
        "confidence_class",
        "evidence_refs",
        "raw_source_material_excluded",
        "secrets_excluded",
        "ambient_authority_excluded",
        "captured_at"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_class": { "$ref": "#/$defs/surface_class" },
        "cluster_lane_class": { "$ref": "#/$defs/cluster_lane_class" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "diagnostic_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic_source_class" }
        },
        "cluster_provenance_class": { "$ref": "#/$defs/cluster_provenance_class" },
        "source_differentiation_class": { "$ref": "#/$defs/source_differentiation_class" },
        "preserves_per_provider_detail": { "type": "boolean" },
        "preserves_timestamps_epochs": { "type": "boolean" },
        "preserves_suppression_baseline": { "type": "boolean" },
        "preserves_related_evidence": { "type": "boolean" },
        "detail_sheet_route_class": { "$ref": "#/$defs/detail_sheet_route_class" },
        "semantic_layer_banner_class": { "$ref": "#/$defs/semantic_layer_banner_class" },
        "freshness_class": { "$ref": "#/$defs/freshness_class" },
        "scope_label_class": { "$ref": "#/$defs/scope_label_class" },
        "acting_provider_family_class": { "$ref": "#/$defs/provider_family_class" },
        "conflict_class": { "$ref": "#/$defs/conflict_class" },
        "provider_disagreement_visibility_class": {
          "$ref": "#/$defs/provider_disagreement_visibility_class"
        },
        "fix_offer_class": { "$ref": "#/$defs/fix_offer_class" },
        "preview_completeness_class": { "$ref": "#/$defs/completeness_class" },
        "rollback_checkpoint_ref": { "$ref": "#/$defs/opaque_id" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "known_limit_class": { "$ref": "#/$defs/known_limit_class" },
        "downgrade_automation_class": { "$ref": "#/$defs/downgrade_automation_class" },
        "confidence_class": { "$ref": "#/$defs/confidence_class" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "disclosure_ref": { "type": "string", "minLength": 1 },
        "raw_source_material_excluded": { "type": "boolean" },
        "secrets_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" },
        "captured_at": { "$ref": "#/$defs/timestamp" }
      }
    },

    "diagnostic_cluster_consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "projection_ref",
        "surface_packet_id_ref",
        "rendered_at",
        "preserves_same_packet",
        "preserves_surface_vocabulary",
        "preserves_cluster_lane_vocabulary",
        "preserves_support_class_vocabulary",
        "preserves_diagnostic_source_vocabulary",
        "preserves_cluster_provenance_vocabulary",
        "preserves_source_differentiation_vocabulary",
        "preserves_detail_sheet_route_vocabulary",
        "preserves_semantic_layer_banner_vocabulary",
        "preserves_freshness_vocabulary",
        "preserves_scope_label_vocabulary",
        "preserves_provider_family_vocabulary",
        "preserves_conflict_vocabulary",
        "preserves_provider_disagreement_visibility_vocabulary",
        "preserves_fix_offer_vocabulary",
        "preserves_completeness_vocabulary",
        "preserves_evidence_class_vocabulary",
        "preserves_known_limit_vocabulary",
        "preserves_downgrade_automation_vocabulary",
        "supports_json_export",
        "raw_private_material_excluded",
        "ambient_authority_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "projection_ref": { "$ref": "#/$defs/opaque_id" },
        "surface_packet_id_ref": { "$ref": "#/$defs/opaque_id" },
        "rendered_at": { "$ref": "#/$defs/timestamp" },
        "preserves_same_packet": { "type": "boolean" },
        "preserves_surface_vocabulary": { "type": "boolean" },
        "preserves_cluster_lane_vocabulary": { "type": "boolean" },
        "preserves_support_class_vocabulary": { "type": "boolean" },
        "preserves_diagnostic_source_vocabulary": { "type": "boolean" },
        "preserves_cluster_provenance_vocabulary": { "type": "boolean" },
        "preserves_source_differentiation_vocabulary": { "type": "boolean" },
        "preserves_detail_sheet_route_vocabulary": { "type": "boolean" },
        "preserves_semantic_layer_banner_vocabulary": { "type": "boolean" },
        "preserves_freshness_vocabulary": { "type": "boolean" },
        "preserves_scope_label_vocabulary": { "type": "boolean" },
        "preserves_provider_family_vocabulary": { "type": "boolean" },
        "preserves_conflict_vocabulary": { "type": "boolean" },
        "preserves_provider_disagreement_visibility_vocabulary": { "type": "boolean" },
        "preserves_fix_offer_vocabulary": { "type": "boolean" },
        "preserves_completeness_vocabulary": { "type": "boolean" },
        "preserves_evidence_class_vocabulary": { "type": "boolean" },
        "preserves_known_limit_vocabulary": { "type": "boolean" },
        "preserves_downgrade_automation_vocabulary": { "type": "boolean" },
        "supports_json_export": { "type": "boolean" },
        "raw_private_material_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" }
      }
    },

    "diagnostic_cluster_semantic_layer_truth_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "workflow_or_surface_id",
        "generated_at",
        "covered_surfaces",
        "rows",
        "consumer_projections",
        "source_contract_refs",
        "promotion_state"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "diagnostic_cluster_semantic_layer_truth_stable_packet"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "workflow_or_surface_id": { "$ref": "#/$defs/opaque_id" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "covered_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_class" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic_cluster_row" }
        },
        "consumer_projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic_cluster_consumer_projection" }
        },
        "source_contract_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "validation_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    }
  }
}
