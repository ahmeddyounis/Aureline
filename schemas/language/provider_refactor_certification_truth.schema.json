{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/language/provider_refactor_certification_truth.schema.json",
  "title": "Aureline provider-arbitration, diagnostic-convergence, and refactor preview/rollback certification truth packet",
  "description": "Boundary schema for the stable provider/refactor certification truth packet. The packet is the language-owned exit-gate contract that certifies — on every claimed framework-pack, notebook-cell, generated-source, structured-artifact, and code-understanding-graph lane — that the provider-arbitration, diagnostic-convergence, and refactor preview/rollback truth the matrix froze is proven by checked-in fixture-repo, notebook/generated/config, partial-scope, provider crash/quarantine, and rollback-determinism drills before the lane keeps a certified grade. A lane whose arbitration or refactor truth is unproven, stale, or downgraded narrows automatically rather than inheriting the broader framework-pack marketing language. The packet is the single certification truth that the framework-pack panel, structured-artifact runner, preview surface, compatibility report, archetype scorecard, release-narrowing automation, support export, Help/About proof card, service-health feed, and conformance dashboard all read; surfaces MUST NOT mint local copies or paraphrase certification verdicts.",
  "type": "object",
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "workflow_or_surface_id",
    "generated_at",
    "covered_lanes",
    "rows",
    "consumer_projections",
    "promotion_state",
    "validation_findings"
  ],
  "properties": {
    "record_kind": { "const": "provider_refactor_certification_truth_stable_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "workflow_or_surface_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" },
    "covered_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact_family_lane_class" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "consumer_projections": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "source_contract_refs": { "$ref": "#/$defs/ref_array" },
    "promotion_state": { "$ref": "#/$defs/promotion_state" },
    "validation_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_finding" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "uniqueItems": true
    },
    "artifact_family_lane_class": {
      "enum": [
        "framework_pack_lane",
        "notebook_cell_lane",
        "generated_source_lane",
        "structured_artifact_lane",
        "code_understanding_graph_lane"
      ]
    },
    "certification_row_class": {
      "enum": [
        "lane_certification",
        "provider_arbitration_certification",
        "diagnostic_convergence_certification",
        "refactor_preview_certification",
        "rollback_determinism_certification",
        "generated_artifact_policy_certification",
        "evidence_drill_admission",
        "known_limit",
        "downgrade_automation",
        "unsupported_gap"
      ]
    },
    "support_class": {
      "enum": [
        "certified",
        "certified_below",
        "beta_grade_only",
        "preview_only",
        "unsupported",
        "support_unbound"
      ]
    },
    "provider_family_class": {
      "enum": [
        "lsp_provider",
        "framework_analyzer",
        "semantic_graph_lane",
        "notebook_adapter",
        "generated_source_bridge",
        "ai_overlay",
        "text_fallback",
        "not_applicable",
        "provider_unbound"
      ]
    },
    "certification_verdict_class": {
      "enum": [
        "certified",
        "provisionally_certified",
        "narrowed_below_certified",
        "blocked_pending_evidence",
        "withdrawn",
        "not_applicable",
        "verdict_unbound"
      ]
    },
    "arbitration_proof_class": {
      "enum": [
        "single_provider_no_conflict",
        "agreement_and_disagreement_proven",
        "disagreement_winner_loser_preserved",
        "downgrade_honesty_proven",
        "provider_crash_quarantine_proven",
        "not_applicable",
        "proof_unbound"
      ]
    },
    "conflict_class": {
      "enum": [
        "single_provider_no_conflict",
        "arbitrated_winner_loser_preserved",
        "unresolved_disagreement_surfaced",
        "policy_override_recorded",
        "not_applicable",
        "conflict_unbound"
      ]
    },
    "convergence_proof_class": {
      "enum": [
        "single_source_no_convergence",
        "multi_source_converged_labeled",
        "provenance_preserved_per_source",
        "suppression_state_preserved",
        "freshness_labeled",
        "not_applicable",
        "proof_unbound"
      ]
    },
    "refactor_transaction_class": {
      "enum": [
        "rename",
        "extract",
        "inline",
        "move",
        "organize_imports",
        "schema_codegen_rewrite",
        "ai_planned_transform",
        "notebook_generated_edit",
        "compare_only_no_mutation",
        "not_applicable",
        "refactor_unbound"
      ]
    },
    "completeness_class": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "unsupported",
        "not_applicable",
        "completeness_unbound"
      ]
    },
    "rollback_path_class": {
      "enum": [
        "exact_undo_via_local_history_checkpoint",
        "compensating_revert_via_workspace_diff",
        "grouped_mutation_journal_revert",
        "regenerate_first_then_replay",
        "manual_review_required_no_automatic_path",
        "no_safe_rollback_available",
        "not_applicable",
        "rollback_unbound"
      ]
    },
    "rollback_determinism_class": {
      "enum": [
        "deterministic_rollback_proven",
        "checkpoint_replay_verified",
        "regeneration_replay_verified",
        "manual_review_only",
        "nondeterministic_unsafe",
        "not_applicable",
        "determinism_unbound"
      ]
    },
    "generated_artifact_policy_class": {
      "enum": [
        "not_generated",
        "regenerate_before_edit",
        "edit_with_regeneration_replay",
        "edit_blocked_generated_source",
        "compare_only_generated",
        "not_applicable",
        "policy_unbound"
      ]
    },
    "evidence_drill_class": {
      "enum": [
        "fixture_repo_drill",
        "notebook_case_drill",
        "generated_case_drill",
        "config_case_drill",
        "partial_scope_drill",
        "provider_crash_quarantine_drill",
        "rollback_determinism_drill",
        "not_applicable",
        "drill_unbound"
      ]
    },
    "evidence_class": {
      "enum": [
        "archetype_repo_evidence",
        "framework_migration_evidence",
        "design_partner_evidence",
        "fixture_repo_evidence",
        "conformance_suite_evidence",
        "benchmark_evidence",
        "docs_disclosure_evidence",
        "evidence_unbound"
      ]
    },
    "known_limit_class": {
      "enum": [
        "none_declared",
        "provider_family_subset_only",
        "artifact_family_subset_only",
        "semantic_mode_subset_only",
        "refactor_class_subset_only",
        "generated_policy_subset_only",
        "diagnostic_source_subset_only",
        "compare_only_no_mutation_limit",
        "unsupported_runtime_target",
        "beta_capability_sample_only",
        "limit_unbound"
      ]
    },
    "downgrade_automation_class": {
      "enum": [
        "none",
        "auto_narrow_on_missing_fixture",
        "auto_narrow_on_provider_unavailable",
        "auto_narrow_on_conflict_unresolved",
        "auto_narrow_on_preview_partial",
        "auto_narrow_on_stale_provenance",
        "auto_demote_on_low_confidence",
        "auto_block_on_missing_evidence",
        "manual_only_pending_review",
        "automation_unbound"
      ]
    },
    "confidence_class": {
      "enum": ["high_confidence", "medium_confidence", "low_confidence"]
    },
    "promotion_state": {
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "finding_severity": { "enum": ["info", "warning", "blocker"] },
    "finding_kind": {
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_identity",
        "missing_artifact_family_lane_coverage",
        "missing_provider_arbitration_coverage",
        "missing_diagnostic_convergence_coverage",
        "missing_refactor_preview_coverage",
        "missing_rollback_determinism_coverage",
        "missing_generated_artifact_policy_coverage",
        "missing_evidence_drill_coverage",
        "missing_required_evidence_drill",
        "missing_support_class",
        "missing_provider_family",
        "missing_known_limit",
        "missing_downgrade_automation",
        "missing_evidence_class",
        "missing_verdict_class",
        "missing_arbitration_proof_class",
        "missing_conflict_class",
        "missing_convergence_proof_class",
        "missing_refactor_transaction_class",
        "missing_completeness_class",
        "missing_rollback_path_class",
        "missing_rollback_determinism_class",
        "missing_generated_artifact_policy_class",
        "missing_evidence_drill_class",
        "certified_with_unbound_binding",
        "verdict_support_mismatch",
        "narrowed_row_missing_disclosure_ref",
        "known_limit_missing_disclosure_ref",
        "downgrade_automation_missing_disclosure_ref",
        "missing_evidence_refs",
        "verdict_not_permitted_on_row_class",
        "arbitration_proof_not_permitted_on_row_class",
        "conflict_not_permitted_on_row_class",
        "convergence_proof_not_permitted_on_row_class",
        "refactor_transaction_not_permitted_on_row_class",
        "completeness_not_permitted_on_row_class",
        "rollback_path_not_permitted_on_row_class",
        "rollback_determinism_not_permitted_on_row_class",
        "generated_artifact_policy_not_permitted_on_row_class",
        "evidence_drill_not_permitted_on_row_class",
        "mutation_bypasses_preview_or_rollback",
        "rollback_determinism_not_proven",
        "disagreement_collapsed_to_ranking_only",
        "raw_source_material_present",
        "secrets_present",
        "ambient_authority_present",
        "missing_consumer_projection",
        "consumer_projection_drift",
        "lane_vocabulary_collapsed",
        "row_class_vocabulary_collapsed",
        "support_class_vocabulary_collapsed",
        "provider_family_vocabulary_collapsed",
        "verdict_vocabulary_collapsed",
        "arbitration_proof_vocabulary_collapsed",
        "conflict_vocabulary_collapsed",
        "convergence_proof_vocabulary_collapsed",
        "refactor_transaction_vocabulary_collapsed",
        "completeness_vocabulary_collapsed",
        "rollback_path_vocabulary_collapsed",
        "rollback_determinism_vocabulary_collapsed",
        "generated_artifact_policy_vocabulary_collapsed",
        "evidence_drill_vocabulary_collapsed",
        "known_limit_vocabulary_collapsed",
        "downgrade_automation_vocabulary_collapsed",
        "evidence_class_vocabulary_collapsed",
        "promotion_state_mismatch"
      ]
    },
    "certification_row": {
      "type": "object",
      "required": [
        "row_id",
        "lane_class",
        "row_class",
        "support_class",
        "provider_family_class",
        "verdict_class",
        "arbitration_proof_class",
        "conflict_class",
        "convergence_proof_class",
        "refactor_transaction_class",
        "completeness_class",
        "rollback_path_class",
        "rollback_determinism_class",
        "generated_artifact_policy_class",
        "evidence_drill_class",
        "evidence_class",
        "known_limit_class",
        "downgrade_automation_class",
        "confidence_class",
        "disagreement_inspectable",
        "evidence_refs",
        "raw_source_material_excluded",
        "secrets_excluded",
        "ambient_authority_excluded",
        "captured_at"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "lane_class": { "$ref": "#/$defs/artifact_family_lane_class" },
        "row_class": { "$ref": "#/$defs/certification_row_class" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "provider_family_class": { "$ref": "#/$defs/provider_family_class" },
        "verdict_class": { "$ref": "#/$defs/certification_verdict_class" },
        "arbitration_proof_class": { "$ref": "#/$defs/arbitration_proof_class" },
        "conflict_class": { "$ref": "#/$defs/conflict_class" },
        "convergence_proof_class": { "$ref": "#/$defs/convergence_proof_class" },
        "refactor_transaction_class": { "$ref": "#/$defs/refactor_transaction_class" },
        "completeness_class": { "$ref": "#/$defs/completeness_class" },
        "rollback_path_class": { "$ref": "#/$defs/rollback_path_class" },
        "rollback_determinism_class": { "$ref": "#/$defs/rollback_determinism_class" },
        "generated_artifact_policy_class": { "$ref": "#/$defs/generated_artifact_policy_class" },
        "evidence_drill_class": { "$ref": "#/$defs/evidence_drill_class" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "known_limit_class": { "$ref": "#/$defs/known_limit_class" },
        "downgrade_automation_class": { "$ref": "#/$defs/downgrade_automation_class" },
        "confidence_class": { "$ref": "#/$defs/confidence_class" },
        "disagreement_inspectable": { "type": "boolean" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" },
        "disclosure_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_source_material_excluded": { "type": "boolean" },
        "secrets_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" },
        "captured_at": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "consumer_projection": {
      "type": "object",
      "required": [
        "consumer_surface",
        "projection_ref",
        "certification_packet_id_ref",
        "rendered_at",
        "preserves_same_packet",
        "preserves_lane_vocabulary",
        "preserves_row_class_vocabulary",
        "preserves_support_class_vocabulary",
        "preserves_provider_family_vocabulary",
        "preserves_verdict_vocabulary",
        "preserves_arbitration_proof_vocabulary",
        "preserves_conflict_vocabulary",
        "preserves_convergence_proof_vocabulary",
        "preserves_refactor_transaction_vocabulary",
        "preserves_completeness_vocabulary",
        "preserves_rollback_path_vocabulary",
        "preserves_rollback_determinism_vocabulary",
        "preserves_generated_artifact_policy_vocabulary",
        "preserves_evidence_drill_vocabulary",
        "preserves_known_limit_vocabulary",
        "preserves_downgrade_automation_vocabulary",
        "preserves_evidence_class_vocabulary",
        "supports_json_export",
        "raw_private_material_excluded",
        "ambient_authority_excluded"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "framework_pack_panel",
            "structured_artifact_runner",
            "preview_surface",
            "compatibility_report",
            "archetype_scorecard",
            "release_narrowing_automation",
            "support_export",
            "help_about",
            "service_health",
            "conformance_dashboard"
          ]
        },
        "projection_ref": { "$ref": "#/$defs/non_empty_string" },
        "certification_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "rendered_at": { "$ref": "#/$defs/non_empty_string" },
        "preserves_same_packet": { "type": "boolean" },
        "preserves_lane_vocabulary": { "type": "boolean" },
        "preserves_row_class_vocabulary": { "type": "boolean" },
        "preserves_support_class_vocabulary": { "type": "boolean" },
        "preserves_provider_family_vocabulary": { "type": "boolean" },
        "preserves_verdict_vocabulary": { "type": "boolean" },
        "preserves_arbitration_proof_vocabulary": { "type": "boolean" },
        "preserves_conflict_vocabulary": { "type": "boolean" },
        "preserves_convergence_proof_vocabulary": { "type": "boolean" },
        "preserves_refactor_transaction_vocabulary": { "type": "boolean" },
        "preserves_completeness_vocabulary": { "type": "boolean" },
        "preserves_rollback_path_vocabulary": { "type": "boolean" },
        "preserves_rollback_determinism_vocabulary": { "type": "boolean" },
        "preserves_generated_artifact_policy_vocabulary": { "type": "boolean" },
        "preserves_evidence_drill_vocabulary": { "type": "boolean" },
        "preserves_known_limit_vocabulary": { "type": "boolean" },
        "preserves_downgrade_automation_vocabulary": { "type": "boolean" },
        "preserves_evidence_class_vocabulary": { "type": "boolean" },
        "supports_json_export": { "type": "boolean" },
        "raw_private_material_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "validation_finding": {
      "type": "object",
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/finding_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    }
  }
}
