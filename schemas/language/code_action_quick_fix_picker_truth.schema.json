{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/language/code_action_quick_fix_picker_truth.schema.json",
  "title": "Aureline code-action and quick-fix picker truth packet",
  "description": "Boundary schema for the stable code-action / quick-fix picker truth packet. The packet freezes, for each new M5 artifact family (framework pack, notebook cell, docs artifact, request/structured artifact, config artifact, and generated source), the acting provider, apply posture (inline-safe, preview-required, compare-only, or blocked-pending-review), mutation scope, validation hook, generated-asset policy, fallback / manual path, provider-disagreement visibility, and rollback checkpoint route its code-action and quick-fix entries may claim. It extends, and never weakens, the launch-language refactor safety model: a one-click inline apply may not widen into generated or structured artifacts without a preview, a preview-required action must export a preview hash and a typed completeness label, a mutating apply must export a rollback checkpoint ref, provider disagreement may not collapse to ranking-only output, and a low-confidence provider may not hide its manual-fix guidance. The packet is the single truth that the code-action picker, quick-fix picker, framework-pack panel, notebook surface, request runner, preview surface, generated-artifact surface, support export, release proof index, Help/About proof card, and conformance dashboard all read; surfaces MUST NOT mint local copies or paraphrase picker posture. The packet is metadata-only and carries no raw source bodies, generated artifact bodies, notebook outputs, provider payloads, secrets, or ambient credentials.",
  "type": "object",
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "workflow_or_surface_id",
    "generated_at",
    "covered_lanes",
    "rows",
    "consumer_projections",
    "promotion_state",
    "validation_findings"
  ],
  "properties": {
    "record_kind": { "const": "code_action_quick_fix_picker_truth_stable_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "workflow_or_surface_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" },
    "covered_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact_family_lane_class" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/picker_row" }
    },
    "consumer_projections": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "source_contract_refs": { "$ref": "#/$defs/ref_array" },
    "promotion_state": { "$ref": "#/$defs/promotion_state" },
    "validation_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_finding" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "uniqueItems": true
    },
    "artifact_family_lane_class": {
      "enum": [
        "framework_pack_lane",
        "notebook_cell_lane",
        "docs_artifact_lane",
        "request_artifact_lane",
        "config_artifact_lane",
        "generated_source_lane"
      ]
    },
    "picker_row_class": {
      "enum": [
        "picker_lane_quality",
        "apply_posture_admission",
        "generated_asset_policy_admission",
        "fallback_path_admission",
        "provider_disagreement_admission",
        "rollback_checkpoint_admission",
        "unsupported_gap",
        "known_limit",
        "downgrade_automation"
      ]
    },
    "support_class": {
      "enum": [
        "certified",
        "certified_below",
        "beta_grade_only",
        "preview_only",
        "unsupported",
        "support_unbound"
      ]
    },
    "provider_family_class": {
      "enum": [
        "lsp_provider",
        "framework_analyzer",
        "semantic_graph_lane",
        "notebook_adapter",
        "generated_source_bridge",
        "ai_overlay",
        "text_fallback",
        "not_applicable",
        "provider_unbound"
      ]
    },
    "apply_posture_class": {
      "enum": [
        "inline_safe",
        "preview_required",
        "compare_only",
        "blocked_pending_review",
        "not_applicable",
        "posture_unbound"
      ]
    },
    "mutation_scope_class": {
      "enum": [
        "no_mutation",
        "single_file_scope",
        "multi_file_scope",
        "cross_artifact_scope",
        "generated_artifact_scope",
        "structured_artifact_scope",
        "workspace_wide_scope",
        "not_applicable",
        "scope_unbound"
      ]
    },
    "validation_hook_class": {
      "enum": [
        "none_required",
        "build_check",
        "test_suite",
        "type_check",
        "lint_format",
        "schema_validate",
        "framework_check",
        "manual_review_only",
        "not_applicable",
        "hook_unbound"
      ]
    },
    "generated_artifact_policy_class": {
      "enum": [
        "not_generated",
        "regenerate_before_edit",
        "edit_with_regeneration_replay",
        "edit_blocked_generated_source",
        "compare_only_generated",
        "not_applicable",
        "policy_unbound"
      ]
    },
    "fallback_path_class": {
      "enum": [
        "none_needed",
        "manual_fix_guidance",
        "repair_guidance_surfaced",
        "regenerate_first_guidance",
        "broaden_review_guidance",
        "disabled_no_fallback",
        "not_applicable",
        "fallback_unbound"
      ]
    },
    "disagreement_visibility_class": {
      "enum": [
        "single_provider_no_disagreement",
        "winner_loser_both_inspectable",
        "unresolved_surfaced",
        "policy_override_recorded",
        "ranking_only_collapsed",
        "not_applicable",
        "visibility_unbound"
      ]
    },
    "rollback_path_class": {
      "enum": [
        "exact_undo_via_local_history_checkpoint",
        "compensating_revert_via_workspace_diff",
        "grouped_mutation_journal_revert",
        "regenerate_first_then_replay",
        "manual_review_required_no_automatic_path",
        "no_safe_rollback_available",
        "not_applicable",
        "rollback_unbound"
      ]
    },
    "completeness_class": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "unsupported",
        "not_applicable",
        "completeness_unbound"
      ]
    },
    "evidence_class": {
      "enum": [
        "archetype_repo_evidence",
        "framework_migration_evidence",
        "design_partner_evidence",
        "fixture_repo_evidence",
        "conformance_suite_evidence",
        "benchmark_evidence",
        "docs_disclosure_evidence",
        "evidence_unbound"
      ]
    },
    "known_limit_class": {
      "enum": [
        "none_declared",
        "provider_family_subset_only",
        "artifact_family_subset_only",
        "semantic_mode_subset_only",
        "refactor_class_subset_only",
        "generated_policy_subset_only",
        "diagnostic_source_subset_only",
        "compare_only_no_mutation_limit",
        "unsupported_runtime_target",
        "beta_capability_sample_only",
        "limit_unbound"
      ]
    },
    "downgrade_automation_class": {
      "enum": [
        "none",
        "auto_narrow_on_missing_fixture",
        "auto_narrow_on_provider_unavailable",
        "auto_narrow_on_conflict_unresolved",
        "auto_narrow_on_preview_partial",
        "auto_narrow_on_stale_provenance",
        "auto_demote_on_low_confidence",
        "auto_block_on_missing_evidence",
        "manual_only_pending_review",
        "automation_unbound"
      ]
    },
    "confidence_class": {
      "enum": ["high_confidence", "medium_confidence", "low_confidence"]
    },
    "consumer_surface": {
      "enum": [
        "framework_pack_panel",
        "notebook_surface",
        "request_runner",
        "preview_surface",
        "docs_surface",
        "generated_artifact_surface",
        "support_export",
        "release_proof_index",
        "help_about",
        "conformance_dashboard"
      ]
    },
    "promotion_state": {
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "finding_severity": {
      "enum": ["info", "warning", "blocker"]
    },
    "picker_row": {
      "type": "object",
      "required": [
        "row_id",
        "lane_class",
        "row_class",
        "support_class",
        "acting_provider_class",
        "apply_posture_class",
        "mutation_scope_class",
        "validation_hook_class",
        "generated_asset_policy_class",
        "fallback_path_class",
        "disagreement_visibility_class",
        "rollback_checkpoint_class",
        "preview_completeness_class",
        "evidence_class",
        "known_limit_class",
        "downgrade_automation_class",
        "confidence_class",
        "raw_source_material_excluded",
        "secrets_excluded",
        "ambient_authority_excluded",
        "captured_at"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "lane_class": { "$ref": "#/$defs/artifact_family_lane_class" },
        "row_class": { "$ref": "#/$defs/picker_row_class" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "acting_provider_class": { "$ref": "#/$defs/provider_family_class" },
        "apply_posture_class": { "$ref": "#/$defs/apply_posture_class" },
        "mutation_scope_class": { "$ref": "#/$defs/mutation_scope_class" },
        "validation_hook_class": { "$ref": "#/$defs/validation_hook_class" },
        "generated_asset_policy_class": { "$ref": "#/$defs/generated_artifact_policy_class" },
        "fallback_path_class": { "$ref": "#/$defs/fallback_path_class" },
        "disagreement_visibility_class": { "$ref": "#/$defs/disagreement_visibility_class" },
        "rollback_checkpoint_class": { "$ref": "#/$defs/rollback_path_class" },
        "preview_completeness_class": { "$ref": "#/$defs/completeness_class" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "known_limit_class": { "$ref": "#/$defs/known_limit_class" },
        "downgrade_automation_class": { "$ref": "#/$defs/downgrade_automation_class" },
        "confidence_class": { "$ref": "#/$defs/confidence_class" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" },
        "disclosure_ref": { "$ref": "#/$defs/non_empty_string" },
        "acting_provider_label": { "$ref": "#/$defs/non_empty_string" },
        "preview_hash_ref": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_source_material_excluded": { "type": "boolean" },
        "secrets_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" },
        "captured_at": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "consumer_projection": {
      "type": "object",
      "required": [
        "consumer_surface",
        "projection_ref",
        "picker_packet_id_ref",
        "rendered_at",
        "preserves_same_packet",
        "preserves_lane_vocabulary",
        "preserves_row_class_vocabulary",
        "preserves_support_class_vocabulary",
        "preserves_acting_provider_vocabulary",
        "preserves_apply_posture_vocabulary",
        "preserves_mutation_scope_vocabulary",
        "preserves_validation_hook_vocabulary",
        "preserves_generated_asset_policy_vocabulary",
        "preserves_fallback_path_vocabulary",
        "preserves_disagreement_visibility_vocabulary",
        "preserves_rollback_checkpoint_vocabulary",
        "preserves_preview_completeness_vocabulary",
        "preserves_known_limit_vocabulary",
        "preserves_downgrade_automation_vocabulary",
        "preserves_evidence_class_vocabulary",
        "supports_json_export",
        "raw_private_material_excluded",
        "ambient_authority_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "projection_ref": { "$ref": "#/$defs/non_empty_string" },
        "picker_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "rendered_at": { "$ref": "#/$defs/non_empty_string" },
        "preserves_same_packet": { "type": "boolean" },
        "preserves_lane_vocabulary": { "type": "boolean" },
        "preserves_row_class_vocabulary": { "type": "boolean" },
        "preserves_support_class_vocabulary": { "type": "boolean" },
        "preserves_acting_provider_vocabulary": { "type": "boolean" },
        "preserves_apply_posture_vocabulary": { "type": "boolean" },
        "preserves_mutation_scope_vocabulary": { "type": "boolean" },
        "preserves_validation_hook_vocabulary": { "type": "boolean" },
        "preserves_generated_asset_policy_vocabulary": { "type": "boolean" },
        "preserves_fallback_path_vocabulary": { "type": "boolean" },
        "preserves_disagreement_visibility_vocabulary": { "type": "boolean" },
        "preserves_rollback_checkpoint_vocabulary": { "type": "boolean" },
        "preserves_preview_completeness_vocabulary": { "type": "boolean" },
        "preserves_known_limit_vocabulary": { "type": "boolean" },
        "preserves_downgrade_automation_vocabulary": { "type": "boolean" },
        "preserves_evidence_class_vocabulary": { "type": "boolean" },
        "supports_json_export": { "type": "boolean" },
        "raw_private_material_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "finding_kind": {
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_identity",
        "missing_artifact_family_lane_coverage",
        "missing_apply_posture_coverage",
        "missing_generated_asset_policy_coverage",
        "missing_fallback_path_coverage",
        "missing_provider_disagreement_coverage",
        "missing_rollback_checkpoint_coverage",
        "missing_support_class",
        "missing_acting_provider",
        "missing_known_limit",
        "missing_downgrade_automation",
        "missing_evidence_class",
        "missing_apply_posture_class",
        "missing_mutation_scope_class",
        "missing_validation_hook_class",
        "missing_generated_asset_policy_class",
        "missing_fallback_path_class",
        "missing_disagreement_visibility_class",
        "missing_rollback_checkpoint_class",
        "certified_with_unbound_binding",
        "narrowed_row_missing_disclosure_ref",
        "known_limit_missing_disclosure_ref",
        "downgrade_automation_missing_disclosure_ref",
        "missing_evidence_refs",
        "apply_posture_not_applicable",
        "apply_posture_not_permitted_on_row_class",
        "mutation_scope_not_applicable",
        "mutation_scope_not_permitted_on_row_class",
        "validation_hook_not_applicable",
        "validation_hook_not_permitted_on_row_class",
        "generated_asset_policy_not_applicable",
        "generated_asset_policy_not_permitted_on_row_class",
        "fallback_path_not_applicable",
        "fallback_path_not_permitted_on_row_class",
        "disagreement_visibility_not_applicable",
        "disagreement_visibility_not_permitted_on_row_class",
        "rollback_checkpoint_not_applicable",
        "rollback_checkpoint_not_permitted_on_row_class",
        "inline_apply_widens_scope_without_preview",
        "missing_preview_hash_ref",
        "missing_preview_completeness_label",
        "missing_checkpoint_ref",
        "missing_acting_provider_label",
        "disagreement_collapsed_to_ranking_only",
        "manual_fix_guidance_hidden",
        "raw_source_material_present",
        "secrets_present",
        "ambient_authority_present",
        "missing_consumer_projection",
        "consumer_projection_drift",
        "lane_vocabulary_collapsed",
        "row_class_vocabulary_collapsed",
        "support_class_vocabulary_collapsed",
        "acting_provider_vocabulary_collapsed",
        "apply_posture_vocabulary_collapsed",
        "mutation_scope_vocabulary_collapsed",
        "validation_hook_vocabulary_collapsed",
        "generated_asset_policy_vocabulary_collapsed",
        "fallback_path_vocabulary_collapsed",
        "disagreement_visibility_vocabulary_collapsed",
        "rollback_checkpoint_vocabulary_collapsed",
        "preview_completeness_vocabulary_collapsed",
        "known_limit_vocabulary_collapsed",
        "downgrade_automation_vocabulary_collapsed",
        "evidence_class_vocabulary_collapsed",
        "promotion_state_mismatch"
      ]
    },
    "validation_finding": {
      "type": "object",
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/finding_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    }
  }
}
