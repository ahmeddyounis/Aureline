{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/language/wide_scope_refactor_fallback_truth.schema.json",
  "title": "Aureline wide-scope refactor fallback truth packet",
  "description": "Boundary schema for the stable wide-scope refactor fallback truth packet. The packet certifies the safe fallback posture a wide-scope or low-confidence transform takes instead of an apply-all on the live workspace, across the M5 artifact families (framework pack, notebook cell, docs artifact, request/structured artifact, config artifact, and generated source). Each lane carries the acting engine identity, the apply posture (side-branch, worktree, staged, compare-only, blocked, or — only when scope is narrow, completeness is complete, and confidence is high — apply-all on the live workspace), co-bound with the target scope, the typed completeness label, the confidence tier, and the missing-scope count; an impact packet with impacted target/owner counts, an impact summary, and a missing-scope explanation; a reviewer/owner hint with a review anchor; a rollback path with a checkpoint ref; a support-export parity posture preserving the refactor lineage and missing-scope explanation; and a provider-disagreement visibility. It extends, and never weakens, the launch-language refactor safety model: apply-all on the live workspace is refused once confidence or completeness falls below the frozen threshold or the scope is wide, an impact packet must preserve the missing-scope explanation, a reviewer hint must export a review anchor and owner hint, a writing fallback must carry a safe rollback path with a checkpoint ref, support/export must preserve the refactor lineage and missing-scope explanation, and provider disagreement may not collapse to ranking-only output. The packet is the single truth that the framework-pack panel, notebook surface, request runner, preview surface, docs surface, generated-artifact surface, support export, release proof index, Help/About proof card, and conformance dashboard all read; surfaces MUST NOT mint local copies or paraphrase fallback posture. The packet is metadata-only and carries no raw source bodies, refactor diffs, generated artifact bodies, notebook outputs, provider payloads, secrets, or ambient credentials.",
  "type": "object",
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "workflow_or_surface_id",
    "generated_at",
    "covered_lanes",
    "rows",
    "consumer_projections",
    "promotion_state",
    "validation_findings"
  ],
  "properties": {
    "record_kind": { "const": "wide_scope_refactor_fallback_truth_stable_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "workflow_or_surface_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" },
    "covered_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact_family_lane_class" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fallback_row" }
    },
    "consumer_projections": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "source_contract_refs": { "$ref": "#/$defs/ref_array" },
    "promotion_state": { "$ref": "#/$defs/promotion_state" },
    "validation_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_finding" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "uniqueItems": true
    },
    "artifact_family_lane_class": {
      "enum": [
        "framework_pack_lane",
        "notebook_cell_lane",
        "docs_artifact_lane",
        "request_artifact_lane",
        "config_artifact_lane",
        "generated_source_lane"
      ]
    },
    "fallback_row_class": {
      "enum": [
        "fallback_lane_quality",
        "apply_posture_admission",
        "impact_packet_admission",
        "reviewer_hint_admission",
        "rollback_path_admission",
        "support_export_parity_admission",
        "provider_disagreement_admission",
        "unsupported_gap",
        "known_limit",
        "downgrade_automation"
      ]
    },
    "support_class": {
      "enum": [
        "certified",
        "certified_below",
        "beta_grade_only",
        "preview_only",
        "unsupported",
        "support_unbound"
      ]
    },
    "provider_family_class": {
      "enum": [
        "lsp_provider",
        "framework_analyzer",
        "semantic_graph_lane",
        "notebook_adapter",
        "generated_source_bridge",
        "ai_overlay",
        "text_fallback",
        "not_applicable",
        "provider_unbound"
      ]
    },
    "refactor_transaction_class": {
      "enum": [
        "rename",
        "extract",
        "inline",
        "move",
        "organize_imports",
        "schema_codegen_rewrite",
        "ai_planned_transform",
        "notebook_generated_edit",
        "compare_only_no_mutation",
        "not_applicable",
        "refactor_unbound"
      ]
    },
    "apply_fallback_posture_class": {
      "enum": [
        "side_branch_apply",
        "worktree_apply",
        "staged_apply",
        "compare_only_review",
        "apply_all_on_live_workspace",
        "blocked_pending_review",
        "not_applicable",
        "posture_unbound"
      ]
    },
    "mutation_scope_class": {
      "enum": [
        "no_mutation",
        "single_file_scope",
        "multi_file_scope",
        "cross_artifact_scope",
        "generated_artifact_scope",
        "structured_artifact_scope",
        "workspace_wide_scope",
        "not_applicable",
        "scope_unbound"
      ]
    },
    "completeness_class": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "unsupported",
        "not_applicable",
        "completeness_unbound"
      ]
    },
    "confidence_class": {
      "enum": ["high_confidence", "medium_confidence", "low_confidence"]
    },
    "reviewer_hint_class": {
      "enum": [
        "codeowners_reviewer",
        "recent_author_reviewer",
        "owning_team_reviewer",
        "manual_assignment_required",
        "no_reviewer_required",
        "not_applicable",
        "hint_unbound"
      ]
    },
    "rollback_path_class": {
      "enum": [
        "exact_undo_via_local_history_checkpoint",
        "compensating_revert_via_workspace_diff",
        "grouped_mutation_journal_revert",
        "regenerate_first_then_replay",
        "manual_review_required_no_automatic_path",
        "no_safe_rollback_available",
        "not_applicable",
        "rollback_unbound"
      ]
    },
    "disagreement_visibility_class": {
      "enum": [
        "single_provider_no_disagreement",
        "winner_loser_both_inspectable",
        "unresolved_surfaced",
        "policy_override_recorded",
        "ranking_only_collapsed",
        "not_applicable",
        "visibility_unbound"
      ]
    },
    "evidence_class": {
      "enum": [
        "archetype_repo_evidence",
        "framework_migration_evidence",
        "design_partner_evidence",
        "fixture_repo_evidence",
        "conformance_suite_evidence",
        "benchmark_evidence",
        "docs_disclosure_evidence",
        "evidence_unbound"
      ]
    },
    "known_limit_class": {
      "enum": [
        "none_declared",
        "provider_family_subset_only",
        "artifact_family_subset_only",
        "semantic_mode_subset_only",
        "refactor_class_subset_only",
        "generated_policy_subset_only",
        "diagnostic_source_subset_only",
        "compare_only_no_mutation_limit",
        "unsupported_runtime_target",
        "beta_capability_sample_only",
        "limit_unbound"
      ]
    },
    "downgrade_automation_class": {
      "enum": [
        "none",
        "auto_narrow_on_missing_fixture",
        "auto_narrow_on_provider_unavailable",
        "auto_narrow_on_conflict_unresolved",
        "auto_narrow_on_preview_partial",
        "auto_narrow_on_stale_provenance",
        "auto_demote_on_low_confidence",
        "auto_block_on_missing_evidence",
        "manual_only_pending_review",
        "automation_unbound"
      ]
    },
    "consumer_surface": {
      "enum": [
        "framework_pack_panel",
        "notebook_surface",
        "request_runner",
        "preview_surface",
        "docs_surface",
        "generated_artifact_surface",
        "support_export",
        "release_proof_index",
        "help_about",
        "conformance_dashboard"
      ]
    },
    "promotion_state": {
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "finding_severity": {
      "enum": ["info", "warning", "blocker"]
    },
    "fallback_row": {
      "type": "object",
      "required": [
        "row_id",
        "lane_class",
        "row_class",
        "refactor_id",
        "support_class",
        "acting_provider_class",
        "refactor_class",
        "apply_posture_class",
        "target_scope_class",
        "scope_completeness_class",
        "confidence_class",
        "missing_scope_count",
        "impacted_target_count",
        "impacted_owner_count",
        "impact_summary_present",
        "missing_scope_explanation_present",
        "reviewer_hint_class",
        "owner_hint_present",
        "rollback_path_class",
        "preserves_refactor_lineage",
        "preserves_missing_scope_explanation",
        "disagreement_visibility_class",
        "evidence_class",
        "known_limit_class",
        "downgrade_automation_class",
        "raw_source_material_excluded",
        "secrets_excluded",
        "ambient_authority_excluded",
        "captured_at"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "lane_class": { "$ref": "#/$defs/artifact_family_lane_class" },
        "row_class": { "$ref": "#/$defs/fallback_row_class" },
        "refactor_id": { "$ref": "#/$defs/non_empty_string" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "acting_provider_class": { "$ref": "#/$defs/provider_family_class" },
        "refactor_class": { "$ref": "#/$defs/refactor_transaction_class" },
        "apply_posture_class": { "$ref": "#/$defs/apply_fallback_posture_class" },
        "target_scope_class": { "$ref": "#/$defs/mutation_scope_class" },
        "scope_completeness_class": { "$ref": "#/$defs/completeness_class" },
        "confidence_class": { "$ref": "#/$defs/confidence_class" },
        "missing_scope_count": { "type": "integer", "minimum": 0 },
        "impacted_target_count": { "type": "integer", "minimum": 0 },
        "impacted_owner_count": { "type": "integer", "minimum": 0 },
        "impact_summary_present": { "type": "boolean" },
        "missing_scope_explanation_present": { "type": "boolean" },
        "reviewer_hint_class": { "$ref": "#/$defs/reviewer_hint_class" },
        "owner_hint_present": { "type": "boolean" },
        "rollback_path_class": { "$ref": "#/$defs/rollback_path_class" },
        "preserves_refactor_lineage": { "type": "boolean" },
        "preserves_missing_scope_explanation": { "type": "boolean" },
        "disagreement_visibility_class": { "$ref": "#/$defs/disagreement_visibility_class" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "known_limit_class": { "$ref": "#/$defs/known_limit_class" },
        "downgrade_automation_class": { "$ref": "#/$defs/downgrade_automation_class" },
        "evidence_refs": { "$ref": "#/$defs/ref_array" },
        "disclosure_ref": { "$ref": "#/$defs/non_empty_string" },
        "engine_identity_label": { "$ref": "#/$defs/non_empty_string" },
        "impact_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "review_anchor_ref": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_ref": { "$ref": "#/$defs/non_empty_string" },
        "lineage_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_source_material_excluded": { "type": "boolean" },
        "secrets_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" },
        "captured_at": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "consumer_projection": {
      "type": "object",
      "required": [
        "consumer_surface",
        "projection_ref",
        "fallback_packet_id_ref",
        "rendered_at",
        "preserves_same_packet",
        "preserves_lane_vocabulary",
        "preserves_row_class_vocabulary",
        "preserves_support_class_vocabulary",
        "preserves_engine_identity_vocabulary",
        "preserves_refactor_class_vocabulary",
        "preserves_target_scope_vocabulary",
        "preserves_scope_completeness_vocabulary",
        "preserves_confidence_vocabulary",
        "preserves_apply_posture_vocabulary",
        "preserves_reviewer_hint_vocabulary",
        "preserves_rollback_path_vocabulary",
        "preserves_disagreement_visibility_vocabulary",
        "preserves_known_limit_vocabulary",
        "preserves_downgrade_automation_vocabulary",
        "preserves_evidence_class_vocabulary",
        "supports_json_export",
        "raw_private_material_excluded",
        "ambient_authority_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "projection_ref": { "$ref": "#/$defs/non_empty_string" },
        "fallback_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "rendered_at": { "$ref": "#/$defs/non_empty_string" },
        "preserves_same_packet": { "type": "boolean" },
        "preserves_lane_vocabulary": { "type": "boolean" },
        "preserves_row_class_vocabulary": { "type": "boolean" },
        "preserves_support_class_vocabulary": { "type": "boolean" },
        "preserves_engine_identity_vocabulary": { "type": "boolean" },
        "preserves_refactor_class_vocabulary": { "type": "boolean" },
        "preserves_target_scope_vocabulary": { "type": "boolean" },
        "preserves_scope_completeness_vocabulary": { "type": "boolean" },
        "preserves_confidence_vocabulary": { "type": "boolean" },
        "preserves_apply_posture_vocabulary": { "type": "boolean" },
        "preserves_reviewer_hint_vocabulary": { "type": "boolean" },
        "preserves_rollback_path_vocabulary": { "type": "boolean" },
        "preserves_disagreement_visibility_vocabulary": { "type": "boolean" },
        "preserves_known_limit_vocabulary": { "type": "boolean" },
        "preserves_downgrade_automation_vocabulary": { "type": "boolean" },
        "preserves_evidence_class_vocabulary": { "type": "boolean" },
        "supports_json_export": { "type": "boolean" },
        "raw_private_material_excluded": { "type": "boolean" },
        "ambient_authority_excluded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "finding_kind": {
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_identity",
        "missing_refactor_id",
        "missing_lane_coverage",
        "missing_apply_posture_coverage",
        "missing_impact_packet_coverage",
        "missing_reviewer_hint_coverage",
        "missing_rollback_path_coverage",
        "missing_support_export_parity_coverage",
        "missing_provider_disagreement_coverage",
        "missing_support_class",
        "missing_engine_identity",
        "missing_engine_identity_label",
        "missing_refactor_class",
        "missing_known_limit",
        "missing_downgrade_automation",
        "missing_evidence_class",
        "missing_evidence_refs",
        "missing_apply_posture_class",
        "missing_target_scope_class",
        "missing_scope_completeness_label",
        "missing_reviewer_hint_class",
        "missing_rollback_path_class",
        "missing_disagreement_visibility_class",
        "certified_with_unbound_binding",
        "narrowed_row_missing_disclosure_ref",
        "known_limit_missing_disclosure_ref",
        "downgrade_automation_missing_disclosure_ref",
        "apply_posture_not_applicable",
        "apply_posture_not_permitted_on_row_class",
        "target_scope_not_permitted_on_row_class",
        "reviewer_hint_not_applicable",
        "reviewer_hint_not_permitted_on_row_class",
        "rollback_path_not_applicable",
        "rollback_path_not_permitted_on_row_class",
        "disagreement_visibility_not_applicable",
        "disagreement_visibility_not_permitted_on_row_class",
        "unsafe_apply_all_below_threshold",
        "scope_completeness_overclaimed",
        "empty_impact_packet",
        "missing_impact_summary",
        "missing_impact_packet_ref",
        "impact_packet_drops_missing_scope",
        "missing_review_anchor_ref",
        "missing_owner_hint",
        "missing_checkpoint_ref",
        "writing_fallback_without_safe_rollback",
        "support_export_drops_lineage",
        "support_export_drops_missing_scope",
        "missing_lineage_ref",
        "disagreement_collapsed_to_ranking_only",
        "raw_source_material_present",
        "secrets_present",
        "ambient_authority_present",
        "missing_consumer_projection",
        "consumer_projection_drift",
        "lane_vocabulary_collapsed",
        "row_class_vocabulary_collapsed",
        "support_class_vocabulary_collapsed",
        "engine_identity_vocabulary_collapsed",
        "refactor_class_vocabulary_collapsed",
        "target_scope_vocabulary_collapsed",
        "scope_completeness_vocabulary_collapsed",
        "confidence_vocabulary_collapsed",
        "apply_posture_vocabulary_collapsed",
        "reviewer_hint_vocabulary_collapsed",
        "rollback_path_vocabulary_collapsed",
        "disagreement_visibility_vocabulary_collapsed",
        "known_limit_vocabulary_collapsed",
        "downgrade_automation_vocabulary_collapsed",
        "evidence_class_vocabulary_collapsed",
        "promotion_state_mismatch"
      ]
    },
    "validation_finding": {
      "type": "object",
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/finding_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    }
  }
}
