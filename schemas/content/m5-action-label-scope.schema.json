{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/content/m5-action-label-scope.schema.json",
  "title": "Aureline action-label and count/scope-language parity catalog",
  "description": "Export-safe catalog of the verb-first action labels and count/scope disclosures the shell renders when an action approves, reruns, exports, installs, applies, deletes, or publishes objects. Every action label is verb-first and carries a controlled verb, the object class it narrows, the scope it targets, its mutation-risk class, the review state it carries, and a reference template built from {verb}, {count:<name>}, {scope:<scope_id>}, {object_one}, and {object_many} placeholders that resolve against the verb, scope, and object registries — never an inlined scope word. Count/scope disclosures state how many objects each scope holds using the same controlled phrase set, so a batch bar, a CLI summary, and an export heading cannot hide scope, side effects, or selection class behind a vague verb such as Continue, Accept, or Submit. Machine-facing ids, refs, and placeholders stay locale-neutral while human prose localizes safely around them. Raw provider payloads, credentials, and secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "catalog_id",
    "catalog_label",
    "reference_locale",
    "scope_inventory",
    "surface_inventory",
    "mutation_class_inventory",
    "review_state_inventory",
    "banned_ambiguous_tokens",
    "scopes",
    "verbs",
    "objects",
    "labels",
    "disclosures",
    "shared_scope_phrase_ids",
    "parity_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_action_label_scope_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "reference_locale": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_inventory": {
      "type": "array",
      "const": [
        "selected",
        "visible",
        "loaded",
        "all_matching",
        "hidden_by_policy",
        "outside_current_workset",
        "single_object"
      ]
    },
    "surface_inventory": {
      "type": "array",
      "const": [
        "batch_action_bar",
        "review_sheet",
        "toast_activity_row",
        "cli_help_summary",
        "export_report_heading",
        "confirmation_dialog"
      ]
    },
    "mutation_class_inventory": {
      "type": "array",
      "const": [
        "approval",
        "destructive",
        "batch_mutation",
        "publish",
        "install",
        "export"
      ]
    },
    "review_state_inventory": {
      "type": "array",
      "const": [
        "reviewed",
        "unreviewed_batch",
        "partially_reviewed",
        "review_required",
        "no_review_needed"
      ]
    },
    "banned_ambiguous_tokens": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scope_definition"
      }
    },
    "verbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/verb"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "disclosures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/disclosure"
      }
    },
    "shared_scope_phrase_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/locale_neutral_token"
      }
    },
    "parity_review": {
      "$ref": "#/$defs/parity_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "locale_neutral_token": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+$"
    },
    "nullable_locale_neutral_token": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_.]+$"
    },
    "scope_class": {
      "type": "string",
      "enum": [
        "selected",
        "visible",
        "loaded",
        "all_matching",
        "hidden_by_policy",
        "outside_current_workset",
        "single_object"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "batch_action_bar",
        "review_sheet",
        "toast_activity_row",
        "cli_help_summary",
        "export_report_heading",
        "confirmation_dialog"
      ]
    },
    "mutation_class": {
      "type": "string",
      "enum": [
        "approval",
        "destructive",
        "batch_mutation",
        "publish",
        "install",
        "export"
      ]
    },
    "review_state": {
      "type": "string",
      "enum": [
        "reviewed",
        "unreviewed_batch",
        "partially_reviewed",
        "review_required",
        "no_review_needed"
      ]
    },
    "reversibility": {
      "type": "string",
      "enum": [
        "reversible",
        "undoable_window",
        "irreversible"
      ]
    },
    "count_status": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "partial",
        "cached",
        "stale",
        "streaming",
        "warming",
        "unknown"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "product_ui",
        "cli_help",
        "docs",
        "support_export",
        "screen_reader",
        "activity_feed"
      ]
    },
    "scope_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "scope_class",
        "canonical_phrase",
        "actionable",
        "is_exclusion",
        "requires_count"
      ],
      "properties": {
        "scope_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "scope_class": {
          "$ref": "#/$defs/scope_class"
        },
        "canonical_phrase": {
          "$ref": "#/$defs/non_empty_string"
        },
        "actionable": {
          "type": "boolean"
        },
        "is_exclusion": {
          "type": "boolean"
        },
        "requires_count": {
          "type": "boolean"
        }
      }
    },
    "verb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb_id",
        "canonical_label",
        "reversibility",
        "default_mutation_class"
      ],
      "properties": {
        "verb_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "canonical_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reversibility": {
          "$ref": "#/$defs/reversibility"
        },
        "default_mutation_class": {
          "$ref": "#/$defs/mutation_class"
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "singular_label",
        "plural_label"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "singular_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "plural_label": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_id",
        "verb_ref",
        "object_ref",
        "scope_ref",
        "mutation_class",
        "review_state",
        "surface",
        "count_var",
        "reference_label",
        "scope_unambiguous_in_sheet",
        "discloses_side_effect",
        "screen_reader_label",
        "consumer_surfaces"
      ],
      "properties": {
        "label_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "verb_ref": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "object_ref": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "scope_ref": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "mutation_class": {
          "$ref": "#/$defs/mutation_class"
        },
        "review_state": {
          "$ref": "#/$defs/review_state"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "count_var": {
          "$ref": "#/$defs/nullable_locale_neutral_token"
        },
        "reference_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_unambiguous_in_sheet": {
          "type": "boolean"
        },
        "discloses_side_effect": {
          "type": "boolean"
        },
        "screen_reader_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure_id",
        "surface",
        "object_ref",
        "verb_ref",
        "primary_scope_ref",
        "disclosed_scope_refs",
        "count_status",
        "count_vars",
        "reference_phrase",
        "consumer_surfaces"
      ],
      "properties": {
        "disclosure_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "object_ref": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "verb_ref": {
          "$ref": "#/$defs/nullable_locale_neutral_token"
        },
        "primary_scope_ref": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "disclosed_scope_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale_neutral_token"
          }
        },
        "count_status": {
          "$ref": "#/$defs/count_status"
        },
        "count_vars": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/locale_neutral_token"
          }
        },
        "reference_phrase": {
          "$ref": "#/$defs/non_empty_string"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "parity_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels_are_verb_first",
        "no_ambiguous_primary_labels",
        "scope_declared_or_unambiguous_in_sheet",
        "batch_actions_declare_count",
        "review_state_declared_on_approval_and_batch",
        "object_class_narrowed",
        "one_controlled_scope_phrase_set",
        "side_effects_disclosed",
        "screen_reader_labels_complete",
        "docs_and_export_reuse_runtime_labels"
      ],
      "properties": {
        "labels_are_verb_first": {
          "type": "boolean",
          "const": true
        },
        "no_ambiguous_primary_labels": {
          "type": "boolean",
          "const": true
        },
        "scope_declared_or_unambiguous_in_sheet": {
          "type": "boolean",
          "const": true
        },
        "batch_actions_declare_count": {
          "type": "boolean",
          "const": true
        },
        "review_state_declared_on_approval_and_batch": {
          "type": "boolean",
          "const": true
        },
        "object_class_narrowed": {
          "type": "boolean",
          "const": true
        },
        "one_controlled_scope_phrase_set": {
          "type": "boolean",
          "const": true
        },
        "side_effects_disclosed": {
          "type": "boolean",
          "const": true
        },
        "screen_reader_labels_complete": {
          "type": "boolean",
          "const": true
        },
        "docs_and_export_reuse_runtime_labels": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ui_resolves_through_catalog",
        "cli_help_uses_action_labels",
        "docs_render_action_labels",
        "support_export_uses_action_labels",
        "screen_reader_reuses_labels",
        "activity_feed_reuses_labels"
      ],
      "properties": {
        "product_ui_resolves_through_catalog": {
          "type": "boolean",
          "const": true
        },
        "cli_help_uses_action_labels": {
          "type": "boolean",
          "const": true
        },
        "docs_render_action_labels": {
          "type": "boolean",
          "const": true
        },
        "support_export_uses_action_labels": {
          "type": "boolean",
          "const": true
        },
        "screen_reader_reuses_labels": {
          "type": "boolean",
          "const": true
        },
        "activity_feed_reuses_labels": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
