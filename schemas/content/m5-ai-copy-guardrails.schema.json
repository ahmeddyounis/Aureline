{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/content/m5-ai-copy-guardrails.schema.json",
  "title": "Aureline AI copy guardrails, confidence vocabulary, and forbidden high-trust phrasing",
  "description": "Export-safe catalog of the controlled AI wording the shell renders on trust-sensitive assistant and review surfaces, plus the rejection register that blocks high-trust overclaiming. Approved terms materialize the required taxonomy — Suggested, Proposed, Draft, Context used, Validation, Low confidence, Review required, and Revert/Undo availability — each with one reserved meaning, one locale-neutral machine token, the protected surfaces it governs (prompt composer, patch review, notebook help, docs/help, provider/account), and the reuse consumers (product UI, docs/help, support export, narrated announcement, release/demo) that must reconstruct it. Every approved term is provisional AI wording, and low-confidence and review-required terms suppress direct mutation. Forbidden phrases carry a lowercase pattern, a risk class, and the approved terms that replace them, so Guaranteed, Perfect, Done for you, and No review needed are rejected on every protected surface. Machine-facing ids, tokens, and patterns stay locale-neutral while human prose localizes safely around them. Credentials, raw provider payloads, and secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "catalog_id",
    "catalog_label",
    "reference_locale",
    "domain_inventory",
    "concept_inventory",
    "surface_inventory",
    "consumer_inventory",
    "forbidden_class_inventory",
    "terms",
    "forbidden_phrases",
    "shared_reuse_term_ids",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_ai_copy_guardrail_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "reference_locale": {
      "$ref": "#/$defs/non_empty_string"
    },
    "domain_inventory": {
      "type": "array",
      "const": [
        "proposal_state",
        "confidence",
        "validation",
        "context_disclosure",
        "review_posture",
        "reversibility"
      ]
    },
    "concept_inventory": {
      "type": "array",
      "const": [
        "suggested",
        "proposed",
        "draft",
        "context_used",
        "validation",
        "low_confidence",
        "review_required",
        "revert_undo_available"
      ]
    },
    "surface_inventory": {
      "type": "array",
      "const": [
        "prompt_composer",
        "patch_review",
        "notebook_help",
        "docs_help",
        "provider_account"
      ]
    },
    "consumer_inventory": {
      "type": "array",
      "const": [
        "product_ui",
        "docs_help",
        "support_export",
        "narrated_announcement",
        "release_demo"
      ]
    },
    "forbidden_class_inventory": {
      "type": "array",
      "const": [
        "perfection_guarantee",
        "review_free_mutation",
        "false_autonomy",
        "false_validation",
        "confidence_overstatement",
        "false_exhaustiveness",
        "false_freshness"
      ]
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "forbidden_phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/forbidden_phrase"
      }
    },
    "shared_reuse_term_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/locale_neutral_token"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "locale_neutral_token": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+$"
    },
    "domain": {
      "enum": [
        "proposal_state",
        "confidence",
        "validation",
        "context_disclosure",
        "review_posture",
        "reversibility"
      ]
    },
    "concept": {
      "enum": [
        "suggested",
        "proposed",
        "draft",
        "context_used",
        "validation",
        "low_confidence",
        "review_required",
        "revert_undo_available"
      ]
    },
    "surface": {
      "enum": [
        "prompt_composer",
        "patch_review",
        "notebook_help",
        "docs_help",
        "provider_account"
      ]
    },
    "consumer": {
      "enum": [
        "product_ui",
        "docs_help",
        "support_export",
        "narrated_announcement",
        "release_demo"
      ]
    },
    "forbidden_class": {
      "enum": [
        "perfection_guarantee",
        "review_free_mutation",
        "false_autonomy",
        "false_validation",
        "confidence_overstatement",
        "false_exhaustiveness",
        "false_freshness"
      ]
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term_id",
        "concept",
        "domain",
        "canonical_label",
        "machine_token",
        "reserved_meaning",
        "required_context",
        "forbidden_uses",
        "surfaces",
        "consumers",
        "ai_provisional",
        "suppresses_direct_mutation",
        "requires_evidence_basis"
      ],
      "properties": {
        "term_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "concept": {
          "$ref": "#/$defs/concept"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "canonical_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "machine_token": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "reserved_meaning": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_context": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "forbidden_uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer"
          }
        },
        "ai_provisional": {
          "type": "boolean",
          "const": true
        },
        "suppresses_direct_mutation": {
          "type": "boolean"
        },
        "requires_evidence_basis": {
          "type": "boolean"
        }
      }
    },
    "forbidden_phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phrase_id",
        "class",
        "pattern",
        "rejection_reason",
        "approved_replacement_term_ids",
        "forbidden_on"
      ],
      "properties": {
        "phrase_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "class": {
          "$ref": "#/$defs/forbidden_class"
        },
        "pattern": {
          "type": "string",
          "pattern": "^[a-z0-9 -]+$"
        },
        "rejection_reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "approved_replacement_term_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/locale_neutral_token"
          }
        },
        "forbidden_on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surface"
          }
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_wording_never_overstates_confidence",
        "ai_wording_never_implies_review_free_completion",
        "ai_wording_never_claims_unproven_validation",
        "proposal_state_explicit_until_accepted",
        "low_confidence_suppresses_direct_mutation",
        "review_required_names_review_surface",
        "reversibility_state_disclosed",
        "forbidden_high_trust_phrases_rejected_on_protected_surfaces",
        "ai_wording_distinct_from_deterministic_service_wording",
        "support_export_reconstructs_in_product_wording",
        "one_catalog_not_parallel_copy_islands",
        "machine_tokens_and_ids_stay_locale_neutral",
        "human_prose_localizes_around_tokens"
      ],
      "properties": {
        "ai_wording_never_overstates_confidence": {
          "const": true
        },
        "ai_wording_never_implies_review_free_completion": {
          "const": true
        },
        "ai_wording_never_claims_unproven_validation": {
          "const": true
        },
        "proposal_state_explicit_until_accepted": {
          "const": true
        },
        "low_confidence_suppresses_direct_mutation": {
          "const": true
        },
        "review_required_names_review_surface": {
          "const": true
        },
        "reversibility_state_disclosed": {
          "const": true
        },
        "forbidden_high_trust_phrases_rejected_on_protected_surfaces": {
          "const": true
        },
        "ai_wording_distinct_from_deterministic_service_wording": {
          "const": true
        },
        "support_export_reconstructs_in_product_wording": {
          "const": true
        },
        "one_catalog_not_parallel_copy_islands": {
          "const": true
        },
        "machine_tokens_and_ids_stay_locale_neutral": {
          "const": true
        },
        "human_prose_localizes_around_tokens": {
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ui_resolves_through_catalog",
        "docs_help_reuses_term_identities",
        "support_export_uses_catalog_terms",
        "narrated_announcements_reuse_term_copy",
        "release_demo_artifacts_reuse_term_copy",
        "prompt_composer_honors_guardrails",
        "patch_review_honors_guardrails",
        "notebook_help_honors_guardrails",
        "provider_account_honors_guardrails"
      ],
      "properties": {
        "product_ui_resolves_through_catalog": {
          "const": true
        },
        "docs_help_reuses_term_identities": {
          "const": true
        },
        "support_export_uses_catalog_terms": {
          "const": true
        },
        "narrated_announcements_reuse_term_copy": {
          "const": true
        },
        "release_demo_artifacts_reuse_term_copy": {
          "const": true
        },
        "prompt_composer_honors_guardrails": {
          "const": true
        },
        "patch_review_honors_guardrails": {
          "const": true
        },
        "notebook_help_honors_guardrails": {
          "const": true
        },
        "provider_account_honors_guardrails": {
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
