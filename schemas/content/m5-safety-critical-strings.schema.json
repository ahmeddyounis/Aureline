{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/content/m5-safety-critical-strings.schema.json",
  "title": "Aureline stable safety-critical string catalog and glossary-linked controlled terms",
  "description": "Export-safe catalog of the safety-critical wording the shell renders for trust, policy, recovery, AI, and runtime surfaces. Each message object carries a stable, locale-neutral message id, an audience, a severity, named variables with declared semantics, truncation guidance, and the controlled-term ids it embeds. Controlled terms are first-class objects with a reserved meaning, a locale-neutral machine token, and the surfaces they may appear on. Messages never inline a protected term: a reference template uses {term:<term_id>} and {var:<name>} placeholders that resolve against the glossary and the declared variables, so the catalog — not a scattered literal string — is the source of truth for protected terminology. Machine-facing ids, tokens, and placeholders stay locale-neutral while human prose localizes safely around them. Raw message bodies, raw provider payloads, credentials, and secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "catalog_id",
    "catalog_label",
    "reference_locale",
    "audience_inventory",
    "severity_inventory",
    "surface_inventory",
    "term_class_inventory",
    "terms",
    "messages",
    "shared_reuse_term_ids",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_safety_critical_string_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "reference_locale": {
      "$ref": "#/$defs/non_empty_string"
    },
    "audience_inventory": {
      "type": "array",
      "const": [
        "end_user",
        "operator",
        "developer",
        "support",
        "screen_reader"
      ]
    },
    "severity_inventory": {
      "type": "array",
      "const": [
        "info",
        "notice",
        "caution",
        "warning",
        "critical",
        "blocking"
      ]
    },
    "surface_inventory": {
      "type": "array",
      "const": [
        "trust_prompt",
        "degraded_state_banner",
        "project_doctor_finding",
        "ai_review_flow",
        "execution_context_sheet",
        "support_export_heading",
        "recovery_action_block",
        "runtime_status"
      ]
    },
    "term_class_inventory": {
      "type": "array",
      "const": [
        "lifecycle",
        "trust",
        "policy",
        "compatibility",
        "freshness",
        "client_scope"
      ]
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/controlled_term"
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "shared_reuse_term_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/locale_neutral_token"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "locale_neutral_token": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+$"
    },
    "nullable_locale_neutral_token": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_.]+$"
    },
    "term_class": {
      "type": "string",
      "enum": [
        "lifecycle",
        "trust",
        "policy",
        "compatibility",
        "freshness",
        "client_scope"
      ]
    },
    "alias_posture": {
      "type": "string",
      "enum": [
        "no_alias",
        "controlled_alias",
        "deprecated_alias"
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "end_user",
        "operator",
        "developer",
        "support",
        "screen_reader"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "notice",
        "caution",
        "warning",
        "critical",
        "blocking"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "trust_prompt",
        "degraded_state_banner",
        "project_doctor_finding",
        "ai_review_flow",
        "execution_context_sheet",
        "support_export_heading",
        "recovery_action_block",
        "runtime_status"
      ]
    },
    "message_class": {
      "type": "string",
      "enum": [
        "safety_critical_string",
        "error_recovery_block",
        "action_label",
        "ai_copy_line",
        "count_scope_phrase"
      ]
    },
    "variable_role": {
      "type": "string",
      "enum": [
        "controlled_term",
        "count",
        "scope_label",
        "entity_name",
        "location",
        "code",
        "duration"
      ]
    },
    "truncation_strategy": {
      "type": "string",
      "enum": [
        "never_truncate",
        "truncate_variable_tail",
        "truncate_variable_middle",
        "priority_drop_trailing_clause"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "product_ui",
        "cli_help",
        "docs",
        "support_export",
        "screen_reader",
        "ai_surface",
        "onboarding",
        "help_about"
      ]
    },
    "controlled_term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term_id",
        "term_class",
        "machine_token",
        "canonical_label",
        "reserved_meaning",
        "alias_posture",
        "never_softened",
        "allowed_surfaces"
      ],
      "properties": {
        "term_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "term_class": {
          "$ref": "#/$defs/term_class"
        },
        "machine_token": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "canonical_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reserved_meaning": {
          "$ref": "#/$defs/non_empty_string"
        },
        "alias_posture": {
          "$ref": "#/$defs/alias_posture"
        },
        "never_softened": {
          "type": "boolean",
          "const": true
        },
        "allowed_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surface_family"
          }
        }
      }
    },
    "message_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "locale_neutral_value",
        "truncatable",
        "term_ref"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "role": {
          "$ref": "#/$defs/variable_role"
        },
        "locale_neutral_value": {
          "type": "boolean"
        },
        "truncatable": {
          "type": "boolean"
        },
        "term_ref": {
          "$ref": "#/$defs/nullable_locale_neutral_token"
        }
      }
    },
    "truncation_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "controlled_terms_never_dropped",
        "note"
      ],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/truncation_strategy"
        },
        "controlled_terms_never_dropped": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_class",
        "audience",
        "severity",
        "surface_family",
        "glossary_term_refs",
        "variables",
        "reference_template",
        "truncation",
        "consumer_surfaces",
        "next_action_label_ref"
      ],
      "properties": {
        "message_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "message_class": {
          "$ref": "#/$defs/message_class"
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "surface_family": {
          "$ref": "#/$defs/surface_family"
        },
        "glossary_term_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale_neutral_token"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message_variable"
          }
        },
        "reference_template": {
          "$ref": "#/$defs/non_empty_string"
        },
        "truncation": {
          "$ref": "#/$defs/truncation_guidance"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        },
        "next_action_label_ref": {
          "$ref": "#/$defs/nullable_locale_neutral_token"
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages_have_stable_locale_neutral_ids",
        "controlled_terms_resolved_not_inlined",
        "audience_and_severity_metadata_present",
        "machine_tokens_stay_locale_neutral",
        "human_prose_localizes_around_tokens",
        "error_copy_explains_failure_remaining_and_next_action",
        "ai_copy_never_overstates_confidence_or_autonomy",
        "counts_disclose_freshness_and_scope",
        "one_catalog_not_parallel_string_islands",
        "truncation_never_drops_controlled_terms"
      ],
      "properties": {
        "messages_have_stable_locale_neutral_ids": {
          "type": "boolean",
          "const": true
        },
        "controlled_terms_resolved_not_inlined": {
          "type": "boolean",
          "const": true
        },
        "audience_and_severity_metadata_present": {
          "type": "boolean",
          "const": true
        },
        "machine_tokens_stay_locale_neutral": {
          "type": "boolean",
          "const": true
        },
        "human_prose_localizes_around_tokens": {
          "type": "boolean",
          "const": true
        },
        "error_copy_explains_failure_remaining_and_next_action": {
          "type": "boolean",
          "const": true
        },
        "ai_copy_never_overstates_confidence_or_autonomy": {
          "type": "boolean",
          "const": true
        },
        "counts_disclose_freshness_and_scope": {
          "type": "boolean",
          "const": true
        },
        "one_catalog_not_parallel_string_islands": {
          "type": "boolean",
          "const": true
        },
        "truncation_never_drops_controlled_terms": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ui_resolves_through_catalog",
        "cli_help_shows_controlled_terms",
        "docs_render_controlled_terms",
        "support_export_uses_catalog_headings",
        "screen_reader_reuses_message_identities",
        "ai_surfaces_honor_copy_guardrails",
        "onboarding_uses_controlled_terms",
        "help_about_shows_state_terms"
      ],
      "properties": {
        "product_ui_resolves_through_catalog": {
          "type": "boolean",
          "const": true
        },
        "cli_help_shows_controlled_terms": {
          "type": "boolean",
          "const": true
        },
        "docs_render_controlled_terms": {
          "type": "boolean",
          "const": true
        },
        "support_export_uses_catalog_headings": {
          "type": "boolean",
          "const": true
        },
        "screen_reader_reuses_message_identities": {
          "type": "boolean",
          "const": true
        },
        "ai_surfaces_honor_copy_guardrails": {
          "type": "boolean",
          "const": true
        },
        "onboarding_uses_controlled_terms": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_state_terms": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
