{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/content/m5-boundary-wording.schema.json",
  "title": "Aureline boundary-wording governance and cross-surface copy-parity catalog",
  "description": "Export-safe catalog that governs how Aureline talks about its hosting and commercial boundary across settings, onboarding, marketplace, help/About, release notes, and account/upgrade prompts. Each entry is a typed honesty packet for one boundary claim on one surface: a controlled boundary term (hosted, managed, premium, self-hosted, local-only, BYOK, trial), the actual product boundary it maps to, the identity/network/data/export/rollback implications it carries, the local/open alternatives it discloses, and the compatibility/support metadata it is anchored to. A term can never claim more local independence than the actual posture provides; a managed/paid claim with a local-capable core must disclose the local/BYOK/self-hosted alternative that remains; a claim that narrows or widens a boundary references support metadata instead of prose-only marketing; and every surface that renders the same concept_id agrees on the boundary facts so a copy-parity lint can block drift. Machine-facing ids and refs stay locale-neutral while human prose localizes around them. Credentials, raw provider payloads, and secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "catalog_id",
    "catalog_label",
    "reference_locale",
    "term_inventory",
    "actual_posture_inventory",
    "surface_inventory",
    "claim_kind_inventory",
    "implication_inventory",
    "implication_posture_inventory",
    "alternative_path_inventory",
    "entries",
    "shared_concept_ids",
    "trust_review",
    "parity_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_boundary_wording_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "reference_locale": {
      "$ref": "#/$defs/non_empty_string"
    },
    "term_inventory": {
      "type": "array",
      "const": [
        "hosted",
        "managed",
        "premium",
        "self_hosted",
        "local_only",
        "byok",
        "trial"
      ]
    },
    "actual_posture_inventory": {
      "type": "array",
      "const": [
        "local_independent",
        "self_hostable",
        "byok",
        "managed_optional",
        "managed_required",
        "commercial_paid"
      ]
    },
    "surface_inventory": {
      "type": "array",
      "const": [
        "settings",
        "onboarding",
        "marketplace",
        "help_about",
        "release_notes",
        "account_upgrade_prompt"
      ]
    },
    "claim_kind_inventory": {
      "type": "array",
      "const": [
        "states_boundary",
        "narrows_boundary",
        "widens_boundary"
      ]
    },
    "implication_inventory": {
      "type": "array",
      "const": [
        "identity",
        "network",
        "data",
        "export",
        "rollback"
      ]
    },
    "implication_posture_inventory": {
      "type": "array",
      "const": [
        "required",
        "optional",
        "not_required",
        "retained",
        "local_only"
      ]
    },
    "alternative_path_inventory": {
      "type": "array",
      "const": [
        "local_only",
        "byok",
        "self_hosted",
        "export",
        "rollback"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "shared_concept_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/locale_neutral_token"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "parity_projection": {
      "$ref": "#/$defs/parity_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "locale_neutral_token": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+$"
    },
    "nullable_locale_neutral_token": {
      "anyOf": [
        {
          "$ref": "#/$defs/locale_neutral_token"
        },
        {
          "type": "null"
        }
      ]
    },
    "term": {
      "enum": [
        "hosted",
        "managed",
        "premium",
        "self_hosted",
        "local_only",
        "byok",
        "trial"
      ]
    },
    "actual_boundary_posture": {
      "enum": [
        "local_independent",
        "self_hostable",
        "byok",
        "managed_optional",
        "managed_required",
        "commercial_paid"
      ]
    },
    "surface": {
      "enum": [
        "settings",
        "onboarding",
        "marketplace",
        "help_about",
        "release_notes",
        "account_upgrade_prompt"
      ]
    },
    "claim_kind": {
      "enum": [
        "states_boundary",
        "narrows_boundary",
        "widens_boundary"
      ]
    },
    "implication": {
      "enum": [
        "identity",
        "network",
        "data",
        "export",
        "rollback"
      ]
    },
    "implication_posture": {
      "enum": [
        "required",
        "optional",
        "not_required",
        "retained",
        "local_only"
      ]
    },
    "alternative_path": {
      "enum": [
        "local_only",
        "byok",
        "self_hosted",
        "export",
        "rollback"
      ]
    },
    "implication_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "posture",
        "disclosure"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/implication"
        },
        "posture": {
          "$ref": "#/$defs/implication_posture"
        },
        "disclosure": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "alternative_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "available",
        "disclosure",
        "reference_ref"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/alternative_path"
        },
        "available": {
          "type": "boolean"
        },
        "disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reference_ref": {
          "$ref": "#/$defs/nullable_locale_neutral_token"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "concept_id",
        "term",
        "surface",
        "canonical_text",
        "claim_kind",
        "support_metadata_ref",
        "actual_boundary_posture",
        "introduces_managed_or_paid",
        "core_workflow_remains_local",
        "implications",
        "alternative_paths",
        "source_ref"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "concept_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "term": {
          "$ref": "#/$defs/term"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "canonical_text": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_kind": {
          "$ref": "#/$defs/claim_kind"
        },
        "support_metadata_ref": {
          "$ref": "#/$defs/nullable_locale_neutral_token"
        },
        "actual_boundary_posture": {
          "$ref": "#/$defs/actual_boundary_posture"
        },
        "introduces_managed_or_paid": {
          "type": "boolean"
        },
        "core_workflow_remains_local": {
          "type": "boolean"
        },
        "implications": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/implication_statement"
          }
        },
        "alternative_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative_disclosure"
          }
        },
        "source_ref": {
          "$ref": "#/$defs/locale_neutral_token"
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_controlled_vocabulary_across_surfaces",
        "wording_never_overstates_actual_boundary",
        "narrowing_or_widening_references_support_metadata",
        "identity_network_data_export_rollback_explained",
        "upgrade_prompts_disclose_local_byok_self_hosted_alternatives",
        "never_pressures_away_from_local_or_open_path",
        "never_implies_vendor_dependence_when_core_local",
        "managed_or_paid_introductions_keep_export_and_rollback",
        "copy_parity_lint_blocks_cross_surface_drift",
        "review_can_fail_on_parity_or_honesty_drift_without_code_change",
        "machine_anchored_to_compatibility_and_support_metadata",
        "one_catalog_not_parallel_boundary_prose_islands"
      ],
      "properties": {
        "one_controlled_vocabulary_across_surfaces": {
          "const": true
        },
        "wording_never_overstates_actual_boundary": {
          "const": true
        },
        "narrowing_or_widening_references_support_metadata": {
          "const": true
        },
        "identity_network_data_export_rollback_explained": {
          "const": true
        },
        "upgrade_prompts_disclose_local_byok_self_hosted_alternatives": {
          "const": true
        },
        "never_pressures_away_from_local_or_open_path": {
          "const": true
        },
        "never_implies_vendor_dependence_when_core_local": {
          "const": true
        },
        "managed_or_paid_introductions_keep_export_and_rollback": {
          "const": true
        },
        "copy_parity_lint_blocks_cross_surface_drift": {
          "const": true
        },
        "review_can_fail_on_parity_or_honesty_drift_without_code_change": {
          "const": true
        },
        "machine_anchored_to_compatibility_and_support_metadata": {
          "const": true
        },
        "one_catalog_not_parallel_boundary_prose_islands": {
          "const": true
        }
      }
    },
    "parity_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings_resolves_through_catalog",
        "onboarding_resolves_through_catalog",
        "marketplace_resolves_through_catalog",
        "help_about_resolves_through_catalog",
        "release_notes_resolve_through_catalog",
        "account_upgrade_prompt_resolves_through_catalog"
      ],
      "properties": {
        "settings_resolves_through_catalog": {
          "const": true
        },
        "onboarding_resolves_through_catalog": {
          "const": true
        },
        "marketplace_resolves_through_catalog": {
          "const": true
        },
        "help_about_resolves_through_catalog": {
          "const": true
        },
        "release_notes_resolve_through_catalog": {
          "const": true
        },
        "account_upgrade_prompt_resolves_through_catalog": {
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "mirror_offline_parity_required": {
          "const": true
        }
      }
    }
  }
}
