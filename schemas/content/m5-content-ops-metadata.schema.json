{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/content/m5-content-ops-metadata.schema.json",
  "title": "Aureline content-ops metadata for docs/help snippets, export/report headings, screenshot/demo captions, and translator notes",
  "description": "Export-safe catalog that gives Aureline's non-runtime wording the same source/command/version/build context the product expects from runtime surfaces. Each entry is a typed provenance packet for one of four artifact kinds — docs/help snippet, export/report heading, screenshot/demo caption, or translator note — carrying a stable locale-neutral id, the source it came from, the command/source it reflects, the product version and build it was captured against, translation-safe placeholder notes (resolved by id, not position), and the locale fallback posture it falls through. Export/report headings pair a localizable human label with a locale-neutral machine field id. Screenshot/demo captions declare capture posture (live, mocked, synthetic), caption-sync state, and a mocked-versus-live disclosure so a caption can never imply live/stable/current product truth while lacking the metadata. Machine-facing ids, codes, and token ids stay locale-neutral while human prose localizes safely around them. Credentials, raw provider payloads, and secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "catalog_id",
    "catalog_label",
    "reference_locale",
    "kind_inventory",
    "consumer_inventory",
    "capture_posture_inventory",
    "caption_sync_state_inventory",
    "fallback_strategy_inventory",
    "placeholder_kind_inventory",
    "token_fidelity_class_inventory",
    "translator_note_class_inventory",
    "entries",
    "shared_reuse_entry_ids",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_content_ops_metadata_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "reference_locale": {
      "$ref": "#/$defs/non_empty_string"
    },
    "kind_inventory": {
      "type": "array",
      "const": [
        "docs_help_snippet",
        "export_report_heading",
        "screenshot_demo_caption",
        "translator_note"
      ]
    },
    "consumer_inventory": {
      "type": "array",
      "const": [
        "docs_help",
        "release_notes",
        "support_export",
        "screenshot_demo_pipeline",
        "cli_help"
      ]
    },
    "capture_posture_inventory": {
      "type": "array",
      "const": [
        "live",
        "mocked",
        "synthetic",
        "not_applicable"
      ]
    },
    "caption_sync_state_inventory": {
      "type": "array",
      "const": [
        "in_sync",
        "stale",
        "pending_review",
        "not_applicable"
      ]
    },
    "fallback_strategy_inventory": {
      "type": "array",
      "const": [
        "source_language_route",
        "nearest_locale",
        "machine_token",
        "policy_blocked"
      ]
    },
    "placeholder_kind_inventory": {
      "type": "array",
      "const": [
        "count",
        "command_id_token",
        "analytics_key_token",
        "automation_route_token",
        "support_field_token",
        "policy_id_token",
        "file_path_token",
        "host_or_url_token",
        "tenant_or_account_token",
        "flag_or_argument_token",
        "version_or_build_token",
        "locale_tag_token",
        "glossary_term_token",
        "enumerated_state_token",
        "evidence_ref_token",
        "freeform_string"
      ]
    },
    "token_fidelity_class_inventory": {
      "type": "array",
      "const": [
        "literal_unchanged",
        "controlled_vocabulary_translation",
        "locale_formatted_value",
        "human_translatable"
      ]
    },
    "translator_note_class_inventory": {
      "type": "array",
      "const": [
        "placeholder_semantics",
        "pluralization_rule",
        "mixed_direction_token",
        "glossary_term_ref",
        "screenshot_or_demo_caption_governance",
        "source_language_escape_hatch",
        "pseudoloc_truncation_review",
        "late_copy_controlled_delta",
        "policy_or_legal_review_required",
        "evidence_source_review"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "shared_reuse_entry_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/locale_neutral_token"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "locale_neutral_token": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+$"
    },
    "nullable_locale_neutral_token": {
      "anyOf": [
        {
          "$ref": "#/$defs/locale_neutral_token"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_non_empty_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/non_empty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "placeholder_token": {
      "type": "string",
      "pattern": "^\\{[a-z0-9_.]+\\}$"
    },
    "kind": {
      "enum": [
        "docs_help_snippet",
        "export_report_heading",
        "screenshot_demo_caption",
        "translator_note"
      ]
    },
    "consumer": {
      "enum": [
        "docs_help",
        "release_notes",
        "support_export",
        "screenshot_demo_pipeline",
        "cli_help"
      ]
    },
    "capture_posture": {
      "enum": [
        "live",
        "mocked",
        "synthetic",
        "not_applicable"
      ]
    },
    "caption_sync_state": {
      "enum": [
        "in_sync",
        "stale",
        "pending_review",
        "not_applicable"
      ]
    },
    "fallback_strategy": {
      "enum": [
        "source_language_route",
        "nearest_locale",
        "machine_token",
        "policy_blocked"
      ]
    },
    "placeholder_kind": {
      "enum": [
        "count",
        "command_id_token",
        "analytics_key_token",
        "automation_route_token",
        "support_field_token",
        "policy_id_token",
        "file_path_token",
        "host_or_url_token",
        "tenant_or_account_token",
        "flag_or_argument_token",
        "version_or_build_token",
        "locale_tag_token",
        "glossary_term_token",
        "enumerated_state_token",
        "evidence_ref_token",
        "freeform_string"
      ]
    },
    "token_fidelity_class": {
      "enum": [
        "literal_unchanged",
        "controlled_vocabulary_translation",
        "locale_formatted_value",
        "human_translatable"
      ]
    },
    "translator_note_class": {
      "anyOf": [
        {
          "enum": [
            "placeholder_semantics",
            "pluralization_rule",
            "mixed_direction_token",
            "glossary_term_ref",
            "screenshot_or_demo_caption_governance",
            "source_language_escape_hatch",
            "pseudoloc_truncation_review",
            "late_copy_controlled_delta",
            "policy_or_legal_review_required",
            "evidence_source_review"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "version_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_version_ref",
        "build_ref",
        "capture_posture",
        "caption_sync_state",
        "mocked_versus_live_disclosed"
      ],
      "properties": {
        "product_version_ref": {
          "type": "string"
        },
        "build_ref": {
          "type": "string"
        },
        "capture_posture": {
          "$ref": "#/$defs/capture_posture"
        },
        "caption_sync_state": {
          "$ref": "#/$defs/caption_sync_state"
        },
        "mocked_versus_live_disclosed": {
          "type": "boolean"
        }
      }
    },
    "placeholder_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholder",
        "token_id",
        "kind",
        "fidelity",
        "semantic",
        "fallback",
        "bidi_isolation_required",
        "plural_rule_ref",
        "glossary_term_ref"
      ],
      "properties": {
        "placeholder": {
          "$ref": "#/$defs/placeholder_token"
        },
        "token_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "kind": {
          "$ref": "#/$defs/placeholder_kind"
        },
        "fidelity": {
          "$ref": "#/$defs/token_fidelity_class"
        },
        "semantic": {
          "$ref": "#/$defs/non_empty_string"
        },
        "fallback": {
          "$ref": "#/$defs/non_empty_string"
        },
        "bidi_isolation_required": {
          "type": "boolean"
        },
        "plural_rule_ref": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "glossary_term_ref": {
          "$ref": "#/$defs/nullable_non_empty_string"
        }
      }
    },
    "locale_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_locale",
        "strategy",
        "fallback_chain",
        "non_authoritative_disclosed",
        "policy_block_ref"
      ],
      "properties": {
        "default_locale": {
          "$ref": "#/$defs/non_empty_string"
        },
        "strategy": {
          "$ref": "#/$defs/fallback_strategy"
        },
        "fallback_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "non_authoritative_disclosed": {
          "type": "boolean"
        },
        "policy_block_ref": {
          "$ref": "#/$defs/nullable_non_empty_string"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "kind",
        "canonical_text",
        "machine_field_name",
        "source_ref",
        "command_ref",
        "version_context",
        "placeholder_notes",
        "translator_note_class",
        "target_string_ref",
        "locale_fallback",
        "consumers",
        "release_support_path"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "canonical_text": {
          "$ref": "#/$defs/non_empty_string"
        },
        "machine_field_name": {
          "$ref": "#/$defs/nullable_locale_neutral_token"
        },
        "source_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "command_ref": {
          "$ref": "#/$defs/nullable_locale_neutral_token"
        },
        "version_context": {
          "$ref": "#/$defs/version_context"
        },
        "placeholder_notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placeholder_note"
          }
        },
        "translator_note_class": {
          "$ref": "#/$defs/translator_note_class"
        },
        "target_string_ref": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "locale_fallback": {
          "$ref": "#/$defs/locale_fallback"
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer"
          }
        },
        "release_support_path": {
          "type": "boolean"
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_artifact_declares_source",
        "rendered_artifacts_declare_version_and_build",
        "screenshots_declare_capture_posture_and_sync",
        "captions_never_imply_live_without_metadata",
        "headings_pair_human_label_with_machine_code",
        "variable_rich_strings_carry_placeholder_notes",
        "count_placeholders_declare_plural_rules",
        "glossary_tokens_use_stable_refs",
        "placeholder_tokens_resolve_by_id_not_position",
        "localized_prose_never_controls_machine_identity",
        "locale_fallback_declared_and_disclosed",
        "release_help_support_never_versionless",
        "support_export_reconstructs_provenance",
        "one_catalog_not_parallel_metadata_islands",
        "machine_identity_stays_locale_neutral",
        "human_prose_localizes_around_tokens"
      ],
      "properties": {
        "every_artifact_declares_source": {
          "const": true
        },
        "rendered_artifacts_declare_version_and_build": {
          "const": true
        },
        "screenshots_declare_capture_posture_and_sync": {
          "const": true
        },
        "captions_never_imply_live_without_metadata": {
          "const": true
        },
        "headings_pair_human_label_with_machine_code": {
          "const": true
        },
        "variable_rich_strings_carry_placeholder_notes": {
          "const": true
        },
        "count_placeholders_declare_plural_rules": {
          "const": true
        },
        "glossary_tokens_use_stable_refs": {
          "const": true
        },
        "placeholder_tokens_resolve_by_id_not_position": {
          "const": true
        },
        "localized_prose_never_controls_machine_identity": {
          "const": true
        },
        "locale_fallback_declared_and_disclosed": {
          "const": true
        },
        "release_help_support_never_versionless": {
          "const": true
        },
        "support_export_reconstructs_provenance": {
          "const": true
        },
        "one_catalog_not_parallel_metadata_islands": {
          "const": true
        },
        "machine_identity_stays_locale_neutral": {
          "const": true
        },
        "human_prose_localizes_around_tokens": {
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docs_help_resolves_through_catalog",
        "release_notes_resolve_through_catalog",
        "support_export_uses_catalog_metadata",
        "screenshot_demo_pipeline_declares_metadata",
        "cli_help_reuses_metadata",
        "report_headings_pair_human_and_machine_codes"
      ],
      "properties": {
        "docs_help_resolves_through_catalog": {
          "const": true
        },
        "release_notes_resolve_through_catalog": {
          "const": true
        },
        "support_export_uses_catalog_metadata": {
          "const": true
        },
        "screenshot_demo_pipeline_declares_metadata": {
          "const": true
        },
        "cli_help_reuses_metadata": {
          "const": true
        },
        "report_headings_pair_human_and_machine_codes": {
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
