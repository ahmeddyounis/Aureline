{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/content/m5-error-recovery-copy.schema.json",
  "title": "Aureline error/recovery copy objects and degraded-state reason chips",
  "description": "Export-safe catalog of the error/recovery wording the shell renders when an M5 workflow fails or runs degraded. Every recovery block carries four explicit parts — what failed, why it likely happened, what still works, and a verb-first next action with a recovery link — so a surface can never stop at generic failure text. Degraded states are first-class reason-chip objects, one per state (restricted, partial_index, remote_host, policy_blocked, cached, stale, reconnecting, rollback_available), with a reserved meaning, a locale-neutral machine token, a severity, and the surfaces they may appear on. Copy lines never inline a chip label: a reference template uses {chip:<chip_id>} and {var:<name>} placeholders that resolve against the chip register and the declared variables, so the catalog — not a scattered literal string — is the source of truth. Machine-facing ids, tokens, and placeholders stay locale-neutral while human prose localizes safely around them. Raw failure bodies, raw provider payloads, credentials, and secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "catalog_id",
    "catalog_label",
    "reference_locale",
    "domain_inventory",
    "severity_inventory",
    "degraded_state_inventory",
    "surface_inventory",
    "chips",
    "blocks",
    "shared_reuse_chip_ids",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_error_recovery_copy_catalog"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "catalog_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "reference_locale": {
      "$ref": "#/$defs/non_empty_string"
    },
    "domain_inventory": {
      "type": "array",
      "const": [
        "runtime",
        "network",
        "repair",
        "install",
        "review",
        "docs_help"
      ]
    },
    "severity_inventory": {
      "type": "array",
      "const": [
        "notice",
        "caution",
        "warning",
        "critical",
        "blocking"
      ]
    },
    "degraded_state_inventory": {
      "type": "array",
      "const": [
        "restricted",
        "partial_index",
        "remote_host",
        "policy_blocked",
        "cached",
        "stale",
        "reconnecting",
        "rollback_available"
      ]
    },
    "surface_inventory": {
      "type": "array",
      "const": [
        "dynamic_banner",
        "inline_blocker",
        "project_doctor",
        "cli_help_summary",
        "support_export",
        "screenshot_caption",
        "screen_reader"
      ]
    },
    "chips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reason_chip"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recovery_block"
      }
    },
    "shared_reuse_chip_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/locale_neutral_token"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "locale_neutral_token": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+$"
    },
    "degraded_state": {
      "type": "string",
      "enum": [
        "restricted",
        "partial_index",
        "remote_host",
        "policy_blocked",
        "cached",
        "stale",
        "reconnecting",
        "rollback_available"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "notice",
        "caution",
        "warning",
        "critical",
        "blocking"
      ]
    },
    "failure_domain": {
      "type": "string",
      "enum": [
        "runtime",
        "network",
        "repair",
        "install",
        "review",
        "docs_help"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "dynamic_banner",
        "inline_blocker",
        "project_doctor",
        "cli_help_summary",
        "support_export",
        "screenshot_caption",
        "screen_reader"
      ]
    },
    "copy_role": {
      "type": "string",
      "enum": [
        "what_failed",
        "why_likely",
        "what_still_works"
      ]
    },
    "variable_role": {
      "type": "string",
      "enum": [
        "entity_name",
        "location",
        "code",
        "count",
        "duration",
        "scope_label"
      ]
    },
    "link_kind": {
      "type": "string",
      "enum": [
        "docs_topic",
        "help_topic",
        "repair_flow",
        "settings_pane",
        "reconnect_flow",
        "rollback_flow",
        "support_export"
      ]
    },
    "reason_chip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chip_id",
        "state",
        "machine_token",
        "canonical_label",
        "reserved_meaning",
        "severity",
        "self_heals",
        "offers_recovery",
        "grounded",
        "allowed_surfaces"
      ],
      "properties": {
        "chip_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "state": {
          "$ref": "#/$defs/degraded_state"
        },
        "machine_token": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "canonical_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reserved_meaning": {
          "$ref": "#/$defs/non_empty_string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "self_heals": {
          "type": "boolean"
        },
        "offers_recovery": {
          "type": "boolean"
        },
        "grounded": {
          "type": "boolean",
          "const": true
        },
        "allowed_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "copy_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "locale_neutral_value",
        "truncatable"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "role": {
          "$ref": "#/$defs/variable_role"
        },
        "locale_neutral_value": {
          "type": "boolean"
        },
        "truncatable": {
          "type": "boolean"
        }
      }
    },
    "copy_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "reference_template",
        "chip_refs",
        "variables"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/copy_role"
        },
        "reference_template": {
          "$ref": "#/$defs/non_empty_string"
        },
        "chip_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale_neutral_token"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/copy_variable"
          }
        }
      }
    },
    "recovery_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "kind",
        "target_ref",
        "label",
        "offline_available"
      ],
      "properties": {
        "link_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "kind": {
          "$ref": "#/$defs/link_kind"
        },
        "target_ref": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "offline_available": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "label",
        "variables",
        "recovery_link"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/copy_variable"
          }
        },
        "recovery_link": {
          "$ref": "#/$defs/recovery_link"
        }
      }
    },
    "recovery_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "failure_domain",
        "severity",
        "what_failed",
        "why_likely",
        "what_still_works",
        "next_action",
        "reason_chips",
        "consumer_surfaces"
      ],
      "properties": {
        "block_id": {
          "$ref": "#/$defs/locale_neutral_token"
        },
        "failure_domain": {
          "$ref": "#/$defs/failure_domain"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "what_failed": {
          "$ref": "#/$defs/copy_line"
        },
        "why_likely": {
          "$ref": "#/$defs/copy_line"
        },
        "what_still_works": {
          "$ref": "#/$defs/copy_line"
        },
        "next_action": {
          "$ref": "#/$defs/next_action"
        },
        "reason_chips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale_neutral_token"
          }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_explain_failure_cause_remaining_and_next_action",
        "recovery_messaging_states_what_still_works_and_how_to_proceed",
        "degraded_state_chips_reused_not_reinvented_per_surface",
        "chips_use_grounded_cause_language_not_euphemism",
        "next_action_labels_are_verb_first_with_recovery_link",
        "machine_tokens_and_ids_stay_locale_neutral",
        "human_prose_localizes_around_tokens",
        "support_export_reconstructs_in_product_explanation",
        "one_catalog_not_parallel_recovery_islands",
        "recovery_links_resolve_offline"
      ],
      "properties": {
        "blocks_explain_failure_cause_remaining_and_next_action": {
          "type": "boolean",
          "const": true
        },
        "recovery_messaging_states_what_still_works_and_how_to_proceed": {
          "type": "boolean",
          "const": true
        },
        "degraded_state_chips_reused_not_reinvented_per_surface": {
          "type": "boolean",
          "const": true
        },
        "chips_use_grounded_cause_language_not_euphemism": {
          "type": "boolean",
          "const": true
        },
        "next_action_labels_are_verb_first_with_recovery_link": {
          "type": "boolean",
          "const": true
        },
        "machine_tokens_and_ids_stay_locale_neutral": {
          "type": "boolean",
          "const": true
        },
        "human_prose_localizes_around_tokens": {
          "type": "boolean",
          "const": true
        },
        "support_export_reconstructs_in_product_explanation": {
          "type": "boolean",
          "const": true
        },
        "one_catalog_not_parallel_recovery_islands": {
          "type": "boolean",
          "const": true
        },
        "recovery_links_resolve_offline": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dynamic_banners_resolve_through_catalog",
        "inline_blockers_resolve_through_catalog",
        "project_doctor_reuses_block_identities",
        "cli_help_summaries_show_same_copy",
        "support_export_uses_catalog_blocks",
        "screenshot_captions_reuse_block_copy",
        "screen_reader_reuses_block_identities"
      ],
      "properties": {
        "dynamic_banners_resolve_through_catalog": {
          "type": "boolean",
          "const": true
        },
        "inline_blockers_resolve_through_catalog": {
          "type": "boolean",
          "const": true
        },
        "project_doctor_reuses_block_identities": {
          "type": "boolean",
          "const": true
        },
        "cli_help_summaries_show_same_copy": {
          "type": "boolean",
          "const": true
        },
        "support_export_uses_catalog_blocks": {
          "type": "boolean",
          "const": true
        },
        "screenshot_captions_reuse_block_copy": {
          "type": "boolean",
          "const": true
        },
        "screen_reader_reuses_block_identities": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
