{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/service/m5-commercial-boundary-cards.schema.json",
  "title": "Aureline commercial-boundary card set",
  "description": "Boundary schema for the frozen Help/About, release-center, diagnostics, and procurement commercial-boundary cards across the local open core and the M5 managed lanes. The set pins exactly one local-open-core card plus one card per managed service family. Each card states its open-versus-paid boundary class, the deployment profiles its boundary holds in (and the profiles it is not offered in), the residual vendor-hosted dependencies a managed lane carries (each naming whether it stays vendor-hosted and whether self-hosting eliminates it; the local open core declares none), the procurement/support evidence available at an export-parity guarantee, a non-empty local-safe baseline that always continues, and a cost-figure disclosure that defers spend/quota numbers to the metering surfaces (never bare). A card's ranked actions keep export, procurement, and local continuation above any learn-about-paid prompt; only managed cards carry an upsell. Every card carries an as-of time and narrows the marketed claim from its boundary-evidence status (managed_full when current, managed_narrowed when stale, local_safe_only when missing or downgraded). The set also pins one surface binding per surface (Help/About, release center, diagnostics, procurement packet, support/admin packet, claim/public-truth automation), each projecting the effective claim, rendering the local-safe baseline, disclosing the residual dependencies, naming the deployment-profile qualifier, and keeping evidence above upsell. Raw URLs, raw hostnames, raw tenant names, raw account ids, raw billing account ids, raw invoice numbers, raw price-list values, raw spend or quota numbers, raw key bytes, raw cloud-region identifiers, and raw secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "set_id",
    "generated_at",
    "set_revision",
    "title",
    "summary",
    "source_refs",
    "cards",
    "surface_bindings",
    "inspection"
  ],
  "properties": {
    "record_kind": { "const": "m5_commercial_boundary_card_set" },
    "schema_version": { "const": 1 },
    "set_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/utc_date_time" },
    "set_revision": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/$defs/reviewable_sentence" },
    "summary": { "$ref": "#/$defs/reviewable_sentence" },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_string" },
      "description": "Schema and contract refs. MUST include schemas/service/m5-commercial-boundary-cards.schema.json."
    },
    "cards": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boundary_card" }
    },
    "surface_bindings": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/surface_binding" }
    },
    "inspection": { "$ref": "#/$defs/inspection_block" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "reviewable_sentence": {
      "type": "string",
      "minLength": 1,
      "description": "Short product-term sentence safe for product copy, support export, procurement export, and release evidence. Raw URLs, raw hostnames, raw tenant names, raw account ids, raw billing account ids, raw invoice numbers, raw price-list values, raw spend or quota numbers, raw key bytes, raw cloud-region identifiers, and raw secret material MUST NOT appear."
    },
    "non_empty_reviewable_sentence_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reviewable_sentence" }
    },
    "stable_token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "utc_date_time": { "type": "string", "format": "date-time" },
    "service_family_class": {
      "type": "string",
      "enum": [
        "sync_family",
        "registry_or_mirror_metadata_family",
        "collaboration_relay_family",
        "remote_workspace_control_plane_family",
        "ai_gateway_family",
        "telemetry_or_support_ingest_family"
      ]
    },
    "marketed_claim_class": {
      "type": "string",
      "enum": ["managed_full", "managed_narrowed", "local_safe_only"]
    },
    "export_guarantee_class": {
      "type": "string",
      "enum": [
        "parity_with_csv_and_json",
        "parity_with_json_only",
        "parity_with_csv_only",
        "manifest_only_no_row_export",
        "no_export_documented_local_only"
      ]
    },
    "posture_origin_class": {
      "type": "string",
      "enum": [
        "seat",
        "plan",
        "policy",
        "org",
        "account",
        "managed_provider",
        "workspace_lifecycle",
        "metering_quota",
        "local_only_no_managed_account"
      ]
    },
    "boundary_class": {
      "type": "string",
      "enum": ["local_open_source", "managed_paid_optional"]
    },
    "dependency_class": {
      "type": "string",
      "enum": [
        "sign_in",
        "package_registry",
        "remote_mirror",
        "remote_agent",
        "symbol_service",
        "ai_provider",
        "policy_bundle",
        "docs_pack",
        "browser_handoff",
        "companion_notification_channel",
        "hosted_control_plane_reachability"
      ],
      "description": "Re-exported from artifacts/governance/residual_dependencies.yaml#dependency_class_vocabulary."
    },
    "deployment_profile_class": {
      "type": "string",
      "enum": [
        "individual_local",
        "self_hosted",
        "enterprise_online",
        "air_gapped",
        "managed_cloud"
      ],
      "description": "Re-exported from artifacts/governance/deployment_profiles.yaml#deployment_profile_vocabulary."
    },
    "boundary_evidence_status_class": {
      "type": "string",
      "enum": ["current", "stale", "missing", "downgraded"]
    },
    "procurement_packet_kind_class": {
      "type": "string",
      "enum": [
        "open_source_license_manifest",
        "residual_dependency_disclosure",
        "deployment_profile_truth_packet",
        "usage_and_forecast_export",
        "chargeback_export",
        "entitlement_summary",
        "support_bundle",
        "offboarding_export"
      ]
    },
    "boundary_action_kind_class": {
      "type": "string",
      "enum": [
        "export_evidence",
        "continue_local",
        "view_procurement_packet",
        "view_residual_dependencies",
        "view_deployment_profile_truth",
        "learn_about_paid"
      ]
    },
    "cost_figure_disclosure_class": {
      "type": "string",
      "enum": ["deferred_to_metering_surfaces", "bound_to_unit_as_of_scope"]
    },
    "boundary_surface_class": {
      "type": "string",
      "enum": [
        "help_about",
        "release_center",
        "diagnostics",
        "procurement_packet",
        "support_admin_packet",
        "claim_public_truth_automation"
      ]
    },
    "residual_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "dependency_class",
        "remains_vendor_hosted",
        "eliminated_under_self_host",
        "disclosure"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_boundary_residual_dependency" },
        "schema_version": { "const": 1 },
        "dependency_class": { "$ref": "#/$defs/dependency_class" },
        "remains_vendor_hosted": {
          "type": "boolean",
          "description": "True when the dependency stays vendor-hosted in the managed/online profiles."
        },
        "eliminated_under_self_host": {
          "type": "boolean",
          "description": "True when self-hosting or a customer-operated mirror removes the dependency. At least one of remains_vendor_hosted / eliminated_under_self_host MUST be true so the disclosure is never empty."
        },
        "disclosure": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "deployment_profile_qualifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "holds_in_profiles",
        "not_offered_in_profiles",
        "qualifier_note"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_boundary_profile_qualifier" },
        "schema_version": { "const": 1 },
        "holds_in_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deployment_profile_class" },
          "description": "The deployment profiles in which the card's open/paid boundary statement is accurate; non-empty so no boundary is implied universal when it is not."
        },
        "not_offered_in_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deployment_profile_class" },
          "description": "The deployment profiles in which the managed lane is not offered; MUST NOT intersect holds_in_profiles."
        },
        "qualifier_note": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "procurement_support_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_kinds",
        "export_guarantee",
        "support_admin_packet_ref",
        "summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_boundary_procurement_evidence" },
        "schema_version": { "const": 1 },
        "packet_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/procurement_packet_kind_class" },
          "description": "The procurement/support packet kinds the card links; procurement and support surfaces reuse this same object."
        },
        "export_guarantee": { "$ref": "#/$defs/export_guarantee_class" },
        "support_admin_packet_ref": { "$ref": "#/$defs/stable_token" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "boundary_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "schema_version", "kind", "rank", "label"],
      "properties": {
        "record_kind": { "const": "m5_commercial_boundary_card_action" },
        "schema_version": { "const": 1 },
        "kind": { "$ref": "#/$defs/boundary_action_kind_class" },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "description": "Render rank; lower is higher priority. A learn_about_paid action MUST rank below every export_evidence, view_procurement_packet, and continue_local action on the same card."
        },
        "label": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "boundary_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "card_id",
        "title",
        "summary",
        "boundary_class",
        "open_paid_statement",
        "posture_origin",
        "residual_dependencies",
        "deployment_profile_qualifier",
        "procurement_support_evidence",
        "local_safe_baseline",
        "cost_figure_disclosure",
        "as_of",
        "evidence_status",
        "actions",
        "declared_marketed_claim",
        "effective_marketed_claim"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_boundary_card" },
        "schema_version": { "const": 1 },
        "card_id": { "$ref": "#/$defs/stable_token" },
        "title": { "$ref": "#/$defs/reviewable_sentence" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" },
        "boundary_class": { "$ref": "#/$defs/boundary_class" },
        "service_family": {
          "$ref": "#/$defs/service_family_class",
          "description": "Present for a managed_paid_optional card; absent for the local_open_source card."
        },
        "open_paid_statement": { "$ref": "#/$defs/reviewable_sentence" },
        "posture_origin": { "$ref": "#/$defs/posture_origin_class" },
        "residual_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/residual_dependency" },
          "description": "Empty only for the local_open_source card; non-empty for every managed_paid_optional card."
        },
        "deployment_profile_qualifier": { "$ref": "#/$defs/deployment_profile_qualifier" },
        "procurement_support_evidence": { "$ref": "#/$defs/procurement_support_evidence" },
        "local_safe_baseline": {
          "$ref": "#/$defs/non_empty_reviewable_sentence_array",
          "description": "Non-empty so the local core keeps running; a stale or unavailable metering/rating path never blocks local editing, search, Git, or local automation."
        },
        "cost_figure_disclosure": {
          "$ref": "#/$defs/cost_figure_disclosure_class",
          "description": "Boundary cards defer spend/quota numbers to the metering surfaces; a number is never shown bare."
        },
        "as_of": {
          "$ref": "#/$defs/utc_date_time",
          "description": "Last evidence as-of time; present even when no number is shown."
        },
        "evidence_status": { "$ref": "#/$defs/boundary_evidence_status_class" },
        "actions": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/boundary_action" },
          "description": "Ranked actions. MUST include export_evidence, continue_local, and view_procurement_packet, and no learn_about_paid action may rank above them."
        },
        "declared_marketed_claim": {
          "$ref": "#/$defs/marketed_claim_class",
          "description": "managed_full for a managed_paid_optional card; local_safe_only for the local_open_source card."
        },
        "effective_marketed_claim": {
          "$ref": "#/$defs/marketed_claim_class",
          "description": "The declared claim capped by the evidence status."
        },
        "recovery_cue": {
          "$ref": "#/$defs/reviewable_sentence",
          "description": "Present only when the card is narrowed below its declared claim."
        }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "binding_id",
        "surface",
        "bound_card_ids",
        "projects_effective_claim",
        "renders_local_safe_baseline",
        "discloses_residual_dependencies",
        "names_deployment_profile_qualifier",
        "surfaces_evidence_before_upsell",
        "summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_boundary_surface_binding" },
        "schema_version": { "const": 1 },
        "binding_id": { "$ref": "#/$defs/stable_token" },
        "surface": { "$ref": "#/$defs/boundary_surface_class" },
        "bound_card_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_token" }
        },
        "projects_effective_claim": { "const": true },
        "renders_local_safe_baseline": { "const": true },
        "discloses_residual_dependencies": { "const": true },
        "names_deployment_profile_qualifier": { "const": true },
        "surfaces_evidence_before_upsell": { "const": true },
        "summary": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "inspection_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "card_count",
        "surface_binding_count",
        "local_open_card_count",
        "managed_paid_card_count",
        "service_families_covered",
        "managed_lane_coverage_complete",
        "surface_coverage_complete",
        "all_cards_local_safe_backed",
        "all_managed_cards_disclose_residual",
        "all_cards_qualify_deployment_profile",
        "all_cards_link_procurement_evidence",
        "value_never_bare",
        "upsell_never_outranks_truth",
        "effective_full_card_count",
        "narrowed_card_count",
        "local_safe_only_card_count"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_boundary_card_inspection" },
        "schema_version": { "const": 1 },
        "card_count": { "type": "integer", "minimum": 7 },
        "surface_binding_count": { "type": "integer", "minimum": 6 },
        "local_open_card_count": { "const": 1 },
        "managed_paid_card_count": { "type": "integer", "minimum": 6 },
        "service_families_covered": { "type": "integer", "minimum": 6 },
        "managed_lane_coverage_complete": { "const": true },
        "surface_coverage_complete": { "const": true },
        "all_cards_local_safe_backed": { "const": true },
        "all_managed_cards_disclose_residual": { "const": true },
        "all_cards_qualify_deployment_profile": { "const": true },
        "all_cards_link_procurement_evidence": { "const": true },
        "value_never_bare": { "const": true },
        "upsell_never_outranks_truth": { "const": true },
        "effective_full_card_count": { "type": "integer", "minimum": 0 },
        "narrowed_card_count": { "type": "integer", "minimum": 0 },
        "local_safe_only_card_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
