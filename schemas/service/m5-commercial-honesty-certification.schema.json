{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/service/m5-commercial-honesty-certification.schema.json",
  "title": "Aureline commercial honesty-certification packet",
  "description": "Boundary schema for the cross-lane certification of entitlement, metering, forecast, chargeback, and downgrade/offboarding honesty across the claimed managed deployment profiles. The packet freezes exactly one certification row per honesty dimension (entitlement, metering, forecast, chargeback, downgrade/offboarding, and commercial-boundary honesty). Each row names the sibling consumer packet that backs it, the managed service families it applies across, the deployment profiles it is certified in and the profiles its managed lane is honestly not offered in (together partitioning all five profiles, so the self-host, air-gapped, and mirror profiles are always addressed and the certification is never drawn from one vendor-managed online profile alone), the certification drills that exercise it, and a non-empty local-safe baseline. Each drill carries a grade and a backing-evidence freshness status whose weaker marketed-claim cap recomputes the drill cap; a row's effective certified claim is the weakest of its declared claim and every drill cap, so a failed drill or stale evidence narrows the claim from managed_full to managed_narrowed or local_safe_only automatically rather than inheriting broader managed marketing language. The packet also pins one surface binding per consumer surface (release center, Help/About, diagnostics, service health, support/admin packet, claim/public-truth automation), each projecting the effective claim, and at least the release center and claim automation narrow the marketed claim on a failed certification. Raw URLs, raw hostnames, raw tenant names, raw account ids, raw billing account ids, raw invoice numbers, raw price-list values, raw spend or quota numbers, raw key bytes, raw cloud-region identifiers, and raw secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "packet_revision",
    "title",
    "summary",
    "source_refs",
    "rows",
    "surface_bindings",
    "inspection"
  ],
  "properties": {
    "record_kind": { "const": "m5_commercial_honesty_certification" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/utc_date_time" },
    "packet_revision": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/$defs/reviewable_sentence" },
    "summary": { "$ref": "#/$defs/reviewable_sentence" },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_string" },
      "description": "Schema and contract refs. MUST include schemas/service/m5-commercial-honesty-certification.schema.json and SHOULD cite each backing-consumer artifact."
    },
    "rows": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "surface_bindings": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/surface_binding" }
    },
    "inspection": { "$ref": "#/$defs/inspection_block" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "reviewable_sentence": {
      "type": "string",
      "minLength": 1,
      "description": "Short product-term sentence safe for product copy, support export, procurement export, and release evidence. Raw URLs, raw hostnames, raw tenant names, raw account ids, raw billing account ids, raw invoice numbers, raw price-list values, raw spend or quota numbers, raw key bytes, raw cloud-region identifiers, and raw secret material MUST NOT appear."
    },
    "non_empty_reviewable_sentence_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reviewable_sentence" }
    },
    "utc_date_time": { "type": "string", "format": "date-time" },
    "service_family_class": {
      "type": "string",
      "enum": [
        "sync_family",
        "registry_or_mirror_metadata_family",
        "collaboration_relay_family",
        "remote_workspace_control_plane_family",
        "ai_gateway_family",
        "telemetry_or_support_ingest_family"
      ]
    },
    "marketed_claim_class": {
      "type": "string",
      "enum": ["managed_full", "managed_narrowed", "local_safe_only"]
    },
    "deployment_profile_class": {
      "type": "string",
      "enum": [
        "individual_local",
        "self_hosted",
        "enterprise_online",
        "air_gapped",
        "managed_cloud"
      ]
    },
    "honesty_dimension_class": {
      "type": "string",
      "enum": [
        "entitlement_honesty",
        "metering_honesty",
        "forecast_honesty",
        "chargeback_honesty",
        "downgrade_offboarding_honesty",
        "commercial_boundary_honesty"
      ]
    },
    "certification_drill_class": {
      "type": "string",
      "enum": [
        "stale_meter_drill",
        "fail_open_local_core",
        "fail_closed_managed_action",
        "seat_loss_drill",
        "org_switch_drill",
        "grace_period_drill",
        "export_rights_validation",
        "chargeback_scope_export_check",
        "residual_dependency_disclosure_review"
      ]
    },
    "drill_grade_class": {
      "type": "string",
      "enum": ["certified", "narrowed", "not_applicable"]
    },
    "boundary_evidence_status_class": {
      "type": "string",
      "enum": ["current", "stale", "missing", "downgraded"]
    },
    "backing_consumer_class": {
      "type": "string",
      "enum": [
        "commercial_control_plane",
        "entitlement_summary",
        "usage_forecast_views",
        "chargeback_scope_views",
        "metering_degradation_rules",
        "offboarding_cards",
        "commercial_boundary_cards"
      ]
    },
    "certification_surface_class": {
      "type": "string",
      "enum": [
        "release_center",
        "help_about",
        "diagnostics",
        "service_health",
        "support_admin_packet",
        "claim_public_truth_automation"
      ]
    },
    "drill_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "drill",
        "grade",
        "evidence_status",
        "claim_cap",
        "backing_consumer",
        "detail"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_certification_drill_result" },
        "schema_version": { "const": 1 },
        "drill": { "$ref": "#/$defs/certification_drill_class" },
        "grade": { "$ref": "#/$defs/drill_grade_class" },
        "evidence_status": { "$ref": "#/$defs/boundary_evidence_status_class" },
        "claim_cap": {
          "$ref": "#/$defs/marketed_claim_class",
          "description": "The weaker of the grade cap and the evidence cap; recomputed, never authored independently."
        },
        "backing_consumer": { "$ref": "#/$defs/backing_consumer_class" },
        "detail": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "dimension",
        "title",
        "summary",
        "backing_consumer",
        "service_families",
        "certified_profiles",
        "not_offered_profiles",
        "drills",
        "local_safe_baseline",
        "declared_marketed_claim",
        "effective_certified_claim",
        "narrowing_reasons"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_honesty_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "dimension": { "$ref": "#/$defs/honesty_dimension_class" },
        "title": { "$ref": "#/$defs/reviewable_sentence" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" },
        "backing_consumer": { "$ref": "#/$defs/backing_consumer_class" },
        "service_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/service_family_class" }
        },
        "certified_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deployment_profile_class" },
          "description": "Deployment profiles the row's honesty is certified in. Together with not_offered_profiles, MUST cover all five profiles with no overlap."
        },
        "not_offered_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deployment_profile_class" },
          "description": "Deployment profiles the row's managed lane is honestly not offered in."
        },
        "drills": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/drill_result" }
        },
        "local_safe_baseline": { "$ref": "#/$defs/non_empty_reviewable_sentence_array" },
        "declared_marketed_claim": {
          "const": "managed_full",
          "description": "Certification rows certify a managed claim; the local-safe baseline is carried separately and always continues."
        },
        "effective_certified_claim": {
          "$ref": "#/$defs/marketed_claim_class",
          "description": "The weakest of the declared claim and every drill cap; recomputed, never authored independently."
        },
        "narrowing_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/certification_drill_class" },
          "description": "The drills whose cap narrowed the row below its declared claim."
        },
        "recovery_cue": {
          "$ref": "#/$defs/reviewable_sentence",
          "description": "Present only when the row is narrowed; absent on a fully certified row."
        }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "binding_id",
        "surface",
        "bound_dimensions",
        "projects_effective_claim",
        "narrows_on_failure",
        "summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_certification_surface_binding" },
        "schema_version": { "const": 1 },
        "binding_id": { "$ref": "#/$defs/non_empty_string" },
        "surface": { "$ref": "#/$defs/certification_surface_class" },
        "bound_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/honesty_dimension_class" }
        },
        "projects_effective_claim": {
          "const": true,
          "description": "A surface MUST project the effective claim, never a stronger one."
        },
        "narrows_on_failure": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "inspection_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_count",
        "dimensions_covered",
        "dimension_vocab_complete",
        "drills_exercised",
        "drill_vocab_complete",
        "total_drill_results",
        "deployment_profiles_addressed",
        "deployment_profiles_certified",
        "addresses_all_deployment_profiles",
        "certifies_self_host_or_offline",
        "surface_binding_count",
        "surface_coverage_complete",
        "all_rows_local_safe_backed",
        "certified_row_count",
        "narrowed_row_count",
        "local_safe_only_row_count",
        "fully_certified"
      ],
      "properties": {
        "record_kind": { "const": "m5_commercial_honesty_certification_inspection" },
        "schema_version": { "const": 1 },
        "row_count": { "type": "integer", "minimum": 0 },
        "dimensions_covered": { "type": "integer", "minimum": 0 },
        "dimension_vocab_complete": { "type": "boolean" },
        "drills_exercised": { "type": "integer", "minimum": 0 },
        "drill_vocab_complete": { "type": "boolean" },
        "total_drill_results": { "type": "integer", "minimum": 0 },
        "deployment_profiles_addressed": { "type": "integer", "minimum": 0, "maximum": 5 },
        "deployment_profiles_certified": { "type": "integer", "minimum": 0, "maximum": 5 },
        "addresses_all_deployment_profiles": { "type": "boolean" },
        "certifies_self_host_or_offline": { "type": "boolean" },
        "surface_binding_count": { "type": "integer", "minimum": 0 },
        "surface_coverage_complete": { "type": "boolean" },
        "all_rows_local_safe_backed": { "type": "boolean" },
        "certified_row_count": { "type": "integer", "minimum": 0 },
        "narrowed_row_count": { "type": "integer", "minimum": 0 },
        "local_safe_only_row_count": { "type": "integer", "minimum": 0 },
        "fully_certified": { "type": "boolean" }
      }
    }
  }
}
