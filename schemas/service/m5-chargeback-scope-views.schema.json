{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/service/m5-chargeback-scope-views.schema.json",
  "title": "Aureline chargeback-scope view set",
  "description": "Boundary schema for the frozen chargeback-scope view set across the M5 managed lanes. The set pins one view per claimed service family (AI gateway, settings sync, collaboration relay, registry/mirror, support ingest, managed workspace) and a single scope switcher across them. Each view keeps one cost truth per offered chargeback scope, so personal, workspace, team, and organization never collapse into one ambiguous owner total, and each scope truth separates a direct cost line from an inherited share that names the broader parent scope it rolls up from (the broadest scope is the chain root and explicitly marks its inherited line not applicable rather than a hidden zero). Every cost line is a descriptor (unit, aggregation window, scope owner, as-of time, freshness, and value presentation — never a raw number) and the set exports at CSV/JSON parity. The view's effective marketed claim is recomputed from the active managed state's cap, so a stale meter, an exhausted forecast, a grace window, a removed seat, an org switch, or a plan downgrade narrows the marketed chargeback claim automatically. The switcher preserves the active scope, the inherited-versus-direct separation, and the owner identity, and never collapses the scopes. One surface binding per surface (account chargeback, service-health diagnostics, Help/About, support/admin export, release center) projects the effective claim, renders the inherited-versus-direct separation, and renders the local-safe baseline. Raw URLs, raw hostnames, raw tenant names, raw account ids, raw billing account ids, raw invoice numbers, raw price-list values, raw spend or quota numbers, raw key bytes, raw cloud-region identifiers, and raw secret material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "set_id",
    "generated_at",
    "set_revision",
    "title",
    "summary",
    "source_refs",
    "switcher",
    "views",
    "surface_bindings",
    "inspection"
  ],
  "properties": {
    "record_kind": { "const": "m5_chargeback_scope_view_set" },
    "schema_version": { "const": 1 },
    "set_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/utc_date_time" },
    "set_revision": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/$defs/reviewable_sentence" },
    "summary": { "$ref": "#/$defs/reviewable_sentence" },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_string" },
      "description": "Schema and contract refs. MUST include schemas/service/m5-chargeback-scope-views.schema.json."
    },
    "active_managed_state": {
      "$ref": "#/$defs/managed_state_class",
      "description": "Present only on a narrowed export; the canonical set omits it."
    },
    "switcher": { "$ref": "#/$defs/scope_switcher" },
    "views": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/chargeback_scope_view" }
    },
    "surface_bindings": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/surface_binding" }
    },
    "inspection": { "$ref": "#/$defs/inspection_block" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "reviewable_sentence": {
      "type": "string",
      "minLength": 1,
      "description": "Short product-term sentence safe for product copy, support export, admin export, and release evidence. Raw URLs, raw hostnames, raw tenant names, raw account ids, raw billing account ids, raw invoice numbers, raw price-list values, raw spend or quota numbers, raw key bytes, raw cloud-region identifiers, and raw secret material MUST NOT appear."
    },
    "non_empty_reviewable_sentence_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reviewable_sentence" }
    },
    "reviewable_sentence_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewable_sentence" }
    },
    "owner_identity": {
      "type": "string",
      "minLength": 1,
      "description": "An opaque owner-identity ref (for example, scope-owner.ai_gateway.team.opaque); never a raw tenant name, account id, or any comma so the CSV export stays parseable.",
      "not": { "pattern": "," }
    },
    "stable_token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "utc_date_time": { "type": "string", "format": "date-time" },
    "service_family_class": {
      "type": "string",
      "enum": [
        "sync_family",
        "registry_or_mirror_metadata_family",
        "collaboration_relay_family",
        "remote_workspace_control_plane_family",
        "ai_gateway_family",
        "telemetry_or_support_ingest_family"
      ]
    },
    "meter_family_class": {
      "type": "string",
      "enum": [
        "profile_or_settings_sync_meter_family",
        "collaboration_relay_meter_family",
        "remote_workspace_control_plane_meter_family",
        "ai_gateway_meter_family",
        "registry_or_mirror_meter_family",
        "support_ingest_meter_family"
      ]
    },
    "service_id_class": {
      "type": "string",
      "enum": [
        "managed_settings_sync",
        "managed_marketplace",
        "managed_ai_broker",
        "managed_relay",
        "managed_catalog",
        "managed_telemetry_sink",
        "managed_support_export",
        "managed_entitlement_usage",
        "managed_offboarding_export"
      ]
    },
    "meter_unit_class": {
      "type": "string",
      "enum": [
        "tokens",
        "bytes_stored",
        "participant_minutes",
        "download_count",
        "workspace_hours",
        "support_bundle_count"
      ]
    },
    "aggregation_window_class": {
      "type": "string",
      "enum": ["calendar_month_utc", "rolling_24h", "rolling_30d", "contract_term"]
    },
    "scope_owner_class": {
      "type": "string",
      "enum": ["personal", "workspace", "team", "organization", "tenant", "byok_external"]
    },
    "snapshot_freshness_class": {
      "type": "string",
      "enum": [
        "freshness_live",
        "freshness_recent",
        "freshness_aging",
        "freshness_stale",
        "freshness_unknown",
        "freshness_not_applicable"
      ]
    },
    "managed_state_class": {
      "type": "string",
      "enum": [
        "signed_in",
        "local_only",
        "reauth_required",
        "managed_blocked",
        "grace_period",
        "seat_removed",
        "plan_downgrade",
        "org_switched",
        "forecast_threshold",
        "meter_stale"
      ],
      "description": "The locked, user-visible managed-state vocabulary."
    },
    "marketed_claim_class": {
      "type": "string",
      "enum": ["managed_full", "managed_narrowed", "local_safe_only"]
    },
    "value_presentation_class": {
      "type": "string",
      "enum": [
        "month_to_date_bound_to_unit_as_of_scope",
        "suppressed_no_managed_number"
      ]
    },
    "attribution_basis_class": {
      "type": "string",
      "enum": ["direct", "inherited"]
    },
    "chargeback_scope_surface_class": {
      "type": "string",
      "enum": [
        "account_chargeback_surface",
        "service_health_diagnostics",
        "help_about",
        "support_admin_export",
        "release_center"
      ]
    },
    "cost_attribution_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "attribution_basis",
        "meter_unit",
        "aggregation_window",
        "scope_owner",
        "as_of",
        "freshness",
        "value_presentation",
        "carries_raw_number"
      ],
      "properties": {
        "record_kind": { "const": "m5_chargeback_cost_attribution" },
        "schema_version": { "const": 1 },
        "attribution_basis": { "$ref": "#/$defs/attribution_basis_class" },
        "inherited_from": {
          "$ref": "#/$defs/scope_owner_class",
          "description": "The broader parent scope an inherited line rolls up from. Present only on an inherited line that has a parent; a direct line and the chain-root inherited line omit it."
        },
        "meter_unit": { "$ref": "#/$defs/meter_unit_class" },
        "aggregation_window": { "$ref": "#/$defs/aggregation_window_class" },
        "scope_owner": { "$ref": "#/$defs/scope_owner_class" },
        "as_of": { "$ref": "#/$defs/utc_date_time" },
        "freshness": { "$ref": "#/$defs/snapshot_freshness_class" },
        "value_presentation": {
          "$ref": "#/$defs/value_presentation_class",
          "description": "A shown cost is bound to the unit, as-of time, and scope owner; the chain-root inherited line suppresses the number rather than implying a zero."
        },
        "carries_raw_number": {
          "const": false,
          "description": "Always false: a raw spend or quota number never crosses this boundary."
        }
      }
    },
    "scope_cost_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "scope_owner",
        "owner_identity",
        "direct",
        "inherited",
        "summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_chargeback_scope_cost_truth" },
        "schema_version": { "const": 1 },
        "scope_owner": { "$ref": "#/$defs/scope_owner_class" },
        "owner_identity": { "$ref": "#/$defs/owner_identity" },
        "direct": { "$ref": "#/$defs/cost_attribution_measurement" },
        "inherited": { "$ref": "#/$defs/cost_attribution_measurement" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "schema_version", "csv", "json", "parity_confirmed"],
      "properties": {
        "record_kind": { "const": "m5_usage_export_parity" },
        "schema_version": { "const": 1 },
        "csv": { "const": true },
        "json": { "const": true },
        "parity_confirmed": {
          "const": true,
          "description": "Always true: CSV and JSON carry the same per-scope direct and inherited lines, unit, as-of time, and scope owner."
        }
      }
    },
    "chargeback_scope_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "view_id",
        "title",
        "summary",
        "lane_ref",
        "service_family",
        "meter_family",
        "meter_unit",
        "aggregation_window",
        "linked_service_ids",
        "scope_cost_truths",
        "export_parity",
        "applicable_managed_states",
        "declared_marketed_claim",
        "effective_marketed_claim",
        "narrowing_reasons",
        "local_safe_baseline",
        "blocked_managed_only_actions"
      ],
      "properties": {
        "record_kind": { "const": "m5_chargeback_scope_view" },
        "schema_version": { "const": 1 },
        "view_id": { "$ref": "#/$defs/stable_token" },
        "title": { "$ref": "#/$defs/reviewable_sentence" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" },
        "lane_ref": {
          "$ref": "#/$defs/stable_token",
          "description": "The control-plane lane this view projects."
        },
        "service_family": { "$ref": "#/$defs/service_family_class" },
        "meter_family": { "$ref": "#/$defs/meter_family_class" },
        "meter_unit": { "$ref": "#/$defs/meter_unit_class" },
        "aggregation_window": { "$ref": "#/$defs/aggregation_window_class" },
        "linked_service_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/service_id_class" }
        },
        "scope_cost_truths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scope_cost_truth" },
          "description": "One cost truth per offered scope; personal, workspace, team, and organization never collapse into one total."
        },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "applicable_managed_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/managed_state_class" }
        },
        "declared_marketed_claim": { "$ref": "#/$defs/marketed_claim_class" },
        "effective_marketed_claim": { "$ref": "#/$defs/marketed_claim_class" },
        "narrowing_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/managed_state_class" }
        },
        "recovery_cue": {
          "$ref": "#/$defs/reviewable_sentence",
          "description": "Present (non-null) when the view is narrowed below its declared claim."
        },
        "local_safe_baseline": {
          "$ref": "#/$defs/non_empty_reviewable_sentence_array",
          "description": "Non-empty so a stale or unavailable metering path narrows the managed chargeback view but never local editing, search, Git, or local automation."
        },
        "blocked_managed_only_actions": { "$ref": "#/$defs/reviewable_sentence_array" }
      }
    },
    "scope_switcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "switcher_id",
        "available_scopes",
        "active_scope",
        "preserves_active_scope",
        "preserves_inherited_direct_separation",
        "preserves_owner_identity",
        "never_collapses_scopes",
        "summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_chargeback_scope_switcher" },
        "schema_version": { "const": 1 },
        "switcher_id": { "$ref": "#/$defs/stable_token" },
        "available_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scope_owner_class" }
        },
        "active_scope": { "$ref": "#/$defs/scope_owner_class" },
        "preserves_active_scope": { "const": true },
        "preserves_inherited_direct_separation": { "const": true },
        "preserves_owner_identity": { "const": true },
        "never_collapses_scopes": { "const": true },
        "summary": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "binding_id",
        "surface",
        "bound_view_ids",
        "projects_effective_claim",
        "renders_inherited_direct_separation",
        "renders_local_safe_baseline",
        "summary"
      ],
      "properties": {
        "record_kind": { "const": "m5_chargeback_scope_surface_binding" },
        "schema_version": { "const": 1 },
        "binding_id": { "$ref": "#/$defs/stable_token" },
        "surface": { "$ref": "#/$defs/chargeback_scope_surface_class" },
        "bound_view_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_token" }
        },
        "projects_effective_claim": { "const": true },
        "renders_inherited_direct_separation": { "const": true },
        "renders_local_safe_baseline": { "const": true },
        "summary": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "inspection_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "view_count",
        "surface_binding_count",
        "service_families_covered",
        "scope_owners_covered",
        "all_views_separate_direct_and_inherited",
        "all_views_export_csv_json_parity",
        "value_never_bare",
        "no_collapsed_scope_total",
        "all_views_local_safe_backed",
        "switcher_preserves_active_scope",
        "switcher_active_scope_available",
        "active_scope",
        "effective_full_view_count",
        "narrowed_view_count",
        "local_safe_only_view_count"
      ],
      "properties": {
        "record_kind": { "const": "m5_chargeback_scope_inspection" },
        "schema_version": { "const": 1 },
        "view_count": { "type": "integer", "minimum": 6 },
        "surface_binding_count": { "type": "integer", "minimum": 5 },
        "service_families_covered": { "type": "integer", "minimum": 6 },
        "scope_owners_covered": { "type": "integer", "minimum": 4 },
        "all_views_separate_direct_and_inherited": { "const": true },
        "all_views_export_csv_json_parity": { "const": true },
        "value_never_bare": { "const": true },
        "no_collapsed_scope_total": { "const": true },
        "all_views_local_safe_backed": { "const": true },
        "switcher_preserves_active_scope": { "const": true },
        "switcher_active_scope_available": { "const": true },
        "active_scope": { "$ref": "#/$defs/scope_owner_class" },
        "effective_full_view_count": { "type": "integer", "minimum": 0 },
        "narrowed_view_count": { "type": "integer", "minimum": 0 },
        "local_safe_only_view_count": { "type": "integer", "minimum": 0 },
        "active_managed_state": { "$ref": "#/$defs/managed_state_class" }
      }
    }
  }
}
