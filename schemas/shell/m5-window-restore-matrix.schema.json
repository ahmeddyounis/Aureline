{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-window-restore-matrix.schema.json",
  "title": "Aureline M5 workspace-window, shared-authority, skeleton-restore, and no-rerun session-hydration matrix",
  "description": "Export-safe packet freezing Aureline's concrete multi-window ownership and restore-orchestration behavior. The packet names every claimed M5 workspace-restore profile — shared workspace authority backing multiple windows, window-local pane topology, skeleton-first / hydrate-second restore, no-rerun session hydration, and display-topology recovery — and binds each governed family to the claimed surface families that render it (shell, recovery, diagnostics, admin, docs/help, support-export), the restore contexts it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each family declares the controlled vocabularies it carries: the single controlled window-restore-role vocabulary consumers bind to (workspace_authority, window_topology, pane_role, layout_skeleton, session_hydration, restore_fidelity, display_affinity), plus family-specific shared-workspace-authority roles, window-local-topology roles, skeleton-first-restore roles, no-rerun-session-hydration roles, and display-topology-recovery roles. Hard invariants forbid rerunning commands or reattaching privileged sessions implicitly during restore, deleting layout structure silently on a missing extension or remote target, leaving windows or dialogs unreachable after a display-topology remap, merging workspace-authority and window-topology state into one opaque blob, and overclaiming restore fidelity when only context or evidence was reopened. The matrix binds back to the already-landed multi-window-parity and monitor-geometry-remap-and-restore-bounds packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "window_restore_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_workspace_window_shared_authority_skeleton_restore_and_no_rerun_session_hydration_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "window_restore_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/window_restore_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "window_restore_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "window_restore_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "window_restore_family": {
      "enum": [
        "shared_workspace_authority",
        "window_local_topology",
        "skeleton_first_restore",
        "no_rerun_session_hydration",
        "display_topology_recovery"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "workspace_authority",
        "window_topology",
        "pane_role",
        "layout_skeleton",
        "session_hydration",
        "restore_fidelity",
        "display_affinity"
      ]
    },
    "window_restore_row": {
      "type": "object",
      "required": [
        "window_restore_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore",
        "deletes_layout_structure_silently_on_missing_extension_or_remote_target",
        "leaves_windows_or_dialogs_unreachable_after_display_topology_remap",
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob",
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened"
      ],
      "properties": {
        "window_restore_family": {
          "$ref": "#/$defs/window_restore_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "shared_workspace_authority_roles": {
          "type": "array"
        },
        "window_local_topology_roles": {
          "type": "array"
        },
        "skeleton_first_restore_roles": {
          "type": "array"
        },
        "no_rerun_session_hydration_roles": {
          "type": "array"
        },
        "display_topology_recovery_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore": {
          "const": false
        },
        "deletes_layout_structure_silently_on_missing_extension_or_remote_target": {
          "const": false
        },
        "leaves_windows_or_dialogs_unreachable_after_display_topology_remap": {
          "const": false
        },
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob": {
          "const": false
        },
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened": {
          "const": false
        }
      }
    }
  }
}
