{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-status-bar-certification.schema.json",
  "title": "Aureline M5 status-bar item priority, placement, overflow & inspector back-link certification packet",
  "description": "Status-bar certification capstone on top of the frozen M5 shell-primitives matrix. For every claimed M5 status context — notebook, data/API, remote, preview, review, profiler, incident, and desktop base — the packet certifies that the status bar keeps recovery-critical, execution-context, ongoing-work, and ambient-metadata items in stable priority slots that never jitter or reflow around a spinner / vanity item, that every visible and overflowed item is reachable through keyboard search, a status menu, and a palette route, that every item links back to the narrowest useful inspector or command rather than a generic settings detour, and that a support export reconstructs the visible and overflowed items, their owning subsystems, and any critical-state displacement without a screenshot. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The ambient status-item-class, overflow-behavior, freshness, accessibility-route, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen shell-primitives matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_priority_classes",
    "required_reach_routes",
    "rows",
    "covered_contexts",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_status_bar_certification_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_status_bar_certification:v1" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_priority_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/priority_class" }
    },
    "required_reach_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/reach_route" }
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "covered_contexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/context" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "certification_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "$ref": "#/$defs/ref_list" },
    "release_center_refs": { "$ref": "#/$defs/ref_list" },
    "help_docs_refs": { "$ref": "#/$defs/ref_list" },
    "support_export_refs": { "$ref": "#/$defs/ref_list" },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "context": {
      "type": "string",
      "enum": [
        "notebook_lane",
        "data_api_lane",
        "remote_lane",
        "preview_lane",
        "review_lane",
        "profiler_lane",
        "incident_lane",
        "desktop_base_lane"
      ]
    },
    "priority_class": {
      "type": "string",
      "enum": [
        "recovery_critical",
        "execution_context",
        "ongoing_work",
        "ambient_metadata"
      ]
    },
    "reach_route": {
      "type": "string",
      "enum": ["keyboard_search", "status_menu", "palette_route"]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "placement_stability",
        "overflow_discoverability",
        "inspector_backlink",
        "support_export_parity"
      ]
    },
    "primitive_family": {
      "type": "string",
      "enum": [
        "status_bar_item",
        "status_overflow_menu",
        "tooltip",
        "hovercard",
        "peek_panel",
        "pinned_preview_promotion",
        "splitter_handle",
        "pane_resize_preset",
        "progress_indicator",
        "durable_job_row"
      ]
    },
    "status_item_class": {
      "type": "string",
      "enum": [
        "background_work",
        "connection_target",
        "deployment_profile",
        "sync_freshness",
        "problem_count",
        "mode_indicator",
        "notification_summary",
        "capacity_meter"
      ]
    },
    "overflow_behavior": {
      "type": "string",
      "enum": [
        "priority_pinned",
        "collapse_to_overflow_menu",
        "group_into_summary",
        "drop_vanity_item",
        "promote_severe_state",
        "keyboard_reachable_overflow"
      ]
    },
    "source_freshness_label": {
      "type": "string",
      "enum": [
        "live_canonical",
        "cached_snapshot",
        "stale_invalidated",
        "provider_attributed",
        "sampled_approximate",
        "refresh_in_flight"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "source_provider",
        "freshness",
        "reopen_path"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "placement_stability": {
      "type": "string",
      "enum": [
        "stable_priority_slots_no_jitter",
        "disclosed_compact_priority_compaction",
        "unstable_slots_or_vanity_reflow"
      ]
    },
    "overflow_discoverability": {
      "type": "string",
      "enum": [
        "keyboard_menu_palette_reachable",
        "disclosed_reduced_overflow_route",
        "overflow_hover_or_pointer_only"
      ]
    },
    "inspector_backlink": {
      "type": "string",
      "enum": [
        "every_item_backlinks_to_narrowest_inspector",
        "disclosed_grouped_backlink",
        "backlink_missing_or_generic_detour"
      ]
    },
    "support_export_parity": {
      "type": "string",
      "enum": [
        "visible_and_overflowed_items_reconstructable",
        "disclosed_partial_capture",
        "critical_displacement_absent_from_capture"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "vanity_item_reflow",
        "spinner_only_state",
        "hover_only_critical_truth",
        "source_freshness_hidden",
        "stale_preview_mistaken_for_live",
        "promotion_dropped_truth",
        "pointer_only_resize",
        "resize_state_not_serializable",
        "progress_lost_on_look_away",
        "grouped_progress_unattributed",
        "severe_state_displaced_truth",
        "proof_stale"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "context", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "context": { "$ref": "#/$defs/context" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "trigger", "disclosed", "detail"],
      "properties": {
        "context": { "$ref": "#/$defs/context" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "context_missing",
            "unstable_placement",
            "overflow_not_keyboard_reachable",
            "inspector_backlink_missing",
            "critical_displacement_absent_from_capture",
            "keyboard_reachability_lost",
            "priority_order_stale",
            "reach_routes_incomplete",
            "status_item_classes_incomplete",
            "narrowed_row_without_reason",
            "narrowed_row_without_waiver",
            "waiver_context_mismatch",
            "waiver_expired",
            "row_status_stale",
            "row_causes_stale",
            "status_counts_stale",
            "coverage_stale",
            "raw_boundary_material_in_export"
          ]
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "driven_primitive_families",
        "matrix_qualification",
        "owner_role",
        "context_label",
        "shell_zone_slot",
        "certified_priority_classes",
        "certified_reach_routes",
        "certified_status_item_classes",
        "overflow_behaviors",
        "source_freshness_labels",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "placement_stability",
        "overflow_discoverability",
        "inspector_backlink",
        "support_export_parity",
        "keyboard_reachable_without_hover",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "context": { "$ref": "#/$defs/context" },
        "driven_primitive_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/primitive_family" }
        },
        "matrix_qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "context_label": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "certified_priority_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/priority_class" }
        },
        "certified_reach_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reach_route" }
        },
        "certified_status_item_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/status_item_class" }
        },
        "overflow_behaviors": {
          "type": "array",
          "items": { "$ref": "#/$defs/overflow_behavior" }
        },
        "source_freshness_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_freshness_label" }
        },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "placement_stability": { "$ref": "#/$defs/placement_stability" },
        "overflow_discoverability": { "$ref": "#/$defs/overflow_discoverability" },
        "inspector_backlink": { "$ref": "#/$defs/inspector_backlink" },
        "support_export_parity": { "$ref": "#/$defs/support_export_parity" },
        "keyboard_reachable_without_hover": { "type": "boolean" },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    }
  }
}
