{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-metric-density-surface-certification.schema.json",
  "title": "Aureline M5 shell-metric-density surface certification packet",
  "description": "M05-1163 closing capstone certifying that the frozen M5 shell-geometry families (shell-metric, minimum-size, density-mode, responsive-geometry, collapse-priority) hold their truth on every claimed M5 desktop operating profile. Keyed on the claimed profile (live trusted geometry surface, reviewable geometry structure, unverified density-mode surface, unverified responsive-geometry surface, disclosed collapse-priority surface), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, snapped-width, CLI/export, degraded-state, and shell-geometry-component-truth behavior — and either passes (green), auto-narrows its geometry claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted geometry profile may certify a trusted geometry surface; and every B138 hard invariant must hold (density or collapse never changes command meaning, focus order, or trust visibility; an extension or embedded surface never sets a private fracturing width; a hit target never shrinks below the supported minimum; a primary workflow is never hidden behind an overlay-only fallback; and a zone never starves the main workspace). Every row cites exactly one canonical shell-geometry proof bundle. The packet is metadata-only: raw pixel geometry, absolute window coordinates, z-index integers, credentials, secrets, and endpoint refs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_shell_metric_density_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-shell-metric-density-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_geometry_surface",
        "reviewable_geometry_structure",
        "unverified_density_mode_surface",
        "unverified_responsive_geometry_surface",
        "disclosed_collapse_priority_surface"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "snapped_width",
        "cli_export",
        "degraded_state",
        "shell_geometry_component_truth"
      ]
    },
    "geometry_claim": {
      "enum": [
        "trusted_geometry_surface",
        "reviewable_geometry_surface",
        "density_mode_unverified_projection",
        "responsive_geometry_unverified_projection",
        "collapse_priority_disclosed_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "geometry_family": {
      "enum": [
        "shell_metric",
        "minimum_size",
        "density_mode",
        "responsive_geometry",
        "collapse_priority"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "density_changed_command_or_focus_or_trust",
        "responsive_collapse_dropped_recovery_state",
        "zone_starved_main_workspace",
        "extension_set_private_fracturing_width",
        "hit_target_shrank_below_minimum",
        "primary_workflow_hidden_behind_overlay_only_fallback",
        "metric_copied_by_hand_across_packages",
        "size_metric_unstated",
        "density_mode_unstated",
        "responsive_class_unstated",
        "registry_reference_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lets_density_or_collapse_change_command_focus_or_trust",
        "lets_an_extension_or_embedded_surface_set_a_private_fracturing_width",
        "shrinks_a_hit_target_below_the_supported_minimum",
        "hides_a_primary_workflow_behind_an_overlay_only_fallback",
        "lets_a_zone_starve_the_main_workspace"
      ],
      "properties": {
        "lets_density_or_collapse_change_command_focus_or_trust": { "const": false },
        "lets_an_extension_or_embedded_surface_set_a_private_fracturing_width": { "const": false },
        "shrinks_a_hit_target_below_the_supported_minimum": { "const": false },
        "hides_a_primary_workflow_behind_an_overlay_only_fallback": { "const": false },
        "lets_a_zone_starve_the_main_workspace": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/geometry_claim" },
        "to_claim": { "$ref": "#/$defs/geometry_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_shell_metric_density_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/geometry_claim" },
        "certified_claim": { "$ref": "#/$defs/geometry_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/geometry_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-shell-metric-density-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
