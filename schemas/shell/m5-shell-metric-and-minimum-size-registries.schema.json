{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-metric-and-minimum-size-registries.schema.json",
  "title": "Aureline M5 shell-metric and minimum-size registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 shell-metric / density matrix. It carries resolved, honest projections of the shell-metric and minimum-size shell-geometry families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved shell-metric entries (naming a canonical registry token, a semantic role, a metric role, a shell zone, logical-pixel bounds inside the zone's canonical envelope, and comfortable/standard/compact density coverage that never starves the main workspace and preserves task identity under snapped widths) and resolved minimum-size entries (naming a canonical registry token, a minimum-size role, a semantic role, a control class, a declared minimum hit dimension at or above the control's canonical minimum, and reachability by pointer and keyboard). Hard invariants forbid a zone starving the main workspace below its minimum, a hit target shrinking below the supported minimum, an extension or embedded surface setting a private fracturing width, and a metric being hand-copied instead of tracing to the registry. Acceptance criteria — all claimed M5 shell surfaces resolve their geometry from the shared metric registry, minimum editor and control hit-target guarantees hold under supported density modes and snapped-window widths, and regression suites fail when a surface drifts outside the canonical B138 metric envelope — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_shell_metric_and_minimum_size_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "geometry_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "geometry_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_metric_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_task_identity_under_collapse",
        "metric_role",
        "metric_role_hand_copied",
        "zone",
        "zone_is_classified",
        "zone_is_workspace_dominant",
        "surface_context",
        "density_coverage",
        "covers_all_density_modes",
        "minimum_px",
        "default_px",
        "recommended_px",
        "maximum_px",
        "within_canonical_envelope",
        "bound_to_registry",
        "starves_main_workspace",
        "preserves_task_identity_under_snapped_width",
        "degrade_reason",
        "next_action",
        "metric_holds_across_density_and_snapped_widths"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_task_identity_under_collapse": { "type": "boolean" },
        "metric_role": { "$ref": "#/$defs/non_empty_string" },
        "metric_role_hand_copied": { "type": "boolean" },
        "zone": { "$ref": "#/$defs/non_empty_string" },
        "zone_is_classified": { "type": "boolean" },
        "zone_is_workspace_dominant": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "density_coverage": { "type": "array" },
        "covers_all_density_modes": { "type": "boolean" },
        "minimum_px": { "type": "integer", "minimum": 0 },
        "default_px": { "type": "integer", "minimum": 0 },
        "recommended_px": { "type": "integer", "minimum": 0 },
        "maximum_px": { "type": "integer", "minimum": 0 },
        "within_canonical_envelope": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "starves_main_workspace": { "type": "boolean" },
        "preserves_task_identity_under_snapped_width": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "metric_holds_across_density_and_snapped_widths": { "type": "boolean" }
      }
    },
    "minimum_size_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "minimum_size_role",
        "minimum_size_role_shrinks_below_minimum",
        "semantic_role",
        "control",
        "control_is_classified",
        "surface_context",
        "density_coverage",
        "covers_all_density_modes",
        "declared_minimum_px",
        "canonical_minimum_px",
        "meets_supported_minimum",
        "pointer_and_keyboard_reachable",
        "degrade_reason",
        "next_action",
        "hit_target_holds_across_density"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "minimum_size_role": { "$ref": "#/$defs/non_empty_string" },
        "minimum_size_role_shrinks_below_minimum": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "control": { "$ref": "#/$defs/non_empty_string" },
        "control_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "density_coverage": { "type": "array" },
        "covers_all_density_modes": { "type": "boolean" },
        "declared_minimum_px": { "type": "integer", "minimum": 0 },
        "canonical_minimum_px": { "type": "integer", "minimum": 0 },
        "meets_supported_minimum": { "type": "boolean" },
        "pointer_and_keyboard_reachable": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "hit_target_holds_across_density": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "shell_metric_entries",
        "minimum_size_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "lets_zone_starve_main_workspace_below_minimum",
        "shrinks_hit_target_below_supported_minimum",
        "extension_or_embedded_sets_private_fracturing_width",
        "metric_hand_copied_instead_of_registry"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "shell_metric_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shell_metric_entry" }
        },
        "minimum_size_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/minimum_size_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "lets_zone_starve_main_workspace_below_minimum": { "const": false },
        "shrinks_hit_target_below_supported_minimum": { "const": false },
        "extension_or_embedded_sets_private_fracturing_width": { "const": false },
        "metric_hand_copied_instead_of_registry": { "const": false }
      }
    }
  }
}
