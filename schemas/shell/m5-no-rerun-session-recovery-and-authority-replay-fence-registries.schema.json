{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-no-rerun-session-recovery-and-authority-replay-fence-registries.schema.json",
  "title": "Aureline M5 no-rerun session-recovery and authority-replay-fence registries",
  "description": "Export-safe packet for the no-hidden-rerun recovery implement lane over the frozen M5 window-restore matrix. It carries resolved, honest projections of the no-rerun-session-hydration family across the claimed M5 consumer surfaces, resolving every session-scoped surface (terminal, debug session, notebook, preview, remote shell, collaboration pane) to one explicit reconnect-or-rerun posture and fencing off silent reacquisition of privileged authority. Each registry row binds a consumer surface to resolved recovery-posture entries (naming a canonical registry token, a stable recovery-target ID, a semantic role, a classified recovery-posture state, published session surface / session scope / prior authority snapshot / provenance class / reconnect plan / distinct reauthorization plan, and canonical/accessible/audit resolution-form coverage while deciding the explicit posture before any replay and disclosing reauthorization when the posture requires fresh user intent) and resolved authority-replay-fence entries (naming a canonical registry token, a stable guarded-surface ID, a semantic role, a classified authority-replay-fence class, published preserved surface role / prior authority class / provenance hint, and the preserved-surface-role / prior-authority-class / provenance-hint disclosure triple). Hard invariants forbid session-scoped work rerunning or reacquiring authority automatically after restore, the fact that reauthorization is required being hidden, recovery-posture and authority-fence state being merged into one opaque blob, and live continuity being overclaimed when only context or evidence restored. Acceptance criteria — session-scoped surfaces never rerun or regain authority automatically after restore; users can distinguish context-only restore from truly live session continuity; and recovery drills fail when restore replays session-scoped work or hides that reauthorization is required — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_no_rerun_session_recovery_and_authority_replay_fence_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "window_restore_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "window_restore_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "recovery_posture_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "recovery_target_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority",
        "recovery_posture_state",
        "recovery_posture_state_is_classified",
        "canonical_recovery_posture_mode",
        "surface_context",
        "session_surface_id",
        "session_scope",
        "prior_authority_snapshot",
        "provenance_class",
        "reconnect_plan_ref",
        "reauthorization_plan_ref",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "recovery_posture_object_complete",
        "bound_to_registry",
        "posture_decided_before_replay",
        "requires_fresh_user_intent",
        "reauthorization_disclosed_when_required",
        "degrade_reason",
        "next_action",
        "posture_resolves_across_recoveries"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "recovery_target_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority": { "type": "boolean" },
        "recovery_posture_state": { "$ref": "#/$defs/non_empty_string" },
        "recovery_posture_state_is_classified": { "type": "boolean" },
        "canonical_recovery_posture_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "session_surface_id": { "type": "string" },
        "session_scope": { "type": "string" },
        "prior_authority_snapshot": { "type": "string" },
        "provenance_class": { "type": "string" },
        "reconnect_plan_ref": { "type": "string" },
        "reauthorization_plan_ref": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "recovery_posture_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "posture_decided_before_replay": { "type": "boolean" },
        "requires_fresh_user_intent": { "type": "boolean" },
        "reauthorization_disclosed_when_required": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "posture_resolves_across_recoveries": { "type": "boolean" }
      }
    },
    "authority_replay_fence_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "guarded_surface_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority",
        "fence_class",
        "fence_class_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "preserved_surface_role",
        "prior_authority_class",
        "provenance_hint",
        "preserves_surface_and_provenance",
        "fence_is_truthful",
        "authority_was_held_used",
        "reauthorization_required_disclosed",
        "privileged_flow_deferred",
        "fresh_intent_required_disclosed",
        "fence_holds_no_reacquire",
        "provides_complete_disclosure_triple",
        "degrade_reason",
        "next_action",
        "fence_holds_on_every_surface"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "guarded_surface_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority": { "type": "boolean" },
        "fence_class": { "$ref": "#/$defs/non_empty_string" },
        "fence_class_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "preserved_surface_role": { "type": "string" },
        "prior_authority_class": { "type": "string" },
        "provenance_hint": { "type": "string" },
        "preserves_surface_and_provenance": { "type": "boolean" },
        "fence_is_truthful": { "type": "boolean" },
        "authority_was_held_used": { "type": "boolean" },
        "reauthorization_required_disclosed": { "type": "boolean" },
        "privileged_flow_deferred": { "type": "boolean" },
        "fresh_intent_required_disclosed": { "type": "boolean" },
        "fence_holds_no_reacquire": { "type": "boolean" },
        "provides_complete_disclosure_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fence_holds_on_every_surface": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "recovery_posture_entries",
        "authority_replay_fence_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "reruns_session_scoped_work_or_reacquires_authority_automatically_after_restore",
        "hides_that_reauthorization_is_required",
        "merges_recovery_posture_and_authority_fence_into_one_opaque_blob",
        "overclaims_live_continuity_when_only_context_or_evidence_restored"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "recovery_posture_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recovery_posture_entry" }
        },
        "authority_replay_fence_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/authority_replay_fence_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "reruns_session_scoped_work_or_reacquires_authority_automatically_after_restore": { "const": false },
        "hides_that_reauthorization_is_required": { "const": false },
        "merges_recovery_posture_and_authority_fence_into_one_opaque_blob": { "const": false },
        "overclaims_live_continuity_when_only_context_or_evidence_restored": { "const": false }
      }
    }
  }
}
