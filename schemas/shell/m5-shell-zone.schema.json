{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-zone.schema.json",
  "title": "Aureline M5 shell-zone, responsive-class, and multi-window continuity matrix",
  "description": "Export-safe packet freezing the canonical M5 live-shell object model. The packet names every claimed M5 surface family — notebook, data grid, profiler, pipeline, docs, preview, review, incident, companion, and operator — and binds each to its canonical shell slot, fallback slot, dependency-missing placeholder behavior, the responsive classes it must survive, the window classes it may live in, the allowed occupant transitions, the ordered responsive collapse ladder, the owning-window routing expectations, the workspace-global continuity truths every window preserves, evidence requirements, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. A self-describing vocabulary set freezes the controlled vocabulary for shell-zone slots, responsive classes, window classes, occupant transitions, fallback placements, owning-window routing, continuity truths, and placeholder behaviors. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "continuity_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_shell_zone_responsive_class_and_multi_window_continuity_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "continuity_review": { "$ref": "#/$defs/continuity_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "type": "string",
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "type": "string",
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "occupant_persistence": {
      "type": "string",
      "enum": ["side_by_side", "tabbed", "sheeted", "overflowed", "solo_docked"]
    },
    "fallback_placement": {
      "type": "string",
      "enum": ["docked", "sheet", "overflow", "placeholder"]
    },
    "owning_window_routing": {
      "type": "string",
      "enum": [
        "route_to_owning_window_object",
        "preserve_object_anchor_on_return",
        "no_focus_theft",
        "no_orphan_on_detach"
      ]
    },
    "continuity_truth": {
      "type": "string",
      "enum": [
        "workspace_global_trust",
        "remote_target",
        "deployment_profile",
        "recovery_state"
      ]
    },
    "placeholder_behavior": {
      "type": "string",
      "enum": [
        "in_slot_identity_preserved",
        "reconnect_remote_or_provider",
        "install_or_enable_dependency",
        "recentered_on_topology_drift"
      ]
    },
    "state_vocabulary": {
      "type": "string",
      "enum": [
        "responsive_class",
        "window_class",
        "occupant_persistence",
        "fallback_placement",
        "owning_window_routing",
        "continuity_truth"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": ["required", "recommended", "optional", "not_applicable"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "slot_undeclared",
        "collapse_changed_task_identity",
        "critical_state_hidden_on_collapse",
        "owning_window_routing_lost",
        "workspace_truth_diverged_across_windows",
        "placeholder_lost_identity_or_reopen",
        "secondary_display_topology_drift",
        "policy_blocked",
        "proof_stale",
        "upstream_dependency_narrowed"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "attaches_only_to_declared_slot",
        "collapse_preserves_task_identity",
        "critical_state_stays_visible_or_overflowed",
        "routes_to_owning_window_object",
        "window_preserves_workspace_global_truth",
        "placeholder_preserves_identity_and_reopen",
        "not_applicable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "qualification",
        "owner_role",
        "scope_summary",
        "required_fields",
        "canonical_slot",
        "fallback_slot",
        "placeholder_behavior",
        "state_vocabularies",
        "responsive_classes",
        "window_classes",
        "occupant_persistence",
        "fallback_placements",
        "owning_window_routing",
        "continuity_truths",
        "evidence_requirement",
        "required_proof_packet_refs",
        "downgrade_triggers",
        "rollback_posture",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "notebook",
            "data_grid",
            "profiler",
            "pipeline",
            "docs",
            "preview",
            "review",
            "incident",
            "companion",
            "operator"
          ]
        },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "canonical_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "fallback_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "placeholder_behavior": { "$ref": "#/$defs/placeholder_behavior" },
        "state_vocabularies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_vocabulary" }
        },
        "responsive_classes": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" },
          "contains": { "const": "primary_workspace_window" }
        },
        "occupant_persistence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/occupant_persistence" }
        },
        "fallback_placements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_placement" }
        },
        "owning_window_routing": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/owning_window_routing" }
        },
        "continuity_truths": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/continuity_truth" }
        },
        "evidence_requirement": { "$ref": "#/$defs/evidence_requirement" },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "rollback_posture": { "$ref": "#/$defs/rollback_posture" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_zone_slots",
        "responsive_classes",
        "window_classes",
        "occupant_persistence",
        "fallback_placements",
        "owning_window_routing",
        "continuity_truths",
        "placeholder_behaviors"
      ],
      "properties": {
        "shell_zone_slots": { "type": "array", "items": { "$ref": "#/$defs/shell_zone_slot" } },
        "responsive_classes": { "type": "array", "items": { "$ref": "#/$defs/responsive_class" } },
        "window_classes": { "type": "array", "items": { "$ref": "#/$defs/window_class" } },
        "occupant_persistence": { "type": "array", "items": { "$ref": "#/$defs/occupant_persistence" } },
        "fallback_placements": { "type": "array", "items": { "$ref": "#/$defs/fallback_placement" } },
        "owning_window_routing": { "type": "array", "items": { "$ref": "#/$defs/owning_window_routing" } },
        "continuity_truths": { "type": "array", "items": { "$ref": "#/$defs/continuity_truth" } },
        "placeholder_behaviors": { "type": "array", "items": { "$ref": "#/$defs/placeholder_behavior" } }
      }
    },
    "continuity_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_surfaces_attach_only_to_declared_slots",
        "responsive_collapse_never_changes_task_identity",
        "responsive_collapse_never_hides_critical_state",
        "every_window_preserves_workspace_global_trust_remote_profile_recovery",
        "layout_stays_local_while_truth_stays_global",
        "dialogs_notifications_approvals_route_to_owning_window_object",
        "no_focus_theft_or_orphaning",
        "secondary_display_and_zoom_preserve_identity",
        "one_shell_zone_matrix_not_local_layout_prose",
        "no_surface_invents_its_own_slot_or_collapse",
        "downgrade_narrows_instead_of_hides",
        "unmapped_surface_blocks_shell_maturity_claim"
      ],
      "properties": {
        "new_surfaces_attach_only_to_declared_slots": { "const": true },
        "responsive_collapse_never_changes_task_identity": { "const": true },
        "responsive_collapse_never_hides_critical_state": { "const": true },
        "every_window_preserves_workspace_global_trust_remote_profile_recovery": { "const": true },
        "layout_stays_local_while_truth_stays_global": { "const": true },
        "dialogs_notifications_approvals_route_to_owning_window_object": { "const": true },
        "no_focus_theft_or_orphaning": { "const": true },
        "secondary_display_and_zoom_preserve_identity": { "const": true },
        "one_shell_zone_matrix_not_local_layout_prose": { "const": true },
        "no_surface_invents_its_own_slot_or_collapse": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true },
        "unmapped_surface_blocks_shell_maturity_claim": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_frame_consumes_slot_matrix",
        "windowing_consumes_window_classes",
        "layout_consumes_responsive_classes",
        "status_bar_consumes_status_slot",
        "attention_router_routes_to_owning_window",
        "notification_envelope_uses_owning_window_routing",
        "docs_help_consume_slot_metadata",
        "release_proof_consumes_slot_metadata",
        "support_export_shows_shell_zone_matrix",
        "preview_labs_label_for_unmapped_surfaces"
      ],
      "properties": {
        "shell_frame_consumes_slot_matrix": { "const": true },
        "windowing_consumes_window_classes": { "const": true },
        "layout_consumes_responsive_classes": { "const": true },
        "status_bar_consumes_status_slot": { "const": true },
        "attention_router_routes_to_owning_window": { "const": true },
        "notification_envelope_uses_owning_window_routing": { "const": true },
        "docs_help_consume_slot_metadata": { "const": true },
        "release_proof_consumes_slot_metadata": { "const": true },
        "support_export_shows_shell_zone_matrix": { "const": true },
        "preview_labs_label_for_unmapped_surfaces": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "multi_window_proof_packet_ref",
        "support_export_parity_required",
        "multi_window_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "multi_window_proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "multi_window_parity_required": { "const": true }
      }
    }
  }
}
