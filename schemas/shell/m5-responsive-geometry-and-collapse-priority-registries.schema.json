{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-responsive-geometry-and-collapse-priority-registries.schema.json",
  "title": "Aureline M5 responsive-geometry and collapse-priority registries",
  "description": "Export-safe packet for the responsive-geometry / collapse-priority implement lane over the frozen M5 shell-metric / density matrix. It carries resolved, honest projections of the responsive-geometry and collapse-priority shell-geometry families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved window-class entries (naming a canonical registry token, a semantic role, a responsive-geometry role, a Compact / Standard / Expanded desktop window class, the exact canonical logical-pixel width bounds for that class, title / rail / sidebar / workspace / inspector / panel / status shell-zone coexistence, preserved task identity and recovery-critical state, and no hover-only action or unusable pane) and resolved collapse-step entries (naming a canonical registry token, a collapse-priority role, a collapse target, an identity-transition form, the canonical collapse-order rank, a dominant main workspace, and an identity-stable docked / sheet / overlay / temporary-panel transition). Hard invariants forbid a responsive change or collapse altering command / focus / trust, an extension inventing a private fracturing width, a zone starving the main workspace, and a primary workflow hidden behind an overlay-only fallback. Acceptance criteria — Compact / Standard / Expanded window classes produce predictable tokenized layout across every surface, docked / sheet / overlay / temporary-panel transitions stay identity-stable without hover-only actions or unusable panes, and extension surfaces that cannot honor the canonical geometry degrade honestly instead of inventing private widths — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_responsive_geometry_and_collapse_priority_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "geometry_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "geometry_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "window_class_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_task_identity_under_collapse",
        "responsive_geometry_role",
        "responsive_role_drops_recovery_state",
        "window_class",
        "window_class_is_classified",
        "surface_context",
        "min_width_px",
        "max_width_px",
        "canonical_min_width_px",
        "canonical_max_width_px",
        "matches_canonical_bounds",
        "coexisting_zones",
        "covers_all_zones",
        "preserves_task_identity",
        "preserves_recovery_critical_state",
        "makes_essential_action_hover_only",
        "narrows_editor_group_into_unusable_pane",
        "degrade_reason",
        "next_action",
        "responsive_change_preserves_task_identity"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_task_identity_under_collapse": { "type": "boolean" },
        "responsive_geometry_role": { "$ref": "#/$defs/non_empty_string" },
        "responsive_role_drops_recovery_state": { "type": "boolean" },
        "window_class": { "$ref": "#/$defs/non_empty_string" },
        "window_class_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "min_width_px": { "type": "integer", "minimum": 0 },
        "max_width_px": { "type": "integer", "minimum": 0 },
        "canonical_min_width_px": { "type": "integer", "minimum": 0 },
        "canonical_max_width_px": { "type": "integer", "minimum": 0 },
        "matches_canonical_bounds": { "type": "boolean" },
        "coexisting_zones": { "type": "array" },
        "covers_all_zones": { "type": "boolean" },
        "preserves_task_identity": { "type": "boolean" },
        "preserves_recovery_critical_state": { "type": "boolean" },
        "makes_essential_action_hover_only": { "type": "boolean" },
        "narrows_editor_group_into_unusable_pane": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "responsive_change_preserves_task_identity": { "type": "boolean" }
      }
    },
    "collapse_step_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_task_identity_under_collapse",
        "collapse_priority_role",
        "collapse_role_fractures_layout",
        "collapse_target",
        "target_is_classified",
        "target_is_protected",
        "transition_form",
        "form_is_classified",
        "surface_context",
        "collapses",
        "declared_collapse_rank",
        "canonical_collapse_rank",
        "matches_canonical_order",
        "preserves_identity_state_and_keyboard_route",
        "keeps_main_workspace_dominant",
        "hides_primary_workflow_behind_overlay_only",
        "degrade_reason",
        "next_action",
        "transition_is_identity_stable"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_task_identity_under_collapse": { "type": "boolean" },
        "collapse_priority_role": { "$ref": "#/$defs/non_empty_string" },
        "collapse_role_fractures_layout": { "type": "boolean" },
        "collapse_target": { "$ref": "#/$defs/non_empty_string" },
        "target_is_classified": { "type": "boolean" },
        "target_is_protected": { "type": "boolean" },
        "transition_form": { "$ref": "#/$defs/non_empty_string" },
        "form_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "collapses": { "type": "boolean" },
        "declared_collapse_rank": { "type": "integer", "minimum": 0 },
        "canonical_collapse_rank": { "type": ["integer", "null"], "minimum": 0 },
        "matches_canonical_order": { "type": "boolean" },
        "preserves_identity_state_and_keyboard_route": { "type": "boolean" },
        "keeps_main_workspace_dominant": { "type": "boolean" },
        "hides_primary_workflow_behind_overlay_only": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "transition_is_identity_stable": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "window_class_entries",
        "collapse_step_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "responsive_or_collapse_alters_command_focus_or_trust",
        "extension_sets_private_fracturing_width",
        "lets_zone_starve_main_workspace_below_minimum",
        "hides_primary_workflow_behind_overlay_only_fallback"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "window_class_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class_entry" }
        },
        "collapse_step_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/collapse_step_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "responsive_or_collapse_alters_command_focus_or_trust": { "const": false },
        "extension_sets_private_fracturing_width": { "const": false },
        "lets_zone_starve_main_workspace_below_minimum": { "const": false },
        "hides_primary_workflow_behind_overlay_only_fallback": { "const": false }
      }
    }
  }
}
