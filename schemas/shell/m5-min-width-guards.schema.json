{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-min-width-guards.schema.json",
  "title": "Aureline M5 min-width-guard (editor minimum / compare fallback / no unusable narrow pane) packet",
  "description": "Minimum-useful-size capstone on top of the frozen M5 shell-zone matrix. For every governed surface family — notebook, data grid, profiler, pipeline, docs, preview, review, incident, companion, and operator — the packet certifies that its editor / primary pane enforces a minimum useful width and height, that when a second group, compare, diff, or dense inspector would violate that minimum the surface falls back to a declared safe compare mode (tabbed compare, staged peek, sequential disclosure, or explicit user choice) instead of silently producing an unusable narrow split, and that breadcrumbs, active object identity, and recovery-critical status stay visible while the fallback is active. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the safe-fallback set and per-class plan checks are the lint that prevents a later narrow-pane regression from shipping as stable. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "responsive_class_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "absolute_min_useful_width_px",
    "absolute_min_useful_height_px",
    "standard_min_useful_width_px",
    "standard_min_useful_height_px",
    "rows",
    "covered_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "guard_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_min_width_guards_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "responsive_class_schema_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "absolute_min_useful_width_px": { "type": "integer", "minimum": 1 },
    "absolute_min_useful_height_px": { "type": "integer", "minimum": 1 },
    "standard_min_useful_width_px": { "type": "integer", "minimum": 1 },
    "standard_min_useful_height_px": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_families": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "guard_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "responsive_class": {
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "occupant_persistence": {
      "enum": ["side_by_side", "tabbed", "sheeted", "overflowed", "solo_docked"]
    },
    "compare_fallback_strategy": {
      "enum": [
        "side_by_side_split",
        "tabbed_compare",
        "staged_peek",
        "sequential_disclosure",
        "explicit_user_choice"
      ]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "min_size_enforcement": {
      "enum": [
        "min_useful_size_enforced",
        "disclosed_reduced_minimum",
        "pane_forced_below_usable_minimum"
      ]
    },
    "compare_fallback": {
      "enum": [
        "safe_fallback_before_unusable_split",
        "disclosed_fallback_narrowing",
        "silent_unusable_split"
      ]
    },
    "status_continuity": {
      "enum": [
        "identity_breadcrumbs_status_preserved",
        "disclosed_status_relocation",
        "status_or_identity_lost_under_fallback"
      ]
    },
    "class_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsive_class",
        "strategy",
        "meets_min_useful_size",
        "identity_and_status_preserved"
      ],
      "properties": {
        "responsive_class": { "$ref": "#/$defs/responsive_class" },
        "strategy": { "$ref": "#/$defs/compare_fallback_strategy" },
        "meets_min_useful_size": { "type": "boolean" },
        "identity_and_status_preserved": { "type": "boolean" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "trigger", "disclosed", "detail"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "matrix_qualification",
        "owner_role",
        "surface_label",
        "canonical_slot",
        "fallback_slot",
        "declared_responsive_classes",
        "declared_occupant_persistence",
        "declared_strategies",
        "compare_fallback_strategy",
        "min_useful_width_px",
        "min_useful_height_px",
        "class_plans",
        "min_size_enforcement",
        "compare_fallback",
        "status_continuity",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "guard_causes",
        "narrowing_reason"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "matrix_qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "surface_label": { "type": "string", "minLength": 1 },
        "canonical_slot": { "type": "string", "minLength": 1 },
        "fallback_slot": { "type": "string", "minLength": 1 },
        "declared_responsive_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "declared_occupant_persistence": {
          "type": "array",
          "items": { "$ref": "#/$defs/occupant_persistence" }
        },
        "declared_strategies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compare_fallback_strategy" }
        },
        "compare_fallback_strategy": { "$ref": "#/$defs/compare_fallback_strategy" },
        "min_useful_width_px": { "type": "integer", "minimum": 0 },
        "min_useful_height_px": { "type": "integer", "minimum": 0 },
        "class_plans": {
          "type": "array",
          "items": { "$ref": "#/$defs/class_plan" }
        },
        "min_size_enforcement": { "$ref": "#/$defs/min_size_enforcement" },
        "compare_fallback": { "$ref": "#/$defs/compare_fallback" },
        "status_continuity": { "$ref": "#/$defs/status_continuity" },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "guard_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
