{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-display-topology-recovery-and-role-continuity-registries.schema.json",
  "title": "Aureline M5 display-topology-recovery bounds-recovery and role-continuity registries",
  "description": "Export-safe packet for the display-topology-recovery implement lane over the frozen M5 window-restore matrix. It carries resolved, honest projections of the display-topology-recovery family across the claimed M5 consumer surfaces, resolving every window, dialog, or sheet to one explicit bounds-recovery posture (affinity monitor restored, clamped onto visible bounds, rescaled for a DPI change, relocated to a primary fallback, or a fullscreen surface restored to windowed bounds) that keeps the surface on visible bounds after display detach, dock / undock, DPI change, or fullscreen / desktop moves, and fencing off any reset of an auxiliary window into a generic window. Each registry row binds a consumer surface to resolved bounds-recovery entries (naming a canonical registry token, a stable remap-target ID, a semantic role, a classified bounds-recovery state, published window surface / monitor-affinity hint / resolved visible bounds / layout intent / provenance class / distinct keyboard-reach plan, and canonical/accessible/audit resolution-form coverage while resolving the bounds before the surface is presented and recording a material topology adjustment in provenance) and resolved role-continuity-fence entries (naming a canonical registry token, a stable guarded-window ID, a semantic role, a classified role-continuity class, published preserved role label / boundary label / provenance hint, and the preserved-role-label / boundary-label / provenance-hint disclosure triple). Hard invariants forbid a restored or remapped window or dialog being stranded off-screen after a display-topology change, an auxiliary window being reset into a generic window, bounds-recovery and role-continuity state being merged into one opaque blob, and layout fidelity being overclaimed when only bounds or context recovered. Acceptance criteria — no restored or remapped window opens wholly off-screen or strands a blocking dialog beyond keyboard reach; auxiliary windows preserve their intended role and boundary labels after monitor or DPI changes; and display-topology drills fail when remap loses collaboration / presentation context or hides that fidelity was reduced — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_display_topology_recovery_and_role_continuity_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "window_restore_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "window_restore_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "bounds_recovery_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "remap_target_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority",
        "bounds_recovery_state",
        "bounds_recovery_state_is_classified",
        "canonical_bounds_recovery_mode",
        "surface_context",
        "window_surface_id",
        "affinity_monitor_hint",
        "resolved_visible_bounds",
        "layout_intent",
        "provenance_class",
        "keyboard_reach_plan",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "bounds_recovery_object_complete",
        "bound_to_registry",
        "bounds_resolved_before_present",
        "is_material_topology_adjustment",
        "topology_adjustment_recorded_when_material",
        "degrade_reason",
        "next_action",
        "bounds_resolve_across_remaps"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "remap_target_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority": { "type": "boolean" },
        "bounds_recovery_state": { "$ref": "#/$defs/non_empty_string" },
        "bounds_recovery_state_is_classified": { "type": "boolean" },
        "canonical_bounds_recovery_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "window_surface_id": { "type": "string" },
        "affinity_monitor_hint": { "type": "string" },
        "resolved_visible_bounds": { "type": "string" },
        "layout_intent": { "type": "string" },
        "provenance_class": { "type": "string" },
        "keyboard_reach_plan": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "bounds_recovery_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "bounds_resolved_before_present": { "type": "boolean" },
        "is_material_topology_adjustment": { "type": "boolean" },
        "topology_adjustment_recorded_when_material": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "bounds_resolve_across_remaps": { "type": "boolean" }
      }
    },
    "role_continuity_fence_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "guarded_window_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority",
        "role_class",
        "role_class_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "preserved_role_label",
        "boundary_label",
        "provenance_hint",
        "preserves_role_and_boundary",
        "fence_is_truthful",
        "role_was_present_used",
        "role_preserved_after_remap",
        "fidelity_reduced",
        "fidelity_reduction_disclosed",
        "fence_holds_no_reset",
        "provides_complete_disclosure_triple",
        "degrade_reason",
        "next_action",
        "fence_holds_on_every_surface"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "guarded_window_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority": { "type": "boolean" },
        "role_class": { "$ref": "#/$defs/non_empty_string" },
        "role_class_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "preserved_role_label": { "type": "string" },
        "boundary_label": { "type": "string" },
        "provenance_hint": { "type": "string" },
        "preserves_role_and_boundary": { "type": "boolean" },
        "fence_is_truthful": { "type": "boolean" },
        "role_was_present_used": { "type": "boolean" },
        "role_preserved_after_remap": { "type": "boolean" },
        "fidelity_reduced": { "type": "boolean" },
        "fidelity_reduction_disclosed": { "type": "boolean" },
        "fence_holds_no_reset": { "type": "boolean" },
        "provides_complete_disclosure_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fence_holds_on_every_surface": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "bounds_recovery_entries",
        "role_continuity_fence_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "strands_window_or_dialog_offscreen_after_remap",
        "resets_auxiliary_window_into_generic_window",
        "merges_bounds_recovery_and_role_continuity_into_one_opaque_blob",
        "overclaims_layout_fidelity_when_only_bounds_or_context_recovered"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "bounds_recovery_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bounds_recovery_entry" }
        },
        "role_continuity_fence_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/role_continuity_fence_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "strands_window_or_dialog_offscreen_after_remap": { "const": false },
        "resets_auxiliary_window_into_generic_window": { "const": false },
        "merges_bounds_recovery_and_role_continuity_into_one_opaque_blob": { "const": false },
        "overclaims_layout_fidelity_when_only_bounds_or_context_recovered": { "const": false }
      }
    }
  }
}
