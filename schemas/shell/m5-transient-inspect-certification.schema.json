{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-transient-inspect-certification.schema.json",
  "title": "Aureline M5 tooltip, hovercard & peek-panel representation, promotion, keyboard-reach & stale-labeling certification packet",
  "description": "Transient-inspect certification capstone on top of the frozen M5 shell-primitives matrix. For every claimed M5 inspect context — search results, docs/help, review/change, editor, data grid, profiler, and operator — the packet certifies that a tooltip, hovercard, or peek panel preserves canonical target identity, source/provider class, freshness/mapping quality, and representation label; that pinning or promoting a peek keeps that same identity and state without dropping its representation or provenance truth; that no glanceable information is hover-only or pointer-only but stays reachable through keyboard focus, an explicit context action, or an info affordance on touch/pen and compact layouts; and that stale, cached, or approximate preview content stays visibly labeled before and after pinning and is reconstructable from a support export. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The representation-class, promotion-state, freshness, accessibility-route, required-label, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen shell-primitives matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_representation_classes",
    "required_promotion_states",
    "required_labels",
    "rows",
    "covered_contexts",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_transient_inspect_certification_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_transient_inspect_certification:v1" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_representation_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/representation_class" }
    },
    "required_promotion_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/promotion_state" }
    },
    "required_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/required_label" }
    },
    "rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "covered_contexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/context" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "certification_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "$ref": "#/$defs/ref_list" },
    "release_center_refs": { "$ref": "#/$defs/ref_list" },
    "help_docs_refs": { "$ref": "#/$defs/ref_list" },
    "support_export_refs": { "$ref": "#/$defs/ref_list" },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "context": {
      "type": "string",
      "enum": [
        "search_results",
        "docs_help",
        "review_change",
        "editor",
        "data_grid",
        "profiler",
        "operator"
      ]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "representation_truth",
        "promotion_continuity",
        "non_hover_reach",
        "stale_preview_labeling"
      ]
    },
    "primitive_family": {
      "type": "string",
      "enum": [
        "status_bar_item",
        "status_overflow_menu",
        "tooltip",
        "hovercard",
        "peek_panel",
        "pinned_preview_promotion",
        "splitter_handle",
        "pane_resize_preset",
        "progress_indicator",
        "durable_job_row"
      ]
    },
    "representation_class": {
      "type": "string",
      "enum": [
        "plain_tooltip",
        "rich_hovercard",
        "structured_peek",
        "pinned_peek",
        "provenance_strip",
        "truncated_with_reopen"
      ]
    },
    "promotion_state": {
      "type": "string",
      "enum": [
        "transient",
        "pinned",
        "promoted_to_panel",
        "detached_to_window",
        "demoted_to_transient",
        "dismissed_preserved"
      ]
    },
    "source_freshness_label": {
      "type": "string",
      "enum": [
        "live_canonical",
        "cached_snapshot",
        "stale_invalidated",
        "provider_attributed",
        "sampled_approximate",
        "refresh_in_flight"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "source_provider",
        "freshness",
        "reopen_path"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "representation_truth": {
      "type": "string",
      "enum": [
        "identity_source_freshness_representation_labeled",
        "disclosed_reduced_representation_detail",
        "source_provider_or_freshness_hidden"
      ]
    },
    "promotion_continuity": {
      "type": "string",
      "enum": [
        "pin_open_paths_preserve_identity_and_state",
        "disclosed_reduced_promotion_path",
        "promotion_drops_identity_or_representation"
      ]
    },
    "non_hover_reach": {
      "type": "string",
      "enum": [
        "keyboard_focus_context_reachable",
        "disclosed_reduced_reach_route",
        "information_hover_or_pointer_only"
      ]
    },
    "stale_preview_labeling": {
      "type": "string",
      "enum": [
        "stale_labeled_and_export_reconstructable",
        "disclosed_partial_capture",
        "stale_reads_as_live_or_absent_from_capture"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "vanity_item_reflow",
        "spinner_only_state",
        "hover_only_critical_truth",
        "source_freshness_hidden",
        "stale_preview_mistaken_for_live",
        "promotion_dropped_truth",
        "pointer_only_resize",
        "resize_state_not_serializable",
        "progress_lost_on_look_away",
        "grouped_progress_unattributed",
        "severe_state_displaced_truth",
        "proof_stale"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "context", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "context": { "$ref": "#/$defs/context" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "trigger", "disclosed", "detail"],
      "properties": {
        "context": { "$ref": "#/$defs/context" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "context_missing",
            "representation_truth_hidden",
            "promotion_dropped_truth",
            "information_hover_only",
            "stale_preview_mistaken_for_live",
            "tooltip_sole_critical_instruction",
            "representation_classes_incomplete",
            "promotion_states_incomplete",
            "required_labels_incomplete",
            "stale_labels_missing",
            "narrowed_row_without_reason",
            "narrowed_row_without_waiver",
            "waiver_context_mismatch",
            "waiver_expired",
            "row_status_stale",
            "row_causes_stale",
            "status_counts_stale",
            "coverage_stale",
            "raw_boundary_material_in_export"
          ]
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "driven_primitive_families",
        "matrix_qualification",
        "owner_role",
        "context_label",
        "shell_zone_slot",
        "certified_representation_classes",
        "certified_promotion_states",
        "source_freshness_labels",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "representation_truth",
        "promotion_continuity",
        "non_hover_reach",
        "stale_preview_labeling",
        "tooltip_never_sole_critical_instruction",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "context": { "$ref": "#/$defs/context" },
        "driven_primitive_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/primitive_family" }
        },
        "matrix_qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "context_label": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "certified_representation_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/representation_class" }
        },
        "certified_promotion_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/promotion_state" }
        },
        "source_freshness_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_freshness_label" }
        },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "representation_truth": { "$ref": "#/$defs/representation_truth" },
        "promotion_continuity": { "$ref": "#/$defs/promotion_continuity" },
        "non_hover_reach": { "$ref": "#/$defs/non_hover_reach" },
        "stale_preview_labeling": { "$ref": "#/$defs/stale_preview_labeling" },
        "tooltip_never_sole_critical_instruction": { "type": "boolean" },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    }
  }
}
