{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-window-restore-surface-certification.schema.json",
  "title": "Aureline M5 window-restore surface certification packet",
  "description": "M05-1187 closing capstone certifying that the frozen M5 workspace-restore families (shared workspace authority, window-local topology, skeleton-first restore, no-rerun session hydration, display-topology recovery) hold their window-restore truth on every claimed M5 desktop workspace profile. Keyed on the claimed profile (live trusted restore surface, reviewable restore structure, disclosed layout-skeleton profile, unverified session-replay profile, unverified display-recovery profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and window-restore-component-truth behavior — and either passes (green), auto-narrows its restore claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted restore profile may certify a trusted restore surface; and every B141 hard invariant must hold (no restore reruns commands or reattaches privileged sessions implicitly; no missing extension or remote target deletes layout structure silently; no display-topology remap leaves windows or dialogs unreachable; workspace authority and window topology are never merged into one opaque blob; and no restore-fidelity claim outpaces exact / compatible / layout-only evidence). Every row cites exactly one canonical window-restore proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_window_restore_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-window-restore-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_restore_surface",
        "reviewable_restore_structure",
        "disclosed_layout_skeleton_profile",
        "unverified_session_replay_profile",
        "unverified_display_recovery_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "window_restore_component_truth"
      ]
    },
    "window_restore_claim": {
      "enum": [
        "trusted_restore_surface",
        "reviewable_restore_surface",
        "layout_skeleton_disclosed_projection",
        "session_replay_unverified_projection",
        "display_recovery_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "window_restore_family": {
      "enum": [
        "shared_workspace_authority",
        "window_local_topology",
        "skeleton_first_restore",
        "no_rerun_session_hydration",
        "display_topology_recovery"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "reran_commands_or_reattached_privileged_sessions_implicitly_during_restore",
        "deleted_layout_structure_silently_on_missing_extension_or_remote_target",
        "left_windows_or_dialogs_unreachable_after_display_topology_remap",
        "merged_workspace_authority_and_window_topology_into_one_opaque_blob",
        "overclaimed_restore_fidelity_when_only_context_or_evidence_reopened",
        "window_topology_boundary_drifted_by_surface",
        "workspace_authority_unstated",
        "restore_fidelity_class_unstated",
        "display_affinity_unstated",
        "registry_reference_unstated",
        "session_hydration_rule_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore",
        "deletes_layout_structure_silently_on_missing_extension_or_remote_target",
        "leaves_windows_or_dialogs_unreachable_after_display_topology_remap",
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob",
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened"
      ],
      "properties": {
        "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore": {
          "const": false
        },
        "deletes_layout_structure_silently_on_missing_extension_or_remote_target": {
          "const": false
        },
        "leaves_windows_or_dialogs_unreachable_after_display_topology_remap": { "const": false },
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob": { "const": false },
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/window_restore_claim" },
        "to_claim": { "$ref": "#/$defs/window_restore_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_window_restore_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/window_restore_claim" },
        "certified_claim": { "$ref": "#/$defs/window_restore_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_restore_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-window-restore-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
