{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-responsive-collapse.schema.json",
  "title": "Aureline M5 responsive-collapse (compact/standard/expanded) packet",
  "description": "Responsive-collapse capstone on top of the frozen M5 shell-zone matrix. For every governed surface family — notebook, data grid, profiler, pipeline, docs, preview, review, incident, companion, and operator — the packet certifies that its compact/standard/expanded presentation stays identity-stable across the ordered collapse ladder (docked → sheet → overflow → placeholder), that the docked-to-sheet transition preserves the same object identity and task state, that no essential action becomes hover-only or route-breaking as width narrows, and that 400% zoom and high-contrast layouts keep the same route semantics and task state. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the collapse-ladder and per-class presentation checks are the lint that prevents a later collapse regression from shipping as stable. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "responsive_class_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "rows",
    "covered_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "collapse_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_responsive_collapse_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "responsive_class_schema_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_families": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "collapse_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "responsive_class": {
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "fallback_placement": {
      "enum": ["docked", "sheet", "overflow", "placeholder"]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "collapse_ladder_state": {
      "enum": [
        "identity_stable_ladder",
        "disclosed_ladder_narrowing",
        "ladder_changes_identity"
      ]
    },
    "identity_continuity": {
      "enum": [
        "identity_and_state_preserved",
        "disclosed_state_rehydration",
        "identity_or_state_lost_on_transition"
      ]
    },
    "critical_action_reach": {
      "enum": [
        "all_critical_and_actions_reachable",
        "disclosed_overflow_reach",
        "critical_state_hidden",
        "essential_action_hover_only_or_route_broken"
      ]
    },
    "zoom_contrast_parity": {
      "enum": [
        "routes_stable_at_zoom_and_contrast",
        "disclosed_zoom_narrowing",
        "route_semantics_diverge_at_zoom"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsive_class",
        "placement",
        "identity_preserved",
        "essential_actions_reachable"
      ],
      "properties": {
        "responsive_class": { "$ref": "#/$defs/responsive_class" },
        "placement": { "$ref": "#/$defs/fallback_placement" },
        "identity_preserved": { "type": "boolean" },
        "essential_actions_reachable": { "type": "boolean" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "trigger", "disclosed", "detail"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "matrix_qualification",
        "owner_role",
        "surface_label",
        "canonical_slot",
        "fallback_slot",
        "declared_responsive_classes",
        "collapse_ladder",
        "class_presentations",
        "collapse_ladder_state",
        "identity_continuity",
        "critical_action_reach",
        "zoom_contrast_parity",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "collapse_causes",
        "narrowing_reason"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "matrix_qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "surface_label": { "type": "string", "minLength": 1 },
        "canonical_slot": { "type": "string", "minLength": 1 },
        "fallback_slot": { "type": "string", "minLength": 1 },
        "declared_responsive_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "collapse_ladder": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_placement" }
        },
        "class_presentations": {
          "type": "array",
          "items": { "$ref": "#/$defs/presentation" }
        },
        "collapse_ladder_state": { "$ref": "#/$defs/collapse_ladder_state" },
        "identity_continuity": { "$ref": "#/$defs/identity_continuity" },
        "critical_action_reach": { "$ref": "#/$defs/critical_action_reach" },
        "zoom_contrast_parity": { "$ref": "#/$defs/zoom_contrast_parity" },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "collapse_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
