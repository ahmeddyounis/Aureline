{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-owning-window-routing.schema.json",
  "title": "Aureline M5 owning-window routing packet",
  "description": "Owning-window routing-continuity capstone on top of the frozen M5 shell-zone matrix. For every governed surface family — notebook, data grid, profiler, pipeline, docs, preview, review, incident, companion, and operator — the packet certifies that permission sheets, trust prompts, destructive confirmations, and publish/approval dialogs bind to the window that owns the authoritative object, that durable notification reopen paths land on the exact object or a truthful placeholder rather than a generic home screen, that routed actions never steal focus from a protected typing surface (degrading to a badge or activity-center row instead), and that privacy-safe OS-notification summaries preserve one exact reopen path without bypassing in-app review. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the routing-completeness and per-window plan checks are the lint that prevents a later routing regression from shipping as stable. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "window_topology_contract_ref",
    "session_restore_contract_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_routing_expectations",
    "rows",
    "covered_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "routing_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_owning_window_routing_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "window_topology_contract_ref": { "type": "string", "minLength": 1 },
    "session_restore_contract_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_routing_expectations": { "type": "array", "items": { "$ref": "#/$defs/owning_window_routing_expectation" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_families": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "routing_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "window_class": {
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "owning_window_routing_expectation": {
      "enum": [
        "route_to_owning_window_object",
        "preserve_object_anchor_on_return",
        "no_focus_theft",
        "no_orphan_on_detach"
      ]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "dialog_binding": {
      "enum": [
        "bound_to_owning_window_object",
        "disclosed_binding_relocation",
        "binding_lost_or_orphaned"
      ]
    },
    "reopen_continuity": {
      "enum": [
        "reopens_exact_object_or_truthful_placeholder",
        "disclosed_placeholder_narrowing",
        "lands_on_generic_shell"
      ]
    },
    "focus_retention": {
      "enum": [
        "no_focus_steal_on_typing",
        "disclosed_deferral_to_badge_or_center",
        "focus_stolen_from_typing"
      ]
    },
    "os_notification_privacy": {
      "enum": [
        "privacy_safe_summary_preserves_reopen",
        "disclosed_minimal_summary",
        "leaks_content_or_bypasses_review"
      ]
    },
    "window_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_class",
        "binds_to_owning_object",
        "preserves_typing_focus",
        "keeps_single_reopen_path"
      ],
      "properties": {
        "window_class": { "$ref": "#/$defs/window_class" },
        "binds_to_owning_object": { "type": "boolean" },
        "preserves_typing_focus": { "type": "boolean" },
        "keeps_single_reopen_path": { "type": "boolean" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "trigger", "disclosed", "detail"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "matrix_qualification",
        "owner_role",
        "surface_label",
        "canonical_slot",
        "fallback_slot",
        "declared_window_classes",
        "declared_owning_window_routing",
        "window_plans",
        "dialog_binding",
        "reopen_continuity",
        "focus_retention",
        "os_notification_privacy",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "routing_causes",
        "narrowing_reason"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "matrix_qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "surface_label": { "type": "string", "minLength": 1 },
        "canonical_slot": { "type": "string", "minLength": 1 },
        "fallback_slot": { "type": "string", "minLength": 1 },
        "declared_window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "declared_owning_window_routing": {
          "type": "array",
          "items": { "$ref": "#/$defs/owning_window_routing_expectation" }
        },
        "window_plans": {
          "type": "array",
          "items": { "$ref": "#/$defs/window_plan" }
        },
        "dialog_binding": { "$ref": "#/$defs/dialog_binding" },
        "reopen_continuity": { "$ref": "#/$defs/reopen_continuity" },
        "focus_retention": { "$ref": "#/$defs/focus_retention" },
        "os_notification_privacy": { "$ref": "#/$defs/os_notification_privacy" },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "routing_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
