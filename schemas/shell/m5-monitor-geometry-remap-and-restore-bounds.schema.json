{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-monitor-geometry-remap-and-restore-bounds.schema.json",
  "title": "Aureline M5 monitor-topology geometry-remap and restore-bounds registries",
  "description": "Export-safe packet for the monitor-topology geometry-remap / restore-bounds implement lane over the frozen M5 shell-metric / density matrix. It ties concrete shell geometry to real desktop topology changes so a monitor attach or detach, a DPI change, an undock, a fullscreen transition, or a snapped-layout recovery preserves a usable on-screen layout rather than replaying stale absolute coordinates. Each registry row binds a consumer surface to resolved restore-bounds entries (naming a canonical registry token, a semantic role, a responsive-geometry role, a restore-surface kind, a topology change, a visible-bounds clamp, no off-screen or focus-trapped restore, preserved usable geometry, persisted layout intent instead of stale absolute coordinates, and a recenter / reset affordance whenever fidelity is reduced) and resolved geometry-remap-provenance entries (naming a canonical registry token, a topology change, a fidelity outcome, preserved workspace / focus / critical state, a recorded remap reason, and every mandatory provenance field so support can diagnose why fidelity changed). Hard invariants forbid a restore reopening off-screen or trapping focus, a remap replaying stale absolute coordinates without a clamp, a remap silently dropping the workspace / focus chain / critical state, and reduced fidelity left without a recenter affordance or recorded provenance. Acceptance criteria — no restored window or approval sheet reopens off-screen or traps focus, mixed-DPI and topology-change drills preserve usable editor / panel / inspector geometry while surfacing any unavoidable fallback as recoverable product truth, and restore and support exports record geometry-remap events with enough detail to diagnose why fidelity changed — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_monitor_geometry_remap_and_restore_bounds"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "geometry_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "geometry_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "restore_bounds_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_task_identity_under_collapse",
        "responsive_geometry_role",
        "responsive_role_drops_recovery_state",
        "restore_surface_kind",
        "restore_surface_kind_is_classified",
        "topology_change",
        "topology_change_is_classified",
        "topology_is_dpi_change",
        "surface_context",
        "fidelity_outcome",
        "fidelity_is_reduced",
        "reopens_fully_off_screen",
        "traps_focus_after_remap",
        "clamped_into_visible_bounds",
        "preserves_usable_geometry",
        "uses_absolute_coordinates_instead_of_intent",
        "offers_recenter_reset_affordance",
        "degrade_reason",
        "next_action",
        "restore_preserves_on_screen_continuity"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_task_identity_under_collapse": { "type": "boolean" },
        "responsive_geometry_role": { "$ref": "#/$defs/non_empty_string" },
        "responsive_role_drops_recovery_state": { "type": "boolean" },
        "restore_surface_kind": { "$ref": "#/$defs/non_empty_string" },
        "restore_surface_kind_is_classified": { "type": "boolean" },
        "topology_change": { "$ref": "#/$defs/non_empty_string" },
        "topology_change_is_classified": { "type": "boolean" },
        "topology_is_dpi_change": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "fidelity_outcome": { "$ref": "#/$defs/non_empty_string" },
        "fidelity_is_reduced": { "type": "boolean" },
        "reopens_fully_off_screen": { "type": "boolean" },
        "traps_focus_after_remap": { "type": "boolean" },
        "clamped_into_visible_bounds": { "type": "boolean" },
        "preserves_usable_geometry": { "type": "boolean" },
        "uses_absolute_coordinates_instead_of_intent": { "type": "boolean" },
        "offers_recenter_reset_affordance": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "restore_preserves_on_screen_continuity": { "type": "boolean" }
      }
    },
    "remap_provenance_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_task_identity_under_collapse",
        "responsive_geometry_role",
        "responsive_role_drops_recovery_state",
        "topology_change",
        "topology_change_is_classified",
        "fidelity_outcome",
        "fidelity_outcome_is_classified",
        "fidelity_is_reduced",
        "surface_context",
        "recorded_provenance_fields",
        "records_mandatory_provenance",
        "preserves_workspace_focus_and_critical_state",
        "records_remap_reason",
        "silently_drops_workspace_or_state",
        "degrade_reason",
        "next_action",
        "provenance_is_diagnosable"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_task_identity_under_collapse": { "type": "boolean" },
        "responsive_geometry_role": { "$ref": "#/$defs/non_empty_string" },
        "responsive_role_drops_recovery_state": { "type": "boolean" },
        "topology_change": { "$ref": "#/$defs/non_empty_string" },
        "topology_change_is_classified": { "type": "boolean" },
        "fidelity_outcome": { "$ref": "#/$defs/non_empty_string" },
        "fidelity_outcome_is_classified": { "type": "boolean" },
        "fidelity_is_reduced": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "recorded_provenance_fields": { "type": "array" },
        "records_mandatory_provenance": { "type": "boolean" },
        "preserves_workspace_focus_and_critical_state": { "type": "boolean" },
        "records_remap_reason": { "type": "boolean" },
        "silently_drops_workspace_or_state": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "provenance_is_diagnosable": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "restore_bounds_entries",
        "remap_provenance_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "restore_reopens_off_screen_or_traps_focus",
        "remap_replays_stale_absolute_coordinates_without_clamp",
        "remap_silently_drops_workspace_focus_or_critical_state",
        "reduced_fidelity_without_recenter_or_provenance"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "restore_bounds_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/restore_bounds_entry" }
        },
        "remap_provenance_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/remap_provenance_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "restore_reopens_off_screen_or_traps_focus": { "const": false },
        "remap_replays_stale_absolute_coordinates_without_clamp": { "const": false },
        "remap_silently_drops_workspace_focus_or_critical_state": { "const": false },
        "reduced_fidelity_without_recenter_or_provenance": { "const": false }
      }
    }
  }
}
