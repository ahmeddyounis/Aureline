{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-window-restore-accessibility-parity.schema.json",
  "title": "Aureline M5 window-restore accessibility & auto-narrowing parity",
  "description": "Export-safe packet for the M05-1186 keyboard / screen-reader / high-zoom / high-contrast / localization / CLI / export parity and honest auto-narrowing capstone over the frozen M5 window-restore matrix. Each row certifies one of the five governed workspace-restore families (shared-workspace-authority, window-local-topology, skeleton-first-restore, no-rerun-session-hydration, display-topology-recovery) as keyboard-reachable, screen-reader-announced, high-zoom-legible, high-contrast-safe, localization-safe, CLI/export-safe, and self-narrowing. When a skeleton-first family's layout-skeleton proof can only be partially disclosed, a no-rerun session-replay fence cannot be confirmed, or a family's display-remap recovery evidence has aged out or is policy-blocked, the family's claim auto-narrows from trusted_restore_surface / reviewable_restore_surface to a layout-skeleton-disclosed / session-replay-unverified / display-recovery-unverified projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical window-restore identity / last-known registry reference. Window-restore meaning is never conveyed by a shell-chrome-only affordance, a mislabeled screenshot, or an unlabeled control alone. The packet is metadata-only: raw secret blobs, machine-specific sensitive paths, plaintext payloads, and endpoint refs never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_window_restore_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 5
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "window_restore_family": {
      "type": "string",
      "enum": [
        "shared_workspace_authority",
        "window_local_topology",
        "skeleton_first_restore",
        "no_rerun_session_hydration",
        "display_topology_recovery"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "window_restore_claim": {
      "type": "string",
      "enum": [
        "trusted_restore_surface",
        "reviewable_restore_surface",
        "layout_skeleton_disclosed_projection",
        "session_replay_unverified_projection",
        "display_recovery_unverified_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "shared_authority_clarity",
        "window_local_isolation_clarity",
        "skeleton_fidelity_clarity",
        "session_replay_fence_clarity",
        "display_recovery_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "fully_qualified",
        "layout_skeleton_disclosed_partial",
        "session_replay_unconfirmed",
        "display_recovery_unconfirmed"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "reran_commands_or_reattached_privileged_sessions_implicitly_during_restore",
        "deleted_layout_structure_silently_on_missing_extension_or_remote_target",
        "left_windows_or_dialogs_unreachable_after_display_topology_remap",
        "merged_workspace_authority_and_window_topology_into_one_opaque_blob",
        "overclaimed_restore_fidelity_when_only_context_or_evidence_reopened",
        "window_topology_boundary_drifted_by_surface",
        "workspace_authority_unstated",
        "restore_fidelity_class_unstated",
        "display_affinity_unstated",
        "registry_reference_unstated",
        "session_hydration_rule_unstated",
        "proof_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "semantic_role",
        "registry_reference",
        "workspace_authority",
        "restore_fidelity_class",
        "display_affinity"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "restore_coordinator",
        "shell_ui",
        "workspace_service",
        "session_service",
        "diagnostics",
        "docs_help",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_truth_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/window_restore_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_truth_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "window_restore_family",
        "source_family_schema_ref",
        "window_restore_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "high_zoom_reach",
        "high_contrast_reach",
        "localization_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_ready_claim",
        "claim_conditions",
        "truth_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_window_restore_accessibility_parity_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "window_restore_family": { "$ref": "#/$defs/window_restore_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "window_restore_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_zoom_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_contrast_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "localization_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_ready_claim": { "$ref": "#/$defs/window_restore_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "truth_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "structure_heavy_family_count",
        "all_structure_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_trusted_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_truth_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "structure_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_structure_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_trusted_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_truth_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
