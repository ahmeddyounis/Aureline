{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-metrics.schema.json",
  "title": "Aureline M5 shell-metric / minimum-size shell-geometry entry",
  "description": "Canonical single-entry shape of an M5 shell-metric or minimum-size shell-geometry family (a shell-zone default / minimum / recommended / maximum size, or a minimum hit target such as tab minimum width, resize-handle hit area, or icon-only hit target). Every claimed M5 desktop surface references this schema or the combined m5-shell-metric-density-matrix.schema.json rather than reinventing its own shell-zone widths or hit-target rules. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-entry shape.",
  "type": "object",
  "required": [
    "geometry_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "semantic_roles",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "density_or_collapse_changes_command_focus_or_trust",
    "extension_or_embedded_sets_private_fracturing_width",
    "shrinks_hit_target_below_supported_minimum",
    "hides_primary_workflow_behind_overlay_only_fallback",
    "lets_zone_starve_main_workspace_below_minimum"
  ],
  "properties": {
    "geometry_family": {
      "$ref": "#/$defs/geometry_family"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "zone",
          "metric",
          "hit_target",
          "density",
          "responsive",
          "collapse",
          "workspace_dominance"
        ]
      }
    },
    "shell_metric_roles": {
      "type": "array"
    },
    "minimum_size_roles": {
      "type": "array"
    },
    "density_mode_roles": {
      "type": "array"
    },
    "responsive_geometry_roles": {
      "type": "array"
    },
    "collapse_priority_roles": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "density_or_collapse_changes_command_focus_or_trust": {
      "const": false
    },
    "extension_or_embedded_sets_private_fracturing_width": {
      "const": false
    },
    "shrinks_hit_target_below_supported_minimum": {
      "const": false
    },
    "hides_primary_workflow_behind_overlay_only_fallback": {
      "const": false
    },
    "lets_zone_starve_main_workspace_below_minimum": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "geometry_family": {
      "enum": [
        "shell_metric",
        "minimum_size"
      ]
    }
  }
}
