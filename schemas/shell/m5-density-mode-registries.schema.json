{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-density-mode-registries.schema.json",
  "title": "Aureline M5 density-mode registries",
  "description": "Export-safe packet for the density-mode implement lane over the frozen M5 shell-metric / density matrix. It carries resolved, honest projections of the density-mode shell-geometry family across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved density-scale entries (naming a canonical registry token, a semantic role, a density-mode role, a comfortable / standard / compact density mode, the exact canonical row / control / spacing / padding / gutter tokens for that mode, list / tree / table / tab / panel / editor / inspector surface-element coverage, hit targets at or above their supported minimum, a presentation-only change, and preserved command / focus / trust) and resolved density-persistence entries (naming a canonical registry token, a persistence scope, and an override reason so a chosen density persists at profile scope by default and only an explicitly explained local override may narrow it). Hard invariants forbid a density change rearranging information architecture, a density change altering command / focus / trust, a hit target shrinking below the supported minimum, and density switching silently outside its profile scope. Acceptance criteria — comfortable / standard / compact modes produce predictable tokenized changes across every surface element, density preferences remain operable at high zoom without shrinking hit targets below their minimum, and extension surfaces that cannot honor the canonical density tokens degrade honestly instead of inventing private scales — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_density_mode_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "geometry_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "geometry_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "density_scale_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_task_identity_under_collapse",
        "density_mode_role",
        "density_mode_role_changes_information_architecture",
        "density_mode",
        "density_mode_is_classified",
        "surface_context",
        "row_height_px",
        "control_height_px",
        "tab_chip_spacing_px",
        "panel_padding_px",
        "gutter_spacing_px",
        "canonical_row_height_px",
        "canonical_control_height_px",
        "matches_canonical_scale",
        "surface_elements",
        "covers_all_surface_elements",
        "changes_information_architecture",
        "preserves_command_focus_and_trust",
        "meets_hit_target_minimum",
        "degrade_reason",
        "next_action",
        "density_change_is_presentation_only"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_task_identity_under_collapse": { "type": "boolean" },
        "density_mode_role": { "$ref": "#/$defs/non_empty_string" },
        "density_mode_role_changes_information_architecture": { "type": "boolean" },
        "density_mode": { "$ref": "#/$defs/non_empty_string" },
        "density_mode_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "row_height_px": { "type": "integer", "minimum": 0 },
        "control_height_px": { "type": "integer", "minimum": 0 },
        "tab_chip_spacing_px": { "type": "integer", "minimum": 0 },
        "panel_padding_px": { "type": "integer", "minimum": 0 },
        "gutter_spacing_px": { "type": "integer", "minimum": 0 },
        "canonical_row_height_px": { "type": "integer", "minimum": 0 },
        "canonical_control_height_px": { "type": "integer", "minimum": 0 },
        "matches_canonical_scale": { "type": "boolean" },
        "surface_elements": { "type": "array" },
        "covers_all_surface_elements": { "type": "boolean" },
        "changes_information_architecture": { "type": "boolean" },
        "preserves_command_focus_and_trust": { "type": "boolean" },
        "meets_hit_target_minimum": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "density_change_is_presentation_only": { "type": "boolean" }
      }
    },
    "density_persistence_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "density_mode_role",
        "semantic_role",
        "persistence_scope",
        "scope_is_classified",
        "scope_is_profile_scoped",
        "override_reason",
        "override_is_explained",
        "surface_context",
        "switched_silently_by_provider_theme_or_workflow",
        "degrade_reason",
        "next_action",
        "persistence_holds_at_profile_scope"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "density_mode_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "persistence_scope": { "$ref": "#/$defs/non_empty_string" },
        "scope_is_classified": { "type": "boolean" },
        "scope_is_profile_scoped": { "type": "boolean" },
        "override_reason": { "$ref": "#/$defs/non_empty_string" },
        "override_is_explained": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "switched_silently_by_provider_theme_or_workflow": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "persistence_holds_at_profile_scope": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "density_scale_entries",
        "density_persistence_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "density_change_alters_information_architecture",
        "density_change_alters_command_focus_or_trust",
        "shrinks_hit_target_below_supported_minimum",
        "silently_switches_density_outside_profile_scope"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "density_scale_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/density_scale_entry" }
        },
        "density_persistence_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/density_persistence_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "density_change_alters_information_architecture": { "const": false },
        "density_change_alters_command_focus_or_trust": { "const": false },
        "shrinks_hit_target_below_supported_minimum": { "const": false },
        "silently_switches_density_outside_profile_scope": { "const": false }
      }
    }
  }
}
