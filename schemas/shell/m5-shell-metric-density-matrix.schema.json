{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-metric-density-matrix.schema.json",
  "title": "Aureline M5 shell-metric, minimum-size, density-mode, responsive-geometry, and collapse-priority shell-geometry matrix",
  "description": "Export-safe packet freezing Aureline's concrete shell geometry and density behavior. The packet names every claimed M5 desktop surface that still describes its own shell-zone widths, minimum editor / chrome sizes, density modes, responsive window classes, collapse priorities, or hit-target rules — across the desktop shell, editor, review, notebook, and data surfaces — and binds each governed family to the claimed surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, snapped-width, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each family declares the controlled vocabularies it carries: the single controlled shell-geometry-role vocabulary consumers bind to (zone, metric, hit_target, density, responsive, collapse, workspace_dominance), plus family-specific shell-metric roles, minimum-size roles, density-mode roles, responsive-geometry roles, and collapse-priority roles. Hard invariants forbid density or collapse changing command meaning, focus order, or trust visibility, an extension or embedded surface setting a private width that fractures the layout, shrinking a hit target below the supported minimum, hiding a primary workflow behind an overlay-only fallback, and letting a zone starve the main workspace below its minimum. The matrix binds back to the already-landed shell-zone and reusable-shell-primitive packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "geometry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_shell_metric_minimum_size_density_mode_responsive_geometry_and_collapse_priority_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "geometry_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/geometry_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "geometry_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "geometry_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "geometry_family": {
      "enum": [
        "shell_metric",
        "minimum_size",
        "density_mode",
        "responsive_geometry",
        "collapse_priority"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "zone",
        "metric",
        "hit_target",
        "density",
        "responsive",
        "collapse",
        "workspace_dominance"
      ]
    },
    "geometry_row": {
      "type": "object",
      "required": [
        "geometry_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "density_or_collapse_changes_command_focus_or_trust",
        "extension_or_embedded_sets_private_fracturing_width",
        "shrinks_hit_target_below_supported_minimum",
        "hides_primary_workflow_behind_overlay_only_fallback",
        "lets_zone_starve_main_workspace_below_minimum"
      ],
      "properties": {
        "geometry_family": {
          "$ref": "#/$defs/geometry_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "shell_metric_roles": {
          "type": "array"
        },
        "minimum_size_roles": {
          "type": "array"
        },
        "density_mode_roles": {
          "type": "array"
        },
        "responsive_geometry_roles": {
          "type": "array"
        },
        "collapse_priority_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "density_or_collapse_changes_command_focus_or_trust": {
          "const": false
        },
        "extension_or_embedded_sets_private_fracturing_width": {
          "const": false
        },
        "shrinks_hit_target_below_supported_minimum": {
          "const": false
        },
        "hides_primary_workflow_behind_overlay_only_fallback": {
          "const": false
        },
        "lets_zone_starve_main_workspace_below_minimum": {
          "const": false
        }
      }
    }
  }
}
