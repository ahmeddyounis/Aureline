{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-primitives.schema.json",
  "title": "Aureline M5 status-bar, transient-inspect, pane-control, and durable-progress-component matrix",
  "description": "Export-safe packet freezing the canonical M5 shell primitives. The packet names every high-frequency shell primitive M5 claims — status-bar items, status overflow menus, tooltips, hovercards, peek panels, pinned-preview promotions, splitter handles, pane-resize presets, progress indicators, and durable job-row components — and binds each to a canonical shell zone, the responsive classes it must survive, the window classes it keeps continuity across, and the claimed M5 surface families that render it. Each primitive declares the controlled vocabularies it carries: status-item classes, overflow/severe-state displacement behaviors, source/provider/freshness labels, hover/peek representation classes, pinned-preview promotion states, splitter/pane-resize states, progress/job-row states, non-visual accessibility routes, and mandatory labels. Hard invariants forbid status bars reflowing around vanity items, hovercards/peek panels hiding source/freshness after pinning, critical truth staying hover-only or spinner-only, and panes resizable by pointer only. The shell zone, responsive class, window class, and surface family vocabularies are reused verbatim from the frozen M5 shell-zone matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "primitive_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_status_bar_transient_inspect_pane_control_and_durable_progress_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "primitive_rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/primitive_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "primitive_family": {
      "enum": [
        "status_bar_item",
        "status_overflow_menu",
        "tooltip",
        "hovercard",
        "peek_panel",
        "pinned_preview_promotion",
        "splitter_handle",
        "pane_resize_preset",
        "progress_indicator",
        "durable_job_row"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook",
        "data_grid",
        "profiler",
        "pipeline",
        "docs",
        "preview",
        "review",
        "incident",
        "companion",
        "operator"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "source_provider",
        "freshness",
        "reopen_path"
      ]
    },
    "status_item_class": {
      "enum": [
        "background_work",
        "connection_target",
        "deployment_profile",
        "sync_freshness",
        "problem_count",
        "mode_indicator",
        "notification_summary",
        "capacity_meter"
      ]
    },
    "overflow_behavior": {
      "enum": [
        "priority_pinned",
        "collapse_to_overflow_menu",
        "group_into_summary",
        "drop_vanity_item",
        "promote_severe_state",
        "keyboard_reachable_overflow"
      ]
    },
    "source_freshness_label": {
      "enum": [
        "live_canonical",
        "cached_snapshot",
        "stale_invalidated",
        "provider_attributed",
        "sampled_approximate",
        "refresh_in_flight"
      ]
    },
    "representation_class": {
      "enum": [
        "plain_tooltip",
        "rich_hovercard",
        "structured_peek",
        "pinned_peek",
        "provenance_strip",
        "truncated_with_reopen"
      ]
    },
    "promotion_state": {
      "enum": [
        "transient",
        "pinned",
        "promoted_to_panel",
        "detached_to_window",
        "demoted_to_transient",
        "dismissed_preserved"
      ]
    },
    "pane_resize_state": {
      "enum": [
        "idle",
        "dragging",
        "keyboard_step",
        "snapped_to_preset",
        "reset_to_default",
        "clamped_to_min_width",
        "collapsed_to_rail"
      ]
    },
    "progress_state": {
      "enum": [
        "queued",
        "running",
        "grouped_batch",
        "paused",
        "succeeded",
        "failed",
        "canceled_by_user",
        "reopenable_history"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "vanity_item_reflow",
        "spinner_only_state",
        "hover_only_critical_truth",
        "source_freshness_hidden",
        "stale_preview_mistaken_for_live",
        "promotion_dropped_truth",
        "pointer_only_resize",
        "resize_state_not_serializable",
        "progress_lost_on_look_away",
        "grouped_progress_unattributed",
        "severe_state_displaced_truth",
        "proof_stale"
      ]
    },
    "primitive_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "surface_families",
        "required_labels",
        "status_item_classes",
        "overflow_behaviors",
        "source_freshness_labels",
        "representation_classes",
        "promotion_states",
        "pane_resize_states",
        "progress_states",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "reflows_around_vanity_items",
        "hides_source_or_freshness",
        "keeps_critical_truth_hover_only",
        "resizable_by_pointer_only"
      ],
      "properties": {
        "primitive_family": { "$ref": "#/$defs/primitive_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "status_item_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/status_item_class" }
        },
        "overflow_behaviors": {
          "type": "array",
          "items": { "$ref": "#/$defs/overflow_behavior" }
        },
        "source_freshness_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_freshness_label" }
        },
        "representation_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/representation_class" }
        },
        "promotion_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/promotion_state" }
        },
        "pane_resize_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/pane_resize_state" }
        },
        "progress_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/progress_state" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "reflows_around_vanity_items": { "const": false },
        "hides_source_or_freshness": { "const": false },
        "keeps_critical_truth_hover_only": { "const": false },
        "resizable_by_pointer_only": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_families",
        "status_item_classes",
        "overflow_behaviors",
        "source_freshness_labels",
        "representation_classes",
        "promotion_states",
        "pane_resize_states",
        "progress_states",
        "accessibility_routes",
        "required_labels"
      ],
      "properties": {
        "primitive_families": { "type": "array", "items": { "$ref": "#/$defs/primitive_family" } },
        "status_item_classes": { "type": "array", "items": { "$ref": "#/$defs/status_item_class" } },
        "overflow_behaviors": { "type": "array", "items": { "$ref": "#/$defs/overflow_behavior" } },
        "source_freshness_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_freshness_label" }
        },
        "representation_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/representation_class" }
        },
        "promotion_states": { "type": "array", "items": { "$ref": "#/$defs/promotion_state" } },
        "pane_resize_states": { "type": "array", "items": { "$ref": "#/$defs/pane_resize_state" } },
        "progress_states": { "type": "array", "items": { "$ref": "#/$defs/progress_state" } },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": { "type": "array", "items": { "$ref": "#/$defs/required_label" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambient_instrumentation_overflow_safe",
        "no_status_reflow_around_vanity_items",
        "transient_inspect_preserves_source_and_freshness",
        "pinned_preview_keeps_representation_truth",
        "pane_resize_keyboard_addressable_and_serializable",
        "progress_rows_durable_and_reopenable",
        "no_critical_truth_hover_or_spinner_only",
        "severe_state_displaces_vanity_not_truth",
        "every_primitive_bound_to_shell_zone",
        "every_primitive_declares_accessibility_route",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "ambient_instrumentation_overflow_safe": { "const": true },
        "no_status_reflow_around_vanity_items": { "const": true },
        "transient_inspect_preserves_source_and_freshness": { "const": true },
        "pinned_preview_keeps_representation_truth": { "const": true },
        "pane_resize_keyboard_addressable_and_serializable": { "const": true },
        "progress_rows_durable_and_reopenable": { "const": true },
        "no_critical_truth_hover_or_spinner_only": { "const": true },
        "severe_state_displaces_vanity_not_truth": { "const": true },
        "every_primitive_bound_to_shell_zone": { "const": true },
        "every_primitive_declares_accessibility_route": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_bar_consumes_matrix",
        "hovercard_peek_consumes_representation_vocabulary",
        "splitter_consumes_resize_state_vocabulary",
        "activity_center_consumes_progress_vocabulary",
        "support_export_reads_single_source",
        "accessibility_bridge_reads_single_source"
      ],
      "properties": {
        "status_bar_consumes_matrix": { "const": true },
        "hovercard_peek_consumes_representation_vocabulary": { "const": true },
        "splitter_consumes_resize_state_vocabulary": { "const": true },
        "activity_center_consumes_progress_vocabulary": { "const": true },
        "support_export_reads_single_source": { "const": true },
        "accessibility_bridge_reads_single_source": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "shell_primitives_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "shell_primitives_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
