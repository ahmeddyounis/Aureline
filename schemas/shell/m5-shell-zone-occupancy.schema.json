{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-zone-occupancy.schema.json",
  "title": "Aureline M5 shell-zone occupancy & declared-slot routing packet",
  "description": "Occupancy capstone on top of the frozen M5 shell-zone matrix. For every governed surface family — notebook, data grid, profiler, pipeline, docs, preview, review, incident, companion, and operator — the packet certifies that the live surface occupies a declared (registered) shell slot, that command/keyboard/docs/onboarding routes resolve to the same slot and occupant, and that a dependency-missing or policy-blocked occupant degrades into an explicit in-slot placeholder card preserving spatial continuity rather than collapsing layout or inventing a private chrome island. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the registered-slot check is the lint that prevents an unregistered shell attachment from shipping as stable. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "rows",
    "covered_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "occupancy_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_shell_zone_occupancy_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_shell_zone_occupancy:v1" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/occupancy_row" }
    },
    "covered_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "occupancy_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "$ref": "#/$defs/ref_list" },
    "release_center_refs": { "$ref": "#/$defs/ref_list" },
    "help_docs_refs": { "$ref": "#/$defs/ref_list" },
    "support_export_refs": { "$ref": "#/$defs/ref_list" },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "family": {
      "type": "string",
      "enum": [
        "notebook",
        "data_grid",
        "profiler",
        "pipeline",
        "docs",
        "preview",
        "review",
        "incident",
        "companion",
        "operator"
      ]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "slot_attachment": {
      "type": "string",
      "enum": ["attached_to_declared_slot", "undeclared_slot_attachment"]
    },
    "occupant_availability": {
      "type": "string",
      "enum": [
        "occupant_available",
        "dependency_missing_placeholder",
        "policy_blocked_placeholder",
        "placeholder_collapsed_layout"
      ]
    },
    "route_resolution": {
      "type": "string",
      "enum": [
        "all_routes_resolve_to_slot_occupant",
        "disclosed_route_fallback",
        "conflicting_route_resolution"
      ]
    },
    "route_channel": {
      "type": "string",
      "enum": ["command", "keyboard", "docs", "onboarding"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "slot_undeclared",
        "collapse_changed_task_identity",
        "critical_state_hidden_on_collapse",
        "owning_window_routing_lost",
        "workspace_truth_diverged_across_windows",
        "placeholder_lost_identity_or_reopen",
        "secondary_display_topology_drift",
        "policy_blocked",
        "proof_stale",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "placeholder_behavior": {
      "type": "string",
      "enum": [
        "in_slot_identity_preserved",
        "reconnect_remote_or_provider",
        "install_or_enable_dependency",
        "recentered_on_topology_drift"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "trigger", "disclosed", "detail"],
      "properties": {
        "family": { "$ref": "#/$defs/family" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "family_missing",
            "undeclared_slot_attachment",
            "occupied_slot_not_registered",
            "canonical_slot_not_registered",
            "placeholder_collapsed_layout",
            "conflicting_route_resolution",
            "route_channels_incomplete",
            "narrowed_row_without_reason",
            "narrowed_row_without_waiver",
            "waiver_family_mismatch",
            "waiver_expired",
            "row_status_stale",
            "row_causes_stale",
            "status_counts_stale",
            "coverage_stale",
            "raw_boundary_material_in_export"
          ]
        }
      }
    },
    "occupancy_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "matrix_qualification",
        "owner_role",
        "occupant_surface",
        "canonical_slot",
        "fallback_slot",
        "registered_slots",
        "occupied_slot",
        "placeholder_behavior",
        "slot_attachment",
        "occupant_availability",
        "route_resolution",
        "resolved_route_channels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "occupancy_causes",
        "narrowing_reason"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/family" },
        "matrix_qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "occupant_surface": { "$ref": "#/$defs/non_empty_string" },
        "canonical_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "fallback_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "registered_slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shell_zone_slot" }
        },
        "occupied_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "placeholder_behavior": { "$ref": "#/$defs/placeholder_behavior" },
        "slot_attachment": { "$ref": "#/$defs/slot_attachment" },
        "occupant_availability": { "$ref": "#/$defs/occupant_availability" },
        "route_resolution": { "$ref": "#/$defs/route_resolution" },
        "resolved_route_channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/route_channel" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "occupancy_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    }
  }
}
