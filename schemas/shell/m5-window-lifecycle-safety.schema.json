{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-window-lifecycle-safety.schema.json",
  "title": "Aureline M5 window-lifecycle-safety packet",
  "description": "Window-lifecycle-safety capstone on top of the frozen M5 shell-zone matrix. For every governed surface family — notebook, data grid, profiler, pipeline, docs, preview, review, incident, companion, and operator — the packet certifies that a cross-window drag/drop advertises the resulting verb (Move tab, Copy editor, Open compare here, Create window) before the drop completes and keeps it keyboard-reachable through a command equivalent, that closing a secondary window never silently orphans a dirty buffer, live approval, collaboration control, or long-running evidence review, and that a specialized window reopens into the safest equivalent shell arrangement when an extension, remote target, or feature pack is unavailable. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the protected-resource and drag-plan completeness checks are the lint that prevents a later lifecycle regression from shipping as stable. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "window_topology_contract_ref",
    "session_restore_contract_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_drag_verbs",
    "required_protected_resources",
    "rows",
    "covered_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "lifecycle_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_window_lifecycle_safety_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "window_topology_contract_ref": { "type": "string", "minLength": 1 },
    "session_restore_contract_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_drag_verbs": { "type": "array", "items": { "$ref": "#/$defs/drag_verb" } },
    "required_protected_resources": { "type": "array", "items": { "$ref": "#/$defs/protected_resource" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_families": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "lifecycle_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "window_class": {
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "drag_verb": {
      "enum": ["move_tab", "copy_editor", "open_compare_here", "create_window"]
    },
    "protected_resource": {
      "enum": ["dirty_buffer", "live_approval", "collaboration_control", "evidence_review"]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "drag_verb_disclosure": {
      "enum": [
        "verb_disclosed_with_keyboard_parity",
        "disclosed_verb_reach_narrowing",
        "verb_hidden_or_keyboard_lost"
      ]
    },
    "close_orphan_guard": {
      "enum": [
        "close_guarded_no_orphan",
        "disclosed_deferred_guard_relocation",
        "silent_orphan_on_close"
      ]
    },
    "safe_reopen_fallback": {
      "enum": [
        "reopens_safest_equivalent_layout",
        "disclosed_reduced_equivalent_fallback",
        "reopen_orphaned_or_wrong_surface"
      ]
    },
    "drag_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "disclosed_before_drop", "keyboard_command_equivalent"],
      "properties": {
        "verb": { "$ref": "#/$defs/drag_verb" },
        "disclosed_before_drop": { "type": "boolean" },
        "keyboard_command_equivalent": { "type": "boolean" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "trigger", "disclosed", "detail"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "matrix_qualification",
        "owner_role",
        "surface_label",
        "canonical_slot",
        "fallback_slot",
        "declared_window_classes",
        "declared_protected_resources",
        "drag_plans",
        "drag_verb_disclosure",
        "close_orphan_guard",
        "safe_reopen_fallback",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "lifecycle_causes",
        "narrowing_reason"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "matrix_qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "surface_label": { "type": "string", "minLength": 1 },
        "canonical_slot": { "type": "string", "minLength": 1 },
        "fallback_slot": { "type": "string", "minLength": 1 },
        "declared_window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "declared_protected_resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/protected_resource" }
        },
        "drag_plans": {
          "type": "array",
          "items": { "$ref": "#/$defs/drag_plan" }
        },
        "drag_verb_disclosure": { "$ref": "#/$defs/drag_verb_disclosure" },
        "close_orphan_guard": { "$ref": "#/$defs/close_orphan_guard" },
        "safe_reopen_fallback": { "$ref": "#/$defs/safe_reopen_fallback" },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "lifecycle_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
