{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-metric-density-shared-consumers.schema.json",
  "title": "M5 Shell-Geometry Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the five B138 shell-geometry families (shell metric, minimum size, density mode, responsive geometry, collapse priority) to the shell / editor / review / notebook / data / settings / CLI-export / support-export / product consumers that render them, proving one shared shell-geometry grammar across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_shell_metric_density_shared_consumer_geometry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "geometry_family": {
      "type": "string",
      "enum": [
        "shell_metric",
        "minimum_size",
        "density_mode",
        "responsive_geometry",
        "collapse_priority"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "editor_ui",
        "review_ui",
        "notebook_ui",
        "data_ui",
        "settings_ui",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "geometry_grammar_drift_detected",
        "task_identity_or_recovery_state_dropped",
        "density_or_collapse_changed_command_focus_or_trust",
        "extension_set_private_fracturing_width",
        "hit_target_shrank_below_supported_minimum",
        "primary_workflow_hidden_behind_overlay_only_fallback",
        "zone_starved_main_workspace_below_minimum",
        "canonical_registry_reference_missing",
        "upstream_geometry_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_role_word",
        "family_word",
        "registry_reference_word",
        "width_or_density_class_word",
        "surface_context_word",
        "minimum_guarantee_word"
      ],
      "properties": {
        "geometry_role_word": {
          "type": "string",
          "enum": [
            "zone",
            "metric",
            "hit_target",
            "density",
            "responsive",
            "collapse",
            "workspace_dominance"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "width_or_density_class_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "minimum_guarantee_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "geometry_object_id",
        "geometry_object_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "density_or_collapse_changes_command_focus_or_trust",
        "extension_or_embedded_sets_private_fracturing_width",
        "shrinks_hit_target_below_supported_minimum",
        "hides_primary_workflow_behind_overlay_only_fallback",
        "lets_zone_starve_main_workspace_below_minimum",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "geometry_object_id": { "type": "string", "minLength": 1 },
        "geometry_object_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/geometry_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "density_or_collapse_changes_command_focus_or_trust": {
          "type": "boolean",
          "const": false
        },
        "extension_or_embedded_sets_private_fracturing_width": {
          "type": "boolean",
          "const": false
        },
        "shrinks_hit_target_below_supported_minimum": {
          "type": "boolean",
          "const": false
        },
        "hides_primary_workflow_behind_overlay_only_fallback": {
          "type": "boolean",
          "const": false
        },
        "lets_zone_starve_main_workspace_below_minimum": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_object_same_geometry_across_surfaces",
        "geometry_role_words_stay_in_frozen_vocabulary",
        "adaptive_roles_never_drop_task_identity_or_recovery_state",
        "density_or_collapse_never_changes_command_focus_or_trust",
        "extension_or_embedded_never_sets_private_fracturing_width",
        "hit_targets_never_shrink_below_supported_minimum",
        "primary_workflows_never_hidden_behind_overlay_only_fallback",
        "zones_never_starve_main_workspace_below_minimum",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_object_same_geometry_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "geometry_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "adaptive_roles_never_drop_task_identity_or_recovery_state": {
          "type": "boolean",
          "const": true
        },
        "density_or_collapse_never_changes_command_focus_or_trust": {
          "type": "boolean",
          "const": true
        },
        "extension_or_embedded_never_sets_private_fracturing_width": {
          "type": "boolean",
          "const": true
        },
        "hit_targets_never_shrink_below_supported_minimum": {
          "type": "boolean",
          "const": true
        },
        "primary_workflows_never_hidden_behind_overlay_only_fallback": {
          "type": "boolean",
          "const": true
        },
        "zones_never_starve_main_workspace_below_minimum": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_ui_consumes_shared_geometry",
        "editor_ui_consumes_shared_geometry",
        "review_ui_consumes_shared_geometry",
        "notebook_ui_consumes_shared_geometry",
        "data_ui_consumes_shared_geometry",
        "settings_ui_consumes_shared_geometry",
        "support_export_consumes_shared_geometry",
        "every_family_adopted_by_two_or_more_consumers",
        "geometry_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_geometry_family"
      ],
      "properties": {
        "shell_ui_consumes_shared_geometry": {
          "type": "boolean",
          "const": true
        },
        "editor_ui_consumes_shared_geometry": {
          "type": "boolean",
          "const": true
        },
        "review_ui_consumes_shared_geometry": {
          "type": "boolean",
          "const": true
        },
        "notebook_ui_consumes_shared_geometry": {
          "type": "boolean",
          "const": true
        },
        "data_ui_consumes_shared_geometry": {
          "type": "boolean",
          "const": true
        },
        "settings_ui_consumes_shared_geometry": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_geometry": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "geometry_identical_for_same_object": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_geometry_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
