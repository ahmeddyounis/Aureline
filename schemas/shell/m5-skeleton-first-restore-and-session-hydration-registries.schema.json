{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-skeleton-first-restore-and-session-hydration-registries.schema.json",
  "title": "Aureline M5 skeleton-first-restore and session-hydration registries",
  "description": "Export-safe packet for the skeleton-first / hydrate-second implement lane over the frozen M5 window-restore matrix. It carries resolved, honest projections of the skeleton-first-restore and no-rerun-session-hydration families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved skeleton-restore entries (naming a canonical registry token, a stable restore-target ID, a semantic role, a classified restore-fidelity class, published window shell / stable pane-tree structure / preserved pane roles / placeholder set / layout-skeleton root / distinct deferred-hydration plan, and canonical/accessible/audit resolution-form coverage while rebuilding the skeleton before heavy hydration and preserving pane roles when it defers hydration) and resolved session-hydration entries (naming a canonical registry token, a stable pane ID, a semantic role, a classified session-hydration surface, published preserved pane role / missing-dependency class / restore-fidelity hint, and the preserved-pane-role / missing-dependency-class / restore-fidelity-hint disclosure triple). Hard invariants forbid session-scoped work rerunning or reattaching privileged sessions during restore, layout structure being deleted silently on a missing dependency, skeleton and hydration state being merged into one opaque blob, and restore fidelity being overclaimed when only context or evidence reopened. Acceptance criteria — restored layouts appear as truthful skeletons before heavy services hydrate; missing dependencies produce pane-role-preserving placeholders instead of silent layout collapse; and support/export can explain which panes restored as live, placeholder, context-only, or evidence-only — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_skeleton_first_restore_and_session_hydration_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "window_restore_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "window_restore_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "skeleton_restore_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "restore_target_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority",
        "restore_fidelity_class",
        "restore_fidelity_class_is_classified",
        "canonical_restore_fidelity_mode",
        "surface_context",
        "window_shell_id",
        "pane_tree_structure",
        "pane_role_set",
        "placeholder_set",
        "layout_skeleton_root",
        "hydration_plan_ref",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "restore_skeleton_object_complete",
        "bound_to_registry",
        "skeleton_rebuilt_before_hydration",
        "defers_heavy_hydration",
        "pane_roles_preserved_when_deferred",
        "degrade_reason",
        "next_action",
        "skeleton_resolves_across_restores"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "restore_target_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority": { "type": "boolean" },
        "restore_fidelity_class": { "$ref": "#/$defs/non_empty_string" },
        "restore_fidelity_class_is_classified": { "type": "boolean" },
        "canonical_restore_fidelity_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "window_shell_id": { "type": "string" },
        "pane_tree_structure": { "type": "string" },
        "pane_role_set": { "type": "string" },
        "placeholder_set": { "type": "string" },
        "layout_skeleton_root": { "type": "string" },
        "hydration_plan_ref": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "restore_skeleton_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "skeleton_rebuilt_before_hydration": { "type": "boolean" },
        "defers_heavy_hydration": { "type": "boolean" },
        "pane_roles_preserved_when_deferred": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "skeleton_resolves_across_restores": { "type": "boolean" }
      }
    },
    "session_hydration_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "pane_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority",
        "hydration_surface",
        "hydration_surface_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "preserved_pane_role",
        "missing_dependency_class",
        "restore_fidelity_hint",
        "preserves_pane_role_and_topology",
        "hydration_is_truthful",
        "dependency_missing_used",
        "placeholder_substituted_on_missing",
        "heavy_dependency_deferred",
        "deferred_fidelity_disclosed",
        "hydration_stays_no_rerun",
        "provides_complete_disclosure_triple",
        "degrade_reason",
        "next_action",
        "hydration_no_rerun_on_every_pane"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "pane_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority": { "type": "boolean" },
        "hydration_surface": { "$ref": "#/$defs/non_empty_string" },
        "hydration_surface_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "preserved_pane_role": { "type": "string" },
        "missing_dependency_class": { "type": "string" },
        "restore_fidelity_hint": { "type": "string" },
        "preserves_pane_role_and_topology": { "type": "boolean" },
        "hydration_is_truthful": { "type": "boolean" },
        "dependency_missing_used": { "type": "boolean" },
        "placeholder_substituted_on_missing": { "type": "boolean" },
        "heavy_dependency_deferred": { "type": "boolean" },
        "deferred_fidelity_disclosed": { "type": "boolean" },
        "hydration_stays_no_rerun": { "type": "boolean" },
        "provides_complete_disclosure_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "hydration_no_rerun_on_every_pane": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "skeleton_restore_entries",
        "session_hydration_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "reruns_session_scoped_work_or_reattaches_privileged_sessions_during_restore",
        "deletes_layout_structure_silently_on_missing_dependency",
        "merges_skeleton_and_hydration_into_one_opaque_blob",
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "skeleton_restore_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/skeleton_restore_entry" }
        },
        "session_hydration_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/session_hydration_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "reruns_session_scoped_work_or_reattaches_privileged_sessions_during_restore": { "const": false },
        "deletes_layout_structure_silently_on_missing_dependency": { "const": false },
        "merges_skeleton_and_hydration_into_one_opaque_blob": { "const": false },
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened": { "const": false }
      }
    }
  }
}
