{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-desktop-profile-certification.schema.json",
  "title": "Aureline M5 desktop-profile certification packet",
  "description": "Desktop-profile capstone on top of the frozen M5 shell-zone matrix. For every claimed M5 desktop profile — compact, standard, and expanded widths, mixed-DPI, multi-monitor, and dependency-missing restore — the packet certifies that across every claimed surface family shell-zone integrity holds (no surface invents a private slot), adaptive layout preserves task identity (responsive collapse never changes identity, hides critical state, or forces an unusable narrow pane), multi-window truth stays global while layout stays local (every window preserves workspace trust, remote, profile, and recovery truth), and owning-window routing returns contextful actions to the owning window and object (no wrong-window reopen, focus theft, or orphaning). Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the evaluated-family completeness check is the lint that prevents a profile audit from regressing into a partial view. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "shell_zoning_contract_ref",
    "reference_layout_contract_ref",
    "window_topology_contract_ref",
    "attention_routing_contract_ref",
    "session_restore_contract_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_truth_dimensions",
    "required_profiles",
    "required_families",
    "rows",
    "covered_profiles",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "profile_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_desktop_profile_certification_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "shell_zoning_contract_ref": { "type": "string", "minLength": 1 },
    "reference_layout_contract_ref": { "type": "string", "minLength": 1 },
    "window_topology_contract_ref": { "type": "string", "minLength": 1 },
    "attention_routing_contract_ref": { "type": "string", "minLength": 1 },
    "session_restore_contract_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_truth_dimensions": { "type": "array", "items": { "$ref": "#/$defs/truth_dimension" } },
    "required_profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
    "required_families": { "type": "array", "items": { "type": "string" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_profiles": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "profile_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "profile": {
      "enum": [
        "compact_desktop",
        "standard_desktop",
        "expanded_desktop",
        "mixed_dpi",
        "multi_monitor",
        "dependency_missing_restore"
      ]
    },
    "truth_dimension": {
      "enum": [
        "shell_zone_integrity",
        "adaptive_layout",
        "multi_window_truth",
        "owning_window_routing"
      ]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "shell_zone_integrity": {
      "enum": [
        "all_surfaces_in_declared_slots",
        "disclosed_slot_fallback_narrowing",
        "private_slot_drift_detected"
      ]
    },
    "adaptive_layout": {
      "enum": [
        "identity_stable_no_unusable_pane",
        "disclosed_collapse_narrowing",
        "identity_lost_or_unusable_pane"
      ]
    },
    "multi_window_truth": {
      "enum": [
        "all_truths_preserved_layout_local",
        "disclosed_truth_projection_narrowing",
        "workspace_truth_diverged_across_windows"
      ]
    },
    "owning_window_routing": {
      "enum": [
        "routes_to_owning_object_no_focus_theft",
        "disclosed_routing_relocation",
        "routing_lost_focus_theft_or_orphan"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "profile", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/profile" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "trigger", "disclosed", "detail"],
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profile_label",
        "owner_role",
        "scenario_summary",
        "evaluated_families",
        "shell_zone_integrity",
        "adaptive_layout",
        "multi_window_truth",
        "owning_window_routing",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "profile_causes",
        "narrowing_reason"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "profile_label": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "scenario_summary": { "type": "string", "minLength": 1 },
        "evaluated_families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "shell_zone_integrity": { "$ref": "#/$defs/shell_zone_integrity" },
        "adaptive_layout": { "$ref": "#/$defs/adaptive_layout" },
        "multi_window_truth": { "$ref": "#/$defs/multi_window_truth" },
        "owning_window_routing": { "$ref": "#/$defs/owning_window_routing" },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "profile_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
