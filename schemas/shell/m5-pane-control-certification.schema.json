{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-pane-control-certification.schema.json",
  "title": "Aureline M5 splitter & resizable-pane control precision, persistence, restore & export certification packet",
  "description": "Pane-control certification capstone on top of the frozen M5 shell-primitives matrix. For every claimed M5 multi-pane layout — notebook, data, review, docs, profiler, and incident — the packet certifies that a splitter or resizable pane can be resized precisely with both pointer and keyboard inputs (enlarged logical hit targets, hover/focus strengthen states, keyboard step-size controls, and double-click / default-size restore); that resize intent persists as proportions or named presets rather than brittle pixel positions, and that compact/expanded or monitor-topology changes preserve that intent safely; that reset-to-default and restore after crash or display/topology changes stay lossless and non-destructive; and that current pane proportions and recent resize actions are reconstructable from a support export without screenshots or manual reproduction. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The pane-resize-state, accessibility-route, required-label, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen shell-primitives matrix. Pane controls carry no source/provider or freshness truth, so the required-label set is the four pane-control labels (identity, state, keyboard_route, reopen_path). Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_pane_resize_states",
    "required_labels",
    "rows",
    "covered_layouts",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_pane_control_certification_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_pane_control_certification:v1" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_pane_resize_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/pane_resize_state" }
    },
    "required_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/required_label" }
    },
    "rows": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "covered_layouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/layout" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "certification_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "$ref": "#/$defs/ref_list" },
    "release_center_refs": { "$ref": "#/$defs/ref_list" },
    "help_docs_refs": { "$ref": "#/$defs/ref_list" },
    "support_export_refs": { "$ref": "#/$defs/ref_list" },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "layout": {
      "type": "string",
      "enum": ["notebook", "data", "review", "docs", "profiler", "incident"]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "resize_control_precision",
        "proportion_persistence",
        "reset_restore",
        "resize_state_export"
      ]
    },
    "primitive_family": {
      "type": "string",
      "enum": [
        "status_bar_item",
        "status_overflow_menu",
        "tooltip",
        "hovercard",
        "peek_panel",
        "pinned_preview_promotion",
        "splitter_handle",
        "pane_resize_preset",
        "progress_indicator",
        "durable_job_row"
      ]
    },
    "pane_resize_state": {
      "type": "string",
      "enum": [
        "idle",
        "dragging",
        "keyboard_step",
        "snapped_to_preset",
        "reset_to_default",
        "clamped_to_min_width",
        "collapsed_to_rail"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "source_provider",
        "freshness",
        "reopen_path"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "resize_control_precision": {
      "type": "string",
      "enum": [
        "precise_pointer_and_keyboard_resize",
        "disclosed_reduced_hit_target_or_step",
        "pointer_only_or_brittle_hit_target"
      ]
    },
    "proportion_persistence": {
      "type": "string",
      "enum": [
        "proportions_or_presets_persisted",
        "disclosed_reduced_persistence_fidelity",
        "brittle_pixel_only_persistence"
      ]
    },
    "reset_restore": {
      "type": "string",
      "enum": [
        "default_reset_and_topology_restore",
        "disclosed_reduced_restore_fidelity",
        "restore_lost_or_destructive"
      ]
    },
    "resize_export": {
      "type": "string",
      "enum": [
        "proportions_and_actions_reconstructable",
        "disclosed_partial_capture",
        "resize_state_absent_from_capture"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "vanity_item_reflow",
        "spinner_only_state",
        "hover_only_critical_truth",
        "source_freshness_hidden",
        "stale_preview_mistaken_for_live",
        "promotion_dropped_truth",
        "pointer_only_resize",
        "resize_state_not_serializable",
        "progress_lost_on_look_away",
        "grouped_progress_unattributed",
        "severe_state_displaced_truth",
        "proof_stale"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "layout", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "layout": { "$ref": "#/$defs/layout" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "trigger", "disclosed", "detail"],
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "layout_missing",
            "resize_control_not_precise",
            "persistence_brittle_pixel_only",
            "restore_lost_or_destructive",
            "resize_state_absent_from_capture",
            "pane_pointer_only_resizable",
            "pane_resize_states_incomplete",
            "required_labels_incomplete",
            "narrowed_row_without_reason",
            "narrowed_row_without_waiver",
            "waiver_layout_mismatch",
            "waiver_expired",
            "row_status_stale",
            "row_causes_stale",
            "status_counts_stale",
            "coverage_stale",
            "raw_boundary_material_in_export"
          ]
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "driven_primitive_families",
        "matrix_qualification",
        "owner_role",
        "layout_label",
        "shell_zone_slot",
        "certified_pane_resize_states",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "resize_control_precision",
        "proportion_persistence",
        "reset_restore",
        "resize_export",
        "pane_never_pointer_only_resizable",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "driven_primitive_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/primitive_family" }
        },
        "matrix_qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "layout_label": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "certified_pane_resize_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/pane_resize_state" }
        },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "resize_control_precision": { "$ref": "#/$defs/resize_control_precision" },
        "proportion_persistence": { "$ref": "#/$defs/proportion_persistence" },
        "reset_restore": { "$ref": "#/$defs/reset_restore" },
        "resize_export": { "$ref": "#/$defs/resize_export" },
        "pane_never_pointer_only_resizable": { "type": "boolean" },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    }
  }
}
