{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-trust-component-accessibility-parity.schema.json",
  "title": "Aureline M5 trust-component accessibility parity certification packet",
  "description": "Accessibility parity certification capstone on top of the frozen M5 settings-row, capability-sheet, evidence-chronology, and chronology-export component matrix. For every claimed non-default accessibility condition — keyboard reach, focus order, screen-reader narration, high-zoom, high-contrast, reduced-motion, and compact/comfortable density — the packet certifies that the settings rows, capability sheets, event rows, timeline groups, and export previews stay keyboard- and screen-reader-reachable with focus that lands and returns in order; stay legible and stable under high-zoom, high-contrast, and compact density with no truth hover-only, color-only, or lost on compaction; keep a durable static text alternative for anything conveyed by motion; and reconstruct the same source, state, and chronology language from reusable fixtures and a support export without ad hoc visual or screenshot checks. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The settings-row-state, source-pill, consequence-class, scope-state, chronology-verb, provenance-badge, detail-state, export-field, accessibility-route, required-label, shell-zone, responsive-class, window-class, surface-family, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen trust-chronology component matrix. The union across the six frozen components covers the full six accessibility routes (keyboard_focusable, screen_reader_announced, non_hover_reachable, pointer_optional, high_contrast_safe, support_exportable) and the full six required labels (identity, state, keyboard_route, provenance, effective_value, audit_reopen_path). Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_accessibility_routes",
    "required_labels",
    "rows",
    "covered_conditions",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "$defs": {
    "condition": {
      "type": "string",
      "enum": [
        "keyboard_reach",
        "focus_order",
        "screen_reader_narration",
        "high_zoom",
        "high_contrast",
        "reduced_motion",
        "density_compaction"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "non_visual_reach",
        "zoom_contrast_density",
        "motion_alternative",
        "support_export_parity"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "provenance",
        "effective_value",
        "audit_reopen_path"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "keyboard_focus_and_narration_reachable",
        "disclosed_reduced_reach_detail",
        "truth_reachable_by_pointer_or_hover_only"
      ]
    },
    "zoom_contrast_density_state": {
      "type": "string",
      "enum": [
        "legible_stable_under_zoom_contrast_density",
        "disclosed_reduced_zoom_contrast_density_detail",
        "truncated_color_only_or_lost_on_compaction"
      ]
    },
    "motion_alternative_state": {
      "type": "string",
      "enum": [
        "durable_text_alternative_present",
        "disclosed_reduced_alternative_detail",
        "motion_only_affordance"
      ]
    },
    "support_export_parity_state": {
      "type": "string",
      "enum": [
        "component_truth_reconstructable",
        "disclosed_partial_capture",
        "component_state_absent_from_capture"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "effective_configured_conflated",
        "source_pill_missing",
        "lock_state_unexplained",
        "consequence_grouping_dropped",
        "transitive_scope_hidden",
        "re_consent_skipped",
        "verb_vocabulary_drift",
        "provenance_badge_missing",
        "chronology_detail_not_reopenable",
        "export_field_dropped",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "condition", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "condition": { "$ref": "#/$defs/condition" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "trigger", "disclosed", "detail"],
      "properties": {
        "condition": { "$ref": "#/$defs/condition" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": { "type": "string" },
        "condition": { "type": "string" },
        "waiver_id": { "type": "string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "driven_component_families",
        "matrix_qualification",
        "owner_role",
        "condition_label",
        "certified_shell_zone_slots",
        "certified_responsive_classes",
        "certified_window_classes",
        "certified_surface_families",
        "certified_settings_row_states",
        "certified_source_pills",
        "certified_consequence_classes",
        "certified_capability_scope_states",
        "certified_chronology_verbs",
        "certified_provenance_badges",
        "certified_chronology_detail_states",
        "certified_chronology_export_fields",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "non_visual_reach",
        "zoom_contrast_density",
        "motion_alternative",
        "support_export_parity",
        "never_hover_color_only_or_compaction_lost",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "condition": { "$ref": "#/$defs/condition" },
        "driven_component_families": { "type": "array", "items": { "type": "string" } },
        "matrix_qualification": { "type": "string" },
        "owner_role": { "type": "string" },
        "condition_label": { "type": "string" },
        "certified_shell_zone_slots": { "type": "array", "items": { "type": "string" } },
        "certified_responsive_classes": { "type": "array", "items": { "type": "string" } },
        "certified_window_classes": { "type": "array", "items": { "type": "string" } },
        "certified_surface_families": { "type": "array", "items": { "type": "string" } },
        "certified_settings_row_states": { "type": "array", "items": { "type": "string" } },
        "certified_source_pills": { "type": "array", "items": { "type": "string" } },
        "certified_consequence_classes": { "type": "array", "items": { "type": "string" } },
        "certified_capability_scope_states": { "type": "array", "items": { "type": "string" } },
        "certified_chronology_verbs": { "type": "array", "items": { "type": "string" } },
        "certified_provenance_badges": { "type": "array", "items": { "type": "string" } },
        "certified_chronology_detail_states": { "type": "array", "items": { "type": "string" } },
        "certified_chronology_export_fields": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": { "type": "array", "items": { "$ref": "#/$defs/required_label" } },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "non_visual_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "zoom_contrast_density": { "$ref": "#/$defs/zoom_contrast_density_state" },
        "motion_alternative": { "$ref": "#/$defs/motion_alternative_state" },
        "support_export_parity": { "$ref": "#/$defs/support_export_parity_state" },
        "never_hover_color_only_or_compaction_lost": { "type": "boolean" },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  },
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "shell_m5_trust_component_accessibility_parity_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string" },
    "packet_id": { "type": "string" },
    "source_schema_ref": { "type": "string" },
    "headline": { "type": "string" },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string" },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_accessibility_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/accessibility_route" }
    },
    "required_labels": { "type": "array", "items": { "$ref": "#/$defs/required_label" } },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "covered_conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } },
    "certification_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
    "blocking_findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
