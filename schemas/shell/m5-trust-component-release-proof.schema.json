{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-trust-component-release-proof.schema.json",
  "title": "Aureline M5 trust-component release-proof certification packet",
  "description": "Release-evidence certification capstone that closes the B88 component-contract lane on top of the frozen M5 settings-row, capability-sheet, evidence-chronology, and chronology-export component matrix. For every governed component family — settings row, capability sheet, event/history row, timeline group, narrative summary card, and chronology export preview — the packet certifies, per-family and against the family's own frozen matrix row, that the component's contract truth stays certified on every claimed M5 trust/config/activity/support surface; that the same reusable component reads with one row grammar across every surface; that a support export plus screenshot/golden baselines reconstruct the component truth; and that the exported proof stays fresh so a consumer that drifts off the shared contract auto-narrows rather than keeping a stale claim. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The settings-row-state, source-pill, consequence-class, scope-state, chronology-verb, provenance-badge, detail-state, export-field, accessibility-route, required-label, shell-zone, responsive-class, window-class, surface-family, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen trust-chronology component matrix. Each row certifies all ten claimed M5 surface families, and the union of certified truth pillars across the six families covers the whole track invariant (effective_value_source_and_lock, consequence_scope_and_reconsent, chronology_verb_provenance_and_export). Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_truth_pillars",
    "required_surface_families",
    "rows",
    "covered_families",
    "covered_truth_pillars",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "settings_row",
        "capability_sheet",
        "event_history_row",
        "timeline_group",
        "narrative_summary_card",
        "chronology_export_preview"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "component_contract_truth",
        "cross_surface_parity",
        "support_export_proof",
        "proof_freshness"
      ]
    },
    "truth_pillar": {
      "type": "string",
      "enum": [
        "effective_value_source_and_lock",
        "consequence_scope_and_reconsent",
        "chronology_verb_provenance_and_export"
      ]
    },
    "component_contract_truth_state": {
      "type": "string",
      "enum": [
        "contract_truth_certified_every_surface",
        "disclosed_reduced_contract_truth",
        "contract_truth_collapsed_or_drifted"
      ]
    },
    "cross_surface_parity_state": {
      "type": "string",
      "enum": [
        "parity_certified_across_surfaces",
        "disclosed_reduced_surface_projection",
        "row_grammar_diverged_off_primary_surface"
      ]
    },
    "support_export_proof_state": {
      "type": "string",
      "enum": [
        "reconstructable_in_export_and_screenshot",
        "disclosed_partial_capture",
        "component_truth_absent_from_capture"
      ]
    },
    "proof_freshness_state": {
      "type": "string",
      "enum": [
        "exported_proof_fresh_and_current",
        "disclosed_partial_refresh",
        "exported_proof_stale_or_divergent"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "effective_configured_conflated",
        "source_pill_missing",
        "lock_state_unexplained",
        "consequence_grouping_dropped",
        "transitive_scope_hidden",
        "re_consent_skipped",
        "verb_vocabulary_drift",
        "provenance_badge_missing",
        "chronology_detail_not_reopenable",
        "export_field_dropped",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "component_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_family", "trigger", "disclosed", "detail"],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": { "type": "string" },
        "family": { "type": "string" },
        "waiver_id": { "type": "string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "matrix_qualification",
        "owner_role",
        "family_label",
        "scope_summary",
        "certified_truth_pillars",
        "shell_zone_slot",
        "certified_responsive_classes",
        "certified_window_classes",
        "certified_surface_families",
        "certified_settings_row_states",
        "certified_source_pills",
        "certified_consequence_classes",
        "certified_capability_scope_states",
        "certified_chronology_verbs",
        "certified_provenance_badges",
        "certified_chronology_detail_states",
        "certified_chronology_export_fields",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "component_contract_truth",
        "cross_surface_parity",
        "support_export_proof",
        "proof_freshness",
        "never_drops_audit_or_support_truth",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "matrix_qualification": { "type": "string" },
        "owner_role": { "type": "string" },
        "family_label": { "type": "string" },
        "scope_summary": { "type": "string" },
        "certified_truth_pillars": { "type": "array", "items": { "$ref": "#/$defs/truth_pillar" } },
        "shell_zone_slot": { "type": "string" },
        "certified_responsive_classes": { "type": "array", "items": { "type": "string" } },
        "certified_window_classes": { "type": "array", "items": { "type": "string" } },
        "certified_surface_families": { "type": "array", "items": { "type": "string" } },
        "certified_settings_row_states": { "type": "array", "items": { "type": "string" } },
        "certified_source_pills": { "type": "array", "items": { "type": "string" } },
        "certified_consequence_classes": { "type": "array", "items": { "type": "string" } },
        "certified_capability_scope_states": { "type": "array", "items": { "type": "string" } },
        "certified_chronology_verbs": { "type": "array", "items": { "type": "string" } },
        "certified_provenance_badges": { "type": "array", "items": { "type": "string" } },
        "certified_chronology_detail_states": { "type": "array", "items": { "type": "string" } },
        "certified_chronology_export_fields": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } },
        "required_labels": { "type": "array", "items": { "type": "string" } },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "component_contract_truth": { "$ref": "#/$defs/component_contract_truth_state" },
        "cross_surface_parity": { "$ref": "#/$defs/cross_surface_parity_state" },
        "support_export_proof": { "$ref": "#/$defs/support_export_proof_state" },
        "proof_freshness": { "$ref": "#/$defs/proof_freshness_state" },
        "never_drops_audit_or_support_truth": { "type": "boolean" },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  },
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "shell_m5_trust_component_release_proof_packet_record"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "type": "string" },
    "packet_id": { "type": "string" },
    "source_schema_ref": { "type": "string" },
    "headline": { "type": "string" },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string" },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_truth_pillars": { "type": "array", "items": { "$ref": "#/$defs/truth_pillar" } },
    "required_surface_families": { "type": "array", "items": { "type": "string" } },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "covered_families": { "type": "array", "items": { "$ref": "#/$defs/component_family" } },
    "covered_truth_pillars": { "type": "array", "items": { "$ref": "#/$defs/truth_pillar" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } },
    "certification_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
    "blocking_findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
