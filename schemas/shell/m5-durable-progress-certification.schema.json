{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-durable-progress-certification.schema.json",
  "title": "Aureline M5 durable progress-indicator & job-row actor, phase, action & history parity certification packet",
  "description": "Durable-progress certification capstone on top of the frozen M5 shell-primitives matrix. For every claimed M5 durable-work job family — indexing, notebook/runtime, request/data-load, download, update, sync, branch-agent, provider-handoff, and support/export — the packet certifies that durable work stays reviewable after focus loss rather than as a transient spinner or toast; that every progress row attributes its actor/subsystem, phase, current step, cancel/retry/open-details actions, and a link back to the authoritative object or evidence packet; that grouped completion/failure history and blocked/paused reasons are preserved in durable, reopenable history; and that current progress and recent job history are reconstructable from a support export without relying on transient toasts or a live dashboard. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The progress-state, source-freshness, accessibility-route, required-label, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen shell-primitives matrix. Progress rows carry source/provider and freshness truth, so the required-label set is the full six labels (identity, state, keyboard_route, source_provider, freshness, reopen_path). Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_progress_states",
    "required_labels",
    "rows",
    "covered_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_durable_progress_certification_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_durable_progress_certification:v1" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_progress_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/progress_state" }
    },
    "required_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/required_label" }
    },
    "rows": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "covered_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "certification_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "$ref": "#/$defs/ref_list" },
    "release_center_refs": { "$ref": "#/$defs/ref_list" },
    "help_docs_refs": { "$ref": "#/$defs/ref_list" },
    "support_export_refs": { "$ref": "#/$defs/ref_list" },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "family": {
      "type": "string",
      "enum": [
        "indexing",
        "notebook_runtime",
        "request_data_load",
        "download",
        "update",
        "sync",
        "branch_agent",
        "provider_handoff",
        "support_export"
      ]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "durable_presence",
        "progress_attribution",
        "grouped_history",
        "progress_export"
      ]
    },
    "primitive_family": {
      "type": "string",
      "enum": [
        "status_bar_item",
        "status_overflow_menu",
        "tooltip",
        "hovercard",
        "peek_panel",
        "pinned_preview_promotion",
        "splitter_handle",
        "pane_resize_preset",
        "progress_indicator",
        "durable_job_row"
      ]
    },
    "progress_state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "grouped_batch",
        "paused",
        "succeeded",
        "failed",
        "canceled_by_user",
        "reopenable_history"
      ]
    },
    "source_freshness_label": {
      "type": "string",
      "enum": [
        "live_canonical",
        "cached_snapshot",
        "stale_invalidated",
        "provider_attributed",
        "sampled_approximate",
        "refresh_in_flight"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "source_provider",
        "freshness",
        "reopen_path"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "durable_presence": {
      "type": "string",
      "enum": [
        "durable_reviewable_after_focus_loss",
        "disclosed_reduced_history_retention",
        "transient_spinner_or_toast_only"
      ]
    },
    "progress_attribution": {
      "type": "string",
      "enum": [
        "actor_phase_action_object_attributed",
        "disclosed_coarse_attribution",
        "attribution_or_object_link_missing"
      ]
    },
    "grouped_history": {
      "type": "string",
      "enum": [
        "grouped_history_and_blocked_reasons_preserved",
        "disclosed_compacted_history",
        "history_or_blocked_reason_lost"
      ]
    },
    "progress_export": {
      "type": "string",
      "enum": [
        "progress_and_history_reconstructable",
        "disclosed_partial_capture",
        "progress_state_absent_from_capture"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "vanity_item_reflow",
        "spinner_only_state",
        "hover_only_critical_truth",
        "source_freshness_hidden",
        "stale_preview_mistaken_for_live",
        "promotion_dropped_truth",
        "pointer_only_resize",
        "resize_state_not_serializable",
        "progress_lost_on_look_away",
        "grouped_progress_unattributed",
        "severe_state_displaced_truth",
        "proof_stale"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "trigger", "disclosed", "detail"],
      "properties": {
        "family": { "$ref": "#/$defs/family" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "family_missing",
            "progress_not_durable",
            "attribution_missing",
            "grouped_history_lost",
            "progress_state_absent_from_capture",
            "job_spinner_or_toast_only",
            "progress_states_incomplete",
            "required_labels_incomplete",
            "narrowed_row_without_reason",
            "narrowed_row_without_waiver",
            "waiver_family_mismatch",
            "waiver_expired",
            "row_status_stale",
            "row_causes_stale",
            "status_counts_stale",
            "coverage_stale",
            "raw_boundary_material_in_export"
          ]
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "driven_primitive_families",
        "matrix_qualification",
        "owner_role",
        "family_label",
        "shell_zone_slot",
        "certified_progress_states",
        "certified_source_freshness_labels",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "durable_presence",
        "progress_attribution",
        "grouped_history",
        "progress_export",
        "never_spinner_or_toast_only",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/family" },
        "driven_primitive_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/primitive_family" }
        },
        "matrix_qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "family_label": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "certified_progress_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/progress_state" }
        },
        "certified_source_freshness_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_freshness_label" }
        },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "durable_presence": { "$ref": "#/$defs/durable_presence" },
        "progress_attribution": { "$ref": "#/$defs/progress_attribution" },
        "grouped_history": { "$ref": "#/$defs/grouped_history" },
        "progress_export": { "$ref": "#/$defs/progress_export" },
        "never_spinner_or_toast_only": { "type": "boolean" },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    }
  }
}
