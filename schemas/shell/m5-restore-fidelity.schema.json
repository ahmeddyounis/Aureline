{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-restore-fidelity.schema.json",
  "title": "Aureline M5 restore-fidelity restore-profile entry",
  "description": "Canonical single-entry shape of an M5 window-restore family whose truth is skeleton-first rebuild and no-rerun session hydration (skeleton-first restore and no-rerun session hydration). Every claimed M5 desktop surface references this schema or the combined m5-window-restore-matrix.schema.json rather than reinventing its own skeleton-versus-hydrate ordering, no-rerun rule, or exact-versus-compatible-versus-layout-only restore-fidelity classes. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-entry shape.",
  "type": "object",
  "required": [
    "window_restore_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "semantic_roles",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore",
    "deletes_layout_structure_silently_on_missing_extension_or_remote_target",
    "leaves_windows_or_dialogs_unreachable_after_display_topology_remap",
    "merges_workspace_authority_and_window_topology_into_one_opaque_blob",
    "overclaims_restore_fidelity_when_only_context_or_evidence_reopened"
  ],
  "properties": {
    "window_restore_family": {
      "$ref": "#/$defs/window_restore_family"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "workspace_authority",
          "window_topology",
          "pane_role",
          "layout_skeleton",
          "session_hydration",
          "restore_fidelity",
          "display_affinity"
        ]
      }
    },
    "shared_workspace_authority_roles": {
      "type": "array"
    },
    "window_local_topology_roles": {
      "type": "array"
    },
    "skeleton_first_restore_roles": {
      "type": "array"
    },
    "no_rerun_session_hydration_roles": {
      "type": "array"
    },
    "display_topology_recovery_roles": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore": {
      "const": false
    },
    "deletes_layout_structure_silently_on_missing_extension_or_remote_target": {
      "const": false
    },
    "leaves_windows_or_dialogs_unreachable_after_display_topology_remap": {
      "const": false
    },
    "merges_workspace_authority_and_window_topology_into_one_opaque_blob": {
      "const": false
    },
    "overclaims_restore_fidelity_when_only_context_or_evidence_reopened": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "window_restore_family": {
      "enum": [
        "skeleton_first_restore",
        "no_rerun_session_hydration"
      ]
    }
  }
}
