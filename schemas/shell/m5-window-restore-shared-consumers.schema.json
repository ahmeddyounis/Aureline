{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-window-restore-shared-consumers.schema.json",
  "title": "M5 Window-Restore Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the five B141 workspace-window-restore families (shared workspace authority, window-local topology, skeleton-first restore, no-rerun session hydration, display-topology recovery) to the restore-coordinator / shell / workspace / session / diagnostics / docs-help / CLI-export / support-export / product consumers that render them, proving one shared window-restore registry across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_window_restore_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "window_restore_family": {
      "type": "string",
      "enum": [
        "shared_workspace_authority",
        "window_local_topology",
        "skeleton_first_restore",
        "no_rerun_session_hydration",
        "display_topology_recovery"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "restore_coordinator",
        "shell_ui",
        "workspace_service",
        "session_service",
        "diagnostics",
        "docs_help",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "window_restore_grammar_drift_detected",
        "session_continuity_or_window_local_selection_dropped",
        "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore",
        "deletes_layout_structure_silently_on_missing_extension_or_remote_target",
        "leaves_windows_or_dialogs_unreachable_after_display_topology_remap",
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob",
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened",
        "canonical_registry_reference_missing",
        "upstream_window_restore_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_restore_role_word",
        "family_word",
        "registry_reference_word",
        "restore_context_word",
        "surface_context_word",
        "session_continuity_word"
      ],
      "properties": {
        "window_restore_role_word": {
          "type": "string",
          "enum": [
            "workspace_authority",
            "window_topology",
            "pane_role",
            "layout_skeleton",
            "session_hydration",
            "restore_fidelity",
            "display_affinity"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "restore_context_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "session_continuity_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "restore_profile_id",
        "restore_profile_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore",
        "deletes_layout_structure_silently_on_missing_extension_or_remote_target",
        "leaves_windows_or_dialogs_unreachable_after_display_topology_remap",
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob",
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "restore_profile_id": { "type": "string", "minLength": 1 },
        "restore_profile_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/window_restore_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "reruns_commands_or_reattaches_privileged_sessions_implicitly_during_restore": {
          "type": "boolean",
          "const": false
        },
        "deletes_layout_structure_silently_on_missing_extension_or_remote_target": {
          "type": "boolean",
          "const": false
        },
        "leaves_windows_or_dialogs_unreachable_after_display_topology_remap": {
          "type": "boolean",
          "const": false
        },
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob": {
          "type": "boolean",
          "const": false
        },
        "overclaims_restore_fidelity_when_only_context_or_evidence_reopened": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_profile_same_window_restore_across_surfaces",
        "window_restore_role_words_stay_in_frozen_vocabulary",
        "authority_roles_never_clobber_selection_or_rerun_session_work",
        "restore_never_reruns_or_reattaches_session_scoped_work",
        "restore_never_deletes_layout_structure_silently",
        "display_remap_never_leaves_window_or_dialog_unreachable",
        "workspace_authority_and_window_topology_never_merged_into_blob",
        "restore_never_overclaims_fidelity_when_only_context_or_evidence_reopened",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_profile_same_window_restore_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "window_restore_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "authority_roles_never_clobber_selection_or_rerun_session_work": {
          "type": "boolean",
          "const": true
        },
        "restore_never_reruns_or_reattaches_session_scoped_work": {
          "type": "boolean",
          "const": true
        },
        "restore_never_deletes_layout_structure_silently": {
          "type": "boolean",
          "const": true
        },
        "display_remap_never_leaves_window_or_dialog_unreachable": {
          "type": "boolean",
          "const": true
        },
        "workspace_authority_and_window_topology_never_merged_into_blob": {
          "type": "boolean",
          "const": true
        },
        "restore_never_overclaims_fidelity_when_only_context_or_evidence_reopened": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restore_coordinator_consumes_shared_window_restore",
        "shell_ui_consumes_shared_window_restore",
        "workspace_service_consumes_shared_window_restore",
        "session_service_consumes_shared_window_restore",
        "diagnostics_consumes_shared_window_restore",
        "docs_help_consumes_shared_window_restore",
        "cli_export_consumes_shared_window_restore",
        "support_export_consumes_shared_window_restore",
        "product_ui_consumes_shared_window_restore",
        "every_family_adopted_by_two_or_more_consumers",
        "window_restore_identical_for_same_profile",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_window_restore_family"
      ],
      "properties": {
        "restore_coordinator_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "shell_ui_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "workspace_service_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "session_service_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "docs_help_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "cli_export_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "product_ui_consumes_shared_window_restore": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "window_restore_identical_for_same_profile": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_window_restore_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
