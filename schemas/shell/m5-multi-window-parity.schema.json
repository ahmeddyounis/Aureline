{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-multi-window-parity.schema.json",
  "title": "Aureline M5 multi-window truth-parity packet",
  "description": "Multi-window-truth capstone on top of the frozen M5 shell-zone matrix. For every governed surface family — notebook, data grid, profiler, pipeline, docs, preview, review, incident, companion, and operator — the packet certifies that every window carrying its work preserves the same workspace identity, trust, remote/host, profile, and recovery-critical truth while keeping layout, density, and focus local, that dialogs, notifications, and approvals route back to the owning window and object without focus theft or orphaning, and that crash-restore, dependency-loss, and monitor-topology drills stay predictable and non-destructive. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the truth-completeness and per-window plan checks are the lint that prevents a later cross-window regression from shipping as stable. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "window_topology_contract_ref",
    "session_restore_contract_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_continuity_truths",
    "rows",
    "covered_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "parity_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_multi_window_parity_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "window_topology_contract_ref": { "type": "string", "minLength": 1 },
    "session_restore_contract_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_continuity_truths": { "type": "array", "items": { "$ref": "#/$defs/continuity_truth" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_families": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "parity_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "continuity_truth": {
      "enum": ["workspace_global_trust", "remote_target", "deployment_profile", "recovery_state"]
    },
    "window_class": {
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "owning_window_routing_expectation": {
      "enum": [
        "route_to_owning_window_object",
        "preserve_object_anchor_on_return",
        "no_focus_theft",
        "no_orphan_on_detach"
      ]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "continuity_parity": {
      "enum": [
        "all_truths_preserved_in_every_window",
        "disclosed_truth_projection_narrowing",
        "workspace_truth_diverged_across_windows"
      ]
    },
    "layout_locality": {
      "enum": [
        "layout_density_focus_local_risk_global",
        "disclosed_local_only_state",
        "workspace_global_risk_hidden_locally"
      ]
    },
    "owning_window_routing": {
      "enum": [
        "routes_to_owning_window_object",
        "disclosed_routing_relocation",
        "routing_lost_focus_theft_or_orphan"
      ]
    },
    "recovery_drill": {
      "enum": [
        "restore_dependency_topology_predictable",
        "disclosed_recovery_narrowing",
        "restore_destructive_or_orphaned"
      ]
    },
    "window_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_class",
        "preserved_truths",
        "layout_is_local",
        "routes_to_owning_window"
      ],
      "properties": {
        "window_class": { "$ref": "#/$defs/window_class" },
        "preserved_truths": {
          "type": "array",
          "items": { "$ref": "#/$defs/continuity_truth" }
        },
        "layout_is_local": { "type": "boolean" },
        "routes_to_owning_window": { "type": "boolean" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "trigger", "disclosed", "detail"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "matrix_qualification",
        "owner_role",
        "surface_label",
        "canonical_slot",
        "fallback_slot",
        "declared_window_classes",
        "declared_continuity_truths",
        "declared_owning_window_routing",
        "window_plans",
        "continuity_parity",
        "layout_locality",
        "owning_window_routing",
        "recovery_drill",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "parity_causes",
        "narrowing_reason"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "matrix_qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "surface_label": { "type": "string", "minLength": 1 },
        "canonical_slot": { "type": "string", "minLength": 1 },
        "fallback_slot": { "type": "string", "minLength": 1 },
        "declared_window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "declared_continuity_truths": {
          "type": "array",
          "items": { "$ref": "#/$defs/continuity_truth" }
        },
        "declared_owning_window_routing": {
          "type": "array",
          "items": { "$ref": "#/$defs/owning_window_routing_expectation" }
        },
        "window_plans": {
          "type": "array",
          "items": { "$ref": "#/$defs/window_plan" }
        },
        "continuity_parity": { "$ref": "#/$defs/continuity_parity" },
        "layout_locality": { "$ref": "#/$defs/layout_locality" },
        "owning_window_routing": { "$ref": "#/$defs/owning_window_routing" },
        "recovery_drill": { "$ref": "#/$defs/recovery_drill" },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "parity_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
