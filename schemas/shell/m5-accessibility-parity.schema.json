{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-accessibility-parity.schema.json",
  "title": "Aureline M5 shell-primitive accessibility parity certification packet",
  "description": "Accessibility parity certification capstone on top of the frozen M5 shell-primitives matrix. For every claimed non-default accessibility condition — keyboard reach, focus return, screen-reader narration, touch / context-action, high-zoom, high-contrast, and reduced-motion — the packet certifies that the status, hover/peek, splitter, and progress shell primitives stay keyboard- and screen-reader-reachable with focus that returns after dismiss; stay legible and stable under high-zoom and high-contrast; keep durable text alternatives when motion is reduced and touch / context-action alternatives where a pointer affordance would otherwise be required; and reconstruct their accessibility posture and primitive state from reusable fixtures and a support export without ad hoc visual or screenshot checks. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The status-item-class, overflow-behavior, representation-class, promotion-state, pane-resize-state, progress-state, source-freshness, accessibility-route, required-label, shell-zone, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen shell-primitives matrix. The union across the ten frozen primitives covers the full six accessibility routes (keyboard_focusable, screen_reader_announced, non_hover_reachable, pointer_optional, high_contrast_safe, support_exportable) and the full six required labels (identity, state, keyboard_route, source_provider, freshness, reopen_path). Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_accessibility_routes",
    "required_labels",
    "rows",
    "covered_conditions",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_accessibility_parity_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_accessibility_parity:v1" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_accessibility_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/accessibility_route" }
    },
    "required_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/required_label" }
    },
    "rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "covered_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "certification_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "$ref": "#/$defs/ref_list" },
    "release_center_refs": { "$ref": "#/$defs/ref_list" },
    "help_docs_refs": { "$ref": "#/$defs/ref_list" },
    "support_export_refs": { "$ref": "#/$defs/ref_list" },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "condition": {
      "type": "string",
      "enum": [
        "keyboard_reach",
        "focus_return",
        "screen_reader_narration",
        "touch_context_action",
        "high_zoom",
        "high_contrast",
        "reduced_motion"
      ]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "non_visual_reach",
        "zoom_contrast_stability",
        "motion_touch_alternative",
        "accessibility_export"
      ]
    },
    "primitive_family": {
      "type": "string",
      "enum": [
        "status_bar_item",
        "status_overflow_menu",
        "tooltip",
        "hovercard",
        "peek_panel",
        "pinned_preview_promotion",
        "splitter_handle",
        "pane_resize_preset",
        "progress_indicator",
        "durable_job_row"
      ]
    },
    "status_item_class": {
      "type": "string",
      "enum": [
        "background_work",
        "connection_target",
        "deployment_profile",
        "sync_freshness",
        "problem_count",
        "mode_indicator",
        "notification_summary",
        "capacity_meter"
      ]
    },
    "overflow_behavior": {
      "type": "string",
      "enum": [
        "priority_pinned",
        "collapse_to_overflow_menu",
        "group_into_summary",
        "drop_vanity_item",
        "promote_severe_state",
        "keyboard_reachable_overflow"
      ]
    },
    "representation_class": {
      "type": "string",
      "enum": [
        "plain_tooltip",
        "rich_hovercard",
        "structured_peek",
        "pinned_peek",
        "provenance_strip",
        "truncated_with_reopen"
      ]
    },
    "promotion_state": {
      "type": "string",
      "enum": [
        "transient",
        "pinned",
        "promoted_to_panel",
        "detached_to_window",
        "demoted_to_transient",
        "dismissed_preserved"
      ]
    },
    "pane_resize_state": {
      "type": "string",
      "enum": [
        "idle",
        "dragging",
        "keyboard_step",
        "snapped_to_preset",
        "reset_to_default",
        "clamped_to_min_width",
        "collapsed_to_rail"
      ]
    },
    "progress_state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "grouped_batch",
        "paused",
        "succeeded",
        "failed",
        "canceled_by_user",
        "reopenable_history"
      ]
    },
    "source_freshness_label": {
      "type": "string",
      "enum": [
        "live_canonical",
        "cached_snapshot",
        "stale_invalidated",
        "provider_attributed",
        "sampled_approximate",
        "refresh_in_flight"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "source_provider",
        "freshness",
        "reopen_path"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "non_visual_reach": {
      "type": "string",
      "enum": [
        "keyboard_focus_and_narration_reachable",
        "disclosed_reduced_reach_detail",
        "truth_reachable_by_pointer_or_hover_only"
      ]
    },
    "zoom_contrast_stability": {
      "type": "string",
      "enum": [
        "legible_stable_under_zoom_and_contrast",
        "disclosed_reduced_zoom_contrast_detail",
        "truncated_or_unreadable_under_zoom_or_contrast"
      ]
    },
    "motion_touch_alternative": {
      "type": "string",
      "enum": [
        "durable_text_and_touch_alternatives_present",
        "disclosed_reduced_alternative_detail",
        "motion_only_or_pointer_only_affordance"
      ]
    },
    "accessibility_export": {
      "type": "string",
      "enum": [
        "accessibility_posture_and_state_reconstructable",
        "disclosed_partial_capture",
        "accessibility_state_absent_from_capture"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "vanity_item_reflow",
        "spinner_only_state",
        "hover_only_critical_truth",
        "source_freshness_hidden",
        "stale_preview_mistaken_for_live",
        "promotion_dropped_truth",
        "pointer_only_resize",
        "resize_state_not_serializable",
        "progress_lost_on_look_away",
        "grouped_progress_unattributed",
        "severe_state_displaced_truth",
        "proof_stale"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "condition", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "condition": { "$ref": "#/$defs/condition" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "trigger", "disclosed", "detail"],
      "properties": {
        "condition": { "$ref": "#/$defs/condition" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "condition_missing",
            "reach_pointer_or_hover_only",
            "zoom_contrast_unreadable",
            "motion_or_pointer_only_affordance",
            "accessibility_state_absent_from_capture",
            "critical_truth_pointer_or_hover_only",
            "accessibility_routes_incomplete",
            "required_labels_incomplete",
            "narrowed_row_without_reason",
            "narrowed_row_without_waiver",
            "waiver_condition_mismatch",
            "waiver_expired",
            "row_status_stale",
            "row_causes_stale",
            "status_counts_stale",
            "coverage_stale",
            "raw_boundary_material_in_export"
          ]
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "driven_primitive_families",
        "matrix_qualification",
        "owner_role",
        "condition_label",
        "certified_shell_zone_slots",
        "certified_status_item_classes",
        "certified_overflow_behaviors",
        "certified_representation_classes",
        "certified_promotion_states",
        "certified_pane_resize_states",
        "certified_progress_states",
        "certified_source_freshness_labels",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "non_visual_reach",
        "zoom_contrast_stability",
        "motion_touch_alternative",
        "accessibility_export",
        "never_pointer_or_hover_only",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "condition": { "$ref": "#/$defs/condition" },
        "driven_primitive_families": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/primitive_family" }
        },
        "matrix_qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "condition_label": { "$ref": "#/$defs/non_empty_string" },
        "certified_shell_zone_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/shell_zone_slot" }
        },
        "certified_status_item_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/status_item_class" }
        },
        "certified_overflow_behaviors": {
          "type": "array",
          "items": { "$ref": "#/$defs/overflow_behavior" }
        },
        "certified_representation_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/representation_class" }
        },
        "certified_promotion_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/promotion_state" }
        },
        "certified_pane_resize_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/pane_resize_state" }
        },
        "certified_progress_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/progress_state" }
        },
        "certified_source_freshness_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_freshness_label" }
        },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "non_visual_reach": { "$ref": "#/$defs/non_visual_reach" },
        "zoom_contrast_stability": { "$ref": "#/$defs/zoom_contrast_stability" },
        "motion_touch_alternative": { "$ref": "#/$defs/motion_touch_alternative" },
        "accessibility_export": { "$ref": "#/$defs/accessibility_export" },
        "never_pointer_or_hover_only": { "type": "boolean" },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    }
  }
}
