{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-workspace-authority-and-window-topology-registries.schema.json",
  "title": "Aureline M5 workspace-authority and window-topology registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 window-restore matrix. It carries resolved, honest projections of the shared-workspace-authority and window-local-topology families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved workspace-authority entries (naming a canonical registry token, a stable workspace ID, a semantic role, a classified authority scope, published backing windows / stable pane-tree IDs / shared dirty-buffer / save / checkpoint state / authoritative state root / distinct profile-defaults reference, and canonical/accessible/audit resolution-form coverage while keeping window-local selection and focus window-local and preserving window-local history under shared authority) and resolved window-topology entries (naming a canonical registry token, a stable window ID, a semantic role, a classified window-topology surface, published window-local pane-tree / focus-history / display-affinity, and the window-local pane-tree / focus-history / display-affinity disclosure triple). Hard invariants forbid window-local state overwriting shared workspace authority, shared workspace authority becoming private window state, workspace-authority and window-topology state being merged into one opaque blob, and shared dirty-buffer / save / checkpoint state drifting across windows sharing one authority. Acceptance criteria — every claimed workspace resolves to one stable workspace-authority object; multiple windows share one authority while preserving independent layout and focus without dirty-state drift; and the suite fails when window-local state overwrites shared authority or shared authority becomes private window state — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_workspace_authority_and_window_topology_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "window_restore_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "window_restore_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "workspace_authority_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "workspace_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority",
        "authority_scope",
        "authority_scope_is_classified",
        "canonical_authority_mode",
        "surface_context",
        "backing_window_ids",
        "stable_pane_tree_ids",
        "shared_dirty_buffer_state",
        "shared_save_checkpoint_state",
        "authority_state_root",
        "profile_defaults_ref",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "workspace_authority_object_complete",
        "bound_to_registry",
        "window_local_state_isolated",
        "shares_authority_across_windows",
        "window_local_history_preserved",
        "degrade_reason",
        "next_action",
        "authority_resolves_across_workspaces"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "workspace_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority": { "type": "boolean" },
        "authority_scope": { "$ref": "#/$defs/non_empty_string" },
        "authority_scope_is_classified": { "type": "boolean" },
        "canonical_authority_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "backing_window_ids": { "type": "string" },
        "stable_pane_tree_ids": { "type": "string" },
        "shared_dirty_buffer_state": { "type": "string" },
        "shared_save_checkpoint_state": { "type": "string" },
        "authority_state_root": { "type": "string" },
        "profile_defaults_ref": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "workspace_authority_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "window_local_state_isolated": { "type": "boolean" },
        "shares_authority_across_windows": { "type": "boolean" },
        "window_local_history_preserved": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "authority_resolves_across_workspaces": { "type": "boolean" }
      }
    },
    "window_topology_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "window_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority",
        "topology_surface",
        "topology_surface_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "window_local_pane_tree",
        "window_local_focus_history",
        "display_affinity_hint",
        "keeps_authority_distinct",
        "topology_is_truthful",
        "authority_copied_into_window_used",
        "authority_copy_disclosed",
        "profile_default_override_asserted",
        "profile_default_override_explained",
        "topology_stays_distinct",
        "provides_complete_disclosure_triple",
        "degrade_reason",
        "next_action",
        "topology_distinct_on_every_window"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "window_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_window_local_selection_and_no_rerun_under_shared_authority": { "type": "boolean" },
        "topology_surface": { "$ref": "#/$defs/non_empty_string" },
        "topology_surface_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "window_local_pane_tree": { "type": "string" },
        "window_local_focus_history": { "type": "string" },
        "display_affinity_hint": { "type": "string" },
        "keeps_authority_distinct": { "type": "boolean" },
        "topology_is_truthful": { "type": "boolean" },
        "authority_copied_into_window_used": { "type": "boolean" },
        "authority_copy_disclosed": { "type": "boolean" },
        "profile_default_override_asserted": { "type": "boolean" },
        "profile_default_override_explained": { "type": "boolean" },
        "topology_stays_distinct": { "type": "boolean" },
        "provides_complete_disclosure_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "topology_distinct_on_every_window": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "workspace_authority_entries",
        "window_topology_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "window_local_state_overwrites_shared_workspace_authority",
        "shared_workspace_authority_becomes_private_window_state",
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob",
        "dirty_buffer_state_drifts_across_windows_sharing_one_authority"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "workspace_authority_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workspace_authority_entry" }
        },
        "window_topology_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_topology_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "window_local_state_overwrites_shared_workspace_authority": { "const": false },
        "shared_workspace_authority_becomes_private_window_state": { "const": false },
        "merges_workspace_authority_and_window_topology_into_one_opaque_blob": { "const": false },
        "dirty_buffer_state_drifts_across_windows_sharing_one_authority": { "const": false }
      }
    }
  }
}
