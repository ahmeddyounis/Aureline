{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-ambient-instrumentation-stability.schema.json",
  "title": "Aureline M5 ambient shell-instrumentation stability certification packet",
  "description": "Ambient-instrumentation stability certification capstone on top of the frozen M5 shell-primitives matrix. For every claimed M5 rendering profile — standard, compact, expanded, multi-window, high-zoom, reduced-motion, degraded-network, and degraded-power — the packet certifies that counters, spinners, and multi-job summaries stay stable without reflowing or flickering the status/header strip when many jobs or counters update at once; that overflowed ambient items stay searchable from the command palette or status menus with the same labels and explanations used in the visible instrumentation; that multiple active jobs, repeated updates, and quick state changes group into one meaningful summary rather than many flickering primitives; and that this ambient-stability behavior is reconstructable from reusable fixtures and a support export without ad hoc visual checks. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The status-item-class, overflow-behavior, source-freshness, accessibility-route, required-label, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen shell-primitives matrix. The union across the status-bar item, the status overflow menu, and the progress indicator covers the full six required labels (identity, state, keyboard_route, source_provider, freshness, reopen_path), all eight status-item classes, and all six overflow behaviors. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_status_item_classes",
    "required_overflow_behaviors",
    "required_labels",
    "rows",
    "covered_profiles",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_ambient_instrumentation_stability_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_ambient_instrumentation_stability:v1" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_status_item_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/status_item_class" }
    },
    "required_overflow_behaviors": {
      "type": "array",
      "items": { "$ref": "#/$defs/overflow_behavior" }
    },
    "required_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/required_label" }
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "covered_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "certification_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "$ref": "#/$defs/ref_list" },
    "release_center_refs": { "$ref": "#/$defs/ref_list" },
    "help_docs_refs": { "$ref": "#/$defs/ref_list" },
    "support_export_refs": { "$ref": "#/$defs/ref_list" },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "profile": {
      "type": "string",
      "enum": [
        "standard",
        "compact",
        "expanded",
        "multi_window",
        "high_zoom",
        "reduced_motion",
        "degraded_network",
        "degraded_power"
      ]
    },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "counter_stability",
        "overflow_searchability",
        "grouped_summary",
        "stability_export"
      ]
    },
    "primitive_family": {
      "type": "string",
      "enum": [
        "status_bar_item",
        "status_overflow_menu",
        "tooltip",
        "hovercard",
        "peek_panel",
        "pinned_preview_promotion",
        "splitter_handle",
        "pane_resize_preset",
        "progress_indicator",
        "durable_job_row"
      ]
    },
    "status_item_class": {
      "type": "string",
      "enum": [
        "background_work",
        "connection_target",
        "deployment_profile",
        "sync_freshness",
        "problem_count",
        "mode_indicator",
        "notification_summary",
        "capacity_meter"
      ]
    },
    "overflow_behavior": {
      "type": "string",
      "enum": [
        "priority_pinned",
        "collapse_to_overflow_menu",
        "group_into_summary",
        "drop_vanity_item",
        "promote_severe_state",
        "keyboard_reachable_overflow"
      ]
    },
    "source_freshness_label": {
      "type": "string",
      "enum": [
        "live_canonical",
        "cached_snapshot",
        "stale_invalidated",
        "provider_attributed",
        "sampled_approximate",
        "refresh_in_flight"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "source_provider",
        "freshness",
        "reopen_path"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "counter_stability": {
      "type": "string",
      "enum": [
        "counter_spinner_summary_stable_no_reflow",
        "disclosed_reduced_counter_detail",
        "status_reflows_or_flickers_on_update"
      ]
    },
    "overflow_searchability": {
      "type": "string",
      "enum": [
        "overflow_items_palette_searchable_same_labels",
        "disclosed_reduced_overflow_search_detail",
        "overflow_item_undiscoverable_or_relabeled"
      ]
    },
    "grouped_summary": {
      "type": "string",
      "enum": [
        "multi_job_grouped_into_one_summary",
        "disclosed_coarse_grouping",
        "many_flickering_primitives_instead_of_summary"
      ]
    },
    "stability_export": {
      "type": "string",
      "enum": [
        "stability_fixtures_and_export_reconstructable",
        "disclosed_partial_capture",
        "stability_state_absent_from_capture"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "vanity_item_reflow",
        "spinner_only_state",
        "hover_only_critical_truth",
        "source_freshness_hidden",
        "stale_preview_mistaken_for_live",
        "promotion_dropped_truth",
        "pointer_only_resize",
        "resize_state_not_serializable",
        "progress_lost_on_look_away",
        "grouped_progress_unattributed",
        "severe_state_displaced_truth",
        "proof_stale"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "profile", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/profile" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "trigger", "disclosed", "detail"],
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "profile_missing",
            "counters_reflow",
            "overflow_undiscoverable",
            "flickering_primitives",
            "stability_state_absent_from_capture",
            "status_reflows_around_vanity_items",
            "status_item_classes_incomplete",
            "overflow_behaviors_incomplete",
            "required_labels_incomplete",
            "narrowed_row_without_reason",
            "narrowed_row_without_waiver",
            "waiver_profile_mismatch",
            "waiver_expired",
            "row_status_stale",
            "row_causes_stale",
            "status_counts_stale",
            "coverage_stale",
            "raw_boundary_material_in_export"
          ]
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "driven_primitive_families",
        "matrix_qualification",
        "owner_role",
        "profile_label",
        "shell_zone_slot",
        "certified_status_item_classes",
        "certified_overflow_behaviors",
        "certified_source_freshness_labels",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "counter_stability",
        "overflow_searchability",
        "grouped_summary",
        "stability_export",
        "never_reflows_around_vanity_items",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "driven_primitive_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/primitive_family" }
        },
        "matrix_qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "profile_label": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "certified_status_item_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/status_item_class" }
        },
        "certified_overflow_behaviors": {
          "type": "array",
          "items": { "$ref": "#/$defs/overflow_behavior" }
        },
        "certified_source_freshness_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_freshness_label" }
        },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "counter_stability": { "$ref": "#/$defs/counter_stability" },
        "overflow_searchability": { "$ref": "#/$defs/overflow_searchability" },
        "grouped_summary": { "$ref": "#/$defs/grouped_summary" },
        "stability_export": { "$ref": "#/$defs/stability_export" },
        "never_reflows_around_vanity_items": { "type": "boolean" },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    }
  }
}
