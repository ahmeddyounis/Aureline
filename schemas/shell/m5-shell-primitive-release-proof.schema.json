{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/shell/m5-shell-primitive-release-proof.schema.json",
  "title": "Aureline M5 shell-primitive release-proof certification packet",
  "description": "Release-proof publication capstone on top of the frozen M5 shell-primitives matrix. It emits one certification row per claimed shell primitive — the status-bar item and overflow menu, the tooltip/hovercard/peek/pinned-preview transient-inspect surfaces, the splitter handle and pane-resize preset, and the ambient progress indicator and durable job row — grouped under one of four truth pillars (ambient instrumentation, transient inspect, pane control, durable progress) and certified across four release-truth axes: primitive truth, representation/freshness, interaction reach, and exported proof parity, across the standard, compact, expanded, multi-window, high-zoom, high-contrast, and reduced-motion rendering profiles. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted. The status-item-class, overflow-behavior, representation-class, promotion-state, pane-resize-state, progress-state, source-freshness, accessibility-route, required-label, shell-zone, consumer-surface, downgrade-trigger, and qualification vocabulary is pulled by reference from the frozen shell-primitives matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_accessibility_routes",
    "required_labels",
    "required_profiles",
    "required_truth_pillars",
    "rows",
    "covered_families",
    "covered_truth_pillars",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "shell_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_shell_primitive_release_proof_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_shell_primitive_release_proof:v1" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_proof_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_dimension" }
    },
    "required_accessibility_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/accessibility_route" }
    },
    "required_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/required_label" }
    },
    "required_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/release_profile" }
    },
    "required_truth_pillars": {
      "type": "array",
      "items": { "$ref": "#/$defs/truth_pillar" }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "covered_families": { "type": "array", "items": { "type": "string" } },
    "covered_truth_pillars": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } },
    "certification_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
    "blocking_findings": { "type": "array", "items": { "type": "object" } },
    "report_clean": { "type": "boolean" },
    "shell_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "status": { "enum": ["green", "yellow", "red"] },
    "truth_pillar": {
      "enum": ["ambient_instrumentation", "transient_inspect", "pane_control", "durable_progress"]
    },
    "release_profile": {
      "enum": [
        "standard",
        "compact",
        "expanded",
        "multi_window",
        "high_zoom",
        "high_contrast",
        "reduced_motion"
      ]
    },
    "proof_dimension": {
      "enum": [
        "primitive_truth",
        "representation_freshness",
        "interaction_reach",
        "exported_proof_parity"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "source_provider",
        "freshness",
        "reopen_path"
      ]
    },
    "primitive_family": {
      "enum": [
        "status_bar_item",
        "status_overflow_menu",
        "tooltip",
        "hovercard",
        "peek_panel",
        "pinned_preview_promotion",
        "splitter_handle",
        "pane_resize_preset",
        "progress_indicator",
        "durable_job_row"
      ]
    },
    "primitive_truth_state": {
      "enum": [
        "primitive_truth_certified_and_current",
        "disclosed_reduced_truth_scope",
        "primitive_truth_collapsed_or_lost"
      ]
    },
    "representation_freshness_state": {
      "enum": [
        "source_freshness_representation_preserved",
        "disclosed_partial_representation",
        "source_or_freshness_hidden_or_stale"
      ]
    },
    "interaction_reach_state": {
      "enum": [
        "keyboard_touch_reach_and_resize_certified",
        "disclosed_reduced_reach_or_resize",
        "pointer_or_hover_only_or_brittle_resize"
      ]
    },
    "exported_proof_parity_state": {
      "enum": [
        "exported_surfaces_reflect_current_proof",
        "disclosed_partial_export_refresh",
        "exported_proof_stale_or_divergent"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "primitive_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "primitive_family": { "$ref": "#/$defs/primitive_family" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_family", "trigger", "disclosed", "detail"],
      "properties": {
        "primitive_family": { "$ref": "#/$defs/primitive_family" },
        "trigger": { "type": "string" },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "primitive_family",
        "truth_pillar",
        "matrix_qualification",
        "owner_role",
        "primitive_label",
        "shell_zone_slot",
        "certified_profiles",
        "accessibility_routes",
        "required_labels",
        "primitive_truth",
        "representation_freshness",
        "interaction_reach",
        "exported_proof_parity",
        "never_hover_spinner_or_pointer_only",
        "derived_status",
        "certification_causes"
      ],
      "properties": {
        "primitive_family": { "$ref": "#/$defs/primitive_family" },
        "truth_pillar": { "$ref": "#/$defs/truth_pillar" },
        "matrix_qualification": { "type": "string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "primitive_label": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "type": "string" },
        "certified_profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/release_profile" }
        },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "primitive_truth": { "$ref": "#/$defs/primitive_truth_state" },
        "representation_freshness": { "$ref": "#/$defs/representation_freshness_state" },
        "interaction_reach": { "$ref": "#/$defs/interaction_reach_state" },
        "exported_proof_parity": { "$ref": "#/$defs/exported_proof_parity_state" },
        "never_hover_spinner_or_pointer_only": { "type": "boolean" },
        "active_waiver": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
        "narrowing_reason": {
          "anyOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
