{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspace/m5-missing-surface-placeholders.schema.json",
  "title": "Aureline M5 missing-surface placeholders",
  "description": "Schema for the m5_missing_surface_placeholders packet: one placeholder card per restored pane that could not hydrate because its extension, feature pack, remote target, or backing service is missing. Each card preserves the original pane role, the stable pane-tree slot, the last-known provenance (producer/version/build and last attach), the missing-dependency class, and the recovery actions, so a missing surface never silently deletes a pane, loses a tab, or substitutes a misleading empty state. A fail-closed gate derives the published fidelity as the weakest ceiling implied by the declared fidelity and the dependency/schema/topology/evidence-freshness conditions; because a placeholder always describes a missing dependency, the dependency ceiling caps it at a slot-preserving layout_only restore (or manual_review when the dependency root is gone), so a missing surface can never publish an exact restore. The substitution behavior must preserve the slot (placeholder_slot_preserved or reopen_as_context); silent_delete is reject-only. Every card offers a read-only open-details action and the recovery action its missing-dependency class calls for, and carries screen-reader narration that announces the role, slot, missing reason, and recovery with the slot keyboard-reachable. The fidelity, artifact-class, redaction, condition, downgrade, recovery, and missing-dependency-behavior vocabularies are reused from the serialization-and-restore matrix and the re-entry-surface vocabulary from the restore-provenance packet rather than forked. The parity surfaces (exported diagnostics, support packet, compare/export summary, companion handoff) each bind to this one packet and name the missing-surface classes and affected pane roles. The Rust types in crates/aureline-workspace/src/m5_missing_surface_placeholders are the schema of record; this file is the cross-tool export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "governs_artifact_class",
    "restore_fidelity_classes",
    "artifact_classes",
    "missing_dependency_classes",
    "pane_roles",
    "reentry_surfaces",
    "redaction_exclusions",
    "schema_conditions",
    "dependency_conditions",
    "topology_conditions",
    "evidence_freshness_states",
    "missing_dependency_behaviors",
    "downgrade_reasons",
    "recovery_paths",
    "action_kinds",
    "consumer_surfaces",
    "placeholders",
    "consumer_bindings",
    "summary"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "__fixture__": { "$ref": "#/$defs/fixture_metadata" },
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_missing_surface_placeholders" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "governs_artifact_class": { "$ref": "#/$defs/artifact_class", "const": "placeholder_card" },
    "restore_fidelity_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/restore_fidelity" }
    },
    "artifact_classes": { "type": "array", "items": { "$ref": "#/$defs/artifact_class" } },
    "missing_dependency_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/missing_dependency_class" }
    },
    "pane_roles": { "type": "array", "items": { "$ref": "#/$defs/pane_role" } },
    "reentry_surfaces": { "type": "array", "items": { "$ref": "#/$defs/reentry_surface" } },
    "redaction_exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/redaction_exclusion" }
    },
    "schema_conditions": { "type": "array", "items": { "$ref": "#/$defs/schema_condition" } },
    "dependency_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency_condition" }
    },
    "topology_conditions": { "type": "array", "items": { "$ref": "#/$defs/topology_condition" } },
    "evidence_freshness_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_freshness" }
    },
    "missing_dependency_behaviors": {
      "type": "array",
      "items": { "$ref": "#/$defs/missing_dependency_behavior" }
    },
    "downgrade_reasons": { "type": "array", "items": { "$ref": "#/$defs/downgrade_reason" } },
    "recovery_paths": { "type": "array", "items": { "$ref": "#/$defs/recovery_path" } },
    "action_kinds": { "type": "array", "items": { "$ref": "#/$defs/action_kind" } },
    "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
    "placeholders": { "type": "array", "items": { "$ref": "#/$defs/placeholder" } },
    "consumer_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "restore_fidelity": {
      "type": "string",
      "enum": ["exact_restore", "compatible_restore", "layout_only", "manual_review"]
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "workspace_authority_checkpoint",
        "window_topology_snapshot",
        "portable_state_package",
        "restore_provenance_record",
        "placeholder_card",
        "compare_export_summary"
      ]
    },
    "missing_dependency_class": {
      "type": "string",
      "enum": ["extension", "feature_pack", "remote_target", "backing_service"]
    },
    "pane_role": {
      "type": "string",
      "enum": [
        "editor",
        "terminal",
        "explorer",
        "ai_panel",
        "preview",
        "notebook",
        "query_console",
        "profiler",
        "docs",
        "incident_workspace"
      ]
    },
    "reentry_surface": {
      "type": "string",
      "enum": [
        "desktop_restore",
        "portable_state_import",
        "crash_recovery",
        "support_packet_replay",
        "companion_browser_reentry"
      ]
    },
    "redaction_exclusion": {
      "type": "string",
      "enum": [
        "excludes_secrets",
        "excludes_live_authority",
        "excludes_machine_local_anchors",
        "excludes_raw_provider_payloads"
      ]
    },
    "schema_condition": {
      "type": "string",
      "enum": ["schema_match", "schema_forward_migratable", "schema_unmigratable"]
    },
    "dependency_condition": {
      "type": "string",
      "enum": ["dependencies_present", "dependencies_partial_missing", "dependency_root_missing"]
    },
    "topology_condition": {
      "type": "string",
      "enum": ["topology_identical", "topology_adapted", "topology_incompatible"]
    },
    "evidence_freshness": {
      "type": "string",
      "enum": ["current", "aging", "expired", "missing"]
    },
    "missing_dependency_behavior": {
      "type": "string",
      "enum": ["placeholder_slot_preserved", "reopen_as_context", "silent_delete"]
    },
    "downgrade_reason": {
      "type": "string",
      "enum": ["schema_drift", "dependency_missing", "topology_changed", "evidence_stale"]
    },
    "recovery_path": {
      "type": "string",
      "enum": [
        "restore_compatibly",
        "relocate_dependency",
        "reopen_as_context",
        "refresh_evidence",
        "manual_review",
        "none"
      ]
    },
    "action_kind": {
      "type": "string",
      "enum": [
        "open_details",
        "install_dependency",
        "reconnect_remote",
        "retry_service",
        "reopen_as_context",
        "export_evidence"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "diagnostics_export",
        "support_packet",
        "compare_export_summary",
        "companion_handoff"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_ref", "producer_version", "build_ref"],
      "properties": {
        "producer_ref": { "$ref": "#/$defs/non_empty_string" },
        "producer_version": { "type": "integer", "minimum": 1 },
        "build_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "last_known_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "remembered_schema_version", "last_attached_ref"],
      "properties": {
        "producer": { "$ref": "#/$defs/producer" },
        "remembered_schema_version": { "type": "integer", "minimum": 1 },
        "last_attached_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessible_summary",
        "focus_order",
        "role_announced",
        "slot_announced",
        "missing_reason_announced",
        "recovery_announced",
        "keyboard_reachable"
      ],
      "properties": {
        "accessible_summary": { "$ref": "#/$defs/non_empty_string" },
        "focus_order": { "type": "integer", "minimum": 0 },
        "role_announced": { "const": true },
        "slot_announced": { "const": true },
        "missing_reason_announced": { "const": true },
        "recovery_announced": { "const": true },
        "keyboard_reachable": { "const": true }
      }
    },
    "affordance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "command_id",
        "keyboard_shortcut",
        "focus_order",
        "accessible_label",
        "scoped_to_slot"
      ],
      "properties": {
        "action": { "$ref": "#/$defs/action_kind" },
        "command_id": { "$ref": "#/$defs/non_empty_string" },
        "keyboard_shortcut": { "$ref": "#/$defs/non_empty_string" },
        "focus_order": { "type": "integer", "minimum": 0 },
        "accessible_label": { "$ref": "#/$defs/non_empty_string" },
        "scoped_to_slot": { "const": true }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholder_id",
        "owner",
        "reentry_surface",
        "pane_role",
        "pane_id",
        "slot_path",
        "window_ref",
        "missing_dependency_class",
        "missing_dependency_ref",
        "dependency_condition",
        "last_known_provenance",
        "redaction_class",
        "substitution_behavior",
        "declared_resulting_fidelity",
        "schema_condition",
        "topology_condition",
        "evidence_freshness",
        "published_fidelity",
        "downgrade_reasons",
        "recovery_path",
        "available_actions",
        "narration",
        "caveats",
        "narrowed_fields",
        "evidence_ref",
        "scope_snapshot_ref",
        "note"
      ],
      "properties": {
        "placeholder_id": { "$ref": "#/$defs/non_empty_string" },
        "owner": { "$ref": "#/$defs/non_empty_string" },
        "reentry_surface": { "$ref": "#/$defs/reentry_surface" },
        "pane_role": { "$ref": "#/$defs/pane_role" },
        "pane_id": { "$ref": "#/$defs/non_empty_string" },
        "slot_path": { "$ref": "#/$defs/non_empty_string" },
        "window_ref": { "$ref": "#/$defs/non_empty_string" },
        "missing_dependency_class": { "$ref": "#/$defs/missing_dependency_class" },
        "missing_dependency_ref": { "$ref": "#/$defs/non_empty_string" },
        "dependency_condition": {
          "$ref": "#/$defs/dependency_condition",
          "not": { "const": "dependencies_present" }
        },
        "last_known_provenance": { "$ref": "#/$defs/last_known_provenance" },
        "redaction_class": {
          "type": "array",
          "items": { "$ref": "#/$defs/redaction_exclusion" },
          "uniqueItems": true,
          "minItems": 4
        },
        "substitution_behavior": {
          "$ref": "#/$defs/missing_dependency_behavior",
          "not": { "const": "silent_delete" }
        },
        "declared_resulting_fidelity": { "$ref": "#/$defs/restore_fidelity" },
        "schema_condition": { "$ref": "#/$defs/schema_condition" },
        "topology_condition": { "$ref": "#/$defs/topology_condition" },
        "evidence_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "published_fidelity": {
          "$ref": "#/$defs/restore_fidelity",
          "not": { "const": "exact_restore" }
        },
        "downgrade_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_reason" },
          "uniqueItems": true,
          "minItems": 1,
          "contains": { "const": "dependency_missing" }
        },
        "recovery_path": {
          "$ref": "#/$defs/recovery_path",
          "enum": ["relocate_dependency", "manual_review"]
        },
        "available_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/affordance" },
          "minItems": 2,
          "contains": {
            "properties": { "action": { "const": "open_details" } },
            "required": ["action"]
          }
        },
        "narration": { "$ref": "#/$defs/narration" },
        "caveats": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrowed_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "binding_ref",
        "record_packet_id_ref",
        "scope_snapshot_ref",
        "ingests_record",
        "preserves_missing_class_labels",
        "preserves_pane_role_labels",
        "names_affected_counts",
        "raw_private_material_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "binding_ref": { "$ref": "#/$defs/non_empty_string" },
        "record_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingests_record": { "const": true },
        "preserves_missing_class_labels": { "const": true },
        "preserves_pane_role_labels": { "const": true },
        "names_affected_counts": { "const": true },
        "raw_private_material_excluded": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholders",
        "extension_missing",
        "feature_pack_missing",
        "remote_target_missing",
        "backing_service_missing",
        "layout_only_placeholders",
        "manual_review_placeholders",
        "slot_preserved_placeholders",
        "reopened_as_context_placeholders",
        "affected_pane_roles"
      ],
      "properties": {
        "placeholders": { "type": "integer", "minimum": 0 },
        "extension_missing": { "type": "integer", "minimum": 0 },
        "feature_pack_missing": { "type": "integer", "minimum": 0 },
        "remote_target_missing": { "type": "integer", "minimum": 0 },
        "backing_service_missing": { "type": "integer", "minimum": 0 },
        "layout_only_placeholders": { "type": "integer", "minimum": 0 },
        "manual_review_placeholders": { "type": "integer", "minimum": 0 },
        "slot_preserved_placeholders": { "type": "integer", "minimum": 0 },
        "reopened_as_context_placeholders": { "type": "integer", "minimum": 0 },
        "affected_pane_roles": { "type": "integer", "minimum": 0 }
      }
    },
    "fixture_metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "scenario"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "doc_sections": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
