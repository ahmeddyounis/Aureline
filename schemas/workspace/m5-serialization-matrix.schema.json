{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/workspace/m5-serialization-matrix.schema.json",
  "title": "Aureline M5 workspace-serialization and restore-fidelity matrix",
  "description": "Schema for the m5_serialization_and_restore_matrix packet: the single machine-readable contract for everything M5 is allowed to remember, export, compare, restore exactly, restore compatibly, or only reopen as context. The packet freezes one artifact-class row per remembered-state artifact class (workspace-authority checkpoint, window-topology snapshot, portable-state package, restore-provenance record, placeholder card, compare/export summary) and one surface row per restorable M5 surface (preview route, notebook session, query console, profiler capture, docs pane, incident workspace, companion handoff packet, portable-state artifact). Each artifact-class row binds the class to its portable/shared/local/machine-local ownership, redaction exclusions, the restore-fidelity classes it supports (exact_restore, compatible_restore, layout_only, manual_review), and the observed schema, dependency, topology, and evidence-freshness conditions. A fail-closed gate derives the published restore fidelity as the weakest ceiling those conditions imply, so a schema drift, a missing dependency, a changed topology, or stale evidence narrows the restore automatically; a missing dependency never silently deletes layout; an exportable class must exclude secrets, live authority, and machine-local anchors; and a machine-local class is never exportable. Every continuity surface (crash recovery, browser/companion handoff, import/export, claim publication) is cross-linked to this matrix so restore language stays canonical, and every required reviewer surface (shiproom, docs/help, support export) binds to this one packet and narrows with it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "artifact_classes",
    "restore_fidelity_classes",
    "ownership_classes",
    "redaction_exclusions",
    "schema_conditions",
    "dependency_conditions",
    "topology_conditions",
    "evidence_freshness_states",
    "missing_dependency_behaviors",
    "downgrade_reasons",
    "recovery_paths",
    "continuity_surfaces",
    "restorable_surfaces",
    "consumer_surfaces",
    "rows",
    "surface_rows",
    "continuity_crosslinks",
    "consumer_bindings",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_serialization_and_restore_matrix" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "artifact_classes": { "type": "array", "items": { "$ref": "#/$defs/artifact_class" } },
    "restore_fidelity_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/restore_fidelity" }
    },
    "ownership_classes": { "type": "array", "items": { "$ref": "#/$defs/ownership" } },
    "redaction_exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/redaction_exclusion" }
    },
    "schema_conditions": { "type": "array", "items": { "$ref": "#/$defs/schema_condition" } },
    "dependency_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency_condition" }
    },
    "topology_conditions": { "type": "array", "items": { "$ref": "#/$defs/topology_condition" } },
    "evidence_freshness_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_freshness" }
    },
    "missing_dependency_behaviors": {
      "type": "array",
      "items": { "$ref": "#/$defs/missing_dependency_behavior" }
    },
    "downgrade_reasons": { "type": "array", "items": { "$ref": "#/$defs/downgrade_reason" } },
    "recovery_paths": { "type": "array", "items": { "$ref": "#/$defs/recovery_path" } },
    "continuity_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/continuity_surface" }
    },
    "restorable_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/restorable_surface" }
    },
    "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/artifact_class_row" } },
    "surface_rows": { "type": "array", "items": { "$ref": "#/$defs/surface_row" } },
    "continuity_crosslinks": {
      "type": "array",
      "items": { "$ref": "#/$defs/continuity_crosslink" }
    },
    "consumer_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "artifact_class": {
      "type": "string",
      "enum": [
        "workspace_authority_checkpoint",
        "window_topology_snapshot",
        "portable_state_package",
        "restore_provenance_record",
        "placeholder_card",
        "compare_export_summary"
      ]
    },
    "restore_fidelity": {
      "type": "string",
      "enum": ["exact_restore", "compatible_restore", "layout_only", "manual_review"]
    },
    "ownership": {
      "type": "string",
      "enum": ["portable", "shared", "local", "machine_local"]
    },
    "redaction_exclusion": {
      "type": "string",
      "enum": [
        "excludes_secrets",
        "excludes_live_authority",
        "excludes_machine_local_anchors",
        "excludes_raw_provider_payloads"
      ]
    },
    "schema_condition": {
      "type": "string",
      "enum": ["schema_match", "schema_forward_migratable", "schema_unmigratable"]
    },
    "dependency_condition": {
      "type": "string",
      "enum": [
        "dependencies_present",
        "dependencies_partial_missing",
        "dependency_root_missing"
      ]
    },
    "topology_condition": {
      "type": "string",
      "enum": ["topology_identical", "topology_adapted", "topology_incompatible"]
    },
    "evidence_freshness": {
      "type": "string",
      "enum": ["current", "aging", "expired", "missing"]
    },
    "missing_dependency_behavior": {
      "type": "string",
      "enum": ["placeholder_slot_preserved", "reopen_as_context", "silent_delete"]
    },
    "downgrade_reason": {
      "type": "string",
      "enum": ["schema_drift", "dependency_missing", "topology_changed", "evidence_stale"]
    },
    "recovery_path": {
      "type": "string",
      "enum": [
        "restore_compatibly",
        "relocate_dependency",
        "reopen_as_context",
        "refresh_evidence",
        "manual_review",
        "none"
      ]
    },
    "continuity_surface": {
      "type": "string",
      "enum": [
        "crash_recovery",
        "browser_companion_handoff",
        "import_export",
        "claim_publication"
      ]
    },
    "restorable_surface": {
      "type": "string",
      "enum": [
        "preview_route",
        "notebook_session",
        "query_console",
        "profiler_capture",
        "docs_pane",
        "incident_workspace",
        "companion_handoff_packet",
        "portable_state_artifact"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": ["shiproom", "docs_help", "support_export"]
    },
    "artifact_class_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "artifact_class",
        "owner",
        "persisted_scope",
        "ownership",
        "exportable",
        "redaction_exclusions",
        "supported_fidelity_classes",
        "declared_max_fidelity",
        "schema_condition",
        "dependency_condition",
        "topology_condition",
        "evidence_freshness",
        "missing_dependency_behavior",
        "published_fidelity",
        "downgrade_reasons",
        "recovery_path",
        "continuity_surfaces",
        "caveats",
        "stale_or_missing_fields",
        "schema_ref",
        "evidence_ref",
        "scope_snapshot_ref",
        "note"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "owner": { "$ref": "#/$defs/non_empty_string" },
        "persisted_scope": { "$ref": "#/$defs/non_empty_string" },
        "ownership": { "$ref": "#/$defs/ownership" },
        "exportable": { "type": "boolean" },
        "redaction_exclusions": {
          "type": "array",
          "items": { "$ref": "#/$defs/redaction_exclusion" },
          "uniqueItems": true,
          "minItems": 3
        },
        "supported_fidelity_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/restore_fidelity" },
          "uniqueItems": true,
          "minItems": 1
        },
        "declared_max_fidelity": { "$ref": "#/$defs/restore_fidelity" },
        "schema_condition": { "$ref": "#/$defs/schema_condition" },
        "dependency_condition": { "$ref": "#/$defs/dependency_condition" },
        "topology_condition": { "$ref": "#/$defs/topology_condition" },
        "evidence_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "missing_dependency_behavior": {
          "$ref": "#/$defs/missing_dependency_behavior",
          "not": { "const": "silent_delete" }
        },
        "published_fidelity": { "$ref": "#/$defs/restore_fidelity" },
        "downgrade_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_reason" },
          "uniqueItems": true
        },
        "recovery_path": { "$ref": "#/$defs/recovery_path" },
        "continuity_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/continuity_surface" },
          "uniqueItems": true,
          "minItems": 1
        },
        "caveats": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "stale_or_missing_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      },
      "allOf": [
        {
          "$comment": "An exact-restore row is clean: pristine conditions, no downgrade reason, recovery none.",
          "if": {
            "properties": { "published_fidelity": { "const": "exact_restore" } },
            "required": ["published_fidelity"]
          },
          "then": {
            "properties": {
              "schema_condition": { "const": "schema_match" },
              "dependency_condition": { "const": "dependencies_present" },
              "topology_condition": { "const": "topology_identical" },
              "evidence_freshness": { "const": "current" },
              "downgrade_reasons": { "maxItems": 0 },
              "caveats": { "maxItems": 0 },
              "stale_or_missing_fields": { "maxItems": 0 },
              "recovery_path": { "const": "none" }
            }
          }
        },
        {
          "$comment": "An exportable row excludes machine-local anchors and is never machine-local.",
          "if": {
            "properties": { "exportable": { "const": true } },
            "required": ["exportable"]
          },
          "then": {
            "properties": {
              "ownership": { "enum": ["portable", "shared"] },
              "redaction_exclusions": { "minItems": 4 }
            }
          }
        }
      ]
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface",
        "owner",
        "persisted_artifact_classes",
        "max_supported_fidelity",
        "portability",
        "continuity_surfaces",
        "note"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "surface": { "$ref": "#/$defs/restorable_surface" },
        "owner": { "$ref": "#/$defs/non_empty_string" },
        "persisted_artifact_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_class" },
          "uniqueItems": true,
          "minItems": 1
        },
        "max_supported_fidelity": { "$ref": "#/$defs/restore_fidelity" },
        "portability": { "$ref": "#/$defs/ownership" },
        "continuity_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/continuity_surface" },
          "uniqueItems": true,
          "minItems": 1
        },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "continuity_crosslink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuity_surface",
        "crosslink_ref",
        "canonical_packet_ref",
        "reuses_matrix_vocabulary"
      ],
      "properties": {
        "continuity_surface": { "$ref": "#/$defs/continuity_surface" },
        "crosslink_ref": { "$ref": "#/$defs/non_empty_string" },
        "canonical_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "reuses_matrix_vocabulary": { "const": true }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "binding_ref",
        "matrix_packet_id_ref",
        "scope_snapshot_ref",
        "ingests_matrix",
        "preserves_fidelity_labels",
        "preserves_ownership_labels",
        "narrows_on_downgrade",
        "raw_private_material_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "binding_ref": { "$ref": "#/$defs/non_empty_string" },
        "matrix_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingests_matrix": { "const": true },
        "preserves_fidelity_labels": { "const": true },
        "preserves_ownership_labels": { "const": true },
        "narrows_on_downgrade": { "const": true },
        "raw_private_material_excluded": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class_rows",
        "surface_rows",
        "exact_restore_rows",
        "compatible_restore_rows",
        "layout_only_rows",
        "manual_review_rows",
        "downgraded_rows",
        "exportable_rows",
        "stale_evidence_rows"
      ],
      "properties": {
        "artifact_class_rows": { "type": "integer", "minimum": 0 },
        "surface_rows": { "type": "integer", "minimum": 0 },
        "exact_restore_rows": { "type": "integer", "minimum": 0 },
        "compatible_restore_rows": { "type": "integer", "minimum": 0 },
        "layout_only_rows": { "type": "integer", "minimum": 0 },
        "manual_review_rows": { "type": "integer", "minimum": 0 },
        "downgraded_rows": { "type": "integer", "minimum": 0 },
        "exportable_rows": { "type": "integer", "minimum": 0 },
        "stale_evidence_rows": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
