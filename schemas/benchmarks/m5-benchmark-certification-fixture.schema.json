{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/benchmarks/m5-benchmark-certification-fixture.schema.json",
  "title": "M5 benchmark-certification fixture record",
  "description": "Self-contained certification-recompute fixture. It carries one certification row under test, the minimal upstream snapshot the recompute reads (freshness entries, corpus-intake decisions, governance metrics, threshold-change records, reproducibility packs, and publication surfaces), an evaluation date, and the expected fired gaps, narrowed claim, certification state, and promotion blocker the engine must reproduce. Each fixture proves one fail-closed certification path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "description",
    "as_of",
    "row",
    "upstream",
    "expected_fired_gaps",
    "expected_effective_claim",
    "expected_certification_state"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "fixture_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "row": {
      "type": "object",
      "required": [
        "row_id",
        "posture",
        "metric_refs",
        "corpus_refs",
        "governance_pack_ref",
        "freshness_entry_ref",
        "published_claim_ceiling",
        "required_repro_disclosure_fields"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "posture": { "$ref": "#/$defs/claimLevel" },
        "metric_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "corpus_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "governance_pack_ref": { "type": "string", "minLength": 1 },
        "freshness_entry_ref": { "type": "string", "minLength": 1 },
        "published_claim_ceiling": { "$ref": "#/$defs/claimLevel" },
        "required_repro_disclosure_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freshness_entries": { "type": "object" },
        "corpus_intake": { "type": "object" },
        "governance_metrics": { "type": "object" },
        "threshold_changes": { "type": "object" },
        "repro_packs": { "type": "object" },
        "publication_surfaces": { "type": "object" }
      }
    },
    "expected_fired_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "expected_effective_claim": { "$ref": "#/$defs/claimLevel" },
    "expected_certification_state": {
      "enum": ["certified", "narrowed", "quarantined"]
    },
    "expected_blocks_promotion": { "type": "boolean" }
  },
  "$defs": {
    "claimLevel": {
      "enum": [
        "quarantined_not_comparable",
        "internal_gate_only",
        "methodology_only",
        "aureline_only_claim",
        "public_head_to_head_comparison"
      ]
    },
    "gap": {
      "enum": [
        "uncertified_corpus_intake",
        "missing_hardware_basis",
        "missing_threshold_lineage",
        "expired_threshold_waiver",
        "missing_reproducibility_pack",
        "incomplete_reproducibility_pack",
        "stale_reproducibility_pack",
        "stale_freshness_evidence",
        "incomparable_freshness_evidence",
        "missing_publication_propagation"
      ]
    }
  }
}
