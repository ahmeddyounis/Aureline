{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/benchmarks/protected-metric.schema.json",
  "title": "Aureline benchmark protected-metric object",
  "description": "Boundary schema for a single protected-metric object. A protected metric is a claim-bearing benchmark identity bound to its evidence: its stable id and product name, the corpus-manifest ids it measures, the reference-hardware profile and lab-image revision it ran on, the governed threshold id and state, its owner, its waiver path, its freshness rule, the strongest claim it is allowed to publish, the narrowing reasons currently active, and the resulting effective claim. A metric with no corpus binding, no hardware identity, or no lab-image identity fails closed and cannot make a comparable claim. A claim-bearing metric may not cite a self_capture hardware or lab-image identity. Raw run logs, raw machine labels, and raw provider payloads never cross this boundary; only stable ids and reviewable sentences do.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "metric_ref",
    "metric_name",
    "corpus_refs",
    "hardware_profile_ref",
    "lab_image_ref",
    "threshold_ref",
    "threshold_state",
    "owner_ref",
    "waiver",
    "freshness",
    "published_claim_ceiling",
    "active_narrowing_reasons",
    "effective_claim"
  ],
  "properties": {
    "record_kind": { "const": "benchmark_protected_metric" },
    "schema_version": { "const": 1 },
    "metric_ref": { "$ref": "#/$defs/stable_id" },
    "metric_name": { "$ref": "#/$defs/non_empty_string" },
    "corpus_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stable_id" },
      "description": "Corpus-manifest ids this metric measures. At least one is required; an empty set fails closed."
    },
    "hardware_profile_ref": {
      "$ref": "#/$defs/stable_id",
      "description": "Reference-hardware profile this metric ran on; a missing identity fires missing_hardware_identity."
    },
    "lab_image_ref": {
      "$ref": "#/$defs/stable_id",
      "description": "Lab-image revision this metric ran on; a missing identity fires missing_lab_image_identity."
    },
    "threshold_ref": { "$ref": "#/$defs/non_empty_string" },
    "threshold_state": { "$ref": "#/$defs/threshold_state" },
    "owner_ref": { "$ref": "#/$defs/non_empty_string" },
    "waiver": { "$ref": "#/$defs/waiver_binding" },
    "freshness": { "$ref": "#/$defs/freshness_block" },
    "published_claim_ceiling": { "$ref": "#/$defs/claim_level" },
    "active_narrowing_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/narrowing_reason" }
    },
    "effective_claim": { "$ref": "#/$defs/claim_level" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "stable_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_.]*$" },
    "reviewable_sentence": { "type": "string", "minLength": 1 },
    "utc_date": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      ]
    },
    "claim_level": {
      "type": "string",
      "enum": [
        "internal_gate_only",
        "methodology_only",
        "aureline_only_claim",
        "public_head_to_head_comparison",
        "quarantined_not_comparable"
      ]
    },
    "threshold_state": {
      "type": "string",
      "enum": [
        "frozen_calibrated",
        "tightened",
        "eased_with_evidence",
        "provisional_uncalibrated",
        "drifted_unreviewed",
        "stale_recalibration_pending"
      ]
    },
    "waiver_class": {
      "type": "string",
      "enum": [
        "none",
        "performance_council_time_boxed",
        "architecture_council_protected_path",
        "release_council_launch_scope",
        "shiproom_executive_scope"
      ]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "stale_corpus_revision",
        "missing_hardware_identity",
        "missing_lab_image_identity",
        "threshold_drift",
        "incomparable_run_metadata",
        "expired_waiver",
        "stale_freshness",
        "undisclosed_publication_field"
      ]
    },
    "waiver_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "waiver_ref", "expires_on"],
      "properties": {
        "class": { "$ref": "#/$defs/waiver_class" },
        "waiver_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/non_empty_string" }
          ]
        },
        "expires_on": { "$ref": "#/$defs/utc_date" }
      }
    },
    "freshness_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "evidence_captured_on", "freshness_slo_days", "expires_on"],
      "properties": {
        "rule": { "$ref": "#/$defs/reviewable_sentence" },
        "evidence_captured_on": { "$ref": "#/$defs/utc_date" },
        "freshness_slo_days": { "type": "integer", "minimum": 1 },
        "expires_on": { "$ref": "#/$defs/utc_date" }
      }
    }
  }
}
