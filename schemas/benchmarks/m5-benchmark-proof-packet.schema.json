{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/benchmarks/m5-benchmark-proof-packet.schema.json",
  "title": "M5 benchmark-certification proof packet",
  "description": "Boundary schema for the canonical M5 benchmark-certification proof packet. The packet binds every claimed M5 performance, compatibility, and qualification row to its corpus-intake decision, reference-hardware basis, threshold lineage, reproducibility pack, freshness and comparability state, and publication propagation, recomputes a certification state and narrowed effective claim from those bindings, and projects the promotion verdict release, support, docs, and help consume so a claimed row cannot outrun its current benchmark evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "as_of",
    "title",
    "summary",
    "governance_matrix_ref",
    "freshness_ledger_ref",
    "public_comparison_register_ref",
    "threshold_change_ledger_ref",
    "corpus_intake_ledger_ref",
    "publication_ingestion_register_ref",
    "evidence_index_ref",
    "source_refs",
    "claim_levels",
    "claim_classes",
    "evidence_pillars",
    "certification_gaps",
    "certification_states",
    "required_publication_surfaces",
    "rows",
    "promotion_gate",
    "consumer_bindings",
    "inspection"
  ],
  "properties": {
    "record_kind": { "const": "benchmark_m5_certification_proof_packet" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "governance_matrix_ref": { "type": "string", "minLength": 1 },
    "freshness_ledger_ref": { "type": "string", "minLength": 1 },
    "public_comparison_register_ref": { "type": "string", "minLength": 1 },
    "threshold_change_ledger_ref": { "type": "string", "minLength": 1 },
    "corpus_intake_ledger_ref": { "type": "string", "minLength": 1 },
    "publication_ingestion_register_ref": { "type": "string", "minLength": 1 },
    "evidence_index_ref": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "claim_levels": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "rank", "claim_bearing"],
        "properties": {
          "level": { "$ref": "#/$defs/claimLevel" },
          "rank": { "type": "integer", "minimum": 0 },
          "claim_bearing": { "type": "boolean" }
        }
      }
    },
    "claim_classes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_class", "description", "claim_bearing_capable"],
        "properties": {
          "claim_class": { "$ref": "#/$defs/claimClass" },
          "description": { "type": "string", "minLength": 1 },
          "claim_bearing_capable": { "type": "boolean" }
        }
      }
    },
    "evidence_pillars": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pillar", "proves", "current_source_ref"],
        "properties": {
          "pillar": { "$ref": "#/$defs/pillar" },
          "proves": { "type": "string", "minLength": 1 },
          "current_source_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "certification_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap", "pillar", "detects", "narrows_to", "auto_detectable", "stop_rule"],
        "properties": {
          "gap": { "$ref": "#/$defs/gap" },
          "pillar": { "$ref": "#/$defs/pillar" },
          "detects": { "type": "string", "minLength": 1 },
          "narrows_to": { "$ref": "#/$defs/claimLevel" },
          "auto_detectable": { "const": true },
          "stop_rule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "certification_states": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "is_certified", "blocks_when_claim_bearing", "description"],
        "properties": {
          "state": { "$ref": "#/$defs/certificationState" },
          "is_certified": { "type": "boolean" },
          "blocks_when_claim_bearing": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_publication_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certificationRow" }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "blocking_row_ids", "blocking_gaps", "rationale"],
      "properties": {
        "decision": { "enum": ["proceed", "hold"] },
        "blocking_row_ids": { "type": "array", "items": { "type": "string" } },
        "blocking_gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer", "source_projection", "ingests"],
        "properties": {
          "consumer": { "type": "string", "minLength": 1 },
          "source_projection": { "type": "string", "minLength": 1 },
          "ingests": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["how_to_recompute", "promotion_gate", "evidence_index_ref"],
      "properties": {
        "how_to_recompute": { "type": "string", "minLength": 1 },
        "promotion_gate": { "type": "string", "minLength": 1 },
        "claim_class_coverage": { "type": "string", "minLength": 1 },
        "evidence_index_ref": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "claimLevel": {
      "enum": [
        "quarantined_not_comparable",
        "internal_gate_only",
        "methodology_only",
        "aureline_only_claim",
        "public_head_to_head_comparison"
      ]
    },
    "claimClass": { "enum": ["performance", "compatibility", "qualification"] },
    "pillar": {
      "enum": [
        "corpus_identity",
        "hardware_basis",
        "threshold_lineage",
        "reproducibility_pack",
        "freshness_comparability",
        "publication_propagation"
      ]
    },
    "gap": {
      "enum": [
        "uncertified_corpus_intake",
        "missing_hardware_basis",
        "missing_threshold_lineage",
        "expired_threshold_waiver",
        "missing_reproducibility_pack",
        "incomplete_reproducibility_pack",
        "stale_reproducibility_pack",
        "stale_freshness_evidence",
        "incomparable_freshness_evidence",
        "missing_publication_propagation"
      ]
    },
    "certificationState": { "enum": ["certified", "narrowed", "quarantined"] },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certification_status", "gap", "bound_refs"],
      "properties": {
        "certification_status": { "enum": ["certified", "gap"] },
        "gap": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/gap" }]
        },
        "bound_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "detail": { "type": "string" }
      }
    },
    "certificationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "subject_kind",
        "claim_class",
        "title",
        "claim_publication_entry_ref",
        "posture",
        "metric_refs",
        "corpus_refs",
        "governance_pack_ref",
        "repro_pack_ref",
        "freshness_entry_ref",
        "threshold_change_refs",
        "corpus_intake_refs",
        "required_repro_disclosure_fields",
        "aligned_claim_object_refs",
        "published_claim_ceiling",
        "freshness_input",
        "evidence_bindings",
        "fired_certification_gaps",
        "effective_claim",
        "certification_state",
        "promotion_blocker",
        "release_packet"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "subject_kind": { "const": "m5_benchmark_certification_row" },
        "claim_class": { "$ref": "#/$defs/claimClass" },
        "title": { "type": "string", "minLength": 1 },
        "claim_publication_entry_ref": { "type": "string", "minLength": 1 },
        "posture": { "$ref": "#/$defs/claimLevel" },
        "metric_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "corpus_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "governance_pack_ref": { "type": "string", "minLength": 1 },
        "repro_pack_ref": { "type": "string", "minLength": 1 },
        "freshness_entry_ref": { "type": "string", "minLength": 1 },
        "threshold_change_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "corpus_intake_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_repro_disclosure_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "aligned_claim_object_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "published_claim_ceiling": { "$ref": "#/$defs/claimLevel" },
        "freshness_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effective_claim", "freshness_state"],
          "properties": {
            "effective_claim": { "$ref": "#/$defs/claimLevel" },
            "freshness_state": {
              "enum": ["current", "aging", "stale", "incomparable", "missing"]
            }
          }
        },
        "evidence_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corpus_identity",
            "hardware_basis",
            "threshold_lineage",
            "reproducibility_pack",
            "freshness_comparability",
            "publication_propagation"
          ],
          "properties": {
            "corpus_identity": { "$ref": "#/$defs/evidenceBinding" },
            "hardware_basis": { "$ref": "#/$defs/evidenceBinding" },
            "threshold_lineage": { "$ref": "#/$defs/evidenceBinding" },
            "reproducibility_pack": { "$ref": "#/$defs/evidenceBinding" },
            "freshness_comparability": { "$ref": "#/$defs/evidenceBinding" },
            "publication_propagation": { "$ref": "#/$defs/evidenceBinding" }
          }
        },
        "fired_certification_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap" }
        },
        "effective_claim": { "$ref": "#/$defs/claimLevel" },
        "certification_state": { "$ref": "#/$defs/certificationState" },
        "promotion_blocker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocks_promotion", "blocker_gaps", "certification_label"],
          "properties": {
            "blocks_promotion": { "type": "boolean" },
            "blocker_gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
            "certification_label": { "type": "string", "minLength": 1 }
          }
        },
        "release_packet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_packet_ref",
            "declared_certification_state",
            "declared_effective_claim"
          ],
          "properties": {
            "release_packet_ref": { "type": "string", "minLength": 1 },
            "declared_certification_state": { "$ref": "#/$defs/certificationState" },
            "declared_effective_claim": { "$ref": "#/$defs/claimLevel" }
          }
        }
      }
    }
  }
}
