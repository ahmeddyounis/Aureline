{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/benchmarks/m5-benchmark-governance.schema.json",
  "title": "Aureline M5 benchmark-governance matrix",
  "description": "Boundary schema for the frozen M5 benchmark-corpus, protected-metric, reference-hardware, lab-image, threshold, waiver, and public-benchmark publication matrix. The matrix binds every protected metric to one named corpus-manifest revision, one reference-hardware profile, one lab-image revision, one governed threshold state, one owner, one waiver path, and one freshness rule, and it freezes the closed narrowing vocabulary that drops a benchmark claim when its corpus revision is stale, its hardware or lab-image identity is missing, its threshold has drifted, its run metadata is incomparable, its waiver has expired, its evidence is stale, or a publication pack omits a required disclosure field. The companion fixture record proves each narrowing path is mechanically detectable. Raw run logs, raw provider payloads, raw customer or repository names, raw machine labels, secret material, and screenshots never cross this boundary; only stable governance ids and reviewable sentences do.",
  "oneOf": [
    { "$ref": "#/$defs/benchmark_governance_matrix" },
    { "$ref": "#/$defs/benchmark_governance_fixture_record" }
  ],
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "reviewable_sentence": {
      "type": "string",
      "minLength": 1,
      "description": "Short product-term sentence safe for product copy, docs, support export, and release evidence. Raw run logs, raw provider payloads, raw customer or repository names, raw machine labels, and secret material MUST NOT appear."
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "utc_date": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      ]
    },
    "utc_date_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "claim_level": {
      "type": "string",
      "enum": [
        "internal_gate_only",
        "methodology_only",
        "aureline_only_claim",
        "public_head_to_head_comparison",
        "quarantined_not_comparable"
      ],
      "description": "Ordered benchmark-claim strength. internal_gate_only is the weakest claim-bearing level; public_head_to_head_comparison is the strongest; quarantined_not_comparable is the terminal narrowed state that carries no performance conclusion."
    },
    "corpus_class": {
      "type": "string",
      "enum": [
        "microbenchmark_scenario",
        "workflow_scenario",
        "remote_collaboration_scenario",
        "accessibility_scenario"
      ]
    },
    "hardware_class": {
      "type": "string",
      "enum": ["reference_lab", "self_capture"]
    },
    "threshold_state": {
      "type": "string",
      "enum": [
        "frozen_calibrated",
        "tightened",
        "eased_with_evidence",
        "provisional_uncalibrated",
        "drifted_unreviewed",
        "stale_recalibration_pending"
      ]
    },
    "waiver_class": {
      "type": "string",
      "enum": [
        "none",
        "performance_council_time_boxed",
        "architecture_council_protected_path",
        "release_council_launch_scope",
        "shiproom_executive_scope"
      ]
    },
    "publication_posture": {
      "type": "string",
      "enum": [
        "methodology_only",
        "aureline_only_claim",
        "public_head_to_head_comparison",
        "quarantined_not_comparable"
      ]
    },
    "narrowing_reason": {
      "type": "string",
      "enum": [
        "stale_corpus_revision",
        "missing_hardware_identity",
        "missing_lab_image_identity",
        "threshold_drift",
        "incomparable_run_metadata",
        "expired_waiver",
        "stale_freshness",
        "undisclosed_publication_field"
      ]
    },
    "narrowing_reason_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/narrowing_reason" }
    },
    "claim_level_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rank", "claim_bearing", "description"],
      "properties": {
        "level": { "$ref": "#/$defs/claim_level" },
        "rank": { "type": "integer", "minimum": 0 },
        "claim_bearing": { "type": "boolean" },
        "description": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "threshold_state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "claim_bearing_allowed", "fires_threshold_drift", "requires", "description"],
      "properties": {
        "state": { "$ref": "#/$defs/threshold_state" },
        "claim_bearing_allowed": { "type": "boolean" },
        "fires_threshold_drift": { "type": "boolean" },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "description": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "waiver_class_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "authority", "expiry_required", "claim_impact_when_active", "claim_impact_when_expired", "description"],
      "properties": {
        "class": { "$ref": "#/$defs/waiver_class" },
        "authority": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "expiry_required": { "type": "boolean" },
        "claim_impact_when_active": { "$ref": "#/$defs/reviewable_sentence" },
        "claim_impact_when_expired": { "$ref": "#/$defs/reviewable_sentence" },
        "description": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "narrowing_rule_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "detects", "narrows_to", "auto_detectable", "stop_rule"],
      "properties": {
        "reason": { "$ref": "#/$defs/narrowing_reason" },
        "detects": { "$ref": "#/$defs/reviewable_sentence" },
        "narrows_to": { "$ref": "#/$defs/claim_level" },
        "auto_detectable": { "type": "boolean", "const": true },
        "stop_rule": { "$ref": "#/$defs/reviewable_sentence" }
      }
    },
    "corpus_manifest_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_ref",
        "corpus_class",
        "bound_revision",
        "license_status",
        "redaction_status",
        "retention_class",
        "access_control_class",
        "external_review_required",
        "freshness_rule",
        "manifest_source_ref"
      ],
      "properties": {
        "corpus_ref": { "$ref": "#/$defs/non_empty_string" },
        "corpus_class": { "$ref": "#/$defs/corpus_class" },
        "bound_revision": { "type": "integer", "minimum": 1 },
        "license_status": { "$ref": "#/$defs/non_empty_string" },
        "redaction_status": { "$ref": "#/$defs/non_empty_string" },
        "retention_class": { "$ref": "#/$defs/non_empty_string" },
        "access_control_class": { "$ref": "#/$defs/non_empty_string" },
        "external_review_required": { "type": "boolean" },
        "freshness_rule": { "$ref": "#/$defs/reviewable_sentence" },
        "manifest_source_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "hardware_profile_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_profile_ref",
        "hardware_class",
        "display_class_ref",
        "default_power_posture",
        "manifest_source_ref"
      ],
      "properties": {
        "hardware_profile_ref": { "$ref": "#/$defs/non_empty_string" },
        "hardware_class": { "$ref": "#/$defs/hardware_class" },
        "display_class_ref": { "$ref": "#/$defs/non_empty_string" },
        "default_power_posture": { "$ref": "#/$defs/non_empty_string" },
        "manifest_source_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "lab_image_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lab_image_ref",
        "bound_revision",
        "environment_ref",
        "calibration_rule_set_ref",
        "comparability_reset_rule",
        "manifest_source_ref"
      ],
      "properties": {
        "lab_image_ref": { "$ref": "#/$defs/non_empty_string" },
        "bound_revision": { "type": "integer", "minimum": 1 },
        "environment_ref": { "$ref": "#/$defs/non_empty_string" },
        "calibration_rule_set_ref": { "$ref": "#/$defs/non_empty_string" },
        "comparability_reset_rule": { "$ref": "#/$defs/reviewable_sentence" },
        "manifest_source_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "evidence_captured_on", "freshness_slo_days", "expires_on"],
      "properties": {
        "rule": { "$ref": "#/$defs/reviewable_sentence" },
        "evidence_captured_on": { "$ref": "#/$defs/utc_date" },
        "freshness_slo_days": { "type": "integer", "minimum": 1 },
        "expires_on": { "$ref": "#/$defs/utc_date" }
      }
    },
    "waiver_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "waiver_ref", "expires_on"],
      "properties": {
        "class": { "$ref": "#/$defs/waiver_class" },
        "waiver_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/non_empty_string" }
          ]
        },
        "expires_on": { "$ref": "#/$defs/utc_date" }
      }
    },
    "protected_metric_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_ref",
        "metric_name",
        "corpus_refs",
        "hardware_profile_ref",
        "lab_image_ref",
        "threshold_ref",
        "threshold_state",
        "owner_ref",
        "waiver",
        "freshness",
        "published_claim_ceiling",
        "active_narrowing_reasons",
        "effective_claim"
      ],
      "properties": {
        "metric_ref": { "$ref": "#/$defs/non_empty_string" },
        "metric_name": { "$ref": "#/$defs/non_empty_string" },
        "corpus_refs": { "$ref": "#/$defs/ref_array" },
        "hardware_profile_ref": { "$ref": "#/$defs/non_empty_string" },
        "lab_image_ref": { "$ref": "#/$defs/non_empty_string" },
        "threshold_ref": { "$ref": "#/$defs/non_empty_string" },
        "threshold_state": { "$ref": "#/$defs/threshold_state" },
        "owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "waiver": { "$ref": "#/$defs/waiver_binding" },
        "freshness": { "$ref": "#/$defs/freshness_block" },
        "published_claim_ceiling": { "$ref": "#/$defs/claim_level" },
        "active_narrowing_reasons": { "$ref": "#/$defs/narrowing_reason_array" },
        "effective_claim": { "$ref": "#/$defs/claim_level" }
      }
    },
    "publication_pack_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_ref",
        "posture",
        "metric_refs",
        "hardware_profile_ref",
        "lab_image_ref",
        "required_disclosure_fields",
        "disclosed_fields",
        "raw_run_metadata_retained",
        "freshness",
        "published_claim_ceiling",
        "active_narrowing_reasons",
        "effective_claim"
      ],
      "properties": {
        "pack_ref": { "$ref": "#/$defs/non_empty_string" },
        "posture": { "$ref": "#/$defs/publication_posture" },
        "metric_refs": { "$ref": "#/$defs/ref_array" },
        "hardware_profile_ref": { "$ref": "#/$defs/non_empty_string" },
        "lab_image_ref": { "$ref": "#/$defs/non_empty_string" },
        "required_disclosure_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "disclosed_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "raw_run_metadata_retained": { "type": "boolean" },
        "freshness": { "$ref": "#/$defs/freshness_block" },
        "published_claim_ceiling": { "$ref": "#/$defs/claim_level" },
        "active_narrowing_reasons": { "$ref": "#/$defs/narrowing_reason_array" },
        "effective_claim": { "$ref": "#/$defs/claim_level" }
      }
    },
    "consumer_binding_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "source_projection", "ingests"],
      "properties": {
        "consumer": { "$ref": "#/$defs/non_empty_string" },
        "source_projection": { "$ref": "#/$defs/non_empty_string" },
        "ingests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewable_sentence" }
        }
      }
    },
    "inspection_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["how_to_recompute", "promotion_gate", "evidence_index_ref"],
      "properties": {
        "how_to_recompute": { "$ref": "#/$defs/reviewable_sentence" },
        "promotion_gate": { "$ref": "#/$defs/reviewable_sentence" },
        "evidence_index_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "benchmark_governance_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "matrix_id",
        "generated_at",
        "matrix_revision",
        "title",
        "summary",
        "source_refs",
        "evidence_index_ref",
        "claim_levels",
        "threshold_states",
        "waiver_classes",
        "narrowing_rules",
        "corpus_manifests",
        "hardware_profiles",
        "lab_images",
        "protected_metrics",
        "publication_packs",
        "consumer_bindings",
        "inspection"
      ],
      "properties": {
        "record_kind": { "const": "m5_benchmark_governance_matrix" },
        "schema_version": { "const": 1 },
        "matrix_id": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/utc_date_time" },
        "matrix_revision": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/reviewable_sentence" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "description": "Schema and governance refs. MUST include schemas/benchmarks/m5-benchmark-governance.schema.json."
        },
        "evidence_index_ref": { "$ref": "#/$defs/non_empty_string" },
        "claim_levels": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim_level_row" }
        },
        "threshold_states": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/threshold_state_row" }
        },
        "waiver_classes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/waiver_class_row" }
        },
        "narrowing_rules": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/narrowing_rule_row" }
        },
        "corpus_manifests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/corpus_manifest_row" }
        },
        "hardware_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hardware_profile_row" }
        },
        "lab_images": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lab_image_row" }
        },
        "protected_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/protected_metric_row" }
        },
        "publication_packs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/publication_pack_row" }
        },
        "consumer_bindings": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/consumer_binding_row" }
        },
        "inspection": { "$ref": "#/$defs/inspection_block" }
      }
    },
    "benchmark_governance_fixture_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "scenario",
        "subject_kind",
        "subject_ref",
        "published_claim_ceiling",
        "input_defect",
        "fired_narrowing_reasons",
        "expected_effective_claim",
        "auto_detectable",
        "notes"
      ],
      "properties": {
        "record_kind": { "const": "m5_benchmark_governance_fixture_record" },
        "schema_version": { "const": 1 },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/reviewable_sentence" },
        "subject_kind": {
          "type": "string",
          "enum": ["protected_metric", "publication_pack"]
        },
        "subject_ref": { "$ref": "#/$defs/non_empty_string" },
        "published_claim_ceiling": { "$ref": "#/$defs/claim_level" },
        "input_defect": { "$ref": "#/$defs/reviewable_sentence" },
        "fired_narrowing_reasons": { "$ref": "#/$defs/narrowing_reason_array" },
        "expected_effective_claim": { "$ref": "#/$defs/claim_level" },
        "auto_detectable": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/reviewable_sentence" }
      }
    }
  }
}
