{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/review/m5-review-pack-surface-certification.schema.json",
  "title": "Aureline M5 review-pack surface certification packet",
  "description": "M05-1283 closing B152 capstone certifying that the frozen M5 review-pack object classes (review-pack record, ownership signal, required-evidence / required-check row, local-CI parity strip, AI review policy hook, review-template packet) hold their review-pack truth on every claimed M5 review, AI, provider, browser-handoff, and support / export surface. Keyed on the claimed consumer profile (fully-certified review-pack lane, reviewable review-pack record structure, stale-pack-version-digest profile, unverified-owner-provenance profile, unevaluated-required-check profile, local-only-parity profile, undisclosed-AI-pack-binding profile, stale-template-attribution profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and review-pack-truth behavior — and either passes (green), auto-narrows its review-pack claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a fully-certified review-pack lane whose pack version / digest, owner provenance, evaluator result class, local-versus-provider parity, pack freshness, and template attribution all converge on one export-safe, provider-current, internally consistent record may certify a certified review-pack record; and every B152 hard invariant must hold (a local parity estimate never masquerades as provider-authoritative mergeability or approval truth; a ci-only, not-evaluated-here, or provider-unavailable state is never hidden behind a green summary; advisory-owner and enforced-owner are never flattened into one owner pill; AI review never runs under a different pack version without disclosure; and the review-pack version / digest or template attribution is never lost when exporting, publishing, or reopening review evidence). Every row cites exactly one canonical review-pack evaluator matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_review_pack_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/review/m5-review-pack-results/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "certified_review_pack_lane",
        "reviewable_review_pack_record_structure",
        "stale_pack_version_digest_profile",
        "unverified_owner_provenance_profile",
        "unevaluated_required_check_profile",
        "local_only_parity_profile",
        "undisclosed_ai_pack_binding_profile",
        "stale_template_attribution_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "review_pack_truth"
      ]
    },
    "review_pack_claim": {
      "enum": [
        "certified_review_pack_truth",
        "reviewable_review_pack_record",
        "pack_version_digest_unverified_projection",
        "owner_provenance_unverified_projection",
        "evidence_check_unverified_projection",
        "local_parity_unverified_projection",
        "ai_pack_binding_unverified_projection",
        "template_attribution_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "review_pack_record",
        "ownership_signal",
        "required_evidence_check_row",
        "local_ci_parity_strip",
        "ai_policy_hook",
        "review_template_packet"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "local_estimate_shown_as_provider_authoritative",
        "unevaluated_check_hidden_behind_green_summary",
        "advisory_and_enforced_owner_flattened",
        "ai_review_ran_under_undisclosed_pack_version",
        "pack_version_or_digest_dropped",
        "template_attribution_dropped",
        "pack_version_digest_unstated",
        "owner_provenance_unstated",
        "evaluator_result_class_unstated",
        "parity_state_unstated",
        "pack_freshness_unstated",
        "review_pack_matrix_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lets_a_local_parity_estimate_masquerade_as_provider_authoritative",
        "hides_ci_only_not_evaluated_here_or_provider_unavailable_behind_a_green_summary",
        "flattens_advisory_owner_and_enforced_owner_into_one_owner_pill",
        "lets_ai_review_run_under_a_different_pack_version_without_disclosure",
        "loses_review_pack_version_digest_or_template_attribution_when_exporting_publishing_or_reopening"
      ],
      "properties": {
        "lets_a_local_parity_estimate_masquerade_as_provider_authoritative": { "const": false },
        "hides_ci_only_not_evaluated_here_or_provider_unavailable_behind_a_green_summary": { "const": false },
        "flattens_advisory_owner_and_enforced_owner_into_one_owner_pill": { "const": false },
        "lets_ai_review_run_under_a_different_pack_version_without_disclosure": { "const": false },
        "loses_review_pack_version_digest_or_template_attribution_when_exporting_publishing_or_reopening": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/review_pack_claim" },
        "to_claim": { "$ref": "#/$defs/review_pack_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_review_pack_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/review_pack_claim" },
        "certified_claim": { "$ref": "#/$defs/review_pack_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/review/m5-review-pack-results/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
