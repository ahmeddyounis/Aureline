{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/review/m5-review-pack-shared-consumers.schema.json",
  "title": "M5 Review-Pack Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the six B152 review-pack evaluator objects (review-pack record, ownership signal, required-evidence / required-check row, local-CI parity strip, AI review policy hook, review-template packet) to the review-detail / merge-readiness / AI-review-panel / provider-handoff / review-pack-summary / ownership-overlay / local-CI-parity-strip / support-export / help-docs consumers that render them, proving one shared review-pack vocabulary across the review-list / detail, merge-readiness / merge-queue, AI-review, support / export, and browser / provider-handoff surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_review_pack_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "review_pack_object": {
      "type": "string",
      "enum": [
        "review_pack_record",
        "ownership_signal",
        "required_evidence_check_row",
        "local_ci_parity_strip",
        "ai_policy_hook",
        "review_template_packet"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_detail",
        "merge_readiness",
        "ai_review_panel",
        "provider_handoff",
        "review_pack_summary",
        "ownership_overlay",
        "local_ci_parity_strip",
        "support_export_packet",
        "help_docs"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "vocabulary_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "review_pack_vocabulary_drift_detected",
        "pack_freshness_or_parity_disclosure_dropped",
        "lets_a_local_parity_estimate_masquerade_as_provider_authoritative",
        "hides_ci_only_not_evaluated_here_or_provider_unavailable_behind_a_green_summary",
        "flattens_advisory_owner_and_enforced_owner_into_one_owner_pill",
        "lets_ai_review_run_under_a_different_pack_version_without_disclosure",
        "loses_review_pack_version_digest_or_template_attribution_when_exporting_publishing_or_reopening",
        "canonical_registry_reference_missing",
        "upstream_review_pack_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_pack_role_word",
        "object_word",
        "registry_reference_word",
        "parity_state_word",
        "surface_context_word",
        "pack_freshness_word"
      ],
      "properties": {
        "review_pack_role_word": {
          "type": "string",
          "enum": [
            "pack_version_and_digest_disclosure",
            "owner_provenance_disclosure",
            "evaluator_result_class_disclosure",
            "local_versus_provider_parity_disclosure",
            "required_evidence_and_check_disclosure",
            "template_attribution_disclosure",
            "pack_freshness_and_invalidation_disclosure"
          ]
        },
        "object_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "parity_state_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "pack_freshness_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "subject_id",
        "subject_label",
        "object",
        "consumer",
        "representation",
        "state_facets",
        "vocabulary_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "lets_a_local_parity_estimate_masquerade_as_provider_authoritative",
        "hides_ci_only_not_evaluated_here_or_provider_unavailable_behind_a_green_summary",
        "flattens_advisory_owner_and_enforced_owner_into_one_owner_pill",
        "lets_ai_review_run_under_a_different_pack_version_without_disclosure",
        "loses_review_pack_version_digest_or_template_attribution_when_exporting_publishing_or_reopening",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "subject_label": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/review_pack_object" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "vocabulary_state": { "$ref": "#/$defs/vocabulary_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "lets_a_local_parity_estimate_masquerade_as_provider_authoritative": {
          "type": "boolean",
          "const": false
        },
        "hides_ci_only_not_evaluated_here_or_provider_unavailable_behind_a_green_summary": {
          "type": "boolean",
          "const": false
        },
        "flattens_advisory_owner_and_enforced_owner_into_one_owner_pill": {
          "type": "boolean",
          "const": false
        },
        "lets_ai_review_run_under_a_different_pack_version_without_disclosure": {
          "type": "boolean",
          "const": false
        },
        "loses_review_pack_version_digest_or_template_attribution_when_exporting_publishing_or_reopening": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "vocabulary_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "vocabulary_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_reuse_proven_by_fixtures",
        "same_subject_same_review_pack_vocabulary_across_surfaces",
        "review_pack_role_words_stay_in_frozen_vocabulary",
        "gate_roles_never_let_local_estimate_read_as_provider_authoritative",
        "ci_only_not_evaluated_here_and_provider_unavailable_never_hidden",
        "advisory_and_enforced_owner_never_flattened",
        "ai_review_never_runs_under_a_different_pack_version_without_disclosure",
        "pack_version_digest_and_template_attribution_never_lost",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "copy_export_open_provider_preserve_one_payload",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "object_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_subject_same_review_pack_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "review_pack_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "gate_roles_never_let_local_estimate_read_as_provider_authoritative": {
          "type": "boolean",
          "const": true
        },
        "ci_only_not_evaluated_here_and_provider_unavailable_never_hidden": {
          "type": "boolean",
          "const": true
        },
        "advisory_and_enforced_owner_never_flattened": {
          "type": "boolean",
          "const": true
        },
        "ai_review_never_runs_under_a_different_pack_version_without_disclosure": {
          "type": "boolean",
          "const": true
        },
        "pack_version_digest_and_template_attribution_never_lost": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "copy_export_open_provider_preserve_one_payload": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_detail_consumes_shared_review_pack_vocabulary",
        "merge_readiness_consumes_shared_review_pack_vocabulary",
        "ai_review_panel_consumes_shared_review_pack_vocabulary",
        "provider_handoff_consumes_shared_review_pack_vocabulary",
        "review_pack_summary_consumes_shared_review_pack_vocabulary",
        "ownership_overlay_consumes_shared_review_pack_vocabulary",
        "local_ci_parity_strip_consumes_shared_review_pack_vocabulary",
        "support_export_packet_consumes_shared_review_pack_vocabulary",
        "help_docs_consumes_shared_review_pack_vocabulary",
        "every_object_adopted_by_two_or_more_consumers",
        "review_pack_vocabulary_identical_for_same_subject",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_review_pack_object"
      ],
      "properties": {
        "review_detail_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "merge_readiness_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "ai_review_panel_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "provider_handoff_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "review_pack_summary_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "ownership_overlay_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "local_ci_parity_strip_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "support_export_packet_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "help_docs_consumes_shared_review_pack_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "every_object_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "review_pack_vocabulary_identical_for_same_subject": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_review_pack_object": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
