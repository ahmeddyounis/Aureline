{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/review/m5-ai-review-assist-matrix.schema.json",
  "title": "Aureline M5 AI-review-finding-row, review-scope-selector, publish-to-review-sheet, and resolution-memory-row matrix",
  "description": "Export-safe packet freezing Aureline's AI-review-assist model \u2014 the reusable AI review finding row, the review scope selector, the publish-to-review sheet, and the resolution memory row a review-capable consumer must treat as first-class, durable, publish-safe review objects. The packet names every covered object class and binds each to the claimed surface families that render it, the classification stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain AI-review-finding / review-scope-selector / publish-to-review-sheet / resolution-memory schema, the required visible state (finding label, finding class and severity, analyzed scope, publish destination, local-versus-provider state, lifecycle state, and publish / export fallback), and the mandatory labels it must show (identity, finding_role, canonical_reference, plus finding_class_badge, publish_destination, lifecycle_state). The publish_state field makes a provider-committed publish mechanically distinct from a local draft. Hard invariants forbid AI review results publishing or merging implicitly, hiding whether output stays local or becomes a provider comment / suggested patch / check annotation, keeping stale findings looking current after diff or instruction drift, losing local drafts or evidence when provider write scope is missing or a publish fails, and presenting a finding without its analyzed scope, publish destination, or lifecycle state. The matrix binds back to the already-landed stable-proof-index and migration-task-row packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "ai_review_assist_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_ai_review_finding_scope_selector_publish_sheet_and_resolution_memory_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "ai_review_assist_rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/ai_review_assist_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "ai_review_assist_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "ai_review_assist_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "ai_review_finding_row",
        "review_scope_selector",
        "publish_to_review_sheet",
        "resolution_memory_row"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "publish_state": {
      "enum": [
        "local_draft",
        "publish_now_provider_comment",
        "publish_now_suggested_patch",
        "publish_now_check_annotation",
        "open_in_provider",
        "export_fallback_offline"
      ]
    },
    "semantic_role": {
      "enum": [
        "finding_classification",
        "analyzed_scope_disclosure",
        "publish_destination_disclosure",
        "local_versus_provider_state",
        "lifecycle_state_tracking",
        "publish_export_fallback",
        "resolution_memory_disclosure"
      ]
    },
    "required_visible_state": {
      "type": "object",
      "required": [
        "finding_label",
        "finding_class_and_severity",
        "analyzed_scope",
        "publish_destination",
        "local_versus_provider_state",
        "lifecycle_state",
        "publish_export_fallback"
      ],
      "properties": {
        "finding_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "finding_class_and_severity": {
          "$ref": "#/$defs/non_empty_string"
        },
        "analyzed_scope": {
          "$ref": "#/$defs/non_empty_string"
        },
        "publish_destination": {
          "$ref": "#/$defs/non_empty_string"
        },
        "local_versus_provider_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "lifecycle_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "publish_export_fallback": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "ai_review_assist_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "publish_state",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "required_visible_state",
        "surface_families",
        "classification_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "lets_ai_review_results_publish_or_merge_implicitly",
        "hides_whether_output_stays_local_or_becomes_a_provider_comment_suggested_patch_or_check_annotation",
        "keeps_stale_findings_looking_current_after_diff_or_instruction_drift",
        "loses_local_drafts_or_evidence_when_provider_write_scope_is_missing_or_publish_fails",
        "presents_an_ai_review_finding_without_its_analyzed_scope_publish_destination_or_lifecycle_state"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "publish_state": {
          "$ref": "#/$defs/publish_state"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_visible_state": {
          "$ref": "#/$defs/required_visible_state"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "classification_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "finding_row_roles": {
          "type": "array"
        },
        "scope_selector_roles": {
          "type": "array"
        },
        "publish_sheet_roles": {
          "type": "array"
        },
        "resolution_memory_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "lets_ai_review_results_publish_or_merge_implicitly": {
          "const": false
        },
        "hides_whether_output_stays_local_or_becomes_a_provider_comment_suggested_patch_or_check_annotation": {
          "const": false
        },
        "keeps_stale_findings_looking_current_after_diff_or_instruction_drift": {
          "const": false
        },
        "loses_local_drafts_or_evidence_when_provider_write_scope_is_missing_or_publish_fails": {
          "const": false
        },
        "presents_an_ai_review_finding_without_its_analyzed_scope_publish_destination_or_lifecycle_state": {
          "const": false
        }
      }
    }
  }
}
