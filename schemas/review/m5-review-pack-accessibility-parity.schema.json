{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/review/m5-review-pack-accessibility-parity.schema.json",
  "title": "Aureline M5 review-pack accessibility & auto-narrowing parity",
  "description": "Export-safe packet for the M05-1282 keyboard / screen-reader / high-zoom / high-contrast / CLI / export parity and honest auto-narrowing capstone over the frozen M5 review-pack evaluator matrix. Each row certifies one of the six canonical review-pack objects (review_pack_record, ownership_signal, required_evidence_check_row, local_ci_parity_strip, ai_policy_hook, review_template_packet) as keyboard-complete, assistive-tech-reachable, high-zoom / high-contrast-safe, CLI/export-safe, and self-narrowing. When a pack version / digest is stale, owner provenance is missing, a required check is unevaluated (ci-only / not-evaluated-here / provider-unavailable), a local parity estimate diverges from provider-authoritative state, an AI review runs under an undisclosed pack version, or a template attribution is stale, the object's claim auto-narrows from trusted_review_surface / reviewable_review_surface to a pack-version-unverified / owner-provenance-unverified / evidence-check-unverified / local-parity-unverified / ai-pack-version-unverified / template-attribution-unverified projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical object identity / last-known state. A local parity estimate never masquerades as provider-authoritative, and advisory-owner and enforced-owner are never flattened into one owner pill. The packet is metadata-only: raw diff hunks, message payloads, credentials, secrets, and endpoint refs never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_review_pack_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 6
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "object": {
      "type": "string",
      "enum": [
        "review_pack_record",
        "ownership_signal",
        "required_evidence_check_row",
        "local_ci_parity_strip",
        "ai_policy_hook",
        "review_template_packet"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "review_pack_claim": {
      "type": "string",
      "enum": [
        "trusted_review_surface",
        "reviewable_review_surface",
        "pack_version_unverified_projection",
        "owner_provenance_unverified_projection",
        "evidence_check_unverified_projection",
        "local_parity_unverified_projection",
        "ai_pack_version_unverified_projection",
        "template_attribution_unverified_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "pack_version_digest_clarity",
        "owner_provenance_clarity",
        "evidence_check_state_clarity",
        "local_provider_parity_clarity",
        "ai_pack_binding_clarity",
        "template_attribution_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "fully_qualified",
        "pack_version_digest_stale",
        "owner_provenance_missing",
        "evidence_check_unevaluated",
        "local_parity_capability_difference",
        "ai_pack_version_undisclosed",
        "template_attribution_stale"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "local_estimate_shown_as_provider_authoritative",
        "unevaluated_check_hidden_behind_green_summary",
        "advisory_and_enforced_owner_flattened",
        "ai_review_ran_under_undisclosed_pack_version",
        "pack_version_or_digest_dropped",
        "template_attribution_dropped",
        "pack_version_digest_unstated",
        "owner_provenance_unstated",
        "evaluator_result_class_unstated",
        "parity_state_unstated",
        "pack_freshness_unstated",
        "review_pack_matrix_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "pack_role",
        "canonical_reference",
        "pack_version_digest",
        "evaluator_result_class",
        "template_attribution"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_detail",
        "merge_readiness",
        "ai_review_panel",
        "provider_handoff",
        "review_pack_summary",
        "ownership_overlay",
        "local_ci_parity_strip",
        "support_export_packet",
        "help_docs"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_truth_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/review_pack_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_truth_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "object",
        "source_object_schema_ref",
        "object_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "high_zoom_reach",
        "high_contrast_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_ready_claim",
        "claim_conditions",
        "truth_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_review_pack_accessibility_parity_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/object" },
        "source_object_schema_ref": { "type": "string", "minLength": 1 },
        "object_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_zoom_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_contrast_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_ready_claim": { "$ref": "#/$defs/review_pack_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "truth_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "object_count",
        "structure_heavy_object_count",
        "all_structure_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_trusted_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_truth_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "object_count": { "type": "integer", "minimum": 0 },
        "structure_heavy_object_count": { "type": "integer", "minimum": 0 },
        "all_structure_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_trusted_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_truth_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
