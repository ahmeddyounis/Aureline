{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/review/m5-ai-review-shared-consumers.schema.json",
  "title": "M5 AI-Review Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the four B151 AI-review-assist objects (AI review finding row, review scope selector, publish-to-review sheet, resolution memory row) to the review-detail / AI-review-panel / finding-row / review-scope-selector / publish-to-review-sheet / pending-review-tray / provider-publish-review / resolution-memory-ledger / support-export consumers that render them, proving one shared AI-review vocabulary across the review-list / detail, pending-review-tray, AI-evidence / history, support / export, and help / docs surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_ai_review_shared_consumer_registry_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "ai_review_object": {
      "type": "string",
      "enum": [
        "ai_review_finding_row",
        "review_scope_selector",
        "publish_to_review_sheet",
        "resolution_memory_row"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_detail",
        "ai_review_panel",
        "finding_row",
        "review_scope_selector",
        "publish_to_review_sheet",
        "pending_review_tray",
        "provider_publish_review",
        "resolution_memory_ledger",
        "support_export_packet"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "ai_review_vocabulary_drift_detected",
        "finding_lifecycle_or_destination_disclosure_dropped",
        "lets_ai_review_results_publish_or_merge_implicitly",
        "hides_whether_output_stays_local_or_becomes_a_provider_comment_suggested_patch_or_check_annotation",
        "keeps_stale_findings_looking_current_after_diff_or_instruction_drift",
        "loses_local_drafts_or_evidence_when_provider_write_scope_is_missing_or_publish_fails",
        "presents_an_ai_review_finding_without_its_analyzed_scope_publish_destination_or_lifecycle_state",
        "canonical_registry_reference_missing",
        "upstream_ai_review_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_review_role_word",
        "object_word",
        "registry_reference_word",
        "publish_state_word",
        "surface_context_word",
        "finding_lifecycle_word"
      ],
      "properties": {
        "ai_review_role_word": {
          "type": "string",
          "enum": [
            "finding_classification",
            "analyzed_scope_disclosure",
            "publish_destination_disclosure",
            "local_versus_provider_state",
            "lifecycle_state_tracking",
            "publish_export_fallback",
            "resolution_memory_disclosure"
          ]
        },
        "object_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "publish_state_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "finding_lifecycle_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "finding_id",
        "finding_label",
        "object",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "lets_ai_review_results_publish_or_merge_implicitly",
        "hides_whether_output_stays_local_or_becomes_a_provider_comment_suggested_patch_or_check_annotation",
        "keeps_stale_findings_looking_current_after_diff_or_instruction_drift",
        "loses_local_drafts_or_evidence_when_provider_write_scope_is_missing_or_publish_fails",
        "presents_an_ai_review_finding_without_its_analyzed_scope_publish_destination_or_lifecycle_state",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "finding_label": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/ai_review_object" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "lets_ai_review_results_publish_or_merge_implicitly": {
          "type": "boolean",
          "const": false
        },
        "hides_whether_output_stays_local_or_becomes_a_provider_comment_suggested_patch_or_check_annotation": {
          "type": "boolean",
          "const": false
        },
        "keeps_stale_findings_looking_current_after_diff_or_instruction_drift": {
          "type": "boolean",
          "const": false
        },
        "loses_local_drafts_or_evidence_when_provider_write_scope_is_missing_or_publish_fails": {
          "type": "boolean",
          "const": false
        },
        "presents_an_ai_review_finding_without_its_analyzed_scope_publish_destination_or_lifecycle_state": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_reuse_proven_by_fixtures",
        "same_finding_same_ai_review_vocabulary_across_surfaces",
        "ai_review_role_words_stay_in_frozen_vocabulary",
        "gate_roles_never_publish_or_merge_implicitly",
        "output_destination_class_never_hidden",
        "stale_findings_never_shown_as_current",
        "local_drafts_and_evidence_never_lost",
        "finding_never_shown_without_scope_destination_and_lifecycle",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "copy_export_open_provider_preserve_one_payload",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "object_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_finding_same_ai_review_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "ai_review_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "gate_roles_never_publish_or_merge_implicitly": {
          "type": "boolean",
          "const": true
        },
        "output_destination_class_never_hidden": {
          "type": "boolean",
          "const": true
        },
        "stale_findings_never_shown_as_current": {
          "type": "boolean",
          "const": true
        },
        "local_drafts_and_evidence_never_lost": {
          "type": "boolean",
          "const": true
        },
        "finding_never_shown_without_scope_destination_and_lifecycle": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "copy_export_open_provider_preserve_one_payload": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_detail_consumes_shared_ai_review_vocabulary",
        "ai_review_panel_consumes_shared_ai_review_vocabulary",
        "finding_row_consumes_shared_ai_review_vocabulary",
        "review_scope_selector_consumes_shared_ai_review_vocabulary",
        "publish_to_review_sheet_consumes_shared_ai_review_vocabulary",
        "pending_review_tray_consumes_shared_ai_review_vocabulary",
        "provider_publish_review_consumes_shared_ai_review_vocabulary",
        "resolution_memory_ledger_consumes_shared_ai_review_vocabulary",
        "support_export_packet_consumes_shared_ai_review_vocabulary",
        "every_object_adopted_by_two_or_more_consumers",
        "ai_review_vocabulary_identical_for_same_finding",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_ai_review_object"
      ],
      "properties": {
        "review_detail_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "ai_review_panel_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "finding_row_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "review_scope_selector_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "publish_to_review_sheet_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "pending_review_tray_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "provider_publish_review_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "resolution_memory_ledger_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "support_export_packet_consumes_shared_ai_review_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "every_object_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "ai_review_vocabulary_identical_for_same_finding": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_ai_review_object": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
