{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/review/m5-review-pack-evaluator-matrix.schema.json",
  "title": "Aureline M5 review-pack, ownership-signal, required-evidence-check, local-CI-parity-strip, AI-policy-hook, and review-template-packet matrix",
  "description": "Export-safe packet freezing Aureline's review-pack evaluator model \u2014 the declarative review-pack record, the ownership signal, the required-evidence / required-check row, the local-CI parity strip, the AI review policy hook, and the review-template packet a review-capable consumer must treat as first-class, durable, provider-aware review objects. The packet names every covered object class and binds each to the claimed surface families that render it, the classification stages it passes through, the non-visual accessibility routes it offers, its canonical per-domain review-pack / ownership-signal / review-pack-result / local-CI-parity / AI-policy-hook / review-template schema, the required visible state (pack label, pack version and digest, owner provenance, evaluator result class, local-versus-provider parity, pack freshness state, and template attribution), and the mandatory labels it must show (identity, pack_role, canonical_reference, plus pack_version_digest, evaluator_result_class, template_attribution). The parity_state field makes a provider-authoritative result mechanically distinct from a local parity estimate. Hard invariants forbid a local parity estimate masquerading as provider-authoritative mergeability, hiding a ci-only / not-evaluated-here / provider-unavailable state behind a green summary, flattening advisory-owner and enforced-owner into one owner pill, letting AI review run under a different pack version without disclosure, and losing the review-pack version / digest or template attribution when exporting, publishing, or reopening review evidence. The matrix binds back to the already-landed stable-proof-index and migration-task-row packets. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "review_pack_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_review_pack_ownership_local_ci_parity_and_review_template_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "review_pack_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/review_pack_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "review_pack_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "review_pack_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "object_class": {
      "enum": [
        "review_pack_record",
        "ownership_signal",
        "required_evidence_check_row",
        "local_ci_parity_strip",
        "ai_policy_hook",
        "review_template_packet"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "parity_state": {
      "enum": [
        "provider_authoritative",
        "local_parity_estimate",
        "stale_relative_to_base_head",
        "not_evaluated_here",
        "ci_only",
        "provider_unavailable",
        "draft_only_review_state"
      ]
    },
    "semantic_role": {
      "enum": [
        "pack_version_and_digest_disclosure",
        "owner_provenance_disclosure",
        "evaluator_result_class_disclosure",
        "local_versus_provider_parity_disclosure",
        "required_evidence_and_check_disclosure",
        "template_attribution_disclosure",
        "pack_freshness_and_invalidation_disclosure"
      ]
    },
    "required_visible_state": {
      "type": "object",
      "required": [
        "pack_label",
        "pack_version_and_digest",
        "owner_provenance",
        "evaluator_result_class",
        "local_versus_provider_parity",
        "pack_freshness_state",
        "template_attribution"
      ],
      "properties": {
        "pack_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "pack_version_and_digest": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_provenance": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evaluator_result_class": {
          "$ref": "#/$defs/non_empty_string"
        },
        "local_versus_provider_parity": {
          "$ref": "#/$defs/non_empty_string"
        },
        "pack_freshness_state": {
          "$ref": "#/$defs/non_empty_string"
        },
        "template_attribution": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "review_pack_row": {
      "type": "object",
      "required": [
        "object_class",
        "qualification",
        "parity_state",
        "owner_role",
        "backup_owner_role",
        "scope_summary",
        "required_visible_state",
        "surface_families",
        "classification_stages",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_closure_artifact_refs",
        "source_contract_refs",
        "lets_a_local_parity_estimate_masquerade_as_provider_authoritative",
        "hides_ci_only_not_evaluated_here_or_provider_unavailable_behind_a_green_summary",
        "flattens_advisory_owner_and_enforced_owner_into_one_owner_pill",
        "lets_ai_review_run_under_a_different_pack_version_without_disclosure",
        "loses_review_pack_version_digest_or_template_attribution_when_exporting_publishing_or_reopening"
      ],
      "properties": {
        "object_class": {
          "$ref": "#/$defs/object_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "parity_state": {
          "$ref": "#/$defs/parity_state"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_visible_state": {
          "$ref": "#/$defs/required_visible_state"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "classification_stages": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "review_pack_record_roles": {
          "type": "array"
        },
        "ownership_signal_roles": {
          "type": "array"
        },
        "required_evidence_roles": {
          "type": "array"
        },
        "local_ci_parity_roles": {
          "type": "array"
        },
        "ai_policy_hook_roles": {
          "type": "array"
        },
        "template_packet_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_closure_artifact_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "lets_a_local_parity_estimate_masquerade_as_provider_authoritative": {
          "const": false
        },
        "hides_ci_only_not_evaluated_here_or_provider_unavailable_behind_a_green_summary": {
          "const": false
        },
        "flattens_advisory_owner_and_enforced_owner_into_one_owner_pill": {
          "const": false
        },
        "lets_ai_review_run_under_a_different_pack_version_without_disclosure": {
          "const": false
        },
        "loses_review_pack_version_digest_or_template_attribution_when_exporting_publishing_or_reopening": {
          "const": false
        }
      }
    }
  }
}
