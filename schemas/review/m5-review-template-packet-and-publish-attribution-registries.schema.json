{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/review/m5-review-template-packet-and-publish-attribution-registries.schema.json",
  "title": "Aureline M5 review-template-packet and template-publish-attribution registries",
  "description": "Export-safe packet for the comment / summary review-template-packet and template-publish-attribution lane over the frozen M5 review-pack evaluator matrix. It makes the matrix review_template_packet class operable by carrying resolved, honest projections of the review-template-packet domain (one typed comment / summary template packet per review — carrying the pack-authored rationale blocks, the checklist text, and the bundle manifests, each carrying a template version and a pack digest and bound to the same active review-pack version and content digest as human, local, and CI review) and the template-publish-attribution domain (the typed record naming which binding an attribution carries — field-provenance, template-version-and-digest, or destination-and-redaction — whether each field is pack-authored, generated, user-edited, omitted, or redacted, and the destination / template source / redaction state a publish or export must show first) across the claimed M5 review, AI-review, provider-handoff, and support / export surfaces. Each registry row binds a consumer surface to resolved review-template-packet entries and resolved template-publish-attribution entries. Hard invariants forbid a clean packet from reading as trustworthy while it flattens the template version or pack digest into generic review text, lets a user-edited or redacted field read as pack-authored content behind a green summary, drops the template version / digest or template attribution on export or reopen, or sends template-driven content without first showing destination, template source, and redaction state. Acceptance criteria — published, draft, and exported review summaries preserve template version and pack digest instead of flattening them into generic review text; user edits and redactions stay visibly separate from pack-authored template content; and no publish / export surface can send template-driven review content without showing destination, template source, and redaction state first — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_review_template_packet_and_publish_attribution_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "line_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "review_template_packet_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "line_binding_id",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "report_section",
        "report_section_is_classified",
        "canonical_report_section_mode",
        "surface_context",
        "exact_repo_journey_rows",
        "bundle_ids",
        "install_topology",
        "toolchain_envelope",
        "known_limits",
        "rollback_target",
        "diagnostics_posture",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "review_template_packet_object_complete",
        "bound_to_registry",
        "rollback_and_diagnostics_bounded",
        "is_public_facing_line",
        "support_language_matches_line_proof",
        "degrade_reason",
        "next_action",
        "review_template_packet_resolves_across_lines"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "line_binding_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening": { "type": "boolean" },
        "report_section": { "$ref": "#/$defs/non_empty_string" },
        "report_section_is_classified": { "type": "boolean" },
        "canonical_report_section_mode": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "exact_repo_journey_rows": { "type": "string" },
        "bundle_ids": { "type": "string" },
        "install_topology": { "type": "string" },
        "toolchain_envelope": { "type": "string" },
        "known_limits": { "type": "string" },
        "rollback_target": { "type": "string" },
        "diagnostics_posture": { "type": "string" },
        "resolution_form_coverage": { "type": "array" },
        "covers_all_resolution_forms": { "type": "boolean" },
        "review_template_packet_object_complete": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "rollback_and_diagnostics_bounded": { "type": "boolean" },
        "is_public_facing_line": { "type": "boolean" },
        "support_language_matches_line_proof": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "review_template_packet_resolves_across_lines": { "type": "boolean" }
      }
    },
    "template_publish_attribution_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "comparison_ref",
        "token_name",
        "semantic_role",
        "semantic_role_must_preserve_downgrade_snapshot_and_signoff_before_widening",
        "comparison_scope",
        "comparison_scope_is_classified",
        "surface_context",
        "resolution_form_coverage",
        "covers_all_resolution_forms",
        "resolved_line_identity",
        "known_limits_ledger",
        "rollback_target_reference",
        "rehearsal_currency_state",
        "readiness_signoff_state",
        "support_language_reference",
