{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/review/m5-ai-review-assist-surface-certification.schema.json",
  "title": "Aureline M5 AI-review-assist surface certification packet",
  "description": "M05-1273 closing B151 capstone certifying that the frozen M5 AI-review object classes (AI review finding row, review scope selector, publish-to-review sheet, resolution memory row) hold their AI-review truth on every claimed M5 review, AI, provider, pending-review, and support / export surface. Keyed on the claimed consumer profile (fully-classified AI-review lane, reviewable AI-review record structure, disclosed provider-freshness-partial profile, unverified diff-scope profile, unverified publish-target profile, unverified finding-lifecycle profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and ai-review-truth behavior — and either passes (green), auto-narrows its AI-review claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh certified claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a fully-classified AI-review lane whose finding class, analyzed diff scope, publish destination, local-versus-provider state, and lifecycle state all converge on one export-safe, provider-current, internally consistent record may certify a certified AI-review record; and every B151 hard invariant must hold (AI review results never publish or merge implicitly; whether output stays local or becomes a provider comment, suggested patch, or provider-specific check annotation is never hidden; stale findings never keep looking current after diff or instruction drift; local drafts or evidence are never lost when provider write scope is missing or publish fails; and no AI review finding is presented without its analyzed scope, publish destination, or lifecycle state). Every row cites exactly one canonical AI-review-assist matrix proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_ai_review_assist_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/review/m5-ai-review-publish-packets/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "certified_ai_review_lane",
        "reviewable_ai_review_record_structure",
        "disclosed_provider_freshness_partial_profile",
        "unverified_diff_scope_profile",
        "unverified_publish_target_profile",
        "unverified_finding_lifecycle_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "ai_review_truth"
      ]
    },
    "ai_review_claim": {
      "enum": [
        "certified_ai_review_truth",
        "reviewable_ai_review_record",
        "provider_freshness_disclosed_projection",
        "diff_scope_unverified_projection",
        "publish_target_unverified_projection",
        "finding_lifecycle_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "object_class": {
      "enum": [
        "ai_review_finding_row",
        "review_scope_selector",
        "publish_to_review_sheet",
        "resolution_memory_row"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "ai_review_auto_actioned",
        "finding_shown_without_scope",
        "publish_destination_hidden",
        "local_draft_lost_on_publish_failure",
        "stale_finding_shown_as_current",
        "finding_class_badge_missing",
        "analyzed_scope_unstated",
        "publish_mode_unstated",
        "lifecycle_state_missing",
        "publish_export_fallback_missing",
        "resolution_memory_unstated",
        "ai_review_assist_matrix_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lets_ai_review_results_publish_or_merge_implicitly",
        "hides_whether_output_stays_local_or_becomes_a_provider_comment_suggested_patch_or_check_annotation",
        "keeps_stale_findings_looking_current_after_diff_or_instruction_drift",
        "loses_local_drafts_or_evidence_when_provider_write_scope_is_missing_or_publish_fails",
        "presents_an_ai_review_finding_without_its_analyzed_scope_publish_destination_or_lifecycle_state"
      ],
      "properties": {
        "lets_ai_review_results_publish_or_merge_implicitly": { "const": false },
        "hides_whether_output_stays_local_or_becomes_a_provider_comment_suggested_patch_or_check_annotation": { "const": false },
        "keeps_stale_findings_looking_current_after_diff_or_instruction_drift": { "const": false },
        "loses_local_drafts_or_evidence_when_provider_write_scope_is_missing_or_publish_fails": { "const": false },
        "presents_an_ai_review_finding_without_its_analyzed_scope_publish_destination_or_lifecycle_state": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/ai_review_claim" },
        "to_claim": { "$ref": "#/$defs/ai_review_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_ai_review_assist_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/ai_review_claim" },
        "certified_claim": { "$ref": "#/$defs/ai_review_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/object_class" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/review/m5-ai-review-publish-packets/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
