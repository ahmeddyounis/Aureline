{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-typography-and-geometry.schema.json",
  "title": "Aureline M5 typography and spacing / sizing / radii / elevation foundation entry",
  "description": "Canonical single-entry shape of an M5 typography, spacing / sizing / radii / elevation geometry, or hit-target visual-foundation family (type scale and font stacks, density-aware geometry steps, or minimum hit-target rules). Every claimed M5 surface references this schema or the combined m5-visual-foundation-matrix.schema.json rather than reinventing its own type scale or geometry. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-entry shape.",
  "type": "object",
  "required": [
    "foundation_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "semantic_roles",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "collapses_status_or_trust_into_color_only",
    "lets_syntax_or_diff_palette_collide_with_diagnostics",
    "shrinks_hit_target_below_supported_minimum",
    "lets_chart_meaning_depend_on_color_alone",
    "forks_local_spacing_or_elevation_from_shared_geometry"
  ],
  "properties": {
    "foundation_family": {
      "enum": [
        "typography",
        "spacing_sizing_radii_elevation",
        "hit_target"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "brand",
          "interactive",
          "neutral",
          "status",
          "syntax",
          "diff",
          "chart"
        ]
      }
    },
    "color_roles": {
      "type": "array"
    },
    "theme_token_roles": {
      "type": "array"
    },
    "syntax_roles": {
      "type": "array"
    },
    "diff_roles": {
      "type": "array"
    },
    "chart_roles": {
      "type": "array"
    },
    "typography_roles": {
      "type": "array"
    },
    "geometry_roles": {
      "type": "array"
    },
    "hit_target_rules": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "collapses_status_or_trust_into_color_only": {
      "const": false
    },
    "lets_syntax_or_diff_palette_collide_with_diagnostics": {
      "const": false
    },
    "shrinks_hit_target_below_supported_minimum": {
      "const": false
    },
    "lets_chart_meaning_depend_on_color_alone": {
      "const": false
    },
    "forks_local_spacing_or_elevation_from_shared_geometry": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
