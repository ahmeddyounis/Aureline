{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-color-system-and-semantic-theme-token-registries.schema.json",
  "title": "Aureline M5 color-system and semantic-theme-token registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 visual-foundation matrix. It carries resolved, honest projections of the color-system and semantic-theme-token foundation families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved color entries (naming a canonical token, a semantic role, a color role, an operational state family, a non-color cue, and dark/light/high-contrast mode coverage that stays distinguishable in every mode) and resolved theme-token entries (naming a canonical token, a theme-token role stable across surfaces, a semantic role, and the dark/light/high-contrast pair). Hard invariants forbid status meaning relying on color alone, a raw color value inlined instead of a canonical token, an operational state indistinguishable across modes, and an incomplete theme-mode parity. Acceptance criteria — the first shell/editor/review/notebook/data consumers use the canonical color/state families instead of feature-local palettes, the trust-sensitive restricted/remote/AI/collaboration/debug states remain distinguishable in dark/light/high-contrast modes, and raw-color or ambiguous status regressions are detectable by fixtures/lint/release evidence — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_color_system_and_semantic_theme_token_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "foundation_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "foundation_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "color_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_demands_non_color_cue",
        "color_role",
        "color_role_is_hue_alone",
        "operational_state",
        "operational_state_is_classified",
        "operational_state_is_trust_sensitive",
        "non_color_cue",
        "non_color_cue_present",
        "surface_context",
        "defined_modes",
        "covers_all_modes",
        "meaning_stated_non_color_only",
        "distinguishable_in_all_modes",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "meaning_distinct_across_modes"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_non_color_cue": { "type": "boolean" },
        "color_role": { "$ref": "#/$defs/non_empty_string" },
        "color_role_is_hue_alone": { "type": "boolean" },
        "operational_state": { "$ref": "#/$defs/non_empty_string" },
        "operational_state_is_classified": { "type": "boolean" },
        "operational_state_is_trust_sensitive": { "type": "boolean" },
        "non_color_cue": { "$ref": "#/$defs/non_empty_string" },
        "non_color_cue_present": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "defined_modes": { "type": "array" },
        "covers_all_modes": { "type": "boolean" },
        "meaning_stated_non_color_only": { "type": "boolean" },
        "distinguishable_in_all_modes": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "meaning_distinct_across_modes": { "type": "boolean" }
      }
    },
    "theme_token_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "theme_token_role",
        "theme_token_role_is_raw_hex",
        "semantic_role",
        "surface_context",
        "defined_modes",
        "covers_all_modes",
        "references_canonical_token",
        "role_stable_across_surfaces",
        "degrade_reason",
        "next_action",
        "token_stable_across_theme_pair"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "theme_token_role": { "$ref": "#/$defs/non_empty_string" },
        "theme_token_role_is_raw_hex": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "defined_modes": { "type": "array" },
        "covers_all_modes": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "role_stable_across_surfaces": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "token_stable_across_theme_pair": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "color_entries",
        "theme_token_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "status_meaning_relies_on_color_alone",
        "raw_color_value_inlined_instead_of_token",
        "operational_state_indistinguishable_across_modes",
        "theme_mode_parity_incomplete"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "color_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/color_entry" }
        },
        "theme_token_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/theme_token_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "status_meaning_relies_on_color_alone": { "const": false },
        "raw_color_value_inlined_instead_of_token": { "const": false },
        "operational_state_indistinguishable_across_modes": { "const": false },
        "theme_mode_parity_incomplete": { "const": false }
      }
    }
  }
}
