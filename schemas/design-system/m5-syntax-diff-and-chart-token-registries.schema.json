{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-syntax-diff-and-chart-token-registries.schema.json",
  "title": "Aureline M5 syntax-, diff-, and chart-token registries",
  "description": "Export-safe packet for the syntax/diff/chart implement lane over the frozen M5 visual-foundation matrix. It carries resolved, honest projections of the syntax-token, diff-token, and chart-token foundation families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved syntax entries (naming a canonical token, a syntax scope kept distinct from diagnostics, a diagnostics-precedence posture, and export-channel survival), resolved diff entries (naming a canonical token, a diff region kept distinct from diagnostics, a moved-block confidence, a historical-vs-current emphasis, a non-color cue, and export survival), and resolved chart entries (naming a canonical token, a chart series that pairs a legend/pattern/marker cue at accessible contrast and survives export). Hard invariants forbid a syntax or diff palette colliding with diagnostics, chart meaning relying on color alone, meaning lost under high contrast or export, and a raw color value inlined instead of a canonical token. Acceptance criteria — syntax/diff/chart surfaces share one stable semantic mapping, diagnostics visually outrank syntax where they overlap while diff/chart meaning survives high-contrast and export paths, and legend/pattern parity exists wherever color alone would be insufficient — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_syntax_diff_and_chart_token_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "foundation_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "foundation_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "syntax_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_demands_non_color_cue",
        "syntax_role",
        "syntax_role_collides_with_diagnostics",
        "diagnostics_posture",
        "diagnostics_precedence_honored",
        "surface_context",
        "export_channels",
        "survives_required_export_channels",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "diagnostics_outrank_syntax"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_non_color_cue": { "type": "boolean" },
        "syntax_role": { "$ref": "#/$defs/non_empty_string" },
        "syntax_role_collides_with_diagnostics": { "type": "boolean" },
        "diagnostics_posture": { "$ref": "#/$defs/non_empty_string" },
        "diagnostics_precedence_honored": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "export_channels": { "type": "array" },
        "survives_required_export_channels": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "diagnostics_outrank_syntax": { "type": "boolean" }
      }
    },
    "diff_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_demands_non_color_cue",
        "diff_role",
        "diff_role_collides_with_diagnostics",
        "moved_confidence",
        "moved_confidence_stated",
        "historical_emphasis",
        "historical_emphasis_stated",
        "non_color_cue",
        "non_color_cue_present",
        "surface_context",
        "export_channels",
        "survives_required_export_channels",
        "distinct_from_diagnostics",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "meaning_survives_export"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_non_color_cue": { "type": "boolean" },
        "diff_role": { "$ref": "#/$defs/non_empty_string" },
        "diff_role_collides_with_diagnostics": { "type": "boolean" },
        "moved_confidence": { "$ref": "#/$defs/non_empty_string" },
        "moved_confidence_stated": { "type": "boolean" },
        "historical_emphasis": { "$ref": "#/$defs/non_empty_string" },
        "historical_emphasis_stated": { "type": "boolean" },
        "non_color_cue": { "$ref": "#/$defs/non_empty_string" },
        "non_color_cue_present": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "export_channels": { "type": "array" },
        "survives_required_export_channels": { "type": "boolean" },
        "distinct_from_diagnostics": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "meaning_survives_export": { "type": "boolean" }
      }
    },
    "chart_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_demands_non_color_cue",
        "chart_role",
        "chart_role_is_color_alone",
        "non_color_cue",
        "non_color_cue_present",
        "legend_or_pattern_present",
        "accessible_contrast",
        "surface_context",
        "export_channels",
        "survives_required_export_channels",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "meaning_survives_without_color"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_non_color_cue": { "type": "boolean" },
        "chart_role": { "$ref": "#/$defs/non_empty_string" },
        "chart_role_is_color_alone": { "type": "boolean" },
        "non_color_cue": { "$ref": "#/$defs/non_empty_string" },
        "non_color_cue_present": { "type": "boolean" },
        "legend_or_pattern_present": { "type": "boolean" },
        "accessible_contrast": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "export_channels": { "type": "array" },
        "survives_required_export_channels": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "meaning_survives_without_color": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "syntax_entries",
        "diff_entries",
        "chart_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "syntax_or_diff_palette_collides_with_diagnostics",
        "chart_meaning_relies_on_color_alone",
        "meaning_lost_under_high_contrast_or_export",
        "raw_color_value_inlined_instead_of_token"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "syntax_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/syntax_entry" }
        },
        "diff_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/diff_entry" }
        },
        "chart_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/chart_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "syntax_or_diff_palette_collides_with_diagnostics": { "const": false },
        "chart_meaning_relies_on_color_alone": { "const": false },
        "meaning_lost_under_high_contrast_or_export": { "const": false },
        "raw_color_value_inlined_instead_of_token": { "const": false }
      }
    }
  }
}
