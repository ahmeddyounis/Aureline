{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-motion-layer-iconography-accessibility-parity.schema.json",
  "title": "Aureline M5 motion-layer-iconography accessibility & auto-narrowing parity",
  "description": "Export-safe packet for the M05-1154 keyboard / screen-reader / high-zoom / reduced-motion / battery-saver / thermal-pressure / CLI / export parity and honest auto-narrowing capstone over the frozen M5 motion / layer / iconography matrix. Each row certifies one of the seven governed visual-interaction families (motion-token, reduced-motion, opacity-scrim, layer-order, portal-ownership, iconography, illustration) as keyboard-reachable, screen-reader-announced, high-zoom-legible, reduced-motion / power-saver / thermal-safe, CLI/export-safe, and self-narrowing. When a motion token's protected-path timing evidence is stale, a reduced-motion / power-saver / thermal clamp cannot be confirmed, an opacity scrim's orientation / contrast preservation is unconfirmed, a portal's owning-surface attachment cannot be confirmed, or an illustration boundary can only be partially disclosed, the family's claim auto-narrows from trusted_interaction_surface / reviewable_interaction_surface to a motion-timing-unverified / reduced-motion-clamp-unverified / scrim-orientation-unverified / portal-ownership-unverified / illustration-boundary-disclosed projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical interaction identity / last-known token reference. Meaning is never conveyed by motion, decoration, or an unlabeled symbol alone. The packet is metadata-only: raw duration curves, z-index integers, glyph blobs, credentials, secrets, and endpoint refs never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_motion_layer_iconography_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 7
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "interaction_family": {
      "type": "string",
      "enum": [
        "motion_token",
        "reduced_motion",
        "opacity_scrim",
        "layer_order",
        "portal_ownership",
        "iconography",
        "illustration"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "visual_interaction_claim": {
      "type": "string",
      "enum": [
        "trusted_interaction_surface",
        "reviewable_interaction_surface",
        "motion_timing_unverified_projection",
        "reduced_motion_clamp_unverified_projection",
        "scrim_orientation_unverified_projection",
        "portal_ownership_unverified_projection",
        "illustration_boundary_disclosed_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "motion_timing_clarity",
        "reduced_motion_safety_clarity",
        "scrim_orientation_clarity",
        "layer_order_clarity",
        "portal_ownership_clarity",
        "icon_semantics_clarity",
        "illustration_boundary_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "fully_qualified",
        "motion_timing_evidence_stale",
        "reduced_motion_safety_unconfirmed",
        "scrim_contrast_unconfirmed",
        "portal_ownership_unconfirmed",
        "illustration_boundary_disclosed_partial"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "motion_delayed_protected_input",
        "motion_meaning_lost_under_reduced_motion",
        "scrim_erased_orientation_or_contrast",
        "overlay_bypassed_shared_z_order",
        "portal_detached_from_owning_surface",
        "unlabeled_icon_for_uncommon_or_destructive_action",
        "illustration_impersonated_operational_state",
        "icon_semantics_ambiguous",
        "layer_tier_unstated",
        "semantic_role_unstated",
        "token_reference_unstated",
        "proof_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "semantic_role",
        "token_reference",
        "motion_profile",
        "layer_tier",
        "accessible_fallback"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "editor_ui",
        "help_ui",
        "marketplace_ui",
        "onboarding_ui",
        "settings_ui",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_truth_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/visual_interaction_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_truth_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "interaction_family",
        "source_family_schema_ref",
        "interaction_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "high_zoom_reach",
        "reduced_motion_reach",
        "power_thermal_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_ready_claim",
        "claim_conditions",
        "truth_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_motion_layer_iconography_accessibility_parity_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "interaction_family": { "$ref": "#/$defs/interaction_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "interaction_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_zoom_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "reduced_motion_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "power_thermal_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_ready_claim": { "$ref": "#/$defs/visual_interaction_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "truth_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "structure_heavy_family_count",
        "all_structure_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_trusted_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_truth_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "structure_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_structure_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_trusted_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_truth_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
