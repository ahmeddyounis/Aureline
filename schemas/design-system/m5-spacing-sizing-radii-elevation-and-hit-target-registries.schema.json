{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-spacing-sizing-radii-elevation-and-hit-target-registries.schema.json",
  "title": "Aureline M5 spacing / sizing / radii / border / elevation geometry and hit-target registries",
  "description": "Export-safe packet for the closing geometry implement lane over the frozen M5 visual-foundation matrix. It carries resolved, honest projections of the spacing / sizing / radii / border / elevation geometry family and the minimum hit-target family across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved geometry entries (naming a canonical token, a primitive kind, a geometry role that matches the kind, a density mode, an elevation tier, and density-aware application) and resolved hit-target entries (naming a canonical token, a control kind, a hit-target rule, a density mode, meeting the supported minimum, and adequate spacing between adjacent targets). Hard invariants forbid geometry forking from the shared foundation, a hit target shrinking below its supported minimum, overlays / dialogs losing their elevation hierarchy, and a raw geometry value inlined instead of a canonical token. Acceptance criteria — the first claimed M5 consumers use canonical spacing / sizing / radii / elevation primitives rather than ad hoc local geometry, compact density does not shrink hit targets below supported minima while overlays / dialogs preserve the intended elevation hierarchy, and geometry drift is visible in fixtures / linting / proof packets before stable promotion — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_spacing_sizing_radii_elevation_and_hit_target_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "foundation_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "foundation_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "geometry_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "geometry_role",
        "primitive_kind",
        "geometry_role_matches_kind",
        "is_elevation",
        "elevation_tier",
        "elevation_hierarchy_preserved",
        "density_mode",
        "density_aware",
        "surface_context",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "geometry_is_canonical"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "geometry_role": { "$ref": "#/$defs/non_empty_string" },
        "primitive_kind": { "$ref": "#/$defs/non_empty_string" },
        "geometry_role_matches_kind": { "type": "boolean" },
        "is_elevation": { "type": "boolean" },
        "elevation_tier": { "$ref": "#/$defs/non_empty_string" },
        "elevation_hierarchy_preserved": { "type": "boolean" },
        "density_mode": { "$ref": "#/$defs/non_empty_string" },
        "density_aware": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "geometry_is_canonical": { "type": "boolean" }
      }
    },
    "hit_target_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "hit_target_rule",
        "control_kind",
        "control_kind_resolved",
        "density_mode",
        "meets_supported_minimum",
        "adequate_target_spacing",
        "surface_context",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "target_meets_minimum"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "hit_target_rule": { "$ref": "#/$defs/non_empty_string" },
        "control_kind": { "$ref": "#/$defs/non_empty_string" },
        "control_kind_resolved": { "type": "boolean" },
        "density_mode": { "$ref": "#/$defs/non_empty_string" },
        "meets_supported_minimum": { "type": "boolean" },
        "adequate_target_spacing": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "target_meets_minimum": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "geometry_entries",
        "hit_target_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "local_geometry_forked_from_foundation",
        "hit_target_shrunk_below_minimum",
        "elevation_hierarchy_broken",
        "raw_geometry_value_inlined_instead_of_token"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "geometry_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/geometry_entry" }
        },
        "hit_target_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/hit_target_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "local_geometry_forked_from_foundation": { "const": false },
        "hit_target_shrunk_below_minimum": { "const": false },
        "elevation_hierarchy_broken": { "const": false },
        "raw_geometry_value_inlined_instead_of_token": { "const": false }
      }
    }
  }
}
