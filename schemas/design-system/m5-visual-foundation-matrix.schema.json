{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-visual-foundation-matrix.schema.json",
  "title": "Aureline M5 color-system, semantic-theme-token, syntax / diff / chart-token, typography, and spacing / sizing / radii / elevation visual-foundation matrix",
  "description": "Export-safe packet freezing Aureline's concrete visual foundation. The packet names every claimed M5 surface that still describes its own color meaning, semantic theme role, syntax / diff / chart palette, type scale, font stack, or spacing / sizing / radii / elevation geometry — across the shell, editor, review, data, and docs surfaces — and binds each governed family to the claimed surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, reduced-motion, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each family declares the controlled vocabularies it carries: the single controlled semantic-role vocabulary consumers bind to (brand, interactive, neutral, status, syntax, diff, chart), plus family-specific color roles, theme-token roles, syntax roles, diff roles, chart roles, typography roles, geometry roles, and hit-target rules. Hard invariants forbid collapsing status or trust meaning into color-only cues, letting a syntax or diff palette collide with diagnostics, shrinking a hit target below its supported minimum, letting chart meaning depend on color alone, and forking local spacing or elevation away from the shared geometry. The matrix binds back to the already-landed design-system foundations and publication packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "foundation_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_color_system_semantic_theme_token_syntax_diff_chart_token_typography_and_spacing_sizing_radii_elevation_visual_foundation_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "foundation_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/foundation_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "foundation_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "foundation_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "foundation_family": {
      "enum": [
        "color_system",
        "semantic_theme_token",
        "syntax_token",
        "diff_token",
        "chart_token",
        "typography",
        "spacing_sizing_radii_elevation",
        "hit_target"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "brand",
        "interactive",
        "neutral",
        "status",
        "syntax",
        "diff",
        "chart"
      ]
    },
    "foundation_row": {
      "type": "object",
      "required": [
        "foundation_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_status_or_trust_into_color_only",
        "lets_syntax_or_diff_palette_collide_with_diagnostics",
        "shrinks_hit_target_below_supported_minimum",
        "lets_chart_meaning_depend_on_color_alone",
        "forks_local_spacing_or_elevation_from_shared_geometry"
      ],
      "properties": {
        "foundation_family": {
          "$ref": "#/$defs/foundation_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "color_roles": {
          "type": "array"
        },
        "theme_token_roles": {
          "type": "array"
        },
        "syntax_roles": {
          "type": "array"
        },
        "diff_roles": {
          "type": "array"
        },
        "chart_roles": {
          "type": "array"
        },
        "typography_roles": {
          "type": "array"
        },
        "geometry_roles": {
          "type": "array"
        },
        "hit_target_rules": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "collapses_status_or_trust_into_color_only": {
          "const": false
        },
        "lets_syntax_or_diff_palette_collide_with_diagnostics": {
          "const": false
        },
        "shrinks_hit_target_below_supported_minimum": {
          "const": false
        },
        "lets_chart_meaning_depend_on_color_alone": {
          "const": false
        },
        "forks_local_spacing_or_elevation_from_shared_geometry": {
          "const": false
        }
      }
    }
  }
}
