{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-motion-token-and-reduced-motion-registries.schema.json",
  "title": "Aureline M5 motion-token and reduced-motion registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 motion / layer / iconography matrix. It carries resolved, honest projections of the motion-token and reduced-motion interaction families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved motion entries (naming a canonical token, a semantic role, a motion role, a motion surface class, a reduced-motion fallback, and reduced-motion/power-saver/thermal clamp coverage that respects input priority and introduces no layout shift) and resolved reduced-motion entries (naming a canonical token, a reduced-motion role, a semantic role, the three clamps, and a static fallback that preserves meaning). Hard invariants forbid motion delaying input on a protected path, a raw duration value inlined instead of a canonical token, a layout shift on a protected surface, and an incomplete clamp coverage. Acceptance criteria — the first shell/dialog/panel/embedded consumers use one canonical motion grammar instead of feature-local transitions, protected input paths are not delayed by decorative motion and reduced-motion behavior is explicit and testable, and animation regressions are detectable by fixtures/release evidence before promotion — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_motion_token_and_reduced_motion_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "interaction_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "interaction_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "motion_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_demands_accessible_fallback",
        "motion_role",
        "motion_role_delays_protected_input",
        "surface_class",
        "surface_class_is_classified",
        "surface_class_is_protected_path",
        "reduced_motion_fallback",
        "reduced_motion_fallback_present",
        "surface_context",
        "clamp_coverage",
        "covers_all_clamps",
        "respects_input_priority",
        "preserves_no_layout_shift",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "motion_safe_on_protected_paths"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_accessible_fallback": { "type": "boolean" },
        "motion_role": { "$ref": "#/$defs/non_empty_string" },
        "motion_role_delays_protected_input": { "type": "boolean" },
        "surface_class": { "$ref": "#/$defs/non_empty_string" },
        "surface_class_is_classified": { "type": "boolean" },
        "surface_class_is_protected_path": { "type": "boolean" },
        "reduced_motion_fallback": { "$ref": "#/$defs/non_empty_string" },
        "reduced_motion_fallback_present": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "clamp_coverage": { "type": "array" },
        "covers_all_clamps": { "type": "boolean" },
        "respects_input_priority": { "type": "boolean" },
        "preserves_no_layout_shift": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "motion_safe_on_protected_paths": { "type": "boolean" }
      }
    },
    "reduced_motion_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "reduced_motion_role",
        "reduced_motion_role_is_motion_only",
        "semantic_role",
        "surface_context",
        "clamp_coverage",
        "covers_all_clamps",
        "references_canonical_token",
        "static_fallback_preserves_meaning",
        "degrade_reason",
        "next_action",
        "fallback_preserves_meaning_across_clamps"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "reduced_motion_role": { "$ref": "#/$defs/non_empty_string" },
        "reduced_motion_role_is_motion_only": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "clamp_coverage": { "type": "array" },
        "covers_all_clamps": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "static_fallback_preserves_meaning": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fallback_preserves_meaning_across_clamps": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "motion_entries",
        "reduced_motion_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "motion_delays_protected_input",
        "raw_duration_value_inlined_instead_of_token",
        "layout_shift_on_protected_surface",
        "clamp_coverage_incomplete"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "motion_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/motion_entry" }
        },
        "reduced_motion_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reduced_motion_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "motion_delays_protected_input": { "const": false },
        "raw_duration_value_inlined_instead_of_token": { "const": false },
        "layout_shift_on_protected_surface": { "const": false },
        "clamp_coverage_incomplete": { "const": false }
      }
    }
  }
}
