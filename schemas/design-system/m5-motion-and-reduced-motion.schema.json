{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-motion-and-reduced-motion.schema.json",
  "title": "Aureline M5 motion / reduced-motion visual-interaction entry",
  "description": "Canonical single-entry shape of an M5 motion-token or reduced-motion visual-interaction family (a duration / easing family that clarifies origin, continuity, and completion, or a reduced-motion / power-saver / thermal clamp with a static fallback). Every claimed M5 surface references this schema or the combined m5-motion-layer-iconography-matrix.schema.json rather than reinventing its own animation curves or reduced-motion behavior. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-entry shape.",
  "type": "object",
  "required": [
    "interaction_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "semantic_roles",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "delays_protected_input_with_motion",
    "scrim_erases_orientation_or_contrast",
    "overlay_bypasses_shared_z_order",
    "uses_unlabeled_icon_for_uncommon_or_destructive_action",
    "lets_illustration_impersonate_operational_or_security_truth"
  ],
  "properties": {
    "interaction_family": {
      "$ref": "#/$defs/interaction_family"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "motion",
          "overlay",
          "layer",
          "portal",
          "icon",
          "illustration",
          "attention"
        ]
      }
    },
    "motion_roles": {
      "type": "array"
    },
    "reduced_motion_roles": {
      "type": "array"
    },
    "opacity_scrim_roles": {
      "type": "array"
    },
    "layer_order_roles": {
      "type": "array"
    },
    "portal_ownership_roles": {
      "type": "array"
    },
    "iconography_roles": {
      "type": "array"
    },
    "illustration_roles": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "delays_protected_input_with_motion": {
      "const": false
    },
    "scrim_erases_orientation_or_contrast": {
      "const": false
    },
    "overlay_bypasses_shared_z_order": {
      "const": false
    },
    "uses_unlabeled_icon_for_uncommon_or_destructive_action": {
      "const": false
    },
    "lets_illustration_impersonate_operational_or_security_truth": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "interaction_family": {
      "enum": [
        "motion_token",
        "reduced_motion"
      ]
    }
  }
}
