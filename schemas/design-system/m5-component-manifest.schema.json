{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-component-manifest.schema.json",
  "title": "Aureline M5 design-system component-manifest package",
  "description": "Versioned, machine-readable package of component-contract manifests for the launch-critical M5 component families (placeholder cards, state blocks, review sheets, job rows, boundary bars, form controls, and dense collection primitives). Each manifest is the single, cite-able contract engineering, QA, docs, and the extension SDK reuse instead of reading shell code or screenshots: it declares the component anatomy, the mandatory and optional controlled-state families it renders (drawn from the canonical state vocabulary), the governed labels it announces, the commands it offers, its keyboard model, its accessibility contract, the foundation token references it renders from, and the extension-author consumption rules. Each manifest carries versioned lifecycle and owner metadata so design QA, support exports, and release packets point at the same contract revision. The records are metadata-only: they carry semantic token references and message ids, never raw color values, credential bodies, or provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "package_id",
    "package_version",
    "owner_role",
    "manifests",
    "proof_lane_ref",
    "release_packet_ref",
    "source_contract_refs",
    "redaction_class_token",
    "summary_message_id",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_component_manifest_package" },
    "schema_version": { "const": 1 },
    "package_id": { "$ref": "#/$defs/non_empty_string" },
    "package_version": { "$ref": "#/$defs/semver" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "manifests": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/manifest" }
    },
    "proof_lane_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "summary_message_id": { "$ref": "#/$defs/message_id" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "message_id": { "type": "string", "pattern": "^design_system_component\\." },
    "component_kind": {
      "enum": [
        "placeholder_card",
        "state_block",
        "review_sheet",
        "job_row",
        "boundary_bar",
        "form_control",
        "dense_collection"
      ]
    },
    "lifecycle_state": {
      "enum": ["experimental", "preview", "stable", "deprecated"]
    },
    "canonical_state_class": {
      "enum": [
        "empty",
        "loading",
        "pending",
        "degraded",
        "blocked",
        "error",
        "completed"
      ]
    },
    "state_class_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/canonical_state_class" },
      "uniqueItems": true
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_kind",
        "component_id",
        "display_name",
        "lifecycle",
        "anatomy",
        "states",
        "labels",
        "commands",
        "keyboard",
        "accessibility",
        "token_dependencies",
        "extension_guidance",
        "summary_message_id"
      ],
      "properties": {
        "component_kind": { "$ref": "#/$defs/component_kind" },
        "component_id": { "$ref": "#/$defs/non_empty_string" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "anatomy": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/anatomy_part" }
        },
        "states": { "$ref": "#/$defs/states" },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/label" }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        },
        "keyboard": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/key_binding" }
        },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "token_dependencies": { "$ref": "#/$defs/non_empty_string_array" },
        "extension_guidance": { "$ref": "#/$defs/extension_guidance" },
        "summary_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_role",
        "lifecycle_state",
        "manifest_version",
        "introduced_in_package_version"
      ],
      "properties": {
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "lifecycle_state": { "$ref": "#/$defs/lifecycle_state" },
        "manifest_version": { "type": "integer", "minimum": 1 },
        "introduced_in_package_version": { "$ref": "#/$defs/semver" }
      }
    },
    "anatomy_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "role", "required"],
      "properties": {
        "part_id": { "$ref": "#/$defs/non_empty_string" },
        "role": { "$ref": "#/$defs/non_empty_string" },
        "required": { "type": "boolean" }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandatory", "optional"],
      "properties": {
        "mandatory": {
          "allOf": [
            { "$ref": "#/$defs/state_class_array" },
            { "minItems": 1 }
          ]
        },
        "optional": { "$ref": "#/$defs/state_class_array" }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_id", "message_id", "purpose"],
      "properties": {
        "label_id": { "$ref": "#/$defs/non_empty_string" },
        "message_id": { "$ref": "#/$defs/message_id" },
        "purpose": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "label_message_id", "keys"],
      "properties": {
        "command_id": { "$ref": "#/$defs/non_empty_string" },
        "label_message_id": { "$ref": "#/$defs/message_id" },
        "keys": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "key_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "action"],
      "properties": {
        "keys": { "$ref": "#/$defs/non_empty_string" },
        "action": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "screen_reader_label_rule",
        "focus_order_rule",
        "notes"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/non_empty_string" },
        "screen_reader_label_rule": { "$ref": "#/$defs/non_empty_string" },
        "focus_order_rule": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string_array" }
      }
    },
    "extension_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guidance_ref", "consumption_rules"],
      "properties": {
        "guidance_ref": { "$ref": "#/$defs/non_empty_string" },
        "consumption_rules": { "$ref": "#/$defs/non_empty_string_array" }
      }
    }
  }
}
