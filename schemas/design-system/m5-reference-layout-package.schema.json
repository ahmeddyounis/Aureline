{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-reference-layout-package.schema.json",
  "title": "Aureline M5 design-system reference-layout package",
  "description": "Versioned, machine-readable package of reference-layout descriptors for the dominant M5 workspaces (notebooks, data grids, the profiler, pipelines, docs, preview, incident, and companion surfaces). Each descriptor is the single, cite-able truth for how a workspace occupies the governed shell zones: it declares the zone occupancy (which shell zone the workspace claims, the governed slot it fills, the surface kind, whether the zone is mandatory, and the placeholder behavior the zone shows before content resolves), the responsive collapse rules (per adaptive class, which zones collapse and the fallback placement they collapse to), the missing-dependency placeholder rules (when a dependency is absent, the placeholder class, governed message id, and degraded behavior the affected zone shows), and the reopen / reset routes. The governed zone, slot, fallback-placement, and placeholder-class tokens match the canonical shell vocabulary so shell code, docs/help, and support exports name the same layout identities and collapse states users actually see. The records are metadata-only: they carry semantic slot ids and message ids, never raw geometry payloads, credential bodies, or provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "package_id",
    "package_version",
    "owner_role",
    "layouts",
    "proof_lane_ref",
    "release_packet_ref",
    "source_contract_refs",
    "redaction_class_token",
    "summary_message_id",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_reference_layout_package" },
    "schema_version": { "const": 1 },
    "package_id": { "$ref": "#/$defs/non_empty_string" },
    "package_version": { "$ref": "#/$defs/semver" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "layouts": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/layout" }
    },
    "proof_lane_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "summary_message_id": { "$ref": "#/$defs/message_id" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "message_id": { "type": "string", "pattern": "^design_system_reference_layout\\." },
    "workspace_kind": {
      "enum": [
        "notebook",
        "data_grid",
        "profiler",
        "pipeline",
        "docs",
        "preview",
        "incident",
        "companion"
      ]
    },
    "shell_zone": {
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "surface_kind": {
      "enum": ["host_chrome", "first_party", "provider_backed", "extension_contributed"]
    },
    "adaptive_class": {
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "fallback_placement": {
      "enum": ["docked", "sheet", "overflow", "placeholder"]
    },
    "placeholder_class": {
      "enum": [
        "required_chrome",
        "missing_extension",
        "missing_remote",
        "missing_provider",
        "capability_loss",
        "topology_drift"
      ]
    },
    "route_kind": {
      "enum": ["reopen", "reset"]
    },
    "lifecycle_state": {
      "enum": ["experimental", "preview", "stable", "deprecated"]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_kind",
        "workspace_id",
        "display_name",
        "lifecycle",
        "zone_occupancy",
        "responsive_collapse",
        "missing_dependency_rules",
        "reopen_routes",
        "summary_message_id"
      ],
      "properties": {
        "workspace_kind": { "$ref": "#/$defs/workspace_kind" },
        "workspace_id": { "$ref": "#/$defs/non_empty_string" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "zone_occupancy": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/zone_occupancy" }
        },
        "responsive_collapse": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/collapse_rule" }
        },
        "missing_dependency_rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/missing_dependency_rule" }
        },
        "reopen_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layout_route" }
        },
        "summary_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_role",
        "lifecycle_state",
        "layout_version",
        "introduced_in_package_version"
      ],
      "properties": {
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "lifecycle_state": { "$ref": "#/$defs/lifecycle_state" },
        "layout_version": { "type": "integer", "minimum": 1 },
        "introduced_in_package_version": { "$ref": "#/$defs/semver" }
      }
    },
    "zone_occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone",
        "slot_id",
        "surface_role",
        "surface_kind",
        "required",
        "placeholder_behavior"
      ],
      "properties": {
        "zone": { "$ref": "#/$defs/shell_zone" },
        "slot_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_role": { "$ref": "#/$defs/non_empty_string" },
        "surface_kind": { "$ref": "#/$defs/surface_kind" },
        "required": { "type": "boolean" },
        "placeholder_behavior": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "collapse_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adaptive_class",
        "collapsed_zones",
        "placement",
        "preserves_zone_identity",
        "behavior"
      ],
      "properties": {
        "adaptive_class": { "$ref": "#/$defs/adaptive_class" },
        "collapsed_zones": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/shell_zone" }
        },
        "placement": { "$ref": "#/$defs/fallback_placement" },
        "preserves_zone_identity": { "type": "boolean" },
        "behavior": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "missing_dependency_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "affected_zone",
        "placeholder_class",
        "placeholder_message_id",
        "degraded_behavior"
      ],
      "properties": {
        "dependency_id": { "$ref": "#/$defs/non_empty_string" },
        "affected_zone": { "$ref": "#/$defs/shell_zone" },
        "placeholder_class": { "$ref": "#/$defs/placeholder_class" },
        "placeholder_message_id": { "$ref": "#/$defs/message_id" },
        "degraded_behavior": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "layout_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "route_kind", "command_message_id", "keys", "description"],
      "properties": {
        "route_id": { "$ref": "#/$defs/non_empty_string" },
        "route_kind": { "$ref": "#/$defs/route_kind" },
        "command_message_id": { "$ref": "#/$defs/message_id" },
        "keys": { "$ref": "#/$defs/non_empty_string" },
        "description": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
