{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-evidence-pack.schema.json",
  "title": "Aureline M5 design-system component-gallery evidence pack",
  "description": "Versioned, machine-readable evidence pack for the launch-critical M5 component families (placeholder cards, state blocks, review sheets, durable job rows, boundary bars, form controls, and dense collections). For each family it renders one gallery scene per controlled state from the checked-in host-primitive library — reproducing the parts, non-color cues, and interactivity the primitive declares — and captures each scene under every appearance variant in the same pack: normal dark and light themes, both high-contrast variants, the reduced-motion posture, and two zoom levels. Each captured variant carries a deterministic content digest (the visual-diff baseline) so a regression changes the digest without a manual screenshot comparison. Each component attaches its owning identity (component id, owner role) and a computed freshness derived from its capture date, evaluation date, and freshness window; stale evidence auto-narrows the component's shell-quality claim and missing coverage blocks it. The records are metadata-only: they carry semantic token references, message ids, and content digests, never raw color values, raw screenshots, credential bodies, or provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "pack_id",
    "pack_version",
    "owner_role",
    "source_primitive_library_ref",
    "source_manifest_package_ref",
    "source_foundation_package_ref",
    "components",
    "proof_lane_ref",
    "release_packet_ref",
    "source_contract_refs",
    "redaction_class_token",
    "summary_message_id",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_evidence_pack" },
    "schema_version": { "const": 1 },
    "pack_id": { "$ref": "#/$defs/non_empty_string" },
    "pack_version": { "$ref": "#/$defs/semver" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "source_primitive_library_ref": { "$ref": "#/$defs/non_empty_string" },
    "source_manifest_package_ref": { "$ref": "#/$defs/non_empty_string" },
    "source_foundation_package_ref": { "$ref": "#/$defs/non_empty_string" },
    "components": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/component" }
    },
    "proof_lane_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "summary_message_id": { "$ref": "#/$defs/message_id" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "message_id": { "type": "string", "pattern": "^design_system_evidence\\." },
    "iso_date": { "type": "string", "minLength": 10 },
    "digest": { "type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$" },
    "component_kind": {
      "enum": [
        "placeholder_card",
        "state_block",
        "review_sheet",
        "job_row",
        "boundary_bar",
        "form_control",
        "dense_collection"
      ]
    },
    "canonical_state_class": {
      "enum": [
        "empty",
        "loading",
        "pending",
        "degraded",
        "blocked",
        "error",
        "completed"
      ]
    },
    "non_color_cue_class": {
      "enum": [
        "label_text",
        "icon",
        "border",
        "shape",
        "progress_indicator",
        "lock_or_shield_glyph",
        "check_or_selection_marker"
      ]
    },
    "variant_kind": {
      "enum": [
        "normal_dark",
        "normal_light",
        "high_contrast_dark",
        "high_contrast_light",
        "reduced_motion",
        "zoom_150",
        "zoom_200"
      ]
    },
    "theme_class": {
      "enum": [
        "dark_reference",
        "light_parity",
        "high_contrast_dark",
        "high_contrast_light"
      ]
    },
    "motion_posture": {
      "enum": [
        "motion_standard",
        "motion_reduced",
        "motion_low_motion",
        "motion_power_saver",
        "motion_critical_hot_path"
      ]
    },
    "freshness": { "enum": ["current", "stale"] },
    "claim_gate": { "enum": ["certified", "narrowed", "blocked"] },
    "appearance_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_kind",
        "theme_class",
        "motion_posture",
        "zoom_percent",
        "baseline_digest",
        "baseline_capture_ref",
        "diff_artifact_ref",
        "non_color_meaning_present",
        "focus_visible"
      ],
      "properties": {
        "variant_kind": { "$ref": "#/$defs/variant_kind" },
        "theme_class": { "$ref": "#/$defs/theme_class" },
        "motion_posture": { "$ref": "#/$defs/motion_posture" },
        "zoom_percent": { "type": "integer", "minimum": 100, "maximum": 400 },
        "baseline_digest": { "$ref": "#/$defs/digest" },
        "baseline_capture_ref": { "$ref": "#/$defs/non_empty_string" },
        "diff_artifact_ref": { "$ref": "#/$defs/non_empty_string" },
        "non_color_meaning_present": { "const": true },
        "focus_visible": { "type": "boolean" }
      }
    },
    "gallery_scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "state",
        "mandatory",
        "display_name",
        "rendered_parts",
        "non_color_cues",
        "status_message_id",
        "interactive",
        "keyboard_journey_ref",
        "assistive_technology_ref",
        "variants"
      ],
      "properties": {
        "scene_id": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/canonical_state_class" },
        "mandatory": { "type": "boolean" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "rendered_parts": { "$ref": "#/$defs/non_empty_string_array" },
        "non_color_cues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "label_text" },
          "items": { "$ref": "#/$defs/non_color_cue_class" }
        },
        "status_message_id": { "$ref": "#/$defs/message_id" },
        "interactive": { "type": "boolean" },
        "keyboard_journey_ref": { "$ref": "#/$defs/non_empty_string" },
        "assistive_technology_ref": { "$ref": "#/$defs/non_empty_string" },
        "variants": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/appearance_variant" }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_kind",
        "component_id",
        "primitive_id",
        "owner_role",
        "display_name",
        "captured_at",
        "evaluated_at",
        "freshness_window_days",
        "freshness",
        "claim_gate",
        "scenes",
        "summary_message_id"
      ],
      "properties": {
        "component_kind": { "$ref": "#/$defs/component_kind" },
        "component_id": { "$ref": "#/$defs/non_empty_string" },
        "primitive_id": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/iso_date" },
        "evaluated_at": { "$ref": "#/$defs/iso_date" },
        "freshness_window_days": { "type": "integer", "minimum": 1 },
        "freshness": { "$ref": "#/$defs/freshness" },
        "claim_gate": { "$ref": "#/$defs/claim_gate" },
        "scenes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/gallery_scene" }
        },
        "summary_message_id": { "$ref": "#/$defs/message_id" }
      }
    }
  }
}
