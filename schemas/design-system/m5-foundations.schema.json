{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-foundations.schema.json",
  "title": "Aureline M5 design-system foundations artifact",
  "description": "Canonical foundations/tokens artifact the M5 design-system contract matrix references. Names the governed token families and their semantic token references, plus the theme, density, and motion-posture vocabularies the foundations span, and the proof lane that blocks drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "foundations_id",
    "owner_role",
    "token_families",
    "theme_classes",
    "density_classes",
    "motion_postures",
    "proof_lane_ref",
    "summary_message_id"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_foundations" },
    "schema_version": { "const": 1 },
    "foundations_id": { "$ref": "#/$defs/non_empty_string" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "token_families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/token_family" }
    },
    "theme_classes": { "$ref": "#/$defs/non_empty_string_array" },
    "density_classes": { "$ref": "#/$defs/non_empty_string_array" },
    "motion_postures": { "$ref": "#/$defs/non_empty_string_array" },
    "proof_lane_ref": { "$ref": "#/$defs/non_empty_string" },
    "summary_message_id": { "$ref": "#/$defs/message_id" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "message_id": { "type": "string", "pattern": "^design_system_contract\\." },
    "token_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "display_name", "semantic_token_refs"],
      "properties": {
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "semantic_token_refs": { "$ref": "#/$defs/non_empty_string_array" }
      }
    }
  }
}
