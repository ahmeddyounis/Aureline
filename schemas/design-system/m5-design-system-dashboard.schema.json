{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-design-system-dashboard.schema.json",
  "title": "Aureline M5 design-system contract dashboard",
  "description": "Compact green/yellow/red projection of the M5 design-system contract matrix. Names the inventory object counts per kind, the stale objects, and for each claimed surface the conformant / retest-pending / uncovered status, the surfaces that auto-narrowed or are blocked, the surfaces carrying active waivers, the active waiver ids, and the exact contract gaps across all surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "matrix_id",
    "report_label",
    "total_objects",
    "objects_by_kind",
    "stale_object_ids",
    "total_surfaces",
    "green_count",
    "yellow_count",
    "red_count",
    "conformant_surface_ids",
    "retest_pending_surface_ids",
    "uncovered_surface_ids",
    "auto_narrowed_surface_ids",
    "blocked_surface_ids",
    "waived_surface_ids",
    "active_waiver_ids",
    "blocks_stable_promotion",
    "contract_gaps",
    "source_contract_refs",
    "dashboard_message_id",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_dashboard" },
    "schema_version": { "const": 1 },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "total_objects": { "type": "integer", "minimum": 0 },
    "objects_by_kind": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_kind_count" }
    },
    "stale_object_ids": { "$ref": "#/$defs/string_array" },
    "total_surfaces": { "type": "integer", "minimum": 0 },
    "green_count": { "type": "integer", "minimum": 0 },
    "yellow_count": { "type": "integer", "minimum": 0 },
    "red_count": { "type": "integer", "minimum": 0 },
    "conformant_surface_ids": { "$ref": "#/$defs/string_array" },
    "retest_pending_surface_ids": { "$ref": "#/$defs/string_array" },
    "uncovered_surface_ids": { "$ref": "#/$defs/string_array" },
    "auto_narrowed_surface_ids": { "$ref": "#/$defs/string_array" },
    "blocked_surface_ids": { "$ref": "#/$defs/string_array" },
    "waived_surface_ids": { "$ref": "#/$defs/string_array" },
    "active_waiver_ids": { "$ref": "#/$defs/string_array" },
    "blocks_stable_promotion": { "type": "boolean" },
    "contract_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract_gap" }
    },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "dashboard_message_id": { "$ref": "#/$defs/message_id" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "message_id": { "type": "string", "pattern": "^design_system_contract\\." },
    "object_kind": {
      "enum": [
        "foundation",
        "component_contract",
        "reference_layout",
        "state_semantic_family",
        "demo_fixture",
        "proof_packet"
      ]
    },
    "gap_kind": { "enum": ["unmapped_object", "missing_proof", "stale_proof"] },
    "object_kind_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_kind", "count"],
      "properties": {
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "contract_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "object_id",
        "object_kind",
        "gap_kind",
        "waived",
        "cause_message_id"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "waived": { "type": "boolean" },
        "cause_message_id": { "$ref": "#/$defs/message_id" }
      }
    }
  }
}
