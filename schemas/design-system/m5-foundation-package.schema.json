{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-foundation-package.schema.json",
  "title": "Aureline M5 design-system foundation package",
  "description": "Versioned, machine-readable foundation package the M5 design system ships and shell code, docs/help, screenshots, and extension guidance all consume. The package carries one family per governed foundation kind (color, spacing, typography, icon, density, motion, contrast, and component-state), each with its own version field and a list of entries. Every entry names a stable semantic token reference and an explicit support state (supported, deprecated, or unsupported); a deprecated or unsupported entry carries the downgrade target and reason so the entry stays inspectable and explicitly downgraded instead of being silently dropped. The density, reduced-motion, power-saving, and high-contrast rows read from this same package rather than from feature-local wiring. The package exports to deterministic JSON for import, diff, and release-packet inclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "package_id",
    "package_version",
    "owner_role",
    "families",
    "proof_lane_ref",
    "release_packet_ref",
    "source_contract_refs",
    "redaction_class_token",
    "summary_message_id",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_foundation_package" },
    "schema_version": { "const": 1 },
    "package_id": { "$ref": "#/$defs/non_empty_string" },
    "package_version": { "$ref": "#/$defs/semver" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "families": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/family" }
    },
    "proof_lane_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "summary_message_id": { "$ref": "#/$defs/message_id" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "message_id": { "type": "string", "pattern": "^design_system_foundation\\." },
    "family_kind": {
      "enum": [
        "color",
        "spacing",
        "typography",
        "icon",
        "density",
        "motion",
        "contrast",
        "component_state"
      ]
    },
    "support_state": { "enum": ["supported", "deprecated", "unsupported"] },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_kind", "family_id", "display_name", "family_version", "entries"],
      "properties": {
        "family_kind": { "$ref": "#/$defs/family_kind" },
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "family_version": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "display_name", "value_token", "support_state"],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "value_token": { "$ref": "#/$defs/non_empty_string" },
        "support_state": { "$ref": "#/$defs/support_state" },
        "downgrade": { "$ref": "#/$defs/downgrade" }
      }
    },
    "downgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downgraded_to", "reason_message_id", "since_package_version"],
      "properties": {
        "downgraded_to": { "$ref": "#/$defs/non_empty_string" },
        "reason_message_id": { "$ref": "#/$defs/message_id" },
        "since_package_version": { "$ref": "#/$defs/semver" }
      }
    }
  }
}
