{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-motion-layer-iconography-surface-certification.schema.json",
  "title": "Aureline M5 motion-layer-iconography surface certification packet",
  "description": "M05-1155 closing capstone certifying that the frozen M5 visual-interaction families (motion-token, reduced-motion, opacity-scrim, layer-order, portal-ownership, iconography, illustration) hold their truth on every claimed M5 desktop / dialog / onboarding / notification / embedded operating profile. Keyed on the claimed profile (live trusted interaction surface, reviewable layer structure, stale-motion-timing surface, unconfirmed reduced-motion surface, orientation-erasing scrim surface, detached-portal surface, impersonating-illustration surface), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, reduced-motion, power-thermal, CLI/export, degraded-state, and visual-interaction-component-truth behavior — and either passes (green), auto-narrows its interaction claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted interaction profile may certify a trusted interaction surface; and every B137 hard invariant must hold (protected input is never delayed by motion, a scrim never erases workspace orientation or contrast, an overlay never bypasses the shared z-order, an unlabeled icon is never used for an uncommon or destructive action, and an illustration never impersonates operational or security truth). Every row cites exactly one canonical visual-interaction proof bundle. The packet is metadata-only: raw duration curves, z-index integers, glyph blobs, credentials, secrets, and endpoint refs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_motion_layer_iconography_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-motion-layer-iconography-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_interaction_surface",
        "reviewable_layer_structure",
        "stale_motion_timing_surface",
        "unconfirmed_reduced_motion_surface",
        "orientation_erasing_scrim_surface",
        "detached_portal_surface",
        "impersonating_illustration_surface"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "reduced_motion",
        "power_thermal",
        "cli_export",
        "degraded_state",
        "visual_interaction_component_truth"
      ]
    },
    "interaction_claim": {
      "enum": [
        "trusted_interaction_surface",
        "reviewable_interaction_surface",
        "motion_timing_unverified_projection",
        "reduced_motion_clamp_unverified_projection",
        "scrim_orientation_unverified_projection",
        "portal_ownership_unverified_projection",
        "illustration_boundary_disclosed_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "interaction_family": {
      "enum": [
        "motion_token",
        "reduced_motion",
        "opacity_scrim",
        "layer_order",
        "portal_ownership",
        "iconography",
        "illustration"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "motion_delayed_protected_input",
        "motion_meaning_lost_under_reduced_motion",
        "scrim_erased_orientation_or_contrast",
        "overlay_bypassed_shared_z_order",
        "portal_detached_from_owning_surface",
        "unlabeled_icon_for_uncommon_or_destructive_action",
        "illustration_impersonated_operational_state",
        "icon_semantics_ambiguous",
        "layer_tier_unstated",
        "semantic_role_unstated",
        "token_reference_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delays_protected_input_with_motion",
        "lets_a_scrim_erase_workspace_orientation_or_contrast",
        "lets_an_overlay_bypass_the_shared_z_order",
        "uses_an_unlabeled_icon_for_an_uncommon_or_destructive_action",
        "lets_an_illustration_impersonate_operational_or_security_truth"
      ],
      "properties": {
        "delays_protected_input_with_motion": { "const": false },
        "lets_a_scrim_erase_workspace_orientation_or_contrast": { "const": false },
        "lets_an_overlay_bypass_the_shared_z_order": { "const": false },
        "uses_an_unlabeled_icon_for_an_uncommon_or_destructive_action": { "const": false },
        "lets_an_illustration_impersonate_operational_or_security_truth": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/interaction_claim" },
        "to_claim": { "$ref": "#/$defs/interaction_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_motion_layer_iconography_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/interaction_claim" },
        "certified_claim": { "$ref": "#/$defs/interaction_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interaction_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-motion-layer-iconography-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
