{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-motion-layer-iconography-matrix.schema.json",
  "title": "Aureline M5 motion-token, reduced-motion, opacity / scrim, layer-order, portal-ownership, iconography, and illustration-boundary visual-interaction matrix",
  "description": "Export-safe packet freezing Aureline's motion, overlay, layering, symbol, and illustration grammar. The packet names every claimed M5 surface that still describes its own animation curves, reduced-motion behavior, scrim / opacity rules, z-order tiers, portal ownership, icon semantics, or illustration limits — across the desktop shell, dialogs, onboarding, notifications, and embedded surfaces — and binds each governed family to the claimed surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, reduced-motion, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each family declares the controlled vocabularies it carries: the single controlled interaction-role vocabulary consumers bind to (motion, overlay, layer, portal, icon, illustration, attention), plus family-specific motion roles, reduced-motion roles, opacity / scrim roles, layer-order roles, portal-ownership roles, iconography roles, and illustration roles. Hard invariants forbid delaying input on protected paths with motion, letting a scrim erase workspace orientation or contrast, letting an overlay bypass the shared z-order model, using an unlabeled icon for an uncommon or destructive action, and letting an illustration impersonate operational or security truth. The matrix binds back to the already-landed design-system foundations and publication packets. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "interaction_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_motion_token_opacity_scrim_layer_order_portal_iconography_and_illustration_boundary_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "interaction_rows": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/interaction_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "interaction_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "interaction_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "interaction_family": {
      "enum": [
        "motion_token",
        "reduced_motion",
        "opacity_scrim",
        "layer_order",
        "portal_ownership",
        "iconography",
        "illustration"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "motion",
        "overlay",
        "layer",
        "portal",
        "icon",
        "illustration",
        "attention"
      ]
    },
    "interaction_row": {
      "type": "object",
      "required": [
        "interaction_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "delays_protected_input_with_motion",
        "scrim_erases_orientation_or_contrast",
        "overlay_bypasses_shared_z_order",
        "uses_unlabeled_icon_for_uncommon_or_destructive_action",
        "lets_illustration_impersonate_operational_or_security_truth"
      ],
      "properties": {
        "interaction_family": {
          "$ref": "#/$defs/interaction_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "motion_roles": {
          "type": "array"
        },
        "reduced_motion_roles": {
          "type": "array"
        },
        "opacity_scrim_roles": {
          "type": "array"
        },
        "layer_order_roles": {
          "type": "array"
        },
        "portal_ownership_roles": {
          "type": "array"
        },
        "iconography_roles": {
          "type": "array"
        },
        "illustration_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "delays_protected_input_with_motion": {
          "const": false
        },
        "scrim_erases_orientation_or_contrast": {
          "const": false
        },
        "overlay_bypasses_shared_z_order": {
          "const": false
        },
        "uses_unlabeled_icon_for_uncommon_or_destructive_action": {
          "const": false
        },
        "lets_illustration_impersonate_operational_or_security_truth": {
          "const": false
        }
      }
    }
  }
}
