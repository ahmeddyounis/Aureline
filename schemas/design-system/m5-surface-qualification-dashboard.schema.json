{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-surface-qualification-dashboard.schema.json",
  "title": "Aureline M5 surface-qualification dashboard",
  "description": "Compact green/yellow/red scoreboard projected from the M5 surface-qualification packet. Help/About surfaces the headline counts and the narrowed/blocked surface ids; the release center and shiproom watch the gate; support exports ship the same descriptor. The dashboard carries no per-surface lane bindings — only the qualified/provisional/disqualified counts, the auto-narrowed/blocked/waived surface ids, the active waiver ids, and the exact gaps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "total_surfaces",
    "green_count",
    "yellow_count",
    "red_count",
    "qualified_surface_ids",
    "provisional_surface_ids",
    "disqualified_surface_ids",
    "auto_narrowed_surface_ids",
    "blocked_surface_ids",
    "waived_surface_ids",
    "active_waiver_ids",
    "blocks_stable_promotion",
    "qualification_gaps",
    "source_contract_refs",
    "dashboard_message_id",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_surface_qualification_dashboard" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "total_surfaces": { "type": "integer", "minimum": 0 },
    "green_count": { "type": "integer", "minimum": 0 },
    "yellow_count": { "type": "integer", "minimum": 0 },
    "red_count": { "type": "integer", "minimum": 0 },
    "qualified_surface_ids": { "$ref": "#/$defs/string_array" },
    "provisional_surface_ids": { "$ref": "#/$defs/string_array" },
    "disqualified_surface_ids": { "$ref": "#/$defs/string_array" },
    "auto_narrowed_surface_ids": { "$ref": "#/$defs/string_array" },
    "blocked_surface_ids": { "$ref": "#/$defs/string_array" },
    "waived_surface_ids": { "$ref": "#/$defs/string_array" },
    "active_waiver_ids": { "$ref": "#/$defs/string_array" },
    "blocks_stable_promotion": { "type": "boolean" },
    "qualification_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualification_gap" }
    },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "dashboard_message_id": { "$ref": "#/$defs/message_id" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "message_id": {
      "type": "string",
      "pattern": "^design_system_qualification\\."
    },
    "lane": {
      "enum": ["foundation", "component_contract", "reference_layout", "evidence"]
    },
    "gap_kind": {
      "enum": [
        "foundation_token_unresolved",
        "foundation_state_unpublished",
        "component_manifest_missing",
        "reference_layout_missing",
        "evidence_stale",
        "evidence_blocked"
      ]
    },
    "qualification_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "lane",
        "gap_kind",
        "subject",
        "waived",
        "cause_message_id"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "lane": { "$ref": "#/$defs/lane" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "subject": { "$ref": "#/$defs/non_empty_string" },
        "waived": { "type": "boolean" },
        "cause_message_id": { "$ref": "#/$defs/message_id" }
      }
    }
  }
}
