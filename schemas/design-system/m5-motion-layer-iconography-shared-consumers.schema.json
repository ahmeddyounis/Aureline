{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-motion-layer-iconography-shared-consumers.schema.json",
  "title": "M5 Visual-Interaction Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the seven B137 visual-interaction families (motion token, reduced motion, opacity/scrim, layer order, portal ownership, iconography, illustration) to the shell / editor / help / marketplace / onboarding / settings / CLI-export / support-export consumers that render them, proving one shared visual-interaction grammar across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_motion_layer_iconography_shared_consumer_grammar_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "interaction_family": {
      "type": "string",
      "enum": [
        "motion_token",
        "reduced_motion",
        "opacity_scrim",
        "layer_order",
        "portal_ownership",
        "iconography",
        "illustration"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "editor_ui",
        "help_ui",
        "marketplace_ui",
        "onboarding_ui",
        "settings_ui",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "grammar_drift_detected",
        "meaning_relied_on_motion_or_decoration_alone",
        "motion_delayed_protected_input",
        "scrim_erased_orientation_or_contrast",
        "overlay_bypassed_shared_z_order",
        "unlabeled_icon_for_destructive_action",
        "illustration_impersonated_operational_truth",
        "canonical_reference_missing",
        "upstream_interaction_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_role_word",
        "family_word",
        "token_reference_word",
        "state_variant_word",
        "surface_context_word",
        "accessible_fallback_word"
      ],
      "properties": {
        "interaction_role_word": {
          "type": "string",
          "enum": [
            "motion",
            "overlay",
            "layer",
            "portal",
            "icon",
            "illustration",
            "attention"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "token_reference_word": { "type": "string", "minLength": 1 },
        "state_variant_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "accessible_fallback_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "interaction_object_id",
        "interaction_object_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "delays_protected_input_with_motion",
        "lets_scrim_erase_orientation_or_contrast",
        "lets_overlay_bypass_shared_z_order",
        "uses_unlabeled_icon_for_uncommon_or_destructive_action",
        "lets_illustration_impersonate_operational_or_security_truth",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "interaction_object_id": { "type": "string", "minLength": 1 },
        "interaction_object_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/interaction_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "delays_protected_input_with_motion": {
          "type": "boolean",
          "const": false
        },
        "lets_scrim_erase_orientation_or_contrast": {
          "type": "boolean",
          "const": false
        },
        "lets_overlay_bypass_shared_z_order": {
          "type": "boolean",
          "const": false
        },
        "uses_unlabeled_icon_for_uncommon_or_destructive_action": {
          "type": "boolean",
          "const": false
        },
        "lets_illustration_impersonate_operational_or_security_truth": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_object_same_grammar_across_surfaces",
        "interaction_role_words_stay_in_frozen_vocabulary",
        "meaning_never_relies_on_motion_or_decoration_alone",
        "motion_never_delays_protected_input",
        "scrims_never_erase_orientation_or_contrast",
        "overlays_never_bypass_shared_z_order",
        "icons_never_unlabeled_for_uncommon_or_destructive_actions",
        "illustrations_never_impersonate_operational_truth",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_object_same_grammar_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "interaction_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "meaning_never_relies_on_motion_or_decoration_alone": {
          "type": "boolean",
          "const": true
        },
        "motion_never_delays_protected_input": {
          "type": "boolean",
          "const": true
        },
        "scrims_never_erase_orientation_or_contrast": {
          "type": "boolean",
          "const": true
        },
        "overlays_never_bypass_shared_z_order": {
          "type": "boolean",
          "const": true
        },
        "icons_never_unlabeled_for_uncommon_or_destructive_actions": {
          "type": "boolean",
          "const": true
        },
        "illustrations_never_impersonate_operational_truth": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_ui_consumes_shared_grammar",
        "editor_ui_consumes_shared_grammar",
        "help_ui_consumes_shared_grammar",
        "marketplace_ui_consumes_shared_grammar",
        "onboarding_ui_consumes_shared_grammar",
        "settings_ui_consumes_shared_grammar",
        "support_export_consumes_shared_grammar",
        "every_family_adopted_by_two_or_more_consumers",
        "grammar_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_interaction_family"
      ],
      "properties": {
        "shell_ui_consumes_shared_grammar": {
          "type": "boolean",
          "const": true
        },
        "editor_ui_consumes_shared_grammar": {
          "type": "boolean",
          "const": true
        },
        "help_ui_consumes_shared_grammar": {
          "type": "boolean",
          "const": true
        },
        "marketplace_ui_consumes_shared_grammar": {
          "type": "boolean",
          "const": true
        },
        "onboarding_ui_consumes_shared_grammar": {
          "type": "boolean",
          "const": true
        },
        "settings_ui_consumes_shared_grammar": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_grammar": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "grammar_identical_for_same_object": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_interaction_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
