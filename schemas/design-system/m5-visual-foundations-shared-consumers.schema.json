{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-visual-foundations-shared-consumers.schema.json",
  "title": "M5 Visual-Foundation Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the eight B136 visual-foundation families (color system, semantic theme token, syntax token, diff token, chart token, typography, spacing/sizing/radii/elevation geometry, hit target) to the shell / editor / review / data / docs / settings / CLI-export / support-export consumers that render them, proving one shared visual vocabulary across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_visual_foundations_shared_consumer_vocabulary_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "foundation_family": {
      "type": "string",
      "enum": [
        "color_system",
        "semantic_theme_token",
        "syntax_token",
        "diff_token",
        "chart_token",
        "typography",
        "spacing_sizing_radii_elevation",
        "hit_target"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "editor_ui",
        "review_ui",
        "data_ui",
        "docs_ui",
        "settings_ui",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "vocabulary_drift_detected",
        "hue_alone_used_for_meaning",
        "syntax_or_diff_collided_with_diagnostics",
        "hit_target_shrunk_below_minimum",
        "chart_meaning_depended_on_color_alone",
        "local_geometry_forked_from_foundation",
        "canonical_reference_missing",
        "upstream_foundation_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_role_word",
        "family_word",
        "token_reference_word",
        "theme_variant_word",
        "density_context_word",
        "non_color_cue_word"
      ],
      "properties": {
        "semantic_role_word": {
          "type": "string",
          "enum": [
            "brand",
            "interactive",
            "neutral",
            "status",
            "syntax",
            "diff",
            "chart"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "token_reference_word": { "type": "string", "minLength": 1 },
        "theme_variant_word": { "type": "string", "minLength": 1 },
        "density_context_word": { "type": "string", "minLength": 1 },
        "non_color_cue_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "foundation_object_id",
        "foundation_object_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "relies_on_hue_alone_for_meaning",
        "lets_syntax_or_diff_palette_collide_with_diagnostics",
        "shrinks_hit_target_below_supported_minimum",
        "lets_chart_meaning_depend_on_color_alone",
        "forks_local_spacing_or_elevation_from_shared_geometry",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "foundation_object_id": { "type": "string", "minLength": 1 },
        "foundation_object_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/foundation_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "relies_on_hue_alone_for_meaning": {
          "type": "boolean",
          "const": false
        },
        "lets_syntax_or_diff_palette_collide_with_diagnostics": {
          "type": "boolean",
          "const": false
        },
        "shrinks_hit_target_below_supported_minimum": {
          "type": "boolean",
          "const": false
        },
        "lets_chart_meaning_depend_on_color_alone": {
          "type": "boolean",
          "const": false
        },
        "forks_local_spacing_or_elevation_from_shared_geometry": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_object_same_vocabulary_across_surfaces",
        "semantic_role_words_stay_in_frozen_vocabulary",
        "meaning_never_relies_on_hue_alone",
        "syntax_diff_never_collide_with_diagnostics",
        "chart_meaning_never_depends_on_color_alone",
        "hit_targets_never_shrink_below_minimum",
        "geometry_never_forks_from_shared_foundation",
        "typography_and_geometry_stay_density_aware",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_object_same_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "semantic_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "meaning_never_relies_on_hue_alone": {
          "type": "boolean",
          "const": true
        },
        "syntax_diff_never_collide_with_diagnostics": {
          "type": "boolean",
          "const": true
        },
        "chart_meaning_never_depends_on_color_alone": {
          "type": "boolean",
          "const": true
        },
        "hit_targets_never_shrink_below_minimum": {
          "type": "boolean",
          "const": true
        },
        "geometry_never_forks_from_shared_foundation": {
          "type": "boolean",
          "const": true
        },
        "typography_and_geometry_stay_density_aware": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_ui_consumes_shared_foundation",
        "editor_ui_consumes_shared_foundation",
        "review_ui_consumes_shared_foundation",
        "data_ui_consumes_shared_foundation",
        "docs_ui_consumes_shared_foundation",
        "settings_ui_consumes_shared_foundation",
        "support_export_consumes_shared_foundation",
        "every_family_adopted_by_two_or_more_consumers",
        "vocabulary_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_foundation_family"
      ],
      "properties": {
        "shell_ui_consumes_shared_foundation": {
          "type": "boolean",
          "const": true
        },
        "editor_ui_consumes_shared_foundation": {
          "type": "boolean",
          "const": true
        },
        "review_ui_consumes_shared_foundation": {
          "type": "boolean",
          "const": true
        },
        "data_ui_consumes_shared_foundation": {
          "type": "boolean",
          "const": true
        },
        "docs_ui_consumes_shared_foundation": {
          "type": "boolean",
          "const": true
        },
        "settings_ui_consumes_shared_foundation": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_foundation": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "vocabulary_identical_for_same_object": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_foundation_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
