{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-reference-layout.schema.json",
  "title": "Aureline M5 design-system reference layout artifact",
  "description": "Canonical reference-layout artifact the M5 design-system contract matrix references. Names the governed shell slots, their landmark roles, and their placeholder behavior, plus the placeholder policy for empty and loading slots so shell-slot and placeholder behavior stays consistent across new M5 families.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "layout_id",
    "display_name",
    "owner_role",
    "shell_slots",
    "placeholder_policy",
    "summary_message_id"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_reference_layout" },
    "schema_version": { "const": 1 },
    "layout_id": { "$ref": "#/$defs/non_empty_string" },
    "display_name": { "$ref": "#/$defs/non_empty_string" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "shell_slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shell_slot" }
    },
    "placeholder_policy": { "$ref": "#/$defs/placeholder_policy" },
    "summary_message_id": { "$ref": "#/$defs/message_id" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "pattern": "^design_system_contract\\." },
    "shell_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "role", "placeholder_behavior"],
      "properties": {
        "slot_id": { "$ref": "#/$defs/non_empty_string" },
        "role": { "$ref": "#/$defs/non_empty_string" },
        "placeholder_behavior": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "placeholder_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["empty_slot_rule", "loading_slot_rule"],
      "properties": {
        "empty_slot_rule": { "$ref": "#/$defs/non_empty_string" },
        "loading_slot_rule": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
