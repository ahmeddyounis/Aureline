{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-host-primitive.schema.json",
  "title": "Aureline M5 design-system host-rendered primitive library",
  "description": "Versioned, machine-readable library of host-rendered primitives for the launch-critical M5 component families (placeholder cards, state blocks, review sheets, durable job rows, boundary bars, form controls, and dense collection primitives). Each primitive is the single shared implementation every M5 surface routes through instead of forking a per-feature variant: it inherits its component manifest's component id, accessibility role, keyboard chords, and foundation token references; declares a render plan per controlled state (with the parts it renders, the non-color cues it carries, and whether the state is interactive); preserves the shared density, motion, and contrast vocabulary; and routes a set of M5 family surfaces through the same implementation, each with a conformance posture so embedded or extension consumers either inherit the host-rendered primitive or declare a reduced posture behind an explicit partial badge. The records are metadata-only: they carry semantic token references and message ids, never raw color values, credential bodies, or provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "library_id",
    "library_version",
    "owner_role",
    "primitives",
    "proof_lane_ref",
    "release_packet_ref",
    "source_contract_refs",
    "redaction_class_token",
    "summary_message_id",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_host_primitive_library" },
    "schema_version": { "const": 1 },
    "library_id": { "$ref": "#/$defs/non_empty_string" },
    "library_version": { "$ref": "#/$defs/semver" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "primitives": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/primitive" }
    },
    "proof_lane_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "summary_message_id": { "$ref": "#/$defs/message_id" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "message_id": { "type": "string", "pattern": "^design_system_primitive\\." },
    "component_kind": {
      "enum": [
        "placeholder_card",
        "state_block",
        "review_sheet",
        "job_row",
        "boundary_bar",
        "form_control",
        "dense_collection"
      ]
    },
    "canonical_state_class": {
      "enum": [
        "empty",
        "loading",
        "pending",
        "degraded",
        "blocked",
        "error",
        "completed"
      ]
    },
    "non_color_cue_class": {
      "enum": [
        "label_text",
        "icon",
        "border",
        "shape",
        "progress_indicator",
        "lock_or_shield_glyph",
        "check_or_selection_marker"
      ]
    },
    "density_class": {
      "enum": ["compact", "standard", "comfortable"]
    },
    "motion_posture": {
      "enum": [
        "motion_standard",
        "motion_reduced",
        "motion_low_motion",
        "motion_power_saver",
        "motion_critical_hot_path"
      ]
    },
    "contrast_class": {
      "enum": [
        "dark_reference",
        "light_parity",
        "high_contrast_dark",
        "high_contrast_light"
      ]
    },
    "consumer_class": {
      "enum": [
        "host_chrome",
        "first_party",
        "provider_backed",
        "extension_contributed"
      ]
    },
    "conformance_posture": {
      "enum": ["inherited_host_rendered", "reduced_with_partial_badge"]
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_kind",
        "primitive_id",
        "component_id",
        "display_name",
        "accessibility_role",
        "keyboard_chords",
        "token_references",
        "state_render_plans",
        "appearance",
        "consumers",
        "summary_message_id"
      ],
      "properties": {
        "component_kind": { "$ref": "#/$defs/component_kind" },
        "primitive_id": { "$ref": "#/$defs/non_empty_string" },
        "component_id": { "$ref": "#/$defs/non_empty_string" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "accessibility_role": { "$ref": "#/$defs/non_empty_string" },
        "keyboard_chords": { "$ref": "#/$defs/non_empty_string_array" },
        "token_references": { "$ref": "#/$defs/non_empty_string_array" },
        "state_render_plans": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/state_render_plan" }
        },
        "appearance": { "$ref": "#/$defs/appearance_binding" },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer" }
        },
        "summary_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "state_render_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "mandatory",
        "rendered_parts",
        "non_color_cues",
        "status_message_id",
        "interactive"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/canonical_state_class" },
        "mandatory": { "type": "boolean" },
        "rendered_parts": { "$ref": "#/$defs/non_empty_string_array" },
        "non_color_cues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "label_text" },
          "items": { "$ref": "#/$defs/non_color_cue_class" }
        },
        "status_message_id": { "$ref": "#/$defs/message_id" },
        "interactive": { "type": "boolean" }
      }
    },
    "appearance_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density_classes",
        "motion_postures",
        "contrast_classes",
        "honors_focus_order",
        "honors_keyboard_model",
        "honors_high_contrast",
        "honors_reduced_motion"
      ],
      "properties": {
        "density_classes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/density_class" }
        },
        "motion_postures": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/motion_posture" }
        },
        "contrast_classes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contrast_class" }
        },
        "honors_focus_order": { "const": true },
        "honors_keyboard_model": { "const": true },
        "honors_high_contrast": { "const": true },
        "honors_reduced_motion": { "const": true }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_class", "display_name", "consumer_class", "posture"],
      "properties": {
        "surface_class": { "$ref": "#/$defs/non_empty_string" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "consumer_class": { "$ref": "#/$defs/consumer_class" },
        "posture": { "$ref": "#/$defs/conformance_posture" },
        "partial_badge_message_id": { "$ref": "#/$defs/message_id" }
      },
      "allOf": [
        {
          "comment": "A reduced consumer must carry a partial badge and be embedded or extension-backed; it can never read as first-party parity.",
          "if": {
            "properties": {
              "posture": { "const": "reduced_with_partial_badge" }
            },
            "required": ["posture"]
          },
          "then": {
            "required": ["partial_badge_message_id"],
            "properties": {
              "consumer_class": {
                "enum": ["provider_backed", "extension_contributed"]
              }
            }
          }
        },
        {
          "comment": "An inherited consumer renders the host primitive verbatim and carries no partial badge.",
          "if": {
            "properties": {
              "posture": { "const": "inherited_host_rendered" }
            },
            "required": ["posture"]
          },
          "then": {
            "not": { "required": ["partial_badge_message_id"] }
          }
        }
      ]
    }
  }
}
