{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-component-contract.schema.json",
  "title": "Aureline M5 design-system component contract artifact",
  "description": "Canonical launch-critical component-contract artifact the M5 design-system contract matrix references. A launch-critical component declares its anatomy, the state-semantic families it renders, its keyboard model, its accessibility contract (role, screen-reader label rule, focus-order rule), its semantic token dependencies, and the extension-SDK guidance extenders read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "display_name",
    "surface_class",
    "owner_role",
    "anatomy",
    "states",
    "keyboard_model",
    "accessibility",
    "token_dependencies",
    "extension_guidance_ref",
    "summary_message_id"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_component_contract" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/non_empty_string" },
    "display_name": { "$ref": "#/$defs/non_empty_string" },
    "surface_class": { "$ref": "#/$defs/launch_surface_class" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/anatomy_part" }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/canonical_state_class" }
    },
    "keyboard_model": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/key_binding" }
    },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "token_dependencies": { "$ref": "#/$defs/non_empty_string_array" },
    "extension_guidance_ref": { "$ref": "#/$defs/non_empty_string" },
    "summary_message_id": { "$ref": "#/$defs/message_id" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "message_id": { "type": "string", "pattern": "^design_system_contract\\." },
    "launch_surface_class": {
      "enum": [
        "shell_chrome",
        "start_center",
        "command_palette",
        "search_surface",
        "dialog_sheet",
        "trust_prompt",
        "notification_envelope",
        "help_about_row",
        "settings_root",
        "activity_center_row"
      ]
    },
    "canonical_state_class": {
      "enum": [
        "empty",
        "loading",
        "pending",
        "degraded",
        "blocked",
        "error",
        "completed"
      ]
    },
    "anatomy_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "role"],
      "properties": {
        "part_id": { "$ref": "#/$defs/non_empty_string" },
        "role": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "key_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "action"],
      "properties": {
        "keys": { "$ref": "#/$defs/non_empty_string" },
        "action": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "screen_reader_label_rule", "focus_order_rule"],
      "properties": {
        "role": { "$ref": "#/$defs/non_empty_string" },
        "screen_reader_label_rule": { "$ref": "#/$defs/non_empty_string" },
        "focus_order_rule": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
