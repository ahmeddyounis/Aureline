{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-design-system-contract-matrix.schema.json",
  "title": "Aureline M5 design-system contract matrix",
  "description": "Frozen design-system contract matrix for the claimed M5 surfaces. The packet has two coordinated halves: a governed inventory of contract objects (foundations/tokens, component contracts, reference layouts, state-semantic families, demo fixtures, and proof packets), each naming its owner, first consumer, canonical artifact, release packet, and the proof lane that blocks drift; and a claimed-surface coverage gate that maps each surface to the contract objects it must point at, resolves a green/yellow/red traffic-light status (conformant / retest-pending / uncovered), and resolves a release-gate decision: a surface that lacks a mapped contract object is blocked from Stable promotion and named, while a surface whose mapped object has stale design-system proof auto-narrows below Stable before promotion. Blocking gaps can be accepted under an active, disclosed waiver scoped to a single object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "matrix_id",
    "report_label",
    "contract_objects",
    "surfaces",
    "vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "release_gate",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_contract_matrix" },
    "schema_version": { "const": 1 },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "contract_objects": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/contract_object" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_coverage_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "conformance_review": { "$ref": "#/$defs/conformance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_gate": { "$ref": "#/$defs/release_gate" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "message_id": {
      "type": "string",
      "pattern": "^design_system_contract\\."
    },
    "object_kind": {
      "enum": [
        "foundation",
        "component_contract",
        "reference_layout",
        "state_semantic_family",
        "demo_fixture",
        "proof_packet"
      ]
    },
    "consumer": {
      "enum": [
        "shell",
        "help",
        "onboarding",
        "presentation",
        "extension_sdk",
        "release_center",
        "qa",
        "support_export",
        "stable_claim_matrix"
      ]
    },
    "proof_freshness_state": { "enum": ["current", "stale", "missing"] },
    "coverage_status": { "enum": ["conformant", "retest_pending", "uncovered"] },
    "coverage_signal": { "enum": ["green", "yellow", "red"] },
    "coverage_gate_decision": {
      "enum": ["certified_promote", "auto_narrowed", "blocked"]
    },
    "claim_class": {
      "enum": ["stable", "beta", "preview", "experimental", "held", "unavailable"]
    },
    "gap_kind": { "enum": ["unmapped_object", "missing_proof", "stale_proof"] },
    "launch_surface_class": {
      "enum": [
        "shell_chrome",
        "start_center",
        "command_palette",
        "search_surface",
        "dialog_sheet",
        "trust_prompt",
        "notification_envelope",
        "help_about_row",
        "settings_root",
        "activity_center_row"
      ]
    },
    "contract_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "object_kind",
        "display_name",
        "owner_role",
        "first_consumer",
        "canonical_artifact_ref",
        "schema_ref",
        "release_packet_ref",
        "proof_lane_ref",
        "extension_guidance_ref",
        "proof_freshness",
        "summary_message_id"
      ],
      "properties": {
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "display_name": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "first_consumer": { "$ref": "#/$defs/consumer" },
        "canonical_artifact_ref": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_lane_ref": { "$ref": "#/$defs/non_empty_string" },
        "extension_guidance_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_freshness": { "$ref": "#/$defs/proof_freshness_state" },
        "summary_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "required_contract_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "object_kind"],
      "properties": {
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" }
      }
    },
    "contract_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "object_id",
        "object_kind",
        "gap_kind",
        "waived",
        "cause_message_id"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "waived": { "type": "boolean" },
        "cause_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "coverage_waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiver_id",
        "object_id",
        "reason_message_id",
        "owner_role",
        "expires_at",
        "narrowed_to"
      ],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "reason_message_id": { "$ref": "#/$defs/message_id" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "narrowed_to": {
          "enum": ["beta", "preview", "experimental", "held", "unavailable"]
        }
      }
    },
    "surface_coverage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_class",
        "surface_label",
        "owner_role",
        "claimed_class",
        "effective_class",
        "coverage_status",
        "signal",
        "required_objects",
        "waivers",
        "gate_decision",
        "gaps",
        "consumer_surfaces",
        "source_contract_refs",
        "status_message_id",
        "gate_message_id"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_class": { "$ref": "#/$defs/launch_surface_class" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "claimed_class": { "const": "stable" },
        "effective_class": { "$ref": "#/$defs/claim_class" },
        "coverage_status": { "$ref": "#/$defs/coverage_status" },
        "signal": { "$ref": "#/$defs/coverage_signal" },
        "required_objects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/required_contract_object" }
        },
        "waivers": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_waiver" }
        },
        "gate_decision": { "$ref": "#/$defs/coverage_gate_decision" },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/contract_gap" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer" }
        },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "status_message_id": { "$ref": "#/$defs/message_id" },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_kinds",
        "consumers",
        "proof_freshness_states",
        "coverage_statuses",
        "coverage_signals",
        "coverage_gate_decisions",
        "claim_classes",
        "gap_kinds",
        "state_semantic_families",
        "launch_surface_classes",
        "cue_families"
      ],
      "properties": {
        "object_kinds": { "$ref": "#/$defs/non_empty_string_array" },
        "consumers": { "$ref": "#/$defs/non_empty_string_array" },
        "proof_freshness_states": { "$ref": "#/$defs/non_empty_string_array" },
        "coverage_statuses": { "$ref": "#/$defs/non_empty_string_array" },
        "coverage_signals": { "$ref": "#/$defs/non_empty_string_array" },
        "coverage_gate_decisions": { "$ref": "#/$defs/non_empty_string_array" },
        "claim_classes": { "$ref": "#/$defs/non_empty_string_array" },
        "gap_kinds": { "$ref": "#/$defs/non_empty_string_array" },
        "state_semantic_families": { "$ref": "#/$defs/non_empty_string_array" },
        "launch_surface_classes": { "$ref": "#/$defs/non_empty_string_array" },
        "cue_families": { "$ref": "#/$defs/non_empty_string_array" }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_object_named_with_owner_and_first_consumer",
        "foundations_object_published",
        "component_contracts_object_published",
        "reference_layouts_object_published",
        "state_semantic_families_object_published",
        "demo_fixtures_object_published",
        "proof_packets_object_published",
        "every_object_binds_canonical_artifact_and_proof_lane",
        "every_object_binds_release_packet",
        "component_contracts_declare_anatomy_states_keyboard_a11y_tokens_extension",
        "every_claimed_surface_maps_required_objects",
        "unmapped_object_blocks_stable_promotion",
        "stale_or_missing_proof_auto_narrows_before_stable",
        "waivers_disclosed_with_scope_owner_and_expiry",
        "exact_contract_gaps_named",
        "dashboard_traffic_light_matches_rows",
        "machine_readable_contract_shared_not_restated",
        "support_export_carries_no_raw_boundary_material"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_consumes_contract",
        "help_documents_contract",
        "onboarding_reflects_contract",
        "presentation_reflects_contract",
        "extension_sdk_consumes_contract",
        "release_center_consumes_contract",
        "qa_gates_on_contract",
        "support_export_consumes_contract",
        "stable_claim_matrix_reads_contract"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_stable_promotion",
        "blocked_surface_ids",
        "auto_narrowed_surface_ids",
        "conformant_surface_ids",
        "waived_surface_ids",
        "gate_message_id"
      ],
      "properties": {
        "blocks_stable_promotion": { "type": "boolean" },
        "blocked_surface_ids": { "$ref": "#/$defs/string_array" },
        "auto_narrowed_surface_ids": { "$ref": "#/$defs/string_array" },
        "conformant_surface_ids": { "$ref": "#/$defs/string_array" },
        "waived_surface_ids": { "$ref": "#/$defs/string_array" },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required",
        "stable_promotion_blocks_without_mapped_object"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "mirror_offline_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "mirror_offline_parity_required": { "const": true },
        "stable_promotion_blocks_without_mapped_object": { "const": true }
      }
    }
  }
}
