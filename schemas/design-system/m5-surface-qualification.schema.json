{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-surface-qualification.schema.json",
  "title": "Aureline M5 surface-qualification packet",
  "description": "Integrating qualification packet that ties each claimed M5 workspace surface to the four governed design-system lanes — the foundation package, the component-manifest package, the reference-layout package, and the visual/accessibility evidence pack — and derives a green/yellow/red qualification verdict from them. A surface whose bound contract artifact is missing is disqualified and blocked from Stable promotion (and named, never hidden); a surface whose evidence proof is stale or whose token/state conformance fails is provisional and auto-narrows below Stable before promotion. Blocking gaps can be accepted under an active, disclosed waiver scoped to a single gap, which ships the surface at the waived claim while its true status stays red. Help/About, the release center, shiproom, support exports, and the stable-claim matrix consume the same packet and its dashboard projection rather than parallel spreadsheets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "lane_sources",
    "surfaces",
    "vocabulary_set",
    "conformance_review",
    "consumer_projection",
    "release_gate",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_design_system_surface_qualification" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "lane_sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/lane_source" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_qualification" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "conformance_review": { "$ref": "#/$defs/conformance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_gate": { "$ref": "#/$defs/release_gate" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "message_id": {
      "type": "string",
      "pattern": "^design_system_qualification\\."
    },
    "lane": {
      "enum": ["foundation", "component_contract", "reference_layout", "evidence"]
    },
    "lane_conformance": {
      "enum": ["conformant", "stale", "nonconformant", "missing"]
    },
    "qualification_status": {
      "enum": ["qualified", "provisional", "disqualified"]
    },
    "signal": { "enum": ["green", "yellow", "red"] },
    "gate_decision": {
      "enum": ["certified_promote", "auto_narrowed", "blocked"]
    },
    "gap_kind": {
      "enum": [
        "foundation_token_unresolved",
        "foundation_state_unpublished",
        "component_manifest_missing",
        "reference_layout_missing",
        "evidence_stale",
        "evidence_blocked"
      ]
    },
    "consumer": {
      "enum": [
        "help_about",
        "release_center",
        "shiproom",
        "support_export",
        "stable_claim_matrix"
      ]
    },
    "claim_class": {
      "enum": ["stable", "beta", "preview", "experimental", "held", "unavailable"]
    },
    "workspace_kind": {
      "enum": [
        "notebook",
        "data_grid",
        "profiler",
        "pipeline",
        "docs",
        "preview",
        "incident",
        "companion"
      ]
    },
    "component_kind": {
      "enum": [
        "placeholder_card",
        "state_block",
        "review_sheet",
        "job_row",
        "boundary_bar",
        "form_control",
        "dense_collection"
      ]
    },
    "lane_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "source_ref", "schema_ref", "source_id", "source_version"],
      "properties": {
        "lane": { "$ref": "#/$defs/lane" },
        "source_ref": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_id": { "$ref": "#/$defs/non_empty_string" },
        "source_version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "lane_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "source_ref",
        "schema_ref",
        "source_version",
        "conformance",
        "detail_message_id"
      ],
      "properties": {
        "lane": { "$ref": "#/$defs/lane" },
        "source_ref": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_version": { "$ref": "#/$defs/non_empty_string" },
        "conformance": { "$ref": "#/$defs/lane_conformance" },
        "detail_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "qualification_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "lane",
        "gap_kind",
        "subject",
        "waived",
        "cause_message_id"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "lane": { "$ref": "#/$defs/lane" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "subject": { "$ref": "#/$defs/non_empty_string" },
        "waived": { "type": "boolean" },
        "cause_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "qualification_waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiver_id",
        "gap_kind",
        "subject",
        "reason_message_id",
        "owner_role",
        "expires_at",
        "narrowed_to"
      ],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "subject": { "$ref": "#/$defs/non_empty_string" },
        "reason_message_id": { "$ref": "#/$defs/message_id" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "narrowed_to": {
          "enum": ["beta", "preview", "experimental", "held", "unavailable"]
        }
      }
    },
    "surface_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "workspace_kind",
        "surface_label",
        "owner_role",
        "bound_component_kinds",
        "claimed_class",
        "effective_class",
        "status",
        "signal",
        "gate_decision",
        "lane_bindings",
        "waivers",
        "gaps",
        "consumer_surfaces",
        "status_message_id",
        "gate_message_id"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/non_empty_string" },
        "workspace_kind": { "$ref": "#/$defs/workspace_kind" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "bound_component_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_kind" }
        },
        "claimed_class": { "const": "stable" },
        "effective_class": { "$ref": "#/$defs/claim_class" },
        "status": { "$ref": "#/$defs/qualification_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gate_decision": { "$ref": "#/$defs/gate_decision" },
        "lane_bindings": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/lane_binding" }
        },
        "waivers": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualification_waiver" }
        },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualification_gap" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer" }
        },
        "status_message_id": { "$ref": "#/$defs/message_id" },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lanes",
        "lane_conformances",
        "qualification_statuses",
        "signals",
        "gate_decisions",
        "gap_kinds",
        "consumers",
        "claim_classes",
        "workspace_kinds",
        "component_kinds"
      ],
      "properties": {
        "lanes": { "$ref": "#/$defs/non_empty_string_array" },
        "lane_conformances": { "$ref": "#/$defs/non_empty_string_array" },
        "qualification_statuses": { "$ref": "#/$defs/non_empty_string_array" },
        "signals": { "$ref": "#/$defs/non_empty_string_array" },
        "gate_decisions": { "$ref": "#/$defs/non_empty_string_array" },
        "gap_kinds": { "$ref": "#/$defs/non_empty_string_array" },
        "consumers": { "$ref": "#/$defs/non_empty_string_array" },
        "claim_classes": { "$ref": "#/$defs/non_empty_string_array" },
        "workspace_kinds": { "$ref": "#/$defs/non_empty_string_array" },
        "component_kinds": { "$ref": "#/$defs/non_empty_string_array" }
      }
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_surface_binds_all_four_lanes",
        "every_surface_names_bound_component_families",
        "token_state_conformance_computed_from_foundation",
        "missing_contract_blocks_stable_promotion",
        "stale_or_failing_conformance_auto_narrows_before_stable",
        "waivers_disclosed_with_scope_owner_and_expiry",
        "exact_gaps_named",
        "dashboard_traffic_light_matches_rows",
        "generated_from_checked_in_lane_contracts",
        "support_export_carries_no_raw_boundary_material"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "help_about_surfaces_qualification",
        "release_center_gates_on_qualification",
        "shiproom_watches_qualification_dashboard",
        "support_export_ships_qualification",
        "stable_claim_matrix_reads_effective_claim"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_stable_promotion",
        "blocked_surface_ids",
        "auto_narrowed_surface_ids",
        "qualified_surface_ids",
        "waived_surface_ids",
        "gate_message_id"
      ],
      "properties": {
        "blocks_stable_promotion": { "type": "boolean" },
        "blocked_surface_ids": { "$ref": "#/$defs/string_array" },
        "auto_narrowed_surface_ids": { "$ref": "#/$defs/string_array" },
        "qualified_surface_ids": { "$ref": "#/$defs/string_array" },
        "waived_surface_ids": { "$ref": "#/$defs/string_array" },
        "gate_message_id": { "$ref": "#/$defs/message_id" }
      }
    }
  }
}
