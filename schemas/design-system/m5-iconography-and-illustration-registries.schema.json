{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-iconography-and-illustration-registries.schema.json",
  "title": "Aureline M5 iconography and illustration registries",
  "description": "Export-safe packet for the icon / illustration implement lane over the frozen M5 motion / layer / iconography matrix. It carries resolved, honest projections of the iconography and illustration-boundary interaction families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved icon entries (naming a canonical token, a semantic role, an iconography role, a shell/action/status/navigation/file-type/trust-overlay meaning class, an accessible text equivalent, a stable metaphor, and a distinct file-type-versus-shell/status boundary) and resolved illustration entries (naming a canonical token, an illustration role, a semantic role, a placement, staying secondary to content and never impersonating operational or security truth or replacing the operational messaging). Hard invariants forbid an uncommon or destructive action using an unlabeled icon, file-type and shell/status meaning collapsing together, an illustration impersonating operational or security truth, and a private icon or illustration grammar inlined instead of a canonical token. Acceptance criteria — the first shell/explorer/tab/result-row/onboarding consumers show stable icon semantics with accessible labels and no private grammar, file-type versus shell/status meaning stays distinct, and onboarding/empty-state illustration never replaces operational messaging or trust explanations — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_iconography_and_illustration_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "interaction_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "interaction_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "icon_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_demands_accessible_fallback",
        "iconography_role",
        "iconography_role_is_unlabeled_disallowed",
        "meaning_class",
        "meaning_class_is_classified",
        "meaning_class_is_boundary_sensitive",
        "surface_context",
        "has_accessible_text_equivalent",
        "reuses_stable_metaphor",
        "boundary_distinct",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "icon_semantics_hold"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_accessible_fallback": { "type": "boolean" },
        "iconography_role": { "$ref": "#/$defs/non_empty_string" },
        "iconography_role_is_unlabeled_disallowed": { "type": "boolean" },
        "meaning_class": { "$ref": "#/$defs/non_empty_string" },
        "meaning_class_is_classified": { "type": "boolean" },
        "meaning_class_is_boundary_sensitive": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "has_accessible_text_equivalent": { "type": "boolean" },
        "reuses_stable_metaphor": { "type": "boolean" },
        "boundary_distinct": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "icon_semantics_hold": { "type": "boolean" }
      }
    },
    "illustration_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "illustration_role",
        "illustration_role_is_operational_truth_disallowed",
        "semantic_role",
        "semantic_role_demands_accessible_fallback",
        "placement",
        "placement_present",
        "surface_context",
        "stays_secondary_to_content",
        "never_impersonates_operational_or_security_truth",
        "replaces_operational_messaging",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "illustration_boundary_preserved"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "illustration_role": { "$ref": "#/$defs/non_empty_string" },
        "illustration_role_is_operational_truth_disallowed": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_accessible_fallback": { "type": "boolean" },
        "placement": { "$ref": "#/$defs/non_empty_string" },
        "placement_present": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "stays_secondary_to_content": { "type": "boolean" },
        "never_impersonates_operational_or_security_truth": { "type": "boolean" },
        "replaces_operational_messaging": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "illustration_boundary_preserved": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "icon_entries",
        "illustration_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "icon_uses_unlabeled_symbol_for_uncommon_or_destructive_action",
        "file_type_and_shell_status_meaning_collapsed",
        "illustration_impersonates_operational_or_security_truth",
        "private_icon_or_illustration_grammar_instead_of_token"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "icon_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/icon_entry" }
        },
        "illustration_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/illustration_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "icon_uses_unlabeled_symbol_for_uncommon_or_destructive_action": { "const": false },
        "file_type_and_shell_status_meaning_collapsed": { "const": false },
        "illustration_impersonates_operational_or_security_truth": { "const": false },
        "private_icon_or_illustration_grammar_instead_of_token": { "const": false }
      }
    }
  }
}
