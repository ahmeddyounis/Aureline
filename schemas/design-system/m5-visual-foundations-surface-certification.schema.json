{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-visual-foundations-surface-certification.schema.json",
  "title": "Aureline M5 visual-foundations surface certification packet",
  "description": "M05-1147 closing capstone certifying that the frozen M5 visual-foundation families (color-system, semantic-theme-token, syntax-token, diff-token, chart-token, typography, spacing-sizing-radii-elevation, hit-target) hold their truth on every claimed M5 shell / editor / review / data / docs operating profile. Keyed on the claimed profile (live trusted visual surface, reviewable geometry structure, stale-contrast color surface, unpaired theme-token surface, colliding-diff surface, color-only chart surface, drifting-typography surface, undisclosed hit-target surface), each row certifies the profile across eight truth axes — visual, keyboard, screen-reader, high-zoom-reflow, reduced-motion, CLI/export, degraded-state, and visual-foundation-component-truth behavior — and either passes (green), auto-narrows its visual claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted visual profile may certify a trusted visual surface; and every B136 hard invariant must hold (status or trust meaning is never collapsed into color alone, a syntax or diff palette never collides with diagnostics, a hit target is never shrunk below its supported minimum, chart meaning never depends on color alone, and local spacing or elevation never forks from the shared geometry). Every row cites exactly one canonical visual-foundation proof bundle. The packet is metadata-only: raw hex values, font blobs, credentials, secrets, and endpoint refs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_visual_foundations_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-visual-foundations-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_visual_surface",
        "reviewable_geometry_structure",
        "stale_contrast_color_surface",
        "unpaired_theme_token_surface",
        "colliding_diff_surface",
        "color_only_chart_surface",
        "drifting_typography_surface",
        "undisclosed_hit_target_surface"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "reduced_motion",
        "cli_export",
        "degraded_state",
        "visual_foundation_component_truth"
      ]
    },
    "visual_claim": {
      "enum": [
        "trusted_visual_surface",
        "reviewable_visual_surface",
        "contrast_unverified_projection",
        "theme_pair_unverified_projection",
        "semantic_separation_unverified_projection",
        "chart_encoding_unverified_projection",
        "text_readability_unverified_projection",
        "geometry_baseline_disclosed_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "foundation_family": {
      "enum": [
        "color_system",
        "semantic_theme_token",
        "syntax_token",
        "diff_token",
        "chart_token",
        "typography",
        "spacing_sizing_radii_elevation",
        "hit_target"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "status_or_trust_collapsed_to_color_only",
        "syntax_or_diff_palette_collided_with_diagnostics",
        "hit_target_shrunk_below_minimum",
        "chart_meaning_depended_on_color_alone",
        "local_geometry_forked_from_foundation",
        "typography_scale_drifted",
        "font_stack_unstable",
        "theme_pair_incomplete",
        "tabular_numerals_missing",
        "semantic_role_unstated",
        "token_reference_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collapses_status_or_trust_into_color_only",
        "lets_syntax_or_diff_palette_collide_with_diagnostics",
        "shrinks_hit_target_below_supported_minimum",
        "lets_chart_meaning_depend_on_color_alone",
        "forks_local_spacing_or_elevation_from_shared_geometry"
      ],
      "properties": {
        "collapses_status_or_trust_into_color_only": { "const": false },
        "lets_syntax_or_diff_palette_collide_with_diagnostics": { "const": false },
        "shrinks_hit_target_below_supported_minimum": { "const": false },
        "lets_chart_meaning_depend_on_color_alone": { "const": false },
        "forks_local_spacing_or_elevation_from_shared_geometry": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/visual_claim" },
        "to_claim": { "$ref": "#/$defs/visual_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_visual_foundations_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/visual_claim" },
        "certified_claim": { "$ref": "#/$defs/visual_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/foundation_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-visual-foundations-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
