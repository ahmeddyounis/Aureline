{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-opacity-scrim-and-overlay-depth-registries.schema.json",
  "title": "Aureline M5 opacity / scrim and overlay-depth registries",
  "description": "Export-safe packet for the overlay-depth implement lane over the frozen M5 motion / layer / iconography matrix. It carries resolved, honest projections of the opacity/scrim and layer-order (overlay-depth) interaction families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved scrim entries (naming a canonical token, a semantic role, an opacity/scrim role, an overlay depth class, a contrast treatment, and reduced-motion/power-saver/thermal clamp coverage that preserves workspace orientation and text contrast) and resolved overlay-depth entries (naming a canonical token, a layer-order role, a semantic role, an overlay depth class, the three clamps, and stacking under the single shared z-order model). Hard invariants forbid a scrim erasing orientation or contrast, a raw opacity value inlined instead of a canonical token, an overlay bypassing the shared z-order model, and an incomplete clamp coverage. Acceptance criteria — the first shell/dialog/panel/embedded/notification consumers use one canonical overlay grammar, scrims and overlay-depth classes preserve contrast and orientation, and the first claimed overlays show correct blocking-versus-nonblocking depth truth — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_opacity_scrim_and_overlay_depth_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "interaction_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "interaction_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "scrim_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_demands_accessible_fallback",
        "scrim_role",
        "scrim_role_erases_orientation_or_contrast",
        "depth_class",
        "depth_class_is_classified",
        "depth_class_is_blocking",
        "contrast_treatment",
        "contrast_treatment_present",
        "surface_context",
        "clamp_coverage",
        "covers_all_clamps",
        "preserves_orientation",
        "preserves_text_contrast",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "overlay_orientation_preserved"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_accessible_fallback": { "type": "boolean" },
        "scrim_role": { "$ref": "#/$defs/non_empty_string" },
        "scrim_role_erases_orientation_or_contrast": { "type": "boolean" },
        "depth_class": { "$ref": "#/$defs/non_empty_string" },
        "depth_class_is_classified": { "type": "boolean" },
        "depth_class_is_blocking": { "type": "boolean" },
        "contrast_treatment": { "$ref": "#/$defs/non_empty_string" },
        "contrast_treatment_present": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "clamp_coverage": { "type": "array" },
        "covers_all_clamps": { "type": "boolean" },
        "preserves_orientation": { "type": "boolean" },
        "preserves_text_contrast": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "overlay_orientation_preserved": { "type": "boolean" }
      }
    },
    "overlay_depth_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "layer_order_role",
        "layer_order_role_is_private_bypass",
        "semantic_role",
        "depth_class",
        "depth_class_is_classified",
        "depth_class_is_blocking",
        "surface_context",
        "clamp_coverage",
        "covers_all_clamps",
        "references_canonical_token",
        "stacks_under_shared_model",
        "degrade_reason",
        "next_action",
        "depth_truth_holds_across_clamps"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "layer_order_role": { "$ref": "#/$defs/non_empty_string" },
        "layer_order_role_is_private_bypass": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "depth_class": { "$ref": "#/$defs/non_empty_string" },
        "depth_class_is_classified": { "type": "boolean" },
        "depth_class_is_blocking": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "clamp_coverage": { "type": "array" },
        "covers_all_clamps": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "stacks_under_shared_model": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "depth_truth_holds_across_clamps": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "scrim_entries",
        "overlay_depth_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "scrim_erases_orientation_or_contrast",
        "raw_opacity_value_inlined_instead_of_token",
        "overlay_bypasses_shared_z_order",
        "runtime_clamp_coverage_incomplete"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "scrim_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scrim_entry" }
        },
        "overlay_depth_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/overlay_depth_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "scrim_erases_orientation_or_contrast": { "const": false },
        "raw_opacity_value_inlined_instead_of_token": { "const": false },
        "overlay_bypasses_shared_z_order": { "const": false },
        "runtime_clamp_coverage_incomplete": { "const": false }
      }
    }
  }
}
