{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/design-system/m5-layer-order-and-portal-registries.schema.json",
  "title": "Aureline M5 layer-order and portal registries",
  "description": "Export-safe packet for the layer / portal implement lane over the frozen M5 motion / layer / iconography matrix. It carries resolved, honest projections of the layer-order (z-tier) and portal-ownership interaction families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved layer-tier entries (naming a canonical token, a semantic role, a layer-order role, a base/sticky/floating/menu/dialog/toast/critical z-tier, and stacking under the single shared z-order model without a hard-coded always-on-top bypass) and resolved portal entries (naming a canonical token, a portal-ownership role, a semantic role, a z-tier, and an attachment mode that keeps the portal attached to its owning surface and restore-safe). Hard invariants forbid an overlay hard-coding always-on-top, a portal detaching from its owning surface, a raw z-index inlined instead of a canonical token, and a layer-order entry bypassing the shared z-order model. Acceptance criteria — the first shell/dialog/panel/embedded/notification consumers obey one canonical layer-order model with correct attachment and restore behavior, menus/toasts/dialogs/critical prompts no longer compete through ad hoc z-order rules, and layer-order drift is visible before stable promotion — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_layer_order_and_portal_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "interaction_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "interaction_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "layer_tier_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "semantic_role",
        "semantic_role_demands_accessible_fallback",
        "layer_order_role",
        "layer_order_role_is_private_bypass",
        "layer_tier",
        "layer_tier_is_classified",
        "layer_tier_is_competing",
        "z_index",
        "surface_context",
        "hardcodes_always_on_top",
        "stacks_under_shared_model",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "z_order_model_holds"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_accessible_fallback": { "type": "boolean" },
        "layer_order_role": { "$ref": "#/$defs/non_empty_string" },
        "layer_order_role_is_private_bypass": { "type": "boolean" },
        "layer_tier": { "$ref": "#/$defs/non_empty_string" },
        "layer_tier_is_classified": { "type": "boolean" },
        "layer_tier_is_competing": { "type": "boolean" },
        "z_index": { "type": "integer", "minimum": 0 },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "hardcodes_always_on_top": { "type": "boolean" },
        "stacks_under_shared_model": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "z_order_model_holds": { "type": "boolean" }
      }
    },
    "portal_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "token_name",
        "portal_ownership_role",
        "portal_role_is_detached",
        "semantic_role",
        "semantic_role_demands_accessible_fallback",
        "layer_tier",
        "layer_tier_is_classified",
        "z_index",
        "attachment_mode",
        "attachment_mode_present",
        "surface_context",
        "attaches_to_owning_surface",
        "restore_safe",
        "references_canonical_token",
        "degrade_reason",
        "next_action",
        "owning_surface_attachment_preserved"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "token_name": { "type": "string" },
        "portal_ownership_role": { "$ref": "#/$defs/non_empty_string" },
        "portal_role_is_detached": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_demands_accessible_fallback": { "type": "boolean" },
        "layer_tier": { "$ref": "#/$defs/non_empty_string" },
        "layer_tier_is_classified": { "type": "boolean" },
        "z_index": { "type": "integer", "minimum": 0 },
        "attachment_mode": { "$ref": "#/$defs/non_empty_string" },
        "attachment_mode_present": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "attaches_to_owning_surface": { "type": "boolean" },
        "restore_safe": { "type": "boolean" },
        "references_canonical_token": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "owning_surface_attachment_preserved": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "layer_tier_entries",
        "portal_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "overlay_hardcodes_always_on_top",
        "portal_detaches_from_owning_surface",
        "raw_z_order_value_inlined_instead_of_token",
        "layer_order_bypasses_shared_z_order_model"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "layer_tier_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layer_tier_entry" }
        },
        "portal_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/portal_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "overlay_hardcodes_always_on_top": { "const": false },
        "portal_detaches_from_owning_surface": { "const": false },
        "raw_z_order_value_inlined_instead_of_token": { "const": false },
        "layer_order_bypasses_shared_z_order_model": { "const": false }
      }
    }
  }
}
