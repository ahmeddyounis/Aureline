{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/env/m5-env-certification.schema.json",
  "title": "Aureline environment-truth certification packet",
  "description": "Boundary schema for the checked-in environment-truth certification packet and its scenario fixtures. The packet certifies the whole environment-truth lane on every claimed M5 local-native/container/remote-host/devcontainer/managed-cloud target class: per target class it carries the five required certification aspects (capsule identity, template composition, prebuild compatibility, lifecycle-hook truth, runtime-instance parity) bound to the checked-in upstream lane artifacts, the narrowed verdict and warm-start posture the engine reaches, the automatic maturity- and warm-start-narrowing rules, the failure/recovery drills, the publication-channel bindings, and the rolled-up promotion decision. Raw environment payloads, credentials, raw provider responses, raw paths, and raw traces never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "target_class": {
      "type": "string",
      "enum": [
        "local_native",
        "container",
        "remote_host",
        "devcontainer",
        "managed_cloud"
      ]
    },
    "certification_aspect": {
      "type": "string",
      "enum": [
        "capsule_identity",
        "template_composition",
        "prebuild_compatibility",
        "lifecycle_hook_truth",
        "runtime_instance_parity"
      ]
    },
    "claim_maturity": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "warm_start_posture": {
      "type": "string",
      "enum": ["warm_full_reuse", "warm_partial_reuse", "cold_build"]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["current", "partial", "stale", "missing", "not_applicable"]
    },
    "row_verdict": {
      "type": "string",
      "enum": ["certified", "narrowed", "withheld"]
    },
    "publication_channel": {
      "type": "string",
      "enum": ["release_shiproom", "support_export", "docs", "help"]
    },
    "certification_failure_class": {
      "type": "string",
      "enum": [
        "capsule_identity_drift",
        "template_composition_fork",
        "prebuild_invalidation",
        "lifecycle_hook_ungated",
        "runtime_instance_skew"
      ]
    },
    "drill_phase": {
      "type": "string",
      "enum": ["inject", "observe", "narrow", "refresh", "recover", "verify"]
    },
    "aspect_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "evidence_state", "evidence_refs", "rationale"],
      "properties": {
        "aspect": { "$ref": "#/$defs/certification_aspect" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/env/m5-env-certification.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/env/m5-env-certification.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/env/m5-env-certification-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/env/m5-env-certification.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/env/m5-env-certification/manifest.yaml"
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "target_class",
        "target_class_label",
        "claimed_maturity",
        "claimed_warm_start_posture",
        "backing_surface_classes",
        "aspects",
        "effective_maturity",
        "verdict",
        "narrowed",
        "narrow_reason_tokens",
        "stale_or_missing_aspect_tokens",
        "effective_warm_start_posture",
        "warm_start_downgraded",
        "warm_start_downgrade_tokens",
        "why_this_certification",
        "supporting_evidence_refs",
        "consumer_refs",
        "notes"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "target_class": { "$ref": "#/$defs/target_class" },
        "target_class_label": { "$ref": "#/$defs/non_empty_string" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "backing_surface_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "aspects": {
          "type": "array",
          "items": { "$ref": "#/$defs/aspect_evidence" },
          "minItems": 5
        },
        "effective_maturity": { "$ref": "#/$defs/claim_maturity" },
        "verdict": { "$ref": "#/$defs/row_verdict" },
        "narrowed": { "type": "boolean" },
        "narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "stale_or_missing_aspect_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "effective_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "warm_start_downgraded": { "type": "boolean" },
        "warm_start_downgrade_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "why_this_certification": { "$ref": "#/$defs/non_empty_string" },
        "supporting_evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "consumer_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_evidence_state",
        "maturity_floor",
        "effect",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_evidence_state": {
          "type": "string",
          "enum": ["partial", "stale", "missing"]
        },
        "maturity_floor": { "$ref": "#/$defs/claim_maturity" },
        "effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "warm_start_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_evidence_state",
        "warm_start_floor",
        "effect",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_evidence_state": {
          "type": "string",
          "enum": ["partial", "stale", "missing"]
        },
        "warm_start_floor": { "$ref": "#/$defs/warm_start_posture" },
        "effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "observed_maturity",
        "observed_warm_start_posture",
        "narration"
      ],
      "properties": {
        "phase": { "$ref": "#/$defs/drill_phase" },
        "observed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "observed_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "narration": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_id",
        "title",
        "target_class",
        "exercised_aspect",
        "failure_class",
        "degraded_evidence_state",
        "claimed_maturity",
        "claimed_warm_start_posture",
        "expected_degraded_verdict",
        "expected_degraded_maturity",
        "expected_degraded_warm_start_posture",
        "blocks_promotion_while_degraded",
        "recovers_to_verdict",
        "steps",
        "asserts_claim_narrows_under_failure",
        "asserts_recovers_after_refresh",
        "notes"
      ],
      "properties": {
        "drill_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "target_class": { "$ref": "#/$defs/target_class" },
        "exercised_aspect": { "$ref": "#/$defs/certification_aspect" },
        "failure_class": { "$ref": "#/$defs/certification_failure_class" },
        "degraded_evidence_state": { "$ref": "#/$defs/evidence_state" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "expected_degraded_verdict": { "$ref": "#/$defs/row_verdict" },
        "expected_degraded_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_degraded_warm_start_posture": {
          "$ref": "#/$defs/warm_start_posture"
        },
        "blocks_promotion_while_degraded": { "type": "boolean" },
        "recovers_to_verdict": {
          "type": "string",
          "const": "certified"
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill_step" },
          "minItems": 1
        },
        "asserts_claim_narrows_under_failure": {
          "type": "boolean",
          "const": true
        },
        "asserts_recovers_after_refresh": {
          "type": "boolean",
          "const": true
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "consumer_ref",
        "ingested_packet_id",
        "required_verbatim_fields",
        "narrows_with_packet",
        "summary"
      ],
      "properties": {
        "channel": { "$ref": "#/$defs/publication_channel" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "required_verbatim_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrows_with_packet": { "type": "boolean", "const": true },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "promotion_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_blocked",
        "certified_target_class_tokens",
        "narrowed_target_class_tokens",
        "held_target_class_tokens",
        "summary"
      ],
      "properties": {
        "promotion_blocked": { "type": "boolean" },
        "certified_target_class_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "narrowed_target_class_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "held_target_class_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "certified_aspects",
        "lane_evidence_refs",
        "rows",
        "freshness_rules",
        "warm_start_rules",
        "drills",
        "surface_bindings",
        "promotion",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "env_certification_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "certified_aspects": {
          "type": "array",
          "items": { "$ref": "#/$defs/certification_aspect" },
          "minItems": 5,
          "uniqueItems": true
        },
        "lane_evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/certification_row" },
          "minItems": 5
        },
        "freshness_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/freshness_rule" },
          "minItems": 3
        },
        "warm_start_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/warm_start_rule" },
          "minItems": 3
        },
        "drills": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill" },
          "minItems": 1
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 4
        },
        "promotion": { "$ref": "#/$defs/promotion_summary" },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "target_class",
        "claimed_maturity",
        "claimed_warm_start_posture",
        "observed_aspects",
        "expected_verdict",
        "expected_effective_maturity",
        "expected_warm_start_posture",
        "expected_narrow_reason_tokens",
        "expected_warm_start_downgrade_tokens",
        "blocks_promotion",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "env_certification_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "target_class": { "$ref": "#/$defs/target_class" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "observed_aspects": {
          "type": "array",
          "items": { "$ref": "#/$defs/aspect_evidence" },
          "minItems": 5
        },
        "expected_verdict": { "$ref": "#/$defs/row_verdict" },
        "expected_effective_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "expected_narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "expected_warm_start_downgrade_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "blocks_promotion": { "type": "boolean" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
