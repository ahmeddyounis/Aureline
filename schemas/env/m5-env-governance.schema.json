{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/env/m5-env-governance.schema.json",
  "title": "Aureline environment-capsule governance packet",
  "description": "Boundary schema for the checked-in environment-capsule governance packet and its scenario fixtures. The packet certifies environment-capsule truth on claimed M5 workspace-template/starter/prebuild/devcontainer/remote-container/managed-workspace profiles: per profile it carries the seven required capsule dimensions (source digest, target plan, toolchain plan, trust hooks, service graph, prebuild fingerprint, materialization parity), the evidence backing each, the narrowed verdict and warm-start posture the engine reaches, the automatic maturity- and warm-start-narrowing rules, the failure/recovery drills, and the publication-channel bindings. Raw environment payloads, credentials, raw provider responses, raw paths, and raw traces never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "environment_profile": {
      "type": "string",
      "enum": [
        "workspace_template",
        "starter",
        "prebuild",
        "devcontainer",
        "remote_container",
        "managed_workspace"
      ]
    },
    "capsule_dimension": {
      "type": "string",
      "enum": [
        "source_digest",
        "target_plan",
        "toolchain_plan",
        "trust_hooks",
        "service_graph",
        "prebuild_fingerprint",
        "materialization_parity"
      ]
    },
    "claim_maturity": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "warm_start_posture": {
      "type": "string",
      "enum": ["warm_full_reuse", "warm_partial_reuse", "cold_build"]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["current", "partial", "stale", "missing", "not_applicable"]
    },
    "row_verdict": {
      "type": "string",
      "enum": ["certified", "narrowed", "withheld"]
    },
    "materialization_class": {
      "type": "string",
      "enum": [
        "local_native",
        "container",
        "remote_host",
        "devcontainer",
        "managed_cloud"
      ]
    },
    "publication_channel": {
      "type": "string",
      "enum": ["release_shiproom", "support_export", "docs", "help"]
    },
    "drill_failure_class": {
      "type": "string",
      "enum": [
        "source_digest_drift",
        "toolchain_plan_stale",
        "trust_hook_ungated",
        "service_graph_incomplete",
        "prebuild_fingerprint_mismatch",
        "materialization_skew"
      ]
    },
    "drill_phase": {
      "type": "string",
      "enum": ["inject", "observe", "narrow", "refresh", "recover", "verify"]
    },
    "dimension_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "evidence_state", "evidence_refs", "rationale"],
      "properties": {
        "dimension": { "$ref": "#/$defs/capsule_dimension" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": {
          "type": "string",
          "const": "docs/env/m5-env-governance.md"
        },
        "schema_ref": {
          "type": "string",
          "const": "schemas/env/m5-env-governance.schema.json"
        },
        "packet_ref": {
          "type": "string",
          "const": "artifacts/env/m5-env-proof-packet.json"
        },
        "report_ref": {
          "type": "string",
          "const": "artifacts/env/m5-env-governance.md"
        },
        "fixture_manifest_ref": {
          "type": "string",
          "const": "fixtures/env/m5-env-governance/manifest.yaml"
        }
      }
    },
    "capsule_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "profile",
        "profile_label",
        "materialization_class",
        "claimed_maturity",
        "claimed_warm_start_posture",
        "backing_surface_classes",
        "dimensions",
        "effective_maturity",
        "verdict",
        "narrowed",
        "narrow_reason_tokens",
        "stale_or_missing_dimension_tokens",
        "effective_warm_start_posture",
        "warm_start_downgraded",
        "warm_start_downgrade_tokens",
        "why_this_environment",
        "supporting_evidence_refs",
        "consumer_refs",
        "notes"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/environment_profile" },
        "profile_label": { "$ref": "#/$defs/non_empty_string" },
        "materialization_class": { "$ref": "#/$defs/materialization_class" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "backing_surface_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension_evidence" },
          "minItems": 7
        },
        "effective_maturity": { "$ref": "#/$defs/claim_maturity" },
        "verdict": { "$ref": "#/$defs/row_verdict" },
        "narrowed": { "type": "boolean" },
        "narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "stale_or_missing_dimension_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "effective_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "warm_start_downgraded": { "type": "boolean" },
        "warm_start_downgrade_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "why_this_environment": { "$ref": "#/$defs/non_empty_string" },
        "supporting_evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "consumer_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "freshness_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_evidence_state",
        "maturity_floor",
        "effect",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_evidence_state": {
          "type": "string",
          "enum": ["partial", "stale", "missing"]
        },
        "maturity_floor": { "$ref": "#/$defs/claim_maturity" },
        "effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "warm_start_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_evidence_state",
        "warm_start_floor",
        "effect",
        "rationale"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_evidence_state": {
          "type": "string",
          "enum": ["partial", "stale", "missing"]
        },
        "warm_start_floor": { "$ref": "#/$defs/warm_start_posture" },
        "effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "observed_maturity",
        "observed_warm_start_posture",
        "narration"
      ],
      "properties": {
        "phase": { "$ref": "#/$defs/drill_phase" },
        "observed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "observed_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "narration": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_id",
        "title",
        "profile",
        "exercised_dimension",
        "failure_class",
        "degraded_evidence_state",
        "claimed_maturity",
        "claimed_warm_start_posture",
        "expected_degraded_verdict",
        "expected_degraded_maturity",
        "expected_degraded_warm_start_posture",
        "recovers_to_verdict",
        "steps",
        "asserts_claim_narrows_under_failure",
        "asserts_recovers_after_refresh",
        "notes"
      ],
      "properties": {
        "drill_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/environment_profile" },
        "exercised_dimension": { "$ref": "#/$defs/capsule_dimension" },
        "failure_class": { "$ref": "#/$defs/drill_failure_class" },
        "degraded_evidence_state": { "$ref": "#/$defs/evidence_state" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "expected_degraded_verdict": { "$ref": "#/$defs/row_verdict" },
        "expected_degraded_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_degraded_warm_start_posture": {
          "$ref": "#/$defs/warm_start_posture"
        },
        "recovers_to_verdict": {
          "type": "string",
          "const": "certified"
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill_step" },
          "minItems": 1
        },
        "asserts_claim_narrows_under_failure": {
          "type": "boolean",
          "const": true
        },
        "asserts_recovers_after_refresh": {
          "type": "boolean",
          "const": true
        },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "consumer_ref",
        "ingested_packet_id",
        "required_verbatim_fields",
        "narrows_with_packet",
        "summary"
      ],
      "properties": {
        "channel": { "$ref": "#/$defs/publication_channel" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "required_verbatim_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrows_with_packet": { "type": "boolean", "const": true },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "certified_dimensions",
        "evidence_packet_refs",
        "rows",
        "freshness_rules",
        "warm_start_rules",
        "drills",
        "surface_bindings",
        "invariants"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_env_governance_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "certified_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/capsule_dimension" },
          "minItems": 7,
          "uniqueItems": true
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/capsule_row" },
          "minItems": 6
        },
        "freshness_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/freshness_rule" },
          "minItems": 3
        },
        "warm_start_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/warm_start_rule" },
          "minItems": 3
        },
        "drills": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill" },
          "minItems": 1
        },
        "surface_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_binding" },
          "minItems": 4
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "profile",
        "claimed_maturity",
        "claimed_warm_start_posture",
        "observed_dimensions",
        "expected_verdict",
        "expected_effective_maturity",
        "expected_warm_start_posture",
        "expected_narrow_reason_tokens",
        "expected_warm_start_downgrade_tokens",
        "consumer_ref",
        "notes"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_env_governance_fixture_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/environment_profile" },
        "claimed_maturity": { "$ref": "#/$defs/claim_maturity" },
        "claimed_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "observed_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension_evidence" },
          "minItems": 7
        },
        "expected_verdict": { "$ref": "#/$defs/row_verdict" },
        "expected_effective_maturity": { "$ref": "#/$defs/claim_maturity" },
        "expected_warm_start_posture": { "$ref": "#/$defs/warm_start_posture" },
        "expected_narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "expected_warm_start_downgrade_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
