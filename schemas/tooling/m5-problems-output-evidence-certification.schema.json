{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/tooling/m5-problems-output-evidence-certification.schema.json",
  "title": "Aureline M5 Problems / output / execution-evidence qualification certification",
  "description": "Canonical, export-safe object model for the capstone qualification gate that binds the M5 Problems-row, output-channel, execution-evidence-projection, chronology, and fallback-drill lanes into one promotion model. Each claimed M5 tooling profile (Problems panel, output channel, terminal runner, debug console, notebook output, pipeline overlay, AI-tool evidence, support export) is graded across seven dimensions the source set treats as one causal chain — Problems correlation, output-channel identity, evidence-projection lineage, causal-link integrity, confidence honesty, stale/superseded handling, and reopen-to-origin parity. A profile keeps its claim only while every dimension's invariant holds and its proof is current and reopenable; a broken invariant, missing proof, or imported-on-local proof auto-narrows the profile to blocked, honestly labeled stale proof narrows to retest_pending, and a read-only overlay holds at limited. A narrowed profile carries a strictly lower effective grade, a recorded trigger, and a precise narrowed label. The packet also carries explicit release-evidence rows for the four release-bearing integrity axes (causal-link integrity, confidence honesty, stale/superseded handling, reopenable-evidence parity). This is the capstone companion to schemas/tooling/m5-execution-evidence.schema.json (the lane matrix), schemas/tooling/m5-problem-records.schema.json (the Problems row), schemas/tooling/m5-execution-evidence-projections.schema.json (the projected overlay), schemas/tooling/m5-chronology-reuse.schema.json (the chronology entry), schemas/tooling/m5-output-channels.schema.json (the output channel), and schemas/tooling/m5-fallback-evidence-drills.schema.json (the drill corpus); all share one vocabulary so About/help/service-health, compatibility, release, support, and AI surfaces ingest one qualification state. Adding an enum value is additive-minor and requires a schema_version bump; repurposing an existing value is breaking and requires a new decision row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "taxonomy_version",
    "packet_id",
    "label",
    "as_of",
    "redaction_class_token",
    "profiles",
    "release_evidence_rows",
    "guardrails",
    "consumer_surfaces",
    "evidence_freshness",
    "source_contract_refs",
    "upstream_lane_refs",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_problems_output_evidence_certification_packet"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "taxonomy_version": { "type": "integer", "const": 1 },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
    "as_of": { "type": "string", "format": "date-time" },
    "redaction_class_token": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "structured_fields_with_path_redaction",
        "support_bundle_scoped",
        "broadened_capture"
      ],
      "description": "Default redaction posture for the packet. No raw stdout/stderr bytes, command lines, provider payloads, env bodies, absolute paths, URLs, or secrets ever cross this boundary; refs carry opaque ids only."
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "release_evidence_rows": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/release_evidence_row" }
    },
    "guardrails": { "$ref": "#/$defs/guardrails" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "evidence_freshness": { "$ref": "#/$defs/evidence_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/opaque_ref" }
    },
    "upstream_lane_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/opaque_ref" }
    },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "opaque_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
    "tooling_profile": {
      "type": "string",
      "enum": [
        "problems_panel",
        "output_channel",
        "terminal_runner",
        "debug_console",
        "notebook_output",
        "pipeline_overlay",
        "ai_tool_evidence",
        "support_export"
      ]
    },
    "certification_dimension": {
      "type": "string",
      "enum": [
        "problems_correlation",
        "output_channel_identity",
        "evidence_projection_lineage",
        "causal_link_integrity",
        "confidence_honesty",
        "stale_superseded_handling",
        "reopen_to_origin_parity"
      ]
    },
    "qualification_grade": {
      "type": "string",
      "enum": [
        "qualified",
        "limited",
        "retest_pending",
        "blocked",
        "labs_not_claimed"
      ]
    },
    "claimable_grade": {
      "type": "string",
      "enum": ["qualified", "limited", "labs_not_claimed"]
    },
    "narrow_trigger": {
      "type": "string",
      "enum": [
        "problems_correlation_lost",
        "output_channel_identity_flattened",
        "projection_lineage_flattened",
        "causal_link_broken",
        "confidence_overclaimed",
        "stale_evidence",
        "superseded_state_hidden",
        "reopen_path_lost",
        "missing_dimension_proof",
        "imported_overlay_claims_live",
        "upstream_lane_narrowed"
      ]
    },
    "release_evidence_axis": {
      "type": "string",
      "enum": [
        "causal_link_integrity",
        "confidence_honesty",
        "stale_superseded_handling",
        "reopenable_evidence_parity"
      ]
    },
    "origin_class": {
      "type": "string",
      "enum": [
        "local_task",
        "local_test",
        "local_debug_session",
        "notebook_run",
        "headless_automation",
        "extension_owned_run",
        "ai_triggered_run",
        "remote_linked_run",
        "pipeline_provider_run",
        "imported_provider_evidence"
      ]
    },
    "confidence_tier": {
      "type": "string",
      "enum": [
        "structured_full",
        "heuristic_high",
        "heuristic_medium",
        "heuristic_low",
        "provider_mapped",
        "unmapped_requires_review"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "live",
        "cached_within_window",
        "stale_expired",
        "superseded_by_newer_run",
        "unanchored",
        "missing"
      ]
    },
    "proof_currency": {
      "type": "string",
      "enum": [
        "verified_current",
        "cached_within_window",
        "imported_current",
        "stale_expired",
        "missing_proof",
        "requires_review"
      ]
    },
    "dimension_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "invariant_holds", "proof_currency", "summary"],
      "properties": {
        "dimension": { "$ref": "#/$defs/certification_dimension" },
        "invariant_holds": { "type": "boolean" },
        "proof_currency": { "$ref": "#/$defs/proof_currency" },
        "proof_ref": { "$ref": "#/$defs/opaque_ref" },
        "proof_fingerprint_token": { "$ref": "#/$defs/opaque_ref" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "claim_summary",
        "origin_class",
        "representative_confidence",
        "representative_freshness",
        "overlay_profile",
        "dimensions",
        "canonical_evidence_reopenable",
        "primary_alert_keeps_evidence_reopenable",
        "claimed_grade",
        "effective_grade",
        "upstream_lane_refs",
        "evidence_refs"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/tooling_profile" },
        "claim_summary": { "$ref": "#/$defs/summary" },
        "origin_class": { "$ref": "#/$defs/origin_class" },
        "representative_confidence": { "$ref": "#/$defs/confidence_tier" },
        "representative_freshness": { "$ref": "#/$defs/freshness_state" },
        "overlay_profile": { "type": "boolean" },
        "dimensions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/dimension_qualification" }
        },
        "canonical_evidence_reopenable": { "type": "boolean" },
        "primary_alert_keeps_evidence_reopenable": { "type": "boolean" },
        "claimed_grade": { "$ref": "#/$defs/claimable_grade" },
        "effective_grade": { "$ref": "#/$defs/qualification_grade" },
        "narrow_trigger": { "$ref": "#/$defs/narrow_trigger" },
        "narrowed_label": { "$ref": "#/$defs/summary" },
        "upstream_lane_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opaque_ref" }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opaque_ref" }
        }
      }
    },
    "release_evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "dimension",
        "profiles_holding",
        "profiles_claimed",
        "worst_effective_grade",
        "summary"
      ],
      "properties": {
        "axis": { "$ref": "#/$defs/release_evidence_axis" },
        "dimension": { "$ref": "#/$defs/certification_dimension" },
        "profiles_holding": { "type": "integer", "minimum": 0 },
        "profiles_claimed": { "type": "integer", "minimum": 0 },
        "worst_effective_grade": { "$ref": "#/$defs/qualification_grade" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panes_never_flatten_identity",
        "structured_and_heuristic_origins_stay_distinct",
        "stale_and_superseded_state_stays_visible",
        "canonical_evidence_stays_reopenable",
        "imported_overlay_never_claims_live",
        "stale_or_failing_proof_auto_narrows",
        "primary_alert_summary_keeps_evidence_reopenable"
      ],
      "properties": {
        "panes_never_flatten_identity": { "type": "boolean" },
        "structured_and_heuristic_origins_stay_distinct": { "type": "boolean" },
        "stale_and_superseded_state_stays_visible": { "type": "boolean" },
        "canonical_evidence_stays_reopenable": { "type": "boolean" },
        "imported_overlay_never_claims_live": { "type": "boolean" },
        "stale_or_failing_proof_auto_narrows": { "type": "boolean" },
        "primary_alert_summary_keeps_evidence_reopenable": { "type": "boolean" }
      }
    },
    "consumer_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "about_surface_ingests",
        "help_surface_ingests",
        "service_health_ingests",
        "compatibility_surface_ingests",
        "release_evidence_ingests",
        "support_export_ingests",
        "ai_evidence_ingests",
        "narrowed_profiles_labeled_below_claim"
      ],
      "properties": {
        "about_surface_ingests": { "type": "boolean" },
        "help_surface_ingests": { "type": "boolean" },
        "service_health_ingests": { "type": "boolean" },
        "compatibility_surface_ingests": { "type": "boolean" },
        "release_evidence_ingests": { "type": "boolean" },
        "support_export_ingests": { "type": "boolean" },
        "ai_evidence_ingests": { "type": "boolean" },
        "narrowed_profiles_labeled_below_claim": { "type": "boolean" }
      }
    },
    "evidence_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_freshness_slo_hours",
        "last_evidence_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "evidence_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_evidence_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
