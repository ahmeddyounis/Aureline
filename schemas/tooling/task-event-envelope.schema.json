{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/tooling/task-event-envelope.schema.json",
  "title": "Aureline M5 task-event envelope",
  "description": "Boundary schema for the canonical M5 task-event envelope emitted by native, BSP, Bazel BEP/BES, structured-output, and heuristic-parser adapters. Every envelope carries its source kind, the adapter-priority rank that source resolves to, a confidence at or below the source's ceiling, the retained raw-payload reference and retention class, producer provenance, and an explicit, reason-bearing downgrade flag. It reuses the build/test interoperability source-kind, confidence, lifecycle, retention-class, and provenance vocabulary frozen in schemas/runtime/build-test-event-envelope.schema.json.",
  "type": "object",
  "$ref": "#/$defs/task_event_envelope",
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "enum": ["native", "bsp", "bazel-bep", "structured-output", "heuristic-parser"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium-high", "medium", "low"]
    },
    "event_kind": {
      "type": "string",
      "enum": [
        "TaskQueued",
        "TargetGraphReady",
        "TaskStarted",
        "ProgressUpdated",
        "DiagnosticEmitted",
        "TestCaseStarted",
        "TestCaseFinished",
        "ArtifactPublished",
        "TaskFinished"
      ]
    },
    "raw_payload_retention_class": {
      "type": "string",
      "enum": ["metadata_digest_only", "redacted_reference", "support_approval_required"]
    },
    "downgrade_reason": {
      "type": "string",
      "enum": [
        "partial_support",
        "heuristic_fallback",
        "replay_gap",
        "unsupported_adapter_capability"
      ]
    },
    "priority_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_tool_name", "adapter_id", "adapter_version"],
      "properties": {
        "build_tool_name": { "$ref": "#/$defs/non_empty_string" },
        "build_tool_version": { "type": "string" },
        "adapter_id": { "$ref": "#/$defs/non_empty_string" },
        "adapter_version": { "$ref": "#/$defs/non_empty_string" },
        "workspace_revision": { "type": "string" }
      }
    },
    "task_event_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "trace_id",
        "workspace_id",
        "target_id",
        "event_kind",
        "source_kind",
        "priority_rank",
        "confidence",
        "execution_context_id",
        "raw_payload_ref",
        "raw_payload_retention_class",
        "provenance",
        "downgraded"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/non_empty_string" },
        "trace_id": { "$ref": "#/$defs/non_empty_string" },
        "workspace_id": { "$ref": "#/$defs/non_empty_string" },
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "event_kind": { "$ref": "#/$defs/event_kind" },
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "priority_rank": { "$ref": "#/$defs/priority_rank" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "execution_context_id": { "$ref": "#/$defs/non_empty_string" },
        "raw_payload_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_payload_retention_class": { "$ref": "#/$defs/raw_payload_retention_class" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "downgraded": { "type": "boolean" },
        "downgrade_reason": { "$ref": "#/$defs/downgrade_reason" }
      },
      "allOf": [
        {
          "comment": "A downgraded emission must name a reason; a non-downgraded emission must not.",
          "if": { "properties": { "downgraded": { "const": true } } },
          "then": { "required": ["downgrade_reason"] },
          "else": { "not": { "required": ["downgrade_reason"] } }
        }
      ]
    }
  }
}
