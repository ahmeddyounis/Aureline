{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/tooling/replay-bundle.schema.json",
  "title": "Aureline M5 replay bundle",
  "description": "Boundary schema for the dual-retention replay bundle, its support export, its evidence joins, and its CLI/headless view. The bundle binds the canonical normalized task/test/debug event history to a typed, bounded raw-payload lineage index, and joins both halves into the replay, support, incident, and AI evidence surfaces so a reviewer can follow the raw-to-normalized chain end to end. It reuses the source-kind, confidence, lifecycle, payload, retention-class, and provenance vocabulary frozen in schemas/tooling/task-event-envelope.schema.json and the adapter-priority ladder and downgrade vocabulary frozen in schemas/tooling/adapter-capability.schema.json. Raw payload bodies never cross this boundary; lineage entries cite a retained reference, a digest, a retention class, and a bounded retained byte length. Approval-only references are gated from the export joins instead of being dropped, so provenance is never flattened.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/replay_bundle" },
    { "$ref": "#/$defs/support_export" },
    { "$ref": "#/$defs/evidence_join_view" },
    { "$ref": "#/$defs/cli_headless_view" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "enum": ["native", "bsp", "bazel-bep", "structured-output", "heuristic-parser"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium-high", "medium", "low"]
    },
    "event_kind": {
      "type": "string",
      "enum": [
        "TaskQueued",
        "TargetGraphReady",
        "TaskStarted",
        "ProgressUpdated",
        "DiagnosticEmitted",
        "TestCaseStarted",
        "TestCaseFinished",
        "ArtifactPublished",
        "TaskFinished"
      ]
    },
    "payload_kind": {
      "type": "string",
      "enum": ["lifecycle", "progress", "diagnostic", "test", "artifact", "debug"]
    },
    "producer_lane": {
      "type": "string",
      "enum": ["notebook_run", "task_center", "test_session", "debug_session", "pipeline"]
    },
    "join_surface": {
      "type": "string",
      "enum": ["replay", "support_bundle", "incident_packet", "ai_evidence"]
    },
    "raw_payload_retention_class": {
      "type": "string",
      "enum": ["metadata_digest_only", "redacted_reference", "support_approval_required"]
    },
    "downgrade_reason": {
      "type": "string",
      "enum": [
        "partial_support",
        "heuristic_fallback",
        "replay_gap",
        "unsupported_adapter_capability"
      ]
    },
    "failure_mode": {
      "type": "string",
      "enum": ["truncation", "duplicate_delivery", "adapter_drift", "export_import_round_trip"]
    },
    "recovery_posture": {
      "type": "string",
      "enum": [
        "reconstructed_from_lineage",
        "deduplicated_stable",
        "downgraded_visibly",
        "round_trip_stable"
      ]
    },
    "priority_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_tool_name", "adapter_id", "adapter_version"],
      "properties": {
        "build_tool_name": { "$ref": "#/$defs/non_empty_string" },
        "build_tool_version": { "type": "string" },
        "adapter_id": { "$ref": "#/$defs/non_empty_string" },
        "adapter_version": { "$ref": "#/$defs/non_empty_string" },
        "workspace_revision": { "type": "string" }
      }
    },
    "task_event_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "trace_id",
        "sequence",
        "producer_lane",
        "workspace_id",
        "target_id",
        "event_kind",
        "payload_kind",
        "source_kind",
        "priority_rank",
        "confidence",
        "captured_at",
        "execution_context_id",
        "raw_payload_ref",
        "raw_payload_retention_class",
        "provenance",
        "downgraded"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/non_empty_string" },
        "trace_id": { "$ref": "#/$defs/non_empty_string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "producer_lane": { "$ref": "#/$defs/producer_lane" },
        "workspace_id": { "$ref": "#/$defs/non_empty_string" },
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "event_kind": { "$ref": "#/$defs/event_kind" },
        "payload_kind": { "$ref": "#/$defs/payload_kind" },
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "priority_rank": { "$ref": "#/$defs/priority_rank" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "captured_at": { "$ref": "#/$defs/non_empty_string" },
        "execution_context_id": { "$ref": "#/$defs/non_empty_string" },
        "raw_payload_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_payload_retention_class": { "$ref": "#/$defs/raw_payload_retention_class" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "downgraded": { "type": "boolean" },
        "downgrade_reason": { "$ref": "#/$defs/downgrade_reason" }
      },
      "allOf": [
        {
          "comment": "A downgraded record must name a reason; a non-downgraded record must not.",
          "if": { "properties": { "downgraded": { "const": true } } },
          "then": { "required": ["downgrade_reason"] },
          "else": { "not": { "required": ["downgrade_reason"] } }
        }
      ]
    },
    "raw_payload_lineage_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_ref",
        "source_kind",
        "retention_class",
        "payload_digest",
        "payload_byte_len",
        "retained_byte_bound",
        "replay_safe",
        "support_export_safe",
        "ai_evidence_safe",
        "referencing_event_ids"
      ],
      "properties": {
        "raw_payload_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "retention_class": { "$ref": "#/$defs/raw_payload_retention_class" },
        "payload_digest": { "$ref": "#/$defs/non_empty_string" },
        "payload_byte_len": { "type": "integer", "minimum": 0 },
        "retained_byte_bound": { "type": "integer", "minimum": 0 },
        "replay_safe": { "type": "boolean" },
        "support_export_safe": { "type": "boolean" },
        "ai_evidence_safe": { "type": "boolean" },
        "referencing_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "lineage_join_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "join_ref",
        "binds_normalized_envelope",
        "binds_raw_lineage",
        "preserves_source_kind",
        "preserves_priority_rank",
        "preserves_confidence",
        "preserves_provenance",
        "preserves_downgrade_disclosure",
        "honors_retention_redaction",
        "citable_payload_count"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/join_surface" },
        "join_ref": { "$ref": "#/$defs/non_empty_string" },
        "binds_normalized_envelope": { "type": "boolean" },
        "binds_raw_lineage": { "type": "boolean" },
        "preserves_source_kind": { "type": "boolean" },
        "preserves_priority_rank": { "type": "boolean" },
        "preserves_confidence": { "type": "boolean" },
        "preserves_provenance": { "type": "boolean" },
        "preserves_downgrade_disclosure": { "type": "boolean" },
        "honors_retention_redaction": { "type": "boolean" },
        "citable_payload_count": { "type": "integer", "minimum": 0 }
      }
    },
    "robustness_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_mode",
        "recovery_posture",
        "replay_digest_before",
        "replay_digest_after",
        "stable",
        "detail"
      ],
      "properties": {
        "failure_mode": { "$ref": "#/$defs/failure_mode" },
        "recovery_posture": { "$ref": "#/$defs/recovery_posture" },
        "replay_digest_before": { "$ref": "#/$defs/non_empty_string" },
        "replay_digest_after": { "$ref": "#/$defs/non_empty_string" },
        "stable": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "validation_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/non_empty_string" },
        "severity": { "type": "string", "enum": ["info", "warning", "blocker"] },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "replay_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "bundle_id",
        "generated_at",
        "bundle_schema_ref",
        "envelope_schema_ref",
        "doc_ref",
        "policy_baseline_ref",
        "first_consumers_packet_ref",
        "events",
        "raw_lineage",
        "join_projections",
        "robustness_cases",
        "replay_digest",
        "promotion_state"
      ],
      "properties": {
        "record_kind": { "const": "m5_replay_bundle" },
        "schema_version": { "const": 1 },
        "bundle_id": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "bundle_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "envelope_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "policy_baseline_ref": { "$ref": "#/$defs/non_empty_string" },
        "first_consumers_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/task_event_record" }
        },
        "raw_lineage": {
          "type": "array",
          "items": { "$ref": "#/$defs/raw_payload_lineage_entry" }
        },
        "join_projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/lineage_join_projection" }
        },
        "robustness_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/robustness_case" }
        },
        "replay_digest": { "$ref": "#/$defs/non_empty_string" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "validation_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "export_id",
        "exported_at",
        "bundle_id_ref",
        "bundle"
      ],
      "properties": {
        "record_kind": { "const": "m5_replay_bundle_support_export" },
        "schema_version": { "const": 1 },
        "export_id": { "$ref": "#/$defs/non_empty_string" },
        "exported_at": { "$ref": "#/$defs/non_empty_string" },
        "bundle_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "bundle": { "$ref": "#/$defs/replay_bundle" }
      }
    },
    "normalized_replay_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "trace_id",
        "sequence",
        "producer_lane",
        "event_kind",
        "payload_kind",
        "source_kind",
        "priority_rank",
        "confidence",
        "downgraded",
        "raw_payload_retention_class",
        "adapter_id",
        "explanation"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/non_empty_string" },
        "trace_id": { "$ref": "#/$defs/non_empty_string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "producer_lane": { "$ref": "#/$defs/producer_lane" },
        "event_kind": { "$ref": "#/$defs/event_kind" },
        "payload_kind": { "$ref": "#/$defs/payload_kind" },
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "priority_rank": { "$ref": "#/$defs/priority_rank" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "downgraded": { "type": "boolean" },
        "downgrade_reason": { "$ref": "#/$defs/downgrade_reason" },
        "raw_payload_retention_class": { "$ref": "#/$defs/raw_payload_retention_class" },
        "adapter_id": { "$ref": "#/$defs/non_empty_string" },
        "explanation": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "raw_lineage_evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_ref",
        "source_kind",
        "retention_class",
        "payload_digest",
        "disclosed",
        "referencing_event_ids",
        "note"
      ],
      "properties": {
        "raw_payload_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "retention_class": { "$ref": "#/$defs/raw_payload_retention_class" },
        "payload_digest": { "$ref": "#/$defs/non_empty_string" },
        "disclosed": { "type": "boolean" },
        "referencing_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "evidence_join_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "view_id",
        "surface",
        "generated_at",
        "bundle_id_ref",
        "replay_digest",
        "normalized_rows",
        "lineage_rows",
        "disclosed_payload_count",
        "gated_payload_count"
      ],
      "properties": {
        "record_kind": { "const": "m5_replay_bundle_evidence_join" },
        "schema_version": { "const": 1 },
        "view_id": { "$ref": "#/$defs/non_empty_string" },
        "surface": { "$ref": "#/$defs/join_surface" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "bundle_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "replay_digest": { "$ref": "#/$defs/non_empty_string" },
        "normalized_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/normalized_replay_row" }
        },
        "lineage_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/raw_lineage_evidence_row" }
        },
        "disclosed_payload_count": { "type": "integer", "minimum": 0 },
        "gated_payload_count": { "type": "integer", "minimum": 0 }
      }
    },
    "cli_headless_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "trace_id",
        "sequence",
        "producer_lane",
        "source_kind",
        "priority_rank",
        "confidence",
        "downgraded",
        "raw_payload_ref",
        "raw_payload_retention_class",
        "replay_safe",
        "explanation"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/non_empty_string" },
        "trace_id": { "$ref": "#/$defs/non_empty_string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "producer_lane": { "$ref": "#/$defs/producer_lane" },
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "priority_rank": { "$ref": "#/$defs/priority_rank" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "downgraded": { "type": "boolean" },
        "raw_payload_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_payload_retention_class": { "$ref": "#/$defs/raw_payload_retention_class" },
        "payload_digest": { "$ref": "#/$defs/non_empty_string" },
        "payload_byte_len": { "type": "integer", "minimum": 0 },
        "replay_safe": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cli_headless_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "view_id",
        "generated_at",
        "bundle_id_ref",
        "replay_digest",
        "rows",
        "robustness_cases"
      ],
      "properties": {
        "record_kind": { "const": "m5_replay_bundle_cli_headless" },
        "schema_version": { "const": 1 },
        "view_id": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "bundle_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "replay_digest": { "$ref": "#/$defs/non_empty_string" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/cli_headless_row" }
        },
        "robustness_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/robustness_case" }
        }
      }
    }
  }
}
