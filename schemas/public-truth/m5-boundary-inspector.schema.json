{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-boundary-inspector.schema.json",
  "title": "Aureline M5 boundary inspector",
  "description": "The user / admin / evaluator-facing boundary inspector that explains, for each consequential M5 action, where execution and data went, which host / service hops carried the work, and which approval authority was in effect — bound to the same gate-bound state grammar the assurance / governance / route-provenance governance matrix froze. Each high-risk local / remote / provider / admin action carries three reusable cards: a boundary summary card (boundary class, actor / source, target class, sensitive data classes, approving authority, export-safe summary, and a capability-boundary state read from the matrix vocabulary); an ordered route-hop timeline (locality, role, certificate context, and drift marker per hop, whose route state auto-narrows on a mirror substitution or certificate drift and blocks on an unattributed hop); and an approval-ticket inspector (capability class, approving authority, scope, the runtime approval state, the expiry and its standing, and the revoke / renew actions). Each action's inspector takes the worst gate of its three facets, so it never reads safer than its least-attested facet; a route drift or an expiring approval narrows it, and an unattributed hop or an expired approval blocks Stable promotion. The exported evaluation packet reuses the exact boundary / route / approval vocabulary the cards show. The packet is metadata-only: it preserves route / evidence lineage as refs and carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "action_inspectors",
    "evaluation_packet",
    "vocabulary",
    "summary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "m5_boundary_inspector" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "action_inspectors": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/action_inspector" }
    },
    "evaluation_packet": { "$ref": "#/$defs/evaluation_packet" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "summary": { "$ref": "#/$defs/summary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
