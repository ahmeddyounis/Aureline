{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-event-provenance-row.schema.json",
  "title": "Aureline M5 event-provenance row",
  "description": "One reusable event-provenance row from the M5 event-provenance inspector, validatable on its own. For one queued or replayable M5 action it attaches a stable lineage row to the log / diagnostic / artifact / audit surface the event landed on: the event id, the mutation / run / session it links to, the host lane the work ran in, the retrieval epoch it was read as-of, and the redaction posture of the row. Its active state is read from the matrix provenance vocabulary (fully_traced -> provenance_missing), and the effective gate folds in evidence freshness so the row can never read more traceable than its proof. The row is metadata-only: it carries refs and category labels, never credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "action_label",
    "flow",
    "flow_label",
    "surface",
    "surface_label",
    "event_id",
    "mutation_ref",
    "run_ref",
    "session_ref",
    "host_lane",
    "host_lane_label",
    "retrieval_epoch",
    "redaction_posture",
    "redaction_posture_label",
    "provenance_state",
    "provenance_state_label",
    "is_local",
    "evidence_freshness",
    "effective_gate",
    "effective_qualification",
    "trust_boundaries",
    "crosses_trust_boundary",
    "evidence_class",
    "owner_role",
    "proof_ref",
    "export_safe_summary",
    "status",
    "signal",
    "detail_message_id"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "queued_prompt_replay",
        "deferred_model_download",
        "scheduled_credential_rotation",
        "publish_later_data_export",
        "queued_control_plane_sync",
        "retried_policy_push",
        "deferred_support_handoff",
        "replayed_audit_export"
      ]
    },
    "action_label": { "type": "string", "minLength": 1 },
    "flow": { "type": "string", "enum": ["ai", "provider", "remote", "support"] },
    "flow_label": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "enum": ["log", "diagnostic", "artifact", "audit"] },
    "surface_label": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "mutation_ref": { "type": "string", "minLength": 1 },
    "run_ref": { "type": "string", "minLength": 1 },
    "session_ref": { "type": "string", "minLength": 1 },
    "host_lane": {
      "type": "string",
      "enum": ["local_machine", "remote_region", "control_plane", "mirror_edge", "vendor_edge"]
    },
    "host_lane_label": { "type": "string", "minLength": 1 },
    "retrieval_epoch": { "type": "string", "minLength": 1 },
    "redaction_posture": {
      "type": "string",
      "enum": ["metadata_only", "reference_only", "redacted_body", "sealed_local"]
    },
    "redaction_posture_label": { "type": "string", "minLength": 1 },
    "provenance_state": {
      "type": "string",
      "enum": [
        "fully_traced",
        "derived_traced",
        "partial_provenance",
        "provenance_stale",
        "provenance_missing"
      ]
    },
    "provenance_state_label": { "type": "string", "minLength": 1 },
    "is_local": { "type": "boolean" },
    "evidence_freshness": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "effective_gate": { "type": "string", "enum": ["governed", "narrowed", "blocked"] },
    "effective_qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "trust_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["local_first", "control_plane"] }
    },
    "crosses_trust_boundary": { "type": "boolean" },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "owner_role": { "type": "string", "minLength": 1 },
    "proof_ref": { "type": "string", "minLength": 1 },
    "export_safe_summary": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["mapped", "provisional", "unmapped"] },
    "signal": { "type": "string", "enum": ["green", "yellow", "red"] },
    "detail_message_id": { "type": "string", "minLength": 1 }
  }
}
