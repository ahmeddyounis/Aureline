{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-replay-reapproval-gate.schema.json",
  "title": "Aureline M5 replay / reapproval gate",
  "description": "One reusable replay / reapproval gate from the M5 event-provenance inspector, validatable on its own. For one queued or replayable M5 action it records the kind of replay it carries (replay, publish-later, or approve-again), the current capability-boundary state and approval state from the matrix vocabulary, and the decision those facts imply: replay_as_is when fully governed, require_reapproval when current facts narrowed the boundary, or hold_blocked when they invalidate it. The effective gate is the worst of the boundary gate, the approval gate, and the approval evidence freshness; the decision follows the gate, so a deferred action never replays silently across changed boundary or approval facts. The gate is metadata-only: it carries a ticket ref and a proof ref, never credential bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "action_label",
    "deferred_kind",
    "deferred_kind_label",
    "boundary_state",
    "boundary_state_label",
    "approval_state",
    "approval_state_label",
    "decision",
    "decision_label",
    "evidence_freshness",
    "effective_gate",
    "effective_qualification",
    "evidence_class",
    "owner_role",
    "proof_ref",
    "ticket_ref",
    "status",
    "signal",
    "detail_message_id"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "queued_prompt_replay",
        "deferred_model_download",
        "scheduled_credential_rotation",
        "publish_later_data_export",
        "queued_control_plane_sync",
        "retried_policy_push",
        "deferred_support_handoff",
        "replayed_audit_export"
      ]
    },
    "action_label": { "type": "string", "minLength": 1 },
    "deferred_kind": {
      "type": "string",
      "enum": ["replay", "publish_later", "approve_again"]
    },
    "deferred_kind_label": { "type": "string", "minLength": 1 },
    "boundary_state": {
      "type": "string",
      "enum": [
        "within_boundary",
        "boundary_documented",
        "at_boundary_edge",
        "boundary_narrowed",
        "outside_boundary"
      ]
    },
    "boundary_state_label": { "type": "string", "minLength": 1 },
    "approval_state": {
      "type": "string",
      "enum": [
        "pre_authorized",
        "approved",
        "approval_pending",
        "approval_required",
        "approval_denied"
      ]
    },
    "approval_state_label": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["replay_as_is", "require_reapproval", "hold_blocked"]
    },
    "decision_label": { "type": "string", "minLength": 1 },
    "evidence_freshness": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "effective_gate": { "type": "string", "enum": ["governed", "narrowed", "blocked"] },
    "effective_qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "owner_role": { "type": "string", "minLength": 1 },
    "proof_ref": { "type": "string", "minLength": 1 },
    "ticket_ref": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["mapped", "provisional", "unmapped"] },
    "signal": { "type": "string", "enum": ["green", "yellow", "red"] },
    "detail_message_id": { "type": "string", "minLength": 1 }
  }
}
