{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-route-drift-banner.schema.json",
  "title": "Aureline M5 route-drift banner",
  "description": "One reusable route-drift banner from the M5 event-provenance inspector, validatable on its own. For one queued or replayable M5 action it compares the action's current route facts against its baseline (the plan, or the last success) and names every route fact that drifted: endpoint, tenant, region, proxy, certificate, mirror, or policy. The banner binds the action's route-hop state (local_only -> unattributed_route); its effective gate folds in the worst drifted-fact gate and the route evidence freshness, so a changed route never reads more attributable than its facts allow — a tenant change blocks, every other drift narrows. Each drifted fact carries export-safe category refs for the planned and current value, never raw identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "action_label",
    "baseline",
    "baseline_label",
    "route_state",
    "route_state_label",
    "drifted_facets",
    "drift_count",
    "has_drift",
    "evidence_freshness",
    "effective_gate",
    "effective_qualification",
    "evidence_class",
    "owner_role",
    "proof_ref",
    "status",
    "signal",
    "banner_message_id"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "queued_prompt_replay",
        "deferred_model_download",
        "scheduled_credential_rotation",
        "publish_later_data_export",
        "queued_control_plane_sync",
        "retried_policy_push",
        "deferred_support_handoff",
        "replayed_audit_export"
      ]
    },
    "action_label": { "type": "string", "minLength": 1 },
    "baseline": { "type": "string", "enum": ["plan", "last_success"] },
    "baseline_label": { "type": "string", "minLength": 1 },
    "route_state": {
      "type": "string",
      "enum": [
        "local_only",
        "attributed_remote",
        "mirrored_route",
        "route_degraded",
        "unattributed_route"
      ]
    },
    "route_state_label": { "type": "string", "minLength": 1 },
    "drifted_facets": {
      "type": "array",
      "items": { "$ref": "#/$defs/drift_fact_entry" }
    },
    "drift_count": { "type": "integer", "minimum": 0 },
    "has_drift": { "type": "boolean" },
    "evidence_freshness": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "effective_gate": { "type": "string", "enum": ["governed", "narrowed", "blocked"] },
    "effective_qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "owner_role": { "type": "string", "minLength": 1 },
    "proof_ref": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["mapped", "provisional", "unmapped"] },
    "signal": { "type": "string", "enum": ["green", "yellow", "red"] },
    "banner_message_id": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "drift_fact_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet",
        "facet_label",
        "baseline",
        "planned_ref",
        "current_ref",
        "facet_gate",
        "detail_message_id"
      ],
      "properties": {
        "facet": {
          "type": "string",
          "enum": ["endpoint", "tenant", "region", "proxy", "certificate", "mirror", "policy"]
        },
        "facet_label": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "enum": ["plan", "last_success"] },
        "planned_ref": { "type": "string", "minLength": 1 },
        "current_ref": { "type": "string", "minLength": 1 },
        "facet_gate": { "type": "string", "enum": ["governed", "narrowed", "blocked"] },
        "detail_message_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
