{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-fitness-tile.schema.json",
  "title": "Aureline M5 governance fitness tile",
  "description": "One freshness-aware fitness tile from the M5 governance dashboard, validatable on its own so release, Help/About, support, and evaluation exports can carry a single dashboard-backed tile without the whole packet. A tile binds a protected fitness function to the corpus it was measured against and derives a colour-distinct state — passing, warning, evidence_stale, waived, waiver_expired, or blocked — from its measured nightly result, evidence freshness, and waiver standing, so it can never read greener than its proof. The tile carries no credential bodies or raw provider payloads; the proof ref is a repo-relative reference only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "function",
    "function_label",
    "service",
    "scope_profile",
    "corpus_id",
    "measure",
    "measure_label",
    "evidence_freshness",
    "waiver_standing",
    "state",
    "state_label",
    "gate",
    "effective_qualification",
    "evidence_class",
    "owner_role",
    "forum",
    "proof_ref",
    "status",
    "signal",
    "detail_message_id"
  ],
  "properties": {
    "function": {
      "type": "string",
      "enum": [
        "package_boundary_integrity",
        "protected_path_review",
        "schema_example_parity",
        "evidence_freshness_slo",
        "claim_no_overclaim",
        "route_explainability",
        "provenance_completeness"
      ]
    },
    "function_label": { "type": "string", "minLength": 1 },
    "service": {
      "type": "string",
      "enum": [
        "package_governance",
        "evidence_pipeline",
        "claim_publication",
        "route_provenance"
      ]
    },
    "scope_profile": {
      "type": "string",
      "enum": ["managed", "self_hosted", "regulated", "sovereign"]
    },
    "corpus_id": { "type": "string", "minLength": 1 },
    "measure": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "measure_label": { "type": "string", "minLength": 1 },
    "evidence_freshness": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "waiver_standing": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "enum": ["active", "expiring_soon", "expired"] }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "passing",
        "warning",
        "evidence_stale",
        "waived",
        "waiver_expired",
        "blocked"
      ]
    },
    "state_label": { "type": "string", "minLength": 1 },
    "gate": { "type": "string", "enum": ["governed", "narrowed", "blocked"] },
    "effective_qualification": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "deprecated",
        "unavailable"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "owner_role": { "type": "string", "minLength": 1 },
    "forum": {
      "type": "string",
      "enum": ["shiproom_forum", "governance_council", "architecture_forum"]
    },
    "proof_ref": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": { "type": "string", "enum": ["green", "yellow", "red"] },
    "detail_message_id": { "type": "string", "minLength": 1 }
  }
}
