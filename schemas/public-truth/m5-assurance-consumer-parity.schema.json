{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-assurance-consumer-parity.schema.json",
  "title": "M5 assurance consumer-parity packet",
  "description": "One converged model the claimed M5 help/procurement/evaluation/support/public-truth surfaces all read from, built over the assurance center, assurance-claim reducer, governance dashboard, capability-boundary inspector, and event-provenance inspector so no surface restates the same trust facts independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "source_bindings",
    "facts",
    "consumer_views",
    "export_preview",
    "vocabulary",
    "summary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_assurance_consumer_parity" },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "source_bindings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/source_binding" }
    },
    "facts": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/unified_fact" }
    },
    "consumer_views": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/consumer_view" }
    },
    "export_preview": { "$ref": "#/$defs/export_preview" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "summary": { "$ref": "#/$defs/summary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "help_about",
        "procurement_export",
        "evaluation_packet",
        "support_export",
        "release_public_truth"
      ]
    },
    "source_packet": {
      "enum": [
        "assurance_center",
        "assurance_claim_reducer",
        "governance_dashboard",
        "boundary_inspector",
        "event_provenance"
      ]
    },
    "domain": {
      "enum": [
        "assurance_claim",
        "control_proof",
        "governance_fitness",
        "service_ownership",
        "decision_right",
        "capability_boundary",
        "route_timeline",
        "approval_ticket",
        "event_provenance"
      ]
    },
    "gate": { "enum": ["governed", "narrowed", "blocked"] },
    "status": { "enum": ["mapped", "provisional", "unmapped"] },
    "signal": { "enum": ["green", "yellow", "red"] },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "freshness": { "enum": ["current", "stale", "expired", "missing"] },
    "message_id": {
      "type": "string",
      "pattern": "^public_truth\\.assurance_consumer_parity\\."
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "gate",
        "effective_qualification",
        "status",
        "signal",
        "owner_role",
        "converges_with_fact",
        "message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "type": "string", "minLength": 1 },
        "gate": { "$ref": "#/$defs/gate" },
        "effective_qualification": { "$ref": "#/$defs/qualification" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "owner_role": { "type": "string", "minLength": 1 },
        "converges_with_fact": { "const": true },
        "message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "unified_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "domain_label",
        "source_packet",
        "subject",
        "label",
        "gate",
        "effective_qualification",
        "status",
        "signal",
        "owner_role",
        "evidence_freshness",
        "evidence_refs",
        "source_ref",
        "consumer_projections",
        "fact_message_id"
      ],
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "domain_label": { "type": "string", "minLength": 1 },
        "source_packet": { "$ref": "#/$defs/source_packet" },
        "subject": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "gate": { "$ref": "#/$defs/gate" },
        "effective_qualification": { "$ref": "#/$defs/qualification" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "owner_role": { "type": "string", "minLength": 1 },
        "evidence_freshness": { "$ref": "#/$defs/freshness" },
        "evidence_refs": { "$ref": "#/$defs/evidence_refs" },
        "source_ref": { "type": "string", "minLength": 1 },
        "consumer_projections": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/consumer_projection" }
        },
        "fact_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "consumer_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "owner_role",
        "fact_count",
        "governed_facts",
        "narrowed_facts",
        "blocked_facts",
        "worst_gate",
        "effective_qualification",
        "status",
        "signal",
        "reads_all_facts",
        "fact_refs",
        "view_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "fact_count": { "type": "integer", "minimum": 0 },
        "governed_facts": { "type": "integer", "minimum": 0 },
        "narrowed_facts": { "type": "integer", "minimum": 0 },
        "blocked_facts": { "type": "integer", "minimum": 0 },
        "worst_gate": { "$ref": "#/$defs/gate" },
        "effective_qualification": { "$ref": "#/$defs/qualification" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "reads_all_facts": { "const": true },
        "fact_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "view_message_id": { "$ref": "#/$defs/message_id" }
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_packet",
        "source_label",
        "packet_id",
        "record_kind",
        "registry_ref",
        "fact_count",
        "validated_clean",
        "blocks_stable_promotion"
      ],
      "properties": {
        "source_packet": { "$ref": "#/$defs/source_packet" },
        "source_label": { "type": "string", "minLength": 1 },
        "packet_id": { "type": "string", "minLength": 1 },
        "record_kind": { "type": "string", "minLength": 1 },
        "registry_ref": { "type": "string", "minLength": 1 },
        "fact_count": { "type": "integer", "minimum": 0 },
        "validated_clean": { "type": "boolean" },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "export_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "subject",
        "source_packet",
        "gate",
        "effective_qualification",
        "status",
        "owner_role",
        "evidence_freshness",
        "evidence_refs",
        "source_ref"
      ],
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "subject": { "type": "string", "minLength": 1 },
        "source_packet": { "$ref": "#/$defs/source_packet" },
        "gate": { "$ref": "#/$defs/gate" },
        "effective_qualification": { "$ref": "#/$defs/qualification" },
        "status": { "$ref": "#/$defs/status" },
        "owner_role": { "type": "string", "minLength": 1 },
        "evidence_freshness": { "$ref": "#/$defs/freshness" },
        "evidence_refs": { "$ref": "#/$defs/evidence_refs" },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "export_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "preview_id",
        "generated_from",
        "evaluated_at",
        "consumers",
        "domains",
        "entries",
        "redaction_class_token"
      ],
      "properties": {
        "record_kind": { "const": "m5_assurance_consumer_parity_export_preview" },
        "schema_version": { "const": 1 },
        "preview_id": { "type": "string", "minLength": 1 },
        "generated_from": { "type": "string", "minLength": 1 },
        "evaluated_at": { "type": "string", "minLength": 1 },
        "consumers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/consumer" }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/domain" }
        },
        "entries": {
          "type": "array",
          "minItems": 9,
          "items": { "$ref": "#/$defs/export_entry" }
        },
        "redaction_class_token": { "type": "string", "minLength": 1 }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumers",
        "source_packets",
        "domains",
        "gates",
        "signals",
        "qualifications",
        "freshness_states"
      ],
      "properties": {
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "source_packets": { "type": "array", "items": { "$ref": "#/$defs/source_packet" } },
        "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" } },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
        "qualifications": { "type": "array", "items": { "$ref": "#/$defs/qualification" } },
        "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_facts",
        "governed_facts",
        "narrowed_facts",
        "blocked_facts",
        "total_consumers",
        "total_domains",
        "bound_sources",
        "total_projections",
        "converged_projections",
        "worst_gate",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_facts": { "type": "integer", "minimum": 0 },
        "governed_facts": { "type": "integer", "minimum": 0 },
        "narrowed_facts": { "type": "integer", "minimum": 0 },
        "blocked_facts": { "type": "integer", "minimum": 0 },
        "total_consumers": { "const": 5 },
        "total_domains": { "type": "integer", "minimum": 1 },
        "bound_sources": { "const": 5 },
        "total_projections": { "type": "integer", "minimum": 0 },
        "converged_projections": { "type": "integer", "minimum": 0 },
        "worst_gate": { "$ref": "#/$defs/gate" },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts_derive_from_gate",
        "every_fact_projects_to_every_consumer",
        "consumers_converge_on_fact",
        "no_consumer_strengthens_a_fact",
        "every_consumer_reads_every_fact",
        "all_sources_bound",
        "bound_sources_validated_clean",
        "facts_preserve_evidence_lineage",
        "export_mirrors_live_facts",
        "export_carries_no_raw_material",
        "controlled_enums_frozen"
      ],
      "properties": {
        "facts_derive_from_gate": { "const": true },
        "every_fact_projects_to_every_consumer": { "const": true },
        "consumers_converge_on_fact": { "const": true },
        "no_consumer_strengthens_a_fact": { "const": true },
        "every_consumer_reads_every_fact": { "const": true },
        "all_sources_bound": { "const": true },
        "bound_sources_validated_clean": { "const": true },
        "facts_preserve_evidence_lineage": { "const": true },
        "export_mirrors_live_facts": { "const": true },
        "export_carries_no_raw_material": { "const": true },
        "controlled_enums_frozen": { "const": true }
      }
    }
  }
}
