{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-decision-right-card.schema.json",
  "title": "Aureline M5 governance decision-right card",
  "description": "One decision-right card from the M5 governance dashboard, validatable on its own so release, Help/About, support, and evaluation exports can carry a single decision card without the whole packet. A card makes decision authority first-class: it names the governed decision, the forum that exercises it, the accountable owner role, and the services it governs, then derives whether the decision is currently exercisable (clear), needs review (watch), or is held (held) from the worst tile state across its governed scope. The card names roles and forums, never individuals, and carries no private membership or credential bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "decision_label",
    "forum",
    "forum_label",
    "accountable_owner",
    "governed_services",
    "governed_function_count",
    "worst_state",
    "worst_state_label",
    "posture",
    "posture_label",
    "blocking_function_count",
    "open_waiver_count",
    "gate",
    "effective_qualification",
    "evidence_refs",
    "status",
    "signal",
    "card_message_id"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "stable_promotion",
        "waiver_acceptance",
        "boundary_change",
        "exception_renewal"
      ]
    },
    "decision_label": { "type": "string", "minLength": 1 },
    "forum": {
      "type": "string",
      "enum": ["shiproom_forum", "governance_council", "architecture_forum"]
    },
    "forum_label": { "type": "string", "minLength": 1 },
    "accountable_owner": { "type": "string", "minLength": 1 },
    "governed_services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "package_governance",
          "evidence_pipeline",
          "claim_publication",
          "route_provenance"
        ]
      }
    },
    "governed_function_count": { "type": "integer", "minimum": 0 },
    "worst_state": {
      "type": "string",
      "enum": [
        "passing",
        "warning",
        "evidence_stale",
        "waived",
        "waiver_expired",
        "blocked"
      ]
    },
    "worst_state_label": { "type": "string", "minLength": 1 },
    "posture": { "type": "string", "enum": ["clear", "watch", "held"] },
    "posture_label": { "type": "string", "minLength": 1 },
    "blocking_function_count": { "type": "integer", "minimum": 0 },
    "open_waiver_count": { "type": "integer", "minimum": 0 },
    "gate": { "type": "string", "enum": ["governed", "narrowed", "blocked"] },
    "effective_qualification": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "deprecated",
        "unavailable"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": { "type": "string", "enum": ["green", "yellow", "red"] },
    "card_message_id": { "type": "string", "minLength": 1 }
  }
}
