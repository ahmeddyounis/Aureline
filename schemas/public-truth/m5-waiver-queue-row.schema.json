{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-waiver-queue-row.schema.json",
  "title": "Aureline M5 governance waiver-expiry-queue row",
  "description": "One waiver-expiry-queue row from the M5 governance dashboard, validatable on its own so release, Help/About, support, and evaluation exports can carry a single waiver row without the whole packet. A row records a fitness function held under an accepted waiver, its expiry standing (active, expiring_soon, or expired), and the disclosure a reviewer needs to act: the expiry date, the rationale, the responsible party, the action that clears it, and the governance ticket it rides. An in-date waiver narrows the function to waived; an expired waiver blocks it to waiver_expired. The row carries no private incident content beyond the rationale and no credential bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "function",
    "function_label",
    "service",
    "corpus_id",
    "queue_state",
    "queue_state_label",
    "expiry",
    "rationale",
    "responsible_party",
    "action",
    "ticket_ref",
    "tile_state",
    "owner_role",
    "forum",
    "status",
    "signal",
    "detail_message_id"
  ],
  "properties": {
    "function": {
      "type": "string",
      "enum": [
        "package_boundary_integrity",
        "protected_path_review",
        "schema_example_parity",
        "evidence_freshness_slo",
        "claim_no_overclaim",
        "route_explainability",
        "provenance_completeness"
      ]
    },
    "function_label": { "type": "string", "minLength": 1 },
    "service": {
      "type": "string",
      "enum": [
        "package_governance",
        "evidence_pipeline",
        "claim_publication",
        "route_provenance"
      ]
    },
    "corpus_id": { "type": "string", "minLength": 1 },
    "queue_state": {
      "type": "string",
      "enum": ["active", "expiring_soon", "expired"]
    },
    "queue_state_label": { "type": "string", "minLength": 1 },
    "expiry": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "responsible_party": {
      "type": "string",
      "enum": ["service_owner", "governance_owner", "release_owner"]
    },
    "action": {
      "type": "string",
      "enum": [
        "remediate_and_reverify",
        "renew_waiver",
        "accept_residual_risk",
        "enable_compensating_control"
      ]
    },
    "ticket_ref": { "type": "string", "minLength": 1 },
    "tile_state": {
      "type": "string",
      "enum": [
        "passing",
        "warning",
        "evidence_stale",
        "waived",
        "waiver_expired",
        "blocked"
      ]
    },
    "owner_role": { "type": "string", "minLength": 1 },
    "forum": {
      "type": "string",
      "enum": ["shiproom_forum", "governance_council", "architecture_forum"]
    },
    "status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": { "type": "string", "enum": ["green", "yellow", "red"] },
    "detail_message_id": { "type": "string", "minLength": 1 }
  }
}
