{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-assurance-claim-reducer.schema.json",
  "title": "Aureline M5 assurance-claim reducer",
  "description": "The one source of truth that automatically narrows Aureline's regulated, self-hosted, sovereign, no-vendor, no-telemetry, and customer-managed-key claims the moment a precondition behind them drifts, and drives every consumer of those claims from that one output. Each regulated claim depends on four trust preconditions: fresh supporting evidence, an unchanged hosted-dependency boundary, pinned key / data residency, and an intact policy / control path. A reduced claim derives its state from the worst gate among its required preconditions, so a claim can never read stronger than the trust facts behind it: a drifted precondition narrows the claim to under_review, an invalidated precondition blocks it to unproven. Every weaker state records which precondition drifted (the named drift token) and the restoration action that would lift it, and when not fully governed the claim carries a nearest truthful fallback naming the weaker posture that is still true. Every consumer surface — the About / help panel, the assurance center, the exported evaluation packet, the procurement export, and the release / public-truth manifest — projects the same reduced state, so a claim narrowed in one consumer can never read stronger in another. The packet is metadata-only: it preserves drift / evidence lineage as refs and carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "precondition_states",
    "reduced_claims",
    "export_preview",
    "vocabulary",
    "summary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_assurance_claim_reducer" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "precondition_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/precondition_reading" }
    },
    "reduced_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/reduced_claim" }
    },
    "export_preview": { "$ref": "#/$defs/export_preview" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "summary": { "$ref": "#/$defs/summary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "claim_subject": {
      "type": "string",
      "enum": [
        "local_first_continuity",
        "telemetry_control",
        "key_ownership",
        "data_residency",
        "regulated_operation",
        "air_gap_containment",
        "sovereign_deployment"
      ]
    },
    "claim_state": {
      "type": "string",
      "enum": ["proven", "attested", "under_review", "exception_pending", "unproven"]
    },
    "precondition": {
      "type": "string",
      "enum": [
        "evidence_freshness",
        "hosted_dependency_boundary",
        "key_residency",
        "policy_control_path"
      ]
    },
    "precondition_status": {
      "type": "string",
      "enum": ["satisfied", "drifted", "invalidated"]
    },
    "drift_token": {
      "type": "string",
      "enum": [
        "stale_evidence",
        "evidence_expired",
        "hosted_dependency_drift",
        "boundary_dependency_added",
        "key_residency_drift",
        "key_residency_mismatch",
        "policy_path_degraded",
        "policy_path_regression"
      ]
    },
    "restoration_action": {
      "type": "string",
      "enum": [
        "refresh_evidence",
        "restore_boundary",
        "repin_key_residency",
        "restore_policy_path"
      ]
    },
    "consumer": {
      "type": "string",
      "enum": [
        "help_about",
        "assurance_center",
        "evaluation_packet",
        "procurement_export",
        "release_public_truth"
      ]
    },
    "deployment_profile": {
      "type": "string",
      "enum": ["managed", "self_hosted", "regulated", "sovereign"]
    },
    "trust_boundary": {
      "type": "string",
      "enum": ["local_first", "control_plane"]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "gate": {
      "type": "string",
      "enum": ["governed", "narrowed", "blocked"]
    },
    "consumer_status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "precondition_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precondition",
        "precondition_label",
        "status",
        "status_label",
        "gate",
        "evidence_class",
        "owner_role",
        "proof_ref"
      ],
      "properties": {
        "precondition": { "$ref": "#/$defs/precondition" },
        "precondition_label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/precondition_status" },
        "status_label": { "type": "string", "minLength": 1 },
        "gate": { "$ref": "#/$defs/gate" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "owner_role": { "type": "string", "minLength": 1 },
        "proof_ref": { "type": "string", "minLength": 1 }
      }
    },
    "precondition_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precondition",
        "drift",
        "drift_label",
        "status",
        "gate",
        "blocking",
        "restoration_action",
        "evidence_ref",
        "cause_message_id"
      ],
      "properties": {
        "precondition": { "$ref": "#/$defs/precondition" },
        "drift": { "$ref": "#/$defs/drift_token" },
        "drift_label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/precondition_status" },
        "gate": { "$ref": "#/$defs/gate" },
        "blocking": { "type": "boolean" },
        "restoration_action": { "$ref": "#/$defs/restoration_action" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "cause_message_id": {
          "type": "string",
          "pattern": "^public_truth\\.assurance_claim_reducer\\."
        }
      }
    },
    "nearest_truthful": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fallback_posture",
        "fallback_state",
        "still_satisfied",
        "drifted_preconditions",
        "message_id"
      ],
      "properties": {
        "fallback_posture": { "$ref": "#/$defs/deployment_profile" },
        "fallback_state": { "$ref": "#/$defs/claim_state" },
        "still_satisfied": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "drifted_preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "message_id": {
          "type": "string",
          "pattern": "^public_truth\\.assurance_claim_reducer\\."
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "claim_state",
        "effective_qualification",
        "status",
        "signal",
        "owner_role",
        "converges_with_reduced",
        "message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "type": "string", "minLength": 1 },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "owner_role": { "type": "string", "minLength": 1 },
        "converges_with_reduced": { "type": "boolean" },
        "message_id": {
          "type": "string",
          "pattern": "^public_truth\\.assurance_claim_reducer\\."
        }
      }
    },
    "reduced_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "subject_label",
        "claimed_posture",
        "trust_boundaries",
        "owner_role",
        "preconditions",
        "reduced_state",
        "reduced_state_label",
        "reduced_gate",
        "effective_qualification",
        "drifts",
        "evidence_refs",
        "nearest_truthful",
        "status",
        "signal",
        "consumer_projections",
        "state_message_id"
      ],
      "properties": {
        "subject": { "$ref": "#/$defs/claim_subject" },
        "subject_label": { "type": "string", "minLength": 1 },
        "claimed_posture": { "$ref": "#/$defs/deployment_profile" },
        "trust_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/trust_boundary" }
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition_reading" }
        },
        "reduced_state": { "$ref": "#/$defs/claim_state" },
        "reduced_state_label": { "type": "string", "minLength": 1 },
        "reduced_gate": { "$ref": "#/$defs/gate" },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "drifts": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition_drift" }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nearest_truthful": {
          "oneOf": [
            { "$ref": "#/$defs/nearest_truthful" },
            { "type": "null" }
          ]
        },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "consumer_projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_projection" }
        },
        "state_message_id": {
          "type": "string",
          "pattern": "^public_truth\\.assurance_claim_reducer\\."
        }
      }
    },
    "export_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "claimed_posture",
        "reduced_state",
        "effective_qualification",
        "drift_tokens",
        "nearest_posture",
        "nearest_state",
        "evidence_refs"
      ],
      "properties": {
        "subject": { "$ref": "#/$defs/claim_subject" },
        "claimed_posture": { "$ref": "#/$defs/deployment_profile" },
        "reduced_state": { "$ref": "#/$defs/claim_state" },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "drift_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/drift_token" }
        },
        "nearest_posture": {
          "oneOf": [
            { "$ref": "#/$defs/deployment_profile" },
            { "type": "null" }
          ]
        },
        "nearest_state": {
          "oneOf": [
            { "$ref": "#/$defs/claim_state" },
            { "type": "null" }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "export_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "preview_id",
        "generated_from",
        "evaluated_at",
        "entries",
        "consumers",
        "redaction_class_token"
      ],
      "properties": {
        "record_kind": { "const": "m5_assurance_narrowing_export_preview" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "preview_id": { "type": "string", "minLength": 1 },
        "generated_from": { "type": "string", "minLength": 1 },
        "evaluated_at": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_entry" }
        },
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer" }
        },
        "redaction_class_token": { "type": "string", "minLength": 1 }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_subjects",
        "claim_states",
        "preconditions",
        "precondition_statuses",
        "drift_tokens",
        "restoration_actions",
        "consumers",
        "deployment_profiles",
        "trust_boundaries",
        "evidence_classes",
        "qualification_classes",
        "gate_decisions"
      ],
      "properties": {
        "claim_subjects": { "type": "array", "items": { "$ref": "#/$defs/claim_subject" } },
        "claim_states": { "type": "array", "items": { "$ref": "#/$defs/claim_state" } },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/precondition" } },
        "precondition_statuses": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition_status" }
        },
        "drift_tokens": { "type": "array", "items": { "$ref": "#/$defs/drift_token" } },
        "restoration_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/restoration_action" }
        },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "deployment_profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/deployment_profile" }
        },
        "trust_boundaries": { "type": "array", "items": { "$ref": "#/$defs/trust_boundary" } },
        "evidence_classes": { "type": "array", "items": { "$ref": "#/$defs/evidence_class" } },
        "qualification_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualification_class" }
        },
        "gate_decisions": { "type": "array", "items": { "$ref": "#/$defs/gate" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_claims",
        "proven_claims",
        "narrowed_claims",
        "blocked_claims",
        "total_drifts",
        "total_projections",
        "converged_projections",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_claims": { "type": "integer", "minimum": 0 },
        "proven_claims": { "type": "integer", "minimum": 0 },
        "narrowed_claims": { "type": "integer", "minimum": 0 },
        "blocked_claims": { "type": "integer", "minimum": 0 },
        "total_drifts": { "type": "integer", "minimum": 0 },
        "total_projections": { "type": "integer", "minimum": 0 },
        "converged_projections": { "type": "integer", "minimum": 0 },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reduced_state_derived_from_preconditions",
        "no_claim_overstates_preconditions",
        "stale_evidence_narrows",
        "hosted_dependency_drift_narrows",
        "key_residency_mismatch_blocks",
        "policy_path_regression_blocks",
        "drift_attributed_to_precondition",
        "consumers_converge_on_reduced_state",
        "no_consumer_strengthens_after_narrowing",
        "nearest_truthful_present_when_not_governed",
        "nearest_truthful_never_overstates",
        "controlled_enums_frozen",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "reduced_state_derived_from_preconditions": { "type": "boolean" },
        "no_claim_overstates_preconditions": { "type": "boolean" },
        "stale_evidence_narrows": { "type": "boolean" },
        "hosted_dependency_drift_narrows": { "type": "boolean" },
        "key_residency_mismatch_blocks": { "type": "boolean" },
        "policy_path_regression_blocks": { "type": "boolean" },
        "drift_attributed_to_precondition": { "type": "boolean" },
        "consumers_converge_on_reduced_state": { "type": "boolean" },
        "no_consumer_strengthens_after_narrowing": { "type": "boolean" },
        "nearest_truthful_present_when_not_governed": { "type": "boolean" },
        "nearest_truthful_never_overstates": { "type": "boolean" },
        "controlled_enums_frozen": { "type": "boolean" },
        "export_carries_no_raw_material": { "type": "boolean" }
      }
    }
  }
}
