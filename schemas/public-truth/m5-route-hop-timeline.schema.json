{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-route-hop-timeline.schema.json",
  "title": "Aureline M5 route-hop timeline",
  "description": "One ordered route-hop timeline from the M5 boundary inspector, validatable on its own so desktop, support export, and evaluation / procurement packets can carry a single inspector-backed route without the whole packet. The timeline lists, in route order, every hop a consequential M5 action's work passed through — its locality, role, certificate context, and any drift marker — and binds the action's route-hop state from the assurance / route governance matrix vocabulary. The effective gate folds in the worst hop drift and the route evidence freshness, so the timeline auto-narrows on a mirror substitution or certificate drift and blocks on an unattributed hop, never reading more attributable than its hops allow. The timeline carries no credential bodies or raw provider payloads; the proof ref is a repo-relative reference only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "action_label",
    "route_state",
    "route_state_label",
    "hops",
    "origin_locality",
    "final_locality",
    "crosses_trust_boundary",
    "drift_marker_count",
    "evidence_freshness",
    "effective_gate",
    "effective_qualification",
    "evidence_class",
    "owner_role",
    "proof_ref",
    "status",
    "signal",
    "timeline_message_id"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "local_model_execution",
        "remote_model_inference",
        "provider_credential_rotation",
        "workspace_data_export",
        "control_plane_sync",
        "offline_model_acquisition",
        "admin_policy_push",
        "support_bundle_handoff"
      ]
    },
    "action_label": { "type": "string", "minLength": 1 },
    "route_state": {
      "type": "string",
      "enum": [
        "local_only",
        "attributed_remote",
        "mirrored_route",
        "route_degraded",
        "unattributed_route"
      ]
    },
    "route_state_label": { "type": "string", "minLength": 1 },
    "hops": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route_hop" }
    },
    "origin_locality": { "$ref": "#/$defs/hop_locality" },
    "final_locality": { "$ref": "#/$defs/hop_locality" },
    "crosses_trust_boundary": { "type": "boolean" },
    "drift_marker_count": { "type": "integer", "minimum": 0 },
    "evidence_freshness": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "effective_gate": {
      "type": "string",
      "enum": ["governed", "narrowed", "blocked"]
    },
    "effective_qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "owner_role": { "type": "string", "minLength": 1 },
    "proof_ref": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "timeline_message_id": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hop_locality": {
      "type": "string",
      "enum": [
        "local_machine",
        "local_network",
        "remote_region",
        "control_plane",
        "mirror_edge",
        "vendor_edge"
      ]
    },
    "route_hop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "locality",
        "locality_label",
        "role",
        "certificate_context",
        "is_local",
        "drift_marker",
        "hop_gate",
        "detail_message_id"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "locality": { "$ref": "#/$defs/hop_locality" },
        "locality_label": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["origin", "proxy", "mirror", "target"]
        },
        "certificate_context": {
          "type": "string",
          "enum": [
            "no_tls_local",
            "local_trust",
            "pinned_certificate",
            "mirror_certificate",
            "control_plane_certificate"
          ]
        },
        "is_local": { "type": "boolean" },
        "drift_marker": {
          "type": "string",
          "enum": [
            "none",
            "locality_drift",
            "certificate_drift",
            "mirror_substitution",
            "unattributed_hop"
          ]
        },
        "hop_gate": {
          "type": "string",
          "enum": ["governed", "narrowed", "blocked"]
        },
        "detail_message_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
