{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-assurance-certification.schema.json",
  "title": "Aureline M5 assurance certification",
  "description": "Per-profile certification of the M5 assurance / governance / boundary-route / event-provenance contract. The certification projects the assurance / governance / route-provenance governance matrix onto the claimed M5 deployment-profile grid (managed, self_hosted, regulated, sovereign) and qualifies each profile along four proof dimensions that group the governed facets: assurance center (assurance claim, control proof, exception / waiver), governance (governance freshness, service ownership), boundary / route (capability boundary, route hop, approval ticket), and event provenance (event provenance). For one profile and one dimension it gathers the governed facets that back the dimension and scope to that profile: a dimension no facet covers for the profile is honestly labeled not-applicable, otherwise the cell takes the worst proof freshness and worst assurance-state gate among the covering facets so a narrowed control or stale proof can never read as fully proven. A profile's gate is the worst of its applicable cells and its effective qualification is the claimed class narrowed down that gate — governed keeps the Stable claim, narrowed floors it at Beta, blocked floors it at Unavailable. The claimed release surfaces (release center, About / help, shiproom, support export, procurement / evaluation) each bind the dimensions they surface and derive their posture and the exact profile claims they must narrow or block, so release, help, support, shiproom, and evaluation read one certification result rather than local trust overrides. The packet is metadata-only: it carries no credential bodies or raw provider payloads and reduces every cell to refs-only proof paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "governance_packet_id",
    "governance_ref",
    "profiles",
    "consumers",
    "consumer_tokens",
    "disclosure",
    "summary",
    "release_gate",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_assurance_certification"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "governance_packet_id": { "type": "string", "minLength": 1 },
    "governance_ref": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile_claim" }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "consumer_tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer" }
    },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "summary": { "$ref": "#/$defs/summary" },
    "release_gate": { "$ref": "#/$defs/release_gate" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "profile": {
      "type": "string",
      "enum": ["managed", "self_hosted", "regulated", "sovereign"]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "dimension": {
      "type": "string",
      "enum": ["assurance_center", "governance", "boundary_route", "event_provenance"]
    },
    "outcome": {
      "type": "string",
      "enum": ["certified", "narrowed", "blocked", "not_applicable"]
    },
    "gate": {
      "type": "string",
      "enum": ["governed", "narrowed", "blocked"]
    },
    "status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "gap_kind": {
      "type": "string",
      "enum": ["facet_ungoverned", "proof_stale", "proof_expired", "proof_missing", "assurance_state_narrowed", "assurance_state_blocked"]
    },
    "facet": {
      "type": "string",
      "enum": ["assurance_claim", "control_proof", "exception_waiver", "governance_freshness", "service_ownership", "capability_boundary", "route_hop", "approval_ticket", "event_provenance"]
    },
    "freshness": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "consumer": {
      "type": "string",
      "enum": ["release_center", "help_about", "shiproom", "support_export", "procurement_evaluation"]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "dimension_label",
        "outcome",
        "backing_facets",
        "proof_refs",
        "proof_freshness",
        "state_gate",
        "worst_state_token",
        "gate",
        "status",
        "signal",
        "gap_kind",
        "detail_message_id"
      ],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "dimension_label": { "type": "string", "minLength": 1 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "backing_facets": {
          "type": "array",
          "items": { "$ref": "#/$defs/facet" }
        },
        "proof_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "proof_freshness": {
          "anyOf": [{ "$ref": "#/$defs/freshness" }, { "type": "null" }]
        },
        "state_gate": {
          "anyOf": [{ "$ref": "#/$defs/gate" }, { "type": "null" }]
        },
        "worst_state_token": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gap_kind": {
          "anyOf": [{ "$ref": "#/$defs/gap_kind" }, { "type": "null" }]
        },
        "detail_message_id": {
          "type": "string",
          "pattern": "^public_truth\\.assurance_certification\\."
        }
      },
      "allOf": [
        {
          "comment": "A not-applicable cell carries no backing facets and no gap.",
          "if": { "properties": { "outcome": { "const": "not_applicable" } } },
          "then": {
            "properties": {
              "backing_facets": { "maxItems": 0 },
              "proof_freshness": { "type": "null" },
              "state_gate": { "type": "null" },
              "worst_state_token": { "type": "null" },
              "gate": { "const": "governed" },
              "gap_kind": { "type": "null" }
            }
          }
        },
        {
          "comment": "An applicable, non-certified cell names why it narrowed or blocked.",
          "if": {
            "anyOf": [
              { "properties": { "outcome": { "const": "narrowed" } } },
              { "properties": { "outcome": { "const": "blocked" } } }
            ]
          },
          "then": {
            "required": ["gap_kind"],
            "properties": {
              "gap_kind": { "$ref": "#/$defs/gap_kind" },
              "proof_freshness": { "$ref": "#/$defs/freshness" }
            }
          }
        }
      ]
    },
    "profile_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "claim_label",
        "claim_ref",
        "claimed_qualification",
        "cells",
        "applicable_dimensions",
        "effective_qualification",
        "gate",
        "status",
        "signal",
        "verdict_message_id"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "claim_label": { "type": "string", "minLength": 1 },
        "claim_ref": { "type": "string", "minLength": 1 },
        "claimed_qualification": { "$ref": "#/$defs/qualification" },
        "cells": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/cell" }
        },
        "applicable_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "effective_qualification": { "$ref": "#/$defs/qualification" },
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "verdict_message_id": {
          "type": "string",
          "pattern": "^public_truth\\.assurance_certification\\."
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "owner_role",
        "read_dimensions",
        "gate",
        "status",
        "signal",
        "narrowed_profile_refs",
        "blocked_profile_refs",
        "status_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "read_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/status" },
        "signal": { "$ref": "#/$defs/signal" },
        "narrowed_profile_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_profile_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "status_message_id": {
          "type": "string",
          "pattern": "^public_truth\\.assurance_certification\\."
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "one_certification_across_surfaces"],
      "properties": {
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer" }
        },
        "one_certification_across_surfaces": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_profiles",
        "certified_profiles",
        "narrowed_profiles",
        "blocked_profiles",
        "total_consumers",
        "certified_consumers",
        "narrowed_consumers",
        "blocked_consumers",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_profiles": { "type": "integer", "minimum": 0 },
        "certified_profiles": { "type": "integer", "minimum": 0 },
        "narrowed_profiles": { "type": "integer", "minimum": 0 },
        "blocked_profiles": { "type": "integer", "minimum": 0 },
        "total_consumers": { "type": "integer", "minimum": 0 },
        "certified_consumers": { "type": "integer", "minimum": 0 },
        "narrowed_consumers": { "type": "integer", "minimum": 0 },
        "blocked_consumers": { "type": "integer", "minimum": 0 },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "blocks_stable_promotion",
        "narrowed_profile_refs",
        "blocked_profile_refs",
        "drifted_dimensions",
        "gate_message_id"
      ],
      "properties": {
        "gate": { "$ref": "#/$defs/gate" },
        "blocks_stable_promotion": { "type": "boolean" },
        "narrowed_profile_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_profile_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "drifted_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "gate_message_id": {
          "type": "string",
          "pattern": "^public_truth\\.assurance_certification\\."
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "dimensions", "outcomes", "gap_kinds", "facets", "consumers"],
      "properties": {
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } },
        "gap_kinds": { "type": "array", "items": { "$ref": "#/$defs/gap_kind" } },
        "facets": { "type": "array", "items": { "$ref": "#/$defs/facet" } },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_profile_mapped_to_proof",
        "stale_proof_narrows_deterministically",
        "narrowing_is_per_profile",
        "surfaces_consume_one_certification",
        "generated_from_governance_matrix",
        "controlled_enums_frozen",
        "export_carries_no_raw_material",
        "export_preserves_route_evidence_lineage"
      ],
      "properties": {
        "every_profile_mapped_to_proof": { "const": true },
        "stale_proof_narrows_deterministically": { "const": true },
        "narrowing_is_per_profile": { "const": true },
        "surfaces_consume_one_certification": { "const": true },
        "generated_from_governance_matrix": { "const": true },
        "controlled_enums_frozen": { "const": true },
        "export_carries_no_raw_material": { "const": true },
        "export_preserves_route_evidence_lineage": { "const": true }
      }
    }
  }
}
