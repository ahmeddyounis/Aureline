{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-boundary-summary-card.schema.json",
  "title": "Aureline M5 boundary summary card",
  "description": "One boundary summary card from the M5 boundary inspector, validatable on its own so desktop, support export, and evaluation / procurement packets can carry a single inspector-backed card without the whole packet. The card declares the execution / data boundary class a consequential M5 action crosses, who initiated it, the target class, the sensitive data classes that crossed (category labels only, never the data itself), the approving authority, and an export-safe one-line summary. Its capability-boundary state is read from the assurance / route governance matrix vocabulary, and the effective gate folds in evidence freshness so the card can never read further within boundary than its proof. The card carries no credential bodies or raw provider payloads; the proof ref is a repo-relative reference only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "action_label",
    "boundary_class",
    "boundary_class_label",
    "actor",
    "actor_label",
    "source_locality",
    "target_class",
    "target_class_label",
    "sensitive_data_classes",
    "approval_authority",
    "boundary_state",
    "boundary_state_label",
    "evidence_freshness",
    "effective_gate",
    "effective_qualification",
    "trust_boundaries",
    "crosses_trust_boundary",
    "evidence_class",
    "owner_role",
    "proof_ref",
    "export_safe_summary",
    "status",
    "signal",
    "detail_message_id"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "local_model_execution",
        "remote_model_inference",
        "provider_credential_rotation",
        "workspace_data_export",
        "control_plane_sync",
        "offline_model_acquisition",
        "admin_policy_push",
        "support_bundle_handoff"
      ]
    },
    "action_label": { "type": "string", "minLength": 1 },
    "boundary_class": {
      "type": "string",
      "enum": [
        "local_execution",
        "local_to_remote_provider",
        "local_to_control_plane",
        "vendor_handoff"
      ]
    },
    "boundary_class_label": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "string",
      "enum": ["local_user", "workspace_admin", "automation_agent", "support_engineer"]
    },
    "actor_label": { "type": "string", "minLength": 1 },
    "source_locality": {
      "type": "string",
      "enum": [
        "local_machine",
        "local_network",
        "remote_region",
        "control_plane",
        "mirror_edge",
        "vendor_edge"
      ]
    },
    "target_class": {
      "type": "string",
      "enum": [
        "local_machine",
        "remote_provider",
        "managed_control_plane",
        "mirror_registry",
        "vendor_support"
      ]
    },
    "target_class_label": { "type": "string", "minLength": 1 },
    "sensitive_data_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "source_content",
          "prompt_context",
          "workspace_metadata",
          "model_artifact",
          "diagnostic_bundle",
          "credential_reference"
        ]
      }
    },
    "approval_authority": {
      "type": "string",
      "enum": [
        "standing_policy",
        "user_consent",
        "workspace_admin",
        "security_officer",
        "runtime_broker"
      ]
    },
    "boundary_state": {
      "type": "string",
      "enum": [
        "within_boundary",
        "boundary_documented",
        "at_boundary_edge",
        "boundary_narrowed",
        "outside_boundary"
      ]
    },
    "boundary_state_label": { "type": "string", "minLength": 1 },
    "evidence_freshness": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "effective_gate": {
      "type": "string",
      "enum": ["governed", "narrowed", "blocked"]
    },
    "effective_qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "trust_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["local_first", "control_plane"] }
    },
    "crosses_trust_boundary": { "type": "boolean" },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "owner_role": { "type": "string", "minLength": 1 },
    "proof_ref": { "type": "string", "minLength": 1 },
    "export_safe_summary": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "detail_message_id": { "type": "string", "minLength": 1 }
  }
}
