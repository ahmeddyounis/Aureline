{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-governance-dashboard.schema.json",
  "title": "Aureline M5 governance / fitness dashboard",
  "description": "The operator / admin / evaluator-facing governance dashboard that turns Aureline's protected fitness functions, nightly governance runs, accepted waivers, service ownership, and decision rights into inspectable product truth, bound to the same gate-bound state grammar the assurance / governance / route-provenance governance matrix and the assurance center froze. Every surface is derived from one input — each fitness function's measured nightly result, evidence freshness, and (when present) an accepted waiver and its expiry standing — so a tile can never read greener than its proof. A fitness tile distinguishes passing, warning, evidence_stale, waived, waiver_expired, and blocked rather than flattening them into one pass / fail colour: stale evidence narrows a tile to evidence_stale; an in-date waiver narrows it to waived; an expired waiver and missing / expired evidence block it. The waiver-expiry queue orders accepted waivers by expiry urgency and discloses each one's expiry, rationale, responsible party, clearing action, and governance ticket. Service-ownership and decision-right cards make ownership and decision authority first-class. Per-profile overviews summarise the board, and the whole packet is stamped with one corpus identity so a pass measured against one corpus / profile is never read as a pass in another context. The exported evaluation packet reuses the exact state and proof vocabulary the tiles show. The packet is metadata-only: it preserves proof lineage as refs and carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "corpus_id",
    "corpus_label",
    "evaluated_at",
    "overviews",
    "fitness_tiles",
    "nightly_rows",
    "waiver_queue",
    "service_cards",
    "decision_right_cards",
    "evaluation_packet",
    "vocabulary",
    "summary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "m5_governance_dashboard" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "corpus_id": { "type": "string", "minLength": 1 },
    "corpus_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "overviews": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/overview" }
    },
    "fitness_tiles": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/fitness_tile" }
    },
    "nightly_rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/nightly_row" }
    },
    "waiver_queue": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver_queue_row" }
    },
    "service_cards": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/service_card" }
    },
    "decision_right_cards": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/decision_card" }
    },
    "evaluation_packet": { "$ref": "#/$defs/evaluation_packet" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "summary": { "$ref": "#/$defs/summary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
