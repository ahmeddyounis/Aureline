{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-assurance-center.schema.json",
  "title": "Aureline M5 assurance center",
  "description": "The user / admin / evaluator-facing assurance center that turns Aureline's regulated, sovereign, air-gapped, telemetry, residency, key-ownership, and local-first continuity claims into inspectable product truth, bound to the same gate-bound claim-state grammar the assurance / governance / route-provenance governance matrix froze. A claim card never asserts a fixed state; it derives its active state from the control-proof rows backing it, taking the worst gate among them, so a card can never read stronger than its proof. When a claim is not fully governed it carries a nearest truthful fallback naming the weaker posture that is still proven; a waived control narrows the claim to exception_pending and is disclosed with its mitigation, expiry, compensating control, responsible party, and clearing action; stale evidence narrows a claim to under_review; missing / expired evidence blocks it to unproven and holds Stable promotion. Per-profile overviews summarise the claim states, evidence freshness, and open exceptions, and report the strongest honored posture, which auto-narrows below the profile the moment a claim it would imply cannot be proven. The packet carries an exported evaluation packet that reuses the exact claim-state and proof vocabulary the cards show. The packet is metadata-only: it preserves proof lineage as refs and carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "overviews",
    "claim_cards",
    "control_proof_rows",
    "exception_waiver_rows",
    "evaluation_packet",
    "vocabulary",
    "summary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "m5_assurance_center" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "overviews": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/overview" }
    },
    "claim_cards": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/claim_card" }
    },
    "control_proof_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/control_proof_row" }
    },
    "exception_waiver_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception_waiver_row" }
    },
    "evaluation_packet": { "$ref": "#/$defs/evaluation_packet" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "summary": { "$ref": "#/$defs/summary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "claim_subject": {
      "type": "string",
      "enum": [
        "local_first_continuity",
        "telemetry_control",
        "key_ownership",
        "data_residency",
        "regulated_operation",
        "air_gap_containment",
        "sovereign_deployment"
      ]
    },
    "control_id": {
      "type": "string",
      "enum": [
        "local_edit_continuity",
        "telemetry_egress_gate",
        "customer_managed_key_custody",
        "local_key_escrow",
        "data_residency_pin",
        "regulated_audit_trail",
        "vendor_path_severed",
        "offline_update_path",
        "sovereign_control_plane"
      ]
    },
    "claim_state": {
      "type": "string",
      "enum": ["proven", "attested", "under_review", "exception_pending", "unproven"]
    },
    "governance_state": {
      "type": "string",
      "enum": ["pass", "monitored", "stale", "waived", "blocked"]
    },
    "deployment_profile": {
      "type": "string",
      "enum": ["managed", "self_hosted", "regulated", "sovereign"]
    },
    "trust_boundary": {
      "type": "string",
      "enum": ["local_first", "control_plane"]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "stale", "expired", "missing"]
    },
    "qualification_class": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "gate": {
      "type": "string",
      "enum": ["governed", "narrowed", "blocked"]
    },
    "consumer_status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "responsible_party": {
      "type": "string",
      "enum": ["customer", "admin", "vendor"]
    },
    "waiver_action": {
      "type": "string",
      "enum": [
        "provide_proof_and_reattest",
        "rotate_key_material",
        "review_and_renew",
        "enable_compensating_control"
      ]
    },
    "evaluation_action": {
      "type": "string",
      "enum": [
        "inspect_claim",
        "download_control_proofs",
        "review_exceptions",
        "export_evaluation_packet"
      ]
    },
    "claim_gap_kind": {
      "type": "string",
      "enum": ["control_narrowed", "control_blocked"]
    },
    "control_proof_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "control_label",
        "backs_claims",
        "proof_state",
        "proof_state_label",
        "evidence_class",
        "evidence_freshness",
        "owner_role",
        "proof_ref",
        "effective_gate",
        "status",
        "signal",
        "detail_message_id"
      ],
      "properties": {
        "control": { "$ref": "#/$defs/control_id" },
        "control_label": { "type": "string", "minLength": 1 },
        "backs_claims": { "type": "array", "items": { "$ref": "#/$defs/claim_subject" } },
        "proof_state": { "$ref": "#/$defs/claim_state" },
        "proof_state_label": { "type": "string", "minLength": 1 },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "evidence_freshness": { "$ref": "#/$defs/freshness_state" },
        "owner_role": { "type": "string", "minLength": 1 },
        "proof_ref": { "type": "string", "minLength": 1 },
        "effective_gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "detail_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "claim_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fallback_posture",
        "fallback_state",
        "still_proven_controls",
        "unmet_controls",
        "message_id"
      ],
      "properties": {
        "fallback_posture": { "$ref": "#/$defs/deployment_profile" },
        "fallback_state": { "$ref": "#/$defs/claim_state" },
        "still_proven_controls": { "type": "array", "items": { "$ref": "#/$defs/control_id" } },
        "unmet_controls": { "type": "array", "items": { "$ref": "#/$defs/control_id" } },
        "message_id": { "type": "string", "minLength": 1 }
      }
    },
    "claim_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "control", "gap_kind", "cause_message_id"],
      "properties": {
        "claim": { "$ref": "#/$defs/claim_subject" },
        "control": { "$ref": "#/$defs/control_id" },
        "gap_kind": { "$ref": "#/$defs/claim_gap_kind" },
        "cause_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "claim_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "subject_label",
        "claimed_posture",
        "required_controls",
        "active_state",
        "active_state_label",
        "active_gate",
        "effective_qualification",
        "evidence_refs",
        "evidence_classes",
        "trust_boundaries",
        "owner_role",
        "fallback",
        "status",
        "signal",
        "gaps",
        "state_message_id"
      ],
      "properties": {
        "subject": { "$ref": "#/$defs/claim_subject" },
        "subject_label": { "type": "string", "minLength": 1 },
        "claimed_posture": { "$ref": "#/$defs/deployment_profile" },
        "required_controls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/control_id" }
        },
        "active_state": { "$ref": "#/$defs/claim_state" },
        "active_state_label": { "type": "string", "minLength": 1 },
        "active_gate": { "$ref": "#/$defs/gate" },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_classes": { "type": "array", "items": { "$ref": "#/$defs/evidence_class" } },
        "trust_boundaries": { "type": "array", "items": { "$ref": "#/$defs/trust_boundary" } },
        "owner_role": { "type": "string", "minLength": 1 },
        "fallback": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/claim_fallback" }]
        },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/claim_gap" } },
        "state_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "exception_waiver_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "control_label",
        "governance_state",
        "affected_claims",
        "mitigation",
        "expiry",
        "compensating_control",
        "responsible_party",
        "action",
        "status",
        "signal",
        "detail_message_id"
      ],
      "properties": {
        "control": { "$ref": "#/$defs/control_id" },
        "control_label": { "type": "string", "minLength": 1 },
        "governance_state": { "$ref": "#/$defs/governance_state" },
        "affected_claims": { "type": "array", "items": { "$ref": "#/$defs/claim_subject" } },
        "mitigation": { "type": "string", "minLength": 1 },
        "expiry": { "type": "string", "minLength": 1 },
        "compensating_control": { "$ref": "#/$defs/control_id" },
        "responsible_party": { "$ref": "#/$defs/responsible_party" },
        "action": { "$ref": "#/$defs/waiver_action" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "detail_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "claim_state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proven", "attested", "under_review", "exception_pending", "unproven"],
      "properties": {
        "proven": { "type": "integer", "minimum": 0 },
        "attested": { "type": "integer", "minimum": 0 },
        "under_review": { "type": "integer", "minimum": 0 },
        "exception_pending": { "type": "integer", "minimum": 0 },
        "unproven": { "type": "integer", "minimum": 0 }
      }
    },
    "freshness_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "stale", "expired", "missing"],
      "properties": {
        "current": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "expired": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "applicable_claims",
        "claim_state_counts",
        "evidence_freshness_counts",
        "known_exception_count",
        "effective_posture",
        "gate_decision",
        "effective_qualification",
        "status",
        "signal",
        "evaluation_actions",
        "summary_message_id"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/deployment_profile" },
        "applicable_claims": { "type": "array", "items": { "$ref": "#/$defs/claim_subject" } },
        "claim_state_counts": { "$ref": "#/$defs/claim_state_counts" },
        "evidence_freshness_counts": { "$ref": "#/$defs/freshness_counts" },
        "known_exception_count": { "type": "integer", "minimum": 0 },
        "effective_posture": { "$ref": "#/$defs/deployment_profile" },
        "gate_decision": { "$ref": "#/$defs/gate" },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "evaluation_actions": { "type": "array", "items": { "$ref": "#/$defs/evaluation_action" } },
        "summary_message_id": { "type": "string", "minLength": 1 }
      }
    },
    "evaluation_claim_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "claimed_posture",
        "active_state",
        "effective_qualification",
        "owner_role",
        "evidence_refs",
        "fallback_posture",
        "fallback_state"
      ],
      "properties": {
        "subject": { "$ref": "#/$defs/claim_subject" },
        "claimed_posture": { "$ref": "#/$defs/deployment_profile" },
        "active_state": { "$ref": "#/$defs/claim_state" },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "owner_role": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fallback_posture": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/deployment_profile" }]
        },
        "fallback_state": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/claim_state" }]
        }
      }
    },
    "evaluation_control_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "proof_state",
        "evidence_class",
        "evidence_freshness",
        "proof_ref",
        "owner_role"
      ],
      "properties": {
        "control": { "$ref": "#/$defs/control_id" },
        "proof_state": { "$ref": "#/$defs/claim_state" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "evidence_freshness": { "$ref": "#/$defs/freshness_state" },
        "proof_ref": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 }
      }
    },
    "evaluation_exception_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "governance_state",
        "expiry",
        "compensating_control",
        "responsible_party",
        "affected_claims"
      ],
      "properties": {
        "control": { "$ref": "#/$defs/control_id" },
        "governance_state": { "$ref": "#/$defs/governance_state" },
        "expiry": { "type": "string", "minLength": 1 },
        "compensating_control": { "$ref": "#/$defs/control_id" },
        "responsible_party": { "$ref": "#/$defs/responsible_party" },
        "affected_claims": { "type": "array", "items": { "$ref": "#/$defs/claim_subject" } }
      }
    },
    "evaluation_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "generated_from",
        "evaluated_at",
        "claims",
        "controls",
        "exceptions",
        "vocabulary",
        "redaction_class_token"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "m5_assurance_evaluation_packet" },
        "schema_version": { "type": "integer", "const": 1 },
        "packet_id": { "type": "string", "minLength": 1 },
        "generated_from": { "type": "string", "minLength": 1 },
        "evaluated_at": { "type": "string", "minLength": 1 },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/evaluation_claim_entry" } },
        "controls": { "type": "array", "items": { "$ref": "#/$defs/evaluation_control_entry" } },
        "exceptions": { "type": "array", "items": { "$ref": "#/$defs/evaluation_exception_entry" } },
        "vocabulary": { "$ref": "#/$defs/vocabulary" },
        "redaction_class_token": { "type": "string", "minLength": 1 }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_subjects",
        "claim_states",
        "controls",
        "governance_states",
        "deployment_profiles",
        "trust_boundaries",
        "evidence_classes",
        "freshness_states",
        "qualification_classes",
        "gate_decisions",
        "responsible_parties",
        "waiver_actions",
        "evaluation_actions"
      ],
      "properties": {
        "claim_subjects": { "type": "array", "items": { "type": "string" } },
        "claim_states": { "type": "array", "items": { "type": "string" } },
        "controls": { "type": "array", "items": { "type": "string" } },
        "governance_states": { "type": "array", "items": { "type": "string" } },
        "deployment_profiles": { "type": "array", "items": { "type": "string" } },
        "trust_boundaries": { "type": "array", "items": { "type": "string" } },
        "evidence_classes": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "qualification_classes": { "type": "array", "items": { "type": "string" } },
        "gate_decisions": { "type": "array", "items": { "type": "string" } },
        "responsible_parties": { "type": "array", "items": { "type": "string" } },
        "waiver_actions": { "type": "array", "items": { "type": "string" } },
        "evaluation_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_claims",
        "proven_claims",
        "attested_claims",
        "narrowed_claims",
        "blocked_claims",
        "total_controls",
        "governed_controls",
        "narrowed_controls",
        "blocked_controls",
        "total_exceptions",
        "total_profiles",
        "honored_profiles",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_claims": { "type": "integer", "minimum": 0 },
        "proven_claims": { "type": "integer", "minimum": 0 },
        "attested_claims": { "type": "integer", "minimum": 0 },
        "narrowed_claims": { "type": "integer", "minimum": 0 },
        "blocked_claims": { "type": "integer", "minimum": 0 },
        "total_controls": { "type": "integer", "minimum": 0 },
        "governed_controls": { "type": "integer", "minimum": 0 },
        "narrowed_controls": { "type": "integer", "minimum": 0 },
        "blocked_controls": { "type": "integer", "minimum": 0 },
        "total_exceptions": { "type": "integer", "minimum": 0 },
        "total_profiles": { "type": "integer", "minimum": 0 },
        "honored_profiles": { "type": "integer", "minimum": 0 },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_state_derived_from_controls",
        "no_claim_overstates_controls",
        "every_control_bound_to_evidence_and_owner",
        "stale_evidence_narrows_deterministically",
        "missing_evidence_blocks_stable_promotion",
        "exceptions_disclose_mitigation_expiry_and_action",
        "fallback_present_when_not_governed",
        "overview_effective_posture_never_overstated",
        "evaluation_packet_reuses_ui_vocabulary",
        "controlled_enums_frozen",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "claim_state_derived_from_controls": { "type": "boolean" },
        "no_claim_overstates_controls": { "type": "boolean" },
        "every_control_bound_to_evidence_and_owner": { "type": "boolean" },
        "stale_evidence_narrows_deterministically": { "type": "boolean" },
        "missing_evidence_blocks_stable_promotion": { "type": "boolean" },
        "exceptions_disclose_mitigation_expiry_and_action": { "type": "boolean" },
        "fallback_present_when_not_governed": { "type": "boolean" },
        "overview_effective_posture_never_overstated": { "type": "boolean" },
        "evaluation_packet_reuses_ui_vocabulary": { "type": "boolean" },
        "controlled_enums_frozen": { "type": "boolean" },
        "export_carries_no_raw_material": { "type": "boolean" }
      }
    }
  }
}
