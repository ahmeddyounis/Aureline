{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-approval-ticket-inspector.schema.json",
  "title": "Aureline M5 approval-ticket inspector",
  "description": "One approval-ticket inspector from the M5 boundary inspector, validatable on its own so desktop, support export, and evaluation / procurement packets can carry a single inspector-backed approval ticket without the whole packet. The ticket explains who granted what and for how long for a consequential M5 action: the capability class it grants, the approving authority, the scope, the runtime approval state (drawn from the assurance / route governance matrix approval vocabulary), the expiry and its standing, and the revoke / renew actions an operator can take. The effective gate folds the approval state and the expiry standing, so an expiring ticket narrows and an expired one blocks. The ticket carries no credential bodies or raw provider payloads; the ticket and proof refs are repo-relative references only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "action_label",
    "capability_class",
    "capability_class_label",
    "approving_authority",
    "approving_authority_label",
    "scope_summary",
    "approval_state",
    "approval_state_label",
    "expiry",
    "expiry_standing",
    "effective_gate",
    "effective_qualification",
    "revoke_renew_actions",
    "ticket_ref",
    "evidence_class",
    "owner_role",
    "proof_ref",
    "status",
    "signal",
    "detail_message_id"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "local_model_execution",
        "remote_model_inference",
        "provider_credential_rotation",
        "workspace_data_export",
        "control_plane_sync",
        "offline_model_acquisition",
        "admin_policy_push",
        "support_bundle_handoff"
      ]
    },
    "action_label": { "type": "string", "minLength": 1 },
    "capability_class": {
      "type": "string",
      "enum": [
        "local_inference",
        "remote_inference",
        "credential_management",
        "data_egress",
        "policy_administration",
        "model_acquisition",
        "support_disclosure"
      ]
    },
    "capability_class_label": { "type": "string", "minLength": 1 },
    "approving_authority": {
      "type": "string",
      "enum": [
        "standing_policy",
        "user_consent",
        "workspace_admin",
        "security_officer",
        "runtime_broker"
      ]
    },
    "approving_authority_label": { "type": "string", "minLength": 1 },
    "scope_summary": { "type": "string", "minLength": 1 },
    "approval_state": {
      "type": "string",
      "enum": [
        "pre_authorized",
        "approved",
        "approval_pending",
        "approval_required",
        "approval_denied"
      ]
    },
    "approval_state_label": { "type": "string", "minLength": 1 },
    "expiry": { "type": "string", "minLength": 1 },
    "expiry_standing": {
      "type": "string",
      "enum": ["active", "expiring_soon", "expired"]
    },
    "effective_gate": {
      "type": "string",
      "enum": ["governed", "narrowed", "blocked"]
    },
    "effective_qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "revoke_renew_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["revoke_approval", "renew_approval", "require_reapproval", "tighten_scope"]
      }
    },
    "ticket_ref": { "type": "string", "minLength": 1 },
    "evidence_class": {
      "type": "string",
      "enum": [
        "control_attestation",
        "policy_bundle",
        "runtime_approval_record",
        "route_timeline",
        "provenance_ledger",
        "ownership_register",
        "waiver_record",
        "boundary_manifest"
      ]
    },
    "owner_role": { "type": "string", "minLength": 1 },
    "proof_ref": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "signal": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "detail_message_id": { "type": "string", "minLength": 1 }
  }
}
