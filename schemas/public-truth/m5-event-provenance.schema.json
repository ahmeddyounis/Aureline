{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/public-truth/m5-event-provenance.schema.json",
  "title": "Aureline M5 event-provenance inspector",
  "description": "The user / admin / evaluator-facing event-provenance inspector that explains, for each queued or replayable M5 action across the AI, provider, remote, and support flows, where the event came from, what changed since it was planned, and whether replaying it is still safe — bound to the same gate-bound state grammar the assurance / route / event-provenance governance matrix froze. Each deferred action carries three reusable facets: an event-provenance row (the stable lineage attached to a log / diagnostic / artifact / audit surface, naming the event id, the mutation / run / session it links to, the host lane, the retrieval epoch, and the redaction posture, with a provenance state read from the matrix vocabulary); a route-drift banner (the baseline it compares against — plan or last success — and every route fact that drifted: endpoint, tenant, region, proxy, certificate, mirror, or policy, with a route state that auto-narrows on a drift and blocks on a tenant change); and a replay / reapproval gate (the deferred kind — replay, publish-later, or approve-again — the current capability-boundary and approval state, and the decision those facts imply). Each event's verdict takes the worst gate of its three facets, so it never reads safer than its least-attested facet; a drift or a narrowed boundary narrows it, and a tenant drift or a denied approval blocks Stable promotion. The exported redaction-safe preview reuses the exact provenance / route / approval vocabulary the facets show. The preview is metadata-only: it preserves event / route / proof lineage as refs and carries no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "deferred_events",
    "export_preview",
    "vocabulary",
    "summary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "m5_event_provenance" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "report_label": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "deferred_events": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/deferred_event" }
    },
    "export_preview": { "$ref": "#/$defs/export_preview" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "summary": { "$ref": "#/$defs/summary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
