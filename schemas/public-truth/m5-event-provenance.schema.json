      "enum": ["ai", "provider", "remote", "support"]
    },
    "surface": {
      "type": "string",
      "enum": ["log", "diagnostic", "artifact", "audit"]
    },
    "host_lane": {
      "type": "string",
      "enum": ["local_machine", "remote_region", "control_plane", "mirror_edge", "vendor_edge"]
    },
    "redaction_posture": {
      "type": "string",
      "enum": ["metadata_only", "reference_only", "redacted_body", "sealed_local"]
    },
    "provenance_state": {
      "type": "string",
