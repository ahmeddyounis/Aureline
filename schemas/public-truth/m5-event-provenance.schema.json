        "attributed_remote",
        "mirrored_route",
        "route_degraded",
        "unattributed_route"
      ]
    },
    "deferred_kind": {
      "type": "string",
      "enum": ["replay", "publish_later", "approve_again"]
    },
    "boundary_state": {
      "type": "string",
      "enum": [
