{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/support/m5-support-center-layout.schema.json",
  "title": "Aureline Support Center layout",
  "description": "Schema for the m5_support_center_ui packet: the Support Center information architecture that makes supportability a coherent product home. It declares a three-region layout (left-nav module rail, center diagnosis/recovery/inspector/intake-export cards, and one shared right-side build/policy/residency/export inspector that stays visible across modules), reusing the one Support Center module registry (doctor, safe-mode, bisect, performance, language, index, ai-usage, crash, network, artifacts, issue-report/crash-intake, support-bundle export preview). Each nav entry defers per-module readiness to its matrix row and depends on a subset of the shared inspector facets (build, policy, residency, export). A fail-closed presentation gate derives each entry's published presentation (presented, narrowed, withheld) as the weaker of its accessibility ceiling and its required-facet ceiling: an entry that does not satisfy every accessibility invariant (keyboard-complete, high-contrast parity, reduced-motion-safe) is withheld, a required facet that is degraded narrows the entry, and a required facet that is unwired withholds it. The recorded presentation, downgrade reasons (accessibility-unmet, inspector-facet-degraded, inspector-facet-unwired), and recovery path (restore-accessibility, restore-inspector-facet, none) must equal the recomputed gate. Every required consumer surface (desktop-shell, cli-headless, docs-help, support-export) binds to this one registry and must ingest it, preserve its nav labels and shared inspector, and narrow with it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "modules",
    "layout_regions",
    "nav_sections",
    "center_surface_kinds",
    "integration_sources",
    "inspector_facets",
    "facet_availabilities",
    "accessibility_guarantees",
    "presentations",
    "downgrade_reasons",
    "recovery_paths",
    "consumer_surfaces",
    "regions",
    "shared_inspector",
    "nav_entries",
    "consumer_bindings",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_support_center_ui" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "layout_regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/layout_region" }
    },
    "nav_sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/nav_section" }
    },
    "center_surface_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/center_surface_kind" }
    },
    "integration_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/integration_source" }
    },
    "inspector_facets": {
      "type": "array",
      "items": { "$ref": "#/$defs/inspector_facet" }
    },
    "facet_availabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/facet_availability" }
    },
    "accessibility_guarantees": {
      "type": "array",
      "items": { "$ref": "#/$defs/accessibility_guarantee" }
    },
    "presentations": {
      "type": "array",
      "items": { "$ref": "#/$defs/presentation" }
    },
    "downgrade_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_reason" }
    },
    "recovery_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/recovery_path" }
    },
    "consumer_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "shared_inspector": { "$ref": "#/$defs/shared_inspector" },
    "nav_entries": { "type": "array", "items": { "$ref": "#/$defs/nav_entry" } },
    "consumer_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "module": {
      "enum": [
        "doctor",
        "safe_mode",
        "bisect",
        "performance",
        "language",
        "index",
        "ai_usage",
        "crash",
        "network",
        "artifacts",
        "issue_report_crash_intake",
        "support_bundle_export_preview"
      ]
    },
    "layout_region": {
      "enum": ["left_nav", "center", "right_inspector"]
    },
    "nav_section": {
      "enum": ["diagnose", "recover", "inspect", "intake_export"]
    },
    "center_surface_kind": {
      "enum": [
        "diagnosis_cards",
        "recovery_actions",
        "inspector_readout",
        "intake_and_export"
      ]
    },
    "integration_source": {
      "enum": [
        "finding_codes",
        "crash_ids",
        "install_advisory_rows",
        "schema_registry_state"
      ]
    },
    "inspector_facet": {
      "enum": ["build", "policy", "residency", "export"]
    },
    "facet_availability": {
      "enum": ["wired", "degraded", "unwired"]
    },
    "accessibility_guarantee": {
      "enum": ["keyboard_complete", "high_contrast_parity", "reduced_motion_safe"]
    },
    "presentation": {
      "enum": ["presented", "narrowed", "withheld"]
    },
    "downgrade_reason": {
      "enum": [
        "accessibility_unmet",
        "inspector_facet_degraded",
        "inspector_facet_unwired"
      ]
    },
    "recovery_path": {
      "enum": ["restore_accessibility", "restore_inspector_facet", "none"]
    },
    "consumer_surface": {
      "enum": ["desktop_shell", "cli_headless", "docs_help", "support_export"]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "role", "keyboard_order", "accessibility"],
      "properties": {
        "region": { "$ref": "#/$defs/layout_region" },
        "role": { "$ref": "#/$defs/non_empty_string" },
        "keyboard_order": { "type": "integer", "minimum": 0 },
        "accessibility": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_guarantee" }
        }
      }
    },
    "inspector_facet_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facet", "availability", "descriptor_ref", "checked_at"],
      "properties": {
        "facet": { "$ref": "#/$defs/inspector_facet" },
        "availability": { "$ref": "#/$defs/facet_availability" },
        "descriptor_ref": { "$ref": "#/$defs/non_empty_string" },
        "checked_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "shared_inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "persists_across_modules", "facets"],
      "properties": {
        "role": { "$ref": "#/$defs/non_empty_string" },
        "persists_across_modules": { "type": "boolean" },
        "facets": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/inspector_facet_binding" }
        }
      }
    },
    "nav_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "module",
        "nav_label",
        "nav_order",
        "section",
        "center_surface_kind",
        "center_surface_ref",
        "required_facets",
        "integration_sources",
        "accessibility",
        "matrix_row_ref",
        "presentation",
        "recovery_path",
        "conformance_ref",
        "evidence_ref",
        "scope_snapshot_ref",
        "layout_receipt_ref",
        "note"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "module": { "$ref": "#/$defs/module" },
        "nav_label": { "$ref": "#/$defs/non_empty_string" },
        "nav_order": { "type": "integer", "minimum": 0 },
        "section": { "$ref": "#/$defs/nav_section" },
        "center_surface_kind": { "$ref": "#/$defs/center_surface_kind" },
        "center_surface_ref": { "$ref": "#/$defs/non_empty_string" },
        "required_facets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inspector_facet" }
        },
        "integration_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/integration_source" }
        },
        "accessibility": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_guarantee" }
        },
        "matrix_row_ref": { "$ref": "#/$defs/non_empty_string" },
        "presentation": { "$ref": "#/$defs/presentation" },
        "downgrade_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_reason" }
        },
        "recovery_path": { "$ref": "#/$defs/recovery_path" },
        "offered_actions": { "$ref": "#/$defs/string_array" },
        "caveats": { "$ref": "#/$defs/string_array" },
        "unmet_or_unwired_fields": { "$ref": "#/$defs/string_array" },
        "conformance_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "layout_receipt_ref": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "binding_ref",
        "layout_packet_id_ref",
        "scope_snapshot_ref",
        "ingests_registry",
        "preserves_nav_labels",
        "preserves_shared_inspector",
        "narrows_on_downgrade",
        "raw_private_material_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "binding_ref": { "$ref": "#/$defs/non_empty_string" },
        "layout_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingests_registry": { "type": "boolean" },
        "preserves_nav_labels": { "type": "boolean" },
        "preserves_shared_inspector": { "type": "boolean" },
        "narrows_on_downgrade": { "type": "boolean" },
        "raw_private_material_excluded": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_modules",
        "presented_modules",
        "narrowed_modules",
        "withheld_modules",
        "modules_with_downgrade_reasons",
        "accessibility_gap_modules",
        "modules_with_imperfect_facets",
        "nav_sections_used",
        "integration_sources_used"
      ],
      "properties": {
        "total_modules": { "type": "integer", "minimum": 0 },
        "presented_modules": { "type": "integer", "minimum": 0 },
        "narrowed_modules": { "type": "integer", "minimum": 0 },
        "withheld_modules": { "type": "integer", "minimum": 0 },
        "modules_with_downgrade_reasons": { "type": "integer", "minimum": 0 },
        "accessibility_gap_modules": { "type": "integer", "minimum": 0 },
        "modules_with_imperfect_facets": { "type": "integer", "minimum": 0 },
        "nav_sections_used": { "type": "integer", "minimum": 0 },
        "integration_sources_used": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
