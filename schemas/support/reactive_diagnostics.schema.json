{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/support/reactive_diagnostics.schema.json",
  "title": "Aureline reactive-state Project Doctor and support diagnostics packet",
  "description": "Boundary schema for the checked-in reactive-diagnostics packet and its troubleshooting fixtures. The packet folds the canonical reactive-state objects (active subscriptions and epoch, invalidation history, stale materialization classes, slow-consumer/backpressure state) into Project Doctor probes with stable finding codes, reason codes, and safe next steps, plus a metadata-first support-export view. Raw state payloads, credentials, raw provider responses, raw paths, raw commands, and raw traces never cross this boundary.",
  "oneOf": [
    { "$ref": "#/$defs/packet" },
    { "$ref": "#/$defs/fixture" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "consumer_stale",
        "consumer_coalescing",
        "resubscribe_required",
        "provider_overlay_unavailable",
        "epoch_drift",
        "invalidation_storm",
        "backpressure_overflow",
        "partial_scope_stale"
      ]
    },
    "safe_next_step": {
      "type": "string",
      "enum": [
        "wait_for_coalesced_catch_up",
        "request_fresh_snapshot",
        "resubscribe",
        "reconnect_provider",
        "hold_last_known_read_only",
        "open_subscription_inspector",
        "export_reactive_diagnostics"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "degraded", "blocking", "unsupported"]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "observed_authoritative",
        "observed_with_gap",
        "inferred_from_evidence",
        "unknown_requires_probe"
      ]
    },
    "repair_availability": {
      "type": "string",
      "enum": [
        "reviewed_repair_available",
        "preview_only",
        "handoff_only",
        "unsupported"
      ]
    },
    "scope_class": {
      "type": "string",
      "enum": [
        "workspace",
        "window",
        "review_workspace",
        "remote_session",
        "tenant",
        "companion_surface"
      ]
    },
    "view_class": {
      "type": "string",
      "enum": [
        "ephemeral_projection",
        "durable_local_materialization",
        "exportable_snapshot",
        "managed_replicated_view"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["authoritative", "warming", "cached", "stale", "replayed", "imported"]
    },
    "completeness": {
      "type": "string",
      "enum": ["full", "partial", "unloaded", "unavailable"]
    },
    "backpressure_mode": {
      "type": "string",
      "enum": ["realtime", "coalesced", "snapshot_required"]
    },
    "truth_claim": {
      "type": "string",
      "enum": [
        "exact_current_truth",
        "consistent_snapshot",
        "coalesced_stream",
        "partial_projection",
        "warming_no_truth_yet",
        "cached_projection",
        "stale_snapshot",
        "replayed_snapshot",
        "imported_snapshot",
        "policy_limited_projection",
        "provider_unavailable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "desktop_shell",
        "cli_headless",
        "ai_inspector",
        "review_workspace",
        "companion_snapshot"
      ]
    },
    "invalidation_reason": {
      "type": "string",
      "enum": [
        "producer_restart",
        "authority_epoch_rolled",
        "policy_epoch_changed",
        "watcher_dropped",
        "queue_saturation",
        "upstream_input_stale",
        "explicit_refresh_requested",
        "cache_served",
        "replayed_from_bundle",
        "imported_from_external",
        "scope_removed",
        "causality_lost"
      ]
    },
    "persistence_class": {
      "type": "string",
      "enum": [
        "memory_only",
        "local_cache_or_db",
        "saved_artifact",
        "service_or_local_mirror"
      ]
    },
    "lag_condition": {
      "type": "string",
      "enum": [
        "rapid_invalidation_burst",
        "consumer_lag",
        "backpressure_overflow",
        "invalidation_gap",
        "reconnect_after_drop",
        "provider_overlay_disappeared"
      ]
    },
    "epoch_posture": {
      "type": "string",
      "enum": [
        "current",
        "coalescing",
        "stale_epoch",
        "resubscribe_pending",
        "snapshot_recovering"
      ]
    },
    "action_posture": {
      "type": "string",
      "enum": [
        "exact_truth_allowed",
        "revalidate_before_act",
        "narrowed_to_last_known",
        "resubscribe_required",
        "blocked"
      ]
    },
    "recovery_strategy": {
      "type": "string",
      "enum": [
        "coalesce_deltas",
        "request_fresh_snapshot",
        "resubscribe",
        "mark_stale_epoch"
      ]
    },
    "scenario": {
      "type": "string",
      "enum": [
        "epoch_drift",
        "invalidation_storm",
        "lagging_consumer",
        "partial_scope_stale",
        "provider_overlay_unavailable",
        "resubscribe_required",
        "consumer_stale",
        "backpressure_overflow"
      ]
    },
    "active_subscription_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscription_id",
        "binding_id",
        "query_family",
        "scope_class",
        "scope_id",
        "view_class",
        "authority_epoch",
        "snapshot_epoch",
        "delta_seq",
        "freshness",
        "completeness",
        "backpressure_mode",
        "truth_claim",
        "consumer_surfaces",
        "epoch_drift"
      ],
      "properties": {
        "subscription_id": { "type": "integer", "minimum": 0 },
        "binding_id": { "$ref": "#/$defs/non_empty_string" },
        "query_family": { "$ref": "#/$defs/non_empty_string" },
        "scope_class": { "$ref": "#/$defs/scope_class" },
        "scope_id": { "$ref": "#/$defs/non_empty_string" },
        "view_class": { "$ref": "#/$defs/view_class" },
        "authority_epoch": { "$ref": "#/$defs/epoch" },
        "snapshot_epoch": { "$ref": "#/$defs/epoch" },
        "delta_seq": { "$ref": "#/$defs/epoch" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "completeness": { "$ref": "#/$defs/completeness" },
        "backpressure_mode": { "$ref": "#/$defs/backpressure_mode" },
        "truth_claim": { "$ref": "#/$defs/truth_claim" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "epoch_drift": { "type": "boolean" }
      }
    },
    "invalidation_history_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "scope_id",
        "invalidation_reason",
        "from_epoch",
        "to_epoch",
        "observed_at",
        "narration"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "scope_id": { "$ref": "#/$defs/non_empty_string" },
        "invalidation_reason": { "$ref": "#/$defs/invalidation_reason" },
        "from_epoch": { "$ref": "#/$defs/epoch" },
        "to_epoch": { "$ref": "#/$defs/epoch" },
        "observed_at": { "$ref": "#/$defs/non_empty_string" },
        "narration": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "stale_materialization_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "view_class",
        "persistence_class",
        "scope_id",
        "freshness",
        "invalidation_reason",
        "rebuild_next_step",
        "narration"
      ],
      "properties": {
        "binding_id": { "$ref": "#/$defs/non_empty_string" },
        "view_class": { "$ref": "#/$defs/view_class" },
        "persistence_class": { "$ref": "#/$defs/persistence_class" },
        "scope_id": { "$ref": "#/$defs/non_empty_string" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "invalidation_reason": { "$ref": "#/$defs/invalidation_reason" },
        "rebuild_next_step": { "$ref": "#/$defs/safe_next_step" },
        "narration": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "slow_consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "lag_condition",
        "epoch_posture",
        "action_posture",
        "backpressure_mode",
        "reason_code",
        "recommended_strategy",
        "safe_next_step",
        "offers_exact_truth_action",
        "silent_retry_allowed",
        "narration"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "lag_condition": { "$ref": "#/$defs/lag_condition" },
        "epoch_posture": { "$ref": "#/$defs/epoch_posture" },
        "action_posture": { "$ref": "#/$defs/action_posture" },
        "backpressure_mode": { "$ref": "#/$defs/backpressure_mode" },
        "reason_code": { "$ref": "#/$defs/reason_code" },
        "recommended_strategy": { "$ref": "#/$defs/recovery_strategy" },
        "safe_next_step": { "$ref": "#/$defs/safe_next_step" },
        "offers_exact_truth_action": { "type": "boolean" },
        "silent_retry_allowed": { "type": "boolean" },
        "narration": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "doctor_probe_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "finding_code",
        "reason_code",
        "severity",
        "confidence",
        "repair_availability",
        "safe_next_step",
        "condition_summary",
        "recovery_recommendation",
        "evidence_refs"
      ],
      "properties": {
        "probe_id": { "$ref": "#/$defs/non_empty_string" },
        "finding_code": { "$ref": "#/$defs/non_empty_string" },
        "reason_code": { "$ref": "#/$defs/reason_code" },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "repair_availability": { "$ref": "#/$defs/repair_availability" },
        "safe_next_step": { "$ref": "#/$defs/safe_next_step" },
        "condition_summary": { "$ref": "#/$defs/non_empty_string" },
        "recovery_recommendation": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_ref",
        "schema_ref",
        "packet_ref",
        "report_ref",
        "runbook_ref",
        "fixture_manifest_ref"
      ],
      "properties": {
        "doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "report_ref": { "$ref": "#/$defs/non_empty_string" },
        "runbook_ref": { "$ref": "#/$defs/non_empty_string" },
        "fixture_manifest_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "title",
        "source_contract_refs",
        "active_subscriptions",
        "invalidation_history",
        "stale_materializations",
        "slow_consumers",
        "doctor_probes",
        "invariants"
      ],
      "properties": {
        "record_kind": { "const": "reactive_diagnostics_packet_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_contract_refs": { "$ref": "#/$defs/source_contract_refs" },
        "active_subscriptions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/active_subscription_row" }
        },
        "invalidation_history": {
          "type": "array",
          "items": { "$ref": "#/$defs/invalidation_history_row" }
        },
        "stale_materializations": {
          "type": "array",
          "items": { "$ref": "#/$defs/stale_materialization_row" }
        },
        "slow_consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/slow_consumer_row" }
        },
        "doctor_probes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/doctor_probe_row" }
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "fixture_id",
        "scenario",
        "expected_reason_code",
        "expected_finding_code",
        "expected_severity",
        "expected_safe_next_step",
        "notes"
      ],
      "properties": {
        "record_kind": { "const": "reactive_diagnostics_fixture_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "fixture_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/scenario" },
        "expected_reason_code": { "$ref": "#/$defs/reason_code" },
        "expected_finding_code": { "$ref": "#/$defs/non_empty_string" },
        "expected_severity": { "$ref": "#/$defs/severity" },
        "expected_safe_next_step": { "$ref": "#/$defs/safe_next_step" },
        "notes": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
