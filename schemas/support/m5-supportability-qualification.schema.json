{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/support/m5-supportability-qualification.schema.json",
  "title": "Aureline M5 supportability qualification packet",
  "description": "Boundary schema for the m5_supportability_qualification_packet emitted by aureline-support. The packet certifies each claimed M5 supportability surface (Support Center, environment explainability, precedence inspection, support-bundle consent, crash-intake/recovery, supportability handoff) on each claimed M5 profile across the desktop and CLI/headless deployment modes. Every surface/profile row binds its own lane schema, artifact, fixture corpus, and record kind plus the supportability drills that back it, then exposes the same qualification index to Help/About, the desktop Support Center, CLI/headless, support-export, shiproom, and release-manifest consumers. The packet is metadata-safe and never embeds raw artifact payloads, raw logs, raw transcripts, or live credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "doc_ref",
    "schema_ref",
    "artifact_ref",
    "source_spec_refs",
    "supporting_contract_refs",
    "claimed_profiles",
    "deployment_modes",
    "qualification_rows",
    "drill_catalog",
    "downgrade_rules",
    "consumer_bindings",
    "export_safe_summary"
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "claimed_profile": {
      "type": "string",
      "enum": [
        "desktop_local_first",
        "hybrid_remote_attach",
        "managed_cloud",
        "self_hosted_sovereign",
        "air_gapped_mirror_only"
      ]
    },
    "deployment_mode": {
      "type": "string",
      "enum": [
        "desktop",
        "cli_headless"
      ]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "support_center",
        "environment_explainability",
        "precedence_inspection",
        "support_bundle_consent",
        "crash_intake_recovery",
        "supportability_handoff"
      ]
    },
    "drill_class": {
      "type": "string",
      "enum": [
        "diagnosis_latency",
        "consent_sheet_accuracy",
        "export_mode_parity",
        "crash_loop_recovery",
        "exact_build_intake"
      ]
    },
    "qualification_state": {
      "type": "string",
      "enum": [
        "qualified",
        "limited_profile_scoped",
        "local_self_diagnosis_only",
        "blocked_unverified"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "surface_evidence_stale",
        "supportability_drill_stale",
        "deployment_mode_parity_lost",
        "policy_blocked_send",
        "consumer_binding_missing"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "help_about",
        "support_center_desktop",
        "cli_headless",
        "support_export",
        "shiproom",
        "release_manifest"
      ]
    },
    "qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_row_id",
        "surface",
        "surface_label",
        "profile",
        "published_state",
        "deployment_mode_coverage",
        "share_capable",
        "local_save_first",
        "backing_schema_ref",
        "backing_artifact_ref",
        "backing_fixture_ref",
        "backing_record_kind",
        "drill_ids",
        "stale_proof_tokens",
        "downgrade_rule_ids",
        "summary"
      ],
      "properties": {
        "qualification_row_id": { "$ref": "#/$defs/non_empty_string" },
        "surface": { "$ref": "#/$defs/surface_class" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/claimed_profile" },
        "published_state": { "$ref": "#/$defs/qualification_state" },
        "deployment_mode_coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/deployment_mode" },
          "minItems": 1
        },
        "share_capable": { "type": "boolean" },
        "local_save_first": { "type": "boolean" },
        "backing_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "backing_artifact_ref": { "$ref": "#/$defs/non_empty_string" },
        "backing_fixture_ref": { "$ref": "#/$defs/non_empty_string" },
        "backing_record_kind": { "$ref": "#/$defs/non_empty_string" },
        "drill_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "stale_proof_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "downgrade_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "drill_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_id",
        "drill_class",
        "label",
        "covered_surfaces",
        "evidence_refs",
        "is_fresh",
        "summary"
      ],
      "properties": {
        "drill_id": { "$ref": "#/$defs/non_empty_string" },
        "drill_class": { "$ref": "#/$defs/drill_class" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "covered_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_class" },
          "minItems": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "is_fresh": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_class",
        "source_state",
        "downgraded_state",
        "required_effect",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_class": { "$ref": "#/$defs/downgrade_trigger" },
        "source_state": { "$ref": "#/$defs/qualification_state" },
        "downgraded_state": { "$ref": "#/$defs/qualification_state" },
        "required_effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_ref",
        "ingested_packet_id",
        "qualification_row_count",
        "required_verbatim_fields",
        "narrow_on_stale_proof",
        "explicit_limited_state_labels_required",
        "summary"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "qualification_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_verbatim_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrow_on_stale_proof": { "type": "boolean" },
        "explicit_limited_state_labels_required": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  },
  "properties": {
    "record_kind": {
      "const": "m5_supportability_qualification_packet"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "const": "support.m5.supportability_qualification.v1"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "doc_ref": {
      "const": "docs/help/support/m5-supportability-qualification.md"
    },
    "schema_ref": {
      "const": "schemas/support/m5-supportability-qualification.schema.json"
    },
    "artifact_ref": {
      "const": "artifacts/support/m5/m5-supportability-qualification.md"
    },
    "source_spec_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 1
    },
    "supporting_contract_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 1
    },
    "claimed_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/claimed_profile" },
      "minItems": 1
    },
    "deployment_modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/deployment_mode" },
      "minItems": 1
    },
    "qualification_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualification_row" },
      "minItems": 1
    },
    "drill_catalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/drill_row" },
      "minItems": 1
    },
    "downgrade_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_rule" },
      "minItems": 1
    },
    "consumer_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_binding" },
      "minItems": 1
    },
    "export_safe_summary": {
      "$ref": "#/$defs/non_empty_string"
    }
  }
}
