{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/support/m5-support-center-matrix.schema.json",
  "title": "Aureline M5 Support Center matrix",
  "description": "Schema for the m5_support_center_matrix packet: the single contract that defines the Support Center as an explicit product surface. It carries one row per Support Center module (doctor, safe-mode, bisect, performance, language, index, ai-usage, crash, network, artifacts, issue-report/crash-intake, support-bundle export preview), binding each module to the one canonical inspector vocabulary (environment-status, precedence-inspector, crash-intake, install/advisory-state, credential-state, export-consent), the export-risk data classes (metadata-only, environment-adjacent, code-adjacent, high-risk), a redaction default, and the local-save/team-share/formal-support export modes it offers. A non-inheriting, fail-closed readiness gate derives each module's published readiness (operational, degraded, inspect-only, unavailable) as the weakest ceiling implied by its declared readiness, evidence freshness (current, aging, expired, missing), bound-inspector availability (available, degraded, unavailable), and export consent (granted, required-not-granted, blocked); the recorded readiness, publication decision (published, narrowed, withheld), downgrade reasons, and recovery path must equal the recomputed gate. High-risk data must be excluded-always and any module that shares off-machine must reuse the export-consent descriptor. Every required consumer surface (desktop-shell, cli-headless, help-about, shiproom, formal-support-handoff) binds to this one packet and must ingest it, preserve its published readiness and recovery paths, and narrow with it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "modules",
    "readiness_labels",
    "evidence_freshness_states",
    "inspectors",
    "inspector_availabilities",
    "data_classes",
    "redaction_defaults",
    "export_modes",
    "consent_states",
    "publications",
    "downgrade_paths",
    "downgrade_reasons",
    "consumer_surfaces",
    "rows",
    "consumer_bindings",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_support_center_matrix" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "readiness_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/readiness" }
    },
    "evidence_freshness_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_freshness" }
    },
    "inspectors": { "type": "array", "items": { "$ref": "#/$defs/inspector" } },
    "inspector_availabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/inspector_availability" }
    },
    "data_classes": { "type": "array", "items": { "$ref": "#/$defs/data_class" } },
    "redaction_defaults": {
      "type": "array",
      "items": { "$ref": "#/$defs/redaction_default" }
    },
    "export_modes": { "type": "array", "items": { "$ref": "#/$defs/export_mode" } },
    "consent_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/consent_state" }
    },
    "publications": { "type": "array", "items": { "$ref": "#/$defs/publication" } },
    "downgrade_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_path" }
    },
    "downgrade_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_reason" }
    },
    "consumer_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "consumer_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "module": {
      "enum": [
        "doctor",
        "safe_mode",
        "bisect",
        "performance",
        "language",
        "index",
        "ai_usage",
        "crash",
        "network",
        "artifacts",
        "issue_report_crash_intake",
        "support_bundle_export_preview"
      ]
    },
    "readiness": {
      "enum": ["operational", "degraded", "inspect_only", "unavailable"]
    },
    "evidence_freshness": {
      "enum": ["current", "aging", "expired", "missing"]
    },
    "inspector": {
      "enum": [
        "environment_status",
        "precedence_inspector",
        "crash_intake",
        "install_advisory_state",
        "credential_state",
        "export_consent"
      ]
    },
    "inspector_availability": {
      "enum": ["available", "degraded", "unavailable"]
    },
    "data_class": {
      "enum": ["metadata_only", "environment_adjacent", "code_adjacent", "high_risk"]
    },
    "redaction_default": {
      "enum": [
        "embedded_metadata_only",
        "embedded_by_reference",
        "retained_local_only",
        "excluded_by_default",
        "excluded_always"
      ]
    },
    "export_mode": {
      "enum": ["local_save", "team_share", "formal_support"]
    },
    "consent_state": {
      "enum": ["granted", "required_not_granted", "blocked"]
    },
    "publication": {
      "enum": ["published", "narrowed", "withheld"]
    },
    "downgrade_path": {
      "enum": [
        "refresh_evidence",
        "restore_inspector",
        "resolve_consent",
        "withhold_module",
        "none"
      ]
    },
    "downgrade_reason": {
      "enum": [
        "evidence_stale",
        "inspector_degraded",
        "inspector_unavailable",
        "consent_unsatisfied"
      ]
    },
    "consumer_surface": {
      "enum": [
        "desktop_shell",
        "cli_headless",
        "help_about",
        "shiproom",
        "formal_support_handoff"
      ]
    },
    "inspector_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspector", "availability", "descriptor_ref", "checked_at"],
      "properties": {
        "inspector": { "$ref": "#/$defs/inspector" },
        "availability": { "$ref": "#/$defs/inspector_availability" },
        "descriptor_ref": { "$ref": "#/$defs/non_empty_string" },
        "checked_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "export_mode_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "consent"],
      "properties": {
        "mode": { "$ref": "#/$defs/export_mode" },
        "consent": { "$ref": "#/$defs/consent_state" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "module",
        "owner",
        "evidence_freshness",
        "inspectors",
        "data_classes",
        "redaction_default",
        "export_modes",
        "declared_readiness",
        "published_readiness",
        "module_publication",
        "downgrade_path",
        "conformance_ref",
        "evidence_ref",
        "scope_snapshot_ref",
        "matrix_receipt_ref",
        "note"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "module": { "$ref": "#/$defs/module" },
        "owner": { "$ref": "#/$defs/non_empty_string" },
        "evidence_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "inspectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inspector_binding" }
        },
        "data_classes": { "type": "array", "items": { "$ref": "#/$defs/data_class" } },
        "redaction_default": { "$ref": "#/$defs/redaction_default" },
        "export_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_mode_binding" }
        },
        "declared_readiness": { "$ref": "#/$defs/readiness" },
        "published_readiness": { "$ref": "#/$defs/readiness" },
        "module_publication": { "$ref": "#/$defs/publication" },
        "downgrade_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_reason" }
        },
        "downgrade_path": { "$ref": "#/$defs/downgrade_path" },
        "offered_actions": { "$ref": "#/$defs/string_array" },
        "caveats": { "$ref": "#/$defs/string_array" },
        "stale_or_missing_fields": { "$ref": "#/$defs/string_array" },
        "conformance_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "matrix_receipt_ref": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "binding_ref",
        "matrix_packet_id_ref",
        "scope_snapshot_ref",
        "ingests_matrix",
        "preserves_published_readiness",
        "preserves_recovery_paths",
        "narrows_on_downgrade",
        "raw_private_material_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "binding_ref": { "$ref": "#/$defs/non_empty_string" },
        "matrix_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingests_matrix": { "type": "boolean" },
        "preserves_published_readiness": { "type": "boolean" },
        "preserves_recovery_paths": { "type": "boolean" },
        "narrows_on_downgrade": { "type": "boolean" },
        "raw_private_material_excluded": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_modules",
        "published_modules",
        "narrowed_modules",
        "withheld_modules",
        "downgraded_modules",
        "modules_with_downgrade_reasons",
        "stale_evidence_modules",
        "modules_with_imperfect_inspectors",
        "exportable_modules"
      ],
      "properties": {
        "total_modules": { "type": "integer", "minimum": 0 },
        "published_modules": { "type": "integer", "minimum": 0 },
        "narrowed_modules": { "type": "integer", "minimum": 0 },
        "withheld_modules": { "type": "integer", "minimum": 0 },
        "downgraded_modules": { "type": "integer", "minimum": 0 },
        "modules_with_downgrade_reasons": { "type": "integer", "minimum": 0 },
        "stale_evidence_modules": { "type": "integer", "minimum": 0 },
        "modules_with_imperfect_inspectors": { "type": "integer", "minimum": 0 },
        "exportable_modules": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
