{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/support/m5-precedence-inspector.schema.json",
  "title": "Aureline precedence inspectors",
  "description": "Schema for the m5_precedence_inspectors packet: the registry of precedence inspectors that show the winning value, the overshadowed candidates, the affected surfaces, and the source-of-truth lineage for every major M5 resolver family (toolchain, setting, policy, credential, route). Each inspector projects the resolver truth by reference - every candidate carries a descriptor_ref and every inspector a source_of_truth_ref - and shows a winning value, the candidates it overshadowed (winner, overshadowed, unavailable, blocked, conflicting), the precedence source class (policy_scoped, project_scoped, user_scoped, system_scoped, fallback_scoped), the policy-lock state, the affected surfaces, and the restart-or-reauth posture. A fail-closed precedence gate derives each inspector's published presentation (transparent, narrowed, blocked) as the weaker of its resolution-class ceiling (resolved presents transparently; fallback, override, drift, and conflict narrow it; blocked caps it) and its value-disclosure ceiling (plain_values present transparently; metadata_only narrows it, used only for identity-bearing families). The recorded presentation, downgrade reasons (silent_fallback_eliminated, hidden_override, source_drift, unreconciled_conflict, policy_lock_blocked, redaction_boundary), resolution path (restore_preferred_source, review_override, request_policy_change, reauthenticate, reconnect_source, reconcile_conflict, none), and blocked-before-use flag must equal the recomputed gate, so a silent fallback, hidden override, or raw secret can never present as a clean 'this value won' chip. Every required consumer surface (active_surface, support_center, support_export, issue_report_packet, cli_headless) binds to this one registry and must ingest it, preserve its precedence vocabulary and object ids, and narrow with it. The packet is metadata-only and carries no credential bodies, raw provider payloads, or hidden policy payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "families",
    "source_classes",
    "value_disclosures",
    "resolution_classes",
    "presentations",
    "downgrade_reasons",
    "resolution_paths",
    "restart_reauth_postures",
    "policy_lock_states",
    "candidate_dispositions",
    "affected_surfaces",
    "consumer_surfaces",
    "inspectors",
    "consumer_bindings",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_precedence_inspectors" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "families": { "type": "array", "items": { "$ref": "#/$defs/family" } },
    "source_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_class" }
    },
    "value_disclosures": {
      "type": "array",
      "items": { "$ref": "#/$defs/value_disclosure" }
    },
    "resolution_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolution_class" }
    },
    "presentations": {
      "type": "array",
      "items": { "$ref": "#/$defs/presentation" }
    },
    "downgrade_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_reason" }
    },
    "resolution_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolution_path" }
    },
    "restart_reauth_postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/restart_reauth_posture" }
    },
    "policy_lock_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/policy_lock_state" }
    },
    "candidate_dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate_disposition" }
    },
    "affected_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/affected_surface" }
    },
    "consumer_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "inspectors": { "type": "array", "items": { "$ref": "#/$defs/inspector" } },
    "consumer_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "family": {
      "enum": ["toolchain", "setting", "policy", "credential", "route"]
    },
    "source_class": {
      "enum": [
        "policy_scoped",
        "project_scoped",
        "user_scoped",
        "system_scoped",
        "fallback_scoped"
      ]
    },
    "value_disclosure": {
      "enum": ["plain_values", "metadata_only"]
    },
    "resolution_class": {
      "enum": ["resolved", "fallback", "override", "drift", "conflict", "blocked"]
    },
    "presentation": {
      "enum": ["transparent", "narrowed", "blocked"]
    },
    "downgrade_reason": {
      "enum": [
        "silent_fallback_eliminated",
        "hidden_override",
        "source_drift",
        "unreconciled_conflict",
        "policy_lock_blocked",
        "redaction_boundary"
      ]
    },
    "resolution_path": {
      "enum": [
        "restore_preferred_source",
        "review_override",
        "request_policy_change",
        "reauthenticate",
        "reconnect_source",
        "reconcile_conflict",
        "none"
      ]
    },
    "restart_reauth_posture": {
      "enum": ["none", "restart_required", "reauth_required", "reconnect_required"]
    },
    "policy_lock_state": {
      "enum": ["unlocked", "locked"]
    },
    "candidate_disposition": {
      "enum": ["winner", "overshadowed", "unavailable", "blocked", "conflicting"]
    },
    "affected_surface": {
      "enum": [
        "run",
        "test",
        "debug",
        "notebook",
        "request",
        "database",
        "preview",
        "pipeline",
        "editor",
        "terminal"
      ]
    },
    "consumer_surface": {
      "enum": [
        "active_surface",
        "support_center",
        "support_export",
        "issue_report_packet",
        "cli_headless"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_class", "value_label", "disposition", "reason", "descriptor_ref"],
      "properties": {
        "source_class": { "$ref": "#/$defs/source_class" },
        "value_label": { "$ref": "#/$defs/non_empty_string" },
        "disposition": { "$ref": "#/$defs/candidate_disposition" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "descriptor_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspector_id",
        "family",
        "title",
        "winning_value_label",
        "source_class",
        "value_disclosure",
        "policy_lock_state",
        "resolution_class",
        "presentation",
        "resolution_path",
        "restart_reauth_posture",
        "blocked_before_use",
        "raw_material_excluded",
        "candidates",
        "affected_surfaces",
        "source_of_truth_ref",
        "explain_entrypoint_ref",
        "cli_object_ref",
        "conformance_ref",
        "evidence_ref",
        "scope_snapshot_ref",
        "inspector_receipt_ref",
        "note"
      ],
      "properties": {
        "inspector_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "winning_value_label": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "value_disclosure": { "$ref": "#/$defs/value_disclosure" },
        "policy_lock_state": { "$ref": "#/$defs/policy_lock_state" },
        "resolution_class": { "$ref": "#/$defs/resolution_class" },
        "presentation": { "$ref": "#/$defs/presentation" },
        "downgrade_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_reason" }
        },
        "resolution_path": { "$ref": "#/$defs/resolution_path" },
        "restart_reauth_posture": { "$ref": "#/$defs/restart_reauth_posture" },
        "blocked_before_use": { "type": "boolean" },
        "raw_material_excluded": { "type": "boolean" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "affected_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/affected_surface" }
        },
        "caveats": { "$ref": "#/$defs/string_array" },
        "unmet_or_blocked_sources": { "$ref": "#/$defs/string_array" },
        "source_of_truth_ref": { "$ref": "#/$defs/non_empty_string" },
        "explain_entrypoint_ref": { "$ref": "#/$defs/non_empty_string" },
        "cli_object_ref": { "$ref": "#/$defs/non_empty_string" },
        "conformance_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "inspector_receipt_ref": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "binding_ref",
        "packet_id_ref",
        "scope_snapshot_ref",
        "ingests_registry",
        "preserves_precedence_vocabulary",
        "preserves_object_ids",
        "narrows_on_downgrade",
        "raw_material_excluded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "binding_ref": { "$ref": "#/$defs/non_empty_string" },
        "packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_snapshot_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingests_registry": { "type": "boolean" },
        "preserves_precedence_vocabulary": { "type": "boolean" },
        "preserves_object_ids": { "type": "boolean" },
        "narrows_on_downgrade": { "type": "boolean" },
        "raw_material_excluded": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_inspectors",
        "transparent_inspectors",
        "narrowed_inspectors",
        "blocked_inspectors",
        "inspectors_with_downgrade_reasons",
        "metadata_only_inspectors",
        "blocked_before_use_inspectors",
        "families_covered",
        "total_candidates",
        "total_affected_surface_links"
      ],
      "properties": {
        "total_inspectors": { "type": "integer", "minimum": 0 },
        "transparent_inspectors": { "type": "integer", "minimum": 0 },
        "narrowed_inspectors": { "type": "integer", "minimum": 0 },
        "blocked_inspectors": { "type": "integer", "minimum": 0 },
        "inspectors_with_downgrade_reasons": { "type": "integer", "minimum": 0 },
        "metadata_only_inspectors": { "type": "integer", "minimum": 0 },
        "blocked_before_use_inspectors": { "type": "integer", "minimum": 0 },
        "families_covered": { "type": "integer", "minimum": 0 },
        "total_candidates": { "type": "integer", "minimum": 0 },
        "total_affected_surface_links": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
