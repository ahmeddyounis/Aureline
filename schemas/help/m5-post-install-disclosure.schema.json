{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/help/m5-post-install-disclosure.schema.json",
  "title": "Aureline M5 post-install notice/provenance/SBOM disclosure panel set",
  "description": "Export-safe bundle of post-install disclosure panels for the four governed M5 artifact families — desktop builds/installers, extension/framework packs, mirrored/offline artifacts, and generated/exported artifacts. Each panel is one post_install_disclosure_record conforming to schemas/governance/post_install_disclosure.schema.json; the bundle adds family coverage, honesty invariants, and consumer-surface projection so About/help, installed-state inspectors, diagnostics exports, and marketplace/package detail read one model. Raw artifact bytes, raw signatures, raw SBOM bodies, raw notice text, raw registry URLs, raw license files, raw advisory payloads, private mirror endpoints, and customer identifiers never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "panel_set_label",
    "panels",
    "coverage",
    "honesty_invariants",
    "consumer_projection",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_post_install_disclosure_panel_set"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "panel_set_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "panels": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "https://aureline.dev/schemas/governance/post_install_disclosure.schema.json"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "honesty_invariants": {
      "$ref": "#/$defs/honesty_invariants"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "true_flag": {
      "type": "boolean",
      "const": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "covers_desktop_build_installer",
        "covers_extension_framework_pack",
        "covers_mirrored_offline_artifact",
        "covers_generated_export_artifact"
      ],
      "properties": {
        "covers_desktop_build_installer": { "$ref": "#/$defs/true_flag" },
        "covers_extension_framework_pack": { "$ref": "#/$defs/true_flag" },
        "covers_mirrored_offline_artifact": { "$ref": "#/$defs/true_flag" },
        "covers_generated_export_artifact": { "$ref": "#/$defs/true_flag" }
      }
    },
    "honesty_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind_explicit",
        "missing_data_visible_not_omitted",
        "source_class_and_subject_separate",
        "trust_evidence_layered",
        "post_install_access_survives",
        "sbom_format_and_scope_explicit",
        "exports_preserve_caveats",
        "provenance_states_distinguish_official_mirrored_side_loaded_unknown",
        "stale_or_revoked_never_reads_as_verified"
      ],
      "properties": {
        "subject_kind_explicit": { "$ref": "#/$defs/true_flag" },
        "missing_data_visible_not_omitted": { "$ref": "#/$defs/true_flag" },
        "source_class_and_subject_separate": { "$ref": "#/$defs/true_flag" },
        "trust_evidence_layered": { "$ref": "#/$defs/true_flag" },
        "post_install_access_survives": { "$ref": "#/$defs/true_flag" },
        "sbom_format_and_scope_explicit": { "$ref": "#/$defs/true_flag" },
        "exports_preserve_caveats": { "$ref": "#/$defs/true_flag" },
        "provenance_states_distinguish_official_mirrored_side_loaded_unknown": {
          "$ref": "#/$defs/true_flag"
        },
        "stale_or_revoked_never_reads_as_verified": { "$ref": "#/$defs/true_flag" }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "about_help_shows_disclosure_panel",
        "installed_state_inspector_shows_disclosure_panel",
        "diagnostics_export_includes_disclosure_record",
        "marketplace_or_package_detail_shows_provenance_for_packs",
        "does_not_replace_release_publication_artifacts"
      ],
      "properties": {
        "about_help_shows_disclosure_panel": { "$ref": "#/$defs/true_flag" },
        "installed_state_inspector_shows_disclosure_panel": { "$ref": "#/$defs/true_flag" },
        "diagnostics_export_includes_disclosure_record": { "$ref": "#/$defs/true_flag" },
        "marketplace_or_package_detail_shows_provenance_for_packs": { "$ref": "#/$defs/true_flag" },
        "does_not_replace_release_publication_artifacts": { "$ref": "#/$defs/true_flag" }
      }
    }
  }
}
