{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/help/m5-learnability-lane.schema.json",
  "title": "Aureline frozen M5 learnability lane",
  "description": "Boundary schema for the frozen M5 learnability lane. The freeze packet binds one controlled vocabulary (nine learnability terms — learning_mode, tour_package, guided_exercise, glossary_pack, contextual_why_now_card, educational_ai, practice_sandbox_indicator, learning_digest, progress_snapshot), one explain-versus-do boundary for educational AI, and one lane matrix mapping each claimed M5 feature family against each term onto a single canonical lane. Cross-cutting terms (learning_mode, educational_ai, learning_digest) share one canonical lane across every family so no family invents feature-local onboarding state. Each row's verdict is the strictest verdict folded from its command-backed, coachmark, mutation-path, ownership, offline/mirror-parity, and support-export-parity evidence; the packet carries the narrowest overall verdict. Raw pack bodies, raw URLs, raw absolute paths, and raw credential material MUST NOT appear; the schema carries opaque ids, typed vocabulary, and short privacy-safe labels only. Adding a new term or family is additive-minor; repurposing an existing value is breaking.",
  "oneOf": [
    { "$ref": "#/$defs/learnability_vocabulary_entry" },
    { "$ref": "#/$defs/learnability_lane_row" },
    { "$ref": "#/$defs/m5_learnability_lane_freeze" }
  ],
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Integer schema version for frozen learnability-lane records. Current value is 1. Bumped only on breaking payload changes."
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque, stable identifier. Raw URLs, raw absolute paths, and raw secret material MUST NOT appear."
    },
    "qualification_verdict": {
      "type": "string",
      "enum": ["qualified_stable", "narrowed_preview", "narrowed_beta", "absent"],
      "description": "Derived lifecycle verdict for a lane row or the overall freeze."
    },
    "explain_apply_class": {
      "type": "string",
      "enum": ["fully_separated", "apply_requires_approval", "read_only", "conflated"],
      "description": "Explain-versus-do separation class. 'conflated' narrows below Stable."
    },
    "mutation_path_class": {
      "type": "string",
      "enum": ["read_only_no_mutation", "preview_approval_required", "hidden_direct_mutation"],
      "description": "How a surface may mutate state. 'hidden_direct_mutation' narrows below Stable."
    },
    "data_ownership_class": {
      "type": "string",
      "enum": ["user_owned_local_first", "repo_visible_shared", "telemetry_grade_shared"],
      "description": "Who owns the surface's state. Only 'user_owned_local_first' qualifies Stable."
    },
    "learnability_term": {
      "type": "string",
      "enum": [
        "learning_mode",
        "tour_package",
        "guided_exercise",
        "glossary_pack",
        "contextual_why_now_card",
        "educational_ai",
        "practice_sandbox_indicator",
        "learning_digest",
        "progress_snapshot"
      ],
      "description": "One frozen term in the M5 learnability controlled vocabulary."
    },
    "m5_learning_surface_family": {
      "type": "string",
      "enum": [
        "notebook",
        "request_workspace",
        "database_workspace",
        "profiler_trace",
        "docs_browser",
        "preview",
        "template_scaffold",
        "companion",
        "sync_offboarding"
      ],
      "description": "One claimed M5 depth feature family that exposes learnability surfaces."
    },
    "mirror_parity_posture": {
      "type": "object",
      "additionalProperties": false,
      "description": "Offline and mirror-aware availability posture. Local-only, air-gapped, and mirrored profiles must surface learning state with an explicit freshness label instead of silently dead-linking.",
      "required": [
        "available_offline",
        "available_on_mirror",
        "freshness_label",
        "explicit_freshness_disclosed",
        "silent_dead_link_on_stale"
      ],
      "properties": {
        "available_offline": { "type": "boolean" },
        "available_on_mirror": { "type": "boolean" },
        "freshness_label": { "type": "string", "minLength": 1 },
        "explicit_freshness_disclosed": { "type": "boolean" },
        "silent_dead_link_on_stale": { "type": "boolean" },
        "narrowing_reason": { "type": "string", "minLength": 1 }
      }
    },
    "support_export_parity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Support-export parity posture. The same learning state shown in-product must be inspectable in support export, must match the in-product state, and must never carry credential bodies.",
      "required": [
        "inspectable_in_support_export",
        "matches_in_product_state",
        "carries_no_credential_bodies"
      ],
      "properties": {
        "inspectable_in_support_export": { "type": "boolean" },
        "matches_in_product_state": { "type": "boolean" },
        "carries_no_credential_bodies": { "type": "boolean" },
        "narrowing_reason": { "type": "string", "minLength": 1 }
      }
    },
    "educational_ai_boundary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Frozen explain-versus-do boundary for educational AI. Educational AI may explain freely, but 'do' stays separate and rides the standard preview/approval/rollback path; it never mutates live state directly.",
      "required": [
        "explain_and_do_separate",
        "do_requires_same_preview_approval",
        "can_mutate_live_state_directly",
        "practice_sandbox_indicator_present"
      ],
      "properties": {
        "explain_and_do_separate": { "type": "boolean", "const": true },
        "do_requires_same_preview_approval": { "type": "boolean", "const": true },
        "can_mutate_live_state_directly": { "type": "boolean", "const": false },
        "practice_sandbox_indicator_present": { "type": "boolean" },
        "narrowing_reason": { "type": "string", "minLength": 1 }
      }
    },
    "learnability_vocabulary_entry": {
      "type": "object",
      "additionalProperties": false,
      "description": "A frozen controlled-vocabulary entry for one learnability term.",
      "required": [
        "record_kind",
        "schema_version",
        "term",
        "token",
        "definition",
        "explain_apply_class",
        "mutation_path_class",
        "data_ownership_class",
        "command_backed_required",
        "authority_boundary_change_allowed"
      ],
      "properties": {
        "record_kind": { "const": "learnability_vocabulary_entry" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "term": { "$ref": "#/$defs/learnability_term" },
        "token": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "explain_apply_class": { "$ref": "#/$defs/explain_apply_class" },
        "mutation_path_class": { "$ref": "#/$defs/mutation_path_class" },
        "data_ownership_class": {
          "allOf": [
            { "$ref": "#/$defs/data_ownership_class" },
            { "const": "user_owned_local_first" }
          ]
        },
        "command_backed_required": { "type": "boolean" },
        "authority_boundary_change_allowed": { "type": "boolean", "const": false }
      }
    },
    "learnability_lane_row": {
      "type": "object",
      "additionalProperties": false,
      "description": "One cell of the frozen lane matrix: how a family routes one learnability term through the canonical lane.",
      "required": [
        "record_kind",
        "schema_version",
        "family",
        "term",
        "surface_token",
        "canonical_lane_ref",
        "command_backed",
        "hidden_feature_local_coachmark",
        "private_mutation_path",
        "explain_apply_class",
        "mutation_path_class",
        "data_ownership_class",
        "mirror_parity",
        "support_export_parity",
        "verdict"
      ],
      "properties": {
        "record_kind": { "const": "learnability_lane_row" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "family": { "$ref": "#/$defs/m5_learning_surface_family" },
        "term": { "$ref": "#/$defs/learnability_term" },
        "surface_token": { "$ref": "#/$defs/opaque_id" },
        "canonical_lane_ref": { "$ref": "#/$defs/opaque_id" },
        "command_backed": { "type": "boolean" },
        "hidden_feature_local_coachmark": { "type": "boolean" },
        "private_mutation_path": { "type": "boolean" },
        "explain_apply_class": { "$ref": "#/$defs/explain_apply_class" },
        "mutation_path_class": { "$ref": "#/$defs/mutation_path_class" },
        "data_ownership_class": { "$ref": "#/$defs/data_ownership_class" },
        "mirror_parity": { "$ref": "#/$defs/mirror_parity_posture" },
        "support_export_parity": { "$ref": "#/$defs/support_export_parity" },
        "verdict": { "$ref": "#/$defs/qualification_verdict" },
        "narrowing_reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "m5_learnability_lane_freeze": {
      "type": "object",
      "additionalProperties": false,
      "description": "The frozen M5 learnability lane: controlled vocabulary, educational-AI boundary, and lane matrix in one canonical packet.",
      "required": [
        "record_kind",
        "schema_version",
        "freeze_id",
        "generated_at",
        "contract_refs",
        "vocabulary",
        "educational_ai_boundary",
        "lane_rows",
        "overall_verdict"
      ],
      "properties": {
        "record_kind": { "const": "m5_learnability_lane_freeze" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "freeze_id": { "$ref": "#/$defs/opaque_id" },
        "generated_at": { "type": "string", "minLength": 1 },
        "contract_refs": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "vocabulary": {
          "type": "array",
          "minItems": 9,
          "items": { "$ref": "#/$defs/learnability_vocabulary_entry" }
        },
        "educational_ai_boundary": { "$ref": "#/$defs/educational_ai_boundary" },
        "lane_rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/learnability_lane_row" }
        },
        "overall_verdict": { "$ref": "#/$defs/qualification_verdict" },
        "overall_narrowing_reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
