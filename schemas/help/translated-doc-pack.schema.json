{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/help/translated-doc-pack.schema.json",
  "title": "Aureline M5 translated help/docs/tour/auth/recovery/onboarding pack",
  "description": "Translated long-form M5 learnability and recovery assets for the claimed localized profiles: docs/help pages, guided tours, glossary cards, auth copy, recovery copy, and onboarding. Each translation is bound to a stable, locale-neutral asset id and preserves the source asset's citation anchors, command ids, keyboard paths, and scope labels byte-for-byte; it discloses freshness, the source revision it was translated from, and its mirror/offline posture; and it carries an 'Open in source language' escape hatch. Translated bodies live as files under docs/help/locales/ and are referenced by path; this packet carries no credentials or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "pack_id",
    "generated_at",
    "source_language_locale",
    "target_build_identity_ref",
    "source_contract_refs",
    "runtime_consumer_refs",
    "claimed_locales",
    "source_assets",
    "translations",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_translated_help_pack_packet" },
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_language_locale": { "$ref": "#/$defs/locale" },
    "target_build_identity_ref": { "type": "string", "minLength": 1 },
    "source_contract_refs": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "runtime_consumer_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "claimed_locales": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/locale" }
    },
    "source_assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_asset" }
    },
    "translations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/translated_asset" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "asset_family": {
      "enum": [
        "docs",
        "guided_tour",
        "glossary_card",
        "auth_copy",
        "recovery_copy",
        "onboarding"
      ]
    },
    "coverage_state": {
      "enum": ["translated_complete", "translated_partial", "translated_stale"]
    },
    "freshness_class": {
      "enum": [
        "current_with_live_source",
        "warm_cached",
        "stale_behind_source",
        "offline_pinned"
      ]
    },
    "mirror_offline_posture": {
      "enum": [
        "built_in_local",
        "mirrored",
        "offline_pack",
        "cached",
        "live_online",
        "not_installed"
      ]
    },
    "skew_state": { "enum": ["no_skew", "source_revision_ahead"] },
    "badge_class": {
      "enum": [
        "translated",
        "partial_translation",
        "stale_translation",
        "source_language_fallback"
      ]
    },
    "text_direction": { "enum": ["left_to_right", "right_to_left"] },
    "hatch_kind": {
      "enum": [
        "inline_source_language_toggle",
        "command_open_in_source_language",
        "docs_pane_source_language_route",
        "cli_locale_neutral_output_flag",
        "export_in_source_language_for_review"
      ]
    },
    "preserved_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_anchor_refs",
        "command_id_refs",
        "keyboard_path_refs",
        "scope_label_refs"
      ],
      "properties": {
        "citation_anchor_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "command_id_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "keyboard_path_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scope_label_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "escape_hatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hatch_kind",
        "action_label",
        "command_id_ref",
        "source_target_ref",
        "keyboard_path_ref",
        "keyboard_reachable"
      ],
      "properties": {
        "hatch_kind": { "$ref": "#/$defs/hatch_kind" },
        "action_label": { "const": "Open in source language" },
        "command_id_ref": { "type": "string", "pattern": "^cmd:" },
        "source_target_ref": { "type": "string", "minLength": 1 },
        "keyboard_path_ref": { "type": "string", "minLength": 1 },
        "keyboard_reachable": { "type": "boolean" }
      }
    },
    "source_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_family",
        "source_language_locale",
        "source_title",
        "source_revision_ref",
        "source_body_ref",
        "preserved_refs",
        "escape_hatch"
      ],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "asset_family": { "$ref": "#/$defs/asset_family" },
        "source_language_locale": { "$ref": "#/$defs/locale" },
        "source_title": { "type": "string", "minLength": 1 },
        "source_revision_ref": { "type": "string", "minLength": 1 },
        "source_body_ref": { "type": "string", "minLength": 1 },
        "preserved_refs": { "$ref": "#/$defs/preserved_refs" },
        "escape_hatch": { "$ref": "#/$defs/escape_hatch" }
      }
    },
    "translated_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_family",
        "requested_locale",
        "effective_locale",
        "coverage_state",
        "freshness_class",
        "skew_state",
        "mirror_offline_posture",
        "badge_class",
        "text_direction",
        "source_revision_ref",
        "overlay_revision_ref",
        "overlay_source_revision_ref",
        "translated_title",
        "translated_body_ref",
        "preserved_refs",
        "escape_hatch"
      ],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "asset_family": { "$ref": "#/$defs/asset_family" },
        "requested_locale": { "$ref": "#/$defs/locale" },
        "effective_locale": { "$ref": "#/$defs/locale" },
        "coverage_state": { "$ref": "#/$defs/coverage_state" },
        "freshness_class": { "$ref": "#/$defs/freshness_class" },
        "skew_state": { "$ref": "#/$defs/skew_state" },
        "mirror_offline_posture": { "$ref": "#/$defs/mirror_offline_posture" },
        "badge_class": { "$ref": "#/$defs/badge_class" },
        "text_direction": { "$ref": "#/$defs/text_direction" },
        "source_revision_ref": { "type": "string", "minLength": 1 },
        "overlay_revision_ref": { "type": "string", "minLength": 1 },
        "overlay_source_revision_ref": { "type": "string", "minLength": 1 },
        "translated_title": { "type": "string", "minLength": 1 },
        "translated_body_ref": { "type": "string", "minLength": 1 },
        "preserved_refs": { "$ref": "#/$defs/preserved_refs" },
        "escape_hatch": { "$ref": "#/$defs/escape_hatch" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_asset_count",
        "families_covered",
        "total_translations",
        "translations_by_locale",
        "translations_by_family",
        "claimed_locales"
      ],
      "properties": {
        "source_asset_count": { "type": "integer", "minimum": 0 },
        "families_covered": { "type": "integer", "minimum": 0 },
        "total_translations": { "type": "integer", "minimum": 0 },
        "translations_by_locale": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "translations_by_family": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "claimed_locales": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
