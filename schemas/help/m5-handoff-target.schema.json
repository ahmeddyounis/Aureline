{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/help/m5-handoff-target.schema.json",
  "title": "Aureline M5 community-handoff target review sheet set",
  "description": "Export-safe packet bundling one community-handoff target review sheet per governed outbound route — public issue, security disclosure, docs feedback, RFC/discussion, community support, and official support. Each sheet pins a five-class destination trust vocabulary (official_public, official_authenticated, community, private_security, local_only), a visibility boundary, an auth expectation, a data-exit boundary and reviewable note, a commitment-honesty block so support/community links never masquerade as guarantees, optional object anchor and issue-template support for richer handoffs, at least one safe fallback, and a mandatory local-safe fallback that never leaves the product. A route may only target a trust class from its allowed set; world-readable routes require prior review and never auto-open from a critical alert; private/security routes always carry an unsupported-profile disclosure. Raw URLs, raw email addresses, raw local paths, raw usernames, raw hostnames, tokens, and raw secret material never cross this boundary; the records carry opaque refs and bounded reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "sheet_set_id",
    "sheet_set_label",
    "sheets",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at",
    "contract_doc_ref"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_community_handoff_target_sheet_set" },
    "sheet_set_id": { "$ref": "#/$defs/non_empty_string" },
    "sheet_set_label": { "$ref": "#/$defs/non_empty_string" },
    "sheets": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/community_handoff_target_sheet" }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" },
      "uniqueItems": true
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/opaque_ref" },
    "contract_doc_ref": {
      "const": "docs/help/m5_community_handoff_targets_contract.md"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "opaque_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$",
      "not": { "pattern": "://|@" },
      "description": "Opaque, stable identifier safe for live surfaces and exports. Raw URLs, raw absolute paths, raw email addresses, and raw secret material MUST NOT appear."
    },
    "nullable_reviewable_sentence": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/non_empty_string" }
      ]
    },
    "route_class": {
      "type": "string",
      "enum": [
        "public_issue",
        "security_disclosure",
        "docs_feedback",
        "rfc_discussion",
        "community_support",
        "official_support"
      ]
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "official_public",
        "official_authenticated",
        "community",
        "private_security",
        "local_only"
      ]
    },
    "visibility_boundary": {
      "type": "string",
      "enum": [
        "world_readable_public",
        "official_account_visible",
        "community_visible",
        "private_security_channel",
        "local_never_leaves"
      ]
    },
    "auth_expectation": {
      "type": "string",
      "enum": [
        "no_account_needed",
        "official_account_required",
        "community_account_typical",
        "security_channel_credential",
        "local_no_network"
      ]
    },
    "data_exit_boundary": {
      "type": "string",
      "enum": [
        "no_payload_leaves_product",
        "metadata_safe_object_refs",
        "proposal_refs_only",
        "redacted_support_packet",
        "security_payloads_only",
        "external_public_browse",
        "vendor_or_third_party_outbound"
      ]
    },
    "commitment_class": {
      "type": "string",
      "enum": [
        "official_supported_commitment",
        "best_effort_community",
        "no_commitment_public_forum",
        "security_handled_privately",
        "local_draft_no_delivery"
      ]
    },
    "build_context_export_class": {
      "type": "string",
      "enum": [
        "public_issue_template_block",
        "private_support_intake_block",
        "private_security_intake_block",
        "community_discussion_block"
      ]
    },
    "commitment_honesty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guaranteed_product_commitment",
        "commitment_class",
        "honesty_note"
      ],
      "properties": {
        "guaranteed_product_commitment": { "type": "boolean" },
        "commitment_class": { "$ref": "#/$defs/commitment_class" },
        "honesty_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "object_anchor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor_ref", "object_ref", "anchor_label"],
          "properties": {
            "anchor_ref": { "$ref": "#/$defs/opaque_ref" },
            "object_ref": { "$ref": "#/$defs/opaque_ref" },
            "anchor_label": { "$ref": "#/$defs/non_empty_string" }
          }
        }
      ]
    },
    "issue_template": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template_ref",
            "template_label",
            "export_class",
            "carries_structured_fields",
            "template_summary"
          ],
          "properties": {
            "template_ref": { "$ref": "#/$defs/opaque_ref" },
            "template_label": { "$ref": "#/$defs/non_empty_string" },
            "export_class": { "$ref": "#/$defs/build_context_export_class" },
            "carries_structured_fields": { "type": "boolean" },
            "template_summary": { "$ref": "#/$defs/non_empty_string" }
          }
        }
      ]
    },
    "build_context_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_class",
        "export_block_ref",
        "export_block_schema_version",
        "redacted_for_audience",
        "raw_screenshots_excluded",
        "raw_secrets_excluded",
        "export_summary"
      ],
      "properties": {
        "export_class": { "$ref": "#/$defs/build_context_export_class" },
        "export_block_ref": { "$ref": "#/$defs/opaque_ref" },
        "export_block_schema_version": { "type": "integer", "minimum": 1 },
        "redacted_for_audience": { "$ref": "#/$defs/build_context_export_class" },
        "raw_screenshots_excluded": { "type": "boolean", "const": true },
        "raw_secrets_excluded": { "type": "boolean", "const": true },
        "export_summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "local_safe_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fallback_ref",
        "trust_class",
        "visibility_boundary",
        "auth_expectation",
        "data_exit_boundary",
        "fallback_summary"
      ],
      "properties": {
        "fallback_ref": { "$ref": "#/$defs/opaque_ref" },
        "trust_class": { "const": "local_only" },
        "visibility_boundary": { "const": "local_never_leaves" },
        "auth_expectation": { "const": "local_no_network" },
        "data_exit_boundary": { "const": "no_payload_leaves_product" },
        "fallback_summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "community_handoff_target_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "community_handoff_target_sheet_schema_version",
        "record_kind",
        "target_id",
        "route_class",
        "trust_class",
        "visibility_boundary",
        "auth_expectation",
        "data_exit_boundary",
        "data_exit_note",
        "destination_identity_ref",
        "destination_label",
        "recipient_label",
        "commitment_honesty",
        "object_anchor",
        "issue_template",
        "build_context_exports",
        "safe_fallback_refs",
        "local_safe_fallback",
        "requires_prior_review_before_open",
        "auto_open_from_critical_alert_allowed",
        "unsupported_profile_disclosure_required",
        "headline_label",
        "target_summary",
        "contract_doc_ref",
        "notes"
      ],
      "properties": {
        "community_handoff_target_sheet_schema_version": { "const": 1 },
        "record_kind": { "const": "community_handoff_target_sheet_record" },
        "target_id": {
          "type": "string",
          "pattern": "^community_handoff_target:[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "route_class": { "$ref": "#/$defs/route_class" },
        "trust_class": { "$ref": "#/$defs/trust_class" },
        "visibility_boundary": { "$ref": "#/$defs/visibility_boundary" },
        "auth_expectation": { "$ref": "#/$defs/auth_expectation" },
        "data_exit_boundary": { "$ref": "#/$defs/data_exit_boundary" },
        "data_exit_note": { "$ref": "#/$defs/non_empty_string" },
        "destination_identity_ref": { "$ref": "#/$defs/opaque_ref" },
        "destination_label": { "$ref": "#/$defs/non_empty_string" },
        "recipient_label": { "$ref": "#/$defs/non_empty_string" },
        "commitment_honesty": { "$ref": "#/$defs/commitment_honesty" },
        "object_anchor": { "$ref": "#/$defs/object_anchor" },
        "issue_template": { "$ref": "#/$defs/issue_template" },
        "build_context_exports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/build_context_export" }
        },
        "safe_fallback_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opaque_ref" }
        },
        "local_safe_fallback": { "$ref": "#/$defs/local_safe_fallback" },
        "requires_prior_review_before_open": { "type": "boolean" },
        "auto_open_from_critical_alert_allowed": { "type": "boolean" },
        "unsupported_profile_disclosure_required": { "type": "boolean" },
        "headline_label": { "$ref": "#/$defs/non_empty_string" },
        "target_summary": { "$ref": "#/$defs/non_empty_string" },
        "contract_doc_ref": {
          "const": "docs/help/m5_community_handoff_targets_contract.md"
        },
        "notes": { "$ref": "#/$defs/nullable_reviewable_sentence" }
      },
      "allOf": [
        {
          "description": "A route may only target a trust class from its allowed set.",
          "if": {
            "properties": { "route_class": { "const": "security_disclosure" } },
            "required": ["route_class"]
          },
          "then": { "properties": { "trust_class": { "const": "private_security" } } }
        },
        {
          "if": {
            "properties": { "route_class": { "const": "official_support" } },
            "required": ["route_class"]
          },
          "then": { "properties": { "trust_class": { "const": "official_authenticated" } } }
        },
        {
          "if": {
            "properties": { "route_class": { "const": "community_support" } },
            "required": ["route_class"]
          },
          "then": { "properties": { "trust_class": { "const": "community" } } }
        },
        {
          "if": {
            "properties": {
              "route_class": {
                "enum": ["public_issue", "docs_feedback", "rfc_discussion"]
              }
            },
            "required": ["route_class"]
          },
          "then": {
            "properties": {
              "trust_class": { "enum": ["official_public", "community"] }
            }
          }
        },
        {
          "description": "World-readable trust classes require prior review and never auto-open from a critical alert.",
          "if": {
            "properties": {
              "trust_class": { "enum": ["official_public", "community"] }
            },
            "required": ["trust_class"]
          },
          "then": {
            "properties": {
              "requires_prior_review_before_open": { "const": true },
              "auto_open_from_critical_alert_allowed": { "const": false }
            }
          }
        },
        {
          "description": "A private/security route requires an unsupported-profile disclosure.",
          "if": {
            "properties": { "trust_class": { "const": "private_security" } },
            "required": ["trust_class"]
          },
          "then": {
            "properties": {
              "unsupported_profile_disclosure_required": { "const": true }
            }
          }
        },
        {
          "description": "A guaranteed product commitment is only honest for an official authenticated support route.",
          "if": {
            "properties": {
              "commitment_honesty": {
                "properties": {
                  "guaranteed_product_commitment": { "const": true }
                },
                "required": ["guaranteed_product_commitment"]
              }
            },
            "required": ["commitment_honesty"]
          },
          "then": {
            "properties": {
              "trust_class": { "const": "official_authenticated" },
              "commitment_honesty": {
                "properties": {
                  "commitment_class": { "const": "official_supported_commitment" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
