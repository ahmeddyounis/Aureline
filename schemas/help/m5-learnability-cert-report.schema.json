{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/help/m5-learnability-cert-report.schema.json",
  "title": "Aureline M5 learning-mode / guided-exercise / progress-snapshot / educational-AI / offline-mirror learnability truth certification",
  "description": "Export-safe certification binding every claimed M5 feature-family onboarding row (notebook, request/API, database, profiler/trace, docs/browser, preview, template/scaffold, companion, sync/offboarding) to per-dimension learnability-evidence proof over the guided-tour, guided-exercise, progress-snapshot, educational-AI, offline-mirror, and learning-mode-profile dimensions. Each dimension certification names a proof currency and, unless the proof is missing, a reopenable proof ref keyed by a non-display fingerprint. A claimed row whose required-core dimension is uncertified, or whose certified dimension lacks current proof (stale, missing, requires-review, or mirror proof standing in for a live local claim), auto-narrows to an effective grade strictly below its claim, with a recorded narrow trigger and a precise narrowed label. Tutorials, hints, and exercises stay command-backed and opt-in; explain stays separate from do behind the standard preview/approval model; progress stays user-owned and local-first; cached/offline-mirror packs stay explicit with disclosed freshness; educational AI cites repository truth rather than answering omnisciently; and experts are never trapped in tutorials. Raw progress bodies, speaker notes, repository contents, provider payloads, credentials, and raw docs-pack bytes never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "label",
    "rows",
    "guardrails",
    "consumer_projection",
    "evidence_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "certify_m5_learnability_onboarding_truth_packet"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/certified_learnability_row"
      }
    },
    "guardrails": {
      "$ref": "#/$defs/guardrails"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "evidence_freshness": {
      "$ref": "#/$defs/evidence_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "m5_learning_surface_family": {
      "type": "string",
      "enum": [
        "notebook",
        "request_workspace",
        "database_workspace",
        "profiler_trace",
        "docs_browser",
        "preview",
        "template_scaffold",
        "companion",
        "sync_offboarding"
      ]
    },
    "learnability_evidence_dimension": {
      "type": "string",
      "enum": [
        "guided_tour",
        "guided_exercise",
        "progress_snapshot",
        "educational_ai",
        "offline_mirror",
        "learning_mode_profile"
      ]
    },
    "learnability_proof_currency": {
      "type": "string",
      "enum": [
        "verified_current",
        "cached_within_window",
        "mirror_current",
        "stale_expired",
        "missing_proof",
        "requires_review"
      ]
    },
    "learnability_certification_grade": {
      "type": "string",
      "enum": [
        "release_certified",
        "certified",
        "provisionally_certified",
        "uncertified",
        "not_applicable"
      ]
    },
    "learnability_narrow_trigger": {
      "type": "string",
      "enum": [
        "missing_dimension_proof",
        "stale_dimension_proof",
        "mirror_proof_on_live_row",
        "verdict_requires_review",
        "tour_steps_not_command_backed",
        "progress_not_user_owned",
        "educational_ai_citations_missing",
        "offline_mirror_continuity_lost",
        "explain_do_separation_lost",
        "upstream_dependency_narrowed"
      ]
    },
    "certified_learnability_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "family",
        "mirror_served",
        "subject_fingerprint_token"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "family": {
          "$ref": "#/$defs/m5_learning_surface_family"
        },
        "mirror_served": {
          "type": "boolean"
        },
        "subject_fingerprint_token": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "learnability_dimension_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "proof_currency",
        "summary"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/learnability_evidence_dimension"
        },
        "proof_currency": {
          "$ref": "#/$defs/learnability_proof_currency"
        },
        "proof_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proof_fingerprint_token": {
          "$ref": "#/$defs/non_empty_string"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "certified_learnability_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "subject",
        "label_summary",
        "mirror_served",
        "certifications",
        "tour_steps_command_backed",
        "progress_user_owned_local_first",
        "educational_ai_cites_repository_truth",
        "offline_mirror_continuity_disclosed",
        "explain_separate_from_do",
        "experts_not_trapped_in_tutorials",
        "progress_private_to_user",
        "claimed_grade",
        "effective_grade",
        "evidence_refs",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "subject": {
          "$ref": "#/$defs/certified_learnability_subject"
        },
        "label_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_served": {
          "type": "boolean"
        },
        "certifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/learnability_dimension_certification"
          }
        },
        "tour_steps_command_backed": {
          "type": "boolean"
        },
        "progress_user_owned_local_first": {
          "type": "boolean"
        },
        "educational_ai_cites_repository_truth": {
          "type": "boolean"
        },
        "offline_mirror_continuity_disclosed": {
          "type": "boolean"
        },
        "explain_separate_from_do": {
          "type": "boolean"
        },
        "experts_not_trapped_in_tutorials": {
          "type": "boolean"
        },
        "progress_private_to_user": {
          "type": "boolean"
        },
        "claimed_grade": {
          "$ref": "#/$defs/learnability_certification_grade"
        },
        "effective_grade": {
          "$ref": "#/$defs/learnability_certification_grade"
        },
        "narrow_trigger": {
          "$ref": "#/$defs/learnability_narrow_trigger"
        },
        "narrowed_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tutorials_stay_command_backed_and_opt_in",
        "explain_and_do_stay_separate",
        "progress_user_owned_and_local_first",
        "cached_offline_packs_stay_explicit",
        "educational_ai_routes_through_preview_approval",
        "experts_never_trapped_in_tutorials",
        "rows_auto_narrow_without_current_proof"
      ],
      "properties": {
        "tutorials_stay_command_backed_and_opt_in": {
          "type": "boolean"
        },
        "explain_and_do_stay_separate": {
          "type": "boolean"
        },
        "progress_user_owned_and_local_first": {
          "type": "boolean"
        },
        "cached_offline_packs_stay_explicit": {
          "type": "boolean"
        },
        "educational_ai_routes_through_preview_approval": {
          "type": "boolean"
        },
        "experts_never_trapped_in_tutorials": {
          "type": "boolean"
        },
        "rows_auto_narrow_without_current_proof": {
          "type": "boolean"
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "help_about_ingests_certification",
        "docs_migration_ingests_certification",
        "support_export_ingests_certification",
        "release_center_ingests_certification",
        "start_center_ingests_certification",
        "ai_evidence_ingests_certification",
        "narrowed_rows_labeled_below_claim"
      ],
      "properties": {
        "help_about_ingests_certification": {
          "type": "boolean"
        },
        "docs_migration_ingests_certification": {
          "type": "boolean"
        },
        "support_export_ingests_certification": {
          "type": "boolean"
        },
        "release_center_ingests_certification": {
          "type": "boolean"
        },
        "start_center_ingests_certification": {
          "type": "boolean"
        },
        "ai_evidence_ingests_certification": {
          "type": "boolean"
        },
        "narrowed_rows_labeled_below_claim": {
          "type": "boolean"
        }
      }
    },
    "evidence_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_freshness_slo_hours",
        "last_evidence_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "evidence_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_evidence_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
