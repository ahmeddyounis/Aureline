{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/help/m5-public-handoff-matrix.schema.json",
  "title": "Aureline M5 post-install notice/provenance, community-handoff, reproduction-packet, and device-permission/auth-boundary matrix",
  "description": "Export-safe packet freezing the canonical M5 public-handoff and capture-boundary object model. The packet names every governed object — the post-install notice, the provenance disclosure, the community-handoff route, the reproduction packet, the offline-capture continuity record, the device-permission boundary, the embedded auth/webview boundary, and the service-health notice — and binds each to its qualification class, required fields, the controlled state vocabularies it carries, the concrete vocabulary tokens it admits, evidence requirements, the proof packet that keeps it current, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. A self-describing vocabulary set freezes the controlled vocabulary for provenance class, route trust class, capture permission state, redaction state, continuity state, boundary chrome-honesty, and notice freshness. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, raw diagnostics, private endpoints, credentials, and user text bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "object_rows",
    "vocabulary_set",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_public_handoff_and_capture_boundary_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_rows": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/object_row"
      }
    },
    "vocabulary_set": {
      "$ref": "#/$defs/vocabulary_set"
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "object_kind": {
      "type": "string",
      "enum": [
        "post_install_notice",
        "provenance_disclosure",
        "community_handoff_route",
        "reproduction_packet",
        "offline_capture_continuity",
        "device_permission_boundary",
        "embedded_auth_boundary",
        "service_health_notice"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "state_vocabulary": {
      "type": "string",
      "enum": [
        "provenance_class",
        "route_trust_class",
        "capture_permission_state",
        "redaction_state",
        "continuity_state",
        "boundary_chrome_honesty",
        "notice_freshness_state"
      ]
    },
    "provenance_class": {
      "type": "string",
      "enum": [
        "official",
        "mirrored",
        "side_loaded",
        "unknown"
      ]
    },
    "route_trust_class": {
      "type": "string",
      "enum": [
        "official",
        "community",
        "private",
        "local_only"
      ]
    },
    "capture_permission_state": {
      "type": "string",
      "enum": [
        "granted",
        "scope_limited",
        "not_requested",
        "denied",
        "revoked"
      ]
    },
    "redaction_state": {
      "type": "string",
      "enum": [
        "preview_required",
        "previewed_redacted",
        "no_sensitive_material",
        "unredacted_blocked"
      ]
    },
    "continuity_state": {
      "type": "string",
      "enum": [
        "ready_to_launch",
        "launch_failed_retained",
        "blocked_retained",
        "offline_saved_local"
      ]
    },
    "boundary_chrome_honesty": {
      "type": "string",
      "enum": [
        "native_trusted_chrome",
        "clearly_embedded",
        "labeled_external_surface",
        "unattributed_impersonation_blocked"
      ]
    },
    "notice_freshness_state": {
      "type": "string",
      "enum": [
        "proven_current",
        "cached",
        "warming",
        "stale",
        "unverified"
      ]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "optional",
        "not_applicable"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "notice_stale",
        "provenance_unverified",
        "route_visibility_undeclared",
        "redaction_preview_missing",
        "offline_continuity_lost",
        "capture_scope_exceeded",
        "native_chrome_impersonation",
        "policy_blocked",
        "proof_stale",
        "upstream_dependency_narrowed"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "notice_stays_inspectable_after_install",
        "provenance_labeled_never_implied",
        "route_declares_visibility_before_launch",
        "redaction_preview_required_before_share",
        "offline_capture_saved_local",
        "capture_stays_within_granted_scope",
        "boundary_never_impersonates_native_chrome",
        "not_applicable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "help_about",
        "marketplace",
        "update_service_health",
        "community_handoff",
        "reproduction_packet",
        "capture_auth_surface",
        "support_export",
        "docs",
        "release_notes",
        "product_ui"
      ]
    },
    "object_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_kind",
        "qualification",
        "owner_role",
        "scope_summary",
        "required_fields",
        "state_vocabularies",
        "provenance_classes",
        "route_trust_classes",
        "capture_permission_states",
        "redaction_states",
        "continuity_states",
        "boundary_chrome_states",
        "notice_freshness_states",
        "evidence_requirement",
        "required_proof_packet_refs",
        "downgrade_triggers",
        "rollback_posture",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "object_kind": {
          "$ref": "#/$defs/object_kind"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_fields": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "state_vocabularies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state_vocabulary"
          }
        },
        "provenance_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance_class"
          }
        },
        "route_trust_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route_trust_class"
          }
        },
        "capture_permission_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capture_permission_state"
          }
        },
        "redaction_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/redaction_state"
          }
        },
        "continuity_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/continuity_state"
          }
        },
        "boundary_chrome_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundary_chrome_honesty"
          }
        },
        "notice_freshness_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notice_freshness_state"
          }
        },
        "evidence_requirement": {
          "$ref": "#/$defs/evidence_requirement"
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_classes",
        "route_trust_classes",
        "capture_permission_states",
        "redaction_states",
        "continuity_states",
        "boundary_chrome_states",
        "notice_freshness_states"
      ],
      "properties": {
        "provenance_classes": {
          "type": "array",
          "const": [
            "official",
            "mirrored",
            "side_loaded",
            "unknown"
          ]
        },
        "route_trust_classes": {
          "type": "array",
          "const": [
            "official",
            "community",
            "private",
            "local_only"
          ]
        },
        "capture_permission_states": {
          "type": "array",
          "const": [
            "granted",
            "scope_limited",
            "not_requested",
            "denied",
            "revoked"
          ]
        },
        "redaction_states": {
          "type": "array",
          "const": [
            "preview_required",
            "previewed_redacted",
            "no_sensitive_material",
            "unredacted_blocked"
          ]
        },
        "continuity_states": {
          "type": "array",
          "const": [
            "ready_to_launch",
            "launch_failed_retained",
            "blocked_retained",
            "offline_saved_local"
          ]
        },
        "boundary_chrome_states": {
          "type": "array",
          "const": [
            "native_trusted_chrome",
            "clearly_embedded",
            "labeled_external_surface",
            "unattributed_impersonation_blocked"
          ]
        },
        "notice_freshness_states": {
          "type": "array",
          "const": [
            "proven_current",
            "cached",
            "warming",
            "stale",
            "unverified"
          ]
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_install_provenance_inspectable_after_install",
        "outbound_routes_declare_visibility_and_support_class_before_launch",
        "repro_packets_previewed_and_redacted_before_share",
        "offline_capture_survives_failed_handoff",
        "device_mic_auth_webview_never_impersonates_native_chrome",
        "provenance_states_distinguish_official_mirrored_side_loaded_unknown",
        "capture_stays_within_granted_permission_and_capability_limit",
        "one_handoff_object_model_not_parallel_dialogs",
        "no_new_community_programs_or_capture_modalities",
        "redaction_default_excludes_raw_sensitive_material",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "post_install_provenance_inspectable_after_install": {
          "type": "boolean",
          "const": true
        },
        "outbound_routes_declare_visibility_and_support_class_before_launch": {
          "type": "boolean",
          "const": true
        },
        "repro_packets_previewed_and_redacted_before_share": {
          "type": "boolean",
          "const": true
        },
        "offline_capture_survives_failed_handoff": {
          "type": "boolean",
          "const": true
        },
        "device_mic_auth_webview_never_impersonates_native_chrome": {
          "type": "boolean",
          "const": true
        },
        "provenance_states_distinguish_official_mirrored_side_loaded_unknown": {
          "type": "boolean",
          "const": true
        },
        "capture_stays_within_granted_permission_and_capability_limit": {
          "type": "boolean",
          "const": true
        },
        "one_handoff_object_model_not_parallel_dialogs": {
          "type": "boolean",
          "const": true
        },
        "no_new_community_programs_or_capture_modalities": {
          "type": "boolean",
          "const": true
        },
        "redaction_default_excludes_raw_sensitive_material": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "help_about_consumes_handoff_object_model",
        "marketplace_shows_provenance_class",
        "update_service_health_shows_route_trust_and_freshness",
        "community_handoff_declares_visibility_and_support_class",
        "repro_packets_show_redaction_preview",
        "capture_auth_surfaces_show_permission_and_chrome_boundary",
        "support_export_shows_handoff_object_model",
        "docs_show_provenance_and_redaction_truth",
        "release_notes_use_controlled_vocabulary",
        "preview_labs_label_for_unqualified_objects"
      ],
      "properties": {
        "help_about_consumes_handoff_object_model": {
          "type": "boolean",
          "const": true
        },
        "marketplace_shows_provenance_class": {
          "type": "boolean",
          "const": true
        },
        "update_service_health_shows_route_trust_and_freshness": {
          "type": "boolean",
          "const": true
        },
        "community_handoff_declares_visibility_and_support_class": {
          "type": "boolean",
          "const": true
        },
        "repro_packets_show_redaction_preview": {
          "type": "boolean",
          "const": true
        },
        "capture_auth_surfaces_show_permission_and_chrome_boundary": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_handoff_object_model": {
          "type": "boolean",
          "const": true
        },
        "docs_show_provenance_and_redaction_truth": {
          "type": "boolean",
          "const": true
        },
        "release_notes_use_controlled_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "preview_labs_label_for_unqualified_objects": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
