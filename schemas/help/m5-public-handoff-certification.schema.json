{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/help/m5-public-handoff-certification.schema.json",
  "title": "M5 public-handoff & capture-boundary certification packet",
  "description": "Capstone certification that ties the M5 post-install notice/provenance, community-handoff, reproduction-packet, and device-permission/auth-boundary surfaces into one certifiable boundary-truth story per governed object. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "build_identity_ref",
    "release_channel_class",
    "rows",
    "covered_object_kinds",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "stale_proof_causes",
    "blocking_findings",
    "report_clean",
    "public_truth_refs",
    "release_center_refs",
    "claim_publication_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "shell_m5_public_handoff_certification_packet_record" },
    "schema_version": { "type": "integer", "const": 1 },
    "shared_contract_ref": { "const": "shell:m5_public_handoff_certification:v1" },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_object_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectKind" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "stale_proof_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "public_truth_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "claim_publication_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "objectKind": {
      "type": "string",
      "enum": [
        "post_install_notice",
        "provenance_disclosure",
        "community_handoff_route",
        "reproduction_packet",
        "offline_capture_continuity",
        "device_permission_boundary",
        "embedded_auth_boundary",
        "service_health_notice"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "freshness": {
      "type": "string",
      "enum": ["proven_current", "cached", "warming", "stale", "unverified"]
    },
    "boundaryHonesty": {
      "type": "string",
      "enum": ["honestly_disclosed", "disclosed_gap", "undisclosed_impersonation"]
    },
    "redactionReadiness": {
      "type": "string",
      "enum": ["proven", "partial", "unsafe_material"]
    },
    "consumerSurface": {
      "type": "string",
      "enum": [
        "help_about",
        "marketplace",
        "update_service_health",
        "community_handoff",
        "reproduction_packet",
        "capture_auth_surface",
        "support_export",
        "docs",
        "release_notes",
        "product_ui"
      ]
    },
    "downgradeTrigger": {
      "type": "string",
      "enum": [
        "notice_stale",
        "provenance_unverified",
        "route_visibility_undeclared",
        "redaction_preview_missing",
        "offline_continuity_lost",
        "capture_scope_exceeded",
        "native_chrome_impersonation",
        "policy_blocked",
        "proof_stale",
        "upstream_dependency_narrowed"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "object_kind", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "object_kind": { "$ref": "#/$defs/objectKind" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_kind", "trigger", "disclosed", "detail"],
      "properties": {
        "object_kind": { "$ref": "#/$defs/objectKind" },
        "trigger": { "$ref": "#/$defs/downgradeTrigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "object_kind_missing",
            "row_missing_proof",
            "undisclosed_impersonation",
            "unsafe_redaction",
            "stale_proof_without_waiver",
            "unverified_proof_on_stable_row",
            "narrowed_row_without_reason",
            "narrowed_row_without_waiver",
            "waiver_object_mismatch",
            "waiver_expired",
            "row_status_stale",
            "row_causes_stale",
            "status_counts_stale",
            "coverage_stale",
            "raw_boundary_material_in_export"
          ]
        },
        "object_kind": { "type": "string" },
        "waiver_id": { "type": "string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_kind",
        "matrix_qualification",
        "owner_role",
        "certified_surface",
        "proof_packet_refs",
        "last_proof_refresh",
        "disclosure_freshness",
        "boundary_honesty",
        "redaction_readiness",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "stale_proof_causes",
        "narrowing_reason"
      ],
      "properties": {
        "object_kind": { "$ref": "#/$defs/objectKind" },
        "matrix_qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "certified_surface": { "type": "string", "minLength": 1 },
        "proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "disclosure_freshness": { "$ref": "#/$defs/freshness" },
        "boundary_honesty": { "$ref": "#/$defs/boundaryHonesty" },
        "redaction_readiness": { "$ref": "#/$defs/redactionReadiness" },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumerSurface" }
        },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgradeTrigger" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "stale_proof_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  }
}
