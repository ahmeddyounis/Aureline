{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/help/translated-doc-pack-parity.schema.json",
  "title": "Aureline M5 translated help-pack parity report",
  "description": "Cross-locale parity proof for the translated M5 help/docs/tour/auth/recovery/onboarding pack. For every claimed locale it records whether the rendered asset-id sequence matches the source pack, whether citation anchors and command ids survived translation, whether all stable refs and 'Open in source language' escape hatches were preserved, whether freshness-diverging rows render visibly distinct from live source, and whether escalation-critical auth/recovery routes survived. Carries no translated bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "report_id",
    "generated_at",
    "source_language_locale",
    "target_build_identity_ref",
    "pack_id_ref",
    "claimed_locales",
    "rows",
    "parity_clean"
  ],
  "properties": {
    "record_kind": { "const": "m5_translated_help_parity_report" },
    "schema_version": { "const": 1 },
    "report_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_language_locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "target_build_identity_ref": { "type": "string", "minLength": 1 },
    "pack_id_ref": { "type": "string", "minLength": 1 },
    "claimed_locales": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "text_direction",
          "rendered_row_count",
          "asset_id_set_matches_source",
          "translated_count",
          "source_fallback_count",
          "citation_faithful",
          "command_faithful",
          "all_refs_preserved",
          "all_escape_hatches_present",
          "stale_or_offline_distinct_from_live",
          "escalation_routes_preserved",
          "nontranslated_asset_ids"
        ],
        "properties": {
          "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "text_direction": { "enum": ["left_to_right", "right_to_left"] },
          "rendered_row_count": { "type": "integer", "minimum": 0 },
          "asset_id_set_matches_source": { "type": "boolean" },
          "translated_count": { "type": "integer", "minimum": 0 },
          "source_fallback_count": { "type": "integer", "minimum": 0 },
          "citation_faithful": { "type": "boolean" },
          "command_faithful": { "type": "boolean" },
          "all_refs_preserved": { "type": "boolean" },
          "all_escape_hatches_present": { "type": "boolean" },
          "stale_or_offline_distinct_from_live": { "type": "boolean" },
          "escalation_routes_preserved": { "type": "boolean" },
          "nontranslated_asset_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "parity_clean": { "type": "boolean" }
  }
}
