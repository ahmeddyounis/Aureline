{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/lifecycle/m5-resume-breadcrumbs.schema.json",
  "title": "Aureline M5 resume-breadcrumb certification packet",
  "description": "Partial-truth and resume-breadcrumb capstone on top of the frozen M5 lifecycle-state and journey-checkpoint matrix. For every one of the thirteen governed long-lived M5 object families the packet certifies that when a journey is degraded, resumed, restored, partially replayed, or blocked it distinguishes live truth, restored context, cached evidence, and a restart-required placeholder (the four provenance classes); preserves source class, actor/subsystem, host/boundary, and checkpoint lineage (the four lineage facets) instead of generic recovered wording; makes intentionally not-resumed and not-reauthorized actions explicit rather than silently absent; and preserves those breadcrumb truths through export, screenshot, and support-packet capture, across every declared consumer surface, with the same state-truth vocabulary surviving a headless or companion-adjacent execution. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the consumer-surface, provenance-class, and lineage-facet completeness checks are the lints that prevent a certification from regressing into a partial view that would let a restored, cached, or restart-required state be mistaken for live truth. Every family's driving journey, state machine, recovery affordance, checkpoint lineage, and applicable triggers are pulled from the frozen matrix, so this lane mints no parallel lifecycle vocabulary. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "object_state_schema_ref",
    "journey_checkpoint_schema_ref",
    "matrix_doc_ref",
    "state_object_inventory_ref",
    "state_class_recovery_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_breadcrumb_dimensions",
    "required_provenance_classes",
    "required_lineage_facets",
    "required_object_families",
    "rows",
    "covered_object_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "breadcrumb_causes",
    "blocking_findings",
    "report_clean",
    "lifecycle_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "lifecycle_m5_resume_breadcrumbs_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "object_state_schema_ref": { "type": "string", "minLength": 1 },
    "journey_checkpoint_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "state_object_inventory_ref": { "type": "string", "minLength": 1 },
    "state_class_recovery_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_breadcrumb_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/breadcrumb_dimension" }
    },
    "required_provenance_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenance_class" }
    },
    "required_lineage_facets": {
      "type": "array",
      "items": { "$ref": "#/$defs/lineage_facet" }
    },
    "required_object_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_family" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_object_families": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "breadcrumb_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "lifecycle_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_family": {
      "enum": [
        "workspace",
        "extension",
        "remote_session",
        "collaboration_session",
        "ai_action",
        "update_rollback",
        "notebook_runtime",
        "request_api_run",
        "preview_session",
        "pipeline_run",
        "data_session",
        "profiler_capture",
        "companion_session"
      ]
    },
    "breadcrumb_dimension": {
      "enum": [
        "provenance_labeling",
        "lineage_breadcrumb",
        "not_resumed_disclosure",
        "capture_parity"
      ]
    },
    "provenance_class": {
      "enum": [
        "live_truth",
        "restored_context",
        "cached_evidence",
        "restart_required_placeholder"
      ]
    },
    "lineage_facet": {
      "enum": ["source_class", "actor_subsystem", "host_boundary", "checkpoint_lineage"]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "critical_journey": {
      "enum": [
        "workspace_restore",
        "remote_reconnect",
        "extension_activation",
        "collaboration_join",
        "ai_action_run",
        "update_rollback_journey",
        "notebook_execution",
        "request_run",
        "preview_build",
        "pipeline_run_journey",
        "data_session_connect",
        "profiler_capture_journey",
        "companion_attach"
      ]
    },
    "consumer_surface": {
      "enum": [
        "product_ui",
        "cli",
        "docs_help",
        "diagnostics",
        "support_export",
        "telemetry",
        "claim_tooling",
        "release_notes"
      ]
    },
    "journey_checkpoint": {
      "enum": [
        "queued",
        "authorizing",
        "preparing",
        "connecting",
        "restoring",
        "building",
        "warming",
        "verifying",
        "finalizing",
        "ready",
        "partial_ready",
        "recoverable_failure"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "ready",
        "warming",
        "partial",
        "stale",
        "rebuilding",
        "restricted",
        "policy_blocked",
        "reconnecting",
        "degraded",
        "read_only_degraded",
        "unavailable",
        "rollback_available",
        "deprecated",
        "experimental",
        "retest_pending"
      ]
    },
    "last_failure_reason_class": { "type": "string", "minLength": 1 },
    "recovery_affordance": {
      "enum": [
        "retry_action",
        "reconnect_action",
        "rebuild_action",
        "restore_action",
        "rollback_action",
        "request_access_action",
        "retest_action",
        "reopen_read_only_action",
        "review_policy_action",
        "reinstall_action",
        "update_now_action",
        "contact_support_action"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "provenance_labeling": {
      "enum": [
        "provenance_class_labeled_on_every_surface",
        "disclosed_coarse_provenance_grouping",
        "provenance_class_ambiguous_or_missing"
      ]
    },
    "lineage_breadcrumb": {
      "enum": [
        "source_actor_boundary_checkpoint_preserved",
        "disclosed_partial_lineage_breadcrumb",
        "generic_recovered_wording_only"
      ]
    },
    "not_resumed_disclosure": {
      "enum": [
        "not_resumed_actions_explicit",
        "disclosed_grouped_not_resumed_summary",
        "not_resumed_actions_silently_absent"
      ]
    },
    "capture_parity": {
      "enum": [
        "breadcrumbs_captured_in_export_and_screenshot",
        "disclosed_partial_capture",
        "breadcrumbs_absent_from_capture"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "object_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "object_family": { "$ref": "#/$defs/object_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_family", "trigger", "disclosed", "detail"],
      "properties": {
        "object_family": { "$ref": "#/$defs/object_family" },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_family",
        "object_label",
        "matrix_journey",
        "qualification",
        "owner_role",
        "scope_summary",
        "admitted_states",
        "recovery_affordance",
        "last_failure_reason_classes",
        "checkpoint_lineage",
        "distinguished_provenance_classes",
        "preserved_lineage_facets",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "provenance_labeling",
        "lineage_breadcrumb",
        "not_resumed_disclosure",
        "capture_parity",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "breadcrumb_causes",
        "narrowing_reason"
      ],
      "properties": {
        "object_family": { "$ref": "#/$defs/object_family" },
        "object_label": { "type": "string", "minLength": 1 },
        "matrix_journey": { "$ref": "#/$defs/critical_journey" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "admitted_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_state" }
        },
        "recovery_affordance": { "$ref": "#/$defs/recovery_affordance" },
        "last_failure_reason_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/last_failure_reason_class" }
        },
        "checkpoint_lineage": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/journey_checkpoint" }
        },
        "distinguished_provenance_classes": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/provenance_class" }
        },
        "preserved_lineage_facets": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/lineage_facet" }
        },
        "required_consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "evaluated_consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "provenance_labeling": { "$ref": "#/$defs/provenance_labeling" },
        "lineage_breadcrumb": { "$ref": "#/$defs/lineage_breadcrumb" },
        "not_resumed_disclosure": { "$ref": "#/$defs/not_resumed_disclosure" },
        "capture_parity": { "$ref": "#/$defs/capture_parity" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "breadcrumb_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
