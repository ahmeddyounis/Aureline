{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/lifecycle/m5-object-state.schema.json",
  "title": "Aureline M5 lifecycle-state and critical-journey checkpoint matrix",
  "description": "Export-safe packet freezing Aureline's canonical M5 object-state model and its protected-journey checkpoint inventory. The packet names every long-lived object family — workspace, extension, remote session, collaboration session, AI action, update/rollback, notebook runtime, request/API run, preview session, pipeline run, data session, profiler capture, and companion session — and binds each to an explicit state machine drawn from one controlled state vocabulary, one visible primary status surface, one exportable status code, one controlled last-failure reason, and one named recovery affordance. The journey-checkpoint section names, for each protected journey, the ordered milestone checkpoints it shows instead of an anonymous spinner. A self-describing vocabulary set freezes the controlled vocabulary for lifecycle state, primary status surface, recovery affordance, last-failure reason class, and journey checkpoint. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, raw diagnostics, private endpoints, credentials, and user text bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "object_state_rows",
    "journey_checkpoint_rows",
    "vocabulary_set",
    "state_binding_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_lifecycle_state_and_journey_checkpoint_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_state_rows": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/object_state_row"
      }
    },
    "journey_checkpoint_rows": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "https://aureline.dev/schemas/lifecycle/m5-journey-checkpoint.schema.json"
      }
    },
    "vocabulary_set": {
      "$ref": "#/$defs/vocabulary_set"
    },
    "state_binding_review": {
      "$ref": "#/$defs/state_binding_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "object_family": {
      "type": "string",
      "enum": [
        "workspace",
        "extension",
        "remote_session",
        "collaboration_session",
        "ai_action",
        "update_rollback",
        "notebook_runtime",
        "request_api_run",
        "preview_session",
        "pipeline_run",
        "data_session",
        "profiler_capture",
        "companion_session"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "ready",
        "warming",
        "partial",
        "stale",
        "rebuilding",
        "restricted",
        "policy_blocked",
        "reconnecting",
        "degraded",
        "read_only_degraded",
        "unavailable",
        "rollback_available",
        "deprecated",
        "experimental",
        "retest_pending"
      ]
    },
    "primary_status_surface": {
      "type": "string",
      "enum": [
        "status_bar_indicator",
        "object_header_badge",
        "panel_header_status",
        "inline_action_status",
        "activity_center_row",
        "update_center_row",
        "remote_presence_indicator",
        "collaboration_presence_badge"
      ]
    },
    "recovery_affordance": {
      "type": "string",
      "enum": [
        "retry_action",
        "reconnect_action",
        "rebuild_action",
        "restore_action",
        "rollback_action",
        "request_access_action",
        "retest_action",
        "reopen_read_only_action",
        "review_policy_action",
        "reinstall_action",
        "update_now_action",
        "contact_support_action"
      ]
    },
    "last_failure_reason_class": {
      "type": "string",
      "enum": [
        "no_failure",
        "dependency_unavailable",
        "permission_denied",
        "policy_block",
        "connection_lost",
        "timeout_exceeded",
        "version_incompatible",
        "resource_exhausted",
        "integrity_check_failed",
        "upstream_degraded",
        "user_cancelled"
      ]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "optional",
        "not_applicable"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "state_vocabulary_drift",
        "status_surface_missing",
        "status_code_unexportable",
        "last_failure_reason_missing",
        "recovery_affordance_missing",
        "anonymous_checkpoint",
        "proof_stale",
        "policy_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "product_ui",
        "cli",
        "docs_help",
        "diagnostics",
        "support_export",
        "telemetry",
        "claim_tooling",
        "release_notes"
      ]
    },
    "object_state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "required_fields",
        "admitted_states",
        "primary_status_surface",
        "status_code_export_field",
        "last_failure_reason_field",
        "last_failure_reason_classes",
        "recovery_affordance",
        "evidence_requirement",
        "required_proof_packet_refs",
        "downgrade_triggers",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "object_family": {
          "$ref": "#/$defs/object_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_fields": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "admitted_states": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "ready"
          },
          "items": {
            "$ref": "#/$defs/lifecycle_state"
          }
        },
        "primary_status_surface": {
          "$ref": "#/$defs/primary_status_surface"
        },
        "status_code_export_field": {
          "$ref": "#/$defs/non_empty_string"
        },
        "last_failure_reason_field": {
          "$ref": "#/$defs/non_empty_string"
        },
        "last_failure_reason_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/last_failure_reason_class"
          }
        },
        "recovery_affordance": {
          "$ref": "#/$defs/recovery_affordance"
        },
        "evidence_requirement": {
          "$ref": "#/$defs/evidence_requirement"
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_states",
        "primary_status_surfaces",
        "recovery_affordances",
        "last_failure_reason_classes",
        "journey_checkpoints"
      ],
      "properties": {
        "lifecycle_states": {
          "type": "array",
          "const": [
            "ready",
            "warming",
            "partial",
            "stale",
            "rebuilding",
            "restricted",
            "policy_blocked",
            "reconnecting",
            "degraded",
            "read_only_degraded",
            "unavailable",
            "rollback_available",
            "deprecated",
            "experimental",
            "retest_pending"
          ]
        },
        "primary_status_surfaces": {
          "type": "array",
          "const": [
            "status_bar_indicator",
            "object_header_badge",
            "panel_header_status",
            "inline_action_status",
            "activity_center_row",
            "update_center_row",
            "remote_presence_indicator",
            "collaboration_presence_badge"
          ]
        },
        "recovery_affordances": {
          "type": "array",
          "const": [
            "retry_action",
            "reconnect_action",
            "rebuild_action",
            "restore_action",
            "rollback_action",
            "request_access_action",
            "retest_action",
            "reopen_read_only_action",
            "review_policy_action",
            "reinstall_action",
            "update_now_action",
            "contact_support_action"
          ]
        },
        "last_failure_reason_classes": {
          "type": "array",
          "const": [
            "no_failure",
            "dependency_unavailable",
            "permission_denied",
            "policy_block",
            "connection_lost",
            "timeout_exceeded",
            "version_incompatible",
            "resource_exhausted",
            "integrity_check_failed",
            "upstream_degraded",
            "user_cancelled"
          ]
        },
        "journey_checkpoints": {
          "type": "array",
          "const": [
            "queued",
            "authorizing",
            "preparing",
            "connecting",
            "restoring",
            "building",
            "warming",
            "verifying",
            "finalizing",
            "ready",
            "partial_ready",
            "recoverable_failure"
          ]
        }
      }
    },
    "state_binding_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_object_has_explicit_state_machine",
        "every_object_has_one_primary_status_surface",
        "every_object_has_one_exportable_status_code",
        "every_object_has_one_last_failure_reason",
        "every_object_has_one_named_recovery_affordance",
        "controlled_terms_shared_across_ui_cli_docs_support_telemetry",
        "protected_journeys_show_named_checkpoints",
        "ready_state_defined_for_every_object",
        "downgrade_narrows_instead_of_hides",
        "later_rows_cannot_invent_private_state_vocabulary"
      ],
      "properties": {
        "every_object_has_explicit_state_machine": {
          "type": "boolean",
          "const": true
        },
        "every_object_has_one_primary_status_surface": {
          "type": "boolean",
          "const": true
        },
        "every_object_has_one_exportable_status_code": {
          "type": "boolean",
          "const": true
        },
        "every_object_has_one_last_failure_reason": {
          "type": "boolean",
          "const": true
        },
        "every_object_has_one_named_recovery_affordance": {
          "type": "boolean",
          "const": true
        },
        "controlled_terms_shared_across_ui_cli_docs_support_telemetry": {
          "type": "boolean",
          "const": true
        },
        "protected_journeys_show_named_checkpoints": {
          "type": "boolean",
          "const": true
        },
        "ready_state_defined_for_every_object": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "later_rows_cannot_invent_private_state_vocabulary": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ui_consumes_lifecycle_matrix",
        "cli_shows_status_code",
        "docs_help_use_controlled_state_vocabulary",
        "diagnostics_show_last_failure_reason",
        "support_export_shows_object_state_model",
        "telemetry_uses_controlled_state_codes",
        "claim_tooling_reads_single_source",
        "release_notes_use_controlled_vocabulary"
      ],
      "properties": {
        "product_ui_consumes_lifecycle_matrix": {
          "type": "boolean",
          "const": true
        },
        "cli_shows_status_code": {
          "type": "boolean",
          "const": true
        },
        "docs_help_use_controlled_state_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_show_last_failure_reason": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_object_state_model": {
          "type": "boolean",
          "const": true
        },
        "telemetry_uses_controlled_state_codes": {
          "type": "boolean",
          "const": true
        },
        "claim_tooling_reads_single_source": {
          "type": "boolean",
          "const": true
        },
        "release_notes_use_controlled_vocabulary": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "recovery_drill_packet_ref",
        "support_export_parity_required",
        "telemetry_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "recovery_drill_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "telemetry_parity_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
