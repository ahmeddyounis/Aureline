{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/lifecycle/m5-critical-journey-checkpoints.schema.json",
  "title": "Aureline M5 critical-journey checkpoint certification packet",
  "description": "Critical-journey checkpoint capstone on top of the frozen M5 lifecycle-state and journey-checkpoint matrix. For each of the five highest-value M5 journeys the spec protects by name — warm startup, large-repo open, AI multi-file apply, remote attach-and-run, and collaboration join-follow — the packet certifies that the journey exposes visible milestone checkpoints (drawn from the frozen journey-checkpoint vocabulary) instead of one anonymous spinner, keeps any partial or degraded behavior labeled and attributable, keeps the user's place and a next-safe-action, and preserves its checkpoint truths through export, screenshot, and support-packet capture, across every declared consumer surface, and that the same state-truth vocabulary survives a headless or companion-adjacent execution. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the consumer-surface and checkpoint-sequence completeness checks are the lints that prevent a certification from regressing into a partial view that would let a protected flow hide a half-ready or maybe-applied state behind one generic spinner. Every journey's driving object family, state machine, recovery affordance, and applicable triggers are pulled from the frozen matrix, so this lane mints no parallel lifecycle vocabulary. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "object_state_schema_ref",
    "journey_checkpoint_schema_ref",
    "matrix_doc_ref",
    "state_object_inventory_ref",
    "state_class_recovery_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_journey_dimensions",
    "required_protected_journeys",
    "rows",
    "covered_protected_journeys",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "journey_causes",
    "blocking_findings",
    "report_clean",
    "lifecycle_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "lifecycle_m5_critical_journey_checkpoints_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "object_state_schema_ref": { "type": "string", "minLength": 1 },
    "journey_checkpoint_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "state_object_inventory_ref": { "type": "string", "minLength": 1 },
    "state_class_recovery_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_journey_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/journey_dimension" }
    },
    "required_protected_journeys": {
      "type": "array",
      "items": { "$ref": "#/$defs/protected_journey" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_protected_journeys": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "journey_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "lifecycle_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "protected_journey": {
      "enum": [
        "warm_startup",
        "large_repo_open",
        "ai_multi_file_apply",
        "remote_attach_run",
        "collaboration_join_follow"
      ]
    },
    "journey_dimension": {
      "enum": [
        "checkpoint_visibility",
        "partial_truth_labeling",
        "place_continuity",
        "capture_parity"
      ]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "object_family": {
      "enum": [
        "workspace",
        "extension",
        "remote_session",
        "collaboration_session",
        "ai_action",
        "update_rollback",
        "notebook_runtime",
        "request_api_run",
        "preview_session",
        "pipeline_run",
        "data_session",
        "profiler_capture",
        "companion_session"
      ]
    },
    "critical_journey": {
      "enum": [
        "workspace_restore",
        "remote_reconnect",
        "extension_activation",
        "collaboration_join",
        "ai_action_run",
        "update_rollback_journey",
        "notebook_execution",
        "request_run",
        "preview_build",
        "pipeline_run_journey",
        "data_session_connect",
        "profiler_capture_journey",
        "companion_attach"
      ]
    },
    "consumer_surface": {
      "enum": [
        "product_ui",
        "cli",
        "docs_help",
        "diagnostics",
        "support_export",
        "telemetry",
        "claim_tooling",
        "release_notes"
      ]
    },
    "journey_checkpoint": {
      "enum": [
        "queued",
        "authorizing",
        "preparing",
        "connecting",
        "restoring",
        "building",
        "warming",
        "verifying",
        "finalizing",
        "ready",
        "partial_ready",
        "recoverable_failure"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "ready",
        "warming",
        "partial",
        "stale",
        "rebuilding",
        "restricted",
        "policy_blocked",
        "reconnecting",
        "degraded",
        "read_only_degraded",
        "unavailable",
        "rollback_available",
        "deprecated",
        "experimental",
        "retest_pending"
      ]
    },
    "last_failure_reason_class": { "type": "string", "minLength": 1 },
    "recovery_affordance": {
      "enum": [
        "retry_action",
        "reconnect_action",
        "rebuild_action",
        "restore_action",
        "rollback_action",
        "request_access_action",
        "retest_action",
        "reopen_read_only_action",
        "review_policy_action",
        "reinstall_action",
        "update_now_action",
        "contact_support_action"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "checkpoint_visibility": {
      "enum": [
        "named_milestones_replace_spinner",
        "disclosed_compacted_milestones",
        "anonymous_spinner_shown"
      ]
    },
    "partial_truth_labeling": {
      "enum": [
        "partial_state_labeled_and_attributed",
        "disclosed_coarse_partial_label",
        "partial_state_unlabeled_or_unattributed"
      ]
    },
    "place_continuity": {
      "enum": [
        "place_and_next_action_preserved",
        "disclosed_reduced_next_action",
        "place_or_recovery_lost"
      ]
    },
    "capture_parity": {
      "enum": [
        "checkpoints_captured_in_export_and_screenshot",
        "disclosed_partial_capture",
        "checkpoints_absent_from_capture"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "journey", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "journey": { "$ref": "#/$defs/protected_journey" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey", "trigger", "disclosed", "detail"],
      "properties": {
        "journey": { "$ref": "#/$defs/protected_journey" },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journey",
        "journey_label",
        "object_family",
        "matrix_journey",
        "qualification",
        "owner_role",
        "scope_summary",
        "admitted_states",
        "success_state",
        "recovery_affordance",
        "last_failure_reason_classes",
        "checkpoint_sequence",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "checkpoint_visibility",
        "partial_truth_labeling",
        "place_continuity",
        "capture_parity",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "journey_causes",
        "narrowing_reason"
      ],
      "properties": {
        "journey": { "$ref": "#/$defs/protected_journey" },
        "journey_label": { "type": "string", "minLength": 1 },
        "object_family": { "$ref": "#/$defs/object_family" },
        "matrix_journey": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/critical_journey" }]
        },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "admitted_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_state" }
        },
        "success_state": { "$ref": "#/$defs/lifecycle_state" },
        "recovery_affordance": { "$ref": "#/$defs/recovery_affordance" },
        "last_failure_reason_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/last_failure_reason_class" }
        },
        "checkpoint_sequence": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/journey_checkpoint" }
        },
        "required_consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "evaluated_consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "checkpoint_visibility": { "$ref": "#/$defs/checkpoint_visibility" },
        "partial_truth_labeling": { "$ref": "#/$defs/partial_truth_labeling" },
        "place_continuity": { "$ref": "#/$defs/place_continuity" },
        "capture_parity": { "$ref": "#/$defs/capture_parity" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "journey_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
