{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/lifecycle/m5-journey-checkpoint.schema.json",
  "title": "Aureline M5 critical-journey checkpoint row",
  "description": "One protected critical journey and the ordered milestone checkpoints it shows instead of an anonymous spinner. Each journey names its driving object family, at least two unique checkpoints ending in a terminal milestone (ready, partial_ready, or recoverable_failure), the success terminal state, the named recovery affordance offered on a recoverable failure, and the controlled last-failure reason classes it reports. The checkpoint and reason vocabularies are frozen by the M5 object-state matrix so support, automation, docs, and telemetry share one checkpoint language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey",
    "object_family",
    "owner_role",
    "scope_summary",
    "checkpoints",
    "shows_named_checkpoints",
    "success_state",
    "recovery_affordance",
    "last_failure_reason_classes",
    "source_contract_refs"
  ],
  "properties": {
    "journey": {
      "$ref": "#/$defs/critical_journey"
    },
    "object_family": {
      "$ref": "#/$defs/object_family"
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "checkpoints": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/journey_checkpoint"
      }
    },
    "shows_named_checkpoints": {
      "type": "boolean",
      "const": true
    },
    "success_state": {
      "$ref": "#/$defs/lifecycle_state"
    },
    "recovery_affordance": {
      "$ref": "#/$defs/recovery_affordance"
    },
    "last_failure_reason_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/last_failure_reason_class"
      }
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "critical_journey": {
      "type": "string",
      "enum": [
        "workspace_restore",
        "remote_reconnect",
        "extension_activation",
        "collaboration_join",
        "ai_action_run",
        "update_rollback_journey",
        "notebook_execution",
        "request_run",
        "preview_build",
        "pipeline_run_journey",
        "data_session_connect",
        "profiler_capture_journey",
        "companion_attach"
      ]
    },
    "object_family": {
      "type": "string",
      "enum": [
        "workspace",
        "extension",
        "remote_session",
        "collaboration_session",
        "ai_action",
        "update_rollback",
        "notebook_runtime",
        "request_api_run",
        "preview_session",
        "pipeline_run",
        "data_session",
        "profiler_capture",
        "companion_session"
      ]
    },
    "journey_checkpoint": {
      "type": "string",
      "enum": [
        "queued",
        "authorizing",
        "preparing",
        "connecting",
        "restoring",
        "building",
        "warming",
        "verifying",
        "finalizing",
        "ready",
        "partial_ready",
        "recoverable_failure"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "ready",
        "warming",
        "partial",
        "stale",
        "rebuilding",
        "restricted",
        "policy_blocked",
        "reconnecting",
        "degraded",
        "read_only_degraded",
        "unavailable",
        "rollback_available",
        "deprecated",
        "experimental",
        "retest_pending"
      ]
    },
    "recovery_affordance": {
      "type": "string",
      "enum": [
        "retry_action",
        "reconnect_action",
        "rebuild_action",
        "restore_action",
        "rollback_action",
        "request_access_action",
        "retest_action",
        "reopen_read_only_action",
        "review_policy_action",
        "reinstall_action",
        "update_now_action",
        "contact_support_action"
      ]
    },
    "last_failure_reason_class": {
      "type": "string",
      "enum": [
        "no_failure",
        "dependency_unavailable",
        "permission_denied",
        "policy_block",
        "connection_lost",
        "timeout_exceeded",
        "version_incompatible",
        "resource_exhausted",
        "integrity_check_failed",
        "upstream_degraded",
        "user_cancelled"
      ]
    }
  }
}
