{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/lifecycle/m5-lifecycle-telemetry-conformance.schema.json",
  "title": "Aureline M5 lifecycle-telemetry-conformance certification packet",
  "description": "Lifecycle-telemetry emission and export-parity conformance capstone on top of the frozen M5 lifecycle-state and journey-checkpoint matrix. For every one of the thirteen governed long-lived M5 object families the packet certifies that the same controlled lifecycle vocabulary survives the machine paths: the object emits its stable lifecycle and checkpoint enums into all four telemetry sinks (telemetry, structured logs, dashboards, and support exports); it emits controlled transition events attributed to a controlled actor or subsystem; its UI and export paths agree on lifecycle naming and the three mandatory fields (last-failure reason, recovery affordance, and checkpoint boundary); and Support Center, diagnostics, and claim-publication tooling consume the one shared contract rather than local prose, across every declared consumer surface, with the same state-truth vocabulary surviving a headless or companion-adjacent execution. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the consumer-surface, telemetry-sink, and mandatory-field completeness checks are the conformance lints that fail when a surface diverges from the controlled state vocabulary or skips a mandatory field. Every family's driving journey, state machine, primary status surface, status-code export field, last-failure-reason field, recovery affordance, checkpoint lineage, and applicable triggers are pulled from the frozen matrix, so this lane mints no parallel lifecycle vocabulary. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "object_state_schema_ref",
    "journey_checkpoint_schema_ref",
    "matrix_doc_ref",
    "state_object_inventory_ref",
    "state_class_recovery_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_telemetry_dimensions",
    "required_telemetry_sinks",
    "required_mandatory_fields",
    "required_object_families",
    "rows",
    "covered_object_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "conformance_causes",
    "blocking_findings",
    "report_clean",
    "lifecycle_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "lifecycle_m5_lifecycle_telemetry_conformance_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "object_state_schema_ref": { "type": "string", "minLength": 1 },
    "journey_checkpoint_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "state_object_inventory_ref": { "type": "string", "minLength": 1 },
    "state_class_recovery_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_telemetry_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/telemetry_dimension" }
    },
    "required_telemetry_sinks": {
      "type": "array",
      "items": { "$ref": "#/$defs/telemetry_sink" }
    },
    "required_mandatory_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/mandatory_field" }
    },
    "required_object_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_family" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_object_families": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "conformance_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "lifecycle_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_family": {
      "enum": [
        "workspace",
        "extension",
        "remote_session",
        "collaboration_session",
        "ai_action",
        "update_rollback",
        "notebook_runtime",
        "request_api_run",
        "preview_session",
        "pipeline_run",
        "data_session",
        "profiler_capture",
        "companion_session"
      ]
    },
    "telemetry_dimension": {
      "enum": [
        "enum_emission",
        "transition_event",
        "ui_export_parity",
        "shared_contract_consumption"
      ]
    },
    "telemetry_sink": {
      "enum": ["telemetry", "structured_logs", "dashboards", "support_exports"]
    },
    "mandatory_field": {
      "enum": ["last_failure_reason", "recovery_affordance", "checkpoint_boundary"]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "critical_journey": {
      "enum": [
        "workspace_restore",
        "remote_reconnect",
        "extension_activation",
        "collaboration_join",
        "ai_action_run",
        "update_rollback_journey",
        "notebook_execution",
        "request_run",
        "preview_build",
        "pipeline_run_journey",
        "data_session_connect",
        "profiler_capture_journey",
        "companion_attach"
      ]
    },
    "consumer_surface": {
      "enum": [
        "product_ui",
        "cli",
        "docs_help",
        "diagnostics",
        "support_export",
        "telemetry",
        "claim_tooling",
        "release_notes"
      ]
    },
    "journey_checkpoint": {
      "enum": [
        "queued",
        "authorizing",
        "preparing",
        "connecting",
        "restoring",
        "building",
        "warming",
        "verifying",
        "finalizing",
        "ready",
        "partial_ready",
        "recoverable_failure"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "ready",
        "warming",
        "partial",
        "stale",
        "rebuilding",
        "restricted",
        "policy_blocked",
        "reconnecting",
        "degraded",
        "read_only_degraded",
        "unavailable",
        "rollback_available",
        "deprecated",
        "experimental",
        "retest_pending"
      ]
    },
    "primary_status_surface": {
      "enum": [
        "status_bar_indicator",
        "object_header_badge",
        "panel_header_status",
        "inline_action_status",
        "activity_center_row",
        "update_center_row",
        "remote_presence_indicator",
        "collaboration_presence_badge"
      ]
    },
    "last_failure_reason_class": { "type": "string", "minLength": 1 },
    "recovery_affordance": {
      "enum": [
        "retry_action",
        "reconnect_action",
        "rebuild_action",
        "restore_action",
        "rollback_action",
        "request_access_action",
        "retest_action",
        "reopen_read_only_action",
        "review_policy_action",
        "reinstall_action",
        "update_now_action",
        "contact_support_action"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "enum_emission": {
      "enum": [
        "stable_enums_emitted_to_every_sink",
        "disclosed_reduced_enum_sink_set",
        "enums_absent_or_local_prose_emitted"
      ]
    },
    "transition_event": {
      "enum": [
        "transition_events_emitted_with_attribution",
        "disclosed_coarse_transition_events",
        "transition_events_missing_or_anonymous"
      ]
    },
    "ui_export_parity": {
      "enum": [
        "ui_and_export_naming_and_fields_agree",
        "disclosed_export_field_narrowing",
        "ui_export_lifecycle_naming_or_fields_drifted"
      ]
    },
    "shared_contract_consumption": {
      "enum": [
        "shared_contract_consumed_no_local_prose",
        "disclosed_partial_contract_adoption",
        "local_prose_replaces_shared_contract"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "object_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "object_family": { "$ref": "#/$defs/object_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_family", "trigger", "disclosed", "detail"],
      "properties": {
        "object_family": { "$ref": "#/$defs/object_family" },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_family",
        "object_label",
        "matrix_journey",
        "qualification",
        "owner_role",
        "scope_summary",
        "admitted_states",
        "primary_status_surface",
        "status_code_export_field",
        "last_failure_reason_field",
        "recovery_affordance",
        "last_failure_reason_classes",
        "checkpoint_lineage",
        "emitted_telemetry_sinks",
        "conformant_mandatory_fields",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "enum_emission",
        "transition_event",
        "ui_export_parity",
        "shared_contract_consumption",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "conformance_causes",
        "narrowing_reason"
      ],
      "properties": {
        "object_family": { "$ref": "#/$defs/object_family" },
        "object_label": { "type": "string", "minLength": 1 },
        "matrix_journey": { "$ref": "#/$defs/critical_journey" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "admitted_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_state" }
        },
        "primary_status_surface": { "$ref": "#/$defs/primary_status_surface" },
        "status_code_export_field": { "type": "string", "minLength": 1 },
        "last_failure_reason_field": { "type": "string", "minLength": 1 },
        "recovery_affordance": { "$ref": "#/$defs/recovery_affordance" },
        "last_failure_reason_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/last_failure_reason_class" }
        },
        "checkpoint_lineage": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/journey_checkpoint" }
        },
        "emitted_telemetry_sinks": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/telemetry_sink" }
        },
        "conformant_mandatory_fields": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/mandatory_field" }
        },
        "required_consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "evaluated_consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "enum_emission": { "$ref": "#/$defs/enum_emission" },
        "transition_event": { "$ref": "#/$defs/transition_event" },
        "ui_export_parity": { "$ref": "#/$defs/ui_export_parity" },
        "shared_contract_consumption": { "$ref": "#/$defs/shared_contract_consumption" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "conformance_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
