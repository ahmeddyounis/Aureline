{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/lifecycle/m5-lifecycle-release-proof.schema.json",
  "title": "Aureline M5 lifecycle release proof packet",
  "description": "Release-grade lifecycle-state, checkpoint, and recovery-affordance truth proof on top of the frozen M5 lifecycle-state and journey-checkpoint matrix. For every governed long-lived M5 object family — the workspace, extension, remote session, collaboration session, AI action, update/rollback, notebook runtime, request/API run, preview session, pipeline run, data session, profiler capture, and companion session — the packet certifies that the object keeps its explicit lifecycle-state truth (not collapsed into generic loading/error behavior), its named milestone checkpoint truth (not collapsed into an anonymous spinner), and its named recovery-affordance and controlled last-failure-reason truth, across all six claimed M5 desktop profiles and every exported truth surface — UI, CLI/headless, docs/help, diagnostics, support exports, telemetry, and claim publication — with the same state-truth vocabulary preserved in headless and companion-adjacent execution. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted: a family that collapses its state into generic loading/error behavior, collapses its checkpoints into an anonymous spinner, drops its recovery affordance or reason, lets an exported truth surface go stale or divergent, loses headless parity, fails to certify across all six claimed desktop profiles, fails to keep all three truth pillars, or fails to certify every declared consumer surface is automatically narrowed or blocked from stable promotion. Every object binding is pulled from the frozen matrix, so this lane mints no parallel lifecycle vocabulary. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "object_state_schema_ref",
    "journey_checkpoint_schema_ref",
    "matrix_doc_ref",
    "state_object_inventory_ref",
    "state_class_recovery_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_profiles",
    "required_truth_pillars",
    "required_object_families",
    "rows",
    "covered_object_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "conformance_causes",
    "blocking_findings",
    "report_clean",
    "lifecycle_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": {
      "const": "lifecycle_m5_lifecycle_release_proof_packet_record"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "object_state_schema_ref": { "type": "string", "minLength": 1 },
    "journey_checkpoint_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "state_object_inventory_ref": { "type": "string", "minLength": 1 },
    "state_class_recovery_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_proof_dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "lifecycle_state_truth",
          "checkpoint_truth",
          "recovery_affordance_truth",
          "exported_proof_parity"
        ]
      }
    },
    "required_profiles": {
      "type": "array",
      "items": {
        "enum": [
          "compact_desktop",
          "standard_desktop",
          "expanded_desktop",
          "mixed_dpi",
          "multi_monitor",
          "dependency_missing_restore"
        ]
      }
    },
    "required_truth_pillars": {
      "type": "array",
      "items": {
        "enum": ["lifecycle_state", "checkpoint", "recovery_affordance"]
      }
    },
    "required_object_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_family" }
    },
    "rows": {
      "type": "array",
      "minItems": 13,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_object_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_family" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "conformance_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": { "type": "array" },
    "report_clean": { "type": "boolean" },
    "lifecycle_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_family": {
      "enum": [
        "workspace",
        "extension",
        "remote_session",
        "collaboration_session",
        "ai_action",
        "update_rollback",
        "notebook_runtime",
        "request_api_run",
        "preview_session",
        "pipeline_run",
        "data_session",
        "profiler_capture",
        "companion_session"
      ]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "lifecycle_state_truth": {
      "enum": [
        "explicit_state_truth_certified",
        "disclosed_reduced_state_truth",
        "state_collapsed_into_generic_loading_or_error"
      ]
    },
    "checkpoint_truth": {
      "enum": [
        "named_checkpoint_truth_certified",
        "disclosed_compacted_checkpoint_truth",
        "checkpoints_collapsed_to_anonymous_spinner"
      ]
    },
    "recovery_affordance_truth": {
      "enum": [
        "named_recovery_and_reason_certified",
        "disclosed_reduced_recovery_truth",
        "recovery_or_reason_truth_missing"
      ]
    },
    "exported_proof_parity": {
      "enum": [
        "exported_surfaces_reflect_current_proof",
        "disclosed_partial_export_refresh",
        "exported_proof_stale_or_divergent"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "object_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "object_family": { "$ref": "#/$defs/object_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_family", "trigger", "disclosed", "detail"],
      "properties": {
        "object_family": { "$ref": "#/$defs/object_family" },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_family",
        "object_label",
        "matrix_journey",
        "qualification",
        "owner_role",
        "scope_summary",
        "admitted_states",
        "primary_status_surface",
        "status_code_export_field",
        "last_failure_reason_field",
        "recovery_affordance",
        "last_failure_reason_classes",
        "checkpoint_lineage",
        "certified_profiles",
        "certified_truth_pillars",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "lifecycle_state_truth",
        "checkpoint_truth",
        "recovery_affordance_truth",
        "exported_proof_parity",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "conformance_causes",
        "narrowing_reason"
      ],
      "properties": {
        "object_family": { "$ref": "#/$defs/object_family" },
        "object_label": { "type": "string", "minLength": 1 },
        "matrix_journey": { "type": "string" },
        "qualification": { "type": "string" },
        "owner_role": { "type": "string" },
        "scope_summary": { "type": "string", "minLength": 1 },
        "admitted_states": { "type": "array", "items": { "type": "string" } },
        "primary_status_surface": { "type": "string" },
        "status_code_export_field": { "type": "string" },
        "last_failure_reason_field": { "type": "string" },
        "recovery_affordance": { "type": "string" },
        "last_failure_reason_classes": { "type": "array", "items": { "type": "string" } },
        "checkpoint_lineage": { "type": "array", "items": { "type": "string" } },
        "certified_profiles": {
          "type": "array",
          "items": { "$ref": "#/properties/required_profiles/items" }
        },
        "certified_truth_pillars": {
          "type": "array",
          "items": { "$ref": "#/properties/required_truth_pillars/items" }
        },
        "required_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "evaluated_consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "lifecycle_state_truth": { "$ref": "#/$defs/lifecycle_state_truth" },
        "checkpoint_truth": { "$ref": "#/$defs/checkpoint_truth" },
        "recovery_affordance_truth": { "$ref": "#/$defs/recovery_affordance_truth" },
        "exported_proof_parity": { "$ref": "#/$defs/exported_proof_parity" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "conformance_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
