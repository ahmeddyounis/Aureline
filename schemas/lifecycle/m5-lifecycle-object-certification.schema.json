{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/lifecycle/m5-lifecycle-object-certification.schema.json",
  "title": "Aureline M5 lifecycle-object certification packet",
  "description": "Lifecycle-object capstone on top of the frozen M5 lifecycle-state and journey-checkpoint matrix. For every governed long-lived M5 object family — the workspace, extension, remote session, collaboration session, AI action, update/rollback, notebook runtime, request/API run, preview session, pipeline run, data session, profiler capture, and companion session — the packet certifies that the object binds its state to one visible primary status surface, exports one stable status code, reports one controlled last-failure reason, and surfaces one named recovery affordance across every declared consumer surface, and that the same state-truth vocabulary survives a headless or companion-adjacent execution. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the consumer-surface completeness check is the lint that prevents a certification from regressing into a partial view that would force support and diagnostics back onto surface-specific heuristics. Every object binding is pulled from the frozen matrix, so this lane mints no parallel lifecycle vocabulary. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "object_state_schema_ref",
    "journey_checkpoint_schema_ref",
    "matrix_doc_ref",
    "state_object_inventory_ref",
    "state_class_recovery_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_bindings",
    "required_object_families",
    "rows",
    "covered_object_families",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "object_causes",
    "blocking_findings",
    "report_clean",
    "lifecycle_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "lifecycle_m5_lifecycle_object_certification_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "object_state_schema_ref": { "type": "string", "minLength": 1 },
    "journey_checkpoint_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "state_object_inventory_ref": { "type": "string", "minLength": 1 },
    "state_class_recovery_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "required_object_families": { "type": "array", "items": { "$ref": "#/$defs/object_family" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_object_families": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "object_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "lifecycle_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "object_family": {
      "enum": [
        "workspace",
        "extension",
        "remote_session",
        "collaboration_session",
        "ai_action",
        "update_rollback",
        "notebook_runtime",
        "request_api_run",
        "preview_session",
        "pipeline_run",
        "data_session",
        "profiler_capture",
        "companion_session"
      ]
    },
    "binding": {
      "enum": [
        "primary_status_surface",
        "exportable_status_code",
        "last_failure_reason",
        "named_recovery_affordance"
      ]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "consumer_surface": {
      "enum": [
        "product_ui",
        "cli",
        "docs_help",
        "diagnostics",
        "support_export",
        "telemetry",
        "claim_tooling",
        "release_notes"
      ]
    },
    "primary_status_surface": {
      "enum": [
        "status_bar_indicator",
        "object_header_badge",
        "panel_header_status",
        "inline_action_status",
        "activity_center_row",
        "update_center_row",
        "remote_presence_indicator",
        "collaboration_presence_badge"
      ]
    },
    "recovery_affordance": {
      "enum": [
        "retry_action",
        "reconnect_action",
        "rebuild_action",
        "restore_action",
        "rollback_action",
        "request_access_action",
        "retest_action",
        "reopen_read_only_action",
        "review_policy_action",
        "reinstall_action",
        "update_now_action",
        "contact_support_action"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "status_surface_binding": {
      "enum": [
        "bound_to_one_primary_surface",
        "disclosed_surface_relocation",
        "status_surface_missing_or_split"
      ]
    },
    "status_code_export": {
      "enum": [
        "stable_code_exports_everywhere",
        "disclosed_partial_export",
        "status_code_unexportable"
      ]
    },
    "last_failure_reason": {
      "enum": [
        "controlled_reason_reported",
        "disclosed_generic_reason",
        "last_failure_reason_missing_or_raw"
      ]
    },
    "recovery_affordance_binding": {
      "enum": [
        "named_recovery_present",
        "disclosed_reduced_recovery",
        "recovery_affordance_missing"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "object_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "object_family": { "$ref": "#/$defs/object_family" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_family", "trigger", "disclosed", "detail"],
      "properties": {
        "object_family": { "$ref": "#/$defs/object_family" },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_family",
        "object_label",
        "qualification",
        "owner_role",
        "scope_summary",
        "primary_status_surface",
        "status_code_export_field",
        "last_failure_reason_field",
        "recovery_affordance",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "status_surface_binding",
        "status_code_export",
        "last_failure_reason",
        "recovery_affordance_binding",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "object_causes",
        "narrowing_reason"
      ],
      "properties": {
        "object_family": { "$ref": "#/$defs/object_family" },
        "object_label": { "type": "string", "minLength": 1 },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "primary_status_surface": { "$ref": "#/$defs/primary_status_surface" },
        "status_code_export_field": { "type": "string", "minLength": 1 },
        "last_failure_reason_field": { "type": "string", "minLength": 1 },
        "recovery_affordance": { "$ref": "#/$defs/recovery_affordance" },
        "required_consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "evaluated_consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "status_surface_binding": { "$ref": "#/$defs/status_surface_binding" },
        "status_code_export": { "$ref": "#/$defs/status_code_export" },
        "last_failure_reason": { "$ref": "#/$defs/last_failure_reason" },
        "recovery_affordance_binding": { "$ref": "#/$defs/recovery_affordance_binding" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "object_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
