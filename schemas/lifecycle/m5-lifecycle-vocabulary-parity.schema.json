{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/lifecycle/m5-lifecycle-vocabulary-parity.schema.json",
  "title": "Aureline M5 lifecycle-vocabulary parity packet",
  "description": "Controlled-lifecycle-vocabulary parity capstone on top of the frozen M5 lifecycle-state and journey-checkpoint matrix. For every controlled lifecycle-state term — ready, warming, partial, stale, rebuilding, restricted, policy_blocked, reconnecting, degraded, read_only_degraded, unavailable, rollback_available, deprecated, experimental, and retest_pending — the packet certifies that the term keeps one meaning across every consumer surface (product UI, CLI/headless, docs/help, diagnostics, support exports, telemetry, claim tooling, release notes), stays semantically distinct rather than collapsing into a generic failure, exports one stable status code identically on every export path, and narrows its published release/docs/help copy automatically when evidence or support state changes, and that the same state-truth vocabulary survives a headless or companion-adjacent execution. Each row's green/yellow/red status is the derived auto-narrowed value, never asserted; the consumer-surface completeness check is the lint that prevents a certification from regressing into a partial view where one surface still uses legacy or vague wording. Every term grounding is pulled from the frozen matrix, so this lane mints no parallel lifecycle vocabulary. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "object_state_schema_ref",
    "journey_checkpoint_schema_ref",
    "matrix_doc_ref",
    "state_object_inventory_ref",
    "state_class_recovery_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_parity_dimensions",
    "required_states",
    "required_consumer_surfaces",
    "rows",
    "covered_states",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "term_causes",
    "blocking_findings",
    "report_clean",
    "lifecycle_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": { "const": "lifecycle_m5_lifecycle_vocabulary_parity_packet_record" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "shared_contract_ref": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_schema_ref": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "matrix_packet_ref": { "type": "string", "minLength": 1 },
    "object_state_schema_ref": { "type": "string", "minLength": 1 },
    "journey_checkpoint_schema_ref": { "type": "string", "minLength": 1 },
    "matrix_doc_ref": { "type": "string", "minLength": 1 },
    "state_object_inventory_ref": { "type": "string", "minLength": 1 },
    "state_class_recovery_ref": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "release_channel_class": { "type": "string", "minLength": 1 },
    "required_parity_dimensions": { "type": "array", "items": { "$ref": "#/$defs/parity_dimension" } },
    "required_states": { "type": "array", "items": { "$ref": "#/$defs/state" } },
    "required_consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "covered_states": { "type": "array", "items": { "type": "string" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "term_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "object", "required": ["class"] }
    },
    "report_clean": { "type": "boolean" },
    "lifecycle_automation_refs": { "type": "array", "items": { "type": "string" } },
    "release_center_refs": { "type": "array", "items": { "type": "string" } },
    "help_docs_refs": { "type": "array", "items": { "type": "string" } },
    "support_export_refs": { "type": "array", "items": { "type": "string" } },
    "published_report_ref": { "type": "string", "minLength": 1 },
    "published_packet_ref": { "type": "string", "minLength": 1 },
    "published_dashboard_ref": { "type": "string", "minLength": 1 },
    "published_doc_ref": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "state": {
      "enum": [
        "ready",
        "warming",
        "partial",
        "stale",
        "rebuilding",
        "restricted",
        "policy_blocked",
        "reconnecting",
        "degraded",
        "read_only_degraded",
        "unavailable",
        "rollback_available",
        "deprecated",
        "experimental",
        "retest_pending"
      ]
    },
    "parity_dimension": {
      "enum": [
        "cross_surface_term",
        "semantic_distinction",
        "export_code_parity",
        "published_copy_narrowing"
      ]
    },
    "status": { "enum": ["green", "yellow", "red"] },
    "object_family": {
      "enum": [
        "workspace",
        "extension",
        "remote_session",
        "collaboration_session",
        "ai_action",
        "update_rollback",
        "notebook_runtime",
        "request_api_run",
        "preview_session",
        "pipeline_run",
        "data_session",
        "profiler_capture",
        "companion_session"
      ]
    },
    "consumer_surface": {
      "enum": [
        "product_ui",
        "cli",
        "docs_help",
        "diagnostics",
        "support_export",
        "telemetry",
        "claim_tooling",
        "release_notes"
      ]
    },
    "cross_surface_term": {
      "enum": [
        "term_stable_across_all_surfaces",
        "disclosed_surface_paraphrase",
        "term_meaning_drifted_across_surfaces"
      ]
    },
    "semantic_distinction": {
      "enum": [
        "distinct_meaning_preserved",
        "disclosed_grouped_presentation",
        "collapsed_into_generic_failure"
      ]
    },
    "export_code_parity": {
      "enum": [
        "code_exports_identically_all_paths",
        "disclosed_partial_export",
        "status_code_unexportable"
      ]
    },
    "published_copy_narrowing": {
      "enum": [
        "copy_auto_narrows_on_state_change",
        "disclosed_manual_narrowing",
        "stale_copy_overclaims"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "state", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/state" },
        "reason": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "trigger", "disclosed", "detail"],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "trigger": { "type": "string", "minLength": 1 },
        "disclosed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "state_label",
        "admitting_object_families",
        "required_consumer_surfaces",
        "evaluated_consumer_surfaces",
        "cross_surface_term",
        "semantic_distinction",
        "export_code_parity",
        "published_copy_narrowing",
        "headless_parity_preserved",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "term_causes",
        "narrowing_reason"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "state_label": { "type": "string", "minLength": 1 },
        "admitting_object_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/object_family" }
        },
        "required_consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "evaluated_consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "cross_surface_term": { "$ref": "#/$defs/cross_surface_term" },
        "semantic_distinction": { "$ref": "#/$defs/semantic_distinction" },
        "export_code_parity": { "$ref": "#/$defs/export_code_parity" },
        "published_copy_narrowing": { "$ref": "#/$defs/published_copy_narrowing" },
        "headless_parity_preserved": { "type": "boolean" },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "term_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    }
  }
}
