{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/git/freeze-the-m5-repository-topology-worktree-scope-history-surgery-and-checkpoint-recovery-matrix.schema.json",
  "title": "Aureline M5 repository-topology, worktree-scope, history-surgery, and checkpoint-recovery matrix",
  "description": "Export-safe packet freezing the canonical M5 Git depth contract. It binds each repository-topology class (sparse checkout, promisor partial clone, shallow history, submodule, nested independent repo, worktree root, Git-LFS pointer boundary, generated/vendor root) and each history-surgery session object (conflict session, sequence-edit session, recovery checkpoint, publish ref-update proposal, stash shelf entry) to its controlled degraded vocabulary, mutation scope, required preview, reachable recovery, and consumer-surface parity. Risky history operations carry an explicit preview and recovery class. Topology truth is never reduced to a badge; the matrix controls mutation, preview, recovery, and export behavior. Raw paths, raw object bytes, raw branch names, raw patch/reflog/stash bodies, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "topology_rows",
    "session_object_rows",
    "degraded_state_rows",
    "risky_operation_rows",
    "governance_review",
    "consumer_parity",
    "freeze_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_repository_topology_worktree_scope_history_surgery_and_checkpoint_recovery_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "topology_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/topology_row"
      }
    },
    "session_object_rows": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/session_object_row"
      }
    },
    "degraded_state_rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/degraded_state_row"
      }
    },
    "risky_operation_rows": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/risky_operation_row"
      }
    },
    "governance_review": {
      "$ref": "#/$defs/governance_review"
    },
    "consumer_parity": {
      "$ref": "#/$defs/consumer_parity"
    },
    "freeze_posture": {
      "$ref": "#/$defs/freeze_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "topology_class": {
      "enum": [
        "current_repo_root",
        "workset_root",
        "sparse_checkout_root",
        "worktree_root",
        "partial_clone_promisor_root",
        "shallow_history_root",
        "submodule_root",
        "nested_independent_repo_root",
        "lfs_hydration_boundary",
        "generated_vendor_root"
      ]
    },
    "honesty_label": {
      "enum": [
        "outside_current_slice",
        "not_fetched",
        "shallow_boundary",
        "submodule_not_initialized",
        "nested_repo_boundary",
        "pointer_only",
        "wrong_target_root",
        "dirty_state_unknown",
        "unavailable",
        "policy_excluded",
        "generated_or_excluded"
      ]
    },
    "degraded_state": {
      "enum": [
        "omitted",
        "unfetched",
        "uninitialized",
        "pointer_only",
        "dirty_child",
        "reflog_only_fallback",
        "stale_provider_overlay"
      ]
    },
    "preview_class": {
      "enum": [
        "no_preview_read_only",
        "scope_widen_preview",
        "fetch_or_deepen_preview",
        "diff_preview",
        "sequence_plan_preview",
        "ref_update_preview",
        "multi_root_preview",
        "destructive_rewrite_preview"
      ]
    },
    "recovery_class": {
      "enum": [
        "no_mutation_no_recovery",
        "checkpoint_before_mutation",
        "stash_shelf_restore",
        "ref_update_rollback",
        "reflog_only_fallback_disclosed",
        "no_recovery_operation_blocked"
      ]
    },
    "mutation_control": {
      "enum": [
        "active_root_only",
        "child_root_only",
        "explicit_multi_root_preview_required",
        "metadata_only",
        "mutation_denied"
      ]
    },
    "consumer_surface": {
      "enum": [
        "provider_overlay",
        "ai_context",
        "search",
        "review",
        "support_export",
        "cli",
        "shell",
        "diagnostics"
      ]
    },
    "session_object": {
      "enum": [
        "conflict_session",
        "sequence_edit_session",
        "recovery_checkpoint",
        "publish_ref_update_proposal",
        "stash_shelf_entry"
      ]
    },
    "risky_operation": {
      "enum": [
        "merge",
        "rebase",
        "interactive_rebase",
        "cherry_pick",
        "revert",
        "reset",
        "stash_apply",
        "stash_pop",
        "stash_drop",
        "branch_from_stash",
        "publish",
        "force_push_with_lease"
      ]
    },
    "consumer_surface_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "topology_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_class",
        "scope_summary",
        "honesty_label",
        "degraded_states",
        "mutation_control",
        "preview_class",
        "recovery_class",
        "provider_overlay_never_overwrites_local_truth",
        "consumer_surfaces"
      ],
      "properties": {
        "topology_class": {
          "$ref": "#/$defs/topology_class"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "honesty_label": {
          "$ref": "#/$defs/honesty_label"
        },
        "degraded_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/degraded_state"
          }
        },
        "mutation_control": {
          "$ref": "#/$defs/mutation_control"
        },
        "preview_class": {
          "$ref": "#/$defs/preview_class"
        },
        "recovery_class": {
          "$ref": "#/$defs/recovery_class"
        },
        "provider_overlay_never_overwrites_local_truth": {
          "type": "boolean"
        },
        "consumer_surfaces": {
          "$ref": "#/$defs/consumer_surface_array"
        }
      }
    },
    "session_object_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "canonical_record_kind",
        "scope_summary",
        "preview_class",
        "recovery_class",
        "mutation_control",
        "recovery_checkpoint_required_before_mutation",
        "consumer_surfaces"
      ],
      "properties": {
        "session": {
          "$ref": "#/$defs/session_object"
        },
        "canonical_record_kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "preview_class": {
          "$ref": "#/$defs/preview_class"
        },
        "recovery_class": {
          "$ref": "#/$defs/recovery_class"
        },
        "mutation_control": {
          "$ref": "#/$defs/mutation_control"
        },
        "recovery_checkpoint_required_before_mutation": {
          "type": "boolean"
        },
        "consumer_surfaces": {
          "$ref": "#/$defs/consumer_surface_array"
        }
      }
    },
    "degraded_state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "meaning",
        "narrows_coverage_claim",
        "blocks_mutation_until_resolved",
        "visible_before_destructive_op"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/degraded_state"
        },
        "meaning": {
          "$ref": "#/$defs/non_empty_string"
        },
        "narrows_coverage_claim": {
          "type": "boolean"
        },
        "blocks_mutation_until_resolved": {
          "type": "boolean"
        },
        "visible_before_destructive_op": {
          "type": "boolean"
        }
      }
    },
    "risky_operation_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "preview_class",
        "recovery_class",
        "requires_explicit_target",
        "recovery_visible_before_execution"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/risky_operation"
        },
        "preview_class": {
          "$ref": "#/$defs/preview_class"
        },
        "recovery_class": {
          "$ref": "#/$defs/recovery_class"
        },
        "requires_explicit_target": {
          "type": "boolean"
        },
        "recovery_visible_before_execution": {
          "type": "boolean"
        }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_truth_not_reduced_to_badges",
        "matrix_controls_mutation_preview_recovery_export",
        "provider_overlay_never_overwrites_local_truth",
        "recovery_visible_before_destructive_ops",
        "reflog_only_fallback_disclosed",
        "one_shared_matrix_across_surfaces",
        "degraded_vocabulary_shared_across_surfaces",
        "risky_ops_have_preview_and_recovery",
        "topology_classes_stay_distinct"
      ],
      "properties": {
        "topology_truth_not_reduced_to_badges": {
          "type": "boolean"
        },
        "matrix_controls_mutation_preview_recovery_export": {
          "type": "boolean"
        },
        "provider_overlay_never_overwrites_local_truth": {
          "type": "boolean"
        },
        "recovery_visible_before_destructive_ops": {
          "type": "boolean"
        },
        "reflog_only_fallback_disclosed": {
          "type": "boolean"
        },
        "one_shared_matrix_across_surfaces": {
          "type": "boolean"
        },
        "degraded_vocabulary_shared_across_surfaces": {
          "type": "boolean"
        },
        "risky_ops_have_preview_and_recovery": {
          "type": "boolean"
        },
        "topology_classes_stay_distinct": {
          "type": "boolean"
        }
      }
    },
    "consumer_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_overlay_expresses_vocabulary",
        "ai_context_expresses_vocabulary",
        "search_expresses_vocabulary",
        "review_expresses_vocabulary",
        "support_export_expresses_vocabulary",
        "cli_expresses_vocabulary"
      ],
      "properties": {
        "provider_overlay_expresses_vocabulary": {
          "type": "boolean"
        },
        "ai_context_expresses_vocabulary": {
          "type": "boolean"
        },
        "search_expresses_vocabulary": {
          "type": "boolean"
        },
        "review_expresses_vocabulary": {
          "type": "boolean"
        },
        "support_export_expresses_vocabulary": {
          "type": "boolean"
        },
        "cli_expresses_vocabulary": {
          "type": "boolean"
        }
      }
    },
    "freeze_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen",
        "review_slo_hours",
        "last_reviewed_at",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "review_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
