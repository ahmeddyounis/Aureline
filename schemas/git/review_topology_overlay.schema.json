{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/git/review_topology_overlay.schema.json",
  "title": "Aureline topology-aware mutation-review overlay packet",
  "description": "Export-safe packet overlaying repository-topology truth onto the mutation-review surface and gating cross-root bulk mutation. Each root row is the deterministic review-surface projection of one canonical topology descriptor, so parent/child repo identity and worktree/root identity stay visible during mutation review and a non-active root is never mutated by the active ambient action. The multi-root preview is the guard: when the proposed mutation set touches more than one root, it requires the explicit_multi_root_preview_required scope and marks auto_apply_blocked and opt_in_required true, so cross-root bulk mutation stays preview-first and opt-in. Raw paths, raw object bytes, and credentials never cross this boundary; only redaction-safe refs do.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "active_root_ref",
    "roots",
    "rows",
    "preview",
    "support_export"
  ],
  "properties": {
    "record_kind": { "const": "review_topology_overlay_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" },
    "active_root_ref": { "$ref": "#/$defs/non_empty_string" },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aureline.dev/schemas/git/topology.schema.json#/$defs/root_descriptor"
      }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/root_row" }
    },
    "preview": { "$ref": "#/$defs/preview" },
    "support_export": { "$ref": "#/$defs/support_export" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "operation_scope": {
      "$ref": "https://aureline.dev/schemas/git/topology.schema.json#/$defs/operation_scope"
    },
    "root_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "row_id",
        "root_ref",
        "identity_kind",
        "parent_root_ref",
        "is_active_root",
        "result_truth",
        "mutation_scope",
        "mutation_allowed"
      ],
      "properties": {
        "record_kind": { "const": "review_topology_overlay_root_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "root_ref": { "$ref": "#/$defs/non_empty_string" },
        "identity_kind": {
          "$ref": "https://aureline.dev/schemas/git/topology.schema.json#/$defs/repo_identity_kind"
        },
        "parent_root_ref": { "type": ["string", "null"] },
        "is_active_root": { "type": "boolean" },
        "result_truth": {
          "$ref": "https://aureline.dev/schemas/git/topology.schema.json#/$defs/result_truth"
        },
        "mutation_scope": { "$ref": "#/$defs/operation_scope" },
        "mutation_allowed": { "type": "boolean" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "preview_id",
        "active_root_ref",
        "touched_root_refs",
        "spans_multiple_roots",
        "crosses_parent_child_boundary",
        "crosses_nested_boundary",
        "required_scope",
        "explicit_preview_required",
        "auto_apply_blocked",
        "opt_in_required"
      ],
      "properties": {
        "record_kind": { "const": "review_multi_root_mutation_preview" },
        "preview_id": { "$ref": "#/$defs/non_empty_string" },
        "active_root_ref": { "$ref": "#/$defs/non_empty_string" },
        "touched_root_refs": { "$ref": "#/$defs/ref_array" },
        "spans_multiple_roots": { "type": "boolean" },
        "crosses_parent_child_boundary": { "type": "boolean" },
        "crosses_nested_boundary": { "type": "boolean" },
        "required_scope": { "$ref": "#/$defs/operation_scope" },
        "explicit_preview_required": { "type": "boolean" },
        "auto_apply_blocked": { "type": "boolean" },
        "opt_in_required": { "type": "boolean" }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "export_id",
        "row_refs",
        "preview_ref",
        "reconstruction_fields",
        "raw_paths_redacted",
        "raw_object_bytes_redacted"
      ],
      "properties": {
        "record_kind": { "const": "review_topology_overlay_support_export" },
        "export_id": { "$ref": "#/$defs/non_empty_string" },
        "row_refs": { "$ref": "#/$defs/ref_array" },
        "preview_ref": { "$ref": "#/$defs/non_empty_string" },
        "reconstruction_fields": { "$ref": "#/$defs/ref_array" },
        "raw_paths_redacted": { "const": true },
        "raw_object_bytes_redacted": { "const": true }
      }
    }
  }
}
