{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/git/daily_loop_support_export.schema.json",
  "title": "Aureline daily-loop support export v2",
  "description": "Strict redacted support projection for a daily Git-loop result. Raw roots, Git-directory paths, path bodies, labels, branch/ref names, failure details, and backend output are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "target",
    "kind",
    "outcome",
    "redaction_class",
    "redaction_profile_ref",
    "raw_path_export_allowed",
    "raw_ref_name_export_allowed",
    "affected_path_count",
    "omitted_fields",
    "observed_at"
  ],
  "properties": {
    "record_kind": { "const": "git_daily_loop_support_export_record" },
    "schema_version": { "const": 2 },
    "target": { "$ref": "#/$defs/target" },
    "kind": {
      "enum": [
        "status",
        "diff",
        "stage",
        "unstage",
        "commit",
        "amend",
        "stash_capture",
        "stash_apply",
        "stash_pop",
        "stash_drop",
        "stash_branch_from",
        "blame",
        "history"
      ]
    },
    "outcome": {
      "enum": ["completed", "blocked_no_changes_made", "failed", "partial"]
    },
    "redaction_class": { "const": "metadata_safe_default" },
    "redaction_profile_ref": { "const": "support.redaction.local_first_default" },
    "raw_path_export_allowed": { "const": false },
    "raw_ref_name_export_allowed": { "const": false },
    "affected_path_count": { "type": "integer", "minimum": 0 },
    "omitted_fields": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "target.workspace_ref",
          "target.repo.repo_ref",
          "target.repo.repo_root",
          "target.repo.git_dir",
          "target.repo.display_label",
          "target.worktree.repo_ref",
          "target.worktree.worktree_ref",
          "target.worktree.worktree_root",
          "target.worktree.head_label",
          "target.worktree.display_label",
          "affected_paths",
          "outcome_reason"
        ]
      }
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(unavailable|[0-9]+(?:\\.[0-9]{1,9})?Z)$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_ref_digest",
        "repo_ref_digest",
        "worktree_ref_digest",
        "repository_class",
        "is_shallow",
        "is_linked_worktree",
        "head_state_class"
      ],
      "properties": {
        "workspace_ref_digest": { "$ref": "#/$defs/digest" },
        "repo_ref_digest": { "$ref": "#/$defs/digest" },
        "worktree_ref_digest": { "$ref": "#/$defs/digest" },
        "repository_class": { "enum": ["bare_repository", "worktree_repository"] },
        "is_shallow": { "type": "boolean" },
        "is_linked_worktree": { "type": "boolean" },
        "head_state_class": { "enum": ["attached", "detached", "unavailable"] }
      }
    }
  }
}
