{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/git/certify-m5-git-topology-history-recovery-and-provider-parity-rows.schema.json",
  "title": "Aureline M5 Git topology, history-recovery, and provider-parity certification register",
  "description": "Export-safe certification register over the claimed M5 Git and source-acquisition rows. Each row binds one claimed surface to the four certification dimensions it must prove (topology honesty, worktree/root scoping, history-surgery preview/recovery, local/provider parity), records per-dimension evidence freshness and proof state, and carries a verdict derived fail-closed from that evidence: a stale or unrun dimension narrows the row to retest_pending, an honestly partial dimension to limited, and a failed or missing dimension to unsupported. A parity audit proves every consumer surface reflects the same row verdicts; downgrade automation binds the narrowing targets to the register's own derivation semantics. Certification truth is never reduced to a badge; the rows decide whether a claim may be published. Raw paths, raw object bytes, raw branch names, raw patch/reflog/stash bodies, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "certification_label",
    "rows",
    "parity_audit",
    "downgrade_automation",
    "governance_review",
    "freshness_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "certify_m5_git_topology_history_recovery_and_provider_parity_rows"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certification_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/certification_row"
      }
    },
    "parity_audit": {
      "$ref": "#/$defs/parity_audit"
    },
    "downgrade_automation": {
      "$ref": "#/$defs/downgrade_automation"
    },
    "governance_review": {
      "$ref": "#/$defs/governance_review"
    },
    "freshness_posture": {
      "$ref": "#/$defs/freshness_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "claim_row": {
      "enum": [
        "source_acquisition_and_topology_initialization",
        "repository_topology_honesty",
        "worktree_and_root_scoping",
        "topology_aware_search_ai_review_parity",
        "history_surgery_preview_and_recovery",
        "stash_reflog_checkpoint_recovery",
        "conflict_resolution_continuity",
        "publish_and_provider_parity"
      ]
    },
    "dimension": {
      "enum": [
        "topology_honesty",
        "worktree_root_scoping",
        "history_surgery_preview_recovery",
        "local_provider_parity"
      ]
    },
    "freshness": {
      "enum": [
        "current",
        "stale",
        "missing"
      ]
    },
    "proof_state": {
      "enum": [
        "proven",
        "narrowed",
        "failed",
        "not_run"
      ]
    },
    "verdict": {
      "enum": [
        "certified",
        "limited",
        "retest_pending",
        "unsupported"
      ]
    },
    "consumer_surface": {
      "enum": [
        "product",
        "docs_help",
        "cli",
        "support_export",
        "evaluation_pack",
        "claim_publication_manifest",
        "release_public_truth"
      ]
    },
    "consumer_surface_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "dimension_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "applicable",
        "freshness",
        "proof_state",
        "evidence_refs",
        "summary"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "applicable": {
          "type": "boolean"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "proof_state": {
          "$ref": "#/$defs/proof_state"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_row",
        "row_label",
        "published_claim",
        "dimensions",
        "verdict",
        "narrowing_reason",
        "consumer_surfaces"
      ],
      "properties": {
        "claim_row": {
          "$ref": "#/$defs/claim_row"
        },
        "row_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "published_claim": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dimensions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/dimension_qualification"
          }
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "narrowing_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "consumer_surfaces": {
          "$ref": "#/$defs/consumer_surface_array"
        }
      }
    },
    "parity_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_reflects_row_verdicts",
        "docs_help_reflects_row_verdicts",
        "cli_reflects_row_verdicts",
        "support_export_reflects_row_verdicts",
        "evaluation_packs_reflect_row_verdicts",
        "claim_publication_manifests_reflect_row_verdicts",
        "release_public_truth_reflects_row_verdicts",
        "no_surface_claims_wider_than_row",
        "local_truth_authoritative_over_provider"
      ],
      "properties": {
        "product_reflects_row_verdicts": {
          "type": "boolean"
        },
        "docs_help_reflects_row_verdicts": {
          "type": "boolean"
        },
        "cli_reflects_row_verdicts": {
          "type": "boolean"
        },
        "support_export_reflects_row_verdicts": {
          "type": "boolean"
        },
        "evaluation_packs_reflect_row_verdicts": {
          "type": "boolean"
        },
        "claim_publication_manifests_reflect_row_verdicts": {
          "type": "boolean"
        },
        "release_public_truth_reflects_row_verdicts": {
          "type": "boolean"
        },
        "no_surface_claims_wider_than_row": {
          "type": "boolean"
        },
        "local_truth_authoritative_over_provider": {
          "type": "boolean"
        }
      }
    },
    "downgrade_automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_narrow_on_stale",
        "stale_or_unrun_narrows_to",
        "partial_narrows_to",
        "failure_or_missing_narrows_to",
        "propagates_to_docs_help",
        "propagates_to_support_packets",
        "propagates_to_evaluation_packs",
        "propagates_to_claim_publication_manifests",
        "release_surface_stops_overclaiming_on_slip"
      ],
      "properties": {
        "auto_narrow_on_stale": {
          "type": "boolean"
        },
        "stale_or_unrun_narrows_to": {
          "const": "retest_pending"
        },
        "partial_narrows_to": {
          "const": "limited"
        },
        "failure_or_missing_narrows_to": {
          "const": "unsupported"
        },
        "propagates_to_docs_help": {
          "type": "boolean"
        },
        "propagates_to_support_packets": {
          "type": "boolean"
        },
        "propagates_to_evaluation_packs": {
          "type": "boolean"
        },
        "propagates_to_claim_publication_manifests": {
          "type": "boolean"
        },
        "release_surface_stops_overclaiming_on_slip": {
          "type": "boolean"
        }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_current_topology_and_recovery_evidence_per_row",
        "stale_or_underqualified_rows_narrow_automatically",
        "release_surfaces_stop_overclaiming_on_slip",
        "claim_truth_is_not_manual",
        "fails_closed_to_retest_limited_or_unsupported",
        "provider_degraded_local_continuity_required",
        "one_certification_register_across_surfaces",
        "no_claim_broadened_beyond_proof_packet"
      ],
      "properties": {
        "requires_current_topology_and_recovery_evidence_per_row": {
          "type": "boolean"
        },
        "stale_or_underqualified_rows_narrow_automatically": {
          "type": "boolean"
        },
        "release_surfaces_stop_overclaiming_on_slip": {
          "type": "boolean"
        },
        "claim_truth_is_not_manual": {
          "type": "boolean"
        },
        "fails_closed_to_retest_limited_or_unsupported": {
          "type": "boolean"
        },
        "provider_degraded_local_continuity_required": {
          "type": "boolean"
        },
        "one_certification_register_across_surfaces": {
          "type": "boolean"
        },
        "no_claim_broadened_beyond_proof_packet": {
          "type": "boolean"
        }
      }
    },
    "freshness_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_slo_hours",
        "last_reviewed_at",
        "auto_narrow_on_stale",
        "evidence_window_open"
      ],
      "properties": {
        "review_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        },
        "evidence_window_open": {
          "type": "boolean"
        }
      }
    }
  }
}
