{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-ai-execution-replay-component-certification.schema.json",
  "title": "M5 AI Execution/Replay-Component Surface Certification Packet",
  "description": "M05-883 closing capstone certifying that the eight frozen AI-execution/replay components (action-state banner, connector detail row, local-model pack card, high-friction approval sheet, tool-call timeline row, run-history row, replay/rerun-review sheet, agent-status card) hold on every claimed M5 AI surface. Each surface is scored across six truth axes; a degraded axis must produce a visible support-claim narrowing (yellow) or the surface is blocked (red). Metadata-only: raw prompts, tokens, credentials, and replay bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_kind": {
      "const": "m5_ai_execution_replay_component_certification_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certificationRow" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "supportClaim": {
      "type": "string",
      "enum": [
        "live_governed_execution",
        "complete_replay",
        "route_adjacent_replay",
        "cached_evidence",
        "unverified_agent_state",
        "policy_blocked_execution"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "inline_assistant",
        "assistant_panel",
        "patch_review",
        "test_generation",
        "branch_worktree_queue",
        "help_console",
        "cli_headless",
        "support_export"
      ]
    },
    "axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "execution_boundary_and_replay_provenance"
      ]
    },
    "axisState": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "status": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "componentFamily": {
      "type": "string",
      "enum": [
        "ai_action_state_banner",
        "connector_detail_row",
        "local_model_pack_card",
        "approval_sheet",
        "tool_call_timeline_row",
        "run_history_row",
        "replay_review",
        "agent_status"
      ]
    },
    "downgradeTrigger": {
      "type": "string",
      "enum": [
        "execution_mode_unstated",
        "route_or_provider_masked",
        "tool_boundary_unstated",
        "auth_posture_masked",
        "approval_gate_hidden",
        "checkpoint_lineage_broken",
        "replay_completeness_overstated",
        "rerun_review_reason_unstated",
        "takeover_path_hidden",
        "connector_side_effect_undisclosed",
        "local_model_provenance_masked",
        "proof_stale"
      ]
    },
    "exportParity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "axisOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/axis" },
        "state": { "$ref": "#/$defs/axisState" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string" },
        "downgrade_trigger": { "$ref": "#/$defs/downgradeTrigger" }
      }
    },
    "claimAutoNarrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/axis" },
        "from_claim": { "$ref": "#/$defs/supportClaim" },
        "to_claim": { "$ref": "#/$defs/supportClaim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "certificationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_ai_execution_replay_component_certification_row"
        },
        "schema_version": { "type": "integer", "minimum": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "claimed_claim": { "$ref": "#/$defs/supportClaim" },
        "certified_claim": { "$ref": "#/$defs/supportClaim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentFamily" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axisOutcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claimAutoNarrow" },
        "canonical_bundle_ref": { "type": "string", "minLength": 1 },
        "derived_status": { "$ref": "#/$defs/status" },
        "export_parity": { "$ref": "#/$defs/exportParity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "every_axis_covered_on_every_row",
        "narrowed_surface_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
