{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/package-mutation-review.schema.json",
  "title": "Aureline AI package-mutation review",
  "description": "Schema for the ai_package_mutation_review packet. Each AiMutationProposalRow is the AI composer's propose-only view of a governed package mutation: preview-first, routed through governed review, free of hidden scripting, and bound by reference to the aureline-deps automation_governance packet (references_governance_packet_id), the frozen package-state matrix (references_matrix_id), and the reviewed-mutation contract (references_reviewed_flows_id). The AI surface never carries execution authority. Each proposal mirrors the governed safe-fallback decision and result class so the AI lane can never become a bypass lane around lockfile-safe review. The model is metadata-only and carries no credential bodies, registry tokens, raw provider payloads, or private registry URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "as_of",
    "references_governance_packet_id",
    "references_matrix_id",
    "references_reviewed_flows_id",
    "intents",
    "write_authorities",
    "safe_fallback_classes",
    "result_classes",
    "validation_kinds",
    "proposals",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "ai_package_mutation_review" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "references_governance_packet_id": { "$ref": "#/$defs/non_empty_string" },
    "references_matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "references_reviewed_flows_id": { "$ref": "#/$defs/non_empty_string" },
    "intents": { "type": "array", "items": { "$ref": "#/$defs/intent" } },
    "write_authorities": { "type": "array", "items": { "$ref": "#/$defs/write_authority" } },
    "safe_fallback_classes": { "type": "array", "items": { "$ref": "#/$defs/safe_fallback" } },
    "result_classes": { "type": "array", "items": { "$ref": "#/$defs/result_class" } },
    "validation_kinds": { "type": "array", "items": { "$ref": "#/$defs/validation_kind" } },
    "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "intent": { "enum": ["add_dependency", "upgrade_dependency", "remove_dependency", "relock_dependencies"] },
    "write_authority": { "enum": ["propose_only", "inspect_only"] },
    "safe_fallback": {
      "enum": [
        "proceed_after_review",
        "narrow_to_inspect_only",
        "narrow_to_export_only",
        "handoff_to_browser",
        "handoff_to_cli",
        "blocked_no_safe_path"
      ]
    },
    "result_class": {
      "enum": [
        "preview_pending",
        "reviewed_ready",
        "blocked_unsafe",
        "narrowed_inspect_only",
        "handed_off",
        "committed_reviewed",
        "rolled_back"
      ]
    },
    "validation_kind": {
      "enum": ["build", "test", "lint", "typecheck", "security_audit", "license_review", "lockfile_verify"]
    },
    "ecosystem": { "enum": ["cargo", "node_pnpm", "python_pip", "other"] },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "governed_proposal_ref",
        "intent",
        "ecosystem",
        "label",
        "write_authority",
        "preview_first",
        "routes_through_governed_review",
        "no_hidden_scripting",
        "safe_fallback",
        "result_class",
        "rollback_handle_ref",
        "redacted_manifest_path",
        "note"
      ],
      "properties": {
        "proposal_id": { "$ref": "#/$defs/non_empty_string" },
        "governed_proposal_ref": { "$ref": "#/$defs/non_empty_string" },
        "intent": { "$ref": "#/$defs/intent" },
        "ecosystem": { "$ref": "#/$defs/ecosystem" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "write_authority": { "$ref": "#/$defs/write_authority" },
        "preview_first": { "type": "boolean" },
        "routes_through_governed_review": { "type": "boolean" },
        "no_hidden_scripting": { "type": "boolean" },
        "requested_validation": { "type": "array", "items": { "$ref": "#/$defs/validation_kind" } },
        "safe_fallback": { "$ref": "#/$defs/safe_fallback" },
        "result_class": { "$ref": "#/$defs/result_class" },
        "rollback_handle_ref": { "$ref": "#/$defs/non_empty_string" },
        "redacted_manifest_path": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_proposals",
        "add_proposals",
        "upgrade_proposals",
        "remove_proposals",
        "relock_proposals",
        "propose_only_proposals",
        "inspect_only_proposals",
        "proceed_proposals",
        "narrowed_or_handoff_proposals",
        "blocked_proposals",
        "committed_proposals"
      ],
      "properties": {
        "total_proposals": { "type": "integer", "minimum": 0 },
        "add_proposals": { "type": "integer", "minimum": 0 },
        "upgrade_proposals": { "type": "integer", "minimum": 0 },
        "remove_proposals": { "type": "integer", "minimum": 0 },
        "relock_proposals": { "type": "integer", "minimum": 0 },
        "propose_only_proposals": { "type": "integer", "minimum": 0 },
        "inspect_only_proposals": { "type": "integer", "minimum": 0 },
        "proceed_proposals": { "type": "integer", "minimum": 0 },
        "narrowed_or_handoff_proposals": { "type": "integer", "minimum": 0 },
        "blocked_proposals": { "type": "integer", "minimum": 0 },
        "committed_proposals": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
