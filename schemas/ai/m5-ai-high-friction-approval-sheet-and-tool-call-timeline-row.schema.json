{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-ai-high-friction-approval-sheet-and-tool-call-timeline-row.schema.json",
  "title": "Aureline M5 AI high-friction-approval-sheet / tool-call-timeline-row primitive",
  "description": "Export-safe packet implementing the reusable M5 AI high-friction approval sheet and tool-call timeline row as one primitive pair. The packet binds one row per claimed tool lane — read-only tool invocations, mutating tool runs, test-generation validations, branch-agent checkpoints, and the CLI / support export — to the shared approval-sheet and tool-call anatomy, the action scopes, side-effect classes, tool boundaries, rollback postures, approval gates, friction reasons, run outcomes, explicit approve-once/deny/open-plan controls, and governed open-output/remove-from-context/view-provenance follow-up actions. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked approval-sheet and tool-call resolution cases proving the resolvers, and four hard invariants: it never lets a mutating or boundary-crossing action read as an ordinary status update, never buries provenance or removal controls inside raw logs, never drops the rollback / checkpoint vocabulary, and never invents a parallel approval or tool-call grammar. Raw prompt bodies, tool return bodies, paths, URLs, and credential material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_ai_high_friction_approval_sheets_and_tool_call_timeline_rows_across_claimed_m5_ai_tool_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_lane",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "approval_anatomy_parts",
        "tool_call_anatomy_parts",
        "action_scopes",
        "side_effect_classes",
        "tool_boundaries",
        "rollback_postures",
        "approval_gates",
        "friction_reasons",
        "run_outcomes",
        "approval_controls",
        "follow_up_actions",
        "approval_export_fields",
        "tool_call_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "approval_examples",
        "tool_call_examples",
        "masks_mutation_or_boundary_as_status",
        "buries_provenance_or_removal_in_logs",
        "drops_rollback_or_checkpoint_vocabulary",
        "invents_parallel_approval_or_tool_grammar"
      ],
      "properties": {
        "tool_lane": { "$ref": "#/$defs/tool_lane" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "approval_anatomy_parts": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/approval_anatomy_part" }
        },
        "tool_call_anatomy_parts": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/tool_call_anatomy_part" }
        },
        "action_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_scope" }
        },
        "side_effect_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tool_boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rollback_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rollback_posture" }
        },
        "approval_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "friction_reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "run_outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "approval_controls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/approval_control" }
        },
        "follow_up_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/follow_up_action" },
          "allOf": [
            { "contains": { "const": "view_provenance" } },
            { "contains": { "const": "remove_from_context" } }
          ]
        },
        "approval_export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/approval_export_field" }
        },
        "tool_call_export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/tool_call_export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "approval_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/approval_case" }
        },
        "tool_call_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tool_call_case" }
        },
        "masks_mutation_or_boundary_as_status": { "const": false },
        "buries_provenance_or_removal_in_logs": { "const": false },
        "drops_rollback_or_checkpoint_vocabulary": { "const": false },
        "invents_parallel_approval_or_tool_grammar": { "const": false }
      }
    },
    "approval_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested_action_label",
            "action_scope",
            "side_effect_class",
            "tool_boundary",
            "friction_reasons",
            "rollback_posture",
            "checkpoint_ref_present",
            "declared_approval_gate"
          ],
          "properties": {
            "requested_action_label": { "type": "string", "minLength": 1 },
            "action_scope": { "$ref": "#/$defs/action_scope" },
            "side_effect_class": { "type": "string" },
            "tool_boundary": { "type": "string" },
            "friction_reasons": { "type": "array", "items": { "type": "string" } },
            "rollback_posture": { "$ref": "#/$defs/rollback_posture" },
            "checkpoint_ref_present": { "type": "boolean" },
            "declared_approval_gate": { "type": "string" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested_action_label",
            "action_scope",
            "side_effect_class",
            "tool_boundary",
            "friction_reasons",
            "rollback_posture",
            "effective_approval_gate",
            "is_mutating_or_boundary_crossing",
            "requires_review_sheet",
            "is_high_friction",
            "is_reversible",
            "available_controls"
          ],
          "properties": {
            "requested_action_label": { "type": "string", "minLength": 1 },
            "action_scope": { "$ref": "#/$defs/action_scope" },
            "side_effect_class": { "type": "string" },
            "tool_boundary": { "type": "string" },
            "friction_reasons": { "type": "array", "items": { "type": "string" } },
            "rollback_posture": { "$ref": "#/$defs/rollback_posture" },
            "effective_approval_gate": { "type": "string" },
            "is_mutating_or_boundary_crossing": { "type": "boolean" },
            "requires_review_sheet": { "type": "boolean" },
            "is_high_friction": { "type": "boolean" },
            "is_reversible": { "type": "boolean" },
            "available_controls": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/approval_control" }
            }
          }
        }
      }
    },
    "tool_call_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "occurred_at_label",
            "tool_label",
            "tool_boundary",
            "predicted_side_effect",
            "observed_side_effect",
            "run_outcome",
            "output_available",
            "in_active_context"
          ],
          "properties": {
            "occurred_at_label": { "type": "string", "minLength": 1 },
            "tool_label": { "type": "string", "minLength": 1 },
            "tool_boundary": { "type": "string" },
            "predicted_side_effect": { "type": "string" },
            "observed_side_effect": { "type": "string" },
            "run_outcome": { "type": "string" },
            "output_available": { "type": "boolean" },
            "in_active_context": { "type": "boolean" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "occurred_at_label",
            "tool_label",
            "tool_boundary",
            "predicted_side_effect",
            "observed_side_effect",
            "run_outcome",
            "effect_escalated",
            "is_mutating",
            "boundary_crossing",
            "follow_up_actions"
          ],
          "properties": {
            "occurred_at_label": { "type": "string", "minLength": 1 },
            "tool_label": { "type": "string", "minLength": 1 },
            "tool_boundary": { "type": "string" },
            "predicted_side_effect": { "type": "string" },
            "observed_side_effect": { "type": "string" },
            "run_outcome": { "type": "string" },
            "effect_escalated": { "type": "boolean" },
            "is_mutating": { "type": "boolean" },
            "boundary_crossing": { "type": "boolean" },
            "follow_up_actions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/follow_up_action" },
              "contains": { "const": "view_provenance" }
            }
          }
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_lanes",
        "approval_anatomy_parts",
        "tool_call_anatomy_parts",
        "action_scopes",
        "rollback_postures",
        "approval_controls",
        "follow_up_actions",
        "approval_export_fields",
        "tool_call_export_fields",
        "approval_gates",
        "friction_reasons",
        "tool_boundaries",
        "side_effect_classes",
        "run_outcomes",
        "accessibility_routes"
      ],
      "properties": {
        "tool_lanes": { "type": "array", "items": { "type": "string" } },
        "approval_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "tool_call_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "action_scopes": { "type": "array", "items": { "type": "string" } },
        "rollback_postures": { "type": "array", "items": { "type": "string" } },
        "approval_controls": { "type": "array", "items": { "type": "string" } },
        "follow_up_actions": { "type": "array", "items": { "type": "string" } },
        "approval_export_fields": { "type": "array", "items": { "type": "string" } },
        "tool_call_export_fields": { "type": "array", "items": { "type": "string" } },
        "approval_gates": { "type": "array", "items": { "type": "string" } },
        "friction_reasons": { "type": "array", "items": { "type": "string" } },
        "tool_boundaries": { "type": "array", "items": { "type": "string" } },
        "side_effect_classes": { "type": "array", "items": { "type": "string" } },
        "run_outcomes": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tool_lane": {
      "enum": [
        "read_only_tool_invocation",
        "mutating_tool_run",
        "test_generation_validation",
        "branch_agent_checkpoint",
        "cli_support_export"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "approval_anatomy_part": {
      "enum": [
        "requested_action_cue",
        "scope_cue",
        "side_effect_cue",
        "boundary_cue",
        "rollback_checkpoint_cue",
        "friction_reason_cue",
        "approval_gate_cue",
        "control_row_cue"
      ]
    },
    "tool_call_anatomy_part": {
      "enum": [
        "time_cue",
        "tool_cue",
        "side_effect_class_cue",
        "boundary_cue",
        "outcome_cue",
        "follow_up_action_cue",
        "provenance_cue",
        "effect_comparison_cue"
      ]
    },
    "action_scope": {
      "enum": [
        "single_file",
        "workspace_subtree",
        "whole_workspace",
        "external_resource",
        "cross_tenant",
        "host_system"
      ]
    },
    "rollback_posture": {
      "enum": [
        "checkpoint_backed",
        "reversible_in_place",
        "forward_fix_only",
        "irreversible_external",
        "no_rollback"
      ]
    },
    "approval_control": {
      "enum": [
        "approve_once",
        "deny",
        "open_plan",
        "review_rollback_checkpoint",
        "escalate_second_reviewer"
      ]
    },
    "follow_up_action": {
      "enum": [
        "open_output",
        "remove_from_context",
        "view_provenance",
        "replay_in_sandbox",
        "renew_approval"
      ]
    },
    "approval_export_field": {
      "enum": [
        "requested_action",
        "scope",
        "side_effect",
        "boundary",
        "rollback_posture",
        "effective_gate",
        "friction_reasons",
        "requires_review_sheet"
      ]
    },
    "tool_call_export_field": {
      "enum": [
        "occurred_at",
        "tool",
        "boundary",
        "predicted_side_effect",
        "observed_side_effect",
        "outcome",
        "follow_up_actions",
        "effect_escalated"
      ]
    }
  }
}
