{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-ai-connector-detail-row-and-local-model-pack-card.schema.json",
  "title": "Aureline M5 AI connector-detail-row / local-model-pack-card primitive",
  "description": "Export-safe packet implementing the reusable M5 AI connector / tool-server detail row and local model pack card as one primitive pair. The packet binds one row per claimed routing consumer — AI settings, the model picker, the route inspector, the evidence view, and the CLI / support export — to the shared connector and model anatomy, the derived connector readiness (warm/cold/unavailable/policy-blocked), the derived model pack readiness, the execution loci, capabilities, auth postures, model pack states, hardware fits, offline postures, bounded select/verify/remove actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked connector and model resolution cases proving the resolvers, and four hard invariants: it never masks its execution locus or auth posture, never shows a blocked connector as ready, never hides disk cost / hardware expectations / offline locality behind a generic installed state, and never invents a parallel connector or model grammar. Raw URLs, credentials, private endpoints, and user text bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_ai_connector_detail_rows_and_local_model_pack_cards_across_claimed_m5_ai_routing_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "connector_anatomy_parts",
        "model_anatomy_parts",
        "execution_loci",
        "connector_capabilities",
        "auth_postures",
        "connector_readinesses",
        "model_pack_states",
        "model_pack_readinesses",
        "hardware_fits",
        "offline_postures",
        "model_pack_actions",
        "connector_export_fields",
        "model_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "connector_examples",
        "model_examples",
        "masks_execution_locus_or_authority",
        "shows_blocked_connector_as_ready",
        "hides_disk_hardware_or_offline_cost",
        "invents_parallel_connector_or_model_grammar"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "connector_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/connector_anatomy_part" }
        },
        "model_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/model_anatomy_part" }
        },
        "execution_loci": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/execution_locus" }
        },
        "connector_capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "auth_postures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "connector_readinesses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/connector_readiness" }
        },
        "model_pack_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "model_pack_readinesses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/model_pack_readiness" }
        },
        "hardware_fits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hardware_fit" }
        },
        "offline_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/offline_posture" }
        },
        "model_pack_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/model_pack_action" }
        },
        "connector_export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/connector_export_field" }
        },
        "model_export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/model_export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "connector_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/connector_case" }
        },
        "model_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/model_case" }
        },
        "masks_execution_locus_or_authority": { "const": false },
        "shows_blocked_connector_as_ready": { "const": false },
        "hides_disk_hardware_or_offline_cost": { "const": false },
        "invents_parallel_connector_or_model_grammar": { "const": false }
      }
    },
    "connector_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_id",
            "publisher_source",
            "execution_locus",
            "declared_capabilities",
            "auth_posture",
            "policy_blocked",
            "reachable",
            "session_warmed",
            "discloses_side_effects"
          ],
          "properties": {
            "canonical_id": { "type": "string", "minLength": 1 },
            "publisher_source": { "type": "string", "minLength": 1 },
            "execution_locus": { "$ref": "#/$defs/execution_locus" },
            "declared_capabilities": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "auth_posture": { "type": "string" },
            "policy_blocked": { "type": "boolean" },
            "reachable": { "type": "boolean" },
            "session_warmed": { "type": "boolean" },
            "discloses_side_effects": { "type": "boolean" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_id",
            "publisher_source",
            "execution_locus",
            "declared_capabilities",
            "auth_posture",
            "discloses_side_effects",
            "connector_readiness",
            "is_invocable",
            "needs_attention",
            "locus_is_local",
            "requires_authority_before_invocation"
          ],
          "properties": {
            "canonical_id": { "type": "string", "minLength": 1 },
            "publisher_source": { "type": "string", "minLength": 1 },
            "execution_locus": { "$ref": "#/$defs/execution_locus" },
            "declared_capabilities": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "auth_posture": { "type": "string" },
            "discloses_side_effects": { "type": "boolean" },
            "connector_readiness": { "$ref": "#/$defs/connector_readiness" },
            "is_invocable": { "type": "boolean" },
            "needs_attention": { "type": "boolean" },
            "locus_is_local": { "type": "boolean" },
            "requires_authority_before_invocation": { "type": "boolean" }
          }
        }
      }
    },
    "model_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_identity",
            "digest",
            "size_on_disk_mb",
            "hardware_expectation_label",
            "required_memory_mb",
            "available_memory_mb",
            "requires_accelerator",
            "accelerator_present",
            "pack_state",
            "provenance_verified",
            "requires_network_fetch"
          ],
          "properties": {
            "model_identity": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "minLength": 1 },
            "size_on_disk_mb": { "type": "integer", "minimum": 1 },
            "hardware_expectation_label": { "type": "string", "minLength": 1 },
            "required_memory_mb": { "type": "integer", "minimum": 0 },
            "available_memory_mb": { "type": "integer", "minimum": 0 },
            "requires_accelerator": { "type": "boolean" },
            "accelerator_present": { "type": "boolean" },
            "pack_state": { "type": "string" },
            "provenance_verified": { "type": "boolean" },
            "requires_network_fetch": { "type": "boolean" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_identity",
            "digest",
            "size_on_disk_mb",
            "hardware_expectation_label",
            "pack_state",
            "provenance_verified",
            "hardware_fit",
            "offline_posture",
            "model_pack_readiness",
            "available_actions",
            "is_selectable",
            "needs_attention"
          ],
          "properties": {
            "model_identity": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "minLength": 1 },
            "size_on_disk_mb": { "type": "integer", "minimum": 1 },
            "hardware_expectation_label": { "type": "string", "minLength": 1 },
            "pack_state": { "type": "string" },
            "provenance_verified": { "type": "boolean" },
            "hardware_fit": { "$ref": "#/$defs/hardware_fit" },
            "offline_posture": { "$ref": "#/$defs/offline_posture" },
            "model_pack_readiness": { "$ref": "#/$defs/model_pack_readiness" },
            "available_actions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/model_pack_action" }
            },
            "is_selectable": { "type": "boolean" },
            "needs_attention": { "type": "boolean" }
          }
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "connector_anatomy_parts",
        "model_anatomy_parts",
        "execution_loci",
        "connector_readinesses",
        "hardware_fits",
        "offline_postures",
        "model_pack_readinesses",
        "model_pack_actions",
        "connector_export_fields",
        "model_export_fields",
        "connector_capabilities",
        "auth_postures",
        "model_pack_states",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "connector_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "model_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "execution_loci": { "type": "array", "items": { "type": "string" } },
        "connector_readinesses": { "type": "array", "items": { "type": "string" } },
        "hardware_fits": { "type": "array", "items": { "type": "string" } },
        "offline_postures": { "type": "array", "items": { "type": "string" } },
        "model_pack_readinesses": { "type": "array", "items": { "type": "string" } },
        "model_pack_actions": { "type": "array", "items": { "type": "string" } },
        "connector_export_fields": { "type": "array", "items": { "type": "string" } },
        "model_export_fields": { "type": "array", "items": { "type": "string" } },
        "connector_capabilities": { "type": "array", "items": { "type": "string" } },
        "auth_postures": { "type": "array", "items": { "type": "string" } },
        "model_pack_states": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "consumer_surface": {
      "enum": [
        "ai_settings",
        "model_picker",
        "route_inspector",
        "evidence_view",
        "cli_support_export"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "connector_anatomy_part": {
      "enum": [
        "canonical_id_cue",
        "publisher_source_cue",
        "execution_locus_cue",
        "capability_list_cue",
        "auth_posture_cue",
        "readiness_state_cue",
        "side_effect_disclosure_cue",
        "invocation_guard_cue"
      ]
    },
    "model_anatomy_part": {
      "enum": [
        "model_identity_cue",
        "digest_cue",
        "disk_size_cue",
        "hardware_expectation_cue",
        "offline_posture_cue",
        "pack_state_cue",
        "provenance_cue",
        "action_row_cue"
      ]
    },
    "execution_locus": {
      "enum": [
        "in_process_local",
        "local_subprocess",
        "local_container",
        "remote_managed_service",
        "third_party_cloud",
        "on_prem_bridge"
      ]
    },
    "connector_readiness": {
      "enum": ["warm", "cold", "unavailable", "policy_blocked"]
    },
    "hardware_fit": {
      "enum": ["fits", "fits_with_swap", "exceeds_memory", "requires_accelerator"]
    },
    "offline_posture": {
      "enum": ["runs_fully_offline", "mirror_served", "requires_network_fetch", "local_cached"]
    },
    "model_pack_readiness": {
      "enum": [
        "ready_selectable",
        "mirrored_ready",
        "offline_ready",
        "update_pending",
        "hardware_blocked",
        "verification_held"
      ]
    },
    "model_pack_action": {
      "enum": ["select", "verify", "remove", "update", "run_hardware_fit_check"]
    },
    "connector_export_field": {
      "enum": [
        "canonical_id",
        "publisher_source",
        "execution_locus",
        "capabilities",
        "auth_posture",
        "connector_readiness",
        "side_effect_disclosed",
        "requires_authority"
      ]
    },
    "model_export_field": {
      "enum": [
        "model_identity",
        "digest",
        "disk_size_mb",
        "hardware_expectation",
        "hardware_fit",
        "offline_posture",
        "model_pack_readiness",
        "available_actions"
      ]
    }
  }
}
