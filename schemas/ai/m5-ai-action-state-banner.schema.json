{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-ai-action-state-banner.schema.json",
  "title": "Aureline M5 AI action-state-banner / boundary-blocked-banner primitive",
  "description": "Export-safe packet implementing the reusable M5 AI action-state banner and boundary-blocked banner as one primitive. The packet binds one row per claimed banner consumer — the inline explain/fix overlay, the assistant panel, the patch-review lane, the background branch/worktree agent, and the CLI / support export — to the shared banner anatomy, the derived banner postures, the execution modes, action states, scope reaches, placements, approval gates, blocked boundaries, safe alternatives, operator controls, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks its execution mode or scope reach, never shows a boundary crossing as allowed, never emits a generic model or tool error in place of a named boundary, and never hides its operator controls or takeover path. Raw prompts, model payloads, raw URLs, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "banner_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_ai_action_state_banners_and_boundary_blocked_banners_across_claimed_m5_inline_panel_review_agent_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "banner_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/banner_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "banner_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "execution_modes",
        "action_states",
        "scope_reaches",
        "placements",
        "approval_gates",
        "banner_postures",
        "blocked_boundaries",
        "safe_alternatives",
        "operator_controls",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "masks_execution_mode_or_reach",
        "shows_boundary_crossing_as_allowed",
        "emits_generic_model_or_tool_error",
        "hides_operator_controls_or_takeover"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "anatomy_parts": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/anatomy_part" }
        },
        "execution_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/execution_mode" }
        },
        "action_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "scope_reaches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scope_reach" }
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/placement" }
        },
        "approval_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "banner_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/banner_posture" }
        },
        "blocked_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/blocked_boundary" }
        },
        "safe_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/safe_alternative" }
        },
        "operator_controls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operator_control" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "masks_execution_mode_or_reach": { "const": false },
        "shows_boundary_crossing_as_allowed": { "const": false },
        "emits_generic_model_or_tool_error": { "const": false },
        "hides_operator_controls_or_takeover": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "banner_label",
            "scope_repr",
            "execution_mode",
            "action_state",
            "scope_reach",
            "placement",
            "approval_gate",
            "blocked_boundary",
            "operator_controls"
          ],
          "properties": {
            "banner_label": { "type": "string", "minLength": 1 },
            "scope_repr": { "type": "string", "minLength": 1 },
            "execution_mode": { "$ref": "#/$defs/execution_mode" },
            "action_state": { "type": "string" },
            "scope_reach": { "$ref": "#/$defs/scope_reach" },
            "placement": { "$ref": "#/$defs/placement" },
            "approval_gate": { "type": "string" },
            "blocked_boundary": {
              "oneOf": [{ "$ref": "#/$defs/blocked_boundary" }, { "type": "null" }]
            },
            "operator_controls": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/operator_control" }
            }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "banner_label",
            "scope_repr",
            "execution_mode",
            "action_state",
            "scope_reach",
            "placement",
            "approval_gate",
            "blocked_boundary",
            "operator_controls",
            "banner_posture",
            "is_active",
            "is_boundary_blocked",
            "needs_operator_attention",
            "boundary_banner"
          ],
          "properties": {
            "banner_label": { "type": "string", "minLength": 1 },
            "scope_repr": { "type": "string", "minLength": 1 },
            "execution_mode": { "$ref": "#/$defs/execution_mode" },
            "action_state": { "type": "string" },
            "scope_reach": { "$ref": "#/$defs/scope_reach" },
            "placement": { "$ref": "#/$defs/placement" },
            "approval_gate": { "type": "string" },
            "blocked_boundary": {
              "oneOf": [{ "$ref": "#/$defs/blocked_boundary" }, { "type": "null" }]
            },
            "operator_controls": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/operator_control" }
            },
            "banner_posture": { "$ref": "#/$defs/banner_posture" },
            "is_active": { "type": "boolean" },
            "is_boundary_blocked": { "type": "boolean" },
            "needs_operator_attention": { "type": "boolean" },
            "boundary_banner": {
              "oneOf": [{ "$ref": "#/$defs/boundary_banner" }, { "type": "null" }]
            }
          }
        }
      }
    },
    "boundary_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_boundary",
        "safe_alternative",
        "scope_reach",
        "placement",
        "headline"
      ],
      "properties": {
        "blocked_boundary": { "$ref": "#/$defs/blocked_boundary" },
        "safe_alternative": { "$ref": "#/$defs/safe_alternative" },
        "scope_reach": { "$ref": "#/$defs/scope_reach" },
        "placement": { "$ref": "#/$defs/placement" },
        "headline": { "type": "string", "minLength": 1 }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "anatomy_parts",
        "scope_reaches",
        "placements",
        "operator_controls",
        "banner_postures",
        "blocked_boundaries",
        "safe_alternatives",
        "export_fields",
        "execution_modes",
        "action_states",
        "approval_gates",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "scope_reaches": { "type": "array", "items": { "type": "string" } },
        "placements": { "type": "array", "items": { "type": "string" } },
        "operator_controls": { "type": "array", "items": { "type": "string" } },
        "banner_postures": { "type": "array", "items": { "type": "string" } },
        "blocked_boundaries": { "type": "array", "items": { "type": "string" } },
        "safe_alternatives": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "execution_modes": { "type": "array", "items": { "type": "string" } },
        "action_states": { "type": "array", "items": { "type": "string" } },
        "approval_gates": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "consumer_surface": {
      "enum": [
        "inline_explain_fix",
        "assistant_panel",
        "patch_review",
        "branch_worktree_agent",
        "cli_support_export"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "anatomy_part": {
      "enum": [
        "execution_mode_badge",
        "scope_reach_cue",
        "placement_cue",
        "approval_posture_cue",
        "action_state_cue",
        "operator_controls",
        "boundary_blocked_banner",
        "next_safe_action_cue"
      ]
    },
    "execution_mode": {
      "enum": [
        "foreground_assistant",
        "guided_patch",
        "background_branch_agent",
        "review_first_placement",
        "headless_automation"
      ]
    },
    "scope_reach": {
      "enum": [
        "single_selection",
        "current_file",
        "reviewed_file_set",
        "workspace_scoped",
        "connector_scoped",
        "cross_workspace_scoped"
      ]
    },
    "placement": {
      "enum": [
        "inline_overlay",
        "assistant_side_panel",
        "review_lane",
        "background_branch_worktree",
        "tool_run_timeline"
      ]
    },
    "operator_control": {
      "enum": ["open_plan", "pause", "cancel", "resume", "take_over", "narrow_scope"]
    },
    "banner_posture": {
      "enum": [
        "active_within_scope",
        "active_awaiting_approval",
        "paused_mid_run",
        "boundary_blocked",
        "completed_clear",
        "failed_needs_attention",
        "idle_ready"
      ]
    },
    "blocked_boundary": {
      "enum": [
        "reviewed_file_scope",
        "connector_boundary",
        "policy_fence",
        "credential_boundary",
        "network_egress_fence",
        "cross_workspace_scope"
      ]
    },
    "safe_alternative": {
      "enum": [
        "narrow_to_reviewed_scope",
        "request_connector_approval",
        "request_scoped_credential",
        "split_into_approved_steps",
        "stay_within_current_workspace",
        "run_read_only_preview"
      ]
    },
    "export_field": {
      "enum": [
        "execution_mode",
        "action_state",
        "scope_reach",
        "placement",
        "approval_gate",
        "banner_posture",
        "blocked_boundary",
        "safe_alternative",
        "operator_controls",
        "banner_label"
      ]
    }
  }
}
