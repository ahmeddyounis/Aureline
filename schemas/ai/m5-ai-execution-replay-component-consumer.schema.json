{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-ai-execution-replay-component-consumer.schema.json",
  "title": "M5 AI Execution/Replay-Component Consumer Packet",
  "description": "Adoption matrix binding every claimed M5 AI execution/replay consumer (patch review, evidence inspector, branch/worktree queue, support export, docs/help) to the eight canonical AI execution/replay component families, so route, approval, checkpoint-lineage, and replay-completeness truth stays aligned and auto-narrows on drift or missing evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_patch_review_evidence_inspector_branch_worktree_queue_support_export_and_docs_help_ai_execution_replay_component_consumers"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumerRow" }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumers",
        "component_families",
        "descriptors",
        "replay_health_modes",
        "export_caveats",
        "narrowing_reasons",
        "recovery_actions",
        "claim_parity_states",
        "anatomy_parts",
        "export_fields",
        "accessibility_routes"
      ],
      "properties": {
        "consumers": { "$ref": "#/$defs/tokenList" },
        "component_families": { "$ref": "#/$defs/tokenList" },
        "descriptors": { "$ref": "#/$defs/tokenList" },
        "replay_health_modes": { "$ref": "#/$defs/tokenList" },
        "export_caveats": { "$ref": "#/$defs/tokenList" },
        "narrowing_reasons": { "$ref": "#/$defs/tokenList" },
        "recovery_actions": { "$ref": "#/$defs/tokenList" },
        "claim_parity_states": { "$ref": "#/$defs/tokenList" },
        "anatomy_parts": { "$ref": "#/$defs/tokenList" },
        "export_fields": { "$ref": "#/$defs/tokenList" },
        "accessibility_routes": { "$ref": "#/$defs/tokenList" }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "tokenList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "consumer": {
      "enum": [
        "patch_review",
        "evidence_inspector",
        "branch_worktree_queue",
        "support_export",
        "docs_help"
      ]
    },
    "componentFamily": {
      "enum": [
        "ai_action_state_banner",
        "connector_detail_row",
        "local_model_pack_card",
        "approval_sheet",
        "tool_call_timeline_row",
        "run_history_row",
        "replay_review",
        "agent_status"
      ]
    },
    "replayHealth": {
      "enum": [
        "full_replay",
        "route_provider_model_drift",
        "missing_connector_output",
        "redaction_fenced",
        "stale_approval"
      ]
    },
    "claimParityState": {
      "enum": ["claims_preserved", "claims_auto_narrowed"]
    },
    "consumerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "replay_health_modes",
        "export_caveats",
        "claim_parity_states",
        "narrowing_reasons",
        "recovery_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewords_claims_per_surface",
        "invents_new_execution_grammar",
        "drops_route_or_approval_when_narrowed",
        "hides_drift_reason_or_takeover_path"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "$ref": "#/$defs/tokenList" },
        "deployment_lines": { "$ref": "#/$defs/tokenList" },
        "anatomy_parts": { "$ref": "#/$defs/tokenList" },
        "descriptor_families": { "$ref": "#/$defs/tokenList" },
        "replay_health_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/replayHealth" }
        },
        "export_caveats": { "$ref": "#/$defs/tokenList" },
        "claim_parity_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimParityState" }
        },
        "narrowing_reasons": { "$ref": "#/$defs/tokenList" },
        "recovery_actions": { "$ref": "#/$defs/tokenList" },
        "export_fields": { "$ref": "#/$defs/tokenList" },
        "accessibility_routes": { "$ref": "#/$defs/tokenList" },
        "consumer_surfaces": { "$ref": "#/$defs/tokenList" },
        "downgrade_triggers": { "$ref": "#/$defs/tokenList" },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentBinding" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rewords_claims_per_surface": { "type": "boolean" },
        "invents_new_execution_grammar": { "type": "boolean" },
        "drops_route_or_approval_when_narrowed": { "type": "boolean" },
        "hides_drift_reason_or_takeover_path": { "type": "boolean" }
      }
    },
    "componentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/componentFamily" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bindingCase" }
        }
      }
    },
    "bindingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/bindingInput" },
        "resolved": { "$ref": "#/$defs/resolvedBinding" }
      }
    },
    "bindingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "descriptor_families",
        "replay_health",
        "export_caveats"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/componentFamily" },
        "descriptor_families": { "$ref": "#/$defs/tokenList" },
        "replay_health": { "$ref": "#/$defs/replayHealth" },
        "export_caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "note_repr": { "type": ["string", "null"] }
      }
    },
    "resolvedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "canonical_schema_ref",
        "descriptor_families",
        "replay_health",
        "export_caveats",
        "claim_parity_state",
        "is_narrowed",
        "auto_narrow_banner"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/componentFamily" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "descriptor_families": { "$ref": "#/$defs/tokenList" },
        "replay_health": { "$ref": "#/$defs/replayHealth" },
        "export_caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "claim_parity_state": { "$ref": "#/$defs/claimParityState" },
        "is_narrowed": { "type": "boolean" },
        "auto_narrow_banner": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/autoNarrowBanner" }
          ]
        }
      }
    },
    "autoNarrowBanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "recovery_action",
        "consumer",
        "component_family",
        "preserved_descriptors",
        "export_caveats",
        "headline"
      ],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "recovery_action": { "type": "string", "minLength": 1 },
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/componentFamily" },
        "preserved_descriptors": { "$ref": "#/$defs/tokenList" },
        "export_caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "headline": { "type": "string", "minLength": 1 }
      }
    }
  }
}
