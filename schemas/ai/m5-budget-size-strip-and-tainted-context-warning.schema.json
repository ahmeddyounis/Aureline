        "provider_changed"
      ]
    },
    "budget_action": {
      "enum": [
        "inspect_omitted_context",
        "review_route_change",
        "adjust_budget_or_scope",
        "reduce_context",
        "proceed_to_send"
      ]
    },
    "route_class": {
      "enum": [
        "local_model",
        "byok_direct",
        "managed_route",
        "self_hosted_route",
        "mirrored_route",
        "policy_pinned_route"
      ]
    },
    "taint_source": {
      "enum": [
        "pasted_external_text",
        "tool_output",
        "fetched_url_content",
        "untrusted_file",
        "third_party_connector",
        "prior_model_output"
      ]
    },
    "taint_severity": {
      "enum": ["none", "informational", "elevated", "quarantine_required", "injection_suspected"]
    },
    "taint_warning_posture": {
      "enum": [
        "no_taint_trusted",
        "flagged_as_data",
        "elevated_review_required",
        "quarantine_held",
        "injection_blocked",
        "acknowledged_proceedable"
      ]
    },
    "taint_action": {
      "enum": [
        "review_tainted_content",
        "quarantine_content",
        "remove_from_context",
        "acknowledge_as_data",
        "proceed_with_send"
      ]
    },
    "budget_export_field": {
      "enum": [
        "strip_id",
        "budget_posture",
        "pressure_band",
        "included_context_classes",
        "omitted_entries",
        "route_switch",
        "requires_review_before_send",
        "available_actions"
      ]
    },
    "taint_export_field": {
      "enum": [
        "warning_id",
        "taint_source",
        "taint_severity",
        "warning_posture",
        "treated_as_data",
        "blocks_send",
        "requires_review_before_send",
        "available_actions"
      ]
    }
  }
}
