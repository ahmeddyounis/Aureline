        "near_limit",
        "over_budget",
        "truncation_pending",
        "hard_blocked",
        "unmetered_local"
      ]
    },
    "pressure_band": {
      "enum": ["unmetered", "nominal", "watch", "critical", "exhausted"]
    },
    "omitted_reason": {
      "enum": [
        "none_omitted",
        "size_truncated",
        "budget_capped",
        "policy_excluded",
        "dedup_collapsed",
        "stale_dropped"
      ]
    },
    "context_class": {
      "enum": [
