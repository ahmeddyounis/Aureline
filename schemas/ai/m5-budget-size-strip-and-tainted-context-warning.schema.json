{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-budget-size-strip-and-tainted-context-warning.schema.json",
  "title": "Aureline M5 budget-size-strip / tainted-context-warning primitive",
  "description": "Export-safe packet implementing the reusable M5 budget-or-size strip (with its omitted-context drawer) and tainted-context warning as one primitive pair. The packet binds one row per claimed send-capable composer consumer — the inline composer, the side panel, the patch draft, the CLI / headless surface, and the support export — to the shared budget and taint anatomy, the derived budget posture (within_budget/near_limit/over_budget/truncation_pending/hard_blocked/unmetered_local), the derived pressure band, the omitted-context drawer (each entry naming its context class, reason, and detail), the derived route-switch consequence (unchanged/locality_changed/reach_widened/reach_narrowed/provider_changed), the taint source, the taint severity, the derived warning posture (no_taint_trusted/flagged_as_data/elevated_review_required/quarantine_held/injection_blocked/acknowledged_proceedable), the bounded inspect/adjust/review/reduce/proceed and review/quarantine/remove/acknowledge/proceed actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked budget and warning resolution cases proving the resolvers, and four hard invariants: it never masks budget or omission truth, never downplays a taint source or severity, never invents a private context grammar, and never bypasses review before a side-effecting send. Raw prompts, pasted bodies, tool-output bodies, raw paths, raw URLs, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_budget_size_strips_omitted_context_drawers_and_tainted_context_warnings_with_token_pressure_truncation_route_change_and_review_before_send_truth_across_claimed_m5_ai_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "budget_anatomy_parts",
        "taint_anatomy_parts",
        "budget_postures",
        "pressure_bands",
        "omitted_reasons",
        "context_classes",
        "route_switch_consequences",
        "budget_actions",
        "taint_sources",
        "taint_severities",
        "taint_warning_postures",
        "taint_actions",
        "budget_export_fields",
        "taint_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "budget_examples",
        "taint_examples",
        "masks_budget_or_omission_truth",
        "downplays_taint_source_or_severity",
        "invents_private_context_grammar",
        "bypasses_review_before_side_effecting_send"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "budget_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/budget_anatomy_part" }
        },
        "taint_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/taint_anatomy_part" }
        },
        "budget_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/budget_posture" }
        },
        "pressure_bands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pressure_band" }
        },
        "omitted_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/omitted_reason" }
        },
        "context_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/context_class" }
        },
        "route_switch_consequences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route_switch_consequence" }
        },
        "budget_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/budget_action" }
        },
        "taint_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taint_source" }
        },
        "taint_severities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taint_severity" }
        },
        "taint_warning_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taint_warning_posture" }
        },
        "taint_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taint_action" }
        },
        "budget_export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/budget_export_field" }
        },
        "taint_export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/taint_export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "budget_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/budget_case" }
        },
        "taint_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taint_case" }
        },
        "masks_budget_or_omission_truth": { "const": false },
        "downplays_taint_source_or_severity": { "const": false },
        "invents_private_context_grammar": { "const": false },
        "bypasses_review_before_side_effecting_send": { "const": false }
      }
    },
    "omitted_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_class", "reason", "detail"],
      "properties": {
        "context_class": { "$ref": "#/$defs/context_class" },
        "reason": { "$ref": "#/$defs/omitted_reason" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "budget_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strip_id",
            "strip_label",
            "included_context_classes",
            "omitted_entries",
            "unmetered_local",
            "hard_ceiling_hit",
            "over_budget",
            "truncation_pending",
            "near_limit",
            "route_before",
            "route_after"
          ],
          "properties": {
            "strip_id": { "type": "string", "minLength": 1 },
            "strip_label": { "type": "string", "minLength": 1 },
            "included_context_classes": {
              "type": "array",
              "items": { "$ref": "#/$defs/context_class" }
            },
            "omitted_entries": { "type": "array", "items": { "$ref": "#/$defs/omitted_entry" } },
            "unmetered_local": { "type": "boolean" },
            "hard_ceiling_hit": { "type": "boolean" },
            "over_budget": { "type": "boolean" },
            "truncation_pending": { "type": "boolean" },
            "near_limit": { "type": "boolean" },
            "route_before": {
              "anyOf": [{ "$ref": "#/$defs/route_class" }, { "type": "null" }]
            },
            "route_after": { "$ref": "#/$defs/route_class" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strip_id",
            "strip_label",
            "included_context_classes",
            "omitted_entries",
            "budget_posture",
            "pressure_band",
            "route_before",
            "route_after",
            "route_switch",
            "available_actions",
            "has_omitted_context",
            "truncation_active",
            "route_changed",
            "is_sendable",
            "requires_review_before_send",
            "discloses_every_omission"
          ],
          "properties": {
            "strip_id": { "type": "string", "minLength": 1 },
            "strip_label": { "type": "string", "minLength": 1 },
            "included_context_classes": {
              "type": "array",
              "items": { "$ref": "#/$defs/context_class" }
            },
            "omitted_entries": { "type": "array", "items": { "$ref": "#/$defs/omitted_entry" } },
            "budget_posture": { "$ref": "#/$defs/budget_posture" },
            "pressure_band": { "$ref": "#/$defs/pressure_band" },
            "route_before": {
              "anyOf": [{ "$ref": "#/$defs/route_class" }, { "type": "null" }]
            },
            "route_after": { "$ref": "#/$defs/route_class" },
            "route_switch": { "$ref": "#/$defs/route_switch_consequence" },
            "available_actions": {
              "type": "array",
              "items": { "$ref": "#/$defs/budget_action" }
            },
            "has_omitted_context": { "type": "boolean" },
            "truncation_active": { "type": "boolean" },
            "route_changed": { "type": "boolean" },
            "is_sendable": { "type": "boolean" },
            "requires_review_before_send": { "type": "boolean" },
            "discloses_every_omission": { "type": "boolean" }
          }
        }
      }
    },
    "taint_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warning_id",
            "context_label",
            "taint_source",
            "taint_severity",
            "treated_as_data",
            "side_effecting_route",
            "acknowledged",
            "quarantine_note"
          ],
          "properties": {
            "warning_id": { "type": "string", "minLength": 1 },
            "context_label": { "type": "string", "minLength": 1 },
            "taint_source": { "$ref": "#/$defs/taint_source" },
            "taint_severity": { "$ref": "#/$defs/taint_severity" },
            "treated_as_data": { "type": "boolean" },
            "side_effecting_route": { "type": "boolean" },
            "acknowledged": { "type": "boolean" },
            "quarantine_note": { "type": ["string", "null"] }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warning_id",
            "context_label",
            "taint_source",
            "taint_severity",
            "treated_as_data",
            "side_effecting_route",
            "acknowledged",
            "warning_posture",
            "quarantine_note",
            "available_actions",
            "blocks_send",
            "requires_review_before_send",
            "preserves_review_path",
            "treats_untrusted_as_data"
          ],
          "properties": {
            "warning_id": { "type": "string", "minLength": 1 },
            "context_label": { "type": "string", "minLength": 1 },
            "taint_source": { "$ref": "#/$defs/taint_source" },
            "taint_severity": { "$ref": "#/$defs/taint_severity" },
            "treated_as_data": { "type": "boolean" },
            "side_effecting_route": { "type": "boolean" },
            "acknowledged": { "type": "boolean" },
            "warning_posture": { "$ref": "#/$defs/taint_warning_posture" },
            "quarantine_note": { "type": ["string", "null"] },
            "available_actions": {
              "type": "array",
              "items": { "$ref": "#/$defs/taint_action" }
            },
            "blocks_send": { "type": "boolean" },
            "requires_review_before_send": { "type": "boolean" },
            "preserves_review_path": { "type": "boolean" },
            "treats_untrusted_as_data": { "type": "boolean" }
          }
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "budget_anatomy_parts",
        "taint_anatomy_parts",
        "budget_postures",
        "pressure_bands",
        "omitted_reasons",
        "context_classes",
        "route_switch_consequences",
        "budget_actions",
        "taint_sources",
        "taint_severities",
        "taint_warning_postures",
        "taint_actions",
        "budget_export_fields",
        "taint_export_fields",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "budget_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "taint_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "budget_postures": { "type": "array", "items": { "type": "string" } },
        "pressure_bands": { "type": "array", "items": { "type": "string" } },
        "omitted_reasons": { "type": "array", "items": { "type": "string" } },
        "context_classes": { "type": "array", "items": { "type": "string" } },
        "route_switch_consequences": { "type": "array", "items": { "type": "string" } },
        "budget_actions": { "type": "array", "items": { "type": "string" } },
        "taint_sources": { "type": "array", "items": { "type": "string" } },
        "taint_severities": { "type": "array", "items": { "type": "string" } },
        "taint_warning_postures": { "type": "array", "items": { "type": "string" } },
        "taint_actions": { "type": "array", "items": { "type": "string" } },
        "budget_export_fields": { "type": "array", "items": { "type": "string" } },
        "taint_export_fields": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "consumer_surface": {
      "enum": ["inline_composer", "side_panel", "patch_draft", "cli_headless", "support_export"]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "budget_anatomy_part": {
