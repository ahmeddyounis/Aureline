        "consumer_surfaces",
        "accessibility_routes",
        "required_labels"
      ],
      "properties": {
        "component_families": { "type": "array", "items": { "type": "string" } },
        "action_states": { "type": "array", "items": { "type": "string" } },
        "execution_modes": { "type": "array", "items": { "type": "string" } },
        "connector_capabilities": { "type": "array", "items": { "type": "string" } },
        "auth_postures": { "type": "array", "items": { "type": "string" } },
        "model_pack_states": { "type": "array", "items": { "type": "string" } },
        "approval_gates": { "type": "array", "items": { "type": "string" } },
        "friction_reasons": { "type": "array", "items": { "type": "string" } },
        "tool_boundaries": { "type": "array", "items": { "type": "string" } },
        "side_effect_classes": { "type": "array", "items": { "type": "string" } },
        "run_outcomes": { "type": "array", "items": { "type": "string" } },
        "replay_completeness": { "type": "array", "items": { "type": "string" } },
        "rerun_review_reasons": { "type": "array", "items": { "type": "string" } },
        "agent_lifecycle_states": { "type": "array", "items": { "type": "string" } },
        "takeover_paths": { "type": "array", "items": { "type": "string" } },
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "items": { "type": "string" } },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } },
        "required_labels": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
