{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/freeze-the-m5-ai-action-state-banner-connector-detail-row-local-model-pack-card-approval-sheet-tool-call-timeline-row-run-history-row-replay-review-and-agent-status-component-matrix.schema.json",
  "title": "Aureline M5 AI-execution/replay component matrix",
  "description": "Export-safe packet freezing the canonical M5 AI-execution and replay component matrix. The packet names every governed AI component family — the AI action-state banner, the connector/tool-server detail row, the local model pack card, the high-friction approval sheet, the tool-call timeline row, the AI run-history row, the replay/rerun-review sheet, and the agent-status card — and binds each to its qualification class, mandatory and truth labels, the controlled state vocabularies it carries, the AI surface families and deployment lines it must survive with the same truth, the non-visual accessibility routes it must offer, the consumer surfaces that read its projection, the downgrade triggers that narrow it, its required proof packet refs, its source contracts, and four hard component invariants. A self-describing vocabulary set freezes the controlled vocabulary for action state, execution mode, connector capability, auth posture, local-model pack state, approval gate, friction reason, tool boundary, side-effect class, run outcome, replay completeness, rerun-review reason, agent lifecycle state, manual-takeover path, AI surface family, deployment line, consumer surface, accessibility route, and required label. Raw prompts, model payloads, raw URLs, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_ai_action_state_banner_connector_detail_row_local_model_pack_card_high_friction_approval_sheet_tool_call_timeline_row_run_history_row_replay_review_and_agent_status_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component_family": {
      "enum": [
        "ai_action_state_banner",
        "connector_detail_row",
        "local_model_pack_card",
        "approval_sheet",
        "tool_call_timeline_row",
        "run_history_row",
        "replay_review",
        "agent_status"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "action_state": {
      "enum": [
        "idle",
        "composing",
        "streaming",
        "tool_running",
        "awaiting_approval",
        "paused",
        "boundary_blocked",
        "completed",
        "failed"
      ]
    },
    "execution_mode": {
      "enum": [
        "foreground_assistant",
        "guided_patch",
        "background_branch_agent",
        "review_first_placement",
        "headless_automation"
      ]
    },
    "connector_capability": {
      "enum": [
        "read_only_query",
        "file_mutation",
        "network_egress",
        "shell_execution",
        "external_service_call",
        "credential_scoped"
      ]
    },
    "auth_posture": {
      "enum": [
        "oauth_delegated",
        "managed_credential",
        "byok_scoped",
        "service_account",
        "token_scoped",
        "unauthenticated"
      ]
    },
    "model_pack_state": {
      "enum": [
        "installed",
        "mirrored",
        "offline_only",
        "quarantined",
        "hardware_unfit",
        "update_available",
        "provenance_unverified"
      ]
    },
    "approval_gate": {
      "enum": [
        "auto_approved",
        "notify_only",
        "one_click_confirm",
        "high_friction_typed",
        "two_person_review",
        "policy_blocked"
      ]
    },
    "friction_reason": {
      "enum": [
        "irreversible_side_effect",
        "external_network_egress",
        "credential_access",
        "cross_tenant_scope",
        "destructive_file_change",
        "policy_mandated_review"
      ]
    },
    "tool_boundary": {
      "enum": [
        "in_process",
        "local_sandbox",
        "local_shell",
        "remote_connector",
        "external_service",
        "host_delegated"
      ]
    },
    "side_effect_class": {
      "enum": [
        "read_only",
        "file_write",
        "network_call",
        "process_spawn",
        "state_mutation",
        "destructive"
      ]
    },
    "run_outcome": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "superseded",
        "partially_applied",
        "awaiting_review"
      ]
    },
    "replay_completeness": {
      "enum": [
        "fully_replayable",
        "partially_replayable",
        "incomplete_replay",
        "non_deterministic",
        "missing_inputs",
        "provider_drifted"
      ]
    },
    "rerun_review_reason": {
      "enum": [
        "model_version_changed",
        "tool_contract_changed",
        "input_context_changed",
        "route_or_provider_changed",
        "policy_changed",
        "no_re_review_required"
      ]
    },
    "agent_lifecycle_state": {
      "enum": [
        "running",
        "paused",
        "blocked_on_approval",
        "awaiting_takeover",
        "handed_off",
        "completed",
        "abandoned"
      ]
    },
    "takeover_path": {
      "enum": [
        "resume_in_place",
        "take_over_locally",
        "branch_review_handoff",
        "abort_with_checkpoint",
        "escalate_to_owner",
        "no_takeover_possible"
      ]
    },
    "surface_family": {
      "enum": [
        "assistant_panel",
        "patch_review",
        "branch_agent_console",
        "connector_admin",
        "model_manager",
        "run_history",
        "replay_review",
        "support_desk"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "consumer_surface": {
      "enum": [
        "assistant_panel_ui",
        "patch_review_ui",
        "branch_agent_console_ui",
        "connector_admin_console",
        "model_manager_ui",
        "run_history_ui",
        "replay_review_ui",
        "support_export",
        "cli_inspect",
        "product_ui"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "enum": ["identity", "state", "keyboard_route", "execution_mode", "route", "approval_gate"]
    },
    "downgrade_trigger": {
      "enum": [
        "execution_mode_unstated",
        "route_or_provider_masked",
        "tool_boundary_unstated",
        "auth_posture_masked",
        "approval_gate_hidden",
        "checkpoint_lineage_broken",
        "replay_completeness_overstated",
        "rerun_review_reason_unstated",
        "takeover_path_hidden",
        "connector_side_effect_undisclosed",
        "local_model_provenance_masked",
        "proof_stale"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "action_states",
        "execution_modes",
        "connector_capabilities",
        "auth_postures",
        "model_pack_states",
        "approval_gates",
        "friction_reasons",
        "tool_boundaries",
        "side_effect_classes",
        "run_outcomes",
        "replay_completeness",
        "rerun_review_reasons",
        "agent_lifecycle_states",
        "takeover_paths",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_execution_mode_or_route",
        "overstates_replay_completeness",
        "invents_private_ai_status_grammar",
        "hides_approval_gate_or_takeover_path"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "action_states": { "type": "array", "items": { "$ref": "#/$defs/action_state" } },
        "execution_modes": { "type": "array", "items": { "$ref": "#/$defs/execution_mode" } },
        "connector_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/connector_capability" }
        },
        "auth_postures": { "type": "array", "items": { "$ref": "#/$defs/auth_posture" } },
        "model_pack_states": { "type": "array", "items": { "$ref": "#/$defs/model_pack_state" } },
        "approval_gates": { "type": "array", "items": { "$ref": "#/$defs/approval_gate" } },
        "friction_reasons": { "type": "array", "items": { "$ref": "#/$defs/friction_reason" } },
        "tool_boundaries": { "type": "array", "items": { "$ref": "#/$defs/tool_boundary" } },
        "side_effect_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/side_effect_class" }
        },
        "run_outcomes": { "type": "array", "items": { "$ref": "#/$defs/run_outcome" } },
        "replay_completeness": {
          "type": "array",
          "items": { "$ref": "#/$defs/replay_completeness" }
        },
        "rerun_review_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/rerun_review_reason" }
        },
        "agent_lifecycle_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/agent_lifecycle_state" }
        },
        "takeover_paths": { "type": "array", "items": { "$ref": "#/$defs/takeover_path" } },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "masks_execution_mode_or_route": { "const": false },
        "overstates_replay_completeness": { "const": false },
        "invents_private_ai_status_grammar": { "const": false },
        "hides_approval_gate_or_takeover_path": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_families",
        "action_states",
        "execution_modes",
        "connector_capabilities",
        "auth_postures",
        "model_pack_states",
        "approval_gates",
        "friction_reasons",
        "tool_boundaries",
        "side_effect_classes",
        "run_outcomes",
