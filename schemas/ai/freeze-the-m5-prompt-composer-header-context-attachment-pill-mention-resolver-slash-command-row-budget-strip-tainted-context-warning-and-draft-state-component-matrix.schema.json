        "taint_severities": { "type": "array", "items": { "type": "string" } },
        "draft_localities": { "type": "array", "items": { "type": "string" } },
        "staleness_reasons": { "type": "array", "items": { "type": "string" } },
        "send_postures": { "type": "array", "items": { "type": "string" } },
        "review_requirements": { "type": "array", "items": { "type": "string" } },
