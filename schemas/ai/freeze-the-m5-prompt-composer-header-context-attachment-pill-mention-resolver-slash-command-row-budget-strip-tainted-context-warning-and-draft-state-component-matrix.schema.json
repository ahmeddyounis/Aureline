{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/freeze-the-m5-prompt-composer-header-context-attachment-pill-mention-resolver-slash-command-row-budget-strip-tainted-context-warning-and-draft-state-component-matrix.schema.json",
  "title": "Aureline M5 prompt-composer component matrix",
  "description": "Export-safe packet freezing the canonical M5 pre-send prompt-composition component matrix. The packet names every governed composer subcomponent — the prompt-composer header, the context-attachment pill, the mention resolver, the slash-command row, the budget/size strip, the tainted-context warning, the draft-state row, the attachment-stale banner, and the split-send / review-before-send control — and binds each to its qualification class, mandatory and truth labels, the controlled state vocabularies it carries, the composer surface families and deployment lines it must survive with the same truth, the non-visual accessibility routes it must offer, the consumer surfaces that read its projection, the downgrade triggers that narrow it, its required proof packet refs, its source contracts, and four hard component invariants. A self-describing vocabulary set freezes the controlled vocabulary for composer mode, scope, route class, attachment kind, attachment trust state, mention resolution, slash-command state, budget posture, omitted-context reason, taint source, taint severity, draft locality, staleness reason, send posture, review requirement, composer surface family, deployment line, consumer surface, accessibility route, and required label. Raw prompts, pasted bodies, attachment contents, raw URLs, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_prompt_composer_header_context_attachment_pill_mention_resolver_slash_command_row_budget_size_strip_tainted_context_warning_draft_state_row_attachment_stale_banner_and_send_review_control_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "component_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component_family": {
      "enum": [
        "prompt_composer_header",
        "context_attachment_pill",
        "mention_resolver",
        "slash_command_row",
        "budget_size_strip",
        "tainted_context_warning",
        "draft_state_row",
        "attachment_stale_banner",
        "send_review_control"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "composer_mode": {
      "enum": [
        "chat_ask",
        "inline_edit",
        "guided_patch",
        "background_agent",
        "review_first",
        "headless_automation"
      ]
