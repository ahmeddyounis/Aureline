        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "masks_mode_or_route": { "const": false },
        "hides_taint_or_trust_state": { "const": false },
        "invents_private_composer_grammar": { "const": false },
        "bypasses_send_review_gate": { "const": false }
