        "resolved_pinned",
        "ambiguous_candidates",
        "unresolved_missing",
        "out_of_scope_denied",
        "deferred_pending"
      ]
    },
    "slash_command_state": {
      "enum": [
        "available",
        "disabled_unmet_precondition",
        "requires_approval",
        "deprecated_aliased",
        "policy_hidden",
        "unknown_command"
      ]
    },
    "budget_posture": {
      "enum": [
        "within_budget",
