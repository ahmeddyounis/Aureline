        "taint_blocked"
      ]
    },
    "review_requirement": {
      "enum": ["none", "attachment_review", "taint_ack", "budget_ack", "route_change_ack"]
    },
    "surface_family": {
      "enum": [
        "inline_composer",
        "composer_panel",
        "patch_review",
        "branch_agent_console",
        "help_composer",
        "companion_composer",
        "support_desk"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "consumer_surface": {
      "enum": [
        "inline_composer_ui",
        "composer_panel_ui",
        "patch_review_ui",
        "branch_agent_console_ui",
        "help_composer_ui",
        "companion_composer_ui",
        "support_export",
        "cli_inspect",
        "product_ui"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "composer_mode",
        "route_provider_model",
        "trust_or_taint"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "composer_mode_unstated",
        "route_or_provider_masked",
        "attachment_identity_unstated",
        "attachment_freshness_masked",
        "taint_state_hidden",
        "omitted_context_undisclosed",
        "mention_left_unresolved",
        "budget_overrun_hidden",
        "draft_locality_masked",
        "send_review_gate_bypassed",
        "attachment_staleness_undisclosed",
        "proof_stale"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
