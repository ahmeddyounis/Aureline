        "composer_scopes": { "type": "array", "items": { "$ref": "#/$defs/composer_scope" } },
        "route_classes": { "type": "array", "items": { "$ref": "#/$defs/route_class" } },
        "attachment_kinds": { "type": "array", "items": { "$ref": "#/$defs/attachment_kind" } },
        "attachment_trust_states": {
