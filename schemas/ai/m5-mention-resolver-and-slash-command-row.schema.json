{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-mention-resolver-and-slash-command-row.schema.json",
  "title": "Aureline M5 mention-resolver / slash-command-row primitive",
  "description": "Export-safe packet implementing the reusable M5 mention resolver and slash-command row as one primitive pair. The packet binds one row per claimed composer consumer — the inline composer, the command palette, the automation recipe, the CLI / headless surface, and the support export — to the shared mention and command anatomy, the derived mention resolution (resolved-unique/resolved-pinned/ambiguous-candidates/unresolved-missing/out-of-scope-denied/deferred-pending), the derived slash-command row posture (ready-invocable/approval-gated/disabled-explained/deprecated-redirect/policy-hidden/unknown-rejected), the slash-command capability classes, availability states, bounded open/choose/edit/remove/reveal and invoke/request-approval/open-help/view-canonical/explain-disabled actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked mention and command resolution cases proving the resolvers, and four hard invariants: it never masks a command's identity or capability, never hides a mention's resolution or ambiguity, never invents a private command grammar, and never bypasses the ambiguity or approval gate. Raw prompts, mention query bodies, command bodies, raw argument values, raw paths, raw URLs, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "ship_m5_mention_resolvers_and_slash_command_rows_with_exact_target_previews_ambiguity_review_stable_command_ids_and_disabled_state_explanations_across_claimed_m5_composer_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "mention_anatomy_parts",
        "slash_anatomy_parts",
        "mention_resolutions",
        "mention_actions",
        "slash_command_states",
        "capability_classes",
        "slash_row_postures",
        "slash_actions",
        "mention_export_fields",
        "slash_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "mention_examples",
        "slash_examples",
        "masks_command_identity_or_capability",
        "hides_mention_resolution_or_ambiguity",
        "invents_private_command_grammar",
        "bypasses_ambiguity_or_approval_gate"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "mention_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/mention_anatomy_part" }
        },
        "slash_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/slash_anatomy_part" }
        },
        "mention_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mention_resolution" }
        },
        "mention_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mention_action" }
        },
        "slash_command_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "capability_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability_class" }
        },
        "slash_row_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slash_row_posture" }
        },
        "slash_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slash_action" }
        },
        "mention_export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/mention_export_field" }
        },
        "slash_export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/slash_export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mention_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mention_case" }
        },
        "slash_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slash_case" }
        },
        "masks_command_identity_or_capability": { "const": false },
        "hides_mention_resolution_or_ambiguity": { "const": false },
        "invents_private_command_grammar": { "const": false },
        "bypasses_ambiguity_or_approval_gate": { "const": false }
      }
    },
    "mention_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mention_token",
            "scope_note",
            "candidate_count",
            "has_exact_stable_target",
            "target_is_pinned",
            "target_object_id",
            "target_preview_label",
            "in_scope",
            "deferred"
          ],
          "properties": {
            "mention_token": { "type": "string", "minLength": 1 },
            "scope_note": { "type": "string", "minLength": 1 },
            "candidate_count": { "type": "integer", "minimum": 0 },
            "has_exact_stable_target": { "type": "boolean" },
            "target_is_pinned": { "type": "boolean" },
            "target_object_id": { "type": ["string", "null"] },
            "target_preview_label": { "type": ["string", "null"] },
            "in_scope": { "type": "boolean" },
            "deferred": { "type": "boolean" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mention_token",
            "scope_note",
            "candidate_count",
            "resolution",
            "target_object_id",
            "target_preview_label",
            "available_actions",
            "is_bound",
            "blocks_send",
            "needs_explicit_review",
            "preserves_exact_target_preview"
          ],
          "properties": {
            "mention_token": { "type": "string", "minLength": 1 },
            "scope_note": { "type": "string", "minLength": 1 },
            "candidate_count": { "type": "integer", "minimum": 0 },
            "resolution": { "$ref": "#/$defs/mention_resolution" },
            "target_object_id": { "type": ["string", "null"] },
            "target_preview_label": { "type": ["string", "null"] },
            "available_actions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/mention_action" }
            },
            "is_bound": { "type": "boolean" },
            "blocks_send": { "type": "boolean" },
            "needs_explicit_review": { "type": "boolean" },
            "preserves_exact_target_preview": { "type": "boolean" }
          }
        }
      }
    },
    "slash_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_id",
            "command_label",
            "capability_class",
            "help_path",
            "state",
            "requires_approval",
            "disabled_reason",
            "alias_of"
          ],
          "properties": {
            "command_id": { "type": "string", "minLength": 1 },
            "command_label": { "type": "string", "minLength": 1 },
            "capability_class": { "$ref": "#/$defs/capability_class" },
            "help_path": { "type": "string", "minLength": 1 },
            "state": { "type": "string" },
            "requires_approval": { "type": "boolean" },
            "disabled_reason": { "type": ["string", "null"] },
            "alias_of": { "type": ["string", "null"] }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_id",
            "command_label",
            "capability_class",
            "help_path",
            "state",
            "requires_approval",
            "row_posture",
            "disabled_reason",
            "alias_of",
            "available_actions",
            "is_invocable",
            "is_blocked",
            "requires_approval_before_run",
            "explains_disabled_state"
          ],
          "properties": {
            "command_id": { "type": "string", "minLength": 1 },
            "command_label": { "type": "string", "minLength": 1 },
            "capability_class": { "$ref": "#/$defs/capability_class" },
            "help_path": { "type": "string", "minLength": 1 },
            "state": { "type": "string" },
            "requires_approval": { "type": "boolean" },
            "row_posture": { "$ref": "#/$defs/slash_row_posture" },
            "disabled_reason": { "type": ["string", "null"] },
            "alias_of": { "type": ["string", "null"] },
            "available_actions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/slash_action" }
            },
            "is_invocable": { "type": "boolean" },
            "is_blocked": { "type": "boolean" },
            "requires_approval_before_run": { "type": "boolean" },
            "explains_disabled_state": { "type": "boolean" }
          }
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "mention_anatomy_parts",
        "slash_anatomy_parts",
        "mention_resolutions",
        "mention_actions",
        "slash_command_states",
        "capability_classes",
        "slash_row_postures",
        "slash_actions",
        "mention_export_fields",
        "slash_export_fields",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "mention_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "slash_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "mention_resolutions": { "type": "array", "items": { "type": "string" } },
        "mention_actions": { "type": "array", "items": { "type": "string" } },
        "slash_command_states": { "type": "array", "items": { "type": "string" } },
        "capability_classes": { "type": "array", "items": { "type": "string" } },
        "slash_row_postures": { "type": "array", "items": { "type": "string" } },
        "slash_actions": { "type": "array", "items": { "type": "string" } },
        "mention_export_fields": { "type": "array", "items": { "type": "string" } },
        "slash_export_fields": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "consumer_surface": {
      "enum": [
        "inline_composer",
        "command_palette",
        "automation_recipe",
        "cli_headless",
        "support_export"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "mention_anatomy_part": {
      "enum": [
        "mention_token_cue",
        "resolution_state_cue",
        "target_identity_cue",
        "target_preview_cue",
        "scope_note_cue",
        "candidate_count_cue",
        "action_row_cue",
        "keyboard_route_cue"
      ]
    },
    "slash_anatomy_part": {
      "enum": [
        "command_id_cue",
        "command_label_cue",
        "capability_class_cue",
        "state_posture_cue",
        "disabled_reason_cue",
        "help_path_cue",
        "action_row_cue",
        "keyboard_route_cue"
      ]
    },
    "mention_resolution": {
      "enum": [
        "resolved_unique",
        "resolved_pinned",
        "ambiguous_candidates",
        "unresolved_missing",
        "out_of_scope_denied",
        "deferred_pending"
      ]
    },
    "mention_action": {
      "enum": ["open_target", "choose_candidate", "edit_mention", "remove_mention", "reveal_scope"]
    },
    "capability_class": {
      "enum": [
        "read_only_query",
        "scoped_mutation",
        "repository_mutation",
        "external_side_effect",
        "privileged_admin",
        "meta_help"
      ]
    },
    "slash_row_posture": {
      "enum": [
        "ready_invocable",
        "approval_gated",
        "disabled_explained",
        "deprecated_redirect",
        "policy_hidden",
        "unknown_rejected"
      ]
    },
    "slash_action": {
      "enum": ["invoke", "request_approval", "open_help", "view_canonical", "explain_disabled"]
    },
    "mention_export_field": {
      "enum": [
        "mention_token",
        "resolution",
        "target_object_id",
        "target_preview_label",
        "scope_note",
        "is_bound",
        "blocks_send",
        "available_actions"
      ]
    },
    "slash_export_field": {
      "enum": [
        "command_id",
        "capability_class",
        "state",
        "row_posture",
        "requires_approval",
        "disabled_reason_present",
        "help_path",
        "available_actions"
      ]
    }
  }
}
