{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-ai-run-history-row-approval-timeline-entry-and-evidence-export-summary.schema.json",
  "title": "Aureline M5 AI run-history-row / approval-timeline-entry / evidence-export-summary primitive",
  "description": "Export-safe packet implementing the reusable M5 AI run-history row, approval-timeline entry, and evidence / export summary as one primitive trio. The packet binds one row per claimed replay surface — run-history, evidence-packet, export, support, and replay — to the shared run-history, approval-timeline, and evidence-summary anatomy, the entry points, execution modes, run outcomes, approval actor classes, grant scopes, expiry states, approval gates, evidence artifact classes, redaction postures, support linkages, export formats, and export fields. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked run-history, approval-timeline, and evidence-summary resolution cases proving the resolvers, and four hard invariants: it never masks the AI run identity across surfaces, never collapses multiple distinct grants into one vague approved badge, never reduces an export summary to a raw-file download link, and never invents a parallel run-history, approval, or export grammar. Raw prompt bodies, tool return bodies, paths, URLs, and credential material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "ship_m5_ai_run_history_rows_approval_timeline_entries_and_evidence_export_summaries_across_claimed_m5_replay_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": {
      "type": "object",
      "description": "Self-describing controlled-vocabulary set; must match the canonical token lists.",
      "additionalProperties": true
    },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "run_history_anatomy_parts",
        "approval_timeline_anatomy_parts",
        "evidence_summary_anatomy_parts",
        "entry_points",
        "execution_modes",
        "run_outcomes",
        "approval_actor_classes",
        "approval_grant_scopes",
        "approval_expiry_states",
        "approval_gates",
        "artifact_classes",
        "redaction_postures",
        "support_linkages",
        "export_formats",
        "run_history_export_fields",
        "approval_timeline_export_fields",
        "evidence_summary_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "run_history_examples",
        "approval_timeline_examples",
        "evidence_summary_examples",
        "masks_run_identity_across_surfaces",
        "collapses_multiple_grants_into_one_badge",
        "offers_raw_download_links_only",
        "invents_parallel_history_or_export_grammar"
      ],
      "properties": {
        "replay_surface": { "$ref": "#/$defs/replay_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "run_history_anatomy_parts": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/run_history_anatomy_part" }
        },
        "approval_timeline_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/approval_timeline_anatomy_part" }
        },
        "evidence_summary_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/evidence_summary_anatomy_part" }
        },
        "entry_points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/entry_point" },
          "allOf": [
            { "contains": { "const": "open_run" } },
            { "contains": { "const": "replay_run" } },
            { "contains": { "const": "export_evidence" } }
          ]
        },
        "execution_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "run_outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "approval_actor_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/approval_actor_class" }
        },
        "approval_grant_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/approval_grant_scope" }
        },
        "approval_expiry_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/approval_expiry_state" }
        },
        "approval_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "artifact_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_class" }
        },
        "redaction_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/redaction_posture" }
        },
        "support_linkages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/support_linkage" }
        },
        "export_formats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/export_format" }
        },
        "run_history_export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/run_history_export_field" }
        },
        "approval_timeline_export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/approval_timeline_export_field" }
        },
        "evidence_summary_export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/evidence_summary_export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "run_history_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/run_history_case" }
        },
        "approval_timeline_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/approval_timeline_case" }
        },
        "evidence_summary_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_summary_case" }
        },
        "masks_run_identity_across_surfaces": { "const": false },
        "collapses_multiple_grants_into_one_badge": { "const": false },
        "offers_raw_download_links_only": { "const": false },
        "invents_parallel_history_or_export_grammar": { "const": false }
      }
    },
    "replay_surface": {
      "enum": ["run_history", "evidence_packet", "export", "support", "replay"]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "run_history_anatomy_part": {
      "enum": [
        "run_id_cue",
        "task_label_cue",
        "time_cue",
        "route_cue",
        "outcome_cue",
        "entry_point_cue"
      ]
    },
    "approval_timeline_anatomy_part": {
      "enum": [
        "actor_cue",
        "scope_cue",
        "policy_epoch_cue",
        "gate_cue",
        "expiry_cue",
        "inspect_cue"
      ]
    },
    "evidence_summary_anatomy_part": {
      "enum": [
        "packet_id_cue",
        "run_link_cue",
        "artifact_class_cue",
        "redaction_cue",
        "support_linkage_cue",
        "export_format_cue"
      ]
    },
    "entry_point": {
      "enum": [
        "open_run",
        "replay_run",
        "export_evidence",
        "view_support_packet",
        "inspect_approvals"
      ]
    },
    "approval_actor_class": {
      "enum": [
        "workspace_owner",
        "delegated_reviewer",
        "security_reviewer",
        "policy_engine",
        "automation_agent"
      ]
    },
    "approval_grant_scope": {
      "enum": ["single_action", "session", "task", "workspace", "tenant", "global"]
    },
    "approval_expiry_state": {
      "enum": [
        "active",
        "expiring_soon",
        "expired",
        "revoked",
        "single_use_consumed",
        "no_expiry"
      ]
    },
    "artifact_class": {
      "enum": [
        "prompt_transcript",
        "tool_call_log",
        "diff_packet",
        "route_receipt",
        "spend_receipt",
        "approval_lineage",
        "validation_receipt",
        "redaction_manifest"
      ]
    },
    "redaction_posture": {
      "enum": [
        "fully_redacted",
        "credentials_redacted",
        "pii_redacted",
        "redaction_pending",
        "unredacted",
        "redaction_failed"
      ]
    },
    "support_linkage": {
      "enum": [
        "linked_open_ticket",
        "linked_resolved_ticket",
        "linked_internal_case",
        "linkage_pending_consent",
        "not_linked"
      ]
    },
    "export_format": {
      "enum": ["json_bundle", "markdown_report", "csv_table", "signed_archive", "redacted_pdf"]
    },
    "run_history_export_field": {
      "enum": [
        "run_id",
        "task_label",
        "occurred_at",
        "provider_model_route",
        "execution_mode",
        "outcome",
        "entry_points"
      ]
    },
    "approval_timeline_export_field": {
      "enum": [
        "approval_id",
        "actor",
        "grant_scope",
        "policy_epoch",
        "gate",
        "expiry_state",
        "effective"
      ]
    },
    "evidence_summary_export_field": {
      "enum": [
        "packet_id",
        "run_id",
        "artifact_classes",
        "redaction_posture",
        "support_linkage",
        "export_formats",
        "shareable"
      ]
    },
    "run_history_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      },
      "additionalProperties": false
    },
    "approval_timeline_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      },
      "additionalProperties": false
    },
    "evidence_summary_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
