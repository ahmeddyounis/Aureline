{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-prompt-composer-header-and-context-attachment-pill.schema.json",
  "title": "Aureline M5 prompt-composer-header / context-attachment-pill primitive",
  "description": "Export-safe packet implementing the reusable M5 prompt-composer header and context-attachment pill as one primitive pair. The packet binds one row per claimed composition consumer — the inline assistant, the side panel, the patch draft, the handoff surface, and the CLI / support export — to the shared header and pill anatomy, the derived header posture (ready/local-only/review-before-send/budget-constrained/route-blocked/budget-blocked), the derived pill posture (fresh-trusted/stale/unverified/tainted/redacted/out-of-scope), the composer modes, scopes, route classes, budget postures, attachment kinds, trust states, bounded open/remove/refresh/review/reveal actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked header and pill resolution cases proving the resolvers, and four hard invariants: it never masks its composer mode or route, never hides an attachment's freshness or trust state, never invents a private composer grammar, and never bypasses the review-before-send gate. Raw prompts, pasted bodies, attachment contents, raw URLs, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_prompt_composer_headers_and_context_attachment_pills_with_mode_scope_route_budget_freshness_trust_truth_across_claimed_m5_ai_composition_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "header_anatomy_parts",
        "pill_anatomy_parts",
        "composer_modes",
        "composer_scopes",
        "route_classes",
        "budget_postures",
        "header_postures",
        "attachment_kinds",
        "attachment_trust_states",
        "pill_postures",
        "pill_actions",
        "header_export_fields",
        "pill_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "header_examples",
        "pill_examples",
        "masks_mode_or_route",
        "hides_attachment_freshness_or_trust",
        "invents_private_composer_grammar",
        "bypasses_review_before_send"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "header_anatomy_parts": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/header_anatomy_part" }
        },
        "pill_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/pill_anatomy_part" }
        },
        "composer_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "composer_scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "route_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "budget_postures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "header_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/header_posture" }
        },
        "attachment_kinds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "attachment_trust_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "pill_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pill_posture" }
        },
        "pill_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pill_action" }
        },
        "header_export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/header_export_field" }
        },
        "pill_export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/pill_export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "header_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/header_case" }
        },
        "pill_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pill_case" }
        },
        "masks_mode_or_route": { "const": false },
        "hides_attachment_freshness_or_trust": { "const": false },
        "invents_private_composer_grammar": { "const": false },
        "bypasses_review_before_send": { "const": false }
      }
    },
    "header_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "composer_mode",
            "composer_scope",
            "route_class",
            "provider_model_label",
            "budget_posture",
            "route_blocked",
            "review_context_available"
          ],
          "properties": {
            "composer_mode": { "type": "string" },
            "composer_scope": { "type": "string" },
            "route_class": { "type": "string" },
            "provider_model_label": { "type": "string", "minLength": 1 },
            "budget_posture": { "type": "string" },
            "route_blocked": { "type": "boolean" },
            "review_context_available": { "type": "boolean" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "composer_mode",
            "composer_scope",
            "route_class",
            "provider_model_label",
            "budget_posture",
            "review_context_available",
            "header_posture",
            "is_sendable",
            "needs_attention",
            "route_stays_local",
            "route_leaves_shell",
            "requires_review_before_send"
          ],
          "properties": {
            "composer_mode": { "type": "string" },
            "composer_scope": { "type": "string" },
            "route_class": { "type": "string" },
            "provider_model_label": { "type": "string", "minLength": 1 },
            "budget_posture": { "type": "string" },
            "review_context_available": { "type": "boolean" },
            "header_posture": { "$ref": "#/$defs/header_posture" },
            "is_sendable": { "type": "boolean" },
            "needs_attention": { "type": "boolean" },
            "route_stays_local": { "type": "boolean" },
            "route_leaves_shell": { "type": "boolean" },
            "requires_review_before_send": { "type": "boolean" }
          }
        }
      }
    },
    "pill_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attachment_id",
            "attachment_label",
            "attachment_kind",
            "trust_state",
            "is_stale",
            "staleness_reason",
            "source_removed",
            "in_scope"
          ],
          "properties": {
            "attachment_id": { "type": "string", "minLength": 1 },
            "attachment_label": { "type": "string", "minLength": 1 },
            "attachment_kind": { "type": "string" },
            "trust_state": { "type": "string" },
            "is_stale": { "type": "boolean" },
            "staleness_reason": { "type": ["string", "null"] },
            "source_removed": { "type": "boolean" },
            "in_scope": { "type": "boolean" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attachment_id",
            "attachment_label",
            "attachment_kind",
            "trust_state",
            "is_stale",
            "staleness_reason",
            "pill_posture",
            "available_actions",
            "is_openable",
            "is_tainted",
            "needs_review_before_send",
            "needs_attention"
          ],
          "properties": {
            "attachment_id": { "type": "string", "minLength": 1 },
            "attachment_label": { "type": "string", "minLength": 1 },
            "attachment_kind": { "type": "string" },
            "trust_state": { "type": "string" },
            "is_stale": { "type": "boolean" },
            "staleness_reason": { "type": ["string", "null"] },
            "pill_posture": { "$ref": "#/$defs/pill_posture" },
            "available_actions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/pill_action" }
            },
            "is_openable": { "type": "boolean" },
            "is_tainted": { "type": "boolean" },
            "needs_review_before_send": { "type": "boolean" },
            "needs_attention": { "type": "boolean" }
          }
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "header_anatomy_parts",
        "pill_anatomy_parts",
        "header_postures",
        "pill_postures",
        "pill_actions",
        "header_export_fields",
        "pill_export_fields",
        "composer_modes",
        "composer_scopes",
        "route_classes",
        "budget_postures",
        "attachment_kinds",
        "attachment_trust_states",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "header_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "pill_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "header_postures": { "type": "array", "items": { "type": "string" } },
        "pill_postures": { "type": "array", "items": { "type": "string" } },
        "pill_actions": { "type": "array", "items": { "type": "string" } },
        "header_export_fields": { "type": "array", "items": { "type": "string" } },
        "pill_export_fields": { "type": "array", "items": { "type": "string" } },
        "composer_modes": { "type": "array", "items": { "type": "string" } },
        "composer_scopes": { "type": "array", "items": { "type": "string" } },
        "route_classes": { "type": "array", "items": { "type": "string" } },
        "budget_postures": { "type": "array", "items": { "type": "string" } },
        "attachment_kinds": { "type": "array", "items": { "type": "string" } },
        "attachment_trust_states": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "consumer_surface": {
      "enum": [
        "inline_assistant",
        "side_panel",
        "patch_draft",
        "handoff_surface",
        "cli_support_export"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "header_anatomy_part": {
      "enum": [
        "mode_badge",
        "scope_cue",
        "route_provider_model_cue",
        "budget_band_cue",
        "review_context_entry",
        "local_or_blocked_cue",
        "keyboard_route_cue"
      ]
    },
    "pill_anatomy_part": {
      "enum": [
        "identity_cue",
        "kind_cue",
        "label_cue",
        "trust_state_cue",
        "freshness_cue",
        "scope_cue",
        "action_row_cue",
        "keyboard_route_cue"
      ]
    },
    "header_posture": {
      "enum": [
        "ready_composing",
        "local_only_composing",
        "review_before_send",
        "budget_constrained",
        "route_blocked",
        "budget_blocked"
      ]
    },
    "pill_posture": {
      "enum": [
        "fresh_trusted",
        "stale",
        "unverified",
        "tainted",
        "redacted",
        "out_of_scope"
      ]
    },
    "pill_action": {
      "enum": ["open", "remove", "refresh", "review_trust", "reveal_scope"]
    },
    "header_export_field": {
      "enum": [
        "composer_mode",
        "composer_scope",
        "route_class",
        "provider_model_label",
        "budget_posture",
        "header_posture",
        "route_stays_local",
        "requires_review_before_send"
      ]
    },
    "pill_export_field": {
      "enum": [
        "attachment_id",
        "attachment_kind",
        "trust_state",
        "pill_posture",
        "is_stale",
        "is_openable",
        "available_actions",
        "needs_review_before_send"
      ]
    }
  }
}
