{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-ai-rerun-review-sheet-incomplete-replay-banner-and-agent-status-card.schema.json",
  "title": "Aureline M5 AI rerun-review-sheet / incomplete-replay-banner / agent-status-card primitive",
  "description": "Export-safe packet implementing the reusable M5 AI rerun-review sheet, incomplete-replay banner, and agent-status card (paused-or-blocked, takeover summary, re-review banner, and agent-run-lineage row) as one primitive trio. The packet binds one row per claimed background-agent surface — rerun-review, branch-agent console, run-history, support, and CLI — to the shared rerun-review, incomplete-replay, and agent-status anatomy, the continue options, execution modes, run outcomes, approval gates, rerun-review reasons, rerun admissions, rerun drift dimensions, replay-completeness states, replay segments, agent lifecycle states, takeover paths, blast radii, and export fields. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked rerun-review, incomplete-replay, and agent-status resolution cases proving the resolvers, and four hard invariants: it never masks the AI run lineage across surfaces, never presents an interrupted agent as alive, never overstates replay completeness, and never invents a parallel rerun-review or agent-status grammar. Raw prompt bodies, tool return bodies, diffs, paths, URLs, and credential material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_ai_rerun_review_sheets_incomplete_replay_banners_and_agent_status_cards_across_claimed_m5_background_agent_flows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": {
      "type": "object",
      "description": "Self-describing controlled-vocabulary set; must match the canonical token lists.",
      "additionalProperties": true
    },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background_agent_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "rerun_review_anatomy_parts",
        "incomplete_replay_anatomy_parts",
        "agent_status_anatomy_parts",
        "continue_options",
        "execution_modes",
        "run_outcomes",
        "approval_gates",
        "rerun_review_reasons",
        "rerun_admissions",
        "rerun_drift_dimensions",
        "replay_completeness_states",
        "replay_segments",
        "agent_lifecycle_states",
        "takeover_paths",
        "agent_blast_radii",
        "rerun_review_export_fields",
        "incomplete_replay_export_fields",
        "agent_status_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rerun_review_examples",
        "incomplete_replay_examples",
        "agent_status_examples",
        "masks_run_lineage_across_surfaces",
        "presents_interrupted_agent_as_alive",
        "overstates_replay_completeness",
        "invents_parallel_rerun_or_agent_grammar"
      ],
      "properties": {
        "background_agent_surface": {
          "enum": ["rerun_review", "branch_agent_console", "run_history", "support", "cli"]
        },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rerun_review_anatomy_parts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "incomplete_replay_anatomy_parts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "agent_status_anatomy_parts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "continue_options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "execution_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "run_outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "approval_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rerun_review_reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rerun_admissions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rerun_drift_dimensions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "replay_completeness_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "replay_segments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "agent_lifecycle_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "takeover_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "agent_blast_radii": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rerun_review_export_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "incomplete_replay_export_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "agent_status_export_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rerun_review_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rerun_review_case" }
        },
        "incomplete_replay_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/incomplete_replay_case" }
        },
        "agent_status_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/agent_status_case" }
        },
        "masks_run_lineage_across_surfaces": { "const": false },
        "presents_interrupted_agent_as_alive": { "const": false },
        "overstates_replay_completeness": { "const": false },
        "invents_parallel_rerun_or_agent_grammar": { "const": false }
      }
    },
    "rerun_review_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "rerun_review_id",
            "canonical_run_id",
            "rerun_review_reason",
            "approval_reuse_allowed",
            "requires_re_review",
            "admission"
          ],
          "additionalProperties": true
        }
      }
    },
    "incomplete_replay_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "packet_id",
            "canonical_run_id",
            "replay_completeness",
            "retained_segments",
            "missing_segments",
            "is_complete",
            "requires_new_approvals"
          ],
          "additionalProperties": true
        }
      }
    },
    "agent_status_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "agent_id",
            "canonical_run_id",
            "lifecycle_state",
            "blast_radius",
            "continue_options",
            "presents_as_alive",
            "is_interrupted"
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
