{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ai/m5-prompt-composer-component-consumer.schema.json",
  "title": "M5 Prompt-Composer-Component Consumer Packet",
  "description": "Adoption matrix binding every claimed M5 prompt-composer consumer (inline / panel composer, patch review, branch-agent console, docs/help, companion composer) to the nine canonical prompt-composer component families, so locality, route/provider/model, approval, and taint truth stays aligned and auto-narrows when the surrounding workflow becomes review-only, handoff-only, offline / mirrored, or companion-scoped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_inline_panel_patch_review_branch_agent_docs_help_and_companion_prompt_composer_component_consumers"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumerRow" }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumers",
        "component_families",
        "descriptors",
        "parity_health_modes",
        "export_caveats",
        "narrowing_reasons",
        "recovery_actions",
        "claim_parity_states",
        "anatomy_parts",
        "export_fields",
        "accessibility_routes"
      ],
      "properties": {
        "consumers": { "$ref": "#/$defs/tokenList" },
        "component_families": { "$ref": "#/$defs/tokenList" },
        "descriptors": { "$ref": "#/$defs/tokenList" },
        "parity_health_modes": { "$ref": "#/$defs/tokenList" },
        "export_caveats": { "$ref": "#/$defs/tokenList" },
        "narrowing_reasons": { "$ref": "#/$defs/tokenList" },
        "recovery_actions": { "$ref": "#/$defs/tokenList" },
        "claim_parity_states": { "$ref": "#/$defs/tokenList" },
        "anatomy_parts": { "$ref": "#/$defs/tokenList" },
        "export_fields": { "$ref": "#/$defs/tokenList" },
        "accessibility_routes": { "$ref": "#/$defs/tokenList" }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "ai_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "ai_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "tokenList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "consumer": {
      "enum": [
        "inline_panel",
        "patch_review",
        "branch_agent",
        "docs_help",
        "companion"
      ]
    },
    "componentFamily": {
      "enum": [
        "prompt_composer_header",
        "context_attachment_pill",
        "mention_resolver",
        "slash_command_row",
        "budget_size_strip",
        "tainted_context_warning",
        "draft_state_row",
        "attachment_stale_banner",
        "send_review_control"
      ]
    },
    "parityHealth": {
      "enum": [
        "full_parity",
        "review_only_narrowed",
        "handoff_only_narrowed",
        "offline_mirror_narrowed",
        "companion_scope_narrowed"
      ]
    },
    "claimParityState": {
      "enum": ["claims_preserved", "claims_auto_narrowed"]
    },
    "consumerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "parity_health_modes",
        "export_caveats",
        "claim_parity_states",
        "narrowing_reasons",
        "recovery_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewords_claims_per_surface",
        "invents_new_composer_grammar",
        "drops_locality_route_approval_or_taint_when_narrowed",
        "inherits_stronger_label_from_healthier_surface"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "$ref": "#/$defs/tokenList" },
        "deployment_lines": { "$ref": "#/$defs/tokenList" },
        "anatomy_parts": { "$ref": "#/$defs/tokenList" },
        "descriptor_families": { "$ref": "#/$defs/tokenList" },
        "parity_health_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parityHealth" }
        },
        "export_caveats": { "$ref": "#/$defs/tokenList" },
        "claim_parity_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimParityState" }
        },
        "narrowing_reasons": { "$ref": "#/$defs/tokenList" },
        "recovery_actions": { "$ref": "#/$defs/tokenList" },
        "export_fields": { "$ref": "#/$defs/tokenList" },
        "accessibility_routes": { "$ref": "#/$defs/tokenList" },
        "consumer_surfaces": { "$ref": "#/$defs/tokenList" },
        "downgrade_triggers": { "$ref": "#/$defs/tokenList" },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentBinding" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rewords_claims_per_surface": { "type": "boolean" },
        "invents_new_composer_grammar": { "type": "boolean" },
        "drops_locality_route_approval_or_taint_when_narrowed": { "type": "boolean" },
        "inherits_stronger_label_from_healthier_surface": { "type": "boolean" }
      }
    },
    "componentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/componentFamily" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bindingCase" }
        }
      }
    },
    "bindingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/bindingInput" },
        "resolved": { "$ref": "#/$defs/resolvedBinding" }
      }
    },
    "bindingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "descriptor_families",
        "parity_health",
        "export_caveats"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/componentFamily" },
        "descriptor_families": { "$ref": "#/$defs/tokenList" },
        "parity_health": { "$ref": "#/$defs/parityHealth" },
        "export_caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "note_repr": { "type": ["string", "null"] }
      }
    },
    "resolvedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "canonical_schema_ref",
        "descriptor_families",
        "parity_health",
        "export_caveats",
        "claim_parity_state",
        "is_narrowed",
        "auto_narrow_banner"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/componentFamily" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "descriptor_families": { "$ref": "#/$defs/tokenList" },
        "parity_health": { "$ref": "#/$defs/parityHealth" },
        "export_caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "claim_parity_state": { "$ref": "#/$defs/claimParityState" },
        "is_narrowed": { "type": "boolean" },
        "auto_narrow_banner": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/autoNarrowBanner" }
          ]
        }
      }
    },
    "autoNarrowBanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "recovery_action",
        "consumer",
        "component_family",
        "preserved_descriptors",
        "export_caveats",
        "headline"
      ],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "recovery_action": { "type": "string", "minLength": 1 },
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/componentFamily" },
        "preserved_descriptors": { "$ref": "#/$defs/tokenList" },
        "export_caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "headline": { "type": "string", "minLength": 1 }
      }
    }
  }
}
