{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/implement-browser-provider-console-handoff-objects-with-destination-reason-privacy-consequence-and-return-anchor.schema.json",
  "title": "Aureline browser / provider-console handoff objects with destination reason, privacy consequence, and return anchor",
  "description": "Export-safe support export that wraps the browser/provider-console handoff-objects packet. Every claimed M5 external documentation or provider-console exit - a docs-browser open, a help/about portal link, an AI-answer citation jump, or a provider-console pivot - routes through exactly one BrowserHandoff object rather than a raw URL jump. Each handoff names the governed surface the reader is leaving (source_surface, source_identity_ref, source_class), the destination class it opens, why in-product viewing was insufficient (destination_reason + destination_reason_note), exactly what context does or does not cross the boundary (shared_context + privacy_consequence), the current trust and policy posture (trust_class + policy_posture), and how the reader returns (return_anchor with an optional follow-up note). A handoff never silently exfiltrates raw code selections, private README text, unpublished ADR content, or prompt context, and ordinary docs navigation never shares query or workspace context; raw browser opens, provider-console pivots, and docs fallbacks may not bypass explicit handoff review; and the support-export and docs-history projections reconstruct every handoff so identity survives the round trip. Raw URLs, raw callback bodies, raw page bodies, raw code selections, prompt text, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "export_id",
    "export_packet_id_ref",
    "exported_at",
    "raw_private_material_excluded",
    "handoff_identity_preserved",
    "return_anchor_preserved",
    "export_packet"
  ],
  "properties": {
    "record_kind": { "const": "browser_provider_console_handoff_objects_support_export" },
    "schema_version": { "const": 1 },
    "export_id": { "$ref": "#/$defs/non_empty_string" },
    "export_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
    "exported_at": { "$ref": "#/$defs/non_empty_string" },
    "raw_private_material_excluded": { "const": true },
    "handoff_identity_preserved": { "const": true },
    "return_anchor_preserved": { "const": true },
    "export_packet": { "$ref": "#/$defs/packet" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "source_surface": {
      "type": "string",
      "enum": [
        "docs_browser",
        "help_about",
        "ai_answer",
        "provider_console_pivot",
        "review_surface",
        "support_history"
      ]
    },
    "destination_class": {
      "type": "string",
      "enum": [
        "docs_or_portal_web",
        "code_host_web",
        "issue_tracker_web",
        "package_registry_web",
        "ai_provider_web",
        "managed_admin_web",
        "external_generic_web"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": [
        "project_docs",
        "mirrored_official_docs",
        "extension_docs_pack",
        "live_external_docs",
        "curated_knowledge_pack",
        "generated_reference",
        "derived_explanation"
      ]
    },
    "destination_reason": {
      "type": "string",
      "enum": [
        "exact_anchor_unavailable_locally",
        "live_version_newer_than_mirror",
        "source_not_mirrored",
        "review_thread_requires_hosted_view",
        "user_requested_open_in_browser"
      ]
    },
    "privacy_consequence": {
      "type": "string",
      "enum": [
        "no_context_shared",
        "scoped_url_only",
        "query_terms_disclosed",
        "isolated_session",
        "shared_context_blocked"
      ]
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "first_party_authoritative",
        "signed_mirror_verified",
        "extension_pack_signed",
        "live_provider_handoff",
        "derived_inference_only"
      ]
    },
    "policy_posture": {
      "type": "string",
      "enum": [
        "allowed_explicit",
        "requires_confirmation",
        "blocked_by_policy",
        "unavailable_disclosed"
      ]
    },
    "return_anchor_kind": {
      "type": "string",
      "enum": [
        "back_to_docs_browser",
        "back_to_help_about",
        "back_to_ai_answer",
        "back_to_review_panel",
        "back_to_workspace",
        "back_to_provider_panel"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "browser_companion",
        "help_about",
        "support_export",
        "docs_history",
        "diagnostics",
        "extension_api"
      ]
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "validation_severity": {
      "type": "string",
      "enum": ["blocker", "warning"]
    },
    "validation_kind": {
      "type": "string",
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_packet_identity",
        "missing_source_contracts",
        "missing_handoff_objects",
        "handoff_object_incomplete",
        "duplicate_handoff_id",
        "destination_reason_missing",
        "return_anchor_missing",
        "trust_policy_posture_missing",
        "privacy_consequence_inconsistent",
        "hidden_context_share_detected",
        "ordinary_navigation_shares_context",
        "blocked_handoff_presented_available",
        "raw_browser_open_bypass",
        "exit_coverage_missing",
        "required_reconstruction_surface_missing",
        "reconstruction_projection_drops_handoff",
        "consumer_projection_packet_id_mismatch",
        "consumer_projection_orphan_handoff_ref",
        "history_reconstruction_drops_handoff",
        "raw_boundary_material_present",
        "handoff_unavailable_narrowed",
        "shared_context_blocked_narrowed",
        "promotion_state_mismatch"
      ]
    },
    "shared_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shares_resolved_destination_ref",
        "shares_user_query_terms",
        "shares_raw_code_selection",
        "shares_private_readme_text",
        "shares_unpublished_adr_content",
        "shares_prompt_context"
      ],
      "properties": {
        "shares_resolved_destination_ref": { "type": "boolean" },
        "shares_user_query_terms": { "type": "boolean" },
        "shares_raw_code_selection": { "const": false },
        "shares_private_readme_text": { "const": false },
        "shares_unpublished_adr_content": { "const": false },
        "shares_prompt_context": { "const": false }
      }
    },
    "return_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_kind", "anchor_ref", "label"],
      "properties": {
        "anchor_kind": { "$ref": "#/$defs/return_anchor_kind" },
        "anchor_ref": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "follow_up_note": { "type": "string" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "source_surface",
        "source_identity_ref",
        "source_class",
        "destination_class",
        "destination_ref",
        "destination_reason",
        "destination_reason_note",
        "privacy_consequence",
        "shared_context",
        "trust_class",
        "policy_posture",
        "policy_disclosure_note",
        "return_anchor",
        "ordinary_navigation",
        "user_initiated",
        "offered_as_actionable",
        "routed_through_handoff_review",
        "raw_boundary_material_excluded"
      ],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/non_empty_string" },
        "source_surface": { "$ref": "#/$defs/source_surface" },
        "source_identity_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "destination_class": { "$ref": "#/$defs/destination_class" },
        "destination_ref": { "$ref": "#/$defs/non_empty_string" },
        "destination_reason": { "$ref": "#/$defs/destination_reason" },
        "destination_reason_note": { "$ref": "#/$defs/non_empty_string" },
        "privacy_consequence": { "$ref": "#/$defs/privacy_consequence" },
        "shared_context": { "$ref": "#/$defs/shared_context" },
        "trust_class": { "$ref": "#/$defs/trust_class" },
        "policy_posture": { "$ref": "#/$defs/policy_posture" },
        "policy_disclosure_note": { "$ref": "#/$defs/non_empty_string" },
        "return_anchor": { "$ref": "#/$defs/return_anchor" },
        "ordinary_navigation": { "type": "boolean" },
        "user_initiated": { "type": "boolean" },
        "offered_as_actionable": { "type": "boolean" },
        "routed_through_handoff_review": { "type": "boolean" },
        "raw_boundary_material_excluded": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "projection_ref",
        "packet_id_ref",
        "reuses_shared_handoff_object",
        "preserves_destination_reason",
        "preserves_return_anchor",
        "preserves_privacy_consequence",
        "handoff_id_refs"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/consumer_surface" },
        "projection_ref": { "$ref": "#/$defs/non_empty_string" },
        "packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "reuses_shared_handoff_object": { "type": "boolean" },
        "preserves_destination_reason": { "type": "boolean" },
        "preserves_return_anchor": { "type": "boolean" },
        "preserves_privacy_consequence": { "type": "boolean" },
        "handoff_id_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "validation_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/validation_kind" },
        "severity": { "$ref": "#/$defs/validation_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "surface_label",
        "generated_at",
        "handoffs",
        "consumer_projections",
        "source_contract_refs",
        "redaction_class_token",
        "promotion_state"
      ],
      "properties": {
        "record_kind": { "const": "browser_provider_console_handoff_objects_packet" },
        "schema_version": { "const": 1 },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "handoffs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/handoff" }
        },
        "consumer_projections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_projection" }
        },
        "source_contract_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "validation_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    }
  }
}
