{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/m5-symbol-linked-reference-card-primitive.schema.json",
  "title": "Aureline M5 symbol-linked reference-card primitive",
  "description": "Export-safe packet implementing the reusable M5 symbol-linked reference card as one primitive. The packet binds one row per claimed M5 reference-card consumer — the editor hover/peek, the docs-browser card, the AI-explanation card, the onboarding reference card, and the support evidence card — to the shared card anatomy, symbol anchors, derived symbol-linkage strengths, corpus classes, source providers, match states, project-doc override reasons, version scopes, freshness states, derived freshness postures, export fields, non-visual accessibility routes, consumer surfaces, downgrade triggers, worked resolution cases, and four hard reference-card invariants. Each worked resolution preserves the initiating file/symbol code anchor and always carries a self-contained linkage disclosure naming why the card appeared and how strong the symbol linkage is (an exact symbol match, a nearby version match, a project-specific override, or a keyword fallback). A self-describing vocabulary set freezes the controlled vocabulary for consumer surface, anatomy part, linkage strength, freshness posture, export field, symbol anchor, corpus class, version scope, source provider, match state, override reason, freshness state, and accessibility route. Raw URLs, raw tokens, credentials, private endpoints, initiating source bodies, and doc bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "reference_card_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_docs_symbol_linked_reference_cards_with_code_anchor_symbol_anchor_linkage_strength_source_version_and_freshness_truth"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "reference_card_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/reference_card_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "reference_card_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "type": "string", "minLength": 1 },
        "reference_card_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "reference_card_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "symbol_anchors",
        "linkage_strengths",
        "corpus_classes",
        "source_providers",
        "match_states",
        "override_reasons",
        "version_scopes",
        "freshness_states",
        "freshness_postures",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "masks_source_or_version",
        "shows_cached_or_stale_as_live",
        "invents_private_card_grammar",
        "hides_symbol_linkage"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "editor_hover_peek",
            "docs_browser_card",
            "ai_explanation_card",
            "onboarding_reference_card",
            "support_evidence_card"
          ]
        },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "anatomy_parts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "enum": [
              "card_title_label",
              "initiating_code_anchor",
              "symbol_anchor_badge",
              "linkage_strength_cue",
              "source_provider_badge",
              "version_scope_badge",
              "cited_source_revision",
              "open_action"
            ]
          },
          "allOf": [
            { "contains": { "const": "card_title_label" } },
            { "contains": { "const": "initiating_code_anchor" } },
            { "contains": { "const": "symbol_anchor_badge" } },
            { "contains": { "const": "linkage_strength_cue" } },
            { "contains": { "const": "source_provider_badge" } },
            { "contains": { "const": "open_action" } }
          ]
        },
        "symbol_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "function_symbol",
              "type_symbol",
              "module_symbol",
              "field_or_method",
              "macro_symbol",
              "unresolved_anchor"
            ]
          }
        },
        "linkage_strengths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "exact_symbol_linkage",
              "nearby_version_linkage",
              "project_specific_linkage",
              "keyword_fallback_linkage",
              "heuristic_linkage",
              "unresolved_no_linkage"
            ]
          }
        },
        "corpus_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "match_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "override_reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "version_scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freshness_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freshness_postures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "current_live",
              "recently_synced_current",
              "cached_explicit_not_live",
              "mirrored_explicit_not_live",
              "stale_flagged",
              "freshness_unknown"
            ]
          }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string" },
          "allOf": [
            { "contains": { "const": "linkage_strength" } },
            { "contains": { "const": "symbol_anchor" } },
            { "contains": { "const": "initiating_anchor" } },
            { "contains": { "const": "source_provider" } },
            { "contains": { "const": "version_scope" } },
            { "contains": { "const": "freshness_state" } }
          ]
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "masks_source_or_version": { "const": false },
        "shows_cached_or_stale_as_live": { "const": false },
        "invents_private_card_grammar": { "const": false },
        "hides_symbol_linkage": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "anatomy_parts",
        "linkage_strengths",
        "freshness_postures",
        "export_fields",
        "symbol_anchors",
        "corpus_classes",
        "version_scopes",
        "source_providers",
        "match_states",
        "override_reasons",
        "freshness_states",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "linkage_strengths": { "type": "array", "items": { "type": "string" } },
        "freshness_postures": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "symbol_anchors": { "type": "array", "items": { "type": "string" } },
        "corpus_classes": { "type": "array", "items": { "type": "string" } },
        "version_scopes": { "type": "array", "items": { "type": "string" } },
        "source_providers": { "type": "array", "items": { "type": "string" } },
        "match_states": { "type": "array", "items": { "type": "string" } },
        "override_reasons": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
