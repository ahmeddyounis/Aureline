{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/m5-docs-pack-row-and-stale-example-finding-row-primitive.schema.json",
  "title": "Aureline M5 docs-pack row and stale-example finding row primitive",
  "description": "Export-safe packet implementing the reusable M5 docs-pack row and stale-example finding row as two primitives. The packet binds one row per claimed M5 pack/finding consumer — the docs-pack manager, the help pack panel, the onboarding pack step, the AI pack context, and the support pack evidence — to the shared pack-row and stale-example anatomy, pack states, derived pack trust postures, verification states, pack actions, stale-example statuses, derived example drift postures, anchor kinds, example actions, corpus classes, source providers, version scopes, freshness states, export fields, non-visual accessibility routes, consumer surfaces, downgrade triggers, worked pack and stale-example resolution cases, and four hard row invariants. Each worked pack case keeps a pack's pin/mirror/offline/quarantine/update/stale state distinct and never shows a quarantined, stale, or mirrored pack as trusted or live; each worked stale-example case anchors the finding to a concrete snippet/command/config and never shows a drifted or unverified example as current. A self-describing vocabulary set freezes the controlled vocabulary. Raw URLs, raw tokens, credentials, private endpoints, pack payloads, and example bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "pack_finding_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_docs_pack_rows_and_stale_example_finding_rows_with_pin_offline_refresh_quarantine_update_remove_actions_and_version_drift_truth"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "pack_finding_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/pack_finding_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "pack_finding_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "type": "string", "minLength": 1 },
        "pack_finding_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "pack_finding_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "pack_anatomy_parts",
        "example_anatomy_parts",
        "pack_states",
        "trust_postures",
        "verification_states",
        "pack_actions",
        "stale_example_statuses",
        "drift_postures",
        "anchor_kinds",
        "example_actions",
        "corpus_classes",
        "source_providers",
        "version_scopes",
        "freshness_states",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "pack_examples",
        "stale_example_findings",
        "masks_pack_state_or_source",
        "shows_quarantined_or_stale_as_trusted",
        "invents_private_pack_grammar",
        "hides_version_drift"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "docs_pack_manager",
            "help_pack_panel",
            "onboarding_pack_step",
            "ai_pack_context",
            "support_pack_evidence"
          ]
        },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "pack_anatomy_parts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "enum": [
              "pack_identity_label",
              "selected_scope_badge",
              "size_count_meter",
              "signer_source_badge",
              "pack_state_badge",
              "refresh_time_label",
              "verification_badge",
              "pack_action_cluster"
            ]
          },
          "allOf": [
            { "contains": { "const": "pack_identity_label" } },
            { "contains": { "const": "selected_scope_badge" } },
            { "contains": { "const": "signer_source_badge" } },
            { "contains": { "const": "pack_state_badge" } },
            { "contains": { "const": "verification_badge" } },
            { "contains": { "const": "pack_action_cluster" } }
          ]
        },
        "example_anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": {
            "enum": [
              "finding_title_label",
              "affected_anchor_ref",
              "drift_status_badge",
              "version_drift_context",
              "source_provider_badge",
              "example_action_cluster"
            ]
          },
          "allOf": [
            { "contains": { "const": "finding_title_label" } },
            { "contains": { "const": "affected_anchor_ref" } },
            { "contains": { "const": "drift_status_badge" } },
            { "contains": { "const": "version_drift_context" } },
            { "contains": { "const": "example_action_cluster" } }
          ]
        },
        "pack_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "pinned_pack",
              "mirrored_pack",
              "offline_pack",
              "quarantined_pack",
              "update_available",
              "unpinned_tracking"
            ]
          }
        },
        "trust_postures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "pinned_current",
              "tracking_current",
              "mirror_served_not_live",
              "offline_only",
              "update_overdue",
              "stale_needs_refresh",
              "quarantined_untrusted",
              "verification_unverified"
            ]
          }
        },
        "verification_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["signature_verified", "checksum_only", "unverified", "verification_failed"]
          }
        },
        "pack_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "pin_pack",
              "unpin_pack",
              "refresh_pack",
              "take_offline",
              "review_quarantine",
              "update_pack",
              "remove_pack",
              "export_pack_manifest"
            ]
          }
        },
        "stale_example_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "example_current",
              "api_signature_drifted",
              "deprecated_symbol_used",
              "broken_link_target",
              "version_mismatch_example",
              "unverified_example"
            ]
          }
        },
        "drift_postures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "example_verified_current",
              "example_current_pending_reverify",
              "signature_drift_actionable",
              "deprecated_symbol_actionable",
              "broken_reference_actionable",
              "version_mismatch_actionable",
              "unverified_needs_check"
            ]
          }
        },
        "anchor_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["code_snippet", "shell_command", "config_shape", "api_signature", "link_target"]
          }
        },
        "example_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["compare_drift", "open_current_source", "suppress_finding", "export_finding"]
          }
        },
        "corpus_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "version_scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freshness_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "export_fields": {
          "type": "array",
          "minItems": 7,
          "items": { "type": "string" },
          "allOf": [
            { "contains": { "const": "pack_state" } },
            { "contains": { "const": "signer_source" } },
            { "contains": { "const": "verification_state" } },
            { "contains": { "const": "trust_posture" } },
            { "contains": { "const": "stale_example_status" } },
            { "contains": { "const": "drift_posture" } },
            { "contains": { "const": "freshness_state" } }
          ]
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "pack_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "stale_example_findings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "masks_pack_state_or_source": { "const": false },
        "shows_quarantined_or_stale_as_trusted": { "const": false },
        "invents_private_pack_grammar": { "const": false },
        "hides_version_drift": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "pack_anatomy_parts",
        "example_anatomy_parts",
        "trust_postures",
        "verification_states",
        "pack_actions",
        "drift_postures",
        "anchor_kinds",
        "example_actions",
        "export_fields",
        "pack_states",
        "stale_example_statuses",
        "corpus_classes",
        "version_scopes",
        "source_providers",
        "freshness_states",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "pack_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "example_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "trust_postures": { "type": "array", "items": { "type": "string" } },
        "verification_states": { "type": "array", "items": { "type": "string" } },
        "pack_actions": { "type": "array", "items": { "type": "string" } },
        "drift_postures": { "type": "array", "items": { "type": "string" } },
        "anchor_kinds": { "type": "array", "items": { "type": "string" } },
        "example_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "pack_states": { "type": "array", "items": { "type": "string" } },
        "stale_example_statuses": { "type": "array", "items": { "type": "string" } },
        "corpus_classes": { "type": "array", "items": { "type": "string" } },
        "version_scopes": { "type": "array", "items": { "type": "string" } },
        "source_providers": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
