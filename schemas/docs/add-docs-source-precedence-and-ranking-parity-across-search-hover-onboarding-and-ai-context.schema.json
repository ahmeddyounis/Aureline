{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/add-docs-source-precedence-and-ranking-parity-across-search-hover-onboarding-and-ai-context.schema.json",
  "title": "Aureline docs-source precedence and ranking parity across search, hover/peek, onboarding, and AI context",
  "description": "Export-safe support export that wraps the docs-source precedence/ranking parity packet. The packet materializes one or more ranked answer sets whose candidates keep seven distinguishable source lanes (project docs, generated docs, mirrored official docs, curated knowledge packs, extension-contributed docs, live external docs, and derived explanations), each carrying its source-precedence class, a closed precedence reason with a human-readable note, version-match and freshness state, mirror/offline posture, and project-specific / override cues. It binds per-surface projections that prove docs search, hover/peek, onboarding, AI context, and support export project the same ranking explanation using one stable vocabulary. Project docs may outrank vendor docs for repo-specific questions but the vendor difference stays visible; a less-authoritative source may outrank a more-authoritative one only with a justifying reason; derived explanations never claim primary authority; no surface mints a hidden ranking model; and an offline / air-gapped profile keeps candidates inspectable with an explicit unavailable reason. Raw document bodies, raw source files, raw URLs, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "export_id",
    "export_packet_id_ref",
    "exported_at",
    "raw_private_material_excluded",
    "ranking_explanation_preserved",
    "export_packet"
  ],
  "properties": {
    "record_kind": {
      "const": "docs_source_precedence_and_ranking_parity_support_export"
    },
    "schema_version": { "const": 1 },
    "export_id": { "$ref": "#/$defs/non_empty_string" },
    "export_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
    "exported_at": { "$ref": "#/$defs/non_empty_string" },
    "raw_private_material_excluded": { "const": true },
    "ranking_explanation_preserved": { "const": true },
    "export_packet": { "$ref": "#/$defs/ranking_packet" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "source_class": {
      "type": "string",
      "enum": [
        "project_docs",
        "generated_reference",
        "mirrored_official_docs",
        "curated_knowledge_pack",
        "vendor_provider_docs",
        "support_runbook",
        "derived_explanation"
      ]
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "first_party_authoritative",
        "signed_mirror_verified",
        "extension_pack_signed",
        "curated_supported",
        "live_provider_handoff",
        "derived_inference_only"
      ]
    },
    "source_lane": {
      "type": "string",
      "enum": [
        "project_docs",
        "generated_docs",
        "mirrored_official_docs",
        "curated_knowledge_pack",
        "extension_contributed_docs",
        "live_external_docs",
        "derived_explanation"
      ]
    },
    "precedence_class": {
      "type": "string",
      "enum": [
        "project_authoritative_only",
        "project_outranks_vendor_default",
        "vendor_override_disclosed",
        "project_vendor_disagreement_inspectable",
        "not_applicable"
      ]
    },
    "precedence_reason": {
      "type": "string",
      "enum": [
        "project_scope_match",
        "exact_version_match",
        "freshness_preferred",
        "official_upstream_authority",
        "curated_pack_relevance",
        "extension_contributed_scope",
        "live_external_fallback",
        "vendor_override_policy",
        "disagreement_both_shown",
        "derived_inference_only"
      ]
    },
    "version_match_state": {
      "type": "string",
      "enum": [
        "exact_build_match",
        "compatible_minor_drift",
        "incompatible_drift_detected",
        "pre_release_unverified",
        "unknown_target_build"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "authoritative_live",
        "warm_cached",
        "degraded_cached",
        "stale",
        "unverified"
      ]
    },
    "mirror_offline_posture": {
      "type": "string",
      "enum": [
        "live_online",
        "local_project_pack",
        "generated_local",
        "mirrored_pack",
        "offline_pinned_pack",
        "cached_local",
        "not_installed",
        "support_pack"
      ]
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "search_query",
        "symbol",
        "question",
        "onboarding_topic",
        "ai_context_subject"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": ["docs_search", "hover_peek", "onboarding", "ai_context", "support_export"]
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "finding_severity": {
      "type": "string",
      "enum": ["info", "warning", "blocker"]
    },
    "finding_kind": {
      "type": "string",
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_packet_identity",
        "missing_source_contracts",
        "missing_ranking_sets",
        "ranking_set_incomplete",
        "candidate_incomplete",
        "candidate_lane_mismatch",
        "candidate_lane_unresolved",
        "source_class_distinguishability_missing",
        "duplicate_rank_position",
        "precedence_reason_note_missing",
        "precedence_reason_class_mismatch",
        "unexplained_rank_inversion",
        "outrank_without_visible_alternative",
        "derived_explanation_ranked_as_primary",
        "boundary_disclosure_missing",
        "offline_unavailable_reason_missing",
        "missing_rank_explanation_surface",
        "rank_explanation_drops_truth",
        "hidden_ranking_model",
        "projection_ref_unresolved",
        "support_export_drops_ranking_set",
        "raw_boundary_material_present",
        "air_gapped_candidate_narrowed",
        "project_vendor_disagreement_narrowed",
        "promotion_state_mismatch"
      ]
    },
    "ranked_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "docs_source_ref",
        "result_ref",
        "source_class",
        "trust_class",
        "lane",
        "precedence_class",
        "precedence_reason",
        "precedence_reason_note",
        "version_match_state",
        "freshness_state",
        "mirror_offline_posture",
        "rank_position",
        "project_specific_cue",
        "override_cue",
        "available_in_offline_profile",
        "raw_boundary_material_excluded"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/non_empty_string" },
        "docs_source_ref": { "$ref": "#/$defs/non_empty_string" },
        "result_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "trust_class": { "$ref": "#/$defs/trust_class" },
        "lane": { "$ref": "#/$defs/source_lane" },
        "precedence_class": { "$ref": "#/$defs/precedence_class" },
        "precedence_reason": { "$ref": "#/$defs/precedence_reason" },
        "precedence_reason_note": { "$ref": "#/$defs/non_empty_string" },
        "version_match_state": { "$ref": "#/$defs/version_match_state" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "mirror_offline_posture": { "$ref": "#/$defs/mirror_offline_posture" },
        "rank_position": { "type": "integer", "minimum": 1 },
        "project_specific_cue": { "type": "boolean" },
        "override_cue": { "type": "boolean" },
        "outranks_refs": { "type": "array", "items": { "type": "string" } },
        "available_in_offline_profile": { "type": "boolean" },
        "unavailable_reason": { "type": "string" },
        "disclosure_note": { "type": "string" },
        "raw_boundary_material_excluded": { "type": "boolean" }
      }
    },
    "ranking_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_label",
        "subject_kind",
        "project_specific_subject",
        "candidates"
      ],
      "properties": {
        "subject_id": { "$ref": "#/$defs/non_empty_string" },
        "subject_label": { "$ref": "#/$defs/non_empty_string" },
        "subject_kind": { "$ref": "#/$defs/subject_kind" },
        "project_specific_subject": { "type": "boolean" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ranked_candidate" }
        },
        "disclosure_note": { "type": "string" }
      }
    },
    "surface_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "projection_id",
        "ranking_set_ref",
        "shows_source_class",
        "shows_precedence_reason",
        "shows_version_match",
        "shows_freshness",
        "shows_project_or_override_cue",
        "uses_shared_ranking_vocabulary",
        "explanation_inspectable_on_demand",
        "candidate_id_refs"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/consumer_surface" },
        "projection_id": { "$ref": "#/$defs/non_empty_string" },
        "ranking_set_ref": { "$ref": "#/$defs/non_empty_string" },
        "shows_source_class": { "type": "boolean" },
        "shows_precedence_reason": { "type": "boolean" },
        "shows_version_match": { "type": "boolean" },
        "shows_freshness": { "type": "boolean" },
        "shows_project_or_override_cue": { "type": "boolean" },
        "uses_shared_ranking_vocabulary": { "type": "boolean" },
        "explanation_inspectable_on_demand": { "type": "boolean" },
        "candidate_id_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validation_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/finding_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "ranking_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "surface_label",
        "generated_at",
        "ranking_sets",
        "surface_projections",
        "source_contract_refs",
        "redaction_class_token",
        "promotion_state"
      ],
      "properties": {
        "record_kind": {
          "const": "docs_source_precedence_and_ranking_parity_packet"
        },
        "schema_version": { "const": 1 },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "ranking_sets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ranking_set" }
        },
        "surface_projections": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/surface_projection" }
        },
        "source_contract_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "validation_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    }
  }
}
