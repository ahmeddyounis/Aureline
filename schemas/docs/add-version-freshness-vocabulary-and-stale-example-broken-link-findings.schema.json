{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/add-version-freshness-vocabulary-and-stale-example-broken-link-findings.schema.json",
  "title": "Aureline docs version/freshness vocabulary and stale-example/broken-link findings",
  "description": "Export-safe support export that wraps the docs version-freshness findings packet. The packet freezes one controlled version-match/freshness vocabulary (exact, nearby, project_specific, mirrored, cached, stale, policy_blocked, browser_handoff_required) reused by docs/search result rows, symbol-linked reference cards, docs pages, AI citation chips, onboarding/glossary surfaces, and support exports. Each state carries a distinct confidence treatment so cached or nearby-version documentation never renders with the same confidence as exact current documentation, and the four distinct states browser_handoff_required, cached, mirrored, and project_specific never collapse into one generic info badge. A version-mismatch card discloses both the active code/package version and the viewed docs version. Stale-example and broken-link findings compare a doc's code blocks, commands, API references, config paths, or links against the current graph/pack metadata and keep stable object identity plus their suppress/compare/open-current-source actions on every surface. Raw document bodies, raw URLs, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "export_id",
    "export_packet_id_ref",
    "exported_at",
    "raw_private_material_excluded",
    "ambient_authority_excluded",
    "export_packet"
  ],
  "properties": {
    "record_kind": { "const": "docs_version_freshness_findings_support_export" },
    "schema_version": { "const": 1 },
    "export_id": { "$ref": "#/$defs/non_empty_string" },
    "export_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
    "exported_at": { "$ref": "#/$defs/non_empty_string" },
    "raw_private_material_excluded": { "const": true },
    "ambient_authority_excluded": { "const": true },
    "export_packet": { "$ref": "#/$defs/packet" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "version_freshness_state": {
      "type": "string",
      "enum": [
        "exact",
        "nearby",
        "project_specific",
        "mirrored",
        "cached",
        "stale",
        "policy_blocked",
        "browser_handoff_required"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "current_exact",
        "qualified_nearby",
        "project_scoped",
        "mirrored_verified",
        "cached_unverified",
        "not_current",
        "inline_unavailable"
      ]
    },
    "subject_kind": {
      "type": "string",
      "enum": ["code_block", "command", "api_reference", "config_path", "link"]
    },
    "finding_class": {
      "type": "string",
      "enum": [
        "stale_example",
        "broken_link",
        "nearby_version_example",
        "removed_api_reference",
        "changed_config_path",
        "command_syntax_changed"
      ]
    },
    "finding_severity": {
      "type": "string",
      "enum": ["advisory", "narrowing", "blocking"]
    },
    "suppression_state": {
      "type": "string",
      "enum": ["active", "suppressed_by_reviewer", "suppressed_by_policy"]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "result_row",
        "symbol_reference_card",
        "docs_page",
        "ai_citation_chip",
        "onboarding_glossary",
        "support_export"
      ]
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "validation_severity": {
      "type": "string",
      "enum": ["info", "warning", "blocker"]
    },
    "validation_kind": {
      "type": "string",
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_packet_identity",
        "missing_source_contracts",
        "missing_cards",
        "card_incomplete",
        "duplicate_card_id",
        "card_confidence_collapsed",
        "version_disclosure_missing",
        "state_reason_missing",
        "vocabulary_coverage_missing",
        "finding_incomplete",
        "finding_subject_class_mismatch",
        "duplicate_finding_id",
        "finding_orphan",
        "finding_actions_missing",
        "finding_suppression_reason_missing",
        "required_surface_missing",
        "consumer_projection_packet_id_mismatch",
        "state_distinction_collapsed",
        "consumer_projection_drift",
        "raw_boundary_material_present",
        "promotion_state_mismatch"
      ]
    },
    "version_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_version_ref",
        "viewed_version_ref",
        "difference_changes_api_or_workflow"
      ],
      "properties": {
        "active_version_ref": { "$ref": "#/$defs/non_empty_string" },
        "viewed_version_ref": { "$ref": "#/$defs/non_empty_string" },
        "difference_changes_api_or_workflow": { "type": "boolean" },
        "difference_summary": { "type": "string" }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "doc_node_ref",
        "display_label",
        "state",
        "confidence",
        "open_current_source_ref",
        "raw_boundary_material_excluded"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "doc_node_ref": { "$ref": "#/$defs/non_empty_string" },
        "display_label": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/version_freshness_state" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "version_disclosure": { "$ref": "#/$defs/version_disclosure" },
        "state_reason": { "type": "string" },
        "open_current_source_ref": { "$ref": "#/$defs/non_empty_string" },
        "raw_boundary_material_excluded": { "const": true }
      }
    },
    "finding_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suppression_state", "compare_ref", "open_current_source_ref"],
      "properties": {
        "suppression_state": { "$ref": "#/$defs/suppression_state" },
        "suppression_reason": { "type": "string" },
        "compare_ref": { "$ref": "#/$defs/non_empty_string" },
        "open_current_source_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "finding_class",
        "subject_kind",
        "severity",
        "card_id_ref",
        "doc_node_ref",
        "observed_ref",
        "compared_against_ref",
        "summary",
        "actions"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/non_empty_string" },
        "finding_class": { "$ref": "#/$defs/finding_class" },
        "subject_kind": { "$ref": "#/$defs/subject_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "card_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "doc_node_ref": { "$ref": "#/$defs/non_empty_string" },
        "observed_ref": { "$ref": "#/$defs/non_empty_string" },
        "compared_against_ref": { "$ref": "#/$defs/non_empty_string" },
        "current_ref": { "type": "string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "actions": { "$ref": "#/$defs/finding_actions" }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "projection_ref",
        "packet_id_ref",
        "preserves_state_badge",
        "preserves_state_distinctions",
        "preserves_confidence_treatment",
        "preserves_version_disclosure",
        "preserves_findings",
        "preserves_finding_actions",
        "raw_private_material_excluded"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/consumer_surface" },
        "projection_ref": { "$ref": "#/$defs/non_empty_string" },
        "packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "preserves_state_badge": { "const": true },
        "preserves_state_distinctions": { "const": true },
        "preserves_confidence_treatment": { "const": true },
        "preserves_version_disclosure": { "const": true },
        "preserves_findings": { "const": true },
        "preserves_finding_actions": { "const": true },
        "raw_private_material_excluded": { "const": true }
      }
    },
    "validation_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/validation_kind" },
        "severity": { "$ref": "#/$defs/validation_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "surface_label",
        "generated_at",
        "cards",
        "findings",
        "consumer_projections",
        "source_contract_refs",
        "redaction_class_token",
        "promotion_state",
        "validation_findings"
      ],
      "properties": {
        "record_kind": { "const": "docs_version_freshness_findings_packet" },
        "schema_version": { "const": 1 },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "consumer_projections": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/consumer_projection" }
        },
        "source_contract_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
        "promotion_state": { "const": "stable" },
        "validation_findings": {
          "type": "array",
          "maxItems": 0,
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    }
  }
}
