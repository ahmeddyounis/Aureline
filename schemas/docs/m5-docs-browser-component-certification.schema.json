{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/m5-docs-browser-component-certification.schema.json",
  "title": "M5 Docs-Browser Component Surface Certification Packet",
  "description": "M05-875 closing surface-certification capstone over the frozen M5 docs-browser component matrix. Certifies that the eight reusable docs-search-bar, docs-scope-switcher, docs-result-row, symbol-linked-reference-card, docs-source/version-badge, docs-pack-row, stale-example-finding-row, and browser-handoff-banner components hold their governed truth on every claimed M5 docs / help / onboarding / AI surface, and auto-narrows the docs-support claim of any surface that cannot sustain it. Metadata-only: raw docs bodies, provider tokens, and mirror cursors never cross this boundary.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_docs_browser_component_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "type": "string",
      "const": "artifacts/docs/m5/freeze_the_m5_docs_search_bar_result_row_symbol_reference_card_source_badge_docs_pack_row_and_handoff_banner_component_matrix/support_export.json"
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "support_claim": {
      "type": "string",
      "enum": [
        "current_authoritative",
        "supported_reference",
        "version_adjacent_reference",
        "cached_reference",
        "unverified_reference",
        "policy_blocked_reference"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "docs_browser",
        "onboarding",
        "glossary",
        "ai_citations",
        "support_help",
        "mirror_offline",
        "cli_headless",
        "support_export"
      ]
    },
    "axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "source_and_handoff_provenance"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "component_family": {
      "type": "string",
      "enum": [
        "docs_search_bar",
        "docs_scope_switcher",
        "docs_result_row",
        "symbol_linked_reference_card",
        "docs_source_version_badge",
        "docs_pack_row",
        "stale_example_finding_row",
        "docs_handoff_banner"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "corpus_class_unstated",
        "source_provider_masked",
        "version_scope_unstated",
        "symbol_anchor_unresolved_hidden",
        "project_override_reason_hidden",
        "freshness_hidden",
        "pack_state_misrepresented",
        "stale_example_shown_as_current",
        "handoff_reason_unstated",
        "mirrored_or_cached_shown_as_live",
        "quarantined_pack_shown_as_trusted",
        "proof_stale"
      ]
    },
    "export_parity": {
      "type": "object",
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "additionalProperties": false,
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "axis_outcome": {
      "type": "object",
      "required": ["axis", "state", "parity_note"],
      "additionalProperties": false,
      "properties": {
        "axis": { "$ref": "#/$defs/axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string" },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "additionalProperties": false,
      "properties": {
        "binding_axis": { "$ref": "#/$defs/axis" },
        "from_claim": { "$ref": "#/$defs/support_claim" },
        "to_claim": { "$ref": "#/$defs/support_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "observed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "record_kind": { "type": "string", "const": "m5_docs_browser_component_certification_row" },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "claimed_claim": { "$ref": "#/$defs/support_claim" },
        "certified_claim": { "$ref": "#/$defs/support_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": { "type": "string", "minLength": 1 },
        "derived_status": { "$ref": "#/$defs/status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "every_axis_covered_on_every_row",
        "narrowed_surface_count",
        "report_clean"
      ],
      "additionalProperties": false,
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
