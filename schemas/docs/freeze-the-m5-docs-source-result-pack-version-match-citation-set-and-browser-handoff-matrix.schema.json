        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_fields": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "state_vocabularies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state_vocabulary"
          }
        },
        "source_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_class"
          }
        },
        "version_match_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version_match_state_token"
          }
        },
        "freshness_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/freshness_state"
          }
        },
        "trust_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trust_class"
          }
        },
        "locale_matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale_match"
          }
        },
        "mirror_offline_postures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mirror_offline_posture"
          }
        },
        "handoff_reasons": {
