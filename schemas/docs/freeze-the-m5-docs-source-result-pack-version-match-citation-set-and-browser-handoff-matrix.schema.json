        "live_version_newer_than_mirror",
        "source_not_mirrored",
        "review_thread_requires_hosted_view",
        "user_requested_open_in_browser"
      ]
    },
    "browser_handoff_privacy_consequence": {
      "type": "string",
      "enum": [
        "no_context_shared",
        "scoped_url_only",
        "query_terms_disclosed",
        "isolated_session",
        "shared_context_blocked"
      ]
    },
    "evidence_requirement": {
