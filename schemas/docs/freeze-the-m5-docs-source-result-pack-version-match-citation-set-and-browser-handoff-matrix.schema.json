{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/freeze-the-m5-docs-source-result-pack-version-match-citation-set-and-browser-handoff-matrix.schema.json",
  "title": "Aureline M5 docs-source, docs-result, docs-pack-manifest, version-match, citation-set, and browser-handoff matrix",
  "description": "Export-safe packet freezing the canonical M5 documentation object model. The packet names every governed documentation object — the docs source descriptor, the docs result object, the docs-pack manifest, the derived-explanation citation set, the version-match/freshness state, the stale-example finding, and the browser-handoff object — and binds each to its qualification class, required fields, the controlled state vocabularies it carries, the concrete vocabulary tokens it admits, evidence requirements, the proof packet that keeps it current, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. A self-describing vocabulary set freezes the controlled vocabulary for source class, version-match state, freshness, trust class, locale match, mirror/offline posture, browser-handoff reason, and browser-handoff privacy consequence. Raw document bodies, raw source files, rendered HTML, raw URLs, raw provider payloads, credentials, and live vendor-doc snapshots never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "object_rows",
    "vocabulary_set",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_docs_source_result_pack_version_match_citation_set_and_browser_handoff_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/object_row"
      }
    },
    "vocabulary_set": {
      "$ref": "#/$defs/vocabulary_set"
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "object_kind": {
      "type": "string",
      "enum": [
        "docs_source_descriptor",
        "docs_result_object",
        "docs_pack_manifest",
        "derived_explanation_citation_set",
        "version_match_state",
        "stale_example_finding",
        "browser_handoff_object"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "state_vocabulary": {
      "type": "string",
      "enum": [
        "source_class",
        "version_match_state",
        "freshness_state",
        "trust_class",
        "locale_match",
        "mirror_offline_posture",
        "browser_handoff_reason",
        "browser_handoff_privacy_consequence"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": [
        "project_docs",
        "mirrored_official_docs",
        "extension_docs_pack",
        "live_external_docs",
        "curated_knowledge_pack",
        "generated_reference",
        "derived_explanation"
      ]
    },
    "version_match_state_token": {
      "type": "string",
      "enum": [
        "exact_build_match",
        "compatible_minor_drift",
        "incompatible_drift_detected",
        "pre_release_unverified",
        "unknown_target_build"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
