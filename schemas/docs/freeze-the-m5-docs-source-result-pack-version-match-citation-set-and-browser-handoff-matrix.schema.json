        "first_party_authoritative",
        "signed_mirror_verified",
        "extension_pack_signed",
        "live_provider_handoff",
        "derived_inference_only"
      ]
    },
    "locale_match": {
      "type": "string",
      "enum": [
        "source_language_original",
        "translated_complete",
        "translated_partial",
        "translated_stale",
        "source_language_fallback",
        "locale_not_installed"
      ]
    },
    "mirror_offline_posture": {
      "type": "string",
      "enum": [
