        "policy_blocked",
        "mirror_offline",
        "source_version_mismatch",
        "freshness_expired",
        "trust_narrowing",
        "citation_set_expired",
        "source_class_unverified",
        "handoff_context_leak_risk",
        "locale_skew_detected",
        "upstream_dependency_narrowed"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "source_labeled_never_impersonated",
        "citation_bound_expires_with_citations",
        "handoff_isolated_return_path_preserved",
        "version_freshness_visible",
        "not_applicable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "docs_browser",
        "docs_search",
        "ai_explain",
        "onboarding",
        "help_about",
        "support_export",
        "extension_api",
        "release_center",
        "diagnostics",
