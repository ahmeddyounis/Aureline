{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/add-browser-handoff-banners-and-shared-docs-browser-onboarding-glossary-ai-and-support-consumers.schema.json",
  "title": "Aureline M5 docs browser-handoff banner and shared docs-browser consumers",
  "description": "Export-safe packet that implements the reusable M5 browser-handoff banner as a primitive and adopts it, together with the already-built docs search-bar, result-row, symbol-reference-card, source/version-badge, docs-pack-row, and stale-example-finding-row components, across the shared docs-browser, onboarding-tour, glossary-card, AI-evidence-follow, and support/help consumers. Each consumer row binds the shared handoff-banner anatomy, the reused docs-browser components, the handoff reasons, derived in-product necessities, declared privacy exposures, derived privacy consequences, derived return-path postures, handoff actions, corpus/source/version/freshness/pack context, export fields, non-visual accessibility routes, consumer surfaces, downgrade triggers, worked handoff resolution cases, and four hard row invariants. Each worked handoff case explains its destination reason, privacy consequence, return path, and in-product necessity, never understates the privacy consequence, and never flattens into a raw URL jump that strips source/version context. A self-describing vocabulary set freezes the controlled vocabulary. Raw URLs, raw tokens, credentials, private endpoints, document bodies, and prompt text never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_m5_browser_handoff_banners_and_shared_docs_browser_onboarding_glossary_ai_and_support_consumers"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "handoff_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "type": "string", "minLength": 1 },
        "handoff_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "reused_components",
        "banner_anatomy_parts",
        "handoff_reasons",
        "necessities",
        "privacy_exposures",
        "privacy_consequences",
        "return_path_postures",
        "handoff_actions",
        "corpus_classes",
        "source_providers",
        "version_scopes",
        "freshness_states",
        "pack_states",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "handoff_examples",
        "strips_source_version_context",
        "understates_privacy_consequence",
        "flattens_to_raw_url_jump",
        "invents_private_handoff_grammar"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "docs_browser",
            "onboarding_tour",
            "glossary_card",
            "ai_evidence_follow",
            "support_help"
          ]
        },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reused_components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "search_bar",
              "result_row",
              "reference_card",
              "source_version_badge",
              "pack_row",
              "stale_example_row",
              "handoff_banner"
            ]
          }
        },
        "banner_anatomy_parts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "enum": [
              "banner_title_label",
              "destination_reason_badge",
              "in_product_blocker_note",
              "privacy_consequence_notice",
              "source_version_context_badge",
              "return_path_anchor",
              "handoff_action_cluster"
            ]
          },
          "allOf": [
            { "contains": { "const": "destination_reason_badge" } },
            { "contains": { "const": "in_product_blocker_note" } },
            { "contains": { "const": "privacy_consequence_notice" } },
            { "contains": { "const": "source_version_context_badge" } },
            { "contains": { "const": "return_path_anchor" } },
            { "contains": { "const": "handoff_action_cluster" } }
          ]
        },
        "handoff_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "no_local_corpus",
              "interactive_content_required",
              "auth_gated_source",
              "dynamic_rendering_required",
              "external_canonical_source",
              "user_requested_browser"
            ]
          }
        },
        "necessities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "cannot_serve_in_product",
              "should_defer_to_canonical",
              "user_requested_external"
            ]
          }
        },
        "privacy_exposures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "no_data_leaves",
              "anonymous_query_leaves",
              "document_context_leaves",
              "identified_request_leaves",
              "external_account_required"
            ]
          }
        },
        "privacy_consequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "stays_fully_in_product",
              "anonymous_lookup_only",
              "query_context_shared",
              "identified_request_shared",
              "external_account_and_identity_shared"
            ]
          }
        },
        "return_path_postures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["context_preserved_return", "anchored_return", "no_governed_return"]
          }
        },
        "handoff_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "open_in_browser",
              "copy_return_anchor",
              "stay_in_product",
              "export_handoff_packet"
            ]
          }
        },
        "corpus_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "version_scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freshness_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "pack_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "export_fields": {
          "type": "array",
          "minItems": 7,
          "items": {
            "enum": [
              "handoff_reason",
              "destination",
              "in_product_necessity",
              "privacy_exposure",
              "privacy_consequence",
              "return_anchor",
              "source_provider",
              "version_scope",
              "freshness_state",
              "pack_context"
            ]
          },
          "allOf": [
            { "contains": { "const": "handoff_reason" } },
            { "contains": { "const": "in_product_necessity" } },
            { "contains": { "const": "privacy_consequence" } },
            { "contains": { "const": "return_anchor" } },
            { "contains": { "const": "source_provider" } },
            { "contains": { "const": "version_scope" } },
            { "contains": { "const": "freshness_state" } }
          ]
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "handoff_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/handoff_case" }
        },
        "strips_source_version_context": { "const": false },
        "understates_privacy_consequence": { "const": false },
        "flattens_to_raw_url_jump": { "const": false },
        "invents_private_handoff_grammar": { "const": false }
      }
    },
    "handoff_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "handoff_reason",
            "destination_repr",
            "necessity",
            "privacy_consequence",
            "return_path_posture",
            "return_anchor_repr",
            "boundary_disclosed",
            "available_actions"
          ],
          "additionalProperties": true
        }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "shared_components",
        "banner_anatomy_parts",
        "necessities",
        "privacy_exposures",
        "privacy_consequences",
        "return_path_postures",
        "handoff_actions",
        "export_fields",
        "handoff_reasons",
        "corpus_classes",
        "version_scopes",
        "source_providers",
        "freshness_states",
        "pack_states",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "shared_components": { "type": "array", "items": { "type": "string" } },
        "banner_anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "necessities": { "type": "array", "items": { "type": "string" } },
        "privacy_exposures": { "type": "array", "items": { "type": "string" } },
        "privacy_consequences": { "type": "array", "items": { "type": "string" } },
        "return_path_postures": { "type": "array", "items": { "type": "string" } },
        "handoff_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "handoff_reasons": { "type": "array", "items": { "type": "string" } },
        "corpus_classes": { "type": "array", "items": { "type": "string" } },
        "version_scopes": { "type": "array", "items": { "type": "string" } },
        "source_providers": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "pack_states": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
