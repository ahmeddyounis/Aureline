{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/certify-docs-source-pack-version-citation-and-browser-handoff-truth-and-narrow-stale-claims.schema.json",
  "title": "Aureline M5 documentation-claim certification packet",
  "description": "Export-safe packet certifying every claimed M5 documentation-facing profile (docs browser, help/about/service-health, onboarding/learning, AI explanation, support export) against the frozen docs-source/result/pack/version-match/citation-set/browser-handoff matrix and the checked-in evidence corpus those contracts produce. Each profile row binds a profile to the documentation-evidence classes it depends on, the upstream schemas and support exports that form its evidence, the qualification class it earned, a certification verdict, downgrade triggers, and an explicit not-greener-than-matrix flag. The packet carries a compatibility report against the frozen matrix, a machine-readable downgrade-rule set that release/claim/support tooling auto-enforces (narrowing or holding a profile when its source-class, docs-pack-lifecycle, version-match, citation-set, or browser-handoff evidence falls out of the freshness SLO), trust-review and consumer-projection invariants, and a proof-freshness block. This packet is canonical for claimed M5 documentation support in this lane: no profile may stay greener than it or than the frozen matrix. Raw document bodies, raw source files, rendered HTML, raw URLs, raw query text, raw provider payloads, credentials, and live vendor-doc snapshots never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "certification_label",
    "profile_rows",
    "compatibility_report",
    "downgrade_rules",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "evidence_corpus_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "certify_docs_source_pack_version_citation_and_browser_handoff_truth_and_narrow_stale_claims"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certification_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "profile_rows": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/profile_row"
      }
    },
    "compatibility_report": {
      "$ref": "#/$defs/compatibility_report"
    },
    "downgrade_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_rule"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "evidence_corpus_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "profile": {
      "type": "string",
      "enum": [
        "docs_browser",
        "help_about",
        "onboarding_learning",
        "ai_explanation",
        "support_export"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "source_class",
        "docs_pack_lifecycle",
        "version_match",
        "citation_set",
        "browser_handoff"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "certified",
        "narrowed_to_qualified",
        "retest_pending",
        "held_pending_evidence",
        "blocked_underqualified"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "source_class_evidence_stale",
        "docs_pack_lifecycle_evidence_stale",
        "version_match_evidence_stale",
        "citation_set_evidence_stale",
        "browser_handoff_evidence_stale",
        "parity_degraded_vs_matrix",
        "upstream_matrix_narrowed",
        "proof_freshness_expired",
        "greener_than_matrix"
      ]
    },
    "downgrade_action": {
      "type": "string",
      "enum": [
        "narrow_to_beta",
        "narrow_to_preview",
        "mark_retest_pending",
        "hold",
        "block_publication"
      ]
    },
    "profile_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "qualification",
        "verdict",
        "scope_summary",
        "evidence_classes",
        "evidence_schema_refs",
        "evidence_artifact_refs",
        "evidence_packet_refs",
        "downgrade_triggers",
        "not_greener_than_matrix",
        "source_class_disclosed",
        "citation_basis_required",
        "browser_handoff_context_isolated"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_class"
          }
        },
        "evidence_schema_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "evidence_artifact_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "not_greener_than_matrix": {
          "type": "boolean",
          "const": true
        },
        "source_class_disclosed": {
          "type": "boolean",
          "const": true
        },
        "citation_basis_required": {
          "type": "boolean"
        },
        "browser_handoff_context_isolated": {
          "type": "boolean"
        }
      }
    },
    "compatibility_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_artifact_ref",
        "matrix_schema_ref",
        "matrix_schema_version",
        "all_profiles_present",
        "all_evidence_classes_covered",
        "no_profile_greener_than_matrix",
        "every_profile_has_evidence",
        "downgrade_rules_auto_enforced"
      ],
      "properties": {
        "matrix_artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "matrix_schema_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "matrix_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "all_profiles_present": {
          "type": "boolean",
          "const": true
        },
        "all_evidence_classes_covered": {
          "type": "boolean",
          "const": true
        },
        "no_profile_greener_than_matrix": {
          "type": "boolean",
          "const": true
        },
        "every_profile_has_evidence": {
          "type": "boolean",
          "const": true
        },
        "downgrade_rules_auto_enforced": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger",
        "action",
        "applies_to_profiles",
        "applies_to_evidence_classes",
        "auto_enforced",
        "rationale"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "trigger": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "action": {
          "$ref": "#/$defs/downgrade_action"
        },
        "applies_to_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "applies_to_evidence_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_class"
          }
        },
        "auto_enforced": {
          "type": "boolean",
          "const": true
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class_visible_no_vendor_masquerade",
        "version_match_and_freshness_visible",
        "citation_basis_preserved_derived_never_outlives_citations",
        "browser_handoff_context_not_silently_shared",
        "mirror_offline_state_visible",
        "no_profile_greener_than_packet",
        "downgrade_narrows_instead_of_hides",
        "stale_or_partial_evidence_narrows_or_blocks_publication"
      ],
      "properties": {
        "source_class_visible_no_vendor_masquerade": {
          "type": "boolean",
          "const": true
        },
        "version_match_and_freshness_visible": {
          "type": "boolean",
          "const": true
        },
        "citation_basis_preserved_derived_never_outlives_citations": {
          "type": "boolean",
          "const": true
        },
        "browser_handoff_context_not_silently_shared": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_state_visible": {
          "type": "boolean",
          "const": true
        },
        "no_profile_greener_than_packet": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_partial_evidence_narrows_or_blocks_publication": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_gate_consumes_packet",
        "claim_publication_consumes_packet",
        "about_help_service_health_consumes_packet",
        "support_export_consumes_packet",
        "onboarding_consumes_packet",
        "ai_context_consumes_packet",
        "narrowed_profiles_labeled_not_hidden"
      ],
      "properties": {
        "release_gate_consumes_packet": {
          "type": "boolean",
          "const": true
        },
        "claim_publication_consumes_packet": {
          "type": "boolean",
          "const": true
        },
        "about_help_service_health_consumes_packet": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_packet": {
          "type": "boolean",
          "const": true
        },
        "onboarding_consumes_packet": {
          "type": "boolean",
          "const": true
        },
        "ai_context_consumes_packet": {
          "type": "boolean",
          "const": true
        },
        "narrowed_profiles_labeled_not_hidden": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale",
        "retest_pending_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        },
        "retest_pending_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
