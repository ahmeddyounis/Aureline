{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/freeze-the-m5-docs-search-bar-result-row-symbol-reference-card-source-badge-docs-pack-row-and-handoff-banner-component-matrix.schema.json",
  "title": "Aureline M5 docs-browser component matrix",
  "description": "Export-safe packet freezing the canonical M5 documentation-browser component matrix. The packet names every governed docs-browser component family — the docs search bar, the docs scope switcher, the docs result row, the symbol-linked reference card, the docs source/version badge, the docs-pack row, the stale-example finding row, and the browser-handoff banner — and binds each to its qualification class, mandatory and truth labels, the controlled state vocabularies it carries, the docs surface families and deployment lines it must survive with the same truth, the non-visual accessibility routes it must offer, the consumer surfaces that read its projection, the downgrade triggers that narrow it, its required proof packet refs, its source contracts, and four hard component invariants. A self-describing vocabulary set freezes the controlled vocabulary for corpus class, version/package scope, result match state, project-doc override reason, symbol anchor, source provider, freshness state, docs-pack state, stale-example status, browser-handoff reason, docs surface family, deployment line, consumer surface, accessibility route, and required label. Raw document bodies, rendered HTML, raw URLs, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_docs_search_bar_result_row_symbol_linked_reference_card_docs_source_version_badge_docs_pack_row_stale_example_finding_row_and_handoff_banner_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "docs_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "type": "string", "minLength": 1 },
        "docs_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component_family": {
      "enum": [
        "docs_search_bar",
        "docs_scope_switcher",
        "docs_result_row",
        "symbol_linked_reference_card",
        "docs_source_version_badge",
        "docs_pack_row",
        "stale_example_finding_row",
        "docs_handoff_banner"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "corpus_class": {
      "enum": [
        "first_party_docs",
        "api_reference",
        "guide_tutorial",
        "codebase_symbol",
        "community_contributed",
        "vendor_dependency",
        "release_notes_changelog"
      ]
    },
    "version_scope": {
      "enum": [
        "exact_version_match",
        "nearby_version",
        "project_specific",
        "latest_stable",
        "pinned_range",
        "unversioned"
      ]
    },
    "match_state": {
      "enum": [
        "exact_match",
        "nearby_match",
        "project_specific_match",
        "mirrored_match",
        "cached_match",
        "stale_match"
      ]
    },
    "override_reason": {
      "enum": [
        "project_pinned_override",
        "local_freshness_override",
        "explicit_user_preference",
        "vendor_source_unavailable",
        "policy_scoped_override",
        "no_override"
      ]
    },
    "symbol_anchor": {
      "enum": [
        "function_symbol",
        "type_symbol",
        "module_symbol",
        "field_or_method",
        "macro_symbol",
        "unresolved_anchor"
      ]
    },
    "source_provider": {
      "enum": [
        "bundled_local",
        "mirrored_registry",
        "first_party_hosted",
        "third_party_hosted",
        "offline_import",
        "ai_derived"
      ]
    },
    "freshness_state": {
      "enum": [
        "live_current",
        "recently_synced",
        "cached_offline",
        "stale_expired",
        "unknown_freshness"
      ]
    },
    "pack_state": {
      "enum": [
        "pinned_pack",
        "mirrored_pack",
        "offline_pack",
        "quarantined_pack",
        "update_available",
        "unpinned_tracking"
      ]
    },
    "stale_example_status": {
      "enum": [
        "example_current",
        "api_signature_drifted",
        "deprecated_symbol_used",
        "broken_link_target",
        "version_mismatch_example",
        "unverified_example"
      ]
    },
    "handoff_reason": {
      "enum": [
        "no_local_corpus",
        "interactive_content_required",
        "auth_gated_source",
        "dynamic_rendering_required",
        "external_canonical_source",
        "user_requested_browser"
      ]
    },
    "surface_family": {
      "enum": [
        "docs_browser",
        "help_center",
        "onboarding",
        "ai_context",
        "search_palette",
        "hover_peek",
        "support_desk",
        "admin_review"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "consumer_surface": {
      "enum": [
        "docs_browser_ui",
        "help_about",
        "search_palette",
        "hover_peek",
        "onboarding_tour",
        "ai_context_panel",
        "support_export",
        "cli_inspect",
        "admin_console",
        "product_ui"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "enum": ["identity", "state", "keyboard_route", "corpus_class", "source_provider", "freshness"]
    },
    "downgrade_trigger": {
      "enum": [
        "corpus_class_unstated",
        "source_provider_masked",
        "version_scope_unstated",
        "symbol_anchor_unresolved_hidden",
        "project_override_reason_hidden",
        "freshness_hidden",
        "pack_state_misrepresented",
        "stale_example_shown_as_current",
        "handoff_reason_unstated",
        "mirrored_or_cached_shown_as_live",
        "quarantined_pack_shown_as_trusted",
        "proof_stale"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "corpus_classes",
        "version_scopes",
        "match_states",
        "override_reasons",
        "symbol_anchors",
        "source_providers",
        "freshness_states",
        "pack_states",
        "stale_example_statuses",
        "handoff_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_corpus_or_source_provenance",
        "shows_stale_or_cached_as_live_current",
        "invents_private_docs_status_grammar",
        "hides_handoff_reason_or_override_reason"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "corpus_classes": { "type": "array", "items": { "$ref": "#/$defs/corpus_class" } },
        "version_scopes": { "type": "array", "items": { "$ref": "#/$defs/version_scope" } },
        "match_states": { "type": "array", "items": { "$ref": "#/$defs/match_state" } },
        "override_reasons": { "type": "array", "items": { "$ref": "#/$defs/override_reason" } },
        "symbol_anchors": { "type": "array", "items": { "$ref": "#/$defs/symbol_anchor" } },
        "source_providers": { "type": "array", "items": { "$ref": "#/$defs/source_provider" } },
        "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness_state" } },
        "pack_states": { "type": "array", "items": { "$ref": "#/$defs/pack_state" } },
        "stale_example_statuses": {
          "type": "array",
          "items": { "$ref": "#/$defs/stale_example_status" }
        },
        "handoff_reasons": { "type": "array", "items": { "$ref": "#/$defs/handoff_reason" } },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "masks_corpus_or_source_provenance": { "const": false },
        "shows_stale_or_cached_as_live_current": { "const": false },
        "invents_private_docs_status_grammar": { "const": false },
        "hides_handoff_reason_or_override_reason": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_families",
        "corpus_classes",
        "version_scopes",
        "match_states",
        "override_reasons",
        "symbol_anchors",
        "source_providers",
        "freshness_states",
        "pack_states",
        "stale_example_statuses",
        "handoff_reasons",
        "surface_families",
        "deployment_lines",
        "consumer_surfaces",
        "accessibility_routes",
        "required_labels"
      ],
      "properties": {
        "component_families": { "type": "array", "items": { "type": "string" } },
        "corpus_classes": { "type": "array", "items": { "type": "string" } },
        "version_scopes": { "type": "array", "items": { "type": "string" } },
        "match_states": { "type": "array", "items": { "type": "string" } },
        "override_reasons": { "type": "array", "items": { "type": "string" } },
        "symbol_anchors": { "type": "array", "items": { "type": "string" } },
        "source_providers": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "pack_states": { "type": "array", "items": { "type": "string" } },
        "stale_example_statuses": { "type": "array", "items": { "type": "string" } },
        "handoff_reasons": { "type": "array", "items": { "type": "string" } },
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "items": { "type": "string" } },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } },
        "required_labels": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
