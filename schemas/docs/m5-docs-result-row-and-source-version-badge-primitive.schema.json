{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/m5-docs-result-row-and-source-version-badge-primitive.schema.json",
  "title": "Aureline M5 docs-result-row and source-version-badge primitive",
  "description": "Export-safe packet implementing the reusable M5 docs result row and source/version badge as one primitive. The packet binds one row per claimed M5 docs-result consumer — the docs-browser result list, the AI-answer citation, the onboarding step reference, the support answer result, and the CLI result list — to the shared result-row anatomy, result kinds, corpus classes, source providers, derived source-badge classes, match states, project-doc override reasons, rank factors, symbol-match confidences, version scopes, freshness states, derived freshness postures, export fields, non-visual accessibility routes, consumer surfaces, downgrade triggers, worked resolution cases, and four hard result-row invariants. A self-describing vocabulary set freezes the controlled vocabulary for consumer surface, anatomy part, result kind, source-badge class, symbol-match confidence, freshness posture, rank factor, export field, corpus class, version scope, source provider, match state, override reason, freshness state, and accessibility route. Raw URLs, raw tokens, credentials, private endpoints, and result bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "result_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_docs_result_rows_and_source_or_version_badges_with_result_kind_provider_version_scope_symbol_match_confidence_freshness_and_rank_reason_truth"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "result_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/result_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "result_row_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "type": "string", "minLength": 1 },
        "result_row_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "result_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "result_kinds",
        "corpus_classes",
        "source_providers",
        "source_badge_classes",
        "match_states",
        "override_reasons",
        "rank_factors",
        "symbol_match_confidences",
        "version_scopes",
        "freshness_states",
        "freshness_postures",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "masks_source_or_version",
        "shows_cached_or_stale_as_live",
        "invents_private_result_grammar",
        "hides_rank_reason"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "docs_browser_result",
            "ai_answer_citation",
            "onboarding_step_reference",
            "support_answer_result",
            "cli_result_list"
          ]
        },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "anatomy_parts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "enum": [
              "title_label",
              "result_kind_tag",
              "source_provider_badge",
              "version_scope_badge",
              "symbol_match_confidence_cue",
              "freshness_badge",
              "rank_reason_disclosure",
              "open_action"
            ]
          },
          "allOf": [
            { "contains": { "const": "title_label" } },
            { "contains": { "const": "result_kind_tag" } },
            { "contains": { "const": "source_provider_badge" } },
            { "contains": { "const": "version_scope_badge" } },
            { "contains": { "const": "freshness_badge" } },
            { "contains": { "const": "open_action" } }
          ]
        },
        "result_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "doc_page",
              "api_symbol_entry",
              "guide_section",
              "code_symbol_anchor",
              "changelog_entry",
              "example_snippet"
            ]
          }
        },
        "corpus_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_badge_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "local_project_docs",
              "workspace_spec",
              "first_party_reference",
              "cached_mirrored_reference",
              "live_vendor_upstream",
              "extension_contributed",
              "ai_derived_explanation"
            ]
          }
        },
        "match_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "override_reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rank_factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "project_doc_precedence",
              "version_adjacency",
              "mirror_freshness",
              "explicit_preference",
              "vendor_fallback",
              "policy_scoped_ranking"
            ]
          }
        },
        "symbol_match_confidences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "exact_symbol_match",
              "strong_match",
              "partial_match",
              "heuristic_match",
              "unresolved_symbol",
              "not_symbol_scoped"
            ]
          }
        },
        "version_scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freshness_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freshness_postures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "current_live",
              "recently_synced_current",
              "cached_explicit_not_live",
              "mirrored_explicit_not_live",
              "stale_flagged",
              "freshness_unknown"
            ]
          }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string" },
          "allOf": [
            { "contains": { "const": "result_kind" } },
            { "contains": { "const": "source_badge_class" } },
            { "contains": { "const": "source_provider" } },
            { "contains": { "const": "version_scope" } },
            { "contains": { "const": "freshness_state" } },
            { "contains": { "const": "freshness_posture" } }
          ]
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "masks_source_or_version": { "const": false },
        "shows_cached_or_stale_as_live": { "const": false },
        "invents_private_result_grammar": { "const": false },
        "hides_rank_reason": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "anatomy_parts",
        "result_kinds",
        "source_badge_classes",
        "symbol_match_confidences",
        "freshness_postures",
        "rank_factors",
        "export_fields",
        "corpus_classes",
        "version_scopes",
        "source_providers",
        "match_states",
        "override_reasons",
        "freshness_states",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "result_kinds": { "type": "array", "items": { "type": "string" } },
        "source_badge_classes": { "type": "array", "items": { "type": "string" } },
        "symbol_match_confidences": { "type": "array", "items": { "type": "string" } },
        "freshness_postures": { "type": "array", "items": { "type": "string" } },
        "rank_factors": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "corpus_classes": { "type": "array", "items": { "type": "string" } },
        "version_scopes": { "type": "array", "items": { "type": "string" } },
        "source_providers": { "type": "array", "items": { "type": "string" } },
        "match_states": { "type": "array", "items": { "type": "string" } },
        "override_reasons": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
