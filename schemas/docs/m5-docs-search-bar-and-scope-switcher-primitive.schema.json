{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/m5-docs-search-bar-and-scope-switcher-primitive.schema.json",
  "title": "Aureline M5 docs-search-bar and scope-switcher primitive",
  "description": "Export-safe packet implementing the reusable M5 docs search bar and scope switcher as one primitive. The packet binds one row per claimed M5 docs-search consumer — the docs-browser search, the onboarding/tutorial lookup, the AI citation-follow flow, the support/help search, and the CLI docs search — to the shared search-bar anatomy, corpus classes, source providers, provider availabilities, cached/live/mirrored retrieval modes, version scopes, freshness states, derived search-availability postures, search-limit reasons, next actions, export fields, non-visual accessibility routes, consumer surfaces, downgrade triggers, worked resolution cases, and four hard search-bar invariants. A self-describing vocabulary set freezes the controlled vocabulary for consumer surface, anatomy part, provider availability, retrieval mode, search availability, limit reason, next action, export field, corpus class, version scope, source provider, freshness state, and accessibility route. Raw URLs, raw tokens, credentials, private endpoints, and user query bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "search_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_docs_search_bars_and_scope_switchers_with_corpus_class_provider_availability_and_cached_live_state_truth"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "search_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/search_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "description": "Governance-review block; every flag is a hard invariant and must be true.",
      "additionalProperties": true
    },
    "consumer_projection": {
      "type": "object",
      "description": "Consumer projection block; every flag must be true.",
      "additionalProperties": true
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "search_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "type": "string", "minLength": 1 },
        "search_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      },
      "additionalProperties": false
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "search_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "corpus_classes",
        "source_providers",
        "provider_availabilities",
        "retrieval_modes",
        "version_scopes",
        "freshness_states",
        "search_availabilities",
        "limit_reasons",
        "next_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "masks_corpus_or_provider",
        "shows_cached_or_mirrored_as_live",
        "invents_private_search_grammar",
        "hides_degraded_state_reason"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "docs_browser_search",
            "onboarding_tutorial_lookup",
            "ai_citation_follow",
            "support_help_search",
            "cli_docs_search"
          ]
        },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "anatomy_parts": {
          "type": "array",
          "minItems": 4,
          "items": {
            "enum": [
              "corpus_scope_label",
              "provider_availability_cue",
              "scope_target_switcher",
              "retrieval_mode_cue",
              "keyboard_hint",
              "query_input_field",
              "degraded_state_banner",
              "search_availability_verdict"
            ]
          },
          "allOf": [
            { "contains": { "const": "corpus_scope_label" } },
            { "contains": { "const": "scope_target_switcher" } },
            { "contains": { "const": "keyboard_hint" } },
            { "contains": { "const": "search_availability_verdict" } }
          ]
        },
        "corpus_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "provider_availabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "provider_available",
              "provider_degraded",
              "provider_mirror_only",
              "provider_policy_limited",
              "provider_unavailable",
              "provider_availability_unknown"
            ]
          }
        },
        "retrieval_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "live_retrieval",
              "cached_retrieval",
              "mirrored_retrieval",
              "offline_bundled_retrieval",
              "no_corpus_available",
              "retrieval_mode_unknown"
            ]
          }
        },
        "version_scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freshness_states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "search_availabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "search_live_ready",
              "search_cached_ready",
              "search_mirrored_ready",
              "narrowed_provider_degraded",
              "narrowed_policy_limited",
              "degraded_provider_unavailable",
              "degraded_offline_no_corpus",
              "blocked_unknown_state"
            ]
          }
        },
        "limit_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "provider_degraded_reduced_corpus",
              "policy_limited_scope",
              "provider_unavailable_offline",
              "no_local_corpus_offline",
              "search_state_unknown"
            ]
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "use_cached_corpus",
              "request_policy_access",
              "retry_when_online",
              "import_or_hand_off_to_browser",
              "run_availability_check"
            ]
          }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string" },
          "allOf": [
            { "contains": { "const": "corpus_class" } },
            { "contains": { "const": "source_provider" } },
            { "contains": { "const": "provider_availability" } },
            { "contains": { "const": "retrieval_mode" } },
            { "contains": { "const": "search_availability" } }
          ]
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "masks_corpus_or_provider": { "const": false },
        "shows_cached_or_mirrored_as_live": { "const": false },
        "invents_private_search_grammar": { "const": false },
        "hides_degraded_state_reason": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "anatomy_parts",
        "provider_availabilities",
        "retrieval_modes",
        "search_availabilities",
        "limit_reasons",
        "next_actions",
        "export_fields",
        "corpus_classes",
        "version_scopes",
        "source_providers",
        "freshness_states",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "provider_availabilities": { "type": "array", "items": { "type": "string" } },
        "retrieval_modes": { "type": "array", "items": { "type": "string" } },
        "search_availabilities": { "type": "array", "items": { "type": "string" } },
        "limit_reasons": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "corpus_classes": { "type": "array", "items": { "type": "string" } },
        "version_scopes": { "type": "array", "items": { "type": "string" } },
        "source_providers": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
