{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/stable-docs-source-and-result-object-reuse-across-consumer-surfaces.schema.json",
  "title": "Aureline stable docs-source descriptor and docs-result object reuse across consumer surfaces",
  "description": "Export-safe support export that wraps the canonical docs-source/result object reuse packet. The packet materializes one DocsSourceDescriptor per source class and one DocsResult per source, and binds them to per-surface projections that prove the same source/result objects are reused, with identity preserved, across docs search, symbol-linked reference cards, hover/peek docs, AI citations, glossary cards, and support exports. Project documentation, mirrored official docs, extension-contributed docs, live external docs, and derived explanations stay distinguishable; project docs never masquerade as vendor docs; derived explanations never claim primary authority; live external docs always require an explicit browser handoff; a result never silently upgrades the version-match or freshness state of its source; and no surface forces full-content export. Raw document bodies, raw source files, raw URLs, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "export_id",
    "export_packet_id_ref",
    "exported_at",
    "raw_private_material_excluded",
    "ambient_authority_excluded",
    "export_packet"
  ],
  "properties": {
    "record_kind": {
      "const": "stable_docs_source_and_result_object_reuse_support_export"
    },
    "schema_version": { "const": 1 },
    "export_id": { "$ref": "#/$defs/non_empty_string" },
    "export_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
    "exported_at": { "$ref": "#/$defs/non_empty_string" },
    "raw_private_material_excluded": { "const": true },
    "ambient_authority_excluded": { "const": true },
    "export_packet": { "$ref": "#/$defs/reuse_packet" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "source_class": {
      "type": "string",
      "enum": [
        "project_docs",
        "generated_reference",
        "mirrored_official_docs",
        "curated_knowledge_pack",
        "vendor_provider_docs",
        "support_runbook",
        "derived_explanation"
      ]
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "first_party_authoritative",
        "signed_mirror_verified",
        "extension_pack_signed",
        "curated_supported",
        "live_provider_handoff",
        "derived_inference_only"
      ]
    },
    "version_match_state": {
      "type": "string",
      "enum": [
        "exact_build_match",
        "compatible_minor_drift",
        "incompatible_drift_detected",
        "pre_release_unverified",
        "unknown_target_build"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "authoritative_live",
        "warm_cached",
        "degraded_cached",
        "stale",
        "unverified"
      ]
    },
    "mirror_offline_posture": {
      "type": "string",
      "enum": [
        "live_online",
        "local_project_pack",
        "generated_local",
        "mirrored_pack",
        "offline_pinned_pack",
        "cached_local",
        "not_installed",
        "support_pack"
      ]
    },
    "browser_handoff": {
      "type": "string",
      "enum": ["available", "blocked_by_policy", "not_required", "unavailable"]
    },
    "precedence_class": {
      "type": "string",
      "enum": [
        "project_authoritative_only",
        "project_outranks_vendor_default",
        "vendor_override_disclosed",
        "project_vendor_disagreement_inspectable",
        "not_applicable"
      ]
    },
    "inference_marker": {
      "type": "string",
      "enum": ["raw_source", "inference", "heuristic", "generated_summary"]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "docs_search",
        "symbol_reference_card",
        "hover_peek_docs",
        "ai_citation",
        "glossary_card",
        "support_export"
      ]
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "finding_severity": {
      "type": "string",
      "enum": ["info", "warning", "blocker"]
    },
    "finding_kind": {
      "type": "string",
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_packet_identity",
        "missing_source_contracts",
        "source_descriptor_incomplete",
        "source_trust_class_mismatch",
        "source_class_distinguishability_missing",
        "derived_explanation_masquerades_as_primary",
        "live_external_docs_handoff_missing",
        "boundary_disclosure_missing",
        "result_object_incomplete",
        "result_source_ref_unresolved",
        "source_result_truth_mismatch",
        "snippet_forces_full_content",
        "missing_consumer_surface",
        "projection_ref_unresolved",
        "consumer_surface_projection_drift",
        "raw_boundary_material_present",
        "promotion_state_mismatch"
      ]
    },
    "snippet_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snippet_anchor_ref",
        "start_line",
        "end_line",
        "excerpt_char_budget",
        "full_content_excluded"
      ],
      "properties": {
        "snippet_anchor_ref": { "$ref": "#/$defs/non_empty_string" },
        "start_line": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 0 },
        "excerpt_char_budget": { "type": "integer", "minimum": 0 },
        "full_content_excluded": { "type": "boolean" },
        "redaction_note": { "type": "string" }
      }
    },
    "source_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_class",
        "provider_or_pack_id",
        "provider_or_pack_revision_ref",
        "locale",
        "trust_class",
        "browser_handoff",
        "mirror_offline_posture",
        "precedence_class",
        "version_match_state",
        "freshness_state",
        "raw_boundary_material_excluded"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "provider_or_pack_id": { "$ref": "#/$defs/non_empty_string" },
        "provider_or_pack_revision_ref": { "$ref": "#/$defs/non_empty_string" },
        "locale": { "$ref": "#/$defs/non_empty_string" },
        "trust_class": { "$ref": "#/$defs/trust_class" },
        "browser_handoff": { "$ref": "#/$defs/browser_handoff" },
        "browser_handoff_packet_ref": { "type": "string" },
        "mirror_offline_posture": { "$ref": "#/$defs/mirror_offline_posture" },
        "precedence_class": { "$ref": "#/$defs/precedence_class" },
        "version_match_state": { "$ref": "#/$defs/version_match_state" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "pack_manifest_ref": { "type": "string" },
        "disclosure_note": { "type": "string" },
        "raw_boundary_material_excluded": { "type": "boolean" }
      }
    },
    "docs_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "title",
        "docs_source_ref",
        "source_class",
        "trust_class",
        "version_match_state",
        "freshness_state",
        "snippet",
        "support_export_safe_id",
        "raw_boundary_material_excluded"
      ],
      "properties": {
        "result_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "docs_source_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "trust_class": { "$ref": "#/$defs/trust_class" },
        "version_match_state": { "$ref": "#/$defs/version_match_state" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "symbol_refs": { "type": "array", "items": { "type": "string" } },
        "citation_anchor_refs": { "type": "array", "items": { "type": "string" } },
        "snippet": { "$ref": "#/$defs/snippet_meta" },
        "inference_markers": {
          "type": "array",
          "items": { "$ref": "#/$defs/inference_marker" }
        },
        "support_export_safe_id": { "$ref": "#/$defs/non_empty_string" },
        "disclosure_note": { "type": "string" },
        "raw_boundary_material_excluded": { "type": "boolean" }
      }
    },
    "surface_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "projection_id",
        "result_id_ref",
        "source_id_ref",
        "shows_source_class",
        "shows_version_match",
        "shows_freshness",
        "shows_trust_class",
        "preserves_symbol_or_citation_refs",
        "preserves_result_identity",
        "full_content_excluded",
        "local_badge_vocabulary_used"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "projection_id": { "$ref": "#/$defs/non_empty_string" },
        "result_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "shows_source_class": { "type": "boolean" },
        "shows_version_match": { "type": "boolean" },
        "shows_freshness": { "type": "boolean" },
        "shows_trust_class": { "type": "boolean" },
        "preserves_symbol_or_citation_refs": { "type": "boolean" },
        "preserves_result_identity": { "type": "boolean" },
        "full_content_excluded": { "type": "boolean" },
        "local_badge_vocabulary_used": { "type": "boolean" }
      }
    },
    "validation_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/finding_kind" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "reuse_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "surface_label",
        "generated_at",
        "sources",
        "results",
        "surface_projections",
        "source_contract_refs",
        "redaction_class_token",
        "promotion_state"
      ],
      "properties": {
        "record_kind": {
          "const": "stable_docs_source_and_result_object_reuse_packet"
        },
        "schema_version": { "const": 1 },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "sources": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/source_descriptor" }
        },
        "results": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/docs_result" }
        },
        "surface_projections": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/surface_projection" }
        },
        "source_contract_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "validation_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    }
  }
}
