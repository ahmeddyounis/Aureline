{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/release-docs-maintenance.schema.json",
  "title": "Aureline release-docs maintenance surface",
  "description": "Export-safe truth packet for one dedicated README/changelog/onboarding release-docs maintenance surface. It binds the artifact kind, the branch/release/channel publish scope, the publish/export boundary state, the local-versus-shared evidence scope, the scope-before-edit disclosure, the source/version badge, the pending suggestion refs, the reopenable compare history, the in-product integration anchors (release center, help browser, About, support export), and the always-available open-source and diff-review actions. Raw Markdown bodies, raw source files, rendered HTML, raw diffs, raw URLs, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "surface_id",
    "artifact_kind",
    "artifact_ref",
    "audience_scope",
    "publish_scope",
    "publish_boundary_state",
    "evidence_scope",
    "scope_visible_before_edit",
    "active_scope_summary",
    "in_product_maintenance_path",
    "source_version_badge",
    "pending_suggestion_count",
    "pending_suggestion_refs",
    "compare_history",
    "integration_anchors",
    "publish_boundary_notes",
    "open_source_action",
    "open_diff_review_action",
    "surface_refs"
  ],
  "properties": {
    "record_kind": {
      "const": "release_docs_maintenance_surface_record"
    },
    "schema_version": {
      "const": 1
    },
    "surface_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_kind": {
      "$ref": "#/$defs/artifact_kind"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "audience_scope": {
      "$ref": "#/$defs/audience_scope"
    },
    "publish_scope": {
      "$ref": "#/$defs/publish_scope"
    },
    "publish_boundary_state": {
      "$ref": "#/$defs/publish_boundary_state"
    },
    "evidence_scope": {
      "$ref": "#/$defs/evidence_scope"
    },
    "scope_visible_before_edit": {
      "description": "Whether the branch/release/channel scope is shown before edit or export. Must be true.",
      "const": true
    },
    "active_scope_summary": {
      "type": "string",
      "minLength": 1
    },
    "in_product_maintenance_path": {
      "description": "Whether maintenance stays on an in-product path rather than a browser-only or vendor-console-only path. Must be true.",
      "const": true
    },
    "source_version_badge": {
      "$ref": "#/$defs/source_version_badge"
    },
    "pending_suggestion_count": {
      "type": "integer",
      "minimum": 0
    },
    "pending_suggestion_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compare_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compare_entry"
      }
    },
    "integration_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/integration_anchor"
      }
    },
    "publish_boundary_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_source_action": {
      "$ref": "#/$defs/action"
    },
    "open_diff_review_action": {
      "$ref": "#/$defs/action"
    },
    "apply_export_action": {
      "$ref": "#/$defs/action"
    },
    "surface_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "artifact_kind": {
      "type": "string",
      "enum": [
        "readme",
        "changelog",
        "help_article",
        "onboarding_note",
        "module_doc",
        "migration_notes",
        "release_notes",
        "docs_pack",
        "support_runbook",
        "benchmark_copy",
        "screenshot",
        "symbol_reference",
        "markdown_doc"
      ]
    },
    "audience_scope": {
      "type": "string",
      "enum": [
        "developer",
        "maintainer",
        "end_user",
        "release_manager",
        "support_operator",
        "enterprise_admin",
        "public_reader"
      ]
    },
    "publish_boundary_state": {
      "type": "string",
      "enum": [
        "local_only",
        "review_handoff_scoped",
        "publish_handoff_scoped",
        "blocked_unscoped"
      ]
    },
    "evidence_scope": {
      "type": "string",
      "enum": [
        "local_draft",
        "private_branch",
        "shared_review",
        "shared_prerelease",
        "installed_stable"
      ]
    },
    "compare_kind": {
      "type": "string",
      "enum": [
        "working_vs_installed",
        "branch_vs_release",
        "revision_vs_revision",
        "channel_vs_channel"
      ]
    },
    "integration_target": {
      "type": "string",
      "enum": [
        "release_center",
        "help_browser",
        "about_panel",
        "support_export"
      ]
    },
    "freshness_class": {
      "type": "string",
      "enum": [
        "authoritative_live",
        "warm_cached",
        "stale",
        "unverified"
      ]
    },
    "version_match_state": {
      "type": "string",
      "enum": [
        "exact_build_match",
        "compatible_minor_drift",
        "incompatible_drift_detected",
        "unknown_target_build"
      ]
    },
    "publish_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch_scope": {
          "type": "string",
          "minLength": 1
        },
        "release_scope": {
          "type": "string",
          "minLength": 1
        },
        "channel_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_version_badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class_token",
        "source_pack_ref",
        "source_revision_ref",
        "version_or_revision_ref",
        "source_build_at",
        "running_build_identity_ref",
        "freshness_class",
        "version_match_state"
      ],
      "properties": {
        "source_class_token": {
          "type": "string",
          "minLength": 1
        },
        "source_pack_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_revision_ref": {
          "type": "string",
          "minLength": 1
        },
        "version_or_revision_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_build_at": {
          "type": "string",
          "minLength": 1
        },
        "running_build_identity_ref": {
          "type": "string",
          "minLength": 1
        },
        "freshness_class": {
          "$ref": "#/$defs/freshness_class"
        },
        "version_match_state": {
          "$ref": "#/$defs/version_match_state"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ref",
        "action_label",
        "keyboard_reachable"
      ],
      "properties": {
        "action_ref": {
          "type": "string",
          "minLength": 1
        },
        "action_label": {
          "type": "string",
          "minLength": 1
        },
        "keyboard_reachable": {
          "const": true
        }
      }
    },
    "compare_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compare_id",
        "compare_kind",
        "base_ref",
        "base_label",
        "target_ref",
        "target_label",
        "compared_at",
        "diff_summary_ref",
        "changed_section_refs",
        "evidence_scope",
        "reopenable",
        "reopen_action"
      ],
      "properties": {
        "compare_id": {
          "type": "string",
          "minLength": 1
        },
        "compare_kind": {
          "$ref": "#/$defs/compare_kind"
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_label": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_label": {
          "type": "string",
          "minLength": 1
        },
        "compared_at": {
          "type": "string",
          "minLength": 1
        },
        "diff_summary_ref": {
          "type": "string",
          "minLength": 1
        },
        "changed_section_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_scope": {
          "$ref": "#/$defs/evidence_scope"
        },
        "reopenable": {
          "description": "Whether the comparison can be reopened from history. Must be true.",
          "const": true
        },
        "reopen_action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "integration_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "anchor_ref",
        "open_action"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/integration_target"
        },
        "anchor_ref": {
          "type": "string",
          "minLength": 1
        },
        "open_action": {
          "$ref": "#/$defs/action"
        }
      }
    }
  }
}
