{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/m5-docs-authoring-cert-report.schema.json",
  "title": "Aureline M5 docs-authoring certification report",
  "description": "Export-safe report certifying the M5 docs-authoring stack — the Markdown authoring workspace, CommonMark safe preview, docs-maintenance suggestions, docs validation, and docs evidence handoff — across every claimed docs/browser deployment profile (desktop, mirrored, cached, pinned-pack, extension-owned, and browser-handoff). Each profile row binds the surfaces it covers to three certification gates (source/version/freshness truth, safe rendered-preview boundaries, and export/support parity) and an auto-derived qualification class and verdict: a missing safe-preview boundary blocks promotion, and any other failed gate or stale proof narrows the profile below its claimed class. The report carries a roll-up certification index, a compatibility report against the frozen docs-authoring matrix, an auto-enforced downgrade-rule set, trust-review and consumer-projection invariants, published known-limits and migration links, and a proof-freshness block. This report is canonical for claimed M5 docs-authoring support: no profile may stay greener than it. Raw document bodies, raw source files, rendered HTML, raw provider payloads, credentials, and live vendor-doc snapshots never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "report_id",
    "certification_label",
    "profile_rows",
    "certification_index",
    "compatibility_report",
    "downgrade_rules",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "known_limits",
    "migration_refs",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_docs_authoring_certification_report"
    },
    "schema_version": {
      "const": 1
    },
    "report_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certification_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "profile_rows": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/profile_row"
      }
    },
    "certification_index": {
      "$ref": "#/$defs/certification_index"
    },
    "compatibility_report": {
      "$ref": "#/$defs/compatibility_report"
    },
    "downgrade_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_rule"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "known_limits": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "migration_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "profile": {
      "type": "string",
      "enum": [
        "desktop",
        "mirrored",
        "cached",
        "pinned_pack",
        "extension_owned",
        "browser_handoff"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "markdown_authoring_workspace",
        "commonmark_preview",
        "docs_maintenance_suggestions",
        "docs_validation",
        "docs_evidence_handoff"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "certified",
        "narrowed_to_qualified",
        "held_pending_evidence",
        "blocked_underqualified"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "current",
        "stale"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "mirror_offline",
        "source_version_mismatch",
        "freshness_expired",
        "trust_narrowing",
        "scope_expansion_unqualified",
        "unsafe_preview_blocked",
        "missing_export_parity",
        "upstream_dependency_narrowed"
      ]
    },
    "downgrade_action": {
      "type": "string",
      "enum": [
        "narrow_to_beta",
        "narrow_to_preview",
        "hold",
        "block_promotion"
      ]
    },
    "surface_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "schema_ref",
        "artifact_ref",
        "covered"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "schema_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "covered": {
          "type": "boolean"
        }
      }
    },
    "profile_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "claimed_qualification",
        "qualification",
        "verdict",
        "freshness_state",
        "scope_summary",
        "surface_coverage",
        "source_version_freshness_truth",
        "safe_rendered_preview_boundaries",
        "export_support_parity",
        "proof_age_hours",
        "freshness_window_hours",
        "evidence_packet_refs",
        "downgrade_triggers",
        "not_greener_than_matrix"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "claimed_qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "freshness_state": {
          "$ref": "#/$defs/freshness_state"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_coverage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/surface_coverage"
          }
        },
        "source_version_freshness_truth": {
          "type": "boolean"
        },
        "safe_rendered_preview_boundaries": {
          "type": "boolean"
        },
        "export_support_parity": {
          "type": "boolean"
        },
        "proof_age_hours": {
          "type": "integer",
          "minimum": 0
        },
        "freshness_window_hours": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "not_greener_than_matrix": {
          "type": "boolean",
          "const": true
        },
        "narrowing_trigger": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "narrowed_reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "class_cap_trigger": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "class_cap_rationale": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "certification_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_ref",
        "all_profiles_current",
        "all_profiles_certified",
        "certified_profiles",
        "narrowed_profiles",
        "blocked_profiles",
        "covered_surfaces",
        "summary"
      ],
      "properties": {
        "report_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "all_profiles_current": {
          "type": "boolean"
        },
        "all_profiles_certified": {
          "type": "boolean"
        },
        "certified_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "narrowed_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "blocked_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "covered_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "compatibility_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_artifact_ref",
        "matrix_schema_ref",
        "matrix_schema_version",
        "all_profiles_present",
        "no_profile_greener_than_matrix",
        "every_surface_has_schema_and_artifact",
        "downgrade_rules_auto_enforced"
      ],
      "properties": {
        "matrix_artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "matrix_schema_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "matrix_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "all_profiles_present": {
          "type": "boolean",
          "const": true
        },
        "no_profile_greener_than_matrix": {
          "type": "boolean",
          "const": true
        },
        "every_surface_has_schema_and_artifact": {
          "type": "boolean",
          "const": true
        },
        "downgrade_rules_auto_enforced": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger",
        "action",
        "applies_to",
        "auto_enforced",
        "rationale"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "trigger": {
          "$ref": "#/$defs/downgrade_trigger"
        },
        "action": {
          "$ref": "#/$defs/downgrade_action"
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "auto_enforced": {
          "type": "boolean",
          "const": true
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_canonical_rendered_safe_and_labeled",
        "rendered_preview_safe_by_default",
        "preview_not_privileged_execution_path",
        "suggestions_diff_first_never_auto_applied",
        "source_version_freshness_truth_visible",
        "validation_state_never_silently_upgraded",
        "evidence_handoff_source_linked",
        "handoff_never_hides_owner_origin_or_boundary",
        "handoff_never_silently_widens_authority",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion",
        "no_profile_greener_than_report"
      ],
      "properties": {
        "source_canonical_rendered_safe_and_labeled": {
          "type": "boolean",
          "const": true
        },
        "rendered_preview_safe_by_default": {
          "type": "boolean",
          "const": true
        },
        "preview_not_privileged_execution_path": {
          "type": "boolean",
          "const": true
        },
        "suggestions_diff_first_never_auto_applied": {
          "type": "boolean",
          "const": true
        },
        "source_version_freshness_truth_visible": {
          "type": "boolean",
          "const": true
        },
        "validation_state_never_silently_upgraded": {
          "type": "boolean",
          "const": true
        },
        "evidence_handoff_source_linked": {
          "type": "boolean",
          "const": true
        },
        "handoff_never_hides_owner_origin_or_boundary": {
          "type": "boolean",
          "const": true
        },
        "handoff_never_silently_widens_authority": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        },
        "no_profile_greener_than_report": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_gate_consumes_report",
        "cli_headless_shows_certification",
        "support_export_shows_certification",
        "diagnostics_shows_certification",
        "help_about_shows_certification",
        "release_center_shows_certification",
        "evidence_index_references_report",
        "narrowed_profiles_labeled_not_hidden"
      ],
      "properties": {
        "release_gate_consumes_report": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_certification": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_certification": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_shows_certification": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_certification": {
          "type": "boolean",
          "const": true
        },
        "release_center_shows_certification": {
          "type": "boolean",
          "const": true
        },
        "evidence_index_references_report": {
          "type": "boolean",
          "const": true
        },
        "narrowed_profiles_labeled_not_hidden": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
