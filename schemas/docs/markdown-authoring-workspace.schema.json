{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/markdown-authoring-workspace.schema.json",
  "title": "Aureline Markdown authoring workspace",
  "description": "Export-safe truth packet for one governed Markdown authoring workspace. It binds the active source/split/rendered mode, the remembered mode preference, the stable keyboard-reachable mode commands, the always-available recovery back to raw source, the CommonMark baseline and enabled/active extension disclosure, the rendered-preview sanitization posture, the diagram/math/custom-component capability posture, the source/version/freshness badge, the mirror/offline state, the publish-boundary state, the browser-handoff availability, and the initiating code/doc anchor context. Raw Markdown bodies, raw source files, rendered HTML, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "workspace_id",
    "workspace_label",
    "artifact_kind",
    "artifact_ref",
    "active_mode",
    "remembered_mode_preference",
    "mode_commands",
    "recover_to_source_command",
    "commonmark_baseline",
    "commonmark_baseline_note",
    "enabled_extensions",
    "sanitization_state",
    "render_capabilities",
    "source_version_badge",
    "mirror_offline_state",
    "publish_boundary_state",
    "browser_handoff_availability",
    "open_source_action",
    "rendered_is_not_canonical_note",
    "surface_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "markdown_authoring_workspace_record"
    },
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "workspace_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "artifact_kind": {
      "$ref": "#/$defs/artifact_kind"
    },
    "artifact_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "active_mode": {
      "$ref": "#/$defs/workspace_mode"
    },
    "remembered_mode_preference": {
      "$ref": "#/$defs/workspace_mode"
    },
    "mode_commands": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/mode_command"
      }
    },
    "recover_to_source_command": {
      "$ref": "#/$defs/recovery_command"
    },
    "commonmark_baseline": {
      "type": "boolean",
      "const": true
    },
    "commonmark_baseline_note": {
      "$ref": "#/$defs/non_empty_string"
    },
    "enabled_extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "active_extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "sanitization_state": {
      "$ref": "#/$defs/sanitization_state"
    },
    "sanitization_note": {
      "$ref": "#/$defs/non_empty_string"
    },
    "render_capabilities": {
      "$ref": "#/$defs/render_capabilities"
    },
    "source_version_badge": {
      "$ref": "#/$defs/source_version_badge"
    },
    "mirror_offline_state": {
      "$ref": "#/$defs/mirror_offline_posture"
    },
    "publish_boundary_state": {
      "$ref": "#/$defs/publish_boundary_state"
    },
    "browser_handoff_availability": {
      "$ref": "#/$defs/browser_handoff_availability"
    },
    "open_source_action": {
      "$ref": "#/$defs/maintenance_action"
    },
    "open_browser_action": {
      "$ref": "#/$defs/maintenance_action"
    },
    "anchor_context": {
      "$ref": "#/$defs/anchor"
    },
    "rendered_is_not_canonical_note": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "workspace_mode": {
      "type": "string",
      "enum": [
        "source",
        "split",
        "rendered"
      ]
    },
    "artifact_kind": {
      "type": "string",
      "enum": [
        "readme",
        "changelog",
        "help_article",
        "onboarding_note",
        "module_doc",
        "migration_notes",
        "release_notes",
        "docs_pack",
        "support_runbook",
        "benchmark_copy",
        "screenshot",
        "symbol_reference",
        "markdown_doc"
      ]
    },
    "sanitization_state": {
      "type": "string",
      "enum": [
        "sanitized_safe",
        "raw_html_blocked",
        "raw_html_allowed_disclosed",
        "not_applicable"
      ]
    },
    "render_capability": {
      "type": "string",
      "enum": [
        "disabled",
        "sandboxed_opt_in",
        "blocked",
        "not_applicable"
      ]
    },
    "freshness_class": {
      "type": "string",
      "enum": [
        "authoritative_live",
        "warm_cached",
        "degraded_cached",
        "stale",
        "unverified"
      ]
    },
    "version_match_state": {
      "type": "string",
      "enum": [
        "exact_build_match",
        "compatible_minor_drift",
        "incompatible_drift_detected",
        "pre_release_unverified",
        "unknown_target_build"
      ]
    },
    "mirror_offline_posture": {
      "type": "string",
      "enum": [
        "live_online",
        "local_project_pack",
        "generated_local",
        "mirrored_pack",
        "offline_pinned_pack",
        "cached_local",
        "not_installed",
        "support_pack"
      ]
    },
    "publish_boundary_state": {
      "type": "string",
      "enum": [
        "local_only",
        "review_handoff_scoped",
        "publish_handoff_scoped",
        "blocked_unscoped"
      ]
    },
    "browser_handoff_availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable_offline",
        "blocked_policy",
        "not_applicable"
      ]
    },
    "anchor_kind": {
      "type": "string",
      "enum": [
        "code_symbol",
        "code_file",
        "doc_section",
        "review_thread",
        "release_note",
        "search_result"
      ]
    },
    "mode_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "target_mode",
        "key_binding",
        "keyboard_reachable",
        "label"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "target_mode": {
          "$ref": "#/$defs/workspace_mode"
        },
        "key_binding": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keyboard_reachable": {
          "type": "boolean",
          "const": true
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "recovery_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "key_binding",
        "keyboard_reachable",
        "label",
        "reverts_to_mode"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "key_binding": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keyboard_reachable": {
          "type": "boolean",
          "const": true
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reverts_to_mode": {
          "const": "source"
        }
      }
    },
    "render_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagrams",
        "math",
        "custom_components"
      ],
      "properties": {
        "diagrams": {
          "$ref": "#/$defs/render_capability"
        },
        "math": {
          "$ref": "#/$defs/render_capability"
        },
        "custom_components": {
          "$ref": "#/$defs/render_capability"
        }
      }
    },
    "source_version_badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class_token",
        "source_pack_ref",
        "source_revision_ref",
        "version_or_revision_ref",
        "source_build_at",
        "running_build_identity_ref",
        "freshness_class",
        "version_match_state"
      ],
      "properties": {
        "source_class_token": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_pack_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_revision_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "version_or_revision_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_build_at": {
          "$ref": "#/$defs/non_empty_string"
        },
        "running_build_identity_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "freshness_class": {
          "$ref": "#/$defs/freshness_class"
        },
        "version_match_state": {
          "$ref": "#/$defs/version_match_state"
        }
      }
    },
    "maintenance_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ref",
        "action_label",
        "keyboard_reachable"
      ],
      "properties": {
        "action_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "action_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keyboard_reachable": {
          "type": "boolean"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_kind",
        "anchor_ref",
        "anchor_label",
        "preserved_across_modes"
      ],
      "properties": {
        "anchor_kind": {
          "$ref": "#/$defs/anchor_kind"
        },
        "anchor_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "anchor_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "preserved_across_modes": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
