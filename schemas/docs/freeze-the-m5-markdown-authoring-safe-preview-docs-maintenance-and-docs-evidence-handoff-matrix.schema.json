{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/freeze-the-m5-markdown-authoring-safe-preview-docs-maintenance-and-docs-evidence-handoff-matrix.schema.json",
  "title": "Aureline M5 Markdown-authoring, safe-preview, docs-maintenance, and docs-evidence-handoff matrix",
  "description": "Export-safe packet freezing the M5 depth qualification for the five docs-authoring surfaces: the Markdown authoring workspace, the CommonMark safe-preview baseline, docs-maintenance suggestions, docs validation, and docs evidence handoff. The packet binds each surface to its qualification class, supported workspace modes, rendered-preview safety class, validation states, docs-suggestion triggers, evidence-handoff scope, evidence requirements, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. Raw document bodies, raw source files, rendered HTML, raw provider payloads, credentials, and live vendor-doc snapshots never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "lane_rows",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_markdown_authoring_safe_preview_docs_maintenance_and_docs_evidence_handoff_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "lane_rows": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/lane_row"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "release_posture": {
      "$ref": "#/$defs/release_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "surface": {
      "type": "string",
      "enum": [
        "markdown_authoring_workspace",
        "commonmark_preview",
        "docs_maintenance_suggestions",
        "docs_validation",
        "docs_evidence_handoff"
      ]
    },
    "qualification_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "workspace_mode": {
      "type": "string",
      "enum": [
        "source",
        "split",
        "rendered"
      ]
    },
    "preview_safety_class": {
      "type": "string",
      "enum": [
        "sanitized_safe",
        "raw_html_blocked",
        "raw_html_allowed_disclosed",
        "not_applicable"
      ]
    },
    "validation_state": {
      "type": "string",
      "enum": [
        "validated",
        "suspected_stale",
        "unchanged_unverified",
        "unsupported",
        "skipped",
        "stale_rerun_required",
        "not_validated"
      ]
    },
    "suggestion_trigger": {
      "type": "string",
      "enum": [
        "code_diff",
        "stale_example",
        "release_note_drift",
        "failing_snippet",
        "contract_change",
        "human_note"
      ]
    },
    "evidence_handoff_scope": {
      "type": "string",
      "enum": [
        "local_only",
        "review_handoff_scoped",
        "publish_handoff_scoped",
        "blocked_unscoped"
      ]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "optional",
        "not_applicable"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "mirror_offline",
        "source_version_mismatch",
        "freshness_expired",
        "trust_narrowing",
        "scope_expansion_unqualified",
        "unsafe_preview_blocked",
        "upstream_dependency_narrowed"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "source_canonical_no_mutation",
        "diff_first_review_required",
        "return_path_preserved",
        "evidence_preserved_no_revert",
        "not_applicable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "authoring_workspace",
        "preview_pane",
        "docs_maintenance_panel",
        "docs_browser",
        "browser_companion",
        "cli_headless",
        "support_export",
        "release_center",
        "diagnostics",
        "help_about"
      ]
    },
    "lane_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "qualification",
        "scope_summary",
        "supported_workspace_modes",
        "preview_safety_class",
        "validation_states",
        "suggestion_triggers",
        "evidence_handoff_scope",
        "evidence_requirement",
        "required_evidence_packet_refs",
        "downgrade_triggers",
        "rollback_posture",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "qualification": {
          "$ref": "#/$defs/qualification_class"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "supported_workspace_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workspace_mode"
          }
        },
        "preview_safety_class": {
          "$ref": "#/$defs/preview_safety_class"
        },
        "validation_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validation_state"
          }
        },
        "suggestion_triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggestion_trigger"
          }
        },
        "evidence_handoff_scope": {
          "$ref": "#/$defs/evidence_handoff_scope"
        },
        "evidence_requirement": {
          "$ref": "#/$defs/evidence_requirement"
        },
        "required_evidence_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_canonical_rendered_safe_and_labeled",
        "rendered_preview_safe_by_default",
        "preview_not_privileged_execution_path",
        "suggestions_diff_first_never_auto_applied",
        "source_version_freshness_truth_visible",
        "validation_state_never_silently_upgraded",
        "evidence_handoff_source_linked",
        "handoff_never_hides_owner_origin_or_boundary",
        "handoff_never_silently_widens_authority",
        "no_full_browser_collab_editor_or_remote_cms",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "source_canonical_rendered_safe_and_labeled": {
          "type": "boolean",
          "const": true
        },
        "rendered_preview_safe_by_default": {
          "type": "boolean",
          "const": true
        },
        "preview_not_privileged_execution_path": {
          "type": "boolean",
          "const": true
        },
        "suggestions_diff_first_never_auto_applied": {
          "type": "boolean",
          "const": true
        },
        "source_version_freshness_truth_visible": {
          "type": "boolean",
          "const": true
        },
        "validation_state_never_silently_upgraded": {
          "type": "boolean",
          "const": true
        },
        "evidence_handoff_source_linked": {
          "type": "boolean",
          "const": true
        },
        "handoff_never_hides_owner_origin_or_boundary": {
          "type": "boolean",
          "const": true
        },
        "handoff_never_silently_widens_authority": {
          "type": "boolean",
          "const": true
        },
        "no_full_browser_collab_editor_or_remote_cms": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_workspace_shows_mode_and_source_truth",
        "preview_shows_safety_class",
        "maintenance_panel_shows_suggestion_triggers_and_diff",
        "validation_shows_state",
        "evidence_handoff_shows_scope_and_source_link",
        "cli_headless_shows_qualification",
        "support_export_shows_qualification",
        "release_center_shows_qualification",
        "help_about_shows_qualification",
        "preview_labs_label_for_unqualified_surfaces"
      ],
      "properties": {
        "authoring_workspace_shows_mode_and_source_truth": {
          "type": "boolean",
          "const": true
        },
        "preview_shows_safety_class": {
          "type": "boolean",
          "const": true
        },
        "maintenance_panel_shows_suggestion_triggers_and_diff": {
          "type": "boolean",
          "const": true
        },
        "validation_shows_state": {
          "type": "boolean",
          "const": true
        },
        "evidence_handoff_shows_scope_and_source_link": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_qualification": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_qualification": {
          "type": "boolean",
          "const": true
        },
        "release_center_shows_qualification": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_qualification": {
          "type": "boolean",
          "const": true
        },
        "preview_labs_label_for_unqualified_surfaces": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "mirror_offline_packet_ref",
        "support_export_parity_required",
        "mirror_offline_parity_required"
      ],
      "properties": {
        "release_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mirror_offline_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_parity_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
