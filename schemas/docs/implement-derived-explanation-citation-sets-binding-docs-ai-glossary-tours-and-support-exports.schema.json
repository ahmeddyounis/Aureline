{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/implement-derived-explanation-citation-sets-binding-docs-ai-glossary-tours-and-support-exports.schema.json",
  "title": "Aureline derived-explanation citation sets binding docs, AI, glossary, tours, and support exports",
  "description": "Export-safe support export that wraps the derived-explanation citation-sets packet. Every claimed M5 derived explanation - a docs-browser explanation, an AI answer, a glossary card, a guided-tour step, an architecture explainer, or a support-export note - attaches exactly one citation set or explicitly labels itself an inference. A citation set binds one explanation to the concrete evidence it depended on: cited files, cited symbols, cited docs nodes, the code-graph epoch, the locale, and the derivation tool/version. A direct-citation set names at least one cited file, symbol, or docs node; a labeled-inference set carries an explicit inference label and never claims primary authority (its trust class stays derived_inference_only). The citation basis survives offline, mirrored, localized, and support-export flows even when raw content is redacted or omitted, and the support-export projection preserves every citation set. Raw document bodies, raw source files, raw URLs, raw provider payloads, prompt text, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "export_id",
    "export_packet_id_ref",
    "exported_at",
    "raw_private_material_excluded",
    "ambient_authority_excluded",
    "citation_basis_preserved",
    "export_packet"
  ],
  "properties": {
    "record_kind": { "const": "derived_explanation_citation_sets_support_export" },
    "schema_version": { "const": 1 },
    "export_id": { "$ref": "#/$defs/non_empty_string" },
    "export_packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
    "exported_at": { "$ref": "#/$defs/non_empty_string" },
    "raw_private_material_excluded": { "const": true },
    "ambient_authority_excluded": { "const": true },
    "citation_basis_preserved": { "const": true },
    "export_packet": { "$ref": "#/$defs/packet" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "surface": {
      "type": "string",
      "enum": [
        "docs_browser_explanation",
        "ai_answer",
        "glossary_card",
        "guided_tour_step",
        "architecture_explainer",
        "support_export_note"
      ]
    },
    "basis": {
      "type": "string",
      "enum": ["direct_citation", "labeled_inference"]
    },
    "redaction": {
      "type": "string",
      "enum": [
        "content_inline_preserved",
        "content_redacted_basis_preserved",
        "content_omitted_basis_preserved"
      ]
    },
    "inference_confidence": {
      "type": "string",
      "enum": ["grounded", "heuristic", "speculative"]
    },
    "source_class": {
      "type": "string",
      "enum": [
        "project_docs",
        "mirrored_official_docs",
        "extension_docs_pack",
        "live_external_docs",
        "curated_knowledge_pack",
        "generated_reference",
        "derived_explanation"
      ]
    },
    "version_match_state": {
      "type": "string",
      "enum": [
        "exact_build_match",
        "compatible_minor_drift",
        "incompatible_drift_detected",
        "pre_release_unverified",
        "unknown_target_build"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "authoritative_live",
        "warm_cached",
        "degraded_cached",
        "stale",
        "unverified"
      ]
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "first_party_authoritative",
        "signed_mirror_verified",
        "extension_pack_signed",
        "live_provider_handoff",
        "derived_inference_only"
      ]
    },
    "locale_match": {
      "type": "string",
      "enum": [
        "source_language_original",
        "translated_complete",
        "translated_partial",
        "translated_stale",
        "source_language_fallback",
        "locale_not_installed"
      ]
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "validation_severity": {
      "type": "string",
      "enum": ["blocker", "warning"]
    },
    "validation_kind": {
      "type": "string",
      "enum": [
        "wrong_record_kind",
        "wrong_schema_version",
        "missing_packet_identity",
        "missing_source_contracts",
        "missing_citation_sets",
        "citation_set_incomplete",
        "duplicate_citation_set_id",
        "duplicate_explanation_binding",
        "citation_basis_missing",
        "inference_label_missing",
        "basis_trust_inconsistent",
        "graph_epoch_missing",
        "derivation_tool_missing",
        "redaction_drops_citation_basis",
        "surface_coverage_missing",
        "required_surface_projection_missing",
        "consumer_projection_packet_id_mismatch",
        "consumer_projection_drops_reuse",
        "consumer_projection_orphan_citation_ref",
        "support_export_drops_citation_basis",
        "raw_boundary_material_present",
        "citation_freshness_narrowed",
        "speculative_inference_narrowed",
        "promotion_state_mismatch"
      ]
    },
    "cited_file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_path_ref", "content_digest_ref", "source_class"],
      "properties": {
        "file_path_ref": { "$ref": "#/$defs/non_empty_string" },
        "content_digest_ref": { "$ref": "#/$defs/non_empty_string" },
        "line_span_ref": { "type": "string" },
        "source_class": { "$ref": "#/$defs/source_class" }
      }
    },
    "cited_symbol_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol_ref", "graph_node_ref", "kind_label"],
      "properties": {
        "symbol_ref": { "$ref": "#/$defs/non_empty_string" },
        "container_ref": { "type": "string" },
        "graph_node_ref": { "$ref": "#/$defs/non_empty_string" },
        "kind_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cited_doc_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_node_ref",
        "source_class",
        "version_match",
        "freshness",
        "locale",
        "trust_class"
      ],
      "properties": {
        "doc_node_ref": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "version_match": { "$ref": "#/$defs/version_match_state" },
        "freshness": { "$ref": "#/$defs/freshness_state" },
        "locale": { "$ref": "#/$defs/locale_match" },
        "trust_class": { "$ref": "#/$defs/trust_class" }
      }
    },
    "graph_epoch_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch_ref", "workspace_revision_ref", "captured_at"],
      "properties": {
        "epoch_ref": { "$ref": "#/$defs/non_empty_string" },
        "workspace_revision_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "derivation_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_ref", "tool_version_ref"],
      "properties": {
        "tool_ref": { "$ref": "#/$defs/non_empty_string" },
        "tool_version_ref": { "$ref": "#/$defs/non_empty_string" },
        "model_ref": { "type": "string" }
      }
    },
    "inference_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "inferred_from_summary", "confidence"],
      "properties": {
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "inferred_from_summary": { "$ref": "#/$defs/non_empty_string" },
        "confidence": { "$ref": "#/$defs/inference_confidence" }
      }
    },
    "citation_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_set_id",
        "explanation_id",
        "explanation_surface",
        "explanation_label",
        "basis",
        "source_class",
        "trust_class",
        "freshness",
        "locale",
        "cited_files",
        "cited_symbols",
        "cited_docs",
        "graph_epoch",
        "derivation",
        "redaction",
        "raw_boundary_material_excluded"
      ],
      "properties": {
        "citation_set_id": { "$ref": "#/$defs/non_empty_string" },
        "explanation_id": { "$ref": "#/$defs/non_empty_string" },
        "explanation_surface": { "$ref": "#/$defs/surface" },
        "explanation_label": { "$ref": "#/$defs/non_empty_string" },
        "basis": { "$ref": "#/$defs/basis" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "trust_class": { "$ref": "#/$defs/trust_class" },
        "freshness": { "$ref": "#/$defs/freshness_state" },
        "locale": { "$ref": "#/$defs/locale_match" },
        "cited_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/cited_file_ref" }
        },
        "cited_symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/cited_symbol_ref" }
        },
        "cited_docs": {
          "type": "array",
          "items": { "$ref": "#/$defs/cited_doc_ref" }
        },
        "graph_epoch": { "$ref": "#/$defs/graph_epoch_ref" },
        "derivation": { "$ref": "#/$defs/derivation_tool" },
        "inference_label": { "$ref": "#/$defs/inference_label" },
        "redaction": { "$ref": "#/$defs/redaction" },
        "raw_boundary_material_excluded": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "projection_ref",
        "packet_id_ref",
        "reuses_shared_citation_object",
        "preserves_inference_label",
        "preserves_citation_basis_on_export",
        "citation_set_id_refs"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/surface" },
        "projection_ref": { "$ref": "#/$defs/non_empty_string" },
        "packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "reuses_shared_citation_object": { "type": "boolean" },
        "preserves_inference_label": { "type": "boolean" },
        "preserves_citation_basis_on_export": { "type": "boolean" },
        "citation_set_id_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "validation_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/validation_kind" },
        "severity": { "$ref": "#/$defs/validation_severity" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "surface_label",
        "generated_at",
        "citation_sets",
        "consumer_projections",
        "source_contract_refs",
        "redaction_class_token",
        "promotion_state"
      ],
      "properties": {
        "record_kind": { "const": "derived_explanation_citation_sets_packet" },
        "schema_version": { "const": 1 },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "surface_label": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "citation_sets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation_set" }
        },
        "consumer_projections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_projection" }
        },
        "source_contract_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "validation_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    }
  }
}
