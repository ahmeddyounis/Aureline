{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/docs/docs-rendered-preview-capabilities.schema.json",
  "title": "Aureline rendered-preview capability boundary",
  "description": "Export-safe truth packet for the capability boundaries a single docs rendered preview enforces. It binds the owning workspace ref, the active source/split/rendered mode, the disclosed surface owner/origin, the rendered-preview sanitization posture, one capability boundary per capability kind (diagrams, front matter, math, callouts, remote assets, custom components) with its request state, render posture, visible boundary cue, raw/source escape, no-authority-expansion posture, and external-open path, the always-available recovery back to raw source, the open-source action, the theme/zoom/density/motion/keyboard accessibility parity posture, the no-authority-expansion and not-canonical disclosures, the source/version/freshness badge, the mirror/offline state, and the publish-boundary state. Raw Markdown bodies, raw source files, rendered HTML, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "boundary_id",
    "boundary_label",
    "workspace_ref",
    "artifact_kind",
    "artifact_ref",
    "active_mode",
    "surface_owner",
    "origin_disclosure",
    "sanitization_state",
    "capability_boundaries",
    "recover_to_source_command",
    "open_source_action",
    "accessibility_parity",
    "no_authority_expansion_note",
    "rendered_is_not_canonical_note",
    "source_version_badge",
    "mirror_offline_state",
    "publish_boundary_state",
    "surface_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "rendered_preview_boundary_record"
    },
    "schema_version": {
      "const": 1
    },
    "boundary_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "boundary_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "workspace_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "artifact_kind": {
      "$ref": "#/$defs/artifact_kind"
    },
    "artifact_ref": {
      "$ref": "#/$defs/non_empty_string"
    },
    "active_mode": {
      "$ref": "#/$defs/workspace_mode"
    },
    "surface_owner": {
      "$ref": "#/$defs/surface_owner"
    },
    "origin_disclosure": {
      "$ref": "#/$defs/non_empty_string"
    },
    "sanitization_state": {
      "$ref": "#/$defs/sanitization_state"
    },
    "sanitization_note": {
      "$ref": "#/$defs/non_empty_string"
    },
    "capability_boundaries": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/capability_boundary"
      }
    },
    "recover_to_source_command": {
      "$ref": "#/$defs/recovery_command"
    },
    "open_source_action": {
      "$ref": "#/$defs/maintenance_action"
    },
    "accessibility_parity": {
      "$ref": "#/$defs/accessibility_parity"
    },
    "no_authority_expansion_note": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rendered_is_not_canonical_note": {
      "$ref": "#/$defs/non_empty_string"
    },
    "source_version_badge": {
      "$ref": "#/$defs/source_version_badge"
    },
    "mirror_offline_state": {
      "$ref": "#/$defs/mirror_offline_posture"
    },
    "publish_boundary_state": {
      "$ref": "#/$defs/publish_boundary_state"
    },
    "surface_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "workspace_mode": {
      "type": "string",
      "enum": [
        "source",
        "split",
        "rendered"
      ]
    },
    "artifact_kind": {
      "type": "string",
      "enum": [
        "readme",
        "changelog",
        "help_article",
        "onboarding_note",
        "module_doc",
        "migration_notes",
        "release_notes",
        "docs_pack",
        "support_runbook",
        "benchmark_copy",
        "screenshot",
        "symbol_reference",
        "markdown_doc"
      ]
    },
    "surface_owner": {
      "type": "string",
      "enum": [
        "docs_preview_sandbox",
        "disclosed_browser_companion",
        "impersonated_native_shell",
        "impersonated_browser_control_plane"
      ]
    },
    "sanitization_state": {
      "type": "string",
      "enum": [
        "sanitized_safe",
        "raw_html_blocked",
        "raw_html_allowed_disclosed",
        "not_applicable"
      ]
    },
    "capability_kind": {
      "type": "string",
      "enum": [
        "diagrams",
        "front_matter",
        "math",
        "callouts",
        "remote_assets",
        "custom_components"
      ]
    },
    "request_state": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested_awaiting_consent",
        "granted_sandboxed",
        "denied_by_policy",
        "not_applicable"
      ]
    },
    "render_posture": {
      "type": "string",
      "enum": [
        "disabled",
        "sandboxed_active",
        "static_only",
        "raw_fallback",
        "blocked",
        "not_applicable"
      ]
    },
    "authority_posture": {
      "type": "string",
      "enum": [
        "no_authority_expansion",
        "impersonates_native_approval",
        "claims_browser_control_plane"
      ]
    },
    "external_open_state": {
      "type": "string",
      "enum": [
        "available",
        "blocked_by_policy",
        "not_required",
        "unavailable"
      ]
    },
    "freshness_class": {
      "type": "string",
      "enum": [
        "authoritative_live",
        "warm_cached",
        "degraded_cached",
        "stale",
        "unverified"
      ]
    },
    "version_match_state": {
      "type": "string",
      "enum": [
        "exact_build_match",
        "compatible_minor_drift",
        "incompatible_drift_detected",
        "pre_release_unverified",
        "unknown_target_build"
      ]
    },
    "mirror_offline_posture": {
      "type": "string",
      "enum": [
        "live_online",
        "local_project_pack",
        "generated_local",
        "mirrored_pack",
        "offline_pinned_pack",
        "cached_local",
        "not_installed",
        "support_pack"
      ]
    },
    "publish_boundary_state": {
      "type": "string",
      "enum": [
        "local_only",
        "review_handoff_scoped",
        "publish_handoff_scoped",
        "blocked_unscoped"
      ]
    },
    "capability_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_kind",
        "request_state",
        "render_posture",
        "boundary_cue",
        "escape_to_source_available",
        "authority_posture",
        "external_open_state"
      ],
      "properties": {
        "capability_kind": {
          "$ref": "#/$defs/capability_kind"
        },
        "request_state": {
          "$ref": "#/$defs/request_state"
        },
        "render_posture": {
          "$ref": "#/$defs/render_posture"
        },
        "boundary_cue": {
          "$ref": "#/$defs/non_empty_string"
        },
        "escape_to_source_available": {
          "type": "boolean"
        },
        "authority_posture": {
          "$ref": "#/$defs/authority_posture"
        },
        "external_open_state": {
          "$ref": "#/$defs/external_open_state"
        },
        "open_externally_action": {
          "$ref": "#/$defs/maintenance_action"
        },
        "consent_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "note": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "recovery_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "key_binding",
        "keyboard_reachable",
        "label",
        "reverts_to_mode"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "key_binding": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keyboard_reachable": {
          "type": "boolean",
          "const": true
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reverts_to_mode": {
          "const": "source"
        }
      }
    },
    "accessibility_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_parity",
        "zoom_parity",
        "density_parity",
        "reduced_motion_parity",
        "keyboard_parity"
      ],
      "properties": {
        "theme_parity": {
          "type": "boolean"
        },
        "zoom_parity": {
          "type": "boolean"
        },
        "density_parity": {
          "type": "boolean"
        },
        "reduced_motion_parity": {
          "type": "boolean"
        },
        "keyboard_parity": {
          "type": "boolean"
        },
        "parity_note": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "source_version_badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class_token",
        "source_pack_ref",
        "source_revision_ref",
        "version_or_revision_ref",
        "source_build_at",
        "running_build_identity_ref",
        "freshness_class",
        "version_match_state"
      ],
      "properties": {
        "source_class_token": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_pack_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_revision_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "version_or_revision_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_build_at": {
          "$ref": "#/$defs/non_empty_string"
        },
        "running_build_identity_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "freshness_class": {
          "$ref": "#/$defs/freshness_class"
        },
        "version_match_state": {
          "$ref": "#/$defs/version_match_state"
        }
      }
    },
    "maintenance_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ref",
        "action_label",
        "keyboard_reachable"
      ],
      "properties": {
        "action_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "action_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keyboard_reachable": {
          "type": "boolean"
        }
      }
    }
  }
}
