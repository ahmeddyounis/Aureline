{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-environment-matrix-card.schema.json",
  "title": "Aureline M5 environment-matrix-card resolution case",
  "description": "Companion schema for the M5 environment-matrix-card third of the failure-triage-panel / quarantine-review-sheet / environment-matrix-card triple primitive. It describes one worked environment-matrix-card resolution case: an input card state (a target class, a primary environment lane, and at least two compared environment legs, each carrying its target/runtime/toolchain/build compatibility class) and its resolved truth. The resolved truth carries the derived card posture (incompatible/unverified/mixed/compatible — the worst axis across every leg), the overall compatibility, whether any leg is incompatible, and always withholds safe equivalence (asserts_safe_equivalence is always false). The canonical packet schema that embeds these cases is m5-test-failure-triage-panel.schema.json. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "resolved"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_class",
        "primary_environment_lane",
        "legs",
        "card_identity_ref"
      ],
      "properties": {
        "target_class": { "$ref": "#/$defs/target_class" },
        "primary_environment_lane": { "$ref": "#/$defs/environment_lane" },
        "legs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/leg" }
        },
        "card_identity_ref": { "type": "string", "minLength": 1 }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_class",
        "primary_environment_lane",
        "legs",
        "leg_count",
        "card_identity_ref",
        "card_posture",
        "overall_compatibility",
        "available_actions",
        "has_incompatible_leg",
        "has_unverified_axis",
        "asserts_safe_equivalence",
        "warns_on_incompatibility",
        "can_rerun_on_leg",
        "needs_attention"
      ],
      "properties": {
        "target_class": { "$ref": "#/$defs/target_class" },
        "primary_environment_lane": { "$ref": "#/$defs/environment_lane" },
        "legs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/leg" }
        },
        "leg_count": { "type": "integer", "minimum": 2 },
        "card_identity_ref": { "type": "string", "minLength": 1 },
        "card_posture": {
          "enum": [
            "incompatible_matrix",
            "unverified_matrix",
            "mixed_matrix",
            "compatible_matrix"
          ]
        },
        "overall_compatibility": { "$ref": "#/$defs/compatibility_class" },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reveal_compatibility_details",
              "inspect_leg_deltas",
              "rerun_on_leg",
              "export_environment_matrix"
            ]
          }
        },
        "has_incompatible_leg": { "type": "boolean" },
        "has_unverified_axis": { "type": "boolean" },
        "asserts_safe_equivalence": { "const": false },
        "warns_on_incompatibility": { "type": "boolean" },
        "can_rerun_on_leg": { "type": "boolean" },
        "needs_attention": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_lane",
        "target_compatibility",
        "runtime_compatibility",
        "toolchain_compatibility",
        "build_compatibility",
        "leg_label"
      ],
      "properties": {
        "environment_lane": { "$ref": "#/$defs/environment_lane" },
        "target_compatibility": { "$ref": "#/$defs/compatibility_class" },
        "runtime_compatibility": { "$ref": "#/$defs/compatibility_class" },
        "toolchain_compatibility": { "$ref": "#/$defs/compatibility_class" },
        "build_compatibility": { "$ref": "#/$defs/compatibility_class" },
        "leg_label": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility_class": {
      "enum": [
        "fully_compatible",
        "partially_compatible",
        "incompatible",
        "unverified",
        "not_applicable"
      ]
    },
    "target_class": {
      "enum": [
        "unit_test",
        "integration_test",
        "end_to_end_test",
        "ui_snapshot_test",
        "benchmark_test",
        "contract_test"
      ]
    },
    "environment_lane": {
      "enum": [
        "local_host",
        "container",
        "remote_runner",
        "ci_matrix",
        "browser_matrix",
        "emulated_device"
      ]
    }
  }
}
