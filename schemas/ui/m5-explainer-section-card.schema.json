{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-explainer-section-card.schema.json",
  "title": "Aureline M5 explainer section card",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "card_id", "section_ref", "topic_ref", "object_refs", "workset_snapshot_ref", "summary_generation_mode", "citation_refs", "citation_state", "freshness_state", "confidence", "provenance_class", "topology_refs", "ownership_refs", "source_refs", "consumer_surfaces", "copy_export", "reduced_capability_banner", "support_export_join", "auto_narrowing_contract"],
  "properties": {
    "record_kind": { "const": "m5_explainer_section_card" },
    "schema_version": { "const": 1 },
    "card_id": { "$ref": "#/$defs/ref" },
    "section_ref": { "$ref": "#/$defs/ref" },
    "topic_ref": { "$ref": "#/$defs/ref" },
    "object_refs": { "$ref": "#/$defs/ref_array" },
    "workset_snapshot_ref": { "$ref": "#/$defs/ref" },
    "summary_generation_mode": { "enum": ["curated", "generated", "generated_reviewed", "imported", "unknown"] },
    "citation_refs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["citation_ref", "citation_kind", "provenance_class"], "properties": { "citation_ref": { "$ref": "#/$defs/ref" }, "citation_kind": { "enum": ["file", "symbol", "doc", "topology_node", "ownership", "trace", "profile"] }, "provenance_class": { "$ref": "#/$defs/provenance_class" } } } },
    "citation_state": { "enum": ["complete", "partial", "missing", "policy_limited", "stale"] },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "provenance_class": { "$ref": "#/$defs/provenance_class" },
    "topology_refs": { "$ref": "#/$defs/ref_array" },
    "ownership_refs": { "$ref": "#/$defs/ref_array" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/ref_array" },
    "copy_export": { "$ref": "#/$defs/copy_export" },
    "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
    "support_export_join": { "$ref": "#/$defs/support_export_join" },
    "auto_narrowing_contract": { "$ref": "#/$defs/auto_narrowing_contract" }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
    "freshness_state": { "enum": ["live", "current", "warm_cached", "cached", "imported", "stale", "superseded", "partial", "expired", "policy_limited", "unknown"] },
    "confidence": { "enum": ["confirmed", "high", "medium", "low", "unknown"] },
    "provenance_class": { "enum": ["indexed", "imported", "inferred", "provider", "annotation", "runtime_capture", "curated", "generated"] },
    "copy_export": { "type": "object", "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "minItems": 3, "items": { "enum": ["text", "json", "markdown"] } }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "type": "string" }, "json": { "type": "string" }, "markdown": { "type": "string" }, "screenshot_only_prohibited": { "const": true } } },
    "reduced_capability_banner": { "type": "object", "required": ["banner_id", "severity", "capability_state", "visible_label", "missing_capabilities", "preserved_fields"], "properties": { "banner_id": { "$ref": "#/$defs/ref" }, "severity": { "enum": ["info", "warning", "blocking"] }, "capability_state": { "enum": ["full", "read_only", "inspect_only", "compare_only", "export_only", "policy_blocked", "unavailable"] }, "visible_label": { "type": "string" }, "missing_capabilities": { "$ref": "#/$defs/ref_array" }, "preserved_fields": { "$ref": "#/$defs/ref_array" } } },
    "support_export_join": { "type": "object", "required": ["join_id", "schema_ref", "joined_object_kinds", "raw_profile_samples_exported", "raw_trace_events_exported", "gui_cli_support_label_parity"], "properties": { "join_id": { "$ref": "#/$defs/ref" }, "schema_ref": { "$ref": "#/$defs/ref" }, "joined_object_kinds": { "$ref": "#/$defs/ref_array" }, "raw_profile_samples_exported": { "const": false }, "raw_trace_events_exported": { "const": false }, "gui_cli_support_label_parity": { "const": true } } },
    "auto_narrowing_contract": { "type": "object", "required": ["narrow_on_missing_or_stale", "stale_or_missing_effect", "policy_blocked_effect", "degraded_state_reason_field", "release_help_claim_ceiling"], "properties": { "narrow_on_missing_or_stale": { "$ref": "#/$defs/ref_array" }, "stale_or_missing_effect": { "const": "narrow_claim" }, "policy_blocked_effect": { "enum": ["block_export_or_narrow_claim", "narrow_claim"] }, "degraded_state_reason_field": { "const": "narrowed_claim_reasons" }, "release_help_claim_ceiling": { "const": "available_evidence_only" } } }
  }
}
