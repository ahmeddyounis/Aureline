{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-decision-right-card.schema.json",
  "title": "Aureline M5 decision-right card",
  "description": "Export-safe shape for a single M5 decision right card instance. The component carries the frozen governance readiness-state vocabulary shared across the M5 governance-dashboard component matrix plus its own family-specific vocabulary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape. Raw URLs, raw tokens, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "qualification",
    "identity",
    "readiness_state",
    "evidence_freshness",
    "keyboard_route",
    "decision_forum",
    "decision_right_state"
  ],
  "properties": {
    "component_family": {
      "const": "decision_right_card"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "identity": {
      "$ref": "#/$defs/non_empty_string"
    },
    "readiness_state": {
      "$ref": "#/$defs/readiness_state"
    },
    "evidence_freshness": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route": {
      "$ref": "#/$defs/non_empty_string"
    },
    "decision_forum": {
      "$ref": "#/$defs/decision_forum_class"
    },
    "decision_right_state": {
      "$ref": "#/$defs/decision_right_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "readiness_state": {
      "enum": [
        "passing",
        "warning",
        "blocked",
        "waived",
        "expired_waiver",
        "evidence_stale",
        "owner_unresolved",
        "forum_unresolved",
        "not_evaluated"
      ]
    },
    "decision_forum_class": {
      "enum": [
        "release_council",
        "service_owner",
        "security_review_board",
        "architecture_forum",
        "no_authorized_forum"
      ]
    },
    "decision_right_state": {
      "enum": [
        "authoritative_forum",
        "advisory_only",
        "forum_unresolved",
        "delegated_decision",
        "not_evaluated_here"
      ]
    }
  }
}
