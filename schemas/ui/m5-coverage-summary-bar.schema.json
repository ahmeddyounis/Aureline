{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-coverage-summary-bar.schema.json",
  "title": "Aureline M5 coverage-summary-bar / coverage-overlay-marker primitive",
  "description": "Export-safe packet implementing the reusable M5 coverage-summary bar and coverage-overlay marker as one twin primitive. The packet binds one row per claimed coverage consumer — the coverage-report panel, the editor gutter overlay, the CI coverage summary, the headless/CLI coverage surface, and the coverage report export — to the shared summary and overlay anatomy, the derived coverage posture (full-suite/changed-files/single-shard/merged-multi-shard/imported-report/partial-incomplete — one distinct posture per scope so no two scopes collapse into one percentage), the line-versus-branch-or-combined metric kinds, the provenance / freshness classes and imported/merged/live source notes, the included run set, the derived overlay posture (covered/uncovered/partial/branch-missed/excluded/unknown — the frozen controlled vocabulary), the overlay emphasis classes, bounded reveal/open-uncovered-lines/open-report/rerun and reveal/open-report/open-uncovered-context/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the two resolvers, and four hard invariants: it never collapses a multi-run or imported scope into one unlabeled percentage, never hides a shard omission or a stale provenance behind a green number, never drops the line-versus-branch metric dimension, and never invents an alternate label for a governed coverage state. Raw coverage payloads, pasted paths, credentials, and private endpoints never cross this boundary. This is the canonical packet schema; the overlay-marker companion schema at m5-coverage-overlay-marker.schema.json describes the overlay resolution case shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_coverage_summary_bars_and_coverage_overlay_markers_with_included_run_provenance_line_versus_branch_or_partial_truth_changed_file_emphasis_and_open_report_continuity_across_claimed_m5_test_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "test_evidence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "summary_anatomy_parts",
        "overlay_anatomy_parts",
        "coverage_scope_classes",
        "coverage_metric_kinds",
        "provenance_classes",
        "freshness_states",
        "source_notes",
        "coverage_postures",
        "overlay_states",
        "overlay_emphasis_classes",
        "overlay_postures",
        "summary_actions",
        "overlay_actions",
        "summary_export_fields",
        "overlay_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "summary_examples",
        "overlay_examples",
        "collapses_multi_run_into_single_percentage",
        "hides_shard_omission_or_stale_provenance",
        "drops_line_versus_branch_dimension",
        "invents_alternate_coverage_state_label"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "coverage_report_panel",
            "editor_gutter_overlay",
            "ci_coverage_summary",
            "headless_cli_coverage",
            "coverage_report_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "summary_anatomy_parts": { "type": "array", "minItems": 1 },
        "overlay_anatomy_parts": { "type": "array", "minItems": 1 },
        "coverage_scope_classes": { "type": "array", "minItems": 1 },
        "coverage_metric_kinds": { "type": "array", "minItems": 1 },
        "provenance_classes": { "type": "array", "minItems": 1 },
        "freshness_states": { "type": "array", "minItems": 1 },
        "source_notes": { "type": "array", "minItems": 1 },
        "coverage_postures": { "type": "array", "minItems": 1 },
        "overlay_states": { "type": "array", "minItems": 1 },
        "overlay_emphasis_classes": { "type": "array", "minItems": 1 },
        "overlay_postures": { "type": "array", "minItems": 1 },
        "summary_actions": { "type": "array", "minItems": 1 },
        "overlay_actions": { "type": "array", "minItems": 1 },
        "summary_export_fields": { "type": "array", "minItems": 1 },
        "overlay_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "summary_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/summary_example" }
        },
        "overlay_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/overlay_example" }
        },
        "collapses_multi_run_into_single_percentage": { "const": false },
        "hides_shard_omission_or_stale_provenance": { "const": false },
        "drops_line_versus_branch_dimension": { "const": false },
        "invents_alternate_coverage_state_label": { "const": false }
      }
    },
    "summary_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "scope_class",
            "metric_kind",
            "provenance_class",
            "freshness_state",
            "source_note",
            "included_run_count",
            "covered_units",
            "total_units",
            "summary_identity_ref",
            "coverage_posture",
            "available_actions",
            "is_multi_run",
            "is_imported",
            "is_stale",
            "requires_included_run_label",
            "discloses_shard_omission",
            "has_uncovered",
            "can_rerun",
            "needs_attention"
          ]
        }
      }
    },
    "overlay_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "overlay_state",
            "emphasis_class",
            "provenance_class",
            "is_changed_line",
            "source_run_set_ref",
            "evidence_object_ref",
            "line_reference",
            "overlay_posture",
            "is_emphasized_change",
            "preserves_state_meaning",
            "has_report_continuity",
            "available_actions",
            "needs_attention"
          ]
        }
      }
    }
  }
}
