{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-decision-right-milestone-controls.schema.json",
  "title": "Aureline M5 decision-right card and milestone dashboard row controls",
  "description": "Export-safe packet for the two reusable M5 governance-dashboard primitives implemented as one controls packet: the decision-right card (which council/forum can actually approve the next move, the reason for review, the satisfied/pending state, and the target milestone) and the milestone dashboard row (milestone name, owning team, blocker count, waiver count, gate state, nearest review forum, and next-review continuity). It narrows the decision_right_card and milestone_dashboard_row families frozen in schemas/ui/m5-governance-dashboard-component-matrix.schema.json into two resolvers plus a parity matrix, so a shiproom reviewer, operator, or release reviewer can tell — from the card and the row alone — who can approve the next move, why a review is open, whether it is satisfied or still pending, and how owned work rolls up into milestone readiness with its current blocker and waiver truth. Each controls row binds one claimed M5 governance consumer (the shiproom board, the operator board, the release center, the support export, and the CLI inspect) to the shared anatomy, the frozen readiness-state vocabulary, the decision-forum classes, the decision-right states, the milestone-gate states, the satisfaction states, the owner-coverage and evidence-freshness readings, degrade reasons, next actions, actions, export fields, and non-visual accessibility routes, plus worked resolution cases that must reproduce the resolver output exactly. Hard invariants forbid a surface reading ready while a forum or gate can still block it, letting an advisory forum read as authoritative, drifting milestone readiness away from ownership and blocker/waiver truth, and inventing a decision-right-local status word. Raw URLs, raw tokens, credentials, private endpoints, and user text bodies never cross this boundary; an owning-team or forum alias is a role alias, never a personal contact detail. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_decision_right_cards_and_milestone_dashboard_rows_across_claimed_m5_shiproom_and_operator_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "consumer_surface": {
      "enum": [
        "shiproom_board",
        "operator_board",
        "release_center",
        "support_export",
        "cli_inspect"
      ]
    },
    "readiness_state": {
      "enum": [
        "passing",
        "warning",
        "blocked",
        "waived",
        "expired_waiver",
        "evidence_stale",
        "owner_unresolved",
        "forum_unresolved",
        "not_evaluated"
      ]
    },
    "decision_forum_class": {
      "enum": [
        "release_council",
        "service_owner",
        "security_review_board",
        "architecture_forum",
        "no_authorized_forum"
      ]
    },
    "decision_right_state": {
      "enum": [
        "authoritative_forum",
        "advisory_only",
        "forum_unresolved",
        "delegated_decision",
        "not_evaluated_here"
      ]
    },
    "satisfaction_state": {
      "enum": ["review_satisfied", "review_pending", "review_waived", "review_not_required"]
    },
    "milestone_gate_state": {
      "enum": [
        "exit_gate_met",
        "exit_gate_pending",
        "exit_gate_blocked",
        "exit_gate_waived",
        "exit_gate_stale"
      ]
    },
    "owner_coverage_state": {
      "enum": [
        "owned_with_backup",
        "primary_only_no_backup",
        "owner_unresolved",
        "owner_stale",
        "policy_hidden"
      ]
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "anatomy_parts",
        "readiness_states",
        "decision_forum_classes",
        "decision_right_states",
        "satisfaction_states",
        "milestone_gate_states",
        "owner_coverage_states",
        "card_actions",
        "row_actions",
        "export_fields",
        "accessibility_routes",
        "decision_examples",
        "milestone_examples"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "readiness_states": { "type": "array", "minItems": 1 },
        "decision_forum_classes": { "type": "array", "minItems": 1 },
        "decision_right_states": { "type": "array", "minItems": 1 },
        "satisfaction_states": { "type": "array", "minItems": 1 },
        "milestone_gate_states": { "type": "array", "minItems": 1 },
        "owner_coverage_states": { "type": "array", "minItems": 1 },
        "card_actions": { "type": "array", "minItems": 1 },
        "row_actions": { "type": "array", "minItems": 2 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "decision_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision_case" }
        },
        "milestone_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/milestone_case" }
        },
        "lets_ready_hide_a_blocking_forum_or_gate": { "const": false },
        "lets_advisory_forum_read_authoritative": { "const": false },
        "drifts_milestone_readiness_from_ownership_and_counts": { "const": false },
        "invents_decision_local_status_grammar": { "const": false }
      }
    },
    "decision_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "card_id_repr",
            "required_forum",
            "decision_state",
            "satisfaction_state",
            "governance_review_required",
            "decision_authoritative",
            "forum_visible",
            "blocking_forum_or_gate_shown",
            "readiness_state",
            "is_clean_pass",
            "card_actions"
          ],
          "properties": {
            "required_forum": { "$ref": "#/$defs/decision_forum_class" },
            "decision_state": { "$ref": "#/$defs/decision_right_state" },
            "satisfaction_state": { "$ref": "#/$defs/satisfaction_state" },
            "governance_review_required": { "type": "boolean" },
            "decision_authoritative": { "type": "boolean" },
            "forum_visible": { "const": true },
            "blocking_forum_or_gate_shown": { "type": "boolean" },
            "readiness_state": { "$ref": "#/$defs/readiness_state" },
            "is_clean_pass": { "type": "boolean" },
            "card_actions": { "type": "array", "minItems": 1 }
          }
        }
      }
    },
    "milestone_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "milestone_id_repr",
            "owner_coverage",
            "blocker_count",
            "waiver_count",
            "gate_state",
            "nearest_review_forum",
            "owner_accountable",
            "ownership_visible",
            "blocker_waiver_truth_visible",
            "next_review_continuity",
            "readiness_state",
            "is_clean_pass",
            "row_actions"
          ],
          "properties": {
            "owner_coverage": { "$ref": "#/$defs/owner_coverage_state" },
            "blocker_count": { "type": "integer", "minimum": 0 },
            "waiver_count": { "type": "integer", "minimum": 0 },
            "gate_state": { "$ref": "#/$defs/milestone_gate_state" },
            "nearest_review_forum": { "$ref": "#/$defs/decision_forum_class" },
            "owner_accountable": { "type": "boolean" },
            "ownership_visible": { "const": true },
            "blocker_waiver_truth_visible": { "const": true },
            "next_review_continuity": { "const": true },
            "readiness_state": { "$ref": "#/$defs/readiness_state" },
            "is_clean_pass": { "type": "boolean" },
            "row_actions": { "type": "array", "minItems": 2 }
          }
        }
      }
    }
  }
}
