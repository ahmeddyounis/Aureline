{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-manifest-build-component-matrix.schema.json",
  "title": "Aureline M5 manifest / build component matrix",
  "description": "Canonical freeze matrix for the reusable M5 manifest / build-confidence component family: manifest editor headers, schema/validator rows, target-context chip groups, resource-link and resource-explorer rows, adapter source badges, target-graph rows, capability matrices, raw-event drawers, and fallback-confidence drawers. Every reusable primitive, its state vocabulary, and its export / assistive parity are defined once so later M5 rows reference one canonical family instead of restating infra/build confidence truth in feature-local prose. Authored, rendered, planned, live, cached, and provider-overlay truth never blur; target context stays visible; schema freshness and adapter source kind are explicit; lower-confidence discovery never overwrites higher-confidence truth silently; drift, connector loss, and policy blocks narrow before execution; exported evidence preserves the same target IDs, adapter kinds, and freshness / confidence states shown in-product.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "set_label",
    "components",
    "guardrails",
    "consumer_projection",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_manifest_build_component_matrix" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "set_label": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/component" }
    },
    "guardrails": { "$ref": "#/$defs/guardrails" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time", "minLength": 1 },
    "truth_mode": {
      "description": "Shared authored/rendered/planned/live/provider-overlay truth class. Serialized form of the crate-wide TruthMode enum.",
      "enum": ["desired", "rendered", "plan", "live", "provider_overlay"]
    },
    "confidence": {
      "enum": ["high", "medium", "low", "unknown"]
    },
    "adapter_source": {
      "enum": [
        "native_build_server",
        "native_build_event",
        "heuristic_parse",
        "imported_snapshot",
        "provider_overlay",
        "unknown"
      ]
    },
    "schema_freshness": {
      "enum": ["fresh", "stale", "unversioned", "unavailable"]
    },
    "family": {
      "enum": [
        "manifest_editor_header",
        "schema_validator_row",
        "target_context_chip_group",
        "resource_link_row",
        "resource_explorer_row",
        "adapter_source_badge",
        "target_graph_row",
        "capability_matrix",
        "raw_event_drawer",
        "fallback_confidence_drawer"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "target_context",
        "truth_class",
        "freshness_or_confidence",
        "adapter_source",
        "keyboard_route"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "schema_stale",
        "adapter_unavailable",
        "connector_loss",
        "policy_block",
        "drift_from_source",
        "low_confidence_discovery",
        "structured_channel_lost",
        "target_context_unresolved"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "family",
        "surface_label",
        "truth_mode",
        "target_context_ref",
        "adapter_source",
        "required_labels",
        "export_safe",
        "assistive_ready",
        "label_summary",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "component_id": { "$ref": "#/$defs/id" },
        "family": { "$ref": "#/$defs/family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "target_context_ref": { "$ref": "#/$defs/ref" },
        "adapter_source": { "$ref": "#/$defs/adapter_source" },
        "required_labels": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "export_safe": { "type": "boolean" },
        "assistive_ready": { "type": "boolean" },
        "label_summary": { "type": "string", "minLength": 1 },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "degraded": { "$ref": "#/$defs/degraded" },
        "manifest_editor_header": { "$ref": "#/$defs/manifest_editor_header" },
        "schema_validator_row": { "$ref": "#/$defs/schema_validator_row" },
        "target_context_chip_group": { "$ref": "#/$defs/target_context_chip_group" },
        "resource_link_row": { "$ref": "#/$defs/resource_link_row" },
        "resource_explorer_row": { "$ref": "#/$defs/resource_explorer_row" },
        "adapter_source_badge": { "$ref": "#/$defs/adapter_source_badge" },
        "target_graph_row": { "$ref": "#/$defs/target_graph_row" },
        "capability_matrix": { "$ref": "#/$defs/capability_matrix" },
        "raw_event_drawer": { "$ref": "#/$defs/raw_event_drawer" },
        "fallback_confidence_drawer": { "$ref": "#/$defs/fallback_confidence_drawer" }
      }
    },
    "degraded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "manifest_editor_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_mode",
        "schema_freshness",
        "edit_posture",
        "target_context_visible",
        "manifest_ref"
      ],
      "properties": {
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "schema_freshness": { "$ref": "#/$defs/schema_freshness" },
        "edit_posture": {
          "enum": ["read_only", "preview_apply_review", "blocked_protected"]
        },
        "target_context_visible": { "type": "boolean" },
        "manifest_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "schema_validator_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_state", "schema_freshness", "blocks_apply_on_error"],
      "properties": {
        "validation_state": {
          "enum": ["valid", "warnings", "errors", "schema_unavailable", "unversioned"]
        },
        "schema_freshness": { "$ref": "#/$defs/schema_freshness" },
        "blocks_apply_on_error": { "type": "boolean" }
      }
    },
    "target_context_chip_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_mode",
        "target_identity_ref",
        "context_complete",
        "stays_visible_on_scroll"
      ],
      "properties": {
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "target_identity_ref": { "$ref": "#/$defs/ref" },
        "context_complete": { "type": "boolean" },
        "stays_visible_on_scroll": { "type": "boolean" }
      }
    },
    "resource_link_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_class",
        "from_truth",
        "to_truth",
        "confidence",
        "never_overwrites_higher_confidence"
      ],
      "properties": {
        "link_class": {
          "enum": [
            "authored_to_rendered",
            "rendered_to_live",
            "plan_to_live",
            "schema_backed",
            "cross_target"
          ]
        },
        "from_truth": { "$ref": "#/$defs/truth_mode" },
        "to_truth": { "$ref": "#/$defs/truth_mode" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "never_overwrites_higher_confidence": { "type": "boolean" }
      }
    },
    "resource_explorer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_mode", "freshness", "confidence", "target_context_visible"],
      "properties": {
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "freshness": {
          "enum": ["live_fresh", "cached_stale", "imported_snapshot", "plan_only", "unknown"]
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "target_context_visible": { "type": "boolean" }
      }
    },
    "adapter_source_badge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_source", "confidence", "source_kind_explicit"],
      "properties": {
        "adapter_source": { "$ref": "#/$defs/adapter_source" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "source_kind_explicit": { "type": "boolean" }
      }
    },
    "target_graph_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kind", "truth_mode", "edge_confidence", "target_identity_ref"],
      "properties": {
        "node_kind": {
          "enum": [
            "build_target",
            "test_target",
            "run_target",
            "dependency_edge",
            "container_target"
          ]
        },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "edge_confidence": { "$ref": "#/$defs/confidence" },
        "target_identity_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "capability_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_state",
        "adapter_source",
        "discloses_source_and_confidence",
        "confidence"
      ],
      "properties": {
        "capability_state": {
          "enum": ["supported", "partial", "unsupported", "unknown", "provider_gated"]
        },
        "adapter_source": { "$ref": "#/$defs/adapter_source" },
        "discloses_source_and_confidence": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "raw_event_drawer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_channel", "redaction_applied", "preserves_event_identity"],
      "properties": {
        "event_channel": {
          "enum": [
            "native_build_event",
            "native_build_server",
            "task_event_bus",
            "heuristic_parse",
            "imported_log"
          ]
        },
        "redaction_applied": { "type": "boolean" },
        "preserves_event_identity": { "type": "boolean" }
      }
    },
    "fallback_confidence_drawer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_state",
        "recovery_route",
        "never_overwrites_structured_silently"
      ],
      "properties": {
        "confidence_state": {
          "enum": [
            "structured_high",
            "structured_degraded",
            "heuristic_fallback",
            "imported_only",
            "unknown"
          ]
        },
        "fallback_reason": {
          "enum": [
            "adapter_unavailable",
            "structured_channel_lost",
            "schema_drift",
            "connector_loss",
            "policy_block"
          ]
        },
        "recovery_route": {
          "enum": [
            "reattach_adapter",
            "rerun_discovery",
            "inspect_only",
            "open_source_truth",
            "retry_connector"
          ]
        },
        "never_overwrites_structured_silently": { "type": "boolean" }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_classes_never_blur",
        "target_context_visible_on_every_surface",
        "schema_freshness_and_adapter_source_explicit",
        "lower_confidence_never_overwrites_silently",
        "drift_connector_loss_policy_narrow_before_execution",
        "exported_evidence_preserves_ids_kinds_and_states",
        "components_bound_to_shared_vocabulary",
        "no_new_adapters_connectors_or_engines"
      ],
      "properties": {
        "truth_classes_never_blur": { "const": true },
        "target_context_visible_on_every_surface": { "const": true },
        "schema_freshness_and_adapter_source_explicit": { "const": true },
        "lower_confidence_never_overwrites_silently": { "const": true },
        "drift_connector_loss_policy_narrow_before_execution": { "const": true },
        "exported_evidence_preserves_ids_kinds_and_states": { "const": true },
        "components_bound_to_shared_vocabulary": { "const": true },
        "no_new_adapters_connectors_or_engines": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ingests_components",
        "docs_help_ingests_components",
        "diagnostics_ingests_components",
        "support_export_ingests_components",
        "release_control_ingests_components",
        "later_rows_reference_one_canonical_family"
      ],
      "properties": {
        "product_ingests_components": { "const": true },
        "docs_help_ingests_components": { "const": true },
        "diagnostics_ingests_components": { "const": true },
        "support_export_ingests_components": { "const": true },
        "release_control_ingests_components": { "const": true },
        "later_rows_reference_one_canonical_family": { "const": true }
      }
    }
  }
}
