{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-contract-source-badge.schema.json",
  "title": "Aureline M5 contract/source badge",
  "description": "Reusable badge contract linking request surfaces to OpenAPI, GraphQL, gRPC, imported, browser-captured, manual, or local collection sources with version/snapshot and freshness truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "badge_id",
    "request_identity_ref",
    "surface_contexts",
    "contract_kind",
    "display_label",
    "contract_ref",
    "operation_ref",
    "version_or_snapshot_ref",
    "freshness_state",
    "drift_state",
    "generated_from_contract",
    "actions",
    "raw_contract_payload_exposed",
    "source_refs",
    "consumer_surfaces",
    "copy_export",
    "reduced_capability_banner",
    "provider_handoff_notes"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_contract_source_badge"
    },
    "schema_version": {
      "const": 1
    },
    "badge_id": {
      "$ref": "#/$defs/id"
    },
    "request_identity_ref": {
      "$ref": "#/$defs/ref"
    },
    "surface_contexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "full_request_editor",
          "history_row",
          "handoff_surface",
          "compare_surface",
          "response_tabset",
          "cli_headless",
          "support_export"
        ]
      }
    },
    "contract_kind": {
      "type": "string",
      "enum": [
        "openapi",
        "graphql",
        "grpc",
        "asyncapi",
        "websocket",
        "browser_capture",
        "imported_snapshot",
        "manual",
        "local_collection"
      ]
    },
    "display_label": {
      "type": "string",
      "enum": [
        "OpenAPI",
        "GraphQL",
        "gRPC",
        "AsyncAPI",
        "WebSocket",
        "Browser capture",
        "Imported snapshot",
        "Manual",
        "Local collection"
      ]
    },
    "contract_ref": {
      "$ref": "#/$defs/ref"
    },
    "operation_ref": {
      "$ref": "#/$defs/ref"
    },
    "version_or_snapshot_ref": {
      "$ref": "#/$defs/ref"
    },
    "freshness_state": {
      "$ref": "#/$defs/freshness_state"
    },
    "drift_state": {
      "type": "string",
      "enum": [
        "current",
        "matching_snapshot",
        "stale",
        "superseded",
        "imported_snapshot",
        "persisted_operation_mismatch",
        "unknown"
      ]
    },
    "generated_from_contract": {
      "type": "boolean"
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_actions",
        "label_parity_across_surfaces"
      ],
      "properties": {
        "badge_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "open_contract",
              "view_operation",
              "refresh_contract",
              "diff_snapshot",
              "copy_badge_summary"
            ]
          }
        },
        "label_parity_across_surfaces": {
          "const": true
        }
      }
    },
    "raw_contract_payload_exposed": {
      "const": false
    },
    "source_refs": {
      "$ref": "#/$defs/ref_array"
    },
    "consumer_surfaces": {
      "$ref": "#/$defs/consumer_surfaces"
    },
    "copy_export": {
      "$ref": "#/$defs/copy_export"
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banner_id",
        "severity",
        "capability_state",
        "visible_label",
        "missing_capabilities",
        "preserved_fields",
        "action_policy"
      ],
      "properties": {
        "banner_id": {
          "$ref": "#/$defs/ref"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocked"
          ]
        },
        "capability_state": {
          "type": "string",
          "enum": [
            "read_only",
            "write_capable",
            "inspect_only",
            "mutation_review_required",
            "policy_blocked",
            "unavailable"
          ]
        },
        "visible_label": {
          "$ref": "#/$defs/ref"
        },
        "missing_capabilities": {
          "$ref": "#/$defs/ref_array"
        },
        "preserved_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "action_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_send_available",
            "replay_available",
            "mutate_available",
            "export_available"
          ],
          "properties": {
            "live_send_available": {
              "type": "boolean"
            },
            "replay_available": {
              "type": "boolean"
            },
            "mutate_available": {
              "type": "boolean"
            },
            "export_available": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provider_handoff_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note_id",
          "provider_surface",
          "handoff_state",
          "truth_preserved",
          "return_anchor_ref",
          "raw_material_exported"
        ],
        "properties": {
          "note_id": {
            "$ref": "#/$defs/ref"
          },
          "provider_surface": {
            "type": "string",
            "enum": [
              "desktop_request_workspace",
              "desktop_database_tool",
              "remote_workspace",
              "container_workspace",
              "managed_workspace",
              "browser_runtime_panel",
              "notebook_handoff",
              "chart_handoff",
              "ai_context_handoff",
              "cli_headless",
              "support_export",
              "release_proof"
            ]
          },
          "handoff_state": {
            "$ref": "#/$defs/ref"
          },
          "truth_preserved": {
            "$ref": "#/$defs/ref_array"
          },
          "return_anchor_ref": {
            "$ref": "#/$defs/ref"
          },
          "raw_material_exported": {
            "const": false
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "live",
        "current",
        "warm_cached",
        "cached",
        "imported",
        "stale",
        "superseded",
        "partial",
        "expired",
        "policy_limited",
        "unknown"
      ]
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "desktop_request_workspace",
          "desktop_database_tool",
          "remote_workspace",
          "container_workspace",
          "managed_workspace",
          "browser_runtime_panel",
          "notebook_handoff",
          "chart_handoff",
          "ai_context_handoff",
          "cli_headless",
          "support_export",
          "release_proof"
        ]
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "export_fields",
        "text",
        "json",
        "markdown",
        "screenshot_only_prohibited"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "json",
              "markdown"
            ]
          }
        },
        "export_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "text": {
          "$ref": "#/$defs/ref"
        },
        "json": {
          "$ref": "#/$defs/ref"
        },
        "markdown": {
          "$ref": "#/$defs/ref"
        },
        "screenshot_only_prohibited": {
          "const": true
        }
      }
    }
  }
}
