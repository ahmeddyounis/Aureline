{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-adapter-confidence-chip.schema.json",
  "title": "Aureline M5 adapter-confidence chip component",
  "description": "Canonical single-instance shape of the M5 adapter-confidence chip build / remote / managed-workspace boundary component. Every claimed M5 instance references this schema or the combined m5-build-remote-boundary-component-matrix.schema.json rather than reinventing its own confidence, host-ownership, or continuity wording. The Rust validator in crates/aureline-remote is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "boundary_dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "implies_exact_continuity_after_material_change",
    "hides_local_safe_or_companion_handoff_in_overflow_only",
    "lower_confidence_overwrites_resolved_target_without_review"
  ],
  "properties": {
    "component_family": {
      "const": "adapter_confidence_chip"
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "boundary_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/boundary_disposition"
      }
    },
    "adapter_confidences": {
      "type": "array"
    },
    "discovery_confidences": {
      "type": "array"
    },
    "host_kinds": {
      "type": "array"
    },
    "origin_loci": {
      "type": "array"
    },
    "lifecycle_states": {
      "type": "array"
    },
    "persistence_classes": {
      "type": "array"
    },
    "continuity_classes": {
      "type": "array"
    },
    "expiry_classes": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "implies_exact_continuity_after_material_change": {
      "const": false
    },
    "hides_local_safe_or_companion_handoff_in_overflow_only": {
      "const": false
    },
    "lower_confidence_overwrites_resolved_target_without_review": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "boundary_disposition": {
      "enum": [
        "local_execution",
        "ssh_execution",
        "container_execution",
        "devcontainer_execution",
        "managed_workspace",
        "browser_bridge",
        "service_plane",
        "suspended",
        "rebuilt",
        "recreated",
        "expired",
        "local_safe_continuation",
        "not_evaluated"
      ]
    }
  }
}
