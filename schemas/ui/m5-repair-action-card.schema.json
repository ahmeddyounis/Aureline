{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-repair-action-card.schema.json",
  "title": "M5 Repair Action Card and Repair Preview Row Primitive Packet",
  "description": "Export-safe support packet for the reusable M5 repair-action-card / repair-preview-row primitive: one row per claimed M5 recovery surface binding the shared repair-action-card anatomy, repair-preview-row anatomy, repair classes, blast radii, local-or-remote-or-managed target boundaries, reversibility classes, trust / policy requirements, changed-versus-unchanged change classes, derived action-label classes, actions, export fields, and non-visual accessibility routes, plus worked resolution cases that reconstruct the same repair explanation from one shared model. This packet schema overrides the per-fragment schema suggestions in the source set; the companion repair-preview-row component fragment is schemas/ui/m5-repair-preview-row.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_repair_action_card_and_repair_preview_row_impact_scope_target_boundary_and_reversal_class_primitive"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/definitions/consumer_row" }
    },
    "vocabulary_set": { "$ref": "#/definitions/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "repair_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "repair_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "repair_class": {
      "enum": [
        "reinstall_toolchain",
        "repair_environment_config",
        "rebuild_index",
        "clear_cache",
        "repair_permissions",
        "regenerate_lockfile",
        "reconnect_remote_target",
        "factory_reset_component"
      ]
    },
    "blast_radius": {
      "enum": [
        "no_writes_preview",
        "workspace_scoped",
        "toolchain_scoped",
        "host_environment_scoped",
        "multi_target_scoped"
      ]
    },
    "host_boundary": {
      "enum": [
        "local_host",
        "remote_ssh_host",
        "container_host",
        "managed_workspace_host",
        "virtual_machine_host",
        "wasm_sandbox_host"
      ]
    },
    "target_boundary": {
      "enum": ["local_target", "remote_target", "managed_target"]
    },
    "reversibility": {
      "enum": [
        "fully_reversible_checkpoint",
        "reversible_with_backup",
        "partially_reversible",
        "irreversible_confirmed",
        "reversal_requires_manual_steps"
      ]
    },
    "trust_requirement": {
      "enum": [
        "no_elevation",
        "local_confirmation",
        "admin_elevation",
        "policy_approval_required",
        "managed_by_administrator"
      ]
    },
    "change_class": {
      "enum": [
        "toolchain_binaries",
        "workspace_config",
        "cache_artifacts",
        "index_data",
        "file_permissions",
        "lockfile_state",
        "remote_session_state",
        "user_source_files"
      ]
    },
    "action_label_class": {
      "enum": [
        "apply_local_reversible",
        "preview_only",
        "request_policy_approval",
        "review_off_device_repair",
        "apply_non_exact_repair",
        "open_factory_reset_out_of_band"
      ]
    },
    "card_part": {
      "enum": [
        "repair_class_label",
        "target_scope_label",
        "blast_radius_badge",
        "target_boundary_badge",
        "trust_requirement_badge",
        "reversal_class_badge",
        "action_label"
      ]
    },
    "preview_row_part": {
      "enum": [
        "preview_only_flag",
        "approval_required_flag",
        "rerunnable_flag",
        "factory_reset_out_of_band_flag",
        "changed_class_list",
        "unchanged_class_list"
      ]
    },
    "repair_action": {
      "enum": [
        "preview_repair",
        "request_approval",
        "apply_repair",
        "rollback_repair",
        "open_factory_reset",
        "cancel_repair"
      ]
    },
    "export_field": {
      "enum": [
        "repair_identity",
        "repair_class",
        "target_scope",
        "blast_radius",
        "target_boundary",
        "reversal_class",
        "trust_requirement",
        "changed_classes",
        "unchanged_classes",
        "preview_flags",
        "available_actions"
      ]
    },
    "consumer_surface": {
      "enum": [
        "project_doctor_panel",
        "doctor_repair_card",
        "guided_repair_wizard",
        "support_bundle_repair_row",
        "environment_repair_prompt",
        "toolchain_repair_card",
        "remote_host_repair_card",
        "repair_preview_sheet",
        "activity_center_repair"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "repair_classes",
        "card_parts",
        "preview_row_parts",
        "target_boundaries",
        "change_classes",
        "trust_requirements",
        "action_label_classes",
        "repair_actions",
        "export_fields",
        "blast_radii",
        "reversibility_classes",
        "host_boundaries",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "repair_classes": { "type": "array", "items": { "type": "string" } },
        "card_parts": { "type": "array", "items": { "type": "string" } },
        "preview_row_parts": { "type": "array", "items": { "type": "string" } },
        "target_boundaries": { "type": "array", "items": { "type": "string" } },
        "change_classes": { "type": "array", "items": { "type": "string" } },
        "trust_requirements": { "type": "array", "items": { "type": "string" } },
        "action_label_classes": { "type": "array", "items": { "type": "string" } },
        "repair_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "blast_radii": { "type": "array", "items": { "type": "string" } },
        "reversibility_classes": { "type": "array", "items": { "type": "string" } },
        "host_boundaries": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repair_title",
            "repair_class",
            "target_scope_repr",
            "blast_radius",
            "host_boundary",
            "reversibility",
            "trust_requirement",
            "changed_classes",
            "unchanged_classes",
            "preview_only",
            "approval_required",
            "rerunnable",
            "factory_reset_out_of_band"
          ],
          "properties": {
            "repair_title": { "type": "string", "minLength": 1 },
            "repair_class": { "$ref": "#/definitions/repair_class" },
            "target_scope_repr": { "type": "string", "minLength": 1 },
            "blast_radius": { "$ref": "#/definitions/blast_radius" },
            "host_boundary": { "$ref": "#/definitions/host_boundary" },
            "reversibility": { "$ref": "#/definitions/reversibility" },
            "trust_requirement": { "$ref": "#/definitions/trust_requirement" },
            "changed_classes": {
              "type": "array",
              "items": { "$ref": "#/definitions/change_class" }
            },
            "unchanged_classes": {
              "type": "array",
              "items": { "$ref": "#/definitions/change_class" }
            },
            "preview_only": { "type": "boolean" },
            "approval_required": { "type": "boolean" },
            "rerunnable": { "type": "boolean" },
            "factory_reset_out_of_band": { "type": "boolean" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repair_title",
            "repair_class",
            "target_scope_repr",
            "blast_radius",
            "host_boundary",
            "target_boundary",
            "reversibility",
            "reversal_is_exact",
            "trust_requirement",
            "requires_approval",
            "changed_classes",
            "unchanged_classes",
            "preview_only",
            "approval_required",
            "rerunnable",
            "factory_reset_out_of_band",
            "action_label_class",
            "available_actions",
            "blast_radius_reviewable",
            "changed_and_unchanged_disclosed"
          ],
          "properties": {
            "repair_title": { "type": "string", "minLength": 1 },
            "repair_class": { "$ref": "#/definitions/repair_class" },
            "target_scope_repr": { "type": "string", "minLength": 1 },
            "blast_radius": { "$ref": "#/definitions/blast_radius" },
            "host_boundary": { "$ref": "#/definitions/host_boundary" },
            "target_boundary": { "$ref": "#/definitions/target_boundary" },
            "reversibility": { "$ref": "#/definitions/reversibility" },
            "reversal_is_exact": { "type": "boolean" },
            "trust_requirement": { "$ref": "#/definitions/trust_requirement" },
            "requires_approval": { "type": "boolean" },
            "changed_classes": {
              "type": "array",
              "items": { "$ref": "#/definitions/change_class" }
            },
            "unchanged_classes": {
              "type": "array",
              "items": { "$ref": "#/definitions/change_class" }
            },
            "preview_only": { "type": "boolean" },
            "approval_required": { "type": "boolean" },
            "rerunnable": { "type": "boolean" },
            "factory_reset_out_of_band": { "type": "boolean" },
            "action_label_class": { "$ref": "#/definitions/action_label_class" },
            "available_actions": {
              "type": "array",
              "items": { "$ref": "#/definitions/repair_action" }
            },
            "blast_radius_reviewable": { "type": "boolean" },
            "changed_and_unchanged_disclosed": { "type": "boolean" }
          }
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "card_parts",
        "preview_row_parts",
        "repair_classes",
        "blast_radii",
        "target_boundaries",
        "reversibility_classes",
        "trust_requirements",
        "change_classes",
        "action_label_classes",
        "repair_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "understates_blast_radius",
        "overstates_reversibility",
        "masks_target_boundary",
        "hides_changed_or_unchanged_classes"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/definitions/consumer_surface" },
        "qualification": { "$ref": "#/definitions/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "shell_zone_slot": { "type": "string", "minLength": 1 },
        "responsive_classes": { "type": "array", "items": { "type": "string" } },
        "window_classes": { "type": "array", "items": { "type": "string" } },
        "card_parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/card_part" }
        },
        "preview_row_parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/preview_row_part" }
        },
        "repair_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/repair_class" }
        },
        "blast_radii": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/blast_radius" }
        },
        "target_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/target_boundary" }
        },
        "reversibility_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/reversibility" }
        },
        "trust_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/trust_requirement" }
        },
        "change_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/change_class" }
        },
        "action_label_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/action_label_class" }
        },
        "repair_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/repair_action" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/resolution_case" }
        },
        "understates_blast_radius": { "const": false },
        "overstates_reversibility": { "const": false },
        "masks_target_boundary": { "const": false },
        "hides_changed_or_unchanged_classes": { "const": false }
      }
    }
  }
}
