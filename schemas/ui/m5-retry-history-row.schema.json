{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-retry-history-row.schema.json",
  "title": "Aureline M5 retry-history-row resolution case",
  "description": "Companion schema for the M5 retry-history-row half of the flaky-state-badge / retry-history-row twin primitive. It describes one worked retry-history-row resolution case: an input attempt history and its resolved truth. The resolved truth carries the frozen controlled retry vocabulary (passed-first-try/passed-on-retry/failed-all-retries/errored/skipped/aborted) as its derived retry posture, the recent attempt outcomes in order, whether the outcomes diverged, whether the row discloses its environment / build / runtime deltas, the attempt origin (local/remote/notebook/imported-CI), whether the rerun widened the selection, a durable path back to the raw attempt logs (the open-logs continuity), and the bounded reveal/rerun/open-logs/export actions. The canonical packet schema that embeds these cases is m5-flaky-state-badge.schema.json. Raw test payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "resolved"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_outcome",
        "recent_outcomes",
        "scope_class",
        "attempt_origin",
        "confidence_class",
        "provenance_class",
        "has_env_delta",
        "has_build_delta",
        "has_runtime_delta",
        "test_identity_ref",
        "attempt_log_ref"
      ],
      "properties": {
        "last_outcome": { "$ref": "#/$defs/retry_outcome" },
        "recent_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/retry_outcome" }
        },
        "scope_class": { "$ref": "#/$defs/scope_class" },
        "attempt_origin": { "$ref": "#/$defs/attempt_origin" },
        "confidence_class": { "$ref": "#/$defs/confidence_class" },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "has_env_delta": { "type": "boolean" },
        "has_build_delta": { "type": "boolean" },
        "has_runtime_delta": { "type": "boolean" },
        "test_identity_ref": { "type": "string", "minLength": 1 },
        "attempt_log_ref": { "type": "string", "minLength": 1 }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_outcome",
        "recent_outcomes",
        "scope_class",
        "attempt_origin",
        "confidence_class",
        "provenance_class",
        "has_env_delta",
        "has_build_delta",
        "has_runtime_delta",
        "test_identity_ref",
        "attempt_log_ref",
        "row_posture",
        "available_actions",
        "is_divergent",
        "preserves_outcome_order",
        "discloses_env_build_runtime_delta",
        "explains_divergent_outcomes",
        "is_imported",
        "widened_scope",
        "has_log_continuity",
        "needs_attention"
      ],
      "properties": {
        "last_outcome": { "$ref": "#/$defs/retry_outcome" },
        "recent_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/retry_outcome" }
        },
        "scope_class": { "$ref": "#/$defs/scope_class" },
        "attempt_origin": { "$ref": "#/$defs/attempt_origin" },
        "confidence_class": { "$ref": "#/$defs/confidence_class" },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "has_env_delta": { "type": "boolean" },
        "has_build_delta": { "type": "boolean" },
        "has_runtime_delta": { "type": "boolean" },
        "test_identity_ref": { "type": "string", "minLength": 1 },
        "attempt_log_ref": { "type": "string", "minLength": 1 },
        "row_posture": {
          "enum": [
            "passed_first_try_row",
            "passed_on_retry_row",
            "failed_all_retries_row",
            "errored_row",
            "skipped_row",
            "aborted_row"
          ]
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reveal_retry_details",
              "rerun_test",
              "open_logs",
              "export_retry_history"
            ]
          }
        },
        "is_divergent": { "type": "boolean" },
        "preserves_outcome_order": { "const": true },
        "discloses_env_build_runtime_delta": { "type": "boolean" },
        "explains_divergent_outcomes": { "const": true },
        "is_imported": { "type": "boolean" },
        "widened_scope": { "type": "boolean" },
        "has_log_continuity": { "const": true },
        "needs_attention": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "retry_outcome": {
      "enum": [
        "passed_first_try",
        "passed_on_retry",
        "failed_all_retries",
        "errored_attempt",
        "skipped_attempt",
        "aborted_attempt"
      ]
    },
    "scope_class": {
      "enum": [
        "same_selection",
        "failed_only_rerun",
        "widened_selection",
        "single_test_rerun",
        "imported_attempt",
        "unknown_scope"
      ]
    },
    "attempt_origin": {
      "enum": [
        "local_attempt",
        "remote_attempt",
        "notebook_attempt",
        "imported_ci_attempt",
        "unknown_origin"
      ]
    },
    "confidence_class": {
      "enum": [
        "high_confidence",
        "moderate_confidence",
        "low_confidence",
        "single_occurrence",
        "insufficient_data",
        "policy_overridden"
      ]
    },
    "provenance_class": {
      "enum": [
        "verified_current_run",
        "imported_ci_artifact",
        "cached_local_result",
        "stale_prior_result",
        "suspected_flaky",
        "reproduced_flaky",
        "stable_again",
        "manually_muted",
        "unknown"
      ]
    }
  }
}
