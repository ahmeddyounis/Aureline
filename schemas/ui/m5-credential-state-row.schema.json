{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-credential-state-row.schema.json",
  "title": "Aureline M5 credential-state row component",
  "description": "Names where a secret is stored, which credential class it holds, whether a handle-only path exists or a raw reveal is possible, and its expiry / rotation / revoke lifecycle state \u2014 so a user never has to infer where a secret lives or whether it can be shown right now. Canonical per-component contract frozen by the M5 credential component matrix (schemas/ui/m5-credential-component-matrix.schema.json); downstream M5 rows point at this schema instead of restating credential UI truth by hand. Raw secret values, tokens, passphrases, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "storage_mode",
    "credential_class",
    "reveal_posture",
    "lifecycle_state",
    "degraded_state",
    "required_labels"
  ],
  "properties": {
    "component_family": {
      "const": "credential_state_row"
    },
    "storage_mode": {
      "enum": [
        "os_keychain",
        "encrypted_vault",
        "secret_broker_handle",
        "session_memory_only",
        "external_reference",
        "no_secret_stored"
      ]
    },
    "credential_class": {
      "enum": [
        "oauth_token",
        "api_key",
        "personal_access_token",
        "ssh_or_signing_key",
        "client_certificate",
        "device_code_grant"
      ]
    },
    "reveal_posture": {
      "enum": [
        "handle_only",
        "masked_last_four",
        "reveal_on_demand",
        "clipboard_scoped",
        "never_revealed",
        "policy_blocked_reveal"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "active_current",
        "refresh_needed",
        "rotation_due",
        "revoked",
        "expired",
        "superseded"
      ]
    },
    "degraded_state": {
      "enum": [
        "fully_available",
        "limited_capability",
        "stale_needs_reauth",
        "offline_cached",
        "policy_blocked",
        "unavailable"
      ]
    },
    "required_labels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "state",
          "keyboard_route",
          "storage_and_reveal_posture",
          "identity_and_delegation",
          "expiry_and_export_boundary"
        ]
      }
    }
  }
}
