{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-component-accessibility-fallback.schema.json",
  "title": "M5 Component Accessibility Fallback Packet",
  "description": "Canvas/list/table/textual fallback parity, keyboard and screen-reader navigation, and export-safe summaries for the frozen M5 profiler/topology component families (M05-801).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_component_accessibility_fallback_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "profile_session_card",
        "flamegraph_view",
        "icicle_view",
        "call_tree_row",
        "heap_profile_compare_card",
        "trace_timeline",
        "workset_switcher_row",
        "topology_node_card",
        "ownership_card",
        "explainer_section_card"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["canvas", "list", "table", "textual"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "handoff_packet",
        "cli_headless",
        "support_export"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "desktop_profiler_workspace",
        "hotspot_workspace",
        "trace_viewer",
        "heap_analysis",
        "profile_compare",
        "topology_map",
        "ownership_browser",
        "architecture_explainer",
        "search_results",
        "review_workspace",
        "onboarding_tour",
        "ai_context_panel",
        "incident_workspace",
        "docs_help",
        "cli_headless",
        "support_export",
        "release_proof"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "zoom_density_state": {
      "type": "string",
      "enum": [
        "legible_under_zoom_and_density",
        "disclosed_reduced_legibility",
        "truncated_or_lost_on_zoom_or_density"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "json": { "type": "string" },
        "markdown": { "type": "string" },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "severity", "capability_state", "visible_label"],
      "properties": {
        "banner_id": { "type": "string" },
        "severity": { "type": "string" },
        "capability_state": { "type": "string" },
        "visible_label": { "type": "string" },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } },
        "preserved_fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "support_export_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_id",
        "schema_ref",
        "raw_profile_samples_exported",
        "raw_trace_events_exported",
        "gui_cli_support_label_parity"
      ],
      "properties": {
        "join_id": { "type": "string" },
        "schema_ref": { "type": "string" },
        "joined_object_kinds": { "type": "array", "items": { "type": "string" } },
        "raw_profile_samples_exported": { "type": "boolean" },
        "raw_trace_events_exported": { "type": "boolean" },
        "gui_cli_support_label_parity": { "type": "boolean" }
      }
    },
    "auto_narrowing_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stale_or_missing_effect",
        "policy_blocked_effect",
        "degraded_state_reason_field",
        "release_help_claim_ceiling"
      ],
      "properties": {
        "narrow_on_missing_or_stale": { "type": "array", "items": { "type": "string" } },
        "stale_or_missing_effect": { "type": "string" },
        "policy_blocked_effect": { "type": "string" },
        "degraded_state_reason_field": { "type": "string" },
        "release_help_claim_ceiling": { "type": "string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "fallback_modalities",
        "filter_sort_range_parity",
        "keyboard_reach",
        "screen_reader_reach",
        "zoom_density",
        "export_summary",
        "export_summary_ref",
        "rendering_surfaces",
        "narrowing_disclosures",
        "consumer_surfaces",
        "copy_export",
        "reduced_capability_banner",
        "support_export_join",
        "auto_narrowing_contract"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "m5_component_accessibility_fallback_row" },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "filter_sort_range_parity": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "zoom_density": { "$ref": "#/$defs/zoom_density_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "rendering_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_disclosure" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "support_export_join": { "$ref": "#/$defs/support_export_join" },
        "auto_narrowing_contract": { "$ref": "#/$defs/auto_narrowing_contract" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_count",
        "canvas_heavy_family_count",
        "all_canvas_heavy_have_non_visual_fallback",
        "all_keyboard_and_screen_reader_reachable",
        "all_export_summaries_preserve_meaning",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "family_count": { "type": "integer" },
        "canvas_heavy_family_count": { "type": "integer" },
        "all_canvas_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_keyboard_and_screen_reader_reachable": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer" },
        "yellow_count": { "type": "integer" },
        "red_count": { "type": "integer" },
        "rendering_surface_count": { "type": "integer" },
        "consumer_surface_count": { "type": "integer" }
      }
    }
  }
}
