{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-protected-path-governance-component-accessibility-parity.schema.json",
  "title": "M5 Protected-Path Governance Component Accessibility, Headless, and Export Parity Packet",
  "description": "Export-safe packet proving that the eight shared M5 protected-path governance components (protected-path row, ownership card, approver matrix, review-pack summary, public-surface diff card, merge-control banner, DRI-registry row, merge-readiness strip) expose keyboard, screen-reader, CLI, and export forms at parity with the desktop, and that each component's governed-authority claim automatically narrows to the ceiling permitted by its condition when provider enforcement is advisory, stale, or a local estimate, when owner backup coverage is missing, when approver state is waived or expired, when the review pack is stale, or when the public-surface diff truth is partial.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "accessibility_rows",
    "downgrade_triggers",
    "rendering_surfaces",
    "trust_review",
    "projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "protected_path_governance_component_accessibility_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "accessibility_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "rendering_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rendering_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "projection": { "$ref": "#/$defs/projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "protected_path_row",
        "ownership_card",
        "approver_matrix",
        "review_pack_summary",
        "public_surface_diff_card",
        "merge_control_banner",
        "dri_registry_row",
        "merge_readiness_strip"
      ]
    },
    "claim_condition": {
      "type": "string",
      "enum": [
        "governance_truth_trusted",
        "provider_enforcement_stale_or_partial",
        "owner_coverage_partial",
        "approver_state_stale_or_partial",
        "review_pack_freshness_stale",
        "public_surface_diff_truth_partial"
      ]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "full_governed_authority",
        "advisory_enforcement_only",
        "owner_backup_coverage_missing",
        "approver_state_narrowed",
        "review_pack_stale_disclosed",
        "public_surface_evidence_withheld"
      ]
    },
    "rendering_surface": {
      "type": "string",
      "enum": ["desktop_full", "cli_headless", "support_export"]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "seek_provider_enforcement_clearance",
        "resolve_owner_backup_coverage",
        "refresh_approver_state",
        "refresh_review_pack",
        "generate_public_surface_diff",
        "continue_governed_review"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "provider_enforcement_stale_or_partial",
        "owner_coverage_partial",
        "approver_state_stale_or_partial",
        "review_pack_freshness_stale",
        "public_surface_diff_truth_partial",
        "claim_overstated",
        "parity_dropped",
        "trust_narrowing"
      ]
    },
    "claim_narrowing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "narrowed_to", "preserved_truth_note", "next_action", "next_action_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_to": { "$ref": "#/$defs/claim_tier" },
        "preserved_truth_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "condition",
        "effective_claim",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "rendering_surfaces",
        "narrowing",
        "governed_semantics_note",
        "enforcement_authority_note",
        "backup_coverage_note",
        "approver_state_note",
        "public_surface_evidence_note",
        "is_pointer_only",
        "is_export_opaque",
        "desktop_stronger_than_cli",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "condition": { "$ref": "#/$defs/claim_condition" },
        "effective_claim": { "$ref": "#/$defs/claim_tier" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "rendering_surfaces": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing": {
          "oneOf": [{ "$ref": "#/$defs/claim_narrowing" }, { "type": "null" }]
        },
        "governed_semantics_note": { "type": "string" },
        "enforcement_authority_note": { "type": "string" },
        "backup_coverage_note": { "type": "string" },
        "approver_state_note": { "type": "string" },
        "public_surface_evidence_note": { "type": "string" },
        "is_pointer_only": { "const": false },
        "is_export_opaque": { "const": false },
        "desktop_stronger_than_cli": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Trusted governance truth keeps the full claim and never narrows.",
          "if": { "properties": { "condition": { "const": "governance_truth_trusted" } } },
          "then": { "properties": { "narrowing": { "type": "null" } } }
        },
        {
          "comment": "Any weakening condition must carry an explicit narrow disclosure and keep the owner/approver/public-surface semantics explicit.",
          "if": {
            "properties": {
              "condition": {
                "enum": [
                  "provider_enforcement_stale_or_partial",
                  "owner_coverage_partial",
                  "approver_state_stale_or_partial",
                  "review_pack_freshness_stale",
                  "public_surface_diff_truth_partial"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "narrowing": { "$ref": "#/$defs/claim_narrowing" },
              "governed_semantics_note": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "comment": "Stale or advisory provider enforcement must carry an explicit advisory-not-authoritative note.",
          "if": {
            "properties": { "condition": { "const": "provider_enforcement_stale_or_partial" } }
          },
          "then": {
            "properties": { "enforcement_authority_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "Partial owner coverage must carry an explicit missing-backup-coverage note.",
          "if": {
            "properties": { "condition": { "const": "owner_coverage_partial" } }
          },
          "then": {
            "properties": { "backup_coverage_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "A waived or expired approval must carry an explicit approver-state note.",
          "if": {
            "properties": { "condition": { "const": "approver_state_stale_or_partial" } }
          },
          "then": {
            "properties": { "approver_state_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "A partial public-surface diff must carry an explicit missing-diff/migration note.",
          "if": {
            "properties": { "condition": { "const": "public_surface_diff_truth_partial" } }
          },
          "then": {
            "properties": { "public_surface_evidence_note": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard_reachable_on_every_claim",
        "screen_reader_labeled_on_every_claim",
        "cli_enum_exposed_on_every_claim",
        "export_enum_exposed_on_every_claim",
        "explanation_field_present_on_every_claim",
        "no_component_pointer_only",
        "no_component_export_opaque",
        "desktop_never_stronger_than_cli",
        "claim_narrows_when_governance_evidence_weakens",
        "governed_authority_never_overstated_under_weakening",
        "owner_approver_public_surface_semantics_kept_explicit",
        "advisory_never_promoted_to_provider_authoritative"
      ],
      "properties": {
        "keyboard_reachable_on_every_claim": { "const": true },
        "screen_reader_labeled_on_every_claim": { "const": true },
        "cli_enum_exposed_on_every_claim": { "const": true },
        "export_enum_exposed_on_every_claim": { "const": true },
        "explanation_field_present_on_every_claim": { "const": true },
        "no_component_pointer_only": { "const": true },
        "no_component_export_opaque": { "const": true },
        "desktop_never_stronger_than_cli": { "const": true },
        "claim_narrows_when_governance_evidence_weakens": { "const": true },
        "governed_authority_never_overstated_under_weakening": { "const": true },
        "owner_approver_public_surface_semantics_kept_explicit": { "const": true },
        "advisory_never_promoted_to_provider_authoritative": { "const": true }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposes_keyboard_and_screen_reader_labels",
        "exposes_cli_and_export_enums",
        "exposes_explanation_fields",
        "auto_narrows_on_stale_provider_enforcement",
        "auto_narrows_on_partial_owner_coverage",
        "auto_narrows_on_stale_approver_state",
        "auto_narrows_on_stale_review_pack",
        "auto_narrows_on_partial_public_surface_diff",
        "desktop_cli_export_semantics_identical",
        "narrowing_prevents_overstated_governed_authority"
      ],
      "properties": {
        "exposes_keyboard_and_screen_reader_labels": { "const": true },
        "exposes_cli_and_export_enums": { "const": true },
        "exposes_explanation_fields": { "const": true },
        "auto_narrows_on_stale_provider_enforcement": { "const": true },
        "auto_narrows_on_partial_owner_coverage": { "const": true },
        "auto_narrows_on_stale_approver_state": { "const": true },
        "auto_narrows_on_stale_review_pack": { "const": true },
        "auto_narrows_on_partial_public_surface_diff": { "const": true },
        "desktop_cli_export_semantics_identical": { "const": true },
        "narrowing_prevents_overstated_governed_authority": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
