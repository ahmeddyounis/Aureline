{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-relation-strip.schema.json",
  "title": "Aureline M5 relation strip",
  "description": "Canonical reusable relation strip. Names the linked engineering context of a work item — branch, pull request, review, test run, incident, or an unmapped relation — so the branch/review/test context is always explicit and never given an alternate label. Governed by the M5 work-item component matrix in crates/aureline-provider.",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_item_object_id", "relations"],
  "properties": {
    "work_item_object_id": { "$ref": "#/$defs/non_empty_string" },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_kind", "label"],
      "properties": {
        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "target_reference": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "relation_kind": {
      "enum": [
        "linked_branch",
        "linked_pull_request",
        "linked_review",
        "linked_test_run",
        "linked_incident",
        "unmapped_relation"
      ]
    }
  }
}
