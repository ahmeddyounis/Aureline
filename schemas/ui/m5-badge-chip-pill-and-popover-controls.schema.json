{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-badge-chip-pill-and-popover-controls.schema.json",
  "title": "Aureline M5 badge / chip / pill and popover controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 decision-feedback component matrix. It carries resolved, honest projections of the badge / chip / pill and the popover across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved badge examples (naming the concise label, the badge expression with no-color-only semantics, the state disposition, the preserved lifecycle/support/provider/policy/source/freshness meaning taxonomy, the overflow behavior, and the expansion route back to a plain-language explanation reachable by keyboard/screen-reader/export) and the resolved popover examples (naming the accessible name, dismissal behavior, state disposition, surface context, dismissibility, keyboard operability, and anchored focus return). Hard invariants forbid badge meaning relying on color alone, badge meaning hidden behind hover only, popovers carrying the only critical workflow instruction, and popovers failing to return focus to their trigger. Acceptance criteria — claimed consumers show consistent badge taxonomy and popover focus behavior without hover-only truth gaps, plain-language explanation for badge meaning is reachable from keyboard/screen-reader/exported views, and badge/popover drift is caught before release evidence turns green — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_badge_chip_pill_and_popover_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "badge_example": {
      "type": "object",
      "required": [
        "badge_id",
        "badge_label",
        "expression",
        "expression_is_color_only",
        "disposition",
        "disposition_demands_explanation",
        "meaning_taxonomy",
        "meaning_is_classified",
        "overflow_behavior",
        "is_overflowing",
        "expansion_route",
        "surface_context",
        "meaning_stated_non_color_only",
        "plain_language_explanation_present",
        "explanation_reachable_by_keyboard_sr_export",
        "taxonomy_stable_across_surfaces",
        "degrade_reason",
        "next_action",
        "meaning_legible_without_hover"
      ],
      "properties": {
        "badge_id": { "$ref": "#/$defs/non_empty_string" },
        "badge_label": { "type": "string" },
        "expression": { "$ref": "#/$defs/non_empty_string" },
        "expression_is_color_only": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "disposition_demands_explanation": { "type": "boolean" },
        "meaning_taxonomy": { "$ref": "#/$defs/non_empty_string" },
        "meaning_is_classified": { "type": "boolean" },
        "overflow_behavior": { "$ref": "#/$defs/non_empty_string" },
        "is_overflowing": { "type": "boolean" },
        "expansion_route": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "meaning_stated_non_color_only": { "type": "boolean" },
        "plain_language_explanation_present": { "type": "boolean" },
        "explanation_reachable_by_keyboard_sr_export": { "type": "boolean" },
        "taxonomy_stable_across_surfaces": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "meaning_legible_without_hover": { "type": "boolean" }
      }
    },
    "popover_example": {
      "type": "object",
      "required": [
        "popover_id",
        "accessible_name",
        "dismissal",
        "dismissal_is_disallowed",
        "disposition",
        "surface_context",
        "is_dismissible",
        "keyboard_operable",
        "focus_returns_to_trigger",
        "carries_only_critical_instruction",
        "critical_steps_available_elsewhere",
        "is_non_modal_secondary",
        "content_reachable_without_hover",
        "degrade_reason",
        "next_action",
        "stays_lightweight_secondary_with_safe_focus"
      ],
      "properties": {
        "popover_id": { "$ref": "#/$defs/non_empty_string" },
        "accessible_name": { "type": "string" },
        "dismissal": { "$ref": "#/$defs/non_empty_string" },
        "dismissal_is_disallowed": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "is_dismissible": { "type": "boolean" },
        "keyboard_operable": { "type": "boolean" },
        "focus_returns_to_trigger": { "type": "boolean" },
        "carries_only_critical_instruction": { "type": "boolean" },
        "critical_steps_available_elsewhere": { "type": "boolean" },
        "is_non_modal_secondary": { "type": "boolean" },
        "content_reachable_without_hover": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "stays_lightweight_secondary_with_safe_focus": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "badge_examples",
        "popover_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "badge_meaning_relies_on_color_alone",
        "badge_meaning_hidden_behind_hover_only",
        "popover_carries_only_critical_instruction",
        "popover_fails_to_return_focus_to_trigger"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "badge_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/badge_example" }
        },
        "popover_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/popover_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "badge_meaning_relies_on_color_alone": { "const": false },
        "badge_meaning_hidden_behind_hover_only": { "const": false },
        "popover_carries_only_critical_instruction": { "const": false },
        "popover_fails_to_return_focus_to_trigger": { "const": false }
      }
    }
  }
}
