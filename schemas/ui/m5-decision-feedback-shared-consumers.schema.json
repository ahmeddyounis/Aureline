{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-decision-feedback-shared-consumers.schema.json",
  "title": "M5 Decision / Feedback Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the eight B135 decision and feedback primitives (badge/chip/pill, popover, dialog/sheet, banner/inline notice, toast, empty state, loading state, consequence block) to the shell / help / support / review / settings / updates / CLI-export / support-export consumers that render them, proving one shared vocabulary across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_decision_feedback_shared_consumer_vocabulary_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 12,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "badge_chip_pill",
        "popover",
        "dialog_sheet",
        "banner_inline_notice",
        "toast",
        "empty_state",
        "loading_state",
        "consequence_block"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "help_ui",
        "support_ui",
        "review_ui",
        "settings_ui",
        "updates_ui",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "vocabulary_drift_detected",
        "color_alone_used_for_meaning",
        "popover_carried_only_critical_instruction",
        "generic_yes_no_confirmation_copy_used",
        "durable_work_shown_as_toast_only",
        "useful_pane_blanked_during_loading",
        "full_screen_spinner_when_partial_capable",
        "canonical_reference_missing",
        "upstream_primitive_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition_word",
        "scope_word",
        "severity_word",
        "rationale_word",
        "recovery_path_word",
        "durable_object_word"
      ],
      "properties": {
        "disposition_word": { "type": "string", "minLength": 1 },
        "scope_word": { "type": "string", "minLength": 1 },
        "severity_word": { "type": "string", "minLength": 1 },
        "rationale_word": { "type": "string", "minLength": 1 },
        "recovery_path_word": { "type": "string", "minLength": 1 },
        "durable_object_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "primitive_object_id",
        "primitive_object_label",
        "component",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "relies_on_color_alone_for_meaning",
        "lets_a_popover_carry_the_only_critical_instruction",
        "uses_generic_yes_no_confirmation_copy",
        "represents_durable_work_as_toast_only_truth",
        "blanks_a_useful_pane_during_loading",
        "uses_a_full_screen_spinner_where_partial_capable",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "primitive_object_id": { "type": "string", "minLength": 1 },
        "primitive_object_label": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "relies_on_color_alone_for_meaning": {
          "type": "boolean",
          "const": false
        },
        "lets_a_popover_carry_the_only_critical_instruction": {
          "type": "boolean",
          "const": false
        },
        "uses_generic_yes_no_confirmation_copy": {
          "type": "boolean",
          "const": false
        },
        "represents_durable_work_as_toast_only_truth": {
          "type": "boolean",
          "const": false
        },
        "blanks_a_useful_pane_during_loading": {
          "type": "boolean",
          "const": false
        },
        "uses_a_full_screen_spinner_where_partial_capable": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_reuse_proven_by_fixtures",
        "same_object_same_vocabulary_across_surfaces",
        "disposition_words_stay_in_frozen_vocabulary",
        "meaning_never_relies_on_color_alone",
        "popover_never_carries_only_critical_instruction",
        "dialogs_never_use_generic_yes_no_copy",
        "toast_never_becomes_only_durable_truth",
        "loading_never_blanks_useful_pane",
        "loading_never_uses_full_screen_spinner_when_partial_capable",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "primitive_reuse_proven_by_fixtures": {
          "type": "boolean",
          "const": true
        },
        "same_object_same_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "disposition_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "meaning_never_relies_on_color_alone": {
          "type": "boolean",
          "const": true
        },
        "popover_never_carries_only_critical_instruction": {
          "type": "boolean",
          "const": true
        },
        "dialogs_never_use_generic_yes_no_copy": {
          "type": "boolean",
          "const": true
        },
        "toast_never_becomes_only_durable_truth": {
          "type": "boolean",
          "const": true
        },
        "loading_never_blanks_useful_pane": {
          "type": "boolean",
          "const": true
        },
        "loading_never_uses_full_screen_spinner_when_partial_capable": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_ui_reuses_shared_primitives",
        "help_ui_reuses_shared_primitives",
        "support_ui_reuses_shared_primitives",
        "review_ui_reuses_shared_primitives",
        "settings_ui_reuses_shared_primitives",
        "updates_ui_reuses_shared_primitives",
        "support_export_reuses_shared_primitives",
        "every_primitive_adopted_by_two_or_more_consumers",
        "vocabulary_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_contract_family"
      ],
      "properties": {
        "shell_ui_reuses_shared_primitives": {
          "type": "boolean",
          "const": true
        },
        "help_ui_reuses_shared_primitives": {
          "type": "boolean",
          "const": true
        },
        "support_ui_reuses_shared_primitives": {
          "type": "boolean",
          "const": true
        },
        "review_ui_reuses_shared_primitives": {
          "type": "boolean",
          "const": true
        },
        "settings_ui_reuses_shared_primitives": {
          "type": "boolean",
          "const": true
        },
        "updates_ui_reuses_shared_primitives": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_shared_primitives": {
          "type": "boolean",
          "const": true
        },
        "every_primitive_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "vocabulary_identical_for_same_object": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_contract_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
