{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-core-action-input-component-matrix.schema.json",
  "title": "Aureline M5 button, icon-button, split-button, text-field, search-field, combobox, toggle-control, and segmented-control component matrix",
  "description": "Export-safe packet freezing Aureline's most reused atomic action and input controls. The packet names every claimed M5 surface that still ships its own button, icon button, split button, text field, search field, combobox, checkbox/radio/switch toggle, or segmented control — across the forms, settings, search, entry, review, and repair surfaces — and binds each to the claimed surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, reduced-motion, CLI/export, support-packet), the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each control declares the controlled vocabularies it carries: the single controlled interaction-state vocabulary consumers bind to (default, hover, focus_visible, pressed, loading, disabled, locked, read_only, degraded), plus family-specific button emphasis, icon-label mode, split-button default posture, field label mode, field validation state, search-field affordance, combobox value source, toggle semantics, and segmented mode. Hard invariants forbid letting placeholder text replace the label, letting a loading state relabel the action or lose attribution, leaving an icon-only destructive action unlabeled, blurring a switch with a deferred checkbox, letting a split button default to a riskier alternate, and hiding locked or degraded semantics behind generic disabled chrome. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_button_icon_button_split_button_text_field_search_field_combobox_toggle_control_and_segmented_control_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "component_family": {
      "enum": [
        "button",
        "icon_button",
        "split_button",
        "text_field",
        "search_field",
        "combobox",
        "toggle_control",
        "segmented_control"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "default",
        "hover",
        "focus_visible",
        "pressed",
        "loading",
        "disabled",
        "locked",
        "read_only",
        "degraded"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "lets_placeholder_text_replace_the_label",
        "lets_loading_relabel_the_action_or_lose_attribution",
        "leaves_icon_only_destructive_action_unlabeled",
        "blurs_switch_with_deferred_checkbox",
        "lets_split_button_default_to_riskier_alternate",
        "hides_locked_or_degraded_semantics_behind_generic_disabled"
      ],
      "properties": {
        "component_family": {
          "$ref": "#/$defs/component_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/disposition"
          }
        },
        "button_emphases": {
          "type": "array"
        },
        "icon_label_modes": {
          "type": "array"
        },
        "split_postures": {
          "type": "array"
        },
        "field_label_modes": {
          "type": "array"
        },
        "field_validations": {
          "type": "array"
        },
        "search_affordances": {
          "type": "array"
        },
        "combobox_value_sources": {
          "type": "array"
        },
        "toggle_semantics": {
          "type": "array"
        },
        "segmented_modes": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "lets_placeholder_text_replace_the_label": {
          "const": false
        },
        "lets_loading_relabel_the_action_or_lose_attribution": {
          "const": false
        },
        "leaves_icon_only_destructive_action_unlabeled": {
          "const": false
        },
        "blurs_switch_with_deferred_checkbox": {
          "const": false
        },
        "lets_split_button_default_to_riskier_alternate": {
          "const": false
        },
        "hides_locked_or_degraded_semantics_behind_generic_disabled": {
          "const": false
        }
      }
    }
  }
}
