{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-merge-readiness-strip.schema.json",
  "title": "Aureline M5 merge-readiness strip",
  "description": "Per-component contract for a merge-readiness strip: the reusable compact-strip component that summarizes blocking state and ownership; blocking reasons stay explicit rather than collapsed into a single ready/not-ready pill. Binds the frozen governance-state vocabulary plus the blocking state and enforcement authority so a local readiness estimate is never presented as the provider's final gate. The Rust validator in crates/aureline-review is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "ownership_label",
    "blocking_state",
    "enforcement_authority",
    "governance_state_vocab"
  ],
  "properties": {
    "component": {
      "const": "merge_readiness_strip"
    },
    "ownership_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "blocking_state": {
      "$ref": "#/$defs/blocking_state"
    },
    "enforcement_authority": {
      "$ref": "#/$defs/enforcement_authority"
    },
    "governance_state_vocab": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/governance_state_vocab"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "blocking_state": {
      "enum": [
        "ready",
        "blocked",
        "stale"
      ]
    },
    "enforcement_authority": {
      "enum": [
        "advisory",
        "authoritative",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "governance_state_vocab": {
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    }
  }
}
