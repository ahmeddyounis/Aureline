{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-rollout-ring-row.schema.json",
  "title": "Aureline M5 rollout-ring row",
  "description": "Stable UI contract for an M5 rollout-ring row. The row names ring, promotion state, target scope, rollback availability, freshness, and keyboard route so held or paused rollout lanes never inherit general-availability labels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "ring",
    "promotion_state",
    "target_scope_ref",
    "freshness",
    "rollback_available",
    "discloses_ring",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_rollout_ring_row" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "ring": {
      "enum": ["canary", "early_adopter", "broad", "general_availability", "paused"]
    },
    "promotion_state": {
      "enum": ["held", "promoting", "promoted", "rolled_back", "blocked"]
    },
    "target_scope_ref": { "$ref": "#/$defs/ref" },
    "freshness": { "$ref": "#/$defs/truth_mode" },
    "rollback_available": { "type": "boolean" },
    "discloses_ring": { "const": true },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_reported"]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "enum": ["rollout_paused", "provenance_incomplete"] },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
