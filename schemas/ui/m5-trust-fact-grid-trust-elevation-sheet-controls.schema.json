{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-trust-fact-grid-trust-elevation-sheet-controls.schema.json",
  "title": "Aureline M5 trust-fact-grid and trust-elevation-sheet controls",
  "description": "Export-safe packet for the second implement lane over the frozen M5 workspace-trust / guided-repair component matrix. It carries resolved, honest projections of the trust-fact grid and the trust-elevation sheet across the claimed M5 consumer surfaces, so a trust elevation is a reviewed fact sheet a user can inspect before approving. Each controls row binds a consumer surface to the resolved trust-fact grid examples (naming actor, object identity, trust class / scope, policy source, narrowed capability, and per-root trust) and the resolved trust-elevation sheet examples (naming actor, object, scope, policy source, capability delta, the reduced-mode alternative, and the lasting-versus-one-time effect). Hard invariants forbid implying an ambient or inherited grant beyond the reviewed object, hiding the policy source or capability delta behind menus only, collapsing the reduced-mode alternative into generic chrome, and collapsing a one-time effect into a lasting / generic grant. Acceptance criteria — no trust prompt implies ambient grant beyond the reviewed object and scope, and trust prompts expose the same fields, delta grammar, and reduced-mode path — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_trust_fact_grid_and_trust_elevation_sheet_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "trust_disposition": {
      "type": ["string", "null"],
      "enum": [
        "trusted",
        "restricted",
        "mixed_root",
        "policy_blocked",
        "reduced_mode",
        "preview_ready",
        "checkpoint_missing",
        "exact_reversal",
        "compensate",
        "regenerate",
        "manual_follow_up",
        "audit_only",
        null
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "trust_fact_grid_example": {
      "type": "object",
      "required": [
        "grid_id",
        "actor_identity",
        "object_identity",
        "trust_scope",
        "trust_disposition",
        "root_trust",
        "grant_source",
        "policy_epoch",
        "capability_narrow",
        "capability_narrowed",
        "is_mixed_root",
        "collapses_per_root_into_uniform",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "all_facts_named"
      ],
      "properties": {
        "grid_id": { "$ref": "#/$defs/non_empty_string" },
        "actor_identity": { "type": "string" },
        "object_identity": { "type": "string" },
        "trust_scope": { "$ref": "#/$defs/non_empty_string" },
        "trust_disposition": { "$ref": "#/$defs/trust_disposition" },
        "root_trust": { "$ref": "#/$defs/non_empty_string" },
        "grant_source": { "$ref": "#/$defs/non_empty_string" },
        "policy_epoch": { "type": "string" },
        "capability_narrow": { "$ref": "#/$defs/non_empty_string" },
        "capability_narrowed": { "type": "boolean" },
        "is_mixed_root": { "type": "boolean" },
        "collapses_per_root_into_uniform": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "all_facts_named": { "type": "boolean" }
      }
    },
    "trust_elevation_sheet_example": {
      "type": "object",
      "required": [
        "sheet_id",
        "actor_identity",
        "object_identity",
        "trust_scope",
        "trust_disposition",
        "grant_source",
        "policy_epoch",
        "capability_narrow",
        "capability_narrowed",
        "reduced_mode_alternative_stated",
        "effect_class",
        "effect_lasting",
        "implies_ambient_scope",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "reviewed_before_approval"
      ],
      "properties": {
        "sheet_id": { "$ref": "#/$defs/non_empty_string" },
        "actor_identity": { "type": "string" },
        "object_identity": { "type": "string" },
        "trust_scope": { "$ref": "#/$defs/non_empty_string" },
        "trust_disposition": { "$ref": "#/$defs/trust_disposition" },
        "grant_source": { "$ref": "#/$defs/non_empty_string" },
        "policy_epoch": { "type": "string" },
        "capability_narrow": { "$ref": "#/$defs/non_empty_string" },
        "capability_narrowed": { "type": "boolean" },
        "reduced_mode_alternative_stated": { "type": "boolean" },
        "effect_class": { "$ref": "#/$defs/non_empty_string" },
        "effect_lasting": { "type": "boolean" },
        "implies_ambient_scope": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "reviewed_before_approval": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "trust_fact_grid_examples",
        "trust_elevation_sheet_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "implies_ambient_or_inherited_grant_beyond_reviewed_object",
        "hides_policy_source_or_capability_delta_in_menus_only",
        "collapses_reduced_mode_alternative_into_generic_chrome",
        "collapses_effect_duration_into_generic_grant"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "trust_fact_grid_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/trust_fact_grid_example" }
        },
        "trust_elevation_sheet_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/trust_elevation_sheet_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_ambient_or_inherited_grant_beyond_reviewed_object": { "const": false },
        "hides_policy_source_or_capability_delta_in_menus_only": { "const": false },
        "collapses_reduced_mode_alternative_into_generic_chrome": { "const": false },
        "collapses_effect_duration_into_generic_grant": { "const": false }
      }
    }
  }
}
