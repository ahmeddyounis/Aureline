{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-class-and-evidence-freshness-badge.schema.json",
  "title": "Aureline M5 support-class and evidence-freshness badge primitive",
  "description": "Export-safe packet for the reusable M5 support-class / evidence-freshness badge primitive. It narrows the support_class and evidence_freshness families frozen in schemas/ui/m5-badge-family-matrix.schema.json into one resolver plus a parity matrix, so a user can tell — from the two badges and their explanation drawers alone — how supported a capability is (certified/supported/limited/community/experimental) and how fresh the proof behind that support is (fresh/retest_pending/evidence_stale/imported_evidence), as two distinct, composable cues rather than one overloaded badge. Each badge row binds one claimed badge consumer (the onboarding checklist, the Help capability card, the marketplace listing, the diagnostics report, the certification record, and the evaluation pack) to the shared badge anatomy, support-class values, freshness values, derived effective-claim postures, narrowing reasons, next actions, explanation-drawer fields, export fields, and non-visual accessibility routes, plus worked resolution cases that must reproduce the resolver output exactly. The resolver derives the effective claim from the freshness axis alone — a certified capability with stale evidence narrows exactly like a community one, because freshness is never derived from support class — and when imported or stale evidence reduces the claim it produces a self-contained narrowing note that preserves the underlying support-class context. Hard invariants forbid collapsing the two axes into one overloaded badge, implying freshness from the support class, dropping the support-class context when a claim narrows, and letting exported evidence lose badge meaning. Raw URLs, raw signing keys, raw tokens, credentials, and user text bodies never cross this boundary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "badge_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_support_class_and_evidence_freshness_badges_across_claimed_m5_onboarding_help_marketplace_and_diagnostics_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "badge_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/badge_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "consumer_surface": {
      "enum": [
        "onboarding_checklist",
        "help_capability_card",
        "marketplace_listing",
        "diagnostics_report",
        "certification_record",
        "evaluation_pack"
      ]
    },
    "support_class": {
      "enum": ["certified", "supported", "limited", "community", "experimental"]
    },
    "freshness": {
      "enum": ["fresh", "retest_pending", "evidence_stale", "imported_evidence"]
    },
    "effective_claim": {
      "enum": [
        "claim_current",
        "claim_retest_pending",
        "claim_narrowed_evidence_stale",
        "claim_narrowed_imported_evidence"
      ]
    },
    "narrowing_reason": {
      "enum": ["retest_pending", "evidence_stale", "imported_evidence"]
    },
    "next_action": {
      "enum": ["await_retest", "refresh_evidence", "reverify_imported_evidence"]
    },
    "badge_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "anatomy_parts",
        "support_class_values",
        "freshness_values",
        "effective_claim_postures",
        "narrowing_reasons",
        "next_actions",
        "explanation_fields",
        "export_fields",
        "accessibility_routes",
        "example_resolutions"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "support_class_values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/support_class" }
        },
        "freshness_values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/freshness" }
        },
        "effective_claim_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effective_claim" }
        },
        "narrowing_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/next_action" }
        },
        "explanation_fields": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "collapses_support_and_freshness_into_one_badge": { "const": false },
        "implies_freshness_from_support_class": { "const": false },
        "drops_support_class_context_on_narrowing": { "const": false },
        "drops_badge_meaning_in_export": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "subject_label",
            "support_class",
            "freshness",
            "effective_claim",
            "is_current",
            "is_retest_pending",
            "is_narrowed",
            "evidence_source_repr",
            "last_evaluated_repr"
          ],
          "properties": {
            "support_class": { "$ref": "#/$defs/support_class" },
            "freshness": { "$ref": "#/$defs/freshness" },
            "effective_claim": { "$ref": "#/$defs/effective_claim" },
            "is_current": { "type": "boolean" },
            "is_retest_pending": { "type": "boolean" },
            "is_narrowed": { "type": "boolean" },
            "narrowing_note": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": [
                    "reason",
                    "next_action",
                    "preserved_support_class",
                    "narrows_claim",
                    "headline"
                  ],
                  "properties": {
                    "reason": { "$ref": "#/$defs/narrowing_reason" },
                    "next_action": { "$ref": "#/$defs/next_action" },
                    "preserved_support_class": { "$ref": "#/$defs/support_class" },
                    "narrows_claim": { "type": "boolean" },
                    "headline": { "$ref": "#/$defs/non_empty_string" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
