{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-adapter-confidence-chip-discovery-diff-card-controls.schema.json",
  "title": "Aureline M5 adapter-confidence-chip and discovery-diff-card controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 build/remote-boundary component matrix. It carries resolved, honest projections of the adapter-confidence chip and the discovery-diff card across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved adapter-confidence chip examples (naming the adapter/source class, confidence band, heuristic-vs-structured-vs-imported discovery mode, the single controlled certainty, the claim ceiling, and any current downgrade reason) and the resolved discovery-diff card examples (naming the previous and current target identity, the previous and current discovery confidence, the changed certainty, and the review-before-switch state). Hard invariants forbid relabeling a materially changed target without an attributable review state, letting lower-confidence discovery overwrite a higher-confidence resolved target without review, hiding the adapter confidence, source class, or discovery mode, and concealing a downgrade or drift behind generic status wording. Acceptance criteria are proven by the resolved examples, not merely asserted: a user can see when a target is exact, compatible, heuristic, imported, downgraded, or stale before invoking; material discovery drift produces an attributable review state instead of a silent relabel; and stale or weaker discovery never silently replaces a stronger resolved target. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-remote is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_adapter_confidence_chip_and_discovery_diff_card_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "certainty": {
      "enum": ["exact", "compatible", "heuristic", "imported", "downgraded", "stale"]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "adapter_confidence_chip_example": {
      "type": "object",
      "required": [
        "chip_id",
        "adapter_source_class",
        "adapter_confidence",
        "discovery_mode",
        "certainty",
        "claim_ceiling",
        "current_downgrade_reason",
        "degrade_reason",
        "next_action",
        "source_class_disclosed",
        "confidence_band_disclosed",
        "discovery_mode_disclosed",
        "is_stale"
      ],
      "properties": {
        "chip_id": { "$ref": "#/$defs/non_empty_string" },
        "adapter_source_class": { "$ref": "#/$defs/non_empty_string" },
        "adapter_confidence": { "$ref": "#/$defs/non_empty_string" },
        "discovery_mode": { "$ref": "#/$defs/non_empty_string" },
        "certainty": { "$ref": "#/$defs/certainty" },
        "claim_ceiling": { "$ref": "#/$defs/non_empty_string" },
        "current_downgrade_reason": { "type": ["string", "null"] },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "source_class_disclosed": { "type": "boolean" },
        "confidence_band_disclosed": { "type": "boolean" },
        "discovery_mode_disclosed": { "type": "boolean" },
        "is_stale": { "type": "boolean" }
      }
    },
    "discovery_diff_card_example": {
      "type": "object",
      "required": [
        "card_id",
        "previous_target_identity",
        "current_target_identity",
        "previous_confidence",
        "current_confidence",
        "changed_certainty",
        "material_change",
        "review_before_switch_available",
        "attributed_review_state",
        "target_identity_disclosed",
        "changed_certainty_disclosed",
        "degrade_reason",
        "next_action",
        "renders_silent_relabel",
        "overwrites_higher_confidence_without_review"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "previous_target_identity": { "type": "string" },
        "current_target_identity": { "type": "string" },
        "previous_confidence": { "$ref": "#/$defs/non_empty_string" },
        "current_confidence": { "$ref": "#/$defs/non_empty_string" },
        "changed_certainty": { "$ref": "#/$defs/certainty" },
        "material_change": { "type": "boolean" },
        "review_before_switch_available": { "type": "boolean" },
        "attributed_review_state": { "type": "boolean" },
        "target_identity_disclosed": { "type": "boolean" },
        "changed_certainty_disclosed": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "renders_silent_relabel": { "type": "boolean" },
        "overwrites_higher_confidence_without_review": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "adapter_confidence_chip_examples",
        "discovery_diff_card_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "relabels_target_without_attributable_review",
        "lower_confidence_overwrites_resolved_without_review",
        "hides_adapter_confidence_or_discovery_mode",
        "conceals_downgrade_or_drift_in_generic_status_wording"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "adapter_confidence_chip_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/adapter_confidence_chip_example" }
        },
        "discovery_diff_card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/discovery_diff_card_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "relabels_target_without_attributable_review": { "const": false },
        "lower_confidence_overwrites_resolved_without_review": { "const": false },
        "hides_adapter_confidence_or_discovery_mode": { "const": false },
        "conceals_downgrade_or_drift_in_generic_status_wording": { "const": false }
      }
    }
  }
}
