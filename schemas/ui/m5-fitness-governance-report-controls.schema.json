{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-fitness-governance-report-controls.schema.json",
  "title": "Aureline M5 fitness dashboard tile and governance report row controls",
  "description": "Export-safe packet for the two reusable M5 governance-dashboard primitives implemented as one controls packet: the fitness dashboard tile (protected-metric identity, declared fitness state, threshold state, corpus/profile provenance, evidence freshness, profile-match state, owner, and linked evidence) and the governance report row (report type, corpus/profile scope, timestamp, pass/partial/fail outcome, provenance disclosure, and compare-or-open-report continuity). It narrows the fitness_dashboard_tile and governance_report_row families frozen in schemas/ui/m5-governance-dashboard-component-matrix.schema.json into two resolvers plus a parity matrix, so a user can tell — from the tile and the row alone — what protected metric is under review, whether its evidence is fresh, which corpus or profile produced a governance result, and whether that result may be trusted outside its support class. Each controls row binds one claimed M5 assurance consumer (the assurance dashboard, the operator board, the shiproom packet, the CLI inspect, and the support export) to the shared anatomy, the frozen readiness-state vocabulary, the provenance classes, report scopes, threshold states, evidence-freshness states, degrade reasons, provenance disclosures, report actions, export fields, and non-visual accessibility routes, plus worked resolution cases that must reproduce the resolver output exactly. Hard invariants forbid rendering stale or wrong-profile evidence as a clean pass, hiding the corpus/profile provenance, hiding the owner or evidence freshness, and inventing a dashboard-local status word. Raw URLs, raw tokens, credentials, private endpoints, and user text bodies never cross this boundary; an owner alias is a role alias, never a personal contact detail. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_fitness_dashboard_tiles_and_governance_report_rows_across_claimed_m5_assurance_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "consumer_surface": {
      "enum": [
        "assurance_dashboard",
        "operator_board",
        "shiproom_packet",
        "cli_inspect",
        "support_export"
      ]
    },
    "readiness_state": {
      "enum": [
        "passing",
        "warning",
        "blocked",
        "waived",
        "expired_waiver",
        "evidence_stale",
        "owner_unresolved",
        "forum_unresolved",
        "not_evaluated"
      ]
    },
    "provenance_disclosure": {
      "enum": [
        "canonical_within_support_class",
        "sampled_disclose_caveat",
        "synthetic_disclose_caveat",
        "profile_pinned_disclose_scope",
        "provenance_undisclosed"
      ]
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "anatomy_parts",
        "readiness_states",
        "provenance_classes",
        "evidence_freshness_states",
        "provenance_disclosures",
        "report_actions",
        "export_fields",
        "accessibility_routes",
        "fitness_tile_examples",
        "report_row_examples"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "readiness_states": { "type": "array", "minItems": 1 },
        "provenance_classes": { "type": "array", "minItems": 1 },
        "evidence_freshness_states": { "type": "array", "minItems": 1 },
        "provenance_disclosures": { "type": "array", "minItems": 1 },
        "report_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "fitness_tile_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fitness_case" }
        },
        "report_row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/report_case" }
        },
        "renders_stale_or_wrong_profile_as_clean_pass": { "const": false },
        "hides_corpus_or_profile_provenance": { "const": false },
        "hides_owner_or_evidence_freshness": { "const": false },
        "invents_dashboard_local_status_grammar": { "const": false }
      }
    },
    "fitness_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "fitness_id_repr",
            "fitness_family_repr",
            "declared_state",
            "threshold_state",
            "provenance_class",
            "evidence_freshness",
            "profile_match",
            "readiness_state",
            "is_clean_pass"
          ],
          "properties": {
            "readiness_state": { "$ref": "#/$defs/readiness_state" },
            "is_clean_pass": { "type": "boolean" }
          }
        }
      }
    },
    "report_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "report_id_repr",
            "report_type",
            "report_scope",
            "provenance_class",
            "provenance_disclosure",
            "provenance_trustable_outside_support_class",
            "readiness_state",
            "report_actions"
          ],
          "properties": {
            "provenance_disclosure": { "$ref": "#/$defs/provenance_disclosure" },
            "provenance_trustable_outside_support_class": { "type": "boolean" },
            "readiness_state": { "$ref": "#/$defs/readiness_state" },
            "report_actions": { "type": "array", "minItems": 2 }
          }
        }
      }
    }
  }
}
