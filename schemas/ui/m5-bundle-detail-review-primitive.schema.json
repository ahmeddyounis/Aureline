{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-bundle-detail-review-primitive.schema.json",
  "title": "Aureline M5 bundle detail / review primitive",
  "description": "Canonical parity matrix for the reusable M5 bundle detail / review primitive: a bundle detail page and an install / update review sheet that both resolve from one review context and share one review identity. Narrows two families of the frozen M5 workflow-bundle component matrix (bundle_detail_page, bundle_install_update_review_sheet) into one working resolver. Bundle adoption no longer hides what will change in the workspace, profile, or installed package set (AC1); review sheets stay intelligible under mirror/offline and policy-constrained conditions (AC2); every claimed stack-entry surface points to the same diffed bundle truth (AC3). A mutating install / update / remove always creates a one-step rollback checkpoint before mutating. Raw manifest bytes, credentials, entitlement tokens, mirror URLs, and provider cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_bundle_detail_review_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "bundle_detail_page",
        "install_review_sheet",
        "update_review_sheet",
        "drift_review_sheet",
        "migration_review_view",
        "support_export_replay"
      ]
    },
    "review_posture": {
      "enum": ["ready_to_apply", "constrained_by_policy", "read_only_comparison"]
    },
    "dependency_marker": {
      "enum": [
        "entitlement_required",
        "policy_gated",
        "preview_capability",
        "labs_capability",
        "mirror_only_source",
        "bounded_platform"
      ]
    },
    "side_effect_class": {
      "enum": [
        "extension_install",
        "settings_profile_write",
        "task_recipe_registration",
        "docs_tour_pack_install",
        "toolchain_install",
        "scaffold_generation"
      ]
    },
    "export_field": {
      "enum": [
        "review_id",
        "bundle_identity",
        "source_class",
        "diff_scope",
        "rollback_checkpoint",
        "dependency_markers",
        "mirror_offline_posture",
        "changelog_ref"
      ]
    },
    "component_kind": {
      "enum": [
        "extension",
        "profile_preset",
        "layout_preset",
        "settings_preset",
        "task_recipe",
        "launch_recipe",
        "debug_recipe",
        "docs_pack",
        "tour_pack",
        "template_ref",
        "scaffold_ref",
        "migration_mapping"
      ]
    },
    "review_operation": {
      "enum": ["install", "update", "remove", "drift_review"]
    },
    "diff_action": {
      "enum": ["added", "removed", "modified", "unchanged"]
    },
    "asset_ownership": {
      "enum": [
        "bundle_owned",
        "locally_overridden",
        "adopted",
        "removable",
        "blocked_by_policy",
        "blocked_by_lifecycle"
      ]
    },
    "resolution_choice": {
      "enum": [
        "keep_local",
        "adopt_bundle",
        "rebase",
        "compare",
        "remove_bundle_owned",
        "not_applicable"
      ]
    },
    "source_class": {
      "enum": [
        "certified",
        "managed_approved",
        "community_reviewed",
        "imported_pending_review",
        "local_draft"
      ]
    },
    "bundle_class": {
      "enum": [
        "launch_bundle",
        "framework_pack",
        "template_bundle",
        "imported_handoff_bundle",
        "org_managed_bundle",
        "no_bundle"
      ]
    },
    "signer_source": {
      "enum": ["first_party", "trusted_remote", "unverified_remote", "untrusted"]
    },
    "support_class": {
      "enum": [
        "stable",
        "preview",
        "labs",
        "policy_gated",
        "mirror_only",
        "bounded_platform"
      ]
    },
    "scorecard_class": {
      "enum": ["certified", "probable", "community", "imported", "preview", "local_draft"]
    },
    "freshness_state": {
      "enum": ["fresh", "aging", "stale", "missing"]
    },
    "imported_confidence": {
      "enum": ["native", "bridged", "approximated", "unverified"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_supplied"]
    },
    "downgrade_trigger": {
      "enum": [
        "stale_certification",
        "mirror_stale",
        "offline_cache_only",
        "unverified_signer",
        "local_override_drift",
        "incompatible_aureline",
        "entitlement_dependency_unmet",
        "imported_not_native",
        "rollback_only_path"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "component_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_kind", "component_id", "label", "lifecycle_stage"],
      "properties": {
        "component_kind": { "$ref": "#/$defs/component_kind" },
        "component_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "lifecycle_stage": { "$ref": "#/$defs/support_class" }
      }
    },
    "component_diff_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_kind",
        "component_id",
        "lifecycle_stage",
        "requires_review",
        "diff_action",
        "ownership",
        "resolution",
        "diffable",
        "label",
        "diff_preview_ref"
      ],
      "properties": {
        "component_kind": { "$ref": "#/$defs/component_kind" },
        "component_id": { "type": "string", "minLength": 1 },
        "lifecycle_stage": { "$ref": "#/$defs/support_class" },
        "requires_review": { "type": "boolean" },
        "diff_action": { "$ref": "#/$defs/diff_action" },
        "ownership": { "$ref": "#/$defs/asset_ownership" },
        "resolution": { "$ref": "#/$defs/resolution_choice" },
        "diffable": { "const": true },
        "label": { "type": "string", "minLength": 1 },
        "diff_preview_ref": { "$ref": "#/$defs/ref" },
        "local_override_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "rollback_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_ref",
        "one_step",
        "reversible",
        "captured_before_mutation",
        "captured_component_count"
      ],
      "properties": {
        "checkpoint_ref": { "$ref": "#/$defs/ref" },
        "one_step": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "captured_before_mutation": { "type": "boolean" },
        "captured_component_count": { "type": "integer", "minimum": 0 }
      }
    },
    "nullable_rollback_checkpoint": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rollback_checkpoint" }]
    },
    "nullable_degraded_state": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/degraded_state" }]
    },
    "review_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "surface_label",
        "bundle_id_ref",
        "bundle_name",
        "bundle_class",
        "signer_source",
        "support_class",
        "source_class",
        "scorecard_class",
        "certification_freshness",
        "imported_confidence",
        "compatible_aureline_range",
        "truth_mode",
        "changelog_ref",
        "evidence_link_refs",
        "component_inventory",
        "dependency_markers",
        "operation",
        "diff_rows",
        "side_effects",
        "claims_no_change_despite_diff",
        "claims_current_despite_stale"
      ],
      "properties": {
        "review_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/signer_source" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "scorecard_class": { "$ref": "#/$defs/scorecard_class" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "imported_confidence": { "$ref": "#/$defs/imported_confidence" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "changelog_ref": { "$ref": "#/$defs/ref" },
        "evidence_link_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "component_inventory": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_summary" }
        },
        "dependency_markers": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency_marker" }
        },
        "operation": { "$ref": "#/$defs/review_operation" },
        "diff_rows": { "type": "array", "items": { "$ref": "#/$defs/component_diff_entry" } },
        "side_effects": { "type": "array", "items": { "$ref": "#/$defs/side_effect_class" } },
        "rollback_checkpoint": { "$ref": "#/$defs/rollback_checkpoint" },
        "claims_no_change_despite_diff": { "const": false },
        "claims_current_despite_stale": { "const": false },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_detail_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "bundle_id_ref",
        "bundle_name",
        "bundle_class",
        "signer_source",
        "support_class",
        "source_class",
        "scorecard_class",
        "certification_freshness",
        "compatible_aureline_range",
        "truth_mode",
        "changelog_ref",
        "evidence_link_refs",
        "component_inventory",
        "dependency_markers",
        "lists_full_inventory",
        "discloses_mirror_offline_posture",
        "discloses_dependency_markers"
      ],
      "properties": {
        "review_id": { "$ref": "#/$defs/id" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/signer_source" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "scorecard_class": { "$ref": "#/$defs/scorecard_class" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "changelog_ref": { "$ref": "#/$defs/ref" },
        "evidence_link_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "component_inventory": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_summary" }
        },
        "dependency_markers": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency_marker" }
        },
        "lists_full_inventory": { "const": true },
        "discloses_mirror_offline_posture": { "const": true },
        "discloses_dependency_markers": { "const": true }
      }
    },
    "resolved_review_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "operation",
        "diff_rows",
        "side_effects",
        "dependency_markers",
        "rollback_checkpoint",
        "truth_mode",
        "review_posture",
        "enumerates_every_change",
        "creates_rollback_checkpoint",
        "reviewed_before_apply",
        "discloses_diff_scope"
      ],
      "properties": {
        "review_id": { "$ref": "#/$defs/id" },
        "operation": { "$ref": "#/$defs/review_operation" },
        "diff_rows": { "type": "array", "items": { "$ref": "#/$defs/component_diff_entry" } },
        "side_effects": { "type": "array", "items": { "$ref": "#/$defs/side_effect_class" } },
        "dependency_markers": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency_marker" }
        },
        "rollback_checkpoint": { "$ref": "#/$defs/nullable_rollback_checkpoint" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "review_posture": { "$ref": "#/$defs/review_posture" },
        "enumerates_every_change": { "const": true },
        "creates_rollback_checkpoint": { "type": "boolean" },
        "reviewed_before_apply": { "const": true },
        "discloses_diff_scope": { "const": true }
      }
    },
    "resolved_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "detail_page",
        "review_sheet",
        "change_fully_disclosed",
        "intelligible_under_constraint",
        "shared_diff_truth"
      ],
      "properties": {
        "review_id": { "$ref": "#/$defs/id" },
        "detail_page": { "$ref": "#/$defs/resolved_detail_page" },
        "review_sheet": { "$ref": "#/$defs/resolved_review_sheet" },
        "change_fully_disclosed": { "const": true },
        "intelligible_under_constraint": { "const": true },
        "shared_diff_truth": { "const": true },
        "degraded": { "$ref": "#/$defs/nullable_degraded_state" }
      }
    },
    "review_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/review_input" },
        "resolved": { "$ref": "#/$defs/resolved_review" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "operations",
        "source_classes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_reviews",
        "hides_diff_scope",
        "applies_before_review",
        "hides_dependency_markers"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/review_operation" }
        },
        "source_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_class" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_reviews": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/review_case" }
        },
        "hides_diff_scope": { "const": false },
        "applies_before_review": { "const": false },
        "hides_dependency_markers": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "review_postures",
        "dependency_markers",
        "side_effect_classes",
        "export_fields",
        "component_kinds",
        "review_operations",
        "diff_actions",
        "asset_ownerships",
        "resolution_choices",
        "source_classes",
        "bundle_classes",
        "signer_sources",
        "support_classes",
        "scorecard_classes",
        "freshness_states",
        "imported_confidences",
        "truth_modes",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "review_postures": { "type": "array", "items": { "type": "string" } },
        "dependency_markers": { "type": "array", "items": { "type": "string" } },
        "side_effect_classes": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "component_kinds": { "type": "array", "items": { "type": "string" } },
        "review_operations": { "type": "array", "items": { "type": "string" } },
        "diff_actions": { "type": "array", "items": { "type": "string" } },
        "asset_ownerships": { "type": "array", "items": { "type": "string" } },
        "resolution_choices": { "type": "array", "items": { "type": "string" } },
        "source_classes": { "type": "array", "items": { "type": "string" } },
        "bundle_classes": { "type": "array", "items": { "type": "string" } },
        "signer_sources": { "type": "array", "items": { "type": "string" } },
        "support_classes": { "type": "array", "items": { "type": "string" } },
        "scorecard_classes": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "imported_confidences": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "review_identity_preserved_across_surfaces",
        "change_disclosed_before_apply",
        "review_intelligible_under_constraint",
        "rollback_checkpoint_created_before_mutation",
        "support_export_reconstructs_review",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "review_identity_preserved_across_surfaces": { "const": true },
        "change_disclosed_before_apply": { "const": true },
        "review_intelligible_under_constraint": { "const": true },
        "rollback_checkpoint_created_before_mutation": { "const": true },
        "support_export_reconstructs_review": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "review_sheet_reads_single_diff_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "review_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "review_sheet_reads_single_diff_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "review_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "review_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
