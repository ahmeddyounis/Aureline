{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-unsafe-fix-blocked-note.schema.json",
  "title": "Aureline M5 unsafe-fix-blocked-note / approved-repair-guidance primitive",
  "description": "Export-safe packet implementing the reusable M5 unsafe-fix blocked note and approved-repair guidance card as one twin-resolver primitive. The packet binds one row per claimed Doctor / support consumer — Doctor repair review, support-center unsafe-fix desk, recovery-center repair guidance, headless/CLI repair review, and support repair export — to the shared blocked-note and repair-guidance anatomy. The blocked note carries the note id, the specific blocked action label, the scenario code, related finding families, opaque evidence ids, the unsafe-fix block reason, the recommended safer repair, the redaction posture, the build/profile identity, the case disposition, the derived note posture (no-safe-alternative/irreversible-blocked/approval-required-blocked/policy-blocked/evidence-or-scope-blocked), whether a safer repair is offered, whether the rollback state and evidence remain preserved, whether the note stays distinct from a reviewed repair transaction, and bounded reveal-reason/view-safer-repair/preserve-evidence/dismiss/export actions. The approved-repair guidance carries the guidance id, the approved repair class, the blast radius, the changed and unchanged classes, the reversibility, the derived guidance posture (no-repair-available/irreversible-repair/partially-reversible-repair/broad-reversible-repair/scoped-reviewed-repair), whether the repair is a reviewed reversible transaction, whether declining keeps the evidence, and bounded reveal-blast-radius/view-changed-classes/request-approval/decline/export actions. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving both resolvers, and four hard invariants: it never masks the block reason or the recommended safer repair, never presents a destructive reset as equivalent to a reviewed repair transaction, never drops the rollback or evidence posture, and never collapses the guidance into one opaque blob. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_unsafe_fix_blocked_notes_and_approved_repair_guidance_with_blocked_action_block_reason_safer_repair_blast_radius_and_rollback_evidence_preservation_truth_across_claimed_m5_doctor_and_support_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "support_case_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "support_case_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "note_anatomy_parts",
        "guidance_anatomy_parts",
        "scenario_families",
        "finding_families",
        "block_reasons",
        "approved_repair_classes",
        "redaction_states",
        "case_dispositions",
        "blast_radii",
        "change_classes",
        "reversibilities",
        "note_postures",
        "note_actions",
        "guidance_postures",
        "guidance_actions",
        "note_export_fields",
        "guidance_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "note_examples",
        "guidance_examples",
        "masks_block_reason_or_repair",
        "presents_reset_as_reviewed_transaction",
        "drops_rollback_or_evidence_posture",
        "collapses_guidance_into_blob"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "doctor_repair_review",
            "support_center_unsafe_fix_desk",
            "recovery_center_repair_guidance",
            "headless_cli_repair_review",
            "support_repair_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "note_anatomy_parts": { "type": "array", "minItems": 1 },
        "guidance_anatomy_parts": { "type": "array", "minItems": 1 },
        "scenario_families": { "type": "array", "minItems": 1 },
        "finding_families": { "type": "array", "minItems": 1 },
        "block_reasons": { "type": "array", "minItems": 1 },
        "approved_repair_classes": { "type": "array", "minItems": 1 },
        "redaction_states": { "type": "array", "minItems": 1 },
        "case_dispositions": { "type": "array", "minItems": 1 },
        "blast_radii": { "type": "array", "minItems": 1 },
        "change_classes": { "type": "array", "minItems": 1 },
        "reversibilities": { "type": "array", "minItems": 1 },
        "note_postures": { "type": "array", "minItems": 1 },
        "note_actions": { "type": "array", "minItems": 1 },
        "guidance_postures": { "type": "array", "minItems": 1 },
        "guidance_actions": { "type": "array", "minItems": 1 },
        "note_export_fields": { "type": "array", "minItems": 1 },
        "guidance_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "note_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/note_example" }
        },
        "guidance_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/guidance_example" }
        },
        "masks_block_reason_or_repair": { "const": false },
        "presents_reset_as_reviewed_transaction": { "const": false },
        "drops_rollback_or_evidence_posture": { "const": false },
        "collapses_guidance_into_blob": { "const": false }
      }
    },
    "note_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "note_id",
            "blocked_action_label",
            "scenario_family",
            "finding_families",
            "related_evidence_ids",
            "block_reason",
            "recommended_repair",
            "redaction_state",
            "build_profile_identity",
            "case_disposition",
            "note_posture",
            "available_actions",
            "safer_repair_offered",
            "rollback_preserved",
            "evidence_preserved",
            "distinct_from_reviewed_transaction",
            "lineage_continuous"
          ]
        }
      }
    },
    "guidance_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "guidance_id",
            "repair_class",
            "blast_radius",
            "changed_classes",
            "unchanged_classes",
            "reversibility",
            "guidance_posture",
            "available_actions",
            "is_reviewed_transaction",
            "decline_keeps_evidence",
            "changed_and_unchanged_explicit"
          ]
        }
      }
    }
  }
}
