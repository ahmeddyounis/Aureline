{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-review-request-check-queue-component-matrix.schema.json",
  "title": "Aureline M5 review-request, checks, merge-readiness, and merge-queue component matrix",
  "description": "Export-safe packet freezing the M5 component truth for seven reusable review surfaces: review-request rows, checks-summary cards, pending-review trays, merge-readiness panels, merge-queue entries, stack-dependency chips, and approval-invalidation banners. Each component row binds a maturity class to the exact provider-versus-local-estimate distinction, stale-provider downgrade vocabulary, browser-handoff boundary, and local-continue fallback it must preserve, plus evidence requirements, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. Raw diff bodies, raw check logs, raw provider payloads, credentials, and live provider responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_review_request_check_and_merge_queue_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "component": {
      "type": "string",
      "enum": [
        "review_request_row",
        "checks_summary_card",
        "pending_review_tray",
        "merge_readiness_panel",
        "merge_queue_entry",
        "stack_dependency_chip",
        "approval_invalidation_banner"
      ]
    },
    "maturity_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "optional",
        "not_applicable"
      ]
    },
    "stale_provider_state": {
      "type": "string",
      "enum": [
        "provider_fresh",
        "provider_refreshing",
        "provider_stale",
        "provider_unreachable",
        "provider_conflict",
        "local_only_continuation"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "provider_freshness_stale",
        "approval_invalidated",
        "stack_parent_blocked",
        "queue_ownership_unresolved",
        "check_class_unverified",
        "browser_handoff_unavailable",
        "trust_narrowing",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "provider_mutation_attributable",
        "local_continue_preserved",
        "return_path_preserved",
        "evidence_preserved_no_revert",
        "not_applicable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_workspace",
        "merge_queue_panel",
        "pending_review_tray",
        "merge_readiness_panel",
        "browser_companion",
        "cli_headless",
        "support_export",
        "diagnostics",
        "help_about"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "maturity",
        "scope_summary",
        "provider_local_distinction",
        "stale_provider_downgrade_vocab",
        "browser_handoff_boundary",
        "local_continue_fallback",
        "evidence_requirement",
        "required_evidence_packet_refs",
        "downgrade_triggers",
        "rollback_posture",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/component"
        },
        "maturity": {
          "$ref": "#/$defs/maturity_class"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider_local_distinction": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale_provider_downgrade_vocab": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stale_provider_state"
          }
        },
        "browser_handoff_boundary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "local_continue_fallback": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_requirement": {
          "$ref": "#/$defs/evidence_requirement"
        },
        "required_evidence_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_local_estimate_distinct",
        "stale_provider_downgrade_explicit",
        "approval_invalidation_never_generic_warning",
        "browser_handoff_explicit",
        "local_continue_preserved_on_degraded_freshness",
        "stack_blocking_explicit",
        "queue_ownership_explicit",
        "check_class_explicit",
        "no_forced_raw_provider_navigation_for_triage",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "provider_local_estimate_distinct": {
          "type": "boolean",
          "const": true
        },
        "stale_provider_downgrade_explicit": {
          "type": "boolean",
          "const": true
        },
        "approval_invalidation_never_generic_warning": {
          "type": "boolean",
          "const": true
        },
        "browser_handoff_explicit": {
          "type": "boolean",
          "const": true
        },
        "local_continue_preserved_on_degraded_freshness": {
          "type": "boolean",
          "const": true
        },
        "stack_blocking_explicit": {
          "type": "boolean",
          "const": true
        },
        "queue_ownership_explicit": {
          "type": "boolean",
          "const": true
        },
        "check_class_explicit": {
          "type": "boolean",
          "const": true
        },
        "no_forced_raw_provider_navigation_for_triage": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_request_row_shows_provider_and_base_head",
        "checks_summary_card_shows_check_class_and_freshness",
        "pending_review_tray_shows_owner_and_local_provider",
        "merge_readiness_panel_shows_blocking_and_ownership",
        "merge_queue_entry_shows_queue_owner_and_position",
        "stack_dependency_chip_shows_stack_relation_and_blocking",
        "approval_invalidation_banner_shows_reason_not_generic",
        "cli_headless_shows_component_truth",
        "support_export_shows_component_truth"
      ],
      "properties": {
        "review_request_row_shows_provider_and_base_head": {
          "type": "boolean",
          "const": true
        },
        "checks_summary_card_shows_check_class_and_freshness": {
          "type": "boolean",
          "const": true
        },
        "pending_review_tray_shows_owner_and_local_provider": {
          "type": "boolean",
          "const": true
        },
        "merge_readiness_panel_shows_blocking_and_ownership": {
          "type": "boolean",
          "const": true
        },
        "merge_queue_entry_shows_queue_owner_and_position": {
          "type": "boolean",
          "const": true
        },
        "stack_dependency_chip_shows_stack_relation_and_blocking": {
          "type": "boolean",
          "const": true
        },
        "approval_invalidation_banner_shows_reason_not_generic": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_component_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_component_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
