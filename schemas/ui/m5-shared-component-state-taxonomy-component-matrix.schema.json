{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-shared-component-state-taxonomy-component-matrix.schema.json",
  "title": "Aureline M5 shared-component-state-taxonomy, interactive-state, selection-or-lock-state, and degraded-state-application component matrix",
  "description": "Export-safe packet freezing Aureline's reusable component-state semantics. The packet names the four state-contract families M5 claims — the shared component-state taxonomy, the interactive-state contract, the selection-or-lock-state contract, and the degraded-state-application contract — and binds each to the claimed M5 surface families that render it (controls, dense collections, prompts and dialogs, recovery surfaces, shell status/progress, and settings/capability sheets), the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, the mandatory labels it must be able to show, and the exact subset of the thirteen canonical states (default, hover, focus_visible, pressed_active, selected, current, disabled, read_only, loading, pending, warning_error, locked, degraded) it governs. The shared taxonomy freezes the precedence and distinctness rules (locked_over_disabled, read_only_over_disabled, current_distinct_from_selected, pending_distinct_from_loading) and the disclosure triggers that require publishing a state's cause, owner, block reason, or recovery instead of a silent style-only change. Hard invariants forbid collapsing current and selected, masking an explainable lock behind a plain disabled treatment, presenting pending as generic loading, and omitting consequence or recovery on a degraded, warning, or error state. Raw local paths, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-design-system is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_the_m5_shared_component_state_taxonomy_interactive_state_selection_or_lock_state_and_degraded_state_application_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "state_taxonomy_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "state_taxonomy_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "shared_component_state_taxonomy",
        "interactive_state",
        "selection_or_lock_state",
        "degraded_state_application"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "state_class": {
      "enum": [
        "default",
        "hover",
        "focus_visible",
        "pressed_active",
        "selected",
        "current",
        "disabled",
        "read_only",
        "loading",
        "pending",
        "warning_error",
        "locked",
        "degraded"
      ]
    },
    "precedence_rule": {
      "enum": [
        "locked_over_disabled",
        "read_only_over_disabled",
        "current_distinct_from_selected",
        "pending_distinct_from_loading"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "state_classes",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_current_and_selected",
        "masks_lock_behind_disabled",
        "presents_pending_as_generic_loading",
        "omits_consequence_or_recovery_on_degraded"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "state_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_class" }
        },
        "precedence_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/precedence_rule" }
        },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "collapses_current_and_selected": { "const": false },
        "masks_lock_behind_disabled": { "const": false },
        "presents_pending_as_generic_loading": { "const": false },
        "omits_consequence_or_recovery_on_degraded": { "const": false }
      }
    }
  }
}
