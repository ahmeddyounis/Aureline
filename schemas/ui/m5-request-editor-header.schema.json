{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-request-editor-header.schema.json",
  "title": "Aureline M5 request editor header",
  "description": "Reusable request header contract preserving method or operation kind, target identity, origin, environment, auth posture, capability, last-run state, and export-safe refs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "header_id", "request_identity_ref", "method_or_operation_kind", "target_identity_ref", "execution_origin", "environment_picker", "auth", "capability_state", "last_run_state", "freshness_state", "variable_resolution_ref", "source_refs", "consumer_surfaces", "copy_export"],
  "properties": {
    "record_kind": { "const": "m5_request_editor_header" },
    "schema_version": { "const": 1 },
    "header_id": { "$ref": "#/$defs/id" },
    "request_identity_ref": { "$ref": "#/$defs/ref" },
    "method_or_operation_kind": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "GRAPHQL_QUERY", "GRAPHQL_MUTATION", "GRAPHQL_SUBSCRIPTION", "SQL_SELECT", "SQL_DML", "SQL_DDL", "BROWSER_RUNTIME_ACTION"] },
    "target_identity_ref": { "$ref": "#/$defs/ref" },
    "execution_origin": { "$ref": "#/$defs/origin" },
    "environment_picker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_ref", "display_label", "selected_layer", "freshness_state", "policy_locked", "effective_fingerprint_ref"],
      "properties": {
        "environment_ref": { "$ref": "#/$defs/ref" },
        "display_label": { "$ref": "#/$defs/ref" },
        "selected_layer": { "type": "string", "enum": ["workspace", "profile", "collection", "runtime_override", "managed_policy", "imported_snapshot"] },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "policy_locked": { "type": "boolean" },
        "effective_fingerprint_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth_mode", "auth_storage_mode", "auth_source_ref", "raw_secret_exposed"],
      "properties": {
        "auth_mode": { "type": "string", "enum": ["none", "bearer", "basic", "api_key", "oauth_device_code", "delegated_session", "policy_injected", "browser_cookie_reference", "imported_no_live_auth"] },
        "auth_storage_mode": { "$ref": "#/$defs/auth_storage_mode" },
        "auth_source_ref": { "$ref": "#/$defs/ref" },
        "raw_secret_exposed": { "const": false }
      }
    },
    "capability_state": { "$ref": "#/$defs/capability_state" },
    "last_run_state": { "type": "string", "enum": ["never_run", "running", "succeeded", "failed", "blocked", "cancelled", "stale", "partial"] },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "variable_resolution_ref": { "$ref": "#/$defs/ref" },
    "reduced_capability_behavior": { "type": ["string", "null"], "minLength": 1 },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "origin": { "type": "string", "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "imported_snapshot", "cli_headless"] },
    "auth_storage_mode": { "type": "string", "enum": ["no_auth", "secret_broker_handle", "delegated_identity", "policy_injected", "browser_device_code", "local_encrypted_store", "managed_rotation", "imported_no_live_auth", "policy_blocked"] },
    "capability_state": { "type": "string", "enum": ["read_only", "write_capable", "inspect_only", "mutation_review_required", "policy_blocked", "unavailable"] },
    "freshness_state": { "type": "string", "enum": ["live", "current", "warm_cached", "cached", "imported", "stale", "superseded", "partial", "expired", "policy_limited", "unknown"] },
    "consumer_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["desktop_request_workspace", "desktop_database_tool", "remote_workspace", "container_workspace", "managed_workspace", "browser_runtime_panel", "notebook_handoff", "chart_handoff", "ai_context_handoff", "cli_headless", "support_export", "release_proof"] } },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } },
        "export_fields": { "$ref": "#/$defs/ref_array" },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
