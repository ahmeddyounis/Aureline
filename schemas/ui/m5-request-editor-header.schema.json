{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-request-editor-header.schema.json",
  "title": "Aureline M5 request editor header",
  "description": "Reusable request header contract preserving method or operation kind, target identity, origin, environment, auth posture, capability, last-run state, and export-safe refs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "header_id", "request_identity_ref", "method_or_operation_kind", "target_identity_ref", "execution_origin", "environment_picker", "auth", "capability_state", "run_control", "last_run_state", "last_run_summary", "freshness_state", "variable_resolution_ref", "auth_sheet_ref", "contract_source_badges", "source_refs", "consumer_surfaces", "copy_export"],
  "properties": {
    "record_kind": { "const": "m5_request_editor_header" },
    "schema_version": { "const": 1 },
    "header_id": { "$ref": "#/$defs/id" },
    "request_identity_ref": { "$ref": "#/$defs/ref" },
    "method_or_operation_kind": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "GRAPHQL_QUERY", "GRAPHQL_MUTATION", "GRAPHQL_SUBSCRIPTION", "SQL_SELECT", "SQL_DML", "SQL_DDL", "BROWSER_RUNTIME_ACTION"] },
    "target_identity_ref": { "$ref": "#/$defs/ref" },
    "execution_origin": { "$ref": "#/$defs/origin" },
    "environment_picker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_ref", "display_label", "source_layers", "selected_layer", "freshness_state", "policy_locked", "effective_fingerprint_ref", "override_scope", "export_scope"],
      "properties": {
        "environment_ref": { "$ref": "#/$defs/ref" },
        "display_label": { "$ref": "#/$defs/ref" },
        "source_layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "source_ref", "resolution_state", "override_allowed", "export_scope"],
            "properties": {
              "layer": { "type": "string", "enum": ["workspace", "profile", "collection", "request_document", "runtime_override", "secret_broker", "managed_policy", "browser_runtime", "imported_snapshot", "default_value"] },
              "source_ref": { "$ref": "#/$defs/ref" },
              "resolution_state": { "$ref": "#/$defs/resolution_state" },
              "override_allowed": { "type": "boolean" },
              "export_scope": { "$ref": "#/$defs/export_scope" }
            }
          }
        },
        "selected_layer": { "type": "string", "enum": ["workspace", "profile", "collection", "runtime_override", "managed_policy", "imported_snapshot"] },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "policy_locked": { "type": "boolean" },
        "effective_fingerprint_ref": { "$ref": "#/$defs/ref" },
        "override_scope": { "$ref": "#/$defs/override_scope" },
        "export_scope": { "$ref": "#/$defs/export_scope" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth_mode", "auth_storage_mode", "auth_source_ref", "scheme", "secret_source_class", "token_lifetime", "expiry_label", "handoff_state", "policy_notes", "raw_secret_exposed"],
      "properties": {
        "auth_mode": { "type": "string", "enum": ["none", "bearer", "basic", "api_key", "oauth_device_code", "delegated_session", "policy_injected", "browser_cookie_reference", "imported_no_live_auth"] },
        "auth_storage_mode": { "$ref": "#/$defs/auth_storage_mode" },
        "auth_source_ref": { "$ref": "#/$defs/ref" },
        "scheme": { "$ref": "#/$defs/auth_scheme" },
        "secret_source_class": { "$ref": "#/$defs/secret_source_class" },
        "token_lifetime": { "$ref": "#/$defs/token_lifetime" },
        "expiry_label": { "$ref": "#/$defs/ref" },
        "handoff_state": { "$ref": "#/$defs/handoff_state" },
        "policy_notes": { "$ref": "#/$defs/ref_array" },
        "raw_secret_exposed": { "const": false }
      }
    },
    "capability_state": { "$ref": "#/$defs/capability_state" },
    "run_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "run_enabled", "cancel_enabled", "primary_action_label", "blocked_reason_ref"],
      "properties": {
        "state": { "type": "string", "enum": ["idle", "ready", "running", "cancelling", "blocked"] },
        "run_enabled": { "type": "boolean" },
        "cancel_enabled": { "type": "boolean" },
        "primary_action_label": { "type": "string", "enum": ["Run", "Send", "Review mutation", "Cancel", "Resume auth", "Inspect"] },
        "blocked_reason_ref": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "last_run_state": { "type": "string", "enum": ["never_run", "running", "succeeded", "failed", "blocked", "cancelled", "stale", "partial"] },
    "last_run_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_ref", "completed_at", "status", "duration_ms", "origin_ref", "result_summary_ref", "assertion_summary_ref"],
      "properties": {
        "run_ref": { "$ref": "#/$defs/ref" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "status": { "type": "string", "enum": ["never_run", "running", "succeeded", "failed", "blocked", "cancelled", "stale", "partial"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "origin_ref": { "$ref": "#/$defs/ref" },
        "result_summary_ref": { "$ref": "#/$defs/ref" },
        "assertion_summary_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "variable_resolution_ref": { "$ref": "#/$defs/ref" },
    "auth_sheet_ref": { "$ref": "#/$defs/ref" },
    "contract_source_badges": { "$ref": "#/$defs/ref_array" },
    "reduced_capability_behavior": { "type": ["string", "null"], "minLength": 1 },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "origin": { "type": "string", "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "imported_snapshot", "cli_headless"] },
    "auth_storage_mode": { "type": "string", "enum": ["no_auth", "secret_broker_handle", "delegated_identity", "policy_injected", "browser_device_code", "local_encrypted_store", "managed_rotation", "imported_no_live_auth", "policy_blocked"] },
    "auth_scheme": { "type": "string", "enum": ["no_auth", "basic", "bearer", "api_key", "oauth2_authorization_code", "oauth2_client_credentials", "oauth2_device_code", "browser_session", "mtls"] },
    "secret_source_class": { "type": "string", "enum": ["none", "workspace_variable", "secret_broker", "delegated_identity", "policy_injected", "browser_device_code", "local_encrypted_store", "managed_rotation", "imported_no_live_auth", "policy_blocked"] },
    "token_lifetime": { "type": "string", "enum": ["no_expiry", "short_lived", "refreshable", "expired", "session_bound", "unknown"] },
    "handoff_state": { "type": "string", "enum": ["not_applicable", "pending", "awaiting_user_authorization", "authorized", "expired", "denied", "policy_blocked"] },
    "capability_state": { "type": "string", "enum": ["read_only", "write_capable", "inspect_only", "mutation_review_required", "policy_blocked", "unavailable"] },
    "freshness_state": { "type": "string", "enum": ["live", "current", "warm_cached", "cached", "imported", "stale", "superseded", "partial", "expired", "policy_limited", "unknown"] },
    "resolution_state": { "type": "string", "enum": ["resolved", "unresolved", "shadowed", "policy_hidden", "secret_handle"] },
    "override_scope": { "type": "string", "enum": ["not_overridable", "request_only", "workspace_profile", "runtime_session", "managed_policy_only"] },
    "export_scope": { "type": "string", "enum": ["metadata_only", "redacted_preview", "secret_handle_ref", "blocked_by_policy", "not_exported"] },
    "consumer_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["desktop_request_workspace", "desktop_database_tool", "remote_workspace", "container_workspace", "managed_workspace", "browser_runtime_panel", "notebook_handoff", "chart_handoff", "ai_context_handoff", "cli_headless", "support_export", "release_proof"] } },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } },
        "export_fields": { "$ref": "#/$defs/ref_array" },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
