{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-notebook-kernel-output-component-matrix.schema.json",
  "title": "Aureline M5 notebook-document-header, kernel-state-strip, kernel-picker-row, kernel-origin-pill, output-trust-banner, output-provenance-chip-group, restart-consequence-card, and kernel-recovery-card component matrix",
  "description": "Export-safe packet freezing Aureline's reusable notebook kernel / output components. The packet names every notebook surface component family M5 claims that still drifts too easily on document, runtime, trust, and recovery language — notebook document headers, kernel state strips, kernel picker rows, kernel origin pills, output trust banners, output provenance chip groups, restart consequence cards, and kernel recovery cards — and binds each to the claimed M5 notebook surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Every component binds the one controlled disposition vocabulary (no_kernel, queued, busy, ready, disconnected, managed, remote, stale_output, sanitized, active, reconnect, restart_clean, choose_another_kernel) plus the family-specific controlled vocabularies it carries: document source classes and identity states; kernel execution states and connection states; kernel candidate kinds and selection states; kernel origin classes and origin trust states; output trust classes and freshness states; output provenance kinds and provenance states; restart action classes and consequence states; and kernel recovery action classes and recovery states. Hard invariants forbid a kernel recovery card implying a rerun, presenting stale output as live, hiding a raw / sanitized / active trust class behind a hover-only affordance, and collapsing local, SSH, container, managed, or browser-bridge kernels into one unlabeled badge. Raw notebook JSON, raw cell source, raw output bytes, raw kernel-protocol frames, and private endpoints never cross this boundary. The Rust validator in crates/aureline-notebook is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_the_m5_notebook_document_header_kernel_state_strip_kernel_picker_row_kernel_origin_pill_output_trust_banner_output_provenance_chip_group_restart_consequence_card_and_kernel_recovery_card_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "notebook_component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "notebook_component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "notebook_document_header",
        "kernel_state_strip",
        "kernel_picker_row",
        "kernel_origin_pill",
        "output_trust_banner",
        "output_provenance_chip_group",
        "restart_consequence_card",
        "kernel_recovery_card"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "no_kernel",
        "queued",
        "busy",
        "ready",
        "disconnected",
        "managed",
        "remote",
        "stale_output",
        "sanitized",
        "active",
        "reconnect",
        "restart_clean",
        "choose_another_kernel"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "recovery_card_implies_rerun",
        "presents_stale_output_as_live",
        "hides_trust_class_behind_hover_only",
        "collapses_kernel_origins_into_one_badge"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "recovery_card_implies_rerun": { "const": false },
        "presents_stale_output_as_live": { "const": false },
        "hides_trust_class_behind_hover_only": { "const": false },
        "collapses_kernel_origins_into_one_badge": { "const": false }
      }
    }
  }
}
