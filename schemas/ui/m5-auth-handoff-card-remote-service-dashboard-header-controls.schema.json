{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-auth-handoff-card-remote-service-dashboard-header-controls.schema.json",
  "title": "Aureline M5 auth handoff-card and remote/service dashboard-header controls",
  "description": "Export-safe packet for the fourth implement lane over the frozen M5 embedded-boundary component matrix. It carries resolved, honest projections of the auth handoff card and the remote/service dashboard header across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved auth-handoff-card examples (naming the handoff posture, provider/domain, reason, fallback state, local-safe continuity note, and — under a device-code posture — its code or expiry disclosure) and the resolved remote/service dashboard-header examples (naming the target/service identity, ownership boundary, freshness/offline state, and export/open-console actions while keeping the primary local recovery controls reachable). Hard invariants forbid masquerading as native permission or approval chrome, hiding owner/origin or the browser handoff behind menus only, rendering a stale or blocked state as fresh first-party truth, and embedding a high-risk approval without a native step-up. Acceptance criteria are proven by the resolved examples, not merely asserted: users can distinguish embedded sign-in checkpoints from system-browser or passkey handoff and know which local state remains intact while the handoff completes, and remote/service dashboards never substitute for primary local recovery controls or hide their freshness and ownership boundaries. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_auth_handoff_card_and_remote_service_dashboard_header_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "boundary_disposition": {
      "enum": [
        "live_first_party_local",
        "live_first_party_hosted",
        "live_provider_owned",
        "stale_snapshot",
        "offline_snapshot",
        "provider_blocked",
        "browser_handoff_only",
        "capability_limited",
        "not_evaluated"
      ]
    },
    "handoff_posture": {
      "enum": [
        "embedded_sign_in_checkpoint",
        "system_browser_handoff",
        "passkey_handoff",
        "device_code_handoff",
        "provider_content_handoff"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "auth_handoff_card_example": {
      "type": "object",
      "required": [
        "card_id",
        "posture",
        "handoff_kind",
        "handoff_reason",
        "provider_label",
        "provider_domain_label",
        "boundary_disposition",
        "fallback_state",
        "expiry_disclosure",
        "provider_or_domain_stated",
        "reason_stated",
        "local_continuity_stated",
        "fallback_stated",
        "device_code_disclosure_present",
        "degrade_reason",
        "next_action",
        "imitates_native_approval_ui",
        "embeds_high_risk_approval_without_step_up"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "posture": { "$ref": "#/$defs/handoff_posture" },
        "handoff_kind": { "$ref": "#/$defs/non_empty_string" },
        "handoff_reason": { "$ref": "#/$defs/non_empty_string" },
        "provider_label": { "type": "string" },
        "provider_domain_label": { "type": "string" },
        "boundary_disposition": { "$ref": "#/$defs/boundary_disposition" },
        "fallback_state": { "$ref": "#/$defs/non_empty_string" },
        "expiry_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "provider_or_domain_stated": { "type": "boolean" },
        "reason_stated": { "type": "boolean" },
        "local_continuity_stated": { "type": "boolean" },
        "fallback_stated": { "type": "boolean" },
        "device_code_disclosure_present": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "imitates_native_approval_ui": { "type": "boolean" },
        "embeds_high_risk_approval_without_step_up": { "type": "boolean" }
      }
    },
    "remote_service_dashboard_header_example": {
      "type": "object",
      "required": [
        "header_id",
        "owner_origin",
        "service_identity_label",
        "freshness",
        "boundary_disposition",
        "service_identity_stated",
        "owner_origin_disclosed",
        "freshness_stated",
        "primary_local_recovery_available",
        "export_action_available",
        "open_console_action_available",
        "degrade_reason",
        "next_action",
        "substitutes_for_local_recovery",
        "allows_high_risk_approval_in_embedded_chrome"
      ],
      "properties": {
        "header_id": { "$ref": "#/$defs/non_empty_string" },
        "owner_origin": { "$ref": "#/$defs/non_empty_string" },
        "service_identity_label": { "type": "string" },
        "freshness": { "$ref": "#/$defs/non_empty_string" },
        "boundary_disposition": { "$ref": "#/$defs/boundary_disposition" },
        "service_identity_stated": { "type": "boolean" },
        "owner_origin_disclosed": { "type": "boolean" },
        "freshness_stated": { "type": "boolean" },
        "primary_local_recovery_available": { "type": "boolean" },
        "export_action_available": { "type": "boolean" },
        "open_console_action_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "substitutes_for_local_recovery": { "type": "boolean" },
        "allows_high_risk_approval_in_embedded_chrome": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "auth_handoff_card_examples",
        "remote_service_dashboard_header_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masquerades_as_native_approval_chrome",
        "hides_owner_origin_or_handoff_in_menus_only",
        "renders_stale_or_blocked_as_fresh_first_party_truth",
        "embeds_high_risk_approval_without_native_step_up"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "auth_handoff_card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/auth_handoff_card_example" }
        },
        "remote_service_dashboard_header_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/remote_service_dashboard_header_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masquerades_as_native_approval_chrome": { "const": false },
        "hides_owner_origin_or_handoff_in_menus_only": { "const": false },
        "renders_stale_or_blocked_as_fresh_first_party_truth": { "const": false },
        "embeds_high_risk_approval_without_native_step_up": { "const": false }
      }
    }
  }
}
