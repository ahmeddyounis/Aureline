{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-badge-family-certification.schema.json",
  "title": "Aureline M5 badge-family surface certification packet",
  "description": "M05-947 closing capstone certifying that the frozen M5 badge families (support class, evidence freshness, lifecycle, channel, deployment scope, compatibility state) hold their truth on every claimed M5 badge-bearing surface. Keyed on the claimed surface (marketplace, help/about, settings, onboarding, diagnostics, runtime/deployment, support/export, CLI/headless), each row certifies the surface across six truth axes — visual, keyboard, screen-reader, CLI/export, degraded-state, and axis-separation behavior — and either passes (green), auto-narrows its badge-support claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a full-truth claim inherited from a healthier surface. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; and badge meaning (each axis stays distinct, with its explanation drawer, downgrade rule, and filter key) must be preserved across product, docs, diagnostics, and export. Every row cites exactly one canonical badge-family release-proof bundle. The packet is metadata-only: raw badge material, signing keys, and evidence cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_badge_family_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-badge-family-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_surface": {
      "enum": [
        "marketplace",
        "help_about",
        "settings",
        "onboarding",
        "diagnostics",
        "runtime_deployment",
        "support_export",
        "cli_headless"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "axis_separation"
      ]
    },
    "support_claim": {
      "enum": ["full_claim", "supported", "limited", "provisional", "imported", "policy_blocked"]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "surface_status": {
      "enum": ["green", "yellow", "red"]
    },
    "badge_family": {
      "enum": [
        "support_class",
        "evidence_freshness",
        "lifecycle",
        "channel",
        "deployment_scope",
        "compatibility_state"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "support_class_value_unstated",
        "evidence_freshness_hidden",
        "lifecycle_value_unstated",
        "channel_value_unstated",
        "deployment_scope_unstated",
        "compatibility_state_unstated",
        "explanation_drawer_missing",
        "axis_merged_into_another",
        "freshness_implied_from_support_class",
        "filter_key_dropped",
        "export_lost_badge_meaning",
        "proof_stale"
      ]
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/support_claim" },
        "to_claim": { "$ref": "#/$defs/support_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "badge_meaning_preserved",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_badge_family_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/certified_surface" },
        "claimed_claim": { "$ref": "#/$defs/support_claim" },
        "certified_claim": { "$ref": "#/$defs/support_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/badge_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "badge_meaning_preserved": { "type": "boolean" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-badge-family-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/surface_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_rows_preserve_badge_meaning",
        "every_axis_covered_on_every_row",
        "narrowed_surface_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_rows_preserve_badge_meaning": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
