{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-manifest-authoring-primitive.schema.json",
  "title": "Aureline M5 manifest-authoring primitive",
  "description": "Canonical parity matrix for the reusable M5 manifest-authoring primitive: a manifest-editor header, a schema/validator row, a target-context chip group, and an apply-review banner that all resolve from one authoring context and share one authoring identity and one truth class. Narrows three families of the frozen M5 manifest/build component matrix (manifest editor header, schema/validator row, target-context chip group) plus the apply-review banner they imply into one working resolver. Environment and schema source are never hidden (AC1); desired/rendered/live/preview/apply state stays explicit before mutation (AC2); schema/validator freshness is visible wherever a manifest is trusted (AC3). Raw manifest bodies, credentials, and endpoint data never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_manifest_authoring_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "desktop_manifest_editor",
        "plan_preview_pane",
        "cluster_resource_explorer",
        "apply_review_dialog",
        "provider_console_handoff",
        "support_export_replay"
      ]
    },
    "source_type": {
      "enum": [
        "authored_file",
        "rendered_artifact",
        "imported_snapshot",
        "provider_overlay",
        "generated_template"
      ]
    },
    "execution_origin": {
      "enum": [
        "local_workspace",
        "connected_cluster",
        "dry_run_sandbox",
        "imported_replay",
        "provider_console"
      ]
    },
    "schema_source": {
      "enum": [
        "bundled_with_app",
        "remote_registry",
        "cluster_discovered",
        "imported_snapshot",
        "provider_overlay",
        "unknown"
      ]
    },
    "dry_run": {
      "enum": [
        "available",
        "unavailable_connector_lost",
        "unavailable_policy_blocked",
        "not_applicable"
      ]
    },
    "rollback": {
      "enum": [
        "checkpoint_available",
        "rollback_supported",
        "no_rollback",
        "unknown"
      ]
    },
    "truth_mode": {
      "enum": ["authored_desired", "rendered", "planned", "live", "provider_overlay"]
    },
    "truth_mode_enum": {
      "enum": ["desired", "rendered", "plan", "live", "provider_overlay"]
    },
    "schema_freshness": {
      "enum": ["fresh", "stale", "unversioned", "unavailable"]
    },
    "validation_state": {
      "enum": ["valid", "warnings", "errors", "schema_unavailable", "unversioned"]
    },
    "edit_posture": {
      "enum": ["read_only", "preview_apply_review", "blocked_protected"]
    },
    "downgrade_trigger": {
      "enum": [
        "schema_stale",
        "adapter_unavailable",
        "connector_loss",
        "policy_block",
        "drift_from_source",
        "low_confidence_discovery",
        "structured_channel_lost",
        "target_context_unresolved"
      ]
    },
    "export_field": {
      "enum": [
        "authoring_id",
        "manifest_ref",
        "target_identity",
        "truth_class",
        "schema_freshness",
        "execution_origin",
        "mutation_counts"
      ]
    },
    "target_context_chips": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"] },
        "cluster": { "type": ["string", "null"] },
        "namespace": { "type": ["string", "null"] }
      }
    },
    "mutation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creates", "updates", "deletes"],
      "properties": {
        "creates": { "type": "integer", "minimum": 0 },
        "updates": { "type": "integer", "minimum": 0 },
        "deletes": { "type": "integer", "minimum": 0 }
      }
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "authoring_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_id",
        "manifest_ref",
        "manifest_label",
        "source_type",
        "truth_mode",
        "schema_source",
        "schema_freshness",
        "validation_state",
        "edit_posture",
        "execution_origin",
        "target_identity_ref",
        "target_context",
        "dry_run",
        "rollback"
      ],
      "properties": {
        "authoring_id": { "$ref": "#/$defs/id" },
        "manifest_ref": { "$ref": "#/$defs/ref" },
        "manifest_label": { "type": "string", "minLength": 1 },
        "source_type": { "$ref": "#/$defs/source_type" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "schema_source": { "$ref": "#/$defs/schema_source" },
        "schema_version_label": { "type": "string" },
        "schema_freshness": { "$ref": "#/$defs/schema_freshness" },
        "validation_state": { "$ref": "#/$defs/validation_state" },
        "policy_offline_note": { "type": "string" },
        "docs_ref": { "type": "string" },
        "edit_posture": { "$ref": "#/$defs/edit_posture" },
        "execution_origin": { "$ref": "#/$defs/execution_origin" },
        "target_identity_ref": { "$ref": "#/$defs/ref" },
        "target_context": { "$ref": "#/$defs/target_context_chips" },
        "mutation_counts": { "$ref": "#/$defs/mutation_counts" },
        "dry_run": { "$ref": "#/$defs/dry_run" },
        "rollback": { "$ref": "#/$defs/rollback" },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_id",
        "manifest_ref",
        "manifest_label",
        "source_type",
        "truth_mode",
        "schema_freshness",
        "edit_posture",
        "execution_origin",
        "target_context_visible",
        "preview_available",
        "apply_available"
      ],
      "properties": {
        "authoring_id": { "$ref": "#/$defs/id" },
        "manifest_ref": { "$ref": "#/$defs/ref" },
        "manifest_label": { "type": "string", "minLength": 1 },
        "source_type": { "$ref": "#/$defs/source_type" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "schema_freshness": { "$ref": "#/$defs/schema_freshness" },
        "edit_posture": { "$ref": "#/$defs/edit_posture" },
        "execution_origin": { "$ref": "#/$defs/execution_origin" },
        "target_context_visible": { "const": true },
        "preview_available": { "type": "boolean" },
        "apply_available": { "type": "boolean" }
      }
    },
    "resolved_schema_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_id",
        "schema_source",
        "schema_freshness",
        "validation_state",
        "blocks_apply",
        "open_docs_available"
      ],
      "properties": {
        "authoring_id": { "$ref": "#/$defs/id" },
        "schema_source": { "$ref": "#/$defs/schema_source" },
        "schema_version_label": { "type": ["string", "null"] },
        "schema_freshness": { "$ref": "#/$defs/schema_freshness" },
        "validation_state": { "$ref": "#/$defs/validation_state" },
        "blocks_apply": { "type": "boolean" },
        "policy_offline_note": { "type": ["string", "null"] },
        "open_docs_available": { "type": "boolean" }
      }
    },
    "resolved_chips": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_id",
        "truth_mode",
        "target_identity_ref",
        "chips",
        "context_complete",
        "stays_visible"
      ],
      "properties": {
        "authoring_id": { "$ref": "#/$defs/id" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "target_identity_ref": { "$ref": "#/$defs/ref" },
        "chips": { "$ref": "#/$defs/target_context_chips" },
        "context_complete": { "type": "boolean" },
        "stays_visible": { "const": true }
      }
    },
    "resolved_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_id",
        "truth_mode",
        "counts_known",
        "dry_run",
        "rollback",
        "preview_available",
        "apply_available"
      ],
      "properties": {
        "authoring_id": { "$ref": "#/$defs/id" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "mutation_counts": {
          "oneOf": [{ "$ref": "#/$defs/mutation_counts" }, { "type": "null" }]
        },
        "counts_known": { "type": "boolean" },
        "dry_run": { "$ref": "#/$defs/dry_run" },
        "rollback": { "$ref": "#/$defs/rollback" },
        "preview_available": { "type": "boolean" },
        "apply_available": { "type": "boolean" },
        "apply_blocked_reason": {
          "oneOf": [{ "$ref": "#/$defs/downgrade_trigger" }, { "type": "null" }]
        }
      }
    },
    "resolved_authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_id",
        "header",
        "schema_row",
        "context_chips",
        "apply_banner",
        "environment_and_schema_source_disclosed",
        "schema_freshness_visible"
      ],
      "properties": {
        "authoring_id": { "$ref": "#/$defs/id" },
        "header": { "$ref": "#/$defs/resolved_header" },
        "schema_row": { "$ref": "#/$defs/resolved_schema_row" },
        "context_chips": { "$ref": "#/$defs/resolved_chips" },
        "apply_banner": { "$ref": "#/$defs/resolved_banner" },
        "environment_and_schema_source_disclosed": { "const": true },
        "schema_freshness_visible": { "const": true },
        "degraded": {
          "oneOf": [{ "$ref": "#/$defs/degraded_state" }, { "type": "null" }]
        }
      }
    },
    "authoring_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/authoring_input" },
        "resolved": { "$ref": "#/$defs/resolved_authoring" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "source_types",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_authoring",
        "hides_environment_or_schema_source",
        "blurs_truth_states",
        "hides_schema_freshness",
        "offers_apply_before_review"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "source_types": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_type" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode_enum" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_authoring": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/authoring_case" }
        },
        "hides_environment_or_schema_source": { "const": false },
        "blurs_truth_states": { "const": false },
        "hides_schema_freshness": { "const": false },
        "offers_apply_before_review": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "source_types",
        "execution_origins",
        "schema_sources",
        "dry_run_states",
        "rollback_postures",
        "export_fields",
        "truth_modes",
        "schema_freshness",
        "validation_states",
        "edit_postures",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "source_types": { "type": "array", "items": { "type": "string" } },
        "execution_origins": { "type": "array", "items": { "type": "string" } },
        "schema_sources": { "type": "array", "items": { "type": "string" } },
        "dry_run_states": { "type": "array", "items": { "type": "string" } },
        "rollback_postures": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "schema_freshness": { "type": "array", "items": { "type": "string" } },
        "validation_states": { "type": "array", "items": { "type": "string" } },
        "edit_postures": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "authoring_identity_preserved_across_surfaces",
        "environment_and_schema_source_never_hidden",
        "states_explicit_before_mutation",
        "schema_freshness_visible_where_trusted",
        "support_export_reconstructs_authoring",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "authoring_identity_preserved_across_surfaces": { "const": true },
        "environment_and_schema_source_never_hidden": { "const": true },
        "states_explicit_before_mutation": { "const": true },
        "schema_freshness_visible_where_trusted": { "const": true },
        "support_export_reconstructs_authoring": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "apply_banner_reads_single_gate_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "authoring_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "apply_banner_reads_single_gate_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "authoring_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "authoring_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
