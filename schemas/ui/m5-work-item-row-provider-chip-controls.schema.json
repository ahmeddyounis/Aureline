{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-work-item-row-provider-chip-controls.schema.json",
  "title": "Aureline M5 work-item rows and provider chip groups",
  "description": "Export-safe packet implementing the reusable M5 work-item-row and provider-chip-group components in two co-equal control vectors. Each work-item row names its canonical id, title, work-item kind, assignee/owner, priority or severity, and linked-change count; its state-authority class is derived from the provider authority and the local-versus-provider state, so a local-only draft or a policy-blocked item can never read as provider-authoritative in a list surface. The canonical id is always visible and copyable and the default actions are keyboard-complete. Each provider chip group names the provider, the project or space it is scoped to, the tenant/org cue where relevant, and an explicit read-only/comment-link/full-edit/offline-capture/policy-blocked write posture that is checked against the provider authority so an offline-capture or policy-blocked chip never presents as live full-edit. Generic ticket/task wording never conceals provider ownership; raw work-item bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "work_item_rows",
    "provider_chip_groups",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "work_item_row_provider_chip_controls" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "work_item_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/work_item_row" }
    },
    "provider_chip_groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider_chip_group" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "work_item_kind": {
      "type": "string",
      "enum": ["issue", "task", "incident", "change_request", "epic", "unknown_kind"]
    },
    "provider_authority": {
      "type": "string",
      "enum": [
        "provider_owned",
        "local_draft",
        "mirrored_read_only",
        "imported_snapshot",
        "unlinked_local",
        "policy_pinned"
      ]
    },
    "local_state": {
      "type": "string",
      "enum": [
        "synced_with_provider",
        "local_only_draft",
        "queued_for_publish",
        "publish_deferred",
        "publish_failed",
        "conflict_held"
      ]
    },
    "state_authority_class": {
      "type": "string",
      "enum": [
        "provider_authoritative",
        "local_only_draft",
        "publish_pending",
        "snapshot_only",
        "blocked_capability"
      ]
    },
    "priority_class": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "none", "unknown"]
    },
    "row_action": {
      "type": "string",
      "enum": [
        "copy_canonical_id",
        "open_detail",
        "open_in_provider",
        "review_transition",
        "reveal_linked_context",
        "export_row"
      ]
    },
    "write_posture": {
      "type": "string",
      "enum": [
        "read_only",
        "comment_link",
        "full_edit",
        "offline_capture",
        "policy_blocked"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "issue_inbox",
        "work_item_detail",
        "review_workspace",
        "incident_workspace",
        "support_workflow",
        "cli_work_item"
      ]
    },
    "deployment_line": {
      "type": "string",
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "inbox_ui",
        "detail_ui",
        "relation_panel_ui",
        "sync_status_ui",
        "transition_sheet_ui",
        "evidence_panel_ui",
        "support_export",
        "cli_inspect",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "identity_unstated",
        "provider_authority_unstated",
        "local_versus_provider_state_hidden",
        "linked_context_unstated",
        "side_effect_preview_hidden",
        "publish_later_continuity_hidden",
        "sync_pending_state_hidden",
        "evidence_provenance_unstated",
        "handoff_destination_unstated",
        "export_boundary_hidden",
        "alternate_state_label_invented",
        "generic_ticket_wording_used",
        "proof_stale"
      ]
    },
    "accessibility_route_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_route" },
      "contains": { "const": "keyboard_focusable" }
    },
    "work_item_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "canonical_id",
        "canonical_id_copyable",
        "title",
        "work_item_kind",
        "provider_authority",
        "local_state",
        "owner_label",
        "priority_class",
        "uses_severity_scale",
        "priority_label",
        "linked_change_count",
        "linked_change_label",
        "state_authority_class",
        "claims_provider_authoritative",
        "local_state_note",
        "publish_pending_note",
        "blocked_capability_note",
        "default_actions",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "uses_generic_ticket_wording"
      ],
      "properties": {
        "component": { "const": "work_item_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id_copyable": { "const": true },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "work_item_kind": { "$ref": "#/$defs/work_item_kind" },
        "provider_authority": { "$ref": "#/$defs/provider_authority" },
        "local_state": { "$ref": "#/$defs/local_state" },
        "owner_label": { "$ref": "#/$defs/non_empty_string" },
        "priority_class": { "$ref": "#/$defs/priority_class" },
        "uses_severity_scale": { "type": "boolean" },
        "priority_label": { "$ref": "#/$defs/non_empty_string" },
        "linked_change_count": { "type": "integer", "minimum": 0 },
        "linked_change_label": { "type": "string" },
        "state_authority_class": { "$ref": "#/$defs/state_authority_class" },
        "claims_provider_authoritative": { "type": "boolean" },
        "local_state_note": { "type": "string" },
        "publish_pending_note": { "type": "string" },
        "blocked_capability_note": { "type": "string" },
        "default_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/row_action" },
          "allOf": [
            { "contains": { "const": "copy_canonical_id" } },
            { "contains": { "const": "open_detail" } }
          ]
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "uses_generic_ticket_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "local_state": { "const": "synced_with_provider" } },
            "required": ["local_state"]
          },
          "else": {
            "properties": { "local_state_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "state_authority_class": { "const": "publish_pending" } },
            "required": ["state_authority_class"]
          },
          "then": {
            "properties": { "publish_pending_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "state_authority_class": { "const": "blocked_capability" } },
            "required": ["state_authority_class"]
          },
          "then": {
            "properties": { "blocked_capability_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "state_authority_class": { "const": "provider_authoritative" } },
            "required": ["state_authority_class"]
          },
          "then": {
            "properties": { "claims_provider_authoritative": { "const": true } }
          },
          "else": {
            "properties": { "claims_provider_authoritative": { "const": false } }
          }
        },
        {
          "if": {
            "properties": { "linked_change_count": { "type": "integer", "minimum": 1 } },
            "required": ["linked_change_count"]
          },
          "then": {
            "properties": { "linked_change_label": { "$ref": "#/$defs/non_empty_string" } }
          }
        }
      ]
    },
    "provider_chip_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "group_id",
        "provider_label",
        "project_or_space_label",
        "provider_authority",
        "has_tenant_scope",
        "tenant_scope_note",
        "write_posture",
        "is_writable",
        "read_only_note",
        "offline_capture_note",
        "policy_block_note",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "uses_generic_ticket_wording"
      ],
      "properties": {
        "component": { "const": "provider_chip_group" },
        "group_id": { "$ref": "#/$defs/non_empty_string" },
        "provider_label": { "$ref": "#/$defs/non_empty_string" },
        "project_or_space_label": { "$ref": "#/$defs/non_empty_string" },
        "provider_authority": { "$ref": "#/$defs/provider_authority" },
        "has_tenant_scope": { "type": "boolean" },
        "tenant_scope_note": { "type": "string" },
        "write_posture": { "$ref": "#/$defs/write_posture" },
        "is_writable": { "type": "boolean" },
        "read_only_note": { "type": "string" },
        "offline_capture_note": { "type": "string" },
        "policy_block_note": { "type": "string" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "uses_generic_ticket_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "write_posture": { "const": "read_only" } },
            "required": ["write_posture"]
          },
          "then": {
            "properties": { "read_only_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "write_posture": { "const": "offline_capture" } },
            "required": ["write_posture"]
          },
          "then": {
            "properties": { "offline_capture_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "write_posture": { "const": "policy_blocked" } },
            "required": ["write_posture"]
          },
          "then": {
            "properties": { "policy_block_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": {
              "write_posture": { "enum": ["comment_link", "full_edit"] }
            },
            "required": ["write_posture"]
          },
          "then": {
            "properties": { "is_writable": { "const": true } },
            "required": ["is_writable"]
          },
          "else": {
            "properties": { "is_writable": { "const": false } },
            "required": ["is_writable"]
          }
        },
        {
          "if": {
            "properties": { "has_tenant_scope": { "const": true } },
            "required": ["has_tenant_scope"]
          },
          "then": {
            "properties": { "tenant_scope_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id_always_visible_and_copyable",
        "work_item_state_shows_provider_authority",
        "local_or_blocked_never_reads_as_provider_authoritative",
        "blocked_capability_always_explicit",
        "linked_change_count_always_shown",
        "keyboard_complete_default_actions",
        "provider_chip_shows_project_or_space_scope",
        "provider_chip_shows_write_posture",
        "tenant_org_cue_shown_when_relevant",
        "offline_capture_and_policy_block_explicit",
        "no_generic_ticket_wording_conceals_ownership",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "canonical_id_always_visible_and_copyable": { "const": true },
        "work_item_state_shows_provider_authority": { "const": true },
        "local_or_blocked_never_reads_as_provider_authoritative": { "const": true },
        "blocked_capability_always_explicit": { "const": true },
        "linked_change_count_always_shown": { "const": true },
        "keyboard_complete_default_actions": { "const": true },
        "provider_chip_shows_project_or_space_scope": { "const": true },
        "provider_chip_shows_write_posture": { "const": true },
        "tenant_org_cue_shown_when_relevant": { "const": true },
        "offline_capture_and_policy_block_explicit": { "const": true },
        "no_generic_ticket_wording_conceals_ownership": { "const": true },
        "controls_stable_across_deployment_lines": { "const": true },
        "copy_and_export_safe": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list_rows_distinguish_authority_without_inspector",
        "canonical_id_copyable_everywhere",
        "chip_group_shows_scope_and_posture_inline",
        "cli_headless_shows_control_truth",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "list_rows_distinguish_authority_without_inspector": { "const": true },
        "canonical_id_copyable_everywhere": { "const": true },
        "chip_group_shows_scope_and_posture_inline": { "const": true },
        "cli_headless_shows_control_truth": { "const": true },
        "support_export_shows_control_truth": { "const": true },
        "help_about_shows_control_truth": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
