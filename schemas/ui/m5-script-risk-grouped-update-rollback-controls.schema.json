{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-script-risk-grouped-update-rollback-controls.schema.json",
  "title": "Aureline M5 script-risk notices, grouped-update planners, and rollback/checkpoint strips",
  "description": "Export-safe packet implementing the reusable M5 script-risk-notice, grouped-update-planner, and rollback-checkpoint-strip components in three co-equal control vectors. Each script-risk notice names what may run (an install lifecycle script, a native build step, a post-install binary fetch, or nothing) and derives its risk class from the execution source, the policy disposition, and whether the source is trusted, so a package running an untrusted hook can never present as benign and every executing notice offers a policy-block or review action plus explicit support/client notes. Each grouped-update planner names the update reason and the grouped packages, and derives its plan class (direct bump, security patch, grouped refresh, or broad convergence) from the reason, the grouped-package count, and the transitive churn, so a broad convergence can never read as a single direct bump. Each rollback/checkpoint strip keeps recovery posture visible after a mutation: it names the checkpoint identity, the remove-blocked state, and the revert/open-diff/export-patch actions, and derives its recovery posture from the remove-blocked state and whether a lockfile regenerated, so a remove-blocked revert can never claim a clean rollback. Raw manifest bodies, raw lockfile bodies, raw script bodies, registry credentials, private registry URLs, and live registry responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "script_risk_notices",
    "grouped_update_planners",
    "rollback_checkpoint_strips",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "script_risk_grouped_update_rollback_controls"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "script_risk_notices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/script_risk_notice"
      }
    },
    "grouped_update_planners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/grouped_update_planner"
      }
    },
    "rollback_checkpoint_strips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rollback_checkpoint_strip"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_trigger"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "execution_source": {
      "type": "string",
      "enum": [
        "install_lifecycle_script",
        "native_build_step",
        "postinstall_binary_fetch",
        "no_scripts_declared"
      ]
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "no_execution",
        "review_recommended",
        "policy_blocked",
        "unknown_untrusted"
      ]
    },
    "update_reason": {
      "type": "string",
      "enum": [
        "direct_request",
        "security_advisory",
        "routine_refresh",
        "dependency_convergence"
      ]
    },
    "plan_class": {
      "type": "string",
      "enum": [
        "direct_bump",
        "security_patch",
        "grouped_refresh",
        "broad_convergence"
      ]
    },
    "remove_blocked_state": {
      "type": "string",
      "enum": [
        "not_a_remove",
        "removable",
        "remove_blocked_policy_pinned",
        "remove_blocked_required_by"
      ]
    },
    "recovery_posture_class": {
      "type": "string",
      "enum": [
        "fully_revertible",
        "revert_with_regeneration",
        "compensating_only"
      ]
    },
    "degradation_state": {
      "type": "string",
      "enum": [
        "resolved_exact",
        "manifest_range_only",
        "mirror_backed",
        "offline_snapshot_only",
        "auth_required_unsatisfied",
        "unknown_or_stale"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "staged_review_no_write",
        "write_back_checkpointed",
        "regenerate_only_no_manual_edit",
        "compensating_only_no_clean_revert",
        "not_applicable"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "registry_unreachable",
        "auth_required",
        "mirror_backed_only",
        "offline_snapshot_only",
        "lockfile_divergent",
        "script_or_native_build_risk",
        "broad_lockfile_regeneration",
        "rollback_unavailable",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "package_workspace",
        "dependency_explorer",
        "install_update_review",
        "registry_auth_workspace",
        "rollback_recovery",
        "browser_companion",
        "cli_headless",
        "support_export",
        "help_about"
      ]
    },
    "script_risk_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "notice_id",
        "package_label",
        "execution_source",
        "policy_blocks",
        "source_trusted",
        "risk_class",
        "execution_source_note",
        "review_action_label",
        "policy_block_action_label",
        "support_note",
        "client_note",
        "degradation_state",
        "degradation_note",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "type": "string",
          "const": "script_risk_notice"
        },
        "notice_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "package_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "execution_source": {
          "$ref": "#/$defs/execution_source"
        },
        "policy_blocks": {
          "type": "boolean"
        },
        "source_trusted": {
          "type": "boolean"
        },
        "risk_class": {
          "$ref": "#/$defs/risk_class"
        },
        "execution_source_note": {
          "type": "string"
        },
        "review_action_label": {
          "type": "string"
        },
        "policy_block_action_label": {
          "type": "string"
        },
        "support_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "client_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "degradation_state": {
          "$ref": "#/$defs/degradation_state"
        },
        "degradation_note": {
          "type": "string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_source": {
                "const": "no_scripts_declared"
              }
            },
            "required": [
              "execution_source"
            ]
          },
          "else": {
            "properties": {
              "execution_source_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk_class": {
                "const": "policy_blocked"
              }
            },
            "required": [
              "risk_class"
            ]
          },
          "then": {
            "properties": {
              "policy_block_action_label": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk_class": {
                "enum": [
                  "review_recommended",
                  "unknown_untrusted"
                ]
              }
            },
            "required": [
              "risk_class"
            ]
          },
          "then": {
            "properties": {
              "review_action_label": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "degradation_state": {
                "const": "resolved_exact"
              }
            }
          },
          "else": {
            "properties": {
              "degradation_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "properties": {
            "rollback_posture": {
              "enum": [
                "read_only_no_mutation",
                "staged_review_no_write"
              ]
            }
          }
        }
      ]
    },
    "grouped_update_planner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "planner_id",
        "plan_label",
        "update_reason",
        "reason_note",
        "grouped_packages",
        "transitive_churn_count",
        "plan_class",
        "transitive_churn_note",
        "convergence_note",
        "security_note",
        "degradation_state",
        "degradation_note",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "type": "string",
          "const": "grouped_update_planner"
        },
        "planner_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "plan_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "update_reason": {
          "$ref": "#/$defs/update_reason"
        },
        "reason_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "grouped_packages": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "transitive_churn_count": {
          "type": "integer",
          "minimum": 0
        },
        "plan_class": {
          "$ref": "#/$defs/plan_class"
        },
        "transitive_churn_note": {
          "type": "string"
        },
        "convergence_note": {
          "type": "string"
        },
        "security_note": {
          "type": "string"
        },
        "degradation_state": {
          "$ref": "#/$defs/degradation_state"
        },
        "degradation_note": {
          "type": "string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "plan_class": {
                "const": "broad_convergence"
              }
            },
            "required": [
              "plan_class"
            ]
          },
          "then": {
            "properties": {
              "convergence_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "plan_class": {
                "const": "security_patch"
              }
            },
            "required": [
              "plan_class"
            ]
          },
          "then": {
            "properties": {
              "security_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "degradation_state": {
                "const": "resolved_exact"
              }
            }
          },
          "else": {
            "properties": {
              "degradation_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "properties": {
            "rollback_posture": {
              "enum": [
                "read_only_no_mutation",
                "staged_review_no_write"
              ]
            }
          }
        }
      ]
    },
    "rollback_checkpoint_strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "strip_id",
        "checkpoint_label",
        "checkpoint_id",
        "mutation_summary",
        "remove_blocked_state",
        "remove_blocked_note",
        "regenerated",
        "regeneration_note",
        "recovery_posture_class",
        "rollback_posture",
        "recovery_visible_now",
        "revert_action_label",
        "open_diff_action_label",
        "export_patch_action_label",
        "degradation_state",
        "degradation_note",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "type": "string",
          "const": "rollback_checkpoint_strip"
        },
        "strip_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "checkpoint_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mutation_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "remove_blocked_state": {
          "$ref": "#/$defs/remove_blocked_state"
        },
        "remove_blocked_note": {
          "type": "string"
        },
        "regenerated": {
          "type": "boolean"
        },
        "regeneration_note": {
          "type": "string"
        },
        "recovery_posture_class": {
          "$ref": "#/$defs/recovery_posture_class"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "recovery_visible_now": {
          "type": "boolean",
          "const": true
        },
        "revert_action_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "open_diff_action_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "export_patch_action_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "degradation_state": {
          "$ref": "#/$defs/degradation_state"
        },
        "degradation_note": {
          "type": "string"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "remove_blocked_state": {
                "enum": [
                  "remove_blocked_policy_pinned",
                  "remove_blocked_required_by"
                ]
              }
            },
            "required": [
              "remove_blocked_state"
            ]
          },
          "then": {
            "properties": {
              "remove_blocked_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "regenerated": {
                "const": true
              }
            },
            "required": [
              "regenerated"
            ]
          },
          "then": {
            "properties": {
              "regeneration_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "degradation_state": {
                "const": "resolved_exact"
              }
            }
          },
          "else": {
            "properties": {
              "degradation_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recovery_posture_class": {
                "const": "fully_revertible"
              }
            },
            "required": [
              "recovery_posture_class"
            ]
          },
          "then": {
            "properties": {
              "rollback_posture": {
                "const": "write_back_checkpointed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recovery_posture_class": {
                "const": "revert_with_regeneration"
              }
            },
            "required": [
              "recovery_posture_class"
            ]
          },
          "then": {
            "properties": {
              "rollback_posture": {
                "const": "regenerate_only_no_manual_edit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recovery_posture_class": {
                "const": "compensating_only"
              }
            },
            "required": [
              "recovery_posture_class"
            ]
          },
          "then": {
            "properties": {
              "rollback_posture": {
                "const": "compensating_only_no_clean_revert"
              }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_execution_source_always_explicit",
        "script_risk_class_derived_not_asserted",
        "policy_block_or_review_action_always_offered",
        "update_reason_always_explicit",
        "grouped_packages_always_listed",
        "transitive_churn_never_understated",
        "plan_class_distinguishes_bump_patch_grouped_broad",
        "remove_blocked_states_explicit",
        "recovery_posture_visible_after_mutation",
        "revert_open_diff_export_patch_always_offered",
        "no_generic_one_click_update_language",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "script_execution_source_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "script_risk_class_derived_not_asserted": {
          "type": "boolean",
          "const": true
        },
        "policy_block_or_review_action_always_offered": {
          "type": "boolean",
          "const": true
        },
        "update_reason_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "grouped_packages_always_listed": {
          "type": "boolean",
          "const": true
        },
        "transitive_churn_never_understated": {
          "type": "boolean",
          "const": true
        },
        "plan_class_distinguishes_bump_patch_grouped_broad": {
          "type": "boolean",
          "const": true
        },
        "remove_blocked_states_explicit": {
          "type": "boolean",
          "const": true
        },
        "recovery_posture_visible_after_mutation": {
          "type": "boolean",
          "const": true
        },
        "revert_open_diff_export_patch_always_offered": {
          "type": "boolean",
          "const": true
        },
        "no_generic_one_click_update_language": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_risk_notice_shows_source_and_risk",
        "grouped_update_planner_shows_reason_and_class",
        "transitive_churn_shown_inline",
        "rollback_strip_shows_recovery_posture",
        "remove_blocked_states_shown_inline",
        "cli_headless_shows_control_truth",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "script_risk_notice_shows_source_and_risk": {
          "type": "boolean",
          "const": true
        },
        "grouped_update_planner_shows_reason_and_class": {
          "type": "boolean",
          "const": true
        },
        "transitive_churn_shown_inline": {
          "type": "boolean",
          "const": true
        },
        "rollback_strip_shows_recovery_posture": {
          "type": "boolean",
          "const": true
        },
        "remove_blocked_states_shown_inline": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_control_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_control_truth": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_control_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
