{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-incident-snapshot-card.schema.json",
  "title": "Aureline M5 incident-snapshot-card component",
  "description": "Names the incident's severity, its scope, and its freshness — so a stale incident snapshot is never shown as live and a user always sees how severe an incident is before escalating or handing off to desktop. Canonical per-component contract frozen by the M5 companion component matrix (schemas/ui/m5-companion-component-matrix.schema.json); downstream M5 rows point at this schema instead of restating companion UI truth by hand. Raw file bodies, diff hunks, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["component_family", "object_kind", "severity", "client_scope", "freshness", "dispositions", "required_labels"],
  "properties": {
    "component_family": { "const": "incident_snapshot_card" },
    "object_kind": { "$ref": "#/$defs/object_kind" },
    "severity": { "$ref": "#/$defs/severity" },
    "client_scope": { "$ref": "#/$defs/client_scope" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "dispositions": { "$ref": "#/$defs/dispositions" },
    "required_labels": { "$ref": "#/$defs/required_labels" }
  },
  "$defs": {
"object_kind": {
      "enum": ["notification_event", "review_item", "ci_run", "followed_session", "incident_record", "handoff_intent"]
    },
    "severity": {
      "enum": ["critical", "high", "moderate", "low", "informational", "unspecified"]
    },
    "client_scope": {
      "enum": ["workspace_scoped", "repo_scoped", "org_scoped", "device_scoped", "account_global", "unscoped"]
    },
    "freshness": {
      "enum": ["live", "cached", "stale", "offline_held", "expired_snapshot", "unknown_freshness"]
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["review_only", "comment_capable", "desktop_required", "cached", "stale", "policy_blocked", "handoff_ready"]
      }
    },
    "required_labels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["identity", "state", "keyboard_route", "scope_and_freshness", "capability_boundary", "severity_and_handoff_target"]
      }
    }
  }
}
