{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-schema-object-row.schema.json",
  "title": "Aureline M5 schema tree object row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "row_id",
    "connection_identity_ref",
    "schema_tree_ref",
    "object_identity_ref",
    "object_type",
    "object_name_ref",
    "object_path_refs",
    "freshness_state",
    "permission_summary",
    "online_state",
    "actions",
    "export_posture",
    "source_refs",
    "consumer_surfaces",
    "copy_export",
    "reduced_capability_banner",
    "provider_handoff_notes"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_schema_object_row"
    },
    "schema_version": {
      "const": 1
    },
    "row_id": {
      "$ref": "#/$defs/id"
    },
    "connection_identity_ref": {
      "$ref": "#/$defs/ref"
    },
    "schema_tree_ref": {
      "$ref": "#/$defs/ref"
    },
    "object_identity_ref": {
      "$ref": "#/$defs/ref"
    },
    "object_type": {
      "$ref": "#/$defs/object_type"
    },
    "object_name_ref": {
      "$ref": "#/$defs/ref"
    },
    "object_path_refs": {
      "$ref": "#/$defs/ref_array"
    },
    "freshness_state": {
      "$ref": "#/$defs/freshness_state"
    },
    "permission_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permission_state",
        "read_allowed",
        "write_allowed",
        "permission_limited",
        "summary_ref"
      ],
      "properties": {
        "permission_state": {
          "$ref": "#/$defs/permission_state"
        },
        "read_allowed": {
          "type": "boolean"
        },
        "write_allowed": {
          "type": "boolean"
        },
        "permission_limited": {
          "type": "boolean"
        },
        "summary_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "online_state": {
      "$ref": "#/$defs/online_state"
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_enabled",
        "query_enabled",
        "copy_identifier_enabled",
        "disabled_reason_ref",
        "action_labels"
      ],
      "properties": {
        "open_enabled": {
          "type": "boolean"
        },
        "query_enabled": {
          "type": "boolean"
        },
        "copy_identifier_enabled": {
          "type": "boolean"
        },
        "disabled_reason_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "action_labels": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "open",
              "query",
              "copy_identifier"
            ]
          }
        }
      }
    },
    "export_posture": {
      "$ref": "#/$defs/export_posture"
    },
    "source_refs": {
      "$ref": "#/$defs/ref_array"
    },
    "consumer_surfaces": {
      "$ref": "#/$defs/consumer_surfaces"
    },
    "copy_export": {
      "$ref": "#/$defs/copy_export"
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banner_id",
        "severity",
        "capability_state",
        "visible_label",
        "missing_capabilities",
        "preserved_fields",
        "action_policy"
      ],
      "properties": {
        "banner_id": {
          "$ref": "#/$defs/ref"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocked"
          ]
        },
        "capability_state": {
          "type": "string",
          "enum": [
            "read_only",
            "write_capable",
            "inspect_only",
            "mutation_review_required",
            "policy_blocked",
            "unavailable"
          ]
        },
        "visible_label": {
          "$ref": "#/$defs/ref"
        },
        "missing_capabilities": {
          "$ref": "#/$defs/ref_array"
        },
        "preserved_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "action_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_send_available",
            "replay_available",
            "mutate_available",
            "export_available"
          ],
          "properties": {
            "live_send_available": {
              "type": "boolean"
            },
            "replay_available": {
              "type": "boolean"
            },
            "mutate_available": {
              "type": "boolean"
            },
            "export_available": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provider_handoff_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note_id",
          "provider_surface",
          "handoff_state",
          "truth_preserved",
          "return_anchor_ref",
          "raw_material_exported"
        ],
        "properties": {
          "note_id": {
            "$ref": "#/$defs/ref"
          },
          "provider_surface": {
            "type": "string",
            "enum": [
              "desktop_request_workspace",
              "desktop_database_tool",
              "remote_workspace",
              "container_workspace",
              "managed_workspace",
              "browser_runtime_panel",
              "notebook_handoff",
              "chart_handoff",
              "ai_context_handoff",
              "cli_headless",
              "support_export",
              "release_proof"
            ]
          },
          "handoff_state": {
            "$ref": "#/$defs/ref"
          },
          "truth_preserved": {
            "$ref": "#/$defs/ref_array"
          },
          "return_anchor_ref": {
            "$ref": "#/$defs/ref"
          },
          "raw_material_exported": {
            "const": false
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "object_type": {
      "type": "string",
      "enum": [
        "database",
        "schema",
        "table",
        "view",
        "materialized_view",
        "column",
        "index",
        "procedure",
        "function",
        "collection",
        "bucket",
        "document",
        "unknown"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "fresh",
        "live",
        "current",
        "warm_cached",
        "cached",
        "imported",
        "stale",
        "superseded",
        "partial",
        "expired",
        "permission_limited",
        "policy_limited",
        "offline",
        "unknown"
      ]
    },
    "permission_state": {
      "type": "string",
      "enum": [
        "full_access",
        "read_only",
        "inspect_only",
        "permission_limited",
        "policy_hidden",
        "offline_unknown",
        "unknown"
      ]
    },
    "online_state": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "reconnecting",
        "policy_blocked",
        "unknown"
      ]
    },
    "export_posture": {
      "type": "string",
      "enum": [
        "metadata_only",
        "redacted_typed",
        "visible_rows_only_typed",
        "full_result_typed",
        "blocked_pending_consent",
        "blocked_pending_policy",
        "blocked_redaction_class_too_high"
      ]
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "desktop_database_tool",
          "remote_workspace",
          "container_workspace",
          "managed_workspace",
          "notebook_handoff",
          "chart_handoff",
          "ai_context_handoff",
          "cli_headless",
          "support_export",
          "release_proof"
        ]
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "export_fields",
        "text",
        "json",
        "markdown",
        "screenshot_only_prohibited"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "json",
              "markdown"
            ]
          }
        },
        "export_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "text": {
          "$ref": "#/$defs/ref"
        },
        "json": {
          "$ref": "#/$defs/ref"
        },
        "markdown": {
          "$ref": "#/$defs/ref"
        },
        "screenshot_only_prohibited": {
          "const": true
        }
      }
    }
  }
}
