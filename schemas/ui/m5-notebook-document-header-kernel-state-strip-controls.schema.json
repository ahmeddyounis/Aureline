{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-notebook-document-header-kernel-state-strip-controls.schema.json",
  "title": "Aureline M5 notebook document headers and kernel-state strips",
  "description": "Export-safe packet implementing the reusable M5 notebook-document-header and kernel-state-strip components in two co-equal control vectors. Each document header names its canonical .ipynb identity, where the notebook came from, where its saved/unsaved/conflicted/read-only/recovered identity stands, its paired export state, and its current target/workspace context, and offers first-class open/export/review actions; its origin class is derived from the document source class, so an imported, scratch, or unknown-source notebook can never read as a settled canonical source. Each kernel-state strip names its selected kernel origin/class, its execution state, its connection state, and its derived live class, and offers select/inspect/continue-without-kernel actions; its live class is derived from the execution and connection states, so a kernel-free, disconnected, or interrupted notebook can never read as live and a kernel-free notebook stays explicitly editable. Every next step names one stable notebook/kernel-manager/docs/support deep link rather than an ephemeral overlay or hidden route. No component presents a kernel-free notebook as live, collapses local/remote/managed kernels into one badge, conflates document truth with runtime truth, or hides a governed state behind a hover-only affordance; raw notebook payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "document_headers",
    "kernel_strips",
    "downgrade_triggers",
    "consumer_surfaces",
    "notebook_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_notebook_document_headers_and_kernel_state_strips_with_canonical_ipynb_source_selected_kernel_origin_busy_queued_offline_truth_and_no_kernel_edit_parity_across_claimed_m5_notebook_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "document_headers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/notebook_document_header" }
    },
    "kernel_strips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kernel_state_strip" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "notebook_review": { "$ref": "#/$defs/notebook_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "document_source_class": {
      "enum": [
        "local_ipynb",
        "remote_ipynb",
        "managed_workspace_ipynb",
        "imported_ipynb",
        "scratch_untitled",
        "unknown_source"
      ]
    },
    "document_identity_state": {
      "enum": [
        "saved_clean",
        "unsaved_changes",
        "autosaved",
        "conflicted",
        "read_only",
        "recovered"
      ]
    },
    "document_origin_class": {
      "enum": [
        "local_document",
        "remote_document",
        "managed_document",
        "imported_document",
        "scratch_document",
        "unknown_document"
      ]
    },
    "kernel_execution_state": {
      "enum": [
        "idle_ready",
        "queued_pending",
        "busy_running",
        "interrupted",
        "dead_no_kernel",
        "disconnected_reconnecting"
      ]
    },
    "kernel_connection_state": {
      "enum": [
        "connected_local",
        "connected_remote",
        "reconnecting",
        "disconnected",
        "connection_lost",
        "never_connected"
      ]
    },
    "kernel_live_class": {
      "enum": [
        "ready_live",
        "busy_live",
        "queued_live",
        "no_kernel_editable",
        "disconnected_recoverable",
        "inspect_only"
      ]
    },
    "deep_link_kind": {
      "enum": [
        "notebook_location",
        "kernel_manager",
        "docs_anchor",
        "support_bundle",
        "no_deep_link"
      ]
    },
    "header_action": {
      "enum": [
        "open_document",
        "export_document",
        "review_document",
        "copy_document_path",
        "open_deep_link",
        "inspect_source"
      ]
    },
    "strip_action": {
      "enum": [
        "select_kernel",
        "inspect_kernel",
        "continue_without_kernel",
        "reconnect_kernel",
        "restart_kernel",
        "open_deep_link"
      ]
    },
    "disposition": {
      "enum": [
        "no_kernel",
        "queued",
        "busy",
        "ready",
        "disconnected",
        "managed",
        "remote",
        "stale_output",
        "sanitized",
        "active",
        "reconnect",
        "restart_clean",
        "choose_another_kernel"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "kernel_origin_and_class",
        "output_trust_and_freshness",
        "restart_and_recovery"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook_surface",
        "kernel_manager_surface",
        "output_viewer_surface",
        "debug_surface",
        "review_surface",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "notebook_ui",
        "kernel_manager_ui",
        "output_viewer_ui",
        "debugger_ui",
        "ai_context_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "kernel_origin_unstated",
        "kernel_class_collapsed",
        "document_identity_unstated",
        "output_trust_unstated",
        "stale_output_shown_as_live",
        "trust_class_hover_only",
        "provenance_severed",
        "restart_consequence_implied_rerun",
        "recovery_overclaimed",
        "reconnect_shown_as_fresh",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "notebook_document_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "header_id",
        "header_label",
        "source_class",
        "identity_state",
        "origin_class",
        "claims_canonical_source",
        "imported_note",
        "scratch_note",
        "unknown_source_note",
        "unsaved_note",
        "conflict_note",
        "readonly_note",
        "recovered_note",
        "notebook_identity_label",
        "export_state_label",
        "target_context_label",
        "source_of_truth_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "header_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "pretends_kernel_free_is_live",
        "collapses_kernel_origins_into_one_badge",
        "conflates_document_and_runtime_truth",
        "hides_state_behind_hover_only"
      ],
      "properties": {
        "component": { "const": "notebook_document_header" },
        "header_id": { "$ref": "#/$defs/non_empty_string" },
        "header_label": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/document_source_class" },
        "identity_state": { "$ref": "#/$defs/document_identity_state" },
        "origin_class": { "$ref": "#/$defs/document_origin_class" },
        "claims_canonical_source": { "type": "boolean" },
        "imported_note": { "type": "string" },
        "scratch_note": { "type": "string" },
        "unknown_source_note": { "type": "string" },
        "unsaved_note": { "type": "string" },
        "conflict_note": { "type": "string" },
        "readonly_note": { "type": "string" },
        "recovered_note": { "type": "string" },
        "notebook_identity_label": { "$ref": "#/$defs/non_empty_string" },
        "export_state_label": { "$ref": "#/$defs/non_empty_string" },
        "target_context_label": { "$ref": "#/$defs/non_empty_string" },
        "source_of_truth_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "header_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_document" } },
            { "contains": { "const": "export_document" } },
            { "contains": { "const": "review_document" } }
          ],
          "items": { "$ref": "#/$defs/header_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "pretends_kernel_free_is_live": { "const": false },
        "collapses_kernel_origins_into_one_badge": { "const": false },
        "conflates_document_and_runtime_truth": { "const": false },
        "hides_state_behind_hover_only": { "const": false }
      }
    },
    "kernel_state_strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "strip_id",
        "strip_label",
        "execution_state",
        "connection_state",
        "live_class",
        "claims_live",
        "no_kernel_note",
        "reconnect_note",
        "inspect_only_note",
        "kernel_origin_label",
        "kernel_state_summary",
        "execution_context_label",
        "kernel_free_edit_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "strip_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "pretends_kernel_free_is_live",
        "collapses_kernel_origins_into_one_badge",
        "conflates_document_and_runtime_truth",
        "hides_state_behind_hover_only"
      ],
      "properties": {
        "component": { "const": "kernel_state_strip" },
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "strip_label": { "$ref": "#/$defs/non_empty_string" },
        "execution_state": { "$ref": "#/$defs/kernel_execution_state" },
        "connection_state": { "$ref": "#/$defs/kernel_connection_state" },
        "live_class": { "$ref": "#/$defs/kernel_live_class" },
        "claims_live": { "type": "boolean" },
        "no_kernel_note": { "type": "string" },
        "reconnect_note": { "type": "string" },
        "inspect_only_note": { "type": "string" },
        "kernel_origin_label": { "$ref": "#/$defs/non_empty_string" },
        "kernel_state_summary": { "$ref": "#/$defs/non_empty_string" },
        "execution_context_label": { "$ref": "#/$defs/non_empty_string" },
        "kernel_free_edit_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "strip_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "select_kernel" } },
            { "contains": { "const": "inspect_kernel" } },
            { "contains": { "const": "continue_without_kernel" } }
          ],
          "items": { "$ref": "#/$defs/strip_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "pretends_kernel_free_is_live": { "const": false },
        "collapses_kernel_origins_into_one_badge": { "const": false },
        "conflates_document_and_runtime_truth": { "const": false },
        "hides_state_behind_hover_only": { "const": false }
      }
    },
    "notebook_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_shows_canonical_source",
        "header_shows_document_identity",
        "header_offers_open_export_review",
        "strip_shows_kernel_execution_state",
        "strip_shows_kernel_connection_state",
        "strip_offers_select_inspect_continue",
        "document_and_runtime_truth_distinct",
        "kernel_free_notebook_stays_editable",
        "kernel_free_never_shown_as_live",
        "no_kernel_origins_collapsed_into_one_badge",
        "source_and_kernel_state_derived_never_asserted",
        "every_next_step_names_stable_deep_link",
        "no_state_hidden_behind_hover_only",
        "header_and_strip_consistent_across_surfaces",
        "no_component_widens_export_scope_or_exposes_raw_by_default",
        "components_stable_across_deployment_lines",
        "copy_and_export_safe",
        "no_surface_invents_alternate_state_label",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notebook_edit_surface_reads_single_source",
        "kernel_manager_surface_reads_single_source",
        "document_truth_visible_before_run",
        "kernel_state_visible_before_trusting_output",
        "support_export_shows_component_truth",
        "help_docs_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
