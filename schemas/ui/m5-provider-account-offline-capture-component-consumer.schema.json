{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-provider-account-offline-capture-component-consumer.schema.json",
  "title": "Aureline M5 provider-account / offline-capture component consumers",
  "description": "Export-safe packet for the adoption lane over the frozen M5 provider-account / offline-capture component matrix. It binds one row per claimed M5 provider consumer — work-item detail, status-transition review, issue intake, Help / docs, the support / export desk, and the browser-handoff flow — to the five canonical component families (provider-account row, project/board mapping row, sync-behavior row, offline-capture row, privacy/redaction row), the one shared descriptor vocabulary (account state / destination mapping / queued-draft state / redaction posture), the parity-health modes, export caveats, claim-parity states, narrowing reasons, recovery actions, export fields, and non-visual accessibility routes. Each consumer points at the primitive's canonical schema and artifact rather than re-wording account, mapping, sync, queue, or redaction facts in local prose. A weakened parity-health mode (limited provider scope, a stale session, a policy-locked mapping, or a local-only packet) auto-narrows the claim and always discloses a self-contained banner naming the exact reason and recovery action. Cached or offline-captured state never masquerades as provider-committed state. Raw credentials, endpoints, tokens, and raw provider bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_work_item_status_transition_help_support_and_export_consumers_so_provider_account_and_offline_capture_components_keep_account_mapping_sync_and_redaction_language_aligned_across_claimed_m5_profiles"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "provider_account_consumer_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "provider_account_consumer_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "work_item_detail",
        "status_transition_review",
        "issue_intake",
        "docs_help",
        "support_export",
        "browser_handoff"
      ]
    },
    "component_family": {
      "enum": [
        "provider_account_row",
        "project_or_board_mapping_row",
        "sync_behavior_row",
        "offline_capture_row",
        "privacy_redaction_row"
      ]
    },
    "descriptor": {
      "enum": [
        "account_state",
        "destination_mapping",
        "queued_draft_state",
        "redaction_posture"
      ]
    },
    "parity_health": {
      "enum": [
        "full_parity",
        "scope_limited_narrowed",
        "session_stale_narrowed",
        "mapping_policy_locked_narrowed",
        "packet_local_only_narrowed"
      ]
    },
    "claim_parity_state": {
      "enum": ["claims_preserved", "claims_auto_narrowed"]
    },
    "narrowing_reason": {
      "enum": [
        "provider_scope_limited",
        "session_stale",
        "mapping_policy_locked",
        "packet_local_only"
      ]
    },
    "recovery_action": {
      "enum": [
        "reauthorize_for_full_scope",
        "refresh_stale_session",
        "request_mapping_policy_change_or_use_local",
        "publish_queued_packet_when_online"
      ]
    },
    "export_caveat": {
      "enum": [
        "scope_limited_read_only",
        "session_stale_cached_read",
        "mapping_policy_locked_no_publish",
        "packet_local_only_not_committed"
      ]
    },
    "resolved_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "canonical_schema_ref",
        "descriptor_families",
        "parity_health",
        "export_caveats",
        "claim_parity_state",
        "is_narrowed",
        "reflects_cached_or_offline_state",
        "asserts_provider_committed",
        "auto_narrow_banner"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health": { "$ref": "#/$defs/parity_health" },
        "export_caveats": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_state": { "$ref": "#/$defs/claim_parity_state" },
        "is_narrowed": { "type": "boolean" },
        "reflects_cached_or_offline_state": { "type": "boolean" },
        "asserts_provider_committed": { "type": "boolean" },
        "auto_narrow_banner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "recovery_action",
                "consumer",
                "component_family",
                "preserved_descriptors",
                "export_caveats",
                "headline"
              ],
              "properties": {
                "reason": { "$ref": "#/$defs/narrowing_reason" },
                "recovery_action": { "$ref": "#/$defs/recovery_action" },
                "consumer": { "$ref": "#/$defs/consumer" },
                "component_family": { "$ref": "#/$defs/component_family" },
                "preserved_descriptors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/descriptor" }
                },
                "export_caveats": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/export_caveat" }
                },
                "headline": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "$ref": "#/$defs/resolved_binding" }
      }
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "const": true },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "parity_health_modes",
        "export_caveats",
        "claim_parity_states",
        "narrowing_reasons",
        "recovery_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewords_claims_per_surface",
        "invents_new_provider_grammar",
        "drops_account_mapping_queue_or_redaction_when_narrowed",
        "shows_cached_or_offline_state_as_committed",
        "inherits_stronger_label_from_healthier_profile"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parity_health" }
        },
        "export_caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim_parity_state" }
        },
        "narrowing_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recovery_action" }
        },
        "export_fields": { "type": "array", "minItems": 5 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_binding" }
        },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rewords_claims_per_surface": { "const": false },
        "invents_new_provider_grammar": { "const": false },
        "drops_account_mapping_queue_or_redaction_when_narrowed": { "const": false },
        "shows_cached_or_offline_state_as_committed": { "const": false },
        "inherits_stronger_label_from_healthier_profile": { "const": false }
      }
    }
  }
}
