{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-learning-mode-toggle-tip-card-controls.schema.json",
  "title": "Aureline M5 learning-mode toggles and tip cards",
  "description": "Export-safe packet implementing the reusable M5 learning-mode-toggle and tip-card components in two co-equal control vectors. Each learning-mode toggle names its learning state, its user/workspace/feature-family scope, and its pause/snooze/reset actions; its activation class is derived from the learning-mode state, so a paused, ended, or off toggle can never read as active learning. Each tip card names why it is relevant now, stays optional and dismissible, and can be reopened from Help or the command system; its delivery class is derived from the dismissal state, so a dismissed, auto-expired, or suppressed tip can never read as delivered. Every next step names one stable command/file/docs deep link rather than an ephemeral coachmark or hidden route. No control masks privacy or offline/local-only state, hides activation or scope, implies a hidden apply or mutation, invents an alternate state label, or depends on hidden routing; raw docs bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "toggles",
    "tip_cards",
    "downgrade_triggers",
    "consumer_surfaces",
    "learnability_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_learning_mode_toggles_and_tip_cards_with_scope_pause_snooze_reset_why_now_context_and_command_file_docs_deep_link_truth_across_claimed_m5_onboarding_and_help_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "toggles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/learning_mode_toggle" }
    },
    "tip_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tip_card" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "learnability_review": { "$ref": "#/$defs/learnability_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "learning_state": {
      "enum": ["off", "on", "paused", "per_feature_family", "sandboxed_only", "ended"]
    },
    "learning_scope": {
      "enum": ["global", "workspace", "feature_family", "session", "surface", "unavailable"]
    },
    "activation_class": {
      "enum": ["active", "scoped_active", "sandboxed_active", "paused", "inactive"]
    },
    "trigger_class": {
      "enum": [
        "first_encounter",
        "feature_discovery",
        "error_recovery",
        "mode_change",
        "idle_hint",
        "contextual_followup"
      ]
    },
    "dismissal_state": {
      "enum": [
        "dismissible",
        "dismissed",
        "snoozed",
        "persistent_until_acted",
        "auto_expired",
        "suppressed_by_preference"
      ]
    },
    "delivery_class": {
      "enum": ["delivered", "delivered_persistent", "snoozed", "withheld"]
    },
    "deep_link_kind": {
      "enum": ["command_reference", "file_location", "docs_anchor", "help_topic", "no_deep_link"]
    },
    "toggle_action": {
      "enum": [
        "enable_learning",
        "pause_learning",
        "snooze_learning",
        "reset_learning",
        "change_scope",
        "open_deep_link"
      ]
    },
    "tip_action": {
      "enum": [
        "try_next_action",
        "open_deep_link",
        "snooze_tip",
        "dismiss_tip",
        "reopen_from_help",
        "open_command_reference"
      ]
    },
    "disposition": {
      "enum": [
        "learning_on",
        "paused",
        "replayable",
        "sandboxed",
        "cached",
        "local_only",
        "not_installed",
        "no_hidden_apply"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "citation_source",
        "explain_versus_do_boundary",
        "progress_ownership_and_privacy"
      ]
    },
    "surface_family": {
      "enum": [
        "first_run_onboarding",
        "guided_tour",
        "learning_mode_panel",
        "glossary_surface",
        "inline_help",
        "cli_help"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "onboarding_ui",
        "tour_overlay_ui",
        "learning_panel_ui",
        "glossary_ui",
        "exercise_ui",
        "help_panel_ui",
        "cli_help",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "learning_mode_state_unstated",
        "tip_command_binding_unstated",
        "exercise_step_state_unstated",
        "glossary_citation_severed",
        "explanation_apply_boundary_unstated",
        "progress_ownership_unstated",
        "offline_or_local_only_state_hidden",
        "sandbox_boundary_unstated",
        "cached_state_hidden",
        "not_installed_state_hidden",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "learning_mode_toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "toggle_id",
        "toggle_label",
        "learning_state",
        "scope",
        "scope_label",
        "activation_class",
        "claims_active",
        "paused_note",
        "sandboxed_note",
        "inactive_note",
        "scope_and_activation_note",
        "why_now_context",
        "deep_link_kind",
        "deep_link_ref",
        "toggle_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_privacy_or_offline_state",
        "hides_activation_or_scope",
        "implies_hidden_apply_or_mutation",
        "invents_alternate_state_label",
        "depends_on_ephemeral_coachmark_or_hidden_routing"
      ],
      "properties": {
        "component": { "const": "learning_mode_toggle" },
        "toggle_id": { "$ref": "#/$defs/non_empty_string" },
        "toggle_label": { "$ref": "#/$defs/non_empty_string" },
        "learning_state": { "$ref": "#/$defs/learning_state" },
        "scope": { "$ref": "#/$defs/learning_scope" },
        "scope_label": { "$ref": "#/$defs/non_empty_string" },
        "activation_class": { "$ref": "#/$defs/activation_class" },
        "claims_active": { "type": "boolean" },
        "paused_note": { "type": "string" },
        "sandboxed_note": { "type": "string" },
        "inactive_note": { "type": "string" },
        "scope_and_activation_note": { "$ref": "#/$defs/non_empty_string" },
        "why_now_context": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "toggle_actions": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "reset_learning" },
          "items": { "$ref": "#/$defs/toggle_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_privacy_or_offline_state": { "const": false },
        "hides_activation_or_scope": { "const": false },
        "implies_hidden_apply_or_mutation": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "depends_on_ephemeral_coachmark_or_hidden_routing": { "const": false }
      }
    },
    "tip_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "tip_id",
        "tip_label",
        "trigger_class",
        "dismissal_state",
        "delivery_class",
        "claims_delivered",
        "snoozed_note",
        "withheld_note",
        "why_now_context",
        "deep_link_kind",
        "deep_link_ref",
        "tip_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_privacy_or_offline_state",
        "hides_activation_or_scope",
        "implies_hidden_apply_or_mutation",
        "invents_alternate_state_label",
        "depends_on_ephemeral_coachmark_or_hidden_routing"
      ],
      "properties": {
        "component": { "const": "tip_card" },
        "tip_id": { "$ref": "#/$defs/non_empty_string" },
        "tip_label": { "$ref": "#/$defs/non_empty_string" },
        "trigger_class": { "$ref": "#/$defs/trigger_class" },
        "dismissal_state": { "$ref": "#/$defs/dismissal_state" },
        "delivery_class": { "$ref": "#/$defs/delivery_class" },
        "claims_delivered": { "type": "boolean" },
        "snoozed_note": { "type": "string" },
        "withheld_note": { "type": "string" },
        "why_now_context": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "tip_actions": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "dismiss_tip" },
          "items": { "$ref": "#/$defs/tip_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_privacy_or_offline_state": { "const": false },
        "hides_activation_or_scope": { "const": false },
        "implies_hidden_apply_or_mutation": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "depends_on_ephemeral_coachmark_or_hidden_routing": { "const": false }
      }
    },
    "learnability_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toggle_shows_activation",
        "toggle_shows_scope",
        "toggle_offers_pause_snooze_reset",
        "tip_shows_why_now_context",
        "tip_stays_optional_and_dismissible",
        "tip_reopenable_from_help_or_commands",
        "activation_and_delivery_derived_never_asserted",
        "inactive_never_shown_as_active",
        "withheld_never_shown_as_delivered",
        "every_next_step_names_stable_deep_link",
        "no_control_depends_on_ephemeral_coachmark_or_hidden_routing",
        "no_control_widens_trust_or_mutating_authority",
        "progress_user_owned_and_default_local",
        "cached_offline_local_only_state_visible",
        "no_surface_invents_alternate_state_label",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_mode_panel_reads_single_source",
        "onboarding_tip_surface_reads_single_source",
        "activation_and_scope_visible_before_tap",
        "why_now_context_visible_before_tap",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
