{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-intake-escalation-component-certification.schema.json",
  "title": "Aureline M5 support-intake / escalation component surface certification packet",
  "description": "M05-907 closing surface-certification capstone over the frozen M5 support-intake / escalation component matrix. Certifies that the shared support-scenario-picker-row, issue-report-builder-step, escalation-packet-summary, handoff-timeline-row, and unsafe-fix-blocked-note truth holds on every claimed M5 supportability surface, auto-narrowing any surface that cannot sustain it. Metadata-only: typed class tokens, opaque refs, booleans, and redacted labels; never raw logs, report bodies, redacted evidence contents, or credential-bearing material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_support_intake_escalation_component_certification_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "support_claim": {
      "type": "string",
      "enum": [
        "ready_to_escalate",
        "reviewable_case",
        "local_only_diagnosis",
        "evidence_incomplete_case",
        "unclassified_scenario",
        "policy_blocked_repair"
      ]
    },
    "certified_surface": {
      "type": "string",
      "enum": [
        "doctor_results",
        "safe_mode",
        "extension_bisect",
        "support_center",
        "docs_help",
        "support_bundle_preview",
        "cli_headless",
        "support_export"
      ]
    },
    "certification_axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "support_intake_and_escalation_provenance"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "surface_status": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "scenario_or_scope_unstated",
        "doctor_finding_lineage_unstated",
        "evidence_class_masked",
        "redaction_state_undisclosed",
        "packet_destination_unstated",
        "next_human_step_unstated",
        "approved_repair_class_masked",
        "unsafe_fix_block_reason_hidden",
        "case_disposition_unstated",
        "handoff_stage_collapsed",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "component_family": {
      "type": "string",
      "enum": [
        "support_scenario_picker_row",
        "issue_report_builder_step",
        "escalation_packet_summary",
        "handoff_timeline_row",
        "unsafe_fix_blocked_note"
      ]
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_axis",
        "from_claim",
        "to_claim",
        "visible_label",
        "preserves_lineage_continuity"
      ],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/support_claim" },
        "to_claim": { "$ref": "#/$defs/support_claim" },
        "visible_label": { "type": "string", "minLength": 1 },
        "preserves_lineage_continuity": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "lineage_preserved",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_support_intake_escalation_component_certification_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/certified_surface" },
        "claimed_claim": { "$ref": "#/$defs/support_claim" },
        "certified_claim": { "$ref": "#/$defs/support_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "lineage_preserved": { "type": "boolean" },
        "canonical_bundle_ref": { "type": "string", "minLength": 1 },
        "derived_status": { "$ref": "#/$defs/surface_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "every_axis_covered_on_every_row",
        "all_lineage_preserved",
        "narrowed_surface_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "all_lineage_preserved": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
