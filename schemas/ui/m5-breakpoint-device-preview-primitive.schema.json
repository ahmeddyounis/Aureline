{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-breakpoint-device-preview-primitive.schema.json",
  "title": "Aureline M5 breakpoint / device-preview row primitive: device preview row, live-versus-mock runtime-truth cue, and compare / open-source continuity",
  "description": "Export-safe packet implementing Aureline's one reusable breakpoint / device-preview row primitive across every claimed M5 visual-design surface — desktop designer, source-first preview, browser-runtime inspector, framework-pack preview, embedded shell designer, and support-export replay. Each surface row binds the shared device-row / runtime-truth-cue / continuity contract and carries worked resolution cases: a resolver input (a target's device / viewport class, active breakpoint, theme / state variant, data posture, runtime origin, freshness, source-mapping quality, source-sync class, and optional source span) and the resolved device preview row, runtime-truth cue, and continuity block, which share one target identity so a user never loses their place moving across device targets, variants, or runtime origins. A preview can never hide whether it is showing live runtime data, mock data, or a stale / captured view: every resolved preview carries an explicit runtime-truth cue naming the data posture, the runtime origin, and the freshness, and its live / stale flags are consistent with them. Device / breakpoint switching stays source-anchored and reviewable: a source-mapped preview keeps its source anchor and offers an open-source action, and the target identity survives across the row, the cue, and the actions. Every degrade below a live, fresh, source-anchored view carries a typed downgrade trigger from the shared vocabulary rather than a feature-local label. The stored resolution must equal a fresh resolve of its input. Hard invariants forbid blurring live-versus-mock data, hiding a stale or captured view, dropping the source anchor silently, and inventing a feature-local preview label. The device-preview class, data posture, mapping quality, preview freshness, source-sync class, downgrade triggers, preview surface, and visual-design surface families are reused verbatim from the frozen M5 visual-designer component matrix and the sibling primitives. Raw source bodies, screenshots, runtime payloads, credentials, and raw URLs never cross this boundary. The Rust validator and resolver in crates/aureline-preview are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_breakpoint_and_device_preview_row_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "surface_family": {
      "type": "string",
      "enum": [
        "desktop_designer",
        "source_first_preview",
        "browser_runtime_inspector",
        "framework_pack_preview",
        "embedded_shell_designer",
        "support_export_replay"
      ]
    },
    "preview_surface": {
      "type": "string",
      "enum": [
        "source_first_framework_preview",
        "visual_surface_mapping",
        "browser_runtime_inspection",
        "device_or_simulator_preview",
        "full_stack_preview_loop",
        "embedded_webview_preview",
        "visual_edit_transform",
        "support_export_projection"
      ]
    },
    "device_class": {
      "type": "string",
      "enum": [
        "desktop_viewport",
        "tablet_viewport",
        "mobile_viewport",
        "custom_viewport",
        "device_tethered",
        "simulator_preview"
      ]
    },
    "data_posture": {
      "type": "string",
      "enum": ["live", "mock", "captured"]
    },
    "runtime_origin": {
      "type": "string",
      "enum": [
        "live_dev_runtime",
        "local_mock_runtime",
        "captured_snapshot",
        "tethered_device",
        "simulator_runtime"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["fresh", "aging", "stale", "unknown"]
    },
    "mapping_quality": {
      "type": "string",
      "enum": ["exact", "approximate", "unmapped"]
    },
    "sync_class": {
      "type": "string",
      "enum": [
        "in_sync_from_source",
        "pending_rebuild",
        "drifted_from_source",
        "runtime_only_no_source",
        "unidentified_source_sync"
      ]
    },
    "continuity_action": {
      "type": "string",
      "enum": [
        "compare_across_targets",
        "open_source_for_breakpoint",
        "reattach_runtime",
        "pin_capture",
        "inspect_only"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "drifted_from_source",
        "unmapped_source",
        "runtime_unavailable",
        "protected_path_blocked",
        "unsupported_construct",
        "round_trip_conflict_open",
        "unidentified_posture"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "target_id",
        "device_class",
        "data_posture",
        "runtime_origin",
        "freshness",
        "mapping_quality"
      ]
    },
    "preview_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "node_label",
        "viewport_label",
        "active_breakpoint_token",
        "theme_variant_token",
        "state_variant_token",
        "device_class",
        "data_posture",
        "runtime_origin",
        "freshness",
        "mapping_quality",
        "sync_class"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
        "viewport_label": { "$ref": "#/$defs/non_empty_string" },
        "active_breakpoint_token": { "$ref": "#/$defs/non_empty_string" },
        "theme_variant_token": { "$ref": "#/$defs/non_empty_string" },
        "state_variant_token": { "$ref": "#/$defs/non_empty_string" },
        "device_class": { "$ref": "#/$defs/device_class" },
        "data_posture": { "$ref": "#/$defs/data_posture" },
        "runtime_origin": { "$ref": "#/$defs/runtime_origin" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "mapping_quality": { "$ref": "#/$defs/mapping_quality" },
        "sync_class": { "$ref": "#/$defs/sync_class" },
        "source_span_ref": { "type": "string" }
      }
    },
    "resolved_device_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "node_label",
        "viewport_label",
        "active_breakpoint_token",
        "theme_variant_token",
        "state_variant_token",
        "device_class",
        "data_posture",
        "mapping_quality",
        "runtime_origin",
        "live_vs_mock_label",
        "row_label"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
        "viewport_label": { "$ref": "#/$defs/non_empty_string" },
        "active_breakpoint_token": { "$ref": "#/$defs/non_empty_string" },
        "theme_variant_token": { "$ref": "#/$defs/non_empty_string" },
        "state_variant_token": { "$ref": "#/$defs/non_empty_string" },
        "device_class": { "$ref": "#/$defs/device_class" },
        "data_posture": { "$ref": "#/$defs/data_posture" },
        "mapping_quality": { "$ref": "#/$defs/mapping_quality" },
        "runtime_origin": { "$ref": "#/$defs/runtime_origin" },
        "live_vs_mock_label": { "$ref": "#/$defs/non_empty_string" },
        "row_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "resolved_runtime_truth_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "data_posture",
        "runtime_origin",
        "freshness",
        "is_live_data",
        "is_stale",
        "truth_label"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "data_posture": { "$ref": "#/$defs/data_posture" },
        "runtime_origin": { "$ref": "#/$defs/runtime_origin" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "is_live_data": { "type": "boolean" },
        "is_stale": { "type": "boolean" },
        "truth_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "resolved_continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "actions",
        "compare_action_available",
        "open_source_action_available",
        "source_anchored",
        "preserves_selection_context"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/continuity_action" }
        },
        "compare_action_available": { "const": true },
        "open_source_action_available": { "type": "boolean" },
        "source_anchored": { "type": "boolean" },
        "preserves_selection_context": { "const": true }
      }
    },
    "resolved_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "node_label",
        "device_class",
        "data_posture",
        "runtime_origin",
        "freshness",
        "mapping_quality",
        "sync_class",
        "device_row",
        "runtime_truth",
        "continuity",
        "no_hidden_runtime_truth"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
        "device_class": { "$ref": "#/$defs/device_class" },
        "data_posture": { "$ref": "#/$defs/data_posture" },
        "runtime_origin": { "$ref": "#/$defs/runtime_origin" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "mapping_quality": { "$ref": "#/$defs/mapping_quality" },
        "sync_class": { "$ref": "#/$defs/sync_class" },
        "device_row": { "$ref": "#/$defs/resolved_device_row" },
        "runtime_truth": { "$ref": "#/$defs/resolved_runtime_truth_cue" },
        "continuity": { "$ref": "#/$defs/resolved_continuity" },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "no_hidden_runtime_truth": { "const": true }
      }
    },
    "preview_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/preview_input" },
        "resolved": { "$ref": "#/$defs/resolved_preview" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "preview_surface",
        "owner_role",
        "scope_summary",
        "device_classes",
        "data_postures",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_previews",
        "blurs_live_vs_mock",
        "hides_stale_or_captured",
        "drops_source_anchor_silently",
        "invents_local_preview_labels"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "preview_surface": { "$ref": "#/$defs/preview_surface" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "device_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/device_class" }
        },
        "data_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/data_posture" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "example_previews": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/preview_case" }
        },
        "blurs_live_vs_mock": { "const": false },
        "hides_stale_or_captured": { "const": false },
        "drops_source_anchor_silently": { "const": false },
        "invents_local_preview_labels": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "device_classes",
        "data_postures",
        "runtime_origins",
        "freshness_classes",
        "mapping_qualities",
        "sync_classes",
        "continuity_actions",
        "downgrade_triggers",
        "export_fields"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "$ref": "#/$defs/surface_family" } },
        "device_classes": { "type": "array", "items": { "$ref": "#/$defs/device_class" } },
        "data_postures": { "type": "array", "items": { "$ref": "#/$defs/data_posture" } },
        "runtime_origins": { "type": "array", "items": { "$ref": "#/$defs/runtime_origin" } },
        "freshness_classes": { "type": "array", "items": { "$ref": "#/$defs/freshness" } },
        "mapping_qualities": { "type": "array", "items": { "$ref": "#/$defs/mapping_quality" } },
        "sync_classes": { "type": "array", "items": { "$ref": "#/$defs/sync_class" } },
        "continuity_actions": { "type": "array", "items": { "$ref": "#/$defs/continuity_action" } },
        "downgrade_triggers": { "type": "array", "items": { "$ref": "#/$defs/downgrade_trigger" } },
        "export_fields": { "type": "array", "items": { "$ref": "#/$defs/export_field" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_row_cue_continuity",
        "live_mock_captured_always_disclosed",
        "switching_stays_source_anchored",
        "selection_continuity_preserved_across_targets",
        "degrade_explained_in_support_export",
        "no_surface_invents_second_preview_grammar",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_row_cue_continuity": { "const": true },
        "live_mock_captured_always_disclosed": { "const": true },
        "switching_stays_source_anchored": { "const": true },
        "selection_continuity_preserved_across_targets": { "const": true },
        "degrade_explained_in_support_export": { "const": true },
        "no_surface_invents_second_preview_grammar": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_consumers_use_shared_primitive",
        "resolver_reads_single_preview_model",
        "cue_reads_single_runtime_truth_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "preview_consumers_use_shared_primitive": { "const": true },
        "resolver_reads_single_preview_model": { "const": true },
        "cue_reads_single_runtime_truth_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "preview_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "preview_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
