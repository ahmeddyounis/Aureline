{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-marketplace-install-component-matrix.schema.json",
  "title": "Aureline M5 marketplace-result-row, marketplace-detail-fact-grid, compatibility-label-strip, permission-manifest-summary, activation-budget-band, install/update/disable/rollback review-sheet, publisher-continuity-row, and installed-state-diagnostics-card component matrix",
  "description": "Export-safe packet freezing Aureline's reusable extension-marketplace and install-review UI components. The packet names every marketplace or registry surface M5 claims that still ships its own listing, detail, compatibility, permission, budget, install, publisher, or diagnostics chrome \u2014 marketplace result rows, marketplace detail fact grids, compatibility-label strips, permission-manifest summaries, activation-budget bands, install/update/disable/rollback review sheets, publisher-continuity rows, and installed-state diagnostics cards \u2014 and binds each to the claimed M5 surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: the single controlled marketplace/install-disposition vocabulary consumers bind to (public, mirrored, enterprise, side_load, verified, transferred, deprecated, limited, incompatible, over_budget, throttled, quarantined, disable_scope, rollback_compatibility), plus family-specific registry source classes, compatibility states, host/runtime models, permission postures, activation-budget bands, publisher-continuity states, disable-scope classes, rollback-compatibility states, and quarantine states. Hard invariants forbid hiding permission widening or activation cost, hiding a publisher transfer or disable scope or rollback incompatibility, collapsing the registry source class across public/mirrored/enterprise, and presenting an incompatible or over-budget artifact as ready. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_marketplace_result_row_marketplace_detail_fact_grid_compatibility_label_strip_permission_manifest_summary_activation_budget_band_install_update_disable_rollback_review_sheet_publisher_continuity_row_and_installed_state_diagnostics_card_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "component_family": {
      "enum": [
        "marketplace_result_row",
        "marketplace_detail_fact_grid",
        "compatibility_label_strip",
        "permission_manifest_summary",
        "activation_budget_band",
        "install_update_disable_rollback_review_sheet",
        "publisher_continuity_row",
        "installed_state_diagnostics_card"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "public",
        "mirrored",
        "enterprise",
        "side_load",
        "verified",
        "transferred",
        "deprecated",
        "limited",
        "incompatible",
        "over_budget",
        "throttled",
        "quarantined",
        "disable_scope",
        "rollback_compatibility"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_permission_widening_or_activation_cost",
        "hides_publisher_transfer_disable_scope_or_rollback_incompatibility",
        "collapses_registry_source_class_across_public_mirrored_enterprise",
        "presents_incompatible_or_over_budget_as_ready"
      ],
      "properties": {
        "component_family": {
          "$ref": "#/$defs/component_family"
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "public",
              "mirrored",
              "enterprise",
              "side_load",
              "verified",
              "transferred",
              "deprecated",
              "limited",
              "incompatible",
              "over_budget",
              "throttled",
              "quarantined",
              "disable_scope",
              "rollback_compatibility"
            ]
          }
        },
        "registry_source_classes": {
          "type": "array"
        },
        "compatibility_states": {
          "type": "array"
        },
        "host_runtime_models": {
          "type": "array"
        },
        "permission_postures": {
          "type": "array"
        },
        "activation_budget_bands": {
          "type": "array"
        },
        "publisher_continuity_states": {
          "type": "array"
        },
        "disable_scope_classes": {
          "type": "array"
        },
        "rollback_compatibility_states": {
          "type": "array"
        },
        "quarantine_states": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "hides_permission_widening_or_activation_cost": {
          "const": false
        },
        "hides_publisher_transfer_disable_scope_or_rollback_incompatibility": {
          "const": false
        },
        "collapses_registry_source_class_across_public_mirrored_enterprise": {
          "const": false
        },
        "presents_incompatible_or_over_budget_as_ready": {
          "const": false
        }
      }
    }
  }
}
