{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-deployment-summary-card.schema.json",
  "title": "Aureline M5 deployment-summary card",
  "description": "Stable UI contract for an M5 deployment-summary card. The card names deployment scope, operating mode, tenant or org ref, region ref, mirror/offline posture, and both plane states so self-hosted, sovereign, managed, and local-only surfaces do not overclaim their boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "deployment_scope",
    "operating_mode",
    "tenant_org_ref",
    "region_ref",
    "mirror_offline_posture",
    "control_plane_visible",
    "data_plane_visible",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_deployment_summary_card" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "deployment_scope": {
      "enum": ["shared_managed", "dedicated_managed", "self_hosted", "sovereign", "local_only"]
    },
    "operating_mode": { "$ref": "#/$defs/deployment_mode" },
    "tenant_org_ref": { "$ref": "#/$defs/ref" },
    "region_ref": { "$ref": "#/$defs/ref" },
    "mirror_offline_posture": { "$ref": "#/$defs/truth_mode" },
    "control_plane_visible": { "const": true },
    "data_plane_visible": { "const": true },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "deployment_mode": {
      "enum": ["desktop", "managed", "self_hosted", "portable", "air_gapped"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_reported"]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": {
          "enum": ["control_plane_impaired", "mirror_stale", "offline_cache_only", "residual_vendor_dependency", "provenance_incomplete"]
        },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
