{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-efficiency-component-matrix.schema.json",
  "title": "Aureline M5 power-state-indicator, throttled-subsystem-row, background-work-row, background-work-banner, per-workspace-override-sheet, override-policy-note-row, resume-summary-card, and stale-result-continuity-note component matrix",
  "description": "Export-safe packet freezing Aureline's reusable adaptive-efficiency UI components. The packet names every efficiency-surface component family M5 claims that still drifts too easily by surface — power-state indicators, throttled-subsystem rows, background-work rows and banners, per-workspace override sheets, override-policy note rows, resume-summary cards, and stale-result continuity notes — and binds each to the claimed M5 surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: the single controlled work-disposition vocabulary consumers bind to (running_full, slowed, paused, policy_blocked, override_available, override_blocked, resuming, stale_result_shown, not_evaluated), plus family-specific pressure sources, active efficiency states, affected workloads, override postures, policy owners, recovery states, and stale-result states, all bound from the frozen efficiency-state governance object model. Hard invariants forbid collapsing distinct pressure sources into one generic warning, hiding paused work behind toast-only messaging, presenting an override as available when policy blocks it, and clearing stale-result context merely because background work resumed. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_power_state_indicator_throttled_subsystem_row_background_work_row_background_work_banner_per_workspace_override_sheet_override_policy_note_row_resume_summary_card_and_stale_result_continuity_note_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "efficiency_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "efficiency_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "power_state_indicator",
        "throttled_subsystem_row",
        "background_work_row",
        "background_work_banner",
        "per_workspace_override_sheet",
        "override_policy_note_row",
        "resume_summary_card",
        "stale_result_continuity_note"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "work_disposition": {
      "enum": [
        "running_full",
        "slowed",
        "paused",
        "policy_blocked",
        "override_available",
        "override_blocked",
        "resuming",
        "stale_result_shown",
        "not_evaluated"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "work_dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_pressure_sources_into_generic_warning",
        "hides_paused_work_behind_toast_only",
        "presents_override_available_when_policy_blocks",
        "clears_stale_context_on_resume"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "work_dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/work_disposition" }
        },
        "pressure_sources": { "type": "array" },
        "efficiency_states": { "type": "array" },
        "affected_workloads": { "type": "array" },
        "override_postures": { "type": "array" },
        "policy_owners": { "type": "array" },
        "recovery_states": { "type": "array" },
        "stale_result_states": { "type": "array" },
        "degraded_reasons": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_pressure_sources_into_generic_warning": { "const": false },
        "hides_paused_work_behind_toast_only": { "const": false },
        "presents_override_available_when_policy_blocks": { "const": false },
        "clears_stale_context_on_resume": { "const": false }
      }
    }
  }
}
