{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-watch-mode-banner.schema.json",
  "title": "Aureline M5 watch-mode-banner resolution case",
  "description": "Companion schema for the M5 watch-mode-banner half of the session-summary-bar / watch-mode-banner twin primitive. It describes one worked watch-banner resolution case: an input watch state and its resolved truth. The resolved truth carries the frozen controlled watch-fidelity vocabulary (live/reduced/polling/reconnecting/paused/unavailable) as its derived watch posture, whether the watch is degraded, whether it explains why fidelity dropped, the preserved last successful cycle time, and the bounded reveal/recover/pause/export actions. A degraded watch always carries a degrade reason. The canonical packet schema that embeds these cases is m5-test-session-summary-bar.schema.json. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "resolved"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "watch_fidelity",
        "last_successful_cycle",
        "backlog_count",
        "watch_label",
        "watch_identity_ref"
      ],
      "properties": {
        "watch_fidelity": { "$ref": "#/$defs/watch_fidelity" },
        "degrade_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/degrade_reason" }]
        },
        "last_successful_cycle": { "type": "string", "minLength": 1 },
        "backlog_count": { "type": "integer", "minimum": 0 },
        "watch_label": { "type": "string", "minLength": 1 },
        "watch_identity_ref": { "type": "string", "minLength": 1 }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "watch_fidelity",
        "last_successful_cycle",
        "backlog_count",
        "watch_label",
        "watch_identity_ref",
        "watch_posture",
        "available_actions",
        "is_degraded",
        "can_recover",
        "can_pause",
        "explains_degradation",
        "preserves_last_successful_cycle",
        "needs_attention"
      ],
      "properties": {
        "watch_fidelity": { "$ref": "#/$defs/watch_fidelity" },
        "degrade_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/degrade_reason" }]
        },
        "last_successful_cycle": { "type": "string", "minLength": 1 },
        "backlog_count": { "type": "integer", "minimum": 0 },
        "watch_label": { "type": "string", "minLength": 1 },
        "watch_identity_ref": { "type": "string", "minLength": 1 },
        "watch_posture": {
          "enum": [
            "live_watch",
            "reduced_watch",
            "polling_watch",
            "reconnecting_watch",
            "paused_watch",
            "unavailable_watch"
          ]
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reveal_watch_details",
              "recover_watch",
              "pause_watch",
              "export_watch_state"
            ]
          }
        },
        "is_degraded": { "type": "boolean" },
        "can_recover": { "type": "boolean" },
        "can_pause": { "type": "boolean" },
        "explains_degradation": { "type": "boolean" },
        "preserves_last_successful_cycle": { "const": true },
        "needs_attention": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "watch_fidelity": {
      "enum": [
        "live",
        "reduced",
        "polling",
        "unavailable",
        "paused",
        "reconnecting"
      ]
    },
    "degrade_reason": {
      "enum": [
        "resource_pressure",
        "adapter_limited",
        "offline_host",
        "file_watch_lost",
        "too_many_files",
        "policy_limited"
      ]
    }
  }
}
