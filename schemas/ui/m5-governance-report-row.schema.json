{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-governance-report-row.schema.json",
  "title": "Aureline M5 governance report row",
  "description": "Export-safe shape for a single M5 governance report row instance. The component carries the frozen governance readiness-state vocabulary shared across the M5 governance-dashboard component matrix plus its own family-specific vocabulary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape. Raw URLs, raw tokens, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "qualification",
    "identity",
    "readiness_state",
    "evidence_freshness",
    "keyboard_route",
    "report_scope"
  ],
  "properties": {
    "component_family": {
      "const": "governance_report_row"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "identity": {
      "$ref": "#/$defs/non_empty_string"
    },
    "readiness_state": {
      "$ref": "#/$defs/readiness_state"
    },
    "evidence_freshness": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route": {
      "$ref": "#/$defs/non_empty_string"
    },
    "report_scope": {
      "$ref": "#/$defs/report_scope"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "readiness_state": {
      "enum": [
        "passing",
        "warning",
        "blocked",
        "waived",
        "expired_waiver",
        "evidence_stale",
        "owner_unresolved",
        "forum_unresolved",
        "not_evaluated"
      ]
    },
    "report_scope": {
      "enum": [
        "service_scope",
        "family_scope",
        "train_scope",
        "fleet_scope",
        "waiver_ledger_scope"
      ]
    }
  }
}
