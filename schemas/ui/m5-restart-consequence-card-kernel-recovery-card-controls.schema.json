{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-restart-consequence-card-kernel-recovery-card-controls.schema.json",
  "title": "Aureline M5 restart consequence cards and kernel recovery cards",
  "description": "Export-safe packet implementing the reusable M5 restart-consequence-card and kernel-recovery-card components in two co-equal control vectors. Each restart consequence card names a restart/interrupt/shutdown action, what state it preserves (notebook source, prior outputs) and loses (live variables, debugger frames, session), and whether a rerun is required before restart; its impact class is derived from the restart consequence state and its scope from the restart action, so a restart that loses live state can never read as one that preserved it, and a card may claim state was preserved only when the impact preserves it. Each kernel recovery card names where a kernel's recovery stands and offers reconnect/restart-clean/choose-another-kernel/open-inspect-only/export-evidence recovery; its posture is derived from the recovery state and its continuity from the recovery action, so a kernel that still needs a restart or has no kernel available can never read as recovered, and a card may claim the kernel recovered only when its state is recovered. Every card carries a no-hidden-rerun note so a recovery never implies that code or cells were silently executed during restore or repair. Every next step names one stable notebook/kernel-manager/docs/support deep link rather than an ephemeral overlay or hidden route. No component implies a rerun on restore or recovery, presents lost state as preserved, hides a consequence behind a hover-only affordance, or collapses recovery into a generic notebook error; raw notebook payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "restart_consequence_cards",
    "kernel_recovery_cards",
    "downgrade_triggers",
    "consumer_surfaces",
    "restart_recovery_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_restart_consequence_cards_and_kernel_recovery_cards_with_preserved_state_lost_state_reconnect_restart_clean_choose_another_kernel_actions_and_no_hidden_rerun_truth_across_claimed_m5_notebook_restore_and_failure_flows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "restart_consequence_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/restart_consequence_card" }
    },
    "kernel_recovery_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kernel_recovery_card" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "restart_recovery_review": { "$ref": "#/$defs/restart_recovery_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "restart_action_class": {
      "enum": [
        "restart_kernel",
        "restart_and_run_all",
        "interrupt_kernel",
        "shutdown_kernel",
        "reconnect_kernel",
        "clear_outputs"
      ]
    },
    "restart_consequence_state": {
      "enum": [
        "state_preserved",
        "state_lost",
        "variables_cleared",
        "outputs_retained",
        "outputs_cleared",
        "no_consequence"
      ]
    },
    "restart_impact_class": {
      "enum": [
        "state_preserved_impact",
        "live_state_lost_impact",
        "variables_cleared_impact",
        "outputs_retained_impact",
        "outputs_cleared_impact",
        "no_restart_impact"
      ]
    },
    "restart_action_scope": {
      "enum": ["ends_session", "keeps_session", "outputs_only"]
    },
    "kernel_recovery_action_class": {
      "enum": [
        "reconnect",
        "restart_clean",
        "choose_another_kernel",
        "reattach_session",
        "start_local_fallback",
        "wait_for_managed"
      ]
    },
    "kernel_recovery_state": {
      "enum": [
        "recoverable",
        "reconnect_available",
        "restart_required",
        "no_kernel_available",
        "recovery_blocked",
        "recovered"
      ]
    },
    "kernel_recovery_posture": {
      "enum": [
        "recoverable_now",
        "reconnect_offered",
        "restart_needed",
        "no_kernel_available",
        "recovery_blocked",
        "recovered_clean"
      ]
    },
    "recovery_continuity_class": {
      "enum": ["continues_session", "clean_session", "awaits_managed"]
    },
    "deep_link_kind": {
      "enum": [
        "notebook_location",
        "kernel_manager",
        "docs_anchor",
        "support_bundle",
        "no_deep_link"
      ]
    },
    "restart_card_action": {
      "enum": [
        "review_consequences",
        "confirm_restart",
        "cancel_restart",
        "export_evidence",
        "interrupt_instead",
        "open_deep_link"
      ]
    },
    "recovery_card_action": {
      "enum": [
        "reconnect",
        "restart_clean",
        "choose_another_kernel",
        "open_inspect_only",
        "export_evidence",
        "open_deep_link"
      ]
    },
    "disposition": {
      "enum": [
        "no_kernel",
        "queued",
        "busy",
        "ready",
        "disconnected",
        "managed",
        "remote",
        "stale_output",
        "sanitized",
        "active",
        "reconnect",
        "restart_clean",
        "choose_another_kernel"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "kernel_origin_and_class",
        "output_trust_and_freshness",
        "restart_and_recovery"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook_surface",
        "kernel_manager_surface",
        "output_viewer_surface",
        "debug_surface",
        "review_surface",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "notebook_ui",
        "kernel_manager_ui",
        "output_viewer_ui",
        "debugger_ui",
        "ai_context_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "kernel_origin_unstated",
        "kernel_class_collapsed",
        "document_identity_unstated",
        "output_trust_unstated",
        "stale_output_shown_as_live",
        "trust_class_hover_only",
        "provenance_severed",
        "restart_consequence_implied_rerun",
        "recovery_overclaimed",
        "reconnect_shown_as_fresh",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "restart_consequence_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "card_label",
        "restart_action",
        "consequence_state",
        "impact_class",
        "action_scope",
        "claims_state_preserved",
        "requires_rerun",
        "affects_debugger_session",
        "preserved_state_label",
        "lost_state_note",
        "variables_cleared_note",
        "outputs_cleared_note",
        "rerun_requirement_note",
        "debugger_session_note",
        "restart_action_label",
        "consequence_state_label",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "implies_rerun_on_restore_or_recovery",
        "presents_lost_state_as_preserved",
        "hides_consequence_behind_hover_only",
        "collapses_recovery_into_generic_error"
      ],
      "properties": {
        "component": { "const": "restart_consequence_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "card_label": { "$ref": "#/$defs/non_empty_string" },
        "restart_action": { "$ref": "#/$defs/restart_action_class" },
        "consequence_state": { "$ref": "#/$defs/restart_consequence_state" },
        "impact_class": { "$ref": "#/$defs/restart_impact_class" },
        "action_scope": { "$ref": "#/$defs/restart_action_scope" },
        "claims_state_preserved": { "type": "boolean" },
        "requires_rerun": { "type": "boolean" },
        "affects_debugger_session": { "type": "boolean" },
        "preserved_state_label": { "$ref": "#/$defs/non_empty_string" },
        "lost_state_note": { "type": "string" },
        "variables_cleared_note": { "type": "string" },
        "outputs_cleared_note": { "type": "string" },
        "rerun_requirement_note": { "type": "string" },
        "debugger_session_note": { "type": "string" },
        "restart_action_label": { "$ref": "#/$defs/non_empty_string" },
        "consequence_state_label": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "review_consequences" } },
            { "contains": { "const": "confirm_restart" } },
            { "contains": { "const": "cancel_restart" } }
          ],
          "items": { "$ref": "#/$defs/restart_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_rerun_on_restore_or_recovery": { "const": false },
        "presents_lost_state_as_preserved": { "const": false },
        "hides_consequence_behind_hover_only": { "const": false },
        "collapses_recovery_into_generic_error": { "const": false }
      }
    },
    "kernel_recovery_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "card_label",
        "recovery_action",
        "recovery_state",
        "posture_class",
        "continuity_class",
        "claims_recovered",
        "claims_continuity_preserved",
        "requires_rerun_after_recovery",
        "no_rerun_note",
        "clean_session_note",
        "no_kernel_note",
        "blocked_note",
        "restart_note",
        "await_note",
        "recovery_action_label",
        "recovery_state_label",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "implies_rerun_on_restore_or_recovery",
        "presents_lost_state_as_preserved",
        "hides_consequence_behind_hover_only",
        "collapses_recovery_into_generic_error"
      ],
      "properties": {
        "component": { "const": "kernel_recovery_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "card_label": { "$ref": "#/$defs/non_empty_string" },
        "recovery_action": { "$ref": "#/$defs/kernel_recovery_action_class" },
        "recovery_state": { "$ref": "#/$defs/kernel_recovery_state" },
        "posture_class": { "$ref": "#/$defs/kernel_recovery_posture" },
        "continuity_class": { "$ref": "#/$defs/recovery_continuity_class" },
        "claims_recovered": { "type": "boolean" },
        "claims_continuity_preserved": { "type": "boolean" },
        "requires_rerun_after_recovery": { "type": "boolean" },
        "no_rerun_note": { "$ref": "#/$defs/non_empty_string" },
        "clean_session_note": { "type": "string" },
        "no_kernel_note": { "type": "string" },
        "blocked_note": { "type": "string" },
        "restart_note": { "type": "string" },
        "await_note": { "type": "string" },
        "recovery_action_label": { "$ref": "#/$defs/non_empty_string" },
        "recovery_state_label": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "reconnect" } },
            { "contains": { "const": "restart_clean" } },
            { "contains": { "const": "choose_another_kernel" } }
          ],
          "items": { "$ref": "#/$defs/recovery_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_rerun_on_restore_or_recovery": { "const": false },
        "presents_lost_state_as_preserved": { "const": false },
        "hides_consequence_behind_hover_only": { "const": false },
        "collapses_recovery_into_generic_error": { "const": false }
      }
    },
    "restart_recovery_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restart_card_shows_preserved_state",
        "restart_card_shows_lost_state",
        "restart_card_shows_debugger_session_impact",
        "restart_card_shows_rerun_requirement",
        "recovery_card_offers_reconnect_restart_choose",
        "recovery_card_shows_recovery_state",
        "recovery_card_never_implies_rerun",
        "recovery_never_overclaims_recovered",
        "impact_and_posture_derived_never_asserted",
        "lost_state_never_presented_as_preserved",
        "consequence_never_hover_only",
        "rerun_requirement_named_before_restart",
        "recovery_degrades_to_attributable_state_not_generic_error",
        "kernel_origin_never_collapsed_into_one_badge",
        "every_next_step_names_stable_deep_link",
        "cards_consistent_across_surfaces",
        "no_component_widens_export_scope_or_exposes_raw_by_default",
        "components_stable_across_deployment_lines",
        "no_surface_invents_alternate_state_label",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notebook_tab_reads_single_source",
        "debug_bridge_shows_restart_consequences",
        "support_packet_shows_recovery_state",
        "companion_handoff_shows_recovery_summary",
        "cli_export_preserves_no_rerun_truth",
        "help_docs_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
