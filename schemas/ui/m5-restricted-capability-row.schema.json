{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-restricted-capability-row.schema.json",
  "title": "Aureline M5 restricted-capability row component",
  "description": "Canonical single-instance shape of the M5 restricted-capability row workspace-trust / guided-repair component. Every claimed M5 restricted-capability row references this schema or the combined m5-workspace-trust-repair-component-matrix.schema.json rather than reinventing its own trust-lineage, narrowed-capability, or reversal wording. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "implies_blanket_trust_across_roots_or_routes",
    "hides_checkpoint_absence_or_reversal_limits",
    "collapses_reversal_outcomes_into_generic_success",
    "presents_partial_success_as_complete"
  ],
  "properties": {
    "component_family": {
      "const": "restricted_capability_row"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "trusted",
          "restricted",
          "mixed_root",
          "policy_blocked",
          "reduced_mode",
          "preview_ready",
          "checkpoint_missing",
          "exact_reversal",
          "compensate",
          "regenerate",
          "manual_follow_up",
          "audit_only"
        ]
      }
    },
    "grant_source_classes": {
      "type": "array"
    },
    "trust_scope_states": {
      "type": "array"
    },
    "capability_narrow_states": {
      "type": "array"
    },
    "root_trust_states": {
      "type": "array"
    },
    "reversal_classes": {
      "type": "array"
    },
    "checkpoint_states": {
      "type": "array"
    },
    "repair_outcomes": {
      "type": "array"
    },
    "preview_states": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "implies_blanket_trust_across_roots_or_routes": {
      "const": false
    },
    "hides_checkpoint_absence_or_reversal_limits": {
      "const": false
    },
    "collapses_reversal_outcomes_into_generic_success": {
      "const": false
    },
    "presents_partial_success_as_complete": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
