{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-credential-state-row-vault-picker-controls.schema.json",
  "title": "Aureline M5 credential-state rows and vault-or-keychain pickers",
  "description": "Export-safe packet implementing the reusable M5 credential-state-row and vault-or-keychain-picker components in two co-equal control vectors. Each credential-state row names its storage mode, credential (source) class, reveal posture, and the target boundary it applies to (provider, registry, request, database, remote, or release); its health class is derived from the credential lifecycle state, so a revoked or expired credential can never read as healthy. It always names its auditability and always offers keyboard-complete rotate, revoke, and test actions. Each vault-or-keychain picker names its available source, access scope, reveal policy, and a derived portability / export note, so a store-export-blocked or session-only store can never read as freely portable and no picker normalizes raw-secret handling; it always offers an open-source-of-truth action. Friendly connected wording never conceals storage mode, reveal posture, or delegation; raw secret values, tokens, passphrases, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "credential_state_rows",
    "vault_pickers",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "credential_state_row_vault_picker_controls" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "credential_state_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/credential_state_row" }
    },
    "vault_pickers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vault_picker" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "storage_mode": {
      "type": "string",
      "enum": [
        "os_keychain",
        "encrypted_vault",
        "secret_broker_handle",
        "session_memory_only",
        "external_reference",
        "no_secret_stored"
      ]
    },
    "credential_class": {
      "type": "string",
      "enum": [
        "oauth_token",
        "api_key",
        "personal_access_token",
        "ssh_or_signing_key",
        "client_certificate",
        "device_code_grant"
      ]
    },
    "reveal_posture": {
      "type": "string",
      "enum": [
        "handle_only",
        "masked_last_four",
        "reveal_on_demand",
        "clipboard_scoped",
        "never_revealed",
        "policy_blocked_reveal"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "active_current",
        "refresh_needed",
        "rotation_due",
        "revoked",
        "expired",
        "superseded"
      ]
    },
    "store_capability": {
      "type": "string",
      "enum": [
        "persist_across_restart",
        "os_locked_at_rest",
        "sync_across_devices",
        "hardware_backed",
        "store_export_blocked",
        "session_only"
      ]
    },
    "degraded_state": {
      "type": "string",
      "enum": [
        "fully_available",
        "limited_capability",
        "stale_needs_reauth",
        "offline_cached",
        "policy_blocked",
        "unavailable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "storage_and_reveal_posture",
        "identity_and_delegation",
        "expiry_and_export_boundary"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "sign_in_and_auth",
        "provider_and_registry",
        "remote_and_database",
        "package_and_release",
        "recovery_and_audit",
        "cli_and_headless"
      ]
    },
    "deployment_line": {
      "type": "string",
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "credential_settings_ui",
        "secret_prompt_ui",
        "vault_picker_ui",
        "device_code_handoff_ui",
        "delegated_identity_ui",
        "support_export",
        "cli_inspect",
        "status_bar_ui",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "storage_mode_unstated",
        "reveal_posture_unstated",
        "credential_class_unstated",
        "auth_handoff_class_unstated",
        "delegated_identity_unstated",
        "lifecycle_state_hidden",
        "store_capability_unstated",
        "export_safety_boundary_hidden",
        "alternate_state_label_invented",
        "friendly_connected_wording_used",
        "session_only_fallback_hidden",
        "proof_stale"
      ]
    },
    "target_boundary": {
      "type": "string",
      "enum": ["provider", "registry", "request", "database", "remote", "release"]
    },
    "health_class": {
      "type": "string",
      "enum": ["healthy", "attention_needed", "revoked", "expired", "superseded"]
    },
    "state_row_action": {
      "type": "string",
      "enum": [
        "copy_handle_reference",
        "rotate",
        "revoke",
        "test",
        "open_audit",
        "export_row"
      ]
    },
    "access_scope": {
      "type": "string",
      "enum": ["device_local", "user_profile", "team_shared", "org_managed", "session_only"]
    },
    "portability_class": {
      "type": "string",
      "enum": [
        "portable",
        "handle_reference_only",
        "export_blocked",
        "session_only_non_portable"
      ]
    },
    "picker_action": {
      "type": "string",
      "enum": [
        "open_source_of_truth",
        "select_store",
        "copy_store_reference",
        "review_capability",
        "export_picker"
      ]
    },
    "degraded_state_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/degraded_state" }
    },
    "required_label_array": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/required_label" },
      "allOf": [
        { "contains": { "const": "identity" } },
        { "contains": { "const": "state" } },
        { "contains": { "const": "keyboard_route" } }
      ]
    },
    "accessibility_route_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_route" },
      "contains": { "const": "keyboard_focusable" }
    },
    "credential_state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "credential_label",
        "storage_mode",
        "credential_class",
        "reveal_posture",
        "target_boundary",
        "target_label",
        "lifecycle_state",
        "health_class",
        "claims_healthy",
        "attention_note",
        "revoked_note",
        "expired_note",
        "superseded_note",
        "storage_and_reveal_note",
        "is_auditable",
        "audit_note",
        "default_actions",
        "degraded_states",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_storage_or_reveal_posture",
        "implies_raw_secret_exportable",
        "uses_friendly_connected_wording"
      ],
      "properties": {
        "component": { "const": "credential_state_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "credential_label": { "$ref": "#/$defs/non_empty_string" },
        "storage_mode": { "$ref": "#/$defs/storage_mode" },
        "credential_class": { "$ref": "#/$defs/credential_class" },
        "reveal_posture": { "$ref": "#/$defs/reveal_posture" },
        "target_boundary": { "$ref": "#/$defs/target_boundary" },
        "target_label": { "$ref": "#/$defs/non_empty_string" },
        "lifecycle_state": { "$ref": "#/$defs/lifecycle_state" },
        "health_class": { "$ref": "#/$defs/health_class" },
        "claims_healthy": { "type": "boolean" },
        "attention_note": { "type": "string" },
        "revoked_note": { "type": "string" },
        "expired_note": { "type": "string" },
        "superseded_note": { "type": "string" },
        "storage_and_reveal_note": { "$ref": "#/$defs/non_empty_string" },
        "is_auditable": { "type": "boolean" },
        "audit_note": { "type": "string" },
        "default_actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/state_row_action" },
          "allOf": [
            { "contains": { "const": "rotate" } },
            { "contains": { "const": "revoke" } },
            { "contains": { "const": "test" } }
          ]
        },
        "degraded_states": { "$ref": "#/$defs/degraded_state_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_storage_or_reveal_posture": { "const": false },
        "implies_raw_secret_exportable": { "const": false },
        "uses_friendly_connected_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "health_class": { "const": "attention_needed" } },
            "required": ["health_class"]
          },
          "then": {
            "properties": { "attention_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "health_class": { "const": "revoked" } },
            "required": ["health_class"]
          },
          "then": {
            "properties": { "revoked_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "health_class": { "const": "expired" } },
            "required": ["health_class"]
          },
          "then": {
            "properties": { "expired_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "health_class": { "const": "superseded" } },
            "required": ["health_class"]
          },
          "then": {
            "properties": { "superseded_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "health_class": { "const": "healthy" } },
            "required": ["health_class"]
          },
          "then": {
            "properties": { "claims_healthy": { "const": true } },
            "required": ["claims_healthy"]
          },
          "else": {
            "properties": { "claims_healthy": { "const": false } },
            "required": ["claims_healthy"]
          }
        },
        {
          "if": {
            "properties": { "is_auditable": { "const": true } },
            "required": ["is_auditable"]
          },
          "then": {
            "properties": { "audit_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        }
      ]
    },
    "vault_picker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "picker_id",
        "store_label",
        "storage_mode",
        "access_scope",
        "access_scope_label",
        "store_capabilities",
        "reveal_policy",
        "portability_class",
        "claims_portable",
        "portability_note",
        "export_blocked_note",
        "session_only_note",
        "handle_only_note",
        "storage_and_reveal_note",
        "default_actions",
        "degraded_states",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_storage_or_reveal_posture",
        "implies_raw_secret_exportable",
        "uses_friendly_connected_wording"
      ],
      "properties": {
        "component": { "const": "vault_or_keychain_picker" },
        "picker_id": { "$ref": "#/$defs/non_empty_string" },
        "store_label": { "$ref": "#/$defs/non_empty_string" },
        "storage_mode": { "$ref": "#/$defs/storage_mode" },
        "access_scope": { "$ref": "#/$defs/access_scope" },
        "access_scope_label": { "$ref": "#/$defs/non_empty_string" },
        "store_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/store_capability" }
        },
        "reveal_policy": { "$ref": "#/$defs/reveal_posture" },
        "portability_class": { "$ref": "#/$defs/portability_class" },
        "claims_portable": { "type": "boolean" },
        "portability_note": { "$ref": "#/$defs/non_empty_string" },
        "export_blocked_note": { "type": "string" },
        "session_only_note": { "type": "string" },
        "handle_only_note": { "type": "string" },
        "storage_and_reveal_note": { "$ref": "#/$defs/non_empty_string" },
        "default_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/picker_action" },
          "contains": { "const": "open_source_of_truth" }
        },
        "degraded_states": { "$ref": "#/$defs/degraded_state_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_storage_or_reveal_posture": { "const": false },
        "implies_raw_secret_exportable": { "const": false },
        "uses_friendly_connected_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "portability_class": { "const": "export_blocked" } },
            "required": ["portability_class"]
          },
          "then": {
            "properties": { "export_blocked_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": {
              "portability_class": { "const": "session_only_non_portable" }
            },
            "required": ["portability_class"]
          },
          "then": {
            "properties": { "session_only_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "portability_class": { "const": "handle_reference_only" } },
            "required": ["portability_class"]
          },
          "then": {
            "properties": { "handle_only_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "portability_class": { "const": "portable" } },
            "required": ["portability_class"]
          },
          "then": {
            "properties": { "claims_portable": { "const": true } },
            "required": ["claims_portable"]
          },
          "else": {
            "properties": { "claims_portable": { "const": false } },
            "required": ["claims_portable"]
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_state_shows_storage_and_reveal_posture",
        "credential_state_shows_target_boundary",
        "health_state_derived_never_asserted",
        "revoked_or_expired_never_reads_as_healthy",
        "rotate_revoke_test_actions_present",
        "auditability_always_named",
        "vault_picker_shows_available_source_and_scope",
        "vault_picker_shows_reveal_policy",
        "portability_note_derived_never_asserted",
        "export_blocked_and_session_only_explicit",
        "raw_secret_handling_never_normalized",
        "no_friendly_wording_conceals_storage_or_delegation",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "credential_state_shows_storage_and_reveal_posture": { "const": true },
        "credential_state_shows_target_boundary": { "const": true },
        "health_state_derived_never_asserted": { "const": true },
        "revoked_or_expired_never_reads_as_healthy": { "const": true },
        "rotate_revoke_test_actions_present": { "const": true },
        "auditability_always_named": { "const": true },
        "vault_picker_shows_available_source_and_scope": { "const": true },
        "vault_picker_shows_reveal_policy": { "const": true },
        "portability_note_derived_never_asserted": { "const": true },
        "export_blocked_and_session_only_explicit": { "const": true },
        "raw_secret_handling_never_normalized": { "const": true },
        "no_friendly_wording_conceals_storage_or_delegation": { "const": true },
        "controls_stable_across_deployment_lines": { "const": true },
        "copy_and_export_safe": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_rows_show_authority_and_boundary_without_docs",
        "storage_mode_clarity_preserved_across_surfaces",
        "vault_picker_shows_source_scope_and_portability_inline",
        "cli_headless_shows_control_truth",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "credential_rows_show_authority_and_boundary_without_docs": { "const": true },
        "storage_mode_clarity_preserved_across_surfaces": { "const": true },
        "vault_picker_shows_source_scope_and_portability_inline": { "const": true },
        "cli_headless_shows_control_truth": { "const": true },
        "support_export_shows_control_truth": { "const": true },
        "help_about_shows_control_truth": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
