{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-governance-dashboard-component-matrix.schema.json",
  "title": "Aureline M5 fitness-dashboard-tile, governance-report-row, waiver-expiry-queue-item, release-gate-banner, mitigation-note-card, service-ownership-card, on-call-strip, decision-right-card, and milestone-dashboard-row component matrix",
  "description": "Export-safe packet freezing Aureline's reusable governance-dashboard components. The packet names every component family M5 claims that still drifts too easily by assurance dashboard, operator board, or shiproom spreadsheet — fitness dashboard tiles, governance report rows, waiver-expiry queue items, release-gate banners, mitigation note cards, service-ownership cards, on-call strips, decision-right cards, and milestone dashboard rows — and binds each to the claimed M5 governance surface families that render it, the deployment lines it keeps the same truth across, and the mandatory labels it must show. Every component carries the frozen governance readiness-state vocabulary (passing, warning, blocked, waived, expired_waiver, evidence_stale, owner_unresolved, forum_unresolved, not_evaluated) and, where applicable, its family-specific vocabulary: fitness provenance classes, governance report scopes, waiver expiry states, release-gate decisions, mitigation postures, ownership coverage states, on-call coverage states and escalation route classes, decision forum classes and decision-right states, and milestone gate states. Hard invariants forbid rendering a waived or stale reading as a clean pass, letting an ownerless or forumless blocker read as resolved, hiding mitigation behind internal jargon, and inventing a private governance-status grammar. This matrix layers on top of the already-claimed fitness feeds, waiver ledgers, ownership maps, and decision-forum manifests rather than re-architecting them. Raw URLs, raw tokens, credentials, and user text bodies never cross this boundary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_fitness_dashboard_tile_governance_report_row_waiver_expiry_queue_item_release_gate_banner_mitigation_note_card_service_ownership_card_on_call_strip_decision_right_card_and_milestone_dashboard_row_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "governance_packet_ref",
        "assurance_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ]
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 11,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "fitness_dashboard_tile",
        "governance_report_row",
        "waiver_expiry_queue_item",
        "release_gate_banner",
        "mitigation_note_card",
        "service_ownership_card",
        "on_call_strip",
        "decision_right_card",
        "milestone_dashboard_row"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "readiness_state": {
      "enum": [
        "passing",
        "warning",
        "blocked",
        "waived",
        "expired_waiver",
        "evidence_stale",
        "owner_unresolved",
        "forum_unresolved",
        "not_evaluated"
      ]
    },
    "fitness_provenance_class": {
      "enum": [
        "canonical_corpus",
        "profile_pinned",
        "sampled_corpus",
        "synthetic_corpus",
        "provenance_unknown"
      ]
    },
    "report_scope": {
      "enum": ["service_scope", "family_scope", "train_scope", "fleet_scope", "waiver_ledger_scope"]
    },
    "waiver_expiry_state": {
      "enum": ["active_waiver", "expiring_soon", "expired_waiver", "revoked_waiver", "no_waiver"]
    },
    "release_gate_decision": {
      "enum": [
        "go",
        "no_go",
        "conditional_go",
        "held_pending_evidence",
        "blocked_by_owner_or_forum"
      ]
    },
    "mitigation_posture": {
      "enum": [
        "mitigated",
        "partially_mitigated",
        "unmitigated",
        "risk_accepted",
        "mitigation_unknown"
      ]
    },
    "ownership_coverage_state": {
      "enum": [
        "owned_with_backup",
        "primary_only_no_backup",
        "owner_unresolved",
        "owner_stale",
        "policy_hidden"
      ]
    },
    "on_call_coverage_state": {
      "enum": [
        "on_call_covered",
        "on_call_gap",
        "escalation_only",
        "follow_the_sun",
        "on_call_unknown"
      ]
    },
    "escalation_route_class": {
      "enum": [
        "page_primary",
        "page_backup",
        "escalate_to_manager",
        "incident_bridge",
        "no_escalation_path"
      ]
    },
    "decision_forum_class": {
      "enum": [
        "release_council",
        "service_owner",
        "security_review_board",
        "architecture_forum",
        "no_authorized_forum"
      ]
    },
    "decision_right_state": {
      "enum": [
        "authoritative_forum",
        "advisory_only",
        "forum_unresolved",
        "delegated_decision",
        "not_evaluated_here"
      ]
    },
    "milestone_gate_state": {
      "enum": [
        "exit_gate_met",
        "exit_gate_pending",
        "exit_gate_blocked",
        "exit_gate_waived",
        "exit_gate_stale"
      ]
    },
    "surface_family": {
      "enum": [
        "assurance_center",
        "operator_overview",
        "release_center",
        "shiproom",
        "service_health",
        "support_desk",
        "docs_help",
        "admin_review"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "consumer_surface": {
      "enum": [
        "assurance_dashboard",
        "operator_board",
        "release_center_ui",
        "shiproom_packet",
        "service_health",
        "help_about",
        "support_export",
        "docs_portal",
        "cli_inspect",
        "product_ui"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "evidence_freshness",
        "owner_and_escalation",
        "decision_forum"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "fitness_provenance_unstated",
        "evidence_stale_hidden",
        "waiver_expiry_hidden",
        "release_gate_reason_generic",
        "mitigation_hidden_behind_jargon",
        "owner_coverage_overstated",
        "on_call_gap_hidden",
        "escalation_route_unstated",
        "decision_forum_masked",
        "advisory_forum_reads_authoritative",
        "milestone_gate_overstated",
        "proof_stale"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "readiness_states",
        "fitness_provenance_classes",
        "report_scopes",
        "waiver_expiry_states",
        "release_gate_decisions",
        "mitigation_postures",
        "ownership_coverage_states",
        "on_call_coverage_states",
        "escalation_route_classes",
        "decision_forum_classes",
        "decision_right_states",
        "milestone_gate_states",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "renders_waived_or_stale_as_clean_pass",
        "lets_ownerless_or_forumless_blocker_read_resolved",
        "hides_mitigation_behind_internal_jargon",
        "invents_private_governance_status_grammar"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "readiness_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/readiness_state" }
        },
        "fitness_provenance_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/fitness_provenance_class" }
        },
        "report_scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/report_scope" }
        },
        "waiver_expiry_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/waiver_expiry_state" }
        },
        "release_gate_decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/release_gate_decision" }
        },
        "mitigation_postures": {
          "type": "array",
          "items": { "$ref": "#/$defs/mitigation_posture" }
        },
        "ownership_coverage_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/ownership_coverage_state" }
        },
        "on_call_coverage_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/on_call_coverage_state" }
        },
        "escalation_route_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/escalation_route_class" }
        },
        "decision_forum_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision_forum_class" }
        },
        "decision_right_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision_right_state" }
        },
        "milestone_gate_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone_gate_state" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "renders_waived_or_stale_as_clean_pass": { "const": false },
        "lets_ownerless_or_forumless_blocker_read_resolved": { "const": false },
        "hides_mitigation_behind_internal_jargon": { "const": false },
        "invents_private_governance_status_grammar": { "const": false }
      }
    }
  }
}
