{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-project-entry-component-consumer.schema.json",
  "title": "Aureline M5 project-entry component consumer packet",
  "description": "M05-842 first-consumer adoption packet proving the ten frozen M5 project-entry component families (start-center quick-action card, recent-work row, workspace-switcher entry, restore-prompt card, entry-chooser row, entry-review sheet, destination-collision sheet, post-entry handoff card, admission-checkpoint card, and archetype-readiness row) are reusable primitives. Each row is one consumer on one M5 entry surface — Start Center / Open recent / command palette, system-open / file-association intake, protocol / deep-link / browser-mobile handoff, CLI / headless entry, or support / diagnostics + docs/help — that points back to exactly one canonical component family (its per-family schema + the shared release-proof packet) instead of inventing per-surface entry wording. Every consumer keeps the identical entry-verb / literal-target / resulting-mode / write-scope-trust-host-auth / restore-or-first-useful-work labels, the identical command id for a given entry verb, and the identical degraded-state vocabulary (missing target, remote-unreachable, policy-blocked, cached-only, partial-restore, authority-expired); a narrower consumer discloses the reduction with a reduced-capability banner (and a handoff note when it punts to another surface). The packet is metadata-only: raw file paths, clone URLs, credentials, remote hosts, and device identifiers never cross this boundary, so support and automation reconstruct the taken entry path from opaque entry-object refs and canonical command ids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_project_entry_component_consumer_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "consumer_group": {
      "enum": [
        "start_center_palette",
        "system_open_intake",
        "deep_link_handoff",
        "cli_headless",
        "support_diagnostics_docs"
      ]
    },
    "consumer_surface": {
      "enum": [
        "start_center_home",
        "open_recent_list",
        "command_palette",
        "system_open_file_association",
        "drag_and_drop_intake",
        "protocol_deep_link",
        "browser_mobile_handoff",
        "cli_entry",
        "headless_automation",
        "support_export_replay",
        "admin_diagnostics",
        "help_center_docs"
      ]
    },
    "component_family": {
      "enum": [
        "start_center_quick_action_card",
        "recent_work_row",
        "workspace_switcher_entry",
        "restore_prompt_card",
        "entry_chooser_row",
        "entry_review_sheet",
        "destination_collision_sheet",
        "post_entry_handoff_card",
        "admission_checkpoint_card",
        "archetype_readiness_row"
      ]
    },
    "entry_verb": {
      "enum": ["open", "open_recent", "clone", "import", "restore", "resume"]
    },
    "authority_mode": {
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "review_required",
        "export_only",
        "policy_blocked"
      ]
    },
    "handoff_target": {
      "enum": [
        "none",
        "desktop_shell",
        "companion_app",
        "browser_readonly",
        "handoff_packet",
        "cli_headless"
      ]
    },
    "label_parity": {
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "label_family": {
      "enum": [
        "entry_verb",
        "literal_target",
        "resulting_mode",
        "write_scope_trust_host_auth",
        "restore_or_first_useful_work"
      ]
    },
    "degraded_state_token": {
      "enum": [
        "missing_target",
        "remote_unreachable",
        "policy_blocked",
        "cached_only",
        "partial_restore",
        "authority_expired"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_group",
        "consumer_surface",
        "component_family",
        "entry_verb",
        "command_id",
        "canonical_family_schema_ref",
        "canonical_packet_refs",
        "references_canonical_not_local_prose",
        "entry_object_ref",
        "authority_mode",
        "preserved_label_families",
        "degraded_state_vocab",
        "label_parity",
        "handoff_target",
        "copy_export",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_project_entry_component_consumer_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_group": { "$ref": "#/$defs/consumer_group" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "entry_verb": { "$ref": "#/$defs/entry_verb" },
        "command_id": { "type": "string", "minLength": 1 },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_packet_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "entry_object_ref": { "type": "string", "minLength": 1 },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/label_family" }
        },
        "degraded_state_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/degraded_state_token" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_group_count",
        "consumer_surface_count",
        "component_family_count",
        "entry_verb_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_use_canonical_command_id",
        "all_handoff_rows_preserve_target_truth",
        "all_rows_reconstructable",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "command_ids_stable_across_surfaces",
        "start_center_palette_consumer_present",
        "system_open_intake_consumer_present",
        "deep_link_handoff_consumer_present",
        "cli_headless_consumer_present",
        "support_diagnostics_docs_consumer_present",
        "docs_help_reference_present",
        "label_family_coverage_complete",
        "families_reused_across_groups"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_group_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "entry_verb_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_use_canonical_command_id": { "type": "boolean" },
        "all_handoff_rows_preserve_target_truth": { "type": "boolean" },
        "all_rows_reconstructable": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "command_ids_stable_across_surfaces": { "type": "boolean" },
        "start_center_palette_consumer_present": { "type": "boolean" },
        "system_open_intake_consumer_present": { "type": "boolean" },
        "deep_link_handoff_consumer_present": { "type": "boolean" },
        "cli_headless_consumer_present": { "type": "boolean" },
        "support_diagnostics_docs_consumer_present": { "type": "boolean" },
        "docs_help_reference_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "families_reused_across_groups": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
