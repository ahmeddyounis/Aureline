{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-framework-component-matrix.schema.json",
  "title": "Aureline M5 framework-pack-header, route-endpoint-row, component-service-tree-node, convention-diagnostic-row, generator-preview-sheet, run-config-scaffold-card, and derived-relationship-banner component matrix",
  "description": "Export-safe packet freezing Aureline's reusable framework-aware and topology-explorer components. The packet names every framework-aware component family M5 claims that still drifts too easily by surface — framework pack headers, route / endpoint rows, component / service tree nodes, convention-diagnostic rows, generator preview sheets, run-config scaffold cards, and derived-relationship banners — and binds each to the claimed M5 framework-aware / topology-explorer surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Every component binds the one controlled certainty vocabulary (core_native, framework_pack, bridge, heuristic_convention, verified, derived_by_convention, runtime_confirmed, partial) plus the family-specific controlled vocabularies it carries: pack support classes and pack identity states; route evidence classes and authorship; topology node kinds and evidence classes; convention confidence classes and diagnostic severities; generator impact classes and apply postures; execution boundary classes and mutation classes; and derived-relationship classes and proving states. Hard invariants forbid hiding a pack identity / version or support class, letting a heuristic route or tree masquerade as exact, implying a no-op write while mutating config or dependencies, hiding the local / container / SSH / managed execution boundary behind convenience language, omitting a proving-source linkage or rollback / regenerate path, and inventing an alternate label for a governed state. Raw file bodies, raw diffs, raw local paths, repository URLs, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_the_m5_framework_pack_header_route_endpoint_row_component_service_tree_node_convention_diagnostic_row_generator_preview_sheet_run_config_scaffold_card_and_derived_relationship_banner_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "framework_component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "framework_component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "framework_pack_header",
        "route_endpoint_row",
        "component_service_tree_node",
        "convention_diagnostic_row",
        "generator_preview_sheet",
        "run_config_scaffold_card",
        "derived_relationship_banner"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_pack_identity_version_or_support_class",
        "lets_heuristic_masquerade_as_exact",
        "implies_no_op_write_while_mutating_config_or_dependencies",
        "hides_local_container_ssh_or_managed_boundary",
        "omits_proving_source_or_rollback_path",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "hides_pack_identity_version_or_support_class": { "const": false },
        "lets_heuristic_masquerade_as_exact": { "const": false },
        "implies_no_op_write_while_mutating_config_or_dependencies": { "const": false },
        "hides_local_container_ssh_or_managed_boundary": { "const": false },
        "omits_proving_source_or_rollback_path": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    }
  }
}
