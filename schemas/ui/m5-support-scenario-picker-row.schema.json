{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-scenario-picker-row.schema.json",
  "title": "Aureline M5 support-scenario-picker-row primitive",
  "description": "Export-safe packet implementing the reusable M5 support-scenario picker row as one primitive. The packet binds one row per claimed support-intake consumer — Doctor intake, support-center intake, recovery-center intake, headless/CLI intake, and support-packet export — to the shared picker-row anatomy, the derived picker posture (focused-file/workspace/account-or-device/remote-service/unmapped/scenario-diagnosis-blocked), the scenario families, incident scopes, Doctor finding families, bounded reveal/start-diagnosis/start-local-only/confirm-scope/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks its scenario family or incident scope, never hides the bound Doctor finding lineage, never drops the same-weight local-only diagnosis route, and never invents an alternate scenario grammar. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_support_scenario_picker_rows_and_seeded_symptom_scope_cues_with_start_diagnosis_parity_across_claimed_m5_support_intake_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "support_case_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "support_case_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "scenario_families",
        "incident_scopes",
        "doctor_finding_families",
        "row_postures",
        "row_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "picker_examples",
        "masks_scenario_or_scope",
        "hides_doctor_finding_lineage",
        "drops_local_only_route",
        "invents_alternate_scenario_grammar"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "doctor_intake",
            "support_center_intake",
            "recovery_center_intake",
            "headless_cli_intake",
            "support_packet_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "scenario_families": { "type": "array", "minItems": 1 },
        "incident_scopes": { "type": "array", "minItems": 1 },
        "doctor_finding_families": { "type": "array", "minItems": 1 },
        "row_postures": { "type": "array", "minItems": 1 },
        "row_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "picker_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/picker_example" }
        },
        "masks_scenario_or_scope": { "const": false },
        "hides_doctor_finding_lineage": { "const": false },
        "drops_local_only_route": { "const": false },
        "invents_alternate_scenario_grammar": { "const": false }
      }
    },
    "picker_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "scenario_family",
            "incident_scope",
            "doctor_finding_family",
            "row_identity",
            "row_posture",
            "can_start_scenario_diagnosis",
            "local_only_route_available",
            "is_scenario_mapped",
            "available_actions"
          ]
        }
      }
    }
  }
}
