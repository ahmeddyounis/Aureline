{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-install-profile-card.schema.json",
  "title": "Aureline M5 install-profile card",
  "description": "Stable UI contract for an M5 install-profile card. The card names install identity, operating mode, channel, updater owner, state root, freshness, continuity state, and keyboard route so install ownership and durable roots never hide on About, diagnostics, support export, or admin surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "install_id_ref",
    "install_mode",
    "channel_ref",
    "updater_owner_ref",
    "state_root_ref",
    "freshness",
    "continuity_state",
    "discloses_state_roots",
    "discloses_updater_owner",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_install_profile_card" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "install_id_ref": { "$ref": "#/$defs/ref" },
    "install_mode": { "$ref": "#/$defs/deployment_mode" },
    "channel_ref": { "$ref": "#/$defs/ref" },
    "updater_owner_ref": { "$ref": "#/$defs/ref" },
    "state_root_ref": { "$ref": "#/$defs/ref" },
    "freshness": { "$ref": "#/$defs/truth_mode" },
    "continuity_state": { "$ref": "#/$defs/continuity_state" },
    "discloses_state_roots": { "const": true },
    "discloses_updater_owner": { "const": true },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "deployment_mode": {
      "enum": ["desktop", "managed", "self_hosted", "portable", "air_gapped"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_reported"]
    },
    "continuity_state": {
      "enum": ["current", "local_safe", "reattach_required", "review_required"]
    },
    "downgrade_trigger": {
      "enum": [
        "control_plane_impaired",
        "mirror_stale",
        "offline_cache_only",
        "signature_unverified",
        "rollout_paused",
        "handler_ownership_contested",
        "state_root_unavailable",
        "residual_vendor_dependency",
        "provenance_incomplete"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
