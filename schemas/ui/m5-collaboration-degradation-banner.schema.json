{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-collaboration-degradation-banner.schema.json",
  "title": "Aureline M5 collaboration degradation banner (higher-risk control plane)",
  "description": "Canonical per-domain descriptor for the separate higher-risk control plane and the collaboration degradation banner it drives. Names the object identity, its authority model, its convergence state, and the exact named degraded state so a convergence-degraded or awareness-degraded state is never collapsed into a generic stale or broken badge, and local unsent work is preserved first on downgrade. Raw op-log payloads never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "authority_model",
    "convergence_state",
    "named_degraded_state",
    "local_unsent_work_preserved_first"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "higher_risk_control_plane"
      ]
    },
    "authority_model": {
      "$ref": "#/$defs/authority_model"
    },
    "convergence_state": {
      "$ref": "#/$defs/convergence_state"
    },
    "named_degraded_state": {
      "$ref": "#/$defs/degraded_reason"
    },
    "local_unsent_work_preserved_first": {
      "type": "boolean"
    },
    "convergence_versus_awareness_distinguished": {
      "type": "boolean"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "authority_model": {
      "enum": [
        "crdt_convergent_replica",
        "server_ordered_sequence",
        "host_authoritative_state",
        "local_canonical_never_replaced"
      ]
    },
    "degraded_reason": {
      "enum": [
        "authority_model_unresolved",
        "convergence_state_unknown",
        "local_unsent_work_at_risk",
        "anchor_drift_unreviewed",
        "export_posture_unknown",
        "provenance_or_freshness_unknown"
      ]
    },
    "convergence_state": {
      "enum": [
        "converged",
        "converging_pending_ops",
        "server_ordered",
        "host_authoritative",
        "locally_pending_unsent",
        "convergence_degraded",
        "awareness_degraded",
        "anchor_unresolved",
        "anchor_rebound_append_only",
        "relay_partitioned",
        "reconciliation_required",
        "compaction_pending",
        "sealed_archived",
        "local_canonical_preserved",
        "sampled_presence_only",
        "provenance_stale"
      ]
    }
  }
}
