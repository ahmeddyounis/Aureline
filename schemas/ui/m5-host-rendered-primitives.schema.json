{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-host-rendered-primitives.schema.json",
  "title": "Aureline M5 host-rendered trust-component primitives and token / state wiring",
  "description": "Export-safe packet binding Aureline's M5 trust / config / history component families to canonical host-rendered primitives with shared design-token / state wiring, so desktop, companion, and extension-backed first consumers cannot each restyle or relabel them into different meanings. Each primitive row binds one host-rendered primitive family (settings row, capability sheet, event / history row, timeline group, or chronology export preview) to the frozen component families it renders, the host surfaces it renders on (desktop app, companion surface, extension host), the render modes it permits (host-rendered canonical or audited wrapper, never a bespoke local variant), the fixed design-token slots and contract parts it pins, the cosmetic aspects a contributor may restyle, and a naming-parity block whose demo, screenshot, and support-export names all equal the primitive family token. Each row carries worked binding cases: a resolver input (a first consumer's declared render of a primitive on a host surface, with its render mode, wired token slots, restyled cosmetic aspects, and any overridden contract parts) and the resolved conformance verdict — the stored resolution must equal a fresh resolve of its input. Hard invariants forbid allowing a bespoke local variant, dropping a fixed token slot from the host wiring, letting a restyle reach a fixed contract part, and dropping export / audit truth. The frozen component families, source pills, provenance badges, accessibility routes, qualification classes, and downgrade triggers are reused verbatim from the frozen M5 trust-chronology component matrix; the shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix. This module mints new vocabulary only for what the frozen matrix left implicit about binding a family to a host-rendered primitive: the host-rendered primitive families, host surfaces, render modes, design-token slots, restylable aspects, contract parts, and binding conformance verdicts. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary; only opaque export-safe reprs are carried. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "primitive_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_host_rendered_trust_component_primitives_and_token_state_wiring"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "primitive_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/primitive_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": { "type": "object" },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "primitive_family": {
      "enum": [
        "settings_row",
        "capability_sheet",
        "event_history_row",
        "timeline_group",
        "chronology_export_preview"
      ]
    },
    "host_surface": {
      "enum": ["desktop_app", "companion_surface", "extension_host"]
    },
    "render_mode": {
      "enum": [
        "host_rendered_canonical",
        "audited_wrapper",
        "bespoke_local_variant"
      ]
    },
    "token_slot": {
      "enum": [
        "source_pill",
        "provenance_badge",
        "severity_state_color",
        "disclosure_affordance",
        "focus_ring",
        "state_label",
        "density_metric"
      ]
    },
    "contract_part": {
      "enum": [
        "identity_label",
        "typed_state",
        "provenance_or_source_attribution",
        "severity_semantics",
        "disclosure_control",
        "keyboard_route",
        "audit_export_anchor"
      ]
    },
    "binding_conformance": {
      "enum": [
        "conformant",
        "bespoke_drift",
        "token_wiring_incomplete",
        "contract_part_overridden"
      ]
    },
    "primitive_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "bound_component_families",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "host_surfaces",
        "render_modes",
        "fixed_token_slots",
        "fixed_contract_parts",
        "restylable_aspects",
        "source_pills",
        "provenance_badges",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "naming_parity",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_bindings",
        "allows_bespoke_local_variant",
        "drops_fixed_token_wiring",
        "restyles_fixed_contract_part",
        "drops_export_or_audit_truth"
      ],
      "properties": {
        "primitive_family": { "$ref": "#/$defs/primitive_family" },
        "qualification": { "type": "string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "bound_component_families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "shell_zone_slot": { "type": "string" },
        "responsive_classes": { "type": "array", "items": { "type": "string" } },
        "window_classes": { "type": "array", "items": { "type": "string" } },
        "host_surfaces": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/host_surface" }
        },
        "render_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/render_mode" }
        },
        "fixed_token_slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/token_slot" }
        },
        "fixed_contract_parts": {
          "type": "array",
          "minItems": 7,
          "items": { "$ref": "#/$defs/contract_part" }
        },
        "restylable_aspects": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "source_pills": { "type": "array", "items": { "type": "string" } },
        "provenance_badges": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "naming_parity": { "$ref": "#/$defs/naming_parity" },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        },
        "allows_bespoke_local_variant": { "const": false },
        "drops_fixed_token_wiring": { "const": false },
        "restyles_fixed_contract_part": { "const": false },
        "drops_export_or_audit_truth": { "const": false }
      }
    },
    "naming_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demo_name", "screenshot_name", "support_export_name"],
      "properties": {
        "demo_name": { "$ref": "#/$defs/non_empty_string" },
        "screenshot_name": { "$ref": "#/$defs/non_empty_string" },
        "support_export_name": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/binding_input" },
        "resolved": { "$ref": "#/$defs/resolved_binding" }
      }
    },
    "binding_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_family",
        "consumer_id",
        "host_surface",
        "render_mode",
        "audited_wrapper_ref",
        "wired_token_slots",
        "restyled_aspects",
        "overridden_contract_parts"
      ],
      "properties": {
        "primitive_family": { "$ref": "#/$defs/primitive_family" },
        "consumer_id": { "$ref": "#/$defs/non_empty_string" },
        "host_surface": { "$ref": "#/$defs/host_surface" },
        "render_mode": { "$ref": "#/$defs/render_mode" },
        "audited_wrapper_ref": {
          "type": ["string", "null"]
        },
        "wired_token_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_slot" }
        },
        "restyled_aspects": { "type": "array", "items": { "type": "string" } },
        "overridden_contract_parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/contract_part" }
        }
      }
    },
    "resolved_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_family",
        "consumer_id",
        "host_surface",
        "render_mode",
        "renders_through_canonical",
        "fixed_token_slots_wired",
        "restyle_within_bounds",
        "required_token_slots",
        "wired_token_slots",
        "audited_wrapper_ref",
        "conformance"
      ],
      "properties": {
        "primitive_family": { "$ref": "#/$defs/primitive_family" },
        "consumer_id": { "$ref": "#/$defs/non_empty_string" },
        "host_surface": { "$ref": "#/$defs/host_surface" },
        "render_mode": { "$ref": "#/$defs/render_mode" },
        "renders_through_canonical": { "type": "boolean" },
        "fixed_token_slots_wired": { "type": "boolean" },
        "restyle_within_bounds": { "type": "boolean" },
        "required_token_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_slot" }
        },
        "wired_token_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_slot" }
        },
        "audited_wrapper_ref": { "type": ["string", "null"] },
        "conformance": { "$ref": "#/$defs/binding_conformance" }
      }
    }
  }
}
