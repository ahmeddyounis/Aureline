{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-manifest-diff-card.schema.json",
  "title": "Aureline M5 manifest diff card",
  "description": "Reusable manifest diff card for package mutation review. The card preserves manifest identity, scripts/hooks preview, peer/runtime constraint changes, checkpoint and rollback state, and apply boundary across package manager, review, project health, support export, and release proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "card_id",
    "manifest_diff_id",
    "operation_ref",
    "manifest_identity",
    "change_summary",
    "scripts_hooks_preview",
    "constraint_changes",
    "checkpoint_state",
    "rollback_state",
    "apply_boundary",
    "freshness_state",
    "degraded_state",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_manifest_diff_card" },
    "schema_version": { "const": 1 },
    "card_id": { "$ref": "#/$defs/id" },
    "manifest_diff_id": { "$ref": "#/$defs/id" },
    "operation_ref": { "$ref": "#/$defs/ref" },
    "manifest_identity": { "$ref": "#/$defs/manifest_identity" },
    "change_summary": { "$ref": "#/$defs/change_summary" },
    "scripts_hooks_preview": { "$ref": "#/$defs/scripts_hooks_preview" },
    "constraint_changes": { "$ref": "#/$defs/constraint_changes" },
    "checkpoint_state": { "$ref": "#/$defs/checkpoint_state" },
    "rollback_state": { "$ref": "#/$defs/rollback_state" },
    "apply_boundary": { "$ref": "#/$defs/apply_boundary" },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "degraded_state": {
      "type": "string",
      "enum": ["none", "stale", "partial", "blocked", "policy_hidden", "rollback_unavailable", "manifest_scope_unknown"]
    },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "freshness_state": { "type": "string", "enum": ["current", "live", "warm_cached", "stale", "partial", "blocked", "policy_hidden", "expired", "unknown"] },
    "manifest_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_ref", "scope_kind", "ecosystem", "workspace_or_workset_ref"],
      "properties": {
        "manifest_ref": { "$ref": "#/$defs/ref" },
        "scope_kind": { "type": "string", "enum": ["whole_workspace", "selected_manifest", "workset_slice", "workspace_member", "path_or_vcs_target"] },
        "ecosystem": { "type": "string", "enum": ["cargo", "node_pnpm", "python_pip", "other"] },
        "workspace_or_workset_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "change_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_change_count", "lockfile_change_count", "scripts_hooks_change_count", "constraint_change_count", "metadata_change_count"],
      "properties": {
        "dependency_change_count": { "type": "integer", "minimum": 0 },
        "lockfile_change_count": { "type": "integer", "minimum": 0 },
        "scripts_hooks_change_count": { "type": "integer", "minimum": 0 },
        "constraint_change_count": { "type": "integer", "minimum": 0 },
        "metadata_change_count": { "type": "integer", "minimum": 0 }
      }
    },
    "scripts_hooks_preview": {
      "type": "array",
      "items": { "$ref": "#/$defs/script_hook_change" }
    },
    "script_hook_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "change_type", "policy_label", "preview_ref"],
      "properties": {
        "name": { "$ref": "#/$defs/ref" },
        "change_type": { "type": "string", "enum": ["added", "removed", "changed", "unchanged"] },
        "policy_label": { "type": "string", "enum": ["allowed", "review_required", "blocked", "policy_hidden"] },
        "preview_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "constraint_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint_change" }
    },
    "constraint_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_kind", "package_ref", "from_repr", "to_repr", "compatibility_posture"],
      "properties": {
        "constraint_kind": { "type": "string", "enum": ["peer", "runtime", "engine", "toolchain"] },
        "package_ref": { "$ref": "#/$defs/ref" },
        "from_repr": { "$ref": "#/$defs/ref" },
        "to_repr": { "$ref": "#/$defs/ref" },
        "compatibility_posture": { "type": "string", "enum": ["compatible", "review_required", "breaking", "unknown", "policy_hidden"] }
      }
    },
    "checkpoint_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "checkpoint_ref", "created_before_apply"],
      "properties": {
        "state": { "type": "string", "enum": ["available", "missing", "not_applicable", "policy_hidden"] },
        "checkpoint_ref": { "$ref": "#/$defs/ref" },
        "created_before_apply": { "type": "boolean" }
      }
    },
    "rollback_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "rollback_ref", "rollback_scope"],
      "properties": {
        "state": { "type": "string", "enum": ["available", "compensating_only", "unavailable", "not_applicable", "policy_hidden"] },
        "rollback_ref": { "$ref": "#/$defs/ref" },
        "rollback_scope": { "$ref": "#/$defs/ref" }
      }
    },
    "apply_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_authority", "mutation_posture", "review_required", "policy_boundary_ref", "disabled_reason"],
      "properties": {
        "write_authority": { "type": "string", "enum": ["mutates", "stages", "inspect_only", "redacted_export"] },
        "mutation_posture": { "type": "string", "enum": ["direct_apply", "stage_for_review", "inspect_only", "blocked", "policy_hidden"] },
        "review_required": { "type": "boolean" },
        "policy_boundary_ref": { "$ref": "#/$defs/ref" },
        "disabled_reason": { "$ref": "#/$defs/ref" }
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["package_manager", "review_pane", "project_health_center", "support_export", "release_proof"] }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } },
        "export_fields": { "$ref": "#/$defs/ref_array" },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
