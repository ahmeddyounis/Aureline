{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-learning-component-matrix.schema.json",
  "title": "Aureline M5 learning-mode-toggle, tip-card, guided-exercise-step, glossary-chip-or-card, safe-explanation-banner, and progress-marker component matrix",
  "description": "Export-safe packet freezing Aureline's reusable learning-mode and educational-surface components. The packet names every learnability-facing component family M5 claims that still drifts too easily by surface — learning-mode toggles, tip cards, guided exercise steps, glossary chips or cards, safe explanation banners, and progress markers — and binds each to the claimed M5 onboarding/learnability surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Every component binds the one controlled disposition vocabulary (learning_on, paused, replayable, sandboxed, cached, local_only, not_installed, no_hidden_apply) plus the family-specific controlled vocabularies it carries: learning-mode states and scopes; tip trigger classes and dismissal states; exercise step states and validation modes; glossary source classes and citation states; explanation boundary classes and apply states; and progress ownership classes and states. Hard invariants forbid masking a privacy/offline/local-only state, hiding a cited source, implying a hidden apply or widened mutating authority, and inventing an alternate label for a governed state. Raw docs bodies, raw local paths, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-learning is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_the_m5_learning_mode_toggle_tip_card_guided_exercise_step_glossary_chip_or_card_safe_explanation_banner_and_progress_marker_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "learning_component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "learning_component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "learning_mode_toggle",
        "tip_card",
        "guided_exercise_step",
        "glossary_chip_or_card",
        "safe_explanation_banner",
        "progress_marker"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "learning_on",
        "paused",
        "replayable",
        "sandboxed",
        "cached",
        "local_only",
        "not_installed",
        "no_hidden_apply"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_privacy_or_offline_state",
        "hides_citation_source",
        "implies_hidden_apply_or_mutation",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "masks_privacy_or_offline_state": { "const": false },
        "hides_citation_source": { "const": false },
        "implies_hidden_apply_or_mutation": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    }
  }
}
