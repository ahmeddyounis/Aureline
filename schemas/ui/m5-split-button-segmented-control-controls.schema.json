{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-split-button-segmented-control-controls.schema.json",
  "title": "Aureline M5 split-button and segmented-control controls",
  "description": "Export-safe packet for the alternate-action and mode-toggle implement lane over the frozen M5 core-action-input component matrix. It carries resolved, honest projections of the split button and the segmented control across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved split-button examples (naming the permanent primary action label, the safe default posture with no-color-only emphasis, the interaction disposition, the surface context, the alternate visibility, and the scope impact) and the resolved segmented-control examples (naming the group label, selected segment, mode, interaction disposition, surface context, keyboard cycling, and scope impact). Hard invariants forbid split buttons defaulting to riskier alternates, alternate actions hiding behind the default click, segmented controls masquerading as top-level navigation, and locked/degraded semantics hiding behind generic disabled chrome. Acceptance criteria — split buttons and segmented controls are used by first consumers without hiding alternate behavior or widening risk, mode state and default-action truth remain explicit in compact/overflow/keyboard-only/high-zoom layouts, and release/help/support packets can explain why a split-button default or segmented choice was active at export — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_split_button_and_segmented_control_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "split_button_example": {
      "type": "object",
      "required": [
        "split_button_id",
        "primary_action_label",
        "default_posture",
        "default_emphasis",
        "emphasis_is_destructive",
        "disposition",
        "disposition_is_blocked",
        "surface_context",
        "alternate_visibility",
        "alternate_visible",
        "scope_impact",
        "scope_needs_disclosure",
        "scope_disclosed",
        "stale_state_promoted_riskier_alternate",
        "blocked_state_distinct",
        "command_id",
        "command_route_available",
        "degrade_reason",
        "next_action",
        "default_is_safe_at_a_glance"
      ],
      "properties": {
        "split_button_id": { "$ref": "#/$defs/non_empty_string" },
        "primary_action_label": { "type": "string" },
        "default_posture": { "$ref": "#/$defs/non_empty_string" },
        "default_emphasis": { "$ref": "#/$defs/non_empty_string" },
        "emphasis_is_destructive": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "disposition_is_blocked": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "alternate_visibility": { "$ref": "#/$defs/non_empty_string" },
        "alternate_visible": { "type": "boolean" },
        "scope_impact": { "$ref": "#/$defs/non_empty_string" },
        "scope_needs_disclosure": { "type": "boolean" },
        "scope_disclosed": { "type": "boolean" },
        "stale_state_promoted_riskier_alternate": { "type": "boolean" },
        "blocked_state_distinct": { "type": "boolean" },
        "command_id": { "type": "string" },
        "command_route_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "default_is_safe_at_a_glance": { "type": "boolean" }
      }
    },
    "segmented_control_example": {
      "type": "object",
      "required": [
        "segmented_control_id",
        "group_label",
        "selected_segment_label",
        "selected_segment_shown",
        "mode",
        "disposition",
        "disposition_is_blocked",
        "surface_context",
        "keyboard_cycling_available",
        "oversized_segment_set",
        "masquerades_as_navigation",
        "scope_impact",
        "scope_needs_disclosure",
        "scope_disclosed",
        "blocked_state_distinct",
        "command_id",
        "command_route_available",
        "degrade_reason",
        "next_action",
        "selected_mode_explicit_at_a_glance"
      ],
      "properties": {
        "segmented_control_id": { "$ref": "#/$defs/non_empty_string" },
        "group_label": { "type": "string" },
        "selected_segment_label": { "type": "string" },
        "selected_segment_shown": { "type": "boolean" },
        "mode": { "$ref": "#/$defs/non_empty_string" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "disposition_is_blocked": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "keyboard_cycling_available": { "type": "boolean" },
        "oversized_segment_set": { "type": "boolean" },
        "masquerades_as_navigation": { "type": "boolean" },
        "scope_impact": { "$ref": "#/$defs/non_empty_string" },
        "scope_needs_disclosure": { "type": "boolean" },
        "scope_disclosed": { "type": "boolean" },
        "blocked_state_distinct": { "type": "boolean" },
        "command_id": { "type": "string" },
        "command_route_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "selected_mode_explicit_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "split_button_examples",
        "segmented_control_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "split_buttons_default_to_riskier_alternate",
        "alternate_actions_hidden_behind_default",
        "segmented_controls_masquerade_as_navigation",
        "locked_or_degraded_semantics_hidden_behind_disabled"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "split_button_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/split_button_example" }
        },
        "segmented_control_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/segmented_control_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "split_buttons_default_to_riskier_alternate": { "const": false },
        "alternate_actions_hidden_behind_default": { "const": false },
        "segmented_controls_masquerade_as_navigation": { "const": false },
        "locked_or_degraded_semantics_hidden_behind_disabled": { "const": false }
      }
    }
  }
}
