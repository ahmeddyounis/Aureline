{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-mirror-transition-primitive.schema.json",
  "title": "Aureline M5 mirror-transition primitive",
  "description": "Canonical parity matrix for the reusable M5 mirror-transition primitive: mirror/offline artifact rows, a mode-change / disconnect review sheet, and a channel-association review row that all resolve from one transition context and share one transition identity. Narrows three families of the frozen M5 deployment/continuity component matrix (mirror_offline_artifact_row, mode_change_review_sheet, channel_association_review_row) into one working resolver. Offline and mirror transitions read explicitly rather than as generic warnings (AC1); verification / manifests remain accessible from the same component family across deployment profiles (AC2); mode changes preserve export-before-change and rollback truth (AC3). Raw config bytes, credentials, license keys, and mirror URLs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_mirror_transition_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "update_center",
        "mirror_manager",
        "admin_deployment_console",
        "diagnostics_mirror",
        "support_export_replay",
        "docs_mirror_reference"
      ]
    },
    "artifact_class": {
      "enum": ["docs", "extensions", "models", "updates", "policy_bundles"]
    },
    "source_class": {
      "enum": [
        "first_party_mirror",
        "self_hosted_mirror",
        "offline_bundle",
        "peer_cache",
        "vendor_cdn"
      ]
    },
    "continuity_state": {
      "enum": [
        "current_verified",
        "needs_refresh",
        "offline_cache_only",
        "mirror_unavailable",
        "verification_failed",
        "pinned_offline"
      ]
    },
    "artifact_action": {
      "enum": ["verify_signature", "open_manifest", "refresh_now", "pin_offline"]
    },
    "cache_disposition": {
      "enum": [
        "reuse_valid",
        "invalidate_stale",
        "rebuild_required",
        "preserve_pinned"
      ]
    },
    "rollback_path_state": {
      "enum": ["available", "requires_checkpoint", "unavailable", "not_applicable"]
    },
    "export_field": {
      "enum": [
        "transition_id",
        "artifact_class",
        "source_class",
        "artifact_freshness",
        "signature_verification",
        "continuity_state",
        "cache_disposition",
        "rollback_path",
        "export_before_change",
        "channel_owner"
      ]
    },
    "deployment_mode": {
      "enum": ["desktop", "managed", "self_hosted", "portable", "air_gapped"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_reported"]
    },
    "signature_state": {
      "enum": [
        "verified",
        "unverified",
        "signature_mismatch",
        "verification_deferred"
      ]
    },
    "boundary_change": {
      "enum": [
        "state_root_migration",
        "channel_switch",
        "updater_ownership_change",
        "mirror_reattach",
        "online_offline_transition"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "control_plane_impaired",
        "mirror_stale",
        "offline_cache_only",
        "signature_unverified",
        "rollout_paused",
        "handler_ownership_contested",
        "state_root_unavailable",
        "residual_vendor_dependency",
        "provenance_incomplete"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "artifact_class",
        "source_class",
        "freshness",
        "signature_state",
        "mirror_reachable",
        "pinned_offline",
        "needs_refresh",
        "manifest_ref",
        "verify_available",
        "open_manifest_available",
        "stale_not_shown_as_current"
      ],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/ref" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "freshness": { "$ref": "#/$defs/truth_mode" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "mirror_reachable": { "type": "boolean" },
        "pinned_offline": { "type": "boolean" },
        "needs_refresh": { "type": "boolean" },
        "manifest_ref": { "$ref": "#/$defs/ref" },
        "verify_available": { "const": true },
        "open_manifest_available": { "const": true },
        "stale_not_shown_as_current": { "type": "boolean" }
      }
    },
    "transition_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "surface_label",
        "deployment_mode",
        "artifacts",
        "from_mode",
        "to_mode",
        "boundary_change",
        "preserved_local_state_ref",
        "cache_disposition",
        "rollback_path_state",
        "reviewed_before_change",
        "export_before_change_available",
        "channel_ref",
        "handler_association_ref",
        "last_writer_wins_capture",
        "reviewed_before_apply",
        "discloses_current_owner"
      ],
      "properties": {
        "transition_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string", "minLength": 1 },
        "deployment_mode": { "$ref": "#/$defs/deployment_mode" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_input" }
        },
        "from_mode": { "$ref": "#/$defs/deployment_mode" },
        "to_mode": { "$ref": "#/$defs/deployment_mode" },
        "boundary_change": { "$ref": "#/$defs/boundary_change" },
        "preserved_local_state_ref": { "$ref": "#/$defs/ref" },
        "affected_managed_feature_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        },
        "cache_disposition": { "$ref": "#/$defs/cache_disposition" },
        "rollback_path_state": { "$ref": "#/$defs/rollback_path_state" },
        "reviewed_before_change": { "const": true },
        "export_before_change_available": { "const": true },
        "channel_ref": { "$ref": "#/$defs/ref" },
        "handler_association_ref": { "$ref": "#/$defs/ref" },
        "last_writer_wins_capture": { "const": false },
        "reviewed_before_apply": { "const": true },
        "discloses_current_owner": { "const": true },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_artifact_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "artifact_ref",
        "artifact_class",
        "source_class",
        "freshness",
        "signature_state",
        "continuity_state",
        "pinned_offline",
        "manifest_ref",
        "actions",
        "discloses_freshness",
        "stale_not_shown_as_current",
        "verification_accessible",
        "exportable"
      ],
      "properties": {
        "transition_id": { "$ref": "#/$defs/id" },
        "artifact_ref": { "$ref": "#/$defs/ref" },
        "artifact_class": { "$ref": "#/$defs/artifact_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "freshness": { "$ref": "#/$defs/truth_mode" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "continuity_state": { "$ref": "#/$defs/continuity_state" },
        "pinned_offline": { "type": "boolean" },
        "manifest_ref": { "$ref": "#/$defs/ref" },
        "actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/artifact_action" }
        },
        "discloses_freshness": { "const": true },
        "stale_not_shown_as_current": { "const": true },
        "verification_accessible": { "const": true },
        "exportable": { "const": true }
      }
    },
    "resolved_mode_change_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "from_mode",
        "to_mode",
        "boundary_change",
        "preserved_local_state_ref",
        "affected_managed_feature_refs",
        "cache_disposition",
        "artifact_posture",
        "rollback_path_state",
        "reviewed_before_change",
        "export_before_change_available",
        "reversible",
        "discloses_stale_and_usable"
      ],
      "properties": {
        "transition_id": { "$ref": "#/$defs/id" },
        "from_mode": { "$ref": "#/$defs/deployment_mode" },
        "to_mode": { "$ref": "#/$defs/deployment_mode" },
        "boundary_change": { "$ref": "#/$defs/boundary_change" },
        "preserved_local_state_ref": { "$ref": "#/$defs/ref" },
        "affected_managed_feature_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        },
        "cache_disposition": { "$ref": "#/$defs/cache_disposition" },
        "artifact_posture": { "$ref": "#/$defs/continuity_state" },
        "rollback_path_state": { "$ref": "#/$defs/rollback_path_state" },
        "reviewed_before_change": { "const": true },
        "export_before_change_available": { "const": true },
        "reversible": { "const": true },
        "discloses_stale_and_usable": { "const": true }
      }
    },
    "resolved_channel_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "channel_ref",
        "handler_association_ref",
        "last_writer_wins_capture",
        "reviewed_before_apply",
        "discloses_current_owner"
      ],
      "properties": {
        "transition_id": { "$ref": "#/$defs/id" },
        "channel_ref": { "$ref": "#/$defs/ref" },
        "handler_association_ref": { "$ref": "#/$defs/ref" },
        "last_writer_wins_capture": { "const": false },
        "reviewed_before_apply": { "const": true },
        "discloses_current_owner": { "const": true }
      }
    },
    "resolved_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "artifact_rows",
        "mode_change_sheet",
        "channel_row",
        "transition_explicit_not_generic",
        "verification_accessible_across_profiles",
        "export_and_rollback_preserved"
      ],
      "properties": {
        "transition_id": { "$ref": "#/$defs/id" },
        "artifact_rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_artifact_row" }
        },
        "mode_change_sheet": { "$ref": "#/$defs/resolved_mode_change_sheet" },
        "channel_row": { "$ref": "#/$defs/resolved_channel_row" },
        "transition_explicit_not_generic": { "const": true },
        "verification_accessible_across_profiles": { "const": true },
        "export_and_rollback_preserved": { "const": true },
        "degraded": {
          "oneOf": [{ "$ref": "#/$defs/degraded_state" }, { "type": "null" }]
        }
      }
    },
    "transition_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/transition_input" },
        "resolved": { "$ref": "#/$defs/resolved_transition" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "artifact_classes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_transitions",
        "shows_stale_as_current",
        "hides_verification",
        "forces_blind_switch",
        "captures_default_handler"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "artifact_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_class" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_transitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transition_case" }
        },
        "shows_stale_as_current": { "const": false },
        "hides_verification": { "const": false },
        "forces_blind_switch": { "const": false },
        "captures_default_handler": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "artifact_classes",
        "source_classes",
        "continuity_states",
        "artifact_actions",
        "cache_dispositions",
        "rollback_path_states",
        "export_fields",
        "deployment_modes",
        "truth_modes",
        "signature_states",
        "boundary_changes",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "artifact_classes": { "type": "array", "items": { "type": "string" } },
        "source_classes": { "type": "array", "items": { "type": "string" } },
        "continuity_states": { "type": "array", "items": { "type": "string" } },
        "artifact_actions": { "type": "array", "items": { "type": "string" } },
        "cache_dispositions": { "type": "array", "items": { "type": "string" } },
        "rollback_path_states": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "deployment_modes": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "signature_states": { "type": "array", "items": { "type": "string" } },
        "boundary_changes": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "transition_identity_preserved_across_surfaces",
        "stale_never_shown_as_current",
        "verification_manifest_always_accessible",
        "export_before_change_and_rollback_always_preserved",
        "support_export_reconstructs_transition",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "transition_identity_preserved_across_surfaces": { "const": true },
        "stale_never_shown_as_current": { "const": true },
        "verification_manifest_always_accessible": { "const": true },
        "export_before_change_and_rollback_always_preserved": { "const": true },
        "support_export_reconstructs_transition": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mirror_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "review_sheet_reads_single_transition_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "mirror_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "review_sheet_reads_single_transition_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "deployment_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "deployment_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
