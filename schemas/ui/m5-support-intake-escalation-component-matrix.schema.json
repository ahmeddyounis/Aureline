{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-intake-escalation-component-matrix.schema.json",
  "title": "Aureline M5 support-scenario-picker-row, issue-report-builder-step, escalation-packet-summary, handoff-timeline-row, and unsafe-fix-blocked-note component matrix",
  "description": "Export-safe packet freezing Aureline's reusable support-intake and escalation components. The packet names every supportability- and escalation-facing component family M5 claims that still drifts too easily by surface — support-scenario picker rows, issue-report builder steps, escalation-packet summaries, handoff-timeline rows, and unsafe-fix blocked notes — and binds each to the claimed M5 support/escalation surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: scenario families, incident scopes, and the Doctor finding families they bind; report-builder step kinds and evidence classes; escalation-packet destinations and redaction states; handoff stages and next human steps; unsafe-fix block reasons and approved repair classes; and the shared case dispositions (local-only, vendor-case, uncategorized, unsafe-fix-blocked). Hard invariants forbid masking a scenario family or incident scope, hiding why an unsafe fix is blocked, inventing an alternate label for a governed state, and bypassing the escalation-packet minimums. Raw log bodies, raw local paths, raw usernames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-support is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_support_scenario_picker_row_issue_report_builder_step_escalation_packet_summary_handoff_timeline_row_and_unsafe_fix_blocked_note_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "support_case_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_case_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "support_scenario_picker_row",
        "issue_report_builder_step",
        "escalation_packet_summary",
        "handoff_timeline_row",
        "unsafe_fix_blocked_note"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_scenario_or_scope",
        "hides_unsafe_fix_block_reason",
        "invents_alternate_state_label",
        "bypasses_escalation_packet_minimums"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "masks_scenario_or_scope": { "const": false },
        "hides_unsafe_fix_block_reason": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "bypasses_escalation_packet_minimums": { "const": false }
      }
    }
  }
}
