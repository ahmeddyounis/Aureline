{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-marketplace-result-row-detail-fact-grid-controls.schema.json",
  "title": "Aureline M5 marketplace-result-row and marketplace-detail-fact-grid controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 marketplace / install-review component matrix. It carries resolved, honest projections of the marketplace result row and the marketplace detail fact grid across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved result row examples (naming the artifact identity, registry source class, compatibility state, host/runtime model, permission posture, activation-budget band, support/trust tier, and publisher continuity) and the resolved detail fact grid examples (adding richer version ranges, lifecycle state, and docs/changelog/open-issues linkage). Hard invariants forbid collapsing the registry source class across public/mirrored/enterprise, hiding permission widening or activation cost behind compact chrome, hiding a publisher transfer or deprecation, and presenting an incompatible or over-budget artifact as ready to install. Acceptance criteria — the registry source class stays explicit and users can compare key facts, and list and detail share one fact grammar and source vocabulary — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_marketplace_result_row_and_marketplace_detail_fact_grid_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "source_disposition": {
      "type": ["string", "null"],
      "enum": [
        "public",
        "mirrored",
        "enterprise",
        "side_load",
        "verified",
        "transferred",
        "deprecated",
        "limited",
        "incompatible",
        "over_budget",
        "throttled",
        "quarantined",
        "disable_scope",
        "rollback_compatibility",
        null
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "marketplace_result_row_example": {
      "type": "object",
      "required": [
        "row_id",
        "artifact_identity",
        "registry_source",
        "source_disposition",
        "compatibility",
        "is_installable",
        "host_runtime_model",
        "permission_posture",
        "permission_widened",
        "activation_budget",
        "within_activation_budget",
        "trust_tier",
        "publisher_continuity",
        "publisher_changed",
        "collapses_source_class",
        "presents_incompatible_or_over_budget_as_ready",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "comparable_at_a_glance"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "registry_source": { "$ref": "#/$defs/non_empty_string" },
        "source_disposition": { "$ref": "#/$defs/source_disposition" },
        "compatibility": { "$ref": "#/$defs/non_empty_string" },
        "is_installable": { "type": "boolean" },
        "host_runtime_model": { "$ref": "#/$defs/non_empty_string" },
        "permission_posture": { "$ref": "#/$defs/non_empty_string" },
        "permission_widened": { "type": "boolean" },
        "activation_budget": { "$ref": "#/$defs/non_empty_string" },
        "within_activation_budget": { "type": "boolean" },
        "trust_tier": { "$ref": "#/$defs/non_empty_string" },
        "publisher_continuity": { "$ref": "#/$defs/non_empty_string" },
        "publisher_changed": { "type": "boolean" },
        "collapses_source_class": { "type": "boolean" },
        "presents_incompatible_or_over_budget_as_ready": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "comparable_at_a_glance": { "type": "boolean" }
      }
    },
    "marketplace_detail_fact_grid_example": {
      "type": "object",
      "required": [
        "grid_id",
        "artifact_identity",
        "registry_source",
        "source_disposition",
        "compatibility",
        "is_installable",
        "host_runtime_model",
        "permission_posture",
        "permission_widened",
        "activation_budget",
        "within_activation_budget",
        "trust_tier",
        "publisher_continuity",
        "publisher_changed",
        "version_range",
        "lifecycle",
        "docs_linked",
        "changelog_linked",
        "open_issues_linked",
        "collapses_source_class",
        "presents_incompatible_or_over_budget_as_ready",
        "degrade_reason",
        "next_action",
        "fully_legible"
      ],
      "properties": {
        "grid_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "registry_source": { "$ref": "#/$defs/non_empty_string" },
        "source_disposition": { "$ref": "#/$defs/source_disposition" },
        "compatibility": { "$ref": "#/$defs/non_empty_string" },
        "is_installable": { "type": "boolean" },
        "host_runtime_model": { "$ref": "#/$defs/non_empty_string" },
        "permission_posture": { "$ref": "#/$defs/non_empty_string" },
        "permission_widened": { "type": "boolean" },
        "activation_budget": { "$ref": "#/$defs/non_empty_string" },
        "within_activation_budget": { "type": "boolean" },
        "trust_tier": { "$ref": "#/$defs/non_empty_string" },
        "publisher_continuity": { "$ref": "#/$defs/non_empty_string" },
        "publisher_changed": { "type": "boolean" },
        "version_range": { "type": "string" },
        "lifecycle": { "$ref": "#/$defs/non_empty_string" },
        "docs_linked": { "type": "boolean" },
        "changelog_linked": { "type": "boolean" },
        "open_issues_linked": { "type": "boolean" },
        "collapses_source_class": { "type": "boolean" },
        "presents_incompatible_or_over_budget_as_ready": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fully_legible": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "marketplace_result_row_examples",
        "marketplace_detail_fact_grid_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_registry_source_class_across_public_mirrored_enterprise",
        "hides_permission_widening_or_activation_cost",
        "hides_publisher_transfer_or_deprecation",
        "presents_incompatible_or_over_budget_as_ready"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "marketplace_result_row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/marketplace_result_row_example" }
        },
        "marketplace_detail_fact_grid_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/marketplace_detail_fact_grid_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_registry_source_class_across_public_mirrored_enterprise": { "const": false },
        "hides_permission_widening_or_activation_cost": { "const": false },
        "hides_publisher_transfer_or_deprecation": { "const": false },
        "presents_incompatible_or_over_budget_as_ready": { "const": false }
      }
    }
  }
}
