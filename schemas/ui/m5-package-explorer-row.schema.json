{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-package-explorer-row.schema.json",
  "title": "Aureline M5 package explorer rows",
  "description": "Export-safe packet implementing the reusable M5 package-explorer-row component. Each row answers, from the component alone, what package the user is acting on, which ecosystem it belongs to, its current and candidate version, whether it is a direct or transitive dependency, which manifest scope owns it, which registry answered for it, and what the license, advisory, and changelog signals say. The row's action is derived from the lifecycle state and the direct/transitive relation, so an installed, available, outdated, imported, policy-pinned, or remove-blocked package never presents the same undifferentiated action, and a transitive or blocked package always names why it cannot be mutated directly. Raw manifest bodies, raw lockfile bodies, registry credentials, private registry URLs, and live registry responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "rows",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "package_explorer_row_controls"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package_explorer_row"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_trigger"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "explorer_component": {
      "type": "string",
      "const": "package_explorer_row"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "installed",
        "available",
        "outdated",
        "imported",
        "policy_pinned",
        "remove_blocked"
      ]
    },
    "dependency_relation": {
      "type": "string",
      "enum": [
        "direct",
        "transitive",
        "direct_and_transitive"
      ]
    },
    "manifest_scope_class": {
      "type": "string",
      "enum": [
        "runtime_dependency",
        "dev_dependency",
        "optional_dependency",
        "peer_dependency",
        "build_dependency",
        "workspace_catalog"
      ]
    },
    "registry_source_class": {
      "type": "string",
      "enum": [
        "public_registry",
        "private_registry",
        "enterprise_mirror",
        "offline_snapshot",
        "git_source",
        "path_or_vendored"
      ]
    },
    "degradation_state": {
      "type": "string",
      "enum": [
        "resolved_exact",
        "manifest_range_only",
        "mirror_backed",
        "offline_snapshot_only",
        "auth_required_unsatisfied",
        "unknown_or_stale"
      ]
    },
    "license_signal": {
      "type": "string",
      "enum": [
        "allowed",
        "review_required",
        "disallowed",
        "unknown"
      ]
    },
    "advisory_signal": {
      "type": "string",
      "enum": [
        "no_known_advisory",
        "advisory_low",
        "advisory_high",
        "advisory_critical",
        "advisory_unknown"
      ]
    },
    "changelog_signal": {
      "type": "string",
      "enum": [
        "available",
        "partial",
        "unavailable",
        "breaking_change_noted"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "staged_review_no_write",
        "write_back_checkpointed",
        "regenerate_only_no_manual_edit",
        "compensating_only_no_clean_revert",
        "not_applicable"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "registry_unreachable",
        "auth_required",
        "mirror_backed_only",
        "offline_snapshot_only",
        "lockfile_divergent",
        "script_or_native_build_risk",
        "broad_lockfile_regeneration",
        "rollback_unavailable",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "package_workspace",
        "dependency_explorer",
        "install_update_review",
        "registry_auth_workspace",
        "rollback_recovery",
        "browser_companion",
        "cli_headless",
        "support_export",
        "help_about"
      ]
    },
    "package_explorer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "package_label",
        "ecosystem",
        "current_version",
        "candidate_version",
        "relation",
        "lifecycle",
        "manifest_scope",
        "manifest_scope_disclosure",
        "relation_note",
        "registry_source",
        "registry_source_disclosure",
        "degradation_state",
        "degradation_note",
        "license_signal",
        "advisory_signal",
        "changelog_signal",
        "signal_disclosure",
        "offers_direct_action",
        "primary_action_label",
        "action_provenance_note",
        "blocked_reason",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/explorer_component"
        },
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "package_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "ecosystem": {
          "$ref": "#/$defs/non_empty_string"
        },
        "current_version": {
          "type": "string"
        },
        "candidate_version": {
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/dependency_relation"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle_state"
        },
        "manifest_scope": {
          "$ref": "#/$defs/manifest_scope_class"
        },
        "manifest_scope_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "relation_note": {
          "type": "string"
        },
        "registry_source": {
          "$ref": "#/$defs/registry_source_class"
        },
        "registry_source_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "degradation_state": {
          "$ref": "#/$defs/degradation_state"
        },
        "degradation_note": {
          "type": "string"
        },
        "license_signal": {
          "$ref": "#/$defs/license_signal"
        },
        "advisory_signal": {
          "$ref": "#/$defs/advisory_signal"
        },
        "changelog_signal": {
          "$ref": "#/$defs/changelog_signal"
        },
        "signal_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "offers_direct_action": {
          "type": "boolean"
        },
        "primary_action_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "action_provenance_note": {
          "type": "string"
        },
        "blocked_reason": {
          "type": "string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "degradation_state": {
                "const": "resolved_exact"
              }
            }
          },
          "else": {
            "properties": {
              "degradation_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "offers_direct_action": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "action_provenance_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_identity_always_explicit",
        "manifest_scope_always_explicit",
        "direct_transitive_relation_explicit",
        "registry_source_always_explicit",
        "license_advisory_changelog_signals_explicit",
        "lifecycle_state_visually_distinct",
        "action_truth_matches_state",
        "no_generic_action_without_provenance",
        "transitive_and_blocked_states_name_reason",
        "mirror_offline_degradation_explicit",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "package_identity_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "manifest_scope_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "direct_transitive_relation_explicit": {
          "type": "boolean",
          "const": true
        },
        "registry_source_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "license_advisory_changelog_signals_explicit": {
          "type": "boolean",
          "const": true
        },
        "lifecycle_state_visually_distinct": {
          "type": "boolean",
          "const": true
        },
        "action_truth_matches_state": {
          "type": "boolean",
          "const": true
        },
        "no_generic_action_without_provenance": {
          "type": "boolean",
          "const": true
        },
        "transitive_and_blocked_states_name_reason": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_degradation_explicit": {
          "type": "boolean",
          "const": true
        },
        "copy_and_export_safe": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_shows_label_scope_and_relation",
        "lifecycle_state_shown_distinctly",
        "registry_source_and_signals_shown",
        "action_reflects_state_and_provenance",
        "blocked_reason_shown_inline",
        "cli_headless_shows_row_truth",
        "support_export_shows_row_truth",
        "help_about_shows_row_truth"
      ],
      "properties": {
        "row_shows_label_scope_and_relation": {
          "type": "boolean",
          "const": true
        },
        "lifecycle_state_shown_distinctly": {
          "type": "boolean",
          "const": true
        },
        "registry_source_and_signals_shown": {
          "type": "boolean",
          "const": true
        },
        "action_reflects_state_and_provenance": {
          "type": "boolean",
          "const": true
        },
        "blocked_reason_shown_inline": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_row_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_row_truth": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_row_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
