{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-provider-account-offline-capture-component-matrix.schema.json",
  "title": "Aureline M5 provider-account-row, project-or-board-mapping-row, sync-behavior-row, offline-capture-row, and privacy-redaction-row component matrix",
  "description": "Export-safe packet freezing Aureline's reusable provider-boundary settings and status components. The packet names every provider-account- and offline-capture-facing component family M5 claims that still drifts too easily by surface — provider-account rows, project/board mapping rows, sync-behavior rows, offline-capture rows, and privacy/redaction rows — and binds each to the claimed M5 provider surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: provider identity classes, account connection states (not_configured, signed_in, limited_scope, stale_session, offline_cached_read, policy_blocked), and tenant scopes; mapping origins and target kinds; sync modes and effective write scopes; offline-capture states and shared queued-draft states; and redaction classes and metadata-safe export boundaries. Hard invariants forbid masking a connection state or tenant/write scope, hiding a redaction class or export boundary, inventing an alternate label for a governed state, and silently assuming a default publish destination. Raw comment bodies, raw local paths, raw usernames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-provider is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_provider_account_row_project_or_board_mapping_row_sync_behavior_row_offline_capture_row_and_privacy_redaction_row_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "provider_account_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "provider_account_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "provider_account_row",
        "project_or_board_mapping_row",
        "sync_behavior_row",
        "offline_capture_row",
        "privacy_redaction_row"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_connection_or_scope",
        "hides_export_or_redaction_boundary",
        "invents_alternate_state_label",
        "assumes_default_destination_silently"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "masks_connection_or_scope": { "const": false },
        "hides_export_or_redaction_boundary": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "assumes_default_destination_silently": { "const": false }
      }
    }
  }
}
