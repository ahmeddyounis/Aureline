{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-provider-offline-capture-privacy-redaction-row.schema.json",
  "title": "Aureline M5 provider offline-capture / privacy-redaction row primitive",
  "description": "Export-safe packet shipping the reusable M5 offline-capture row and privacy/redaction row as two primitives. The packet binds one row per claimed provider surface consumer — the offline-capture panel, the privacy/redaction panel, the provider status bar, the headless/CLI capture surface, and the support privacy export — to the shared offline-capture-row and privacy-row anatomy, the offline-capture state, the capture kind (bug report/task update/blocked-work note), the packet-destination class (routed/local-bundle/unrouted), the queued-draft count, the redaction default, the derived offline-capture-row posture, the derived publish-later behavior, bounded reveal/defer/retry/clear/export offline actions, the redaction class, the export boundary, the policy source, the telemetry/event limit, the derived privacy-row posture, the derived support-bundle treatment, the copied/exported and withheld field classes, and bounded reveal/view-policy/adjust/export/reviewed-escalation privacy actions. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked offline and privacy resolution cases proving the resolvers, and five hard invariants: it never assumes a default publish destination silently, never hides what remains queued locally, never drops prepared handoff state, never hides its export or redaction boundary, and never leaks credentials or endpoints. Raw comment bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_offline_capture_rows_and_privacy_redaction_rows_with_packet_destination_queued_draft_count_export_clear_actions_and_metadata_safe_boundary_truth_across_claimed_m5_provider_workflows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "provider_offline_privacy_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "provider_offline_privacy_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "offline_anatomy_parts",
        "privacy_anatomy_parts",
        "capture_states",
        "capture_kinds",
        "destination_classes",
        "capture_row_postures",
        "publish_later_behaviors",
        "offline_row_actions",
        "redaction_classes",
        "export_boundaries",
        "policy_sources",
        "telemetry_limits",
        "support_bundle_treatments",
        "privacy_field_classes",
        "privacy_row_postures",
        "privacy_row_actions",
        "queued_draft_states",
        "offline_export_fields",
        "privacy_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "offline_examples",
        "privacy_examples",
        "assumes_default_destination_silently",
        "hides_queued_local_work",
        "drops_prepared_handoff_state",
        "hides_export_or_redaction_boundary",
        "leaks_credentials_or_endpoints"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "offline_capture_panel",
            "privacy_redaction_panel",
            "provider_status_bar",
            "headless_cli_capture",
            "support_privacy_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "offline_anatomy_parts": { "type": "array", "minItems": 1 },
        "privacy_anatomy_parts": { "type": "array", "minItems": 1 },
        "capture_states": { "type": "array", "minItems": 1 },
        "capture_kinds": { "type": "array", "minItems": 1 },
        "destination_classes": { "type": "array", "minItems": 1 },
        "capture_row_postures": { "type": "array", "minItems": 1 },
        "publish_later_behaviors": { "type": "array", "minItems": 1 },
        "offline_row_actions": { "type": "array", "minItems": 1 },
        "redaction_classes": { "type": "array", "minItems": 1 },
        "export_boundaries": { "type": "array", "minItems": 1 },
        "policy_sources": { "type": "array", "minItems": 1 },
        "telemetry_limits": { "type": "array", "minItems": 1 },
        "support_bundle_treatments": { "type": "array", "minItems": 1 },
        "privacy_field_classes": { "type": "array", "minItems": 1 },
        "privacy_row_postures": { "type": "array", "minItems": 1 },
        "privacy_row_actions": { "type": "array", "minItems": 1 },
        "queued_draft_states": { "type": "array", "minItems": 1 },
        "offline_export_fields": { "type": "array", "minItems": 1 },
        "privacy_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "offline_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/offline_example" }
        },
        "privacy_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/privacy_example" }
        },
        "assumes_default_destination_silently": { "const": false },
        "hides_queued_local_work": { "const": false },
        "drops_prepared_handoff_state": { "const": false },
        "hides_export_or_redaction_boundary": { "const": false },
        "leaks_credentials_or_endpoints": { "const": false }
      }
    },
    "offline_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "capture_state",
            "capture_kind",
            "destination_class",
            "queued_draft_state",
            "redaction_default",
            "queued_draft_count",
            "packet_destination_label",
            "capture_ref",
            "row_posture",
            "publish_later_behavior",
            "available_actions",
            "shows_packet_destination",
            "has_queued_drafts",
            "retains_prepared_handoff",
            "hides_queued_local_work",
            "assumes_default_destination_silently"
          ]
        }
      }
    },
    "privacy_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "redaction_class",
            "export_boundary",
            "policy_source",
            "telemetry_limit",
            "redaction_ref",
            "row_posture",
            "support_bundle_treatment",
            "exported_field_classes",
            "withheld_field_classes",
            "available_actions",
            "can_export",
            "metadata_safe_default_explicit",
            "withholds_credentials_and_endpoints",
            "escalation_requires_review",
            "hides_export_or_redaction_boundary"
          ]
        }
      }
    }
  }
}
