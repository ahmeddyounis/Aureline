{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-tab-strip.schema.json",
  "title": "Aureline M5 tab strip component",
  "description": "Canonical single-instance shape of the M5 tab strip navigation / content component. Every claimed M5 tab strip references this schema or the combined m5-navigation-content-component-matrix.schema.json rather than reinventing its own active-context, hierarchy, disclosure, selection, count-scope, item-state, density, or local-action wording. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "tabs_masquerade_as_top_level_workflow_navigation",
    "hides_counts_or_blocked_rows_behind_ambiguous_ellipsis",
    "makes_tree_list_or_table_actions_hover_only",
    "panel_header_becomes_cluttered_secondary_toolbar",
    "collapses_exact_loaded_and_all_matching_scopes_into_one_total"
  ],
  "properties": {
    "component_family": {
      "const": "tab_strip"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "preview",
          "pinned",
          "modified",
          "read_only",
          "blocked",
          "exact_count",
          "loaded_count",
          "all_matching_count",
          "hidden_by_filter",
          "hidden_by_policy",
          "overflowed_local_action",
          "stale_or_partial_hierarchy"
        ]
      }
    },
    "active_context_states": {
      "type": "array"
    },
    "hierarchy_path_states": {
      "type": "array"
    },
    "disclosure_states": {
      "type": "array"
    },
    "selection_states": {
      "type": "array"
    },
    "count_scopes": {
      "type": "array"
    },
    "item_state_flags": {
      "type": "array"
    },
    "density_variants": {
      "type": "array"
    },
    "local_action_budgets": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "tabs_masquerade_as_top_level_workflow_navigation": {
      "const": false
    },
    "hides_counts_or_blocked_rows_behind_ambiguous_ellipsis": {
      "const": false
    },
    "makes_tree_list_or_table_actions_hover_only": {
      "const": false
    },
    "panel_header_becomes_cluttered_secondary_toolbar": {
      "const": false
    },
    "collapses_exact_loaded_and_all_matching_scopes_into_one_total": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
