{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-visual-designer-component-consumer.schema.json",
  "title": "M5 Visual-Designer Component Consumer Packet",
  "description": "Shared framework-pack, preview-runtime, browser-runtime, docs-demo, and onboarding consumers proving the frozen M5 visual-designer component families are reusable primitives with label, token, and degraded-state parity across claimed M5 handoff surfaces (M05-809).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_visual_designer_component_consumer_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "design_canvas",
        "structure_tree_row",
        "property_inspector_row",
        "source_sync_chip",
        "breakpoint_preview_row",
        "unsupported_construct_card",
        "round_trip_conflict_banner"
      ]
    },
    "consumer_group": {
      "type": "string",
      "enum": [
        "framework_pack",
        "preview_runtime",
        "browser_runtime_demo",
        "docs_onboarding"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "framework_pack_preview_lane",
        "preview_runtime_inspector",
        "browser_runtime_inspector",
        "demo_handoff",
        "docs_onboarding_walkthrough",
        "help_center"
      ]
    },
    "authority_mode": {
      "type": "string",
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "compare_only",
        "export_only",
        "policy_blocked"
      ]
    },
    "label_parity_state": {
      "type": "string",
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "handoff_target": {
      "type": "string",
      "enum": [
        "none",
        "companion_app",
        "browser_readonly",
        "handoff_packet",
        "cli_headless"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "source_ownership",
        "state",
        "sync_or_freshness",
        "keyboard_route"
      ]
    },
    "design_system_fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_consistent",
        "density_consistent",
        "motion_consistent",
        "design_system_contract_ref"
      ],
      "properties": {
        "token_consistent": { "type": "boolean" },
        "density_consistent": { "type": "boolean" },
        "motion_consistent": { "type": "boolean" },
        "design_system_contract_ref": { "type": "string", "minLength": 1 }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_group",
        "consumer_surface",
        "component_family",
        "canonical_family_schema_ref",
        "references_canonical_not_local_prose",
        "authority_mode",
        "design_system",
        "label_parity",
        "handoff_target",
        "copy_export",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_visual_designer_component_consumer_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_group": { "$ref": "#/$defs/consumer_group" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_packet_refs": { "type": "array", "items": { "type": "string" } },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "design_system": { "$ref": "#/$defs/design_system_fidelity" },
        "preserved_label_families": {
          "type": "array",
          "items": { "type": "string" }
        },
        "degraded_state_vocab": { "type": "array", "items": { "type": "string" } },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity_state" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_group_count",
        "consumer_surface_count",
        "component_family_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_keep_design_system_fidelity",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "framework_pack_consumer_present",
        "preview_runtime_consumer_present",
        "browser_runtime_demo_consumer_present",
        "docs_onboarding_consumer_present",
        "label_family_coverage_complete",
        "families_reused_across_groups"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_group_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_keep_design_system_fidelity": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "framework_pack_consumer_present": { "type": "boolean" },
        "preview_runtime_consumer_present": { "type": "boolean" },
        "browser_runtime_demo_consumer_present": { "type": "boolean" },
        "docs_onboarding_consumer_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "families_reused_across_groups": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
