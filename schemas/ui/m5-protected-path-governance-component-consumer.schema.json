{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-protected-path-governance-component-consumer.schema.json",
  "title": "M5 Protected-Path Governance-Component Consumer Parity Packet",
  "description": "Export-safe packet binding the eight shared M5 protected-path governance components (protected-path row, ownership card, approver matrix, review-pack summary, public-surface diff card, merge-control banner, DRI-registry row, merge-readiness strip) to the review-workspace, merge-queue, release-center, Help, support, shiproom, and CLI/export consumers that render them, proving owner-coverage / approver-state / public-surface-impact / merge-blocker parity for the same governed change across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "governance_component_consumer_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "protected_path_row",
        "ownership_card",
        "approver_matrix",
        "review_pack_summary",
        "public_surface_diff_card",
        "merge_control_banner",
        "dri_registry_row",
        "merge_readiness_strip"
      ]
    },
    "consumer": {
      "type": "string",
      "enum": [
        "review_workspace",
        "merge_queue",
        "release_center",
        "help_surface",
        "support_packet",
        "shiproom",
        "cli_export"
      ]
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "provider_authoritative_fresh",
        "enforcement_advisory_or_local_estimate",
        "owner_backup_coverage_missing",
        "approver_state_expired_or_waived",
        "public_surface_evidence_missing",
        "proof_stale_relative_to_change"
      ]
    },
    "projection_mode": {
      "type": "string",
      "enum": [
        "full_parity",
        "enforcement_narrowed",
        "coverage_narrowed",
        "approval_narrowed",
        "public_surface_narrowed",
        "stale_narrowed"
      ]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "enforcement_advisory_or_local_estimate",
        "owner_backup_coverage_missing",
        "approver_state_expired_or_waived",
        "public_surface_diff_or_migration_missing",
        "proof_stale_relative_to_change"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": [
        "review_enforcement_authority",
        "review_owner_coverage",
        "review_approver_state",
        "review_public_surface_evidence",
        "refresh_proof"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "governance_state_vocab": {
      "type": "string",
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "owner_coverage_backup_missing",
        "approver_state_expired",
        "review_pack_stale",
        "public_surface_diff_unavailable",
        "migration_evidence_missing",
        "dri_coverage_gap",
        "escalation_handoff_unavailable",
        "trust_narrowing",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "parity_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_coverage_label",
        "approver_state_label",
        "public_surface_impact_label",
        "merge_blocker_label"
      ],
      "properties": {
        "owner_coverage_label": { "type": "string", "minLength": 1 },
        "approver_state_label": { "type": "string", "minLength": 1 },
        "public_surface_impact_label": { "type": "string", "minLength": 1 },
        "merge_blocker_label": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_facets_note", "next_action", "next_action_label"],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_facets_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "governed_change_id",
        "governed_change_label",
        "component",
        "consumer",
        "evidence_state",
        "projection_mode",
        "parity_facets",
        "parity_state",
        "narrow_banner",
        "enforcement_authority_note",
        "evidence_continuity_note",
        "governance_state_vocab",
        "advisory_owner_reads_as_provider_authoritative",
        "guarded_merge_hides_missing_backup_coverage",
        "guarded_merge_hides_expired_approver_state",
        "public_surface_change_hides_diff_or_migration_evidence",
        "rewords_governance_labels_per_surface",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "governed_change_id": { "type": "string", "minLength": 1 },
        "governed_change_label": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "consumer": { "$ref": "#/$defs/consumer" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "projection_mode": { "$ref": "#/$defs/projection_mode" },
        "parity_facets": { "$ref": "#/$defs/parity_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_banner": {
          "oneOf": [{ "$ref": "#/$defs/narrow_banner" }, { "type": "null" }]
        },
        "enforcement_authority_note": { "type": "string" },
        "evidence_continuity_note": { "type": "string" },
        "governance_state_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/governance_state_vocab" }
        },
        "advisory_owner_reads_as_provider_authoritative": { "const": false },
        "guarded_merge_hides_missing_backup_coverage": { "const": false },
        "guarded_merge_hides_expired_approver_state": { "const": false },
        "public_surface_change_hides_diff_or_migration_evidence": { "const": false },
        "rewords_governance_labels_per_surface": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Full parity renders never carry a narrow banner.",
          "if": { "properties": { "projection_mode": { "const": "full_parity" } } },
          "then": { "properties": { "narrow_banner": { "type": "null" } } }
        },
        {
          "comment": "Narrowed renders must carry a narrow banner.",
          "if": {
            "properties": {
              "projection_mode": {
                "enum": [
                  "enforcement_narrowed",
                  "coverage_narrowed",
                  "approval_narrowed",
                  "public_surface_narrowed",
                  "stale_narrowed"
                ]
              }
            }
          },
          "then": {
            "properties": { "narrow_banner": { "$ref": "#/$defs/narrow_banner" } }
          }
        },
        {
          "comment": "Advisory / local-estimate enforcement and stale proof must keep an explicit enforcement-authority note.",
          "if": {
            "properties": {
              "evidence_state": {
                "enum": [
                  "enforcement_advisory_or_local_estimate",
                  "proof_stale_relative_to_change"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "enforcement_authority_note": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "comment": "Coverage, approver, and public-surface narrowing must carry an explicit evidence-continuity note.",
          "if": {
            "properties": {
              "evidence_state": {
                "enum": [
                  "owner_backup_coverage_missing",
                  "approver_state_expired_or_waived",
                  "public_surface_evidence_missing"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_continuity_note": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_reuse_proven_by_fixtures",
        "same_change_same_language_across_surfaces",
        "advisory_never_reads_as_provider_authoritative",
        "guarded_merge_never_hides_missing_backup_coverage",
        "guarded_merge_never_hides_expired_approver_state",
        "public_surface_change_never_hides_diff_or_migration_evidence",
        "owner_coverage_labels_identical_across_surfaces",
        "approver_state_language_identical_across_surfaces",
        "public_surface_impact_language_identical_across_surfaces",
        "help_support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "component_reuse_proven_by_fixtures": { "const": true },
        "same_change_same_language_across_surfaces": { "const": true },
        "advisory_never_reads_as_provider_authoritative": { "const": true },
        "guarded_merge_never_hides_missing_backup_coverage": { "const": true },
        "guarded_merge_never_hides_expired_approver_state": { "const": true },
        "public_surface_change_never_hides_diff_or_migration_evidence": { "const": true },
        "owner_coverage_labels_identical_across_surfaces": { "const": true },
        "approver_state_language_identical_across_surfaces": { "const": true },
        "public_surface_impact_language_identical_across_surfaces": { "const": true },
        "help_support_export_point_canonical_contracts": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true },
        "stale_or_underqualified_blocks_promotion": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_workspace_reuses_shared_components",
        "merge_queue_reuses_shared_components",
        "release_center_reuses_shared_components",
        "help_surface_reuses_shared_components",
        "support_packet_reuses_shared_components",
        "shiproom_reuses_shared_components",
        "cli_export_reuses_shared_components",
        "every_component_adopted_by_two_or_more_consumers",
        "parity_facets_identical_for_same_change",
        "narrowing_disclosed_not_hidden"
      ],
      "properties": {
        "review_workspace_reuses_shared_components": { "const": true },
        "merge_queue_reuses_shared_components": { "const": true },
        "release_center_reuses_shared_components": { "const": true },
        "help_surface_reuses_shared_components": { "const": true },
        "support_packet_reuses_shared_components": { "const": true },
        "shiproom_reuses_shared_components": { "const": true },
        "cli_export_reuses_shared_components": { "const": true },
        "every_component_adopted_by_two_or_more_consumers": { "const": true },
        "parity_facets_identical_for_same_change": { "const": true },
        "narrowing_disclosed_not_hidden": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
