{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-docs-pane-header-boundary-fact-grid-controls.schema.json",
  "title": "Aureline M5 docs-pane-header and boundary-fact-grid controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 embedded-boundary component matrix. It carries resolved, honest projections of the docs / help pane header and the boundary-fact grid across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved docs-pane header examples (naming the source class, owner/origin, version/pack identity, freshness/last-updated state, open-externally action, find-in-page affordance, and a single controlled boundary disposition) and the resolved boundary-fact grid examples (naming the data boundary, reading posture, and why the pane is trustworthy for in-product reading but not high-risk approval). Hard invariants forbid masquerading as native permission or approval chrome, hiding owner/origin or the browser handoff behind menus only, rendering a stale or blocked pane as fresh first-party truth, and embedding a high-risk approval without a native step-up. Acceptance criteria are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_docs_pane_header_and_boundary_fact_grid_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "boundary_disposition": {
      "enum": [
        "live_first_party_local",
        "live_first_party_hosted",
        "live_provider_owned",
        "stale_snapshot",
        "offline_snapshot",
        "provider_blocked",
        "browser_handoff_only",
        "capability_limited",
        "not_evaluated"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "docs_pane_header_example": {
      "type": "object",
      "required": [
        "header_id",
        "source_class",
        "boundary_disposition",
        "owner_origin",
        "pack_identity",
        "freshness",
        "last_updated_stated",
        "capability_limits",
        "handoff_required",
        "open_externally_available",
        "find_in_page_applicable",
        "find_in_page_available",
        "degrade_reason",
        "next_action",
        "distinguishable_source",
        "hides_required_handoff"
      ],
      "properties": {
        "header_id": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/non_empty_string" },
        "boundary_disposition": { "$ref": "#/$defs/boundary_disposition" },
        "owner_origin": { "$ref": "#/$defs/non_empty_string" },
        "pack_identity": { "type": "string" },
        "freshness": { "$ref": "#/$defs/non_empty_string" },
        "last_updated_stated": { "type": "boolean" },
        "capability_limits": { "type": "array", "items": { "type": "string" } },
        "handoff_required": { "type": "boolean" },
        "open_externally_available": { "type": "boolean" },
        "find_in_page_applicable": { "type": "boolean" },
        "find_in_page_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "distinguishable_source": { "type": "boolean" },
        "hides_required_handoff": { "type": "boolean" }
      }
    },
    "boundary_fact_grid_example": {
      "type": "object",
      "required": [
        "grid_id",
        "source_class",
        "data_exit_boundary",
        "reading_posture",
        "boundary_disposition",
        "data_boundary_stated",
        "trustworthy_for_in_product_reading",
        "suitable_for_high_risk_approval",
        "degrade_reason",
        "next_action",
        "masquerades_as_approval_authority"
      ],
      "properties": {
        "grid_id": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/non_empty_string" },
        "data_exit_boundary": { "$ref": "#/$defs/non_empty_string" },
        "reading_posture": { "$ref": "#/$defs/non_empty_string" },
        "boundary_disposition": { "$ref": "#/$defs/boundary_disposition" },
        "data_boundary_stated": { "type": "boolean" },
        "trustworthy_for_in_product_reading": { "type": "boolean" },
        "suitable_for_high_risk_approval": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "masquerades_as_approval_authority": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "docs_pane_header_examples",
        "boundary_fact_grid_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masquerades_as_native_approval_chrome",
        "hides_owner_origin_or_handoff_in_menus_only",
        "renders_stale_or_blocked_as_fresh_first_party_truth",
        "embeds_high_risk_approval_without_native_step_up"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "docs_pane_header_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/docs_pane_header_example" }
        },
        "boundary_fact_grid_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/boundary_fact_grid_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masquerades_as_native_approval_chrome": { "const": false },
        "hides_owner_origin_or_handoff_in_menus_only": { "const": false },
        "renders_stale_or_blocked_as_fresh_first_party_truth": { "const": false },
        "embeds_high_risk_approval_without_native_step_up": { "const": false }
      }
    }
  }
}
