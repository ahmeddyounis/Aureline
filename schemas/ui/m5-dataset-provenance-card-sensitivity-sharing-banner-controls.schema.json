{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-dataset-provenance-card-sensitivity-sharing-banner-controls.schema.json",
  "title": "Aureline M5 dataset provenance cards and sensitivity/sharing banners",
  "description": "Export-safe packet implementing the reusable M5 dataset-provenance-card and sensitivity-sharing-banner components in two co-equal control vectors. Each dataset card names its dataset/table, source class, version/snapshot/partition, row/file count or estimate, sample/truncation state, sensitivity/redaction state, and local-versus-remote location, and offers first-class open/inspect-provenance/export-metadata actions; its location class is derived from the source class and its provenance class from the provenance state, so a remote, unknown-location, partially provenanced, or unprovenanced dataset can never read as a fully-provenanced local dataset before a preview, compare, or share. Each sharing banner names its sensitivity class, share scope state, share class, blocked destinations, metadata-only-versus-raw-payload choice, copy/export policy, and local-safe alternatives, and offers review/share-metadata-only paths; its share disposition is derived from the share scope state, so a raw-payload share is never implied by default and metadata-only, sampled, or redacted states stay visible before a share. Every next step names one stable run/notebook/dataset/docs deep link rather than an ephemeral overlay or hidden route. No component masks provenance or sensitivity state, hides dataset location or provenance, exposes a raw payload by default, implies apples-to-apples without parity, or invents an alternate state label; cards and banners reuse Aureline's existing privacy, redaction, retention, and share-class vocabulary, and raw dataset payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "dataset_cards",
    "sharing_banners",
    "downgrade_triggers",
    "consumer_surfaces",
    "dataset_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_dataset_provenance_cards_and_sensitivity_sharing_banners_with_snapshot_sample_redaction_and_local_remote_location_truth_across_claimed_m5_data_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "dataset_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset_provenance_card" }
    },
    "sharing_banners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sensitivity_sharing_banner" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "dataset_review": { "$ref": "#/$defs/dataset_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "dataset_source_class": {
      "enum": [
        "tracked_dataset",
        "local_file",
        "remote_snapshot",
        "synthetic_data",
        "redacted_sample",
        "unknown_source"
      ]
    },
    "dataset_provenance_state": {
      "enum": [
        "provenance_complete",
        "provenance_partial",
        "provenance_missing",
        "version_pinned",
        "version_drifted",
        "access_restricted"
      ]
    },
    "location_class": {
      "enum": ["local_data", "remote_data", "location_unknown"]
    },
    "provenance_class": {
      "enum": ["provenanced", "pinned", "partially_provenanced", "unprovenanced"]
    },
    "sensitivity_class": {
      "enum": [
        "public_safe",
        "internal",
        "confidential",
        "regulated",
        "production_like",
        "unknown_sensitivity"
      ]
    },
    "share_scope_state": {
      "enum": [
        "summary_only",
        "summary_plus_metadata",
        "evidence_included",
        "raw_payload_included",
        "redacted_share",
        "share_blocked"
      ]
    },
    "share_disposition": {
      "enum": ["metadata_safe", "evidence_scoped", "raw_exposed", "redacted", "blocked"]
    },
    "deep_link_kind": {
      "enum": [
        "run_object",
        "notebook_location",
        "dataset_catalog_anchor",
        "docs_anchor",
        "no_deep_link"
      ]
    },
    "dataset_card_action": {
      "enum": [
        "open_dataset",
        "inspect_provenance",
        "export_metadata",
        "open_deep_link",
        "compare_datasets",
        "copy_dataset_id"
      ]
    },
    "sharing_banner_action": {
      "enum": [
        "review_share_scope",
        "share_metadata_only",
        "export_metadata_only",
        "open_deep_link",
        "copy_local_safe_reference",
        "block_share"
      ]
    },
    "disposition": {
      "enum": [
        "local_run",
        "managed_run",
        "imported_run",
        "manual_attach",
        "reproducible",
        "likely_reproducible",
        "needs_rerun",
        "context_incomplete"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "run_origin_and_revision",
        "provenance_and_sensitivity",
        "export_scope"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook_surface",
        "experiment_run_dashboard",
        "run_comparison_view",
        "dataset_catalog",
        "share_review_sheet",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "notebook_ui",
        "experiment_dashboard_ui",
        "comparison_ui",
        "data_catalog_ui",
        "lineage_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_origin_unstated",
        "code_revision_unstated",
        "environment_fingerprint_unstated",
        "dataset_provenance_severed",
        "comparability_overstated",
        "sensitivity_class_unstated",
        "export_scope_unstated",
        "raw_payload_exposed_by_default",
        "cached_state_hidden",
        "imported_run_unmarked",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "dataset_provenance_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "dataset_label",
        "source_class",
        "provenance_state",
        "location_class",
        "claims_local_data",
        "provenance_class",
        "claims_fully_provenanced",
        "remote_location_note",
        "unknown_location_note",
        "partial_provenance_note",
        "unprovenanced_note",
        "source_and_provenance_note",
        "version_snapshot_partition_note",
        "row_or_file_count_label",
        "sample_or_truncation_note",
        "is_sampled_or_truncated",
        "sensitivity_class",
        "redaction_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_dataset_location_or_provenance",
        "exposes_raw_payload_by_default",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "dataset_provenance_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "dataset_label": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/dataset_source_class" },
        "provenance_state": { "$ref": "#/$defs/dataset_provenance_state" },
        "location_class": { "$ref": "#/$defs/location_class" },
        "claims_local_data": { "type": "boolean" },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "claims_fully_provenanced": { "type": "boolean" },
        "remote_location_note": { "type": "string" },
        "unknown_location_note": { "type": "string" },
        "partial_provenance_note": { "type": "string" },
        "unprovenanced_note": { "type": "string" },
        "source_and_provenance_note": { "$ref": "#/$defs/non_empty_string" },
        "version_snapshot_partition_note": { "$ref": "#/$defs/non_empty_string" },
        "row_or_file_count_label": { "$ref": "#/$defs/non_empty_string" },
        "sample_or_truncation_note": { "$ref": "#/$defs/non_empty_string" },
        "is_sampled_or_truncated": { "type": "boolean" },
        "sensitivity_class": { "$ref": "#/$defs/sensitivity_class" },
        "redaction_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_dataset" } },
            { "contains": { "const": "inspect_provenance" } },
            { "contains": { "const": "export_metadata" } }
          ],
          "items": { "$ref": "#/$defs/dataset_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_dataset_location_or_provenance": { "const": false },
        "exposes_raw_payload_by_default": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "sensitivity_sharing_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "banner_id",
        "banner_label",
        "sensitivity_class",
        "share_scope_state",
        "share_disposition",
        "claims_includes_raw_payload",
        "claims_metadata_only",
        "raw_payload_warning",
        "blocked_note",
        "redaction_note",
        "sensitivity_warning",
        "sensitivity_and_share_class_note",
        "blocked_destinations_note",
        "copy_export_policy_note",
        "local_safe_alternative_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "banner_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_dataset_location_or_provenance",
        "exposes_raw_payload_by_default",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "sensitivity_sharing_banner" },
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "banner_label": { "$ref": "#/$defs/non_empty_string" },
        "sensitivity_class": { "$ref": "#/$defs/sensitivity_class" },
        "share_scope_state": { "$ref": "#/$defs/share_scope_state" },
        "share_disposition": { "$ref": "#/$defs/share_disposition" },
        "claims_includes_raw_payload": { "type": "boolean" },
        "claims_metadata_only": { "type": "boolean" },
        "raw_payload_warning": { "type": "string" },
        "blocked_note": { "type": "string" },
        "redaction_note": { "type": "string" },
        "sensitivity_warning": { "type": "string" },
        "sensitivity_and_share_class_note": { "$ref": "#/$defs/non_empty_string" },
        "blocked_destinations_note": { "$ref": "#/$defs/non_empty_string" },
        "copy_export_policy_note": { "$ref": "#/$defs/non_empty_string" },
        "local_safe_alternative_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "banner_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "review_share_scope" } },
            { "contains": { "const": "share_metadata_only" } }
          ],
          "items": { "$ref": "#/$defs/sharing_banner_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_dataset_location_or_provenance": { "const": false },
        "exposes_raw_payload_by_default": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "dataset_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_card_shows_source_and_provenance",
        "dataset_card_shows_location_and_sample_state",
        "dataset_card_offers_open_inspect_export",
        "share_banner_shows_sensitivity_and_scope",
        "share_banner_offers_review_and_metadata_only",
        "location_and_provenance_derived_never_asserted",
        "remote_or_unknown_never_shown_as_local",
        "unprovenanced_never_shown_as_provenanced",
        "raw_payload_never_implied_by_default",
        "metadata_only_and_sampled_state_visible_before_share",
        "every_next_step_names_stable_deep_link",
        "reuses_existing_privacy_redaction_share_vocabulary",
        "provenance_and_sensitivity_state_visible",
        "cached_offline_local_only_state_visible",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_catalog_reads_single_source",
        "share_review_sheet_reads_single_source",
        "provenance_and_location_visible_before_preview_or_compare",
        "sensitivity_and_scope_visible_before_share",
        "support_export_shows_component_truth",
        "help_docs_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
