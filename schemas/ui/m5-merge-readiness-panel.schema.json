{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-merge-readiness-panel.schema.json",
  "title": "Aureline M5 merge-readiness panels, merge-queue entries, and stack-dependency chips with governance and queue-block truth",
  "description": "Export-safe packet implementing the reusable M5 merge-readiness panel, merge-queue entry, and stack-dependency chip contracts. Each panel makes queue and landing readiness explicit before Aureline offers merge, enqueue, restack, or handoff actions: it names the queue owner, states its blocked reason, labels a stale base, discloses approval recomputation, exposes stack-dependency blocking, and declares auto-merge/queue scope. The core honesty axis is governance: provider-managed, repo-policy-managed, and Aureline-local-estimate queue state never masquerade as one another. From the panel alone a reader can tell whether the queue result is authoritative, estimated, stale, or blocked, without opening raw provider pages: a local estimate never claims to be authoritative, and an authoritative result is never understated as a mere local estimate. Provider outage and stale-sync degradations preserve a local-continue path and, when unreachable, an explicit browser-handoff boundary, so one panel degrades without collapsing the whole review lane. Raw provider queue responses, credentials, and live provider payloads never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "panels",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "merge_readiness_panel_governance_and_queue_block_truth"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/merge_readiness_panel"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_trigger"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "governance": {
      "type": "string",
      "enum": [
        "provider_managed",
        "repo_policy_managed",
        "aureline_local_estimate"
      ]
    },
    "provider_freshness": {
      "type": "string",
      "enum": [
        "provider_fresh",
        "provider_refreshing",
        "provider_stale",
        "provider_unreachable",
        "provider_conflict",
        "local_only_continuation"
      ]
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "ready_to_merge",
        "queued_waiting",
        "blocked_on_stale_base",
        "blocked_on_failing_checks",
        "blocked_on_approval_recomputation",
        "blocked_on_stack_parent",
        "blocked_on_policy",
        "held_manually"
      ]
    },
    "auto_merge_scope": {
      "type": "string",
      "enum": [
        "not_enabled",
        "this_entry_only",
        "whole_stack",
        "queue_batch"
      ]
    },
    "stack_relation": {
      "type": "string",
      "enum": [
        "standalone",
        "stack_root_ready",
        "stack_parent_blocked",
        "stack_child_pending"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "enqueue_for_merge",
        "merge_now",
        "restack_onto_base",
        "recompute_approvals",
        "requeue_after_rerun",
        "continue_local_review",
        "open_provider_in_browser",
        "export_readiness_packet"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "provider_freshness_stale",
        "stale_base_unlabeled",
        "approval_recompute_pending",
        "stack_parent_blocked",
        "queue_ownership_unresolved",
        "browser_handoff_unavailable",
        "trust_narrowing",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_workspace",
        "review_list",
        "companion_queue",
        "handoff_packet",
        "cli_headless",
        "support_export",
        "diagnostics",
        "help_about",
        "merge_queue_drawer"
      ]
    },
    "merge_queue_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "entry_label",
        "queue_position_label",
        "entry_state",
        "is_this_change",
        "blocked_reason_detail"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "entry_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "queue_position_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "entry_state": {
          "$ref": "#/$defs/readiness_state"
        },
        "is_this_change": {
          "type": "boolean"
        },
        "blocked_reason_detail": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "entry_state": {
                "enum": [
                  "blocked_on_stale_base",
                  "blocked_on_failing_checks",
                  "blocked_on_approval_recomputation",
                  "blocked_on_stack_parent",
                  "blocked_on_policy"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "blocked_reason_detail": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "stack_dependency_chip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chip_id",
        "stack_id_label",
        "position_label",
        "relation",
        "blocking_note"
      ],
      "properties": {
        "chip_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stack_id_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "position_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "relation": {
          "$ref": "#/$defs/stack_relation"
        },
        "blocking_note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "const": "stack_parent_blocked"
              }
            }
          },
          "then": {
            "properties": {
              "blocking_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "merge_readiness_panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "review_id_label",
        "queue_owner_label",
        "governance",
        "provider_freshness",
        "readiness_state",
        "claims_authoritative",
        "headline_readiness_label",
        "blocked_reason_detail",
        "stale_base_note",
        "approval_recomputation_note",
        "auto_merge_scope",
        "queue_entries",
        "stack_chips",
        "actions",
        "browser_handoff_boundary",
        "local_continue_fallback",
        "source_contract_refs"
      ],
      "properties": {
        "panel_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "review_id_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "queue_owner_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "governance": {
          "$ref": "#/$defs/governance"
        },
        "provider_freshness": {
          "$ref": "#/$defs/provider_freshness"
        },
        "readiness_state": {
          "$ref": "#/$defs/readiness_state"
        },
        "claims_authoritative": {
          "type": "boolean"
        },
        "headline_readiness_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "blocked_reason_detail": {
          "type": "string"
        },
        "stale_base_note": {
          "type": "string"
        },
        "approval_recomputation_note": {
          "type": "string"
        },
        "auto_merge_scope": {
          "$ref": "#/$defs/auto_merge_scope"
        },
        "queue_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/merge_queue_entry"
          }
        },
        "stack_chips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stack_dependency_chip"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "browser_handoff_boundary": {
          "type": "string"
        },
        "local_continue_fallback": {
          "type": "string"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "readiness_state": {
                "const": "blocked_on_stale_base"
              }
            }
          },
          "then": {
            "properties": {
              "stale_base_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "readiness_state": {
                "const": "blocked_on_approval_recomputation"
              }
            }
          },
          "then": {
            "properties": {
              "approval_recomputation_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_local_estimate_distinct",
        "queue_owner_always_explicit",
        "blocked_reason_never_generic_warning",
        "stale_base_labeled_not_hidden",
        "approval_recomputation_explicit",
        "stack_blocking_explicit",
        "auto_merge_scope_explicit",
        "provider_outage_preserves_local_continuation",
        "stale_sync_never_collapses_review_lane",
        "no_forced_raw_provider_navigation_for_triage",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "provider_local_estimate_distinct": {
          "type": "boolean",
          "const": true
        },
        "queue_owner_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "blocked_reason_never_generic_warning": {
          "type": "boolean",
          "const": true
        },
        "stale_base_labeled_not_hidden": {
          "type": "boolean",
          "const": true
        },
        "approval_recomputation_explicit": {
          "type": "boolean",
          "const": true
        },
        "stack_blocking_explicit": {
          "type": "boolean",
          "const": true
        },
        "auto_merge_scope_explicit": {
          "type": "boolean",
          "const": true
        },
        "provider_outage_preserves_local_continuation": {
          "type": "boolean",
          "const": true
        },
        "stale_sync_never_collapses_review_lane": {
          "type": "boolean",
          "const": true
        },
        "no_forced_raw_provider_navigation_for_triage": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_workspace_reuses_one_panel_contract",
        "review_list_reuses_one_panel_contract",
        "companion_queue_reuses_one_panel_contract",
        "panel_distinguishes_all_governance_kinds",
        "queue_result_authority_readable_without_raw_provider",
        "cli_headless_shows_truth",
        "support_export_shows_truth",
        "diagnostics_shows_truth",
        "help_about_shows_truth",
        "export_preserves_queue_and_stack_identity"
      ],
      "properties": {
        "review_workspace_reuses_one_panel_contract": {
          "type": "boolean",
          "const": true
        },
        "review_list_reuses_one_panel_contract": {
          "type": "boolean",
          "const": true
        },
        "companion_queue_reuses_one_panel_contract": {
          "type": "boolean",
          "const": true
        },
        "panel_distinguishes_all_governance_kinds": {
          "type": "boolean",
          "const": true
        },
        "queue_result_authority_readable_without_raw_provider": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "export_preserves_queue_and_stack_identity": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
