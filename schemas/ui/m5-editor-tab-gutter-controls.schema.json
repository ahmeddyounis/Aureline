{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-editor-tab-gutter-controls.schema.json",
  "title": "Aureline M5 editor-tab and gutter controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 editor-inline component matrix. It carries resolved, honest projections of the editor tab and the gutter across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved editor-tab examples (naming the file/session identity, the tab context, the per-tab modified/preview/pinned/read-only/blocked/shared/generated/remote item state with no-color-only semantics, and the code-pane kind) and the resolved gutter examples (naming the anchor, the marker kind and layer/precedence band, and the diagnostic severity, readable in compact/high-zoom/exported representations). Hard invariants forbid tabs inventing feature-local badges for the same file/session state, gutter markers encoding state by color alone, gutter marker layering losing identity or precedence, and reopen/reveal continuity breaking across single/split/diff/notebook panes. Acceptance criteria — claimed editors show one shared tab and gutter state grammar with no feature-local badges, marker layering stays readable across representations without losing identity or precedence, and users can trace file/session and gutter state through one canonical component contract and command-backed detail entrypoints — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-editor is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_editor_tab_and_gutter_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "editor_tab_example": {
      "type": "object",
      "required": [
        "tab_id",
        "file_session_label",
        "tab_context",
        "item_state",
        "item_state_shared",
        "item_state_generated",
        "item_state_remote",
        "pane_kind",
        "reopen_reveal_continuity_preserved",
        "has_blocked_tab",
        "invents_feature_local_badge",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "state_legible_at_a_glance"
      ],
      "properties": {
        "tab_id": { "$ref": "#/$defs/non_empty_string" },
        "file_session_label": { "type": "string" },
        "tab_context": { "$ref": "#/$defs/non_empty_string" },
        "item_state": { "$ref": "#/$defs/non_empty_string" },
        "item_state_shared": { "type": "boolean" },
        "item_state_generated": { "type": "boolean" },
        "item_state_remote": { "type": "boolean" },
        "pane_kind": { "$ref": "#/$defs/non_empty_string" },
        "reopen_reveal_continuity_preserved": { "type": "boolean" },
        "has_blocked_tab": { "type": "boolean" },
        "invents_feature_local_badge": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "state_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "gutter_example": {
      "type": "object",
      "required": [
        "gutter_id",
        "anchor_label",
        "marker_kind",
        "marker_layer",
        "layer_precedence",
        "is_diagnostic_layer",
        "diagnostic_severity",
        "layer_precedence_preserved",
        "readable_in_compact_and_export",
        "invents_feature_local_badge",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "layering_legible_at_a_glance"
      ],
      "properties": {
        "gutter_id": { "$ref": "#/$defs/non_empty_string" },
        "anchor_label": { "type": "string" },
        "marker_kind": { "$ref": "#/$defs/non_empty_string" },
        "marker_layer": { "$ref": "#/$defs/non_empty_string" },
        "layer_precedence": { "type": "integer", "minimum": 0 },
        "is_diagnostic_layer": { "type": "boolean" },
        "diagnostic_severity": { "$ref": "#/$defs/non_empty_string" },
        "layer_precedence_preserved": { "type": "boolean" },
        "readable_in_compact_and_export": { "type": "boolean" },
        "invents_feature_local_badge": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "layering_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "editor_tab_examples",
        "gutter_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "tabs_invent_feature_local_badges_for_file_session_state",
        "gutter_markers_encode_state_by_color_alone",
        "gutter_marker_layering_loses_identity_or_precedence",
        "reopen_reveal_continuity_breaks_across_panes"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "editor_tab_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/editor_tab_example" }
        },
        "gutter_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gutter_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "tabs_invent_feature_local_badges_for_file_session_state": { "const": false },
        "gutter_markers_encode_state_by_color_alone": { "const": false },
        "gutter_marker_layering_loses_identity_or_precedence": { "const": false },
        "reopen_reveal_continuity_breaks_across_panes": { "const": false }
      }
    }
  }
}
