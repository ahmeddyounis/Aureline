{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-managed-workspace-lifecycle-card-suspend-resume-rebuild-review-sheet-controls.schema.json",
  "title": "Aureline M5 managed-workspace-lifecycle-card and suspend-resume-rebuild-review-sheet controls",
  "description": "Export-safe packet for the third implement lane over the frozen M5 build/remote-boundary component matrix. It carries resolved, honest projections of the managed-workspace lifecycle card and the suspend/resume/rebuild review sheet across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved lifecycle card examples (naming the lifecycle state, persistence class, continuity class, expiry timing, recovery options, and whether local-safe continuation is offered) and the resolved review-sheet examples (naming the action class, template/image provenance, changed persistence class, preserved-vs-lost state, reattach/rerun consequences, continuity class, caveats, and whether the sheet appears before commit). Hard invariants forbid implying exact continuity after a material change, hiding local-safe continuation or companion handoff behind overflow-only affordances, letting a review sheet appear after the destructive/continuity-affecting action it gates, and concealing lifecycle or continuity truth behind generic status wording. Acceptance criteria are proven by the resolved examples, not merely asserted: a user can tell whether a workspace resumed, rebuilt, recreated, or degraded to local-safe continuation and what changed materially; lifecycle review sheets appear before destructive or continuity-affecting actions rather than after the fact; and companion, preview, and support/export paths reuse the same lifecycle cards and review language. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-remote is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_managed_workspace_lifecycle_card_and_suspend_resume_rebuild_review_sheet_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "lifecycle_state": {
      "enum": [
        "provision",
        "warm",
        "ready",
        "suspended",
        "resumed",
        "reconnecting",
        "rebuild_required",
        "recreate_required",
        "expired",
        "local_safe_continuation"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "lifecycle_card_example": {
      "type": "object",
      "required": [
        "card_id",
        "workspace_label",
        "lifecycle_state",
        "lifecycle_label",
        "persistence_class",
        "continuity_class",
        "expiry_class",
        "recovery_options",
        "local_safe_offered",
        "material_change_present",
        "is_outage_state",
        "degrade_reason",
        "next_action",
        "state_disclosed",
        "persistence_disclosed",
        "continuity_disclosed",
        "expiry_disclosed",
        "implies_exact_continuity_after_material_change",
        "hides_local_safe_continuation"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "workspace_label": { "type": "string" },
        "lifecycle_state": { "$ref": "#/$defs/lifecycle_state" },
        "lifecycle_label": { "$ref": "#/$defs/non_empty_string" },
        "persistence_class": { "$ref": "#/$defs/non_empty_string" },
        "continuity_class": { "$ref": "#/$defs/non_empty_string" },
        "expiry_class": { "$ref": "#/$defs/non_empty_string" },
        "recovery_options": { "type": "array", "items": { "type": "string" } },
        "local_safe_offered": { "type": "boolean" },
        "material_change_present": { "type": "boolean" },
        "is_outage_state": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "state_disclosed": { "type": "boolean" },
        "persistence_disclosed": { "type": "boolean" },
        "continuity_disclosed": { "type": "boolean" },
        "expiry_disclosed": { "type": "boolean" },
        "implies_exact_continuity_after_material_change": { "type": "boolean" },
        "hides_local_safe_continuation": { "type": "boolean" }
      }
    },
    "review_sheet_example": {
      "type": "object",
      "required": [
        "sheet_id",
        "workspace_label",
        "action",
        "provenance_class",
        "persistence_class",
        "continuity_class",
        "caveats",
        "persistence_changed",
        "material_change_present",
        "action_disclosed",
        "provenance_disclosed",
        "persistence_change_disclosed",
        "preserved_state_disclosed",
        "lost_state_disclosed",
        "consequences_disclosed",
        "shown_before_commit",
        "degrade_reason",
        "next_action",
        "overclaims_exact_continuity",
        "shown_after_the_fact"
      ],
      "properties": {
        "sheet_id": { "$ref": "#/$defs/non_empty_string" },
        "workspace_label": { "type": "string" },
        "action": { "$ref": "#/$defs/non_empty_string" },
        "provenance_class": { "$ref": "#/$defs/non_empty_string" },
        "persistence_class": { "$ref": "#/$defs/non_empty_string" },
        "continuity_class": { "$ref": "#/$defs/non_empty_string" },
        "caveats": { "type": "array", "items": { "type": "string" } },
        "persistence_changed": { "type": "boolean" },
        "material_change_present": { "type": "boolean" },
        "action_disclosed": { "type": "boolean" },
        "provenance_disclosed": { "type": "boolean" },
        "persistence_change_disclosed": { "type": "boolean" },
        "preserved_state_disclosed": { "type": "boolean" },
        "lost_state_disclosed": { "type": "boolean" },
        "consequences_disclosed": { "type": "boolean" },
        "shown_before_commit": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "overclaims_exact_continuity": { "type": "boolean" },
        "shown_after_the_fact": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "lifecycle_card_examples",
        "review_sheet_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "implies_exact_continuity_after_material_change",
        "hides_local_safe_or_companion_handoff_in_overflow_only",
        "review_sheet_appears_after_the_fact",
        "conceals_lifecycle_or_continuity_in_generic_status_wording"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "lifecycle_card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle_card_example" }
        },
        "review_sheet_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/review_sheet_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_exact_continuity_after_material_change": { "const": false },
        "hides_local_safe_or_companion_handoff_in_overflow_only": { "const": false },
        "review_sheet_appears_after_the_fact": { "const": false },
        "conceals_lifecycle_or_continuity_in_generic_status_wording": { "const": false }
      }
    }
  }
}
