{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-shared-terminal-debug-view.schema.json",
  "title": "Aureline M5 shared terminal / debug view",
  "description": "Canonical per-domain descriptor for one live shared terminal or debugger view. Names the live stream, the single active driver, the view-first default, the control authority, and the provenance of every input so presence never reads as control and no prior input is replayed on join. Raw secrets, raw command lines, raw variable bodies, and raw clipboard contents never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "collaboration_control_association",
    "control_authority_source",
    "active_driver",
    "session_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "shared_terminal_debug_view"
      ]
    },
    "collaboration_control_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "control_authority_source": {
      "$ref": "#/$defs/control_authority_source"
    },
    "active_driver": {
      "$ref": "#/$defs/non_empty_string"
    },
    "input_provenance": {
      "type": "array"
    },
    "session_state": {
      "$ref": "#/$defs/session_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "control_authority_source": {
      "enum": [
        "granted_by_explicit_control_grant",
        "delegated_by_presenter_token",
        "inferred_from_presence_or_follow",
        "expired_or_revoked_grant"
      ]
    },
    "session_state": {
      "enum": [
        "viewer",
        "commenter",
        "editor",
        "driver",
        "navigator",
        "presenter_moderator",
        "live_only",
        "metadata_audit",
        "replayable_text_comment_timeline",
        "elevated_support_evidence",
        "control_requested",
        "control_granted",
        "control_expired",
        "recording_active",
        "consent_renewal_required",
        "restore_view_only"
      ]
    }
  }
}
