{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-learning-component-consumer.schema.json",
  "title": "Aureline M5 learning component consumers",
  "description": "Export-safe packet for the adoption lane over the frozen M5 learning-component matrix. It binds one row per claimed M5 learning consumer — onboarding, migration, contextual help, the docs / browser surface, a feature-family tour, the companion handoff, and the support / export packet — to the six canonical component families (learning-mode toggle, tip card, guided-exercise step, glossary chip / card, safe-explanation banner, progress marker), the one shared descriptor vocabulary (citation source / source-class freshness / progress ownership-privacy / explain-versus-do), the parity-health modes, export caveats, claim-parity states, narrowing reasons, recovery actions, export fields, and non-visual accessibility routes. Each consumer points at the primitive's canonical schema and artifact rather than re-wording citation, source-class, progress / privacy, or explain-versus-do facts in local prose. A weakened parity-health mode (a cached pack, stale source content, an unavailable / not-installed cited source, or local-only progress) auto-narrows the claim and always discloses a self-contained banner naming the exact reason and recovery action. An uncited or unavailable source never masquerades as a live, cited one. Raw secrets, endpoints, tokens, and raw provider bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_onboarding_migration_contextual_help_docs_browser_feature_family_tour_companion_handoff_and_support_export_consumers_so_learning_components_keep_citation_privacy_and_progress_language_aligned_across_claimed_m5_profiles"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "learning_component_consumer_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "learning_component_consumer_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "onboarding",
        "migration",
        "contextual_help",
        "docs_browser",
        "feature_family_tour",
        "companion_handoff",
        "support_export"
      ]
    },
    "component_family": {
      "enum": [
        "learning_mode_toggle",
        "tip_card",
        "guided_exercise_step",
        "glossary_chip_or_card",
        "safe_explanation_banner",
        "progress_marker"
      ]
    },
    "descriptor": {
      "enum": [
        "citation_source",
        "source_class_freshness",
        "progress_ownership_privacy",
        "explain_versus_do"
      ]
    },
    "parity_health": {
      "enum": [
        "full_parity",
        "cached_pack_narrowed",
        "stale_source_narrowed",
        "citation_unavailable_narrowed",
        "progress_local_only_narrowed"
      ]
    },
    "claim_parity_state": {
      "enum": ["claims_aligned", "claims_auto_narrowed"]
    },
    "narrowing_reason": {
      "enum": [
        "cached_pack_served",
        "source_content_stale",
        "cited_source_unavailable_or_not_installed",
        "progress_local_only"
      ]
    },
    "recovery_action": {
      "enum": [
        "refresh_pack_when_online",
        "review_source_freshness_before_trusting",
        "open_cited_source_or_request_access",
        "export_progress_or_enable_supported_sync"
      ]
    },
    "export_caveat": {
      "enum": [
        "content_served_from_cached_pack",
        "source_content_stale",
        "cited_source_unavailable_or_not_installed",
        "progress_local_only_not_synced"
      ]
    },
    "resolved_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "canonical_schema_ref",
        "descriptor_families",
        "parity_health",
        "export_caveats",
        "claim_parity_state",
        "is_narrowed",
        "reflects_uncited_or_unavailable_source",
        "asserts_live_cited_parity",
        "auto_narrow_banner"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health": { "$ref": "#/$defs/parity_health" },
        "export_caveats": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_state": { "$ref": "#/$defs/claim_parity_state" },
        "is_narrowed": { "type": "boolean" },
        "reflects_uncited_or_unavailable_source": { "type": "boolean" },
        "asserts_live_cited_parity": { "type": "boolean" },
        "auto_narrow_banner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "recovery_action",
                "consumer",
                "component_family",
                "preserved_descriptors",
                "export_caveats",
                "headline"
              ],
              "properties": {
                "reason": { "$ref": "#/$defs/narrowing_reason" },
                "recovery_action": { "$ref": "#/$defs/recovery_action" },
                "consumer": { "$ref": "#/$defs/consumer" },
                "component_family": { "$ref": "#/$defs/component_family" },
                "preserved_descriptors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/descriptor" }
                },
                "export_caveats": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/export_caveat" }
                },
                "headline": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "$ref": "#/$defs/resolved_binding" }
      }
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "const": true },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "parity_health_modes",
        "export_caveats",
        "claim_parity_states",
        "narrowing_reasons",
        "recovery_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewords_claims_per_surface",
        "invents_new_learning_grammar",
        "drops_citation_progress_or_explain_do_when_narrowed",
        "shows_uncited_or_unavailable_source_as_live_cited",
        "widens_trust_or_mutating_authority"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parity_health" }
        },
        "export_caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim_parity_state" }
        },
        "narrowing_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recovery_action" }
        },
        "export_fields": { "type": "array", "minItems": 5 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_binding" }
        },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rewords_claims_per_surface": { "const": false },
        "invents_new_learning_grammar": { "const": false },
        "drops_citation_progress_or_explain_do_when_narrowed": { "const": false },
        "shows_uncited_or_unavailable_source_as_live_cited": { "const": false },
        "widens_trust_or_mutating_authority": { "const": false }
      }
    }
  }
}
