{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-dri-registry-row.schema.json",
  "title": "Aureline M5 DRI-registry row",
  "description": "Per-component contract for a DRI-registry row: the reusable component that names the directly responsible individual for a guarded surface and whether the DRI has coverage or a gap, so a surface with no DRI is visible rather than silently unowned. Binds the frozen governance-state vocabulary plus the coverage state (covered or backup_missing) and enforcement authority so an inferred DRI is never presented as the registry's authoritative assignment. The Rust validator in crates/aureline-review is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "dri_label",
    "coverage_state",
    "enforcement_authority",
    "governance_state_vocab"
  ],
  "properties": {
    "component": {
      "const": "dri_registry_row"
    },
    "dri_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "coverage_state": {
      "$ref": "#/$defs/coverage_state"
    },
    "enforcement_authority": {
      "$ref": "#/$defs/enforcement_authority"
    },
    "governance_state_vocab": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/governance_state_vocab"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "coverage_state": {
      "enum": [
        "covered",
        "backup_missing"
      ]
    },
    "enforcement_authority": {
      "enum": [
        "advisory",
        "authoritative",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "governance_state_vocab": {
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    }
  }
}
