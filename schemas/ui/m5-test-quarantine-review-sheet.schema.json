{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-quarantine-review-sheet.schema.json",
  "title": "Aureline M5 quarantine-review-sheet resolution case",
  "description": "Companion schema for the M5 quarantine/mute review-sheet half of the failure-triage-panel / quarantine-review-sheet / environment-matrix-card triple primitive. It describes one worked quarantine-review resolution case: an input suppression state and its resolved truth. The resolved truth preserves the suppression scope, kind, ownership, release impact, expiry state, linked-artifacts flag, reason, and owner, carries the honesty-first derived review posture (expired/unowned/hidden-release/review-due/blocking/governed), keeps the suppressed test visible, and always offers a restore action. The canonical packet schema that embeds these cases is m5-test-failure-triage-panel.schema.json. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "resolved"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suppression_kind",
        "suppression_scope",
        "ownership",
        "release_impact",
        "expiry_state",
        "has_linked_artifacts",
        "reason_label",
        "owner_label",
        "sheet_identity_ref"
      ],
      "properties": {
        "suppression_kind": { "$ref": "#/$defs/suppression_kind" },
        "suppression_scope": { "$ref": "#/$defs/suppression_scope" },
        "ownership": { "$ref": "#/$defs/ownership" },
        "release_impact": { "$ref": "#/$defs/release_impact" },
        "expiry_state": { "$ref": "#/$defs/expiry_state" },
        "has_linked_artifacts": { "type": "boolean" },
        "reason_label": { "type": "string", "minLength": 1 },
        "owner_label": { "type": "string", "minLength": 1 },
        "sheet_identity_ref": { "type": "string", "minLength": 1 }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suppression_kind",
        "suppression_scope",
        "ownership",
        "release_impact",
        "expiry_state",
        "has_linked_artifacts",
        "reason_label",
        "owner_label",
        "sheet_identity_ref",
        "review_posture",
        "available_actions",
        "stays_visible",
        "preserves_reason",
        "owner_is_accountable",
        "is_expired",
        "review_due",
        "blocks_release",
        "hidden_from_release",
        "can_restore",
        "needs_attention"
      ],
      "properties": {
        "suppression_kind": { "$ref": "#/$defs/suppression_kind" },
        "suppression_scope": { "$ref": "#/$defs/suppression_scope" },
        "ownership": { "$ref": "#/$defs/ownership" },
        "release_impact": { "$ref": "#/$defs/release_impact" },
        "expiry_state": { "$ref": "#/$defs/expiry_state" },
        "has_linked_artifacts": { "type": "boolean" },
        "reason_label": { "type": "string", "minLength": 1 },
        "owner_label": { "type": "string", "minLength": 1 },
        "sheet_identity_ref": { "type": "string", "minLength": 1 },
        "review_posture": {
          "enum": [
            "expired_suppression",
            "unowned_suppression",
            "hidden_release_suppression",
            "review_due_suppression",
            "blocking_suppression",
            "governed_suppression"
          ]
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "restore_test" },
          "items": {
            "enum": [
              "reveal_quarantine_details",
              "restore_test",
              "renew_suppression",
              "reassign_owner",
              "open_linked_artifacts",
              "export_quarantine"
            ]
          }
        },
        "stays_visible": { "const": true },
        "preserves_reason": { "const": true },
        "owner_is_accountable": { "type": "boolean" },
        "is_expired": { "type": "boolean" },
        "review_due": { "type": "boolean" },
        "blocks_release": { "type": "boolean" },
        "hidden_from_release": { "type": "boolean" },
        "can_restore": { "const": true },
        "needs_attention": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "suppression_kind": { "enum": ["muted", "quarantined", "skipped"] },
    "suppression_scope": {
      "enum": [
        "single_case",
        "parametrization_subset",
        "whole_file",
        "whole_suite",
        "tagged_group"
      ]
    },
    "ownership": {
      "enum": [
        "unowned",
        "self_owned",
        "team_owned",
        "ci_enforced",
        "imported_policy",
        "owner_expired"
      ]
    },
    "release_impact": {
      "enum": [
        "blocks_release",
        "hidden_from_release",
        "soft_gated",
        "informational",
        "no_impact",
        "unknown_impact"
      ]
    },
    "expiry_state": {
      "enum": [
        "no_expiry",
        "expires_scheduled",
        "review_due",
        "expired",
        "permanent_policy"
      ]
    }
  }
}
