{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-collaboration-join-review-sheet.schema.json",
  "title": "Aureline M5 collaboration join-review sheet",
  "description": "Canonical per-domain descriptor for one join-time consent envelope. Names the join-time consent scope, the guest scope and route visibility, the recording and retention consequences, and the consent renewal requirement so a participant sees the consequences before joining and guest scope or route visibility never widens silently. Raw secrets and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "collaboration_control_association",
    "consent_retention_gate",
    "guest_scope_and_route_visibility",
    "session_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "consent_envelope"
      ]
    },
    "collaboration_control_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "consent_retention_gate": {
      "$ref": "#/$defs/consent_retention_gate"
    },
    "guest_scope_and_route_visibility": {
      "$ref": "#/$defs/non_empty_string"
    },
    "recording_and_retention_consequences": {
      "type": "array"
    },
    "session_state": {
      "$ref": "#/$defs/session_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "consent_retention_gate": {
      "enum": [
        "consent_current_recording_allowed",
        "blocked_by_missing_join_consent",
        "blocked_by_consent_renewal_required",
        "blocked_by_retention_scope_widening",
        "blocked_by_guest_scope_or_route_expansion"
      ]
    },
    "session_state": {
      "enum": [
        "viewer",
        "commenter",
        "editor",
        "driver",
        "navigator",
        "presenter_moderator",
        "live_only",
        "metadata_audit",
        "replayable_text_comment_timeline",
        "elevated_support_evidence",
        "control_requested",
        "control_granted",
        "control_expired",
        "recording_active",
        "consent_renewal_required",
        "restore_view_only"
      ]
    }
  }
}
