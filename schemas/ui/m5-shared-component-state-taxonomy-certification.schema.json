{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-shared-component-state-taxonomy-certification.schema.json",
  "title": "Aureline M5 shared-component-state taxonomy surface certification packet",
  "description": "M05-939 closing surface-certification capstone over the frozen M5 shared-component-state-taxonomy / interactive-state / selection-or-lock-state / degraded-state-application component matrix. Certifies that the shared component-state taxonomy truth holds on every claimed M5 control, collection, and recovery surface, auto-narrowing any surface that cannot sustain it. Metadata-only: typed class tokens, opaque refs, booleans, and redacted labels; never raw state copy, captured surface bodies, or credential-bearing material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_shared_component_state_taxonomy_certification_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "state_claim": {
      "type": "string",
      "enum": [
        "exact_state_truth",
        "reviewable_state_guidance",
        "cause_narrowed_projection",
        "owner_narrowed_projection",
        "recovery_narrowed_projection",
        "stale_proof_projection"
      ]
    },
    "certified_surface": {
      "type": "string",
      "enum": [
        "control_affordance",
        "dense_collection",
        "blocked_action_prompt",
        "settings_capability_sheet",
        "activity_recovery_view",
        "command_palette",
        "support_export",
        "cli_headless"
      ]
    },
    "certification_axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "state_boundary_provenance"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "surface_status": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "precedence_rule_unstated",
        "state_cause_unstated",
        "lock_owner_masked",
        "current_selected_collapsed",
        "pending_shown_as_loading",
        "consequence_or_recovery_omitted",
        "color_only_treatment",
        "keyboard_route_missing",
        "read_only_inspectability_lost",
        "disclosure_requirement_unmet",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "component_family": {
      "type": "string",
      "enum": [
        "shared_component_state_taxonomy",
        "interactive_state",
        "selection_or_lock_state",
        "degraded_state_application"
      ]
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_axis",
        "from_claim",
        "to_claim",
        "visible_label",
        "preserves_lineage_continuity"
      ],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/state_claim" },
        "to_claim": { "$ref": "#/$defs/state_claim" },
        "visible_label": { "type": "string", "minLength": 1 },
        "preserves_lineage_continuity": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "lineage_preserved",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_shared_component_state_taxonomy_certification_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/certified_surface" },
        "claimed_claim": { "$ref": "#/$defs/state_claim" },
        "certified_claim": { "$ref": "#/$defs/state_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "lineage_preserved": { "type": "boolean" },
        "canonical_bundle_ref": { "type": "string", "minLength": 1 },
        "derived_status": { "$ref": "#/$defs/surface_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "every_axis_covered_on_every_row",
        "all_lineage_preserved",
        "narrowed_surface_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "all_lineage_preserved": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
