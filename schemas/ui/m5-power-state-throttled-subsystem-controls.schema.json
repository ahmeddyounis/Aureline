{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-power-state-throttled-subsystem-controls.schema.json",
  "title": "Aureline M5 power-state-indicator and throttled-subsystem-row controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 efficiency component matrix. It carries resolved, honest projections of the power-state indicator and the throttled-subsystem row across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved power-state examples (naming the source of change, the active efficiency state, an inspect path, and a single controlled work disposition) and the resolved throttled-subsystem examples (enumerating which lanes slowed or paused and which protected tasks remain preserved). Hard invariants forbid collapsing distinct pressure sources into one generic warning, hiding slowed work once adaptive behavior became user-visible, leaving what-still-works unstated, and inventing alternate labels for governed states. Acceptance criteria are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_power_state_indicator_and_throttled_subsystem_row_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "efficiency_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "efficiency_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "work_disposition": {
      "enum": [
        "running_full",
        "slowed",
        "paused",
        "policy_blocked",
        "override_available",
        "override_blocked",
        "resuming",
        "stale_result_shown",
        "not_evaluated"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "power_state_example": {
      "type": "object",
      "required": [
        "indicator_id",
        "source_of_change",
        "active_state",
        "work_disposition",
        "inspect_path",
        "degrade_reason",
        "next_action",
        "distinguishable_cause",
        "collapses_into_generic_warning"
      ],
      "properties": {
        "indicator_id": { "$ref": "#/$defs/non_empty_string" },
        "source_of_change": { "type": "array", "items": { "type": "string" } },
        "active_state": { "$ref": "#/$defs/non_empty_string" },
        "work_disposition": { "$ref": "#/$defs/work_disposition" },
        "inspect_path": { "type": "string" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "distinguishable_cause": { "type": "boolean" },
        "collapses_into_generic_warning": { "type": "boolean" }
      }
    },
    "throttled_example": {
      "type": "object",
      "required": [
        "row_id",
        "slowed_workloads",
        "paused_workloads",
        "preserved_protected_tasks",
        "affected_subsystems_named",
        "work_dispositions",
        "degrade_reason",
        "next_action",
        "silently_hid_slowed_work"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "slowed_workloads": { "type": "array", "items": { "type": "string" } },
        "paused_workloads": { "type": "array", "items": { "type": "string" } },
        "preserved_protected_tasks": { "type": "array", "items": { "type": "string" } },
        "affected_subsystems_named": { "type": "boolean" },
        "work_dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/work_disposition" }
        },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "silently_hid_slowed_work": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "power_state_examples",
        "throttled_subsystem_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_pressure_sources_into_generic_warning",
        "hides_slowed_work_after_user_visible",
        "hides_what_still_works",
        "invents_alternate_state_label"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "power_state_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/power_state_example" }
        },
        "throttled_subsystem_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/throttled_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_pressure_sources_into_generic_warning": { "const": false },
        "hides_slowed_work_after_user_visible": { "const": false },
        "hides_what_still_works": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    }
  }
}
