{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-contextual-tip-card.schema.json",
  "title": "Aureline M5 contextual-tip-card primitive",
  "description": "Export-safe packet implementing the reusable M5 contextual tip card as one primitive. The packet binds one row per claimed learnability consumer — the first-run onboarding panel, the guided-tour overlay, the command-palette hint, the inline editor tip, and the support tip export — to the shared tip-card anatomy, the tip trigger classes, the command-backing states, the dismissal states, the derived delivery posture (delivered-actionable/delivered-informational/snoozed-for-later/withheld-for-quiet-hours/withheld-for-presentation-mode/withheld-already-resolved), the bounded try/request-approval/open-docs/snooze/dismiss actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks its stable command binding, never hijacks the workflow as a blocking tour, never ignores quiet hours / presentation mode / a recent dismissal, and never bypasses the trust / approval limits of the underlying action. Raw docs bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_contextual_tip_cards_with_why_now_relevance_dismiss_snooze_stable_command_references_and_quiet_hours_safe_delivery_across_claimed_m5_learnability_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "contextual_tip_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "contextual_tip_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "trigger_classes",
        "command_backing_states",
        "dismissal_states",
        "delivery_postures",
        "tip_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "tip_examples",
        "masks_command_binding",
        "hijacks_workflow_as_blocking_tour",
        "ignores_quiet_hours_or_dismissals",
        "bypasses_underlying_trust_limits"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "first_run_onboarding_panel",
            "guided_tour_overlay",
            "command_palette_hint",
            "inline_editor_tip",
            "support_tip_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "trigger_classes": { "type": "array", "minItems": 1 },
        "command_backing_states": { "type": "array", "minItems": 1 },
        "dismissal_states": { "type": "array", "minItems": 1 },
        "delivery_postures": { "type": "array", "minItems": 1 },
        "tip_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tip_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tip_example" }
        },
        "masks_command_binding": { "const": false },
        "hijacks_workflow_as_blocking_tour": { "const": false },
        "ignores_quiet_hours_or_dismissals": { "const": false },
        "bypasses_underlying_trust_limits": { "const": false }
      }
    },
    "tip_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "trigger_class",
            "command_backing",
            "dismissal_state",
            "why_now_relevance",
            "next_action_command_ref",
            "tip_identity_ref",
            "delivery_posture",
            "available_actions",
            "is_command_backed",
            "is_delivered",
            "requires_approval_before_try",
            "teaches_in_place",
            "hijacks_workflow",
            "respects_quiet_hours",
            "respects_presentation_mode",
            "respects_recent_dismissals",
            "is_reversible",
            "honors_underlying_trust_limits"
          ]
        }
      }
    }
  }
}
