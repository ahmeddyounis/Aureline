{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-settings-row.schema.json",
  "title": "Aureline M5 settings-row primitive: effective value, source pill, and lock state",
  "description": "Export-safe packet implementing Aureline's one reusable settings-row primitive across every M5 config-bearing surface — admin/enterprise, workspace trust, AI/model, network/proxy, execution/runtime, extension, and update/config-channel. Each surface row binds the shared settings-row anatomy (label, plain-language description, value control, source pill, reset action, view-diff, source-detail, and open-in-JSON affordances), the settings-row states and source pills reused verbatim from the frozen M5 trust-chronology component matrix, the lock disclosures that keep a locked value's enforced value and lock source visible without hiding the user-configured value, the focus behaviors for search landing and source-detail escalation, and the export fields that let the support export reconstruct effective-value truth. Each surface carries worked resolution cases: a resolver input (per-source contributions plus pending-reload / invalid-value flags) and the resolved effective value, winning source, retained configured value, typed row state, lock source, and shadow chain — the stored resolution must equal a fresh resolve of its input. Hard invariants forbid conflating effective and configured values, hiding the user-configured value when locked, inventing a private row grammar, and dropping export/audit truth. The shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix; the settings-row state, source pill, accessibility route, qualification class, and downgrade trigger vocabularies are reused verbatim from the frozen M5 trust-chronology component matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary; managed values are carried only as the redaction token 'redacted_managed_value'. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_settings_row_effective_value_source_pill_and_lock_state_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "surface_family": {
      "type": "string",
      "enum": [
        "admin_enterprise",
        "workspace_trust",
        "ai_model",
        "network_proxy",
        "execution_runtime",
        "extension_settings",
        "update_channel"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "type": "string",
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "type": "string",
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "anatomy_part": {
      "type": "string",
      "enum": [
        "label",
        "plain_language_description",
        "value_control",
        "source_pill",
        "reset_action",
        "view_diff_affordance",
        "source_detail_affordance",
        "open_in_json_affordance"
      ]
    },
    "row_state": {
      "type": "string",
      "enum": [
        "effective_matches_configured",
        "overridden_by_higher_source",
        "inherited_from_default",
        "locked_by_policy",
        "pending_reload_to_apply",
        "invalid_value_held",
        "redacted_managed_value"
      ]
    },
    "source_pill": {
      "type": "string",
      "enum": [
        "default_value",
        "user_configured",
        "workspace_configured",
        "policy_managed",
        "remote_profile",
        "environment_override"
      ]
    },
    "lock_disclosure": {
      "type": "string",
      "enum": [
        "enforced_value_shown",
        "lock_source_shown",
        "user_configured_value_retained",
        "lock_reason_explained",
        "override_request_path",
        "no_silent_value_hide"
      ]
    },
    "focus_behavior": {
      "type": "string",
      "enum": [
        "search_result_focus_landing",
        "highlight_on_open",
        "source_detail_side_sheet_escalation",
        "inline_explanation_preferred",
        "return_focus_on_close",
        "deep_link_anchor"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "setting_key",
        "effective_value_repr",
        "configured_value_repr",
        "winning_source_pill",
        "row_state",
        "lock_source_pill",
        "shadow_chain"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "effective_configured_conflated",
        "source_pill_missing",
        "lock_state_unexplained",
        "consequence_grouping_dropped",
        "transitive_scope_hidden",
        "re_consent_skipped",
        "verb_vocabulary_drift",
        "provenance_badge_missing",
        "chronology_detail_not_reopenable",
        "export_field_dropped",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "source_contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value_repr", "enforces_lock"],
      "properties": {
        "source": { "$ref": "#/$defs/source_pill" },
        "value_repr": { "$ref": "#/$defs/non_empty_string" },
        "enforces_lock": { "type": "boolean" }
      }
    },
    "resolution_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting_key", "contributions", "pending_reload", "invalid_value_held"],
      "properties": {
        "setting_key": { "$ref": "#/$defs/non_empty_string" },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_contribution" }
        },
        "pending_reload": { "type": "boolean" },
        "invalid_value_held": { "type": "boolean" },
        "held_value_repr": { "type": ["string", "null"] }
      }
    },
    "resolved_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting_key",
        "effective_value_repr",
        "winning_source",
        "row_state",
        "is_locked",
        "differs_from_configured",
        "shadow_chain"
      ],
      "properties": {
        "setting_key": { "$ref": "#/$defs/non_empty_string" },
        "effective_value_repr": { "$ref": "#/$defs/non_empty_string" },
        "winning_source": { "$ref": "#/$defs/source_pill" },
        "configured_value_repr": { "type": ["string", "null"] },
        "row_state": { "$ref": "#/$defs/row_state" },
        "is_locked": { "type": "boolean" },
        "lock_source": {
          "oneOf": [{ "$ref": "#/$defs/source_pill" }, { "type": "null" }]
        },
        "differs_from_configured": { "type": "boolean" },
        "shadow_chain": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_pill" }
        }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/resolution_input" },
        "resolved": { "$ref": "#/$defs/resolved_row" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "anatomy_parts",
        "row_states",
        "source_pills",
        "lock_disclosures",
        "focus_behaviors",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "conflates_effective_and_configured",
        "hides_user_configured_when_locked",
        "invents_private_row_grammar",
        "drops_export_or_audit_truth"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "anatomy_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/anatomy_part" }
        },
        "row_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/row_state" }
        },
        "source_pills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_pill" }
        },
        "lock_disclosures": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/lock_disclosure" }
        },
        "focus_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/focus_behavior" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "conflates_effective_and_configured": { "const": false },
        "hides_user_configured_when_locked": { "const": false },
        "invents_private_row_grammar": { "const": false },
        "drops_export_or_audit_truth": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "anatomy_parts",
        "row_states",
        "source_pills",
        "lock_disclosures",
        "focus_behaviors",
        "export_fields",
        "accessibility_routes"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "$ref": "#/$defs/surface_family" } },
        "anatomy_parts": { "type": "array", "items": { "$ref": "#/$defs/anatomy_part" } },
        "row_states": { "type": "array", "items": { "$ref": "#/$defs/row_state" } },
        "source_pills": { "type": "array", "items": { "$ref": "#/$defs/source_pill" } },
        "lock_disclosures": { "type": "array", "items": { "$ref": "#/$defs/lock_disclosure" } },
        "focus_behaviors": { "type": "array", "items": { "$ref": "#/$defs/focus_behavior" } },
        "export_fields": { "type": "array", "items": { "$ref": "#/$defs/export_field" } },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_effective_versus_configured",
        "source_pill_and_lock_state_always_explained",
        "locked_value_never_hides_user_configured",
        "view_diff_and_source_detail_consistent",
        "search_landing_and_highlight_consistent",
        "support_export_reconstructs_effective_value",
        "no_surface_invents_second_row_grammar",
        "every_row_bound_to_shell_zone",
        "every_row_declares_accessibility_route",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_effective_versus_configured": { "const": true },
        "source_pill_and_lock_state_always_explained": { "const": true },
        "locked_value_never_hides_user_configured": { "const": true },
        "view_diff_and_source_detail_consistent": { "const": true },
        "search_landing_and_highlight_consistent": { "const": true },
        "support_export_reconstructs_effective_value": { "const": true },
        "no_surface_invents_second_row_grammar": { "const": true },
        "every_row_bound_to_shell_zone": { "const": true },
        "every_row_declares_accessibility_route": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_surfaces_consume_shared_primitive",
        "resolver_reads_single_precedence_ladder",
        "lock_explainer_reads_single_source",
        "search_and_deep_link_read_single_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "config_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_precedence_ladder": { "const": true },
        "lock_explainer_reads_single_source": { "const": true },
        "search_and_deep_link_read_single_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "settings_row_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "settings_row_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
