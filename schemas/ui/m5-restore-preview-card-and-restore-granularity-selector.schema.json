{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-restore-preview-card-and-restore-granularity-selector.schema.json",
  "title": "Aureline M5 restore-preview-card / restore-granularity-selector primitive",
  "description": "Export-safe packet implementing the reusable M5 restore-preview card and restore-granularity selector as one primitive pair. The packet binds one row per claimed mutation / recovery consumer — editor restore, AI-apply restore, import restore, repair restore, and recovery center — to the shared preview and selector anatomy, the derived preview posture (clean/local-drift/managed-file/external-drift/conflict/restore-blocked), the derived selector posture (whole-scope/file-scoped/range-scoped/exclude-generated/dry-run-only/blocked), the restore granularities, restore drift states, managed-file caveats, retention postures, export-redaction postures, restore-selection modes, capture fidelities, mutation classes, bounded inspect/restore/resolve/export and inspect/apply/narrow/exclude actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked preview and selector resolution cases proving the resolvers, and four hard invariants: it never masks its past or current state, never hides its drift baseline or a generated-or-managed-file caveat, never collapses a partial restore into a whole-snapshot restore, and never erases the existing history trail. Every restore records a new attributable checkpoint. Raw snapshot bodies, restored file contents, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_restore_preview_cards_with_external_drift_generated_managed_file_caveats_restore_granularity_and_no_history_erasure_truth_across_claimed_m5_mutation_recovery_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "recovery_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "recovery_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "preview_anatomy_parts",
        "selector_anatomy_parts",
        "capture_fidelities",
        "mutation_classes",
        "restore_drift_states",
        "restore_granularities",
        "managed_caveats",
        "retention_postures",
        "export_redaction_postures",
        "selection_modes",
        "preview_postures",
        "selector_postures",
        "preview_actions",
        "selector_actions",
        "preview_export_fields",
        "selector_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "preview_examples",
        "selector_examples",
        "masks_past_or_current_state",
        "hides_drift_or_managed_caveat",
        "collapses_restore_granularity",
        "erases_history_trail"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "editor_restore",
            "ai_apply_restore",
            "import_restore",
            "repair_restore",
            "recovery_center"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "preview_anatomy_parts": { "type": "array", "minItems": 1 },
        "selector_anatomy_parts": { "type": "array", "minItems": 1 },
        "capture_fidelities": { "type": "array", "minItems": 1 },
        "mutation_classes": { "type": "array", "minItems": 1 },
        "restore_drift_states": { "type": "array", "minItems": 1 },
        "restore_granularities": { "type": "array", "minItems": 1 },
        "managed_caveats": { "type": "array", "minItems": 1 },
        "retention_postures": { "type": "array", "minItems": 1 },
        "export_redaction_postures": { "type": "array", "minItems": 1 },
        "selection_modes": { "type": "array", "minItems": 1 },
        "preview_postures": { "type": "array", "minItems": 1 },
        "selector_postures": { "type": "array", "minItems": 1 },
        "preview_actions": { "type": "array", "minItems": 1 },
        "selector_actions": { "type": "array", "minItems": 1 },
        "preview_export_fields": { "type": "array", "minItems": 1 },
        "selector_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "preview_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/preview_example" }
        },
        "selector_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selector_example" }
        },
        "masks_past_or_current_state": { "const": false },
        "hides_drift_or_managed_caveat": { "const": false },
        "collapses_restore_granularity": { "const": false },
        "erases_history_trail": { "const": false }
      }
    },
    "preview_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "preview_posture",
            "object_identity",
            "drift_state",
            "can_restore",
            "has_external_drift",
            "touches_generated_or_managed",
            "creates_new_checkpoint",
            "preserves_history_trail",
            "available_actions"
          ]
        }
      }
    },
    "selector_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "selector_posture",
            "scope_label",
            "available_modes",
            "default_mode",
            "can_apply",
            "can_narrow",
            "creates_new_checkpoint",
            "preserves_history_trail",
            "available_actions"
          ]
        }
      }
    }
  }
}
