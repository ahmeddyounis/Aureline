{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-embedded-boundary-component-certification.schema.json",
  "title": "Aureline M5 embedded-boundary component surface certification packet",
  "description": "M05-1075 closing capstone certifying that the frozen M5 embedded-boundary component families (docs-pane header, embedded-origin bar, boundary-fact grid, marketplace-account-boundary card, auth-handoff card, remote-service-dashboard header, open-in-browser-handoff row, embedded-state panel) hold their truth on every claimed M5 embedded / browser-handoff surface. Keyed on the claimed surface (docs/help pane, marketplace pane, account pane, remote/service dashboard, extension-owned webview, auth handoff, support/export, CLI/headless), each row certifies the surface across six truth axes — visual, keyboard, screen-reader, CLI/export, degraded-state, and boundary-truth behavior — and either passes (green), auto-narrows its boundary-support claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh first-party full-truth claim inherited from a healthier surface. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; a stale/offline/provider-blocked pane can never keep a fresh first-party full-truth claim and no embedded surface may imitate native permission or approval chrome. Every row cites exactly one canonical embedded-boundary proof bundle. The packet is metadata-only: raw credentials, session tokens, and provider secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_embedded_boundary_component_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-embedded-boundary-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_surface": {
      "enum": [
        "docs_help_pane",
        "marketplace_pane",
        "account_pane",
        "remote_service_dashboard",
        "embedded_webview",
        "auth_handoff",
        "support_export",
        "cli_headless"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "boundary_truth"
      ]
    },
    "support_claim": {
      "enum": [
        "full_truth",
        "resolved_truth",
        "degraded",
        "stale",
        "offline",
        "provider_blocked"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "surface_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "docs_pane_header",
        "embedded_origin_bar",
        "boundary_fact_grid",
        "marketplace_account_boundary_card",
        "auth_handoff_card",
        "remote_service_dashboard_header",
        "open_in_browser_handoff_row",
        "embedded_state_panel"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "owner_or_origin_unstated",
        "data_boundary_unstated",
        "browser_fallback_hidden_in_menus_only",
        "capability_limits_unstated",
        "stale_or_blocked_shown_as_fresh",
        "account_scope_unstated",
        "freshness_or_last_updated_unstated",
        "provider_health_unstated",
        "imitates_native_approval_chrome",
        "high_risk_approval_embedded",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/support_claim" },
        "to_claim": { "$ref": "#/$defs/support_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_embedded_boundary_component_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/certified_surface" },
        "claimed_claim": { "$ref": "#/$defs/support_claim" },
        "certified_claim": { "$ref": "#/$defs/support_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-embedded-boundary-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/surface_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "every_axis_covered_on_every_row",
        "narrowed_surface_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
