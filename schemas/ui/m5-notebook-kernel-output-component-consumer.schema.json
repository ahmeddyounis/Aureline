{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-notebook-kernel-output-component-consumer.schema.json",
  "title": "Aureline M5 notebook-kernel-output component consumer adoption",
  "description": "M05-1090 consumer-adoption lane over the frozen M5 notebook-kernel-output component matrix. Proves that the eight reusable notebook document / kernel / output component families (notebook-document header, kernel-state strip, kernel-picker row, kernel-origin pill, output-trust banner, output-provenance chip group, restart-consequence card, kernel-recovery card) are reused as primitives across the claimed M5 notebook / data consumer classes — notebook editor, diff/review, debug, AI context, CLI/headless, and support/export + release packets — rather than being reinvented as per-feature notebook chrome. Each row points back to exactly one canonical component family (its matrix schema) and the one canonical controls contract (schema + doc + release-proof artifact) its family group belongs to, and preserves the identical document-identity, kernel-state, kernel-selection, kernel-origin, output-trust, output-provenance, restart-consequence, and recovery-continuity labels plus the frozen kernel/output disposition vocabulary. The same document / kernel / output / recovery state renders with one vocabulary and one component family across every claimed consumer (AC1); support/export/release packets drop bespoke feature-local translation tables (AC2). The four spec guardrails stay false per row: no consumer lets a kernel recovery card imply a rerun, presents stale output as live, hides its raw/sanitized/active trust class behind a hover-only affordance, or collapses local, SSH, container, managed, or browser-bridge kernels into one unlabeled badge. The packet is metadata-only: raw kernel connection strings, credential material, and bearer secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_notebook_kernel_output_component_consumer_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "notebook_document_header",
        "kernel_state_strip",
        "kernel_picker_row",
        "kernel_origin_pill",
        "output_trust_banner",
        "output_provenance_chip_group",
        "restart_consequence_card",
        "kernel_recovery_card"
      ]
    },
    "controls_lane": {
      "type": "string",
      "enum": [
        "document_kernel",
        "kernel_choice",
        "output_trust",
        "restart_recovery"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "notebook_editor",
        "diff_review",
        "debug",
        "ai_context",
        "cli",
        "support_export"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "notebook_ui",
        "kernel_manager_ui",
        "output_viewer_ui",
        "debugger_ui",
        "ai_context_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "authority_mode": {
      "type": "string",
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "override_gated",
        "export_only",
        "policy_blocked"
      ]
    },
    "handoff_target": {
      "type": "string",
      "enum": [
        "none",
        "notebook_desktop",
        "kernel_manager",
        "browser_readonly",
        "support_packet",
        "cli_headless"
      ]
    },
    "label_parity": {
      "type": "string",
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_class",
        "consumer_surface",
        "component_family",
        "controls_lane",
        "canonical_family_schema_ref",
        "canonical_controls_schema_ref",
        "canonical_controls_artifact_refs",
        "references_canonical_not_local_prose",
        "notebook_state_ref",
        "authority_mode",
        "preserved_label_families",
        "notebook_disposition_vocab",
        "label_parity",
        "handoff_target",
        "copy_export",
        "recovery_card_implies_rerun",
        "presents_stale_output_as_live",
        "hides_trust_class_behind_hover_only",
        "collapses_kernel_origins_into_one_badge",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_notebook_kernel_output_component_consumer_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_class": { "$ref": "#/$defs/consumer_class" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "controls_lane": { "$ref": "#/$defs/controls_lane" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "notebook_state_ref": { "type": "string", "minLength": 1 },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "notebook_disposition_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "recovery_card_implies_rerun": { "type": "boolean", "const": false },
        "presents_stale_output_as_live": { "type": "boolean", "const": false },
        "hides_trust_class_behind_hover_only": { "type": "boolean", "const": false },
        "collapses_kernel_origins_into_one_badge": { "type": "boolean", "const": false },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_class_count",
        "consumer_surface_count",
        "component_family_count",
        "controls_lane_count",
        "disposition_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_use_canonical_controls_lane",
        "all_runtime_rows_preserve_primary_truth",
        "all_rows_reconstructable",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "all_rows_guardrails_clear",
        "controls_lanes_stable_across_surfaces",
        "notebook_editor_consumer_present",
        "diff_review_consumer_present",
        "debug_consumer_present",
        "ai_context_consumer_present",
        "cli_consumer_present",
        "support_export_consumer_present",
        "editor_reference_present",
        "support_export_reference_present",
        "label_family_coverage_complete",
        "disposition_coverage_complete",
        "families_reused_across_classes"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_class_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "controls_lane_count": { "type": "integer", "minimum": 0 },
        "disposition_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_use_canonical_controls_lane": { "type": "boolean" },
        "all_runtime_rows_preserve_primary_truth": { "type": "boolean" },
        "all_rows_reconstructable": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "all_rows_guardrails_clear": { "type": "boolean" },
        "controls_lanes_stable_across_surfaces": { "type": "boolean" },
        "notebook_editor_consumer_present": { "type": "boolean" },
        "diff_review_consumer_present": { "type": "boolean" },
        "debug_consumer_present": { "type": "boolean" },
        "ai_context_consumer_present": { "type": "boolean" },
        "cli_consumer_present": { "type": "boolean" },
        "support_export_consumer_present": { "type": "boolean" },
        "editor_reference_present": { "type": "boolean" },
        "support_export_reference_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "disposition_coverage_complete": { "type": "boolean" },
        "families_reused_across_classes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
