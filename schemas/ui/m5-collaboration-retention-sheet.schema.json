{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-collaboration-retention-sheet.schema.json",
  "title": "Aureline M5 collaboration retention sheet",
  "description": "Canonical per-domain descriptor for one recording / retention / sealed-archive review. Names the recording state, the retention mode and duration, the replayable-archive scope, and the export / support-evidence scope so recording, transcript retention, replayable archives, and route visibility never widen silently and no raw secret is exported. Raw secrets, raw command text, raw variable bodies, and raw clipboard contents never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "collaboration_control_association",
    "consent_retention_gate",
    "recording_state",
    "session_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "retention_review"
      ]
    },
    "collaboration_control_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "consent_retention_gate": {
      "$ref": "#/$defs/consent_retention_gate"
    },
    "recording_state": {
      "$ref": "#/$defs/non_empty_string"
    },
    "retention_mode_and_duration": {
      "$ref": "#/$defs/non_empty_string"
    },
    "replayable_archive_scope": {
      "$ref": "#/$defs/non_empty_string"
    },
    "session_state": {
      "$ref": "#/$defs/session_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "consent_retention_gate": {
      "enum": [
        "consent_current_recording_allowed",
        "blocked_by_missing_join_consent",
        "blocked_by_consent_renewal_required",
        "blocked_by_retention_scope_widening",
        "blocked_by_guest_scope_or_route_expansion"
      ]
    },
    "session_state": {
      "enum": [
        "viewer",
        "commenter",
        "editor",
        "driver",
        "navigator",
        "presenter_moderator",
        "live_only",
        "metadata_audit",
        "replayable_text_comment_timeline",
        "elevated_support_evidence",
        "control_requested",
        "control_granted",
        "control_expired",
        "recording_active",
        "consent_renewal_required",
        "restore_view_only"
      ]
    }
  }
}
