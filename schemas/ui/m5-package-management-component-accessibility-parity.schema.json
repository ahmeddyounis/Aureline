{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-package-management-component-accessibility-parity.schema.json",
  "title": "M5 Package-Management Component Accessibility, Headless, and Export Parity Packet",
  "description": "Export-safe packet proving that the eight shared M5 package-management components (package explorer row, manifest-scope switcher, install-review sheet, registry-or-mirror row, script-risk notice, lockfile-impact card, grouped-update planner, rollback/checkpoint strip) expose keyboard, screen-reader, CLI, and export forms at parity with the desktop, and that each component's reviewable-management claim automatically narrows to the ceiling permitted by its condition when the target manifest scope is only partially known, registry freshness is stale, auth state is unsatisfied, lockfile-impact computation is unavailable, or the rollback/checkpoint truth is unavailable or policy-blocked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "accessibility_rows",
    "downgrade_triggers",
    "rendering_surfaces",
    "trust_review",
    "projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "package_management_component_accessibility_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "accessibility_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "rendering_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rendering_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "projection": { "$ref": "#/$defs/projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "package_explorer_row",
        "manifest_scope_switcher",
        "install_review_sheet",
        "registry_or_mirror_row",
        "script_risk_notice",
        "lockfile_impact_card",
        "grouped_update_planner",
        "rollback_checkpoint_strip"
      ]
    },
    "claim_condition": {
      "type": "string",
      "enum": [
        "package_truth_trusted",
        "manifest_scope_partial",
        "registry_freshness_stale",
        "auth_state_unsatisfied",
        "lockfile_impact_unavailable",
        "rollback_checkpoint_unavailable"
      ]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "full_reviewable_management",
        "manifest_range_scoped",
        "mirror_or_offline_sourced",
        "auth_required_read_only",
        "lockfile_impact_unknown",
        "rollback_unavailable_manual_recovery"
      ]
    },
    "rendering_surface": {
      "type": "string",
      "enum": ["desktop_full", "cli_headless", "support_export"]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "continue_reviewed_management",
        "confirm_manifest_scope",
        "review_mirror_or_offline_continuity",
        "authenticate_to_registry",
        "recompute_lockfile_impact",
        "establish_rollback_checkpoint"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "manifest_scope_partial",
        "registry_freshness_stale",
        "auth_state_unsatisfied",
        "lockfile_impact_unavailable",
        "rollback_checkpoint_unavailable",
        "claim_overstated",
        "parity_dropped",
        "trust_narrowing"
      ]
    },
    "claim_narrowing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "narrowed_to", "preserved_truth_note", "next_action", "next_action_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_to": { "$ref": "#/$defs/claim_tier" },
        "preserved_truth_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "condition",
        "effective_claim",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "rendering_surfaces",
        "narrowing",
        "scope_disclosure_note",
        "continuity_note",
        "auth_note",
        "rollback_note",
        "is_pointer_only",
        "is_export_opaque",
        "desktop_stronger_than_cli",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "condition": { "$ref": "#/$defs/claim_condition" },
        "effective_claim": { "$ref": "#/$defs/claim_tier" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "rendering_surfaces": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing": {
          "oneOf": [{ "$ref": "#/$defs/claim_narrowing" }, { "type": "null" }]
        },
        "scope_disclosure_note": { "type": "string" },
        "continuity_note": { "type": "string" },
        "auth_note": { "type": "string" },
        "rollback_note": { "type": "string" },
        "is_pointer_only": { "const": false },
        "is_export_opaque": { "const": false },
        "desktop_stronger_than_cli": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Trusted package truth keeps the full claim and never narrows.",
          "if": { "properties": { "condition": { "const": "package_truth_trusted" } } },
          "then": { "properties": { "narrowing": { "type": "null" } } }
        },
        {
          "comment": "Any weakening condition must carry an explicit narrow disclosure and keep manifest scope and side-effect class explicit.",
          "if": {
            "properties": {
              "condition": {
                "enum": [
                  "manifest_scope_partial",
                  "registry_freshness_stale",
                  "auth_state_unsatisfied",
                  "lockfile_impact_unavailable",
                  "rollback_checkpoint_unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "narrowing": { "$ref": "#/$defs/claim_narrowing" },
              "scope_disclosure_note": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "comment": "Stale registry freshness must keep mirror/offline continuity explicit.",
          "if": {
            "properties": { "condition": { "const": "registry_freshness_stale" } }
          },
          "then": {
            "properties": { "continuity_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "Unsatisfied auth state must keep the registry-auth posture explicit.",
          "if": {
            "properties": { "condition": { "const": "auth_state_unsatisfied" } }
          },
          "then": {
            "properties": { "auth_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "Unavailable rollback / checkpoint truth must stay explicit before any write.",
          "if": {
            "properties": { "condition": { "const": "rollback_checkpoint_unavailable" } }
          },
          "then": {
            "properties": { "rollback_note": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard_reachable_on_every_claim",
        "screen_reader_labeled_on_every_claim",
        "cli_enum_exposed_on_every_claim",
        "export_enum_exposed_on_every_claim",
        "explanation_field_present_on_every_claim",
        "no_component_pointer_only",
        "no_component_export_opaque",
        "desktop_never_stronger_than_cli",
        "claim_narrows_when_package_truth_weakens",
        "scope_and_side_effect_never_overstated_under_weakening",
        "mirror_offline_continuity_kept_explicit",
        "rollback_checkpoint_truth_kept_explicit_before_write"
      ],
      "properties": {
        "keyboard_reachable_on_every_claim": { "const": true },
        "screen_reader_labeled_on_every_claim": { "const": true },
        "cli_enum_exposed_on_every_claim": { "const": true },
        "export_enum_exposed_on_every_claim": { "const": true },
        "explanation_field_present_on_every_claim": { "const": true },
        "no_component_pointer_only": { "const": true },
        "no_component_export_opaque": { "const": true },
        "desktop_never_stronger_than_cli": { "const": true },
        "claim_narrows_when_package_truth_weakens": { "const": true },
        "scope_and_side_effect_never_overstated_under_weakening": { "const": true },
        "mirror_offline_continuity_kept_explicit": { "const": true },
        "rollback_checkpoint_truth_kept_explicit_before_write": { "const": true }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposes_keyboard_and_screen_reader_labels",
        "exposes_cli_and_export_enums",
        "exposes_explanation_fields",
        "auto_narrows_on_partial_manifest_scope",
        "auto_narrows_on_stale_registry_freshness",
        "auto_narrows_on_unsatisfied_auth_state",
        "auto_narrows_on_unavailable_lockfile_impact",
        "auto_narrows_on_unavailable_rollback_checkpoint",
        "desktop_cli_export_semantics_identical",
        "narrowing_prevents_overstated_package_management_scope"
      ],
      "properties": {
        "exposes_keyboard_and_screen_reader_labels": { "const": true },
        "exposes_cli_and_export_enums": { "const": true },
        "exposes_explanation_fields": { "const": true },
        "auto_narrows_on_partial_manifest_scope": { "const": true },
        "auto_narrows_on_stale_registry_freshness": { "const": true },
        "auto_narrows_on_unsatisfied_auth_state": { "const": true },
        "auto_narrows_on_unavailable_lockfile_impact": { "const": true },
        "auto_narrows_on_unavailable_rollback_checkpoint": { "const": true },
        "desktop_cli_export_semantics_identical": { "const": true },
        "narrowing_prevents_overstated_package_management_scope": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
