{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-cross-surface-component-consumer.schema.json",
  "title": "M5 Cross-Surface Component Consumer Packet",
  "description": "First-consumer adoption of the frozen M5 profiler/topology component families across performance, search/graph, onboarding/explainer, AI/review, and incident/support surfaces (M05-802). Each row points back to exactly one canonical component family and preserves capture/source badges, workset scope language, citation vocabulary, and degraded-state labels even when the consumer is read-only or export-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_cross_surface_component_consumer_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "profile_session_card",
        "flamegraph_view",
        "icicle_view",
        "call_tree_row",
        "heap_profile_compare_card",
        "trace_timeline",
        "workset_switcher_row",
        "topology_node_card",
        "ownership_card",
        "explainer_section_card"
      ]
    },
    "consumer_group": {
      "type": "string",
      "enum": [
        "performance_tooling",
        "search_graph_understanding",
        "onboarding_explainer",
        "ai_review",
        "incident_support"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "desktop_profiler_workspace",
        "hotspot_workspace",
        "trace_viewer",
        "heap_analysis",
        "profile_compare",
        "topology_map",
        "ownership_browser",
        "architecture_explainer",
        "search_results",
        "review_workspace",
        "onboarding_tour",
        "ai_context_panel",
        "incident_workspace",
        "docs_help",
        "cli_headless",
        "support_export",
        "release_proof"
      ]
    },
    "authority_mode": {
      "type": "string",
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "compare_only",
        "export_only",
        "policy_blocked"
      ]
    },
    "handoff_target": {
      "type": "string",
      "enum": ["none", "companion_app", "browser_readonly", "handoff_packet", "cli_headless"]
    },
    "label_parity_state": {
      "type": "string",
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "live",
        "current",
        "warm_cached",
        "cached",
        "imported",
        "stale",
        "superseded",
        "partial",
        "expired",
        "policy_limited",
        "unknown"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "json": { "type": "string" },
        "markdown": { "type": "string" },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "severity", "capability_state", "visible_label"],
      "properties": {
        "banner_id": { "type": "string" },
        "severity": { "type": "string" },
        "capability_state": { "type": "string" },
        "visible_label": { "type": "string" },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } },
        "preserved_fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "support_export_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_id",
        "schema_ref",
        "raw_profile_samples_exported",
        "raw_trace_events_exported",
        "gui_cli_support_label_parity"
      ],
      "properties": {
        "join_id": { "type": "string" },
        "schema_ref": { "type": "string" },
        "joined_object_kinds": { "type": "array", "items": { "type": "string" } },
        "raw_profile_samples_exported": { "type": "boolean" },
        "raw_trace_events_exported": { "type": "boolean" },
        "gui_cli_support_label_parity": { "type": "boolean" }
      }
    },
    "auto_narrowing_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stale_or_missing_effect",
        "policy_blocked_effect",
        "degraded_state_reason_field",
        "release_help_claim_ceiling"
      ],
      "properties": {
        "narrow_on_missing_or_stale": { "type": "array", "items": { "type": "string" } },
        "stale_or_missing_effect": { "type": "string" },
        "policy_blocked_effect": { "type": "string" },
        "degraded_state_reason_field": { "type": "string" },
        "release_help_claim_ceiling": { "type": "string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_group",
        "consumer_surface",
        "component_family",
        "canonical_family_schema_ref",
        "canonical_packet_refs",
        "references_canonical_not_local_prose",
        "authority_mode",
        "freshness_state",
        "preserved_badge_labels",
        "degraded_state_vocab",
        "label_parity",
        "handoff_target",
        "copy_export",
        "reduced_capability_banner",
        "support_export_join",
        "auto_narrowing_contract"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "m5_cross_surface_component_consumer_row" },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_group": { "$ref": "#/$defs/consumer_group" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_packet_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "preserved_badge_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "degraded_state_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity_state" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "support_export_join": { "$ref": "#/$defs/support_export_join" },
        "auto_narrowing_contract": { "$ref": "#/$defs/auto_narrowing_contract" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_group_count",
        "consumer_surface_count",
        "component_family_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "performance_consumer_present",
        "search_graph_consumer_present",
        "onboarding_explainer_consumer_present",
        "ai_review_consumer_present",
        "incident_support_consumer_present",
        "help_support_release_reference_present"
      ],
      "properties": {
        "row_count": { "type": "integer" },
        "consumer_group_count": { "type": "integer" },
        "consumer_surface_count": { "type": "integer" },
        "component_family_count": { "type": "integer" },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "performance_consumer_present": { "type": "boolean" },
        "search_graph_consumer_present": { "type": "boolean" },
        "onboarding_explainer_consumer_present": { "type": "boolean" },
        "ai_review_consumer_present": { "type": "boolean" },
        "incident_support_consumer_present": { "type": "boolean" },
        "help_support_release_reference_present": { "type": "boolean" }
      }
    }
  }
}
