{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-package-management-component-matrix.schema.json",
  "title": "Aureline M5 package-management component matrix",
  "description": "Export-safe packet freezing the M5 component truth for eight reusable package-management surfaces: package explorer rows, manifest-scope switchers, install-review sheets, registry/mirror rows, script-risk notices, lockfile-impact cards, grouped-update planners, and rollback/checkpoint strips. Each component row binds a maturity class to the exact manifest-scope, registry-source, auth-posture, script/native-build, lockfile-churn, and rollback/checkpoint disclosures it must preserve, plus its registry-degradation narrowing vocabulary, evidence requirements, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. Raw manifest bodies, raw lockfile bodies, registry credentials, private registry URLs, and live registry responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_package_management_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "component": {
      "type": "string",
      "enum": [
        "package_explorer_row",
        "manifest_scope_switcher",
        "install_review_sheet",
        "registry_or_mirror_row",
        "script_risk_notice",
        "lockfile_impact_card",
        "grouped_update_planner",
        "rollback_checkpoint_strip"
      ]
    },
    "maturity_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "optional",
        "not_applicable"
      ]
    },
    "degradation_state": {
      "type": "string",
      "enum": [
        "resolved_exact",
        "manifest_range_only",
        "mirror_backed",
        "offline_snapshot_only",
        "auth_required_unsatisfied",
        "unknown_or_stale"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "registry_unreachable",
        "auth_required",
        "mirror_backed_only",
        "offline_snapshot_only",
        "lockfile_divergent",
        "script_or_native_build_risk",
        "broad_lockfile_regeneration",
        "rollback_unavailable",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "staged_review_no_write",
        "write_back_checkpointed",
        "regenerate_only_no_manual_edit",
        "compensating_only_no_clean_revert",
        "not_applicable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "package_workspace",
        "dependency_explorer",
        "install_update_review",
        "registry_auth_workspace",
        "rollback_recovery",
        "browser_companion",
        "cli_headless",
        "support_export",
        "help_about"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "maturity",
        "scope_summary",
        "manifest_scope_disclosure",
        "registry_source_disclosure",
        "auth_posture_disclosure",
        "script_native_build_disclosure",
        "lockfile_churn_disclosure",
        "rollback_checkpoint_disclosure",
        "degradation_narrowing_vocab",
        "evidence_requirement",
        "required_evidence_packet_refs",
        "downgrade_triggers",
        "rollback_posture",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/component"
        },
        "maturity": {
          "$ref": "#/$defs/maturity_class"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "manifest_scope_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "registry_source_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auth_posture_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "script_native_build_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "lockfile_churn_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_checkpoint_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "degradation_narrowing_vocab": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/degradation_state"
          }
        },
        "evidence_requirement": {
          "$ref": "#/$defs/evidence_requirement"
        },
        "required_evidence_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_scope_always_explicit",
        "direct_transitive_state_explicit",
        "registry_source_always_explicit",
        "auth_posture_never_hidden",
        "script_native_build_risk_explicit",
        "lockfile_churn_never_understated",
        "grouped_update_reason_explicit",
        "rollback_checkpoint_identity_explicit",
        "mirror_offline_continuity_explicit",
        "one_click_never_conceals_scope_or_risk",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "manifest_scope_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "direct_transitive_state_explicit": {
          "type": "boolean",
          "const": true
        },
        "registry_source_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "auth_posture_never_hidden": {
          "type": "boolean",
          "const": true
        },
        "script_native_build_risk_explicit": {
          "type": "boolean",
          "const": true
        },
        "lockfile_churn_never_understated": {
          "type": "boolean",
          "const": true
        },
        "grouped_update_reason_explicit": {
          "type": "boolean",
          "const": true
        },
        "rollback_checkpoint_identity_explicit": {
          "type": "boolean",
          "const": true
        },
        "mirror_offline_continuity_explicit": {
          "type": "boolean",
          "const": true
        },
        "one_click_never_conceals_scope_or_risk": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_explorer_row_shows_manifest_and_relation",
        "manifest_scope_switcher_shows_target_and_confirmation",
        "install_review_sheet_shows_scope_script_and_lockfile",
        "registry_or_mirror_row_shows_source_and_auth",
        "script_risk_notice_shows_script_native_build_risk",
        "lockfile_impact_card_shows_churn_without_understating",
        "grouped_update_planner_shows_reason_and_constraints",
        "rollback_checkpoint_strip_shows_checkpoint_identity",
        "cli_headless_shows_component_truth",
        "support_export_shows_component_truth"
      ],
      "properties": {
        "package_explorer_row_shows_manifest_and_relation": {
          "type": "boolean",
          "const": true
        },
        "manifest_scope_switcher_shows_target_and_confirmation": {
          "type": "boolean",
          "const": true
        },
        "install_review_sheet_shows_scope_script_and_lockfile": {
          "type": "boolean",
          "const": true
        },
        "registry_or_mirror_row_shows_source_and_auth": {
          "type": "boolean",
          "const": true
        },
        "script_risk_notice_shows_script_native_build_risk": {
          "type": "boolean",
          "const": true
        },
        "lockfile_impact_card_shows_churn_without_understating": {
          "type": "boolean",
          "const": true
        },
        "grouped_update_planner_shows_reason_and_constraints": {
          "type": "boolean",
          "const": true
        },
        "rollback_checkpoint_strip_shows_checkpoint_identity": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_component_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_component_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
