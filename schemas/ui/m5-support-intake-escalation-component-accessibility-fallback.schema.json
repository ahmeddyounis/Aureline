{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-intake-escalation-component-accessibility-fallback.schema.json",
  "title": "Aureline M5 support-intake / escalation component accessibility fallback and auto-narrowing packet",
  "description": "M05-906 keyboard / screen-reader / CLI / export parity and honest auto-narrowing capstone over the frozen M5 support-intake / escalation component matrix. Metadata-only: typed class tokens, opaque refs, booleans, and redacted labels; never raw logs, transcripts, attachment bytes, or credential-bearing material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_support_intake_escalation_component_accessibility_fallback_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "support_claim": {
      "type": "string",
      "enum": [
        "ready_to_escalate",
        "reviewable_case",
        "local_only_diagnosis",
        "evidence_incomplete_case",
        "unclassified_scenario",
        "policy_blocked_repair"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "scenario_classification",
        "evidence_completeness",
        "destination_reach",
        "handoff_continuity",
        "repair_guidance"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "classified",
        "local_only_destination",
        "evidence_omitted",
        "scenario_uncertain",
        "repair_policy_blocked"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "scenario_or_scope_unstated",
        "doctor_finding_lineage_unstated",
        "evidence_class_masked",
        "redaction_state_undisclosed",
        "packet_destination_unstated",
        "next_human_step_unstated",
        "approved_repair_class_masked",
        "unsafe_fix_block_reason_hidden",
        "case_disposition_unstated",
        "handoff_stage_collapsed",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "handoff_packet",
        "support_export"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "component_family": {
      "type": "string",
      "enum": [
        "support_scenario_picker_row",
        "issue_report_builder_step",
        "escalation_packet_summary",
        "handoff_timeline_row",
        "unsafe_fix_blocked_note"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "scenario_and_scope",
        "evidence_and_redaction",
        "destination_and_next_step"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "doctor_ui",
        "support_center_ui",
        "report_builder_ui",
        "escalation_desk_ui",
        "recovery_center_ui",
        "help_center_ui",
        "support_export",
        "cli_inspect",
        "product_ui"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_lineage_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/support_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_lineage_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "support_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_support_claim",
        "claim_conditions",
        "lineage_preserved",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_support_intake_escalation_component_accessibility_fallback_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "support_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/reach_state" },
        "cli_reach": { "$ref": "#/$defs/reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_support_claim": { "$ref": "#/$defs/support_claim" },
        "claim_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition_entry" }
        },
        "claim_narrow": { "$ref": "#/$defs/claim_narrow" },
        "lineage_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "hierarchy_heavy_family_count",
        "all_hierarchy_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_export_summaries_preserve_meaning",
        "all_lineage_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "hierarchy_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_hierarchy_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_lineage_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
