{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-approver-matrix.schema.json",
  "title": "Aureline M5 approver matrix",
  "description": "Per-component contract for an approver matrix: the reusable component that names which approvers are required per protected path and each approver's state rather than a single approved/blocked pill. Binds the frozen governance-state vocabulary plus the approver state (satisfied, waived, expired, or stale) and enforcement authority so waived and expired approvals stay explicit and a local prediction is never asserted as the provider's decision. The Rust validator in crates/aureline-review is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "required_approver_label",
    "approver_state",
    "enforcement_authority",
    "governance_state_vocab"
  ],
  "properties": {
    "component": {
      "const": "approver_matrix"
    },
    "required_approver_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "approver_state": {
      "$ref": "#/$defs/approver_state"
    },
    "enforcement_authority": {
      "$ref": "#/$defs/enforcement_authority"
    },
    "governance_state_vocab": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/governance_state_vocab"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "approver_state": {
      "enum": [
        "satisfied",
        "waived",
        "expired",
        "stale"
      ]
    },
    "enforcement_authority": {
      "enum": [
        "advisory",
        "authoritative",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "governance_state_vocab": {
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    }
  }
}
