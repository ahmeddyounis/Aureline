{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-resume-summary-stale-note-controls.schema.json",
  "title": "Aureline M5 resume-summary card and stale-result continuity note controls",
  "description": "Export-safe packet for the fourth and final implement lane over the frozen M5 efficiency component matrix. It carries resolved, honest projections of the resume-summary card and the stale-result continuity note across the claimed M5 recovery surfaces. Each controls row binds a consumer surface to the resolved resume-summary-card examples (listing what resumed, what backlog remains, whether stale results are still visible, and the safest next action for the current task) and the resolved stale-result continuity-note examples (stating that a still-visible result is cached, partial, or based on a prior constrained state after recovery). AC1 is proven by cards and notes that keep a live stale result visible after recovery, degrading to stale_result_evidence_dropped or stale_evidence_silently_removed when they hide it; AC2 is proven by cards that carry one durable summary of resumed work, degrading to recovery_summary_not_durable or resume_backlog_hidden rather than reading clean. Hard invariants forbid clearing stale-result context merely because work resumed, requiring recovery to be inferred from transient banners, hiding the resumed-work backlog, and collapsing distinct pressure sources into one generic warning. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_resume_summary_card_and_stale_result_continuity_note_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "efficiency_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "efficiency_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "work_disposition": {
      "enum": [
        "running_full",
        "slowed",
        "paused",
        "policy_blocked",
        "override_available",
        "override_blocked",
        "resuming",
        "stale_result_shown",
        "not_evaluated"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "resume_summary_example": {
      "type": "object",
      "required": [
        "card_id",
        "recovery_state",
        "resumed_workloads",
        "backlog_workloads",
        "work_disposition",
        "stale_result_state",
        "stale_results_visible",
        "backlog_known",
        "durable_summary_present",
        "next_safe_action_stated",
        "stale_evidence_preserved",
        "degrade_reason",
        "next_action",
        "silently_dropped_stale_evidence"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "recovery_state": { "$ref": "#/$defs/non_empty_string" },
        "resumed_workloads": { "type": "array", "items": { "type": "string" } },
        "backlog_workloads": { "type": "array", "items": { "type": "string" } },
        "work_disposition": { "$ref": "#/$defs/work_disposition" },
        "stale_result_state": { "$ref": "#/$defs/non_empty_string" },
        "stale_results_visible": { "type": "boolean" },
        "backlog_known": { "type": "boolean" },
        "durable_summary_present": { "type": "boolean" },
        "next_safe_action_stated": { "type": "boolean" },
        "stale_evidence_preserved": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "silently_dropped_stale_evidence": { "type": "boolean" }
      }
    },
    "stale_result_note_example": {
      "type": "object",
      "required": [
        "note_id",
        "stale_result_state",
        "work_disposition",
        "returned_to_nominal",
        "stale_results_visible",
        "based_on_constrained_state_stated",
        "refresh_path_stated",
        "stale_evidence_preserved",
        "degrade_reason",
        "next_action",
        "silently_removed_stale_evidence"
      ],
      "properties": {
        "note_id": { "$ref": "#/$defs/non_empty_string" },
        "stale_result_state": { "$ref": "#/$defs/non_empty_string" },
        "work_disposition": { "$ref": "#/$defs/work_disposition" },
        "returned_to_nominal": { "type": "boolean" },
        "stale_results_visible": { "type": "boolean" },
        "based_on_constrained_state_stated": { "type": "boolean" },
        "refresh_path_stated": { "type": "boolean" },
        "stale_evidence_preserved": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "silently_removed_stale_evidence": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "resume_summary_examples",
        "stale_result_note_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "clears_stale_result_context_on_resume",
        "requires_inferring_recovery_from_transient_banners",
        "hides_resumed_work_backlog",
        "collapses_pressure_sources_into_generic_warning"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "resume_summary_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resume_summary_example" }
        },
        "stale_result_note_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stale_result_note_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "clears_stale_result_context_on_resume": { "const": false },
        "requires_inferring_recovery_from_transient_banners": { "const": false },
        "hides_resumed_work_backlog": { "const": false },
        "collapses_pressure_sources_into_generic_warning": { "const": false }
      }
    }
  }
}
