{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-trust-chronology-components.schema.json",
  "title": "Aureline M5 settings-row, capability-sheet, evidence-chronology, and chronology-export component matrix",
  "description": "Export-safe packet freezing Aureline's highest-trust reusable UI components. The packet names every component family M5 claims that still drifts too easily by feature lane — settings rows, permission/capability sheets, event/history rows, timeline groups, narrative summary cards, and chronology export previews — and binds each to a canonical shell zone, the responsive classes it must survive, the window classes it keeps continuity across, and the claimed M5 surface families that render it. Each component declares the controlled vocabularies it carries: settings-row states and source pills, capability consequence classes and scope states, chronology verbs and provenance badges, chronology detail states, chronology export fields, non-visual accessibility routes, and mandatory labels. Hard invariants forbid conflating effective and configured values, hiding permission scope, inventing a private row grammar, and dropping audit/support truth off the primary surface. The shell zone, responsive class, window class, consumer surface, and surface family vocabularies are reused verbatim from the frozen M5 shell-zone matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_settings_row_capability_sheet_evidence_chronology_and_chronology_export_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "settings_row",
        "capability_sheet",
        "event_history_row",
        "timeline_group",
        "narrative_summary_card",
        "chronology_export_preview"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook",
        "data_grid",
        "profiler",
        "pipeline",
        "docs",
        "preview",
        "review",
        "incident",
        "companion",
        "operator"
      ]
    },
    "consumer_surface": {
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "provenance",
        "effective_value",
        "audit_reopen_path"
      ]
    },
    "settings_row_state": {
      "enum": [
        "effective_matches_configured",
        "overridden_by_higher_source",
        "inherited_from_default",
        "locked_by_policy",
        "pending_reload_to_apply",
        "invalid_value_held",
        "redacted_managed_value"
      ]
    },
    "source_pill": {
      "enum": [
        "default_value",
        "user_configured",
        "workspace_configured",
        "policy_managed",
        "remote_profile",
        "environment_override"
      ]
    },
    "consequence_class": {
      "enum": [
        "read_local_context",
        "modify_workspace",
        "execute_code",
        "network_access",
        "credential_access",
        "system_control"
      ]
    },
    "capability_scope_state": {
      "enum": [
        "requested_not_granted",
        "granted_full_scope",
        "granted_reduced_scope",
        "transitive_scope_disclosed",
        "re_consent_required",
        "revoked_with_history"
      ]
    },
    "chronology_verb": {
      "enum": [
        "created",
        "updated",
        "ran",
        "approved",
        "rejected",
        "failed",
        "recovered",
        "exported"
      ]
    },
    "provenance_badge": {
      "enum": [
        "human_initiated",
        "ai_initiated",
        "automation_initiated",
        "remote_actor",
        "system_initiated",
        "replayed_from_history"
      ]
    },
    "chronology_detail_state": {
      "enum": [
        "collapsed",
        "expanded",
        "grouped_by_object",
        "grouped_by_time",
        "filtered",
        "reopenable_detail"
      ]
    },
    "chronology_export_field": {
      "enum": [
        "event_verb",
        "provenance",
        "timestamp",
        "object_ref",
        "actor_role",
        "outcome_code",
        "redaction_class"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "effective_configured_conflated",
        "source_pill_missing",
        "lock_state_unexplained",
        "consequence_grouping_dropped",
        "transitive_scope_hidden",
        "re_consent_skipped",
        "verb_vocabulary_drift",
        "provenance_badge_missing",
        "chronology_detail_not_reopenable",
        "export_field_dropped",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "surface_families",
        "required_labels",
        "settings_row_states",
        "source_pills",
        "consequence_classes",
        "capability_scope_states",
        "chronology_verbs",
        "provenance_badges",
        "chronology_detail_states",
        "chronology_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "conflates_effective_and_configured",
        "hides_permission_scope",
        "invents_private_row_grammar",
        "drops_audit_or_support_truth"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "settings_row_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/settings_row_state" }
        },
        "source_pills": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_pill" }
        },
        "consequence_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/consequence_class" }
        },
        "capability_scope_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability_scope_state" }
        },
        "chronology_verbs": {
          "type": "array",
          "items": { "$ref": "#/$defs/chronology_verb" }
        },
        "provenance_badges": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance_badge" }
        },
        "chronology_detail_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/chronology_detail_state" }
        },
        "chronology_export_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/chronology_export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "conflates_effective_and_configured": { "const": false },
        "hides_permission_scope": { "const": false },
        "invents_private_row_grammar": { "const": false },
        "drops_audit_or_support_truth": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_families",
        "settings_row_states",
        "source_pills",
        "consequence_classes",
        "capability_scope_states",
        "chronology_verbs",
        "provenance_badges",
        "chronology_detail_states",
        "chronology_export_fields",
        "accessibility_routes",
        "required_labels"
      ],
      "properties": {
        "component_families": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "settings_row_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "source_pills": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "consequence_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "capability_scope_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "chronology_verbs": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "provenance_badges": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "chronology_detail_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "chronology_export_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "accessibility_routes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "required_labels": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings_row_carries_effective_versus_configured",
        "settings_source_pills_and_lock_state_explained",
        "capability_sheet_groups_by_consequence",
        "capability_transitive_scope_and_reconsent_preserved",
        "chronology_uses_stable_verbs_and_provenance",
        "chronology_detail_and_export_portable",
        "no_component_invents_second_row_grammar",
        "no_audit_or_support_truth_dropped",
        "every_component_bound_to_shell_zone",
        "every_component_declares_accessibility_route",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "settings_row_carries_effective_versus_configured": { "const": true },
        "settings_source_pills_and_lock_state_explained": { "const": true },
        "capability_sheet_groups_by_consequence": { "const": true },
        "capability_transitive_scope_and_reconsent_preserved": { "const": true },
        "chronology_uses_stable_verbs_and_provenance": { "const": true },
        "chronology_detail_and_export_portable": { "const": true },
        "no_component_invents_second_row_grammar": { "const": true },
        "no_audit_or_support_truth_dropped": { "const": true },
        "every_component_bound_to_shell_zone": { "const": true },
        "every_component_declares_accessibility_route": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings_surfaces_consume_matrix",
        "capability_sheets_consume_scope_vocabulary",
        "activity_and_evidence_consume_chronology_vocabulary",
        "chronology_export_reads_single_source",
        "support_export_reads_single_source",
        "accessibility_bridge_reads_single_source"
      ],
      "properties": {
        "settings_surfaces_consume_matrix": { "const": true },
        "capability_sheets_consume_scope_vocabulary": { "const": true },
        "activity_and_evidence_consume_chronology_vocabulary": { "const": true },
        "chronology_export_reads_single_source": { "const": true },
        "support_export_reads_single_source": { "const": true },
        "accessibility_bridge_reads_single_source": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "trust_component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "trust_component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
