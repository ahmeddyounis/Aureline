{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-notification-row-mobile-review-card-controls.schema.json",
  "title": "Aureline M5 notification rows and mobile review cards",
  "description": "Export-safe packet implementing the reusable M5 notification-row and mobile-review-card components in two co-equal control vectors. Each notification row names the object it references, its exact object landing reference, its repo/workspace client scope, its severity, its notification category, and its unread state; its delivery class is derived from the freshness class, so a stale, offline-held, or expired notification can never read as live. It always offers a keyboard-complete Open verb, and any widening verb names one exact desktop-handoff target rather than a generic activity page. Each mobile review card names its review kind, the object it references, its exact object landing reference, its scope, its freshness, and its companion-versus-desktop capability boundary; its capability class is derived from the frozen disposition vocabulary, so a desktop-required or policy-blocked review can never read as companion-completable. No control invents an alternate state label, implies a desktop-required action is companion-safe, or routes to a generic activity page; raw file bodies, diff hunks, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "notification_rows",
    "review_cards",
    "downgrade_triggers",
    "consumer_surfaces",
    "glance_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "notification_row_mobile_review_card_controls" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "notification_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/notification_row" }
    },
    "review_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review_card" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "glance_review": { "$ref": "#/$defs/glance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "object_kind": {
      "type": "string",
      "enum": [
        "notification_event",
        "review_item",
        "ci_run",
        "followed_session",
        "incident_record",
        "handoff_intent"
      ]
    },
    "client_scope": {
      "type": "string",
      "enum": [
        "workspace_scoped",
        "repo_scoped",
        "org_scoped",
        "device_scoped",
        "account_global",
        "unscoped"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "live",
        "cached",
        "stale",
        "offline_held",
        "expired_snapshot",
        "unknown_freshness"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "review_only",
        "comment_capable",
        "desktop_required",
        "cached",
        "stale",
        "policy_blocked",
        "handoff_ready"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "moderate", "low", "informational", "unspecified"]
    },
    "review_kind": {
      "type": "string",
      "enum": [
        "agent_change",
        "diff_review",
        "comment_thread",
        "approval_request",
        "policy_gate",
        "merge_readiness"
      ]
    },
    "notification_category": {
      "type": "string",
      "enum": ["build", "review", "agent", "incident", "sync", "mention"]
    },
    "handoff_target": {
      "type": "string",
      "enum": [
        "file_location",
        "review_panel",
        "ci_pipeline_run",
        "incident_workspace",
        "agent_session",
        "no_handoff"
      ]
    },
    "degraded_reason": {
      "type": "string",
      "enum": [
        "relay_unavailable",
        "proof_stale",
        "host_session_inactive",
        "trust_narrowed",
        "upstream_matrix_narrowed",
        "handoff_target_unresolved"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "scope_and_freshness",
        "capability_boundary",
        "severity_and_handoff_target"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "browser_companion",
        "mobile_companion",
        "desktop_panel",
        "diagnostics",
        "support_export",
        "help_about"
      ]
    },
    "deployment_line": {
      "type": "string",
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "notification_triage_ui",
        "review_queue_ui",
        "ci_status_ui",
        "session_follow_ui",
        "incident_awareness_ui",
        "desktop_handoff_ui",
        "support_export",
        "status_bar_ui",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "object_identity_unstated",
        "client_scope_unstated",
        "freshness_hidden",
        "capability_boundary_unstated",
        "severity_unstated",
        "handoff_target_unresolved",
        "disposition_unstated",
        "alternate_state_label_invented",
        "generic_companion_wording_used",
        "stale_shown_as_live",
        "desktop_required_action_offered_inline",
        "proof_stale"
      ]
    },
    "delivery_class": {
      "type": "string",
      "enum": ["live", "cached", "stale", "unknown"]
    },
    "notification_verb": {
      "type": "string",
      "enum": ["open", "acknowledge", "mark_read", "mute", "snooze", "handoff_to_desktop"]
    },
    "capability_class": {
      "type": "string",
      "enum": ["review_only", "comment_capable", "desktop_required", "policy_blocked"]
    },
    "review_verb": {
      "type": "string",
      "enum": ["open", "comment", "approve", "request_changes", "handoff_to_desktop", "dismiss"]
    },
    "degraded_reason_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/degraded_reason" }
    },
    "required_label_array": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/required_label" },
      "allOf": [
        { "contains": { "const": "identity" } },
        { "contains": { "const": "state" } },
        { "contains": { "const": "keyboard_route" } }
      ]
    },
    "accessibility_route_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_route" },
      "contains": { "const": "keyboard_focusable" }
    },
    "notification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "event_label",
        "object_kind",
        "object_label",
        "object_landing_ref",
        "client_scope",
        "scope_label",
        "severity",
        "severity_label",
        "notification_category",
        "is_unread",
        "freshness",
        "delivery_class",
        "claims_live",
        "cached_note",
        "stale_note",
        "unknown_note",
        "scope_and_freshness_note",
        "handoff_target",
        "handoff_label",
        "triage_verbs",
        "degraded_reasons",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_scope_or_freshness",
        "hides_capability_boundary",
        "invents_alternate_state_label",
        "implies_desktop_action_is_companion_safe",
        "routes_to_generic_activity_page"
      ],
      "properties": {
        "component": { "const": "notification_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "event_label": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "object_label": { "$ref": "#/$defs/non_empty_string" },
        "object_landing_ref": { "$ref": "#/$defs/non_empty_string" },
        "client_scope": { "$ref": "#/$defs/client_scope" },
        "scope_label": { "$ref": "#/$defs/non_empty_string" },
        "severity": { "$ref": "#/$defs/severity" },
        "severity_label": { "$ref": "#/$defs/non_empty_string" },
        "notification_category": { "$ref": "#/$defs/notification_category" },
        "is_unread": { "type": "boolean" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "delivery_class": { "$ref": "#/$defs/delivery_class" },
        "claims_live": { "type": "boolean" },
        "cached_note": { "type": "string" },
        "stale_note": { "type": "string" },
        "unknown_note": { "type": "string" },
        "scope_and_freshness_note": { "$ref": "#/$defs/non_empty_string" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_label": { "$ref": "#/$defs/non_empty_string" },
        "triage_verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/notification_verb" },
          "contains": { "const": "open" }
        },
        "degraded_reasons": { "$ref": "#/$defs/degraded_reason_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_scope_or_freshness": { "const": false },
        "hides_capability_boundary": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "implies_desktop_action_is_companion_safe": { "const": false },
        "routes_to_generic_activity_page": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "delivery_class": { "const": "cached" } },
            "required": ["delivery_class"]
          },
          "then": {
            "properties": { "cached_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "delivery_class": { "const": "stale" } },
            "required": ["delivery_class"]
          },
          "then": {
            "properties": { "stale_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "delivery_class": { "const": "unknown" } },
            "required": ["delivery_class"]
          },
          "then": {
            "properties": { "unknown_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "delivery_class": { "const": "live" } },
            "required": ["delivery_class"]
          },
          "then": {
            "properties": { "claims_live": { "const": true } },
            "required": ["claims_live"]
          },
          "else": {
            "properties": { "claims_live": { "const": false } },
            "required": ["claims_live"]
          }
        },
        {
          "if": {
            "properties": { "handoff_target": { "const": "no_handoff" } },
            "required": ["handoff_target"]
          },
          "then": {
            "properties": {
              "triage_verbs": {
                "not": { "contains": { "const": "handoff_to_desktop" } }
              }
            }
          }
        }
      ]
    },
    "review_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "review_label",
        "object_kind",
        "object_label",
        "object_landing_ref",
        "client_scope",
        "scope_label",
        "review_kind",
        "review_kind_label",
        "freshness",
        "is_unread",
        "disposition",
        "capability_class",
        "claims_companion_sufficient",
        "capability_note",
        "desktop_required_note",
        "policy_blocked_note",
        "scope_and_freshness_note",
        "handoff_target",
        "handoff_label",
        "review_verbs",
        "degraded_reasons",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_scope_or_freshness",
        "hides_capability_boundary",
        "invents_alternate_state_label",
        "implies_desktop_action_is_companion_safe",
        "routes_to_generic_activity_page"
      ],
      "properties": {
        "component": { "const": "mobile_review_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "review_label": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "object_label": { "$ref": "#/$defs/non_empty_string" },
        "object_landing_ref": { "$ref": "#/$defs/non_empty_string" },
        "client_scope": { "$ref": "#/$defs/client_scope" },
        "scope_label": { "$ref": "#/$defs/non_empty_string" },
        "review_kind": { "$ref": "#/$defs/review_kind" },
        "review_kind_label": { "$ref": "#/$defs/non_empty_string" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "is_unread": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "capability_class": { "$ref": "#/$defs/capability_class" },
        "claims_companion_sufficient": { "type": "boolean" },
        "capability_note": { "$ref": "#/$defs/non_empty_string" },
        "desktop_required_note": { "type": "string" },
        "policy_blocked_note": { "type": "string" },
        "scope_and_freshness_note": { "$ref": "#/$defs/non_empty_string" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_label": { "$ref": "#/$defs/non_empty_string" },
        "review_verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/review_verb" },
          "contains": { "const": "open" }
        },
        "degraded_reasons": { "$ref": "#/$defs/degraded_reason_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_scope_or_freshness": { "const": false },
        "hides_capability_boundary": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "implies_desktop_action_is_companion_safe": { "const": false },
        "routes_to_generic_activity_page": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "capability_class": { "const": "desktop_required" } },
            "required": ["capability_class"]
          },
          "then": {
            "properties": { "desktop_required_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "capability_class": { "const": "policy_blocked" } },
            "required": ["capability_class"]
          },
          "then": {
            "properties": { "policy_blocked_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": {
              "capability_class": { "enum": ["review_only", "comment_capable"] }
            },
            "required": ["capability_class"]
          },
          "then": {
            "properties": { "claims_companion_sufficient": { "const": true } },
            "required": ["claims_companion_sufficient"]
          },
          "else": {
            "properties": { "claims_companion_sufficient": { "const": false } },
            "required": ["claims_companion_sufficient"]
          }
        }
      ]
    },
    "glance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notification_row_shows_object_and_severity",
        "notification_row_shows_scope_and_freshness",
        "notification_row_shows_unread_state",
        "review_card_shows_capability_boundary",
        "review_card_states_companion_sufficiency",
        "review_card_shows_review_kind",
        "object_identity_always_explicit",
        "client_scope_always_explicit",
        "freshness_always_explicit",
        "delivery_and_capability_derived_never_asserted",
        "stale_never_shown_as_live",
        "every_verb_traces_to_one_object",
        "every_handoff_names_exact_target",
        "no_surface_invents_alternate_state_label",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "notification_row_shows_object_and_severity": { "const": true },
        "notification_row_shows_scope_and_freshness": { "const": true },
        "notification_row_shows_unread_state": { "const": true },
        "review_card_shows_capability_boundary": { "const": true },
        "review_card_states_companion_sufficiency": { "const": true },
        "review_card_shows_review_kind": { "const": true },
        "object_identity_always_explicit": { "const": true },
        "client_scope_always_explicit": { "const": true },
        "freshness_always_explicit": { "const": true },
        "delivery_and_capability_derived_never_asserted": { "const": true },
        "stale_never_shown_as_live": { "const": true },
        "every_verb_traces_to_one_object": { "const": true },
        "every_handoff_names_exact_target": { "const": true },
        "no_surface_invents_alternate_state_label": { "const": true },
        "controls_stable_across_deployment_lines": { "const": true },
        "copy_and_export_safe": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notification_triage_ui_reads_single_source",
        "review_queue_ui_reads_single_source",
        "first_glance_names_object_scope_and_freshness",
        "capability_boundary_visible_before_tap",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "notification_triage_ui_reads_single_source": { "const": true },
        "review_queue_ui_reads_single_source": { "const": true },
        "first_glance_names_object_scope_and_freshness": { "const": true },
        "capability_boundary_visible_before_tap": { "const": true },
        "support_export_shows_control_truth": { "const": true },
        "help_about_shows_control_truth": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
