{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-waiver-gate-mitigation-controls.schema.json",
  "title": "Aureline M5 waiver-expiry queue item, release-gate banner, and mitigation note card controls",
  "description": "Export-safe packet for the three reusable M5 governance-dashboard primitives implemented as one controls packet: the waiver-expiry queue item (owner, waiver lifecycle state, expiry, affected milestone or release, mitigation status, and an always-present open-detail action), the release-gate banner (blocker count, waived count, stale-evidence count, ship/no-ship decision, user-facing mitigation, fallback path, and packet/export continuity), and the mitigation note card (the user-facing mitigation text and its clarity). It narrows the waiver_expiry_queue_item, release_gate_banner, and mitigation_note_card families frozen in schemas/ui/m5-governance-dashboard-component-matrix.schema.json into two resolvers plus a parity matrix, so a user, operator, or release reviewer can tell — from the queue item, the banner, and the card alone — who owns a temporary exception, when it expires, which milestone or release it holds, how many blockers or waived or stale-evidence items stand between the lane and a ship decision, and what the mitigation actually is in plain language. Each controls row binds one claimed M5 governance consumer (the assurance dashboard, the operator board, the shiproom packet, the CLI inspect, and the support export) to the shared anatomy, the frozen readiness-state vocabulary, the waiver-expiry states, the release-gate decisions, the mitigation postures, the mitigation-clarity readings, degrade reasons, next actions, actions, export fields, and non-visual accessibility routes, plus worked resolution cases that must reproduce the resolver output exactly. Hard invariants forbid rendering a waived or expired exception as a clean pass, hiding the waiver expiry or the owner, hiding mitigation behind internal jargon, and inventing a gate-local status word. Raw URLs, raw tokens, credentials, private endpoints, and user text bodies never cross this boundary; an owner alias is a role alias, never a personal contact detail. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_waiver_expiry_queue_items_release_gate_banners_and_mitigation_note_cards_across_claimed_m5_governance_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "consumer_surface": {
      "enum": [
        "assurance_dashboard",
        "operator_board",
        "shiproom_packet",
        "cli_inspect",
        "support_export"
      ]
    },
    "readiness_state": {
      "enum": [
        "passing",
        "warning",
        "blocked",
        "waived",
        "expired_waiver",
        "evidence_stale",
        "owner_unresolved",
        "forum_unresolved",
        "not_evaluated"
      ]
    },
    "waiver_expiry_state": {
      "enum": [
        "active_waiver",
        "expiring_soon",
        "expired_waiver",
        "revoked_waiver",
        "no_waiver"
      ]
    },
    "gate_decision": {
      "enum": ["go", "no_go", "conditional_go", "held_pending_evidence", "blocked_by_owner_or_forum"]
    },
    "mitigation_clarity": {
      "enum": ["plain_language", "jargon_detected", "mitigation_absent"]
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "anatomy_parts",
        "readiness_states",
        "waiver_expiry_states",
        "mitigation_clarities",
        "evidence_freshness_states",
        "gate_decisions",
        "item_actions",
        "gate_actions",
        "export_fields",
        "accessibility_routes",
        "waiver_expiry_examples",
        "release_gate_examples"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "readiness_states": { "type": "array", "minItems": 1 },
        "waiver_expiry_states": { "type": "array", "minItems": 1 },
        "mitigation_clarities": { "type": "array", "minItems": 1 },
        "evidence_freshness_states": { "type": "array", "minItems": 1 },
        "gate_decisions": { "type": "array", "minItems": 1 },
        "item_actions": { "type": "array", "minItems": 1 },
        "gate_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "waiver_expiry_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/waiver_case" }
        },
        "release_gate_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gate_case" }
        },
        "renders_waived_or_expired_as_clean_pass": { "const": false },
        "hides_waiver_expiry_or_owner": { "const": false },
        "hides_mitigation_behind_internal_jargon": { "const": false },
        "invents_gate_local_status_grammar": { "const": false }
      }
    },
    "waiver_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "waiver_id_repr",
            "waiver_state",
            "affected_target",
            "mitigation_posture",
            "readiness_state",
            "is_clean_pass",
            "expiry_visible",
            "item_actions"
          ],
          "properties": {
            "waiver_state": { "$ref": "#/$defs/waiver_expiry_state" },
            "readiness_state": { "$ref": "#/$defs/readiness_state" },
            "is_clean_pass": { "type": "boolean" },
            "expiry_visible": { "const": true },
            "item_actions": { "type": "array", "minItems": 1 }
          }
        }
      }
    },
    "gate_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "gate_id_repr",
            "blocker_count",
            "waived_count",
            "stale_evidence_count",
            "resolved_decision",
            "mitigation_clarity",
            "mitigation_understandable",
            "readiness_state",
            "packet_export_continuity",
            "gate_actions"
          ],
          "properties": {
            "resolved_decision": { "$ref": "#/$defs/gate_decision" },
            "mitigation_clarity": { "$ref": "#/$defs/mitigation_clarity" },
            "mitigation_understandable": { "type": "boolean" },
            "readiness_state": { "$ref": "#/$defs/readiness_state" },
            "packet_export_continuity": { "const": true },
            "gate_actions": { "type": "array", "minItems": 2 }
          }
        }
      }
    }
  }
}
