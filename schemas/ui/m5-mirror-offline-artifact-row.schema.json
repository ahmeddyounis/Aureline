{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-mirror-offline-artifact-row.schema.json",
  "title": "Aureline M5 mirror/offline artifact row",
  "description": "Stable UI contract for an M5 mirror/offline artifact row. The row names artifact class, source class, mirror source, freshness, signature state, manifest ref, and verification actions so stale mirrored or cached artifacts never read as live current sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "artifact_ref",
    "artifact_class",
    "source_class",
    "mirror_source_ref",
    "freshness",
    "signature_state",
    "manifest_ref",
    "discloses_freshness",
    "stale_not_shown_as_current",
    "verification_accessible",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_mirror_offline_artifact_row" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "artifact_ref": { "$ref": "#/$defs/ref" },
    "artifact_class": { "enum": ["docs", "extensions", "models", "updates", "policy_bundles"] },
    "source_class": { "enum": ["first_party_mirror", "self_hosted_mirror", "offline_bundle", "peer_cache", "vendor_cdn"] },
    "mirror_source_ref": { "$ref": "#/$defs/ref" },
    "freshness": { "$ref": "#/$defs/truth_mode" },
    "signature_state": {
      "enum": ["verified", "unverified", "signature_mismatch", "verification_deferred"]
    },
    "manifest_ref": { "$ref": "#/$defs/ref" },
    "discloses_freshness": { "const": true },
    "stale_not_shown_as_current": { "const": true },
    "verification_accessible": { "const": true },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_reported"]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "enum": ["mirror_stale", "offline_cache_only", "signature_unverified", "provenance_incomplete"] },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
