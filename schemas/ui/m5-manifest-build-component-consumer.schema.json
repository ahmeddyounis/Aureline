{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-manifest-build-component-consumer.schema.json",
  "title": "M5 manifest / build component consumer packet",
  "description": "M05-817 first-consumer adoption packet proving the frozen M5 manifest / build-confidence component families are reusable primitives across the container/devcontainer, request/live-resource handoff, incident/support, and AI/explanation consumer classes. Every consumer points back to exactly one canonical component family and keeps target-context, freshness, schema source, adapter source, confidence, and degraded-state parity with the primary infra/build surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_manifest_build_component_consumer_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "source_contract_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/consumerRow" }
    },
    "summary": { "$ref": "#/definitions/summary" }
  },
  "definitions": {
    "consumerGroup": {
      "type": "string",
      "enum": [
        "container_devcontainer",
        "request_live_resource_handoff",
        "incident_support",
        "ai_explanation"
      ]
    },
    "consumerSurface": {
      "type": "string",
      "enum": [
        "devcontainer_manifest_panel",
        "container_target_graph_inspector",
        "request_resource_link_handoff",
        "live_resource_explorer_handoff",
        "incident_support_bundle",
        "support_export",
        "release_proof",
        "ai_execution_explainer",
        "ai_confidence_narrative",
        "docs_help"
      ]
    },
    "componentFamily": {
      "type": "string",
      "enum": [
        "manifest_editor_header",
        "schema_validator_row",
        "target_context_chip_group",
        "resource_link_row",
        "resource_explorer_row",
        "adapter_source_badge",
        "target_graph_row",
        "capability_matrix",
        "raw_event_drawer",
        "fallback_confidence_drawer"
      ]
    },
    "authorityMode": {
      "type": "string",
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "compare_only",
        "export_only",
        "policy_blocked"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["live_fresh", "cached_stale", "imported_snapshot", "plan_only", "unknown"]
    },
    "schemaFreshness": {
      "type": "string",
      "enum": ["fresh", "stale", "unversioned", "unavailable"]
    },
    "adapterSource": {
      "type": "string",
      "enum": [
        "native_build_server",
        "native_build_event",
        "heuristic_parse",
        "imported_snapshot",
        "provider_overlay",
        "unknown"
      ]
    },
    "discoveryConfidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "requiredLabel": {
      "type": "string",
      "enum": [
        "identity",
        "target_context",
        "truth_class",
        "freshness_or_confidence",
        "adapter_source",
        "keyboard_route"
      ]
    },
    "labelParity": {
      "type": "string",
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "handoffTarget": {
      "type": "string",
      "enum": ["none", "companion_app", "browser_readonly", "handoff_packet", "cli_headless"]
    },
    "copyExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_copy", "json_copy", "markdown_copy", "screenshot_only_prohibited"],
      "properties": {
        "text_copy": { "type": "boolean" },
        "json_copy": { "type": "boolean" },
        "markdown_copy": { "type": "boolean" },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reducedCapabilityBanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consumerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_group",
        "consumer_surface",
        "component_family",
        "canonical_family_schema_ref",
        "references_canonical_not_local_prose",
        "authority_mode",
        "target_context_ref",
        "freshness",
        "schema_source",
        "adapter_source",
        "discovery_confidence",
        "label_parity",
        "handoff_target",
        "copy_export"
      ],
      "properties": {
        "record_kind": { "const": "m5_manifest_build_component_consumer_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_group": { "$ref": "#/definitions/consumerGroup" },
        "consumer_surface": { "$ref": "#/definitions/consumerSurface" },
        "component_family": { "$ref": "#/definitions/componentFamily" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_packet_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "authority_mode": { "$ref": "#/definitions/authorityMode" },
        "target_context_ref": { "type": "string", "minLength": 1 },
        "freshness": { "$ref": "#/definitions/freshness" },
        "schema_source": { "$ref": "#/definitions/schemaFreshness" },
        "adapter_source": { "$ref": "#/definitions/adapterSource" },
        "discovery_confidence": { "$ref": "#/definitions/discoveryConfidence" },
        "preserved_badge_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "degraded_state_vocab": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/definitions/requiredLabel" }
        },
        "label_parity": { "$ref": "#/definitions/labelParity" },
        "handoff_target": { "$ref": "#/definitions/handoffTarget" },
        "handoff_note_ref": { "type": "string" },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "copy_export": { "$ref": "#/definitions/copyExport" },
        "reduced_capability_banner": { "$ref": "#/definitions/reducedCapabilityBanner" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_group_count",
        "consumer_surface_count",
        "component_family_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_preserve_target_context",
        "all_narrowed_rows_disclose",
        "all_rows_confidence_consistent",
        "all_rows_have_copy_export",
        "families_reused_across_groups",
        "container_devcontainer_consumer_present",
        "request_live_resource_consumer_present",
        "incident_support_consumer_present",
        "ai_explanation_consumer_present",
        "help_support_release_reference_present"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_group_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_preserve_target_context": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_confidence_consistent": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "families_reused_across_groups": { "type": "boolean" },
        "container_devcontainer_consumer_present": { "type": "boolean" },
        "request_live_resource_consumer_present": { "type": "boolean" },
        "incident_support_consumer_present": { "type": "boolean" },
        "ai_explanation_consumer_present": { "type": "boolean" },
        "help_support_release_reference_present": { "type": "boolean" }
      }
    }
  }
}
