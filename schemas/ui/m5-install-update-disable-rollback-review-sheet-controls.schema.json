{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-install-update-disable-rollback-review-sheet-controls.schema.json",
  "title": "Aureline M5 install / update / disable / rollback review-sheet controls",
  "description": "Export-safe packet for the final implement lane over the frozen M5 marketplace / install-review component matrix. It carries resolved, honest projections of the install / update / disable / rollback review sheet across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved review-sheet examples, which name the lifecycle-mutation flow, registry source class, compatibility state, permission delta, publisher continuity, runtime-interruption preview, disable scope, rollback compatibility, the one reviewed transaction grammar (review / confirm / cancel), and evidence freshness. Hard invariants forbid hiding a permission delta or runtime-interruption consequence, hiding a publisher transfer / disable scope / rollback incompatibility, collapsing the registry source class across public / mirrored / enterprise, and presenting an incompatible or over-budget artifact as ready to mutate. Acceptance criteria — one reviewed transaction grammar across install / update / disable / rollback, disable scope and rollback compatibility explicit rather than buried, and registry / source continuity visible from review through help / support / export handoff — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_install_update_disable_rollback_review_sheet_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "review_sheet_example": {
      "type": "object",
      "required": [
        "sheet_id",
        "artifact_identity",
        "mutation_flow",
        "registry_source",
        "compatibility",
        "permission_delta",
        "publisher_continuity",
        "runtime_interruption",
        "disable_scope",
        "rollback_compatibility",
        "review_actions",
        "reviews_disable_scope",
        "reviews_rollback",
        "has_transaction_grammar",
        "names_disable_scope",
        "names_rollback_compatibility",
        "certified_or_supported_claimed",
        "evidence_fresh",
        "presents_incompatible_as_ready",
        "hides_publisher_transfer",
        "collapses_source_class",
        "hides_disable_scope",
        "hides_rollback_incompatibility",
        "leaves_stale_certified_overclaim",
        "degrade_reason",
        "next_action",
        "fully_legible"
      ],
      "properties": {
        "sheet_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "mutation_flow": { "$ref": "#/$defs/non_empty_string" },
        "registry_source": { "$ref": "#/$defs/non_empty_string" },
        "compatibility": { "$ref": "#/$defs/non_empty_string" },
        "permission_delta": { "$ref": "#/$defs/non_empty_string" },
        "publisher_continuity": { "$ref": "#/$defs/non_empty_string" },
        "runtime_interruption": { "$ref": "#/$defs/non_empty_string" },
        "disable_scope": { "type": ["string", "null"] },
        "rollback_compatibility": { "type": ["string", "null"] },
        "review_actions": { "type": "array", "items": { "type": "string" } },
        "reviews_disable_scope": { "type": "boolean" },
        "reviews_rollback": { "type": "boolean" },
        "has_transaction_grammar": { "type": "boolean" },
        "names_disable_scope": { "type": "boolean" },
        "names_rollback_compatibility": { "type": "boolean" },
        "certified_or_supported_claimed": { "type": "boolean" },
        "evidence_fresh": { "type": "boolean" },
        "presents_incompatible_as_ready": { "type": "boolean" },
        "hides_publisher_transfer": { "type": "boolean" },
        "collapses_source_class": { "type": "boolean" },
        "hides_disable_scope": { "type": "boolean" },
        "hides_rollback_incompatibility": { "type": "boolean" },
        "leaves_stale_certified_overclaim": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fully_legible": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "review_sheet_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_permission_delta_or_runtime_interruption",
        "hides_publisher_transfer_disable_scope_or_rollback_incompatibility",
        "collapses_registry_source_class_across_public_mirrored_enterprise",
        "presents_incompatible_or_over_budget_as_ready"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "review_sheet_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/review_sheet_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_permission_delta_or_runtime_interruption": { "const": false },
        "hides_publisher_transfer_disable_scope_or_rollback_incompatibility": { "const": false },
        "collapses_registry_source_class_across_public_mirrored_enterprise": { "const": false },
        "presents_incompatible_or_over_budget_as_ready": { "const": false }
      }
    }
  }
}
