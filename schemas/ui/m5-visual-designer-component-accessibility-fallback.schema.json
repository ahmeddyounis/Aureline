{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-visual-designer-component-accessibility-fallback.schema.json",
  "title": "M5 Visual-Designer Component Accessibility Fallback Packet",
  "description": "List/tree/textual fallback parity, keyboard and screen-reader navigation, and no-drag-only editing rules for the frozen M5 visual-designer component families (M05-808).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_visual_designer_component_accessibility_fallback_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "design_canvas",
        "structure_tree_row",
        "property_inspector_row",
        "source_sync_chip",
        "breakpoint_preview_row",
        "unsupported_construct_card",
        "round_trip_conflict_banner"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["canvas", "list", "tree", "textual"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "handoff_packet",
        "cli_headless",
        "support_export"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "design_canvas_workspace",
        "structure_panel",
        "property_panel",
        "preview_deck",
        "source_sync_rail",
        "docs_help",
        "support_export",
        "release_proof"
      ]
    },
    "reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "drag_editing_state": {
      "type": "string",
      "enum": ["command_backed_parity", "gated_disclosed", "drag_only_trap"]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "drifted_from_source",
        "unmapped_source",
        "runtime_unavailable",
        "protected_path_blocked",
        "unsupported_construct",
        "round_trip_conflict_open",
        "unidentified_posture"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "source_ownership",
        "state",
        "sync_or_freshness",
        "keyboard_route"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "narrowed_label", "preserves_source_backed_context"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_source_backed_context": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "fallback_modalities",
        "reaches_source_backed_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "low_resource_reach",
        "drag_editing",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_visual_designer_component_accessibility_fallback_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "reaches_source_backed_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/reach_state" },
        "low_resource_reach": { "$ref": "#/$defs/reach_state" },
        "drag_editing": { "$ref": "#/$defs/drag_editing_state" },
        "command_backed_actions": { "type": "array", "items": { "type": "string" } },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_disclosure" }
        },
        "auto_narrow": { "$ref": "#/$defs/auto_narrow" },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_count",
        "canvas_heavy_family_count",
        "all_canvas_heavy_have_non_visual_fallback",
        "all_reach_source_backed_truth_via_at",
        "all_no_drag_only_editing",
        "all_export_summaries_preserve_meaning",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "family_count": { "type": "integer", "minimum": 0 },
        "canvas_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_canvas_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_source_backed_truth_via_at": { "type": "boolean" },
        "all_no_drag_only_editing": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
