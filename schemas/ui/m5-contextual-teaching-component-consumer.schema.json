{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-contextual-teaching-component-consumer.schema.json",
  "title": "Aureline M5 contextual-teaching component consumers",
  "description": "Export-safe packet for the adoption lane over the frozen M5 contextual-teaching / migration-bridge component matrix. It binds one row per claimed M5 teaching consumer — first-run onboarding, the migration importer, keybinding / leader help, command docs, the Help pane, and the localized support packet — to the five canonical component families (contextual-tip card, migration-bridge card, sequence-help strip, why-unavailable explanation row, source-language fallback surface), the one shared descriptor vocabulary (command binding / migration mapping / blocked-action explanation / source-language citation), the parity-health modes, export caveats, claim-parity states, narrowing reasons, recovery actions, export fields, and non-visual accessibility routes. Each consumer points at the primitive's canonical schema and artifact rather than re-wording command-binding, migration-mapping, blocked-action, or source-language facts in local prose. A weakened parity-health mode (imported behavior only partially mapped, an unsupported sequence, a changed blocked-action owner, or stale / policy-limited localized fallback) auto-narrows the claim and always discloses a self-contained banner naming the exact reason and recovery action. Partial or unsupported state never masquerades as exact teaching parity. Raw secrets, endpoints, tokens, and raw provider bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_onboarding_help_importer_keybinding_modal_command_doc_consumers_so_contextual_teaching_components_keep_mapping_enablement_source_language_truth_aligned_across_claimed_m5_profiles"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "teaching_component_consumer_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "teaching_component_consumer_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "onboarding_flow",
        "migration_importer",
        "keybinding_leader_help",
        "command_docs",
        "help_pane",
        "localized_support_packet"
      ]
    },
    "component_family": {
      "enum": [
        "contextual_tip_card",
        "migration_bridge_card",
        "sequence_help_strip",
        "why_unavailable_explanation_row",
        "source_language_fallback"
      ]
    },
    "descriptor": {
      "enum": [
        "command_binding",
        "migration_mapping",
        "blocked_action_explanation",
        "source_language_citation"
      ]
    },
    "parity_health": {
      "enum": [
        "full_parity",
        "imported_behavior_partial_narrowed",
        "sequence_unsupported_narrowed",
        "blocked_owner_changed_narrowed",
        "localized_fallback_stale_narrowed"
      ]
    },
    "claim_parity_state": {
      "enum": ["claims_preserved", "claims_auto_narrowed"]
    },
    "narrowing_reason": {
      "enum": [
        "imported_behavior_partial",
        "sequence_unsupported",
        "blocked_action_owner_changed",
        "localized_fallback_stale_or_policy_limited"
      ]
    },
    "recovery_action": {
      "enum": [
        "review_migration_mapping_before_trusting",
        "open_full_cheat_sheet_for_supported_sequence",
        "contact_current_blocking_owner",
        "view_source_language_or_request_localization"
      ]
    },
    "export_caveat": {
      "enum": [
        "imported_behavior_partial_not_exact",
        "sequence_unsupported_no_backing_command",
        "blocked_action_owner_reassigned",
        "localized_fallback_stale_or_policy_limited"
      ]
    },
    "resolved_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "canonical_schema_ref",
        "descriptor_families",
        "parity_health",
        "export_caveats",
        "claim_parity_state",
        "is_narrowed",
        "reflects_partial_or_unsupported_state",
        "asserts_exact_teaching_parity",
        "auto_narrow_banner"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health": { "$ref": "#/$defs/parity_health" },
        "export_caveats": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_state": { "$ref": "#/$defs/claim_parity_state" },
        "is_narrowed": { "type": "boolean" },
        "reflects_partial_or_unsupported_state": { "type": "boolean" },
        "asserts_exact_teaching_parity": { "type": "boolean" },
        "auto_narrow_banner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "recovery_action",
                "consumer",
                "component_family",
                "preserved_descriptors",
                "export_caveats",
                "headline"
              ],
              "properties": {
                "reason": { "$ref": "#/$defs/narrowing_reason" },
                "recovery_action": { "$ref": "#/$defs/recovery_action" },
                "consumer": { "$ref": "#/$defs/consumer" },
                "component_family": { "$ref": "#/$defs/component_family" },
                "preserved_descriptors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/descriptor" }
                },
                "export_caveats": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/export_caveat" }
                },
                "headline": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "$ref": "#/$defs/resolved_binding" }
      }
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "const": true },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "parity_health_modes",
        "export_caveats",
        "claim_parity_states",
        "narrowing_reasons",
        "recovery_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewords_claims_per_surface",
        "invents_new_teaching_grammar",
        "drops_command_mapping_owner_or_citation_when_narrowed",
        "shows_partial_or_unsupported_state_as_exact",
        "inherits_stronger_label_from_healthier_profile"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parity_health" }
        },
        "export_caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim_parity_state" }
        },
        "narrowing_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recovery_action" }
        },
        "export_fields": { "type": "array", "minItems": 5 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_binding" }
        },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rewords_claims_per_surface": { "const": false },
        "invents_new_teaching_grammar": { "const": false },
        "drops_command_mapping_owner_or_citation_when_narrowed": { "const": false },
        "shows_partial_or_unsupported_state_as_exact": { "const": false },
        "inherits_stronger_label_from_healthier_profile": { "const": false }
      }
    }
  }
}
