{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-workspace-trust-repair-component-matrix.schema.json",
  "title": "Aureline M5 workspace-trust-banner, trust-fact-grid, trust-elevation-sheet, restricted-capability-row, root-trust-strip, repair-transaction-preview-card, rollback-class-strip, and repair-result-receipt-row component matrix",
  "description": "Export-safe packet freezing Aureline's reusable workspace-trust and guided-repair UI components. The packet names every workspace-trust or guided-repair surface M5 claims that still ships its own trust or repair chrome \u2014 workspace-trust banners, trust-fact grids, trust-elevation sheets, restricted-capability rows, root-trust strips, repair-transaction preview cards, rollback-class strips, and repair-result receipt rows \u2014 and binds each to the claimed M5 surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: the single controlled trust/repair-disposition vocabulary consumers bind to (trusted, restricted, mixed_root, policy_blocked, reduced_mode, preview_ready, checkpoint_missing, exact_reversal, compensate, regenerate, manual_follow_up, audit_only), plus family-specific grant-source classes, trust-scope states, narrowed-capability states, per-root trust states, reversal classes, checkpoint states, repair-outcome classes, and preview states. Hard invariants forbid implying blanket trust across roots or routes, hiding checkpoint absence or reversal limits, collapsing exact/compensate/regenerate/manual/audit-only outcomes into generic success copy, and presenting a partial success as complete. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_workspace_trust_banner_trust_fact_grid_trust_elevation_sheet_restricted_capability_row_root_trust_strip_repair_transaction_preview_card_rollback_class_strip_and_repair_result_receipt_row_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "component_family": {
      "enum": [
        "workspace_trust_banner",
        "trust_fact_grid",
        "trust_elevation_sheet",
        "restricted_capability_row",
        "root_trust_strip",
        "repair_transaction_preview_card",
        "rollback_class_strip",
        "repair_result_receipt_row"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "trusted",
        "restricted",
        "mixed_root",
        "policy_blocked",
        "reduced_mode",
        "preview_ready",
        "checkpoint_missing",
        "exact_reversal",
        "compensate",
        "regenerate",
        "manual_follow_up",
        "audit_only"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "implies_blanket_trust_across_roots_or_routes",
        "hides_checkpoint_absence_or_reversal_limits",
        "collapses_reversal_outcomes_into_generic_success",
        "presents_partial_success_as_complete"
      ],
      "properties": {
        "component_family": {
          "$ref": "#/$defs/component_family"
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "trusted",
              "restricted",
              "mixed_root",
              "policy_blocked",
              "reduced_mode",
              "preview_ready",
              "checkpoint_missing",
              "exact_reversal",
              "compensate",
              "regenerate",
              "manual_follow_up",
              "audit_only"
            ]
          }
        },
        "grant_source_classes": {
          "type": "array"
        },
        "trust_scope_states": {
          "type": "array"
        },
        "capability_narrow_states": {
          "type": "array"
        },
        "root_trust_states": {
          "type": "array"
        },
        "reversal_classes": {
          "type": "array"
        },
        "checkpoint_states": {
          "type": "array"
        },
        "repair_outcomes": {
          "type": "array"
        },
        "preview_states": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "implies_blanket_trust_across_roots_or_routes": {
          "const": false
        },
        "hides_checkpoint_absence_or_reversal_limits": {
          "const": false
        },
        "collapses_reversal_outcomes_into_generic_success": {
          "const": false
        },
        "presents_partial_success_as_complete": {
          "const": false
        }
      }
    }
  }
}
