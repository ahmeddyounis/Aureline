{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-scaffold-component-certification.schema.json",
  "title": "Aureline M5 scaffold component surface certification packet",
  "description": "M05-1027 closing surface-certification capstone over the frozen M5 scaffold-template-card / starter-parameter-row / scaffold-preflight-card / template-health-row / generated-project-diff-card / scaffold-handoff-banner component matrix. Certifies that the shared scaffold-component truth holds on every claimed M5 stack-entry and project-generation surface, auto-narrowing any surface that cannot sustain it. Metadata-only: typed class tokens, opaque refs, booleans, and redacted labels; never raw parameter values, secret material, generated file bytes, or credential-bearing material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_scaffold_component_certification_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "readiness_claim": {
      "type": "string",
      "enum": [
        "qualified_starter",
        "secret_bound_parameter_projection",
        "blocked_prerequisite_projection",
        "drifted_template_projection",
        "partial_generation_projection",
        "unchecked_validation_projection"
      ]
    },
    "certified_surface": {
      "type": "string",
      "enum": [
        "start_center",
        "template_gallery",
        "scaffold_preflight",
        "generation_diff_review",
        "workspace_handoff",
        "template_health",
        "support_export",
        "cli_headless"
      ]
    },
    "certification_axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "export",
        "degraded_state",
        "source_side_effect_and_recovery"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "surface_status": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "starter_source_unstated",
        "support_class_unstated",
        "side_effect_undisclosed",
        "host_boundary_unstated",
        "parameter_source_unstated",
        "action_timing_unstated",
        "impact_undisclosed",
        "health_freshness_stale",
        "generated_boundary_blurred",
        "recovery_path_omitted",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "component_family": {
      "type": "string",
      "enum": [
        "scaffold_template_card",
        "starter_parameter_row",
        "scaffold_preflight_card",
        "template_health_row",
        "generated_project_diff_card",
        "scaffold_handoff_banner"
      ]
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_value_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_value_only_prohibited": { "type": "boolean" }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_axis",
        "from_claim",
        "to_claim",
        "visible_label",
        "preserves_source_and_recovery_continuity"
      ],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/readiness_claim" },
        "to_claim": { "$ref": "#/$defs/readiness_claim" },
        "visible_label": { "type": "string", "minLength": 1 },
        "preserves_source_and_recovery_continuity": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "source_and_recovery_preserved",
        "hides_side_effect_behind_generic_create",
        "exposes_raw_value_by_default",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_scaffold_component_certification_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/certified_surface" },
        "claimed_claim": { "$ref": "#/$defs/readiness_claim" },
        "certified_claim": { "$ref": "#/$defs/readiness_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "source_and_recovery_preserved": { "type": "boolean" },
        "hides_side_effect_behind_generic_create": { "type": "boolean" },
        "exposes_raw_value_by_default": { "type": "boolean" },
        "canonical_bundle_ref": { "type": "string", "minLength": 1 },
        "derived_status": { "$ref": "#/$defs/surface_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "every_axis_covered_on_every_row",
        "all_source_and_recovery_preserved",
        "no_surface_hides_side_effect",
        "no_surface_exposes_raw_value",
        "narrowed_surface_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "all_source_and_recovery_preserved": { "type": "boolean" },
        "no_surface_hides_side_effect": { "type": "boolean" },
        "no_surface_exposes_raw_value": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
