{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-table-grid-panel-header-controls.schema.json",
  "title": "Aureline M5 table / grid and panel-header controls",
  "description": "Export-safe packet for the dense-structure implement lane over the frozen M5 navigation / content component matrix. It carries resolved, honest projections of the table / grid and the panel header across the claimed M5 request/data, review, search, governance, and support surfaces. Each controls row binds a consumer surface to the resolved table-grid examples (naming the selection-versus-current distinction and row focus, the per-row item state, the sort/filter provenance, the pinned-column identity, the per-value qualification — estimated/imported/stale/partial/policy-limited — the exact/loaded/all-matching/hidden-by-filter/hidden-by-policy/outside-current-scope count scope, the density variant, and the local-action budget) and the resolved panel-header examples (naming the active context, the bounded local-action budget, and a reference back to the canonical count / selection model). Hard invariants forbid hiding the current selection, a blocked row, or the local actions behind pointer hover, collapsing selection-versus-current or the exact/loaded/all-matching count scopes, presenting a qualified, stale, or partial grid as exact canonical truth, and letting the panel header overload into a secondary toolbar or re-encode counts in surface-local copy. Acceptance criteria — grids show the same sort/filter and count semantics across surfaces, pinned and identity columns stay stable under virtualization and overflow without losing provenance or scope truth, and grid/export consumers point back to one canonical header and selection model — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_table_grid_and_panel_header_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "table_grid_example": {
      "type": "object",
      "required": [
        "grid_id",
        "grid_label",
        "selection",
        "selection_versus_current_distinct",
        "row_focus_visible",
        "current_selection_hover_only",
        "item_state",
        "has_blocked_row",
        "blocked_state_hover_only",
        "sort_filter_provenance",
        "sort_filter_provenance_resolved",
        "pinned_column",
        "pinned_column_pinned",
        "pinned_column_identity_lost",
        "value_qualification",
        "value_is_qualified",
        "qualified_value_shown_as_canonical",
        "count_scope",
        "count_scope_hidden_or_outside",
        "count_scopes_distinct",
        "loaded_shown_as_exact",
        "density",
        "local_action_budget",
        "local_actions_hover_only",
        "backend_stale_or_partial",
        "presents_stale_or_partial_as_complete",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "structure_legible_at_a_glance"
      ],
      "properties": {
        "grid_id": { "$ref": "#/$defs/non_empty_string" },
        "grid_label": { "type": "string" },
        "selection": { "$ref": "#/$defs/non_empty_string" },
        "selection_versus_current_distinct": { "type": "boolean" },
        "row_focus_visible": { "type": "boolean" },
        "current_selection_hover_only": { "type": "boolean" },
        "item_state": { "$ref": "#/$defs/non_empty_string" },
        "has_blocked_row": { "type": "boolean" },
        "blocked_state_hover_only": { "type": "boolean" },
        "sort_filter_provenance": { "$ref": "#/$defs/non_empty_string" },
        "sort_filter_provenance_resolved": { "type": "boolean" },
        "pinned_column": { "$ref": "#/$defs/non_empty_string" },
        "pinned_column_pinned": { "type": "boolean" },
        "pinned_column_identity_lost": { "type": "boolean" },
        "value_qualification": { "$ref": "#/$defs/non_empty_string" },
        "value_is_qualified": { "type": "boolean" },
        "qualified_value_shown_as_canonical": { "type": "boolean" },
        "count_scope": { "$ref": "#/$defs/non_empty_string" },
        "count_scope_hidden_or_outside": { "type": "boolean" },
        "count_scopes_distinct": { "type": "boolean" },
        "loaded_shown_as_exact": { "type": "boolean" },
        "density": { "$ref": "#/$defs/non_empty_string" },
        "local_action_budget": { "$ref": "#/$defs/non_empty_string" },
        "local_actions_hover_only": { "type": "boolean" },
        "backend_stale_or_partial": { "type": "boolean" },
        "presents_stale_or_partial_as_complete": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "structure_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "panel_header_example": {
      "type": "object",
      "required": [
        "header_id",
        "header_label",
        "active_context",
        "background_context_shown_as_active",
        "local_action_budget",
        "local_actions_hover_only",
        "becomes_secondary_toolbar",
        "overflowed_action_dropped",
        "references_canonical_model",
        "re_encodes_canonical_counts_locally",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "header_legible_at_a_glance"
      ],
      "properties": {
        "header_id": { "$ref": "#/$defs/non_empty_string" },
        "header_label": { "type": "string" },
        "active_context": { "$ref": "#/$defs/non_empty_string" },
        "background_context_shown_as_active": { "type": "boolean" },
        "local_action_budget": { "$ref": "#/$defs/non_empty_string" },
        "local_actions_hover_only": { "type": "boolean" },
        "becomes_secondary_toolbar": { "type": "boolean" },
        "overflowed_action_dropped": { "type": "boolean" },
        "references_canonical_model": { "type": "boolean" },
        "re_encodes_canonical_counts_locally": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "header_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "table_grid_examples",
        "panel_header_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_current_selection_blocked_or_actions_behind_hover_only",
        "collapses_selection_versus_current_or_count_scopes",
        "presents_qualified_stale_or_partial_grid_as_canonical",
        "panel_header_overloads_or_re_encodes_counts"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "table_grid_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/table_grid_example" }
        },
        "panel_header_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/panel_header_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_current_selection_blocked_or_actions_behind_hover_only": { "const": false },
        "collapses_selection_versus_current_or_count_scopes": { "const": false },
        "presents_qualified_stale_or_partial_grid_as_canonical": { "const": false },
        "panel_header_overloads_or_re_encodes_counts": { "const": false }
      }
    }
  }
}
