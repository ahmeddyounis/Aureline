{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-repair-transaction-preview-card-rollback-class-strip-controls.schema.json",
  "title": "Aureline M5 repair-transaction-preview-card and rollback-class-strip controls",
  "description": "Export-safe packet for the guided-repair implement lane over the frozen M5 workspace-trust / guided-repair component matrix. It carries resolved, honest projections of the repair-transaction preview card and the rollback-class strip across the claimed M5 consumer surfaces, so a repair preview reads as a typed transaction review rather than a folklore 'Fix it' shortcut. Each controls row binds a consumer surface to the resolved preview card examples (naming the stable repair id, linked finding ids, prerequisites, checkpoint state, impact scope, and local / remote / managed target class) and the resolved rollback strip examples (naming the controlled exact / compensate / regenerate / manual / audit-only reversal class and checkpoint availability). Hard invariants forbid hiding checkpoint absence or reversal limits, collapsing distinct reversal classes into a generic success, implying reversibility without an exact or regenerate reversal, and hiding the target class or impact scope. Acceptance criteria — one transaction-preview grammar with checkpoint presence or absence visible before apply, and one reversal vocabulary that stays truthful about reversal limits — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_repair_transaction_preview_card_and_rollback_class_strip_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repair_disposition": {
      "type": ["string", "null"],
      "enum": [
        "trusted",
        "restricted",
        "mixed_root",
        "policy_blocked",
        "reduced_mode",
        "preview_ready",
        "checkpoint_missing",
        "exact_reversal",
        "compensate",
        "regenerate",
        "manual_follow_up",
        "audit_only",
        null
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "repair_transaction_preview_card_example": {
      "type": "object",
      "required": [
        "card_id",
        "repair_id",
        "linked_finding_ids",
        "prerequisites",
        "prerequisites_stated",
        "checkpoint_state",
        "checkpoint_present",
        "checkpoint_absent",
        "impact_scope",
        "target_class",
        "is_local_remote_or_managed",
        "preview_state",
        "preview_ready",
        "repair_disposition",
        "collapses_target_into_generic",
        "hides_checkpoint_absence",
        "presents_incomplete_as_ready",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "transaction_reviewable"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "repair_id": { "type": "string" },
        "linked_finding_ids": { "type": "array", "items": { "type": "string" } },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "prerequisites_stated": { "type": "boolean" },
        "checkpoint_state": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_present": { "type": "boolean" },
        "checkpoint_absent": { "type": "boolean" },
        "impact_scope": { "type": "string" },
        "target_class": { "$ref": "#/$defs/non_empty_string" },
        "is_local_remote_or_managed": { "type": "boolean" },
        "preview_state": { "$ref": "#/$defs/non_empty_string" },
        "preview_ready": { "type": "boolean" },
        "repair_disposition": { "$ref": "#/$defs/repair_disposition" },
        "collapses_target_into_generic": { "type": "boolean" },
        "hides_checkpoint_absence": { "type": "boolean" },
        "presents_incomplete_as_ready": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "transaction_reviewable": { "type": "boolean" }
      }
    },
    "rollback_class_strip_example": {
      "type": "object",
      "required": [
        "strip_id",
        "repair_id",
        "reversal_class",
        "repair_disposition",
        "checkpoint_state",
        "checkpoint_absent",
        "is_exact_reversal",
        "permits_reversible_claim",
        "claims_reversible",
        "reversal_limit_disclosed",
        "overclaims_reversibility",
        "hides_reversal_limit",
        "collapses_into_generic_undo",
        "hides_checkpoint_absence",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "reversal_truth_explicit"
      ],
      "properties": {
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "repair_id": { "type": "string" },
        "reversal_class": { "$ref": "#/$defs/non_empty_string" },
        "repair_disposition": { "$ref": "#/$defs/repair_disposition" },
        "checkpoint_state": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_absent": { "type": "boolean" },
        "is_exact_reversal": { "type": "boolean" },
        "permits_reversible_claim": { "type": "boolean" },
        "claims_reversible": { "type": "boolean" },
        "reversal_limit_disclosed": { "type": "boolean" },
        "overclaims_reversibility": { "type": "boolean" },
        "hides_reversal_limit": { "type": "boolean" },
        "collapses_into_generic_undo": { "type": "boolean" },
        "hides_checkpoint_absence": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "reversal_truth_explicit": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "repair_transaction_preview_card_examples",
        "rollback_class_strip_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_checkpoint_absence_or_reversal_limits",
        "collapses_reversal_classes_into_generic_success",
        "implies_reversibility_without_exact_or_regenerate",
        "hides_target_class_or_impact_scope"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "repair_transaction_preview_card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repair_transaction_preview_card_example" }
        },
        "rollback_class_strip_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rollback_class_strip_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_checkpoint_absence_or_reversal_limits": { "const": false },
        "collapses_reversal_classes_into_generic_success": { "const": false },
        "implies_reversibility_without_exact_or_regenerate": { "const": false },
        "hides_target_class_or_impact_scope": { "const": false }
      }
    }
  }
}
