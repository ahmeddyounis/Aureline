{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-relation-strip-sync-pending-controls.schema.json",
  "title": "Aureline M5 relation strips and sync-pending pills",
  "description": "Export-safe packet implementing the reusable M5 relation-strip and sync-pending-pill components in two co-equal control vectors. Each relation strip summarizes the linked branch/review/test/incident context of a work item, naming every linked context by kind and reference rather than collapsing several links into a single vague 'Linked' label; each relation carries a health class derived from whether the target is reachable and the reference is current, so a stale, broken, or unmapped link is labeled as such instead of reading as live, and every relation offers metadata-safe copy/open actions. Each sync-pending pill discloses its pending change type, its last sync attempt, and a retry-or-export recovery action, and its sync-recovery class is derived from the local-versus-provider state, a policy-block flag, and provider reachability, so a pending, failed, or offline-held change reads visibly differently from a provider-confirmed state and stays recoverable when publish fails or the provider is offline. Generic ticket/task wording never conceals linked context or queued state; raw work-item bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "relation_strips",
    "sync_pending_pills",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "relation_strip_sync_pending_controls" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "relation_strips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relation_strip" }
    },
    "sync_pending_pills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sync_pending_pill" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "linked_branch",
        "linked_pull_request",
        "linked_review",
        "linked_test_run",
        "linked_incident",
        "unmapped_relation"
      ]
    },
    "relation_health_class": {
      "type": "string",
      "enum": ["current", "stale", "broken", "unmapped"]
    },
    "relation_action": {
      "type": "string",
      "enum": ["copy_reference", "open_relation", "reveal_scope", "export_relation"]
    },
    "local_state": {
      "type": "string",
      "enum": [
        "synced_with_provider",
        "local_only_draft",
        "queued_for_publish",
        "publish_deferred",
        "publish_failed",
        "conflict_held"
      ]
    },
    "pending_change_type": {
      "type": "string",
      "enum": [
        "pending_comment",
        "pending_transition",
        "pending_link",
        "pending_field_edit",
        "pending_create"
      ]
    },
    "sync_recovery_class": {
      "type": "string",
      "enum": [
        "provider_confirmed",
        "pending_publish",
        "recoverable_failure",
        "offline_held",
        "policy_blocked"
      ]
    },
    "sync_pill_action": {
      "type": "string",
      "enum": [
        "retry_publish",
        "export_packet",
        "open_in_provider",
        "view_conflict",
        "discard_draft"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "issue_inbox",
        "work_item_detail",
        "review_workspace",
        "incident_workspace",
        "support_workflow",
        "cli_work_item"
      ]
    },
    "deployment_line": {
      "type": "string",
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "inbox_ui",
        "detail_ui",
        "relation_panel_ui",
        "sync_status_ui",
        "transition_sheet_ui",
        "evidence_panel_ui",
        "support_export",
        "cli_inspect",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "identity_unstated",
        "provider_authority_unstated",
        "local_versus_provider_state_hidden",
        "linked_context_unstated",
        "side_effect_preview_hidden",
        "publish_later_continuity_hidden",
        "sync_pending_state_hidden",
        "evidence_provenance_unstated",
        "handoff_destination_unstated",
        "export_boundary_hidden",
        "alternate_state_label_invented",
        "generic_ticket_wording_used",
        "proof_stale"
      ]
    },
    "accessibility_route_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_route" },
      "contains": { "const": "keyboard_focusable" }
    },
    "relation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_kind",
        "reference_label",
        "is_target_reachable",
        "is_reference_current",
        "health_class",
        "relation_note",
        "actions"
      ],
      "properties": {
        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "reference_label": { "$ref": "#/$defs/non_empty_string" },
        "is_target_reachable": { "type": "boolean" },
        "is_reference_current": { "type": "boolean" },
        "health_class": { "$ref": "#/$defs/relation_health_class" },
        "relation_note": { "type": "string" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relation_action" },
          "allOf": [
            { "contains": { "const": "copy_reference" } },
            { "contains": { "const": "open_relation" } }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "health_class": { "const": "current" } },
            "required": ["health_class"]
          },
          "else": {
            "properties": { "relation_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        }
      ]
    },
    "relation_strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "strip_id",
        "canonical_id",
        "relations",
        "collapses_into_generic_linked_label",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "uses_generic_ticket_wording"
      ],
      "properties": {
        "component": { "const": "relation_strip" },
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id": { "$ref": "#/$defs/non_empty_string" },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relation_entry" }
        },
        "collapses_into_generic_linked_label": { "const": false },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "uses_generic_ticket_wording": { "const": false }
      }
    },
    "sync_pending_pill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "pill_id",
        "canonical_id",
        "pending_change_type",
        "pending_change_label",
        "local_state",
        "is_policy_blocked",
        "is_provider_offline",
        "recovery_class",
        "claims_provider_confirmed",
        "distinct_from_confirmed_style",
        "last_sync_attempt_label",
        "recovery_actions",
        "policy_block_note",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "uses_generic_ticket_wording"
      ],
      "properties": {
        "component": { "const": "sync_pending_pill" },
        "pill_id": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id": { "$ref": "#/$defs/non_empty_string" },
        "pending_change_type": { "$ref": "#/$defs/pending_change_type" },
        "pending_change_label": { "$ref": "#/$defs/non_empty_string" },
        "local_state": { "$ref": "#/$defs/local_state" },
        "is_policy_blocked": { "type": "boolean" },
        "is_provider_offline": { "type": "boolean" },
        "recovery_class": { "$ref": "#/$defs/sync_recovery_class" },
        "claims_provider_confirmed": { "type": "boolean" },
        "distinct_from_confirmed_style": { "type": "boolean" },
        "last_sync_attempt_label": { "type": "string" },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sync_pill_action" }
        },
        "policy_block_note": { "type": "string" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "uses_generic_ticket_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "recovery_class": { "const": "provider_confirmed" } },
            "required": ["recovery_class"]
          },
          "then": {
            "properties": { "claims_provider_confirmed": { "const": true } }
          },
          "else": {
            "properties": {
              "claims_provider_confirmed": { "const": false },
              "distinct_from_confirmed_style": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recovery_class": {
                "enum": ["pending_publish", "recoverable_failure", "offline_held"]
              }
            },
            "required": ["recovery_class"]
          },
          "then": {
            "properties": {
              "last_sync_attempt_label": { "$ref": "#/$defs/non_empty_string" },
              "recovery_actions": {
                "contains": { "enum": ["retry_publish", "export_packet"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "recovery_class": { "const": "policy_blocked" } },
            "required": ["recovery_class"]
          },
          "then": {
            "properties": { "policy_block_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_strip_names_each_linked_context",
        "stale_and_broken_relations_labeled",
        "relation_actions_metadata_safe_copy_open",
        "sync_pending_visibly_distinct_from_confirmed",
        "sync_pending_discloses_change_type",
        "last_sync_attempt_shown_when_pending",
        "retry_or_export_recovery_always_available",
        "policy_blocked_state_always_explicit",
        "no_generic_ticket_wording_conceals_context",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "relation_strip_names_each_linked_context": { "const": true },
        "stale_and_broken_relations_labeled": { "const": true },
        "relation_actions_metadata_safe_copy_open": { "const": true },
        "sync_pending_visibly_distinct_from_confirmed": { "const": true },
        "sync_pending_discloses_change_type": { "const": true },
        "last_sync_attempt_shown_when_pending": { "const": true },
        "retry_or_export_recovery_always_available": { "const": true },
        "policy_blocked_state_always_explicit": { "const": true },
        "no_generic_ticket_wording_conceals_context": { "const": true },
        "controls_stable_across_deployment_lines": { "const": true },
        "copy_and_export_safe": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side_rail_relation_strips_name_each_context",
        "list_and_rail_distinguish_pending_from_confirmed",
        "retry_and_export_reachable_headless",
        "cli_headless_shows_control_truth",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "side_rail_relation_strips_name_each_context": { "const": true },
        "list_and_rail_distinguish_pending_from_confirmed": { "const": true },
        "retry_and_export_reachable_headless": { "const": true },
        "cli_headless_shows_control_truth": { "const": true },
        "support_export_shows_control_truth": { "const": true },
        "help_about_shows_control_truth": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
