{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-artifact-identity-diff-mode-controls.schema.json",
  "title": "Aureline M5 artifact identity bars and diff-mode switchers",
  "description": "Export-safe packet implementing the reusable M5 artifact-identity-bar and diff-mode-switcher components. Each identity bar answers, from the component alone, what artifact class the reader is looking at, which canonical source owns it, what parser/schema state backs it, whether the artifact is authored, generated, imported, or policy-owned, and whether it is a writable target or compare-only. Each diff-mode switcher enumerates which review lenses exist, which is active, why any unavailable lens cannot be used, and keeps a raw/export-safe fallback lens reachable. Identity bars and switchers are paired by artifact reference so canonical-source and compare-only truth are never buried in a distant panel. Raw artifact bodies, raw render payloads, raw media bytes, credentials, and live provider responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "identity_bars",
    "diff_switchers",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "artifact_identity_and_diff_mode_controls"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "identity_bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/identity_bar"
      }
    },
    "diff_switchers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diff_switcher"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_trigger"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "origin_class": {
      "type": "string",
      "enum": [
        "authored_in_repo",
        "generated_from_source",
        "imported_external",
        "policy_owned"
      ]
    },
    "fidelity_state": {
      "type": "string",
      "enum": [
        "structured_faithful",
        "structured_partial",
        "schema_unrecognized",
        "render_untrusted",
        "raw_fallback",
        "redacted_or_withheld"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "compare_only_no_write_back",
        "write_back_attributable",
        "regenerate_only_no_manual_edit",
        "evidence_preserved_no_revert",
        "not_applicable"
      ]
    },
    "review_lens": {
      "type": "string",
      "enum": [
        "structured_semantic",
        "rendered_preview",
        "raw_text_fallback",
        "side_by_side",
        "three_way_merge",
        "media_visual"
      ]
    },
    "lens_availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable_schema_unrecognized",
        "unavailable_parser_missing",
        "unavailable_render_untrusted",
        "unavailable_redacted",
        "unavailable_policy_blocked"
      ]
    },
    "identity_component": {
      "type": "string",
      "const": "artifact_identity_bar"
    },
    "diff_component": {
      "type": "string",
      "const": "diff_mode_switcher"
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "parser_unavailable",
        "schema_unrecognized",
        "render_untrusted",
        "compare_only_enforced",
        "generated_artifact_stale",
        "redaction_applied",
        "trust_narrowing",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "diff_compare_view",
        "merge_conflict_workspace",
        "notebook_review",
        "artifact_browser",
        "cli_headless",
        "support_export",
        "help_about"
      ]
    },
    "identity_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "bar_id",
        "artifact_ref",
        "artifact_class_label",
        "origin_class",
        "canonical_source_disclosure",
        "parser_schema_state",
        "claims_writable_target",
        "generated_from_relation",
        "source_of_truth_pointer",
        "raw_fallback_note",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/identity_component"
        },
        "bar_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_class_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "origin_class": {
          "$ref": "#/$defs/origin_class"
        },
        "canonical_source_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "parser_schema_state": {
          "$ref": "#/$defs/fidelity_state"
        },
        "claims_writable_target": {
          "type": "boolean"
        },
        "generated_from_relation": {
          "type": "string"
        },
        "source_of_truth_pointer": {
          "type": "string"
        },
        "raw_fallback_note": {
          "type": "string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "diff_mode_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "availability",
        "unavailability_reason"
      ],
      "properties": {
        "lens": {
          "$ref": "#/$defs/review_lens"
        },
        "availability": {
          "$ref": "#/$defs/lens_availability"
        },
        "unavailability_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "else": {
            "properties": {
              "unavailability_reason": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "diff_switcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "switcher_id",
        "artifact_ref",
        "artifact_class_label",
        "options",
        "active_lens",
        "compare_write_back_safety",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/diff_component"
        },
        "switcher_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_class_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diff_mode_option"
          }
        },
        "active_lens": {
          "$ref": "#/$defs/review_lens"
        },
        "compare_write_back_safety": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class_always_explicit",
        "canonical_source_never_buried",
        "generated_from_relation_never_hidden",
        "compare_only_never_silently_writable",
        "parser_schema_state_explicit",
        "review_lenses_enumerated",
        "lens_unavailability_reason_explicit",
        "raw_fallback_always_available",
        "writable_target_matches_origin",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "artifact_class_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "canonical_source_never_buried": {
          "type": "boolean",
          "const": true
        },
        "generated_from_relation_never_hidden": {
          "type": "boolean",
          "const": true
        },
        "compare_only_never_silently_writable": {
          "type": "boolean",
          "const": true
        },
        "parser_schema_state_explicit": {
          "type": "boolean",
          "const": true
        },
        "review_lenses_enumerated": {
          "type": "boolean",
          "const": true
        },
        "lens_unavailability_reason_explicit": {
          "type": "boolean",
          "const": true
        },
        "raw_fallback_always_available": {
          "type": "boolean",
          "const": true
        },
        "writable_target_matches_origin": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_bar_shows_class_and_canonical_source",
        "diff_switcher_shows_available_and_unavailable_lenses",
        "compare_only_truth_shown_inline",
        "generated_from_relation_shown",
        "raw_fallback_reachable",
        "cli_headless_shows_truth",
        "support_export_shows_truth",
        "help_about_shows_truth"
      ],
      "properties": {
        "identity_bar_shows_class_and_canonical_source": {
          "type": "boolean",
          "const": true
        },
        "diff_switcher_shows_available_and_unavailable_lenses": {
          "type": "boolean",
          "const": true
        },
        "compare_only_truth_shown_inline": {
          "type": "boolean",
          "const": true
        },
        "generated_from_relation_shown": {
          "type": "boolean",
          "const": true
        },
        "raw_fallback_reachable": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
