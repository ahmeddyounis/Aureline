{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-interactive-state-contract.schema.json",
  "title": "Aureline M5 interactive-state contract primitive",
  "description": "Export-safe packet implementing the reusable M5 interactive-state contract as one primitive. The packet binds one row per claimed M5 control — the push button, the icon button, the menu item, the pane splitter, and the quick-action card — to the shared interactive-state anatomy, the four governed interactive states (default/hover/focus-visible/pressed-active), the derived presentation posture (resting-default/pointer-hover/keyboard-focus-visible/pressed-or-active), the required non-color cues, the interaction input routes, the export fields, the mandatory labels, and the non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never signals a state by color alone, never shifts layout on a state change, never changes its hit target on a state change, and never invents a private state name. Raw local paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_default_hover_focus_visible_pressed_state_contracts_with_no_color_only_and_no_layout_shift_rules_across_claimed_m5_controls_and_pane_affordances"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "interactive_state_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "interactive_state_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_kind",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "interactive_states",
        "presentations",
        "non_color_cues",
        "interaction_input_routes",
        "export_fields",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "state_examples",
        "signals_state_by_color_only",
        "shifts_layout_on_state_change",
        "changes_hit_target_on_state_change",
        "invents_private_state_name"
      ],
      "properties": {
        "control_kind": {
          "enum": [
            "push_button",
            "icon_button",
            "menu_item",
            "pane_splitter",
            "quick_action_card"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "interactive_states": { "type": "array", "minItems": 1 },
        "presentations": { "type": "array", "minItems": 1 },
        "non_color_cues": { "type": "array", "minItems": 1 },
        "interaction_input_routes": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "keyboard_focusable" } },
            { "contains": { "const": "non_color_encoded" } }
          ]
        },
        "required_labels": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "state_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_example" }
        },
        "signals_state_by_color_only": { "const": false },
        "shifts_layout_on_state_change": { "const": false },
        "changes_hit_target_on_state_change": { "const": false },
        "invents_private_state_name": { "const": false }
      }
    },
    "state_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "control_kind",
            "interactive_state",
            "presentation",
            "required_non_color_cues",
            "interaction_input_routes",
            "control_identity_ref",
            "state_style_ref",
            "focus_ring_shown",
            "reduced_motion_active",
            "high_contrast_active",
            "no_color_only_signaling",
            "stable_hit_target",
            "no_interaction_breaking_layout_shift",
            "focus_visible_for_keyboard",
            "reduced_motion_safe",
            "high_contrast_safe",
            "driven_by_shared_state_contract"
          ]
        }
      }
    }
  }
}
