{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-core-action-input-shared-consumers.schema.json",
  "title": "M5 Core Action / Input Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the eight B134 core action and input controls (button, icon button, split button, text field, search field, combobox, checkbox/radio/switch toggle control, segmented control) to the forms / settings / search / entry / review / repair / CLI-export / support / product consumers that render them, proving one shared vocabulary across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_core_action_input_shared_consumer_vocabulary_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 12,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "button",
        "icon_button",
        "split_button",
        "text_field",
        "search_field",
        "combobox",
        "toggle_control",
        "segmented_control"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "forms_ui",
        "settings_ui",
        "search_ui",
        "entry_ui",
        "review_ui",
        "repair_ui",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "vocabulary_drift_detected",
        "placeholder_used_as_label",
        "loading_relabeled_or_resized",
        "icon_only_destructive_unlabeled",
        "switch_and_deferred_checkbox_blurred",
        "split_defaulted_to_riskier_alternate",
        "locked_or_degraded_hidden_behind_disabled",
        "canonical_reference_missing",
        "upstream_control_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_word",
        "command_binding_word",
        "value_source_word",
        "validation_word",
        "lock_policy_word"
      ],
      "properties": {
        "state_word": { "type": "string", "minLength": 1 },
        "command_binding_word": { "type": "string", "minLength": 1 },
        "value_source_word": { "type": "string", "minLength": 1 },
        "validation_word": { "type": "string", "minLength": 1 },
        "lock_policy_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "control_object_id",
        "control_object_label",
        "component",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "lets_placeholder_text_replace_the_label",
        "lets_loading_relabel_the_action_or_lose_attribution",
        "leaves_icon_only_destructive_action_unlabeled",
        "blurs_switch_with_deferred_checkbox",
        "lets_split_button_default_to_riskier_alternate",
        "hides_locked_or_degraded_semantics_behind_generic_disabled",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "control_object_id": { "type": "string", "minLength": 1 },
        "control_object_label": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "lets_placeholder_text_replace_the_label": {
          "type": "boolean",
          "const": false
        },
        "lets_loading_relabel_the_action_or_lose_attribution": {
          "type": "boolean",
          "const": false
        },
        "leaves_icon_only_destructive_action_unlabeled": {
          "type": "boolean",
          "const": false
        },
        "blurs_switch_with_deferred_checkbox": {
          "type": "boolean",
          "const": false
        },
        "lets_split_button_default_to_riskier_alternate": {
          "type": "boolean",
          "const": false
        },
        "hides_locked_or_degraded_semantics_behind_generic_disabled": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_reuse_proven_by_fixtures",
        "same_object_same_vocabulary_across_surfaces",
        "state_words_stay_in_frozen_vocabulary",
        "placeholder_never_replaces_label",
        "loading_never_relabels_or_loses_attribution",
        "icon_destructive_never_unlabeled",
        "switch_never_blurred_with_deferred_checkbox",
        "split_never_defaults_to_riskier_alternate",
        "locked_and_degraded_stay_distinct_from_disabled",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "control_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_object_same_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "state_words_stay_in_frozen_vocabulary": { "type": "boolean", "const": true },
        "placeholder_never_replaces_label": { "type": "boolean", "const": true },
        "loading_never_relabels_or_loses_attribution": {
          "type": "boolean",
          "const": true
        },
        "icon_destructive_never_unlabeled": { "type": "boolean", "const": true },
        "switch_never_blurred_with_deferred_checkbox": {
          "type": "boolean",
          "const": true
        },
        "split_never_defaults_to_riskier_alternate": {
          "type": "boolean",
          "const": true
        },
        "locked_and_degraded_stay_distinct_from_disabled": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": { "type": "boolean", "const": true },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forms_ui_reuses_shared_controls",
        "settings_ui_reuses_shared_controls",
        "search_ui_reuses_shared_controls",
        "entry_ui_reuses_shared_controls",
        "review_ui_reuses_shared_controls",
        "repair_ui_reuses_shared_controls",
        "support_export_reuses_shared_controls",
        "every_control_adopted_by_two_or_more_consumers",
        "vocabulary_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_contract_family"
      ],
      "properties": {
        "forms_ui_reuses_shared_controls": { "type": "boolean", "const": true },
        "settings_ui_reuses_shared_controls": { "type": "boolean", "const": true },
        "search_ui_reuses_shared_controls": { "type": "boolean", "const": true },
        "entry_ui_reuses_shared_controls": { "type": "boolean", "const": true },
        "review_ui_reuses_shared_controls": { "type": "boolean", "const": true },
        "repair_ui_reuses_shared_controls": { "type": "boolean", "const": true },
        "support_export_reuses_shared_controls": {
          "type": "boolean",
          "const": true
        },
        "every_control_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "vocabulary_identical_for_same_object": { "type": "boolean", "const": true },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_contract_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
