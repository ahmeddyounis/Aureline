{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-result-grid.schema.json",
  "title": "Aureline M5 result grid",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "grid_id", "result_identity_ref", "statement_or_request_ref", "execution_origin", "columns", "row_count_scope", "returned_row_count", "total_row_count", "truncation_state", "virtualization_state", "filter_sort_state", "copy_export_actions", "redaction_review_state", "export_posture", "source_refs", "consumer_surfaces", "copy_export"],
  "properties": {
    "record_kind": { "const": "m5_result_grid" },
    "schema_version": { "const": 1 },
    "grid_id": { "$ref": "#/$defs/id" },
    "result_identity_ref": { "$ref": "#/$defs/ref" },
    "statement_or_request_ref": { "$ref": "#/$defs/ref" },
    "execution_origin": { "$ref": "#/$defs/origin" },
    "columns": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["column_ref", "display_name", "type_identity", "redaction_class"], "properties": { "column_ref": { "$ref": "#/$defs/ref" }, "display_name": { "$ref": "#/$defs/ref" }, "type_identity": { "type": "string", "enum": ["boolean_logical", "integer_signed", "integer_unsigned", "decimal_or_numeric", "floating_point", "string_text", "binary_bytes", "uuid_or_guid", "json_document", "date_only", "time_only", "timestamp", "array", "struct_record", "unknown"] }, "redaction_class": { "type": "string", "enum": ["none", "metadata_only", "redacted", "secret", "policy_hidden"] } } } },
    "row_count_scope": { "$ref": "#/$defs/row_count_scope" },
    "returned_row_count": { "type": "integer", "minimum": 0 },
    "total_row_count": { "type": ["integer", "null"], "minimum": 0 },
    "truncation_state": { "type": "string", "enum": ["none", "row_truncated_user_limit", "row_truncated_engine_cap", "row_truncated_provider_cap", "cell_truncated_detail_available", "streaming_open", "metadata_only"] },
    "virtualization_state": { "type": "string", "enum": ["inline_no_virtualization", "row_virtualized", "row_and_column_virtualized", "textual_fallback"] },
    "filter_sort_state": { "type": "object", "additionalProperties": false, "required": ["filter_count", "sort_count", "evaluation_locus"], "properties": { "filter_count": { "type": "integer", "minimum": 0 }, "sort_count": { "type": "integer", "minimum": 0 }, "evaluation_locus": { "type": "string", "enum": ["engine_side", "client_side_returned_rows_only", "mixed_review_required", "none"] } } },
    "copy_export_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["copy_visible_typed", "copy_json_lines_typed", "export_csv_typed", "export_json_typed", "export_parquet_typed", "notebook_handoff_typed", "chart_handoff_typed", "ai_context_metadata_only"] } },
    "redaction_review_state": { "$ref": "#/$defs/redaction_review_state" },
    "export_posture": { "$ref": "#/$defs/export_posture" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "origin": { "type": "string", "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "imported_snapshot", "cli_headless"] },
    "row_count_scope": { "type": "string", "enum": ["exact_total_known", "exact_returned_only_total_unknown", "estimate_engine_provided", "estimate_planner_provided", "unknown_streaming", "visible_rows_only", "sampled_rows"] },
    "redaction_review_state": { "type": "string", "enum": ["not_required", "required_before_export", "completed", "blocked_by_policy"] },
    "export_posture": { "type": "string", "enum": ["metadata_only", "redacted_typed", "visible_rows_only_typed", "full_result_typed", "blocked_pending_consent", "blocked_pending_policy", "blocked_redaction_class_too_high"] },
    "consumer_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["desktop_request_workspace", "desktop_database_tool", "remote_workspace", "container_workspace", "managed_workspace", "browser_runtime_panel", "notebook_handoff", "chart_handoff", "ai_context_handoff", "cli_headless", "support_export", "release_proof"] } },
    "copy_export": { "type": "object", "additionalProperties": false, "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "$ref": "#/$defs/ref" }, "json": { "$ref": "#/$defs/ref" }, "markdown": { "$ref": "#/$defs/ref" }, "screenshot_only_prohibited": { "const": true } } }
  }
}
