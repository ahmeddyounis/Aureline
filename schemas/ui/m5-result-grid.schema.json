{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-result-grid.schema.json",
  "title": "Aureline M5 result grid",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "grid_id",
    "result_identity_ref",
    "statement_or_request_ref",
    "execution_origin",
    "columns",
    "row_count_scope",
    "returned_row_count",
    "total_row_count",
    "loaded_range_truth",
    "truncation_state",
    "virtualization_state",
    "filter_sort_state",
    "value_rendering_rules",
    "copy_export_actions",
    "export_review",
    "redaction_review_state",
    "export_posture",
    "source_refs",
    "consumer_surfaces",
    "copy_export",
    "reduced_capability_banner",
    "provider_handoff_notes"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_result_grid"
    },
    "schema_version": {
      "const": 1
    },
    "grid_id": {
      "$ref": "#/$defs/id"
    },
    "result_identity_ref": {
      "$ref": "#/$defs/ref"
    },
    "statement_or_request_ref": {
      "$ref": "#/$defs/ref"
    },
    "execution_origin": {
      "$ref": "#/$defs/origin"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "column_ref",
          "display_name",
          "type_identity",
          "nullable",
          "rendering_rule",
          "redaction_class"
        ],
        "properties": {
          "column_ref": {
            "$ref": "#/$defs/ref"
          },
          "display_name": {
            "$ref": "#/$defs/ref"
          },
          "type_identity": {
            "type": "string",
            "enum": [
              "boolean_logical",
              "integer_signed",
              "integer_unsigned",
              "decimal_or_numeric",
              "floating_point",
              "string_text",
              "binary_bytes",
              "uuid_or_guid",
              "json_document",
              "date_only",
              "time_only",
              "timestamp",
              "array",
              "struct_record",
              "unknown"
            ]
          },
          "nullable": {
            "type": "boolean"
          },
          "rendering_rule": {
            "type": "string",
            "enum": [
              "scalar_text",
              "null_marker",
              "binary_size_digest",
              "json_collapsed_tree",
              "redacted_value",
              "unknown_type"
            ]
          },
          "redaction_class": {
            "type": "string",
            "enum": [
              "none",
              "metadata_only",
              "redacted",
              "secret",
              "policy_hidden"
            ]
          }
        }
      }
    },
    "row_count_scope": {
      "$ref": "#/$defs/row_count_scope"
    },
    "returned_row_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_row_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "loaded_range_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range_scope",
        "loaded_ranges",
        "loaded_row_count",
        "unloaded_rows_known",
        "overscan_row_count"
      ],
      "properties": {
        "range_scope": {
          "type": "string",
          "enum": [
            "all_returned_rows_loaded",
            "partial_returned_rows_loaded",
            "streaming_window",
            "metadata_only_no_rows"
          ]
        },
        "loaded_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_row_inclusive",
              "end_row_exclusive"
            ],
            "properties": {
              "start_row_inclusive": {
                "type": "integer",
                "minimum": 0
              },
              "end_row_exclusive": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "loaded_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "unloaded_rows_known": {
          "type": "boolean"
        },
        "overscan_row_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "truncation_state": {
      "type": "string",
      "enum": [
        "none",
        "row_truncated_user_limit",
        "row_truncated_engine_cap",
        "row_truncated_provider_cap",
        "cell_truncated_detail_available",
        "streaming_open",
        "metadata_only"
      ]
    },
    "virtualization_state": {
      "type": "string",
      "enum": [
        "inline_no_virtualization",
        "row_virtualized",
        "row_and_column_virtualized",
        "textual_fallback"
      ]
    },
    "filter_sort_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filter_count",
        "sort_count",
        "evaluation_locus"
      ],
      "properties": {
        "filter_count": {
          "type": "integer",
          "minimum": 0
        },
        "sort_count": {
          "type": "integer",
          "minimum": 0
        },
        "evaluation_locus": {
          "type": "string",
          "enum": [
            "engine_side",
            "client_side_returned_rows_only",
            "mixed_review_required",
            "none"
          ]
        }
      }
    },
    "value_rendering_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "null_display",
        "binary_display",
        "json_display",
        "large_value_disclosure",
        "raw_binary_copy_default",
        "json_preserves_type_identity"
      ],
      "properties": {
        "null_display": {
          "type": "string",
          "enum": [
            "null_glyph_with_type_tooltip",
            "empty_string_prohibited"
          ]
        },
        "binary_display": {
          "type": "string",
          "enum": [
            "size_and_digest_only",
            "download_after_review",
            "blocked_by_policy"
          ]
        },
        "json_display": {
          "type": "string",
          "enum": [
            "collapsed_tree_typed",
            "formatted_text_typed",
            "metadata_only"
          ]
        },
        "large_value_disclosure": {
          "type": "string",
          "enum": [
            "expand_cell_after_review",
            "truncated_with_length",
            "metadata_only"
          ]
        },
        "raw_binary_copy_default": {
          "const": false
        },
        "json_preserves_type_identity": {
          "const": true
        }
      }
    },
    "copy_export_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "copy_visible_typed",
          "copy_json_lines_typed",
          "export_csv_typed",
          "export_json_typed",
          "export_parquet_typed",
          "notebook_handoff_typed",
          "chart_handoff_typed",
          "ai_context_metadata_only"
        ]
      }
    },
    "export_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_required",
        "review_actions",
        "redaction_summary",
        "raw_values_blocked_by_default"
      ],
      "properties": {
        "review_required": {
          "type": "boolean"
        },
        "review_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "review_redacted_columns",
              "review_visible_row_scope",
              "review_binary_payloads",
              "review_json_payloads",
              "approve_notebook_handoff",
              "approve_support_export"
            ]
          }
        },
        "redaction_summary": {
          "$ref": "#/$defs/ref"
        },
        "raw_values_blocked_by_default": {
          "const": true
        }
      }
    },
    "redaction_review_state": {
      "$ref": "#/$defs/redaction_review_state"
    },
    "export_posture": {
      "$ref": "#/$defs/export_posture"
    },
    "source_refs": {
      "$ref": "#/$defs/ref_array"
    },
    "consumer_surfaces": {
      "$ref": "#/$defs/consumer_surfaces"
    },
    "copy_export": {
      "$ref": "#/$defs/copy_export"
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banner_id",
        "severity",
        "capability_state",
        "visible_label",
        "missing_capabilities",
        "preserved_fields",
        "action_policy"
      ],
      "properties": {
        "banner_id": {
          "$ref": "#/$defs/ref"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocked"
          ]
        },
        "capability_state": {
          "type": "string",
          "enum": [
            "read_only",
            "write_capable",
            "inspect_only",
            "mutation_review_required",
            "policy_blocked",
            "unavailable"
          ]
        },
        "visible_label": {
          "$ref": "#/$defs/ref"
        },
        "missing_capabilities": {
          "$ref": "#/$defs/ref_array"
        },
        "preserved_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "action_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_send_available",
            "replay_available",
            "mutate_available",
            "export_available"
          ],
          "properties": {
            "live_send_available": {
              "type": "boolean"
            },
            "replay_available": {
              "type": "boolean"
            },
            "mutate_available": {
              "type": "boolean"
            },
            "export_available": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provider_handoff_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note_id",
          "provider_surface",
          "handoff_state",
          "truth_preserved",
          "return_anchor_ref",
          "raw_material_exported"
        ],
        "properties": {
          "note_id": {
            "$ref": "#/$defs/ref"
          },
          "provider_surface": {
            "type": "string",
            "enum": [
              "desktop_request_workspace",
              "desktop_database_tool",
              "remote_workspace",
              "container_workspace",
              "managed_workspace",
              "browser_runtime_panel",
              "notebook_handoff",
              "chart_handoff",
              "ai_context_handoff",
              "cli_headless",
              "support_export",
              "release_proof"
            ]
          },
          "handoff_state": {
            "$ref": "#/$defs/ref"
          },
          "truth_preserved": {
            "$ref": "#/$defs/ref_array"
          },
          "return_anchor_ref": {
            "$ref": "#/$defs/ref"
          },
          "raw_material_exported": {
            "const": false
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "origin": {
      "type": "string",
      "enum": [
        "local_desktop",
        "ssh_remote",
        "container_workspace",
        "managed_workspace",
        "browser_runtime",
        "imported_snapshot",
        "cli_headless"
      ]
    },
    "row_count_scope": {
      "type": "string",
      "enum": [
        "exact_total_known",
        "exact_returned_only_total_unknown",
        "estimate_engine_provided",
        "estimate_planner_provided",
        "unknown_streaming",
        "visible_rows_only",
        "sampled_rows"
      ]
    },
    "redaction_review_state": {
      "type": "string",
      "enum": [
        "not_required",
        "required_before_export",
        "completed",
        "blocked_by_policy"
      ]
    },
    "export_posture": {
      "type": "string",
      "enum": [
        "metadata_only",
        "redacted_typed",
        "visible_rows_only_typed",
        "full_result_typed",
        "blocked_pending_consent",
        "blocked_pending_policy",
        "blocked_redaction_class_too_high"
      ]
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "desktop_request_workspace",
          "desktop_database_tool",
          "remote_workspace",
          "container_workspace",
          "managed_workspace",
          "browser_runtime_panel",
          "notebook_handoff",
          "chart_handoff",
          "ai_context_handoff",
          "cli_headless",
          "support_export",
          "release_proof"
        ]
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "export_fields",
        "text",
        "json",
        "markdown",
        "screenshot_only_prohibited"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "json",
              "markdown"
            ]
          }
        },
        "export_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "text": {
          "$ref": "#/$defs/ref"
        },
        "json": {
          "$ref": "#/$defs/ref"
        },
        "markdown": {
          "$ref": "#/$defs/ref"
        },
        "screenshot_only_prohibited": {
          "const": true
        }
      }
    }
  }
}
