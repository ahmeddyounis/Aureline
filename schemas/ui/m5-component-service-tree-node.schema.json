{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-component-service-tree-node.schema.json",
  "title": "Aureline M5 component or service tree node",
  "description": "Per-component contract for a component or service tree node: the reusable component that names a topology node and how its relationship is known. Binds the one controlled certainty vocabulary plus the topology node kind and topology evidence class. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape. An inferred component tree never masquerades as an exact one and every node names its proving source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "identity_label",
    "state_label",
    "keyboard_route_label",
    "certainty",
    "topology_node_kind",
    "topology_evidence_class"
  ],
  "properties": {
    "component_family": {
      "const": "component_service_tree_node"
    },
    "identity_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "state_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certainty": {
      "$ref": "#/$defs/certainty_disposition"
    },
    "topology_node_kind": {
      "$ref": "#/$defs/topology_node_kind"
    },
    "topology_evidence_class": {
      "$ref": "#/$defs/topology_evidence_class"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "topology_node_kind": {
      "enum": [
        "component_node",
        "service_node",
        "module_node",
        "dependency_edge",
        "external_boundary",
        "unknown_node"
      ]
    },
    "topology_evidence_class": {
      "enum": [
        "exact_from_source",
        "heuristic_inferred",
        "runtime_confirmed",
        "derived_by_convention",
        "partial_evidence",
        "unresolved"
      ]
    }
  }
}
