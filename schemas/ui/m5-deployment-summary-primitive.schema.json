{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-deployment-summary-primitive.schema.json",
  "title": "Aureline M5 deployment-summary primitive",
  "description": "Canonical parity matrix for the reusable M5 deployment-summary primitive: a deployment summary card, its residual-dependency rows, and a control-plane/data-plane status strip that all resolve from one deployment context and share one deployment identity. Narrows three families of the frozen M5 deployment/continuity component matrix (deployment_summary_card, residual_dependency_row, control_plane_data_plane_status_strip) into one working resolver. A self-hosted or sovereign surface never implies a stronger boundary than the running deployment provides (AC1); control-plane degradation is distinguishable from local-runtime continuity without opening raw diagnostics (AC2); residual vendor dependency is explicit and exportable (AC3). Raw config bytes, credentials, license keys, and mirror URLs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_deployment_summary_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "about_deployment_card",
        "admin_deployment_console",
        "service_health_panel",
        "diagnostics_deployment",
        "support_export_replay",
        "docs_deployment_reference"
      ]
    },
    "deployment_scope": {
      "enum": [
        "shared_managed",
        "dedicated_managed",
        "self_hosted",
        "sovereign",
        "local_only"
      ]
    },
    "failure_consequence": {
      "enum": [
        "blocks_activation",
        "blocks_updates",
        "blocks_sign_in",
        "degrades_optional_feature",
        "no_user_impact"
      ]
    },
    "mitigation": {
      "enum": [
        "disable_feature",
        "offline_fallback",
        "self_host_alternative",
        "admin_provisioned",
        "no_alternative"
      ]
    },
    "local_safe_next_step": {
      "enum": [
        "continue_local_work",
        "work_offline_cached",
        "retry_control_plane",
        "restore_from_checkpoint",
        "contact_admin"
      ]
    },
    "export_field": {
      "enum": [
        "deployment_id",
        "deployment_scope",
        "operating_mode",
        "tenant_region",
        "mirror_offline_posture",
        "last_control_plane_sync",
        "plane_status",
        "residual_dependencies",
        "local_safe_next_step"
      ]
    },
    "deployment_mode": {
      "enum": ["desktop", "managed", "self_hosted", "portable", "air_gapped"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_reported"]
    },
    "residual_dependency_class": {
      "enum": [
        "license_activation",
        "update_delivery",
        "identity_provider",
        "telemetry_channel",
        "model_inference_service"
      ]
    },
    "plane_state": {
      "enum": ["operational", "degraded", "unavailable", "unknown"]
    },
    "downgrade_trigger": {
      "enum": [
        "control_plane_impaired",
        "mirror_stale",
        "offline_cache_only",
        "signature_unverified",
        "rollout_paused",
        "handler_ownership_contested",
        "state_root_unavailable",
        "residual_vendor_dependency",
        "provenance_incomplete"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "residual_dependency_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor_dependency_ref",
        "dependency_class",
        "required_for_operation",
        "failure_consequence",
        "mitigation",
        "disclosed"
      ],
      "properties": {
        "vendor_dependency_ref": { "$ref": "#/$defs/ref" },
        "dependency_class": { "$ref": "#/$defs/residual_dependency_class" },
        "required_for_operation": { "type": "boolean" },
        "failure_consequence": { "$ref": "#/$defs/failure_consequence" },
        "mitigation": { "$ref": "#/$defs/mitigation" },
        "disclosed": { "type": "boolean" }
      }
    },
    "deployment_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "surface_label",
        "deployment_scope",
        "operating_mode",
        "tenant_org_ref",
        "region_ref",
        "mirror_offline_posture",
        "last_control_plane_sync_ref",
        "truth_mode",
        "control_plane_state",
        "data_plane_state",
        "local_runtime_impaired",
        "control_plane_impairment_flagged_as_local",
        "local_safe_next_step",
        "open_details_available",
        "export_available"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string", "minLength": 1 },
        "deployment_scope": { "$ref": "#/$defs/deployment_scope" },
        "operating_mode": { "$ref": "#/$defs/deployment_mode" },
        "tenant_org_ref": { "$ref": "#/$defs/ref" },
        "region_ref": { "$ref": "#/$defs/ref" },
        "mirror_offline_posture": { "$ref": "#/$defs/truth_mode" },
        "last_control_plane_sync_ref": { "$ref": "#/$defs/ref" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "control_plane_state": { "$ref": "#/$defs/plane_state" },
        "data_plane_state": { "$ref": "#/$defs/plane_state" },
        "local_runtime_impaired": { "type": "boolean" },
        "control_plane_impairment_flagged_as_local": { "const": false },
        "local_safe_next_step": { "$ref": "#/$defs/local_safe_next_step" },
        "residual_dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/residual_dependency_input" }
        },
        "open_details_available": { "type": "boolean" },
        "export_available": { "type": "boolean" },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_summary_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "deployment_scope",
        "operating_mode",
        "tenant_org_ref",
        "region_ref",
        "mirror_offline_posture",
        "last_control_plane_sync_ref",
        "truth_mode",
        "boundary_honestly_scoped",
        "discloses_scope",
        "open_details_available",
        "export_available"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "deployment_scope": { "$ref": "#/$defs/deployment_scope" },
        "operating_mode": { "$ref": "#/$defs/deployment_mode" },
        "tenant_org_ref": { "$ref": "#/$defs/ref" },
        "region_ref": { "$ref": "#/$defs/ref" },
        "mirror_offline_posture": { "$ref": "#/$defs/truth_mode" },
        "last_control_plane_sync_ref": { "$ref": "#/$defs/ref" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "boundary_honestly_scoped": { "const": true },
        "discloses_scope": { "const": true },
        "open_details_available": { "type": "boolean" },
        "export_available": { "type": "boolean" }
      }
    },
    "resolved_residual_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "vendor_dependency_ref",
        "dependency_class",
        "required_for_operation",
        "failure_consequence",
        "mitigation",
        "disclosed",
        "names_failure_and_path",
        "exportable"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "vendor_dependency_ref": { "$ref": "#/$defs/ref" },
        "dependency_class": { "$ref": "#/$defs/residual_dependency_class" },
        "required_for_operation": { "type": "boolean" },
        "failure_consequence": { "$ref": "#/$defs/failure_consequence" },
        "mitigation": { "$ref": "#/$defs/mitigation" },
        "disclosed": { "const": true },
        "names_failure_and_path": { "const": true },
        "exportable": { "const": true }
      }
    },
    "resolved_status_strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "control_plane_state",
        "data_plane_state",
        "local_runtime_impaired",
        "planes_distinct",
        "control_impairment_not_masked_as_local",
        "local_safe_next_step",
        "local_safe_next_step_visible"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "control_plane_state": { "$ref": "#/$defs/plane_state" },
        "data_plane_state": { "$ref": "#/$defs/plane_state" },
        "local_runtime_impaired": { "type": "boolean" },
        "planes_distinct": { "const": true },
        "control_impairment_not_masked_as_local": { "const": true },
        "local_safe_next_step": { "$ref": "#/$defs/local_safe_next_step" },
        "local_safe_next_step_visible": { "const": true }
      }
    },
    "resolved_deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "summary_card",
        "residual_rows",
        "status_strip",
        "boundary_not_overclaimed",
        "planes_distinguishable",
        "residual_dependency_exportable"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "summary_card": { "$ref": "#/$defs/resolved_summary_card" },
        "residual_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolved_residual_row" }
        },
        "status_strip": { "$ref": "#/$defs/resolved_status_strip" },
        "boundary_not_overclaimed": { "const": true },
        "planes_distinguishable": { "const": true },
        "residual_dependency_exportable": { "const": true },
        "degraded": {
          "oneOf": [{ "$ref": "#/$defs/degraded_state" }, { "type": "null" }]
        }
      }
    },
    "deployment_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/deployment_input" },
        "resolved": { "$ref": "#/$defs/resolved_deployment" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "deployment_scopes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_summaries",
        "overclaims_boundary",
        "masks_control_plane_as_local",
        "hides_residual_dependency",
        "drops_local_safe_step"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "deployment_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_scope" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_summaries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_case" }
        },
        "overclaims_boundary": { "const": false },
        "masks_control_plane_as_local": { "const": false },
        "hides_residual_dependency": { "const": false },
        "drops_local_safe_step": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "deployment_scopes",
        "failure_consequences",
        "mitigations",
        "local_safe_next_steps",
        "export_fields",
        "deployment_modes",
        "truth_modes",
        "residual_dependency_classes",
        "plane_states",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "deployment_scopes": { "type": "array", "items": { "type": "string" } },
        "failure_consequences": { "type": "array", "items": { "type": "string" } },
        "mitigations": { "type": "array", "items": { "type": "string" } },
        "local_safe_next_steps": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "deployment_modes": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "residual_dependency_classes": { "type": "array", "items": { "type": "string" } },
        "plane_states": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "deployment_identity_preserved_across_surfaces",
        "boundary_never_overclaimed",
        "control_plane_distinct_from_local_runtime",
        "residual_dependency_always_explicit_and_exportable",
        "support_export_reconstructs_deployment",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "deployment_identity_preserved_across_surfaces": { "const": true },
        "boundary_never_overclaimed": { "const": true },
        "control_plane_distinct_from_local_runtime": { "const": true },
        "residual_dependency_always_explicit_and_exportable": { "const": true },
        "support_export_reconstructs_deployment": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "status_strip_reads_single_plane_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "deployment_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "status_strip_reads_single_plane_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "deployment_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "deployment_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
