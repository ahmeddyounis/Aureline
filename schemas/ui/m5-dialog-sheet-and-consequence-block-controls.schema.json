{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-dialog-sheet-and-consequence-block-controls.schema.json",
  "title": "Aureline M5 dialog / sheet and consequence-block controls",
  "description": "Export-safe packet for the second implement lane over the frozen M5 decision-feedback component matrix. It carries resolved, honest projections of the dialog / sheet and the consequence block across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved dialog examples (naming the title, the dialog action model with no-generic-yes-no semantics, the state disposition, the surface context, the safe initial focus target, the reopen origin, and the rationale/scope/explicit-actions/cancel-path/focus-return/help-hook truth) and the resolved consequence examples (naming the affected-object label, the consequence disclosure, the state disposition, the surface context, the named blast radius, the reversibility posture, the rollback/help posture, and whether the explanation is reachable off-screenshot). Hard invariants forbid dialogs using generic Yes/No copy in high-risk confirmation, dialogs failing to return focus on reopen, consequence blocks omitting a named blast radius, and consequence blocks reducing to generic Yes/No ambiguity. Acceptance criteria — claimed dialog/sheet consumers expose rationale, scope, and explicit actions consistently; default focus, escape/cancel, and focus return stay stable in keyboard-only, screen-reader, and high-zoom scenarios; and support/help/export packets explain the decision surface and its consequence block without screenshots alone — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_dialog_sheet_and_consequence_block_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "dialog_example": {
      "type": "object",
      "required": [
        "dialog_id",
        "dialog_title",
        "action_model",
        "action_model_is_generic_yes_no",
        "disposition",
        "surface_context",
        "focus_target",
        "reopen_origin",
        "is_reopen",
        "rationale_present",
        "scope_named",
        "actions_explicitly_named",
        "initial_focus_is_safe",
        "cancel_path_present",
        "focus_returns_on_reopen",
        "help_or_docs_hook_present",
        "degrade_reason",
        "next_action",
        "names_rationale_scope_and_explicit_actions"
      ],
      "properties": {
        "dialog_id": { "$ref": "#/$defs/non_empty_string" },
        "dialog_title": { "type": "string" },
        "action_model": { "$ref": "#/$defs/non_empty_string" },
        "action_model_is_generic_yes_no": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "focus_target": { "$ref": "#/$defs/non_empty_string" },
        "reopen_origin": { "$ref": "#/$defs/non_empty_string" },
        "is_reopen": { "type": "boolean" },
        "rationale_present": { "type": "boolean" },
        "scope_named": { "type": "boolean" },
        "actions_explicitly_named": { "type": "boolean" },
        "initial_focus_is_safe": { "type": "boolean" },
        "cancel_path_present": { "type": "boolean" },
        "focus_returns_on_reopen": { "type": "boolean" },
        "help_or_docs_hook_present": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "names_rationale_scope_and_explicit_actions": { "type": "boolean" }
      }
    },
    "consequence_example": {
      "type": "object",
      "required": [
        "consequence_id",
        "consequence_label",
        "disclosure",
        "disclosure_is_disallowed",
        "disposition",
        "surface_context",
        "blast_radius",
        "blast_radius_is_broad",
        "reversibility",
        "needs_partial_or_irreversible_note",
        "affected_object_named",
        "blast_radius_named",
        "rollback_or_help_posture_stated",
        "partial_or_irreversible_noted",
        "avoids_generic_yes_no",
        "explanation_reachable_by_keyboard_sr_export",
        "degrade_reason",
        "next_action",
        "names_blast_radius_and_rollback_posture"
      ],
      "properties": {
        "consequence_id": { "$ref": "#/$defs/non_empty_string" },
        "consequence_label": { "type": "string" },
        "disclosure": { "$ref": "#/$defs/non_empty_string" },
        "disclosure_is_disallowed": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "blast_radius": { "$ref": "#/$defs/non_empty_string" },
        "blast_radius_is_broad": { "type": "boolean" },
        "reversibility": { "$ref": "#/$defs/non_empty_string" },
        "needs_partial_or_irreversible_note": { "type": "boolean" },
        "affected_object_named": { "type": "boolean" },
        "blast_radius_named": { "type": "boolean" },
        "rollback_or_help_posture_stated": { "type": "boolean" },
        "partial_or_irreversible_noted": { "type": "boolean" },
        "avoids_generic_yes_no": { "type": "boolean" },
        "explanation_reachable_by_keyboard_sr_export": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "names_blast_radius_and_rollback_posture": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "dialog_examples",
        "consequence_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "dialog_uses_generic_yes_no_in_high_risk",
        "dialog_focus_fails_to_return_on_reopen",
        "consequence_omits_named_blast_radius",
        "consequence_reduces_to_generic_yes_no"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "dialog_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dialog_example" }
        },
        "consequence_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consequence_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "dialog_uses_generic_yes_no_in_high_risk": { "const": false },
        "dialog_focus_fails_to_return_on_reopen": { "const": false },
        "consequence_omits_named_blast_radius": { "const": false },
        "consequence_reduces_to_generic_yes_no": { "const": false }
      }
    }
  }
}
