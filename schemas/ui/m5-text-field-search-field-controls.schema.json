{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-text-field-search-field-controls.schema.json",
  "title": "Aureline M5 text-field and search-field controls",
  "description": "Export-safe packet for the text-entry and search-entry implement lane over the frozen M5 core-action-input component matrix. It carries resolved, honest projections of the text field and the search field across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved text-field examples (naming the permanent label, label mode, validation state with specific copy when flagging, interaction disposition, surface context, focus-visible treatment, reveal requirement, draft continuity, and validation anchor) and the resolved search-field examples (naming the permanent label, label mode, validation state, disposition, surface context, search icon, clear affordance, submit model, scope, retention posture, and privacy disclosure). Hard invariants forbid placeholder text replacing the permanent label, vague validation copy on a flagging field, dropping clear/submit/privacy truth on a search field, and locked/read-only/degraded semantics hiding behind generic disabled chrome. Acceptance criteria — no field relies on placeholder-only labeling or vague validation copy, search consumers expose clear/submit/privacy/blocked truth across local/provider-backed/export-sensitive surfaces, and draft state survives the first interruption/recovery without losing source or validation context — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_text_field_and_search_field_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "text_field_example": {
      "type": "object",
      "required": [
        "text_field_id",
        "label",
        "label_mode",
        "label_is_permanent",
        "validation",
        "validation_is_flagging",
        "validation_message_specific",
        "disposition",
        "disposition_requires_distinct_treatment",
        "surface_context",
        "focus_visible_offered",
        "requires_reveal",
        "reveal_offered",
        "blocked_state_distinct",
        "draft_preserved_across_interruption",
        "validation_anchor_preserved",
        "command_id",
        "command_route_available",
        "degrade_reason",
        "next_action",
        "label_and_validation_honest_at_a_glance"
      ],
      "properties": {
        "text_field_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "type": "string" },
        "label_mode": { "$ref": "#/$defs/non_empty_string" },
        "label_is_permanent": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/non_empty_string" },
        "validation_is_flagging": { "type": "boolean" },
        "validation_message_specific": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "disposition_requires_distinct_treatment": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "focus_visible_offered": { "type": "boolean" },
        "requires_reveal": { "type": "boolean" },
        "reveal_offered": { "type": "boolean" },
        "blocked_state_distinct": { "type": "boolean" },
        "draft_preserved_across_interruption": { "type": "boolean" },
        "validation_anchor_preserved": { "type": "boolean" },
        "command_id": { "type": "string" },
        "command_route_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "label_and_validation_honest_at_a_glance": { "type": "boolean" }
      }
    },
    "search_field_example": {
      "type": "object",
      "required": [
        "search_field_id",
        "label",
        "label_mode",
        "label_is_permanent",
        "validation",
        "validation_is_flagging",
        "validation_message_specific",
        "disposition",
        "disposition_requires_distinct_treatment",
        "surface_context",
        "offers_search_icon",
        "offers_clear",
        "submit_model",
        "submit_model_resolved",
        "submit_is_blocked",
        "scope_label",
        "retention_posture",
        "retention_needs_disclosure",
        "privacy_disclosed",
        "blocked_state_distinct",
        "draft_preserved_across_interruption",
        "command_id",
        "command_route_available",
        "degrade_reason",
        "next_action",
        "clear_submit_privacy_honest_at_a_glance"
      ],
      "properties": {
        "search_field_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "type": "string" },
        "label_mode": { "$ref": "#/$defs/non_empty_string" },
        "label_is_permanent": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/non_empty_string" },
        "validation_is_flagging": { "type": "boolean" },
        "validation_message_specific": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "disposition_requires_distinct_treatment": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "offers_search_icon": { "type": "boolean" },
        "offers_clear": { "type": "boolean" },
        "submit_model": { "$ref": "#/$defs/non_empty_string" },
        "submit_model_resolved": { "type": "boolean" },
        "submit_is_blocked": { "type": "boolean" },
        "scope_label": { "type": "string" },
        "retention_posture": { "$ref": "#/$defs/non_empty_string" },
        "retention_needs_disclosure": { "type": "boolean" },
        "privacy_disclosed": { "type": "boolean" },
        "blocked_state_distinct": { "type": "boolean" },
        "draft_preserved_across_interruption": { "type": "boolean" },
        "command_id": { "type": "string" },
        "command_route_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "clear_submit_privacy_honest_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "text_field_examples",
        "search_field_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "placeholder_text_replaces_label",
        "vague_validation_copy_used",
        "clear_submit_or_privacy_truth_dropped",
        "locked_or_degraded_semantics_hidden_behind_disabled"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "text_field_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text_field_example" }
        },
        "search_field_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/search_field_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "placeholder_text_replaces_label": { "const": false },
        "vague_validation_copy_used": { "const": false },
        "clear_submit_or_privacy_truth_dropped": { "const": false },
        "locked_or_degraded_semantics_hidden_behind_disabled": { "const": false }
      }
    }
  }
}
