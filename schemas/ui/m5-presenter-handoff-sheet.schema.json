{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-presenter-handoff-sheet.schema.json",
  "title": "Aureline M5 presenter-handoff sheet",
  "description": "Canonical per-domain descriptor for one presenter / moderator token and its handoff. Names the current presenter holder, the handoff target, the moderation scope, and the token expiry / reclaim path so no two presenters drive one sensitive surface at once. Raw secrets and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "collaboration_control_association",
    "presenter_holder",
    "handoff_target",
    "session_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "presenter_token"
      ]
    },
    "collaboration_control_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "presenter_holder": {
      "$ref": "#/$defs/non_empty_string"
    },
    "handoff_target": {
      "$ref": "#/$defs/non_empty_string"
    },
    "moderation_scope": {
      "$ref": "#/$defs/non_empty_string"
    },
    "token_expiry_and_reclaim": {
      "type": "object"
    },
    "session_state": {
      "$ref": "#/$defs/session_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "session_state": {
      "enum": [
        "viewer",
        "commenter",
        "editor",
        "driver",
        "navigator",
        "presenter_moderator",
        "live_only",
        "metadata_audit",
        "replayable_text_comment_timeline",
        "elevated_support_evidence",
        "control_requested",
        "control_granted",
        "control_expired",
        "recording_active",
        "consent_renewal_required",
        "restore_view_only"
      ]
    }
  }
}
