{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-variable-resolution-inspector.schema.json",
  "title": "Aureline M5 variable resolution inspector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "inspector_id",
    "request_identity_ref",
    "variable_name",
    "source_layers",
    "effective_source_layer",
    "effective_value_state",
    "effective_redacted_preview",
    "override_scope",
    "export_scope",
    "auth_storage_mode",
    "execution_origin",
    "freshness_state",
    "raw_secret_exposed",
    "source_refs",
    "consumer_surfaces",
    "copy_export",
    "reduced_capability_banner",
    "provider_handoff_notes"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_variable_resolution_inspector"
    },
    "schema_version": {
      "const": 1
    },
    "inspector_id": {
      "$ref": "#/$defs/id"
    },
    "request_identity_ref": {
      "$ref": "#/$defs/ref"
    },
    "variable_name": {
      "$ref": "#/$defs/ref"
    },
    "source_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "source_ref",
          "resolution_state",
          "value_state",
          "redacted_preview",
          "override_scope",
          "export_scope",
          "precedence_rank"
        ],
        "properties": {
          "layer": {
            "type": "string",
            "enum": [
              "workspace",
              "profile",
              "collection",
              "request_document",
              "runtime_override",
              "secret_broker",
              "managed_policy",
              "browser_runtime",
              "imported_snapshot",
              "default_value"
            ]
          },
          "source_ref": {
            "$ref": "#/$defs/ref"
          },
          "resolution_state": {
            "$ref": "#/$defs/resolution_state"
          },
          "value_state": {
            "type": "string",
            "enum": [
              "resolved_plain",
              "resolved_redacted",
              "secret_handle",
              "missing",
              "policy_hidden",
              "shadowed"
            ]
          },
          "redacted_preview": {
            "$ref": "#/$defs/redacted_preview"
          },
          "override_scope": {
            "$ref": "#/$defs/override_scope"
          },
          "export_scope": {
            "$ref": "#/$defs/export_scope"
          },
          "precedence_rank": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "effective_source_layer": {
      "type": "string",
      "enum": [
        "workspace",
        "profile",
        "collection",
        "request_document",
        "runtime_override",
        "secret_broker",
        "managed_policy",
        "browser_runtime",
        "imported_snapshot",
        "default_value"
      ]
    },
    "effective_value_state": {
      "type": "string",
      "enum": [
        "resolved_plain",
        "resolved_redacted",
        "secret_handle",
        "missing",
        "policy_hidden"
      ]
    },
    "effective_redacted_preview": {
      "$ref": "#/$defs/redacted_preview"
    },
    "override_scope": {
      "$ref": "#/$defs/override_scope"
    },
    "export_scope": {
      "$ref": "#/$defs/export_scope"
    },
    "auth_storage_mode": {
      "$ref": "#/$defs/auth_storage_mode"
    },
    "execution_origin": {
      "$ref": "#/$defs/origin"
    },
    "freshness_state": {
      "$ref": "#/$defs/freshness_state"
    },
    "raw_secret_exposed": {
      "const": false
    },
    "redaction_review_state": {
      "$ref": "#/$defs/redaction_review_state"
    },
    "source_refs": {
      "$ref": "#/$defs/ref_array"
    },
    "consumer_surfaces": {
      "$ref": "#/$defs/consumer_surfaces"
    },
    "copy_export": {
      "$ref": "#/$defs/copy_export"
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banner_id",
        "severity",
        "capability_state",
        "visible_label",
        "missing_capabilities",
        "preserved_fields",
        "action_policy"
      ],
      "properties": {
        "banner_id": {
          "$ref": "#/$defs/ref"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocked"
          ]
        },
        "capability_state": {
          "type": "string",
          "enum": [
            "read_only",
            "write_capable",
            "inspect_only",
            "mutation_review_required",
            "policy_blocked",
            "unavailable"
          ]
        },
        "visible_label": {
          "$ref": "#/$defs/ref"
        },
        "missing_capabilities": {
          "$ref": "#/$defs/ref_array"
        },
        "preserved_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "action_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_send_available",
            "replay_available",
            "mutate_available",
            "export_available"
          ],
          "properties": {
            "live_send_available": {
              "type": "boolean"
            },
            "replay_available": {
              "type": "boolean"
            },
            "mutate_available": {
              "type": "boolean"
            },
            "export_available": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provider_handoff_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note_id",
          "provider_surface",
          "handoff_state",
          "truth_preserved",
          "return_anchor_ref",
          "raw_material_exported"
        ],
        "properties": {
          "note_id": {
            "$ref": "#/$defs/ref"
          },
          "provider_surface": {
            "type": "string",
            "enum": [
              "desktop_request_workspace",
              "desktop_database_tool",
              "remote_workspace",
              "container_workspace",
              "managed_workspace",
              "browser_runtime_panel",
              "notebook_handoff",
              "chart_handoff",
              "ai_context_handoff",
              "cli_headless",
              "support_export",
              "release_proof"
            ]
          },
          "handoff_state": {
            "$ref": "#/$defs/ref"
          },
          "truth_preserved": {
            "$ref": "#/$defs/ref_array"
          },
          "return_anchor_ref": {
            "$ref": "#/$defs/ref"
          },
          "raw_material_exported": {
            "const": false
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "origin": {
      "type": "string",
      "enum": [
        "local_desktop",
        "ssh_remote",
        "container_workspace",
        "managed_workspace",
        "browser_runtime",
        "imported_snapshot",
        "cli_headless"
      ]
    },
    "auth_storage_mode": {
      "type": "string",
      "enum": [
        "no_auth",
        "secret_broker_handle",
        "delegated_identity",
        "policy_injected",
        "browser_device_code",
        "local_encrypted_store",
        "managed_rotation",
        "imported_no_live_auth",
        "policy_blocked"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "live",
        "current",
        "warm_cached",
        "cached",
        "imported",
        "stale",
        "superseded",
        "partial",
        "expired",
        "policy_limited",
        "unknown"
      ]
    },
    "redaction_review_state": {
      "type": "string",
      "enum": [
        "not_required",
        "required_before_export",
        "completed",
        "blocked_by_policy"
      ]
    },
    "resolution_state": {
      "type": "string",
      "enum": [
        "resolved",
        "unresolved",
        "shadowed",
        "policy_hidden",
        "secret_handle"
      ]
    },
    "override_scope": {
      "type": "string",
      "enum": [
        "not_overridable",
        "request_only",
        "workspace_profile",
        "runtime_session",
        "managed_policy_only"
      ]
    },
    "export_scope": {
      "type": "string",
      "enum": [
        "metadata_only",
        "redacted_preview",
        "secret_handle_ref",
        "blocked_by_policy",
        "not_exported"
      ]
    },
    "redacted_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_state",
        "display"
      ],
      "properties": {
        "preview_state": {
          "type": "string",
          "enum": [
            "safe_redacted",
            "withheld_secret",
            "unresolved",
            "policy_hidden",
            "not_applicable"
          ]
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "desktop_request_workspace",
          "desktop_database_tool",
          "remote_workspace",
          "container_workspace",
          "managed_workspace",
          "browser_runtime_panel",
          "notebook_handoff",
          "chart_handoff",
          "ai_context_handoff",
          "cli_headless",
          "support_export",
          "release_proof"
        ]
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "export_fields",
        "text",
        "json",
        "markdown",
        "screenshot_only_prohibited"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "json",
              "markdown"
            ]
          }
        },
        "export_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "text": {
          "$ref": "#/$defs/ref"
        },
        "json": {
          "$ref": "#/$defs/ref"
        },
        "markdown": {
          "$ref": "#/$defs/ref"
        },
        "screenshot_only_prohibited": {
          "const": true
        }
      }
    }
  }
}
