{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-route-endpoint-row.schema.json",
  "title": "Aureline M5 route or endpoint row",
  "description": "Per-component contract for a route or endpoint row: the reusable component that names a route or endpoint, how it is known, and whether it is authored or generated. Binds the one controlled certainty vocabulary plus the route evidence class and route authorship. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape. A heuristic route never masquerades as an exact one and the authored-versus-generated boundary is always explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "identity_label",
    "state_label",
    "keyboard_route_label",
    "certainty",
    "route_evidence_class",
    "route_authorship"
  ],
  "properties": {
    "component_family": {
      "const": "route_endpoint_row"
    },
    "identity_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "state_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certainty": {
      "$ref": "#/$defs/certainty_disposition"
    },
    "route_evidence_class": {
      "$ref": "#/$defs/route_evidence_class"
    },
    "route_authorship": {
      "$ref": "#/$defs/route_authorship"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "route_evidence_class": {
      "enum": [
        "exact_from_source",
        "heuristic_convention",
        "runtime_confirmed",
        "derived_by_convention",
        "partial_evidence",
        "unresolved"
      ]
    },
    "route_authorship": {
      "enum": [
        "authored",
        "generated",
        "generated_then_edited",
        "framework_provided",
        "runtime_only",
        "unknown_origin"
      ]
    }
  }
}
