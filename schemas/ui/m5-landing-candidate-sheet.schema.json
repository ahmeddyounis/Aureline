{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-landing-candidate-sheet.schema.json",
  "title": "Aureline M5 landing-candidate sheet",
  "description": "Canonical per-domain descriptor for the reviewed landing candidate. Names the landing target, validation freshness, the protected-branch gate, and the rollback / export fallback so a land never happens from ambient branch state without a reviewed candidate and validation freshness is never assumed. Raw paths, raw provider payloads, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "change_orchestration_association",
    "landing_target",
    "validation_freshness",
    "landing_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "landing_candidate_sheet"
      ]
    },
    "change_orchestration_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "landing_target": {
      "type": "string",
      "minLength": 1
    },
    "validation_freshness": {
      "type": "string",
      "minLength": 1
    },
    "protected_branch_gate": {
      "type": "boolean"
    },
    "landing_state": {
      "enum": [
        "selected_change",
        "stale_validation",
        "restack_required",
        "queue_eligible",
        "queue_blocked",
        "protected_branch_blocked",
        "orphaned",
        "abandoned",
        "exported",
        "imported_reopened"
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
