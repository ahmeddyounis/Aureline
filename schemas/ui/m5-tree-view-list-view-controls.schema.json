{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-tree-view-list-view-controls.schema.json",
  "title": "Aureline M5 tree-view and list-view controls",
  "description": "Export-safe packet for the dense-collection implement lane over the frozen M5 navigation / content component matrix. It carries resolved, honest projections of the tree view and the list view across the claimed M5 explorer, search, review-queue, provider, help, and support surfaces. Each controls row binds a consumer surface to the resolved tree-view examples (naming the disclosure state with virtualization honest, the selection-versus-current distinction and row focus, the per-row item state, the exact/loaded/all-matching/hidden-by-filter/hidden-by-policy/outside-current-scope count scope, the density variant, the local-action budget, the drag/reorder posture, and the cross-window/cross-pane continuity posture) and the resolved list-view examples (the same row semantics minus disclosure, plus a loaded-versus-exact virtualization truth). Hard invariants forbid hiding the current selection, a blocked row, or the local actions behind pointer hover, collapsing selection-versus-current or the exact/loaded/all-matching count scopes, presenting a stale, partial, or lazily-unloaded collection as complete, and overclaiming drag/reorder or cross-surface continuity. Acceptance criteria — tree/list consumers reuse the same row semantics and scope vocabulary, deep nesting and stale or partial backends preserve selection and disclosure truth rather than faking a complete tree, and no surface requires pointer hover to discover the current selection, blocked state, or available local actions — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_tree_view_and_list_view_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "tree_view_example": {
      "type": "object",
      "required": [
        "tree_id",
        "node_label",
        "disclosure",
        "lazy_subtree_shown_as_leaf",
        "selection",
        "selection_versus_current_distinct",
        "row_focus_visible",
        "current_selection_hover_only",
        "item_state",
        "has_blocked_row",
        "blocked_state_hover_only",
        "count_scope",
        "count_scope_hidden_or_outside",
        "count_scopes_distinct",
        "density",
        "local_action_budget",
        "local_actions_hover_only",
        "drag_reorder",
        "drag_reorder_permitted",
        "overclaims_drag_reorder",
        "cross_surface_continuity",
        "continuity_continuous",
        "overclaims_cross_surface_continuity",
        "backend_stale_or_partial",
        "presents_stale_or_partial_as_complete",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "structure_legible_at_a_glance"
      ],
      "properties": {
        "tree_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "type": "string" },
        "disclosure": { "$ref": "#/$defs/non_empty_string" },
        "lazy_subtree_shown_as_leaf": { "type": "boolean" },
        "selection": { "$ref": "#/$defs/non_empty_string" },
        "selection_versus_current_distinct": { "type": "boolean" },
        "row_focus_visible": { "type": "boolean" },
        "current_selection_hover_only": { "type": "boolean" },
        "item_state": { "$ref": "#/$defs/non_empty_string" },
        "has_blocked_row": { "type": "boolean" },
        "blocked_state_hover_only": { "type": "boolean" },
        "count_scope": { "$ref": "#/$defs/non_empty_string" },
        "count_scope_hidden_or_outside": { "type": "boolean" },
        "count_scopes_distinct": { "type": "boolean" },
        "density": { "$ref": "#/$defs/non_empty_string" },
        "local_action_budget": { "$ref": "#/$defs/non_empty_string" },
        "local_actions_hover_only": { "type": "boolean" },
        "drag_reorder": { "$ref": "#/$defs/non_empty_string" },
        "drag_reorder_permitted": { "type": "boolean" },
        "overclaims_drag_reorder": { "type": "boolean" },
        "cross_surface_continuity": { "$ref": "#/$defs/non_empty_string" },
        "continuity_continuous": { "type": "boolean" },
        "overclaims_cross_surface_continuity": { "type": "boolean" },
        "backend_stale_or_partial": { "type": "boolean" },
        "presents_stale_or_partial_as_complete": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "structure_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "list_view_example": {
      "type": "object",
      "required": [
        "list_id",
        "row_label",
        "selection",
        "selection_versus_current_distinct",
        "row_focus_visible",
        "current_selection_hover_only",
        "item_state",
        "has_blocked_row",
        "blocked_state_hover_only",
        "count_scope",
        "count_scope_hidden_or_outside",
        "count_scopes_distinct",
        "loaded_shown_as_exact",
        "density",
        "local_action_budget",
        "local_actions_hover_only",
        "drag_reorder",
        "drag_reorder_permitted",
        "overclaims_drag_reorder",
        "cross_surface_continuity",
        "continuity_continuous",
        "overclaims_cross_surface_continuity",
        "backend_stale_or_partial",
        "presents_stale_or_partial_as_complete",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "structure_legible_at_a_glance"
      ],
      "properties": {
        "list_id": { "$ref": "#/$defs/non_empty_string" },
        "row_label": { "type": "string" },
        "selection": { "$ref": "#/$defs/non_empty_string" },
        "selection_versus_current_distinct": { "type": "boolean" },
        "row_focus_visible": { "type": "boolean" },
        "current_selection_hover_only": { "type": "boolean" },
        "item_state": { "$ref": "#/$defs/non_empty_string" },
        "has_blocked_row": { "type": "boolean" },
        "blocked_state_hover_only": { "type": "boolean" },
        "count_scope": { "$ref": "#/$defs/non_empty_string" },
        "count_scope_hidden_or_outside": { "type": "boolean" },
        "count_scopes_distinct": { "type": "boolean" },
        "loaded_shown_as_exact": { "type": "boolean" },
        "density": { "$ref": "#/$defs/non_empty_string" },
        "local_action_budget": { "$ref": "#/$defs/non_empty_string" },
        "local_actions_hover_only": { "type": "boolean" },
        "drag_reorder": { "$ref": "#/$defs/non_empty_string" },
        "drag_reorder_permitted": { "type": "boolean" },
        "overclaims_drag_reorder": { "type": "boolean" },
        "cross_surface_continuity": { "$ref": "#/$defs/non_empty_string" },
        "continuity_continuous": { "type": "boolean" },
        "overclaims_cross_surface_continuity": { "type": "boolean" },
        "backend_stale_or_partial": { "type": "boolean" },
        "presents_stale_or_partial_as_complete": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "structure_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "tree_view_examples",
        "list_view_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_current_selection_blocked_or_actions_behind_hover_only",
        "collapses_selection_versus_current_or_count_scopes",
        "presents_stale_partial_or_lazy_collection_as_complete",
        "overclaims_drag_reorder_or_cross_surface_continuity"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "tree_view_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tree_view_example" }
        },
        "list_view_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/list_view_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_current_selection_blocked_or_actions_behind_hover_only": { "const": false },
        "collapses_selection_versus_current_or_count_scopes": { "const": false },
        "presents_stale_partial_or_lazy_collection_as_complete": { "const": false },
        "overclaims_drag_reorder_or_cross_surface_continuity": { "const": false }
      }
    }
  }
}
