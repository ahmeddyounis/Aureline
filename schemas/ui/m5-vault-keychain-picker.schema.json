{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-vault-keychain-picker.schema.json",
  "title": "Aureline M5 vault-or-keychain picker component",
  "description": "Names the storage mode a secret will be written to and the store's capability \u2014 so a user always sees where a secret will land and what that store can and cannot guarantee before it is written. Canonical per-component contract frozen by the M5 credential component matrix (schemas/ui/m5-credential-component-matrix.schema.json); downstream M5 rows point at this schema instead of restating credential UI truth by hand. Raw secret values, tokens, passphrases, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "storage_mode",
    "store_capability",
    "degraded_state",
    "required_labels"
  ],
  "properties": {
    "component_family": {
      "const": "vault_or_keychain_picker"
    },
    "storage_mode": {
      "enum": [
        "os_keychain",
        "encrypted_vault",
        "secret_broker_handle",
        "session_memory_only",
        "external_reference",
        "no_secret_stored"
      ]
    },
    "store_capability": {
      "enum": [
        "persist_across_restart",
        "os_locked_at_rest",
        "sync_across_devices",
        "hardware_backed",
        "store_export_blocked",
        "session_only"
      ]
    },
    "degraded_state": {
      "enum": [
        "fully_available",
        "limited_capability",
        "stale_needs_reauth",
        "offline_cached",
        "policy_blocked",
        "unavailable"
      ]
    },
    "required_labels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "state",
          "keyboard_route",
          "storage_and_reveal_posture",
          "identity_and_delegation",
          "expiry_and_export_boundary"
        ]
      }
    }
  }
}
