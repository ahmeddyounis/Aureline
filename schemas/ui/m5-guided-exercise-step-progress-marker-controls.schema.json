{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-guided-exercise-step-progress-marker-controls.schema.json",
  "title": "Aureline M5 guided exercise steps and progress markers",
  "description": "Export-safe packet implementing the reusable M5 guided-exercise-step and progress-marker components in two co-equal control vectors. Each guided exercise step identifies exactly what to act on (its target object) and what counts as success (observable success criteria), offers hint/reveal/reset/skip actions, and declares a sandbox-or-preview preference for a mutating lesson; its progress class is derived from the exercise step state, so a failed-retryable step can never read as passed. Each progress marker shows completed/remaining state and offers resume/reset/export actions; its standing is derived from the progress state, so a paused or reset marker can never read as complete, and progress stays user-owned and default-local, never silently shared beyond the supported scope. No control masks privacy or offline/local-only state, hides success criteria or target identity, implies a hidden apply or mutation, invents an alternate state label, or traps progress without a reset/resume/export route; raw docs bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "exercise_steps",
    "progress_markers",
    "downgrade_triggers",
    "consumer_surfaces",
    "learnability_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_guided_exercise_steps_and_progress_markers_with_target_object_success_criteria_hint_reveal_reset_skip_sandbox_or_preview_preference_and_privacy_bounded_resume_reset_export_truth_across_claimed_m5_learnability_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "exercise_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/guided_exercise_step" }
    },
    "progress_markers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/progress_marker" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "learnability_review": { "$ref": "#/$defs/learnability_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "exercise_step_state": {
      "enum": ["not_started", "active", "passed", "failed_retryable", "replayable", "sandboxed"]
    },
    "validation_mode": {
      "enum": [
        "command_backed",
        "sandboxed_practice",
        "read_only_walkthrough",
        "checkpoint_gated",
        "self_paced",
        "no_hidden_apply"
      ]
    },
    "progress_class": {
      "enum": ["pending", "in_progress", "completed", "retryable", "sandbox_practice"]
    },
    "mutation_preference": {
      "enum": [
        "sandbox_practice",
        "preview_then_apply",
        "read_only_walkthrough",
        "no_mutation_needed"
      ]
    },
    "progress_state": {
      "enum": ["not_started", "in_progress", "completed", "paused", "reset", "offline_local"]
    },
    "ownership_class": {
      "enum": [
        "local_only",
        "user_owned_synced",
        "exported_by_choice",
        "workspace_shared",
        "cached_snapshot",
        "not_installed"
      ]
    },
    "standing_class": {
      "enum": ["unstarted", "underway", "complete", "interrupted", "offline_cached"]
    },
    "deep_link_kind": {
      "enum": ["command_reference", "file_location", "surface_location", "docs_anchor", "no_deep_link"]
    },
    "step_action": {
      "enum": [
        "show_hint",
        "reveal_solution",
        "reset_step",
        "skip_step",
        "check_success",
        "open_target_object"
      ]
    },
    "marker_action": {
      "enum": [
        "resume_progress",
        "reset_progress",
        "export_progress",
        "view_remaining",
        "share_to_workspace",
        "open_resume_point"
      ]
    },
    "disposition": {
      "enum": [
        "learning_on",
        "paused",
        "replayable",
        "sandboxed",
        "cached",
        "local_only",
        "not_installed",
        "no_hidden_apply"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "citation_source",
        "explain_versus_do_boundary",
        "progress_ownership_and_privacy"
      ]
    },
    "surface_family": {
      "enum": [
        "first_run_onboarding",
        "guided_tour",
        "learning_mode_panel",
        "glossary_surface",
        "inline_help",
        "cli_help"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "onboarding_ui",
        "tour_overlay_ui",
        "learning_panel_ui",
        "glossary_ui",
        "exercise_ui",
        "help_panel_ui",
        "cli_help",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "learning_mode_state_unstated",
        "tip_command_binding_unstated",
        "exercise_step_state_unstated",
        "glossary_citation_severed",
        "explanation_apply_boundary_unstated",
        "progress_ownership_unstated",
        "offline_or_local_only_state_hidden",
        "sandbox_boundary_unstated",
        "cached_state_hidden",
        "not_installed_state_hidden",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "guided_exercise_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "step_id",
        "step_label",
        "step_state",
        "validation_mode",
        "progress_class",
        "claims_completed",
        "retry_note",
        "sandbox_note",
        "target_kind",
        "target_ref",
        "target_object_label",
        "success_criteria",
        "mutates_state",
        "mutation_preference",
        "step_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_privacy_or_offline_state",
        "hides_success_criteria_or_target_identity",
        "implies_hidden_apply_or_mutation",
        "invents_alternate_state_label",
        "traps_progress_without_resume_reset_export"
      ],
      "properties": {
        "component": { "const": "guided_exercise_step" },
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "step_label": { "$ref": "#/$defs/non_empty_string" },
        "step_state": { "$ref": "#/$defs/exercise_step_state" },
        "validation_mode": { "$ref": "#/$defs/validation_mode" },
        "progress_class": { "$ref": "#/$defs/progress_class" },
        "claims_completed": { "type": "boolean" },
        "retry_note": { "type": "string" },
        "sandbox_note": { "type": "string" },
        "target_kind": { "$ref": "#/$defs/deep_link_kind" },
        "target_ref": { "type": "string" },
        "target_object_label": { "$ref": "#/$defs/non_empty_string" },
        "success_criteria": { "$ref": "#/$defs/non_empty_string" },
        "mutates_state": { "type": "boolean" },
        "mutation_preference": { "$ref": "#/$defs/mutation_preference" },
        "step_actions": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "reset_step" },
          "items": { "$ref": "#/$defs/step_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_privacy_or_offline_state": { "const": false },
        "hides_success_criteria_or_target_identity": { "const": false },
        "implies_hidden_apply_or_mutation": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "traps_progress_without_resume_reset_export": { "const": false }
      }
    },
    "progress_marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "marker_id",
        "marker_label",
        "progress_state",
        "ownership",
        "standing_class",
        "claims_complete",
        "completed_units",
        "total_units",
        "interrupted_note",
        "offline_note",
        "ownership_and_privacy_note",
        "shares_beyond_local_scope",
        "sharing_disclosure_note",
        "resume_export_kind",
        "resume_export_ref",
        "marker_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_privacy_or_offline_state",
        "hides_success_criteria_or_target_identity",
        "implies_hidden_apply_or_mutation",
        "invents_alternate_state_label",
        "traps_progress_without_resume_reset_export"
      ],
      "properties": {
        "component": { "const": "progress_marker" },
        "marker_id": { "$ref": "#/$defs/non_empty_string" },
        "marker_label": { "$ref": "#/$defs/non_empty_string" },
        "progress_state": { "$ref": "#/$defs/progress_state" },
        "ownership": { "$ref": "#/$defs/ownership_class" },
        "standing_class": { "$ref": "#/$defs/standing_class" },
        "claims_complete": { "type": "boolean" },
        "completed_units": { "type": "integer", "minimum": 0 },
        "total_units": { "type": "integer", "minimum": 0 },
        "interrupted_note": { "type": "string" },
        "offline_note": { "type": "string" },
        "ownership_and_privacy_note": { "$ref": "#/$defs/non_empty_string" },
        "shares_beyond_local_scope": { "type": "boolean" },
        "sharing_disclosure_note": { "type": "string" },
        "resume_export_kind": { "$ref": "#/$defs/deep_link_kind" },
        "resume_export_ref": { "type": "string" },
        "marker_actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/marker_action" },
          "allOf": [
            { "contains": { "const": "resume_progress" } },
            { "contains": { "const": "reset_progress" } },
            { "contains": { "const": "export_progress" } }
          ]
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_privacy_or_offline_state": { "const": false },
        "hides_success_criteria_or_target_identity": { "const": false },
        "implies_hidden_apply_or_mutation": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "traps_progress_without_resume_reset_export": { "const": false }
      }
    },
    "learnability_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise_identifies_target_object",
        "exercise_names_observable_success_criteria",
        "exercise_offers_hint_reveal_reset_skip",
        "mutating_lesson_uses_sandbox_or_preview",
        "step_progress_derived_never_asserted",
        "retryable_never_shown_as_passed",
        "progress_shows_completed_and_remaining",
        "progress_offers_resume_reset_export",
        "completion_derived_never_asserted",
        "incomplete_never_shown_as_complete",
        "progress_user_owned_and_default_local",
        "progress_never_shared_beyond_supported_scope",
        "no_control_widens_trust_or_mutating_authority",
        "no_irreversible_trap_without_reset_or_resume",
        "cached_offline_local_only_state_visible",
        "no_surface_invents_alternate_state_label",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise_ui_reads_single_source",
        "progress_ui_reads_single_source",
        "target_and_success_visible_before_start",
        "completed_and_remaining_visible_before_tap",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
