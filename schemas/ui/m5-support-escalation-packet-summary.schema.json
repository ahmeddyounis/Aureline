{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-escalation-packet-summary.schema.json",
  "title": "Aureline M5 escalation-packet-summary / handoff-timeline-row primitive",
  "description": "Export-safe packet implementing the reusable M5 escalation-packet summary and handoff-timeline row as one twin-resolver primitive. The packet binds one row per claimed support / escalation consumer — support-center escalation desk, recovery-center handoff, Doctor handoff timeline, headless/CLI escalation, and support-packet export — to the shared escalation-summary and handoff-row anatomy. The escalation summary carries the packet id, scenario code, related finding families, opaque evidence ids, repair attempts, redaction posture, build/profile identity, destination class, case disposition, the derived summary posture (escalation-blocked/lineage-incomplete/redaction-review-required/local-only-ready/ready-to-escalate), and bounded reveal-lineage/review-redaction/confirm/cancel/export actions. The handoff row carries the event identity, handoff stage, owner at the time, current owner, related evidence, next expected human step, the derived row posture (awaiting-human/ownership-transferred/repair-underway/case-assembling/local-diagnosis), and bounded reveal-lineage/view-next-step/contact-current-owner/export actions. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving both resolvers, and four hard invariants: it never masks the scenario or finding lineage, never hides the packet destination, never drops the next human step, and never collapses the case lineage into one opaque blob. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_escalation_packet_summaries_and_handoff_timeline_rows_with_packet_id_scenario_code_finding_repair_lineage_owner_destination_and_next_step_truth_across_claimed_m5_support_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "support_case_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "support_case_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "escalation_anatomy_parts",
        "handoff_anatomy_parts",
        "scenario_families",
        "finding_families",
        "destinations",
        "redaction_states",
        "handoff_stages",
        "next_human_steps",
        "approved_repair_classes",
        "case_dispositions",
        "summary_postures",
        "summary_actions",
        "row_postures",
        "row_actions",
        "summary_export_fields",
        "row_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "escalation_examples",
        "handoff_examples",
        "masks_scenario_or_finding_lineage",
        "hides_packet_destination",
        "drops_next_human_step",
        "collapses_case_into_blob"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "support_center_escalation_desk",
            "recovery_center_handoff",
            "doctor_handoff_timeline",
            "headless_cli_escalation",
            "support_packet_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "escalation_anatomy_parts": { "type": "array", "minItems": 1 },
        "handoff_anatomy_parts": { "type": "array", "minItems": 1 },
        "scenario_families": { "type": "array", "minItems": 1 },
        "finding_families": { "type": "array", "minItems": 1 },
        "destinations": { "type": "array", "minItems": 1 },
        "redaction_states": { "type": "array", "minItems": 1 },
        "handoff_stages": { "type": "array", "minItems": 1 },
        "next_human_steps": { "type": "array", "minItems": 1 },
        "approved_repair_classes": { "type": "array", "minItems": 1 },
        "case_dispositions": { "type": "array", "minItems": 1 },
        "summary_postures": { "type": "array", "minItems": 1 },
        "summary_actions": { "type": "array", "minItems": 1 },
        "row_postures": { "type": "array", "minItems": 1 },
        "row_actions": { "type": "array", "minItems": 1 },
        "summary_export_fields": { "type": "array", "minItems": 1 },
        "row_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "escalation_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/escalation_example" }
        },
        "handoff_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/handoff_example" }
        },
        "masks_scenario_or_finding_lineage": { "const": false },
        "hides_packet_destination": { "const": false },
        "drops_next_human_step": { "const": false },
        "collapses_case_into_blob": { "const": false }
      }
    },
    "escalation_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "packet_id",
            "scenario_family",
            "finding_families",
            "related_evidence_ids",
            "repair_attempts",
            "redaction_state",
            "build_profile_identity",
            "destination",
            "case_disposition",
            "summary_posture",
            "available_actions",
            "will_leave_device",
            "needs_redaction_review",
            "lineage_continuous",
            "confirm_available"
          ]
        }
      }
    },
    "handoff_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "event_identity",
            "stage",
            "owner_role",
            "current_owner_role",
            "related_evidence_ids",
            "next_step",
            "row_posture",
            "available_actions",
            "ownership_transferred",
            "awaiting_human",
            "next_step_explicit"
          ]
        }
      }
    }
  }
}
