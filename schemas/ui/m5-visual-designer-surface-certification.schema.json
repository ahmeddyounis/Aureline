{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-visual-designer-surface-certification.schema.json",
  "title": "M5 Visual-Designer Surface Certification Packet",
  "description": "M05-810 certification packet: per claimed M5 visual-design surface, certifies that a visual-design claim self-narrows when its mapping quality, round-trip support, or preview-runtime freshness weakens, and that the export/support packet preserves the same mapping/runtime truth visible in-product. Metadata-only: no raw source bodies, diffs, credentials, or provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "certification_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_visual_designer_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "certification_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/row" }
    },
    "summary": { "$ref": "#/definitions/summary" }
  },
  "definitions": {
    "claim_tier": {
      "type": "string",
      "enum": ["fully_interactive_writable", "inspect_only", "read_only", "source_only"]
    },
    "truth_dimension": {
      "type": "string",
      "enum": ["mapping_quality", "round_trip_support", "preview_runtime_freshness", "export_parity"]
    },
    "mapping_quality": {
      "type": "string",
      "enum": ["exact", "approximate", "unmapped"]
    },
    "round_trip_support": {
      "type": "string",
      "enum": [
        "exact_source_round_trip",
        "approximate_source_round_trip",
        "inspect_only_no_write",
        "source_only_fallback",
        "no_round_trip"
      ]
    },
    "preview_runtime_freshness": {
      "type": "string",
      "enum": ["fresh", "aging", "stale", "unknown"]
    },
    "runtime_origin": {
      "type": "string",
      "enum": [
        "live_dev_runtime",
        "local_mock_runtime",
        "captured_snapshot",
        "tethered_device",
        "simulator_runtime"
      ]
    },
    "source_sync": {
      "type": "string",
      "enum": [
        "in_sync_from_source",
        "pending_rebuild",
        "drifted_from_source",
        "runtime_only_no_source",
        "unidentified_source_sync"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "drifted_from_source",
        "unmapped_source",
        "runtime_unavailable",
        "protected_path_blocked",
        "unsupported_construct",
        "round_trip_conflict_open",
        "unidentified_posture"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": ["identity", "source_ownership", "state", "sync_or_freshness", "keyboard_route"]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "selection_identity",
        "mapping_quality",
        "round_trip_state",
        "runtime_origin",
        "preview_freshness",
        "source_sync_state",
        "effective_claim",
        "narrowed_reason"
      ]
    },
    "auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "weakened_dimension",
        "narrowed_from",
        "narrowed_to",
        "reason_label",
        "preserves_source_truth"
      ],
      "properties": {
        "trigger": { "$ref": "#/definitions/downgrade_trigger" },
        "weakened_dimension": { "$ref": "#/definitions/truth_dimension" },
        "narrowed_from": { "$ref": "#/definitions/claim_tier" },
        "narrowed_to": { "$ref": "#/definitions/claim_tier" },
        "reason_label": { "type": "string", "minLength": 1 },
        "preserves_source_truth": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "claimed_surface",
        "declared_claim",
        "effective_claim",
        "mapping_quality",
        "round_trip_support",
        "preview_runtime_freshness",
        "runtime_origin",
        "source_sync",
        "copy_export",
        "preserved_export_fields",
        "required_labels",
        "consumer_surfaces",
        "certification_bundle_ref",
        "source_family_schema_ref",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_visual_designer_surface_certification_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "claimed_surface": {
          "type": "string",
          "enum": [
            "design_canvas_workspace",
            "structure_tree_panel",
            "property_inspector_panel",
            "source_round_trip_rail",
            "breakpoint_device_preview_deck",
            "framework_pack_preview",
            "browser_runtime_inspection",
            "docs_help_embeds",
            "support_export",
            "release_proof"
          ]
        },
        "declared_claim": { "$ref": "#/definitions/claim_tier" },
        "effective_claim": { "$ref": "#/definitions/claim_tier" },
        "mapping_quality": { "$ref": "#/definitions/mapping_quality" },
        "round_trip_support": { "$ref": "#/definitions/round_trip_support" },
        "preview_runtime_freshness": { "$ref": "#/definitions/preview_runtime_freshness" },
        "runtime_origin": { "$ref": "#/definitions/runtime_origin" },
        "source_sync": { "$ref": "#/definitions/source_sync" },
        "auto_narrow": { "$ref": "#/definitions/auto_narrow" },
        "copy_export": { "$ref": "#/definitions/copy_export" },
        "preserved_export_fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/export_field" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/definitions/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "certification_bundle_ref": { "type": "string", "minLength": 1 },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_count",
        "all_claims_track_truth",
        "all_exports_preserve_truth",
        "all_narrowing_disclosed",
        "evidence_surfaces_present",
        "green_count",
        "yellow_count",
        "red_count",
        "consumer_surface_count"
      ],
      "properties": {
        "surface_count": { "type": "integer", "minimum": 0 },
        "all_claims_track_truth": { "type": "boolean" },
        "all_exports_preserve_truth": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "evidence_surfaces_present": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
