{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-connection-picker-row.schema.json",
  "title": "Aureline M5 connection picker row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "row_id",
    "connection_identity_ref",
    "target_identity_ref",
    "service_identity_ref",
    "engine_family",
    "execution_origin",
    "target_location_class",
    "origin_boundary_ref",
    "auth_storage_mode",
    "access_mode",
    "capability_state",
    "current_database_ref",
    "current_schema_ref",
    "online_state",
    "policy_state",
    "freshness_state",
    "permission_limited",
    "schema_tree_summary",
    "last_introspection_at",
    "export_posture",
    "source_refs",
    "consumer_surfaces",
    "copy_export",
    "reduced_capability_banner",
    "provider_handoff_notes"
  ],
  "properties": {
    "record_kind": {
      "const": "m5_connection_picker_row"
    },
    "schema_version": {
      "const": 1
    },
    "row_id": {
      "$ref": "#/$defs/id"
    },
    "connection_identity_ref": {
      "$ref": "#/$defs/ref"
    },
    "target_identity_ref": {
      "$ref": "#/$defs/ref"
    },
    "service_identity_ref": {
      "$ref": "#/$defs/ref"
    },
    "engine_family": {
      "type": "string",
      "enum": [
        "postgresql",
        "mysql",
        "sqlite",
        "duckdb",
        "snowflake",
        "bigquery",
        "mongodb",
        "browser_storage",
        "imported_snapshot",
        "unknown"
      ]
    },
    "execution_origin": {
      "$ref": "#/$defs/origin"
    },
    "target_location_class": {
      "$ref": "#/$defs/target_location_class"
    },
    "origin_boundary_ref": {
      "$ref": "#/$defs/ref"
    },
    "auth_storage_mode": {
      "$ref": "#/$defs/auth_storage_mode"
    },
    "access_mode": {
      "$ref": "#/$defs/access_mode"
    },
    "capability_state": {
      "$ref": "#/$defs/capability_state"
    },
    "current_database_ref": {
      "$ref": "#/$defs/ref"
    },
    "current_schema_ref": {
      "$ref": "#/$defs/ref"
    },
    "online_state": {
      "$ref": "#/$defs/online_state"
    },
    "policy_state": {
      "$ref": "#/$defs/policy_state"
    },
    "freshness_state": {
      "$ref": "#/$defs/freshness_state"
    },
    "permission_limited": {
      "type": "boolean"
    },
    "schema_tree_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_tree_ref",
        "root_node_ref",
        "depth_limit",
        "node_count_limit",
        "stale_labeled",
        "write_nodes_available"
      ],
      "properties": {
        "schema_tree_ref": {
          "$ref": "#/$defs/ref"
        },
        "root_node_ref": {
          "$ref": "#/$defs/ref"
        },
        "depth_limit": {
          "type": "integer",
          "minimum": 0
        },
        "node_count_limit": {
          "type": "integer",
          "minimum": 0
        },
        "stale_labeled": {
          "type": "boolean"
        },
        "write_nodes_available": {
          "type": "boolean"
        }
      }
    },
    "last_introspection_at": {
      "$ref": "#/$defs/ref"
    },
    "export_posture": {
      "$ref": "#/$defs/export_posture"
    },
    "source_refs": {
      "$ref": "#/$defs/ref_array"
    },
    "consumer_surfaces": {
      "$ref": "#/$defs/consumer_surfaces"
    },
    "copy_export": {
      "$ref": "#/$defs/copy_export"
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banner_id",
        "severity",
        "capability_state",
        "visible_label",
        "missing_capabilities",
        "preserved_fields",
        "action_policy"
      ],
      "properties": {
        "banner_id": {
          "$ref": "#/$defs/ref"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocked"
          ]
        },
        "capability_state": {
          "type": "string",
          "enum": [
            "read_only",
            "write_capable",
            "inspect_only",
            "mutation_review_required",
            "policy_blocked",
            "unavailable"
          ]
        },
        "visible_label": {
          "$ref": "#/$defs/ref"
        },
        "missing_capabilities": {
          "$ref": "#/$defs/ref_array"
        },
        "preserved_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "action_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_send_available",
            "replay_available",
            "mutate_available",
            "export_available"
          ],
          "properties": {
            "live_send_available": {
              "type": "boolean"
            },
            "replay_available": {
              "type": "boolean"
            },
            "mutate_available": {
              "type": "boolean"
            },
            "export_available": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provider_handoff_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note_id",
          "provider_surface",
          "handoff_state",
          "truth_preserved",
          "return_anchor_ref",
          "raw_material_exported"
        ],
        "properties": {
          "note_id": {
            "$ref": "#/$defs/ref"
          },
          "provider_surface": {
            "type": "string",
            "enum": [
              "desktop_request_workspace",
              "desktop_database_tool",
              "remote_workspace",
              "container_workspace",
              "managed_workspace",
              "browser_runtime_panel",
              "notebook_handoff",
              "chart_handoff",
              "ai_context_handoff",
              "cli_headless",
              "support_export",
              "release_proof"
            ]
          },
          "handoff_state": {
            "$ref": "#/$defs/ref"
          },
          "truth_preserved": {
            "$ref": "#/$defs/ref_array"
          },
          "return_anchor_ref": {
            "$ref": "#/$defs/ref"
          },
          "raw_material_exported": {
            "const": false
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "origin": {
      "type": "string",
      "enum": [
        "local_desktop",
        "ssh_remote",
        "container_workspace",
        "managed_workspace",
        "browser_runtime",
        "imported_snapshot",
        "cli_headless"
      ]
    },
    "target_location_class": {
      "type": "string",
      "enum": [
        "local",
        "tunneled",
        "container_local",
        "remote",
        "managed",
        "browser_runtime",
        "imported_snapshot",
        "unknown"
      ]
    },
    "auth_storage_mode": {
      "type": "string",
      "enum": [
        "no_auth",
        "secret_broker_handle",
        "delegated_identity",
        "policy_injected",
        "browser_device_code",
        "local_encrypted_store",
        "managed_rotation",
        "imported_no_live_auth",
        "policy_blocked"
      ]
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "read_only",
        "write_capable",
        "inspect_only",
        "mutation_review_required",
        "policy_blocked",
        "unavailable"
      ]
    },
    "capability_state": {
      "type": "string",
      "enum": [
        "read_only",
        "write_capable",
        "inspect_only",
        "mutation_review_required",
        "policy_blocked",
        "unavailable"
      ]
    },
    "online_state": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "reconnecting",
        "policy_blocked",
        "unknown"
      ]
    },
    "policy_state": {
      "type": "string",
      "enum": [
        "allowed",
        "read_only_enforced",
        "mutation_review_required",
        "policy_limited",
        "policy_blocked",
        "unknown"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "live",
        "current",
        "warm_cached",
        "cached",
        "imported",
        "stale",
        "superseded",
        "partial",
        "expired",
        "policy_limited",
        "offline",
        "unknown"
      ]
    },
    "export_posture": {
      "type": "string",
      "enum": [
        "metadata_only",
        "redacted_typed",
        "visible_rows_only_typed",
        "full_result_typed",
        "blocked_pending_consent",
        "blocked_pending_policy",
        "blocked_redaction_class_too_high"
      ]
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "desktop_request_workspace",
          "desktop_database_tool",
          "remote_workspace",
          "container_workspace",
          "managed_workspace",
          "browser_runtime_panel",
          "notebook_handoff",
          "chart_handoff",
          "ai_context_handoff",
          "cli_headless",
          "support_export",
          "release_proof"
        ]
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "export_fields",
        "text",
        "json",
        "markdown",
        "screenshot_only_prohibited"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "json",
              "markdown"
            ]
          }
        },
        "export_fields": {
          "$ref": "#/$defs/ref_array"
        },
        "text": {
          "$ref": "#/$defs/ref"
        },
        "json": {
          "$ref": "#/$defs/ref"
        },
        "markdown": {
          "$ref": "#/$defs/ref"
        },
        "screenshot_only_prohibited": {
          "const": true
        }
      }
    }
  }
}
