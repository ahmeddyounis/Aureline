{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-connection-picker-row.schema.json",
  "title": "Aureline M5 connection picker row",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "row_id", "connection_identity_ref", "target_identity_ref", "engine_family", "execution_origin", "origin_boundary_ref", "capability_state", "auth_storage_mode", "freshness_state", "permission_limited", "schema_tree_summary", "last_introspection_at", "export_posture", "source_refs", "consumer_surfaces", "copy_export"],
  "properties": {
    "record_kind": { "const": "m5_connection_picker_row" },
    "schema_version": { "const": 1 },
    "row_id": { "$ref": "#/$defs/id" },
    "connection_identity_ref": { "$ref": "#/$defs/ref" },
    "target_identity_ref": { "$ref": "#/$defs/ref" },
    "engine_family": { "type": "string", "enum": ["postgresql", "mysql", "sqlite", "duckdb", "snowflake", "bigquery", "mongodb", "browser_storage", "imported_snapshot", "unknown"] },
    "execution_origin": { "$ref": "#/$defs/origin" },
    "origin_boundary_ref": { "$ref": "#/$defs/ref" },
    "capability_state": { "$ref": "#/$defs/capability_state" },
    "auth_storage_mode": { "$ref": "#/$defs/auth_storage_mode" },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "permission_limited": { "type": "boolean" },
    "schema_tree_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_tree_ref", "root_node_ref", "depth_limit", "node_count_limit", "stale_labeled", "write_nodes_available"],
      "properties": {
        "schema_tree_ref": { "$ref": "#/$defs/ref" },
        "root_node_ref": { "$ref": "#/$defs/ref" },
        "depth_limit": { "type": "integer", "minimum": 0 },
        "node_count_limit": { "type": "integer", "minimum": 0 },
        "stale_labeled": { "type": "boolean" },
        "write_nodes_available": { "type": "boolean" }
      }
    },
    "last_introspection_at": { "$ref": "#/$defs/ref" },
    "export_posture": { "$ref": "#/$defs/export_posture" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "origin": { "type": "string", "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "imported_snapshot", "cli_headless"] },
    "auth_storage_mode": { "type": "string", "enum": ["no_auth", "secret_broker_handle", "delegated_identity", "policy_injected", "browser_device_code", "local_encrypted_store", "managed_rotation", "imported_no_live_auth", "policy_blocked"] },
    "capability_state": { "type": "string", "enum": ["read_only", "write_capable", "inspect_only", "mutation_review_required", "policy_blocked", "unavailable"] },
    "freshness_state": { "type": "string", "enum": ["live", "current", "warm_cached", "cached", "imported", "stale", "superseded", "partial", "expired", "policy_limited", "unknown"] },
    "export_posture": { "type": "string", "enum": ["metadata_only", "redacted_typed", "visible_rows_only_typed", "full_result_typed", "blocked_pending_consent", "blocked_pending_policy", "blocked_redaction_class_too_high"] },
    "consumer_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["desktop_request_workspace", "desktop_database_tool", "remote_workspace", "container_workspace", "managed_workspace", "browser_runtime_panel", "notebook_handoff", "chart_handoff", "ai_context_handoff", "cli_headless", "support_export", "release_proof"] } },
    "copy_export": { "type": "object", "additionalProperties": false, "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "$ref": "#/$defs/ref" }, "json": { "$ref": "#/$defs/ref" }, "markdown": { "$ref": "#/$defs/ref" }, "screenshot_only_prohibited": { "const": true } } }
  }
}
