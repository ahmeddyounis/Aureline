{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-retention-export-card.schema.json",
  "title": "Aureline M5 retention/export-card & history-export-manifest primitive",
  "description": "Export-safe packet implementing the reusable M5 retention/export card and the history-export manifest as one primitive pair. The packet binds one row per claimed compare / export consumer — local-history timeline, refactor evidence, import/migration session, AI-apply evidence, recovery center, and support export desk — to the shared card and manifest anatomy, the derived card posture (fully-shareable/metadata-only-survives/purge-scheduled/policy-restricted/nothing-retained/export-blocked), the derived manifest disposition (full-evidence/redacted-share/policy-restricted/lineage-incomplete/raw-body-withheld/export-blocked), the retention postures, export-redaction postures, manifest classes, cross-baseline comparisons (current-versus-snapshot/snapshot-versus-disk/snapshot-versus-Git-HEAD/snapshot-versus-snapshot), bounded inspect/review/compare/export/request actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked card and manifest resolution cases proving the resolvers, and four hard invariants: it never hides the export baseline, never hides retention or redaction posture, never defaults to raw sensitive content bodies, and never collapses an export into a generic download. Raw checkpoint bodies, diffs, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "ship_m5_cross_baseline_compare_and_export_flows_so_current_versus_snapshot_snapshot_versus_disk_snapshot_versus_git_and_patch_or_evidence_export_stay_explicit_across_claimed_m5_history_refactor_import_ai_paths"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "recovery_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "recovery_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "card_anatomy_parts",
        "manifest_anatomy_parts",
        "retention_postures",
        "export_redactions",
        "manifest_classes",
        "compare_baselines",
        "card_postures",
        "manifest_dispositions",
        "card_actions",
        "manifest_actions",
        "card_export_fields",
        "manifest_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "card_examples",
        "manifest_examples",
        "hides_export_baseline",
        "hides_retention_or_redaction",
        "defaults_to_raw_content_bodies",
        "collapses_export_into_generic_download"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "local_history_timeline",
            "refactor_evidence",
            "import_migration_session",
            "ai_apply_evidence",
            "recovery_center",
            "support_export_desk"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "card_anatomy_parts": { "type": "array", "minItems": 1 },
        "manifest_anatomy_parts": { "type": "array", "minItems": 1 },
        "retention_postures": { "type": "array", "minItems": 1 },
        "export_redactions": { "type": "array", "minItems": 1 },
        "manifest_classes": { "type": "array", "minItems": 1 },
        "compare_baselines": { "type": "array", "minItems": 1 },
        "card_postures": { "type": "array", "minItems": 1 },
        "manifest_dispositions": { "type": "array", "minItems": 1 },
        "card_actions": { "type": "array", "minItems": 1 },
        "manifest_actions": { "type": "array", "minItems": 1 },
        "card_export_fields": { "type": "array", "minItems": 1 },
        "manifest_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card_example" }
        },
        "manifest_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/manifest_example" }
        },
        "hides_export_baseline": { "const": false },
        "hides_retention_or_redaction": { "const": false },
        "defaults_to_raw_content_bodies": { "const": false },
        "collapses_export_into_generic_download": { "const": false }
      }
    },
    "card_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "card_posture",
            "card_label",
            "retention_posture",
            "export_redaction",
            "available_baselines",
            "can_export",
            "baseline_comparison_offered",
            "discloses_retention_and_redaction",
            "hides_compare_baseline",
            "available_actions"
          ]
        }
      }
    },
    "manifest_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "manifest_disposition",
            "manifest_label",
            "manifest_class",
            "export_redaction",
            "primary_baseline",
            "is_shareable",
            "omits_raw_bodies",
            "baseline_is_explicit",
            "available_actions"
          ]
        }
      }
    }
  }
}
