{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-marketplace-account-boundary-open-in-browser-handoff-controls.schema.json",
  "title": "Aureline M5 marketplace/account boundary-card and open-in-browser handoff-row controls",
  "description": "Export-safe packet for the third implement lane over the frozen M5 embedded-boundary component matrix. It carries resolved, honest projections of the marketplace/account boundary card and the open-in-browser handoff row across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved boundary-card examples (naming the owner/origin class, account scope, current profile, region/tenant cue, network state, browser fallback or retry path, and a single controlled boundary disposition) and the resolved open-in-browser handoff-row examples (preserving the current object identity, explaining the reason the in-product lane ended, and keeping local-safe continuity explicit). Hard invariants forbid masquerading as native permission or approval chrome, hiding owner/origin or the browser handoff behind menus only, rendering a stale or blocked state as fresh first-party truth, and embedding a high-risk approval without a native step-up. Acceptance criteria are proven by the resolved examples, not merely asserted: a marketplace/account pane never hides identity, region, or service ownership behind generic product chrome, and a browser handoff preserves object identity and reason-for-handoff instead of dropping users onto a generic landing page. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_marketplace_account_boundary_card_and_open_in_browser_handoff_row_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "boundary_disposition": {
      "enum": [
        "live_first_party_local",
        "live_first_party_hosted",
        "live_provider_owned",
        "stale_snapshot",
        "offline_snapshot",
        "provider_blocked",
        "browser_handoff_only",
        "capability_limited",
        "not_evaluated"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "marketplace_account_boundary_card_example": {
      "type": "object",
      "required": [
        "card_id",
        "owner_origin",
        "account_scope",
        "current_profile",
        "region_or_tenant",
        "network_state",
        "boundary_disposition",
        "browser_fallback_kind",
        "browser_fallback_available",
        "freshness",
        "degrade_reason",
        "next_action",
        "owner_origin_disclosed",
        "account_scope_disclosed",
        "conceals_identity_behind_generic_chrome"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "owner_origin": { "$ref": "#/$defs/non_empty_string" },
        "account_scope": { "$ref": "#/$defs/non_empty_string" },
        "current_profile": { "type": "string" },
        "region_or_tenant": { "type": "string" },
        "network_state": { "$ref": "#/$defs/non_empty_string" },
        "boundary_disposition": { "$ref": "#/$defs/boundary_disposition" },
        "browser_fallback_kind": { "type": ["string", "null"] },
        "browser_fallback_available": { "type": "boolean" },
        "freshness": { "$ref": "#/$defs/non_empty_string" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "owner_origin_disclosed": { "type": "boolean" },
        "account_scope_disclosed": { "type": "boolean" },
        "conceals_identity_behind_generic_chrome": { "type": "boolean" }
      }
    },
    "open_in_browser_handoff_row_example": {
      "type": "object",
      "required": [
        "row_id",
        "handoff_kind",
        "handoff_reason",
        "object_ref",
        "object_label",
        "boundary_disposition",
        "fallback_state",
        "object_identity_preserved",
        "handoff_reason_stated",
        "local_continuity_explicit",
        "browser_fallback_available",
        "degrade_reason",
        "next_action",
        "lands_on_generic_page"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "handoff_kind": { "$ref": "#/$defs/non_empty_string" },
        "handoff_reason": { "$ref": "#/$defs/non_empty_string" },
        "object_ref": { "type": "string" },
        "object_label": { "type": "string" },
        "boundary_disposition": { "$ref": "#/$defs/boundary_disposition" },
        "fallback_state": { "$ref": "#/$defs/non_empty_string" },
        "object_identity_preserved": { "type": "boolean" },
        "handoff_reason_stated": { "type": "boolean" },
        "local_continuity_explicit": { "type": "boolean" },
        "browser_fallback_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "lands_on_generic_page": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "marketplace_account_boundary_card_examples",
        "open_in_browser_handoff_row_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masquerades_as_native_approval_chrome",
        "hides_owner_origin_or_handoff_in_menus_only",
        "renders_stale_or_blocked_as_fresh_first_party_truth",
        "embeds_high_risk_approval_without_native_step_up"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "marketplace_account_boundary_card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/marketplace_account_boundary_card_example" }
        },
        "open_in_browser_handoff_row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/open_in_browser_handoff_row_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masquerades_as_native_approval_chrome": { "const": false },
        "hides_owner_origin_or_handoff_in_menus_only": { "const": false },
        "renders_stale_or_blocked_as_fresh_first_party_truth": { "const": false },
        "embeds_high_risk_approval_without_native_step_up": { "const": false }
      }
    }
  }
}
