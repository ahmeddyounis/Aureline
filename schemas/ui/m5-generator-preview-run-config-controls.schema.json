{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-generator-preview-run-config-controls.schema.json",
  "title": "Aureline M5 generator-preview sheets and run-config scaffold cards",
  "description": "Export-safe packet implementing the reusable M5 generator-preview-sheet and run-config-scaffold-card families in two co-equal control vectors. Each generator-preview sheet names its generator identity / version, its parameters, its created-versus-modified paths, its managed-versus-user-owned files, its dependency / config impact, and its rollback or regenerate posture; its write-effect posture (no-op preview, review-required write, reversible applied, or unknown / blocked) is derived from the frozen generator impact class and apply posture, so a framework generator never implies a safe or no-op write when it changes files, dependencies, or config. Each run-config scaffold card names its target kind, its environment / profile, its launch command, its required toolchain, and its local / container / SSH / managed execution boundary, so a user can see where code will run and which toolchain is required before a convenience action dispatches execution. Every component keeps its rollback / regenerate recovery path explicit (rollback, regenerate, both, forward-fix only, or no recovery needed), and a component without a reversible recovery path never claims one. No component implies a no-op write without explicit file / dependency / config review, hides its dependency / config impact, hides its execution boundary or required toolchain, omits its recovery path, or invents an alternate state label; raw file bodies, raw generated trees, pasted local paths, repository URLs, credentials, and secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "generator_sheets",
    "run_config_cards",
    "downgrade_triggers",
    "consumer_surfaces",
    "generator_run_config_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_generator_preview_sheets_and_run_config_scaffold_cards_with_generator_version_file_effect_classes_dependency_config_impact_rollback_or_regenerate_posture_required_toolchains_and_local_container_ssh_managed_target_truth"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "generator_sheets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/generator_preview_sheet" }
    },
    "run_config_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run_config_scaffold_card" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "generator_run_config_review": { "$ref": "#/$defs/generator_run_config_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "generator_impact_class": {
      "enum": [
        "file_write",
        "dependency_change",
        "config_change",
        "script_or_task_change",
        "no_change",
        "unknown_impact"
      ]
    },
    "generator_apply_posture": {
      "enum": [
        "preview_ready",
        "review_required",
        "apply_ready",
        "rollback_available",
        "regenerate_available",
        "blocked"
      ]
    },
    "run_config_mutation_class": {
      "enum": [
        "creates_config_file",
        "edits_config_file",
        "adds_dependency",
        "no_write_preview",
        "rollback_available",
        "unknown_mutation"
      ]
    },
    "execution_boundary_class": {
      "enum": [
        "local_process",
        "container",
        "ssh_remote",
        "managed_workspace",
        "cloud_remote",
        "unknown_boundary"
      ]
    },
    "write_effect_posture": {
      "enum": [
        "no_op_preview",
        "review_required_write",
        "reversible_applied",
        "unknown_or_blocked"
      ]
    },
    "recovery_path": {
      "enum": [
        "rollback",
        "regenerate",
        "rollback_and_regenerate",
        "forward_fix_only",
        "no_recovery_needed"
      ]
    },
    "file_effect_class": {
      "enum": ["creates_file", "modifies_file", "creates_and_modifies", "no_file_change"]
    },
    "file_ownership_class": {
      "enum": ["managed_generated", "user_owned", "mixed_ownership", "unknown_ownership"]
    },
    "run_target_kind": {
      "enum": [
        "web_app",
        "api_server",
        "cli_tool",
        "test_suite",
        "background_job",
        "unknown_target"
      ]
    },
    "launch_profile_class": {
      "enum": ["development", "debug", "production", "test", "custom_profile"]
    },
    "toolchain_readiness": {
      "enum": [
        "toolchain_ready",
        "toolchain_missing",
        "toolchain_version_mismatch",
        "toolchain_unknown"
      ]
    },
    "generator_sheet_action": {
      "enum": [
        "review_created_and_modified_diff",
        "inspect_impact_and_ownership",
        "open_rollback_or_regenerate",
        "apply_after_review",
        "copy_generator_id"
      ]
    },
    "run_config_card_action": {
      "enum": [
        "inspect_execution_boundary",
        "inspect_required_toolchain",
        "review_config_mutation",
        "run_after_review",
        "copy_launch_command"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "pack_source_and_certainty",
        "execution_boundary_and_impact",
        "proving_source_and_recovery_boundary"
      ]
    },
    "surface_family": {
      "enum": [
        "framework_pack_surface",
        "route_explorer",
        "topology_explorer",
        "convention_diagnostics",
        "generator_review",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "framework_pack_ui",
        "route_explorer_ui",
        "topology_ui",
        "diagnostic_center_ui",
        "generator_review_ui",
        "run_config_ui",
        "editor_gutter_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "pack_identity_unstated",
        "support_class_unstated",
        "exact_versus_heuristic_unstated",
        "authorship_unstated",
        "execution_boundary_unstated",
        "impact_undisclosed",
        "proving_source_omitted",
        "rollback_path_omitted",
        "derived_state_unlabeled",
        "convention_confidence_overstated",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "generator_preview_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "generator_id",
        "generator_name_label",
        "generator_version_label",
        "parameters_label",
        "generator_impact_class",
        "generator_apply_posture",
        "certainty",
        "write_effect_posture",
        "claims_no_op_write",
        "has_recovery_path",
        "file_effect_class",
        "created_path_count",
        "modified_path_count",
        "file_ownership_class",
        "ownership_label",
        "dependency_config_impact_label",
        "recovery_kind",
        "recovery_ref",
        "review_required_note",
        "applied_recovery_note",
        "no_recovery_note",
        "write_effect_note",
        "context_note",
        "sheet_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "implies_no_op_write_without_review",
        "hides_dependency_or_config_impact",
        "omits_rollback_or_regenerate_path",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "generator_preview_sheet" },
        "generator_id": { "$ref": "#/$defs/non_empty_string" },
        "generator_name_label": { "$ref": "#/$defs/non_empty_string" },
        "generator_version_label": { "$ref": "#/$defs/non_empty_string" },
        "parameters_label": { "$ref": "#/$defs/non_empty_string" },
        "generator_impact_class": { "$ref": "#/$defs/generator_impact_class" },
        "generator_apply_posture": { "$ref": "#/$defs/generator_apply_posture" },
        "certainty": { "$ref": "#/$defs/certainty_disposition" },
        "write_effect_posture": { "$ref": "#/$defs/write_effect_posture" },
        "claims_no_op_write": { "type": "boolean" },
        "has_recovery_path": { "type": "boolean" },
        "file_effect_class": { "$ref": "#/$defs/file_effect_class" },
        "created_path_count": { "type": "integer", "minimum": 0 },
        "modified_path_count": { "type": "integer", "minimum": 0 },
        "file_ownership_class": { "$ref": "#/$defs/file_ownership_class" },
        "ownership_label": { "$ref": "#/$defs/non_empty_string" },
        "dependency_config_impact_label": { "type": "string" },
        "recovery_kind": { "$ref": "#/$defs/recovery_path" },
        "recovery_ref": { "type": "string" },
        "review_required_note": { "type": "string" },
        "applied_recovery_note": { "type": "string" },
        "no_recovery_note": { "type": "string" },
        "write_effect_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "sheet_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "review_created_and_modified_diff" } },
            { "contains": { "const": "inspect_impact_and_ownership" } },
            { "contains": { "const": "open_rollback_or_regenerate" } }
          ],
          "items": { "$ref": "#/$defs/generator_sheet_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certainty_disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_no_op_write_without_review": { "const": false },
        "hides_dependency_or_config_impact": { "const": false },
        "omits_rollback_or_regenerate_path": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "run_config_scaffold_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "config_name_label",
        "run_target_kind",
        "target_label",
        "launch_profile_class",
        "environment_profile_label",
        "launch_command_label",
        "required_toolchain_label",
        "toolchain_readiness",
        "execution_boundary_class",
        "is_local_execution",
        "run_config_mutation_class",
        "certainty",
        "write_effect_posture",
        "claims_no_op_write",
        "has_recovery_path",
        "recovery_kind",
        "recovery_ref",
        "review_required_note",
        "applied_recovery_note",
        "no_recovery_note",
        "write_effect_note",
        "context_note",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "implies_no_op_write_without_review",
        "hides_execution_boundary_or_toolchain",
        "omits_rollback_or_regenerate_path",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "run_config_scaffold_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "config_name_label": { "$ref": "#/$defs/non_empty_string" },
        "run_target_kind": { "$ref": "#/$defs/run_target_kind" },
        "target_label": { "$ref": "#/$defs/non_empty_string" },
        "launch_profile_class": { "$ref": "#/$defs/launch_profile_class" },
        "environment_profile_label": { "$ref": "#/$defs/non_empty_string" },
        "launch_command_label": { "$ref": "#/$defs/non_empty_string" },
        "required_toolchain_label": { "$ref": "#/$defs/non_empty_string" },
        "toolchain_readiness": { "$ref": "#/$defs/toolchain_readiness" },
        "execution_boundary_class": { "$ref": "#/$defs/execution_boundary_class" },
        "is_local_execution": { "type": "boolean" },
        "run_config_mutation_class": { "$ref": "#/$defs/run_config_mutation_class" },
        "certainty": { "$ref": "#/$defs/certainty_disposition" },
        "write_effect_posture": { "$ref": "#/$defs/write_effect_posture" },
        "claims_no_op_write": { "type": "boolean" },
        "has_recovery_path": { "type": "boolean" },
        "recovery_kind": { "$ref": "#/$defs/recovery_path" },
        "recovery_ref": { "type": "string" },
        "review_required_note": { "type": "string" },
        "applied_recovery_note": { "type": "string" },
        "no_recovery_note": { "type": "string" },
        "write_effect_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "inspect_execution_boundary" } },
            { "contains": { "const": "inspect_required_toolchain" } },
            { "contains": { "const": "review_config_mutation" } }
          ],
          "items": { "$ref": "#/$defs/run_config_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certainty_disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_no_op_write_without_review": { "const": false },
        "hides_execution_boundary_or_toolchain": { "const": false },
        "omits_rollback_or_regenerate_path": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "generator_run_config_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_sheet_shows_identity_and_version",
        "generator_sheet_shows_created_and_modified_paths",
        "generator_sheet_shows_impact_and_ownership",
        "generator_sheet_offers_rollback_or_regenerate",
        "run_config_card_shows_target_and_launch_command",
        "run_config_card_shows_required_toolchain",
        "run_config_card_shows_execution_boundary",
        "write_posture_derived_never_asserted",
        "no_op_write_never_claimed_with_side_effect",
        "side_effect_always_disclosed_before_apply",
        "execution_boundary_always_visible_before_dispatch",
        "required_toolchain_always_visible_before_dispatch",
        "recovery_path_reachable_before_apply",
        "blocked_component_never_fakes_recovery",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_review_reads_single_source",
        "run_config_reads_single_source",
        "editor_gutter_reads_single_source",
        "impact_and_ownership_visible_before_apply",
        "execution_boundary_and_toolchain_visible_before_dispatch",
        "recovery_path_reachable_before_trust",
        "support_export_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
