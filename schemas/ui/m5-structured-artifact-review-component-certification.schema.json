{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-structured-artifact-review-component-certification.schema.json",
  "title": "M5 Structured-Artifact Review-Component Surface Certification",
  "description": "Surface certification that the nine shared M5 structured-artifact review components (artifact-identity-bar, diff-mode-switcher, structure-row, merge-decision-row, generated-artifact-notice, rendered-compare-viewer, media-metadata-rail, redaction-or-trust-badge-set, compare-summary-card) present the same controlled component truth on every claimed M5 diff, merge, and compare surface, with no hidden parser/schema, render-trust, write-back, or metadata drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "certification_label",
    "surface_rows",
    "summary",
    "downgrade_triggers",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_structured_artifact_component_surface_certification_truth" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "certification_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "artifact_identity_bar",
        "diff_mode_switcher",
        "structure_row",
        "merge_decision_row",
        "generated_artifact_notice",
        "rendered_compare_viewer",
        "media_metadata_rail",
        "redaction_or_trust_badge_set",
        "compare_summary_card"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "diff_toolbar_surface",
        "merge_sheet_surface",
        "review_workspace_surface",
        "help_artifact_surface",
        "support_export",
        "exported_artifact_packet",
        "cli_headless",
        "diagnostics"
      ]
    },
    "axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "structured_fidelity_provenance"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "narrowed_certified", "not_certified_here"]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "full_structured_fidelity",
        "structured_compare_only",
        "partial_structure",
        "raw_fallback_disclosed",
        "metadata_withheld"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["certified_parity", "narrowed_parity", "parity_blocked"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "evidence_packet_invalid",
        "policy_blocked",
        "parser_schema_uncertain",
        "render_trust_unavailable",
        "write_back_safety_unavailable",
        "raw_fallback_required",
        "metadata_withheld_redaction",
        "trust_narrowing",
        "upstream_dependency_narrowed"
      ]
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "note"],
      "properties": {
        "axis": { "$ref": "#/$defs/axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface",
        "components_present",
        "claimed_claim",
        "certified_claim",
        "status",
        "axis_outcomes",
        "narrowed_axes",
        "downgrade_trigger",
        "component_truth_preserved",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "components_present": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "claimed_claim": { "$ref": "#/$defs/claim_tier" },
        "certified_claim": { "$ref": "#/$defs/claim_tier" },
        "status": { "$ref": "#/$defs/status" },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "narrowed_axes": {
          "type": "array",
          "items": { "$ref": "#/$defs/axis" }
        },
        "downgrade_trigger": {
          "oneOf": [{ "$ref": "#/$defs/downgrade_trigger" }, { "type": "null" }]
        },
        "component_truth_preserved": { "type": "boolean" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "component_truth_preserved": { "const": false } } },
          "then": { "properties": { "status": { "const": "parity_blocked" } } }
        },
        {
          "if": {
            "properties": { "narrowed_axes": { "minItems": 1 } }
          },
          "then": {
            "properties": { "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" } }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "certified_count",
        "narrowed_count",
        "blocked_count",
        "all_rows_preserve_component_truth",
        "all_surfaces_covered",
        "all_components_covered",
        "certification_note"
      ],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "certified_count": { "type": "integer", "minimum": 0 },
        "narrowed_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "all_rows_preserve_component_truth": { "type": "boolean" },
        "all_surfaces_covered": { "type": "boolean" },
        "all_components_covered": { "type": "boolean" },
        "certification_note": { "type": "string", "minLength": 1 }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_component_truth_on_every_surface",
        "artifact_class_and_canonical_source_explicit",
        "diff_mode_and_parser_schema_explicit",
        "compare_only_versus_write_back_distinct",
        "render_trust_and_generated_from_explicit",
        "certified_never_implies_full_fidelity",
        "raw_export_safe_fallback_explicit",
        "metadata_and_redaction_posture_preserved",
        "narrows_instead_of_dropping_meaning",
        "flattened_truth_blocks_certification"
      ],
      "properties": {
        "same_component_truth_on_every_surface": { "const": true },
        "artifact_class_and_canonical_source_explicit": { "const": true },
        "diff_mode_and_parser_schema_explicit": { "const": true },
        "compare_only_versus_write_back_distinct": { "const": true },
        "render_trust_and_generated_from_explicit": { "const": true },
        "certified_never_implies_full_fidelity": { "const": true },
        "raw_export_safe_fallback_explicit": { "const": true },
        "metadata_and_redaction_posture_preserved": { "const": true },
        "narrows_instead_of_dropping_meaning": { "const": true },
        "flattened_truth_blocks_certification": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_toolbar_surface_shows_certification",
        "merge_sheet_surface_shows_certification",
        "review_workspace_surface_shows_certification",
        "help_artifact_surface_shows_certification",
        "support_export_shows_certification",
        "exported_artifact_packet_shows_certification",
        "cli_headless_shows_certification",
        "diagnostics_shows_certification",
        "narrowed_surfaces_visibly_labelled"
      ],
      "properties": {
        "diff_toolbar_surface_shows_certification": { "const": true },
        "merge_sheet_surface_shows_certification": { "const": true },
        "review_workspace_surface_shows_certification": { "const": true },
        "help_artifact_surface_shows_certification": { "const": true },
        "support_export_shows_certification": { "const": true },
        "exported_artifact_packet_shows_certification": { "const": true },
        "cli_headless_shows_certification": { "const": true },
        "diagnostics_shows_certification": { "const": true },
        "narrowed_surfaces_visibly_labelled": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
