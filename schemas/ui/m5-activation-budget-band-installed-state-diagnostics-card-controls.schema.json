{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-activation-budget-band-installed-state-diagnostics-card-controls.schema.json",
  "title": "Aureline M5 activation-budget-band and installed-state-diagnostics-card controls",
  "description": "Export-safe packet for the third implement lane over the frozen M5 marketplace / install-review component matrix. It carries resolved, honest projections of the activation-budget band and the installed-state diagnostics card across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved band examples (naming the activation-budget state, low/medium/high/over-budget band class, cold/warm activation evidence, and evidence freshness) and the resolved diagnostics-card examples (naming the activation triggers, exercised capabilities, quarantine state, throttle/quarantine reason, disable/retry remediation actions, and evidence freshness). Hard invariants forbid hiding activation cost or presenting an over-budget band as cost-free, hiding a throttling or quarantine reason behind a healthy card, collapsing the disable/retry pair into one generic action, and leaving Certified/Supported language on stale evidence. Acceptance criteria — activation-budget evidence is legible before install and after runtime degradation, and performance and quarantine implications are visible without digging into logs with the disable/retry pair intact — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_activation_budget_band_and_installed_state_diagnostics_card_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "activation_budget_band_example": {
      "type": "object",
      "required": [
        "band_id",
        "artifact_identity",
        "budget_state",
        "band_class",
        "is_over_budget",
        "cold_start_evidence",
        "warm_start_evidence",
        "has_cold_warm_evidence",
        "certified_or_supported_claimed",
        "evidence_fresh",
        "presents_over_budget_as_cost_free",
        "leaves_stale_certified_overclaim",
        "degrade_reason",
        "next_action",
        "fully_legible"
      ],
      "properties": {
        "band_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "budget_state": { "$ref": "#/$defs/non_empty_string" },
        "band_class": { "$ref": "#/$defs/non_empty_string" },
        "is_over_budget": { "type": "boolean" },
        "cold_start_evidence": { "type": ["string", "null"] },
        "warm_start_evidence": { "type": ["string", "null"] },
        "has_cold_warm_evidence": { "type": "boolean" },
        "certified_or_supported_claimed": { "type": "boolean" },
        "evidence_fresh": { "type": "boolean" },
        "presents_over_budget_as_cost_free": { "type": "boolean" },
        "leaves_stale_certified_overclaim": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fully_legible": { "type": "boolean" }
      }
    },
    "installed_state_diagnostics_card_example": {
      "type": "object",
      "required": [
        "card_id",
        "artifact_identity",
        "budget_state",
        "quarantine_state",
        "compatibility",
        "activation_triggers",
        "exercised_capabilities",
        "throttle_quarantine_reason",
        "remediation_actions",
        "is_actionable",
        "offers_disable",
        "offers_retry",
        "disable_retry_parity",
        "certified_or_supported_claimed",
        "evidence_fresh",
        "hides_quarantine_history",
        "leaves_stale_certified_overclaim",
        "degrade_reason",
        "next_action",
        "fully_legible"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "budget_state": { "$ref": "#/$defs/non_empty_string" },
        "quarantine_state": { "$ref": "#/$defs/non_empty_string" },
        "compatibility": { "$ref": "#/$defs/non_empty_string" },
        "activation_triggers": { "type": "array", "items": { "type": "string" } },
        "exercised_capabilities": { "type": "array", "items": { "type": "string" } },
        "throttle_quarantine_reason": { "type": ["string", "null"] },
        "remediation_actions": { "type": "array", "items": { "type": "string" } },
        "is_actionable": { "type": "boolean" },
        "offers_disable": { "type": "boolean" },
        "offers_retry": { "type": "boolean" },
        "disable_retry_parity": { "type": "boolean" },
        "certified_or_supported_claimed": { "type": "boolean" },
        "evidence_fresh": { "type": "boolean" },
        "hides_quarantine_history": { "type": "boolean" },
        "leaves_stale_certified_overclaim": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fully_legible": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "activation_budget_band_examples",
        "installed_state_diagnostics_card_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_activation_cost_or_over_budget_band",
        "hides_throttling_or_quarantine_reason",
        "collapses_disable_and_retry_into_generic_action",
        "leaves_stale_evidence_certified_or_supported"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "activation_budget_band_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/activation_budget_band_example" }
        },
        "installed_state_diagnostics_card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/installed_state_diagnostics_card_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_activation_cost_or_over_budget_band": { "const": false },
        "hides_throttling_or_quarantine_reason": { "const": false },
        "collapses_disable_and_retry_into_generic_action": { "const": false },
        "leaves_stale_evidence_certified_or_supported": { "const": false }
      }
    }
  }
}
