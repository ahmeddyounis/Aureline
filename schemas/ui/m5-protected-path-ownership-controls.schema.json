{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-protected-path-ownership-controls.schema.json",
  "title": "Aureline M5 protected-path-row / ownership-card controls",
  "description": "Boundary contract for the reusable M5 protected-path row and ownership card controls: one export-safe packet binding a vector of protected-path rows and a vector of ownership cards to one enforcement, coverage, freshness, and escalation vocabulary. The Rust validator in crates/aureline-review is the authoritative gate; this schema documents the export shape. An advisory owner hint never masquerades as provider-authoritative enforcement, and missing backup coverage, unresolved ownership, or policy-hidden owner state never renders as clean coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "protected_path_rows",
    "ownership_cards",
    "downgrade_triggers",
    "consumer_surfaces",
    "review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_protected_path_rows_and_ownership_cards_with_protection_reason_owner_source_advisory_versus_authoritative_state_backup_coverage_and_escalation_continuity"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "protected_path_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protected_path_row" }
    },
    "ownership_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ownership_card" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "governance_state_vocab": {
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "enforcement_source": {
      "enum": [
        "provider_branch_protection",
        "provider_resolved_codeowners",
        "local_manifest_enforced",
        "local_manifest_advisory",
        "local_heuristic_match",
        "inferred_from_authorship"
      ]
    },
    "enforcement_posture": {
      "enum": ["provider_authoritative", "locally_authoritative", "advisory_only", "local_estimate"]
    },
    "coverage_source": {
      "enum": [
        "primary_and_backup_resolved",
        "provider_resolved_covered",
        "primary_only_backup_missing",
        "owner_unresolved",
        "policy_hidden_owner"
      ]
    },
    "coverage_posture": {
      "enum": ["covered_with_backup", "backup_missing", "unresolved", "policy_hidden"]
    },
    "continuity_state": {
      "enum": ["continuous", "degraded_backup_missing", "unresolved_continuity", "policy_limited"]
    },
    "owner_source_class": {
      "enum": [
        "codeowners_entry",
        "dri_registry",
        "ownership_manifest",
        "inferred_authorship",
        "unresolved"
      ]
    },
    "evaluation_freshness_state": {
      "enum": ["currently_evaluated", "imported", "stale", "never_evaluated", "unknown"]
    },
    "rule_source_kind": {
      "enum": [
        "codeowners_rule",
        "protected_path_policy",
        "branch_protection_rule",
        "manifest_entry",
        "no_rule_source"
      ]
    },
    "protected_path_row": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "component",
        "row_id",
        "path_label",
        "protection_reason_label",
        "owner_source_label",
        "enforcement_source",
        "derived_enforcement_posture",
        "governance_state_vocab",
        "evaluation_freshness",
        "evaluation_freshness_label",
        "rule_source_kind",
        "context_note"
      ],
      "properties": {
        "component": { "const": "protected_path_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "path_label": { "$ref": "#/$defs/non_empty_string" },
        "protection_reason_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_source_label": { "$ref": "#/$defs/non_empty_string" },
        "enforcement_source": { "$ref": "#/$defs/enforcement_source" },
        "derived_enforcement_posture": { "$ref": "#/$defs/enforcement_posture" },
        "claims_authoritative_enforcement": { "type": "boolean" },
        "claims_provider_authoritative": { "type": "boolean" },
        "governance_state_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/governance_state_vocab" }
        },
        "evaluation_freshness": { "$ref": "#/$defs/evaluation_freshness_state" },
        "evaluation_freshness_label": { "$ref": "#/$defs/non_empty_string" },
        "rule_source_kind": { "$ref": "#/$defs/rule_source_kind" },
        "context_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "ownership_card": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "component",
        "card_id",
        "owned_path_label",
        "primary_owner_alias",
        "owner_source_class",
        "owner_source_label",
        "enforcement_source",
        "derived_enforcement_posture",
        "coverage_source",
        "derived_coverage_posture",
        "derived_continuity_state",
        "claims_clean_coverage",
        "governance_state_vocab",
        "escalation_path_label",
        "escalation_boundary_note",
        "context_note"
      ],
      "properties": {
        "component": { "const": "ownership_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "owned_path_label": { "$ref": "#/$defs/non_empty_string" },
        "primary_owner_alias": { "$ref": "#/$defs/non_empty_string" },
        "backup_owner_alias": { "type": "string" },
        "owner_source_class": { "$ref": "#/$defs/owner_source_class" },
        "owner_source_label": { "$ref": "#/$defs/non_empty_string" },
        "enforcement_source": { "$ref": "#/$defs/enforcement_source" },
        "derived_enforcement_posture": { "$ref": "#/$defs/enforcement_posture" },
        "claims_authoritative_enforcement": { "type": "boolean" },
        "claims_provider_authoritative": { "type": "boolean" },
        "coverage_source": { "$ref": "#/$defs/coverage_source" },
        "derived_coverage_posture": { "$ref": "#/$defs/coverage_posture" },
        "derived_continuity_state": { "$ref": "#/$defs/continuity_state" },
        "claims_clean_coverage": { "type": "boolean" },
        "governance_state_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/governance_state_vocab" }
        },
        "escalation_path_label": { "$ref": "#/$defs/non_empty_string" },
        "escalation_boundary_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
