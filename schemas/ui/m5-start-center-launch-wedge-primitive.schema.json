{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-start-center-launch-wedge-primitive.schema.json",
  "title": "Aureline M5 start-center launch-wedge primitive",
  "description": "Canonical parity matrix for the reusable M5 start-center launch-wedge primitive: a start-center bundle card and a certified-archetype badge group that both resolve from one launch-wedge context and share one wedge identity. Narrows two families of the frozen M5 workflow-bundle component matrix (start_center_bundle_card, certified_archetype_badge_group) into one working resolver. Certified / approximate / local-only entry assurance is legible before install (AC1); archetype badges degrade visibly to Retest pending / Limited when certification freshness slips or archetype scope narrows (AC2); a stack entry never inherits a hidden marketplace / certification assumption from backend state alone (AC3). Raw manifest bytes, credentials, entitlement tokens, mirror URLs, and provider cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_start_center_launch_wedge_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "start_center_card",
        "workspace_switcher",
        "bundle_picker_list",
        "docs_help_bundle_entry",
        "diagnostics_bundle_view",
        "support_export_replay"
      ]
    },
    "entry_assurance_tier": {
      "enum": ["certified", "approximate", "local_only"]
    },
    "badge_downgrade_state": {
      "enum": ["none", "limited", "retest_pending"]
    },
    "export_field": {
      "enum": [
        "wedge_id",
        "bundle_identity",
        "source_class",
        "support_class",
        "signer_source",
        "certification_freshness",
        "compatible_range",
        "archetype_envelope"
      ]
    },
    "source_class": {
      "enum": [
        "certified",
        "managed_approved",
        "community_reviewed",
        "imported_pending_review",
        "local_draft"
      ]
    },
    "bundle_class": {
      "enum": [
        "launch_bundle",
        "framework_pack",
        "template_bundle",
        "imported_handoff_bundle",
        "org_managed_bundle",
        "no_bundle"
      ]
    },
    "signer_source": {
      "enum": ["first_party", "trusted_remote", "unverified_remote", "untrusted"]
    },
    "support_class": {
      "enum": [
        "stable",
        "preview",
        "labs",
        "policy_gated",
        "mirror_only",
        "bounded_platform"
      ]
    },
    "freshness_state": {
      "enum": ["fresh", "aging", "stale", "missing"]
    },
    "archetype_confidence": {
      "enum": ["confirmed", "probable", "mixed", "undetected"]
    },
    "imported_confidence": {
      "enum": ["native", "bridged", "approximated", "unverified"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_supplied"]
    },
    "downgrade_trigger": {
      "enum": [
        "stale_certification",
        "mirror_stale",
        "offline_cache_only",
        "unverified_signer",
        "local_override_drift",
        "incompatible_aureline",
        "entitlement_dependency_unmet",
        "imported_not_native",
        "rollback_only_path"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "launch_wedge_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wedge_id",
        "surface_label",
        "bundle_id_ref",
        "bundle_name",
        "persona_stack_tag",
        "bundle_class",
        "signer_source",
        "support_class",
        "source_class",
        "certification_freshness",
        "compatible_aureline_range",
        "truth_mode",
        "review_action_ref",
        "inherits_hidden_marketplace_assumption",
        "claims_current_despite_stale",
        "archetype_family_ref",
        "archetype_id",
        "archetype_confidence",
        "supported_platform_envelope_ref",
        "badge_count",
        "imported_confidence"
      ],
      "properties": {
        "wedge_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "persona_stack_tag": { "type": "string" },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/signer_source" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "review_action_ref": { "$ref": "#/$defs/ref" },
        "inherits_hidden_marketplace_assumption": { "const": false },
        "claims_current_despite_stale": { "const": false },
        "archetype_family_ref": { "$ref": "#/$defs/ref" },
        "archetype_id": { "type": "string", "minLength": 1 },
        "archetype_confidence": { "$ref": "#/$defs/archetype_confidence" },
        "supported_platform_envelope_ref": { "$ref": "#/$defs/ref" },
        "badge_count": { "type": "integer", "minimum": 0 },
        "imported_confidence": { "$ref": "#/$defs/imported_confidence" },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_bundle_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wedge_id",
        "bundle_id_ref",
        "bundle_name",
        "persona_stack_tag",
        "bundle_class",
        "signer_source",
        "support_class",
        "source_class",
        "entry_assurance_tier",
        "certification_freshness",
        "compatible_aureline_range",
        "truth_mode",
        "review_action_ref",
        "discloses_signer_source",
        "discloses_certification_freshness",
        "source_class_named",
        "review_action_present"
      ],
      "properties": {
        "wedge_id": { "$ref": "#/$defs/id" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "persona_stack_tag": { "type": "string" },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/signer_source" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "entry_assurance_tier": { "$ref": "#/$defs/entry_assurance_tier" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "review_action_ref": { "$ref": "#/$defs/ref" },
        "discloses_signer_source": { "const": true },
        "discloses_certification_freshness": { "const": true },
        "source_class_named": { "const": true },
        "review_action_present": { "const": true }
      }
    },
    "resolved_badge_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wedge_id",
        "archetype_family_ref",
        "archetype_id",
        "archetype_confidence",
        "source_class",
        "certification_freshness",
        "supported_platform_envelope_ref",
        "badge_count",
        "downgrade_state",
        "badges_degrade_visibly",
        "discloses_certification_freshness"
      ],
      "properties": {
        "wedge_id": { "$ref": "#/$defs/id" },
        "archetype_family_ref": { "$ref": "#/$defs/ref" },
        "archetype_id": { "type": "string", "minLength": 1 },
        "archetype_confidence": { "$ref": "#/$defs/archetype_confidence" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "supported_platform_envelope_ref": { "$ref": "#/$defs/ref" },
        "badge_count": { "type": "integer", "minimum": 0 },
        "downgrade_state": { "$ref": "#/$defs/badge_downgrade_state" },
        "badges_degrade_visibly": { "type": "boolean" },
        "discloses_certification_freshness": { "const": true }
      }
    },
    "resolved_launch_wedge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wedge_id",
        "bundle_card",
        "badge_group",
        "entry_assurance_disclosed",
        "badges_degrade_visibly",
        "source_class_not_inherited"
      ],
      "properties": {
        "wedge_id": { "$ref": "#/$defs/id" },
        "bundle_card": { "$ref": "#/$defs/resolved_bundle_card" },
        "badge_group": { "$ref": "#/$defs/resolved_badge_group" },
        "entry_assurance_disclosed": { "const": true },
        "badges_degrade_visibly": { "type": "boolean" },
        "source_class_not_inherited": { "const": true },
        "degraded": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/degraded_state" }]
        }
      }
    },
    "launch_wedge_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/launch_wedge_input" },
        "resolved": { "$ref": "#/$defs/resolved_launch_wedge" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "source_classes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_wedges",
        "hides_entry_assurance",
        "hides_badge_downgrade",
        "inherits_hidden_source_class"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "source_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_class" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_wedges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/launch_wedge_case" }
        },
        "hides_entry_assurance": { "const": false },
        "hides_badge_downgrade": { "const": false },
        "inherits_hidden_source_class": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "entry_assurance_tiers",
        "badge_downgrade_states",
        "export_fields",
        "source_classes",
        "bundle_classes",
        "signer_sources",
        "support_classes",
        "freshness_states",
        "archetype_confidences",
        "imported_confidences",
        "truth_modes",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "entry_assurance_tiers": { "type": "array", "items": { "type": "string" } },
        "badge_downgrade_states": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "source_classes": { "type": "array", "items": { "type": "string" } },
        "bundle_classes": { "type": "array", "items": { "type": "string" } },
        "signer_sources": { "type": "array", "items": { "type": "string" } },
        "support_classes": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "archetype_confidences": { "type": "array", "items": { "type": "string" } },
        "imported_confidences": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "wedge_identity_preserved_across_surfaces",
        "entry_assurance_legible_before_install",
        "archetype_badges_degrade_visibly",
        "source_class_never_inherited",
        "support_export_reconstructs_wedge",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "wedge_identity_preserved_across_surfaces": { "const": true },
        "entry_assurance_legible_before_install": { "const": true },
        "archetype_badges_degrade_visibly": { "const": true },
        "source_class_never_inherited": { "const": true },
        "support_export_reconstructs_wedge": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "badge_group_reads_single_certification_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "launch_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "badge_group_reads_single_certification_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "launch_wedge_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "launch_wedge_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
