{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-git-history-sequence-component-matrix.schema.json",
  "title": "Aureline M5 Git-history and risky-mutation component matrix",
  "description": "Export-safe packet freezing the reusable M5 Git-history and history-surgery component family: commit-graph headers, history graph rows, branch-comparison chips, worktree rows, stash entries, reflog recovery banners, rebase todo rows, sequence-editor headers, cherry-pick/revert review sheets, patch-apply review sheets, conflict-checkpoint cards, and force-push review dialogs. Each component row names the exact repo/worktree/ref identity, recovery checkpoint/destination, approval-invalidation rule, and browser/provider handoff rule it must preserve, the shared downgrade vocabulary it may surface, the mutation-review class its Git verb requires, and the consumer surfaces that must express the same truth. Component truth is never reduced to a badge, Git verbs are never collapsed into one ambiguous confirm, and conflict/recovery state survives a risky mutation. Raw paths, raw object bytes, raw branch names, raw patch/reflog/stash bodies, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "downgrade_state_rows",
    "governance_review",
    "consumer_parity",
    "freeze_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_git_history_sequence_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 12,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "downgrade_state_rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/downgrade_state_row"
      }
    },
    "governance_review": {
      "$ref": "#/$defs/governance_review"
    },
    "consumer_parity": {
      "$ref": "#/$defs/consumer_parity"
    },
    "freeze_posture": {
      "$ref": "#/$defs/freeze_posture"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "component": {
      "enum": [
        "commit_graph_header",
        "history_graph_row",
        "branch_comparison_chip",
        "worktree_row",
        "stash_entry",
        "reflog_recovery_banner",
        "rebase_todo_row",
        "sequence_editor_header",
        "cherry_pick_revert_review_sheet",
        "patch_apply_review_sheet",
        "conflict_checkpoint_card",
        "force_push_review_dialog"
      ]
    },
    "maturity": {
      "enum": ["stable", "beta", "preview"]
    },
    "downgrade_state": {
      "enum": [
        "stale_provider_overlay",
        "detached_or_missing_ref",
        "dirty_or_conflicted_worktree",
        "shallow_or_partial_topology",
        "reflog_only_fallback",
        "approval_invalidated",
        "offline_local_only"
      ]
    },
    "mutation_review_class": {
      "enum": [
        "display_only_no_mutation",
        "explicit_verb_confirm",
        "sequence_rewrite_confirm",
        "stash_restore_confirm",
        "patch_apply_confirm",
        "force_push_confirm"
      ]
    },
    "consumer_surface": {
      "enum": [
        "review",
        "shell",
        "help",
        "support",
        "support_export",
        "provider_overlay",
        "cli",
        "ai_context"
      ]
    },
    "downgrade_state_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_state"
      }
    },
    "consumer_surface_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "label",
        "maturity",
        "canonical_source_contract_ref",
        "identity_preservation",
        "recovery_checkpoint_rule",
        "approval_invalidation_rule",
        "browser_provider_handoff_rule",
        "downgrade_vocab",
        "mutation_review_class",
        "preserves_distinct_verb",
        "consumer_surfaces"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/component"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "maturity": {
          "$ref": "#/$defs/maturity"
        },
        "canonical_source_contract_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "identity_preservation": {
          "$ref": "#/$defs/non_empty_string"
        },
        "recovery_checkpoint_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "approval_invalidation_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "browser_provider_handoff_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "downgrade_vocab": {
          "$ref": "#/$defs/downgrade_state_array"
        },
        "mutation_review_class": {
          "$ref": "#/$defs/mutation_review_class"
        },
        "preserves_distinct_verb": {
          "type": "boolean"
        },
        "consumer_surfaces": {
          "$ref": "#/$defs/consumer_surface_array"
        }
      }
    },
    "downgrade_state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "meaning",
        "narrows_claim",
        "must_stay_visible_after_mutation"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/downgrade_state"
        },
        "meaning": {
          "$ref": "#/$defs/non_empty_string"
        },
        "narrows_claim": {
          "type": "boolean"
        },
        "must_stay_visible_after_mutation": {
          "type": "boolean"
        }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_surface_consumes_one_shared_matrix",
        "exact_ref_worktree_identity_preserved",
        "recovery_destination_always_explicit",
        "approval_invalidation_never_silent",
        "no_verb_collapsed_into_ambiguous_confirm",
        "conflict_recovery_state_survives_mutation",
        "provider_overlay_never_overwrites_local_truth",
        "local_only_recovery_stays_explicit",
        "downgrade_vocabulary_shared_across_surfaces"
      ],
      "properties": {
        "every_surface_consumes_one_shared_matrix": {
          "type": "boolean"
        },
        "exact_ref_worktree_identity_preserved": {
          "type": "boolean"
        },
        "recovery_destination_always_explicit": {
          "type": "boolean"
        },
        "approval_invalidation_never_silent": {
          "type": "boolean"
        },
        "no_verb_collapsed_into_ambiguous_confirm": {
          "type": "boolean"
        },
        "conflict_recovery_state_survives_mutation": {
          "type": "boolean"
        },
        "provider_overlay_never_overwrites_local_truth": {
          "type": "boolean"
        },
        "local_only_recovery_stays_explicit": {
          "type": "boolean"
        },
        "downgrade_vocabulary_shared_across_surfaces": {
          "type": "boolean"
        }
      }
    },
    "consumer_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_expresses_family",
        "shell_expresses_family",
        "help_expresses_family",
        "support_export_expresses_family",
        "cli_expresses_family",
        "provider_overlay_expresses_family"
      ],
      "properties": {
        "review_expresses_family": {
          "type": "boolean"
        },
        "shell_expresses_family": {
          "type": "boolean"
        },
        "help_expresses_family": {
          "type": "boolean"
        },
        "support_export_expresses_family": {
          "type": "boolean"
        },
        "cli_expresses_family": {
          "type": "boolean"
        },
        "provider_overlay_expresses_family": {
          "type": "boolean"
        }
      }
    },
    "freeze_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen",
        "review_slo_hours",
        "last_reviewed_at",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "review_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
