{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-workspace-trust-banner-root-trust-strip-controls.schema.json",
  "title": "Aureline M5 workspace-trust-banner and root-trust-strip controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 workspace-trust / guided-repair component matrix. It carries resolved, honest projections of the workspace-trust banner and the root-trust strip across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved workspace-trust banner examples (naming the object identity, trust class / scope, grant source, policy epoch, narrowed-capability summary, and a single controlled trust disposition) and the resolved root-trust strip examples (naming the root identity, per-root trust state, grant source, and policy epoch). Hard invariants forbid implying blanket trust across roots or routes, hiding the grant source or policy epoch behind menus only, collapsing mixed-root trust into misleading uniform trust, and hiding a narrowed capability behind generic reduced-mode chrome. Acceptance criteria — mixed-root trust stays explicit and trust state traces to one component contract and one command-backed detail entrypoint — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_workspace_trust_banner_and_root_trust_strip_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "trust_disposition": {
      "type": ["string", "null"],
      "enum": [
        "trusted",
        "restricted",
        "mixed_root",
        "policy_blocked",
        "reduced_mode",
        "preview_ready",
        "checkpoint_missing",
        "exact_reversal",
        "compensate",
        "regenerate",
        "manual_follow_up",
        "audit_only",
        null
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "workspace_trust_banner_example": {
      "type": "object",
      "required": [
        "banner_id",
        "object_identity",
        "trust_scope",
        "trust_disposition",
        "grant_source",
        "policy_epoch",
        "capability_narrow",
        "capability_narrowed",
        "is_mixed_root",
        "collapses_mixed_root_into_uniform",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "legible_at_a_glance"
      ],
      "properties": {
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "object_identity": { "type": "string" },
        "trust_scope": { "$ref": "#/$defs/non_empty_string" },
        "trust_disposition": { "$ref": "#/$defs/trust_disposition" },
        "grant_source": { "$ref": "#/$defs/non_empty_string" },
        "policy_epoch": { "type": "string" },
        "capability_narrow": { "$ref": "#/$defs/non_empty_string" },
        "capability_narrowed": { "type": "boolean" },
        "is_mixed_root": { "type": "boolean" },
        "collapses_mixed_root_into_uniform": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "legible_at_a_glance": { "type": "boolean" }
      }
    },
    "root_trust_strip_example": {
      "type": "object",
      "required": [
        "strip_id",
        "root_identity",
        "root_trust",
        "trust_disposition",
        "grant_source",
        "policy_epoch",
        "part_of_mixed_root",
        "collapses_per_root_into_uniform",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "per_root_trust_explicit"
      ],
      "properties": {
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "root_identity": { "type": "string" },
        "root_trust": { "$ref": "#/$defs/non_empty_string" },
        "trust_disposition": { "$ref": "#/$defs/trust_disposition" },
        "grant_source": { "$ref": "#/$defs/non_empty_string" },
        "policy_epoch": { "type": "string" },
        "part_of_mixed_root": { "type": "boolean" },
        "collapses_per_root_into_uniform": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "per_root_trust_explicit": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "workspace_trust_banner_examples",
        "root_trust_strip_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "implies_blanket_trust_across_roots_or_routes",
        "hides_grant_source_or_policy_epoch_in_menus_only",
        "collapses_mixed_root_into_uniform_trust",
        "hides_narrowed_capability_behind_generic_chrome"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "workspace_trust_banner_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workspace_trust_banner_example" }
        },
        "root_trust_strip_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/root_trust_strip_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_blanket_trust_across_roots_or_routes": { "const": false },
        "hides_grant_source_or_policy_epoch_in_menus_only": { "const": false },
        "collapses_mixed_root_into_uniform_trust": { "const": false },
        "hides_narrowed_capability_behind_generic_chrome": { "const": false }
      }
    }
  }
}
