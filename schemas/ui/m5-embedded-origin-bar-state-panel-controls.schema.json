{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-embedded-origin-bar-state-panel-controls.schema.json",
  "title": "Aureline M5 embedded-origin-bar and embedded-state-panel controls",
  "description": "Export-safe packet for the second implement lane over the frozen M5 embedded-boundary component matrix. It carries resolved, honest projections of the extension-owned embedded origin bar and the embedded-state panel across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved origin-bar examples (naming the owner/origin class, origin disclosure, extension name, publisher, permission state, capability limits, reload action, open-in-browser handoff, and a single controlled boundary disposition) and the resolved embedded-state panel examples (explaining stale, offline, policy-blocked, certificate-denied, or cross-origin-limited states with the shared severity and support-boundary vocabulary). Hard invariants forbid masquerading as native permission or approval chrome, hiding owner/origin or the browser handoff behind menus only, rendering a stale or blocked state as fresh first-party truth, and embedding a high-risk approval without a native step-up. Acceptance criteria are proven by the resolved examples, not merely asserted: no contributed webview appears without visible owner/origin chrome and capability-limit disclosure, and no embedded contributed surface imitates native permission / trust / update / confirmation UI. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_embedded_origin_bar_and_embedded_state_panel_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "boundary_disposition": {
      "enum": [
        "live_first_party_local",
        "live_first_party_hosted",
        "live_provider_owned",
        "stale_snapshot",
        "offline_snapshot",
        "provider_blocked",
        "browser_handoff_only",
        "capability_limited",
        "not_evaluated"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "embedded_origin_bar_example": {
      "type": "object",
      "required": [
        "bar_id",
        "owner_origin",
        "origin_disclosure",
        "extension_name",
        "publisher",
        "boundary_disposition",
        "permission_state",
        "capability_limits",
        "freshness",
        "reload_available",
        "open_in_browser_kind",
        "open_in_browser_available",
        "degrade_reason",
        "next_action",
        "owner_origin_disclosed",
        "capability_limits_disclosed",
        "imitates_native_permission_ui"
      ],
      "properties": {
        "bar_id": { "$ref": "#/$defs/non_empty_string" },
        "owner_origin": { "$ref": "#/$defs/non_empty_string" },
        "origin_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "extension_name": { "type": "string" },
        "publisher": { "type": "string" },
        "boundary_disposition": { "$ref": "#/$defs/boundary_disposition" },
        "permission_state": { "$ref": "#/$defs/non_empty_string" },
        "capability_limits": { "type": "array", "items": { "type": "string" } },
        "freshness": { "$ref": "#/$defs/non_empty_string" },
        "reload_available": { "type": "boolean" },
        "open_in_browser_kind": { "type": ["string", "null"] },
        "open_in_browser_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "owner_origin_disclosed": { "type": "boolean" },
        "capability_limits_disclosed": { "type": "boolean" },
        "imitates_native_permission_ui": { "type": "boolean" }
      }
    },
    "embedded_state_panel_example": {
      "type": "object",
      "required": [
        "panel_id",
        "state_class",
        "owner_origin",
        "boundary_disposition",
        "state_explained",
        "severity_and_support_boundary_shared",
        "recovery_action_available",
        "degrade_reason",
        "next_action",
        "renders_blocked_as_fresh",
        "imitates_native_permission_ui"
      ],
      "properties": {
        "panel_id": { "$ref": "#/$defs/non_empty_string" },
        "state_class": { "$ref": "#/$defs/non_empty_string" },
        "owner_origin": { "$ref": "#/$defs/non_empty_string" },
        "boundary_disposition": { "$ref": "#/$defs/boundary_disposition" },
        "state_explained": { "type": "boolean" },
        "severity_and_support_boundary_shared": { "type": "boolean" },
        "recovery_action_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "renders_blocked_as_fresh": { "type": "boolean" },
        "imitates_native_permission_ui": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "embedded_origin_bar_examples",
        "embedded_state_panel_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masquerades_as_native_approval_chrome",
        "hides_owner_origin_or_handoff_in_menus_only",
        "renders_stale_or_blocked_as_fresh_first_party_truth",
        "embeds_high_risk_approval_without_native_step_up"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "embedded_origin_bar_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/embedded_origin_bar_example" }
        },
        "embedded_state_panel_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/embedded_state_panel_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masquerades_as_native_approval_chrome": { "const": false },
        "hides_owner_origin_or_handoff_in_menus_only": { "const": false },
        "renders_stale_or_blocked_as_fresh_first_party_truth": { "const": false },
        "embeds_high_risk_approval_without_native_step_up": { "const": false }
      }
    }
  }
}
