{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-workspace-trust-repair-component-certification.schema.json",
  "title": "Aureline M5 workspace-trust / guided-repair component surface certification packet",
  "description": "M05-1099 closing capstone certifying that the frozen M5 workspace-trust / guided-repair component families (workspace-trust banner, trust-fact grid, trust-elevation sheet, restricted-capability row, root-trust strip, repair-transaction preview card, rollback-class strip, repair-result receipt row) hold their truth on every claimed M5 trust / repair operating profile. Keyed on the claimed profile (local trusted workspace, remote reviewed workspace, managed policy workspace, exact-reversal repair, restricted workspace, mixed-root workspace, checkpoint-missing repair, manual-follow-up repair), each row certifies the profile across six truth axes — visual, keyboard, screen-reader, CLI/export, degraded-state, and trust-repair-truth behavior — and either passes (green), auto-narrows its trust/repair claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh full-trust claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a local first-party profile may certify a full-trust reviewed result; and every B130 guardrail must hold (no blanket trust across roots or profiles, no hidden checkpoint absence or reversal limits, no collapse of exact/compensate/regenerate/manual/audit-only outcomes into a generic success). Every row cites exactly one canonical workspace-trust-repair proof bundle. The packet is metadata-only: raw credentials, session tokens, and grant secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_workspace_trust_repair_component_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-workspace-trust-repair-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "local_trusted_workspace",
        "remote_reviewed_workspace",
        "managed_policy_workspace",
        "exact_reversal_repair",
        "restricted_workspace",
        "mixed_root_workspace",
        "checkpoint_missing_repair",
        "manual_follow_up_repair"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "trust_repair_truth"
      ]
    },
    "support_claim": {
      "enum": [
        "full_trust_reviewed_result",
        "reviewable_result",
        "stale_lineage_projection",
        "expired_epoch_projection",
        "mixed_root_projection",
        "narrowed_capability_projection",
        "missing_checkpoint_projection",
        "unproven_reversal_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "workspace_trust_banner",
        "trust_fact_grid",
        "trust_elevation_sheet",
        "restricted_capability_row",
        "root_trust_strip",
        "repair_transaction_preview_card",
        "rollback_class_strip",
        "repair_result_receipt_row"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "grant_source_unstated",
        "policy_epoch_unstated",
        "root_scope_collapsed_into_blanket_trust",
        "narrowed_capability_unstated",
        "checkpoint_absence_hidden",
        "reversal_limit_hidden",
        "reversal_class_collapsed_into_generic_success",
        "repair_target_ids_unstated",
        "partial_success_shown_as_complete",
        "mixed_root_shown_as_uniform_trust",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implies_blanket_trust_across_roots_or_profiles",
        "hides_checkpoint_absence_or_reversal_limits",
        "collapses_reversal_outcomes_into_generic_success"
      ],
      "properties": {
        "implies_blanket_trust_across_roots_or_profiles": { "const": false },
        "hides_checkpoint_absence_or_reversal_limits": { "const": false },
        "collapses_reversal_outcomes_into_generic_success": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/support_claim" },
        "to_claim": { "$ref": "#/$defs/support_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_workspace_trust_repair_component_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/support_claim" },
        "certified_claim": { "$ref": "#/$defs/support_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-workspace-trust-repair-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
