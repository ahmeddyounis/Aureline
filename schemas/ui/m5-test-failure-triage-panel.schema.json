{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-failure-triage-panel.schema.json",
  "title": "Aureline M5 failure-triage-panel / quarantine-review-sheet / environment-matrix-card primitive",
  "description": "Export-safe packet implementing the reusable M5 failure-triage panel, quarantine/mute review sheet, and environment-matrix card as one triple primitive. The packet binds one row per claimed quality surface — the test-explorer triage view, the editor inline triage, the notebook triage view, the run-panel triage, and the quality report export — to the shared triage, quarantine, and environment anatomy, the derived triage posture (one distinct posture per failure category), the classifier confidence, the recent attempt sequence, whether an assertion/diff summary and environment/build/runtime deltas are present, the evidence-gated rerun/debug/open-review actions, the derived quarantine review posture (expired/unowned/hidden-release/review-due/blocking/governed — honesty-first) with preserved scope/kind/reason/owner/expiry/linked-artifacts/release-impact and an always-present restore action, and the derived environment card posture (incompatible/unverified/mixed/compatible — the worst axis across every leg) that never asserts safe equivalence. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the three resolvers, and four hard invariants: it never offers a destructive suppression path without evidence context, never hides a suppression's owner/expiry/release impact, never implies safe equivalence across incompatible environments, and never drops the recent attempt sequence or the deltas. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary. This is the canonical packet schema; the quarantine-review companion at m5-test-quarantine-review-sheet.schema.json and the environment-matrix companion at m5-test-environment-matrix-card.schema.json describe the quarantine and environment resolution case shapes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_failure_triage_panels_quarantine_review_sheets_and_environment_matrix_cards_with_assertion_diff_summaries_recent_attempts_env_build_runtime_deltas_owner_expiry_release_impact_and_rerun_debug_review_parity_across_claimed_m5_quality_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "test_evidence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "triage_anatomy_parts",
        "quarantine_anatomy_parts",
        "environment_anatomy_parts",
        "failure_categories",
        "triage_dispositions",
        "classifier_confidences",
        "triage_postures",
        "suppression_kinds",
        "suppression_scopes",
        "quarantine_ownership_classes",
        "release_impacts",
        "expiry_states",
        "quarantine_postures",
        "target_classes",
        "environment_lanes",
        "compatibility_classes",
        "environment_postures",
        "attempt_lineage_kinds",
        "result_origins",
        "triage_actions",
        "quarantine_actions",
        "environment_actions",
        "triage_export_fields",
        "quarantine_export_fields",
        "environment_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "triage_examples",
        "quarantine_examples",
        "environment_examples",
        "offers_suppression_without_evidence",
        "hides_owner_expiry_or_release_impact",
        "implies_safe_environment_equivalence",
        "drops_recent_attempts_or_deltas"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "test_explorer_triage_view",
            "editor_inline_triage",
            "notebook_triage_view",
            "run_panel_triage",
            "quality_report_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "triage_anatomy_parts": { "type": "array", "minItems": 1 },
        "quarantine_anatomy_parts": { "type": "array", "minItems": 1 },
        "environment_anatomy_parts": { "type": "array", "minItems": 1 },
        "failure_categories": { "type": "array", "minItems": 1 },
        "triage_dispositions": { "type": "array", "minItems": 1 },
        "classifier_confidences": { "type": "array", "minItems": 1 },
        "triage_postures": { "type": "array", "minItems": 1 },
        "suppression_kinds": { "type": "array", "minItems": 1 },
        "suppression_scopes": { "type": "array", "minItems": 1 },
        "quarantine_ownership_classes": { "type": "array", "minItems": 1 },
        "release_impacts": { "type": "array", "minItems": 1 },
        "expiry_states": { "type": "array", "minItems": 1 },
        "quarantine_postures": { "type": "array", "minItems": 1 },
        "target_classes": { "type": "array", "minItems": 1 },
        "environment_lanes": { "type": "array", "minItems": 1 },
        "compatibility_classes": { "type": "array", "minItems": 1 },
        "environment_postures": { "type": "array", "minItems": 1 },
        "attempt_lineage_kinds": { "type": "array", "minItems": 1 },
        "result_origins": { "type": "array", "minItems": 1 },
        "triage_actions": { "type": "array", "minItems": 1 },
        "quarantine_actions": { "type": "array", "minItems": 1 },
        "environment_actions": { "type": "array", "minItems": 1 },
        "triage_export_fields": { "type": "array", "minItems": 1 },
        "quarantine_export_fields": { "type": "array", "minItems": 1 },
        "environment_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "triage_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/triage_example" }
        },
        "quarantine_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/quarantine_example" }
        },
        "environment_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/environment_example" }
        },
        "offers_suppression_without_evidence": { "const": false },
        "hides_owner_expiry_or_release_impact": { "const": false },
        "implies_safe_environment_equivalence": { "const": false },
        "drops_recent_attempts_or_deltas": { "const": false }
      }
    },
    "triage_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "failure_category",
            "triage_disposition",
            "result_origin",
            "classifier_confidence",
            "recent_attempts",
            "recent_attempt_count",
            "panel_identity_ref",
            "triage_posture",
            "available_actions",
            "provides_evidence_context",
            "can_rerun",
            "can_debug",
            "can_open_review",
            "needs_attention"
          ]
        }
      }
    },
    "quarantine_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "suppression_kind",
            "suppression_scope",
            "ownership",
            "release_impact",
            "expiry_state",
            "reason_label",
            "owner_label",
            "sheet_identity_ref",
            "review_posture",
            "available_actions",
            "stays_visible",
            "preserves_reason",
            "can_restore"
          ]
        }
      }
    },
    "environment_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "target_class",
            "primary_environment_lane",
            "legs",
            "leg_count",
            "card_identity_ref",
            "card_posture",
            "overall_compatibility",
            "available_actions",
            "has_incompatible_leg",
            "asserts_safe_equivalence",
            "warns_on_incompatibility"
          ]
        }
      }
    }
  }
}
