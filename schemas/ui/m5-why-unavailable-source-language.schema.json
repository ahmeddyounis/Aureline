{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-why-unavailable-source-language.schema.json",
  "title": "Aureline M5 why-unavailable / source-language primitive",
  "description": "Export-safe packet implementing two reusable M5 blocked-action / localized-help primitives — the why-unavailable explanation row and the source-language fallback surface — as one matrix. The packet binds one row per claimed blocked-action / localized consumer — the command-help row, the menu-and-action row, the inline-status row, the settings-and-docs row, and the support explanation export — to both shared anatomies, the frozen blocked-action owners, unavailable reason classes, next-safe-action classes, source-language classes, and fallback-state classes, the derived why-unavailable posture (blocked-by-policy/missing-permission/precondition-unmet/feature-disabled/offline-unavailable/unsupported-target), the failure domain (policy/trust/context/runtime), the localization posture (fully-localized/showing-source-language/partially-localized/stale-localization/citation-preserved-fallback/no-localization), the bounded actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving both resolvers, and four hard invariants: it never collapses distinct blocks into one generic disabled state, never hides its blocking owner or reason, never severs the canonical citation or stable ID, and never drifts into an unsourced paraphrase. Raw error dumps, stack traces, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_why_unavailable_explanation_rows_and_source_language_fallback_surfaces_with_owner_reason_next_safe_action_truth_and_citation_preserving_help_parity_across_claimed_m5_blocked_action_and_localized_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "blocked_localized_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "blocked_localized_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "why_unavailable_anatomy_parts",
        "source_language_anatomy_parts",
        "blocked_action_owners",
        "unavailable_reason_classes",
        "next_safe_action_classes",
        "failure_domains",
        "why_unavailable_postures",
        "why_unavailable_actions",
        "source_language_classes",
        "fallback_state_classes",
        "source_language_postures",
        "source_language_actions",
        "why_unavailable_export_fields",
        "source_language_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "why_unavailable_examples",
        "source_language_examples",
        "collapses_into_generic_disabled_state",
        "hides_blocking_owner_or_reason",
        "severs_canonical_citation_or_id",
        "drifts_into_unsourced_paraphrase"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "command_help_row",
            "menu_and_action_row",
            "inline_status_row",
            "settings_and_docs_row",
            "support_explanation_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "why_unavailable_anatomy_parts": { "type": "array", "minItems": 1 },
        "source_language_anatomy_parts": { "type": "array", "minItems": 1 },
        "blocked_action_owners": { "type": "array", "minItems": 1 },
        "unavailable_reason_classes": { "type": "array", "minItems": 1 },
        "next_safe_action_classes": { "type": "array", "minItems": 1 },
        "failure_domains": { "type": "array", "minItems": 1 },
        "why_unavailable_postures": { "type": "array", "minItems": 1 },
        "why_unavailable_actions": { "type": "array", "minItems": 1 },
        "source_language_classes": { "type": "array", "minItems": 1 },
        "fallback_state_classes": { "type": "array", "minItems": 1 },
        "source_language_postures": { "type": "array", "minItems": 1 },
        "source_language_actions": { "type": "array", "minItems": 1 },
        "why_unavailable_export_fields": { "type": "array", "minItems": 1 },
        "source_language_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "why_unavailable_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/why_unavailable_example" }
        },
        "source_language_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_language_example" }
        },
        "collapses_into_generic_disabled_state": { "const": false },
        "hides_blocking_owner_or_reason": { "const": false },
        "severs_canonical_citation_or_id": { "const": false },
        "drifts_into_unsourced_paraphrase": { "const": false }
      }
    },
    "why_unavailable_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "unavailable_reason",
            "blocking_owner",
            "next_safe_action",
            "blocked_action_ref",
            "next_safe_action_ref",
            "deeper_docs_ref",
            "screen_reader_announcement",
            "row_identity_ref",
            "help_posture",
            "failure_domain",
            "available_actions",
            "has_next_safe_action",
            "owner_is_contactable",
            "reason_is_transient",
            "docs_available",
            "evidence_export_available",
            "names_blocked_action",
            "names_exact_reason",
            "names_owning_boundary",
            "names_next_safe_action_or_states_none",
            "links_deeper_docs",
            "never_generic_disabled",
            "never_requires_pointer_hover",
            "provides_screen_reader_announcement",
            "preserves_docs_path_honestly"
          ]
        }
      }
    },
    "source_language_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "source_language_class",
            "fallback_state",
            "display_locale",
            "stable_id_ref",
            "canonical_citation_ref",
            "source_language_text_ref",
            "screen_reader_announcement",
            "row_identity_ref",
            "help_posture",
            "available_actions",
            "shows_source_language",
            "is_incomplete_or_stale",
            "is_fully_localized",
            "requires_source_text",
            "citation_available",
            "locale_export_available",
            "preserves_source_language_text",
            "preserves_stable_id",
            "preserves_canonical_citation",
            "names_localization_state",
            "never_unsourced_paraphrase",
            "never_requires_pointer_hover",
            "provides_screen_reader_announcement",
            "aligned_with_canonical_ids"
          ]
        }
      }
    }
  }
}
