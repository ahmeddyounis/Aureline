{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-deployment-continuity-component-matrix.schema.json",
  "title": "M5 Deployment/Continuity Component Matrix",
  "description": "Frozen reusable deployment/continuity component matrix: install-profile cards, side-by-side import sheets, rollout-ring rows, deployment summary cards, residual-dependency rows, control-plane/data-plane status strips, mirror/offline artifact rows, mode-change review sheets, and channel-association review rows. One packet defines every reusable primitive, its state vocabulary, its required labels, and its export/assistive parity expectations so later M5 rows reference one canonical component family instead of restating install/deployment truth in feature-local prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "set_label",
    "components",
    "guardrails",
    "consumer_projection",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_deployment_continuity_component_matrix"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "set_label": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component_row" }
    },
    "guardrails": { "$ref": "#/definitions/guardrails" },
    "consumer_projection": { "$ref": "#/definitions/consumer_projection" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "deployment_mode": {
      "type": "string",
      "enum": ["desktop", "managed", "self_hosted", "portable", "air_gapped"]
    },
    "truth_mode": {
      "type": "string",
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_reported"]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "operating_mode",
        "ownership_or_scope",
        "freshness_class",
        "continuity_state",
        "keyboard_route"
      ]
    },
    "component_family": {
      "type": "string",
      "enum": [
        "install_profile_card",
        "side_by_side_import_sheet",
        "rollout_ring_row",
        "deployment_summary_card",
        "residual_dependency_row",
        "control_plane_data_plane_status_strip",
        "mirror_offline_artifact_row",
        "mode_change_review_sheet",
        "channel_association_review_row"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "control_plane_impaired",
        "mirror_stale",
        "offline_cache_only",
        "signature_unverified",
        "rollout_paused",
        "handler_ownership_contested",
        "state_root_unavailable",
        "residual_vendor_dependency",
        "provenance_incomplete"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/definitions/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "install_profile_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install_id_ref",
        "install_mode",
        "channel_ref",
        "updater_owner_ref",
        "state_root_ref",
        "discloses_state_roots",
        "discloses_updater_owner"
      ],
      "properties": {
        "install_id_ref": { "type": "string", "minLength": 1 },
        "install_mode": { "$ref": "#/definitions/deployment_mode" },
        "channel_ref": { "type": "string", "minLength": 1 },
        "updater_owner_ref": { "type": "string", "minLength": 1 },
        "state_root_ref": { "type": "string", "minLength": 1 },
        "discloses_state_roots": { "type": "boolean" },
        "discloses_updater_owner": { "type": "boolean" }
      }
    },
    "side_by_side_import_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_source_ref",
        "handler_ownership_ref",
        "last_writer_wins_capture",
        "discloses_handler_ownership",
        "isolation_preserved"
      ],
      "properties": {
        "import_source_ref": { "type": "string", "minLength": 1 },
        "handler_ownership_ref": { "type": "string", "minLength": 1 },
        "last_writer_wins_capture": { "type": "boolean" },
        "discloses_handler_ownership": { "type": "boolean" },
        "isolation_preserved": { "type": "boolean" }
      }
    },
    "rollout_ring_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ring",
        "promotion_state",
        "target_scope_ref",
        "rollback_available",
        "discloses_ring"
      ],
      "properties": {
        "ring": {
          "type": "string",
          "enum": ["canary", "early_adopter", "broad", "general_availability", "paused"]
        },
        "promotion_state": {
          "type": "string",
          "enum": ["held", "promoting", "promoted", "rolled_back", "blocked"]
        },
        "target_scope_ref": { "type": "string", "minLength": 1 },
        "rollback_available": { "type": "boolean" },
        "discloses_ring": { "type": "boolean" }
      }
    },
    "deployment_summary_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_region_ref",
        "operating_mode",
        "control_plane_visible",
        "data_plane_visible"
      ],
      "properties": {
        "tenant_region_ref": { "type": "string", "minLength": 1 },
        "operating_mode": { "$ref": "#/definitions/deployment_mode" },
        "control_plane_visible": { "type": "boolean" },
        "data_plane_visible": { "type": "boolean" }
      }
    },
    "residual_dependency_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor_dependency_ref",
        "dependency_class",
        "required_for_operation",
        "discloses_residual"
      ],
      "properties": {
        "vendor_dependency_ref": { "type": "string", "minLength": 1 },
        "dependency_class": {
          "type": "string",
          "enum": [
            "license_activation",
            "update_delivery",
            "identity_provider",
            "telemetry_channel",
            "model_inference_service"
          ]
        },
        "required_for_operation": { "type": "boolean" },
        "discloses_residual": { "type": "boolean" }
      }
    },
    "control_plane_data_plane_status_strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_plane_state",
        "data_plane_state",
        "local_runtime_unaffected",
        "impairment_not_masked_as_local_failure"
      ],
      "properties": {
        "control_plane_state": { "$ref": "#/definitions/plane_state" },
        "data_plane_state": { "$ref": "#/definitions/plane_state" },
        "local_runtime_unaffected": { "type": "boolean" },
        "impairment_not_masked_as_local_failure": { "type": "boolean" }
      }
    },
    "plane_state": {
      "type": "string",
      "enum": ["operational", "degraded", "unavailable", "unknown"]
    },
    "mirror_offline_artifact_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mirror_source_ref",
        "freshness",
        "signature_state",
        "discloses_freshness",
        "stale_not_shown_as_current"
      ],
      "properties": {
        "mirror_source_ref": { "type": "string", "minLength": 1 },
        "freshness": { "$ref": "#/definitions/truth_mode" },
        "signature_state": {
          "type": "string",
          "enum": ["verified", "unverified", "signature_mismatch", "verification_deferred"]
        },
        "discloses_freshness": { "type": "boolean" },
        "stale_not_shown_as_current": { "type": "boolean" }
      }
    },
    "mode_change_review_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_mode",
        "to_mode",
        "boundary_change",
        "reviewed_before_durable_change",
        "discloses_cache_and_rollback"
      ],
      "properties": {
        "from_mode": { "$ref": "#/definitions/deployment_mode" },
        "to_mode": { "$ref": "#/definitions/deployment_mode" },
        "boundary_change": {
          "type": "string",
          "enum": [
            "state_root_migration",
            "channel_switch",
            "updater_ownership_change",
            "mirror_reattach",
            "online_offline_transition"
          ]
        },
        "reviewed_before_durable_change": { "type": "boolean" },
        "discloses_cache_and_rollback": { "type": "boolean" }
      }
    },
    "channel_association_review_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_ref",
        "handler_association_ref",
        "last_writer_wins_capture",
        "reviewed_before_apply",
        "discloses_current_owner"
      ],
      "properties": {
        "channel_ref": { "type": "string", "minLength": 1 },
        "handler_association_ref": { "type": "string", "minLength": 1 },
        "last_writer_wins_capture": { "type": "boolean" },
        "reviewed_before_apply": { "type": "boolean" },
        "discloses_current_owner": { "type": "boolean" }
      }
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "family",
        "surface_label",
        "truth_mode",
        "deployment_mode",
        "operating_context_ref",
        "required_labels",
        "export_safe",
        "assistive_ready",
        "label_summary",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/definitions/component_family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/definitions/truth_mode" },
        "deployment_mode": { "$ref": "#/definitions/deployment_mode" },
        "operating_context_ref": { "type": "string", "minLength": 1 },
        "required_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/required_label" }
        },
        "export_safe": { "type": "boolean", "const": true },
        "assistive_ready": { "type": "boolean", "const": true },
        "install_profile_card": { "$ref": "#/definitions/install_profile_card" },
        "side_by_side_import_sheet": { "$ref": "#/definitions/side_by_side_import_sheet" },
        "rollout_ring_row": { "$ref": "#/definitions/rollout_ring_row" },
        "deployment_summary_card": { "$ref": "#/definitions/deployment_summary_card" },
        "residual_dependency_row": { "$ref": "#/definitions/residual_dependency_row" },
        "control_plane_data_plane_status_strip": {
          "$ref": "#/definitions/control_plane_data_plane_status_strip"
        },
        "mirror_offline_artifact_row": { "$ref": "#/definitions/mirror_offline_artifact_row" },
        "mode_change_review_sheet": { "$ref": "#/definitions/mode_change_review_sheet" },
        "channel_association_review_row": {
          "$ref": "#/definitions/channel_association_review_row"
        },
        "degraded": { "$ref": "#/definitions/degraded_state" },
        "label_summary": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_truth_explicit_on_every_surface",
        "no_last_writer_wins_handler_capture",
        "control_plane_impairment_never_masked_as_local",
        "mirror_offline_freshness_never_shown_as_current",
        "self_hosted_never_omits_residual_dependency",
        "mode_changes_reviewed_before_durable_change",
        "exported_evidence_preserves_ids_modes_and_states",
        "components_bound_to_shared_vocabulary",
        "no_new_installers_engines_or_protocols"
      ],
      "properties": {
        "operating_truth_explicit_on_every_surface": { "type": "boolean", "const": true },
        "no_last_writer_wins_handler_capture": { "type": "boolean", "const": true },
        "control_plane_impairment_never_masked_as_local": { "type": "boolean", "const": true },
        "mirror_offline_freshness_never_shown_as_current": { "type": "boolean", "const": true },
        "self_hosted_never_omits_residual_dependency": { "type": "boolean", "const": true },
        "mode_changes_reviewed_before_durable_change": { "type": "boolean", "const": true },
        "exported_evidence_preserves_ids_modes_and_states": { "type": "boolean", "const": true },
        "components_bound_to_shared_vocabulary": { "type": "boolean", "const": true },
        "no_new_installers_engines_or_protocols": { "type": "boolean", "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ingests_components",
        "docs_help_ingests_components",
        "diagnostics_ingests_components",
        "admin_ingests_components",
        "support_export_ingests_components",
        "release_control_ingests_components",
        "later_rows_reference_one_canonical_family"
      ],
      "properties": {
        "product_ingests_components": { "type": "boolean", "const": true },
        "docs_help_ingests_components": { "type": "boolean", "const": true },
        "diagnostics_ingests_components": { "type": "boolean", "const": true },
        "admin_ingests_components": { "type": "boolean", "const": true },
        "support_export_ingests_components": { "type": "boolean", "const": true },
        "release_control_ingests_components": { "type": "boolean", "const": true },
        "later_rows_reference_one_canonical_family": { "type": "boolean", "const": true }
      }
    }
  }
}
