{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-bundle-rollback-remove-primitive.schema.json",
  "title": "Aureline M5 bundle rollback / remove primitive",
  "description": "Canonical parity matrix for the reusable M5 bundle rollback / remove primitive: a rollback / remove card, a created-versus-adopted asset inventory, and a restore path (checkpoint restore + export-before-remove) that all resolve from one removal context and share one removal identity. Narrows the bundle_rollback_remove_card family of the frozen M5 workflow-bundle component matrix into one working resolver focused on removal. Bundle removal no longer implies destructive cleanup of user-created work or hidden state roots (AC1); rollback and remove actions state what remains, what is reverted, and what must be handled manually (AC2); export-before-remove and checkpoint restore are available wherever removal could narrow support or portability truth (AC3). A mutating remove always creates a one-step checkpoint before mutating. Raw manifest bytes, credentials, entitlement tokens, mirror URLs, and provider cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_bundle_rollback_remove_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "workspace_rollback_card",
        "bundle_detail_remove_panel",
        "extension_remove_row",
        "migration_rollback_view",
        "diagnostics_removal_report",
        "support_export_replay"
      ]
    },
    "asset_origin": {
      "enum": [
        "bundle_created",
        "user_created_file",
        "user_profile",
        "local_history",
        "imported_setting",
        "adopted_package"
      ]
    },
    "safe_to_remove_class": {
      "enum": ["safe_to_remove", "keep_local", "requires_manual_handling"]
    },
    "disposition": {
      "enum": ["reverted", "kept_local", "manual_follow_up"]
    },
    "export_field": {
      "enum": [
        "removal_id",
        "bundle_identity",
        "operation",
        "asset_inventory",
        "safe_to_remove_classes",
        "rollback_checkpoint",
        "export_before_remove",
        "mirror_offline_posture"
      ]
    },
    "side_effect_class": {
      "enum": [
        "extension_install",
        "settings_profile_write",
        "task_recipe_registration",
        "docs_tour_pack_install",
        "toolchain_install",
        "scaffold_generation"
      ]
    },
    "component_kind": {
      "enum": [
        "extension",
        "profile_preset",
        "layout_preset",
        "settings_preset",
        "task_recipe",
        "launch_recipe",
        "debug_recipe",
        "docs_pack",
        "tour_pack",
        "template_ref",
        "scaffold_ref",
        "migration_mapping"
      ]
    },
    "review_operation": {
      "enum": ["install", "update", "remove", "drift_review"]
    },
    "asset_ownership": {
      "enum": [
        "bundle_owned",
        "locally_overridden",
        "adopted",
        "removable",
        "blocked_by_policy",
        "blocked_by_lifecycle"
      ]
    },
    "source_class": {
      "enum": [
        "certified",
        "managed_approved",
        "community_reviewed",
        "imported_pending_review",
        "local_draft"
      ]
    },
    "bundle_class": {
      "enum": [
        "launch_bundle",
        "framework_pack",
        "template_bundle",
        "imported_handoff_bundle",
        "org_managed_bundle",
        "no_bundle"
      ]
    },
    "signer_source": {
      "enum": ["first_party", "trusted_remote", "unverified_remote", "untrusted"]
    },
    "support_class": {
      "enum": [
        "stable",
        "preview",
        "labs",
        "policy_gated",
        "mirror_only",
        "bounded_platform"
      ]
    },
    "scorecard_class": {
      "enum": ["certified", "probable", "community", "imported", "preview", "local_draft"]
    },
    "freshness_state": {
      "enum": ["fresh", "aging", "stale", "missing"]
    },
    "imported_confidence": {
      "enum": ["native", "bridged", "approximated", "unverified"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_supplied"]
    },
    "downgrade_trigger": {
      "enum": [
        "stale_certification",
        "mirror_stale",
        "offline_cache_only",
        "unverified_signer",
        "local_override_drift",
        "incompatible_aureline",
        "entitlement_dependency_unmet",
        "imported_not_native",
        "rollback_only_path"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "nullable_degraded_state": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/degraded_state" }]
    },
    "rollback_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_ref",
        "one_step",
        "reversible",
        "captured_before_mutation",
        "captured_component_count"
      ],
      "properties": {
        "checkpoint_ref": { "$ref": "#/$defs/ref" },
        "one_step": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "captured_before_mutation": { "type": "boolean" },
        "captured_component_count": { "type": "integer", "minimum": 0 }
      }
    },
    "nullable_rollback_checkpoint": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rollback_checkpoint" }]
    },
    "export_before_remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_ref", "format_label", "captures_user_assets", "available"],
      "properties": {
        "export_ref": { "$ref": "#/$defs/ref" },
        "format_label": { "type": "string", "minLength": 1 },
        "captures_user_assets": { "type": "boolean" },
        "available": { "type": "boolean" }
      }
    },
    "nullable_export_before_remove": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/export_before_remove" }]
    },
    "removal_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "component_kind",
        "target_ref",
        "label",
        "ownership",
        "safe_to_remove_class",
        "disposition",
        "explicitly_selected_for_removal"
      ],
      "properties": {
        "origin": { "$ref": "#/$defs/asset_origin" },
        "component_kind": { "$ref": "#/$defs/component_kind" },
        "target_ref": { "$ref": "#/$defs/ref" },
        "label": { "type": "string", "minLength": 1 },
        "ownership": { "$ref": "#/$defs/asset_ownership" },
        "safe_to_remove_class": { "$ref": "#/$defs/safe_to_remove_class" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "explicitly_selected_for_removal": { "type": "boolean" }
      }
    },
    "removal_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removal_id",
        "surface_label",
        "bundle_id_ref",
        "bundle_name",
        "bundle_class",
        "signer_source",
        "support_class",
        "source_class",
        "scorecard_class",
        "certification_freshness",
        "imported_confidence",
        "compatible_aureline_range",
        "truth_mode",
        "operation",
        "assets",
        "side_effects",
        "reads_like_destructive_cleanup",
        "claims_current_despite_stale",
        "forces_reset_to_export"
      ],
      "properties": {
        "removal_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/signer_source" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "scorecard_class": { "$ref": "#/$defs/scorecard_class" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "imported_confidence": { "$ref": "#/$defs/imported_confidence" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "operation": { "$ref": "#/$defs/review_operation" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/removal_asset" }
        },
        "side_effects": { "type": "array", "items": { "$ref": "#/$defs/side_effect_class" } },
        "rollback_checkpoint": { "$ref": "#/$defs/rollback_checkpoint" },
        "export_before_remove": { "$ref": "#/$defs/export_before_remove" },
        "reads_like_destructive_cleanup": { "const": false },
        "claims_current_despite_stale": { "const": false },
        "forces_reset_to_export": { "const": false },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removal_id",
        "bundle_id_ref",
        "bundle_name",
        "operation",
        "side_effects",
        "reverted",
        "kept_local",
        "manual_follow_up",
        "discloses_what_remains",
        "discloses_what_is_reverted",
        "discloses_manual_follow_up",
        "implies_destructive_cleanup"
      ],
      "properties": {
        "removal_id": { "$ref": "#/$defs/id" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/review_operation" },
        "side_effects": { "type": "array", "items": { "$ref": "#/$defs/side_effect_class" } },
        "reverted": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "kept_local": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "manual_follow_up": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "discloses_what_remains": { "const": true },
        "discloses_what_is_reverted": { "const": true },
        "discloses_manual_follow_up": { "const": true },
        "implies_destructive_cleanup": { "const": false }
      }
    },
    "resolved_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removal_id",
        "assets",
        "origins_present",
        "safe_to_remove_classes_present",
        "bundle_created_count",
        "user_owned_count",
        "distinguishes_created_from_adopted",
        "preserves_user_assets",
        "collapses_to_opaque_removal"
      ],
      "properties": {
        "removal_id": { "$ref": "#/$defs/id" },
        "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/removal_asset" } },
        "origins_present": { "type": "array", "items": { "$ref": "#/$defs/asset_origin" } },
        "safe_to_remove_classes_present": {
          "type": "array",
          "items": { "$ref": "#/$defs/safe_to_remove_class" }
        },
        "bundle_created_count": { "type": "integer", "minimum": 0 },
        "user_owned_count": { "type": "integer", "minimum": 0 },
        "distinguishes_created_from_adopted": { "const": true },
        "preserves_user_assets": { "const": true },
        "collapses_to_opaque_removal": { "const": false }
      }
    },
    "resolved_restore_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removal_id",
        "rollback_checkpoint",
        "export_before_remove",
        "provides_checkpoint_restore",
        "provides_export_before_remove",
        "narrows_support_or_portability",
        "forces_reset"
      ],
      "properties": {
        "removal_id": { "$ref": "#/$defs/id" },
        "rollback_checkpoint": { "$ref": "#/$defs/nullable_rollback_checkpoint" },
        "export_before_remove": { "$ref": "#/$defs/nullable_export_before_remove" },
        "provides_checkpoint_restore": { "type": "boolean" },
        "provides_export_before_remove": { "type": "boolean" },
        "narrows_support_or_portability": { "type": "boolean" },
        "forces_reset": { "const": false }
      }
    },
    "resolved_removal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removal_id",
        "card",
        "inventory",
        "restore_path",
        "non_destructive_of_user_work",
        "states_remains_reverted_manual",
        "export_and_restore_available"
      ],
      "properties": {
        "removal_id": { "$ref": "#/$defs/id" },
        "card": { "$ref": "#/$defs/resolved_card" },
        "inventory": { "$ref": "#/$defs/resolved_inventory" },
        "restore_path": { "$ref": "#/$defs/resolved_restore_path" },
        "non_destructive_of_user_work": { "const": true },
        "states_remains_reverted_manual": { "const": true },
        "export_and_restore_available": { "const": true },
        "degraded": { "$ref": "#/$defs/nullable_degraded_state" }
      }
    },
    "removal_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/removal_input" },
        "resolved": { "$ref": "#/$defs/resolved_removal" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "operations",
        "source_classes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_removals",
        "implies_destructive_cleanup",
        "collapses_to_opaque_removal",
        "forces_reset_to_export"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/review_operation" }
        },
        "source_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_class" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_removals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/removal_case" }
        },
        "implies_destructive_cleanup": { "const": false },
        "collapses_to_opaque_removal": { "const": false },
        "forces_reset_to_export": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "asset_origins",
        "safe_to_remove_classes",
        "dispositions",
        "export_fields",
        "side_effect_classes",
        "review_operations",
        "asset_ownerships",
        "component_kinds",
        "source_classes",
        "bundle_classes",
        "signer_sources",
        "support_classes",
        "scorecard_classes",
        "freshness_states",
        "imported_confidences",
        "truth_modes",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "asset_origins": { "type": "array", "items": { "type": "string" } },
        "safe_to_remove_classes": { "type": "array", "items": { "type": "string" } },
        "dispositions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "side_effect_classes": { "type": "array", "items": { "type": "string" } },
        "review_operations": { "type": "array", "items": { "type": "string" } },
        "asset_ownerships": { "type": "array", "items": { "type": "string" } },
        "component_kinds": { "type": "array", "items": { "type": "string" } },
        "source_classes": { "type": "array", "items": { "type": "string" } },
        "bundle_classes": { "type": "array", "items": { "type": "string" } },
        "signer_sources": { "type": "array", "items": { "type": "string" } },
        "support_classes": { "type": "array", "items": { "type": "string" } },
        "scorecard_classes": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "imported_confidences": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "removal_identity_preserved_across_surfaces",
        "removal_non_destructive_of_user_work",
        "states_remains_reverted_manual",
        "created_versus_adopted_distinguished",
        "checkpoint_restore_before_mutation",
        "export_before_remove_available_when_narrowing",
        "support_export_reconstructs_removal",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "removal_identity_preserved_across_surfaces": { "const": true },
        "removal_non_destructive_of_user_work": { "const": true },
        "states_remains_reverted_manual": { "const": true },
        "created_versus_adopted_distinguished": { "const": true },
        "checkpoint_restore_before_mutation": { "const": true },
        "export_before_remove_available_when_narrowing": { "const": true },
        "support_export_reconstructs_removal": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removal_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "inventory_reads_single_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "removal_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "inventory_reads_single_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "removal_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "removal_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
