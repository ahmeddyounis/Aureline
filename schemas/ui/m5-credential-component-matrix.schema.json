{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-credential-component-matrix.schema.json",
  "title": "Aureline M5 credential-state-row, secret-access-prompt-sheet, vault-or-keychain-picker, credential-store-capability-row, browser-device-code-handoff-card, delegated-credential-row, rotation-revoke-event-row, and export-safety-banner component matrix",
  "description": "Export-safe packet freezing Aureline's reusable credential / auth-boundary components. The packet names every credential-bearing component family M5 claims that still drifts too easily by surface — credential-state rows, secret-access-prompt sheets, vault-or-keychain pickers, credential-store-capability rows, browser/device-code handoff cards, delegated-credential rows, rotation/revoke-event rows, and export-safety banners — and binds each to the claimed M5 surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, the degraded states it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: storage modes (os_keychain, encrypted_vault, secret_broker_handle, session_memory_only, external_reference, no_secret_stored), credential classes, reveal postures, auth-handoff classes, delegated-identity states, credential lifecycle (expiry / refresh / rotation / revoke) states, store capabilities, and raw-secret-excluded export-safety classes. Hard invariants forbid masking a storage mode or reveal posture, hiding a forwarded / delegated identity, inventing an alternate label for a governed state, and implying a raw secret is export-safe. Raw secret values, pasted tokens, passphrases, and private endpoints never cross this boundary. The Rust validator in crates/aureline-provider is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_credential_state_row_secret_access_prompt_sheet_vault_or_keychain_picker_credential_store_capability_row_browser_device_code_handoff_card_delegated_credential_row_rotation_revoke_event_row_and_export_safety_banner_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "credential_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "credential_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "credential_state_row",
        "secret_access_prompt_sheet",
        "vault_or_keychain_picker",
        "credential_store_capability_row",
        "browser_device_code_handoff_card",
        "delegated_credential_row",
        "rotation_revoke_event_row",
        "export_safety_banner"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "degraded_states",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_storage_or_reveal_posture",
        "hides_identity_delegation",
        "invents_alternate_state_label",
        "implies_raw_secret_exportable"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "degraded_states": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_storage_or_reveal_posture": { "const": false },
        "hides_identity_delegation": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "implies_raw_secret_exportable": { "const": false }
      }
    }
  }
}
