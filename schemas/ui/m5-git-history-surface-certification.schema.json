{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-git-history-surface-certification.schema.json",
  "title": "M5 Git-History Surface Certification",
  "description": "Surface certification that the twelve shared M5 Git-history and risky-mutation components (commit-graph-header, history-graph-row, branch-comparison-chip, worktree-row, stash-entry, reflog-recovery-banner, rebase-todo-row, sequence-editor-header, cherry-pick/revert review-sheet, patch-apply review-sheet, conflict-checkpoint-card, force-push review-dialog) present the same controlled component truth on every claimed M5 Git-history surface, with no hidden ref/worktree/recovery drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "certification_label",
    "surface_rows",
    "summary",
    "downgrade_triggers",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_git_history_surface_certification_truth" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "certification_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "commit_graph_header",
        "history_graph_row",
        "branch_comparison_chip",
        "worktree_row",
        "stash_entry",
        "reflog_recovery_banner",
        "rebase_todo_row",
        "sequence_editor_header",
        "cherry_pick_revert_review_sheet",
        "patch_apply_review_sheet",
        "conflict_checkpoint_card",
        "force_push_review_dialog"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "history_sidebar",
        "risky_mutation_sheet",
        "review_workspace",
        "help_git_surface",
        "support_export",
        "exported_recovery_packet",
        "cli_headless",
        "diagnostics"
      ]
    },
    "axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "local_recovery_provenance"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "narrowed_certified", "not_certified_here"]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "recoverable_in_product",
        "locally_recoverable",
        "partial_history_only",
        "reflog_only_recovery",
        "local_continue_only"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["certified_parity", "narrowed_parity", "parity_blocked"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "evidence_packet_invalid",
        "policy_blocked",
        "provider_review_state_stale",
        "repo_topology_partial",
        "checkpoint_recovery_unavailable",
        "offline_local_only",
        "worktree_divergence_unresolved",
        "trust_narrowing",
        "upstream_dependency_narrowed"
      ]
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "note"],
      "properties": {
        "axis": { "$ref": "#/$defs/axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface",
        "components_present",
        "claimed_claim",
        "certified_claim",
        "status",
        "axis_outcomes",
        "narrowed_axes",
        "downgrade_trigger",
        "component_truth_preserved",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "components_present": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "claimed_claim": { "$ref": "#/$defs/claim_tier" },
        "certified_claim": { "$ref": "#/$defs/claim_tier" },
        "status": { "$ref": "#/$defs/status" },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "narrowed_axes": {
          "type": "array",
          "items": { "$ref": "#/$defs/axis" }
        },
        "downgrade_trigger": {
          "oneOf": [{ "$ref": "#/$defs/downgrade_trigger" }, { "type": "null" }]
        },
        "component_truth_preserved": { "type": "boolean" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "component_truth_preserved": { "const": false } } },
          "then": { "properties": { "status": { "const": "parity_blocked" } } }
        },
        {
          "if": {
            "properties": { "narrowed_axes": { "minItems": 1 } }
          },
          "then": {
            "properties": { "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" } }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "certified_count",
        "narrowed_count",
        "blocked_count",
        "all_rows_preserve_component_truth",
        "all_surfaces_covered",
        "all_components_covered",
        "certification_note"
      ],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "certified_count": { "type": "integer", "minimum": 0 },
        "narrowed_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "all_rows_preserve_component_truth": { "type": "boolean" },
        "all_surfaces_covered": { "type": "boolean" },
        "all_components_covered": { "type": "boolean" },
        "certification_note": { "type": "string", "minLength": 1 }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_component_truth_on_every_surface",
        "ref_worktree_identity_explicit",
        "topology_state_explicit",
        "stash_and_sequence_intent_explicit",
        "patch_target_and_approval_invalidation_explicit",
        "certified_never_implies_fresh",
        "recovery_destination_explicit_local_kept",
        "local_continuation_preserved",
        "narrows_instead_of_dropping_meaning",
        "flattened_truth_blocks_certification"
      ],
      "properties": {
        "same_component_truth_on_every_surface": { "const": true },
        "ref_worktree_identity_explicit": { "const": true },
        "topology_state_explicit": { "const": true },
        "stash_and_sequence_intent_explicit": { "const": true },
        "patch_target_and_approval_invalidation_explicit": { "const": true },
        "certified_never_implies_fresh": { "const": true },
        "recovery_destination_explicit_local_kept": { "const": true },
        "local_continuation_preserved": { "const": true },
        "narrows_instead_of_dropping_meaning": { "const": true },
        "flattened_truth_blocks_certification": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_sidebar_shows_certification",
        "risky_mutation_sheet_shows_certification",
        "review_workspace_shows_certification",
        "help_git_surface_shows_certification",
        "support_export_shows_certification",
        "exported_recovery_packet_shows_certification",
        "cli_headless_shows_certification",
        "diagnostics_shows_certification",
        "narrowed_surfaces_visibly_labelled"
      ],
      "properties": {
        "history_sidebar_shows_certification": { "const": true },
        "risky_mutation_sheet_shows_certification": { "const": true },
        "review_workspace_shows_certification": { "const": true },
        "help_git_surface_shows_certification": { "const": true },
        "support_export_shows_certification": { "const": true },
        "exported_recovery_packet_shows_certification": { "const": true },
        "cli_headless_shows_certification": { "const": true },
        "diagnostics_shows_certification": { "const": true },
        "narrowed_surfaces_visibly_labelled": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
