{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-framework-component-accessibility-fallback.schema.json",
  "title": "Aureline M5 framework-component accessibility & auto-narrowing fallback",
  "description": "Export-safe packet for the M05-1042 accessibility / keyboard / screen-reader / CLI / export parity and honest auto-narrowing capstone over the frozen M5 framework-component matrix. Each row certifies one of the seven canonical component families (framework pack header, route / endpoint row, component / service tree node, convention-diagnostic row, generator preview sheet, run-config scaffold card, derived-relationship banner) as keyboard-complete, assistive-tech-reachable, CLI/export-safe, and self-narrowing. When a framework pack's health cannot be proven, a supported version range cannot be proven for the active project, a proving-source linkage is missing, a relationship is only heuristically inferred, or a generator-effect truth is only partial, the component's exactness claim auto-narrows from exact_framework_truth to an unverified-pack / unproven-version-range / unlinked-source / heuristic-inference / partial-generator-effect projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical pack / certainty source, proving-source linkage, execution boundary, and rollback / regenerate recovery boundary. An unproven-version-range / unlinked-source / heuristic-inference / partial-generator-effect state never masquerades as exact framework truth — incomplete evidence never invents exact certainty. The packet is metadata-only: raw generated file bodies, credentials, tokens, and secret values never cross this boundary, and a raw value is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_framework_component_accessibility_fallback_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "framework_pack_header",
        "route_endpoint_row",
        "component_service_tree_node",
        "convention_diagnostic_row",
        "generator_preview_sheet",
        "run_config_scaffold_card",
        "derived_relationship_banner"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_value",
        "disclosed_partial_capture",
        "requires_raw_value"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "framework_claim": {
      "type": "string",
      "enum": [
        "exact_framework_truth",
        "unproven_version_range_projection",
        "unverified_pack_projection",
        "unlinked_source_projection",
        "heuristic_inference_projection",
        "partial_generator_effect_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "pack_health_integrity",
        "supported_version_range",
        "proving_source_linkage",
        "heuristic_inference_boundary",
        "generator_effect_evidence"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "framework_verified_exact",
        "pack_health_unproven",
        "version_range_unproven",
        "source_linkage_unproven",
        "heuristic_inference_only",
        "generator_effect_partial"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "pack_identity_unstated",
        "support_class_unstated",
        "exact_versus_heuristic_unstated",
        "authorship_unstated",
        "execution_boundary_unstated",
        "impact_undisclosed",
        "proving_source_omitted",
        "rollback_path_omitted",
        "derived_state_unlabeled",
        "convention_confidence_overstated",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "pack_source_and_certainty",
        "execution_boundary_and_impact",
        "proving_source_and_recovery_boundary"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "framework_pack_ui",
        "route_explorer_ui",
        "topology_ui",
        "diagnostic_center_ui",
        "generator_review_ui",
        "run_config_ui",
        "editor_gutter_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_source_and_recovery"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/framework_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_source_and_recovery": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_value_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_value_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "framework_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_framework_claim",
        "claim_conditions",
        "source_and_recovery_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_framework_component_accessibility_fallback_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "framework_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_framework_claim": { "$ref": "#/$defs/framework_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "source_and_recovery_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "hierarchy_heavy_family_count",
        "all_hierarchy_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_exactness_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_source_and_recovery_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "hierarchy_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_hierarchy_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_exactness_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_source_and_recovery_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
