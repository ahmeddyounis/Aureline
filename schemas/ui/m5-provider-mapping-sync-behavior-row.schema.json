{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-provider-mapping-sync-behavior-row.schema.json",
  "title": "Aureline M5 provider mapping / sync-behavior row primitive",
  "description": "Export-safe packet shipping the reusable M5 project/board mapping row and sync-behavior row as two primitives. The packet binds one row per claimed provider surface consumer — the mapping-picker panel, the sync-behavior panel, the provider status bar, the headless/CLI mappings surface, and the support mapping export — to the shared mapping-row and sync-row anatomy, the mapping origin, the derived mapping scope (inherited/local/policy/unmapped), the mapping target kind, the derived mapping-row posture, the lock note, bounded reveal/change/reset/export mapping actions, the provider sync mode, the effective write scope, the derived sync-behavior class (full-bidirectional/comment-link/status-transition/read-only-metadata/offline-capture-only/paused), the visible queued-draft state, and bounded reveal/change-mode/view-queue/retry-publish/export sync actions. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked mapping and sync resolution cases proving the resolvers, and four hard invariants: it never assumes a default publish destination silently, never masks its mapping origin or lock, never collapses its sync behavior into one generic synced label, and never hides its local-draft queue state. Raw comment bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "ship_m5_project_or_board_mapping_rows_and_sync_behavior_rows_with_inherited_local_policy_scope_read_only_comment_transition_sync_modes_and_change_reset_parity_across_claimed_m5_provider_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "provider_mapping_sync_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "provider_mapping_sync_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "mapping_anatomy_parts",
        "sync_anatomy_parts",
        "mapping_target_kinds",
        "mapping_origins",
        "mapping_scopes",
        "mapping_row_postures",
        "mapping_row_actions",
        "sync_modes",
        "write_scopes",
        "sync_behavior_classes",
        "queued_draft_states",
        "sync_row_actions",
        "mapping_export_fields",
        "sync_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "mapping_examples",
        "sync_examples",
        "assumes_default_destination_silently",
        "masks_mapping_origin_or_lock",
        "collapses_sync_into_generic_synced",
        "hides_local_draft_queue_state"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "mapping_picker_panel",
            "sync_behavior_panel",
            "provider_status_bar",
            "headless_cli_mappings",
            "support_mapping_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "mapping_anatomy_parts": { "type": "array", "minItems": 1 },
        "sync_anatomy_parts": { "type": "array", "minItems": 1 },
        "mapping_target_kinds": { "type": "array", "minItems": 1 },
        "mapping_origins": { "type": "array", "minItems": 1 },
        "mapping_scopes": { "type": "array", "minItems": 1 },
        "mapping_row_postures": { "type": "array", "minItems": 1 },
        "mapping_row_actions": { "type": "array", "minItems": 1 },
        "sync_modes": { "type": "array", "minItems": 1 },
        "write_scopes": { "type": "array", "minItems": 1 },
        "sync_behavior_classes": { "type": "array", "minItems": 1 },
        "queued_draft_states": { "type": "array", "minItems": 1 },
        "sync_row_actions": { "type": "array", "minItems": 1 },
        "mapping_export_fields": { "type": "array", "minItems": 1 },
        "sync_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mapping_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mapping_example" }
        },
        "sync_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sync_example" }
        },
        "assumes_default_destination_silently": { "const": false },
        "masks_mapping_origin_or_lock": { "const": false },
        "collapses_sync_into_generic_synced": { "const": false },
        "hides_local_draft_queue_state": { "const": false }
      }
    },
    "mapping_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "target_kind",
            "mapping_origin",
            "provider_project_label",
            "repo_workspace_relation",
            "mapping_ref",
            "mapping_scope",
            "row_posture",
            "available_actions",
            "shows_explicit_destination",
            "is_policy_locked",
            "assumes_default_destination_silently"
          ]
        }
      }
    },
    "sync_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "sync_mode",
            "write_scope",
            "queued_draft_state",
            "sync_ref",
            "behavior_class",
            "available_actions",
            "can_write_live",
            "is_read_only",
            "is_offline_capture_only",
            "has_pending_local_work",
            "collapses_into_generic_synced",
            "hides_local_draft_queue_state"
          ]
        }
      }
    }
  }
}
