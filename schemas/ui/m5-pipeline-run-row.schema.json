{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-pipeline-run-row.schema.json",
  "title": "Aureline M5 pipeline run row",
  "description": "Reusable, copy/export-safe row for external pipeline runs across review, pipeline, project-health, companion, support, and release surfaces. The row binds provider/run identity, trigger, branch/change relation, artifact counts, freshness, and rerun/cancel authority to canonical pipeline run refs instead of surface-local interpretations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "row_id",
    "pipeline_run_id",
    "provider_run_ref",
    "provider_label",
    "workflow_or_job_name",
    "review_anchor_ref",
    "trigger",
    "duration",
    "branch_change_relation",
    "normalized_status",
    "artifact_summary",
    "freshness_state",
    "freshness_note",
    "degraded_state",
    "run_control_authority",
    "open_details_action",
    "provider_handoff",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_pipeline_run_row" },
    "schema_version": { "const": 1 },
    "row_id": { "$ref": "#/$defs/id" },
    "pipeline_run_id": { "$ref": "#/$defs/id" },
    "provider_run_ref": { "$ref": "#/$defs/ref" },
    "provider_label": {
      "type": "string",
      "enum": ["github_actions", "gitlab_ci", "azure_pipelines", "circleci", "buildkite", "local_ci", "imported_provider", "unknown"]
    },
    "workflow_or_job_name": { "$ref": "#/$defs/ref" },
    "review_anchor_ref": { "$ref": "#/$defs/ref" },
    "trigger": { "$ref": "#/$defs/trigger" },
    "duration": { "$ref": "#/$defs/duration" },
    "branch_change_relation": { "$ref": "#/$defs/branch_change_relation" },
    "normalized_status": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "cancelled", "timed_out", "action_required", "blocked", "unknown"]
    },
    "artifact_summary": { "$ref": "#/$defs/artifact_summary" },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "freshness_note": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "degraded_state": {
      "type": "string",
      "enum": ["none", "stale", "superseded", "partial", "blocked", "policy_hidden", "provider_unreachable"]
    },
    "run_control_authority": { "$ref": "#/$defs/run_control_authority" },
    "open_details_action": { "$ref": "#/$defs/open_details_action" },
    "provider_handoff": { "$ref": "#/$defs/provider_handoff" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "live", "warm_cached", "stale", "superseded", "partial", "blocked", "policy_hidden", "expired", "unknown"]
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["review_pane", "pipeline_viewer", "project_health_center", "companion_client", "support_export", "release_proof"]
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger_type", "actor_ref", "actor_class", "event_ref", "triggered_at"],
      "properties": {
        "trigger_type": {
          "type": "string",
          "enum": ["push", "pull_request", "merge_queue", "manual", "scheduled", "rerun", "provider_import"]
        },
        "actor_ref": { "$ref": "#/$defs/ref" },
        "actor_class": {
          "type": "string",
          "enum": ["human_account", "install_or_bot_account", "delegated_user", "scheduled_trigger", "policy_injected_trigger", "replayed_trigger", "unknown_actor_class"]
        },
        "event_ref": { "$ref": "#/$defs/ref" },
        "triggered_at": { "$ref": "#/$defs/ref" }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "milliseconds", "display_label"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["exact", "approximate", "unknown"]
        },
        "milliseconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "display_label": { "$ref": "#/$defs/ref" }
      }
    },
    "branch_change_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_ref", "commit_ref", "change_object_ref", "base_relation", "stale_base"],
      "properties": {
        "branch_ref": { "type": ["string", "null"], "minLength": 1 },
        "commit_ref": { "type": ["string", "null"], "minLength": 1 },
        "change_object_ref": { "type": ["string", "null"], "minLength": 1 },
        "base_relation": {
          "type": "string",
          "enum": ["current_base", "stale_base", "detached_change", "superseded_commit", "unknown_relation", "policy_hidden"]
        },
        "stale_base": { "type": "boolean" }
      },
      "anyOf": [
        { "properties": { "branch_ref": { "$ref": "#/$defs/ref" } } },
        { "properties": { "commit_ref": { "$ref": "#/$defs/ref" } } },
        { "properties": { "change_object_ref": { "$ref": "#/$defs/ref" } } }
      ]
    },
    "artifact_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_count", "log_count", "unavailable_count", "artifact_browser_ref", "retention_label"],
      "properties": {
        "artifact_count": { "type": "integer", "minimum": 0 },
        "log_count": { "type": "integer", "minimum": 0 },
        "unavailable_count": { "type": "integer", "minimum": 0 },
        "artifact_browser_ref": { "$ref": "#/$defs/ref" },
        "retention_label": {
          "type": "string",
          "enum": ["current", "partial_retained", "retention_expired", "policy_hidden", "unknown"]
        }
      }
    },
    "run_control_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rerun_available",
        "cancel_available",
        "authority_label",
        "acting_identity_ref",
        "side_effect_review_required",
        "disabled_reason"
      ],
      "properties": {
        "rerun_available": { "type": "boolean" },
        "cancel_available": { "type": "boolean" },
        "authority_label": {
          "type": "string",
          "enum": ["allowed", "requires_reapproval", "provider_owned", "policy_denied", "unavailable", "read_only"]
        },
        "acting_identity_ref": { "$ref": "#/$defs/ref" },
        "side_effect_review_required": { "type": "boolean" },
        "disabled_reason": { "$ref": "#/$defs/ref" }
      }
    },
    "open_details_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_ref", "action_label", "details_target_ref"],
      "properties": {
        "action_ref": { "$ref": "#/$defs/ref" },
        "action_label": { "$ref": "#/$defs/ref" },
        "details_target_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "provider_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_native_required", "handoff_target_ref", "handoff_reason"],
      "properties": {
        "provider_native_required": { "type": "boolean" },
        "handoff_target_ref": { "$ref": "#/$defs/ref" },
        "handoff_reason": { "$ref": "#/$defs/ref" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["text", "json", "markdown"] }
        },
        "export_fields": { "$ref": "#/$defs/ref_array" },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
