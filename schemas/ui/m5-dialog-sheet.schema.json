{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-dialog-sheet.schema.json",
  "title": "Aureline M5 dialog / sheet component",
  "description": "Canonical single-instance shape of the M5 dialog / sheet decision/feedback primitive (dialog or sheet that names rationale, scope, and explicit actions). Every claimed M5 dialog / sheet references this schema or the combined m5-decision-feedback-component-matrix.schema.json rather than reinventing its own state, rationale, scope, or recovery wording. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "relies_on_color_alone_for_meaning",
    "lets_popover_carry_only_critical_instruction",
    "uses_generic_yes_no_in_high_risk_dialog",
    "represents_durable_work_as_toast_only",
    "blanks_useful_pane_during_loading",
    "uses_full_screen_spinner_when_partial_capable"
  ],
  "properties": {
    "component_family": {
      "const": "dialog_sheet"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "info",
          "success",
          "warning",
          "blocked",
          "pending",
          "degraded",
          "acknowledged",
          "dismissed"
        ]
      }
    },
    "badge_expressions": {
      "type": "array"
    },
    "popover_dismissals": {
      "type": "array"
    },
    "dialog_action_models": {
      "type": "array"
    },
    "notice_scopes": {
      "type": "array"
    },
    "toast_durabilities": {
      "type": "array"
    },
    "empty_state_purposes": {
      "type": "array"
    },
    "loading_fidelities": {
      "type": "array"
    },
    "consequence_disclosures": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "relies_on_color_alone_for_meaning": {
      "const": false
    },
    "lets_popover_carry_only_critical_instruction": {
      "const": false
    },
    "uses_generic_yes_no_in_high_risk_dialog": {
      "const": false
    },
    "represents_durable_work_as_toast_only": {
      "const": false
    },
    "blanks_useful_pane_during_loading": {
      "const": false
    },
    "uses_full_screen_spinner_when_partial_capable": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
