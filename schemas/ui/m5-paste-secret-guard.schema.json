{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-paste-secret-guard.schema.json",
  "title": "Aureline M5 paste / secret guard",
  "description": "Canonical per-domain descriptor for the paste / secret guard that gates any reveal of raw secrets, command text, variable bodies, or clipboard contents on a shared terminal / debug surface. Names the guard posture and the consent posture under which a guarded reveal is permitted so raw material is never revealed without a guard and consent posture. Raw secrets, raw command text, raw variable bodies, and raw clipboard contents never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "collaboration_control_association",
    "guard_posture",
    "consent_retention_gate"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "paste_secret_guard"
      ]
    },
    "collaboration_control_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "guard_posture": {
      "enum": [
        "guarded_masked",
        "guarded_reveal_with_consent",
        "blocked_no_consent"
      ]
    },
    "consent_retention_gate": {
      "$ref": "#/$defs/consent_retention_gate"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "consent_retention_gate": {
      "enum": [
        "consent_current_recording_allowed",
        "blocked_by_missing_join_consent",
        "blocked_by_consent_renewal_required",
        "blocked_by_retention_scope_widening",
        "blocked_by_guest_scope_or_route_expansion"
      ]
    }
  }
}
