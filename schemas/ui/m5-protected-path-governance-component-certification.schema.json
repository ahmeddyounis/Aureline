{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-protected-path-governance-component-certification.schema.json",
  "title": "M5 Protected-Path Governance-Component Surface Certification",
  "description": "Surface certification that the eight shared M5 protected-path governance components (protected-path-row, ownership-card, approver-matrix, review-pack-summary, public-surface-diff-card, merge-control-banner, dri-registry-row, merge-readiness-strip) present the same controlled component truth on every claimed M5 governed review and release surface, with no hidden enforcement-authority, owner-coverage, approver-state, review-pack-freshness, or public-surface-diff drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "certification_label",
    "surface_rows",
    "summary",
    "downgrade_triggers",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_protected_path_governance_component_surface_certification_truth" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "certification_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "protected_path_row",
        "ownership_card",
        "approver_matrix",
        "review_pack_summary",
        "public_surface_diff_card",
        "merge_control_banner",
        "dri_registry_row",
        "merge_readiness_strip"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "review_workspace_surface",
        "merge_queue_surface",
        "release_center_surface",
        "help_governance_surface",
        "support_export",
        "shiproom_surface",
        "exported_governance_packet",
        "cli_headless"
      ]
    },
    "axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "enforcement_ownership_provenance"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "narrowed_certified", "not_certified_here"]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "full_governed_authority",
        "advisory_enforcement_only",
        "owner_backup_coverage_missing",
        "approver_state_narrowed",
        "review_pack_stale_disclosed",
        "public_surface_evidence_withheld"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["certified_parity", "narrowed_parity", "parity_blocked"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "evidence_packet_invalid",
        "policy_blocked",
        "provider_enforcement_advisory_or_stale",
        "owner_backup_coverage_missing",
        "approver_state_waived_or_expired",
        "review_pack_stale",
        "public_surface_evidence_missing",
        "trust_narrowing",
        "upstream_dependency_narrowed"
      ]
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "note"],
      "properties": {
        "axis": { "$ref": "#/$defs/axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface",
        "components_present",
        "claimed_claim",
        "certified_claim",
        "status",
        "axis_outcomes",
        "narrowed_axes",
        "downgrade_trigger",
        "component_truth_preserved",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "components_present": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "claimed_claim": { "$ref": "#/$defs/claim_tier" },
        "certified_claim": { "$ref": "#/$defs/claim_tier" },
        "status": { "$ref": "#/$defs/status" },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "narrowed_axes": {
          "type": "array",
          "items": { "$ref": "#/$defs/axis" }
        },
        "downgrade_trigger": {
          "oneOf": [{ "$ref": "#/$defs/downgrade_trigger" }, { "type": "null" }]
        },
        "component_truth_preserved": { "type": "boolean" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "component_truth_preserved": { "const": false } } },
          "then": { "properties": { "status": { "const": "parity_blocked" } } }
        },
        {
          "if": {
            "properties": { "narrowed_axes": { "minItems": 1 } }
          },
          "then": {
            "properties": { "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" } }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "certified_count",
        "narrowed_count",
        "blocked_count",
        "all_rows_preserve_component_truth",
        "all_surfaces_covered",
        "all_components_covered",
        "certification_note"
      ],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "certified_count": { "type": "integer", "minimum": 0 },
        "narrowed_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "all_rows_preserve_component_truth": { "type": "boolean" },
        "all_surfaces_covered": { "type": "boolean" },
        "all_components_covered": { "type": "boolean" },
        "certification_note": { "type": "string", "minLength": 1 }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_component_truth_on_every_surface",
        "protection_reason_and_owner_source_explicit",
        "advisory_versus_authoritative_enforcement_distinct",
        "approver_state_and_review_pack_freshness_explicit",
        "public_surface_change_class_and_migration_evidence_explicit",
        "certified_never_implies_provider_authoritative_enforcement",
        "backup_coverage_and_escalation_continuity_preserved",
        "narrows_instead_of_dropping_meaning",
        "flattened_truth_blocks_certification",
        "exportable_escalation_continuity_preserved"
      ],
      "properties": {
        "same_component_truth_on_every_surface": { "const": true },
        "protection_reason_and_owner_source_explicit": { "const": true },
        "advisory_versus_authoritative_enforcement_distinct": { "const": true },
        "approver_state_and_review_pack_freshness_explicit": { "const": true },
        "public_surface_change_class_and_migration_evidence_explicit": { "const": true },
        "certified_never_implies_provider_authoritative_enforcement": { "const": true },
        "backup_coverage_and_escalation_continuity_preserved": { "const": true },
        "narrows_instead_of_dropping_meaning": { "const": true },
        "flattened_truth_blocks_certification": { "const": true },
        "exportable_escalation_continuity_preserved": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_workspace_surface_shows_certification",
        "merge_queue_surface_shows_certification",
        "release_center_surface_shows_certification",
        "help_governance_surface_shows_certification",
        "support_export_shows_certification",
        "shiproom_surface_shows_certification",
        "exported_governance_packet_shows_certification",
        "cli_headless_shows_certification",
        "narrowed_surfaces_visibly_labelled"
      ],
      "properties": {
        "review_workspace_surface_shows_certification": { "const": true },
        "merge_queue_surface_shows_certification": { "const": true },
        "release_center_surface_shows_certification": { "const": true },
        "help_governance_surface_shows_certification": { "const": true },
        "support_export_shows_certification": { "const": true },
        "shiproom_surface_shows_certification": { "const": true },
        "exported_governance_packet_shows_certification": { "const": true },
        "cli_headless_shows_certification": { "const": true },
        "narrowed_surfaces_visibly_labelled": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
