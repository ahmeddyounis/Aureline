        "workspace_configured",
        "tool_manager_resolved",
        "system_default",
        "container_provided",
        "session_override"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "shell_integration_quality_hidden",
        "session_liveness_ambiguous",
        "host_boundary_masked",
        "connection_state_stale",
        "runtime_source_unexplained",
        "toolchain_pin_conflict_hidden",
        "collaboration_role_masked",
        "follow_state_ambiguous",
        "repair_blast_radius_understated",
        "reversibility_overstated",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "resolution_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_title",
        "host_boundary",
        "runtime_kind_repr",
        "resolved_runtime_repr",
        "runtime_source",
        "scope",
        "effective_value_provenance"
      ],
      "properties": {
        "context_title": { "$ref": "#/$defs/non_empty_string" },
        "host_boundary": { "$ref": "#/$defs/host_boundary_class" },
        "connection_state": {
          "oneOf": [{ "$ref": "#/$defs/connection_state" }, { "type": "null" }]
        },
        "runtime_kind_repr": { "$ref": "#/$defs/non_empty_string" },
        "resolved_runtime_repr": { "$ref": "#/$defs/non_empty_string" },
        "runtime_source": { "$ref": "#/$defs/runtime_source_class" },
        "scope": { "$ref": "#/$defs/resolved_scope" },
        "effective_value_provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "resolved_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_title",
        "host_boundary",
        "is_remote",
        "target_posture",
        "target_is_degraded",
        "runtime_kind_repr",
        "resolved_runtime_repr",
        "runtime_source",
        "scope",
        "effective_value_provenance",
        "readiness",
        "is_ready",
        "is_blocked",
        "exposes_why_context_entrypoint"
      ],
      "properties": {
        "context_title": { "$ref": "#/$defs/non_empty_string" },
        "host_boundary": { "$ref": "#/$defs/host_boundary_class" },
        "is_remote": { "type": "boolean" },
        "connection_state": {
          "oneOf": [{ "$ref": "#/$defs/connection_state" }, { "type": "null" }]
        },
        "target_posture": { "$ref": "#/$defs/target_posture" },
        "target_is_degraded": { "type": "boolean" },
        "runtime_kind_repr": { "$ref": "#/$defs/non_empty_string" },
        "resolved_runtime_repr": { "$ref": "#/$defs/non_empty_string" },
        "runtime_source": { "$ref": "#/$defs/runtime_source_class" },
        "scope": { "$ref": "#/$defs/resolved_scope" },
        "effective_value_provenance": { "$ref": "#/$defs/provenance" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "is_ready": { "type": "boolean" },
        "is_blocked": { "type": "boolean" },
        "exposes_why_context_entrypoint": { "const": true }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/resolution_input" },
        "resolved": { "$ref": "#/$defs/resolved_context" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "pill_parts",
        "strip_parts",
        "target_postures",
        "readiness_states",
        "provenance_states",
        "resolved_scopes",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "masks_host_or_environment_boundary",
        "conflates_ready_and_degraded_or_blocked",
        "invents_private_status_grammar",
        "hides_why_this_context_entrypoint"
      ],
      "properties": {
        "run_surface": { "$ref": "#/$defs/run_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "pill_parts": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/pill_part" }
        },
        "strip_parts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/strip_part" }
        },
        "target_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target_posture" }
        },
        "readiness_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/readiness" }
        },
        "provenance_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        },
        "resolved_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_scope" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "masks_host_or_environment_boundary": { "const": false },
        "conflates_ready_and_degraded_or_blocked": { "const": false },
        "invents_private_status_grammar": { "const": false },
        "hides_why_this_context_entrypoint": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_surfaces",
        "pill_parts",
        "strip_parts",
        "target_postures",
        "readiness_states",
        "provenance_states",
        "resolved_scopes",
        "export_fields",
        "host_boundary_classes",
        "connection_states",
        "runtime_source_classes",
        "accessibility_routes"
      ],
      "properties": {
        "run_surfaces": { "type": "array", "items": { "$ref": "#/$defs/run_surface" } },
        "pill_parts": { "type": "array", "items": { "$ref": "#/$defs/pill_part" } },
        "strip_parts": { "type": "array", "items": { "$ref": "#/$defs/strip_part" } },
        "target_postures": { "type": "array", "items": { "$ref": "#/$defs/target_posture" } },
        "readiness_states": { "type": "array", "items": { "$ref": "#/$defs/readiness" } },
        "provenance_states": { "type": "array", "items": { "$ref": "#/$defs/provenance" } },
        "resolved_scopes": { "type": "array", "items": { "$ref": "#/$defs/resolved_scope" } },
        "export_fields": { "type": "array", "items": { "$ref": "#/$defs/export_field" } },
        "host_boundary_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/host_boundary_class" }
        },
        "connection_states": { "type": "array", "items": { "$ref": "#/$defs/connection_state" } },
