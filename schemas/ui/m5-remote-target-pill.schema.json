    },
    "strip_part": {
      "type": "string",
      "enum": [
        "runtime_kind",
        "resolved_label_version",
        "winning_source",
        "scope_cue",
        "readiness_state",
        "effective_value_provenance_cue",
        "why_this_context_entrypoint"
      ]
    },
    "target_posture": {
      "type": "string",
      "enum": [
        "local_inline",
        "connected_healthy",
        "establishing",
        "reconnecting",
        "offline_cached",
        "disconnected"
      ]
    },
    "readiness": {
      "type": "string",
      "enum": [
        "ready",
        "degraded_cached",
        "degraded_narrowed",
        "degraded_unreachable_target",
        "blocked_by_policy",
        "blocked_unresolved"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "resolved",
        "cached_offline",
        "narrowed_approximate",
        "policy_blocked",
        "unresolved"
      ]
    },
    "resolved_scope": {
