        "project_scope",
        "workspace_scope",
        "host_scope",
        "global_default_scope"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "target_identity",
        "host_boundary",
        "connection_state",
        "target_posture",
        "runtime_kind",
        "resolved_runtime",
        "runtime_source",
        "resolved_scope",
        "effective_value_provenance",
        "readiness",
        "why_context_entrypoint"
      ]
    },
    "host_boundary_class": {
