{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-remote-target-pill.schema.json",
  "title": "Aureline M5 remote-target pill and environment-status strip primitive: target identity, host boundary, degraded/reconnect state, resolved runtime source, scope, readiness, and 'Why this context?' entrypoint",
  "description": "Export-safe packet implementing Aureline's one reusable remote-target-pill / environment-status-strip primitive across every M5 run-capable surface — the run console, the test runner, the debug session, the notebook runtime, the request runner, the database session, the preview server, the pipeline run, and the incident surface. Each surface row binds the shared remote-target-pill anatomy (target identity, host-or-environment class, connection state, degraded-or-reconnect cue, and a context-inspect affordance), the shared environment-status-strip anatomy (runtime kind, resolved label/version, winning source, scope cue, readiness state, effective-value-provenance cue, and the one-step 'Why this context?' entrypoint), the derived remote-target postures (local-inline, connected-healthy, establishing, reconnecting, offline-cached, disconnected), the derived environment readiness (ready, degraded-cached, degraded-narrowed, degraded-unreachable-target, blocked-by-policy, blocked-unresolved), the effective-value provenance, the resolved scopes, the export fields that let the support export reconstruct source/scope/readiness truth, and the non-visual accessibility routes. The host-boundary class, remote connection state, runtime source class, accessibility route, qualification class, and downgrade trigger vocabularies are reused verbatim from the frozen M5 runtime-boundary component matrix; the shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix. Each surface carries worked resolution cases: a resolver input (target identity, host boundary, connection state, runtime kind, resolved runtime, winning source, scope, and effective-value provenance) and the resolved target posture and environment readiness — the stored resolution must equal a fresh resolve of its input, so a cached, narrowed, or policy-blocked effective value is never presented as cleanly ready and a degraded remote target is never masked as connected. Hard invariants forbid masking the host / environment boundary, conflating ready with degraded or blocked, inventing a private status grammar, and hiding the 'Why this context?' entrypoint. Raw URLs, raw endpoints, raw usernames, raw hostnames, tokens, and credentials never cross this boundary; target identities, runtime kinds, and resolved runtime labels are carried only as opaque, export-safe representations. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_remote_target_pill_and_environment_status_strip_runtime_source_readiness_and_context_entrypoint_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "run_surface": {
      "type": "string",
      "enum": [
        "run_console",
        "test_runner",
        "debug_session",
        "notebook_runtime",
        "request_runner",
        "database_session",
        "preview_server",
        "pipeline_run",
        "incident_surface"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "type": "string",
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "type": "string",
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
