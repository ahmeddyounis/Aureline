        "target_identity_and_host_boundary_always_shown": { "const": true },
        "winning_source_and_scope_always_explicit": { "const": true },
        "readiness_state_always_resolved": { "const": true },
        "cached_narrowed_or_blocked_never_shown_as_ready": { "const": true },
        "why_this_context_entrypoint_always_present": { "const": true },
        "support_export_reconstructs_source_scope_readiness": { "const": true },
        "no_surface_invents_second_status_grammar": { "const": true },
        "every_row_bound_to_shell_zone": { "const": true },
