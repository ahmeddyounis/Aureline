{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-repair-result-receipt-row-checkpoint-lineage-disclosure-controls.schema.json",
  "title": "Aureline M5 repair-result-receipt-row and checkpoint-lineage-disclosure controls",
  "description": "Export-safe packet for the guided-repair result lane over the frozen M5 workspace-trust / guided-repair component matrix. It carries resolved, honest projections of the repair-result receipt row and its checkpoint-lineage disclosure across the claimed M5 consumer surfaces, so what actually happened after a repair is preserved instead of collapsing into a generic success or failure. Each controls row binds a consumer surface to the resolved receipt examples (naming the repair id, linked finding ids, the repair-outcome class, applied-versus-skipped scope, a linked checkpoint ref, the reversal class, and the compensation / manual follow-up state) and the resolved checkpoint-lineage disclosure examples (tracing finding to preview to apply to result). Every clean example keeps a command-backed support-export path reachable. Hard invariants forbid collapsing distinct outcomes into a generic success, hiding partial success or the follow-up it needs, severing a receipt from its checkpoint lineage, and requiring feature-local translation to join a support-export packet. Acceptance criteria — repair outcomes stay attributable and exportable, partial success and manual follow-up are visible first-class outcomes, and support packets can cite one canonical receipt/lineage object — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_repair_result_receipt_row_and_checkpoint_lineage_disclosure_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "repair_disposition": {
      "type": ["string", "null"],
      "enum": [
        "trusted",
        "restricted",
        "mixed_root",
        "policy_blocked",
        "reduced_mode",
        "preview_ready",
        "checkpoint_missing",
        "exact_reversal",
        "compensate",
        "regenerate",
        "manual_follow_up",
        "audit_only",
        null
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "repair_result_receipt_row_example": {
      "type": "object",
      "required": [
        "receipt_id",
        "repair_id",
        "linked_finding_ids",
        "outcome_class",
        "repair_disposition",
        "applied_scope",
        "skipped_scope",
        "is_partial_success",
        "checkpoint_state",
        "checkpoint_ref",
        "checkpoint_present",
        "reversal_class",
        "requires_follow_up",
        "follow_up_stated",
        "collapses_outcome_into_generic_success",
        "presents_partial_as_complete",
        "hides_follow_up",
        "support_export_available",
        "degrade_reason",
        "next_action",
        "outcome_attributable"
      ],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/non_empty_string" },
        "repair_id": { "type": "string" },
        "linked_finding_ids": { "$ref": "#/$defs/string_array" },
        "outcome_class": { "$ref": "#/$defs/non_empty_string" },
        "repair_disposition": { "$ref": "#/$defs/repair_disposition" },
        "applied_scope": { "$ref": "#/$defs/string_array" },
        "skipped_scope": { "$ref": "#/$defs/string_array" },
        "is_partial_success": { "type": "boolean" },
        "checkpoint_state": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_ref": { "type": "string" },
        "checkpoint_present": { "type": "boolean" },
        "reversal_class": { "$ref": "#/$defs/non_empty_string" },
        "requires_follow_up": { "type": "boolean" },
        "follow_up_stated": { "type": "boolean" },
        "collapses_outcome_into_generic_success": { "type": "boolean" },
        "presents_partial_as_complete": { "type": "boolean" },
        "hides_follow_up": { "type": "boolean" },
        "support_export_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "outcome_attributable": { "type": "boolean" }
      }
    },
    "checkpoint_lineage_disclosure_example": {
      "type": "object",
      "required": [
        "disclosure_id",
        "repair_id",
        "linked_finding_ids",
        "preview_ref",
        "checkpoint_ref",
        "checkpoint_state",
        "apply_ref",
        "receipt_ref",
        "outcome_class",
        "reversal_class",
        "lineage_complete",
        "collapses_stages_into_single_status",
        "severs_lineage",
        "support_export_available",
        "degrade_reason",
        "next_action",
        "lineage_traceable"
      ],
      "properties": {
        "disclosure_id": { "$ref": "#/$defs/non_empty_string" },
        "repair_id": { "type": "string" },
        "linked_finding_ids": { "$ref": "#/$defs/string_array" },
        "preview_ref": { "type": "string" },
        "checkpoint_ref": { "type": "string" },
        "checkpoint_state": { "$ref": "#/$defs/non_empty_string" },
        "apply_ref": { "type": "string" },
        "receipt_ref": { "type": "string" },
        "outcome_class": { "$ref": "#/$defs/non_empty_string" },
        "reversal_class": { "$ref": "#/$defs/non_empty_string" },
        "lineage_complete": { "type": "boolean" },
        "collapses_stages_into_single_status": { "type": "boolean" },
        "severs_lineage": { "type": "boolean" },
        "support_export_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "lineage_traceable": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "repair_result_receipt_row_examples",
        "checkpoint_lineage_disclosure_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_outcomes_into_generic_success",
        "hides_partial_success_or_follow_up",
        "severs_receipt_from_checkpoint_lineage",
        "requires_feature_local_translation_for_support_export"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "repair_result_receipt_row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repair_result_receipt_row_example" }
        },
        "checkpoint_lineage_disclosure_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checkpoint_lineage_disclosure_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_outcomes_into_generic_success": { "const": false },
        "hides_partial_success_or_follow_up": { "const": false },
        "severs_receipt_from_checkpoint_lineage": { "const": false },
        "requires_feature_local_translation_for_support_export": { "const": false }
      }
    }
  }
}
