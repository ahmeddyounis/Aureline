{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-provider-chip-group.schema.json",
  "title": "Aureline M5 provider-chip group",
  "description": "Canonical reusable provider-chip group. Names who owns a work item and whether Aureline may write to it, so provider authority is always explicit and never left to generic ticket/task wording. Governed by the M5 work-item component matrix in crates/aureline-provider.",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_item_object_id", "chips"],
  "properties": {
    "work_item_object_id": { "$ref": "#/$defs/non_empty_string" },
    "chips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider_chip" }
    }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "provider_chip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "provider_authority"],
      "properties": {
        "label": { "$ref": "#/$defs/non_empty_string" },
        "provider_authority": { "$ref": "#/$defs/provider_authority" }
      }
    },
    "provider_authority": {
      "enum": [
        "provider_owned",
        "local_draft",
        "mirrored_read_only",
        "imported_snapshot",
        "unlinked_local",
        "policy_pinned"
      ]
    }
  }
}
