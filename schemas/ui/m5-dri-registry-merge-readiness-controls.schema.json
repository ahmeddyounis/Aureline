{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-dri-registry-merge-readiness-controls.schema.json",
  "title": "Aureline M5 DRI-registry-row / merge-readiness-strip controls",
  "description": "Boundary contract for the reusable M5 DRI-registry row and merge-readiness strip controls: one export-safe packet binding a vector of DRI-registry rows and a vector of merge-readiness strips to one authority-locus, owner-source, and merge-target vocabulary. The Rust validator in crates/aureline-review is the authoritative gate; this schema documents the export shape. An advisory owner guessed from the last interacting team never masquerades as an authoritative owner, a local estimate or CI-only signal never reads as the provider's authoritative state, and a change never appears mergeable here without provider-authoritative, unblocked clearance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "dri_registry_rows",
    "merge_readiness_strips",
    "downgrade_triggers",
    "consumer_surfaces",
    "review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_dri_registry_rows_and_merge_readiness_strips_with_primary_backup_role_aliases_support_or_escalation_path_queue_or_branch_target_truth_blocker_counts_export_packet_actions_and_no_silent_mergeability_widening"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "dri_registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dri_registry_row" }
    },
    "merge_readiness_strips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/merge_readiness_strip" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "governance_state_vocab": {
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "authority_locus_source": {
      "enum": [
        "provider_authoritative_state",
        "provider_reported_state",
        "local_heuristic_estimate",
        "ci_reported_only",
        "not_evaluated_here",
        "stale_against_base_head"
      ]
    },
    "authority_locus_posture": {
      "enum": [
        "provider_authoritative",
        "local_estimate",
        "ci_only",
        "not_evaluated_here",
        "stale_relative_to_head"
      ]
    },
    "owner_source_signal": {
      "enum": [
        "forge_codeowners_rule",
        "provider_team_assignment",
        "repository_manifest_declared",
        "registry_declared",
        "last_interacting_team_heuristic",
        "owner_unresolved"
      ]
    },
    "owner_source_posture": {
      "enum": ["codeowners_authoritative", "registry_declared", "advisory_heuristic", "unresolved"]
    },
    "support_forum_kind": {
      "enum": ["slack_channel", "discussion_thread", "mailing_list", "ticket_queue", "no_forum"]
    },
    "escalation_continuity_state": {
      "enum": ["continuous_to_owner", "degraded_fallback", "broken_no_fallback", "not_configured"]
    },
    "registry_freshness_state": {
      "enum": [
        "currently_verified",
        "refresh_due",
        "stale_superseded",
        "never_verified",
        "unknown_freshness"
      ]
    },
    "merge_target_kind": {
      "enum": ["merge_queue", "target_branch", "stacked_branch", "protected_branch", "no_target"]
    },
    "required_next_action_kind": {
      "enum": [
        "resolve_blockers",
        "request_provider_evaluation",
        "refresh_stale_base",
        "await_queue_position",
        "ready_to_merge",
        "escalate_to_owner"
      ]
    },
    "dri_registry_row": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "component",
        "row_id",
        "service_path_identity_label",
        "primary_dri_alias",
        "escalation_alias",
        "support_forum_kind",
        "support_forum_label",
        "escalation_continuity_state",
        "escalation_path_label",
        "owner_source_signal",
        "derived_owner_source",
        "claims_authoritative_owner",
        "registry_freshness_state",
        "freshness_label",
        "authority_locus_source",
        "derived_authority_locus",
        "claims_provider_authoritative",
        "governance_state_vocab",
        "context_note",
        "row_actions"
      ],
      "properties": {
        "component": { "const": "dri_registry_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "service_path_identity_label": { "$ref": "#/$defs/non_empty_string" },
        "primary_dri_alias": { "$ref": "#/$defs/non_empty_string" },
        "backup_dri_alias": { "type": "string" },
        "escalation_alias": { "$ref": "#/$defs/non_empty_string" },
        "support_forum_kind": { "$ref": "#/$defs/support_forum_kind" },
        "support_forum_label": { "$ref": "#/$defs/non_empty_string" },
        "support_forum_ref": { "type": "string" },
        "benchmark_owner_alias": { "type": "string" },
        "compatibility_owner_alias": { "type": "string" },
        "escalation_continuity_state": { "$ref": "#/$defs/escalation_continuity_state" },
        "escalation_path_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_source_signal": { "$ref": "#/$defs/owner_source_signal" },
        "derived_owner_source": { "$ref": "#/$defs/owner_source_posture" },
        "claims_authoritative_owner": { "type": "boolean" },
        "registry_freshness_state": { "$ref": "#/$defs/registry_freshness_state" },
        "freshness_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_locus_source": { "$ref": "#/$defs/authority_locus_source" },
        "derived_authority_locus": { "$ref": "#/$defs/authority_locus_posture" },
        "claims_provider_authoritative": { "type": "boolean" },
        "governance_state_vocab": {
          "type": "array",
          "items": { "$ref": "#/$defs/governance_state_vocab" }
        },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "row_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "merge_readiness_strip": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "component",
        "strip_id",
        "change_title_label",
        "merge_target_kind",
        "merge_target_label",
        "blocker_count",
        "required_next_action_kind",
        "required_next_action_label",
        "export_packet_action_label",
        "authority_locus_source",
        "derived_authority_locus",
        "claims_provider_authoritative",
        "claims_evaluated_here",
        "claims_mergeable_here",
        "mergeability_label",
        "export_parity_label",
        "governance_state_vocab",
        "context_note",
        "strip_actions"
      ],
      "properties": {
        "component": { "const": "merge_readiness_strip" },
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "change_title_label": { "$ref": "#/$defs/non_empty_string" },
        "merge_target_kind": { "$ref": "#/$defs/merge_target_kind" },
        "merge_target_label": { "$ref": "#/$defs/non_empty_string" },
        "blocker_count": { "type": "integer", "minimum": 0 },
        "blocker_summary_label": { "type": "string" },
        "required_next_action_kind": { "$ref": "#/$defs/required_next_action_kind" },
        "required_next_action_label": { "$ref": "#/$defs/non_empty_string" },
        "export_packet_action_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_locus_source": { "$ref": "#/$defs/authority_locus_source" },
        "derived_authority_locus": { "$ref": "#/$defs/authority_locus_posture" },
        "claims_provider_authoritative": { "type": "boolean" },
        "claims_evaluated_here": { "type": "boolean" },
        "claims_mergeable_here": { "type": "boolean" },
        "mergeability_label": { "$ref": "#/$defs/non_empty_string" },
        "export_parity_label": { "$ref": "#/$defs/non_empty_string" },
        "governance_state_vocab": {
          "type": "array",
          "items": { "$ref": "#/$defs/governance_state_vocab" }
        },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "strip_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    }
  }
}
