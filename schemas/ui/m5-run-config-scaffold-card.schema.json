{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-run-config-scaffold-card.schema.json",
  "title": "Aureline M5 run-config scaffold card",
  "description": "Per-component contract for a run-config scaffold card: the reusable component that names where a framework convenience action will actually run and what it writes. Binds the one controlled certainty vocabulary plus the execution boundary class and run-config mutation class. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape. The local, container, SSH, or managed boundary never hides behind framework convenience language and a convenience action never implies a no-op write.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "identity_label",
    "state_label",
    "keyboard_route_label",
    "certainty",
    "execution_boundary_class",
    "run_config_mutation_class"
  ],
  "properties": {
    "component_family": {
      "const": "run_config_scaffold_card"
    },
    "identity_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "state_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certainty": {
      "$ref": "#/$defs/certainty_disposition"
    },
    "execution_boundary_class": {
      "$ref": "#/$defs/execution_boundary_class"
    },
    "run_config_mutation_class": {
      "$ref": "#/$defs/run_config_mutation_class"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "execution_boundary_class": {
      "enum": [
        "local_process",
        "container",
        "ssh_remote",
        "managed_workspace",
        "cloud_remote",
        "unknown_boundary"
      ]
    },
    "run_config_mutation_class": {
      "enum": [
        "creates_config_file",
        "edits_config_file",
        "adds_dependency",
        "no_write_preview",
        "rollback_available",
        "unknown_mutation"
      ]
    }
  }
}
