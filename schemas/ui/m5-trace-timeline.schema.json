{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-trace-timeline.schema.json",
  "title": "Aureline M5 trace timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "timeline_id", "trace_ref", "session_ref", "capture_mode", "artifact_origin", "execution_origin", "lane_summary", "clock_sync_basis", "mapping_quality", "selected_range_ref", "bookmark_refs", "partiality_note_ref", "packet_refs", "textual_fallback_ref", "chronology_capability", "source_refs", "consumer_surfaces", "copy_export", "reduced_capability_banner", "support_export_join", "auto_narrowing_contract"],
  "properties": {
    "record_kind": { "const": "m5_trace_timeline" },
    "schema_version": { "const": 1 },
    "timeline_id": { "$ref": "#/$defs/ref" },
    "trace_ref": { "$ref": "#/$defs/ref" },
    "session_ref": { "$ref": "#/$defs/ref" },
    "capture_mode": { "enum": ["trace", "replay_import", "imported_profile"] },
    "artifact_origin": { "enum": ["live_capture", "replay_capture", "imported_artifact", "support_bundle", "cached_replay", "unknown"] },
    "execution_origin": { "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "ci_runner", "imported_artifact", "support_bundle", "cli_headless"] },
    "lane_summary": { "type": "object", "additionalProperties": false, "required": ["process_refs", "thread_refs", "event_lane_count", "hidden_lane_count"], "properties": { "process_refs": { "$ref": "#/$defs/ref_array" }, "thread_refs": { "$ref": "#/$defs/ref_array" }, "event_lane_count": { "type": "integer", "minimum": 0 }, "hidden_lane_count": { "type": "integer", "minimum": 0 } } },
    "clock_sync_basis": { "enum": ["monotonic_single_process", "synchronized_multi_process", "imported_clock_domain", "partial_clock_correlation", "unknown"] },
    "mapping_quality": { "enum": ["exact", "symbolicated", "source_mapped", "partial", "heuristic", "missing", "not_applicable"] },
    "selected_range_ref": { "$ref": "#/$defs/ref" },
    "bookmark_refs": { "$ref": "#/$defs/ref_array" },
    "partiality_note_ref": { "$ref": "#/$defs/ref" },
    "packet_refs": { "$ref": "#/$defs/ref_array" },
    "textual_fallback_ref": { "$ref": "#/$defs/ref" },
    "chronology_capability": { "type": "object", "additionalProperties": false, "required": ["reverse_step_available", "replay_available", "disabled_reason_refs"], "properties": { "reverse_step_available": { "type": "boolean" }, "replay_available": { "type": "boolean" }, "disabled_reason_refs": { "$ref": "#/$defs/ref_array" } } },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/ref_array" },
    "copy_export": { "$ref": "#/$defs/copy_export" },
    "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
    "support_export_join": { "$ref": "#/$defs/support_export_join" },
    "auto_narrowing_contract": { "$ref": "#/$defs/auto_narrowing_contract" }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
    "copy_export": { "type": "object", "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "minItems": 3, "items": { "enum": ["text", "json", "markdown"] } }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "type": "string" }, "json": { "type": "string" }, "markdown": { "type": "string" }, "screenshot_only_prohibited": { "const": true } } },
    "reduced_capability_banner": { "type": "object", "required": ["banner_id", "severity", "capability_state", "visible_label", "missing_capabilities", "preserved_fields"], "properties": { "banner_id": { "$ref": "#/$defs/ref" }, "severity": { "enum": ["info", "warning", "blocking"] }, "capability_state": { "enum": ["full", "read_only", "inspect_only", "compare_only", "export_only", "policy_blocked", "unavailable"] }, "visible_label": { "type": "string" }, "missing_capabilities": { "$ref": "#/$defs/ref_array" }, "preserved_fields": { "$ref": "#/$defs/ref_array" } } },
    "support_export_join": { "type": "object", "required": ["join_id", "schema_ref", "joined_object_kinds", "raw_profile_samples_exported", "raw_trace_events_exported", "gui_cli_support_label_parity"], "properties": { "join_id": { "$ref": "#/$defs/ref" }, "schema_ref": { "$ref": "#/$defs/ref" }, "joined_object_kinds": { "$ref": "#/$defs/ref_array" }, "raw_profile_samples_exported": { "const": false }, "raw_trace_events_exported": { "const": false }, "gui_cli_support_label_parity": { "const": true } } },
    "auto_narrowing_contract": { "type": "object", "required": ["narrow_on_missing_or_stale", "stale_or_missing_effect", "policy_blocked_effect", "degraded_state_reason_field", "release_help_claim_ceiling"], "properties": { "narrow_on_missing_or_stale": { "$ref": "#/$defs/ref_array" }, "stale_or_missing_effect": { "const": "narrow_claim" }, "policy_blocked_effect": { "enum": ["block_export_or_narrow_claim", "narrow_claim"] }, "degraded_state_reason_field": { "const": "narrowed_claim_reasons" }, "release_help_claim_ceiling": { "const": "available_evidence_only" } } }
  }
}
