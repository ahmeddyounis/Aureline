{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-git-mutation-review-recovery-component.schema.json",
  "title": "Aureline M5 cherry-pick/revert review sheets, patch-apply review sheets, conflict-checkpoint cards, and force-push review dialogs with exact target-ref, publish consequence, and recovery truth",
  "description": "Export-safe packet implementing the four risky-mutation review components frozen in the M5 Git-history component matrix: cherry-pick/revert review sheets, patch-apply review sheets, conflict-checkpoint cards, and force-push review dialogs. Every risky surface confirms as its own distinct mutation-review class rather than a shared confirm, names the exact target ref and worktree it mutates, discloses what it will publish or rewrite, keeps a rollback and recovery checkpoint reachable, and — when the change also touches a hosted review — discloses the approval consequence rather than silently invalidating it. The conflict-checkpoint card keeps base/ours/theirs/result context, the unresolved count, and reopen/restore behavior visible after a risky mutation. Raw patch bytes, raw object bodies, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "cherry_pick_revert_sheets",
    "patch_apply_sheets",
    "conflict_checkpoint_cards",
    "force_push_dialogs",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "git_mutation_review_recovery_component_truth"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "cherry_pick_revert_sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cherry_pick_revert_sheet"
      }
    },
    "patch_apply_sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/patch_apply_sheet"
      }
    },
    "conflict_checkpoint_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/conflict_checkpoint_card"
      }
    },
    "force_push_dialogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/force_push_dialog"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_state"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "hosted_review_impact": {
      "type": "string",
      "enum": [
        "local_only",
        "updates_hosted_review",
        "invalidates_approval",
        "diverges_from_hosted"
      ]
    },
    "blocker_state": {
      "type": "string",
      "enum": [
        "ready",
        "conflict_expected",
        "dirty_worktree",
        "protected_ref_policy",
        "signature_required"
      ]
    },
    "checkpoint_state": {
      "type": "string",
      "enum": [
        "pre_mutation_captured",
        "reflog_fallback_only",
        "unavailable"
      ]
    },
    "cherry_verb": {
      "type": "string",
      "enum": [
        "cherry_pick",
        "revert"
      ]
    },
    "patch_source": {
      "type": "string",
      "enum": [
        "mailbox_series",
        "diff_file",
        "range_diff"
      ]
    },
    "patch_apply_mode": {
      "type": "string",
      "enum": [
        "three_way_merge",
        "index_and_worktree",
        "check_only"
      ]
    },
    "conflict_side": {
      "type": "string",
      "enum": [
        "base",
        "ours",
        "theirs",
        "result"
      ]
    },
    "reopen_state": {
      "type": "string",
      "enum": [
        "reopenable",
        "restorable_from_checkpoint",
        "resolved_applied"
      ]
    },
    "force_push_safety": {
      "type": "string",
      "enum": [
        "force_with_lease",
        "force_with_lease_expecting",
        "plain_force"
      ]
    },
    "downgrade_state": {
      "type": "string",
      "enum": [
        "stale_provider_overlay",
        "detached_or_missing_ref",
        "dirty_or_conflicted_worktree",
        "shallow_or_partial_topology",
        "reflog_only_fallback",
        "approval_invalidated",
        "offline_local_only"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review",
        "shell",
        "help",
        "support",
        "support_export",
        "provider_overlay",
        "cli",
        "ai_context"
      ]
    },
    "cherry_pick_revert_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "verb",
        "source_commit_short_id",
        "source_commit_subject",
        "target_ref",
        "target_worktree",
        "review_class",
        "publish_consequence",
        "hosted_review_impact",
        "approval_consequence",
        "blocked_state",
        "blocker_disclosure",
        "rollback_action",
        "checkpoint_state",
        "checkpoint_disclosure",
        "downgrade_vocab",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "component": { "const": "cherry_pick_revert_review_sheet" },
        "verb": { "$ref": "#/$defs/cherry_verb" },
        "source_commit_short_id": { "$ref": "#/$defs/non_empty_string" },
        "source_commit_subject": { "$ref": "#/$defs/non_empty_string" },
        "target_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_worktree": { "$ref": "#/$defs/non_empty_string" },
        "review_class": { "const": "explicit_verb_confirm" },
        "publish_consequence": { "$ref": "#/$defs/non_empty_string" },
        "hosted_review_impact": { "$ref": "#/$defs/hosted_review_impact" },
        "approval_consequence": { "type": "string" },
        "blocked_state": { "$ref": "#/$defs/blocker_state" },
        "blocker_disclosure": { "type": "string" },
        "rollback_action": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_state": { "$ref": "#/$defs/checkpoint_state" },
        "checkpoint_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "downgrade_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_state" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" }
      }
    },
    "patch_apply_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "patch_source",
        "apply_mode",
        "target_ref",
        "target_worktree",
        "commit_count",
        "affected_file_count",
        "affected_paths",
        "review_class",
        "publish_consequence",
        "hosted_review_impact",
        "approval_consequence",
        "blocked_state",
        "blocker_disclosure",
        "rollback_action",
        "checkpoint_state",
        "checkpoint_disclosure",
        "downgrade_vocab",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "component": { "const": "patch_apply_review_sheet" },
        "patch_source": { "$ref": "#/$defs/patch_source" },
        "apply_mode": { "$ref": "#/$defs/patch_apply_mode" },
        "target_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_worktree": { "$ref": "#/$defs/non_empty_string" },
        "commit_count": { "type": "integer", "minimum": 0 },
        "affected_file_count": { "type": "integer", "minimum": 1 },
        "affected_paths": { "$ref": "#/$defs/non_empty_string_array" },
        "review_class": { "const": "patch_apply_confirm" },
        "publish_consequence": { "$ref": "#/$defs/non_empty_string" },
        "hosted_review_impact": { "$ref": "#/$defs/hosted_review_impact" },
        "approval_consequence": { "type": "string" },
        "blocked_state": { "$ref": "#/$defs/blocker_state" },
        "blocker_disclosure": { "type": "string" },
        "rollback_action": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_state": { "$ref": "#/$defs/checkpoint_state" },
        "checkpoint_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "downgrade_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_state" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" }
      }
    },
    "conflict_checkpoint_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "checkpoint_label",
        "originating_operation",
        "target_ref",
        "target_worktree",
        "sides_present",
        "unresolved_count",
        "total_conflict_count",
        "reopen_state",
        "reopen_disclosure",
        "checkpoint_state",
        "checkpoint_disclosure",
        "review_class",
        "downgrade_vocab",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "component": { "const": "conflict_checkpoint_card" },
        "checkpoint_label": { "$ref": "#/$defs/non_empty_string" },
        "originating_operation": { "$ref": "#/$defs/non_empty_string" },
        "target_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_worktree": { "$ref": "#/$defs/non_empty_string" },
        "sides_present": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/conflict_side" }
        },
        "unresolved_count": { "type": "integer", "minimum": 0 },
        "total_conflict_count": { "type": "integer", "minimum": 0 },
        "reopen_state": { "$ref": "#/$defs/reopen_state" },
        "reopen_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_state": { "$ref": "#/$defs/checkpoint_state" },
        "checkpoint_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "review_class": { "const": "display_only_no_mutation" },
        "downgrade_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_state" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" }
      }
    },
    "force_push_dialog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "target_remote",
        "target_ref",
        "target_worktree",
        "local_tip_short_id",
        "remote_tip_short_id",
        "overwrites_commit_count",
        "safety",
        "lease_disclosure",
        "review_class",
        "publish_consequence",
        "hosted_review_impact",
        "approval_consequence",
        "blocked_state",
        "blocker_disclosure",
        "rollback_action",
        "recovery_ref",
        "checkpoint_state",
        "checkpoint_disclosure",
        "downgrade_vocab",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "component": { "const": "force_push_review_dialog" },
        "target_remote": { "$ref": "#/$defs/non_empty_string" },
        "target_ref": { "$ref": "#/$defs/non_empty_string" },
        "target_worktree": { "$ref": "#/$defs/non_empty_string" },
        "local_tip_short_id": { "$ref": "#/$defs/non_empty_string" },
        "remote_tip_short_id": { "$ref": "#/$defs/non_empty_string" },
        "overwrites_commit_count": { "type": "integer", "minimum": 0 },
        "safety": { "$ref": "#/$defs/force_push_safety" },
        "lease_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "review_class": { "const": "force_push_confirm" },
        "publish_consequence": { "$ref": "#/$defs/non_empty_string" },
        "hosted_review_impact": { "$ref": "#/$defs/hosted_review_impact" },
        "approval_consequence": { "type": "string" },
        "blocked_state": { "$ref": "#/$defs/blocker_state" },
        "blocker_disclosure": { "type": "string" },
        "rollback_action": { "$ref": "#/$defs/non_empty_string" },
        "recovery_ref": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_state": { "$ref": "#/$defs/checkpoint_state" },
        "checkpoint_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "downgrade_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_state" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_verbs_never_collapsed",
        "target_ref_worktree_always_named",
        "affected_scope_always_explicit",
        "publish_consequence_always_disclosed",
        "approval_consequence_explicit_when_hosted",
        "rollback_recovery_always_reachable",
        "conflict_context_survives_mutation",
        "local_only_recovery_stays_explicit",
        "one_component_contract_no_hidden_meaning",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "distinct_verbs_never_collapsed": { "type": "boolean", "const": true },
        "target_ref_worktree_always_named": { "type": "boolean", "const": true },
        "affected_scope_always_explicit": { "type": "boolean", "const": true },
        "publish_consequence_always_disclosed": { "type": "boolean", "const": true },
        "approval_consequence_explicit_when_hosted": { "type": "boolean", "const": true },
        "rollback_recovery_always_reachable": { "type": "boolean", "const": true },
        "conflict_context_survives_mutation": { "type": "boolean", "const": true },
        "local_only_recovery_stays_explicit": { "type": "boolean", "const": true },
        "one_component_contract_no_hidden_meaning": { "type": "boolean", "const": true },
        "downgrade_narrows_instead_of_hides": { "type": "boolean", "const": true },
        "stale_or_underqualified_blocks_promotion": { "type": "boolean", "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_history_reuses_one_contract",
        "review_reuses_one_contract",
        "help_support_reuses_one_contract",
        "support_export_reuses_one_contract",
        "consequences_explicit_across_surfaces",
        "cli_headless_shows_truth",
        "provider_overlay_shows_truth",
        "ai_context_shows_truth"
      ],
      "properties": {
        "git_history_reuses_one_contract": { "type": "boolean", "const": true },
        "review_reuses_one_contract": { "type": "boolean", "const": true },
        "help_support_reuses_one_contract": { "type": "boolean", "const": true },
        "support_export_reuses_one_contract": { "type": "boolean", "const": true },
        "consequences_explicit_across_surfaces": { "type": "boolean", "const": true },
        "cli_headless_shows_truth": { "type": "boolean", "const": true },
        "provider_overlay_shows_truth": { "type": "boolean", "const": true },
        "ai_context_shows_truth": { "type": "boolean", "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
