{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-execution-lifecycle-surface-certification.schema.json",
  "title": "Aureline M5 execution-lifecycle component surface certification",
  "description": "M05-827 certification capstone that closes the frozen M5 execution-lifecycle component lane. Keyed on the claimed M5 execution surface (task/test/request/database/notebook/preview/AI/publish/debug plus support-export/docs-help/release-proof evidence surfaces), each row certifies that the shared run-attempt, input-request, artifact-publish, rerun-review, and debug-hierarchy component family behaves consistently: the surface either passes the shared component packet (certified) or auto-narrows its interactive claim to review-required/read-only/inspect-only (narrowed_disclosed) with a binding component group and frozen downgrade trigger; a surface that hides drift, over-asserts control, or drops export truth is blocked. Unsupported or degraded local/remote/container/managed/provider-backed execution paths force a narrowed claim rather than inheriting a full-truth label (AC2), and every surface cites the one canonical component bundle and references the canonical component families it consumes (AC3). Raw run logs, process memory, dump payloads, symbol blobs, credentials, and provider cursors never cross this metadata-only boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "as_of",
    "matrix_ref",
    "certification_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_execution_lifecycle_surface_certification_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "certification_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "claimed_surface": {
      "enum": [
        "task_execution",
        "test_execution",
        "request_execution",
        "database_execution",
        "notebook_execution",
        "preview_execution",
        "ai_execution",
        "publish_execution",
        "debug_execution",
        "support_export_replay",
        "docs_help_embeds",
        "release_proof"
      ]
    },
    "component_group": {
      "enum": [
        "run_attempt",
        "input_request",
        "artifact_publish",
        "rerun_review",
        "debug_hierarchy"
      ]
    },
    "component_family": {
      "enum": [
        "run_attempt_header",
        "input_request_prompt",
        "artifact_publish_row",
        "rerun_comparison_sheet",
        "debug_session_header",
        "thread_process_tree",
        "dump_crash_artifact_card"
      ]
    },
    "path_class": {
      "enum": ["local", "remote", "container", "managed", "provider_backed"]
    },
    "path_parity_state": {
      "enum": ["current", "disclosed_narrowed", "unsupported"]
    },
    "gated_axis_state": {
      "enum": ["certified", "disclosed_narrowed", "blocked", "not_applicable"]
    },
    "export_parity_state": {
      "enum": ["certified", "disclosed_partial", "dropped"]
    },
    "interactive_claim": {
      "enum": ["full_interactive", "review_required", "read_only", "inspect_only"]
    },
    "downgrade_trigger": {
      "enum": [
        "run_attempt_identity_unresolved",
        "input_consequence_unknown",
        "artifact_lineage_lost",
        "artifact_retention_expired",
        "rerun_context_drift",
        "captured_evidence_only",
        "connector_lost",
        "debug_adapter_unavailable",
        "symbols_unavailable"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "execution_context",
        "truth_class",
        "outcome_or_state",
        "execution_boundary",
        "keyboard_route"
      ]
    },
    "export_field": {
      "enum": [
        "surface_identity",
        "consumed_groups",
        "declared_claim",
        "effective_claim",
        "per_axis_truth",
        "compatibility_notes",
        "narrowed_reason",
        "certification_bundle_ref"
      ]
    },
    "compatibility_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_class", "parity"],
      "properties": {
        "path_class": { "$ref": "#/$defs/path_class" },
        "parity": { "$ref": "#/$defs/path_parity_state" },
        "note": { "type": "string" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_group",
        "trigger",
        "narrowed_label",
        "preserves_component_identity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/interactive_claim" },
        "binding_group": { "$ref": "#/$defs/component_group" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_component_identity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "claimed_surface",
        "source_matrix_ref",
        "certification_bundle_ref",
        "execution_context_ref",
        "consumed_groups",
        "declared_claim",
        "effective_claim",
        "run_attempt_truth",
        "input_request_truth",
        "artifact_publish_truth",
        "rerun_review_truth",
        "debug_hierarchy_truth",
        "export_parity",
        "compatibility_notes",
        "copy_export",
        "export_fields",
        "required_labels",
        "consumer_families",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_execution_lifecycle_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "claimed_surface": { "$ref": "#/$defs/claimed_surface" },
        "source_matrix_ref": { "type": "string", "minLength": 1 },
        "certification_bundle_ref": { "type": "string", "minLength": 1 },
        "execution_context_ref": { "type": "string", "minLength": 1 },
        "consumed_groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_group" }
        },
        "declared_claim": { "$ref": "#/$defs/interactive_claim" },
        "effective_claim": { "$ref": "#/$defs/interactive_claim" },
        "run_attempt_truth": { "$ref": "#/$defs/gated_axis_state" },
        "input_request_truth": { "$ref": "#/$defs/gated_axis_state" },
        "artifact_publish_truth": { "$ref": "#/$defs/gated_axis_state" },
        "rerun_review_truth": { "$ref": "#/$defs/gated_axis_state" },
        "debug_hierarchy_truth": { "$ref": "#/$defs/gated_axis_state" },
        "export_parity": { "$ref": "#/$defs/export_parity_state" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compatibility_note" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_count",
        "evidence_surface_count",
        "green_count",
        "yellow_count",
        "red_count",
        "consumed_group_count",
        "path_class_count",
        "all_claims_honest",
        "all_export_preserve_truth",
        "all_unsupported_paths_narrowed",
        "group_coverage_complete",
        "path_class_coverage_complete"
      ],
      "properties": {
        "surface_count": { "type": "integer", "minimum": 0 },
        "evidence_surface_count": { "type": "integer", "minimum": 0 },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "consumed_group_count": { "type": "integer", "minimum": 0 },
        "path_class_count": { "type": "integer", "minimum": 0 },
        "all_claims_honest": { "type": "boolean" },
        "all_export_preserve_truth": { "type": "boolean" },
        "all_unsupported_paths_narrowed": { "type": "boolean" },
        "group_coverage_complete": { "type": "boolean" },
        "path_class_coverage_complete": { "type": "boolean" }
      }
    }
  }
}
