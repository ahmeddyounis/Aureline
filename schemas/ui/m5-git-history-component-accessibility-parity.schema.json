{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-git-history-component-accessibility-parity.schema.json",
  "title": "M5 Git-History Component Accessibility, Headless, and Export Parity Packet",
  "description": "Export-safe packet proving keyboard / screen-reader / CLI / export parity and automatic claim narrowing for the twelve shared M5 Git-history and risky-mutation components (commit-graph header, history-graph row, branch-comparison chip, worktree row, stash entry, reflog-recovery banner, rebase-todo row, sequence-editor header, cherry-pick/revert review sheet, patch-apply review sheet, conflict-checkpoint card, force-push review dialog). Each row exposes the component under one condition across every rendering surface and narrows its recovery / mutation-safety claim when repo topology, checkpoint availability, or provider-linked recovery truth is partial or stale.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "accessibility_rows",
    "downgrade_triggers",
    "rendering_surfaces",
    "trust_review",
    "projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "git_history_component_accessibility_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "accessibility_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "rendering_surfaces": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/rendering_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "projection": { "$ref": "#/$defs/projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "commit_graph_header",
        "history_graph_row",
        "branch_comparison_chip",
        "worktree_row",
        "stash_entry",
        "reflog_recovery_banner",
        "rebase_todo_row",
        "sequence_editor_header",
        "cherry_pick_revert_review_sheet",
        "patch_apply_review_sheet",
        "conflict_checkpoint_card",
        "force_push_review_dialog"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "local_truth_aligned",
        "provider_review_state_stale",
        "repo_topology_partial",
        "checkpoint_recovery_unavailable",
        "offline_local_only"
      ]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "recoverable_in_product",
        "locally_recoverable",
        "partial_history_only",
        "reflog_only_recovery",
        "local_continue_only"
      ]
    },
    "rendering_surface": {
      "type": "string",
      "enum": ["desktop_full", "cli_headless", "support_export"]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "reconcile_provider_review_state",
        "complete_repo_topology",
        "open_recovery_checkpoint",
        "continue_local_history"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "provider_review_state_stale",
        "repo_topology_partial",
        "checkpoint_recovery_unavailable",
        "offline_local_only",
        "claim_overstated",
        "parity_dropped",
        "trust_narrowing"
      ]
    },
    "narrowing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "narrowed_to", "preserved_truth_note", "next_action", "next_action_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_to": { "$ref": "#/$defs/claim_tier" },
        "preserved_truth_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "condition",
        "effective_claim",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "rendering_surfaces",
        "narrowing",
        "topology_note",
        "recovery_note",
        "local_continue_note",
        "is_pointer_only",
        "is_export_opaque",
        "desktop_stronger_than_cli",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "condition": { "$ref": "#/$defs/condition" },
        "effective_claim": { "$ref": "#/$defs/claim_tier" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "rendering_surfaces": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing": {
          "oneOf": [{ "$ref": "#/$defs/narrowing" }, { "type": "null" }]
        },
        "topology_note": { "type": "string" },
        "recovery_note": { "type": "string" },
        "local_continue_note": { "type": "string" },
        "is_pointer_only": { "const": false },
        "is_export_opaque": { "const": false },
        "desktop_stronger_than_cli": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Aligned local truth carries no narrowing.",
          "if": { "properties": { "condition": { "const": "local_truth_aligned" } } },
          "then": { "properties": { "narrowing": { "type": "null" } } }
        },
        {
          "comment": "Every weakening condition must carry an explicit narrowing.",
          "if": {
            "properties": {
              "condition": {
                "enum": [
                  "provider_review_state_stale",
                  "repo_topology_partial",
                  "checkpoint_recovery_unavailable",
                  "offline_local_only"
                ]
              }
            }
          },
          "then": {
            "required": ["local_continue_note"],
            "properties": {
              "narrowing": { "$ref": "#/$defs/narrowing" },
              "local_continue_note": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "comment": "Partial repo topology must spell out that the history shown is incomplete.",
          "if": { "properties": { "condition": { "const": "repo_topology_partial" } } },
          "then": {
            "properties": { "topology_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "An unavailable checkpoint must keep the reflog recovery destination named.",
          "if": {
            "properties": { "condition": { "const": "checkpoint_recovery_unavailable" } }
          },
          "then": {
            "properties": { "recovery_note": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard_reachable_on_every_claim",
        "screen_reader_labeled_on_every_claim",
        "cli_enum_exposed_on_every_claim",
        "export_enum_exposed_on_every_claim",
        "explanation_field_present_on_every_claim",
        "no_component_pointer_only",
        "no_component_export_opaque",
        "desktop_never_stronger_than_cli",
        "claim_narrows_when_topology_or_recovery_or_provider_degrades",
        "recovery_or_mutation_safety_never_overstated_under_weakening",
        "recovery_destination_kept_explicit",
        "local_continue_preserved_under_degraded_truth"
      ],
      "properties": {
        "keyboard_reachable_on_every_claim": { "const": true },
        "screen_reader_labeled_on_every_claim": { "const": true },
        "cli_enum_exposed_on_every_claim": { "const": true },
        "export_enum_exposed_on_every_claim": { "const": true },
        "explanation_field_present_on_every_claim": { "const": true },
        "no_component_pointer_only": { "const": true },
        "no_component_export_opaque": { "const": true },
        "desktop_never_stronger_than_cli": { "const": true },
        "claim_narrows_when_topology_or_recovery_or_provider_degrades": { "const": true },
        "recovery_or_mutation_safety_never_overstated_under_weakening": { "const": true },
        "recovery_destination_kept_explicit": { "const": true },
        "local_continue_preserved_under_degraded_truth": { "const": true }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposes_keyboard_and_screen_reader_labels",
        "exposes_cli_and_export_enums",
        "exposes_explanation_fields",
        "auto_narrows_on_partial_repo_topology",
        "auto_narrows_on_unavailable_checkpoint_recovery",
        "auto_narrows_on_stale_provider_review_state",
        "auto_narrows_on_offline_local_only",
        "desktop_cli_export_semantics_identical",
        "narrowing_prevents_overstated_recovery_or_mutation_safety",
        "every_component_reachable_non_visually"
      ],
      "properties": {
        "exposes_keyboard_and_screen_reader_labels": { "const": true },
        "exposes_cli_and_export_enums": { "const": true },
        "exposes_explanation_fields": { "const": true },
        "auto_narrows_on_partial_repo_topology": { "const": true },
        "auto_narrows_on_unavailable_checkpoint_recovery": { "const": true },
        "auto_narrows_on_stale_provider_review_state": { "const": true },
        "auto_narrows_on_offline_local_only": { "const": true },
        "desktop_cli_export_semantics_identical": { "const": true },
        "narrowing_prevents_overstated_recovery_or_mutation_safety": { "const": true },
        "every_component_reachable_non_visually": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
