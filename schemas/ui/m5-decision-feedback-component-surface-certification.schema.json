{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-decision-feedback-component-surface-certification.schema.json",
  "title": "Aureline M5 decision-feedback component surface certification packet",
  "description": "M05-1139 closing capstone certifying that the frozen M5 decision-feedback component families (badge-chip-pill, popover, dialog-sheet, banner-inline-notice, toast, empty-state, loading-state, consequence-block) hold their truth on every claimed M5 shell / entry / trust / review / repair / notification operating profile. Keyed on the claimed profile (live trusted decision surface, reviewable decision structure, stale-severity badge surface, unscoped-notice surface, unanchored-popover surface, toast-only durable surface, spinner-loading surface, partial-recovery consequence surface), each row certifies the profile across eight truth axes — visual, keyboard, screen-reader, high-zoom-reflow, reduced-motion, CLI/export, degraded-state, and decision-feedback-component-truth behavior — and either passes (green), auto-narrows its decision claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted decision profile may certify a trusted decision surface; and every B135 guardrail must hold (color is never the only meaning for a badge / banner / inline-notice, a popover never carries the only critical instruction, generic Yes/No copy is never used in a high-risk dialog, durable work is never shown as toast-only truth, a useful pane is never blanked during loading, and a full-screen spinner is never used where partial capability exists). Every row cites exactly one canonical decision-feedback proof bundle. The packet is metadata-only: raw field values, copy payloads, credentials, secrets, and endpoint refs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_decision_feedback_component_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-decision-feedback-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_decision_surface",
        "reviewable_decision_structure",
        "stale_severity_badge_surface",
        "unscoped_notice_surface",
        "unanchored_popover_surface",
        "toast_only_durable_surface",
        "spinner_loading_surface",
        "partial_recovery_consequence_surface"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "reduced_motion",
        "cli_export",
        "degraded_state",
        "decision_feedback_component_truth"
      ]
    },
    "decision_claim": {
      "enum": [
        "trusted_decision_surface",
        "reviewable_decision_surface",
        "severity_unverified_projection",
        "scope_unverified_projection",
        "focus_return_unverified_projection",
        "durable_object_unverified_projection",
        "partial_capability_unverified_projection",
        "recovery_path_disclosed_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "badge_chip_pill",
        "popover",
        "dialog_sheet",
        "banner_inline_notice",
        "toast",
        "empty_state",
        "loading_state",
        "consequence_block"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "color_alone_used_for_meaning",
        "popover_carried_only_critical_instruction",
        "generic_yes_no_used_in_high_risk_dialog",
        "durable_work_shown_as_toast_only",
        "useful_pane_blanked_during_loading",
        "full_screen_spinner_when_partial_capable",
        "rationale_unstated",
        "scope_unstated",
        "recovery_path_unstated",
        "state_taxonomy_drifted",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relies_on_color_alone_for_meaning",
        "lets_popover_carry_only_critical_instruction",
        "uses_generic_yes_no_in_high_risk_dialog",
        "represents_durable_work_as_toast_only",
        "blanks_useful_pane_during_loading",
        "uses_full_screen_spinner_when_partial_capable"
      ],
      "properties": {
        "relies_on_color_alone_for_meaning": { "const": false },
        "lets_popover_carry_only_critical_instruction": { "const": false },
        "uses_generic_yes_no_in_high_risk_dialog": { "const": false },
        "represents_durable_work_as_toast_only": { "const": false },
        "blanks_useful_pane_during_loading": { "const": false },
        "uses_full_screen_spinner_when_partial_capable": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/decision_claim" },
        "to_claim": { "$ref": "#/$defs/decision_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_decision_feedback_component_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/decision_claim" },
        "certified_claim": { "$ref": "#/$defs/decision_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-decision-feedback-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
