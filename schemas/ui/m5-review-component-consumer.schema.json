{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-review-component-consumer.schema.json",
  "title": "M5 Review-Component Consumer Parity Packet",
  "description": "Export-safe packet binding the seven shared M5 review components (review-request row, checks-summary card, pending-review tray, merge-readiness panel, merge-queue entry, stack-dependency chip, approval-invalidation banner) to the desktop list, detail pane, companion triage, Help surface, support packet, and exported-evidence consumers that render them, proving label/action/status/handoff parity for the same review object across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "review_component_consumer_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "review_request_row",
        "checks_summary_card",
        "pending_review_tray",
        "merge_readiness_panel",
        "merge_queue_entry",
        "stack_dependency_chip",
        "approval_invalidation_banner"
      ]
    },
    "consumer": {
      "type": "string",
      "enum": [
        "desktop_list",
        "detail_pane",
        "companion_triage",
        "help_surface",
        "support_export",
        "exported_evidence"
      ]
    },
    "provider_freshness": {
      "type": "string",
      "enum": [
        "provider_fresh",
        "provider_refreshing",
        "provider_stale",
        "provider_unreachable",
        "provider_conflict",
        "local_only_continuation"
      ]
    },
    "render_mode": {
      "type": "string",
      "enum": [
        "full_parity",
        "freshness_narrowed",
        "handoff_required",
        "local_continue_fallback"
      ]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "provider_freshness_degraded",
        "browser_handoff_required",
        "local_continue_engaged"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": [
        "refresh_provider_freshness",
        "open_browser_handoff",
        "continue_local_review"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "provider_freshness_stale",
        "approval_invalidation_pending",
        "browser_handoff_unavailable",
        "local_continue_unavailable",
        "parity_drift_detected",
        "trust_narrowing",
        "upstream_component_narrowed"
      ]
    },
    "parity_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "primary_action",
        "queue_readiness_status_language",
        "handoff_reason"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "primary_action": { "type": "string", "minLength": 1 },
        "queue_readiness_status_language": { "type": "string", "minLength": 1 },
        "handoff_reason": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_facets_note", "next_action", "next_action_label"],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_facets_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "review_object_id",
        "review_object_label",
        "component",
        "consumer",
        "provider_freshness",
        "render_mode",
        "parity_facets",
        "parity_state",
        "narrow_banner",
        "local_continue_note",
        "browser_handoff_boundary",
        "forces_raw_provider_navigation_for_triage",
        "flattens_provider_state_into_local_estimate",
        "hides_approval_invalidation_behind_generic_pill",
        "rewords_labels_per_surface",
        "drops_handoff_reason_or_local_continue",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "review_object_id": { "type": "string", "minLength": 1 },
        "review_object_label": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "consumer": { "$ref": "#/$defs/consumer" },
        "provider_freshness": { "$ref": "#/$defs/provider_freshness" },
        "render_mode": { "$ref": "#/$defs/render_mode" },
        "parity_facets": { "$ref": "#/$defs/parity_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_banner": {
          "oneOf": [{ "$ref": "#/$defs/narrow_banner" }, { "type": "null" }]
        },
        "local_continue_note": { "type": "string" },
        "browser_handoff_boundary": { "type": "string" },
        "forces_raw_provider_navigation_for_triage": { "type": "boolean" },
        "flattens_provider_state_into_local_estimate": { "type": "boolean" },
        "hides_approval_invalidation_behind_generic_pill": { "type": "boolean" },
        "rewords_labels_per_surface": { "type": "boolean" },
        "drops_handoff_reason_or_local_continue": { "type": "boolean" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Full parity renders never carry a narrow banner.",
          "if": { "properties": { "render_mode": { "const": "full_parity" } } },
          "then": { "properties": { "narrow_banner": { "type": "null" } } }
        },
        {
          "comment": "Narrowed renders must carry a narrow banner.",
          "if": {
            "properties": {
              "render_mode": {
                "enum": ["freshness_narrowed", "handoff_required", "local_continue_fallback"]
              }
            }
          },
          "then": {
            "properties": { "narrow_banner": { "$ref": "#/$defs/narrow_banner" } }
          }
        },
        {
          "comment": "Unreachable-provider renders must carry an explicit browser-handoff boundary.",
          "if": {
            "properties": { "provider_freshness": { "const": "provider_unreachable" } }
          },
          "then": {
            "properties": { "browser_handoff_boundary": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_reuse_proven_by_fixtures",
        "same_object_same_language_across_surfaces",
        "provider_state_never_flattened_to_local_estimate",
        "approval_invalidation_never_hidden_behind_generic_pill",
        "primary_actions_identical_across_surfaces",
        "queue_readiness_status_language_identical_across_surfaces",
        "browser_handoff_kept_explicit",
        "local_continue_preserved_under_degraded_freshness",
        "no_forced_raw_provider_navigation_for_triage",
        "help_support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "component_reuse_proven_by_fixtures": { "const": true },
        "same_object_same_language_across_surfaces": { "const": true },
        "provider_state_never_flattened_to_local_estimate": { "const": true },
        "approval_invalidation_never_hidden_behind_generic_pill": { "const": true },
        "primary_actions_identical_across_surfaces": { "const": true },
        "queue_readiness_status_language_identical_across_surfaces": { "const": true },
        "browser_handoff_kept_explicit": { "const": true },
        "local_continue_preserved_under_degraded_freshness": { "const": true },
        "no_forced_raw_provider_navigation_for_triage": { "const": true },
        "help_support_export_point_canonical_contracts": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true },
        "stale_or_underqualified_blocks_promotion": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktop_list_reuses_shared_components",
        "detail_pane_reuses_shared_components",
        "companion_triage_reuses_shared_components",
        "help_surface_reuses_shared_components",
        "support_export_reuses_shared_components",
        "exported_evidence_reuses_shared_components",
        "every_component_adopted_by_two_or_more_consumers",
        "parity_facets_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_preserves_provider_and_queue_identity"
      ],
      "properties": {
        "desktop_list_reuses_shared_components": { "const": true },
        "detail_pane_reuses_shared_components": { "const": true },
        "companion_triage_reuses_shared_components": { "const": true },
        "help_surface_reuses_shared_components": { "const": true },
        "support_export_reuses_shared_components": { "const": true },
        "exported_evidence_reuses_shared_components": { "const": true },
        "every_component_adopted_by_two_or_more_consumers": { "const": true },
        "parity_facets_identical_for_same_object": { "const": true },
        "narrowing_disclosed_not_hidden": { "const": true },
        "export_preserves_provider_and_queue_identity": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
