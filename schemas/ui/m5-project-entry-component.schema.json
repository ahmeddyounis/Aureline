{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-project-entry-component.schema.json",
  "title": "M5 Project-Entry Component Family",
  "description": "Shared schema and controlled vocabularies for the M5 project-entry component family. The component records re-export entry verbs, target kinds, resulting modes, trust states, restore-fidelity classes, and blocked-vs-optional readiness buckets from the frozen UX/workspace contracts so Start Center, recent work, workspace switchers, entry review, restore, admission checkpoints, CLI/headless, deep links, docs/help, support exports, and release proof read one component truth source.",
  "oneOf": [
    { "$ref": "#/$defs/start_center_quick_action_card" },
    { "$ref": "#/$defs/recent_work_row" },
    { "$ref": "#/$defs/workspace_switcher_entry" },
    { "$ref": "#/$defs/restore_prompt_card" },
    { "$ref": "#/$defs/entry_chooser_row" },
    { "$ref": "#/$defs/entry_review_sheet" },
    { "$ref": "#/$defs/destination_collision_sheet" },
    { "$ref": "#/$defs/post_entry_handoff_card" },
    { "$ref": "#/$defs/admission_checkpoint_card" },
    { "$ref": "#/$defs/archetype_readiness_row" }
  ],
  "$defs": {
    "opaque_id": { "type": "string", "minLength": 1 },
    "redaction_aware_text": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "schema_version": { "type": "integer", "const": 1 },
    "entry_verb": {
      "type": "string",
      "enum": ["open", "clone", "import", "add_root", "restore", "resume", "start_from_snapshot"]
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "local_file",
        "local_folder",
        "local_repo_root",
        "workspace_manifest",
        "workset_manifest",
        "remote_repository",
        "ssh_workspace",
        "container_workspace",
        "devcontainer_workspace",
        "managed_cloud_workspace",
        "portable_state_package",
        "handoff_packet",
        "competitor_config_root",
        "template_or_prebuild_snapshot",
        "review_or_work_item_deep_link",
        "recovery_checkpoint"
      ]
    },
    "resulting_mode": {
      "type": "string",
      "enum": [
        "single_file",
        "folder",
        "repo_root",
        "workspace_candidate",
        "workspace_with_roots",
        "workset_slice",
        "inspect_only",
        "clone_then_review",
        "clone_then_open",
        "clone_then_add",
        "clone_only",
        "extract_then_review",
        "compare_before_restore",
        "apply_to_active_workspace",
        "open_prebuild_with_setup_actions",
        "open_prebuild_minimal",
        "resume_live_session",
        "restore_last_session",
        "restore_from_checkpoint"
      ]
    },
    "trust_state": { "type": "string", "enum": ["trusted", "restricted", "pending_evaluation"] },
    "trust_posture_class": {
      "type": "string",
      "enum": [
        "trust_pending_until_admission",
        "trust_never_implied_by_clone",
        "trust_unchanged_until_admit",
        "trust_per_root_admission",
        "trust_inherited_from_target",
        "trust_revalidated_at_resume"
      ]
    },
    "restore_fidelity_class": {
      "type": "string",
      "enum": ["exact_restore", "compatible_restore", "layout_only", "recovered_drafts", "evidence_only", "no_restore"]
    },
    "readiness_bucket": { "type": "string", "enum": ["blocking_now", "recommended_soon", "optional_later"] },
    "blocked_reason_class": {
      "type": "string",
      "enum": ["blocked_by_trust", "blocked_by_policy", "blocked_by_missing_prerequisite", "blocked_by_deployment_profile"]
    },
    "optional_reason_class": {
      "type": "string",
      "enum": ["optional_quality_of_life", "optional_bundle_enhancement", "optional_account_or_sync", "optional_docs_or_learning"]
    },
    "target_state": {
      "type": "string",
      "enum": [
        "reachable",
        "stale_metadata",
        "missing_target",
        "moved_target_detected",
        "missing_mount",
        "remote_unreachable",
        "authority_expired",
        "suspended_managed_workspace",
        "locked_by_other_instance",
        "policy_blocked",
        "quarantined",
        "mode_downgraded",
        "cached_only",
        "unknown"
      ]
    },
    "write_safety_badge": {
      "type": "string",
      "enum": [
        "writes_allowed",
        "writes_require_revalidation",
        "writes_blocked_cached_view_only",
        "writes_blocked_target_unavailable",
        "writes_blocked_policy",
        "writes_unsafe_stale_or_disconnected"
      ]
    },
    "source_locator_kind": {
      "type": "string",
      "enum": [
        "local_path",
        "file_uri",
        "git_https_url",
        "git_ssh_url",
        "archive_ref",
        "handoff_packet_ref",
        "restore_checkpoint_ref",
        "live_session_ref",
        "deep_link_ref"
      ]
    },
    "protocol_class": {
      "type": "string",
      "enum": [
        "local_filesystem",
        "file_uri",
        "git_https",
        "git_ssh",
        "archive",
        "handoff_packet",
        "managed_session",
        "none"
      ]
    },
    "host_class": {
      "type": "string",
      "enum": ["local", "forge_host", "ssh_host", "managed_workspace", "imported_artifact", "none"]
    },
    "auth_posture": {
      "type": "string",
      "enum": [
        "not_applicable",
        "no_auth",
        "uses_existing_credential",
        "auth_required_before_contact",
        "reauth_required",
        "token_redacted"
      ]
    },
    "write_scope": {
      "type": "string",
      "enum": [
        "inspect_only",
        "no_write",
        "writes_new_destination",
        "writes_staging_area",
        "writes_active_workspace",
        "widens_workspace_scope",
        "restores_session_state"
      ]
    },
    "destination_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination_ref", "destination_label", "destination_source"],
      "properties": {
        "destination_ref": { "$ref": "#/$defs/opaque_id" },
        "destination_label": { "$ref": "#/$defs/redaction_aware_text" },
        "destination_source": {
          "type": "string",
          "enum": ["last_used", "recommended", "policy_default", "user_selected", "not_applicable"]
        }
      }
    },
    "side_effect_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_hooks_disclosed",
        "dependency_restore_disclosed",
        "trust_widening_disclosed",
        "hidden_repo_hooks_blocked",
        "hidden_dependency_restore_blocked",
        "hidden_trust_widening_blocked"
      ],
      "properties": {
        "repo_hooks_disclosed": { "type": "boolean" },
        "dependency_restore_disclosed": { "type": "boolean" },
        "trust_widening_disclosed": { "type": "boolean" },
        "hidden_repo_hooks_blocked": { "type": "boolean", "const": true },
        "hidden_dependency_restore_blocked": { "type": "boolean", "const": true },
        "hidden_trust_widening_blocked": { "type": "boolean", "const": true }
      }
    },
    "retained_input_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_class",
        "retained_input_refs",
        "redacted_error_context",
        "repair_actions",
        "retry_uses_retained_input"
      ],
      "properties": {
        "diagnostic_class": {
          "type": "string",
          "enum": [
            "none",
            "target_unreachable",
            "auth_failed",
            "destination_collision",
            "unsupported_import",
            "restore_packet_incomplete",
            "policy_blocked"
          ]
        },
        "retained_input_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opaque_id" }
        },
        "redacted_error_context": { "$ref": "#/$defs/redaction_aware_text" },
        "repair_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_id" }
        },
        "retry_uses_retained_input": { "type": "boolean", "const": true }
      }
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "desktop_shell",
        "start_center",
        "workspace_switcher",
        "open_recent",
        "entry_review",
        "restore_flow",
        "admission_checkpoint",
        "cli_headless",
        "deep_link",
        "docs_help",
        "support_export",
        "release_proof"
      ]
    },
    "copy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_canonical_target_kind_label",
        "uses_canonical_restore_label",
        "uses_canonical_readiness_label",
        "forbids_generic_get_started"
      ],
      "properties": {
        "uses_canonical_target_kind_label": { "type": "boolean", "const": true },
        "uses_canonical_restore_label": { "type": "boolean", "const": true },
        "uses_canonical_readiness_label": { "type": "boolean", "const": true },
        "forbids_generic_get_started": { "type": "boolean", "const": true }
      }
    },
    "base_component": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "record_kind",
        "schema_version",
        "component_id",
        "component_family",
        "component_label",
        "consumer_surfaces",
        "target_kinds",
        "trust_state",
        "trust_posture_class",
        "restore_fidelity_class",
        "resulting_modes",
        "copy_contract",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "type": "string" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "component_id": { "$ref": "#/$defs/opaque_id" },
        "component_family": {
          "type": "string",
          "enum": [
            "start_center_quick_action_card",
            "recent_work_row",
            "workspace_switcher_entry",
            "restore_prompt_card",
            "entry_chooser_row",
            "entry_review_sheet",
            "destination_collision_sheet",
            "post_entry_handoff_card",
            "admission_checkpoint_card",
            "archetype_readiness_row"
          ]
        },
        "component_label": { "$ref": "#/$defs/redaction_aware_text" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "target_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target_kind" }
        },
        "trust_state": { "$ref": "#/$defs/trust_state" },
        "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
        "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
        "resulting_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resulting_mode" }
        },
        "copy_contract": { "$ref": "#/$defs/copy_contract" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opaque_id" }
        }
      }
    },
    "action_id": {
      "type": "string",
      "enum": [
        "open",
        "open_in_new_window",
        "open_restricted",
        "open_read_only_cached_view",
        "locate_missing_target",
        "reconnect",
        "reauth",
        "retry_later",
        "compare_before_restore",
        "open_without_restore",
        "restore_now",
        "skip_once",
        "open_clean",
        "safe_mode",
        "clear_journal",
        "recover_draft",
        "export_evidence",
        "pin",
        "unpin",
        "close_window",
        "move_to_new_window",
        "remove_from_recents",
        "resume",
        "cancel_switch",
        "transfer_window",
        "reopen_previous_workspace",
        "review_trust_and_open",
        "set_up_later",
        "open_minimal",
        "reuse_existing",
        "add_existing_to_workspace",
        "clone_elsewhere",
        "reveal_in_filesystem",
        "inspect_only",
        "cancel_no_change",
        "finish_setup"
      ]
    },
    "collision_source_class": {
      "type": "string",
      "enum": [
        "existing_local_root",
        "prior_workspace_state",
        "duplicate_clone_target",
        "existing_local_path",
        "policy_blocked_destination"
      ]
    },
    "collision_safe_action": {
      "type": "string",
      "enum": [
        "reuse_existing",
        "add_existing_to_workspace",
        "clone_elsewhere",
        "reveal_in_filesystem",
        "inspect_only",
        "cancel_no_change"
      ]
    },
    "follow_up_state_class": {
      "type": "string",
      "enum": [
        "setup_deferred_durable",
        "non_durable_staging",
        "safe_reuse_available",
        "safe_add_existing_available",
        "safe_clone_elsewhere_available",
        "open_minimal_available"
      ]
    },
    "export_share_state": {
      "type": "string",
      "enum": [
        "metadata_only_available",
        "local_only_resume_available",
        "non_durable_staging_not_shareable",
        "not_applicable"
      ]
    },
    "start_center_quick_action_card": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_kind",
            "component_family",
            "entry_verb",
            "primary_action_id",
            "icon_name",
            "card_label",
            "helper_text",
            "badge",
            "command_id",
            "shortcut_disclosure",
            "account_opt_in_posture"
          ],
          "properties": {
            "record_kind": { "const": "m5_start_center_quick_action_card" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "start_center_quick_action_card" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "entry_verb": { "$ref": "#/$defs/entry_verb" },
            "primary_action_id": { "$ref": "#/$defs/action_id" },
            "icon_name": { "type": "string", "minLength": 1 },
            "card_label": { "$ref": "#/$defs/redaction_aware_text" },
            "helper_text": { "$ref": "#/$defs/redaction_aware_text" },
            "badge": { "type": ["string", "null"] },
            "command_id": { "type": "string", "pattern": "^cmd:" },
            "shortcut_disclosure": { "$ref": "#/$defs/redaction_aware_text" },
            "account_opt_in_posture": { "type": "string", "enum": ["optional_local_path_available", "required_for_this_row", "deferred_review_pending", "unavailable_in_this_envelope"] },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "recent_work_row": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_kind",
            "component_family",
            "workspace_or_project_name",
            "target_subtitle",
            "target_kind_label",
            "last_opened_at",
            "target_state",
            "trust_state",
            "restore_availability_label",
            "missing_target_condition",
            "write_safety_badge",
            "row_actions",
            "row_action_labels"
          ],
          "properties": {
            "record_kind": { "const": "m5_recent_work_row" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "recent_work_row" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "workspace_or_project_name": { "$ref": "#/$defs/redaction_aware_text" },
            "target_subtitle": { "$ref": "#/$defs/redaction_aware_text" },
            "target_kind_label": { "$ref": "#/$defs/redaction_aware_text" },
            "last_opened_at": { "$ref": "#/$defs/redaction_aware_text" },
            "target_state": { "$ref": "#/$defs/target_state" },
            "restore_availability_label": { "$ref": "#/$defs/redaction_aware_text" },
            "missing_target_condition": {
              "type": "string",
              "enum": [
                "ready",
                "missing_path",
                "moved_root",
                "reconnect_required",
                "inspect_only",
                "blocked",
                "unknown"
              ]
            },
            "write_safety_badge": { "$ref": "#/$defs/write_safety_badge" },
            "row_actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action_id" } },
            "row_action_labels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/redaction_aware_text" } },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "workspace_switcher_entry": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_kind",
            "component_family",
            "object_identity_ref",
            "object_identity_source",
            "open_window_state",
            "selected_profile_ref",
            "selected_keymap_ref",
            "target_boundary_badges",
            "dirty_session",
            "dirty_buffer_count",
            "restore_badges",
            "target_state",
            "write_safety_badge",
            "row_actions",
            "switcher_entry_classes",
            "cross_window_consequence",
            "close_reopen_move_actions"
          ],
          "properties": {
            "record_kind": { "const": "m5_workspace_switcher_entry" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "workspace_switcher_entry" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "object_identity_ref": { "$ref": "#/$defs/opaque_id" },
            "object_identity_source": {
              "type": "string",
              "enum": [
                "filesystem_identity_ref",
                "remote_target_descriptor_ref",
                "artifact_descriptor_ref",
                "recent_work_id_fallback"
              ]
            },
            "open_window_state": {
              "type": "string",
              "enum": [
                "current_window",
                "open_in_other_window",
                "reopen_available",
                "blocked_or_unavailable"
              ]
            },
            "selected_profile_ref": { "$ref": "#/$defs/opaque_id" },
            "selected_keymap_ref": { "$ref": "#/$defs/opaque_id" },
            "target_boundary_badges": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["local", "remote", "managed", "imported", "cached_only"]
              }
            },
            "dirty_session": { "type": "boolean" },
            "dirty_buffer_count": { "type": "integer", "minimum": 0 },
            "restore_badges": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/opaque_id" }
            },
            "target_state": { "$ref": "#/$defs/target_state" },
            "write_safety_badge": { "$ref": "#/$defs/write_safety_badge" },
            "row_actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action_id" } },
            "switcher_entry_classes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["local", "remote", "managed", "pinned", "recent", "recently_restored", "open_window", "template", "imported"] }
            },
            "cross_window_consequence": { "type": "string", "enum": ["none", "open_new_window", "switch_active_window", "transfer_window", "close_other_window_required"] },
            "close_reopen_move_actions": {
              "type": "array",
              "minItems": 3,
              "contains": { "const": "close_window" },
              "items": { "$ref": "#/$defs/action_id" }
            },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "restore_prompt_card": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_kind",
            "component_family",
            "restore_prompt_ref",
            "object_identity_ref",
            "session_summary",
            "dirty_buffer_count",
            "restore_fidelity_label",
            "partial_or_unsafe_reasons",
            "safest_next_action",
            "restore_actions",
            "restorable_counts",
            "safe_mode_available",
            "open_without_restore_available",
            "clear_journal_available",
            "export_evidence_available"
          ],
          "properties": {
            "record_kind": { "const": "m5_restore_prompt_card" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "restore_prompt_card" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
