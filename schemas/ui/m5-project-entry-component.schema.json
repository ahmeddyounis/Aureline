{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-project-entry-component.schema.json",
  "title": "M5 Project-Entry Component Family",
  "description": "Shared schema and controlled vocabularies for the M5 project-entry component family. The component records re-export entry verbs, target kinds, resulting modes, trust states, restore-fidelity classes, and blocked-vs-optional readiness buckets from the frozen UX/workspace contracts so Start Center, recent work, workspace switchers, entry review, restore, admission checkpoints, CLI/headless, deep links, docs/help, support exports, and release proof read one component truth source.",
  "oneOf": [
    { "$ref": "#/$defs/start_center_quick_action_card" },
    { "$ref": "#/$defs/recent_work_row" },
    { "$ref": "#/$defs/workspace_switcher_entry" },
    { "$ref": "#/$defs/restore_prompt_card" },
    { "$ref": "#/$defs/entry_chooser_row" },
    { "$ref": "#/$defs/entry_review_sheet" },
    { "$ref": "#/$defs/destination_collision_sheet" },
    { "$ref": "#/$defs/post_entry_handoff_card" },
    { "$ref": "#/$defs/admission_checkpoint_card" },
    { "$ref": "#/$defs/archetype_readiness_row" }
  ],
  "$defs": {
    "opaque_id": { "type": "string", "minLength": 1 },
    "redaction_aware_text": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "schema_version": { "type": "integer", "const": 1 },
    "entry_verb": {
      "type": "string",
      "enum": ["open", "clone", "import", "add_root", "restore", "resume", "start_from_snapshot"]
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "local_file",
        "local_folder",
        "local_repo_root",
        "workspace_manifest",
        "workset_manifest",
        "remote_repository",
        "ssh_workspace",
        "container_workspace",
        "devcontainer_workspace",
        "managed_cloud_workspace",
        "portable_state_package",
        "handoff_packet",
        "competitor_config_root",
        "template_or_prebuild_snapshot",
        "review_or_work_item_deep_link",
        "recovery_checkpoint"
      ]
    },
    "resulting_mode": {
      "type": "string",
      "enum": [
        "single_file",
        "folder",
        "repo_root",
        "workspace_candidate",
        "workspace_with_roots",
        "workset_slice",
        "inspect_only",
        "clone_then_review",
        "clone_then_open",
        "clone_then_add",
        "clone_only",
        "extract_then_review",
        "compare_before_restore",
        "apply_to_active_workspace",
        "open_prebuild_with_setup_actions",
        "open_prebuild_minimal",
        "resume_live_session",
        "restore_last_session",
        "restore_from_checkpoint"
      ]
    },
    "trust_state": { "type": "string", "enum": ["trusted", "restricted", "pending_evaluation"] },
    "trust_posture_class": {
      "type": "string",
      "enum": [
        "trust_pending_until_admission",
        "trust_never_implied_by_clone",
        "trust_unchanged_until_admit",
        "trust_per_root_admission",
        "trust_inherited_from_target",
        "trust_revalidated_at_resume"
      ]
    },
    "restore_fidelity_class": {
      "type": "string",
      "enum": ["exact_restore", "compatible_restore", "layout_only", "recovered_drafts", "evidence_only", "no_restore"]
    },
    "readiness_bucket": { "type": "string", "enum": ["blocking_now", "recommended_soon", "optional_later"] },
    "blocked_reason_class": {
      "type": "string",
      "enum": ["blocked_by_trust", "blocked_by_policy", "blocked_by_missing_prerequisite", "blocked_by_deployment_profile"]
    },
    "optional_reason_class": {
      "type": "string",
      "enum": ["optional_quality_of_life", "optional_bundle_enhancement", "optional_account_or_sync", "optional_docs_or_learning"]
    },
    "target_state": {
      "type": "string",
      "enum": [
        "reachable",
        "stale_metadata",
        "missing_target",
        "moved_target_detected",
        "missing_mount",
        "remote_unreachable",
        "authority_expired",
        "suspended_managed_workspace",
        "locked_by_other_instance",
        "policy_blocked",
        "quarantined",
        "mode_downgraded",
        "cached_only",
        "unknown"
      ]
    },
    "write_safety_badge": {
      "type": "string",
      "enum": [
        "writes_allowed",
        "writes_require_revalidation",
        "writes_blocked_cached_view_only",
        "writes_blocked_target_unavailable",
        "writes_blocked_policy",
        "writes_unsafe_stale_or_disconnected"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "desktop_shell",
        "start_center",
        "workspace_switcher",
        "open_recent",
        "entry_review",
        "restore_flow",
        "admission_checkpoint",
        "cli_headless",
        "deep_link",
        "docs_help",
        "support_export",
        "release_proof"
      ]
    },
    "copy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_canonical_target_kind_label",
        "uses_canonical_restore_label",
        "uses_canonical_readiness_label",
        "forbids_generic_get_started"
      ],
      "properties": {
        "uses_canonical_target_kind_label": { "type": "boolean", "const": true },
        "uses_canonical_restore_label": { "type": "boolean", "const": true },
        "uses_canonical_readiness_label": { "type": "boolean", "const": true },
        "forbids_generic_get_started": { "type": "boolean", "const": true }
      }
    },
    "base_component": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "record_kind",
        "schema_version",
        "component_id",
        "component_family",
        "component_label",
        "consumer_surfaces",
        "target_kinds",
        "trust_state",
        "trust_posture_class",
        "restore_fidelity_class",
        "resulting_modes",
        "copy_contract",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "type": "string" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "component_id": { "$ref": "#/$defs/opaque_id" },
        "component_family": {
          "type": "string",
          "enum": [
            "start_center_quick_action_card",
            "recent_work_row",
            "workspace_switcher_entry",
            "restore_prompt_card",
            "entry_chooser_row",
            "entry_review_sheet",
            "destination_collision_sheet",
            "post_entry_handoff_card",
            "admission_checkpoint_card",
            "archetype_readiness_row"
          ]
        },
        "component_label": { "$ref": "#/$defs/redaction_aware_text" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "target_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target_kind" }
        },
        "trust_state": { "$ref": "#/$defs/trust_state" },
        "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
        "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
        "resulting_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resulting_mode" }
        },
        "copy_contract": { "$ref": "#/$defs/copy_contract" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opaque_id" }
        }
      }
    },
    "action_id": {
      "type": "string",
      "enum": [
        "open",
        "open_in_new_window",
        "open_restricted",
        "open_read_only_cached_view",
        "locate_missing_target",
        "reconnect",
        "reauth",
        "retry_later",
        "compare_before_restore",
        "open_without_restore",
        "restore_now",
        "skip_once",
        "open_clean",
        "recover_draft",
        "export_evidence",
        "pin",
        "unpin",
        "remove_from_recents",
        "resume",
        "cancel_switch",
        "transfer_window",
        "reopen_previous_workspace",
        "review_trust_and_open",
        "set_up_later"
      ]
    },
    "start_center_quick_action_card": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "entry_verb", "primary_action_id", "account_opt_in_posture"],
          "properties": {
            "record_kind": { "const": "m5_start_center_quick_action_card" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "start_center_quick_action_card" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "entry_verb": { "$ref": "#/$defs/entry_verb" },
            "primary_action_id": { "$ref": "#/$defs/action_id" },
            "account_opt_in_posture": { "type": "string", "enum": ["optional_local_path_available", "required_for_this_row", "deferred_review_pending", "unavailable_in_this_envelope"] },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "recent_work_row": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "target_state", "write_safety_badge", "row_actions"],
          "properties": {
            "record_kind": { "const": "m5_recent_work_row" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "recent_work_row" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "target_state": { "$ref": "#/$defs/target_state" },
            "write_safety_badge": { "$ref": "#/$defs/write_safety_badge" },
            "row_actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action_id" } },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "workspace_switcher_entry": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "target_state", "write_safety_badge", "row_actions", "switcher_entry_classes", "cross_window_consequence"],
          "properties": {
            "record_kind": { "const": "m5_workspace_switcher_entry" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "workspace_switcher_entry" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "target_state": { "$ref": "#/$defs/target_state" },
            "write_safety_badge": { "$ref": "#/$defs/write_safety_badge" },
            "row_actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action_id" } },
            "switcher_entry_classes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["local", "remote", "managed", "pinned", "recent", "recently_restored", "open_window", "template", "imported"] }
            },
            "cross_window_consequence": { "type": "string", "enum": ["none", "open_new_window", "switch_active_window", "transfer_window", "close_other_window_required"] },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "restore_prompt_card": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "restore_prompt_ref", "restore_actions", "restorable_counts"],
          "properties": {
            "record_kind": { "const": "m5_restore_prompt_card" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "restore_prompt_card" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "restore_prompt_ref": { "$ref": "#/$defs/opaque_id" },
            "restore_actions": { "type": "array", "contains": { "const": "restore_now" }, "items": { "$ref": "#/$defs/action_id" } },
            "restorable_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "entry_chooser_row": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "entry_verb_candidate", "target_kind_candidates", "resulting_mode_candidates", "next_step_decision_hooks"],
          "properties": {
            "record_kind": { "const": "m5_entry_chooser_row" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "entry_chooser_row" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "entry_verb_candidate": { "$ref": "#/$defs/entry_verb" },
            "target_kind_candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target_kind" } },
            "resulting_mode_candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resulting_mode" } },
            "next_step_decision_hooks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action_id" } },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "entry_review_sheet": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "entry_verb_candidate", "target_kind_candidates", "resulting_mode_candidates", "next_step_decision_hooks", "destination_disposition", "reviewed_before_write"],
          "properties": {
            "record_kind": { "const": "m5_entry_review_sheet" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "entry_review_sheet" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "entry_verb_candidate": { "$ref": "#/$defs/entry_verb" },
            "target_kind_candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target_kind" } },
            "resulting_mode_candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resulting_mode" } },
            "next_step_decision_hooks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action_id" } },
            "destination_disposition": { "type": "string", "enum": ["no_write", "staging_area", "new_destination", "existing_empty_destination", "existing_non_empty_destination", "active_workspace"] },
            "reviewed_before_write": { "type": "boolean", "const": true },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "destination_collision_sheet": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "collision_class", "safe_actions", "blocks_until_choice"],
          "properties": {
            "record_kind": { "const": "m5_destination_collision_sheet" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "destination_collision_sheet" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "collision_class": { "type": "string", "enum": ["none", "existing_empty_path", "existing_non_empty_path", "existing_repo_root_match", "existing_workspace_file", "previously_cloned_target_match", "policy_blocked_destination"] },
            "safe_actions": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["choose_new_destination", "reuse_existing", "open_existing", "clone_to_staging", "cancel"] } },
            "blocks_until_choice": { "type": "boolean", "const": true },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "post_entry_handoff_card": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "entry_verb", "admission_checkpoint_ref", "first_useful_work_route", "handoff_actions"],
          "properties": {
            "record_kind": { "const": "m5_post_entry_handoff_card" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "post_entry_handoff_card" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "entry_verb": { "$ref": "#/$defs/entry_verb" },
            "admission_checkpoint_ref": { "$ref": "#/$defs/opaque_id" },
            "first_useful_work_route": { "type": "string", "enum": ["ordinary_editing", "review_before_trust", "compare_before_restore", "inspect_import", "resume_live_session", "setup_later"] },
            "handoff_actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action_id" } },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "admission_checkpoint_card": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "admission_class", "readiness_bucket_summary", "ordinary_editing_available"],
          "properties": {
            "record_kind": { "const": "m5_admission_checkpoint_card" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "admission_checkpoint_card" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "admission_class": { "type": "string", "enum": ["admitted", "trust_review_required", "needs_repair", "policy_blocked", "unsupported_target", "missing_prerequisite"] },
            "readiness_bucket_summary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["blocking_now_total", "recommended_soon_total", "optional_later_total"],
              "properties": {
                "blocking_now_total": { "type": "integer", "minimum": 0 },
                "recommended_soon_total": { "type": "integer", "minimum": 0 },
                "optional_later_total": { "type": "integer", "minimum": 0 }
              }
            },
            "blocked_reason_classes": { "type": "array", "items": { "$ref": "#/$defs/blocked_reason_class" } },
            "optional_reason_classes": { "type": "array", "items": { "$ref": "#/$defs/optional_reason_class" } },
            "ordinary_editing_available": { "type": "boolean" },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    },
    "archetype_readiness_row": {
      "allOf": [
        { "$ref": "#/$defs/base_component" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_kind", "component_family", "detected_archetype_class", "readiness_bucket", "setup_location_class"],
          "properties": {
            "record_kind": { "const": "m5_archetype_readiness_row" },
            "schema_version": { "$ref": "#/$defs/schema_version" },
            "component_id": { "$ref": "#/$defs/opaque_id" },
            "component_family": { "const": "archetype_readiness_row" },
            "component_label": { "$ref": "#/$defs/redaction_aware_text" },
            "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/consumer_surface" } },
            "target_kinds": { "type": "array", "items": { "$ref": "#/$defs/target_kind" } },
            "trust_state": { "$ref": "#/$defs/trust_state" },
            "trust_posture_class": { "$ref": "#/$defs/trust_posture_class" },
            "restore_fidelity_class": { "$ref": "#/$defs/restore_fidelity_class" },
            "resulting_modes": { "type": "array", "items": { "$ref": "#/$defs/resulting_mode" } },
            "detected_archetype_class": { "type": "string", "enum": ["certified", "probable", "generic", "mixed", "restricted", "missing_prerequisite"] },
            "readiness_bucket": { "$ref": "#/$defs/readiness_bucket" },
            "setup_location_class": { "type": "string", "enum": ["local_workspace", "remote_workspace", "container", "devcontainer", "managed_cloud", "profile_or_policy", "external_provider"] },
            "blocked_reason_class": { "$ref": "#/$defs/blocked_reason_class" },
            "optional_reason_class": { "$ref": "#/$defs/optional_reason_class" },
            "copy_contract": { "$ref": "#/$defs/copy_contract" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/opaque_id" } }
          }
        }
      ]
    }
  }
}
