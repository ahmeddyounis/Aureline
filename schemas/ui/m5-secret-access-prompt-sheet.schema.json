{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-secret-access-prompt-sheet.schema.json",
  "title": "Aureline M5 secret-access-prompt sheet component",
  "description": "Names which credential class is being requested, the reveal posture it honours, and the auth-handoff class it will complete \u2014 so a prompt never conceals whether a raw secret will be exposed or how the handoff completes. Canonical per-component contract frozen by the M5 credential component matrix (schemas/ui/m5-credential-component-matrix.schema.json); downstream M5 rows point at this schema instead of restating credential UI truth by hand. Raw secret values, tokens, passphrases, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "credential_class",
    "reveal_posture",
    "auth_handoff_class",
    "degraded_state",
    "required_labels"
  ],
  "properties": {
    "component_family": {
      "const": "secret_access_prompt_sheet"
    },
    "credential_class": {
      "enum": [
        "oauth_token",
        "api_key",
        "personal_access_token",
        "ssh_or_signing_key",
        "client_certificate",
        "device_code_grant"
      ]
    },
    "reveal_posture": {
      "enum": [
        "handle_only",
        "masked_last_four",
        "reveal_on_demand",
        "clipboard_scoped",
        "never_revealed",
        "policy_blocked_reveal"
      ]
    },
    "auth_handoff_class": {
      "enum": [
        "system_browser_redirect",
        "device_code_poll",
        "embedded_prompt",
        "passkey_step_up",
        "delegated_forward",
        "offline_deferred"
      ]
    },
    "degraded_state": {
      "enum": [
        "fully_available",
        "limited_capability",
        "stale_needs_reauth",
        "offline_cached",
        "policy_blocked",
        "unavailable"
      ]
    },
    "required_labels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "state",
          "keyboard_route",
          "storage_and_reveal_posture",
          "identity_and_delegation",
          "expiry_and_export_boundary"
        ]
      }
    }
  }
}
