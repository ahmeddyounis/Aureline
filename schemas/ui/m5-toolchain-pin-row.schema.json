{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-toolchain-pin-row.schema.json",
  "title": "M5 Toolchain-Pin Row, Precedence Inspector, and Switch-Review Card Primitive Packet",
  "description": "Export-safe packet binding every claimed M5 environment selector to the shared toolchain-pin-row, precedence-inspector, and switch-review-card anatomy, with a worked resolver proving winning-scope, shadowed-layer, and revert-or-repair truth. Minted only by the aureline_shell_m5_toolchain_pin_switch_review_primitive emitter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "selector_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_toolchain_pin_row_precedence_inspector_and_switch_review_card_winning_scope_shadowed_layer_and_revert_or_repair_primitive"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "selector_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/definitions/selectorRow" }
    },
    "vocabulary_set": { "$ref": "#/definitions/vocabularySet" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "selection_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "selection_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "pinScope": {
      "enum": [
        "policy_scope",
        "session_scope",
        "project_scope",
        "workspace_scope",
        "user_scope",
        "host_scope",
        "global_default_scope"
      ]
    },
    "toolchainSource": {
      "enum": [
        "pin_file",
        "workspace_setting",
        "version_manager",
        "system_installed",
        "container_image",
        "session_override"
      ]
    },
    "pinState": {
      "enum": [
        "pinned_resolved",
        "pinned_missing_fallback",
        "unpinned",
        "pin_conflict",
        "pin_overridden"
      ]
    },
    "selectionHealth": {
      "enum": [
        "healthy",
        "degraded_stale",
        "mismatched_version",
        "missing_unavailable"
      ]
    },
    "pinAction": {
      "enum": [
        "review_precedence",
        "clear_override",
        "revert_to_shadowed_pin",
        "repair_selection"
      ]
    },
    "blastRadius": {
      "enum": [
        "no_writes_preview",
        "workspace_scoped",
        "toolchain_scoped",
        "host_environment_scoped",
        "multi_target_scoped"
      ]
    },
    "reversibility": {
      "enum": [
        "fully_reversible_checkpoint",
        "reversible_with_backup",
        "partially_reversible",
        "irreversible_confirmed",
        "reversal_requires_manual_steps"
      ]
    },
    "candidateLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "source", "selection_repr", "present"],
      "properties": {
        "scope": { "$ref": "#/definitions/pinScope" },
        "source": { "$ref": "#/definitions/toolchainSource" },
        "selection_repr": { "type": "string" },
        "present": { "type": "boolean" }
      }
    },
    "rankedLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "source",
        "selection_repr",
        "precedence_rank",
        "is_winner",
        "is_durable_pin",
        "shadow_reason"
      ],
      "properties": {
        "scope": { "$ref": "#/definitions/pinScope" },
        "source": { "$ref": "#/definitions/toolchainSource" },
        "selection_repr": { "type": "string", "minLength": 1 },
        "precedence_rank": { "type": "integer", "minimum": 0, "maximum": 6 },
        "is_winner": { "type": "boolean" },
        "is_durable_pin": { "type": "boolean" },
        "shadow_reason": { "type": ["string", "null"] }
      }
    },
    "switchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to_scope",
        "to_source",
        "to_selection_repr",
        "requires_restart",
        "requires_reconnect",
        "newly_blocked_actions",
        "safe_local_only_fallback"
      ],
      "properties": {
        "to_scope": { "$ref": "#/definitions/pinScope" },
        "to_source": { "$ref": "#/definitions/toolchainSource" },
        "to_selection_repr": { "type": "string", "minLength": 1 },
        "requires_restart": { "type": "boolean" },
        "requires_reconnect": { "type": "boolean" },
        "newly_blocked_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "safe_local_only_fallback": { "type": "boolean" }
      }
    },
    "switchReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to_scope",
        "to_source",
        "to_selection_repr",
        "restart_required",
        "reconnect_required",
        "newly_blocked_actions",
        "blocks_actions_after_switch",
        "safe_local_only_fallback",
        "blast_radius",
        "reversibility"
      ],
      "properties": {
        "to_scope": { "$ref": "#/definitions/pinScope" },
        "to_source": { "$ref": "#/definitions/toolchainSource" },
        "to_selection_repr": { "type": "string", "minLength": 1 },
        "restart_required": { "type": "boolean" },
        "reconnect_required": { "type": "boolean" },
        "newly_blocked_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocks_actions_after_switch": { "type": "boolean" },
        "safe_local_only_fallback": { "type": "boolean" },
        "blast_radius": { "$ref": "#/definitions/blastRadius" },
        "reversibility": { "$ref": "#/definitions/reversibility" }
      }
    },
    "resolutionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_title",
        "target_kind",
        "candidate_layers",
        "selection_health",
        "switch_request"
      ],
      "properties": {
        "target_title": { "type": "string", "minLength": 1 },
        "target_kind": {
          "enum": ["interpreter", "sdk", "shell", "kernel", "runtime"]
        },
        "candidate_layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/candidateLayer" }
        },
        "selection_health": { "$ref": "#/definitions/selectionHealth" },
        "switch_request": {
          "oneOf": [
            { "$ref": "#/definitions/switchRequest" },
            { "type": "null" }
          ]
        }
      }
    },
    "resolvedSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_title",
        "target_kind",
        "winning_scope",
        "winning_source",
        "winning_selection_repr",
        "pin_state",
        "selection_health",
        "selection_is_degraded",
        "ordered_layers",
        "discloses_shadowed_pins",
        "shadows_durable_pin",
        "available_actions",
        "exposes_repair_when_degraded",
        "switch_review"
      ],
      "properties": {
        "target_title": { "type": "string", "minLength": 1 },
        "target_kind": {
          "enum": ["interpreter", "sdk", "shell", "kernel", "runtime"]
        },
        "winning_scope": { "$ref": "#/definitions/pinScope" },
        "winning_source": { "$ref": "#/definitions/toolchainSource" },
        "winning_selection_repr": { "type": "string", "minLength": 1 },
        "pin_state": { "$ref": "#/definitions/pinState" },
        "selection_health": { "$ref": "#/definitions/selectionHealth" },
        "selection_is_degraded": { "type": "boolean" },
        "ordered_layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/rankedLayer" }
        },
        "discloses_shadowed_pins": { "type": "boolean" },
        "shadows_durable_pin": { "type": "boolean" },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/pinAction" }
        },
        "exposes_repair_when_degraded": { "type": "boolean" },
        "switch_review": {
          "oneOf": [
            { "$ref": "#/definitions/switchReview" },
            { "type": "null" }
          ]
        }
      }
    },
    "resolutionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/definitions/resolutionInput" },
        "resolved": { "$ref": "#/definitions/resolvedSelection" }
      }
    },
    "selectorRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "pin_row_parts",
        "inspector_parts",
        "switch_card_parts",
        "target_kinds",
        "pin_states",
        "pin_scopes",
        "selection_health_states",
        "pin_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "silently_shadows_durable_pin",
        "shows_degraded_as_resolved",
        "invents_private_selection_grammar",
        "hides_switch_blast_radius"
      ],
      "properties": {
        "selector_surface": {
          "enum": [
            "status_bar_selector",
            "command_palette_switcher",
            "settings_toolchain_row",
            "interpreter_picker",
            "sdk_selector",
            "shell_profile_picker",
            "kernel_picker",
            "runtime_target_switcher",
            "repair_panel_selector"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "shell_zone_slot": { "type": "string", "minLength": 1 },
        "responsive_classes": { "type": "array", "items": { "type": "string" } },
        "window_classes": { "type": "array", "items": { "type": "string" } },
        "pin_row_parts": {
          "type": "array",
          "items": {
            "enum": [
              "target_kind",
              "current_selection",
              "winning_scope",
              "source_provenance",
              "conflict_or_override_note",
              "clear_or_revert_action"
            ]
          },
          "allOf": [
            { "contains": { "const": "target_kind" } },
            { "contains": { "const": "current_selection" } },
            { "contains": { "const": "winning_scope" } },
            { "contains": { "const": "source_provenance" } }
          ]
        },
        "inspector_parts": {
          "type": "array",
          "items": {
            "enum": [
              "ordered_winning_stack",
              "overshadowed_candidates",
              "shadow_explanation",
              "affected_surfaces"
            ]
          },
          "allOf": [
            { "contains": { "const": "ordered_winning_stack" } },
            { "contains": { "const": "overshadowed_candidates" } },
            { "contains": { "const": "shadow_explanation" } }
          ]
        },
        "switch_card_parts": {
          "type": "array",
          "items": {
            "enum": [
              "immediate_changes",
              "restart_or_reconnect_requirement",
              "newly_blocked_actions",
              "safe_local_only_fallback",
              "blast_radius_and_reversibility"
            ]
          },
          "allOf": [
            { "contains": { "const": "immediate_changes" } },
            { "contains": { "const": "restart_or_reconnect_requirement" } },
            { "contains": { "const": "safe_local_only_fallback" } }
          ]
        },
        "target_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["interpreter", "sdk", "shell", "kernel", "runtime"]
          }
        },
        "pin_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/pinState" }
        },
        "pin_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/pinScope" }
        },
        "selection_health_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/selectionHealth" }
        },
        "pin_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/pinAction" }
        },
        "export_fields": {
          "type": "array",
          "items": { "type": "string" },
          "allOf": [
            { "contains": { "const": "target_kind" } },
            { "contains": { "const": "winning_scope" } },
            { "contains": { "const": "winning_source" } },
            { "contains": { "const": "pin_state" } },
            { "contains": { "const": "selection_health" } },
            { "contains": { "const": "available_actions" } }
          ]
        },
        "accessibility_routes": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/resolutionCase" }
        },
        "silently_shadows_durable_pin": { "const": false },
        "shows_degraded_as_resolved": { "const": false },
        "invents_private_selection_grammar": { "const": false },
        "hides_switch_blast_radius": { "const": false }
      }
    },
    "vocabularySet": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
