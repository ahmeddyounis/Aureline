{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-efficiency-component-consumer.schema.json",
  "title": "Aureline M5 adaptive-efficiency component consumer adoption",
  "description": "M05-1066 consumer-adoption lane over the frozen M5 adaptive-efficiency component matrix. Proves that the eight reusable adaptive-efficiency component families (power-state indicator, throttled-subsystem row, background-work row / banner, per-workspace override sheet, override-policy note row, resume-summary card, stale-result continuity note) are reused as primitives across five claimed M5 consumer classes — shell-status / activity-center, notebook / preview / pipeline / graph work-content, docs-browser / companion-adjacent, incident / diagnostics, and support / export + Help/About — rather than being reinvented as per-surface low-power prose. Each row points back to exactly one canonical component family (its matrix schema) and the one canonical controls contract (schema + doc + release-proof artifact) its family group belongs to, and preserves the identical source-of-change / active-efficiency-state / slowed-versus-paused / what-still-works / override-availability / policy-owner / resumed-work-backlog / stale-result-continuity / next-safe-action labels and the frozen work-disposition vocabulary. The same constrained or recovered state renders with one vocabulary and one component family across every claimed consumer (AC1); Help/support/export consumers drop bespoke per-lane prose (AC2). The four spec guardrails stay false per row: no consumer collapses battery saver / thermal pressure / user-selected low-power mode / policy cap into one generic warning, hides paused work behind toast-only messaging, presents an override as available when policy blocks it, or clears stale-result context merely because background work resumed. The packet is metadata-only: raw battery / thermal telemetry, workspace secrets, and scheduler cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_efficiency_component_consumer_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "power_state_indicator",
        "throttled_subsystem_row",
        "background_work_row",
        "background_work_banner",
        "per_workspace_override_sheet",
        "override_policy_note_row",
        "resume_summary_card",
        "stale_result_continuity_note"
      ]
    },
    "controls_lane": {
      "type": "string",
      "enum": [
        "power_throttle",
        "background_work",
        "override_policy",
        "resume_continuity"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "shell_status_activity",
        "work_content_surface",
        "docs_browser_companion",
        "incident_diagnostics",
        "support_export_help"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_status_bar",
        "activity_center",
        "background_work_tray",
        "notebook_canvas",
        "preview_pane",
        "pipeline_runner",
        "graph_explorer",
        "docs_browser_handoff",
        "companion_adjacent",
        "incident_console",
        "diagnostics_panel",
        "support_export_replay",
        "help_about_reference"
      ]
    },
    "authority_mode": {
      "type": "string",
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "override_gated",
        "export_only",
        "policy_blocked"
      ]
    },
    "handoff_target": {
      "type": "string",
      "enum": [
        "none",
        "desktop_shell",
        "companion_app",
        "browser_readonly",
        "support_packet",
        "cli_headless"
      ]
    },
    "label_parity": {
      "type": "string",
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_class",
        "consumer_surface",
        "component_family",
        "controls_lane",
        "canonical_family_schema_ref",
        "canonical_controls_schema_ref",
        "canonical_controls_artifact_refs",
        "references_canonical_not_local_prose",
        "constrained_state_ref",
        "authority_mode",
        "preserved_label_families",
        "work_disposition_vocab",
        "label_parity",
        "handoff_target",
        "copy_export",
        "collapses_pressure_sources_into_generic_warning",
        "hides_paused_work_behind_toast_only",
        "presents_override_available_when_policy_blocks",
        "clears_stale_context_on_resume",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_efficiency_component_consumer_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_class": { "$ref": "#/$defs/consumer_class" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "controls_lane": { "$ref": "#/$defs/controls_lane" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "constrained_state_ref": { "type": "string", "minLength": 1 },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "work_disposition_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "collapses_pressure_sources_into_generic_warning": {
          "type": "boolean",
          "const": false
        },
        "hides_paused_work_behind_toast_only": {
          "type": "boolean",
          "const": false
        },
        "presents_override_available_when_policy_blocks": {
          "type": "boolean",
          "const": false
        },
        "clears_stale_context_on_resume": { "type": "boolean", "const": false },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_class_count",
        "consumer_surface_count",
        "component_family_count",
        "controls_lane_count",
        "work_disposition_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_use_canonical_controls_lane",
        "all_constrained_rows_preserve_truth",
        "all_rows_reconstructable",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "all_rows_guardrails_clear",
        "controls_lanes_stable_across_surfaces",
        "shell_status_activity_consumer_present",
        "work_content_consumer_present",
        "docs_browser_companion_consumer_present",
        "incident_diagnostics_consumer_present",
        "support_export_help_consumer_present",
        "docs_help_reference_present",
        "label_family_coverage_complete",
        "work_disposition_coverage_complete",
        "families_reused_across_classes"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_class_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "controls_lane_count": { "type": "integer", "minimum": 0 },
        "work_disposition_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_use_canonical_controls_lane": { "type": "boolean" },
        "all_constrained_rows_preserve_truth": { "type": "boolean" },
        "all_rows_reconstructable": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "all_rows_guardrails_clear": { "type": "boolean" },
        "controls_lanes_stable_across_surfaces": { "type": "boolean" },
        "shell_status_activity_consumer_present": { "type": "boolean" },
        "work_content_consumer_present": { "type": "boolean" },
        "docs_browser_companion_consumer_present": { "type": "boolean" },
        "incident_diagnostics_consumer_present": { "type": "boolean" },
        "support_export_help_consumer_present": { "type": "boolean" },
        "docs_help_reference_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "work_disposition_coverage_complete": { "type": "boolean" },
        "families_reused_across_classes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
