{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-secret-guard-confirmation.schema.json",
  "title": "Aureline M5 secret-guard confirmation",
  "description": "Canonical per-domain descriptor for the confirmation or deny outcome of a paste / secret guard on a shared terminal / debug surface. Names the risky-action class it decided, the disclosed scope, target, and reason it was shown, the guard outcome (allowed with confirm, step-up required, denied, or blocked), and the audit-safe attribution of who decided so a declined or blocked event stays attributable. Raw secrets, raw command text, raw variable bodies, and raw clipboard contents never cross this boundary — only metadata about the decision does.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "collaboration_control_association",
    "risky_action_class",
    "guard_outcome",
    "attribution_ref"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "secret_guard_confirmation"
      ]
    },
    "collaboration_control_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "risky_action_class": {
      "$ref": "#/$defs/risky_action_class"
    },
    "disclosed_scope": {
      "$ref": "#/$defs/non_empty_string"
    },
    "disclosed_target": {
      "$ref": "#/$defs/non_empty_string"
    },
    "disclosed_reason": {
      "$ref": "#/$defs/non_empty_string"
    },
    "guard_outcome": {
      "$ref": "#/$defs/guard_outcome"
    },
    "attribution_ref": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "risky_action_class": {
      "enum": [
        "high_risk_paste",
        "terminal_broadcast",
        "clipboard_bridge",
        "debug_evaluate",
        "environment_variable_reveal",
        "variable_body_reveal"
      ]
    },
    "guard_outcome": {
      "enum": [
        "disclosed_awaiting_confirm",
        "allowed_with_confirm",
        "step_up_required",
        "denied",
        "blocked_no_consent"
      ]
    }
  }
}
