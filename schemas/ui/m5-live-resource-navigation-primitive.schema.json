{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-live-resource-navigation-primitive.schema.json",
  "title": "Aureline M5 live-resource navigation primitive",
  "description": "Canonical parity matrix for the reusable M5 live-resource navigation primitive: a source-to-live resource-link row, a rendered/live compare card, a resource-explorer row, and a drift/unavailable banner that all resolve from one live-resource context and share one resource identity and one disclosed truth class. Narrows two families of the frozen M5 manifest/build component matrix (resource-link row, resource-explorer row) plus the compare card and drift banner they imply into one working resolver. Source config and live/cached truth never blur (AC1); drift and unavailability are visible before users act (AC2); partial or permission-limited data is never presented as fully current (AC3). Raw resource bodies, credentials, and endpoint data never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_live_resource_navigation_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "source_to_live_navigator",
        "rendered_live_compare",
        "cluster_resource_explorer",
        "drift_unavailable_banner",
        "provider_console_handoff",
        "support_export_replay"
      ]
    },
    "resource_kind": {
      "enum": ["workload", "network", "config", "storage", "identity", "custom_resource"]
    },
    "health": {
      "enum": ["healthy", "degraded", "progressing", "unavailable", "unknown"]
    },
    "permission": {
      "enum": ["full_access", "read_only", "permission_limited", "connection_lost", "offline"]
    },
    "compare_verdict": {
      "enum": [
        "in_sync",
        "drifted",
        "rendered_only_no_live",
        "live_only_unmanaged",
        "overlay_authoritative",
        "comparison_unavailable"
      ]
    },
    "action_kind": {
      "enum": [
        "open_detail",
        "view_logs",
        "view_events",
        "inspect_diff",
        "open_in_provider_console"
      ]
    },
    "export_field": {
      "enum": [
        "resource_id",
        "resource_identity",
        "target_identity",
        "truth_class",
        "freshness",
        "confidence",
        "permission_posture"
      ]
    },
    "truth_mode": {
      "enum": ["authored_desired", "rendered", "planned", "live", "provider_overlay"]
    },
    "truth_mode_enum": {
      "enum": ["desired", "rendered", "plan", "live", "provider_overlay"]
    },
    "resource_link_class": {
      "enum": [
        "authored_to_rendered",
        "rendered_to_live",
        "plan_to_live",
        "schema_backed",
        "cross_target"
      ]
    },
    "resource_freshness": {
      "enum": ["live_fresh", "cached_stale", "imported_snapshot", "plan_only", "unknown"]
    },
    "discovery_confidence": {
      "enum": ["high", "medium", "low", "unknown"]
    },
    "downgrade_trigger": {
      "enum": [
        "schema_stale",
        "adapter_unavailable",
        "connector_loss",
        "policy_block",
        "drift_from_source",
        "low_confidence_discovery",
        "structured_channel_lost",
        "target_context_unresolved"
      ]
    },
    "resource_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_kind", "stable_id"],
      "properties": {
        "resource_kind": { "$ref": "#/$defs/resource_kind" },
        "stable_id": { "type": "string", "minLength": 1 },
        "namespace": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"] }
      }
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "navigation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "resource_ref",
        "resource_label",
        "identity",
        "link_class",
        "from_truth",
        "to_truth",
        "truth_mode",
        "freshness",
        "confidence",
        "permission",
        "health",
        "compare_verdict",
        "target_identity_ref",
        "available_actions"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "resource_ref": { "$ref": "#/$defs/ref" },
        "resource_label": { "type": "string", "minLength": 1 },
        "identity": { "$ref": "#/$defs/resource_identity" },
        "link_class": { "$ref": "#/$defs/resource_link_class" },
        "from_truth": { "$ref": "#/$defs/truth_mode_enum" },
        "to_truth": { "$ref": "#/$defs/truth_mode_enum" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "freshness": { "$ref": "#/$defs/resource_freshness" },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "permission": { "$ref": "#/$defs/permission" },
        "health": { "$ref": "#/$defs/health" },
        "compare_verdict": { "$ref": "#/$defs/compare_verdict" },
        "target_identity_ref": { "$ref": "#/$defs/ref" },
        "permission_connection_note": { "type": "string" },
        "divergence_note": { "type": "string" },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_kind" }
        },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_link_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "link_class",
        "from_truth",
        "to_truth",
        "confidence",
        "permission",
        "never_overwrites_higher_confidence",
        "from_side_navigable",
        "to_side_navigable"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "link_class": { "$ref": "#/$defs/resource_link_class" },
        "from_truth": { "$ref": "#/$defs/truth_mode_enum" },
        "to_truth": { "$ref": "#/$defs/truth_mode_enum" },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "permission": { "$ref": "#/$defs/permission" },
        "never_overwrites_higher_confidence": { "const": true },
        "from_side_navigable": { "type": "boolean" },
        "to_side_navigable": { "type": "boolean" }
      }
    },
    "resolved_compare_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "truth_mode",
        "compare_verdict",
        "rendered_side_truth",
        "live_side_truth",
        "comparison_current",
        "safe_to_inspect"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "compare_verdict": { "$ref": "#/$defs/compare_verdict" },
        "rendered_side_truth": { "$ref": "#/$defs/truth_mode_enum" },
        "live_side_truth": { "$ref": "#/$defs/truth_mode_enum" },
        "what_diverged": { "type": ["string", "null"] },
        "comparison_current": { "type": "boolean" },
        "safe_to_inspect": { "const": true }
      }
    },
    "resolved_explorer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "identity",
        "truth_mode",
        "freshness",
        "confidence",
        "health",
        "permission",
        "actions",
        "target_context_visible",
        "presents_as_current"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "identity": { "$ref": "#/$defs/resource_identity" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "freshness": { "$ref": "#/$defs/resource_freshness" },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "health": { "$ref": "#/$defs/health" },
        "permission": { "$ref": "#/$defs/permission" },
        "permission_connection_note": { "type": ["string", "null"] },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_kind" }
        },
        "target_context_visible": { "const": true },
        "presents_as_current": { "type": "boolean" }
      }
    },
    "resolved_drift_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "truth_mode",
        "banner_present",
        "drift_present",
        "unavailable",
        "what_stale",
        "safe_to_inspect"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "banner_present": { "type": "boolean" },
        "drift_present": { "type": "boolean" },
        "unavailable": { "type": "boolean" },
        "what_diverged": { "type": ["string", "null"] },
        "what_stale": { "type": "boolean" },
        "safe_to_inspect": { "const": true },
        "banner_reason": {
          "oneOf": [{ "$ref": "#/$defs/downgrade_trigger" }, { "type": "null" }]
        }
      }
    },
    "resolved_navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "link_row",
        "compare_card",
        "explorer_row",
        "drift_banner",
        "truth_classes_distinct",
        "drift_and_unavailability_disclosed"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "link_row": { "$ref": "#/$defs/resolved_link_row" },
        "compare_card": { "$ref": "#/$defs/resolved_compare_card" },
        "explorer_row": { "$ref": "#/$defs/resolved_explorer_row" },
        "drift_banner": { "$ref": "#/$defs/resolved_drift_banner" },
        "truth_classes_distinct": { "const": true },
        "drift_and_unavailability_disclosed": { "const": true },
        "degraded": {
          "oneOf": [{ "$ref": "#/$defs/degraded_state" }, { "type": "null" }]
        }
      }
    },
    "navigation_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/navigation_input" },
        "resolved": { "$ref": "#/$defs/resolved_navigation" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "resource_kinds",
        "truth_modes",
        "link_classes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_navigation",
        "hides_truth_class",
        "blurs_source_and_live",
        "hides_drift_or_unavailability",
        "presents_partial_as_current"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "resource_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resource_kind" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode_enum" }
        },
        "link_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resource_link_class" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_navigation": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/navigation_case" }
        },
        "hides_truth_class": { "const": false },
        "blurs_source_and_live": { "const": false },
        "hides_drift_or_unavailability": { "const": false },
        "presents_partial_as_current": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "resource_kinds",
        "health_states",
        "permission_postures",
        "compare_verdicts",
        "action_kinds",
        "export_fields",
        "truth_modes",
        "resource_link_classes",
        "resource_freshness",
        "discovery_confidence",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "resource_kinds": { "type": "array", "items": { "type": "string" } },
        "health_states": { "type": "array", "items": { "type": "string" } },
        "permission_postures": { "type": "array", "items": { "type": "string" } },
        "compare_verdicts": { "type": "array", "items": { "type": "string" } },
        "action_kinds": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "resource_link_classes": { "type": "array", "items": { "type": "string" } },
        "resource_freshness": { "type": "array", "items": { "type": "string" } },
        "discovery_confidence": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "resource_identity_preserved_across_surfaces",
        "source_and_live_never_blurred",
        "drift_and_unavailability_visible_before_action",
        "partial_or_limited_never_shown_as_current",
        "support_export_reconstructs_navigation",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "resource_identity_preserved_across_surfaces": { "const": true },
        "source_and_live_never_blurred": { "const": true },
        "drift_and_unavailability_visible_before_action": { "const": true },
        "partial_or_limited_never_shown_as_current": { "const": true },
        "support_export_reconstructs_navigation": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "drift_banner_reads_single_status_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "navigation_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "drift_banner_reads_single_status_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "navigation_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "navigation_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
