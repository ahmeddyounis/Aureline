{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-panel-header-local-action-cluster-controls.schema.json",
  "title": "Aureline M5 panel-header and local-action-cluster controls",
  "description": "Export-safe packet for the panel-header / local-action-cluster implement lane over the frozen M5 navigation / content component matrix. It carries resolved, honest projections of the panel header and its bounded local-action cluster across the claimed M5 shell, request/data, review, search, support, and product surfaces. Each controls row binds a consumer surface to the resolved panel-header examples (naming a stable title slot, the active context, the source / freshness at the pane boundary — cached/partial/stale/remote/provider-owned — a reference back to the canonical count / selection model, and command-backed refresh and reveal / detail affordances) and the resolved local-action-cluster examples (naming the local-action budget, the action placement — inline / structured menu / overflow — keyboard reachability, and the compaction / responsive-collapse mode). Hard invariants forbid hiding the local actions behind pointer hover or losing keyboard access, overstating readiness or hiding the source / freshness cue, overloading the header or keeping advanced actions as persistent clutter, and letting compaction re-instantiate a different surface or lose the panel identity. Acceptance criteria — claimed panes show one header grammar for title, local actions, overflow, and freshness / source cues; compaction and responsive collapse preserve the same panel identity and action semantics; and headers stay low-noise but sufficient to explain what the pane owns and whether it is current enough to trust — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_panel_header_and_local_action_cluster_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "panel_header_example": {
      "type": "object",
      "required": [
        "header_id",
        "header_label",
        "title_slot_stable",
        "active_context",
        "background_context_shown_as_active",
        "source_freshness",
        "source_is_qualified",
        "freshness_cue_shown",
        "freshness_cue_missing",
        "readiness_overstated",
        "references_canonical_model",
        "re_encodes_canonical_counts_locally",
        "refresh_command_available",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "header_legible_at_a_glance"
      ],
      "properties": {
        "header_id": { "$ref": "#/$defs/non_empty_string" },
        "header_label": { "type": "string" },
        "title_slot_stable": { "type": "boolean" },
        "active_context": { "$ref": "#/$defs/non_empty_string" },
        "background_context_shown_as_active": { "type": "boolean" },
        "source_freshness": { "$ref": "#/$defs/non_empty_string" },
        "source_is_qualified": { "type": "boolean" },
        "freshness_cue_shown": { "type": "boolean" },
        "freshness_cue_missing": { "type": "boolean" },
        "readiness_overstated": { "type": "boolean" },
        "references_canonical_model": { "type": "boolean" },
        "re_encodes_canonical_counts_locally": { "type": "boolean" },
        "refresh_command_available": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "header_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "local_action_cluster_example": {
      "type": "object",
      "required": [
        "cluster_id",
        "cluster_label",
        "local_action_budget",
        "local_actions_hover_only",
        "keyboard_reachable",
        "advanced_actions_persistent_clutter",
        "action_placement",
        "overflowed_action_dropped",
        "compaction_mode",
        "compaction_is_compacted",
        "reinstantiates_different_surface",
        "compaction_loses_identity",
        "compaction_loses_action_semantics",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "cluster_legible_at_a_glance"
      ],
      "properties": {
        "cluster_id": { "$ref": "#/$defs/non_empty_string" },
        "cluster_label": { "type": "string" },
        "local_action_budget": { "$ref": "#/$defs/non_empty_string" },
        "local_actions_hover_only": { "type": "boolean" },
        "keyboard_reachable": { "type": "boolean" },
        "advanced_actions_persistent_clutter": { "type": "boolean" },
        "action_placement": { "$ref": "#/$defs/non_empty_string" },
        "overflowed_action_dropped": { "type": "boolean" },
        "compaction_mode": { "$ref": "#/$defs/non_empty_string" },
        "compaction_is_compacted": { "type": "boolean" },
        "reinstantiates_different_surface": { "type": "boolean" },
        "compaction_loses_identity": { "type": "boolean" },
        "compaction_loses_action_semantics": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "cluster_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "panel_header_examples",
        "local_action_cluster_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_actions_behind_hover_only_or_loses_keyboard_access",
        "overstates_readiness_or_hides_source_freshness_cue",
        "overloads_header_or_keeps_advanced_actions_as_persistent_clutter",
        "compaction_reinstantiates_surface_or_loses_panel_identity"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "panel_header_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/panel_header_example" }
        },
        "local_action_cluster_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/local_action_cluster_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_actions_behind_hover_only_or_loses_keyboard_access": { "const": false },
        "overstates_readiness_or_hides_source_freshness_cue": { "const": false },
        "overloads_header_or_keeps_advanced_actions_as_persistent_clutter": { "const": false },
        "compaction_reinstantiates_surface_or_loses_panel_identity": { "const": false }
      }
    }
  }
}
