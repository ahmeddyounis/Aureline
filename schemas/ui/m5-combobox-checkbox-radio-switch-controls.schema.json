{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-combobox-checkbox-radio-switch-controls.schema.json",
  "title": "Aureline M5 combobox and checkbox-radio-switch controls",
  "description": "Export-safe packet for the filterable-selection and boolean-control implement lane over the frozen M5 core-action-input component matrix. It carries resolved, honest projections of the combobox and the checkbox / radio / switch (toggle control) across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved combobox examples (naming the disclosed selected value, value source, support-class tag where a remote / unverified value requires one, filterability, effective-value provenance with disclosure when it materially changes trust, keyboard-navigation stability, interaction disposition, and surface context) and the resolved toggle examples (naming the disclosed selected state, toggle semantics, apply timing so a switch is never blurred with a deferred checkbox, one-of-many versus multi-select arity, radio exclusivity, provenance, disposition, and surface context). Hard invariants forbid dropping value-source / provenance truth, blurring a switch with a deferred checkbox, blurring one-of-many versus multi-select behavior, and hiding locked / read-only semantics behind generic disabled chrome. Acceptance criteria — combobox and boolean-control consumers express value source, lock state, and immediate/deferred semantics without contradiction; keyboard / screen-reader / high-zoom / reduced-motion fixtures preserve toggle/selection truth instead of flattening it into generic disabled styling; and support/help/export packets can reconstruct the chosen selection/toggle state and why it was or was not editable — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_combobox_and_checkbox_radio_switch_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "combobox_example": {
      "type": "object",
      "required": [
        "combobox_id",
        "label",
        "selected_value",
        "selected_value_disclosed",
        "value_source",
        "value_source_resolved",
        "value_source_is_unverified",
        "support_class_tag",
        "support_class_tagged",
        "requires_filter",
        "filter_offered",
        "value_provenance",
        "value_provenance_resolved",
        "value_provenance_needs_disclosure",
        "provenance_disclosed",
        "keyboard_navigation_stable",
        "disposition",
        "disposition_requires_distinct_treatment",
        "blocked_state_distinct",
        "surface_context",
        "command_id",
        "command_route_available",
        "degrade_reason",
        "next_action",
        "value_source_and_lock_honest_at_a_glance"
      ],
      "properties": {
        "combobox_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "type": "string" },
        "selected_value": { "type": "string" },
        "selected_value_disclosed": { "type": "boolean" },
        "value_source": { "$ref": "#/$defs/non_empty_string" },
        "value_source_resolved": { "type": "boolean" },
        "value_source_is_unverified": { "type": "boolean" },
        "support_class_tag": { "type": "string" },
        "support_class_tagged": { "type": "boolean" },
        "requires_filter": { "type": "boolean" },
        "filter_offered": { "type": "boolean" },
        "value_provenance": { "$ref": "#/$defs/non_empty_string" },
        "value_provenance_resolved": { "type": "boolean" },
        "value_provenance_needs_disclosure": { "type": "boolean" },
        "provenance_disclosed": { "type": "boolean" },
        "keyboard_navigation_stable": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "disposition_requires_distinct_treatment": { "type": "boolean" },
        "blocked_state_distinct": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "command_route_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "value_source_and_lock_honest_at_a_glance": { "type": "boolean" }
      }
    },
    "toggle_example": {
      "type": "object",
      "required": [
        "toggle_id",
        "label",
        "selected_state",
        "selected_state_disclosed",
        "toggle_semantics",
        "toggle_semantics_resolved",
        "semantics_is_switch",
        "semantics_is_exclusive",
        "apply_timing",
        "apply_timing_resolved",
        "apply_timing_is_deferred",
        "apply_timing_is_blocked",
        "selection_arity_explicit",
        "group_exclusivity_enforced",
        "value_provenance",
        "value_provenance_resolved",
        "value_provenance_needs_disclosure",
        "provenance_disclosed",
        "disposition",
        "disposition_requires_distinct_treatment",
        "blocked_state_distinct",
        "surface_context",
        "command_id",
        "command_route_available",
        "degrade_reason",
        "next_action",
        "semantics_and_timing_honest_at_a_glance"
      ],
      "properties": {
        "toggle_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "type": "string" },
        "selected_state": { "type": "string" },
        "selected_state_disclosed": { "type": "boolean" },
        "toggle_semantics": { "$ref": "#/$defs/non_empty_string" },
        "toggle_semantics_resolved": { "type": "boolean" },
        "semantics_is_switch": { "type": "boolean" },
        "semantics_is_exclusive": { "type": "boolean" },
        "apply_timing": { "$ref": "#/$defs/non_empty_string" },
        "apply_timing_resolved": { "type": "boolean" },
        "apply_timing_is_deferred": { "type": "boolean" },
        "apply_timing_is_blocked": { "type": "boolean" },
        "selection_arity_explicit": { "type": "boolean" },
        "group_exclusivity_enforced": { "type": "boolean" },
        "value_provenance": { "$ref": "#/$defs/non_empty_string" },
        "value_provenance_resolved": { "type": "boolean" },
        "value_provenance_needs_disclosure": { "type": "boolean" },
        "provenance_disclosed": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "disposition_requires_distinct_treatment": { "type": "boolean" },
        "blocked_state_distinct": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "command_route_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "semantics_and_timing_honest_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "combobox_examples",
        "toggle_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "value_source_or_provenance_truth_dropped",
        "switch_blurred_with_deferred_checkbox",
        "one_of_many_versus_multi_select_blurred",
        "locked_or_read_only_semantics_hidden_behind_disabled"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "combobox_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/combobox_example" }
        },
        "toggle_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/toggle_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "value_source_or_provenance_truth_dropped": { "const": false },
        "switch_blurred_with_deferred_checkbox": { "const": false },
        "one_of_many_versus_multi_select_blurred": { "const": false },
        "locked_or_read_only_semantics_hidden_behind_disabled": { "const": false }
      }
    }
  }
}
