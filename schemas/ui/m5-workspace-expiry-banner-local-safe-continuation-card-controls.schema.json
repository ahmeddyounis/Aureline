{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-workspace-expiry-banner-local-safe-continuation-card-controls.schema.json",
  "title": "Aureline M5 workspace-expiry-banner and local-safe-continuation-card controls",
  "description": "Export-safe packet for the fourth and final implement lane over the frozen M5 build/remote-boundary component matrix. It carries resolved, honest projections of the workspace-expiry banner and the local-safe-continuation card across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved expiry-banner examples (naming the exact expiry timing, triggering owner/source, affected capabilities, offered export-before-loss / renew / reopen actions, and continuity class) and the resolved local-safe-continuation-card examples (naming the preserved files/context, the lost live state such as terminals, ports, kernels, and previews, the next safe actions, and continuity class). Hard invariants forbid implying exact continuity after an expiry / material change, hiding local-safe continuation or companion handoff behind overflow-only affordances, letting an expiry event read as a generic disconnect or a silent service loss, and concealing preserved-vs-lost state or next safe actions behind generic status wording. Acceptance criteria are proven by the resolved examples, not merely asserted: expiry events no longer appear as generic disconnects or silent service loss; users can see what remains local-safe and what must be reattached or rerun; and shell, companion handoff, incident packets, and support exports reuse the same expiry banner and local-safe continuation cards. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-remote is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_workspace_expiry_banner_and_local_safe_continuation_card_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "expiry_class": {
      "enum": [
        "none",
        "idle_window",
        "hibernation_window",
        "hard_deadline",
        "control_plane_outage"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "expiry_banner_example": {
      "type": "object",
      "required": [
        "banner_id",
        "workspace_label",
        "expiry_class",
        "triggering_reason",
        "continuity_class",
        "affected_capabilities",
        "offered_actions",
        "renew_reopen_allowed",
        "material_change_present",
        "degrade_reason",
        "next_action",
        "expiry_disclosed",
        "triggering_source_disclosed",
        "capabilities_disclosed",
        "appears_as_generic_disconnect_or_silent_loss",
        "implies_exact_continuity_after_material_change"
      ],
      "properties": {
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "workspace_label": { "type": "string" },
        "expiry_class": { "$ref": "#/$defs/expiry_class" },
        "triggering_reason": { "$ref": "#/$defs/non_empty_string" },
        "continuity_class": { "$ref": "#/$defs/non_empty_string" },
        "affected_capabilities": { "type": "array", "items": { "type": "string" } },
        "offered_actions": { "type": "array", "items": { "type": "string" } },
        "renew_reopen_allowed": { "type": "boolean" },
        "material_change_present": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "expiry_disclosed": { "type": "boolean" },
        "triggering_source_disclosed": { "type": "boolean" },
        "capabilities_disclosed": { "type": "boolean" },
        "appears_as_generic_disconnect_or_silent_loss": { "type": "boolean" },
        "implies_exact_continuity_after_material_change": { "type": "boolean" }
      }
    },
    "local_safe_card_example": {
      "type": "object",
      "required": [
        "card_id",
        "workspace_label",
        "persistence_class",
        "continuity_class",
        "preserved_context",
        "lost_live_state",
        "next_actions",
        "material_change_present",
        "offers_continue_locally",
        "degrade_reason",
        "next_action",
        "preserved_disclosed",
        "lost_disclosed",
        "next_actions_disclosed",
        "local_safe_continuation_unavailable",
        "overclaims_exact_continuity"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "workspace_label": { "type": "string" },
        "persistence_class": { "$ref": "#/$defs/non_empty_string" },
        "continuity_class": { "$ref": "#/$defs/non_empty_string" },
        "preserved_context": { "type": "array", "items": { "type": "string" } },
        "lost_live_state": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } },
        "material_change_present": { "type": "boolean" },
        "offers_continue_locally": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "preserved_disclosed": { "type": "boolean" },
        "lost_disclosed": { "type": "boolean" },
        "next_actions_disclosed": { "type": "boolean" },
        "local_safe_continuation_unavailable": { "type": "boolean" },
        "overclaims_exact_continuity": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "expiry_banner_examples",
        "local_safe_card_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "implies_exact_continuity_after_material_change",
        "hides_local_safe_or_companion_handoff_in_overflow_only",
        "expiry_appears_as_generic_disconnect_or_silent_loss",
        "conceals_preserved_vs_lost_state_or_next_safe_actions"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "expiry_banner_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expiry_banner_example" }
        },
        "local_safe_card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/local_safe_card_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "implies_exact_continuity_after_material_change": { "const": false },
        "hides_local_safe_or_companion_handoff_in_overflow_only": { "const": false },
        "expiry_appears_as_generic_disconnect_or_silent_loss": { "const": false },
        "conceals_preserved_vs_lost_state_or_next_safe_actions": { "const": false }
      }
    }
  }
}
