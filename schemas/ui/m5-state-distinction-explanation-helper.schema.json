{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-state-distinction-explanation-helper.schema.json",
  "title": "Aureline M5 state-distinction explanation helper primitive",
  "description": "Export-safe packet implementing the reusable M5 state-distinction explanation helper as one primitive. The packet binds one row per claimed M5 consumer surface — the onboarding/help surface, the blocked-action row, the settings row, the activity row, and the workspace-entry surface — to the shared explanation anatomy, the four confusable distinctions (current-vs-selected / read-only-vs-disabled / locked-vs-disabled / pending-vs-loading), the frozen precedence rule each teaches, the primary and contrasted states, the delivery form (inline chip / expanded drawer / blocked-limited copy), the required non-color cues, the required disclosures (state cause / owner / block reason / recovery action), the recovery-disclosure and state cause classes, the export fields, the mandatory labels, and the non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never invents one-off state language, never contradicts the shared taxonomy, never collapses the two look-alike states, and never misaligns blocked-action help from the component-state truth. Raw local paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_current_vs_selected_read_only_vs_disabled_locked_vs_disabled_and_pending_vs_loading_state_explanation_helpers_across_claimed_m5_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "explanation_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "explanation_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "distinctions",
        "precedence_rules",
        "deliveries",
        "non_color_cues",
        "required_disclosures",
        "recovery_disclosure_classes",
        "state_cause_classes",
        "export_fields",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "explanation_examples",
        "invents_one_off_state_language",
        "contradicts_shared_taxonomy",
        "collapses_the_two_states",
        "misaligns_blocked_action_help"
      ],
      "properties": {
        "surface": {
          "enum": [
            "onboarding_help",
            "blocked_action_row",
            "settings_row",
            "activity_row",
            "workspace_entry"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "distinctions": { "type": "array", "minItems": 1 },
        "precedence_rules": { "type": "array", "minItems": 1 },
        "deliveries": { "type": "array", "minItems": 1 },
        "non_color_cues": { "type": "array", "minItems": 1 },
        "required_disclosures": { "type": "array", "minItems": 1 },
        "recovery_disclosure_classes": { "type": "array", "minItems": 1 },
        "state_cause_classes": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "keyboard_focusable" } },
            { "contains": { "const": "non_color_encoded" } }
          ]
        },
        "required_labels": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "explanation_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/explanation_example" }
        },
        "invents_one_off_state_language": { "const": false },
        "contradicts_shared_taxonomy": { "const": false },
        "collapses_the_two_states": { "const": false },
        "misaligns_blocked_action_help": { "const": false }
      }
    },
    "explanation_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "surface",
            "distinction",
            "delivery",
            "precedence_rule",
            "primary_state",
            "contrasted_state",
            "required_non_color_cues",
            "required_disclosures",
            "recovery_class",
            "state_cause",
            "recovery_available",
            "high_contrast_active",
            "explanation_identity_ref",
            "taxonomy_ref",
            "distinction_copy_ref",
            "blocked_limited_copy_ref",
            "touches_blocked_or_limited_state",
            "carries_blocked_action_help",
            "explains_distinction_in_place",
            "states_stay_distinct",
            "no_one_off_language",
            "aligned_with_shared_taxonomy",
            "blocked_action_help_aligned_with_component_truth",
            "no_color_only_signaling",
            "keyboard_and_screen_reader_explainable",
            "driven_by_shared_state_contract"
          ]
        }
      }
    }
  }
}
