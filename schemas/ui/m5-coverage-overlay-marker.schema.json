{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-coverage-overlay-marker.schema.json",
  "title": "Aureline M5 coverage-overlay-marker resolution case",
  "description": "Companion schema for the M5 coverage-overlay-marker half of the coverage-summary-bar / coverage-overlay-marker twin primitive. It describes one worked overlay-marker resolution case: an input overlay state and its resolved truth. The resolved truth carries the frozen controlled overlay vocabulary (covered/uncovered/partial/branch-missed/excluded/unknown) as its derived overlay posture, whether the marker is an emphasized changed line, whether it preserves its exact coverage-state meaning, the source run-set identity behind the glyph, a durable path back to the evidence object that produced the marker (the editor-to-report continuity), and the bounded reveal/open-report/open-uncovered-context/export actions. The canonical packet schema that embeds these cases is m5-coverage-summary-bar.schema.json. Raw coverage payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "resolved"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay_state",
        "emphasis_class",
        "provenance_class",
        "is_changed_line",
        "source_run_set_ref",
        "evidence_object_ref",
        "line_reference"
      ],
      "properties": {
        "overlay_state": { "$ref": "#/$defs/overlay_state" },
        "emphasis_class": { "$ref": "#/$defs/emphasis_class" },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "is_changed_line": { "type": "boolean" },
        "source_run_set_ref": { "type": "string", "minLength": 1 },
        "evidence_object_ref": { "type": "string", "minLength": 1 },
        "line_reference": { "type": "string", "minLength": 1 }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay_state",
        "emphasis_class",
        "provenance_class",
        "is_changed_line",
        "source_run_set_ref",
        "evidence_object_ref",
        "line_reference",
        "overlay_posture",
        "available_actions",
        "is_emphasized_change",
        "preserves_state_meaning",
        "has_report_continuity",
        "needs_attention"
      ],
      "properties": {
        "overlay_state": { "$ref": "#/$defs/overlay_state" },
        "emphasis_class": { "$ref": "#/$defs/emphasis_class" },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "is_changed_line": { "type": "boolean" },
        "source_run_set_ref": { "type": "string", "minLength": 1 },
        "evidence_object_ref": { "type": "string", "minLength": 1 },
        "line_reference": { "type": "string", "minLength": 1 },
        "overlay_posture": {
          "enum": [
            "covered_marker",
            "uncovered_marker",
            "partial_marker",
            "branch_missed_marker",
            "excluded_marker",
            "unknown_marker"
          ]
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reveal_marker_details",
              "open_coverage_report",
              "open_uncovered_context",
              "export_marker"
            ]
          }
        },
        "is_emphasized_change": { "type": "boolean" },
        "preserves_state_meaning": { "const": true },
        "has_report_continuity": { "const": true },
        "needs_attention": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "overlay_state": {
      "enum": [
        "covered_line",
        "uncovered_line",
        "partially_covered",
        "branch_missed",
        "excluded_line",
        "no_overlay_data"
      ]
    },
    "emphasis_class": {
      "enum": [
        "changed_line_emphasis",
        "context_line",
        "newly_uncovered",
        "regression_hotspot",
        "stable_covered",
        "suppressed_region"
      ]
    },
    "provenance_class": {
      "enum": [
        "verified_current_run",
        "imported_ci_artifact",
        "cached_local_result",
        "stale_prior_result",
        "suspected_flaky",
        "reproduced_flaky",
        "stable_again",
        "manually_muted",
        "unknown"
      ]
    }
  }
}
