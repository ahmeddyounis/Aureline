{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-channel-association-review-row.schema.json",
  "title": "Aureline M5 channel-association review row",
  "description": "Stable UI contract for an M5 channel-association review row. The row names channel, handler association, current owner, precedence state, review-before-apply, and keyboard route so file/protocol association changes never silently capture ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "channel_ref",
    "handler_association_ref",
    "current_owner_ref",
    "precedence_state",
    "last_writer_wins_capture",
    "reviewed_before_apply",
    "discloses_current_owner",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_channel_association_review_row" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "channel_ref": { "$ref": "#/$defs/ref" },
    "handler_association_ref": { "$ref": "#/$defs/ref" },
    "current_owner_ref": { "$ref": "#/$defs/ref" },
    "precedence_state": {
      "enum": ["sole_owner", "precedence_declared", "user_arbitrated", "contested"]
    },
    "last_writer_wins_capture": { "const": false },
    "reviewed_before_apply": { "const": true },
    "discloses_current_owner": { "const": true },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "enum": ["handler_ownership_contested", "provenance_incomplete"] },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
