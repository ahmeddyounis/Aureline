{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-inline-result-marker.schema.json",
  "title": "Aureline M5 inline-result-marker primitive",
  "description": "Export-safe packet implementing the reusable M5 inline result marker as one primitive. The packet binds one row per claimed editor / notebook consumer — the editor-gutter marker, the editor inline marker, the notebook-cell marker, the headless/CLI marker, and the marker-report export — to the shared marker anatomy, the derived marker posture (quarantined/unmapped/approximate-mapping/imported-evidence/stale-result/live-local), the pass/fail/error/timeout verdicts, the stability chips (stable/flaky-suspected/known-flaky/quarantined/newly-added/unknown), the source-mapping fidelities (exact/approximate/unmapped-to-buffer/no-local-buffer), the imported/live result origins, freshness states, attempt lineage kinds, bounded reveal-evidence/open-recent-attempts/rerun/review-quarantine/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks its verdict or imported/live origin, never hides a quarantine's release impact, never renders an imported, stale, or approximately-mapped run as a current live-local result, and never drops the attempt lineage a tree or triage consumer would show. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_inline_result_markers_with_live_versus_imported_versus_stale_stability_chips_open_recent_attempts_and_target_env_shorthand_across_claimed_m5_editors_and_notebook_views"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "test_evidence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "marker_verdicts",
        "stability_chips",
        "result_origins",
        "result_freshness",
        "source_mappings",
        "marker_postures",
        "attempt_lineage_kinds",
        "marker_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "marker_examples",
        "masks_verdict_or_origin",
        "hides_quarantine_release_impact",
        "overstates_imported_or_stale_as_live",
        "drops_attempt_lineage"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "editor_gutter_marker",
            "editor_inline_marker",
            "notebook_cell_marker",
            "headless_cli_marker",
            "marker_report_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "marker_verdicts": { "type": "array", "minItems": 1 },
        "stability_chips": { "type": "array", "minItems": 1 },
        "result_origins": { "type": "array", "minItems": 1 },
        "result_freshness": { "type": "array", "minItems": 1 },
        "source_mappings": { "type": "array", "minItems": 1 },
        "marker_postures": { "type": "array", "minItems": 1 },
        "attempt_lineage_kinds": { "type": "array", "minItems": 1 },
        "marker_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "marker_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/marker_example" }
        },
        "masks_verdict_or_origin": { "const": false },
        "hides_quarantine_release_impact": { "const": false },
        "overstates_imported_or_stale_as_live": { "const": false },
        "drops_attempt_lineage": { "const": false }
      }
    },
    "marker_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "verdict",
            "stability_chip",
            "result_origin",
            "result_freshness",
            "source_mapping",
            "attempt_lineage",
            "marker_identity_ref",
            "marker_posture",
            "can_rerun_from_marker",
            "can_open_recent_attempts",
            "shows_live_certainty",
            "carries_reduced_certainty",
            "implies_current_local_result",
            "is_muted",
            "available_actions"
          ]
        }
      }
    }
  }
}
