{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-intelligence-component-accessibility-fallback.schema.json",
  "title": "Aureline M5 test-intelligence component accessibility fallback and auto-narrowing packet",
  "description": "M05-1034 keyboard / screen-reader / CLI / export parity and honest auto-narrowing capstone over the frozen M5 test-intelligence component matrix (coverage summary bar, coverage overlay marker, flaky-state badge, retry-history row, snapshot-review card, coverage-import / merge sheet, test-generation suggestion card). Metadata-only: typed class tokens, opaque refs, booleans, and redacted labels; never raw logs, assertion bodies, coverage payloads, snapshot bytes, or credential-bearing material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_test_intelligence_component_accessibility_fallback_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "evidence_claim": {
      "type": "string",
      "enum": [
        "verified_current_evidence",
        "reviewable_evidence",
        "partial_condition_evidence",
        "unconfirmed_flaky_evidence",
        "unverified_baseline_evidence",
        "imported_or_stale_evidence",
        "unvalidated_generated_evidence"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "included_run_provenance",
        "branch_condition_coverage",
        "flaky_evidence_window",
        "baseline_scope_identity",
        "sandbox_validation"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "evidence_current_exact",
        "provenance_imported_or_stale",
        "branch_condition_partial",
        "flaky_window_insufficient",
        "baseline_identity_unverified",
        "sandbox_validation_unproven"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "provenance_class_unstated",
        "freshness_class_undisclosed",
        "shard_omission_hidden",
        "line_versus_branch_unstated",
        "flaky_confidence_overstated",
        "retry_scope_widened",
        "snapshot_baseline_unstated",
        "raw_text_fallback_missing",
        "generated_assumption_hidden",
        "opaque_apply_bundle",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "handoff_packet",
        "support_export"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "component_family": {
      "type": "string",
      "enum": [
        "coverage_summary_bar",
        "coverage_overlay_marker",
        "flaky_state_badge",
        "retry_history_row",
        "snapshot_review_card",
        "coverage_import_merge_sheet",
        "test_generation_suggestion_card"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "provenance_and_freshness",
        "baseline_or_scope_identity",
        "assumption_and_recovery_boundary"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "coverage_report_ui",
        "editor_overlay_ui",
        "flaky_dashboard_ui",
        "retry_history_ui",
        "snapshot_review_ui",
        "coverage_import_ui",
        "test_generation_ui",
        "support_export",
        "cli_inspect"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_lineage_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/evidence_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_lineage_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "test_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_test_claim",
        "claim_conditions",
        "lineage_preserved",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_test_intelligence_component_accessibility_fallback_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "test_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/reach_state" },
        "cli_reach": { "$ref": "#/$defs/reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_test_claim": { "$ref": "#/$defs/evidence_claim" },
        "claim_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition_entry" }
        },
        "claim_narrow": { "$ref": "#/$defs/claim_narrow" },
        "lineage_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "hierarchy_heavy_family_count",
        "all_hierarchy_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_export_summaries_preserve_meaning",
        "all_lineage_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "hierarchy_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_hierarchy_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_lineage_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
