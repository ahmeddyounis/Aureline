{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-badge-family-matrix.schema.json",
  "title": "Aureline M5 support-class, evidence-freshness, lifecycle, channel, deployment-scope, compatibility-state, and explanation-drawer badge matrix",
  "description": "Export-safe packet freezing Aureline's reusable badge families. The packet names the six badge axes M5 shows on claim-bearing surfaces — support class, evidence freshness, lifecycle, channel, deployment scope, and compatibility state — and binds each to its controlled value vocabulary, the mandatory explanation-drawer fields it must open, the claimed M5 surface families that render it, the deployment lines it keeps the same meaning across, and the mandatory labels it must show. Axis-separation rules keep one family from implying another (Certified does not mean Fresh; Desktop-only does not mean Experimental). Hard invariants forbid collapsing two axes into one overloaded pill, implying freshness from support class, implying a lifecycle stage from deployment scope, and letting exported evidence lose badge meaning. This matrix layers on top of the already-claimed support-class ledger, freshness descriptor, lifecycle registry, channel matrix, deployment profile, and compatibility forecast rather than re-architecting them. Raw URLs, raw keys, raw tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "badge_rows",
    "vocabulary_set",
    "axis_separation_rules",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_support_class_evidence_freshness_lifecycle_channel_deployment_scope_compatibility_state_and_explanation_drawer_badge_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "badge_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/badge_row" }
    },
    "vocabulary_set": { "type": "object" },
    "axis_separation_rules": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/axis_separation_rule" }
    },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "release_packet_ref",
        "badge_family_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ]
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "badge_family": {
      "enum": [
        "support_class",
        "evidence_freshness",
        "lifecycle",
        "channel",
        "deployment_scope",
        "compatibility_state"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "support_class_value": {
      "enum": [
        "certified",
        "fully_supported",
        "community_supported",
        "best_effort",
        "deprecated",
        "unsupported"
      ]
    },
    "evidence_freshness_value": {
      "enum": ["fresh", "recent", "aging", "stale", "expired", "unverified"]
    },
    "lifecycle_value": {
      "enum": ["stable", "beta", "preview", "experimental", "maintenance", "end_of_life"]
    },
    "channel_value": {
      "enum": [
        "stable_channel",
        "beta_channel",
        "nightly_channel",
        "edge_channel",
        "lts_channel",
        "custom_channel"
      ]
    },
    "deployment_scope_value": {
      "enum": [
        "desktop_only",
        "local_oss_scope",
        "self_hosted_scope",
        "managed_scope",
        "air_gapped_scope",
        "mirror_offline_scope"
      ]
    },
    "compatibility_state_value": {
      "enum": [
        "compatible",
        "minor_skew",
        "major_skew",
        "incompatible",
        "migration_required",
        "compatibility_unknown"
      ]
    },
    "explanation_field": {
      "enum": [
        "what_it_means",
        "why_shown",
        "what_changes_it",
        "evidence_source",
        "how_to_improve",
        "last_evaluated"
      ]
    },
    "axis_separation_rule": {
      "enum": [
        "support_class_does_not_imply_freshness",
        "deployment_scope_does_not_imply_lifecycle",
        "lifecycle_does_not_imply_channel",
        "channel_does_not_imply_support_class",
        "compatibility_does_not_imply_support_class",
        "freshness_does_not_imply_compatibility"
      ]
    },
    "surface_family": {
      "enum": [
        "marketplace",
        "help_docs",
        "settings",
        "onboarding",
        "diagnostics",
        "runtime",
        "exported_evidence"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "consumer_surface": {
      "enum": [
        "marketplace_ui",
        "help_about",
        "settings_ui",
        "onboarding_flow",
        "diagnostics_surface",
        "docs_portal",
        "evaluation_pack",
        "support_export",
        "cli_inspect",
        "product_ui"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "non_color_encoded",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "value_state",
        "axis_name",
        "explanation_drawer",
        "evidence_source",
        "filter_key"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "support_class_value_unstated",
        "evidence_freshness_hidden",
        "lifecycle_value_unstated",
        "channel_value_unstated",
        "deployment_scope_unstated",
        "compatibility_state_unstated",
        "explanation_drawer_missing",
        "axis_merged_into_another",
        "freshness_implied_from_support_class",
        "filter_key_dropped",
        "export_lost_badge_meaning",
        "proof_stale"
      ]
    },
    "badge_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "explanation_fields",
        "support_class_values",
        "evidence_freshness_values",
        "lifecycle_values",
        "channel_values",
        "deployment_scope_values",
        "compatibility_state_values",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_multiple_axes_into_one_pill",
        "implies_freshness_from_support_class",
        "implies_lifecycle_from_deployment_scope",
        "drops_badge_meaning_in_export"
      ],
      "properties": {
        "badge_family": { "$ref": "#/$defs/badge_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "explanation_fields": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/explanation_field" }
        },
        "support_class_values": {
          "type": "array",
          "items": { "$ref": "#/$defs/support_class_value" }
        },
        "evidence_freshness_values": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_freshness_value" }
        },
        "lifecycle_values": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_value" }
        },
        "channel_values": {
          "type": "array",
          "items": { "$ref": "#/$defs/channel_value" }
        },
        "deployment_scope_values": {
          "type": "array",
          "items": { "$ref": "#/$defs/deployment_scope_value" }
        },
        "compatibility_state_values": {
          "type": "array",
          "items": { "$ref": "#/$defs/compatibility_state_value" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_multiple_axes_into_one_pill": { "const": false },
        "implies_freshness_from_support_class": { "const": false },
        "implies_lifecycle_from_deployment_scope": { "const": false },
        "drops_badge_meaning_in_export": { "const": false }
      }
    }
  }
}
