{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-rendered-compare-media-trust-controls.schema.json",
  "title": "Aureline M5 rendered compare viewers, media-metadata rails, and redaction-or-trust badge sets",
  "description": "Export-safe packet implementing the reusable M5 rendered-compare-viewer, media-metadata-rail, and redaction-or-trust-badge-set components. Each rendered compare viewer answers, from the component alone, which media-like artifact is compared, its scale or dimension metadata, its accessibility text fallback, whether it is sandboxed and whether its render is trusted, and how to open the raw artifact or export it. Each media-metadata rail names the artifact format, its size/duration/dimensions, its hidden-content state, its sanitized/sandboxed/export-safe posture, and its local/team/support share guidance. Each redaction-or-trust badge set names the redaction state, the trust level, and whether that posture is preserved when the review is shared or exported. Every rendered compare viewer and media-metadata rail is accompanied by a redaction-or-trust badge set for the same artifact. Raw artifact bodies, raw render payloads, raw media bytes, credentials, and live provider responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "rendered_compare_viewers",
    "media_metadata_rails",
    "redaction_trust_badge_sets",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "rendered_compare_media_trust_controls"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rendered_compare_viewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rendered_compare_viewer"
      }
    },
    "media_metadata_rails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/media_metadata_rail"
      }
    },
    "redaction_trust_badge_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/redaction_or_trust_badge_set"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_trigger"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "fidelity_state": {
      "type": "string",
      "enum": [
        "structured_faithful",
        "structured_partial",
        "schema_unrecognized",
        "render_untrusted",
        "raw_fallback",
        "redacted_or_withheld"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "compare_only_no_write_back",
        "write_back_attributable",
        "regenerate_only_no_manual_edit",
        "evidence_preserved_no_revert",
        "not_applicable"
      ]
    },
    "render_trust_class": {
      "type": "string",
      "enum": [
        "sandboxed_trusted",
        "sandboxed_untrusted",
        "raw_text_fallback",
        "redacted_withheld"
      ]
    },
    "rendered_viewer_action": {
      "type": "string",
      "enum": [
        "open_raw",
        "export",
        "toggle_scale",
        "view_text_fallback",
        "compare_side_by_side"
      ]
    },
    "media_artifact_kind": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "design_snapshot",
        "rendered_document",
        "other"
      ]
    },
    "media_measure_kind": {
      "type": "string",
      "enum": [
        "dimensions",
        "duration",
        "byte_size",
        "page_count"
      ]
    },
    "hidden_content_state": {
      "type": "string",
      "enum": [
        "no_embedded_sensitive_content",
        "embedded_sensitive_content_present",
        "embedded_content_scan_unknown"
      ]
    },
    "media_safety_posture": {
      "type": "string",
      "enum": [
        "raw_unsanitized",
        "sanitized",
        "sandboxed",
        "export_safe"
      ]
    },
    "media_share_scope": {
      "type": "string",
      "enum": [
        "local_only",
        "team_share",
        "support_export"
      ]
    },
    "redaction_state": {
      "type": "string",
      "enum": [
        "not_redacted",
        "partially_redacted",
        "fully_redacted",
        "redaction_pending"
      ]
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "trusted",
        "sandboxed_only",
        "untrusted",
        "unverified"
      ]
    },
    "trust_badge": {
      "type": "string",
      "enum": [
        "redacted",
        "sanitized",
        "sandboxed",
        "export_safe",
        "trusted",
        "untrusted",
        "local_only"
      ]
    },
    "rendered_viewer_component": {
      "type": "string",
      "const": "rendered_compare_viewer"
    },
    "media_rail_component": {
      "type": "string",
      "const": "media_metadata_rail"
    },
    "badge_set_component": {
      "type": "string",
      "const": "redaction_or_trust_badge_set"
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "render_untrusted",
        "media_metadata_unavailable",
        "hidden_content_detected",
        "redaction_applied",
        "sandbox_enforced",
        "trust_narrowing",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "diff_compare_view",
        "notebook_review",
        "artifact_browser",
        "design_snapshot_review",
        "cli_headless",
        "support_export",
        "help_about"
      ]
    },
    "rendered_compare_viewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "viewer_id",
        "artifact_ref",
        "artifact_class_label",
        "trust_class",
        "scale_or_dimension_metadata",
        "alt_text_fallback",
        "sandbox_note",
        "untrusted_render_note",
        "raw_fallback_label",
        "redaction_note",
        "available_actions",
        "schema_fidelity",
        "raw_context_action",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/rendered_viewer_component"
        },
        "viewer_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_class_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "trust_class": {
          "$ref": "#/$defs/render_trust_class"
        },
        "scale_or_dimension_metadata": {
          "$ref": "#/$defs/non_empty_string"
        },
        "alt_text_fallback": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sandbox_note": {
          "type": "string"
        },
        "untrusted_render_note": {
          "type": "string"
        },
        "raw_fallback_label": {
          "type": "string"
        },
        "redaction_note": {
          "type": "string"
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rendered_viewer_action"
          }
        },
        "schema_fidelity": {
          "$ref": "#/$defs/fidelity_state"
        },
        "raw_context_action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "trust_class": {
                "const": "sandboxed_untrusted"
              }
            }
          },
          "then": {
            "properties": {
              "untrusted_render_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trust_class": {
                "const": "raw_text_fallback"
              }
            }
          },
          "then": {
            "properties": {
              "raw_fallback_label": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trust_class": {
                "const": "redacted_withheld"
              }
            }
          },
          "then": {
            "properties": {
              "redaction_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "media_metadata_rail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "rail_id",
        "artifact_ref",
        "artifact_kind",
        "format_label",
        "measure_kind",
        "measure_value",
        "hidden_content_state",
        "hidden_content_note",
        "safety_posture",
        "share_scope",
        "share_guidance",
        "schema_fidelity",
        "raw_context_action",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/media_rail_component"
        },
        "rail_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_kind": {
          "$ref": "#/$defs/media_artifact_kind"
        },
        "format_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "measure_kind": {
          "$ref": "#/$defs/media_measure_kind"
        },
        "measure_value": {
          "$ref": "#/$defs/non_empty_string"
        },
        "hidden_content_state": {
          "$ref": "#/$defs/hidden_content_state"
        },
        "hidden_content_note": {
          "type": "string"
        },
        "safety_posture": {
          "$ref": "#/$defs/media_safety_posture"
        },
        "share_scope": {
          "$ref": "#/$defs/media_share_scope"
        },
        "share_guidance": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema_fidelity": {
          "$ref": "#/$defs/fidelity_state"
        },
        "raw_context_action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hidden_content_state": {
                "enum": [
                  "embedded_sensitive_content_present",
                  "embedded_content_scan_unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "hidden_content_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "redaction_or_trust_badge_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "badge_set_id",
        "artifact_ref",
        "redaction_state",
        "trust_level",
        "available_badges",
        "redaction_note",
        "untrusted_note",
        "share_guidance",
        "export_posture_preserved",
        "schema_fidelity",
        "raw_context_action",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/badge_set_component"
        },
        "badge_set_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "redaction_state": {
          "$ref": "#/$defs/redaction_state"
        },
        "trust_level": {
          "$ref": "#/$defs/trust_level"
        },
        "available_badges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trust_badge"
          }
        },
        "redaction_note": {
          "type": "string"
        },
        "untrusted_note": {
          "type": "string"
        },
        "share_guidance": {
          "$ref": "#/$defs/non_empty_string"
        },
        "export_posture_preserved": {
          "type": "boolean",
          "const": true
        },
        "schema_fidelity": {
          "$ref": "#/$defs/fidelity_state"
        },
        "raw_context_action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "redaction_state": {
                "enum": [
                  "partially_redacted",
                  "fully_redacted",
                  "redaction_pending"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "redaction_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trust_level": {
                "enum": [
                  "untrusted",
                  "unverified"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "untrusted_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_trust_always_explicit",
        "accessibility_fallback_always_present",
        "scale_or_dimension_metadata_present",
        "hidden_content_state_disclosed",
        "metadata_visibility_explicit",
        "sanitized_or_export_safe_posture_explicit",
        "share_guidance_explicit",
        "redaction_posture_preserved_on_export",
        "raw_export_safe_fallback_explicit",
        "raw_context_always_reachable",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "render_trust_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "accessibility_fallback_always_present": {
          "type": "boolean",
          "const": true
        },
        "scale_or_dimension_metadata_present": {
          "type": "boolean",
          "const": true
        },
        "hidden_content_state_disclosed": {
          "type": "boolean",
          "const": true
        },
        "metadata_visibility_explicit": {
          "type": "boolean",
          "const": true
        },
        "sanitized_or_export_safe_posture_explicit": {
          "type": "boolean",
          "const": true
        },
        "share_guidance_explicit": {
          "type": "boolean",
          "const": true
        },
        "redaction_posture_preserved_on_export": {
          "type": "boolean",
          "const": true
        },
        "raw_export_safe_fallback_explicit": {
          "type": "boolean",
          "const": true
        },
        "raw_context_always_reachable": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendered_viewer_shows_render_trust_and_scale",
        "rendered_viewer_shows_alt_text_fallback",
        "media_rail_shows_format_and_measure",
        "media_rail_shows_hidden_content_and_posture",
        "badge_set_shows_redaction_and_trust",
        "share_export_preserves_posture",
        "raw_context_reachable_from_all",
        "cli_headless_shows_truth",
        "support_export_shows_truth",
        "help_about_shows_truth"
      ],
      "properties": {
        "rendered_viewer_shows_render_trust_and_scale": {
          "type": "boolean",
          "const": true
        },
        "rendered_viewer_shows_alt_text_fallback": {
          "type": "boolean",
          "const": true
        },
        "media_rail_shows_format_and_measure": {
          "type": "boolean",
          "const": true
        },
        "media_rail_shows_hidden_content_and_posture": {
          "type": "boolean",
          "const": true
        },
        "badge_set_shows_redaction_and_trust": {
          "type": "boolean",
          "const": true
        },
        "share_export_preserves_posture": {
          "type": "boolean",
          "const": true
        },
        "raw_context_reachable_from_all": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
