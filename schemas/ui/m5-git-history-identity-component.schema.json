{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-git-history-identity-component.schema.json",
  "title": "Aureline M5 Git-history identity components with working-context, divergence, dirty, shallow/partial, and recovery truth",
  "description": "Export-safe packet implementing the four identity/display components frozen in the M5 Git-history component matrix: commit-graph headers, history-graph rows, branch-comparison chips, and worktree rows. Each component answers, from itself alone, which repo root and checked-out ref it names, which worktree path it belongs to, how its ref has diverged, whether the worktree is dirty or conflicted, whether the checkout is shallow/partial/sparse, and whether it targets the current primary worktree, another linked worktree, a partial/shallow checkout, or a detached/bare root. A non-current context can never claim to be the current one, multiple worktrees are never flattened into one ambiguous branch list, and dirty/conflicted/divergent/detached contexts keep recovery/reflog availability explicit. Raw paths, raw object bytes, raw branch names, raw reflog/stash bodies, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "rows",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "git_history_identity_component_working_context_truth"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/identity_row"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_state"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "identity_component": {
      "type": "string",
      "enum": [
        "commit_graph_header",
        "history_graph_row",
        "branch_comparison_chip",
        "worktree_row"
      ]
    },
    "working_context_target": {
      "type": "string",
      "enum": [
        "current_repo_worktree",
        "linked_worktree",
        "partial_or_shallow_checkout",
        "detached_or_bare_root"
      ]
    },
    "divergence": {
      "type": "string",
      "enum": [
        "current",
        "ahead",
        "behind",
        "diverged",
        "detached_no_upstream",
        "unknown"
      ]
    },
    "dirty_state": {
      "type": "string",
      "enum": [
        "clean",
        "dirty_uncommitted",
        "conflicted"
      ]
    },
    "topology_completeness": {
      "type": "string",
      "enum": [
        "complete",
        "shallow",
        "partial",
        "sparse"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "open_in_workspace",
        "switch_worktree_context",
        "compare_refs",
        "open_recovery_reflog",
        "deepen_or_hydrate_history",
        "open_provider_in_browser"
      ]
    },
    "downgrade_state": {
      "type": "string",
      "enum": [
        "stale_provider_overlay",
        "detached_or_missing_ref",
        "dirty_or_conflicted_worktree",
        "shallow_or_partial_topology",
        "reflog_only_fallback",
        "approval_invalidated",
        "offline_local_only"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review",
        "shell",
        "help",
        "support",
        "support_export",
        "provider_overlay",
        "cli",
        "ai_context"
      ]
    },
    "identity_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "working_context_target",
        "repo_identity_label",
        "checked_out_ref_label",
        "worktree_path_label",
        "divergence",
        "dirty_state",
        "topology_completeness",
        "claims_current_primary_context",
        "separate_worktree_context_note",
        "incomplete_history_marker",
        "recovery_reflog_availability",
        "downgrade_vocab",
        "actions",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component": {
          "$ref": "#/$defs/identity_component"
        },
        "working_context_target": {
          "$ref": "#/$defs/working_context_target"
        },
        "repo_identity_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "checked_out_ref_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "worktree_path_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "divergence": {
          "$ref": "#/$defs/divergence"
        },
        "dirty_state": {
          "$ref": "#/$defs/dirty_state"
        },
        "topology_completeness": {
          "$ref": "#/$defs/topology_completeness"
        },
        "claims_current_primary_context": {
          "type": "boolean"
        },
        "separate_worktree_context_note": {
          "type": "string"
        },
        "incomplete_history_marker": {
          "type": "string"
        },
        "recovery_reflog_availability": {
          "type": "string"
        },
        "downgrade_vocab": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_state"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "working_context_target": {
                "const": "current_repo_worktree"
              }
            }
          },
          "then": {
            "properties": {
              "claims_current_primary_context": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "claims_current_primary_context": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree_identity_never_flattened",
        "exact_repo_ref_identity_explicit",
        "divergence_state_explicit",
        "dirty_state_explicit",
        "shallow_partial_sparse_marked",
        "worktree_path_explicit",
        "recovery_reflog_availability_explicit",
        "separate_working_context_preserved",
        "current_versus_other_context_unambiguous",
        "one_component_contract_no_hidden_meaning",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "worktree_identity_never_flattened": {
          "type": "boolean",
          "const": true
        },
        "exact_repo_ref_identity_explicit": {
          "type": "boolean",
          "const": true
        },
        "divergence_state_explicit": {
          "type": "boolean",
          "const": true
        },
        "dirty_state_explicit": {
          "type": "boolean",
          "const": true
        },
        "shallow_partial_sparse_marked": {
          "type": "boolean",
          "const": true
        },
        "worktree_path_explicit": {
          "type": "boolean",
          "const": true
        },
        "recovery_reflog_availability_explicit": {
          "type": "boolean",
          "const": true
        },
        "separate_working_context_preserved": {
          "type": "boolean",
          "const": true
        },
        "current_versus_other_context_unambiguous": {
          "type": "boolean",
          "const": true
        },
        "one_component_contract_no_hidden_meaning": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_reuses_one_contract",
        "shell_reuses_one_contract",
        "help_reuses_one_contract",
        "support_export_reuses_one_contract",
        "component_distinguishes_current_other_partial",
        "cli_headless_shows_truth",
        "provider_overlay_shows_truth",
        "ai_context_shows_truth"
      ],
      "properties": {
        "review_reuses_one_contract": {
          "type": "boolean",
          "const": true
        },
        "shell_reuses_one_contract": {
          "type": "boolean",
          "const": true
        },
        "help_reuses_one_contract": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_one_contract": {
          "type": "boolean",
          "const": true
        },
        "component_distinguishes_current_other_partial": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "provider_overlay_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "ai_context_shows_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
