{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-bundle-drift-override-primitive.schema.json",
  "title": "Aureline M5 bundle drift / override primitive",
  "description": "Canonical parity matrix for the reusable M5 bundle drift / override primitive: a drift banner, a set of local-override rows at field / package / task granularity, and a rollback / remove card that all resolve from one drift context and share one drift identity. Narrows three families of the frozen M5 workflow-bundle component matrix (bundle_drift_banner, bundle_local_override_row, bundle_rollback_remove_card) into one working resolver. Bundle drift becomes reviewable at the right level of detail instead of collapsing into a generic package-update warning (AC1); users can see harmless local preference versus support-significant drift (AC2); local overrides remain attributable and exportable without forcing a bundle reset (AC3). A mutating remove / update always creates a one-step rollback checkpoint before mutating. Raw manifest bytes, credentials, entitlement tokens, mirror URLs, and provider cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_bundle_drift_override_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "workspace_drift_banner",
        "bundle_detail_drift_panel",
        "extension_drift_row",
        "migration_drift_view",
        "diagnostics_drift_report",
        "support_export_replay"
      ]
    },
    "drift_kind": {
      "enum": [
        "local_only_edit",
        "bundle_version_drift",
        "missing_artifact",
        "imported_gap",
        "stale_certification",
        "policy_entitlement_narrowing"
      ]
    },
    "granularity": { "enum": ["field", "package", "task"] },
    "significance": { "enum": ["harmless_local_preference", "support_significant"] },
    "export_field": {
      "enum": [
        "drift_id",
        "bundle_identity",
        "drift_state",
        "drift_kinds",
        "local_overrides",
        "rollback_checkpoint",
        "mirror_offline_posture",
        "missing_artifacts"
      ]
    },
    "side_effect_class": {
      "enum": [
        "extension_install",
        "settings_profile_write",
        "task_recipe_registration",
        "docs_tour_pack_install",
        "toolchain_install",
        "scaffold_generation"
      ]
    },
    "component_kind": {
      "enum": [
        "extension",
        "profile_preset",
        "layout_preset",
        "settings_preset",
        "task_recipe",
        "launch_recipe",
        "debug_recipe",
        "docs_pack",
        "tour_pack",
        "template_ref",
        "scaffold_ref",
        "migration_mapping"
      ]
    },
    "drift_state": {
      "enum": ["in_sync", "local_ahead", "bundle_ahead", "diverged", "unknown"]
    },
    "review_operation": {
      "enum": ["install", "update", "remove", "drift_review"]
    },
    "diff_action": {
      "enum": ["added", "removed", "modified", "unchanged"]
    },
    "asset_ownership": {
      "enum": [
        "bundle_owned",
        "locally_overridden",
        "adopted",
        "removable",
        "blocked_by_policy",
        "blocked_by_lifecycle"
      ]
    },
    "resolution_choice": {
      "enum": [
        "keep_local",
        "adopt_bundle",
        "rebase",
        "compare",
        "remove_bundle_owned",
        "not_applicable"
      ]
    },
    "source_class": {
      "enum": [
        "certified",
        "managed_approved",
        "community_reviewed",
        "imported_pending_review",
        "local_draft"
      ]
    },
    "bundle_class": {
      "enum": [
        "launch_bundle",
        "framework_pack",
        "template_bundle",
        "imported_handoff_bundle",
        "org_managed_bundle",
        "no_bundle"
      ]
    },
    "signer_source": {
      "enum": ["first_party", "trusted_remote", "unverified_remote", "untrusted"]
    },
    "support_class": {
      "enum": [
        "stable",
        "preview",
        "labs",
        "policy_gated",
        "mirror_only",
        "bounded_platform"
      ]
    },
    "scorecard_class": {
      "enum": ["certified", "probable", "community", "imported", "preview", "local_draft"]
    },
    "freshness_state": {
      "enum": ["fresh", "aging", "stale", "missing"]
    },
    "imported_confidence": {
      "enum": ["native", "bridged", "approximated", "unverified"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_supplied"]
    },
    "downgrade_trigger": {
      "enum": [
        "stale_certification",
        "mirror_stale",
        "offline_cache_only",
        "unverified_signer",
        "local_override_drift",
        "incompatible_aureline",
        "entitlement_dependency_unmet",
        "imported_not_native",
        "rollback_only_path"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "nullable_degraded_state": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/degraded_state" }]
    },
    "rollback_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_ref",
        "one_step",
        "reversible",
        "captured_before_mutation",
        "captured_component_count"
      ],
      "properties": {
        "checkpoint_ref": { "$ref": "#/$defs/ref" },
        "one_step": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "captured_before_mutation": { "type": "boolean" },
        "captured_component_count": { "type": "integer", "minimum": 0 }
      }
    },
    "nullable_rollback_checkpoint": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rollback_checkpoint" }]
    },
    "local_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granularity",
        "target_ref",
        "label",
        "drift_kind",
        "diff_action",
        "ownership",
        "resolution",
        "significance"
      ],
      "properties": {
        "granularity": { "$ref": "#/$defs/granularity" },
        "target_ref": { "$ref": "#/$defs/ref" },
        "label": { "type": "string", "minLength": 1 },
        "drift_kind": { "$ref": "#/$defs/drift_kind" },
        "diff_action": { "$ref": "#/$defs/diff_action" },
        "ownership": { "$ref": "#/$defs/asset_ownership" },
        "resolution": { "$ref": "#/$defs/resolution_choice" },
        "significance": { "$ref": "#/$defs/significance" }
      }
    },
    "missing_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_kind", "artifact_ref", "label"],
      "properties": {
        "component_kind": { "$ref": "#/$defs/component_kind" },
        "artifact_ref": { "$ref": "#/$defs/ref" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "drift_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_id",
        "surface_label",
        "bundle_id_ref",
        "bundle_name",
        "bundle_class",
        "signer_source",
        "support_class",
        "source_class",
        "scorecard_class",
        "certification_freshness",
        "imported_confidence",
        "compatible_aureline_range",
        "truth_mode",
        "drift_state",
        "operation",
        "local_overrides",
        "missing_artifacts",
        "recommended_choices",
        "side_effects",
        "reads_like_generic_update",
        "claims_harmless_despite_significant",
        "claims_current_despite_stale",
        "forces_reset_to_export"
      ],
      "properties": {
        "drift_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/signer_source" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "scorecard_class": { "$ref": "#/$defs/scorecard_class" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "imported_confidence": { "$ref": "#/$defs/imported_confidence" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "drift_state": { "$ref": "#/$defs/drift_state" },
        "operation": { "$ref": "#/$defs/review_operation" },
        "local_overrides": { "type": "array", "items": { "$ref": "#/$defs/local_override" } },
        "missing_artifacts": { "type": "array", "items": { "$ref": "#/$defs/missing_artifact" } },
        "recommended_choices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_choice" }
        },
        "side_effects": { "type": "array", "items": { "$ref": "#/$defs/side_effect_class" } },
        "rollback_checkpoint": { "$ref": "#/$defs/rollback_checkpoint" },
        "reads_like_generic_update": { "const": false },
        "claims_harmless_despite_significant": { "const": false },
        "claims_current_despite_stale": { "const": false },
        "forces_reset_to_export": { "const": false },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_id",
        "bundle_id_ref",
        "bundle_name",
        "drift_state",
        "truth_mode",
        "recommended_choices",
        "distinct_drift_kinds",
        "has_missing_artifacts",
        "highest_significance",
        "reads_like_generic_update",
        "discloses_override_state"
      ],
      "properties": {
        "drift_id": { "$ref": "#/$defs/id" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "drift_state": { "$ref": "#/$defs/drift_state" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "recommended_choices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_choice" }
        },
        "distinct_drift_kinds": { "type": "array", "items": { "$ref": "#/$defs/drift_kind" } },
        "has_missing_artifacts": { "type": "boolean" },
        "highest_significance": { "$ref": "#/$defs/significance" },
        "reads_like_generic_update": { "const": false },
        "discloses_override_state": { "const": true }
      }
    },
    "resolved_override_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_id",
        "overrides",
        "granularities_present",
        "preserves_local_overrides",
        "attributable_and_exportable",
        "collapses_to_opaque_customized"
      ],
      "properties": {
        "drift_id": { "$ref": "#/$defs/id" },
        "overrides": { "type": "array", "items": { "$ref": "#/$defs/local_override" } },
        "granularities_present": { "type": "array", "items": { "$ref": "#/$defs/granularity" } },
        "preserves_local_overrides": { "const": true },
        "attributable_and_exportable": { "const": true },
        "collapses_to_opaque_customized": { "const": false }
      }
    },
    "resolved_rollback_remove_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_id",
        "operation",
        "side_effects",
        "rollback_checkpoint",
        "creates_rollback_checkpoint",
        "discloses_rollback_path",
        "discloses_side_effects",
        "forces_reset"
      ],
      "properties": {
        "drift_id": { "$ref": "#/$defs/id" },
        "operation": { "$ref": "#/$defs/review_operation" },
        "side_effects": { "type": "array", "items": { "$ref": "#/$defs/side_effect_class" } },
        "rollback_checkpoint": { "$ref": "#/$defs/nullable_rollback_checkpoint" },
        "creates_rollback_checkpoint": { "type": "boolean" },
        "discloses_rollback_path": { "const": true },
        "discloses_side_effects": { "const": true },
        "forces_reset": { "const": false }
      }
    },
    "resolved_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_id",
        "banner",
        "override_list",
        "rollback_remove_card",
        "reviewable_at_detail",
        "significance_distinguished",
        "overrides_attributable_without_reset"
      ],
      "properties": {
        "drift_id": { "$ref": "#/$defs/id" },
        "banner": { "$ref": "#/$defs/resolved_banner" },
        "override_list": { "$ref": "#/$defs/resolved_override_list" },
        "rollback_remove_card": { "$ref": "#/$defs/resolved_rollback_remove_card" },
        "reviewable_at_detail": { "const": true },
        "significance_distinguished": { "const": true },
        "overrides_attributable_without_reset": { "const": true },
        "degraded": { "$ref": "#/$defs/nullable_degraded_state" }
      }
    },
    "drift_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/drift_input" },
        "resolved": { "$ref": "#/$defs/resolved_drift" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "operations",
        "source_classes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_drifts",
        "reads_like_generic_update",
        "collapses_to_opaque_customized",
        "forces_reset_to_export"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/review_operation" }
        },
        "source_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_class" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_drifts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/drift_case" }
        },
        "reads_like_generic_update": { "const": false },
        "collapses_to_opaque_customized": { "const": false },
        "forces_reset_to_export": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "drift_kinds",
        "granularities",
        "significances",
        "export_fields",
        "side_effect_classes",
        "drift_states",
        "review_operations",
        "diff_actions",
        "asset_ownerships",
        "resolution_choices",
        "component_kinds",
        "source_classes",
        "bundle_classes",
        "signer_sources",
        "support_classes",
        "scorecard_classes",
        "freshness_states",
        "imported_confidences",
        "truth_modes",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "drift_kinds": { "type": "array", "items": { "type": "string" } },
        "granularities": { "type": "array", "items": { "type": "string" } },
        "significances": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "side_effect_classes": { "type": "array", "items": { "type": "string" } },
        "drift_states": { "type": "array", "items": { "type": "string" } },
        "review_operations": { "type": "array", "items": { "type": "string" } },
        "diff_actions": { "type": "array", "items": { "type": "string" } },
        "asset_ownerships": { "type": "array", "items": { "type": "string" } },
        "resolution_choices": { "type": "array", "items": { "type": "string" } },
        "component_kinds": { "type": "array", "items": { "type": "string" } },
        "source_classes": { "type": "array", "items": { "type": "string" } },
        "bundle_classes": { "type": "array", "items": { "type": "string" } },
        "signer_sources": { "type": "array", "items": { "type": "string" } },
        "support_classes": { "type": "array", "items": { "type": "string" } },
        "scorecard_classes": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "imported_confidences": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "drift_identity_preserved_across_surfaces",
        "drift_reviewable_at_detail",
        "significance_distinguished",
        "overrides_attributable_without_reset",
        "rollback_checkpoint_created_before_mutation",
        "support_export_reconstructs_drift",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "drift_identity_preserved_across_surfaces": { "const": true },
        "drift_reviewable_at_detail": { "const": true },
        "significance_distinguished": { "const": true },
        "overrides_attributable_without_reset": { "const": true },
        "rollback_checkpoint_created_before_mutation": { "const": true },
        "support_export_reconstructs_drift": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "override_list_reads_single_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "drift_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "override_list_reads_single_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "drift_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "drift_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
