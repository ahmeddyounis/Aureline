{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-component-consumer.schema.json",
  "title": "Aureline M5 test-explorer / watch / triage component consumer packet",
  "description": "M05-913 consumer-adoption packet proving the seven frozen M5 test-explorer / watch / triage component families (test-tree row, inline result marker, session-summary bar, watch-mode banner, failure-triage panel, quarantine-review sheet, and environment-matrix card) are reusable primitives beyond the primary test tree. Each row is one consumer on one M5 test surface — status-bar summary, activity center, coverage / flaky / snapshot intelligence, pipeline overlay, imported-CI view, or support packet — that points back to exactly one canonical component family (its primitive schema + release-proof packet) instead of inventing per-surface test vocabulary. Every consumer keeps the identical result-freshness, target-class, watch-state, quarantine-semantics, and imported-versus-live result-origin labels and one shared state lexicon (failed / rerun_failed / quarantined). A consumer whose result is imported, whose target compatibility drifted, whose watch fidelity degraded, or whose quarantine visibility is restricted by scope / policy auto-narrows its visible claim and discloses the reduction with an auto-narrow banner naming the reason and a recovery hint. The packet is metadata-only: raw runner output, assertion diffs, stack frames, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_test_component_consumer_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "consumer_class": {
      "enum": [
        "day_to_day_editor",
        "quality_intelligence",
        "pipeline_imported",
        "support_export"
      ]
    },
    "consumer_surface": {
      "enum": [
        "status_bar_summary",
        "activity_center",
        "coverage_intelligence",
        "flaky_intelligence",
        "snapshot_review",
        "pipeline_overlay",
        "imported_ci_view",
        "support_packet"
      ]
    },
    "component_family": {
      "enum": [
        "test_tree_row",
        "inline_result_marker",
        "session_summary_bar",
        "watch_mode_banner",
        "failure_triage_panel",
        "quarantine_review_sheet",
        "environment_matrix_card"
      ]
    },
    "result_origin": {
      "enum": [
        "live_local",
        "imported_ci",
        "imported_teammate",
        "replayed_snapshot",
        "synthetic_seed",
        "unknown_origin"
      ]
    },
    "claim_narrow_reason": {
      "enum": [
        "results_imported",
        "target_compatibility_drift",
        "watch_fidelity_degraded",
        "quarantine_visibility_restricted"
      ]
    },
    "label_parity": {
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "label_family": {
      "enum": [
        "result_freshness",
        "target_class",
        "watch_state",
        "quarantine_semantics",
        "result_origin"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "auto_narrow_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "reasons", "recovery_hints"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim_narrow_reason" }
        },
        "recovery_hints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_class",
        "consumer_surface",
        "component_family",
        "canonical_family_schema_ref",
        "canonical_packet_refs",
        "references_canonical_not_local_prose",
        "result_origin",
        "preserved_label_families",
        "shared_state_lexicon",
        "claim_narrow_reasons",
        "label_parity",
        "copy_export",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_test_component_consumer_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_class": { "$ref": "#/$defs/consumer_class" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_packet_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "result_origin": { "$ref": "#/$defs/result_origin" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/label_family" }
        },
        "shared_state_lexicon": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "claim_narrow_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_narrow_reason" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "auto_narrow_banner": { "$ref": "#/$defs/auto_narrow_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_class_count",
        "consumer_surface_count",
        "component_family_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_origin_claim_consistent",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "day_to_day_editor_present",
        "quality_intelligence_present",
        "pipeline_imported_present",
        "support_export_present",
        "label_family_coverage_complete",
        "all_narrow_reasons_demonstrated",
        "imported_and_live_both_present",
        "shared_lexicon_uniform",
        "families_reused_across_classes"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_class_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_origin_claim_consistent": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "day_to_day_editor_present": { "type": "boolean" },
        "quality_intelligence_present": { "type": "boolean" },
        "pipeline_imported_present": { "type": "boolean" },
        "support_export_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "all_narrow_reasons_demonstrated": { "type": "boolean" },
        "imported_and_live_both_present": { "type": "boolean" },
        "shared_lexicon_uniform": { "type": "boolean" },
        "families_reused_across_classes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
