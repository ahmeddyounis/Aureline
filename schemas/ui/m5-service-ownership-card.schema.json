{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-service-ownership-card.schema.json",
  "title": "Aureline M5 service-ownership card",
  "description": "Export-safe shape for a single M5 service ownership card instance. The component carries the frozen governance readiness-state vocabulary shared across the M5 governance-dashboard component matrix plus its own family-specific vocabulary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape. Raw URLs, raw tokens, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "qualification",
    "identity",
    "readiness_state",
    "evidence_freshness",
    "keyboard_route",
    "ownership_coverage_state",
    "owner_and_escalation"
  ],
  "properties": {
    "component_family": {
      "const": "service_ownership_card"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "identity": {
      "$ref": "#/$defs/non_empty_string"
    },
    "readiness_state": {
      "$ref": "#/$defs/readiness_state"
    },
    "evidence_freshness": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route": {
      "$ref": "#/$defs/non_empty_string"
    },
    "ownership_coverage_state": {
      "$ref": "#/$defs/ownership_coverage_state"
    },
    "owner_and_escalation": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "readiness_state": {
      "enum": [
        "passing",
        "warning",
        "blocked",
        "waived",
        "expired_waiver",
        "evidence_stale",
        "owner_unresolved",
        "forum_unresolved",
        "not_evaluated"
      ]
    },
    "ownership_coverage_state": {
      "enum": [
        "owned_with_backup",
        "primary_only_no_backup",
        "owner_unresolved",
        "owner_stale",
        "policy_hidden"
      ]
    }
  }
}
