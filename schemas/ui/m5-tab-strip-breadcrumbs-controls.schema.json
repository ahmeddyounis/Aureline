{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-tab-strip-breadcrumbs-controls.schema.json",
  "title": "Aureline M5 tab-strip and breadcrumbs controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 navigation / content component matrix. It carries resolved, honest projections of the tab strip and the breadcrumb trail across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved tab-strip examples (naming the active-context state, the per-tab pinned/preview/modified/read-only/blocked/shared/reopened item state with no-color-only semantics, and the local-action budget) and the resolved breadcrumb examples (naming the leaf identity, ancestry kind, hierarchy/path state, and source-aware context, honest under partial, stale, or truncated hierarchy). Hard invariants forbid tabs or breadcrumbs masquerading as top-level workflow navigation, inventing surface-local badges for a shared context, and hiding a blocked tab or collapsing missing breadcrumb scope behind an ambiguous ellipsis. Acceptance criteria — tabs show one shared state grammar with no surface-local badges, breadcrumb paths stay explicit in compact/expanded/exported views, and users can trace current context and local ancestry through one canonical component contract and command-backed detail entrypoints — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_tab_strip_and_breadcrumbs_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "tab_strip_example": {
      "type": "object",
      "required": [
        "strip_id",
        "active_context_label",
        "active_context",
        "item_state",
        "item_state_shared",
        "item_state_reopened",
        "local_action_budget",
        "has_blocked_tab",
        "presents_as_top_level_navigation",
        "invents_surface_local_badge",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "context_legible_at_a_glance"
      ],
      "properties": {
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "active_context_label": { "type": "string" },
        "active_context": { "$ref": "#/$defs/non_empty_string" },
        "item_state": { "$ref": "#/$defs/non_empty_string" },
        "item_state_shared": { "type": "boolean" },
        "item_state_reopened": { "type": "boolean" },
        "local_action_budget": { "$ref": "#/$defs/non_empty_string" },
        "has_blocked_tab": { "type": "boolean" },
        "presents_as_top_level_navigation": { "type": "boolean" },
        "invents_surface_local_badge": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "context_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "breadcrumbs_example": {
      "type": "object",
      "required": [
        "trail_id",
        "leaf_label",
        "ancestry_kind",
        "source_aware",
        "hierarchy_path",
        "path_is_partial_or_stale",
        "path_explicit_in_compact_and_expanded",
        "collapses_missing_scope_into_ellipsis",
        "presents_partial_or_stale_as_complete",
        "presents_as_top_level_navigation",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "path_explicit"
      ],
      "properties": {
        "trail_id": { "$ref": "#/$defs/non_empty_string" },
        "leaf_label": { "type": "string" },
        "ancestry_kind": { "$ref": "#/$defs/non_empty_string" },
        "source_aware": { "type": "boolean" },
        "hierarchy_path": { "$ref": "#/$defs/non_empty_string" },
        "path_is_partial_or_stale": { "type": "boolean" },
        "path_explicit_in_compact_and_expanded": { "type": "boolean" },
        "collapses_missing_scope_into_ellipsis": { "type": "boolean" },
        "presents_partial_or_stale_as_complete": { "type": "boolean" },
        "presents_as_top_level_navigation": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "path_explicit": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "tab_strip_examples",
        "breadcrumbs_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "tabs_masquerade_as_top_level_workflow_navigation",
        "breadcrumbs_masquerade_as_top_level_workflow_navigation",
        "invents_surface_local_badges_for_shared_context",
        "collapses_missing_scope_or_hides_blocked_behind_ellipsis"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "tab_strip_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tab_strip_example" }
        },
        "breadcrumbs_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/breadcrumbs_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "tabs_masquerade_as_top_level_workflow_navigation": { "const": false },
        "breadcrumbs_masquerade_as_top_level_workflow_navigation": { "const": false },
        "invents_surface_local_badges_for_shared_context": { "const": false },
        "collapses_missing_scope_or_hides_blocked_behind_ellipsis": { "const": false }
      }
    }
  }
}
