{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-experiment-component-accessibility-fallback.schema.json",
  "title": "Aureline M5 experiment-component accessibility & auto-narrowing fallback",
  "description": "Export-safe packet for the M05-1018 accessibility / keyboard / screen-reader / CLI / export parity and honest auto-narrowing capstone over the frozen M5 experiment-component matrix. Each row certifies one of the eight canonical component families (experiment run row, dataset provenance card, artifact lineage panel, run comparison table, environment fingerprint card, compare guard banner, sensitivity / sharing banner, result summary card) as keyboard-complete, assistive-tech-reachable, CLI/export-safe, and self-narrowing. When a dataset's sensitivity blocks preview, artifact lineage is stale or missing, an environment fingerprint is partial, comparison evidence is incomplete, a compare guard is blocked, or a dataset's provenance is severed, the component's result claim auto-narrows from exact_comparable_result / reviewable_result to a partial-fingerprint / incomparable-runs / guard-blocked / stale-lineage / unprovenanced-data / blocked-preview projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical run-identity / provenance / lineage. A partial-fingerprint / incomplete-comparison / stale-lineage / severed-provenance state never masquerades as an exact comparable result, and an unproven comparison never implies an apples-to-apples fair baseline. The packet is metadata-only: raw datasets, credentials, tokens, request bodies, and endpoint secrets never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_experiment_component_accessibility_fallback_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "experiment_run_row",
        "dataset_provenance_card",
        "artifact_lineage_panel",
        "run_comparison_table",
        "environment_fingerprint_card",
        "compare_guard_banner",
        "sensitivity_sharing_banner",
        "result_summary_card"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "experiment_claim": {
      "type": "string",
      "enum": [
        "exact_comparable_result",
        "reviewable_result",
        "partial_fingerprint_projection",
        "incomparable_runs_projection",
        "guard_blocked_projection",
        "stale_lineage_projection",
        "unprovenanced_data_projection",
        "blocked_preview_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "run_origin_traceability",
        "dataset_provenance",
        "artifact_lineage",
        "comparability_evidence",
        "environment_fingerprint",
        "compare_guard_clearance",
        "sensitivity_disclosure",
        "export_scope_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "live_exact_result",
        "fingerprint_partial",
        "comparability_incomplete",
        "compare_guard_blocked",
        "lineage_stale",
        "provenance_severed",
        "sensitivity_blocks_preview"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "run_origin_unstated",
        "code_revision_unstated",
        "environment_fingerprint_unstated",
        "dataset_provenance_severed",
        "comparability_overstated",
        "sensitivity_class_unstated",
        "export_scope_unstated",
        "raw_payload_exposed_by_default",
        "cached_state_hidden",
        "imported_run_unmarked",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "run_origin_and_revision",
        "provenance_and_sensitivity",
        "export_scope"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "notebook_ui",
        "experiment_dashboard_ui",
        "comparison_ui",
        "data_catalog_ui",
        "lineage_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_lineage_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/experiment_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_lineage_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "experiment_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_experiment_claim",
        "claim_conditions",
        "lineage_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_experiment_component_accessibility_fallback_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "experiment_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_experiment_claim": { "$ref": "#/$defs/experiment_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "lineage_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "hierarchy_heavy_family_count",
        "all_hierarchy_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_comparable_result_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_lineage_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "hierarchy_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_hierarchy_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_comparable_result_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_lineage_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
