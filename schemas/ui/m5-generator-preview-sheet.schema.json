{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-generator-preview-sheet.schema.json",
  "title": "Aureline M5 generator preview sheet",
  "description": "Per-component contract for a generator preview sheet: the reusable component that names what a generator or codemod will change and what it permits. Binds the one controlled certainty vocabulary plus the generator impact class and generator apply posture. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape. A generator never implies a no-op write when it changes config or dependencies and rollback or regenerate stays explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "identity_label",
    "state_label",
    "keyboard_route_label",
    "certainty",
    "generator_impact_class",
    "generator_apply_posture"
  ],
  "properties": {
    "component_family": {
      "const": "generator_preview_sheet"
    },
    "identity_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "state_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certainty": {
      "$ref": "#/$defs/certainty_disposition"
    },
    "generator_impact_class": {
      "$ref": "#/$defs/generator_impact_class"
    },
    "generator_apply_posture": {
      "$ref": "#/$defs/generator_apply_posture"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "generator_impact_class": {
      "enum": [
        "file_write",
        "dependency_change",
        "config_change",
        "script_or_task_change",
        "no_change",
        "unknown_impact"
      ]
    },
    "generator_apply_posture": {
      "enum": [
        "preview_ready",
        "review_required",
        "apply_ready",
        "rollback_available",
        "regenerate_available",
        "blocked"
      ]
    }
  }
}
