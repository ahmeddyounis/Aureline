{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-button-icon-button-controls.schema.json",
  "title": "Aureline M5 button and icon-button controls",
  "description": "Export-safe packet for the first implement lane over the frozen M5 core-action-input component matrix. It carries resolved, honest projections of the button and the icon button across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved button examples (naming the permanent action label, the primary/secondary/quiet/destructive/ghost emphasis with no-color-only semantics, the interaction disposition, the surface context, and the loading behavior that preserves width and label) and the resolved icon-button examples (naming the accessible name, icon-label mode, emphasis, surface context, command surface, and command parity). Hard invariants forbid buttons relabeling or resizing while loading, icon-only destructive actions going unlabeled, locked/degraded semantics hiding behind generic disabled chrome, and controls forking feature-local styles. Acceptance criteria — claimed consumers show stable primary/destructive/quiet action behavior with correct focus/loading/disabled/locked states, icon-only buttons expose accessible names and command parity rather than hidden or brand-only affordances, and button state drift is caught before release evidence turns green — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_button_and_icon_button_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "button_example": {
      "type": "object",
      "required": [
        "button_id",
        "action_label",
        "emphasis",
        "emphasis_is_destructive",
        "disposition",
        "disposition_is_blocked",
        "surface_context",
        "loading_behavior",
        "is_loading",
        "loading_preserves_label_and_width",
        "blocked_state_distinct",
        "command_id",
        "forks_feature_local_style",
        "command_route_available",
        "degrade_reason",
        "next_action",
        "action_attributable_at_a_glance"
      ],
      "properties": {
        "button_id": { "$ref": "#/$defs/non_empty_string" },
        "action_label": { "type": "string" },
        "emphasis": { "$ref": "#/$defs/non_empty_string" },
        "emphasis_is_destructive": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "disposition_is_blocked": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "loading_behavior": { "$ref": "#/$defs/non_empty_string" },
        "is_loading": { "type": "boolean" },
        "loading_preserves_label_and_width": { "type": "boolean" },
        "blocked_state_distinct": { "type": "boolean" },
        "command_id": { "type": "string" },
        "forks_feature_local_style": { "type": "boolean" },
        "command_route_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "action_attributable_at_a_glance": { "type": "boolean" }
      }
    },
    "icon_button_example": {
      "type": "object",
      "required": [
        "icon_button_id",
        "accessible_name",
        "label_mode",
        "exposes_accessible_name",
        "emphasis",
        "emphasis_is_destructive",
        "disposition",
        "surface_context",
        "command_surface",
        "tooltip_parity",
        "command_id",
        "command_parity_across_surfaces",
        "invents_brand_only_affordance",
        "command_route_available",
        "degrade_reason",
        "next_action",
        "name_and_command_legible_at_a_glance"
      ],
      "properties": {
        "icon_button_id": { "$ref": "#/$defs/non_empty_string" },
        "accessible_name": { "type": "string" },
        "label_mode": { "$ref": "#/$defs/non_empty_string" },
        "exposes_accessible_name": { "type": "boolean" },
        "emphasis": { "$ref": "#/$defs/non_empty_string" },
        "emphasis_is_destructive": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "command_surface": { "$ref": "#/$defs/non_empty_string" },
        "tooltip_parity": { "type": "boolean" },
        "command_id": { "type": "string" },
        "command_parity_across_surfaces": { "type": "boolean" },
        "invents_brand_only_affordance": { "type": "boolean" },
        "command_route_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "name_and_command_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "button_examples",
        "icon_button_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "buttons_relabel_or_resize_when_loading",
        "icon_only_destructive_actions_go_unlabeled",
        "locked_or_degraded_semantics_hidden_behind_disabled",
        "controls_fork_feature_local_styles"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "button_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/button_example" }
        },
        "icon_button_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/icon_button_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "buttons_relabel_or_resize_when_loading": { "const": false },
        "icon_only_destructive_actions_go_unlabeled": { "const": false },
        "locked_or_degraded_semantics_hidden_behind_disabled": { "const": false },
        "controls_fork_feature_local_styles": { "const": false }
      }
    }
  }
}
