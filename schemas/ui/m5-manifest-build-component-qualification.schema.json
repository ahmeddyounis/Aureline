{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-manifest-build-component-qualification.schema.json",
  "title": "M5 Manifest / Build Component Qualification Packet",
  "description": "One-bundle qualification of the frozen M5 manifest / build component families across every claimed infrastructure, live-resource, build/run/test/debug, incident/support, and handoff consumer. Keyed on the claim-bearing consumer, each row certifies five parity dimensions (target context, schema freshness, truth-layer labels, adapter source kind, accessibility/export behavior) as certified, disclosed-narrowed, or undisclosed-drift, and cites one certification bundle consolidating the whole B95 lane (M05-819).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "certification_bundle_ref",
    "certified_component_packets",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_manifest_build_component_qualification_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "certification_bundle_ref": { "type": "string", "minLength": 1 },
    "certified_component_packets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "consumer": {
      "type": "string",
      "enum": [
        "infrastructure_surface",
        "live_resource_surface",
        "execution_launcher",
        "incident_support",
        "handoff_consumer",
        "support_packet",
        "help_center",
        "release_evidence"
      ]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "target_context",
        "schema_freshness",
        "truth_layer_labels",
        "adapter_source_kind",
        "accessibility_export_behavior"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "schema_stale",
        "adapter_unavailable",
        "connector_loss",
        "policy_block",
        "drift_from_source",
        "low_confidence_discovery",
        "structured_channel_lost",
        "target_context_unresolved"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "consumer_identity",
        "target_context",
        "schema_freshness",
        "truth_layer_labels",
        "adapter_source_kind",
        "accessibility_behavior",
        "verdict",
        "narrowed_reason"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "target_context",
        "truth_class",
        "freshness_or_confidence",
        "adapter_source",
        "keyboard_route"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["qualified", "qualified_with_narrowing", "blocked"]
    },
    "dimension_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "state": { "$ref": "#/$defs/parity_state" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "reason_label": { "type": "string" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_copy",
        "json_copy",
        "markdown_copy",
        "screenshot_only_prohibited"
      ],
      "properties": {
        "text_copy": { "type": "boolean" },
        "json_copy": { "type": "boolean" },
        "markdown_copy": { "type": "boolean" },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer",
        "uses_shared_components",
        "target_context_ref",
        "dimensions",
        "copy_export",
        "preserved_export_fields",
        "required_labels",
        "canonical_component_refs",
        "certification_bundle_ref",
        "source_family_schema_ref",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_manifest_build_component_qualification_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer": { "$ref": "#/$defs/consumer" },
        "uses_shared_components": { "type": "boolean" },
        "target_context_ref": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dimension_parity" }
        },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "preserved_export_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_field" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "canonical_component_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "certification_bundle_ref": { "type": "string", "minLength": 1 },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_count",
        "all_use_shared_components",
        "all_preserve_target_context",
        "all_exports_preserve_truth",
        "all_narrowing_disclosed",
        "evidence_consumers_present",
        "dimensions_covered",
        "green_count",
        "yellow_count",
        "red_count",
        "canonical_packet_count"
      ],
      "properties": {
        "consumer_count": { "type": "integer", "minimum": 0 },
        "all_use_shared_components": { "type": "boolean" },
        "all_preserve_target_context": { "type": "boolean" },
        "all_exports_preserve_truth": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "evidence_consumers_present": { "type": "boolean" },
        "dimensions_covered": { "type": "integer", "minimum": 0 },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "canonical_packet_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
