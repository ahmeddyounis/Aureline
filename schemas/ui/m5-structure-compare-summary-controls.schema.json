{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-structure-compare-summary-controls.schema.json",
  "title": "Aureline M5 structure rows and compare summary cards",
  "description": "Export-safe packet implementing the reusable M5 structure-row and compare-summary-card components. Each structure row answers, from the component alone, which structured object or key-path changed, whether it was added, removed, modified, metadata-only, or redacted-and-hidden, what the old and new summaries are, what confidence or schema note backs the reading, and how to reach the underlying raw content. Each compare summary card rolls up the compare result: changed-object counts by change kind, scale and risk markers, a compare-only-versus-write-back safety disclosure, and a raw-context jump action, without flattening the diff or hiding the raw artifact. Structure rows and compare summary cards are paired by artifact reference. Raw artifact bodies, raw diffs, credentials, and live provider responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "structure_rows",
    "compare_summary_cards",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "structure_rows_and_compare_summary_controls"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "structure_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/structure_row"
      }
    },
    "compare_summary_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compare_summary_card"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_trigger"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "fidelity_state": {
      "type": "string",
      "enum": [
        "structured_faithful",
        "structured_partial",
        "schema_unrecognized",
        "render_untrusted",
        "raw_fallback",
        "redacted_or_withheld"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "compare_only_no_write_back",
        "write_back_attributable",
        "regenerate_only_no_manual_edit",
        "evidence_preserved_no_revert",
        "not_applicable"
      ]
    },
    "change_kind": {
      "type": "string",
      "enum": [
        "added",
        "removed",
        "modified",
        "metadata_only",
        "redacted_hidden"
      ]
    },
    "object_category": {
      "type": "string",
      "enum": [
        "structured_object",
        "package_delta",
        "metadata_field",
        "redacted_field"
      ]
    },
    "risk_marker": {
      "type": "string",
      "enum": [
        "large_change_volume",
        "security_sensitive_path",
        "generated_artifact_drift",
        "schema_fidelity_narrowed",
        "redacted_content_present",
        "irreversible_write_back"
      ]
    },
    "risk_severity": {
      "type": "string",
      "enum": [
        "info",
        "caution",
        "critical"
      ]
    },
    "structure_component": {
      "type": "string",
      "const": "structure_row"
    },
    "compare_component": {
      "type": "string",
      "const": "compare_summary_card"
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "schema_unrecognized",
        "render_untrusted",
        "compare_only_enforced",
        "large_diff_truncation_risk",
        "redaction_applied",
        "trust_narrowing",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "diff_compare_view",
        "merge_conflict_workspace",
        "notebook_review",
        "artifact_browser",
        "cli_headless",
        "support_export",
        "help_about"
      ]
    },
    "change_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "modified",
        "metadata_only",
        "redacted_hidden",
        "total_changed_objects"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_only": {
          "type": "integer",
          "minimum": 0
        },
        "redacted_hidden": {
          "type": "integer",
          "minimum": 0
        },
        "total_changed_objects": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "risk_marker_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker",
        "severity",
        "note"
      ],
      "properties": {
        "marker": {
          "$ref": "#/$defs/risk_marker"
        },
        "severity": {
          "$ref": "#/$defs/risk_severity"
        },
        "note": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "structure_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "artifact_ref",
        "object_path",
        "object_category",
        "change_kind",
        "old_summary",
        "new_summary",
        "confidence_or_schema_note",
        "schema_fidelity",
        "redaction_note",
        "raw_context_action",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/structure_component"
        },
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "object_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "object_category": {
          "$ref": "#/$defs/object_category"
        },
        "change_kind": {
          "$ref": "#/$defs/change_kind"
        },
        "old_summary": {
          "type": "string"
        },
        "new_summary": {
          "type": "string"
        },
        "confidence_or_schema_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema_fidelity": {
          "$ref": "#/$defs/fidelity_state"
        },
        "redaction_note": {
          "type": "string"
        },
        "raw_context_action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "change_kind": {
                "const": "redacted_hidden"
              }
            }
          },
          "then": {
            "properties": {
              "redaction_note": {
                "$ref": "#/$defs/non_empty_string"
              },
              "old_summary": {
                "const": ""
              },
              "new_summary": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "compare_summary_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "artifact_ref",
        "artifact_class_label",
        "change_counts",
        "large_diff",
        "risk_markers",
        "confidence_or_schema_note",
        "schema_fidelity",
        "compare_write_back_safety",
        "raw_context_action",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/compare_component"
        },
        "card_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_class_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "change_counts": {
          "$ref": "#/$defs/change_counts"
        },
        "large_diff": {
          "type": "boolean"
        },
        "risk_markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk_marker_note"
          }
        },
        "confidence_or_schema_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema_fidelity": {
          "$ref": "#/$defs/fidelity_state"
        },
        "compare_write_back_safety": {
          "$ref": "#/$defs/non_empty_string"
        },
        "raw_context_action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_identity_always_explicit",
        "change_kind_distinct_per_object",
        "old_new_summary_preserved",
        "raw_context_always_reachable",
        "scale_surfaced_without_flattening",
        "risk_markers_explained",
        "redacted_content_never_leaked",
        "confidence_or_schema_note_explicit",
        "compare_only_never_silently_writable",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "object_identity_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "change_kind_distinct_per_object": {
          "type": "boolean",
          "const": true
        },
        "old_new_summary_preserved": {
          "type": "boolean",
          "const": true
        },
        "raw_context_always_reachable": {
          "type": "boolean",
          "const": true
        },
        "scale_surfaced_without_flattening": {
          "type": "boolean",
          "const": true
        },
        "risk_markers_explained": {
          "type": "boolean",
          "const": true
        },
        "redacted_content_never_leaked": {
          "type": "boolean",
          "const": true
        },
        "confidence_or_schema_note_explicit": {
          "type": "boolean",
          "const": true
        },
        "compare_only_never_silently_writable": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure_row_shows_object_and_change_kind",
        "compare_card_shows_counts_and_risk",
        "raw_context_reachable_from_both",
        "redacted_fields_shown_as_hidden_not_dropped",
        "cli_headless_shows_truth",
        "support_export_shows_truth",
        "help_about_shows_truth"
      ],
      "properties": {
        "structure_row_shows_object_and_change_kind": {
          "type": "boolean",
          "const": true
        },
        "compare_card_shows_counts_and_risk": {
          "type": "boolean",
          "const": true
        },
        "raw_context_reachable_from_both": {
          "type": "boolean",
          "const": true
        },
        "redacted_fields_shown_as_hidden_not_dropped": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
