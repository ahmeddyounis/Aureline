{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-project-entry-component-certification.schema.json",
  "title": "Aureline M5 project-entry component surface certification packet",
  "description": "M05-843 closing capstone certifying that the frozen M5 project-entry component families behave consistently on every claimed M5 project-entry surface. Keyed on the claimed surface (Start Center, command palette, system-open, deep-link, CLI/headless, template/prebuild, clone, import, restore), each row certifies the surface across five truth axes — profile/remote badge parity, restore class, trust posture, first-useful-work routing, and always-on export parity — and either passes (green), auto-narrows its interactive claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a full-truth claim inherited from a healthier lane. A degraded axis must produce a visible tier narrowing; export parity must always certify. Every row cites exactly one canonical release-proof bundle. The packet is metadata-only: raw file paths, clone URLs, credentials, remote hosts, and device identifiers never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_project_entry_component_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-project-entry-component-proof/packet.json"
    },
    "rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_surface": {
      "enum": [
        "start_center",
        "command_palette",
        "system_open",
        "deep_link",
        "cli_headless",
        "template_prebuild",
        "clone",
        "import",
        "restore"
      ]
    },
    "certification_axis": {
      "enum": [
        "profile_remote_badge",
        "restore_class",
        "trust_posture",
        "first_useful_work_routing",
        "export_parity"
      ]
    },
    "claim_tier": {
      "enum": ["full_entry", "reviewed_entry", "inspect_only", "export_only"]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "surface_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "start_center_quick_action_card",
        "recent_work_row",
        "workspace_switcher_entry",
        "restore_prompt_card",
        "entry_chooser_row",
        "entry_review_sheet",
        "destination_collision_sheet",
        "post_entry_handoff_card",
        "admission_checkpoint_card",
        "archetype_readiness_row"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "type": "string", "minLength": 1 }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_tier", "to_tier", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_tier": { "$ref": "#/$defs/claim_tier" },
        "to_tier": { "$ref": "#/$defs/claim_tier" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_tier",
        "certified_tier",
        "consumed_families",
        "axis_outcomes",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_project_entry_component_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/certified_surface" },
        "claimed_tier": { "$ref": "#/$defs/claim_tier" },
        "certified_tier": { "$ref": "#/$defs/claim_tier" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-project-entry-component-proof/packet.json"
        },
        "derived_status": { "$ref": "#/$defs/surface_status" },
        "export_parity": { "$ref": "#/$defs/copy_export" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "every_axis_covered_on_every_row",
        "narrowed_surface_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
