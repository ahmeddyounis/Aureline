{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-stack-edit-review-sheet.schema.json",
  "title": "Aureline M5 stack-edit / review sheet",
  "description": "Canonical per-domain descriptor for the sheet that edits and reviews a patch stack. Names each member's stack membership source, flags a restack-required stack, flags stale-or-broken membership, and labels an inferred-from-branch-name membership as inferred so the four membership sources are never flattened into one badge. Raw paths, raw provider payloads, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "change_orchestration_association",
    "stack_membership_source",
    "landing_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "stack_edit_review_sheet"
      ]
    },
    "change_orchestration_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "stack_membership_source": {
      "enum": [
        "declared_in_change_object",
        "declared_locally",
        "inferred_from_branch_name",
        "stale_or_broken_membership"
      ]
    },
    "restack_required": {
      "type": "boolean"
    },
    "landing_state": {
      "enum": [
        "selected_change",
        "stale_validation",
        "restack_required",
        "queue_eligible",
        "queue_blocked",
        "protected_branch_blocked",
        "orphaned",
        "abandoned",
        "exported",
        "imported_reopened"
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
