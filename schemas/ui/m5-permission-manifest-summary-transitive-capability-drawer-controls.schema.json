{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-permission-manifest-summary-transitive-capability-drawer-controls.schema.json",
  "title": "Aureline M5 permission-manifest-summary and transitive-capability-drawer controls",
  "description": "Export-safe packet for the third implement lane over the frozen M5 marketplace / install-review component matrix. It carries resolved, honest projections of the permission manifest summary and its transitive capability drawer across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved summary examples (naming the permission posture, the required / optional / inherited capability classes, the runtime / host model, the data / network boundaries, and the canonical manifest digest) and the resolved drawer examples (disclosing transitive widening and attributing each dependency-contributed permission to the dependency that contributed it). Hard invariants forbid flattening permissions into one vague full-access label, hiding transitive or dependency-contributed widening, hiding the data / network / runtime boundary, and severing a summary from its canonical manifest digest. Acceptance criteria — the permission posture stays explicit at search, detail, install, update, and diagnostics time and traces back to one canonical manifest grouping contract, and transitive widening is visible and attributable before trust silently continues — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_permission_manifest_summary_and_transitive_capability_drawer_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "permission_manifest_summary_example": {
      "type": "object",
      "required": [
        "summary_id",
        "artifact_identity",
        "posture",
        "requests_capabilities",
        "widens_transitively",
        "host_runtime_model",
        "required_capabilities",
        "optional_capabilities",
        "inherited_capabilities",
        "data_boundary",
        "network_boundary",
        "manifest_digest",
        "flattens_into_full_access",
        "degrade_reason",
        "next_action",
        "fully_legible"
      ],
      "properties": {
        "summary_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "posture": { "$ref": "#/$defs/non_empty_string" },
        "requests_capabilities": { "type": "boolean" },
        "widens_transitively": { "type": "boolean" },
        "host_runtime_model": { "$ref": "#/$defs/non_empty_string" },
        "required_capabilities": { "type": "array", "items": { "type": "string" } },
        "optional_capabilities": { "type": "array", "items": { "type": "string" } },
        "inherited_capabilities": { "type": "array", "items": { "type": "string" } },
        "data_boundary": { "type": "string" },
        "network_boundary": { "type": "string" },
        "manifest_digest": { "type": "string" },
        "flattens_into_full_access": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fully_legible": { "type": "boolean" }
      }
    },
    "transitive_capability_drawer_example": {
      "type": "object",
      "required": [
        "drawer_id",
        "artifact_identity",
        "posture",
        "widens_transitively",
        "transitive_widening_disclosed",
        "dependency_contributed_capabilities",
        "dependency_attributions",
        "manifest_digest",
        "flattens_into_full_access",
        "hides_transitive_widening",
        "degrade_reason",
        "next_action",
        "fully_legible"
      ],
      "properties": {
        "drawer_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "posture": { "$ref": "#/$defs/non_empty_string" },
        "widens_transitively": { "type": "boolean" },
        "transitive_widening_disclosed": { "type": "boolean" },
        "dependency_contributed_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependency_attributions": { "type": "array", "items": { "type": "string" } },
        "manifest_digest": { "type": "string" },
        "flattens_into_full_access": { "type": "boolean" },
        "hides_transitive_widening": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fully_legible": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "permission_manifest_summary_examples",
        "transitive_capability_drawer_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "flattens_permissions_into_vague_full_access",
        "hides_transitive_or_dependency_contributed_widening",
        "hides_data_network_or_runtime_boundary",
        "severs_summary_from_canonical_manifest_digest"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "permission_manifest_summary_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/permission_manifest_summary_example" }
        },
        "transitive_capability_drawer_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transitive_capability_drawer_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "flattens_permissions_into_vague_full_access": { "const": false },
        "hides_transitive_or_dependency_contributed_widening": { "const": false },
        "hides_data_network_or_runtime_boundary": { "const": false },
        "severs_summary_from_canonical_manifest_digest": { "const": false }
      }
    }
  }
}
