{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-output-trust-banner-output-provenance-chip-group-controls.schema.json",
  "title": "Aureline M5 output trust banners and output provenance chip groups",
  "description": "Export-safe packet implementing the reusable M5 output-trust-banner and output-provenance-chip-group components in two co-equal control vectors. Each output trust banner names an output's trust class, its raw-versus-rendered representation, and whether it is live or stale after an edit, a kernel restart, or a target/environment drift, and offers first-class open-raw/export/copy actions; its presentation class is derived from the output trust class, so a raw or untrusted output can never read as trusted active content (users can tell whether an output is plain text, sanitized rich content, trusted local active content, or isolated remote active content), and an output may present as live only when its freshness is live_output. Each output provenance chip group names an output's cell/run identity, its origin class, its attached artifacts, and its persistence/retention cues, and offers inspect/view-artifacts/copy actions; its origin and lineage are derived from the output provenance kind and state, so an imported, restored, external, or unknown output can never read as internally produced and a current pinned lineage may be claimed only when the provenance is complete or the execution count is pinned. Every next step names one stable notebook/output-viewer/docs/support deep link rather than an ephemeral overlay or hidden route. No component presents stale output as live, hides the trust class behind a hover-only affordance, flattens the output into ambiguous evidence on copy/export, or severs the output's canonical provenance; raw notebook payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "trust_banners",
    "provenance_chip_groups",
    "downgrade_triggers",
    "consumer_surfaces",
    "output_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_output_trust_banners_and_output_provenance_chip_groups_with_plaintext_sanitizedrich_trustedlocalactive_isolatedremoteactive_class_stale_output_honesty_and_copy_export_choice_across_claimed_m5_notebook_outputs"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "trust_banners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output_trust_banner" }
    },
    "provenance_chip_groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output_provenance_chip_group" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "output_review": { "$ref": "#/$defs/output_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "output_trust_class": {
      "enum": [
        "trusted_output",
        "sanitized_output",
        "sandboxed_output",
        "raw_active_output",
        "blocked_output",
        "unknown_trust"
      ]
    },
    "output_freshness_state": {
      "enum": [
        "live_output",
        "stale_output",
        "cached_output",
        "cleared_output",
        "superseded_output",
        "no_output"
      ]
    },
    "output_presentation_class": {
      "enum": [
        "plain_text",
        "sanitized_rich",
        "trusted_local_active",
        "isolated_remote_active",
        "blocked_content",
        "unknown_content"
      ]
    },
    "representation_mode": {
      "enum": ["rendered_rich", "raw_source", "redacted_representation"]
    },
    "output_provenance_kind": {
      "enum": [
        "produced_by_cell",
        "produced_by_run",
        "imported_output",
        "restored_output",
        "external_output",
        "unknown_provenance"
      ]
    },
    "output_provenance_state": {
      "enum": [
        "provenance_complete",
        "provenance_partial",
        "provenance_missing",
        "execution_count_pinned",
        "execution_count_drifted",
        "provenance_stale"
      ]
    },
    "output_origin_class": {
      "enum": [
        "cell_produced",
        "run_produced",
        "imported_origin",
        "restored_origin",
        "external_origin",
        "unknown_origin"
      ]
    },
    "output_provenance_resolution": {
      "enum": [
        "fully_resolved",
        "partially_resolved",
        "unresolved",
        "lineage_pinned",
        "lineage_drifted",
        "resolution_stale"
      ]
    },
    "deep_link_kind": {
      "enum": [
        "notebook_location",
        "output_viewer",
        "docs_anchor",
        "support_bundle",
        "no_deep_link"
      ]
    },
    "banner_action": {
      "enum": [
        "open_raw",
        "export_output",
        "copy_output",
        "clear_stale_output",
        "rerun_to_refresh",
        "open_deep_link"
      ]
    },
    "chip_action": {
      "enum": [
        "inspect_provenance",
        "view_artifacts",
        "copy_lineage_identity",
        "view_persistence",
        "export_provenance",
        "open_deep_link"
      ]
    },
    "disposition": {
      "enum": [
        "no_kernel",
        "queued",
        "busy",
        "ready",
        "disconnected",
        "managed",
        "remote",
        "stale_output",
        "sanitized",
        "active",
        "reconnect",
        "restart_clean",
        "choose_another_kernel"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "kernel_origin_and_class",
        "output_trust_and_freshness",
        "restart_and_recovery"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook_surface",
        "kernel_manager_surface",
        "output_viewer_surface",
        "debug_surface",
        "review_surface",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "notebook_ui",
        "kernel_manager_ui",
        "output_viewer_ui",
        "debugger_ui",
        "ai_context_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "kernel_origin_unstated",
        "kernel_class_collapsed",
        "document_identity_unstated",
        "output_trust_unstated",
        "stale_output_shown_as_live",
        "trust_class_hover_only",
        "provenance_severed",
        "restart_consequence_implied_rerun",
        "recovery_overclaimed",
        "reconnect_shown_as_fresh",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "output_trust_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "banner_id",
        "banner_label",
        "trust_class",
        "freshness_state",
        "representation_mode",
        "presentation_class",
        "claims_active_content",
        "claims_live",
        "sanitized_note",
        "active_content_note",
        "isolation_note",
        "blocked_note",
        "unknown_trust_note",
        "stale_note",
        "cached_note",
        "cleared_note",
        "trust_class_label",
        "representation_label",
        "freshness_label",
        "copy_export_choice_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "banner_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "presents_stale_output_as_live",
        "hides_trust_class_behind_hover_only",
        "flattens_output_into_ambiguous_evidence",
        "severs_output_provenance"
      ],
      "properties": {
        "component": { "const": "output_trust_banner" },
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "banner_label": { "$ref": "#/$defs/non_empty_string" },
        "trust_class": { "$ref": "#/$defs/output_trust_class" },
        "freshness_state": { "$ref": "#/$defs/output_freshness_state" },
        "representation_mode": { "$ref": "#/$defs/representation_mode" },
        "presentation_class": { "$ref": "#/$defs/output_presentation_class" },
        "claims_active_content": { "type": "boolean" },
        "claims_live": { "type": "boolean" },
        "sanitized_note": { "type": "string" },
        "active_content_note": { "type": "string" },
        "isolation_note": { "type": "string" },
        "blocked_note": { "type": "string" },
        "unknown_trust_note": { "type": "string" },
        "stale_note": { "type": "string" },
        "cached_note": { "type": "string" },
        "cleared_note": { "type": "string" },
        "trust_class_label": { "$ref": "#/$defs/non_empty_string" },
        "representation_label": { "$ref": "#/$defs/non_empty_string" },
        "freshness_label": { "$ref": "#/$defs/non_empty_string" },
        "copy_export_choice_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "banner_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_raw" } },
            { "contains": { "const": "export_output" } },
            { "contains": { "const": "copy_output" } }
          ],
          "items": { "$ref": "#/$defs/banner_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "presents_stale_output_as_live": { "const": false },
        "hides_trust_class_behind_hover_only": { "const": false },
        "flattens_output_into_ambiguous_evidence": { "const": false },
        "severs_output_provenance": { "const": false }
      }
    },
    "output_provenance_chip_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "group_id",
        "group_label",
        "provenance_kind",
        "provenance_state",
        "origin_class",
        "resolution_class",
        "claims_internal_origin",
        "claims_current_lineage",
        "external_note",
        "partial_note",
        "missing_note",
        "drift_note",
        "stale_note",
        "cell_run_identity_label",
        "origin_class_label",
        "attached_artifacts_label",
        "persistence_retention_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "chip_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "presents_stale_output_as_live",
        "hides_trust_class_behind_hover_only",
        "flattens_output_into_ambiguous_evidence",
        "severs_output_provenance"
      ],
      "properties": {
        "component": { "const": "output_provenance_chip_group" },
        "group_id": { "$ref": "#/$defs/non_empty_string" },
        "group_label": { "$ref": "#/$defs/non_empty_string" },
        "provenance_kind": { "$ref": "#/$defs/output_provenance_kind" },
        "provenance_state": { "$ref": "#/$defs/output_provenance_state" },
        "origin_class": { "$ref": "#/$defs/output_origin_class" },
        "resolution_class": { "$ref": "#/$defs/output_provenance_resolution" },
        "claims_internal_origin": { "type": "boolean" },
        "claims_current_lineage": { "type": "boolean" },
        "external_note": { "type": "string" },
        "partial_note": { "type": "string" },
        "missing_note": { "type": "string" },
        "drift_note": { "type": "string" },
        "stale_note": { "type": "string" },
        "cell_run_identity_label": { "$ref": "#/$defs/non_empty_string" },
        "origin_class_label": { "$ref": "#/$defs/non_empty_string" },
        "attached_artifacts_label": { "$ref": "#/$defs/non_empty_string" },
        "persistence_retention_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "chip_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "inspect_provenance" } },
            { "contains": { "const": "view_artifacts" } },
            { "contains": { "const": "copy_lineage_identity" } }
          ],
          "items": { "$ref": "#/$defs/chip_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "presents_stale_output_as_live": { "const": false },
        "hides_trust_class_behind_hover_only": { "const": false },
        "flattens_output_into_ambiguous_evidence": { "const": false },
        "severs_output_provenance": { "const": false }
      }
    },
    "output_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banner_shows_trust_class",
        "banner_shows_raw_vs_rendered",
        "banner_shows_stale_state",
        "banner_offers_open_raw_and_export",
        "chip_shows_cell_run_identity",
        "chip_shows_origin_class",
        "chip_shows_attached_artifacts",
        "chip_shows_persistence_or_retention",
        "trust_and_provenance_derived_never_asserted",
        "stale_output_never_presented_as_live",
        "trust_class_never_hover_only",
        "copy_export_preserves_trust_and_representation",
        "output_provenance_never_severed",
        "output_trust_visible_in_notebook_ai_support",
        "every_next_step_names_stable_deep_link",
        "banner_and_chip_consistent_across_surfaces",
        "no_component_widens_export_scope_or_exposes_raw_by_default",
        "components_stable_across_deployment_lines",
        "no_surface_invents_alternate_state_label",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_viewer_reads_single_source",
        "notebook_output_shows_trust_class",
        "ai_context_shows_output_provenance",
        "support_export_shows_trust_and_provenance",
        "copy_export_preserves_representation",
        "help_docs_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
