{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-navigation-content-component-matrix.schema.json",
  "title": "Aureline M5 tab-strip, breadcrumbs, tree-view, list-view, table/grid, and panel-header navigation-content component matrix",
  "description": "Export-safe packet freezing Aureline's reusable navigation and dense-content UI components. The packet names every claimed M5 surface that still ships its own tab set, breadcrumb trail, explorer tree, result list, dense table/grid, or panel header \u2014 across shell, explorer, search, review, request/data, help, and support surfaces \u2014 and binds each to the claimed surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, reduced-motion, CLI/export, support-packet), the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: the single controlled navigation/content-disposition vocabulary consumers bind to (preview, pinned, modified, read_only, blocked, exact_count, loaded_count, all_matching_count, hidden_by_filter, hidden_by_policy, overflowed_local_action, stale_or_partial_hierarchy), plus family-specific active-context states, hierarchy/path states, disclosure states, selection states, count scopes, item-state flags, density variants, and local-action budgets. Hard invariants forbid letting tabs masquerade as top-level workflow navigation, hiding counts or blocked rows behind an ambiguous ellipsis, making tree/list/table actions hover-only, letting a panel header become a cluttered secondary toolbar, and collapsing exact, loaded, and all-matching scopes into one vague total. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_tab_strip_breadcrumbs_tree_view_list_view_table_grid_and_panel_header_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "component_family": {
      "enum": [
        "tab_strip",
        "breadcrumbs",
        "tree_view",
        "list_view",
        "table_grid",
        "panel_header"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "preview",
        "pinned",
        "modified",
        "read_only",
        "blocked",
        "exact_count",
        "loaded_count",
        "all_matching_count",
        "hidden_by_filter",
        "hidden_by_policy",
        "overflowed_local_action",
        "stale_or_partial_hierarchy"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "tabs_masquerade_as_top_level_workflow_navigation",
        "hides_counts_or_blocked_rows_behind_ambiguous_ellipsis",
        "makes_tree_list_or_table_actions_hover_only",
        "panel_header_becomes_cluttered_secondary_toolbar",
        "collapses_exact_loaded_and_all_matching_scopes_into_one_total"
      ],
      "properties": {
        "component_family": {
          "$ref": "#/$defs/component_family"
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "preview",
              "pinned",
              "modified",
              "read_only",
              "blocked",
              "exact_count",
              "loaded_count",
              "all_matching_count",
              "hidden_by_filter",
              "hidden_by_policy",
              "overflowed_local_action",
              "stale_or_partial_hierarchy"
            ]
          }
        },
        "active_context_states": {
          "type": "array"
        },
        "hierarchy_path_states": {
          "type": "array"
        },
        "disclosure_states": {
          "type": "array"
        },
        "selection_states": {
          "type": "array"
        },
        "count_scopes": {
          "type": "array"
        },
        "item_state_flags": {
          "type": "array"
        },
        "density_variants": {
          "type": "array"
        },
        "local_action_budgets": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "tabs_masquerade_as_top_level_workflow_navigation": {
          "const": false
        },
        "hides_counts_or_blocked_rows_behind_ambiguous_ellipsis": {
          "const": false
        },
        "makes_tree_list_or_table_actions_hover_only": {
          "const": false
        },
        "panel_header_becomes_cluttered_secondary_toolbar": {
          "const": false
        },
        "collapses_exact_loaded_and_all_matching_scopes_into_one_total": {
          "const": false
        }
      }
    }
  }
}
