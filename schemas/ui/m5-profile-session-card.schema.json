{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-profile-session-card.schema.json",
  "title": "Aureline M5 profile session card",
  "description": "Reusable profile session card contract preserving capture mode, execution origin, build/runtime identity, target process/config, captured time, mapping quality, compare/export actions, and reduced-capability truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "card_id",
    "session_ref",
    "capture_mode",
    "artifact_origin",
    "execution_origin",
    "build_identity_ref",
    "runtime_identity_ref",
    "target",
    "captured_at",
    "mapping_quality",
    "baseline",
    "actions",
    "source_refs",
    "consumer_surfaces",
    "copy_export",
    "reduced_capability_banner",
    "support_export_join",
    "auto_narrowing_contract"
  ],
  "properties": {
    "record_kind": { "const": "m5_profile_session_card" },
    "schema_version": { "const": 1 },
    "card_id": { "$ref": "#/$defs/id" },
    "session_ref": { "$ref": "#/$defs/ref" },
    "capture_mode": { "$ref": "#/$defs/capture_mode" },
    "artifact_origin": { "$ref": "#/$defs/artifact_origin" },
    "execution_origin": { "$ref": "#/$defs/execution_origin" },
    "build_identity_ref": { "$ref": "#/$defs/ref" },
    "runtime_identity_ref": { "$ref": "#/$defs/ref" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_ref", "config_ref", "display_label", "raw_command_line_exported"],
      "properties": {
        "process_ref": { "$ref": "#/$defs/ref" },
        "config_ref": { "$ref": "#/$defs/ref" },
        "display_label": { "$ref": "#/$defs/ref" },
        "raw_command_line_exported": { "const": false }
      }
    },
    "captured_at": { "type": "string", "format": "date-time" },
    "mapping_quality": { "$ref": "#/$defs/mapping_quality" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_ref", "environment_state", "environment_delta_refs", "threshold_state", "waiver_ref"],
      "properties": {
        "baseline_ref": { "$ref": "#/$defs/ref" },
        "environment_state": { "$ref": "#/$defs/baseline_environment_state" },
        "environment_delta_refs": { "$ref": "#/$defs/ref_array" },
        "threshold_state": { "$ref": "#/$defs/threshold_state" },
        "waiver_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "actions": { "$ref": "#/$defs/actions" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" },
    "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
    "support_export_join": { "$ref": "#/$defs/support_export_join" },
    "auto_narrowing_contract": { "$ref": "#/$defs/auto_narrowing_contract" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
    "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "enum": ["desktop_profiler_workspace", "hotspot_workspace", "trace_viewer", "heap_analysis", "profile_compare", "topology_map", "ownership_browser", "architecture_explainer", "search_results", "review_workspace", "onboarding_tour", "ai_context_panel", "incident_workspace", "docs_help", "cli_headless", "support_export", "release_proof"] } },
    "capture_mode": { "enum": ["sample_cpu", "instrumented_cpu", "allocation", "heap_snapshot", "wall_time", "trace", "replay_import", "imported_profile"] },
    "artifact_origin": { "enum": ["live_capture", "replay_capture", "imported_artifact", "support_bundle", "cached_replay", "unknown"] },
    "execution_origin": { "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "ci_runner", "imported_artifact", "support_bundle", "cli_headless"] },
    "mapping_quality": { "enum": ["exact", "symbolicated", "source_mapped", "partial", "heuristic", "missing", "not_applicable"] },
    "baseline_environment_state": { "enum": ["comparable", "comparable_with_deltas", "incomparable", "baseline_missing", "threshold_pending", "waived"] },
    "threshold_state": { "enum": ["not_applicable", "within_threshold", "regression", "improvement", "threshold_pending", "waived"] },
    "actions": { "type": "object", "additionalProperties": false, "required": ["compare_available", "export_available", "open_trace_available", "disabled_reason_refs"], "properties": { "compare_available": { "type": "boolean" }, "export_available": { "type": "boolean" }, "open_trace_available": { "type": "boolean" }, "disabled_reason_refs": { "$ref": "#/$defs/ref_array" } } },
    "copy_export": { "type": "object", "additionalProperties": false, "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "items": { "enum": ["text", "json", "markdown"] }, "minItems": 3 }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "type": "string" }, "json": { "type": "string" }, "markdown": { "type": "string" }, "screenshot_only_prohibited": { "const": true } } },
    "reduced_capability_banner": { "type": "object", "additionalProperties": false, "required": ["banner_id", "severity", "capability_state", "visible_label", "missing_capabilities", "preserved_fields"], "properties": { "banner_id": { "$ref": "#/$defs/ref" }, "severity": { "enum": ["info", "warning", "blocking"] }, "capability_state": { "enum": ["full", "read_only", "inspect_only", "compare_only", "export_only", "policy_blocked", "unavailable"] }, "visible_label": { "type": "string" }, "missing_capabilities": { "$ref": "#/$defs/ref_array" }, "preserved_fields": { "$ref": "#/$defs/ref_array" } } },
    "support_export_join": { "type": "object", "additionalProperties": false, "required": ["join_id", "schema_ref", "joined_object_kinds", "raw_profile_samples_exported", "raw_trace_events_exported", "gui_cli_support_label_parity"], "properties": { "join_id": { "$ref": "#/$defs/ref" }, "schema_ref": { "$ref": "#/$defs/ref" }, "joined_object_kinds": { "$ref": "#/$defs/ref_array" }, "raw_profile_samples_exported": { "const": false }, "raw_trace_events_exported": { "const": false }, "gui_cli_support_label_parity": { "const": true } } },
    "auto_narrowing_contract": { "type": "object", "additionalProperties": false, "required": ["narrow_on_missing_or_stale", "stale_or_missing_effect", "policy_blocked_effect", "degraded_state_reason_field", "release_help_claim_ceiling"], "properties": { "narrow_on_missing_or_stale": { "$ref": "#/$defs/ref_array" }, "stale_or_missing_effect": { "const": "narrow_claim" }, "policy_blocked_effect": { "enum": ["block_export_or_narrow_claim", "narrow_claim"] }, "degraded_state_reason_field": { "const": "narrowed_claim_reasons" }, "release_help_claim_ceiling": { "const": "available_evidence_only" } } }
  }
}
