{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-ai-message-card-evidence-timeline-controls.schema.json",
  "title": "Aureline M5 AI-message-card and evidence-timeline controls",
  "description": "Export-safe packet for the fourth and final implement lane over the frozen M5 editor-inline component matrix. It carries resolved, honest projections of the AI message card and the evidence timeline across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved AI-message-card examples (naming the lifecycle state with one vocabulary and never as one generic completed message, the source context, the confidence / uncertainty class, the route / provider locality, the spend / cost posture, and the available safe actions) and the resolved evidence-timeline examples (naming a timestamp, the evidence kind, the tool / validation lineage, a related run / change / resource, an inspectable non-opaque structure, and open / replay / export actions that remain truthful under redaction). Hard invariants forbid an AI message state or source context being silently generic, an AI route or spend posture silently drifting, an evidence timeline being hidden in an opaque log, and evidence lineage or redaction truth silently drifting. Acceptance criteria — AI surfaces expose the same message and evidence vocabulary; users can inspect source context, approval state, and supporting evidence before trusting or applying; and timeline / export consumers preserve lineage and redaction truth — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-editor is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_ai_message_card_and_evidence_timeline_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "card_example": {
      "type": "object",
      "required": [
        "card_id",
        "message_label",
        "message_state",
        "state_stated",
        "needs_approval",
        "approval_state_disclosed",
        "confidence",
        "confidence_stated",
        "source_context",
        "source_needs_disclosure",
        "source_disclosed",
        "route_locality",
        "route_is_hosted",
        "route_distinction_explicit",
        "spend_posture",
        "spend_needs_disclosure",
        "spend_disclosed",
        "safe_actions_available",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "card_legible_at_a_glance"
      ],
      "properties": {
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "message_label": { "type": "string" },
        "message_state": { "$ref": "#/$defs/non_empty_string" },
        "state_stated": { "type": "boolean" },
        "needs_approval": { "type": "boolean" },
        "approval_state_disclosed": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/non_empty_string" },
        "confidence_stated": { "type": "boolean" },
        "source_context": { "$ref": "#/$defs/non_empty_string" },
        "source_needs_disclosure": { "type": "boolean" },
        "source_disclosed": { "type": "boolean" },
        "route_locality": { "$ref": "#/$defs/non_empty_string" },
        "route_is_hosted": { "type": "boolean" },
        "route_distinction_explicit": { "type": "boolean" },
        "spend_posture": { "$ref": "#/$defs/non_empty_string" },
        "spend_needs_disclosure": { "type": "boolean" },
        "spend_disclosed": { "type": "boolean" },
        "safe_actions_available": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "card_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "evidence_example": {
      "type": "object",
      "required": [
        "timeline_id",
        "entry_label",
        "has_timestamp",
        "evidence_kind",
        "lineage_class",
        "lineage_stated",
        "related_ref_present",
        "disclosure",
        "is_redacted_or_partial",
        "redaction_disclosed",
        "structured_not_opaque",
        "replay_export_actions_available",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "timeline_legible_at_a_glance"
      ],
      "properties": {
        "timeline_id": { "$ref": "#/$defs/non_empty_string" },
        "entry_label": { "type": "string" },
        "has_timestamp": { "type": "boolean" },
        "evidence_kind": { "$ref": "#/$defs/non_empty_string" },
        "lineage_class": { "$ref": "#/$defs/non_empty_string" },
        "lineage_stated": { "type": "boolean" },
        "related_ref_present": { "type": "boolean" },
        "disclosure": { "$ref": "#/$defs/non_empty_string" },
        "is_redacted_or_partial": { "type": "boolean" },
        "redaction_disclosed": { "type": "boolean" },
        "structured_not_opaque": { "type": "boolean" },
        "replay_export_actions_available": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "timeline_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "card_examples",
        "evidence_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "ai_message_state_or_source_context_silently_generic",
        "ai_route_or_spend_posture_silently_drifts",
        "evidence_timeline_hidden_in_opaque_log",
        "evidence_lineage_or_redaction_truth_silently_drifts"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card_example" }
        },
        "evidence_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "ai_message_state_or_source_context_silently_generic": { "const": false },
        "ai_route_or_spend_posture_silently_drifts": { "const": false },
        "evidence_timeline_hidden_in_opaque_log": { "const": false },
        "evidence_lineage_or_redaction_truth_silently_drifts": { "const": false }
      }
    }
  }
}
