{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-sql-run-bar.schema.json",
  "title": "Aureline M5 SQL run bar",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "bar_id", "editor_identity_ref", "selected_connection", "access_mode", "write_risk_state", "autocommit_state", "transaction_state", "selected_statement_count", "statement_safety_summary", "actions", "export_posture", "source_refs", "consumer_surfaces", "copy_export"],
  "properties": {
    "record_kind": { "const": "m5_sql_run_bar" },
    "schema_version": { "const": 1 },
    "bar_id": { "$ref": "#/$defs/id" },
    "editor_identity_ref": { "$ref": "#/$defs/ref" },
    "selected_connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_identity_ref", "target_identity_ref", "service_identity_ref", "engine_family", "execution_origin", "target_location_class", "current_database_ref", "current_schema_ref", "online_state", "policy_state"],
      "properties": {
        "connection_identity_ref": { "$ref": "#/$defs/ref" },
        "target_identity_ref": { "$ref": "#/$defs/ref" },
        "service_identity_ref": { "$ref": "#/$defs/ref" },
        "engine_family": { "type": "string", "enum": ["postgresql", "mysql", "sqlite", "duckdb", "snowflake", "bigquery", "mongodb", "browser_storage", "imported_snapshot", "unknown"] },
        "execution_origin": { "$ref": "#/$defs/origin" },
        "target_location_class": { "$ref": "#/$defs/target_location_class" },
        "current_database_ref": { "$ref": "#/$defs/ref" },
        "current_schema_ref": { "$ref": "#/$defs/ref" },
        "online_state": { "$ref": "#/$defs/online_state" },
        "policy_state": { "$ref": "#/$defs/policy_state" }
      }
    },
    "access_mode": { "$ref": "#/$defs/access_mode" },
    "write_risk_state": { "$ref": "#/$defs/write_risk_state" },
    "autocommit_state": { "$ref": "#/$defs/autocommit_state" },
    "transaction_state": { "$ref": "#/$defs/transaction_state" },
    "selected_statement_count": { "type": "integer", "minimum": 0 },
    "statement_safety_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety_class", "mutation_review_required", "protected_target_step_up_required", "object_impact_ref"],
      "properties": {
        "safety_class": { "$ref": "#/$defs/statement_safety_class" },
        "mutation_review_required": { "type": "boolean" },
        "protected_target_step_up_required": { "type": "boolean" },
        "object_impact_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_enabled", "cancel_enabled", "explain_enabled", "disabled_reason_ref", "action_labels"],
      "properties": {
        "run_enabled": { "type": "boolean" },
        "cancel_enabled": { "type": "boolean" },
        "explain_enabled": { "type": "boolean" },
        "disabled_reason_ref": { "type": ["string", "null"], "minLength": 1 },
        "action_labels": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["run", "cancel", "explain"] }
        }
      }
    },
    "export_posture": { "$ref": "#/$defs/export_posture" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "origin": { "type": "string", "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "imported_snapshot", "cli_headless"] },
    "target_location_class": { "type": "string", "enum": ["local", "tunneled", "container_local", "remote", "managed", "browser_runtime", "imported_snapshot", "unknown"] },
    "access_mode": { "type": "string", "enum": ["read_only", "write_capable", "inspect_only", "mutation_review_required", "policy_blocked", "unavailable"] },
    "write_risk_state": { "type": "string", "enum": ["read_only_no_write_risk", "write_capable_review_required", "write_capable_autocommit_risk", "policy_blocked", "unavailable"] },
    "autocommit_state": { "type": "string", "enum": ["autocommit_on", "autocommit_off", "not_executable", "unknown"] },
    "transaction_state": { "type": "string", "enum": ["none_open", "explicit_transaction_open", "savepoint_open", "will_open_transaction", "explain_only", "not_executable", "unknown_requires_review"] },
    "statement_safety_class": { "type": "string", "enum": ["read_only_query", "dml", "ddl", "session_affecting", "multi_statement", "ambiguous", "blocked"] },
    "online_state": { "type": "string", "enum": ["online", "offline", "reconnecting", "policy_blocked", "unknown"] },
    "policy_state": { "type": "string", "enum": ["allowed", "read_only_enforced", "mutation_review_required", "policy_limited", "policy_blocked", "unknown"] },
    "export_posture": { "type": "string", "enum": ["metadata_only", "redacted_typed", "visible_rows_only_typed", "full_result_typed", "blocked_pending_consent", "blocked_pending_policy", "blocked_redaction_class_too_high"] },
    "consumer_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["desktop_database_tool", "remote_workspace", "container_workspace", "managed_workspace", "notebook_handoff", "chart_handoff", "ai_context_handoff", "cli_headless", "support_export", "release_proof"] } },
    "copy_export": { "type": "object", "additionalProperties": false, "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "$ref": "#/$defs/ref" }, "json": { "$ref": "#/$defs/ref" }, "markdown": { "$ref": "#/$defs/ref" }, "screenshot_only_prohibited": { "const": true } } }
  }
}
