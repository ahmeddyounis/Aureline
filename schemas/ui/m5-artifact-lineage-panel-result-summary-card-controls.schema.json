{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-artifact-lineage-panel-result-summary-card-controls.schema.json",
  "title": "Aureline M5 artifact lineage panels and result summary cards",
  "description": "Export-safe packet implementing the reusable M5 artifact-lineage-panel and result-summary-card components in two co-equal control vectors. Each lineage panel names its artifact identity, artifact kind, producing run ID, generator step, environment/model fingerprint where relevant, saved scope, and lineage state, and offers first-class open-artifact/trace-to-run/export-lineage actions; its traceability class is derived from the lineage state, so a broken, diverged, or unknown-upstream artifact can never read as a fully-traced artifact and every artifact routes back to its producing run rather than reading as an anonymous attachment. Each summary card names its headline metrics, artifact count, freshness, support/report scope, include-raw toggle, provenance note, and explicit summary-versus-evidence-versus-raw handoff choice, and offers review/share-summary-only paths; its export disposition is derived from the export scope, so a raw payload is never included by default and the include-raw toggle stays an explicit, warned choice. Every next step names one stable run/notebook/dataset/docs deep link rather than an ephemeral overlay or hidden route. No component masks provenance or sensitivity state, hides the producing run or lineage state, exposes a raw payload by default, implies apples-to-apples without parity, or invents an alternate state label; panels and cards reuse Aureline's existing provenance, redaction, retention, and export-scope vocabulary, and raw artifact payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "lineage_panels",
    "summary_cards",
    "downgrade_triggers",
    "consumer_surfaces",
    "artifact_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_artifact_lineage_panels_and_result_summary_cards_with_producing_run_identity_stale_diverged_notes_include_raw_toggles_and_export_boundary_truth_across_claimed_m5_experiment_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "lineage_panels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact_lineage_panel" }
    },
    "summary_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result_summary_card" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "artifact_review": { "$ref": "#/$defs/artifact_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "artifact_kind_class": {
      "enum": [
        "model_checkpoint",
        "metrics_table",
        "plot_figure",
        "exported_report",
        "log_bundle",
        "unknown_artifact"
      ]
    },
    "lineage_state": {
      "enum": [
        "lineage_complete",
        "lineage_partial",
        "lineage_broken",
        "derived_upstream_known",
        "derived_upstream_unknown",
        "regenerated"
      ]
    },
    "traceability_class": {
      "enum": ["fully_traced", "regenerated", "partially_traced", "untraced"]
    },
    "summary_content_class": {
      "enum": [
        "headline_metric",
        "metric_table",
        "narrative_summary",
        "evidence_link",
        "raw_payload_ref",
        "no_result"
      ]
    },
    "summary_export_scope": {
      "enum": [
        "summary_scope",
        "metadata_scope",
        "evidence_scope",
        "raw_scope",
        "redacted_scope",
        "export_withheld"
      ]
    },
    "export_disposition": {
      "enum": ["metadata_safe", "evidence_scoped", "raw_included", "redacted", "withheld"]
    },
    "deep_link_kind": {
      "enum": [
        "run_object",
        "notebook_location",
        "dataset_catalog_anchor",
        "docs_anchor",
        "no_deep_link"
      ]
    },
    "lineage_panel_action": {
      "enum": [
        "open_artifact",
        "trace_to_run",
        "export_lineage",
        "open_deep_link",
        "compare_lineage",
        "copy_artifact_id"
      ]
    },
    "summary_card_action": {
      "enum": [
        "review_export_scope",
        "share_summary_only",
        "include_raw_payload",
        "export_evidence",
        "open_deep_link",
        "copy_summary_id"
      ]
    },
    "disposition": {
      "enum": [
        "local_run",
        "managed_run",
        "imported_run",
        "manual_attach",
        "reproducible",
        "likely_reproducible",
        "needs_rerun",
        "context_incomplete"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "run_origin_and_revision",
        "provenance_and_sensitivity",
        "export_scope"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook_surface",
        "experiment_run_dashboard",
        "run_comparison_view",
        "dataset_catalog",
        "share_review_sheet",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "notebook_ui",
        "experiment_dashboard_ui",
        "comparison_ui",
        "data_catalog_ui",
        "lineage_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_origin_unstated",
        "code_revision_unstated",
        "environment_fingerprint_unstated",
        "dataset_provenance_severed",
        "comparability_overstated",
        "sensitivity_class_unstated",
        "export_scope_unstated",
        "raw_payload_exposed_by_default",
        "cached_state_hidden",
        "imported_run_unmarked",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "artifact_lineage_panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "panel_id",
        "artifact_label",
        "artifact_kind",
        "lineage_state",
        "traceability_class",
        "claims_fully_traced",
        "producing_run_id",
        "producing_run_label",
        "generator_step_note",
        "environment_fingerprint_ref",
        "saved_scope_note",
        "partial_lineage_note",
        "stale_or_diverged_note",
        "unknown_upstream_note",
        "regenerated_note",
        "lineage_and_run_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "panel_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_producing_run_or_lineage_state",
        "exposes_raw_payload_by_default",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "artifact_lineage_panel" },
        "panel_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_label": { "$ref": "#/$defs/non_empty_string" },
        "artifact_kind": { "$ref": "#/$defs/artifact_kind_class" },
        "lineage_state": { "$ref": "#/$defs/lineage_state" },
        "traceability_class": { "$ref": "#/$defs/traceability_class" },
        "claims_fully_traced": { "type": "boolean" },
        "producing_run_id": { "$ref": "#/$defs/non_empty_string" },
        "producing_run_label": { "$ref": "#/$defs/non_empty_string" },
        "generator_step_note": { "$ref": "#/$defs/non_empty_string" },
        "environment_fingerprint_ref": { "$ref": "#/$defs/non_empty_string" },
        "saved_scope_note": { "$ref": "#/$defs/non_empty_string" },
        "partial_lineage_note": { "type": "string" },
        "stale_or_diverged_note": { "type": "string" },
        "unknown_upstream_note": { "type": "string" },
        "regenerated_note": { "type": "string" },
        "lineage_and_run_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "panel_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_artifact" } },
            { "contains": { "const": "trace_to_run" } },
            { "contains": { "const": "export_lineage" } }
          ],
          "items": { "$ref": "#/$defs/lineage_panel_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_producing_run_or_lineage_state": { "const": false },
        "exposes_raw_payload_by_default": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "result_summary_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "card_label",
        "summary_content_class",
        "export_scope_state",
        "export_disposition",
        "claims_includes_raw_payload",
        "claims_metadata_only",
        "include_raw_toggle_on",
        "headline_metric_note",
        "artifact_count_label",
        "freshness_note",
        "support_report_scope_note",
        "provenance_note",
        "raw_inclusion_warning",
        "withheld_note",
        "redaction_note",
        "summary_evidence_raw_handoff_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_producing_run_or_lineage_state",
        "exposes_raw_payload_by_default",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "result_summary_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "card_label": { "$ref": "#/$defs/non_empty_string" },
        "summary_content_class": { "$ref": "#/$defs/summary_content_class" },
        "export_scope_state": { "$ref": "#/$defs/summary_export_scope" },
        "export_disposition": { "$ref": "#/$defs/export_disposition" },
        "claims_includes_raw_payload": { "type": "boolean" },
        "claims_metadata_only": { "type": "boolean" },
        "include_raw_toggle_on": { "type": "boolean" },
        "headline_metric_note": { "$ref": "#/$defs/non_empty_string" },
        "artifact_count_label": { "$ref": "#/$defs/non_empty_string" },
        "freshness_note": { "$ref": "#/$defs/non_empty_string" },
        "support_report_scope_note": { "$ref": "#/$defs/non_empty_string" },
        "provenance_note": { "$ref": "#/$defs/non_empty_string" },
        "raw_inclusion_warning": { "type": "string" },
        "withheld_note": { "type": "string" },
        "redaction_note": { "type": "string" },
        "summary_evidence_raw_handoff_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "review_export_scope" } },
            { "contains": { "const": "share_summary_only" } }
          ],
          "items": { "$ref": "#/$defs/summary_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_producing_run_or_lineage_state": { "const": false },
        "exposes_raw_payload_by_default": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "artifact_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_panel_shows_artifact_and_producing_run",
        "lineage_panel_shows_lineage_state_and_generator_step",
        "lineage_panel_offers_open_trace_export",
        "summary_card_shows_headline_and_export_scope",
        "summary_card_offers_review_and_summary_only",
        "traceability_and_export_derived_never_asserted",
        "untraced_or_broken_never_shown_as_traced",
        "every_artifact_routes_to_producing_run",
        "raw_payload_never_included_by_default",
        "include_raw_is_explicit_choice_never_default",
        "summary_evidence_raw_scope_visible_before_share",
        "every_next_step_names_stable_deep_link",
        "reuses_existing_provenance_export_vocabulary",
        "provenance_and_sensitivity_state_visible",
        "cached_offline_local_only_state_visible",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_ui_reads_single_source",
        "result_summary_surface_reads_single_source",
        "producing_run_and_lineage_visible_before_trust",
        "export_scope_visible_before_share",
        "support_export_shows_component_truth",
        "help_docs_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
