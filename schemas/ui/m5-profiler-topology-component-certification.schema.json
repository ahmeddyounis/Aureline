{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-profiler-topology-component-certification.schema.json",
  "title": "M5 Profiler / Topology Component Certification Packet",
  "description": "Certifies that profile-session, flamegraph, trace, workset-scope, topology, ownership, and explainer component truth holds on every claimed M5 performance and codebase-understanding surface, keyed on the claimed consumer surface (M05-803). Each surface either passes the shared component packet (green) or auto-narrows its claim (yellow); truth-hiding surfaces (red) are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "certification_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_profiler_topology_component_certification" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "certification_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "profile_session_card",
        "flamegraph_view",
        "icicle_view",
        "call_tree_row",
        "heap_profile_compare_card",
        "trace_timeline",
        "workset_switcher_row",
        "topology_node_card",
        "ownership_card",
        "explainer_section_card"
      ]
    },
    "claimed_surface": {
      "type": "string",
      "enum": [
        "desktop_profiler_workspace",
        "hotspot_workspace",
        "trace_viewer",
        "heap_analysis",
        "profile_compare",
        "topology_map",
        "ownership_browser",
        "architecture_explainer",
        "search_results",
        "review_workspace",
        "onboarding_tour",
        "ai_context_panel",
        "incident_workspace",
        "docs_help",
        "cli_headless",
        "support_export",
        "release_proof"
      ]
    },
    "surface_domain": {
      "type": "string",
      "enum": ["performance", "codebase_understanding", "shared_evidence"]
    },
    "capture_execution_truth_state": {
      "type": "string",
      "enum": [
        "identity_certified",
        "disclosed_reduced_identity",
        "identity_hidden_or_imported_as_live",
        "not_applicable"
      ]
    },
    "compare_baseline_truth_state": {
      "type": "string",
      "enum": [
        "baseline_and_confounders_certified",
        "disclosed_deferred_comparison",
        "regression_claimed_before_baseline_truth",
        "not_applicable"
      ]
    },
    "workset_scope_truth_state": {
      "type": "string",
      "enum": [
        "scope_and_no_widening_certified",
        "disclosed_narrowed_scope",
        "silent_widening_or_hidden_scope",
        "not_applicable"
      ]
    },
    "graph_provenance_truth_state": {
      "type": "string",
      "enum": [
        "provenance_and_citations_certified",
        "disclosed_narrowed_to_available_evidence",
        "partial_graph_presented_as_full_truth",
        "not_applicable"
      ]
    },
    "claim_export_parity_state": {
      "type": "string",
      "enum": [
        "labels_and_summaries_certified",
        "disclosed_partial_export",
        "labels_dropped_or_screenshot_only"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "json": { "type": "string" },
        "markdown": { "type": "string" },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "severity", "capability_state", "visible_label"],
      "properties": {
        "banner_id": { "type": "string" },
        "severity": { "type": "string" },
        "capability_state": { "type": "string" },
        "visible_label": { "type": "string" },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } },
        "preserved_fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "support_export_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_id",
        "schema_ref",
        "raw_profile_samples_exported",
        "raw_trace_events_exported",
        "gui_cli_support_label_parity"
      ],
      "properties": {
        "join_id": { "type": "string" },
        "schema_ref": { "type": "string" },
        "joined_object_kinds": { "type": "array", "items": { "type": "string" } },
        "raw_profile_samples_exported": { "type": "boolean" },
        "raw_trace_events_exported": { "type": "boolean" },
        "gui_cli_support_label_parity": { "type": "boolean" }
      }
    },
    "auto_narrowing_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stale_or_missing_effect",
        "policy_blocked_effect",
        "degraded_state_reason_field",
        "release_help_claim_ceiling"
      ],
      "properties": {
        "narrow_on_missing_or_stale": { "type": "array", "items": { "type": "string" } },
        "stale_or_missing_effect": { "type": "string" },
        "policy_blocked_effect": { "type": "string" },
        "degraded_state_reason_field": { "type": "string" },
        "release_help_claim_ceiling": { "type": "string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "surface_domain",
        "consumed_families",
        "certification_bundle_ref",
        "references_canonical_families",
        "capture_execution_truth",
        "compare_baseline_truth",
        "workset_scope_truth",
        "graph_provenance_truth",
        "claim_export_parity",
        "claim_narrowed",
        "copy_export",
        "reduced_capability_banner",
        "support_export_join",
        "auto_narrowing_contract"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "m5_profiler_topology_component_certification_row" },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/claimed_surface" },
        "surface_domain": { "$ref": "#/$defs/surface_domain" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "certification_bundle_ref": { "type": "string", "minLength": 1 },
        "references_canonical_families": { "type": "boolean" },
        "capture_execution_truth": { "$ref": "#/$defs/capture_execution_truth_state" },
        "compare_baseline_truth": { "$ref": "#/$defs/compare_baseline_truth_state" },
        "workset_scope_truth": { "$ref": "#/$defs/workset_scope_truth_state" },
        "graph_provenance_truth": { "$ref": "#/$defs/graph_provenance_truth_state" },
        "claim_export_parity": { "$ref": "#/$defs/claim_export_parity_state" },
        "claim_narrowed": { "type": "boolean" },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "support_export_join": { "$ref": "#/$defs/support_export_join" },
        "auto_narrowing_contract": { "$ref": "#/$defs/auto_narrowing_contract" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_count",
        "performance_surface_count",
        "codebase_understanding_surface_count",
        "shared_evidence_surface_count",
        "consumed_family_count",
        "family_coverage_complete",
        "all_surfaces_certify_or_narrow",
        "all_reference_one_bundle",
        "green_count",
        "yellow_count",
        "red_count"
      ],
      "properties": {
        "surface_count": { "type": "integer" },
        "performance_surface_count": { "type": "integer" },
        "codebase_understanding_surface_count": { "type": "integer" },
        "shared_evidence_surface_count": { "type": "integer" },
        "consumed_family_count": { "type": "integer" },
        "family_coverage_complete": { "type": "boolean" },
        "all_surfaces_certify_or_narrow": { "type": "boolean" },
        "all_reference_one_bundle": { "type": "boolean" },
        "green_count": { "type": "integer" },
        "yellow_count": { "type": "integer" },
        "red_count": { "type": "integer" }
      }
    }
  }
}
