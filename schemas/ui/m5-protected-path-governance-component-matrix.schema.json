{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-protected-path-governance-component-matrix.schema.json",
  "title": "Aureline M5 protected-path governance component matrix",
  "description": "Export-safe packet freezing the M5 component truth for eight reusable governed review, release, and shiproom surfaces: protected-path rows, ownership cards, approver matrices, review-pack summaries, public-surface diff cards, merge-control banners, DRI-registry rows, and merge-readiness strips. Each component row binds a maturity class to the exact advisory-versus-authoritative and provider-authoritative-versus-local-estimate enforcement distinction, the frozen governance-state vocabulary, escalation boundary, and backup-coverage fallback it must preserve, plus evidence requirements, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. Raw CODEOWNERS bodies, raw diff bodies, raw provider payloads, credentials, and live provider responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_protected_path_governance_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "component": {
      "type": "string",
      "enum": [
        "protected_path_row",
        "ownership_card",
        "approver_matrix",
        "review_pack_summary",
        "public_surface_diff_card",
        "merge_control_banner",
        "dri_registry_row",
        "merge_readiness_strip"
      ]
    },
    "maturity_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "optional",
        "not_applicable"
      ]
    },
    "governance_state_vocab": {
      "type": "string",
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "owner_coverage_backup_missing",
        "approver_state_expired",
        "review_pack_stale",
        "public_surface_diff_unavailable",
        "migration_evidence_missing",
        "dri_coverage_gap",
        "escalation_handoff_unavailable",
        "trust_narrowing",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "provider_mutation_attributable",
        "local_continue_preserved",
        "return_path_preserved",
        "evidence_preserved_no_revert",
        "not_applicable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_workspace",
        "release_candidate",
        "shiproom",
        "governance_dashboard",
        "owner_coverage_panel",
        "cli_headless",
        "support_export",
        "diagnostics",
        "help_about"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "maturity",
        "scope_summary",
        "enforcement_distinction",
        "governance_state_vocab",
        "escalation_boundary",
        "backup_coverage_fallback",
        "evidence_requirement",
        "required_evidence_packet_refs",
        "downgrade_triggers",
        "rollback_posture",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/component"
        },
        "maturity": {
          "$ref": "#/$defs/maturity_class"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "enforcement_distinction": {
          "$ref": "#/$defs/non_empty_string"
        },
        "governance_state_vocab": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/governance_state_vocab"
          }
        },
        "escalation_boundary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backup_coverage_fallback": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_requirement": {
          "$ref": "#/$defs/evidence_requirement"
        },
        "required_evidence_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_never_masquerades_as_authoritative",
        "provider_authoritative_versus_local_estimate_distinct",
        "owner_coverage_backup_missing_explicit",
        "approver_expired_waived_stale_explicit",
        "review_pack_freshness_and_parity_explicit",
        "public_surface_diff_machine_generated_required",
        "migration_evidence_required_for_public_surface_change",
        "protection_reason_always_explicit",
        "dri_coverage_gap_explicit",
        "merge_control_blocker_never_generic",
        "escalation_handoff_explicit",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "advisory_never_masquerades_as_authoritative": {
          "type": "boolean",
          "const": true
        },
        "provider_authoritative_versus_local_estimate_distinct": {
          "type": "boolean",
          "const": true
        },
        "owner_coverage_backup_missing_explicit": {
          "type": "boolean",
          "const": true
        },
        "approver_expired_waived_stale_explicit": {
          "type": "boolean",
          "const": true
        },
        "review_pack_freshness_and_parity_explicit": {
          "type": "boolean",
          "const": true
        },
        "public_surface_diff_machine_generated_required": {
          "type": "boolean",
          "const": true
        },
        "migration_evidence_required_for_public_surface_change": {
          "type": "boolean",
          "const": true
        },
        "protection_reason_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "dri_coverage_gap_explicit": {
          "type": "boolean",
          "const": true
        },
        "merge_control_blocker_never_generic": {
          "type": "boolean",
          "const": true
        },
        "escalation_handoff_explicit": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_path_row_shows_reason_and_enforcement_authority",
        "ownership_card_shows_owner_source_and_coverage",
        "approver_matrix_shows_required_and_state",
        "review_pack_summary_shows_freshness_and_parity",
        "public_surface_diff_card_shows_change_class_and_diff",
        "merge_control_banner_shows_blockers_not_generic",
        "dri_registry_row_shows_dri_and_coverage",
        "merge_readiness_strip_shows_blocking_and_ownership",
        "cli_headless_shows_component_truth",
        "support_export_shows_component_truth"
      ],
      "properties": {
        "protected_path_row_shows_reason_and_enforcement_authority": {
          "type": "boolean",
          "const": true
        },
        "ownership_card_shows_owner_source_and_coverage": {
          "type": "boolean",
          "const": true
        },
        "approver_matrix_shows_required_and_state": {
          "type": "boolean",
          "const": true
        },
        "review_pack_summary_shows_freshness_and_parity": {
          "type": "boolean",
          "const": true
        },
        "public_surface_diff_card_shows_change_class_and_diff": {
          "type": "boolean",
          "const": true
        },
        "merge_control_banner_shows_blockers_not_generic": {
          "type": "boolean",
          "const": true
        },
        "dri_registry_row_shows_dri_and_coverage": {
          "type": "boolean",
          "const": true
        },
        "merge_readiness_strip_shows_blocking_and_ownership": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_component_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_component_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
