{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-ci-status-card-session-follow-tile-controls.schema.json",
  "title": "Aureline M5 CI-status cards and session-follow tiles",
  "description": "Export-safe packet implementing the reusable M5 ci-status-card and session-follow-tile components in two co-equal control vectors. Each CI-status card names its provider/source class, its stable run and commit identity, the object it references, its exact object landing reference, its repo/workspace client scope, and its failure count; its result class is derived from the frozen CI status, so a stale CI status can never read as a live pass or fail. It always offers a keyboard-complete Open verb; any rerun or widening verb names one exact desktop-handoff target rather than a generic activity page, and never implies a desktop-only rerun is companion-safe. Each session-follow tile names its presenter and session identity, the object it references, its exact object landing reference, its scope, and its freshness; its joinability class is derived from the frozen session-follow state, so a diverged, stale, host-inactive, or ended session degrades to an explicit read-only or not-joinable state instead of an ambiguous empty card, and never offers an ambiguous join into an expired or narrowed session. No control invents an alternate state label, implies a desktop-required action is companion-safe, or routes to a generic activity page; raw log bodies, build output, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "ci_status_cards",
    "session_follow_tiles",
    "downgrade_triggers",
    "consumer_surfaces",
    "glance_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "ci_status_card_session_follow_tile_controls" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "ci_status_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ci_status_card" }
    },
    "session_follow_tiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/session_follow_tile" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "glance_review": { "$ref": "#/$defs/glance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "object_kind": {
      "type": "string",
      "enum": [
        "notification_event",
        "review_item",
        "ci_run",
        "followed_session",
        "incident_record",
        "handoff_intent"
      ]
    },
    "client_scope": {
      "type": "string",
      "enum": [
        "workspace_scoped",
        "repo_scoped",
        "org_scoped",
        "device_scoped",
        "account_global",
        "unscoped"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "live",
        "cached",
        "stale",
        "offline_held",
        "expired_snapshot",
        "unknown_freshness"
      ]
    },
    "ci_status": {
      "type": "string",
      "enum": ["passed", "failed", "running", "queued", "canceled", "stale"]
    },
    "session_follow_state": {
      "type": "string",
      "enum": [
        "live_following",
        "paused_follow",
        "diverged_from_host",
        "host_inactive",
        "read_only_mirror",
        "follow_ended"
      ]
    },
    "handoff_target": {
      "type": "string",
      "enum": [
        "file_location",
        "review_panel",
        "ci_pipeline_run",
        "incident_workspace",
        "agent_session",
        "no_handoff"
      ]
    },
    "degraded_reason": {
      "type": "string",
      "enum": [
        "relay_unavailable",
        "proof_stale",
        "host_session_inactive",
        "trust_narrowed",
        "upstream_matrix_narrowed",
        "handoff_target_unresolved"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "scope_and_freshness",
        "capability_boundary",
        "severity_and_handoff_target"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "browser_companion",
        "mobile_companion",
        "desktop_panel",
        "diagnostics",
        "support_export",
        "help_about"
      ]
    },
    "deployment_line": {
      "type": "string",
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "notification_triage_ui",
        "review_queue_ui",
        "ci_status_ui",
        "session_follow_ui",
        "incident_awareness_ui",
        "desktop_handoff_ui",
        "support_export",
        "status_bar_ui",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "object_identity_unstated",
        "client_scope_unstated",
        "freshness_hidden",
        "capability_boundary_unstated",
        "severity_unstated",
        "handoff_target_unresolved",
        "disposition_unstated",
        "alternate_state_label_invented",
        "generic_companion_wording_used",
        "stale_shown_as_live",
        "desktop_required_action_offered_inline",
        "proof_stale"
      ]
    },
    "provider_class": {
      "type": "string",
      "enum": [
        "local_core",
        "hosted_provider",
        "self_hosted_runner",
        "mirrored_snapshot",
        "aggregated_source",
        "unknown_source"
      ]
    },
    "result_class": {
      "type": "string",
      "enum": ["green", "red", "in_flight", "canceled", "stale_unknown"]
    },
    "ci_status_verb": {
      "type": "string",
      "enum": ["open", "follow", "open_logs", "rerun", "handoff_to_desktop", "dismiss"]
    },
    "joinability": {
      "type": "string",
      "enum": ["live_joinable", "paused_resumable", "stale_read_only", "not_joinable"]
    },
    "session_follow_verb": {
      "type": "string",
      "enum": [
        "open",
        "follow",
        "pause_follow",
        "resume_follow",
        "handoff_to_desktop",
        "leave_follow"
      ]
    },
    "degraded_reason_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/degraded_reason" }
    },
    "required_label_array": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/required_label" },
      "allOf": [
        { "contains": { "const": "identity" } },
        { "contains": { "const": "state" } },
        { "contains": { "const": "keyboard_route" } }
      ]
    },
    "accessibility_route_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_route" },
      "contains": { "const": "keyboard_focusable" }
    },
    "ci_status_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "pipeline_label",
        "object_kind",
        "object_label",
        "object_landing_ref",
        "run_ref",
        "commit_ref",
        "client_scope",
        "scope_label",
        "provider_class",
        "provider_label",
        "ci_status",
        "result_class",
        "claims_live_result",
        "failure_count",
        "freshness",
        "stale_note",
        "in_flight_note",
        "scope_and_freshness_note",
        "handoff_target",
        "handoff_label",
        "status_verbs",
        "degraded_reasons",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_scope_or_freshness",
        "hides_capability_boundary",
        "invents_alternate_state_label",
        "implies_desktop_action_is_companion_safe",
        "routes_to_generic_activity_page"
      ],
      "properties": {
        "component": { "const": "ci_status_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "pipeline_label": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "object_label": { "$ref": "#/$defs/non_empty_string" },
        "object_landing_ref": { "$ref": "#/$defs/non_empty_string" },
        "run_ref": { "$ref": "#/$defs/non_empty_string" },
        "commit_ref": { "$ref": "#/$defs/non_empty_string" },
        "client_scope": { "$ref": "#/$defs/client_scope" },
        "scope_label": { "$ref": "#/$defs/non_empty_string" },
        "provider_class": { "$ref": "#/$defs/provider_class" },
        "provider_label": { "$ref": "#/$defs/non_empty_string" },
        "ci_status": { "$ref": "#/$defs/ci_status" },
        "result_class": { "$ref": "#/$defs/result_class" },
        "claims_live_result": { "type": "boolean" },
        "failure_count": { "type": "integer", "minimum": 0 },
        "freshness": { "$ref": "#/$defs/freshness" },
        "stale_note": { "type": "string" },
        "in_flight_note": { "type": "string" },
        "scope_and_freshness_note": { "$ref": "#/$defs/non_empty_string" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_label": { "$ref": "#/$defs/non_empty_string" },
        "status_verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ci_status_verb" },
          "contains": { "const": "open" }
        },
        "degraded_reasons": { "$ref": "#/$defs/degraded_reason_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_scope_or_freshness": { "const": false },
        "hides_capability_boundary": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "implies_desktop_action_is_companion_safe": { "const": false },
        "routes_to_generic_activity_page": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result_class": { "const": "stale_unknown" } },
            "required": ["result_class"]
          },
          "then": {
            "properties": { "stale_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "result_class": { "const": "in_flight" } },
            "required": ["result_class"]
          },
          "then": {
            "properties": { "in_flight_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "result_class": { "const": "green" } },
            "required": ["result_class"]
          },
          "then": {
            "properties": { "failure_count": { "const": 0 } },
            "required": ["failure_count"]
          }
        },
        {
          "if": {
            "properties": { "result_class": { "const": "red" } },
            "required": ["result_class"]
          },
          "then": {
            "properties": { "failure_count": { "type": "integer", "minimum": 1 } },
            "required": ["failure_count"]
          }
        },
        {
          "if": {
            "properties": { "result_class": { "const": "stale_unknown" } },
            "required": ["result_class"]
          },
          "then": {
            "properties": { "claims_live_result": { "const": false } },
            "required": ["claims_live_result"]
          },
          "else": {
            "properties": { "claims_live_result": { "const": true } },
            "required": ["claims_live_result"]
          }
        },
        {
          "if": {
            "properties": { "handoff_target": { "const": "no_handoff" } },
            "required": ["handoff_target"]
          },
          "then": {
            "properties": {
              "status_verbs": {
                "not": {
                  "anyOf": [
                    { "contains": { "const": "handoff_to_desktop" } },
                    { "contains": { "const": "rerun" } }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "session_follow_tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "tile_id",
        "session_label",
        "object_kind",
        "object_label",
        "object_landing_ref",
        "presenter_ref",
        "session_ref",
        "client_scope",
        "scope_label",
        "follow_state",
        "joinability",
        "claims_live_session",
        "claims_joinable",
        "freshness",
        "joinability_note",
        "stale_note",
        "not_joinable_note",
        "scope_and_freshness_note",
        "handoff_target",
        "handoff_label",
        "follow_verbs",
        "degraded_reasons",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_scope_or_freshness",
        "hides_capability_boundary",
        "invents_alternate_state_label",
        "implies_desktop_action_is_companion_safe",
        "routes_to_generic_activity_page"
      ],
      "properties": {
        "component": { "const": "session_follow_tile" },
        "tile_id": { "$ref": "#/$defs/non_empty_string" },
        "session_label": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "object_label": { "$ref": "#/$defs/non_empty_string" },
        "object_landing_ref": { "$ref": "#/$defs/non_empty_string" },
        "presenter_ref": { "$ref": "#/$defs/non_empty_string" },
        "session_ref": { "$ref": "#/$defs/non_empty_string" },
        "client_scope": { "$ref": "#/$defs/client_scope" },
        "scope_label": { "$ref": "#/$defs/non_empty_string" },
        "follow_state": { "$ref": "#/$defs/session_follow_state" },
        "joinability": { "$ref": "#/$defs/joinability" },
        "claims_live_session": { "type": "boolean" },
        "claims_joinable": { "type": "boolean" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "joinability_note": { "$ref": "#/$defs/non_empty_string" },
        "stale_note": { "type": "string" },
        "not_joinable_note": { "type": "string" },
        "scope_and_freshness_note": { "$ref": "#/$defs/non_empty_string" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_label": { "$ref": "#/$defs/non_empty_string" },
        "follow_verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/session_follow_verb" },
          "contains": { "const": "open" }
        },
        "degraded_reasons": { "$ref": "#/$defs/degraded_reason_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_scope_or_freshness": { "const": false },
        "hides_capability_boundary": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "implies_desktop_action_is_companion_safe": { "const": false },
        "routes_to_generic_activity_page": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "joinability": { "const": "stale_read_only" } },
            "required": ["joinability"]
          },
          "then": {
            "properties": { "stale_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "joinability": { "const": "not_joinable" } },
            "required": ["joinability"]
          },
          "then": {
            "properties": { "not_joinable_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "joinability": { "const": "live_joinable" } },
            "required": ["joinability"]
          },
          "then": {
            "properties": { "claims_live_session": { "const": true } },
            "required": ["claims_live_session"]
          },
          "else": {
            "properties": { "claims_live_session": { "const": false } },
            "required": ["claims_live_session"]
          }
        },
        {
          "if": {
            "properties": {
              "joinability": { "enum": ["live_joinable", "paused_resumable"] }
            },
            "required": ["joinability"]
          },
          "then": {
            "properties": { "claims_joinable": { "const": true } },
            "required": ["claims_joinable"]
          },
          "else": {
            "properties": {
              "claims_joinable": { "const": false },
              "follow_verbs": {
                "not": {
                  "anyOf": [
                    { "contains": { "const": "follow" } },
                    { "contains": { "const": "resume_follow" } }
                  ]
                }
              }
            },
            "required": ["claims_joinable"]
          }
        }
      ]
    },
    "glance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci_card_shows_run_and_commit_identity",
        "ci_card_shows_provider_source",
        "ci_card_shows_failure_count",
        "session_tile_shows_presenter_and_session_identity",
        "session_tile_states_joinability",
        "session_tile_degrades_to_explicit_state",
        "object_identity_always_explicit",
        "client_scope_always_explicit",
        "freshness_always_explicit",
        "result_and_joinability_derived_never_asserted",
        "stale_never_shown_as_live",
        "every_verb_traces_to_one_object",
        "every_handoff_names_exact_target",
        "desktop_only_action_never_implied_companion_safe",
        "no_surface_invents_alternate_state_label",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "ci_card_shows_run_and_commit_identity": { "const": true },
        "ci_card_shows_provider_source": { "const": true },
        "ci_card_shows_failure_count": { "const": true },
        "session_tile_shows_presenter_and_session_identity": { "const": true },
        "session_tile_states_joinability": { "const": true },
        "session_tile_degrades_to_explicit_state": { "const": true },
        "object_identity_always_explicit": { "const": true },
        "client_scope_always_explicit": { "const": true },
        "freshness_always_explicit": { "const": true },
        "result_and_joinability_derived_never_asserted": { "const": true },
        "stale_never_shown_as_live": { "const": true },
        "every_verb_traces_to_one_object": { "const": true },
        "every_handoff_names_exact_target": { "const": true },
        "desktop_only_action_never_implied_companion_safe": { "const": true },
        "no_surface_invents_alternate_state_label": { "const": true },
        "controls_stable_across_deployment_lines": { "const": true },
        "copy_and_export_safe": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci_status_ui_reads_single_source",
        "session_follow_ui_reads_single_source",
        "first_glance_names_object_scope_and_freshness",
        "rerun_and_join_posture_visible_before_tap",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "ci_status_ui_reads_single_source": { "const": true },
        "session_follow_ui_reads_single_source": { "const": true },
        "first_glance_names_object_scope_and_freshness": { "const": true },
        "rerun_and_join_posture_visible_before_tap": { "const": true },
        "support_export_shows_control_truth": { "const": true },
        "help_about_shows_control_truth": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
