{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-starter-boundary-state-controls.schema.json",
  "title": "Aureline M5 starter boundary states",
  "description": "Export-safe packet implementing the cross-cutting starter boundary state any of the six frozen M5 scaffold / project-entry components can carry when a scaffold's source, availability, trust, or durability is not the plain public-registry default. Each boundary state names its boundary kind (public_registry, mirror_only, offline_cache_only, sign_in_required, remote_or_managed_workspace, or non_durable_temp_staging), its availability state, its owner and freshness cues, the trust and install steps it discloses before they run, and a delete-generated/reuse-existing/clone-elsewhere/continue-without-starter recovery route. Its access posture is derived from the frozen boundary kind and its availability posture from the frozen availability state, so a sign-in-gated, managed-remote, or non-durable starter can never read as a plain public-registry create and an unavailable or blocked starter can never read as ready. Every next step names one stable manifest/registry/docs/policy deep link rather than an ephemeral overlay or hidden route. No boundary state hides its source or owner, hides a mirror/offline/managed/remote/non-durable dependency, performs a trust or install step silently, omits a recovery or continue-without-starter path, or invents an alternate state label; raw file bodies, raw secret values, pasted local paths, repository URLs, credentials, and secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "boundary_states",
    "downgrade_triggers",
    "consumer_surfaces",
    "boundary_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "ship_mirror_offline_auth_boundary_and_managed_zone_starter_states_with_no_silent_trust_no_silent_install_and_non_durable_temp_staging_honesty_across_claimed_m5_scaffold_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "boundary_states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/starter_boundary_state" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "boundary_review": { "$ref": "#/$defs/boundary_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "boundary_kind": {
      "enum": [
        "public_registry",
        "mirror_only",
        "offline_cache_only",
        "sign_in_required",
        "remote_or_managed_workspace",
        "non_durable_temp_staging"
      ]
    },
    "availability_state": {
      "enum": [
        "available",
        "mirror_reachable_only",
        "cache_only_offline",
        "sign_in_pending",
        "provisioning_pending",
        "unavailable"
      ]
    },
    "owner_class": {
      "enum": [
        "first_party_registry",
        "team_mirror",
        "local_cache",
        "managed_service",
        "unknown_owner"
      ]
    },
    "freshness_state": {
      "enum": ["live", "mirror_synced", "cache_stale", "ephemeral", "freshness_unknown"]
    },
    "starter_source_class": {
      "enum": [
        "first_party_starter",
        "team_managed_starter",
        "community_starter",
        "local_only_starter",
        "mirrored_starter",
        "unknown_source_starter"
      ]
    },
    "access_posture": {
      "enum": [
        "direct_public_access",
        "mirror_mediated",
        "offline_cache_backed",
        "auth_gated",
        "managed_remote",
        "non_durable_staging"
      ]
    },
    "availability_posture": {
      "enum": [
        "reachable_now",
        "reachable_via_mirror",
        "reachable_from_cache",
        "blocked_pending_sign_in",
        "blocked_pending_provisioning",
        "not_reachable"
      ]
    },
    "recovery_verb": {
      "enum": [
        "delete_generated",
        "reuse_existing",
        "clone_elsewhere",
        "continue_without_starter",
        "retry_when_available"
      ]
    },
    "state_action": {
      "enum": [
        "review_source_and_owner",
        "review_availability_and_freshness",
        "review_trust_and_install_steps",
        "proceed_with_disclosure",
        "choose_recovery",
        "open_deep_link"
      ]
    },
    "deep_link_kind": {
      "enum": [
        "template_manifest",
        "starter_registry_entry",
        "docs_anchor",
        "policy_reference",
        "no_deep_link"
      ]
    },
    "component_family": {
      "enum": [
        "scaffold_template_card",
        "starter_parameter_row",
        "scaffold_preflight_card",
        "template_health_row",
        "generated_project_diff_card",
        "scaffold_handoff_banner"
      ]
    },
    "disposition": {
      "enum": [
        "first_party",
        "team_managed",
        "community",
        "local_only",
        "create_empty",
        "continue_without_starter",
        "blocked",
        "warning",
        "optional"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "starter_source_and_support",
        "side_effect_disclosure",
        "recovery_and_ownership_boundary"
      ]
    },
    "surface_family": {
      "enum": [
        "start_center",
        "template_gallery",
        "scaffold_preflight",
        "generation_diff_review",
        "workspace_handoff",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "start_center_ui",
        "template_gallery_ui",
        "parameter_form_ui",
        "preflight_ui",
        "diff_review_ui",
        "workspace_ui",
        "health_dashboard_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "starter_source_unstated",
        "support_class_unstated",
        "side_effect_undisclosed",
        "host_boundary_unstated",
        "parameter_source_unstated",
        "action_timing_unstated",
        "impact_undisclosed",
        "health_freshness_stale",
        "generated_boundary_blurred",
        "recovery_path_omitted",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "starter_boundary_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "state_name",
        "boundary_kind",
        "availability_state",
        "owner_class",
        "freshness_state",
        "source_class",
        "source_label",
        "owner_label",
        "availability_note",
        "freshness_note",
        "derived_access_posture",
        "derived_availability_posture",
        "claims_requires_sign_in",
        "claims_requires_managed_provisioning",
        "claims_is_non_durable",
        "claims_depends_on_mirror_or_cache",
        "claims_reachable",
        "sign_in_note",
        "managed_note",
        "non_durable_note",
        "mirror_or_cache_note",
        "unavailable_note",
        "trust_disclosure_note",
        "install_disclosure_note",
        "recovery_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "state_actions",
        "recovery_verbs",
        "applies_to_components",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_starter_source_or_owner",
        "hides_mirror_offline_or_managed_dependency",
        "performs_silent_trust_or_install",
        "omits_recovery_or_continue_without_starter_path",
        "invents_alternate_state_label"
      ],
      "properties": {
        "state_id": { "$ref": "#/$defs/non_empty_string" },
        "state_name": { "$ref": "#/$defs/non_empty_string" },
        "boundary_kind": { "$ref": "#/$defs/boundary_kind" },
        "availability_state": { "$ref": "#/$defs/availability_state" },
        "owner_class": { "$ref": "#/$defs/owner_class" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "source_class": { "$ref": "#/$defs/starter_source_class" },
        "source_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_label": { "$ref": "#/$defs/non_empty_string" },
        "availability_note": { "$ref": "#/$defs/non_empty_string" },
        "freshness_note": { "$ref": "#/$defs/non_empty_string" },
        "derived_access_posture": { "$ref": "#/$defs/access_posture" },
        "derived_availability_posture": { "$ref": "#/$defs/availability_posture" },
        "claims_requires_sign_in": { "type": "boolean" },
        "claims_requires_managed_provisioning": { "type": "boolean" },
        "claims_is_non_durable": { "type": "boolean" },
        "claims_depends_on_mirror_or_cache": { "type": "boolean" },
        "claims_reachable": { "type": "boolean" },
        "sign_in_note": { "type": "string" },
        "managed_note": { "type": "string" },
        "non_durable_note": { "type": "string" },
        "mirror_or_cache_note": { "type": "string" },
        "unavailable_note": { "type": "string" },
        "trust_disclosure_note": { "$ref": "#/$defs/non_empty_string" },
        "install_disclosure_note": { "$ref": "#/$defs/non_empty_string" },
        "recovery_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "state_actions": {
          "type": "array",
          "minItems": 3,
          "allOf": [
            { "contains": { "const": "review_source_and_owner" } },
            { "contains": { "const": "review_availability_and_freshness" } },
            { "contains": { "const": "review_trust_and_install_steps" } }
          ],
          "items": { "$ref": "#/$defs/state_action" }
        },
        "recovery_verbs": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "continue_without_starter" },
          "anyOf": [
            { "contains": { "const": "delete_generated" } },
            { "contains": { "const": "reuse_existing" } },
            { "contains": { "const": "clone_elsewhere" } },
            { "contains": { "const": "continue_without_starter" } }
          ],
          "items": { "$ref": "#/$defs/recovery_verb" }
        },
        "applies_to_components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_starter_source_or_owner": { "const": false },
        "hides_mirror_offline_or_managed_dependency": { "const": false },
        "performs_silent_trust_or_install": { "const": false },
        "omits_recovery_or_continue_without_starter_path": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "boundary_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_names_source_and_owner",
        "state_names_mirror_offline_managed_or_staging_dependency",
        "state_names_availability_and_freshness",
        "trust_step_disclosed_before_prompt",
        "install_step_disclosed_before_run",
        "access_and_availability_posture_derived_never_asserted",
        "unavailable_or_blocked_never_shown_as_ready",
        "non_durable_staging_never_shown_as_durable",
        "managed_or_remote_dependency_never_hidden",
        "recovery_verbs_preserve_delete_reuse_clone_continue",
        "continue_without_starter_always_available",
        "no_surface_invents_alternate_state_label",
        "states_stable_across_deployment_lines",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_center_reads_single_source",
        "template_gallery_reads_single_source",
        "preflight_reads_single_source",
        "boundary_visible_before_trust_or_install",
        "recovery_path_visible_on_failure",
        "support_export_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
