{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-intake-escalation-component-consumer.schema.json",
  "title": "Aureline M5 support-intake / escalation component consumers",
  "description": "Export-safe packet for the adoption lane over the frozen M5 support-intake / escalation component matrix. It binds one row per claimed M5 support consumer — Project Doctor results, the safe-mode recovery flow, the extension-bisect recovery flow, the support center, Help / docs, and the CLI / headless export desk — to the five canonical component families (support-scenario picker row, issue-report builder step, escalation-packet summary, handoff-timeline row, unsafe-fix blocked note), the one shared descriptor vocabulary (scenario code / packet id / redaction class / approved repair), the parity-health modes, export caveats, claim-parity states, narrowing reasons, recovery actions, export fields, and non-visual accessibility routes. Each consumer points at the primitive's canonical schema and artifact rather than re-wording scenario, packet, redaction, or repair facts in local prose. A weakened parity-health mode (uncertain scenario classification, incomplete evidence classes, an unavailable packet destination, or pending redaction review) auto-narrows the claim and always discloses a self-contained banner naming the exact reason and recovery action. Raw crash bodies, raw paths, credentials, and external endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_doctor_safe_mode_bisect_support_center_docs_help_and_export_consumers_so_support_intake_components_keep_scenario_code_repair_lineage_and_redaction_parity_across_claimed_m5_profiles"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "support_case_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "support_case_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "doctor_results",
        "safe_mode",
        "bisect",
        "support_center",
        "docs_help",
        "support_export"
      ]
    },
    "component_family": {
      "enum": [
        "support_scenario_picker_row",
        "issue_report_builder_step",
        "escalation_packet_summary",
        "handoff_timeline_row",
        "unsafe_fix_blocked_note"
      ]
    },
    "descriptor": {
      "enum": ["scenario_code", "packet_id", "redaction_class", "approved_repair"]
    },
    "parity_health": {
      "enum": [
        "full_parity",
        "scenario_uncertain_narrowed",
        "evidence_incomplete_narrowed",
        "destination_unavailable_narrowed",
        "redaction_pending_narrowed"
      ]
    },
    "claim_parity_state": {
      "enum": ["claims_preserved", "claims_auto_narrowed"]
    },
    "narrowing_reason": {
      "enum": [
        "scenario_classification_uncertain",
        "evidence_classes_incomplete",
        "packet_destination_unavailable",
        "redaction_review_required"
      ]
    },
    "recovery_action": {
      "enum": [
        "classify_scenario_before_escalating",
        "complete_evidence_selection_first",
        "choose_available_destination_or_export_locally",
        "complete_redaction_review_first"
      ]
    },
    "export_caveat": {
      "enum": [
        "scenario_uncertain_local_only",
        "evidence_incomplete_not_full_report",
        "destination_unavailable_local_bundle_only",
        "redaction_pending_not_shareable"
      ]
    },
    "resolved_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "canonical_schema_ref",
        "descriptor_families",
        "parity_health",
        "export_caveats",
        "claim_parity_state",
        "is_narrowed",
        "auto_narrow_banner"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health": { "$ref": "#/$defs/parity_health" },
        "export_caveats": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_state": { "$ref": "#/$defs/claim_parity_state" },
        "is_narrowed": { "type": "boolean" },
        "auto_narrow_banner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "recovery_action",
                "consumer",
                "component_family",
                "preserved_descriptors",
                "export_caveats",
                "headline"
              ],
              "properties": {
                "reason": { "$ref": "#/$defs/narrowing_reason" },
                "recovery_action": { "$ref": "#/$defs/recovery_action" },
                "consumer": { "$ref": "#/$defs/consumer" },
                "component_family": { "$ref": "#/$defs/component_family" },
                "preserved_descriptors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/descriptor" }
                },
                "export_caveats": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/export_caveat" }
                },
                "headline": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "$ref": "#/$defs/resolved_binding" }
      }
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "const": true },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "parity_health_modes",
        "export_caveats",
        "claim_parity_states",
        "narrowing_reasons",
        "recovery_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewords_claims_per_surface",
        "invents_new_escalation_grammar",
        "drops_scenario_packet_redaction_or_repair_when_narrowed",
        "inherits_stronger_label_from_healthier_profile"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parity_health" }
        },
        "export_caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim_parity_state" }
        },
        "narrowing_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recovery_action" }
        },
        "export_fields": { "type": "array", "minItems": 5 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_binding" }
        },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rewords_claims_per_surface": { "const": false },
        "invents_new_escalation_grammar": { "const": false },
        "drops_scenario_packet_redaction_or_repair_when_narrowed": { "const": false },
        "inherits_stronger_label_from_healthier_profile": { "const": false }
      }
    }
  }
}
