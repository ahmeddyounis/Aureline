{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-snapshot-review-card.schema.json",
  "title": "Aureline M5 snapshot-review-card / coverage-import-merge-sheet primitive",
  "description": "Export-safe packet implementing the reusable M5 snapshot / golden review card and coverage-import / merge sheet as one twin primitive. The packet binds one row per claimed review consumer — the snapshot review panel, the editor snapshot diff, the coverage-import / merge panel, the headless/CLI review surface, and the review export — to the shared card and sheet anatomy, the derived review posture (matches-baseline/diff-detected/new-snapshot/obsolete/render-unavailable/raw-text-fallback — one distinct posture per diff state so a new snapshot never reads as a matched baseline), the snapshot artifact kinds, baseline identities, render/raw fallback modes, environment/viewport/theme/serializer/locale scope dimensions, the derived merge posture (merged-clean/shard-omission/conflicting-overlap/partial-merge/superseded/merge-unavailable — one distinct posture per merge-resolution state), the coverage import sources, the line-versus-branch metric kinds, the provenance classes, bounded reveal/accept-baseline/reject-change/open-raw-fallback/export and reveal/review-run-scope/open-incompatible/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the two resolvers, and four hard invariants: it never collapses a snapshot acceptance to a blind accept without artifact count, scope, and fallback visibility, never hides the baseline identity or artifact count behind a bare verdict, never hides a shard omission or incompatible-artifact warning behind a merged number, and never invents an alternate label for a governed snapshot or merge state. Raw snapshot payloads, pasted paths, credentials, and private endpoints never cross this boundary. This is the canonical packet schema; the coverage-import-merge-sheet companion schema at m5-coverage-import-merge-sheet.schema.json describes the merge resolution case shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_snapshot_or_golden_review_cards_and_coverage_import_merge_sheets_with_artifact_baseline_identity_raw_or_text_fallback_shard_inclusion_truth_and_stale_or_incompatible_warnings_across_claimed_m5_review_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "test_evidence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "snapshot_anatomy_parts",
        "merge_anatomy_parts",
        "snapshot_artifact_kinds",
        "snapshot_baseline_identities",
        "snapshot_diff_states",
        "snapshot_fallback_modes",
        "snapshot_scope_dimensions",
        "snapshot_review_postures",
        "coverage_import_sources",
        "merge_resolution_states",
        "coverage_metric_kinds",
        "merge_postures",
        "provenance_classes",
        "snapshot_actions",
        "merge_actions",
        "snapshot_export_fields",
        "merge_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "snapshot_examples",
        "merge_examples",
        "collapses_snapshot_accept_without_scope_or_fallback",
        "hides_baseline_identity_or_artifact_count",
        "hides_shard_omission_or_incompatible_warning",
        "invents_alternate_snapshot_or_merge_state_label"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "snapshot_review_panel",
            "editor_snapshot_diff",
            "coverage_import_merge_panel",
            "headless_cli_review",
            "review_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "snapshot_anatomy_parts": { "type": "array", "minItems": 1 },
        "merge_anatomy_parts": { "type": "array", "minItems": 1 },
        "snapshot_artifact_kinds": { "type": "array", "minItems": 1 },
        "snapshot_baseline_identities": { "type": "array", "minItems": 1 },
        "snapshot_diff_states": { "type": "array", "minItems": 1 },
        "snapshot_fallback_modes": { "type": "array", "minItems": 1 },
        "snapshot_scope_dimensions": { "type": "array", "minItems": 1 },
        "snapshot_review_postures": { "type": "array", "minItems": 1 },
        "coverage_import_sources": { "type": "array", "minItems": 1 },
        "merge_resolution_states": { "type": "array", "minItems": 1 },
        "coverage_metric_kinds": { "type": "array", "minItems": 1 },
        "merge_postures": { "type": "array", "minItems": 1 },
        "provenance_classes": { "type": "array", "minItems": 1 },
        "snapshot_actions": { "type": "array", "minItems": 1 },
        "merge_actions": { "type": "array", "minItems": 1 },
        "snapshot_export_fields": { "type": "array", "minItems": 1 },
        "merge_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "snapshot_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/snapshot_example" }
        },
        "merge_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/merge_example" }
        },
        "collapses_snapshot_accept_without_scope_or_fallback": { "const": false },
        "hides_baseline_identity_or_artifact_count": { "const": false },
        "hides_shard_omission_or_incompatible_warning": { "const": false },
        "invents_alternate_snapshot_or_merge_state_label": { "const": false }
      }
    },
    "snapshot_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "artifact_kind",
            "baseline_identity",
            "diff_state",
            "fallback_mode",
            "scope_dimensions",
            "diff_count",
            "provenance_class",
            "card_identity_ref",
            "baseline_ref",
            "review_posture",
            "available_actions",
            "has_scope_disclosed",
            "has_raw_fallback",
            "is_acceptance_decision",
            "acceptance_is_scoped",
            "is_opaque_binary",
            "preserves_fallback_visibility",
            "needs_attention"
          ]
        }
      }
    },
    "merge_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "import_source",
            "merge_resolution",
            "metric_kinds",
            "included_runs",
            "excluded_runs",
            "provenance_class",
            "is_stale",
            "is_incompatible",
            "commit_identity_ref",
            "build_identity_ref",
            "sheet_identity_ref",
            "merge_posture",
            "available_actions",
            "exposes_omitted_shards",
            "discloses_stale_or_incompatible",
            "discloses_metric_dimension",
            "is_imported",
            "is_exact_current_truth",
            "exact_truth_is_qualified",
            "discloses_resulting_scope",
            "needs_attention"
          ]
        }
      }
    }
  }
}
