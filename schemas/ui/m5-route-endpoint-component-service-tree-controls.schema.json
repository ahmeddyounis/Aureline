{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-route-endpoint-component-service-tree-controls.schema.json",
  "title": "Aureline M5 route / endpoint rows and component / service tree nodes",
  "description": "Export-safe packet implementing the reusable M5 route-endpoint-row and component-service-tree-node families in two co-equal control vectors. Each route row names its route / path or matcher, its source file / symbol, its HTTP / UI / runtime kind, its owning framework / app, its params / guards notes, its freshness, and its evidence source; its certainty posture (exact from source, runtime confirmed, heuristic, or partial / unresolved) and authorship posture (authored, generated, framework provided, runtime only, or unknown origin) are derived from the frozen classes, so a heuristic route can never read as exact and the authored-versus-generated boundary stays visible at row level. Each tree node names its entity kind, its source file / symbol, its parent / child or provider / consumer relation, its related test / story / doc links, and its partial or derived notes. Every row and node links back to a canonical proving source (source file, source symbol, runtime trace, or docs anchor) rather than acting as a hidden parallel model, and a runtime-only or unresolved component never claims a proving source it does not have. No component lets a heuristic route or node masquerade as exact, hides the authored-versus-generated or partial-or-derived state, acts as a hidden parallel model, or invents an alternate state label; raw file bodies, raw source trees, pasted local paths, repository URLs, credentials, and secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "route_rows",
    "tree_nodes",
    "downgrade_triggers",
    "consumer_surfaces",
    "route_topology_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_route_endpoint_rows_and_component_service_tree_nodes_with_authored_versus_generated_state_proving_source_files_or_symbols_exact_versus_heuristic_labels_and_open_source_or_open_references_continuity"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "route_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route_endpoint_row" }
    },
    "tree_nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component_service_tree_node" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "route_topology_review": { "$ref": "#/$defs/route_topology_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "route_evidence_class": {
      "enum": [
        "exact_from_source",
        "heuristic_convention",
        "runtime_confirmed",
        "derived_by_convention",
        "partial_evidence",
        "unresolved"
      ]
    },
    "route_authorship": {
      "enum": [
        "authored",
        "generated",
        "generated_then_edited",
        "framework_provided",
        "runtime_only",
        "unknown_origin"
      ]
    },
    "topology_node_kind": {
      "enum": [
        "component_node",
        "service_node",
        "module_node",
        "dependency_edge",
        "external_boundary",
        "unknown_node"
      ]
    },
    "topology_evidence_class": {
      "enum": [
        "exact_from_source",
        "heuristic_inferred",
        "runtime_confirmed",
        "derived_by_convention",
        "partial_evidence",
        "unresolved"
      ]
    },
    "certainty_posture": {
      "enum": [
        "exact_from_source",
        "runtime_confirmed",
        "heuristic",
        "partial_or_unresolved"
      ]
    },
    "authorship_posture": {
      "enum": [
        "authored",
        "generated",
        "framework_provided",
        "runtime_only",
        "unknown_origin"
      ]
    },
    "route_kind": {
      "enum": [
        "http_route",
        "ui_route",
        "websocket_route",
        "rpc_endpoint",
        "runtime_binding",
        "unknown_kind"
      ]
    },
    "relation_kind": {
      "enum": ["parent_child", "provider_consumer", "dependency", "root_node", "none"]
    },
    "freshness_state": {
      "enum": ["current", "imported", "stale", "never_scanned", "unknown"]
    },
    "proving_source_link": {
      "enum": [
        "source_file",
        "source_symbol",
        "runtime_trace",
        "docs_anchor",
        "no_proving_source"
      ]
    },
    "route_row_action": {
      "enum": [
        "open_proving_source",
        "inspect_evidence_and_authorship",
        "review_params_and_guards",
        "copy_route_id",
        "open_reference"
      ]
    },
    "tree_node_action": {
      "enum": [
        "open_proving_source",
        "inspect_evidence_and_relation",
        "open_related_links",
        "copy_node_id",
        "open_reference"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "pack_source_and_certainty",
        "execution_boundary_and_impact",
        "proving_source_and_recovery_boundary"
      ]
    },
    "surface_family": {
      "enum": [
        "framework_pack_surface",
        "route_explorer",
        "topology_explorer",
        "convention_diagnostics",
        "generator_review",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "framework_pack_ui",
        "route_explorer_ui",
        "topology_ui",
        "diagnostic_center_ui",
        "generator_review_ui",
        "run_config_ui",
        "editor_gutter_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "pack_identity_unstated",
        "support_class_unstated",
        "exact_versus_heuristic_unstated",
        "authorship_unstated",
        "execution_boundary_unstated",
        "impact_undisclosed",
        "proving_source_omitted",
        "rollback_path_omitted",
        "derived_state_unlabeled",
        "convention_confidence_overstated",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "route_endpoint_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "route_id",
        "route_or_matcher_label",
        "route_kind",
        "source_file_label",
        "source_symbol_label",
        "owning_framework_label",
        "owning_app_label",
        "route_evidence_class",
        "route_authorship",
        "certainty",
        "derived_certainty_posture",
        "derived_authorship_posture",
        "claims_exact_from_source",
        "claims_generated",
        "has_proving_source_form",
        "params_notes",
        "guards_notes",
        "freshness_state",
        "freshness_label",
        "evidence_source_label",
        "heuristic_note",
        "partial_note",
        "generated_note",
        "no_source_form_note",
        "certainty_and_authorship_note",
        "proving_source_kind",
        "proving_source_ref",
        "context_note",
        "row_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "lets_heuristic_masquerade_as_exact",
        "hides_authored_versus_generated_state",
        "acts_as_hidden_parallel_model",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "route_endpoint_row" },
        "route_id": { "$ref": "#/$defs/non_empty_string" },
        "route_or_matcher_label": { "$ref": "#/$defs/non_empty_string" },
        "route_kind": { "$ref": "#/$defs/route_kind" },
        "source_file_label": { "$ref": "#/$defs/non_empty_string" },
        "source_symbol_label": { "$ref": "#/$defs/non_empty_string" },
        "owning_framework_label": { "$ref": "#/$defs/non_empty_string" },
        "owning_app_label": { "$ref": "#/$defs/non_empty_string" },
        "route_evidence_class": { "$ref": "#/$defs/route_evidence_class" },
        "route_authorship": { "$ref": "#/$defs/route_authorship" },
        "certainty": { "$ref": "#/$defs/certainty_disposition" },
        "derived_certainty_posture": { "$ref": "#/$defs/certainty_posture" },
        "derived_authorship_posture": { "$ref": "#/$defs/authorship_posture" },
        "claims_exact_from_source": { "type": "boolean" },
        "claims_generated": { "type": "boolean" },
        "has_proving_source_form": { "type": "boolean" },
        "params_notes": { "$ref": "#/$defs/non_empty_string" },
        "guards_notes": { "$ref": "#/$defs/non_empty_string" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "freshness_label": { "$ref": "#/$defs/non_empty_string" },
        "evidence_source_label": { "$ref": "#/$defs/non_empty_string" },
        "heuristic_note": { "type": "string" },
        "partial_note": { "type": "string" },
        "generated_note": { "type": "string" },
        "no_source_form_note": { "type": "string" },
        "certainty_and_authorship_note": { "$ref": "#/$defs/non_empty_string" },
        "proving_source_kind": { "$ref": "#/$defs/proving_source_link" },
        "proving_source_ref": { "type": "string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "row_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_proving_source" } },
            { "contains": { "const": "inspect_evidence_and_authorship" } },
            { "contains": { "const": "review_params_and_guards" } }
          ],
          "items": { "$ref": "#/$defs/route_row_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certainty_disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "lets_heuristic_masquerade_as_exact": { "const": false },
        "hides_authored_versus_generated_state": { "const": false },
        "acts_as_hidden_parallel_model": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "component_service_tree_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "node_id",
        "entity_label",
        "topology_node_kind",
        "source_file_label",
        "source_symbol_label",
        "topology_evidence_class",
        "certainty",
        "derived_certainty_posture",
        "claims_exact_from_source",
        "has_proving_source_form",
        "relation_kind",
        "relation_label",
        "related_links_label",
        "heuristic_note",
        "partial_note",
        "no_source_form_note",
        "certainty_and_relation_note",
        "proving_source_kind",
        "proving_source_ref",
        "context_note",
        "node_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "lets_heuristic_masquerade_as_exact",
        "hides_partial_or_derived_state",
        "acts_as_hidden_parallel_model",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "component_service_tree_node" },
        "node_id": { "$ref": "#/$defs/non_empty_string" },
        "entity_label": { "$ref": "#/$defs/non_empty_string" },
        "topology_node_kind": { "$ref": "#/$defs/topology_node_kind" },
        "source_file_label": { "$ref": "#/$defs/non_empty_string" },
        "source_symbol_label": { "$ref": "#/$defs/non_empty_string" },
        "topology_evidence_class": { "$ref": "#/$defs/topology_evidence_class" },
        "certainty": { "$ref": "#/$defs/certainty_disposition" },
        "derived_certainty_posture": { "$ref": "#/$defs/certainty_posture" },
        "claims_exact_from_source": { "type": "boolean" },
        "has_proving_source_form": { "type": "boolean" },
        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "relation_label": { "$ref": "#/$defs/non_empty_string" },
        "related_links_label": { "$ref": "#/$defs/non_empty_string" },
        "heuristic_note": { "type": "string" },
        "partial_note": { "type": "string" },
        "no_source_form_note": { "type": "string" },
        "certainty_and_relation_note": { "$ref": "#/$defs/non_empty_string" },
        "proving_source_kind": { "$ref": "#/$defs/proving_source_link" },
        "proving_source_ref": { "type": "string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "node_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_proving_source" } },
            { "contains": { "const": "inspect_evidence_and_relation" } }
          ],
          "items": { "$ref": "#/$defs/tree_node_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certainty_disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "lets_heuristic_masquerade_as_exact": { "const": false },
        "hides_partial_or_derived_state": { "const": false },
        "acts_as_hidden_parallel_model": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "route_topology_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_row_shows_matcher_and_source",
        "route_row_shows_kind_and_owner",
        "route_row_offers_proving_source",
        "tree_node_shows_entity_and_source",
        "tree_node_shows_relation_and_links",
        "tree_node_offers_proving_source",
        "certainty_and_authorship_derived_never_asserted",
        "heuristic_never_shown_as_exact",
        "authored_versus_generated_visible_at_row_level",
        "partial_or_derived_always_labelled",
        "every_row_links_to_proving_source",
        "runtime_only_never_fakes_a_source",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_explorer_reads_single_source",
        "topology_explorer_reads_single_source",
        "editor_gutter_reads_single_source",
        "certainty_and_authorship_visible_before_trust",
        "proving_source_reachable_before_trust",
        "support_export_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
