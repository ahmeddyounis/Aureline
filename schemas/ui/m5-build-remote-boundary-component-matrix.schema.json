{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-build-remote-boundary-component-matrix.schema.json",
  "title": "Aureline M5 adapter-confidence-chip, discovery-diff-card, host-boundary-strip, execution-origin-receipt-row, managed-workspace-lifecycle-card, suspend-resume-rebuild-review-sheet, workspace-expiry-banner, and local-safe-continuation-card component matrix",
  "description": "Export-safe packet freezing Aureline's reusable build / remote / managed-workspace boundary UI components. The packet names every build-intelligence, host-boundary, or provisioned-workspace surface M5 claims that still ships its own confidence, host-ownership, or lifecycle copy \u2014 adapter-confidence chips, discovery-diff cards, host-boundary strips, execution-origin receipt rows, managed-workspace lifecycle cards, suspend/resume/rebuild review sheets, workspace-expiry banners, and local-safe continuation cards \u2014 and binds each to the claimed M5 surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: the single controlled boundary-disposition vocabulary consumers bind to (local_execution, ssh_execution, container_execution, devcontainer_execution, managed_workspace, browser_bridge, service_plane, suspended, rebuilt, recreated, expired, local_safe_continuation, not_evaluated), plus family-specific adapter confidences, discovery confidences, host kinds, origin loci, lifecycle states, persistence classes, continuity classes, and expiry classes, all bound from the frozen M5 execution and managed-workspace lifecycle object models. Hard invariants forbid implying exact continuity after a material change in target identity, image, template, or persistence class; hiding local-safe continuation or browser/companion handoff behind overflow-only affordances; and letting lower-confidence discovery overwrite a higher-confidence resolved target without an explicit review state. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-remote is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_adapter_confidence_chip_discovery_diff_card_host_boundary_strip_execution_origin_receipt_row_managed_workspace_lifecycle_card_suspend_resume_rebuild_review_sheet_workspace_expiry_banner_and_local_safe_continuation_card_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "boundary_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "component_family": {
      "enum": [
        "adapter_confidence_chip",
        "discovery_diff_card",
        "host_boundary_strip",
        "execution_origin_receipt_row",
        "managed_workspace_lifecycle_card",
        "suspend_resume_rebuild_review_sheet",
        "workspace_expiry_banner",
        "local_safe_continuation_card"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "boundary_disposition": {
      "enum": [
        "local_execution",
        "ssh_execution",
        "container_execution",
        "devcontainer_execution",
        "managed_workspace",
        "browser_bridge",
        "service_plane",
        "suspended",
        "rebuilt",
        "recreated",
        "expired",
        "local_safe_continuation",
        "not_evaluated"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "boundary_dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "implies_exact_continuity_after_material_change",
        "hides_local_safe_or_companion_handoff_in_overflow_only",
        "lower_confidence_overwrites_resolved_target_without_review"
      ],
      "properties": {
        "component_family": {
          "$ref": "#/$defs/component_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "boundary_dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/boundary_disposition"
          }
        },
        "adapter_confidences": {
          "type": "array"
        },
        "discovery_confidences": {
          "type": "array"
        },
        "host_kinds": {
          "type": "array"
        },
        "origin_loci": {
          "type": "array"
        },
        "lifecycle_states": {
          "type": "array"
        },
        "persistence_classes": {
          "type": "array"
        },
        "continuity_classes": {
          "type": "array"
        },
        "expiry_classes": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "implies_exact_continuity_after_material_change": {
          "const": false
        },
        "hides_local_safe_or_companion_handoff_in_overflow_only": {
          "const": false
        },
        "lower_confidence_overwrites_resolved_target_without_review": {
          "const": false
        }
      }
    }
  }
}
