{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-derived-relationship-banner.schema.json",
  "title": "Aureline M5 derived-relationship banner",
  "description": "Per-component contract for a derived-relationship banner: the reusable component that names how a relationship is known and how firmly it links to its proving source. Binds the one controlled certainty vocabulary plus the derived-relationship class and relationship proving state. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape. A derived or inferred link never masquerades as an exact one and every derived state names its proving evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "identity_label",
    "state_label",
    "keyboard_route_label",
    "certainty",
    "derived_relationship_class",
    "relationship_proving_state"
  ],
  "properties": {
    "component_family": {
      "const": "derived_relationship_banner"
    },
    "identity_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "state_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certainty": {
      "$ref": "#/$defs/certainty_disposition"
    },
    "derived_relationship_class": {
      "$ref": "#/$defs/derived_relationship_class"
    },
    "relationship_proving_state": {
      "$ref": "#/$defs/relationship_proving_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "derived_relationship_class": {
      "enum": [
        "exact_from_source",
        "inferred_from_runtime",
        "heuristic_link",
        "derived_by_convention",
        "partial_link",
        "unresolved_link"
      ]
    },
    "relationship_proving_state": {
      "enum": [
        "proving_source_linked",
        "source_linked_partial",
        "runtime_evidence_only",
        "convention_only",
        "no_proving_source",
        "unknown_proving"
      ]
    }
  }
}
