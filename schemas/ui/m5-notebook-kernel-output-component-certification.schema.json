{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-notebook-kernel-output-component-certification.schema.json",
  "title": "Aureline M5 notebook document/kernel/output component profile certification packet",
  "description": "M05-1091 closing capstone certifying that the frozen M5 notebook-kernel-output component families (notebook-document header, kernel-state strip, kernel-picker row, kernel-origin pill, output-trust banner, output-provenance chip group, restart-consequence card, kernel-recovery card) hold their truth on every claimed M5 local / remote / managed notebook profile. Keyed on the claimed notebook runtime / output profile (local trusted kernel, remote isolated kernel, managed kernel, trusted local output, stale output, degraded-origin kernel, restarted kernel, disconnected-reconnecting kernel), each row certifies the profile across six truth axes — visual, keyboard, screen-reader, CLI/export, degraded-state, and notebook-truth behavior — and either passes (green), auto-narrows its result claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh live-trusted claim inherited from a healthier profile or a spec guardrail is breached. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; a stale/disconnected/kernel-free profile can never keep a fresh live-trusted claim; only the local trusted-kernel profile may certify a live-trusted claim; and no profile may let a recovery card imply a rerun, present stale output as live, hide the trust class behind hover-only affordances, or collapse local / remote / managed kernels into one unlabeled badge. Every row cites exactly one canonical notebook-kernel-output proof bundle. The packet is metadata-only: raw notebook cell material, credential material, and bearer secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_notebook_kernel_output_component_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-notebook-kernel-output-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "local_trusted_kernel",
        "remote_isolated_kernel",
        "managed_kernel",
        "trusted_local_output",
        "stale_output",
        "degraded_origin_kernel",
        "restarted_kernel",
        "disconnected_reconnecting_kernel"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "notebook_truth"
      ]
    },
    "support_claim": {
      "enum": [
        "live_trusted_result",
        "reviewable_result",
        "partial_kernel_parity_projection",
        "debugger_unsupported_projection",
        "degraded_origin_projection",
        "stale_output_projection",
        "unprovenanced_environment_projection",
        "no_kernel_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "notebook_document_header",
        "kernel_state_strip",
        "kernel_picker_row",
        "kernel_origin_pill",
        "output_trust_banner",
        "output_provenance_chip_group",
        "restart_consequence_card",
        "kernel_recovery_card"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "kernel_origin_unstated",
        "kernel_class_collapsed",
        "document_identity_unstated",
        "output_trust_unstated",
        "stale_output_shown_as_live",
        "trust_class_hover_only",
        "provenance_severed",
        "restart_consequence_implied_rerun",
        "recovery_overclaimed",
        "reconnect_shown_as_fresh",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery_card_implies_rerun",
        "presents_stale_output_as_live",
        "hides_trust_class_behind_hover_only",
        "collapses_kernel_origins_into_one_badge"
      ],
      "properties": {
        "recovery_card_implies_rerun": { "const": false },
        "presents_stale_output_as_live": { "const": false },
        "hides_trust_class_behind_hover_only": { "const": false },
        "collapses_kernel_origins_into_one_badge": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/support_claim" },
        "to_claim": { "$ref": "#/$defs/support_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_notebook_kernel_output_component_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/support_claim" },
        "certified_claim": { "$ref": "#/$defs/support_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-notebook-kernel-output-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
