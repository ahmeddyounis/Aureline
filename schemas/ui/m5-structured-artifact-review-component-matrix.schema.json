{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-structured-artifact-review-component-matrix.schema.json",
  "title": "Aureline M5 structured-artifact review component matrix",
  "description": "Export-safe packet freezing the M5 component truth for nine reusable structured-artifact review surfaces: artifact identity bars, diff-mode switchers, structure rows, merge-decision rows, generated-artifact notices, rendered compare viewers, media-metadata rails, redaction/trust badge sets, and compare-summary cards. Each component row binds a maturity class to the exact canonical-source disclosure, render/schema fidelity-narrowing vocabulary, compare-only-versus-write-back safety, render-trust disclosure, and generated-from relation it must preserve, plus evidence requirements, downgrade triggers, rollback posture, source contracts, and consumer-surface parity. Raw artifact bodies, raw render payloads, raw media bytes, credentials, and live provider responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_structured_artifact_review_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "component": {
      "type": "string",
      "enum": [
        "artifact_identity_bar",
        "diff_mode_switcher",
        "structure_row",
        "merge_decision_row",
        "generated_artifact_notice",
        "rendered_compare_viewer",
        "media_metadata_rail",
        "redaction_or_trust_badge_set",
        "compare_summary_card"
      ]
    },
    "maturity_class": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "optional",
        "not_applicable"
      ]
    },
    "fidelity_state": {
      "type": "string",
      "enum": [
        "structured_faithful",
        "structured_partial",
        "schema_unrecognized",
        "render_untrusted",
        "raw_fallback",
        "redacted_or_withheld"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "parser_unavailable",
        "schema_unrecognized",
        "render_untrusted",
        "compare_only_enforced",
        "generated_artifact_stale",
        "media_metadata_unavailable",
        "redaction_applied",
        "trust_narrowing",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "compare_only_no_write_back",
        "write_back_attributable",
        "regenerate_only_no_manual_edit",
        "evidence_preserved_no_revert",
        "not_applicable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_workspace",
        "diff_compare_view",
        "merge_conflict_workspace",
        "notebook_review",
        "artifact_browser",
        "browser_companion",
        "cli_headless",
        "support_export",
        "help_about"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "maturity",
        "scope_summary",
        "canonical_source_disclosure",
        "fidelity_narrowing_vocab",
        "compare_write_back_safety",
        "render_trust_disclosure",
        "generated_from_relation",
        "evidence_requirement",
        "required_evidence_packet_refs",
        "downgrade_triggers",
        "rollback_posture",
        "source_contract_refs",
        "consumer_surfaces"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/component"
        },
        "maturity": {
          "$ref": "#/$defs/maturity_class"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "canonical_source_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "fidelity_narrowing_vocab": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fidelity_state"
          }
        },
        "compare_write_back_safety": {
          "$ref": "#/$defs/non_empty_string"
        },
        "render_trust_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generated_from_relation": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_requirement": {
          "$ref": "#/$defs/evidence_requirement"
        },
        "required_evidence_packet_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_trigger"
          }
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer_surface"
          }
        }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source_always_explicit",
        "compare_only_never_silently_writable",
        "structured_mode_never_flattened_without_explanation",
        "generated_from_relation_never_hidden",
        "render_trust_explicit",
        "metadata_visibility_explicit",
        "raw_export_safe_fallback_explicit",
        "redaction_posture_explicit",
        "parser_schema_state_explicit",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "canonical_source_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "compare_only_never_silently_writable": {
          "type": "boolean",
          "const": true
        },
        "structured_mode_never_flattened_without_explanation": {
          "type": "boolean",
          "const": true
        },
        "generated_from_relation_never_hidden": {
          "type": "boolean",
          "const": true
        },
        "render_trust_explicit": {
          "type": "boolean",
          "const": true
        },
        "metadata_visibility_explicit": {
          "type": "boolean",
          "const": true
        },
        "raw_export_safe_fallback_explicit": {
          "type": "boolean",
          "const": true
        },
        "redaction_posture_explicit": {
          "type": "boolean",
          "const": true
        },
        "parser_schema_state_explicit": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_identity_bar_shows_class_and_canonical_source",
        "diff_mode_switcher_shows_available_modes_and_active",
        "structure_row_shows_path_and_change_class",
        "merge_decision_row_shows_side_and_write_back_safety",
        "generated_artifact_notice_shows_generated_from_relation",
        "rendered_compare_viewer_shows_render_trust",
        "media_metadata_rail_shows_metadata_visibility",
        "redaction_or_trust_badge_set_shows_redaction_posture",
        "compare_summary_card_shows_summary_without_flattening",
        "cli_headless_shows_component_truth",
        "support_export_shows_component_truth"
      ],
      "properties": {
        "artifact_identity_bar_shows_class_and_canonical_source": {
          "type": "boolean",
          "const": true
        },
        "diff_mode_switcher_shows_available_modes_and_active": {
          "type": "boolean",
          "const": true
        },
        "structure_row_shows_path_and_change_class": {
          "type": "boolean",
          "const": true
        },
        "merge_decision_row_shows_side_and_write_back_safety": {
          "type": "boolean",
          "const": true
        },
        "generated_artifact_notice_shows_generated_from_relation": {
          "type": "boolean",
          "const": true
        },
        "rendered_compare_viewer_shows_render_trust": {
          "type": "boolean",
          "const": true
        },
        "media_metadata_rail_shows_metadata_visibility": {
          "type": "boolean",
          "const": true
        },
        "redaction_or_trust_badge_set_shows_redaction_posture": {
          "type": "boolean",
          "const": true
        },
        "compare_summary_card_shows_summary_without_flattening": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_component_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_component_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
