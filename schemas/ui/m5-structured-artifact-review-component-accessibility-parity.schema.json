{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-structured-artifact-review-component-accessibility-parity.schema.json",
  "title": "M5 Structured-Artifact Review Component Accessibility, Headless, and Export Parity Packet",
  "description": "Export-safe packet proving that the nine shared M5 structured-artifact review components (artifact identity bar, diff-mode switcher, structure row, merge-decision row, generated-artifact notice, rendered compare viewer, media metadata rail, redaction-or-trust badge set, compare-summary card) expose keyboard, screen-reader, CLI, and export forms at parity with the desktop, and that each component's structured-fidelity claim automatically narrows to the ceiling permitted by its condition when parser/schema certainty is uncertain, render trust is unavailable, merge/write-back safety is unavailable, or metadata availability is stale or policy-blocked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "accessibility_rows",
    "downgrade_triggers",
    "rendering_surfaces",
    "trust_review",
    "projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "structured_artifact_review_component_accessibility_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "accessibility_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "rendering_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rendering_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "projection": { "$ref": "#/$defs/projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "artifact_identity_bar",
        "diff_mode_switcher",
        "structure_row",
        "merge_decision_row",
        "generated_artifact_notice",
        "rendered_compare_viewer",
        "media_metadata_rail",
        "redaction_or_trust_badge_set",
        "compare_summary_card"
      ]
    },
    "claim_condition": {
      "type": "string",
      "enum": [
        "structured_truth_trusted",
        "parser_schema_uncertain",
        "render_trust_unavailable",
        "write_back_safety_unavailable",
        "metadata_unavailable"
      ]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "full_structured_fidelity",
        "structured_compare_only",
        "partial_structure",
        "raw_fallback_disclosed",
        "metadata_withheld"
      ]
    },
    "rendering_surface": {
      "type": "string",
      "enum": ["desktop_full", "cli_headless", "support_export"]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "reparse_against_schema",
        "review_raw_safe_fallback",
        "keep_compare_only",
        "restore_metadata_access",
        "continue_structured_review"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "parser_schema_uncertain",
        "render_trust_unavailable",
        "write_back_safety_unavailable",
        "metadata_availability_unavailable",
        "claim_overstated",
        "parity_dropped",
        "trust_narrowing"
      ]
    },
    "claim_narrowing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "narrowed_to", "preserved_truth_note", "next_action", "next_action_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_to": { "$ref": "#/$defs/claim_tier" },
        "preserved_truth_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "condition",
        "effective_claim",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "rendering_surfaces",
        "narrowing",
        "raw_fallback_note",
        "compare_only_note",
        "redaction_note",
        "is_pointer_only",
        "is_export_opaque",
        "desktop_stronger_than_cli",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "condition": { "$ref": "#/$defs/claim_condition" },
        "effective_claim": { "$ref": "#/$defs/claim_tier" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "rendering_surfaces": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing": {
          "oneOf": [{ "$ref": "#/$defs/claim_narrowing" }, { "type": "null" }]
        },
        "raw_fallback_note": { "type": "string" },
        "compare_only_note": { "type": "string" },
        "redaction_note": { "type": "string" },
        "is_pointer_only": { "const": false },
        "is_export_opaque": { "const": false },
        "desktop_stronger_than_cli": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Trusted structured truth keeps the full claim and never narrows.",
          "if": { "properties": { "condition": { "const": "structured_truth_trusted" } } },
          "then": { "properties": { "narrowing": { "type": "null" } } }
        },
        {
          "comment": "Any weakening condition must carry an explicit narrow disclosure and keep the raw/export-safe fallback explicit.",
          "if": {
            "properties": {
              "condition": {
                "enum": [
                  "parser_schema_uncertain",
                  "render_trust_unavailable",
                  "write_back_safety_unavailable",
                  "metadata_unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "narrowing": { "$ref": "#/$defs/claim_narrowing" },
              "raw_fallback_note": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "comment": "Unavailable write-back safety must carry an explicit compare-only note.",
          "if": {
            "properties": { "condition": { "const": "write_back_safety_unavailable" } }
          },
          "then": {
            "properties": { "compare_only_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "Unavailable metadata must carry an explicit redaction / withheld note.",
          "if": {
            "properties": { "condition": { "const": "metadata_unavailable" } }
          },
          "then": {
            "properties": { "redaction_note": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard_reachable_on_every_claim",
        "screen_reader_labeled_on_every_claim",
        "cli_enum_exposed_on_every_claim",
        "export_enum_exposed_on_every_claim",
        "explanation_field_present_on_every_claim",
        "no_component_pointer_only",
        "no_component_export_opaque",
        "desktop_never_stronger_than_cli",
        "claim_narrows_when_structured_fidelity_weakens",
        "structured_fidelity_never_overstated_under_weakening",
        "raw_or_export_safe_fallback_kept_explicit",
        "compare_only_never_promoted_to_writable_state"
      ],
      "properties": {
        "keyboard_reachable_on_every_claim": { "const": true },
        "screen_reader_labeled_on_every_claim": { "const": true },
        "cli_enum_exposed_on_every_claim": { "const": true },
        "export_enum_exposed_on_every_claim": { "const": true },
        "explanation_field_present_on_every_claim": { "const": true },
        "no_component_pointer_only": { "const": true },
        "no_component_export_opaque": { "const": true },
        "desktop_never_stronger_than_cli": { "const": true },
        "claim_narrows_when_structured_fidelity_weakens": { "const": true },
        "structured_fidelity_never_overstated_under_weakening": { "const": true },
        "raw_or_export_safe_fallback_kept_explicit": { "const": true },
        "compare_only_never_promoted_to_writable_state": { "const": true }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposes_keyboard_and_screen_reader_labels",
        "exposes_cli_and_export_enums",
        "exposes_explanation_fields",
        "auto_narrows_on_uncertain_parser_schema",
        "auto_narrows_on_unavailable_render_trust",
        "auto_narrows_on_unavailable_write_back_safety",
        "auto_narrows_on_unavailable_metadata",
        "desktop_cli_export_semantics_identical",
        "narrowing_prevents_overstated_structured_fidelity",
        "every_component_reachable_non_visually"
      ],
      "properties": {
        "exposes_keyboard_and_screen_reader_labels": { "const": true },
        "exposes_cli_and_export_enums": { "const": true },
        "exposes_explanation_fields": { "const": true },
        "auto_narrows_on_uncertain_parser_schema": { "const": true },
        "auto_narrows_on_unavailable_render_trust": { "const": true },
        "auto_narrows_on_unavailable_write_back_safety": { "const": true },
        "auto_narrows_on_unavailable_metadata": { "const": true },
        "desktop_cli_export_semantics_identical": { "const": true },
        "narrowing_prevents_overstated_structured_fidelity": { "const": true },
        "every_component_reachable_non_visually": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
