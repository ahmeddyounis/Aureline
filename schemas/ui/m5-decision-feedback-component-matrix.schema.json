{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-decision-feedback-component-matrix.schema.json",
  "title": "Aureline M5 badge-chip-pill, popover, dialog-sheet, banner-inline-notice, toast, empty-state, loading-state, and consequence-block component matrix",
  "description": "Export-safe packet freezing Aureline's most reused decision and feedback primitives. The packet names every claimed M5 surface that still ships its own badge / chip / pill, popover, dialog or sheet, banner or inline notice, toast, empty state, loading state, or consequence block — across the shell, entry, trust, review, repair, and notification surfaces — and binds each to the claimed surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, reduced-motion, CLI/export, support-packet), the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each primitive declares the controlled vocabularies it carries: the single controlled state vocabulary consumers bind to (info, success, warning, blocked, pending, degraded, acknowledged, dismissed), plus family-specific badge expression, popover dismissal, dialog action model, notice scope, toast durability, empty-state purpose, loading fidelity, and consequence disclosure. Hard invariants forbid relying on color alone for meaning, letting a popover carry the only critical workflow instruction, using generic Yes/No copy in a high-risk dialog, representing long-running or reviewable work as toast-only truth, blanking a useful pane during loading, and using a full-screen spinner where partial capability exists. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_badge_chip_pill_popover_dialog_sheet_banner_inline_notice_toast_empty_state_loading_state_and_consequence_block_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "component_family": {
      "enum": [
        "badge_chip_pill",
        "popover",
        "dialog_sheet",
        "banner_inline_notice",
        "toast",
        "empty_state",
        "loading_state",
        "consequence_block"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "info",
        "success",
        "warning",
        "blocked",
        "pending",
        "degraded",
        "acknowledged",
        "dismissed"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "relies_on_color_alone_for_meaning",
        "lets_popover_carry_only_critical_instruction",
        "uses_generic_yes_no_in_high_risk_dialog",
        "represents_durable_work_as_toast_only",
        "blanks_useful_pane_during_loading",
        "uses_full_screen_spinner_when_partial_capable"
      ],
      "properties": {
        "component_family": {
          "$ref": "#/$defs/component_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/disposition"
          }
        },
        "badge_expressions": {
          "type": "array"
        },
        "popover_dismissals": {
          "type": "array"
        },
        "dialog_action_models": {
          "type": "array"
        },
        "notice_scopes": {
          "type": "array"
        },
        "toast_durabilities": {
          "type": "array"
        },
        "empty_state_purposes": {
          "type": "array"
        },
        "loading_fidelities": {
          "type": "array"
        },
        "consequence_disclosures": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "relies_on_color_alone_for_meaning": {
          "const": false
        },
        "lets_popover_carry_only_critical_instruction": {
          "const": false
        },
        "uses_generic_yes_no_in_high_risk_dialog": {
          "const": false
        },
        "represents_durable_work_as_toast_only": {
          "const": false
        },
        "blanks_useful_pane_during_loading": {
          "const": false
        },
        "uses_full_screen_spinner_when_partial_capable": {
          "const": false
        }
      }
    }
  }
}
