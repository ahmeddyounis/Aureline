{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-local-history-row-and-checkpoint-group-card.schema.json",
  "title": "Aureline M5 local-history-row / checkpoint-group-card primitive",
  "description": "Export-safe packet implementing the reusable M5 local-history row and checkpoint-group card as one primitive pair. The packet binds one row per claimed recovery consumer — editor recovery, refactor history, AI apply, importer actions, and support evidence — to the shared row and card anatomy, the derived row posture (restorable/automated-capture/metadata-only/purge-pending/unattributed/expired), the derived card posture (atomic/multi-file/generated-artifact/imported/high-risk/restore-blocked), the snapshot origins, actor classes, capture fidelities, checkpoint lineage classes, mutation classes, retention postures, export-redaction postures, pre/post-risk notes, bounded reveal/open/compare/restore/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked row and card resolution cases proving the resolvers, and four hard invariants: it never masks its snapshot actor or timestamp, never hides a capture fidelity or generated-or-managed-file caveat, never invents a private history grammar, and never bypasses the restore-scope review. Raw snapshot bodies, restored file contents, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_local_history_rows_and_checkpoint_group_cards_with_actor_lineage_scope_trigger_retention_and_grouped_restore_truth_across_claimed_m5_recovery_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "recovery_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "recovery_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "row_anatomy_parts",
        "card_anatomy_parts",
        "snapshot_origins",
        "actor_classes",
        "capture_fidelities",
        "checkpoint_lineage_classes",
        "mutation_classes",
        "retention_postures",
        "export_redaction_postures",
        "row_postures",
        "card_postures",
        "row_actions",
        "card_actions",
        "risk_notes",
        "row_export_fields",
        "card_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "row_examples",
        "card_examples",
        "masks_actor_or_timestamp",
        "hides_capture_or_managed_caveat",
        "invents_private_history_grammar",
        "bypasses_restore_scope_review"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "editor_recovery",
            "refactor_history",
            "ai_apply_review",
            "importer_actions",
            "support_evidence"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "row_anatomy_parts": { "type": "array", "minItems": 1 },
        "card_anatomy_parts": { "type": "array", "minItems": 1 },
        "snapshot_origins": { "type": "array", "minItems": 1 },
        "actor_classes": { "type": "array", "minItems": 1 },
        "capture_fidelities": { "type": "array", "minItems": 1 },
        "checkpoint_lineage_classes": { "type": "array", "minItems": 1 },
        "mutation_classes": { "type": "array", "minItems": 1 },
        "retention_postures": { "type": "array", "minItems": 1 },
        "export_redaction_postures": { "type": "array", "minItems": 1 },
        "row_postures": { "type": "array", "minItems": 1 },
        "card_postures": { "type": "array", "minItems": 1 },
        "row_actions": { "type": "array", "minItems": 1 },
        "card_actions": { "type": "array", "minItems": 1 },
        "risk_notes": { "type": "array", "minItems": 1 },
        "row_export_fields": { "type": "array", "minItems": 1 },
        "card_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/row_example" }
        },
        "card_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card_example" }
        },
        "masks_actor_or_timestamp": { "const": false },
        "hides_capture_or_managed_caveat": { "const": false },
        "invents_private_history_grammar": { "const": false },
        "bypasses_restore_scope_review": { "const": false }
      }
    },
    "row_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "row_posture",
            "object_identity",
            "can_restore",
            "is_openable",
            "is_automated",
            "available_actions"
          ]
        }
      }
    },
    "card_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "card_posture",
            "group_label",
            "file_count",
            "can_restore",
            "is_multi_file",
            "touches_generated_or_managed",
            "available_actions"
          ]
        }
      }
    }
  }
}
