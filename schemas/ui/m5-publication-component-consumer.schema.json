{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-publication-component-consumer.schema.json",
  "title": "M5 Publication-Component Consumer Packet",
  "description": "Adoption matrix binding every claimed M5 publication-component consumer (release center, update center, About/help, docs portal, enterprise evaluation, support export) to the four canonical release/publication component families and the one shared provenance / freshness / qualification / client-scope descriptor vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_release_center_update_center_about_help_docs_evaluation_and_support_publication_component_consumers"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "release_center",
        "update_center",
        "about_help",
        "docs_portal",
        "enterprise_evaluation",
        "support_export"
      ]
    },
    "component_family": {
      "enum": [
        "release_candidate_card",
        "version_bump_publish_target",
        "artifact_provenance_bundle",
        "promotion_rollback_history"
      ]
    },
    "descriptor": {
      "enum": ["provenance", "freshness", "qualification", "client_scope"]
    },
    "client_scope_mode": {
      "enum": [
        "full_client_scope",
        "narrowed_client_scope",
        "mirror_offline_scope",
        "browser_companion_handoff"
      ]
    },
    "descriptor_parity_state": {
      "enum": ["descriptors_preserved", "descriptors_disclosed_narrowed"]
    },
    "reduced_scope_reason": {
      "enum": ["client_narrowed", "mirror_offline", "browser_companion_handoff"]
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "const": true },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "client_scope_modes",
        "handoff_caveats",
        "descriptor_parity_states",
        "reduced_scope_reasons",
        "scope_next_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewords_descriptors_per_surface",
        "invents_new_badge_vocabulary",
        "drops_provenance_or_freshness_when_narrowed",
        "hides_mirror_or_offline_handoff_caveat"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": { "type": "string" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "items": { "type": "string" } },
        "anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "descriptor_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor" },
          "minItems": 4
        },
        "client_scope_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/client_scope_mode" }
        },
        "handoff_caveats": { "type": "array", "items": { "type": "string" } },
        "descriptor_parity_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor_parity_state" }
        },
        "reduced_scope_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/reduced_scope_reason" }
        },
        "scope_next_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_binding" }
        },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": { "type": "array", "items": { "type": "string" } },
        "rewords_descriptors_per_surface": { "const": false },
        "invents_new_badge_vocabulary": { "const": false },
        "drops_provenance_or_freshness_when_narrowed": { "const": false },
        "hides_mirror_or_offline_handoff_caveat": { "const": false }
      }
    }
  }
}
