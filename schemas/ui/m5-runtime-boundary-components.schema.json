{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-runtime-boundary-components.schema.json",
  "title": "Aureline M5 terminal-tab, remote-target-pill, environment-status-strip, toolchain-pin-row, presence-avatar-stack, and repair-action-card component matrix",
  "description": "Export-safe packet freezing Aureline's reusable runtime-boundary and repair components. The packet names every component family M5 claims that still drifts too easily by feature lane — terminal tabs/headers, remote target pills, environment status strips, toolchain pin rows, presence avatar stacks, and repair action cards — and binds each to a canonical shell zone, the responsive classes it must survive, the window classes it keeps continuity across, and the claimed M5 surface families that render it. Each component declares the controlled vocabularies it carries: shell-integration qualities and session-liveness states, host-boundary classes and connection states, runtime and toolchain source classes and pin states, collaboration roles and follow states, repair blast radii and reversibility classes, non-visual accessibility routes, and mandatory labels. Hard invariants forbid masking a host/runtime boundary, conflating a live session with a restored one, inventing a private status grammar, and overstating reversibility or dropping audit/support truth off the primary surface. The shell zone, responsive class, window class, consumer surface, and surface family vocabularies are reused verbatim from the frozen M5 shell-zone matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_terminal_tab_remote_target_pill_environment_status_strip_toolchain_pin_row_presence_avatar_stack_and_repair_action_card_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "terminal_tab",
        "remote_target_pill",
        "environment_status_strip",
        "toolchain_pin_row",
        "presence_avatar_stack",
        "repair_action_card"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook",
        "data_grid",
        "profiler",
        "pipeline",
        "docs",
        "preview",
        "review",
        "incident",
        "companion",
        "operator"
      ]
    },
    "consumer_surface": {
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "boundary",
        "resolved_source",
        "reversibility"
      ]
    },
    "shell_integration_quality": {
      "enum": [
        "fully_integrated",
        "command_marks_only",
        "cwd_reporting_only",
        "basic_pty_no_integration",
        "integration_degraded"
      ]
    },
    "session_liveness_state": {
      "enum": [
        "live_attached",
        "live_detached_running",
        "restored_from_transcript",
        "reconnecting",
        "closed_exited"
      ]
    },
    "host_boundary_class": {
      "enum": [
        "local_host",
        "remote_ssh_host",
        "container_host",
        "managed_workspace_host",
        "virtual_machine_host",
        "wasm_sandbox_host"
      ]
    },
    "connection_state": {
      "enum": [
        "connected",
        "connecting",
        "reconnecting",
        "disconnected",
        "offline_cached"
      ]
    },
    "runtime_source_class": {
      "enum": [
        "project_pinned",
        "workspace_configured",
        "tool_manager_resolved",
        "system_default",
        "container_provided",
        "session_override"
      ]
    },
    "toolchain_source_class": {
      "enum": [
        "pin_file",
        "workspace_setting",
        "version_manager",
        "system_installed",
        "container_image",
        "session_override"
      ]
    },
    "toolchain_pin_state": {
      "enum": [
        "pinned_resolved",
        "pinned_missing_fallback",
        "unpinned",
        "pin_conflict",
        "pin_overridden"
      ]
    },
    "collaboration_role": {
      "enum": [
        "session_host",
        "collaborator",
        "presenter",
        "observer",
        "control_holder"
      ]
    },
    "follow_state": {
      "enum": [
        "following_presenter",
        "being_followed",
        "not_following",
        "presenting_to_others",
        "follow_paused"
      ]
    },
    "repair_blast_radius": {
      "enum": [
        "no_writes_preview",
        "workspace_scoped",
        "toolchain_scoped",
        "host_environment_scoped",
        "multi_target_scoped"
      ]
    },
    "reversibility_class": {
      "enum": [
        "fully_reversible_checkpoint",
        "reversible_with_backup",
        "partially_reversible",
        "irreversible_confirmed",
        "reversal_requires_manual_steps"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "shell_integration_quality_hidden",
        "session_liveness_ambiguous",
        "host_boundary_masked",
        "connection_state_stale",
        "runtime_source_unexplained",
        "toolchain_pin_conflict_hidden",
        "collaboration_role_masked",
        "follow_state_ambiguous",
        "repair_blast_radius_understated",
        "reversibility_overstated",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "surface_families",
        "required_labels",
        "shell_integration_qualities",
        "session_liveness_states",
        "host_boundary_classes",
        "connection_states",
        "runtime_source_classes",
        "toolchain_source_classes",
        "toolchain_pin_states",
        "collaboration_roles",
        "follow_states",
        "repair_blast_radii",
        "reversibility_classes",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_host_or_runtime_boundary",
        "conflates_live_and_restored_session",
        "invents_private_status_grammar",
        "overstates_reversibility_or_drops_audit_truth"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "shell_integration_qualities": {
          "type": "array",
          "items": { "$ref": "#/$defs/shell_integration_quality" }
        },
        "session_liveness_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/session_liveness_state" }
        },
        "host_boundary_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/host_boundary_class" }
        },
        "connection_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/connection_state" }
        },
        "runtime_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtime_source_class" }
        },
        "toolchain_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolchain_source_class" }
        },
        "toolchain_pin_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolchain_pin_state" }
        },
        "collaboration_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/collaboration_role" }
        },
        "follow_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/follow_state" }
        },
        "repair_blast_radii": {
          "type": "array",
          "items": { "$ref": "#/$defs/repair_blast_radius" }
        },
        "reversibility_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reversibility_class" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_host_or_runtime_boundary": { "const": false },
        "conflates_live_and_restored_session": { "const": false },
        "invents_private_status_grammar": { "const": false },
        "overstates_reversibility_or_drops_audit_truth": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_families",
        "shell_integration_qualities",
        "session_liveness_states",
        "host_boundary_classes",
        "connection_states",
        "runtime_source_classes",
        "toolchain_source_classes",
        "toolchain_pin_states",
        "collaboration_roles",
        "follow_states",
        "repair_blast_radii",
        "reversibility_classes",
        "accessibility_routes",
        "required_labels"
      ],
      "properties": {
        "component_families": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "shell_integration_qualities": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "session_liveness_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "host_boundary_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "connection_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "runtime_source_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "toolchain_source_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "toolchain_pin_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "collaboration_roles": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "follow_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "repair_blast_radii": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "reversibility_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "accessibility_routes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "required_labels": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_tab_shows_boundary_and_shell_integration",
        "remote_pill_shows_host_boundary_and_connection",
        "environment_strip_names_winning_runtime_source",
        "toolchain_row_explains_why_toolchain_won",
        "presence_stack_shows_role_and_follow_state",
        "repair_card_shows_blast_radius_and_reversibility",
        "live_versus_restored_never_conflated",
        "no_component_invents_second_status_grammar",
        "every_component_bound_to_shell_zone",
        "every_component_declares_accessibility_route",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "terminal_tab_shows_boundary_and_shell_integration": { "const": true },
        "remote_pill_shows_host_boundary_and_connection": { "const": true },
        "environment_strip_names_winning_runtime_source": { "const": true },
        "toolchain_row_explains_why_toolchain_won": { "const": true },
        "presence_stack_shows_role_and_follow_state": { "const": true },
        "repair_card_shows_blast_radius_and_reversibility": { "const": true },
        "live_versus_restored_never_conflated": { "const": true },
        "no_component_invents_second_status_grammar": { "const": true },
        "every_component_bound_to_shell_zone": { "const": true },
        "every_component_declares_accessibility_route": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_and_session_surfaces_consume_matrix",
        "remote_and_environment_surfaces_consume_boundary_vocabulary",
        "collaboration_surfaces_consume_role_follow_vocabulary",
        "repair_surfaces_consume_reversibility_vocabulary",
        "support_export_reads_single_source",
        "accessibility_bridge_reads_single_source"
      ],
      "properties": {
        "terminal_and_session_surfaces_consume_matrix": { "const": true },
        "remote_and_environment_surfaces_consume_boundary_vocabulary": { "const": true },
        "collaboration_surfaces_consume_role_follow_vocabulary": { "const": true },
        "repair_surfaces_consume_reversibility_vocabulary": { "const": true },
        "support_export_reads_single_source": { "const": true },
        "accessibility_bridge_reads_single_source": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "runtime_boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "runtime_boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
