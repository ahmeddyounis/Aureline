{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-experiment-run-row-environment-fingerprint-controls.schema.json",
  "title": "Aureline M5 experiment run rows and environment fingerprint cards",
  "description": "Export-safe packet implementing the reusable M5 experiment-run-row and environment-fingerprint-card components in two co-equal control vectors. Each run row names its run id, its notebook/script/task origin, its commit or workspace revision, its start/end window, its execution origin, and its outcome, and offers first-class open/compare/export actions; its origin class is derived from the run origin kind, so an imported, manually attached, or unknown-origin run can never read as a first-party run before a compare or share. Each fingerprint card names its interpreter or kernel, package/toolchain summary, execution target, hardware/profile class, and capture freshness, and offers inspect/export paths; its capture class is derived from the capture state, so a missing, drifted, or unavailable fingerprint can never read as a captured environment. Every next step names one stable run/notebook/dataset/docs deep link rather than an ephemeral overlay or hidden route. No component masks provenance or sensitivity state, hides run origin or code revision, implies apples-to-apples without parity, or invents an alternate state label; raw dataset payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "run_rows",
    "fingerprint_cards",
    "downgrade_triggers",
    "consumer_surfaces",
    "experiment_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_experiment_run_rows_and_environment_fingerprint_cards_with_run_origin_code_revision_execution_target_and_outcome_truth_across_claimed_m5_notebook_and_data_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "run_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/experiment_run_row" }
    },
    "fingerprint_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/environment_fingerprint_card" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "experiment_review": { "$ref": "#/$defs/experiment_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "run_origin_kind": {
      "enum": [
        "notebook_cell",
        "script_task",
        "scheduled_task",
        "manual_attach",
        "imported_run",
        "unknown_origin"
      ]
    },
    "run_status_state": {
      "enum": ["queued", "running", "succeeded", "failed", "canceled", "stale"]
    },
    "origin_class": {
      "enum": ["local_run", "managed_run", "imported_run", "manually_attached", "origin_unknown"]
    },
    "fingerprint_scope_class": {
      "enum": [
        "interpreter",
        "kernel_spec",
        "packages",
        "hardware_accelerator",
        "os_platform",
        "container_image"
      ]
    },
    "fingerprint_state": {
      "enum": [
        "captured_complete",
        "captured_partial",
        "captured_missing",
        "pinned",
        "drifted",
        "unavailable"
      ]
    },
    "capture_class": {
      "enum": ["captured", "partially_captured", "pinned", "uncaptured"]
    },
    "deep_link_kind": {
      "enum": [
        "run_object",
        "notebook_location",
        "dataset_catalog_anchor",
        "docs_anchor",
        "no_deep_link"
      ]
    },
    "run_action": {
      "enum": [
        "open_run",
        "compare_runs",
        "export_run",
        "open_deep_link",
        "inspect_fingerprint",
        "copy_run_id"
      ]
    },
    "fingerprint_card_action": {
      "enum": [
        "inspect_fingerprint",
        "export_fingerprint",
        "open_deep_link",
        "compare_environments",
        "copy_fingerprint_id",
        "pin_environment"
      ]
    },
    "disposition": {
      "enum": [
        "local_run",
        "managed_run",
        "imported_run",
        "manual_attach",
        "reproducible",
        "likely_reproducible",
        "needs_rerun",
        "context_incomplete"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "run_origin_and_revision",
        "provenance_and_sensitivity",
        "export_scope"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook_surface",
        "experiment_run_dashboard",
        "run_comparison_view",
        "dataset_catalog",
        "share_review_sheet",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "notebook_ui",
        "experiment_dashboard_ui",
        "comparison_ui",
        "data_catalog_ui",
        "lineage_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_origin_unstated",
        "code_revision_unstated",
        "environment_fingerprint_unstated",
        "dataset_provenance_severed",
        "comparability_overstated",
        "sensitivity_class_unstated",
        "export_scope_unstated",
        "raw_payload_exposed_by_default",
        "cached_state_hidden",
        "imported_run_unmarked",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "experiment_run_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "run_id",
        "run_label",
        "origin_kind",
        "status_state",
        "status_label",
        "origin_class",
        "claims_first_party_origin",
        "imported_note",
        "manual_attach_note",
        "unknown_origin_note",
        "origin_and_status_note",
        "code_revision",
        "execution_origin_label",
        "run_window_label",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "run_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_run_origin_or_revision",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "experiment_run_row" },
        "run_id": { "$ref": "#/$defs/non_empty_string" },
        "run_label": { "$ref": "#/$defs/non_empty_string" },
        "origin_kind": { "$ref": "#/$defs/run_origin_kind" },
        "status_state": { "$ref": "#/$defs/run_status_state" },
        "status_label": { "$ref": "#/$defs/non_empty_string" },
        "origin_class": { "$ref": "#/$defs/origin_class" },
        "claims_first_party_origin": { "type": "boolean" },
        "imported_note": { "type": "string" },
        "manual_attach_note": { "type": "string" },
        "unknown_origin_note": { "type": "string" },
        "origin_and_status_note": { "$ref": "#/$defs/non_empty_string" },
        "code_revision": { "$ref": "#/$defs/non_empty_string" },
        "execution_origin_label": { "$ref": "#/$defs/non_empty_string" },
        "run_window_label": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "run_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_run" } },
            { "contains": { "const": "compare_runs" } },
            { "contains": { "const": "export_run" } }
          ],
          "items": { "$ref": "#/$defs/run_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_run_origin_or_revision": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "environment_fingerprint_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "card_label",
        "scope_class",
        "fingerprint_state",
        "capture_class",
        "claims_captured",
        "partial_note",
        "uncaptured_note",
        "interpreter_or_kernel_label",
        "toolchain_summary",
        "execution_target_label",
        "hardware_profile_label",
        "freshness_label",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_run_origin_or_revision",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "environment_fingerprint_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "card_label": { "$ref": "#/$defs/non_empty_string" },
        "scope_class": { "$ref": "#/$defs/fingerprint_scope_class" },
        "fingerprint_state": { "$ref": "#/$defs/fingerprint_state" },
        "capture_class": { "$ref": "#/$defs/capture_class" },
        "claims_captured": { "type": "boolean" },
        "partial_note": { "type": "string" },
        "uncaptured_note": { "type": "string" },
        "interpreter_or_kernel_label": { "$ref": "#/$defs/non_empty_string" },
        "toolchain_summary": { "$ref": "#/$defs/non_empty_string" },
        "execution_target_label": { "$ref": "#/$defs/non_empty_string" },
        "hardware_profile_label": { "$ref": "#/$defs/non_empty_string" },
        "freshness_label": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "inspect_fingerprint" } },
            { "contains": { "const": "export_fingerprint" } }
          ],
          "items": { "$ref": "#/$defs/fingerprint_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_run_origin_or_revision": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "experiment_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_row_shows_origin",
        "run_row_shows_code_revision",
        "run_row_offers_open_compare_export",
        "fingerprint_card_shows_environment",
        "fingerprint_card_offers_inspect_export",
        "origin_and_capture_derived_never_asserted",
        "unknown_origin_never_shown_as_first_party",
        "uncaptured_never_shown_as_captured",
        "comparison_never_implied_apples_to_apples_without_parity",
        "every_next_step_names_stable_deep_link",
        "no_component_widens_export_scope_or_exposes_raw_by_default",
        "run_identity_and_revision_always_explicit",
        "provenance_and_sensitivity_state_visible",
        "cached_offline_local_only_state_visible",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_run_dashboard_reads_single_source",
        "environment_fingerprint_surface_reads_single_source",
        "origin_and_status_visible_before_compare_or_share",
        "environment_capture_visible_before_trust",
        "support_export_shows_component_truth",
        "help_docs_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
