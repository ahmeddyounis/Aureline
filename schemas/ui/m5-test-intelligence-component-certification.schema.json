{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-intelligence-component-certification.schema.json",
  "title": "Aureline M5 test-intelligence component surface certification packet",
  "description": "M05-1035 closing surface-certification capstone over the frozen M5 test-intelligence component matrix. Certifies that the shared coverage-summary-bar, coverage-overlay-marker, flaky-state-badge, retry-history-row, snapshot-review-card, coverage-import-merge-sheet, and test-generation-suggestion-card truth holds on every claimed M5 quality surface, auto-narrowing any surface that cannot sustain it. Metadata-only: typed class tokens, opaque refs, booleans, and redacted labels; never raw assertion diffs, coverage report bodies, snapshot / golden artifact contents, generated-test source, or credential-bearing material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_test_intelligence_component_certification_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "evidence_claim": {
      "type": "string",
      "enum": [
        "verified_current_evidence",
        "reviewable_evidence",
        "partial_condition_evidence",
        "unconfirmed_flaky_evidence",
        "unverified_baseline_evidence",
        "imported_or_stale_evidence",
        "unvalidated_generated_evidence"
      ]
    },
    "certified_surface": {
      "type": "string",
      "enum": [
        "coverage_report_view",
        "editor_gutter_overlay",
        "flaky_dashboard",
        "retry_history_panel",
        "snapshot_review_pane",
        "coverage_import_merge",
        "generated_test_review",
        "cli_export"
      ]
    },
    "certification_axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "evidence_provenance_and_assumption_boundary"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "surface_status": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "provenance_class_unstated",
        "freshness_class_undisclosed",
        "shard_omission_hidden",
        "line_versus_branch_unstated",
        "flaky_confidence_overstated",
        "retry_scope_widened",
        "snapshot_baseline_unstated",
        "raw_text_fallback_missing",
        "generated_assumption_hidden",
        "opaque_apply_bundle",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "component_family": {
      "type": "string",
      "enum": [
        "coverage_summary_bar",
        "coverage_overlay_marker",
        "flaky_state_badge",
        "retry_history_row",
        "snapshot_review_card",
        "coverage_import_merge_sheet",
        "test_generation_suggestion_card"
      ]
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_axis",
        "from_claim",
        "to_claim",
        "visible_label",
        "preserves_evidence_continuity"
      ],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/evidence_claim" },
        "to_claim": { "$ref": "#/$defs/evidence_claim" },
        "visible_label": { "type": "string", "minLength": 1 },
        "preserves_evidence_continuity": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "surface",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "evidence_continuity_preserved",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_test_intelligence_component_certification_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/certified_surface" },
        "claimed_claim": { "$ref": "#/$defs/evidence_claim" },
        "certified_claim": { "$ref": "#/$defs/evidence_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "evidence_continuity_preserved": { "type": "boolean" },
        "canonical_bundle_ref": { "type": "string", "minLength": 1 },
        "derived_status": { "$ref": "#/$defs/surface_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "surface_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_surfaces_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "every_axis_covered_on_every_row",
        "all_evidence_continuity_preserved",
        "narrowed_surface_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "surface_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_surfaces_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "all_evidence_continuity_preserved": { "type": "boolean" },
        "narrowed_surface_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
