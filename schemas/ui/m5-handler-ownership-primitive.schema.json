{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-handler-ownership-primitive.schema.json",
  "title": "Aureline M5 handler-ownership primitive",
  "description": "Canonical parity matrix for the reusable M5 handler-ownership primitive: a handler-ownership / precedence disclosure card, a set of channel-association review rows for file / protocol / recent-item / notification handlers, and a recovery-alignment block that all resolve from one handler-ownership context and share one ownership identity. Narrows the channel-association and install-profile handler-ownership truth of the frozen M5 deployment/continuity component matrix into one working resolver. A side-by-side install can always explain which build owns file associations and why (AC1); handler changes stay previewable and reversible with bounded keep / reassign / cancel actions rather than silent takeovers (AC2); support packets preserve handler ownership and precedence truth with system-open / deep-link / recent-item / notification recovery aligned to the owner and carrying the rollback identity (AC3). Raw config bytes, credentials, license keys, handler URIs, and registry paths never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_handler_ownership_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "about_integration",
        "diagnostics_handlers",
        "install_review",
        "support_export_replay",
        "notification_center",
        "docs_handler_reference"
      ]
    },
    "channel_class": {
      "enum": [
        "file_association",
        "protocol_handler",
        "recent_item_reopen",
        "notification_action",
        "deep_link",
        "system_open"
      ]
    },
    "owner_class": {
      "enum": [
        "primary_stable_install",
        "side_by_side_beta_install",
        "portable_install",
        "managed_fleet_install",
        "external_non_aureline",
        "unowned"
      ]
    },
    "precedence_state": {
      "enum": [
        "sole_owner",
        "primary_among_installs",
        "shared_contested",
        "superseded",
        "not_registered"
      ]
    },
    "change_state": {
      "enum": [
        "no_change",
        "reassign_to_this_install",
        "release_to_other_install",
        "contested_awaiting_review",
        "revert_to_previous"
      ]
    },
    "impact_class": {
      "enum": [
        "opens_in_this_build",
        "opens_in_other_build",
        "routes_to_this_build",
        "resolves_in_place",
        "no_user_visible_change",
        "requires_user_choice"
      ]
    },
    "association_action": {
      "enum": ["keep", "reassign", "cancel", "preview_change"]
    },
    "export_field": {
      "enum": [
        "ownership_id",
        "channel_class",
        "current_owner",
        "proposed_owner",
        "precedence_state",
        "user_facing_impact",
        "channel_actions",
        "rollback_identity",
        "recovery_alignment",
        "ownership_reason"
      ]
    },
    "deployment_mode": {
      "enum": ["desktop", "managed", "self_hosted", "portable", "air_gapped"]
    },
    "downgrade_trigger": {
      "enum": [
        "control_plane_impaired",
        "mirror_stale",
        "offline_cache_only",
        "signature_unverified",
        "rollout_paused",
        "handler_ownership_contested",
        "state_root_unavailable",
        "residual_vendor_dependency",
        "provenance_incomplete"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "channel_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_ref",
        "channel_class",
        "current_owner_ref",
        "current_owner_class",
        "proposed_owner_ref",
        "proposed_owner_class",
        "change_state",
        "impact_class",
        "last_writer_wins_capture",
        "reviewed_before_apply",
        "previewable",
        "reversible",
        "discloses_current_owner"
      ],
      "properties": {
        "channel_ref": { "$ref": "#/$defs/ref" },
        "channel_class": { "$ref": "#/$defs/channel_class" },
        "current_owner_ref": { "$ref": "#/$defs/ref" },
        "current_owner_class": { "$ref": "#/$defs/owner_class" },
        "proposed_owner_ref": { "$ref": "#/$defs/ref" },
        "proposed_owner_class": { "$ref": "#/$defs/owner_class" },
        "change_state": { "$ref": "#/$defs/change_state" },
        "impact_class": { "$ref": "#/$defs/impact_class" },
        "last_writer_wins_capture": { "const": false },
        "reviewed_before_apply": { "const": true },
        "previewable": { "type": "boolean" },
        "reversible": { "const": true },
        "discloses_current_owner": { "const": true }
      }
    },
    "ownership_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_id",
        "surface_label",
        "deployment_mode",
        "install_identity_ref",
        "owner_class",
        "precedence_state",
        "ownership_reason",
        "rollback_identity_ref",
        "inspectable_without_installer",
        "discloses_current_owner",
        "channels"
      ],
      "properties": {
        "ownership_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string", "minLength": 1 },
        "deployment_mode": { "$ref": "#/$defs/deployment_mode" },
        "install_identity_ref": { "$ref": "#/$defs/ref" },
        "owner_class": { "$ref": "#/$defs/owner_class" },
        "precedence_state": { "$ref": "#/$defs/precedence_state" },
        "ownership_reason": { "type": "string", "minLength": 1 },
        "rollback_identity_ref": { "$ref": "#/$defs/ref" },
        "inspectable_without_installer": { "const": true },
        "discloses_current_owner": { "const": true },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/channel_input" }
        },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_id",
        "install_identity_ref",
        "owner_class",
        "deployment_mode",
        "precedence_state",
        "ownership_reason",
        "rollback_identity_ref",
        "discloses_current_owner",
        "discloses_precedence",
        "inspectable_without_installer"
      ],
      "properties": {
        "ownership_id": { "$ref": "#/$defs/id" },
        "install_identity_ref": { "$ref": "#/$defs/ref" },
        "owner_class": { "$ref": "#/$defs/owner_class" },
        "deployment_mode": { "$ref": "#/$defs/deployment_mode" },
        "precedence_state": { "$ref": "#/$defs/precedence_state" },
        "ownership_reason": { "type": "string", "minLength": 1 },
        "rollback_identity_ref": { "$ref": "#/$defs/ref" },
        "discloses_current_owner": { "const": true },
        "discloses_precedence": { "const": true },
        "inspectable_without_installer": { "const": true }
      }
    },
    "resolved_review_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_id",
        "channel_ref",
        "channel_class",
        "current_owner_ref",
        "current_owner_class",
        "proposed_owner_ref",
        "proposed_owner_class",
        "change_state",
        "impact_class",
        "actions",
        "last_writer_wins_capture",
        "reviewed_before_apply",
        "previewable",
        "reversible",
        "discloses_current_owner",
        "is_recovery_path"
      ],
      "properties": {
        "ownership_id": { "$ref": "#/$defs/id" },
        "channel_ref": { "$ref": "#/$defs/ref" },
        "channel_class": { "$ref": "#/$defs/channel_class" },
        "current_owner_ref": { "$ref": "#/$defs/ref" },
        "current_owner_class": { "$ref": "#/$defs/owner_class" },
        "proposed_owner_ref": { "$ref": "#/$defs/ref" },
        "proposed_owner_class": { "$ref": "#/$defs/owner_class" },
        "change_state": { "$ref": "#/$defs/change_state" },
        "impact_class": { "$ref": "#/$defs/impact_class" },
        "actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/association_action" }
        },
        "last_writer_wins_capture": { "const": false },
        "reviewed_before_apply": { "const": true },
        "previewable": { "type": "boolean" },
        "reversible": { "const": true },
        "discloses_current_owner": { "const": true },
        "is_recovery_path": { "type": "boolean" }
      }
    },
    "resolved_recovery_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_id",
        "channel_class",
        "resolves_to_owner_ref",
        "aligned_with_channel_owner",
        "carries_rollback_identity"
      ],
      "properties": {
        "ownership_id": { "$ref": "#/$defs/id" },
        "channel_class": { "$ref": "#/$defs/channel_class" },
        "resolves_to_owner_ref": { "$ref": "#/$defs/ref" },
        "aligned_with_channel_owner": { "const": true },
        "carries_rollback_identity": { "const": true }
      }
    },
    "resolved_recovery_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_id",
        "rollback_identity_ref",
        "recovery_paths",
        "all_paths_aligned_with_owner",
        "all_paths_carry_rollback_identity"
      ],
      "properties": {
        "ownership_id": { "$ref": "#/$defs/id" },
        "rollback_identity_ref": { "$ref": "#/$defs/ref" },
        "recovery_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolved_recovery_path" }
        },
        "all_paths_aligned_with_owner": { "const": true },
        "all_paths_carry_rollback_identity": { "const": true }
      }
    },
    "resolved_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_id",
        "disclosure_card",
        "association_rows",
        "recovery_alignment",
        "owner_and_precedence_disclosed",
        "changes_previewable_and_reversible",
        "ownership_precedence_preserved_in_export"
      ],
      "properties": {
        "ownership_id": { "$ref": "#/$defs/id" },
        "disclosure_card": { "$ref": "#/$defs/resolved_card" },
        "association_rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_review_row" }
        },
        "recovery_alignment": { "$ref": "#/$defs/resolved_recovery_alignment" },
        "owner_and_precedence_disclosed": { "const": true },
        "changes_previewable_and_reversible": { "const": true },
        "ownership_precedence_preserved_in_export": { "const": true },
        "degraded": {
          "oneOf": [{ "$ref": "#/$defs/degraded_state" }, { "type": "null" }]
        }
      }
    },
    "ownership_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/ownership_input" },
        "resolved": { "$ref": "#/$defs/resolved_ownership" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "channel_classes",
        "precedence_states",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_cases",
        "shows_silent_takeover",
        "hides_current_owner",
        "forces_manual_installer_inspection",
        "drops_rollback_identity"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "channel_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/channel_class" }
        },
        "precedence_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/precedence_state" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ownership_case" }
        },
        "shows_silent_takeover": { "const": false },
        "hides_current_owner": { "const": false },
        "forces_manual_installer_inspection": { "const": false },
        "drops_rollback_identity": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "channel_classes",
        "owner_classes",
        "precedence_states",
        "change_states",
        "impact_classes",
        "association_actions",
        "export_fields",
        "deployment_modes",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "channel_classes": { "type": "array", "items": { "type": "string" } },
        "owner_classes": { "type": "array", "items": { "type": "string" } },
        "precedence_states": { "type": "array", "items": { "type": "string" } },
        "change_states": { "type": "array", "items": { "type": "string" } },
        "impact_classes": { "type": "array", "items": { "type": "string" } },
        "association_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "deployment_modes": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "ownership_identity_preserved_across_surfaces",
        "current_owner_and_precedence_always_disclosed",
        "changes_previewable_and_reversible_never_silent",
        "recovery_aligned_with_owner_and_rollback_identity",
        "support_export_reconstructs_ownership",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "ownership_identity_preserved_across_surfaces": { "const": true },
        "current_owner_and_precedence_always_disclosed": { "const": true },
        "changes_previewable_and_reversible_never_silent": { "const": true },
        "recovery_aligned_with_owner_and_rollback_identity": { "const": true },
        "support_export_reconstructs_ownership": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "disclosure_card_reads_single_ownership_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "integration_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "disclosure_card_reads_single_ownership_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "deployment_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "deployment_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
