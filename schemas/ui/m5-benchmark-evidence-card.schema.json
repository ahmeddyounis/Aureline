{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-benchmark-evidence-card.schema.json",
  "title": "Aureline M5 benchmark evidence card",
  "description": "Reusable, copy/export-safe card for benchmark claims. The card binds workflow, budget, corpus or hardware/capture source, freshness, downgrade state, and metric rows to canonical benchmark evidence instead of surface-local benchmark prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "card_id",
    "claim_ref",
    "claim_scope",
    "evidence_source_class",
    "workflow_ref",
    "budget_ref",
    "corpus_ref",
    "hardware_or_capture_ref",
    "metric_rows",
    "freshness_state",
    "downgrade_state",
    "degraded_state",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_benchmark_evidence_card" },
    "schema_version": { "const": 1 },
    "card_id": { "$ref": "#/$defs/id" },
    "claim_ref": { "$ref": "#/$defs/ref" },
    "claim_scope": {
      "type": "string",
      "enum": [
        "methodology_only",
        "aureline_only_reference",
        "head_to_head_comparison",
        "workflow_claim"
      ]
    },
    "evidence_source_class": {
      "type": "string",
      "enum": [
        "lab_run",
        "self_capture",
        "community_report",
        "release_reproduction",
        "methodology_only"
      ]
    },
    "workflow_ref": { "$ref": "#/$defs/ref" },
    "budget_ref": { "$ref": "#/$defs/ref" },
    "corpus_ref": { "$ref": "#/$defs/ref" },
    "hardware_or_capture_ref": { "$ref": "#/$defs/ref" },
    "metric_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric_row" }
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "warm_cached", "stale", "retest_pending", "expired", "quarantined"]
    },
    "downgrade_state": {
      "type": "string",
      "enum": [
        "none",
        "methodology_only",
        "narrowed_to_internal",
        "retest_pending",
        "quarantined",
        "unsupported"
      ]
    },
    "degraded_state": {
      "type": "string",
      "enum": [
        "none",
        "stale_benchmark_evidence",
        "missing_reproduction_pack",
        "incomparable_hardware",
        "narrowed_corpus",
        "self_capture_only",
        "community_unverified"
      ]
    },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "benchmark_report",
          "docs_help",
          "release_notes",
          "support_export",
          "about_card",
          "shiproom_proof"
        ]
      }
    },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "metric_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "label", "value_repr", "unit_label", "threshold_ref", "comparison_basis"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/ref" },
        "value_repr": { "$ref": "#/$defs/ref" },
        "unit_label": { "$ref": "#/$defs/ref" },
        "threshold_ref": { "$ref": "#/$defs/ref" },
        "comparison_basis": {
          "type": "string",
          "enum": [
            "current_baseline",
            "prior_release",
            "head_to_head",
            "not_comparable",
            "methodology_only"
          ]
        }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["text", "json", "markdown"] }
        },
        "export_fields": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "claim_ref",
              "claim_scope",
              "evidence_source_class",
              "workflow_ref",
              "budget_ref",
              "corpus_ref",
              "hardware_or_capture_ref",
              "freshness_state",
              "downgrade_state",
              "degraded_state",
              "metric_rows"
            ]
          }
        },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}

