{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-benchmark-evidence-card.schema.json",
  "title": "Aureline M5 benchmark evidence card",
  "description": "Reusable, copy/export-safe card for benchmark claims. The card binds workflow, budget, corpus or hardware/capture source, freshness, downgrade state, and metric rows to canonical benchmark evidence instead of surface-local benchmark prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "card_id",
    "benchmark_id",
    "claim_ref",
    "claim_scope",
    "evidence_source_class",
    "workflow_ref",
    "budget_ref",
    "measured_value_repr",
    "budget_value_repr",
    "corpus_ref",
    "hardware_or_capture_ref",
    "cold_warm_state",
    "sample_size",
    "extension_set_ref",
    "power_mode",
    "execution_scope",
    "as_of_date",
    "metric_rows",
    "compare_view",
    "freshness_state",
    "downgrade_state",
    "degraded_state",
    "downgrade_banner",
    "caveat_summary_refs",
    "trace_report_export",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_benchmark_evidence_card" },
    "schema_version": { "const": 1 },
    "card_id": { "$ref": "#/$defs/id" },
    "benchmark_id": { "$ref": "#/$defs/id" },
    "claim_ref": { "$ref": "#/$defs/ref" },
    "claim_scope": {
      "type": "string",
      "enum": [
        "methodology_only",
        "aureline_only_reference",
        "head_to_head_comparison",
        "workflow_claim"
      ]
    },
    "evidence_source_class": {
      "type": "string",
      "enum": [
        "lab_reference_run",
        "self_capture",
        "design_partner_result",
        "community_report",
        "imported_evidence",
        "methodology_only"
      ]
    },
    "workflow_ref": { "$ref": "#/$defs/ref" },
    "budget_ref": { "$ref": "#/$defs/ref" },
    "measured_value_repr": { "$ref": "#/$defs/ref" },
    "budget_value_repr": { "$ref": "#/$defs/ref" },
    "corpus_ref": { "$ref": "#/$defs/ref" },
    "hardware_or_capture_ref": { "$ref": "#/$defs/ref" },
    "cold_warm_state": {
      "type": "string",
      "enum": ["cold", "warm", "mixed", "not_applicable"]
    },
    "sample_size": { "type": "integer", "minimum": 1 },
    "extension_set_ref": { "$ref": "#/$defs/ref" },
    "power_mode": {
      "type": "string",
      "enum": ["plugged_in", "battery", "low_power", "performance", "managed_policy", "unknown"]
    },
    "execution_scope": {
      "type": "string",
      "enum": ["local_only", "remote_attached", "managed_remote", "mixed"]
    },
    "as_of_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "metric_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric_row" }
    },
    "compare_view": { "$ref": "#/$defs/compare_view" },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "warm_cached", "stale", "retest_pending", "expired", "quarantined"]
    },
    "downgrade_state": {
      "type": "string",
      "enum": [
        "none",
        "methodology_only",
        "narrowed_to_internal",
        "retest_pending",
        "quarantined",
        "unsupported"
      ]
    },
    "degraded_state": {
      "type": "string",
      "enum": [
        "none",
        "stale_benchmark_evidence",
        "missing_reproduction_pack",
        "incomparable_hardware",
        "narrowed_corpus",
        "self_capture_only",
        "design_partner_limited",
        "community_unverified",
        "imported_evidence_unverified"
      ]
    },
    "downgrade_banner": { "$ref": "#/$defs/downgrade_banner" },
    "caveat_summary_refs": { "$ref": "#/$defs/ref_array" },
    "trace_report_export": { "$ref": "#/$defs/trace_report_export" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "benchmark_report",
          "docs_help",
          "release_notes",
          "support_export",
          "about_card",
          "shiproom_proof"
        ]
      }
    },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "metric_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "label", "value_repr", "budget_value_repr", "unit_label", "threshold_ref", "comparison_basis"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/ref" },
        "value_repr": { "$ref": "#/$defs/ref" },
        "budget_value_repr": { "$ref": "#/$defs/ref" },
        "unit_label": { "$ref": "#/$defs/ref" },
        "threshold_ref": { "$ref": "#/$defs/ref" },
        "comparison_basis": {
          "type": "string",
          "enum": [
            "current_baseline",
            "prior_release",
            "head_to_head",
            "not_comparable",
            "methodology_only"
          ]
        }
      }
    },
    "compare_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compare_mode", "baseline_ref", "comparison_basis", "comparable", "caveat_summary_refs"],
      "properties": {
        "compare_mode": {
          "type": "string",
          "enum": ["single_claim", "prior_release", "head_to_head", "self_to_reference", "community_to_reference"]
        },
        "baseline_ref": { "$ref": "#/$defs/ref" },
        "comparison_basis": {
          "type": "string",
          "enum": ["current_baseline", "prior_release", "head_to_head", "not_comparable", "methodology_only"]
        },
        "comparable": { "type": "boolean" },
        "caveat_summary_refs": { "$ref": "#/$defs/ref_array" }
      }
    },
    "downgrade_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shown", "label", "summary_ref", "reason_refs"],
      "properties": {
        "shown": { "type": "boolean" },
        "label": {
          "type": "string",
          "enum": [
            "none",
            "current",
            "stale_retest_pending",
            "methodology_only",
            "incomparable",
            "self_capture_only",
            "design_partner_limited",
            "community_unverified",
            "imported_evidence_unverified",
            "quarantined"
          ]
        },
        "summary_ref": { "$ref": "#/$defs/ref" },
        "reason_refs": { "$ref": "#/$defs/ref_array" }
      }
    },
    "trace_report_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_ref",
        "report_ref",
        "formats",
        "includes_benchmark_id",
        "includes_caveat_summaries",
        "includes_workflow_budget_truth",
        "includes_environment_truth"
      ],
      "properties": {
        "trace_ref": { "$ref": "#/$defs/ref" },
        "report_ref": { "$ref": "#/$defs/ref" },
        "formats": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["trace", "json", "markdown", "support_package"] }
        },
        "includes_benchmark_id": { "const": true },
        "includes_caveat_summaries": { "const": true },
        "includes_workflow_budget_truth": { "const": true },
        "includes_environment_truth": { "const": true }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["text", "json", "markdown"] }
        },
        "export_fields": {
          "type": "array",
          "minItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "benchmark_id",
              "claim_ref",
              "claim_scope",
              "evidence_source_class",
              "workflow_ref",
              "budget_ref",
              "measured_value_repr",
              "budget_value_repr",
              "corpus_ref",
              "hardware_or_capture_ref",
              "cold_warm_state",
              "sample_size",
              "extension_set_ref",
              "power_mode",
              "execution_scope",
              "as_of_date",
              "compare_view",
              "freshness_state",
              "downgrade_state",
              "degraded_state",
              "caveat_summary_refs",
              "trace_report_export",
              "metric_rows"
            ]
          }
        },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
