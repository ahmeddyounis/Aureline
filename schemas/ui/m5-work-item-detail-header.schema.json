{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-work-item-detail-header.schema.json",
  "title": "Aureline M5 work-item detail header",
  "description": "Canonical reusable work-item detail header. Names the canonical work item (kind) and the provider authority behind it, so the header always states identity and who owns the object before any transition or comment. Governed by the M5 work-item component matrix in crates/aureline-provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_item_object_id",
    "title",
    "work_item_kind",
    "provider_authority"
  ],
  "properties": {
    "work_item_object_id": { "$ref": "#/$defs/non_empty_string" },
    "title": { "$ref": "#/$defs/non_empty_string" },
    "work_item_kind": { "$ref": "#/$defs/work_item_kind" },
    "provider_authority": { "$ref": "#/$defs/provider_authority" },
    "canonical_reference": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "work_item_kind": {
      "enum": ["issue", "task", "incident", "change_request", "epic", "unknown_kind"]
    },
    "provider_authority": {
      "enum": [
        "provider_owned",
        "local_draft",
        "mirrored_read_only",
        "imported_snapshot",
        "unlinked_local",
        "policy_pinned"
      ]
    }
  }
}
