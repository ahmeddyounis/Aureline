{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-annotation-row.schema.json",
  "title": "Aureline M5 annotation row",
  "description": "Reusable diagnostic/review annotation row that keeps diagnostic id, anchor, severity, confidence, freshness, suppression, and remediation separate across review panes, diagnostics, project health, support export, and release proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "row_id",
    "annotation_id",
    "diagnostic_id",
    "anchor_ref",
    "source_packet_ref",
    "annotation_kind",
    "severity",
    "confidence",
    "freshness_state",
    "degraded_state",
    "suppression_state",
    "remediation",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_annotation_row" },
    "schema_version": { "const": 1 },
    "row_id": { "$ref": "#/$defs/id" },
    "annotation_id": { "$ref": "#/$defs/id" },
    "diagnostic_id": { "$ref": "#/$defs/id" },
    "anchor_ref": { "$ref": "#/$defs/ref" },
    "source_packet_ref": { "$ref": "#/$defs/ref" },
    "annotation_kind": {
      "type": "string",
      "enum": ["diagnostic", "review_finding", "policy_finding", "build_annotation", "package_annotation"]
    },
    "severity": { "$ref": "#/$defs/severity" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "degraded_state": {
      "type": "string",
      "enum": ["none", "stale", "superseded", "partial", "policy_hidden", "evidence_missing", "no_fix_yet"]
    },
    "suppression_state": { "$ref": "#/$defs/suppression_state" },
    "remediation": { "$ref": "#/$defs/remediation" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical", "blocking"] },
    "confidence": { "type": "string", "enum": ["confirmed", "high", "medium", "low", "unknown"] },
    "freshness_state": { "type": "string", "enum": ["current", "live", "warm_cached", "stale", "superseded", "partial", "blocked", "policy_hidden", "expired", "no_fix_yet", "unknown"] },
    "suppression_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_ref", "review_ref", "visible_in_export"],
      "properties": {
        "state": { "type": "string", "enum": ["unsuppressed", "suppressed_until_review", "suppressed_by_policy", "exception_expired"] },
        "reason_ref": { "$ref": "#/$defs/ref" },
        "review_ref": { "$ref": "#/$defs/ref" },
        "visible_in_export": { "const": true }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_label", "fix_available", "owner_ref", "due_or_review_ref", "blocked_reason"],
      "properties": {
        "action_label": { "type": "string", "enum": ["inspect", "apply_fix", "open_review", "suppress_until_review", "policy_exception_review", "no_fix_yet"] },
        "fix_available": { "type": "boolean" },
        "owner_ref": { "$ref": "#/$defs/ref" },
        "due_or_review_ref": { "$ref": "#/$defs/ref" },
        "blocked_reason": { "$ref": "#/$defs/ref" }
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["review_pane", "project_health_center", "companion_client", "support_export", "release_proof"] }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } },
        "export_fields": { "$ref": "#/$defs/ref_array" },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
