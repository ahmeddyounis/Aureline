{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-side-by-side-import-sheet.schema.json",
  "title": "Aureline M5 side-by-side import sheet",
  "description": "Stable UI contract for an M5 side-by-side import sheet. The sheet keeps source install, state sharing, handler ownership, rollback checkpoint, and keyboard route explicit so side-by-side or portable imports never devolve into hidden sharing or last-writer-wins handler capture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "import_source_ref",
    "target_install_ref",
    "handler_ownership_ref",
    "state_sharing",
    "import_choice",
    "last_writer_wins_capture",
    "discloses_handler_ownership",
    "isolation_preserved",
    "rollback_checkpoint_preserved",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_side_by_side_import_sheet" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "import_source_ref": { "$ref": "#/$defs/ref" },
    "target_install_ref": { "$ref": "#/$defs/ref" },
    "handler_ownership_ref": { "$ref": "#/$defs/ref" },
    "state_sharing": {
      "enum": ["isolated", "shared_read_only", "shared_writable", "one_time_copy"]
    },
    "import_choice": {
      "enum": ["one_time_import", "one_time_copy", "link_shared", "skip"]
    },
    "last_writer_wins_capture": { "const": false },
    "discloses_handler_ownership": { "const": true },
    "isolation_preserved": { "const": true },
    "rollback_checkpoint_preserved": { "type": "boolean" },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "downgrade_trigger": {
      "enum": ["handler_ownership_contested", "state_root_unavailable", "provenance_incomplete"]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
