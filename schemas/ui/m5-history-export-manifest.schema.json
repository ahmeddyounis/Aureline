{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-history-export-manifest.schema.json",
  "title": "Aureline M5 history-export-manifest resolution",
  "description": "Export-safe shape of a single resolved M5 history-export manifest — the manifest half of the M5 retention/export-card & history-export-manifest primitive pair (see m5-retention-export-card.schema.json for the full matrix packet). One manifest resolution carries its class, export-redaction posture, primary cross-baseline comparison, and derived disposition (full-evidence/redacted-share/policy-restricted/lineage-incomplete/raw-body-withheld/export-blocked), whether it is shareable, whether it omits raw bodies, whether its actor lineage, checkpoint identity, and scope are preserved, and its bounded inspect/view-lineage/review-redaction/export/request actions. A manifest never defaults to a raw sensitive content body and always keeps its primary baseline explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "resolved"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_class",
        "export_redaction",
        "primary_baseline",
        "preserves_actor_lineage",
        "preserves_checkpoint_identity",
        "preserves_scope",
        "includes_raw_bodies",
        "export_path_ready",
        "manifest_label"
      ],
      "properties": {
        "manifest_class": {
          "enum": [
            "support_bundle",
            "recovery_evidence",
            "audit_trail",
            "migration_session",
            "offline_mirror",
            "redacted_share"
          ]
        },
        "export_redaction": {
          "enum": [
            "full_metadata",
            "paths_redacted",
            "bodies_omitted",
            "credentials_scrubbed",
            "policy_restricted",
            "export_blocked"
          ]
        },
        "primary_baseline": {
          "enum": [
            "current_vs_snapshot",
            "snapshot_vs_disk",
            "snapshot_vs_git_head",
            "snapshot_vs_snapshot"
          ]
        },
        "preserves_actor_lineage": { "type": "boolean" },
        "preserves_checkpoint_identity": { "type": "boolean" },
        "preserves_scope": { "type": "boolean" },
        "includes_raw_bodies": { "type": "boolean" },
        "export_path_ready": { "type": "boolean" },
        "manifest_label": { "type": "string", "minLength": 1 }
      }
    },
    "resolved": {
      "type": "object",
      "required": [
        "manifest_class",
        "export_redaction",
        "primary_baseline",
        "manifest_label",
        "manifest_disposition",
        "available_actions",
        "is_shareable",
        "needs_attention",
        "preserves_actor_lineage",
        "preserves_checkpoint_identity",
        "preserves_scope",
        "omits_raw_bodies",
        "baseline_is_explicit",
        "flattens_into_generic_download"
      ],
      "properties": {
        "manifest_disposition": {
          "enum": [
            "full_evidence",
            "redacted_share",
            "policy_restricted",
            "lineage_incomplete",
            "raw_body_withheld",
            "export_blocked"
          ]
        },
        "omits_raw_bodies": { "const": true },
        "baseline_is_explicit": { "const": true },
        "flattens_into_generic_download": { "const": false }
      }
    }
  }
}
