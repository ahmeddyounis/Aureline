{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-embedded-boundary-component-matrix.schema.json",
  "title": "Aureline M5 docs-pane-header, embedded-origin-bar, boundary-fact-grid, marketplace-account-boundary-card, auth-handoff-card, remote-service-dashboard-header, open-in-browser-handoff-row, and embedded-state-panel component matrix",
  "description": "Export-safe packet freezing Aureline's reusable embedded / browser-handoff boundary UI components. The packet names every embedded or browser-handoff surface M5 claims that still ships its own owner/origin chrome — docs-pane headers, embedded-origin bars, boundary-fact grids, marketplace/account boundary cards, auth-handoff cards, remote/service dashboard headers, open-in-browser handoff rows, and embedded-state panels — and binds each to the claimed M5 surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: the single controlled boundary-disposition vocabulary consumers bind to (live_first_party_local, live_first_party_hosted, live_provider_owned, stale_snapshot, offline_snapshot, provider_blocked, browser_handoff_only, capability_limited, not_evaluated), plus family-specific owner classes, data-exit boundaries, browser-handoff kinds, capability limits, freshness states, and account scopes, all bound from the frozen M5 auth-boundary and public-truth object model. Hard invariants forbid imitating native permission or irreversible-approval UI, hiding owner/origin or browser fallback behind menus only, rendering a stale/offline/provider-blocked pane as fresh first-party local truth, and embedding a high-risk approval without a native step-up. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_docs_pane_header_embedded_origin_bar_boundary_fact_grid_marketplace_account_boundary_card_auth_handoff_card_remote_service_dashboard_header_open_in_browser_handoff_row_and_embedded_state_panel_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "docs_pane_header",
        "embedded_origin_bar",
        "boundary_fact_grid",
        "marketplace_account_boundary_card",
        "auth_handoff_card",
        "remote_service_dashboard_header",
        "open_in_browser_handoff_row",
        "embedded_state_panel"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "boundary_disposition": {
      "enum": [
        "live_first_party_local",
        "live_first_party_hosted",
        "live_provider_owned",
        "stale_snapshot",
        "offline_snapshot",
        "provider_blocked",
        "browser_handoff_only",
        "capability_limited",
        "not_evaluated"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "boundary_dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "imitates_native_permission_or_approval_ui",
        "hides_owner_origin_or_browser_fallback_in_menus_only",
        "renders_stale_or_blocked_as_fresh_first_party_truth",
        "embeds_high_risk_approval_without_native_step_up"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "boundary_dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/boundary_disposition" }
        },
        "owner_classes": { "type": "array" },
        "data_exit_boundaries": { "type": "array" },
        "browser_handoff_kinds": { "type": "array" },
        "capability_limits": { "type": "array" },
        "freshness_states": { "type": "array" },
        "account_scopes": { "type": "array" },
        "degraded_reasons": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "imitates_native_permission_or_approval_ui": { "const": false },
        "hides_owner_origin_or_browser_fallback_in_menus_only": { "const": false },
        "renders_stale_or_blocked_as_fresh_first_party_truth": { "const": false },
        "embeds_high_risk_approval_without_native_step_up": { "const": false }
      }
    }
  }
}
