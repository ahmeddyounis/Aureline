{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-run-comparison-table-compare-guard-banner-controls.schema.json",
  "title": "Aureline M5 run comparison tables and compare guard banners",
  "description": "Export-safe packet implementing the reusable M5 run-comparison-table and compare-guard-banner components in two co-equal control vectors. Each comparison table names its baseline and candidate run identities, metric values, delta, threshold state, confidence note, comparator type, and explicit code/data/environment/hardware difference summaries, and offers first-class open-baseline/open-current/export-comparison actions; its fairness class is derived from the comparability state, so a not-comparable, confounded, or insufficiently-overlapping comparison can never read as a fair apples-to-apples baseline and the differences always stay beside the delta. Each guard banner names its guard reason and guard state, discloses what is comparable/partially comparable/not comparable including which lineage fields are missing, which environment/data/code factors changed, and what was redacted, and offers a first-class open-full-lineage action; its guard comparability class is derived from the guard state, so a blocked or overridden guard is never silently bypassed. The four reproducibility trust labels (reproducible, likely_reproducible, needs_rerun, context_incomplete) remain controlled labels used consistently across both vectors. Every next step names one stable run/notebook/dataset/docs deep link rather than an ephemeral overlay or hidden route. No component masks provenance or sensitivity state, hides the baseline or candidate identity, hides the difference factors beside the delta, implies apples-to-apples without parity, or invents an alternate state label; raw metric payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "comparison_tables",
    "guard_banners",
    "downgrade_triggers",
    "consumer_surfaces",
    "compare_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_run_comparison_tables_and_compare_guard_banners_with_baseline_candidate_identity_confounder_disclosure_and_no_fair_delta_claims_when_parity_evidence_is_incomplete_across_claimed_m5_compare_flows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "comparison_tables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run_comparison_table" }
    },
    "guard_banners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/compare_guard_banner" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "compare_review": { "$ref": "#/$defs/compare_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "comparison_axis_class": {
      "enum": [
        "metric_delta",
        "param_diff",
        "dataset_diff",
        "env_diff",
        "code_revision_diff",
        "artifact_diff"
      ]
    },
    "comparability_state": {
      "enum": [
        "comparable",
        "comparable_with_caveats",
        "not_comparable",
        "confounded",
        "insufficient_overlap",
        "unknown_comparability"
      ]
    },
    "fairness_class": {
      "enum": ["fair_baseline", "caveated_baseline", "unfair_baseline", "unproven_baseline"]
    },
    "compare_guard_reason": {
      "enum": [
        "dataset_mismatch",
        "environment_drift",
        "code_revision_gap",
        "metric_definition_change",
        "sample_size_imbalance",
        "confounder_present"
      ]
    },
    "compare_guard_state": {
      "enum": [
        "comparison_permitted",
        "comparison_caveated",
        "comparison_blocked",
        "guard_acknowledged",
        "guard_overridden_by_choice",
        "guard_unavailable"
      ]
    },
    "guard_comparability_class": {
      "enum": [
        "comparable_permitted",
        "partially_comparable",
        "overridden_comparison",
        "not_comparable_blocked",
        "guard_unavailable"
      ]
    },
    "deep_link_kind": {
      "enum": [
        "run_object",
        "notebook_location",
        "dataset_catalog_anchor",
        "docs_anchor",
        "no_deep_link"
      ]
    },
    "run_comparison_action": {
      "enum": [
        "open_baseline_run",
        "open_current_run",
        "export_comparison",
        "open_full_lineage",
        "open_deep_link",
        "copy_comparison_id"
      ]
    },
    "compare_guard_action": {
      "enum": [
        "open_full_lineage",
        "review_comparability",
        "view_changed_factors",
        "acknowledge_guard",
        "open_deep_link",
        "copy_guard_id"
      ]
    },
    "disposition": {
      "enum": [
        "local_run",
        "managed_run",
        "imported_run",
        "manual_attach",
        "reproducible",
        "likely_reproducible",
        "needs_rerun",
        "context_incomplete"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "run_origin_and_revision",
        "provenance_and_sensitivity",
        "export_scope"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook_surface",
        "experiment_run_dashboard",
        "run_comparison_view",
        "dataset_catalog",
        "share_review_sheet",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "notebook_ui",
        "experiment_dashboard_ui",
        "comparison_ui",
        "data_catalog_ui",
        "lineage_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_origin_unstated",
        "code_revision_unstated",
        "environment_fingerprint_unstated",
        "dataset_provenance_severed",
        "comparability_overstated",
        "sensitivity_class_unstated",
        "export_scope_unstated",
        "raw_payload_exposed_by_default",
        "cached_state_hidden",
        "imported_run_unmarked",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "run_comparison_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "table_id",
        "comparison_label",
        "comparison_axis",
        "comparability_state",
        "fairness_class",
        "claims_fair_baseline",
        "baseline_run_id",
        "baseline_run_label",
        "candidate_run_id",
        "candidate_run_label",
        "metric_value_note",
        "delta_note",
        "threshold_state_note",
        "confidence_note",
        "comparator_type_note",
        "code_difference_note",
        "data_difference_note",
        "environment_difference_note",
        "hardware_difference_note",
        "caveat_note",
        "not_comparable_note",
        "confounder_note",
        "insufficient_overlap_note",
        "unknown_comparability_note",
        "comparability_and_parity_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "table_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_baseline_or_candidate_identity",
        "hides_difference_factors_beside_delta",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "run_comparison_table" },
        "table_id": { "$ref": "#/$defs/non_empty_string" },
        "comparison_label": { "$ref": "#/$defs/non_empty_string" },
        "comparison_axis": { "$ref": "#/$defs/comparison_axis_class" },
        "comparability_state": { "$ref": "#/$defs/comparability_state" },
        "fairness_class": { "$ref": "#/$defs/fairness_class" },
        "claims_fair_baseline": { "type": "boolean" },
        "baseline_run_id": { "$ref": "#/$defs/non_empty_string" },
        "baseline_run_label": { "$ref": "#/$defs/non_empty_string" },
        "candidate_run_id": { "$ref": "#/$defs/non_empty_string" },
        "candidate_run_label": { "$ref": "#/$defs/non_empty_string" },
        "metric_value_note": { "$ref": "#/$defs/non_empty_string" },
        "delta_note": { "$ref": "#/$defs/non_empty_string" },
        "threshold_state_note": { "$ref": "#/$defs/non_empty_string" },
        "confidence_note": { "$ref": "#/$defs/non_empty_string" },
        "comparator_type_note": { "$ref": "#/$defs/non_empty_string" },
        "code_difference_note": { "$ref": "#/$defs/non_empty_string" },
        "data_difference_note": { "$ref": "#/$defs/non_empty_string" },
        "environment_difference_note": { "$ref": "#/$defs/non_empty_string" },
        "hardware_difference_note": { "$ref": "#/$defs/non_empty_string" },
        "caveat_note": { "type": "string" },
        "not_comparable_note": { "type": "string" },
        "confounder_note": { "type": "string" },
        "insufficient_overlap_note": { "type": "string" },
        "unknown_comparability_note": { "type": "string" },
        "comparability_and_parity_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "table_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_baseline_run" } },
            { "contains": { "const": "open_current_run" } },
            { "contains": { "const": "export_comparison" } }
          ],
          "items": { "$ref": "#/$defs/run_comparison_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_baseline_or_candidate_identity": { "const": false },
        "hides_difference_factors_beside_delta": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "compare_guard_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "banner_id",
        "banner_label",
        "guard_reason",
        "guard_state",
        "guard_class",
        "claims_permits_fair_comparison",
        "comparability_disclosure_note",
        "missing_lineage_fields_note",
        "changed_factors_note",
        "redaction_note",
        "guard_reason_note",
        "partial_comparability_note",
        "override_warning",
        "blocked_note",
        "guard_unavailable_note",
        "comparability_and_parity_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "banner_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_baseline_or_candidate_identity",
        "hides_difference_factors_beside_delta",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "compare_guard_banner" },
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "banner_label": { "$ref": "#/$defs/non_empty_string" },
        "guard_reason": { "$ref": "#/$defs/compare_guard_reason" },
        "guard_state": { "$ref": "#/$defs/compare_guard_state" },
        "guard_class": { "$ref": "#/$defs/guard_comparability_class" },
        "claims_permits_fair_comparison": { "type": "boolean" },
        "comparability_disclosure_note": { "$ref": "#/$defs/non_empty_string" },
        "missing_lineage_fields_note": { "$ref": "#/$defs/non_empty_string" },
        "changed_factors_note": { "$ref": "#/$defs/non_empty_string" },
        "redaction_note": { "$ref": "#/$defs/non_empty_string" },
        "guard_reason_note": { "$ref": "#/$defs/non_empty_string" },
        "partial_comparability_note": { "type": "string" },
        "override_warning": { "type": "string" },
        "blocked_note": { "type": "string" },
        "guard_unavailable_note": { "type": "string" },
        "comparability_and_parity_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "banner_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_full_lineage" } },
            { "contains": { "const": "review_comparability" } }
          ],
          "items": { "$ref": "#/$defs/compare_guard_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_baseline_or_candidate_identity": { "const": false },
        "hides_difference_factors_beside_delta": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "compare_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_table_shows_baseline_and_candidate",
        "comparison_table_shows_delta_and_difference_factors",
        "comparison_table_offers_open_runs_and_export",
        "compare_guard_banner_shows_comparability_and_reason",
        "compare_guard_banner_offers_full_lineage_and_review",
        "fairness_and_comparability_derived_never_asserted",
        "unfair_or_unproven_never_shown_as_fair",
        "differences_shown_beside_delta",
        "apples_to_apples_never_implied_without_parity",
        "reproducibility_trust_labels_used_consistently",
        "every_next_step_names_stable_deep_link",
        "reuses_existing_comparability_vocabulary",
        "provenance_and_sensitivity_state_visible",
        "changed_factors_and_missing_lineage_visible",
        "redaction_state_visible_before_share",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_ui_reads_single_source",
        "compare_guard_surface_reads_single_source",
        "baseline_and_candidate_visible_before_trust",
        "difference_factors_visible_before_trust",
        "support_export_shows_component_truth",
        "help_docs_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
