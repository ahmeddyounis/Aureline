{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-importer-diff-row.schema.json",
  "title": "Aureline M5 importer diff row",
  "description": "Reusable row for migration importer diffs. It preserves stable outcome vocabulary, compatibility truth, bridge-required state, checkpoint/restore context, and copy/export-safe evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "row_id",
    "migration_session_ref",
    "source_profile_ref",
    "target_ref",
    "migration_domain",
    "source_object_ref",
    "source_value",
    "target_object_ref",
    "target_value",
    "translated_result",
    "outcome_state",
    "compatibility_state",
    "mapping_basis",
    "reason_class",
    "reason_detail_note",
    "lossy_mapping",
    "manual_review_action",
    "docs_action",
    "checkpoint_context",
    "degraded_state",
    "export_safe_identifiers",
    "post_apply_summary_visible",
    "support_export_visible",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_importer_diff_row" },
    "schema_version": { "const": 1 },
    "row_id": { "$ref": "#/$defs/id" },
    "migration_session_ref": { "$ref": "#/$defs/ref" },
    "source_profile_ref": { "$ref": "#/$defs/ref" },
    "target_ref": { "$ref": "#/$defs/ref" },
    "migration_domain": {
      "type": "string",
      "enum": [
        "settings",
        "shortcuts",
        "themes_and_visuals",
        "snippets_and_templates",
        "tasks_and_run_configs",
        "launch_debug",
        "extensions_and_providers",
        "workspace_metadata",
        "profiles_and_layout",
        "docs_and_tours",
        "bridge_metadata",
        "other"
      ]
    },
    "source_object_ref": { "$ref": "#/$defs/ref" },
    "source_value": { "$ref": "#/$defs/value" },
    "target_object_ref": { "$ref": "#/$defs/nullable_ref" },
    "target_value": { "$ref": "#/$defs/nullable_value" },
    "translated_result": { "$ref": "#/$defs/value" },
    "outcome_state": {
      "type": "string",
      "enum": ["imported", "mapped", "skipped", "manual_review", "bridge_required", "unsupported"]
    },
    "compatibility_state": {
      "type": "string",
      "enum": [
        "compatible",
        "native_alternative",
        "bridge_required",
        "manual_review",
        "unsupported",
        "policy_blocked",
        "insufficient_evidence"
      ]
    },
    "mapping_basis": {
      "type": "string",
      "enum": [
        "exact_identity",
        "semantic_equivalent",
        "capability_based",
        "bridge_adapter",
        "name_heuristic",
        "user_override",
        "not_applicable"
      ]
    },
    "reason_class": {
      "type": "string",
      "enum": [
        "exact_equivalent_available",
        "semantic_equivalent_available",
        "capability_mapping_available",
        "user_declined_import",
        "policy_excludes_import",
        "existing_state_retained",
        "conflict_requires_review",
        "bridge_needed_for_parity",
        "target_feature_not_supported",
        "source_artifact_unreadable",
        "source_version_not_qualified",
        "insufficient_evidence"
      ]
    },
    "reason_detail_note": { "$ref": "#/$defs/value" },
    "lossy_mapping": { "type": "boolean" },
    "manual_review_action": { "$ref": "#/$defs/review_action" },
    "docs_action": { "$ref": "#/$defs/review_action" },
    "checkpoint_context": { "$ref": "#/$defs/checkpoint_context" },
    "degraded_state": {
      "type": "string",
      "enum": [
        "none",
        "bridge_required_import",
        "checkpoint_missing",
        "restore_unavailable",
        "compatibility_unknown",
        "source_unreadable",
        "policy_blocked"
      ]
    },
    "export_safe_identifiers": { "$ref": "#/$defs/export_safe_identifiers" },
    "post_apply_summary_visible": { "type": "boolean" },
    "support_export_visible": { "type": "boolean" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["first_run_import_preview", "migration_center", "cli_headless", "docs_help", "support_export"]
      }
    },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome_state": {
            "enum": ["imported", "mapped", "bridge_required"]
          }
        },
        "required": ["outcome_state"]
      },
      "then": {
        "properties": {
          "target_object_ref": { "type": "string", "minLength": 1 },
          "target_value": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_state": { "const": "bridge_required" }
        },
        "required": ["outcome_state"]
      },
      "then": {
        "properties": {
          "compatibility_state": { "const": "bridge_required" },
          "mapping_basis": { "const": "bridge_adapter" },
          "degraded_state": { "const": "bridge_required_import" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "value": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "nullable_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ref" }
      ]
    },
    "nullable_value": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/value" }
      ]
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "checkpoint_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_required", "checkpoint_ref", "restore_available", "restore_ref"],
      "properties": {
        "checkpoint_required": { "type": "boolean" },
        "checkpoint_ref": { "$ref": "#/$defs/nullable_ref" },
        "restore_available": { "type": "boolean" },
        "restore_ref": { "$ref": "#/$defs/nullable_ref" }
      }
    },
    "review_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_kind",
        "label",
        "docs_help_ref",
        "required_before_completion"
      ],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "action_kind": {
          "type": "string",
          "enum": [
            "none",
            "review_mapping",
            "keep_skipped",
            "install_bridge",
            "acknowledge_unsupported",
            "open_docs"
          ]
        },
        "label": { "$ref": "#/$defs/value" },
        "docs_help_ref": { "$ref": "#/$defs/ref" },
        "required_before_completion": { "type": "boolean" }
      }
    },
    "export_safe_identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "migration_session_ref",
        "source_object_ref",
        "target_object_ref",
        "support_packet_ref"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/id" },
        "migration_session_ref": { "$ref": "#/$defs/ref" },
        "source_object_ref": { "$ref": "#/$defs/ref" },
        "target_object_ref": { "$ref": "#/$defs/nullable_ref" },
        "support_packet_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["text", "json", "markdown"] }
        },
        "export_fields": {
          "type": "array",
          "minItems": 23,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "row_id",
              "migration_session_ref",
              "source_profile_ref",
              "target_ref",
              "migration_domain",
              "source_object_ref",
              "source_value",
              "target_object_ref",
              "target_value",
              "translated_result",
              "outcome_state",
              "compatibility_state",
              "mapping_basis",
              "reason_class",
              "reason_detail_note",
              "lossy_mapping",
              "manual_review_action",
              "docs_action",
              "checkpoint_context",
              "degraded_state",
              "export_safe_identifiers",
              "post_apply_summary_visible",
              "support_export_visible"
            ]
          }
        },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
