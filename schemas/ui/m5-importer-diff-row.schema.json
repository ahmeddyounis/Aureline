{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-importer-diff-row.schema.json",
  "title": "Aureline M5 importer diff row",
  "description": "Reusable row for migration importer diffs. It preserves stable outcome vocabulary, compatibility truth, bridge-required state, checkpoint/restore context, and copy/export-safe evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "row_id",
    "migration_session_ref",
    "source_profile_ref",
    "target_ref",
    "migration_domain",
    "outcome_state",
    "compatibility_state",
    "mapping_basis",
    "checkpoint_context",
    "degraded_state",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_importer_diff_row" },
    "schema_version": { "const": 1 },
    "row_id": { "$ref": "#/$defs/id" },
    "migration_session_ref": { "$ref": "#/$defs/ref" },
    "source_profile_ref": { "$ref": "#/$defs/ref" },
    "target_ref": { "$ref": "#/$defs/ref" },
    "migration_domain": {
      "type": "string",
      "enum": [
        "settings",
        "shortcuts",
        "themes_and_visuals",
        "snippets_and_templates",
        "tasks_and_run_configs",
        "launch_debug",
        "extensions_and_providers",
        "workspace_metadata",
        "profiles_and_layout",
        "docs_and_tours",
        "bridge_metadata",
        "other"
      ]
    },
    "outcome_state": {
      "type": "string",
      "enum": ["imported", "mapped", "skipped", "manual_review", "bridge_required", "unsupported"]
    },
    "compatibility_state": {
      "type": "string",
      "enum": [
        "compatible",
        "native_alternative",
        "bridge_required",
        "manual_review",
        "unsupported",
        "policy_blocked",
        "insufficient_evidence"
      ]
    },
    "mapping_basis": {
      "type": "string",
      "enum": [
        "exact_identity",
        "semantic_equivalent",
        "capability_based",
        "bridge_adapter",
        "name_heuristic",
        "user_override",
        "not_applicable"
      ]
    },
    "checkpoint_context": { "$ref": "#/$defs/checkpoint_context" },
    "degraded_state": {
      "type": "string",
      "enum": [
        "none",
        "bridge_required_import",
        "checkpoint_missing",
        "restore_unavailable",
        "compatibility_unknown",
        "source_unreadable",
        "policy_blocked"
      ]
    },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["first_run_import_preview", "migration_center", "cli_headless", "docs_help", "support_export"]
      }
    },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "nullable_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ref" }
      ]
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "checkpoint_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_required", "checkpoint_ref", "restore_available", "restore_ref"],
      "properties": {
        "checkpoint_required": { "type": "boolean" },
        "checkpoint_ref": { "$ref": "#/$defs/nullable_ref" },
        "restore_available": { "type": "boolean" },
        "restore_ref": { "$ref": "#/$defs/nullable_ref" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["text", "json", "markdown"] }
        },
        "export_fields": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "migration_session_ref",
              "source_profile_ref",
              "target_ref",
              "migration_domain",
              "outcome_state",
              "compatibility_state",
              "mapping_basis",
              "checkpoint_context",
              "degraded_state"
            ]
          }
        },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}

