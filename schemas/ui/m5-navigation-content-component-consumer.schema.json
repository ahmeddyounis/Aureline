{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-navigation-content-component-consumer.schema.json",
  "title": "Aureline M5 navigation-content component consumer adoption",
  "description": "M05-1113 consumer-adoption lane over the frozen M5 navigation-content component matrix. Proves that the six reusable navigation / content component families (tab strip, breadcrumbs, tree view, list view, table/grid, panel header) are reused as shared product primitives across the claimed M5 navigation/content consumer classes — shell/explorer, search/graph, review, request/data, help center, and support/export + release packets — rather than being reinvented as per-surface container chrome. Each row points back to exactly one canonical component family (its matrix schema) and the one canonical B132 controls contract (schema + doc + release-proof artifact) its family group belongs to, and preserves the identical active-context, hierarchy/path, disclosure-state, selection-versus-current, pinned/preview/read-only, exact/loaded/all-matching count-scope, local-action-budget, and overflow/freshness labels plus the frozen navigation-content disposition vocabulary. The same active-context/count/hierarchy state renders with one vocabulary and one component family across every claimed consumer (AC1); help/support/release packets drop bespoke per-surface prose (AC2). The five spec guardrails stay false per row: no consumer lets tabs masquerade as top-level workflow navigation, hides counts or blocked rows behind ambiguous ellipses, makes tree/list/table actions hover-only, lets a panel header become a cluttered secondary toolbar, or collapses exact/loaded/all-matching count scopes into one vague total. The packet is metadata-only: raw user content, credentials, and tokens never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_navigation_content_component_consumer_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "tab_strip",
        "breadcrumbs",
        "tree_view",
        "list_view",
        "table_grid",
        "panel_header"
      ]
    },
    "controls_lane": {
      "type": "string",
      "enum": [
        "tab_strip_breadcrumbs",
        "tree_view_list_view",
        "table_grid_panel_header",
        "panel_header_local_action_cluster"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "shell_explorer",
        "search_graph",
        "review",
        "request_data",
        "help_center",
        "support_export_help"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "explorer_ui",
        "search_ui",
        "review_ui",
        "data_ui",
        "help_ui",
        "ai_context_ui",
        "support_export",
        "product_ui"
      ]
    },
    "authority_mode": {
      "type": "string",
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "override_gated",
        "export_only",
        "policy_blocked"
      ]
    },
    "handoff_target": {
      "type": "string",
      "enum": [
        "none",
        "desktop_shell",
        "companion_app",
        "support_packet",
        "cli_headless"
      ]
    },
    "label_parity": {
      "type": "string",
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_class",
        "consumer_surface",
        "component_family",
        "controls_lane",
        "canonical_family_schema_ref",
        "canonical_controls_schema_ref",
        "canonical_controls_artifact_refs",
        "references_canonical_not_local_prose",
        "nav_state_ref",
        "authority_mode",
        "preserved_label_families",
        "navigation_disposition_vocab",
        "label_parity",
        "handoff_target",
        "copy_export",
        "tabs_masquerade_as_top_level_workflow_navigation",
        "hides_counts_or_blocked_rows_behind_ambiguous_ellipsis",
        "makes_tree_list_or_table_actions_hover_only",
        "panel_header_becomes_cluttered_secondary_toolbar",
        "collapses_exact_loaded_and_all_matching_scopes_into_one_total",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_navigation_content_component_consumer_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_class": { "$ref": "#/$defs/consumer_class" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "controls_lane": { "$ref": "#/$defs/controls_lane" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "nav_state_ref": { "type": "string", "minLength": 1 },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "navigation_disposition_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "tabs_masquerade_as_top_level_workflow_navigation": {
          "type": "boolean",
          "const": false
        },
        "hides_counts_or_blocked_rows_behind_ambiguous_ellipsis": {
          "type": "boolean",
          "const": false
        },
        "makes_tree_list_or_table_actions_hover_only": {
          "type": "boolean",
          "const": false
        },
        "panel_header_becomes_cluttered_secondary_toolbar": {
          "type": "boolean",
          "const": false
        },
        "collapses_exact_loaded_and_all_matching_scopes_into_one_total": {
          "type": "boolean",
          "const": false
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_class_count",
        "consumer_surface_count",
        "component_family_count",
        "controls_lane_count",
        "navigation_disposition_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_use_canonical_controls_lane",
        "all_rows_preserve_primary_navigation_truth",
        "all_dense_rows_preserve_count_scope",
        "all_rows_reconstructable",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "all_rows_guardrails_clear",
        "controls_lanes_stable_across_surfaces",
        "shell_explorer_consumer_present",
        "search_graph_consumer_present",
        "review_consumer_present",
        "request_data_consumer_present",
        "help_center_consumer_present",
        "support_export_help_consumer_present",
        "help_reference_present",
        "support_export_reference_present",
        "label_family_coverage_complete",
        "navigation_disposition_coverage_complete",
        "families_reused_across_classes"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_class_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "controls_lane_count": { "type": "integer", "minimum": 0 },
        "navigation_disposition_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_use_canonical_controls_lane": { "type": "boolean" },
        "all_rows_preserve_primary_navigation_truth": { "type": "boolean" },
        "all_dense_rows_preserve_count_scope": { "type": "boolean" },
        "all_rows_reconstructable": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "all_rows_guardrails_clear": { "type": "boolean" },
        "controls_lanes_stable_across_surfaces": { "type": "boolean" },
        "shell_explorer_consumer_present": { "type": "boolean" },
        "search_graph_consumer_present": { "type": "boolean" },
        "review_consumer_present": { "type": "boolean" },
        "request_data_consumer_present": { "type": "boolean" },
        "help_center_consumer_present": { "type": "boolean" },
        "support_export_help_consumer_present": { "type": "boolean" },
        "help_reference_present": { "type": "boolean" },
        "support_export_reference_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "navigation_disposition_coverage_complete": { "type": "boolean" },
        "families_reused_across_classes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
