{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-background-work-row-banner-controls.schema.json",
  "title": "Aureline M5 background-work-row and background-work-banner controls",
  "description": "Export-safe packet for the second implement lane over the frozen M5 efficiency component matrix. It carries resolved, honest projections of the background-work row and the background-work banner across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved background-work-row examples (naming the affected work class, the slowed-versus-paused disposition, what still works, the resume condition, and whether an override exists) and the resolved background-work-banner examples (coalescing broad or repeated pressure into one durable surface). AC1 is proven by rows that stay reviewable in a durable surface after the user looks away, degrading to toast_only_not_durable when they do not; AC2 is proven by banners that coalesce repeated pressure, degrading to duplicate_toast_spam or generic_service_failure_copy rather than reading clean. Hard invariants forbid collapsing pressure into generic service-failure copy, hiding paused work behind toast-only messaging, presenting an override as available when policy blocks it, and dropping background work after a toast is dismissed. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_background_work_row_and_background_work_banner_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "efficiency_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "efficiency_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "work_disposition": {
      "enum": [
        "running_full",
        "slowed",
        "paused",
        "policy_blocked",
        "override_available",
        "override_blocked",
        "resuming",
        "stale_result_shown",
        "not_evaluated"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "background_work_row_example": {
      "type": "object",
      "required": [
        "row_id",
        "affected_work_class",
        "work_disposition",
        "preserved_protected_tasks",
        "resume_condition",
        "override_posture",
        "policy_owner",
        "override_available",
        "durable_surface",
        "reviewable_after_looking_away",
        "degrade_reason",
        "next_action",
        "presented_override_when_blocked"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "affected_work_class": { "type": ["string", "null"] },
        "work_disposition": { "$ref": "#/$defs/work_disposition" },
        "preserved_protected_tasks": { "type": "array", "items": { "type": "string" } },
        "resume_condition": { "type": ["string", "null"] },
        "override_posture": { "$ref": "#/$defs/non_empty_string" },
        "policy_owner": { "$ref": "#/$defs/non_empty_string" },
        "override_available": { "type": "boolean" },
        "durable_surface": { "type": "boolean" },
        "reviewable_after_looking_away": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "presented_override_when_blocked": { "type": "boolean" }
      }
    },
    "background_work_banner_example": {
      "type": "object",
      "required": [
        "banner_id",
        "slowed_workloads",
        "paused_workloads",
        "preserved_protected_tasks",
        "affected_work_named",
        "work_dispositions",
        "resume_condition",
        "override_posture",
        "policy_owner",
        "override_available",
        "pressure_event_count",
        "coalesced_into_single_banner",
        "shows_paused_work_explicitly",
        "durable_surface",
        "degrade_reason",
        "next_action",
        "duplicate_toast_spam",
        "generic_service_failure_copy",
        "presented_override_when_blocked"
      ],
      "properties": {
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "slowed_workloads": { "type": "array", "items": { "type": "string" } },
        "paused_workloads": { "type": "array", "items": { "type": "string" } },
        "preserved_protected_tasks": { "type": "array", "items": { "type": "string" } },
        "affected_work_named": { "type": "boolean" },
        "work_dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/work_disposition" }
        },
        "resume_condition": { "type": ["string", "null"] },
        "override_posture": { "$ref": "#/$defs/non_empty_string" },
        "policy_owner": { "$ref": "#/$defs/non_empty_string" },
        "override_available": { "type": "boolean" },
        "pressure_event_count": { "type": "integer", "minimum": 0 },
        "coalesced_into_single_banner": { "type": "boolean" },
        "shows_paused_work_explicitly": { "type": "boolean" },
        "durable_surface": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "duplicate_toast_spam": { "type": "boolean" },
        "generic_service_failure_copy": { "type": "boolean" },
        "presented_override_when_blocked": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "background_work_row_examples",
        "background_work_banner_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_pressure_into_generic_service_failure",
        "hides_paused_work_behind_toast_only",
        "presents_override_available_when_policy_blocks",
        "drops_background_work_after_toast_dismissal"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "background_work_row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/background_work_row_example" }
        },
        "background_work_banner_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/background_work_banner_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_pressure_into_generic_service_failure": { "const": false },
        "hides_paused_work_behind_toast_only": { "const": false },
        "presents_override_available_when_policy_blocks": { "const": false },
        "drops_background_work_after_toast_dismissal": { "const": false }
      }
    }
  }
}
