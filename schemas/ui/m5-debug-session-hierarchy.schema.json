{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-debug-session-hierarchy.schema.json",
  "title": "Aureline M5 debug-session-hierarchy primitive",
  "description": "Canonical parity matrix for the reusable M5 debug-session-header, thread/process-tree, and dump/crash-artifact-card primitive: a debug session header, a set of thread/process tree rows, a set of dump/crash artifact cards, a CLI/headless line, and a support-export projection that all resolve from one bounded debug session and share one session identity and one target identity. Narrows the debug_session_header, thread_process_tree, and dump_crash_artifact_card families of the frozen M5 execution-lifecycle component matrix into one working resolver. The debug hierarchy stays understandable in-product and in exported evidence even when the session is restored, degraded, or inspect-only (AC1); users can distinguish live attached control from captured crash analysis at a glance (AC2); thread/process tree rows and dump cards preserve mapping-quality and provenance truth rather than collapsing into generic debug chrome (AC3). Raw process memory, register bytes, dump payloads, symbol blobs, credentials, and provider cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_debug_session_hierarchy_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "task_run_pane",
        "test_run_pane",
        "request_run_pane",
        "notebook_execution",
        "ai_mediated_execution",
        "publish_flow",
        "preview_flow",
        "history_activity_center",
        "support_export_replay",
        "companion_summary"
      ]
    },
    "session_mode": {
      "enum": ["launch", "attach", "core", "replay", "inspect_only"]
    },
    "control_posture": {
      "enum": ["live_attached_control", "captured_analysis", "inspect_only_view"]
    },
    "adapter_state": {
      "enum": ["connected", "restored", "disconnected", "unavailable"]
    },
    "stop_reason": {
      "enum": [
        "running",
        "breakpoint",
        "exception",
        "signal",
        "step_complete",
        "paused_by_user",
        "entry_point",
        "crash_capture"
      ]
    },
    "node_kind": { "enum": ["process", "thread"] },
    "thread_run_state": {
      "enum": ["running", "paused", "stepping", "waiting", "exited", "unknown"]
    },
    "action_kind": {
      "enum": [
        "switch_thread",
        "continue_execution",
        "pause_execution",
        "detach_session",
        "open_raw_dump",
        "export_evidence",
        "copy_reference",
        "open_in_editor"
      ]
    },
    "dump_artifact_kind": {
      "enum": ["minidump", "full_core", "crash_report", "hang_report", "heap_snapshot"]
    },
    "symbolication_state": {
      "enum": ["symbolicated", "partial_symbols", "unsymbolicated", "symbols_unavailable"]
    },
    "retention_class": {
      "enum": [
        "retained_durable",
        "expires_scheduled",
        "ephemeral_session_only",
        "evicted_recoverable",
        "evicted_gone"
      ]
    },
    "outcome": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "waiting_input",
        "partially_complete",
        "passed",
        "failed",
        "cancelled",
        "stale_output"
      ]
    },
    "truth_mode": {
      "enum": ["live", "captured", "imported", "planned", "provider_reported"]
    },
    "locality": { "enum": ["local", "remote", "container", "managed"] },
    "export_field": {
      "enum": [
        "session_id",
        "session_ref",
        "target_ref",
        "session_mode",
        "control_posture",
        "truth_class",
        "locality",
        "adapter_state",
        "stop_reason",
        "thread_node_count",
        "selected_thread",
        "dump_refs",
        "symbolication_state",
        "build_provenance",
        "producing_run_ref",
        "session_restored"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_attempt_identity_unresolved",
        "input_consequence_unknown",
        "artifact_lineage_lost",
        "artifact_retention_expired",
        "rerun_context_drift",
        "captured_evidence_only",
        "connector_lost",
        "debug_adapter_unavailable",
        "symbols_unavailable"
      ]
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "session_modes",
        "control_postures",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_sessions",
        "blurs_live_and_captured",
        "flattens_hierarchy",
        "drops_provenance",
        "dump_implies_live_control"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "session_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/session_mode" }
        },
        "control_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/control_posture" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_sessions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case" }
        },
        "blurs_live_and_captured": { "const": false },
        "flattens_hierarchy": { "const": false },
        "drops_provenance": { "const": false },
        "dump_implies_live_control": { "const": false }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/input" },
        "resolved": { "$ref": "#/$defs/resolved" }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "session_id",
        "session_ref",
        "target_ref",
        "session_label",
        "context_summary",
        "age_label",
        "session_mode",
        "truth_mode",
        "locality",
        "adapter_state",
        "stop_reason",
        "session_outcome",
        "tree_nodes"
      ],
      "properties": {
        "session_id": { "$ref": "#/$defs/id" },
        "session_ref": { "$ref": "#/$defs/ref" },
        "target_ref": { "$ref": "#/$defs/ref" },
        "session_label": { "type": "string", "minLength": 1 },
        "context_summary": { "type": "string", "minLength": 1 },
        "age_label": { "type": "string", "minLength": 1 },
        "session_mode": { "$ref": "#/$defs/session_mode" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "locality": { "$ref": "#/$defs/locality" },
        "adapter_state": { "$ref": "#/$defs/adapter_state" },
        "stop_reason": { "$ref": "#/$defs/stop_reason" },
        "session_outcome": { "$ref": "#/$defs/outcome" },
        "restored": { "type": "boolean" },
        "tree_nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tree_node" }
        },
        "selected_thread_ref": { "$ref": "#/$defs/ref" },
        "dump_cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/dump_card" }
        }
      }
    },
    "tree_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_ref", "node_kind", "label", "thread_count", "run_state", "is_selected"],
      "properties": {
        "node_ref": { "$ref": "#/$defs/ref" },
        "node_kind": { "$ref": "#/$defs/node_kind" },
        "parent_ref": { "$ref": "#/$defs/ref" },
        "label": { "type": "string", "minLength": 1 },
        "thread_count": { "type": "integer", "minimum": 0 },
        "run_state": { "$ref": "#/$defs/thread_run_state" },
        "is_selected": { "type": "boolean" },
        "available_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action_kind" }
        }
      }
    },
    "dump_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dump_ref",
        "producing_run_ref",
        "artifact_kind",
        "symbolication",
        "capture_time_label",
        "build_provenance_label",
        "symbol_provenance_label",
        "retention"
      ],
      "properties": {
        "dump_ref": { "$ref": "#/$defs/ref" },
        "producing_run_ref": { "$ref": "#/$defs/ref" },
        "artifact_kind": { "$ref": "#/$defs/dump_artifact_kind" },
        "symbolication": { "$ref": "#/$defs/symbolication_state" },
        "capture_time_label": { "type": "string", "minLength": 1 },
        "build_provenance_label": { "type": "string", "minLength": 1 },
        "symbol_provenance_label": { "type": "string", "minLength": 1 },
        "retention": { "$ref": "#/$defs/retention_class" },
        "available_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action_kind" }
        }
      }
    },
    "resolved": {
      "type": "object",
      "required": [
        "session_id",
        "session_ref",
        "target_ref",
        "header",
        "tree_rows",
        "dump_cards",
        "cli_line",
        "export",
        "hierarchy_understandable",
        "distinguishes_live_from_captured",
        "preserves_mapping_and_provenance"
      ],
      "properties": {
        "session_id": { "$ref": "#/$defs/id" },
        "hierarchy_understandable": { "const": true },
        "distinguishes_live_from_captured": { "const": true },
        "preserves_mapping_and_provenance": { "const": true }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "session_modes",
        "control_postures",
        "adapter_states",
        "stop_reasons",
        "node_kinds",
        "thread_run_states",
        "action_kinds",
        "dump_artifact_kinds",
        "symbolication_states",
        "retention_classes",
        "export_fields",
        "outcomes",
        "truth_modes",
        "localities",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "session_modes": { "type": "array", "items": { "type": "string" } },
        "control_postures": { "type": "array", "items": { "type": "string" } },
        "adapter_states": { "type": "array", "items": { "type": "string" } },
        "stop_reasons": { "type": "array", "items": { "type": "string" } },
        "node_kinds": { "type": "array", "items": { "type": "string" } },
        "thread_run_states": { "type": "array", "items": { "type": "string" } },
        "action_kinds": { "type": "array", "items": { "type": "string" } },
        "dump_artifact_kinds": { "type": "array", "items": { "type": "string" } },
        "symbolication_states": { "type": "array", "items": { "type": "string" } },
        "retention_classes": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "outcomes": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "localities": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "live_control_never_blurs_with_captured",
        "hierarchy_never_flattened",
        "provenance_and_symbolication_preserved",
        "dump_cards_never_imply_live_control",
        "support_export_reconstructs_debug_hierarchy",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "live_control_never_blurs_with_captured": { "const": true },
        "hierarchy_never_flattened": { "const": true },
        "provenance_and_symbolication_preserved": { "const": true },
        "dump_cards_never_imply_live_control": { "const": true },
        "support_export_reconstructs_debug_hierarchy": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "tree_rows_read_single_hierarchy_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "execution_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "tree_rows_read_single_hierarchy_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "debug_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "debug_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
