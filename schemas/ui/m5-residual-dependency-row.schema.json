{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-residual-dependency-row.schema.json",
  "title": "Aureline M5 residual-dependency row",
  "description": "Stable UI contract for an M5 residual-dependency row. The row names remaining vendor dependency, dependency class, failure consequence, mitigation, and exportability so self-hosted or sovereign claims never imply full independence when a residual dependency remains.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "vendor_dependency_ref",
    "dependency_class",
    "required_for_operation",
    "failure_consequence",
    "mitigation",
    "discloses_residual",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_residual_dependency_row" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "vendor_dependency_ref": { "$ref": "#/$defs/ref" },
    "dependency_class": {
      "enum": ["license_activation", "update_delivery", "identity_provider", "telemetry_channel", "model_inference_service"]
    },
    "required_for_operation": { "type": "boolean" },
    "failure_consequence": {
      "enum": ["blocks_activation", "blocks_updates", "blocks_sign_in", "degrades_optional_feature", "no_user_impact"]
    },
    "mitigation": {
      "enum": ["disable_feature", "offline_fallback", "self_host_alternative", "admin_provisioned", "no_alternative"]
    },
    "discloses_residual": { "const": true },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "const": "residual_vendor_dependency" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
