{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-governance-dashboard-component-consumer.schema.json",
  "title": "M5 Governance-Dashboard Component Consumer Packet",
  "description": "Adoption matrix binding every claimed M5 governance-dashboard consumer (assurance center, release center, operator dashboard, shiproom summary, support export, About/help, docs portal, CLI inspect) to the nine canonical governance-dashboard component families and the one shared readiness / evidence-freshness / waiver / owner-coverage / decision-forum descriptor vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_assurance_center_release_center_operator_dashboard_support_export_shiproom_about_help_consumers_so_governance_dashboard_components_keep_fitness_ownership_waiver_and_decision_language_aligned"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 7
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "assurance_center",
        "release_center",
        "operator_dashboard",
        "shiproom_summary",
        "support_export",
        "about_help",
        "docs_portal",
        "cli_inspect"
      ]
    },
    "component_family": {
      "enum": [
        "fitness_dashboard_tile",
        "governance_report_row",
        "waiver_expiry_queue_item",
        "release_gate_banner",
        "mitigation_note_card",
        "service_ownership_card",
        "on_call_strip",
        "decision_right_card",
        "milestone_dashboard_row"
      ]
    },
    "descriptor": {
      "enum": ["readiness", "evidence_freshness", "waiver_state", "owner_coverage", "decision_forum"]
    },
    "evidence_state": {
      "enum": [
        "full_truth_fresh",
        "evidence_stale",
        "waiver_expiring_or_expired",
        "owner_coverage_missing",
        "forum_unresolved",
        "not_evaluated_here"
      ]
    },
    "projection_mode": {
      "enum": [
        "full_parity",
        "stale_narrowed",
        "waiver_narrowed",
        "ownership_narrowed",
        "forum_narrowed",
        "not_evaluated_narrowed"
      ]
    },
    "descriptor_parity_state": {
      "enum": ["descriptors_preserved", "descriptors_disclosed_narrowed"]
    },
    "narrow_reason": {
      "enum": [
        "evidence_stale",
        "waiver_expiring",
        "owner_coverage_missing",
        "forum_unresolved",
        "not_evaluated_here"
      ]
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "const": true },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "readiness_vocab",
        "evidence_states",
        "projection_modes",
        "descriptor_parity_states",
        "narrow_reasons",
        "next_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "renders_waived_or_stale_as_clean_pass",
        "lets_ownerless_or_forumless_blocker_read_resolved",
        "hides_mitigation_behind_internal_jargon",
        "rewords_governance_vocabulary_per_surface",
        "invents_new_dashboard_local_status"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": { "type": "string" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "items": { "type": "string" } },
        "anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "descriptor_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor" },
          "minItems": 5
        },
        "readiness_vocab": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "evidence_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_state" }
        },
        "projection_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/projection_mode" }
        },
        "descriptor_parity_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor_parity_state" }
        },
        "narrow_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        },
        "next_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_binding" }
        },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": { "type": "array", "items": { "type": "string" } },
        "renders_waived_or_stale_as_clean_pass": { "const": false },
        "lets_ownerless_or_forumless_blocker_read_resolved": { "const": false },
        "hides_mitigation_behind_internal_jargon": { "const": false },
        "rewords_governance_vocabulary_per_surface": { "const": false },
        "invents_new_dashboard_local_status": { "const": false }
      }
    }
  }
}
