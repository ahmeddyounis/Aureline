{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-build-remote-boundary-component-accessibility-parity.schema.json",
  "title": "M5 Build/Remote-Boundary Component Accessibility Parity Packet",
  "description": "M05-1081 keyboard / screen-reader / reduced-motion / high-contrast / CLI / export / support-packet parity and honest auto-narrowing capstone over the frozen M5 build/remote/managed-workspace boundary component matrix. Certifies that discovery confidence, host ownership, execution origin, lifecycle state, expiry timing, and continuity truth stays keyboard-complete, screen-reader-reachable, reduced-motion safe, high-contrast legible, CLI/export-safe, and self-narrowing rather than presenting a stale, unverified, unsupported, or partial boundary state as still fresh first-party full-truth.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "record_kind", "packet_id", "as_of", "matrix_ref", "rows", "summary"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_build_remote_boundary_component_accessibility_parity_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "claim_tier": {
      "type": "string",
      "enum": ["full_truth", "resolved_truth", "degraded", "stale", "unverified", "unsupported"]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "discovery_confidence_truth",
        "host_ownership_truth",
        "execution_origin_truth",
        "lifecycle_state_truth",
        "expiry_timing_truth",
        "continuity_truth"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": ["intact", "partial", "stale", "unverified", "unsupported"]
    },
    "reach_state": {
      "type": "string",
      "enum": ["reachable_and_labeled", "disclosed_reduced_but_reachable", "view_only_trap"]
    },
    "component_family": {
      "type": "string",
      "enum": [
        "adapter_confidence_chip",
        "discovery_diff_card",
        "host_boundary_strip",
        "execution_origin_receipt_row",
        "managed_workspace_lifecycle_card",
        "suspend_resume_rebuild_review_sheet",
        "workspace_expiry_banner",
        "local_safe_continuation_card"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": ["desktop_full", "companion_app", "browser_readonly", "cli_headless", "handoff_packet", "support_export"]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "confidence_and_discovery",
        "host_and_execution_origin",
        "lifecycle_and_continuity"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "run_test_debug_ui",
        "notebook_ui",
        "preview_ui",
        "companion_ui",
        "incident_ui",
        "support_export",
        "product_ui"
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "boundary_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_support_claim",
        "claim_conditions",
        "required_labels",
        "consumer_surfaces",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "m5_build_remote_boundary_component_accessibility_parity_row" },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "boundary_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/reach_state" },
        "cli_reach": { "$ref": "#/$defs/reach_state" },
        "export_summary": {
          "type": "string",
          "enum": ["reconstructable_without_screenshot", "disclosed_partial_capture", "absent_needs_screenshot"]
        },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": {
          "type": "object",
          "additionalProperties": true,
          "required": ["formats", "export_fields", "screenshot_only_prohibited"],
          "properties": {
            "formats": { "type": "array", "items": { "type": "string" } },
            "export_fields": { "type": "array", "items": { "type": "string" } },
            "screenshot_only_prohibited": { "type": "boolean" }
          }
        },
        "full_support_claim": { "$ref": "#/$defs/claim_tier" },
        "claim_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["dimension", "state"],
            "properties": {
              "dimension": { "$ref": "#/$defs/claim_dimension" },
              "state": { "$ref": "#/$defs/condition_state" }
            }
          }
        },
        "claim_narrow": {
          "type": "object",
          "additionalProperties": true,
          "required": ["narrowed_to", "binding_dimension", "trigger", "narrowed_label", "preserves_canonical_identity"],
          "properties": {
            "narrowed_to": { "$ref": "#/$defs/claim_tier" },
            "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
            "trigger": { "type": "string", "minLength": 1 },
            "narrowed_label": { "type": "string", "minLength": 1 },
            "preserves_canonical_identity": { "type": "boolean" }
          }
        },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
            "properties": {
              "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
              "state": { "type": "string", "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"] },
              "preserved_labels": { "type": "array", "items": { "type": "string" } },
              "reduced_interactions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "required_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "family_count",
        "hierarchy_heavy_family_count",
        "all_hierarchy_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_export_summaries_preserve_meaning",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "family_count": { "type": "integer", "minimum": 0 },
        "hierarchy_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_hierarchy_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
