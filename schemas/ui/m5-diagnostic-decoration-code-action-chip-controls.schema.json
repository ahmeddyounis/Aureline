{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-diagnostic-decoration-code-action-chip-controls.schema.json",
  "title": "Aureline M5 diagnostic-decoration and code-action-chip controls",
  "description": "Export-safe packet for the second implement lane over the frozen M5 editor-inline component matrix. It carries resolved, honest projections of the diagnostic decoration and the code-action chip across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved diagnostic-decoration examples (naming the problem identity, severity with no-color-only semantics, source/provider, freshness or stale state, anchor durability, and stable linkage to Problems/output/support) and the resolved code-action-chip examples (naming the exact-versus-inferred fix posture, the preview-required apply scope, the blocked-action reason, and the side-effect class where a fix touches multiple files or external state). Hard invariants forbid diagnostics encoding severity/source by color alone, anchors or freshness silently drifting, inferred or blocked fixes reading as exact or ready, and code actions bypassing the preview/apply truth. Acceptance criteria — problem underlines, markers, chips, and panel entries correlate through one severity/source/freshness vocabulary; users can tell whether a fix is exact, inferred, blocked, or review-required before invoking it; and no claimed inline action path bypasses the broader preview/apply truth — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-editor is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_diagnostic_decoration_and_code_action_chip_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "diagnostic_example": {
      "type": "object",
      "required": [
        "decoration_id",
        "message_label",
        "severity",
        "severity_stated",
        "source_class",
        "source_is_imported",
        "freshness",
        "freshness_is_stale",
        "stale_disclosed",
        "anchor_durability",
        "anchor_is_durable",
        "anchor_is_drifted",
        "anchor_drift_disclosed",
        "linkage_target",
        "linkage_stable",
        "imported_certainty_distinguished",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "decoration_legible_at_a_glance"
      ],
      "properties": {
        "decoration_id": { "$ref": "#/$defs/non_empty_string" },
        "message_label": { "type": "string" },
        "severity": { "$ref": "#/$defs/non_empty_string" },
        "severity_stated": { "type": "boolean" },
        "source_class": { "$ref": "#/$defs/non_empty_string" },
        "source_is_imported": { "type": "boolean" },
        "freshness": { "$ref": "#/$defs/non_empty_string" },
        "freshness_is_stale": { "type": "boolean" },
        "stale_disclosed": { "type": "boolean" },
        "anchor_durability": { "$ref": "#/$defs/non_empty_string" },
        "anchor_is_durable": { "type": "boolean" },
        "anchor_is_drifted": { "type": "boolean" },
        "anchor_drift_disclosed": { "type": "boolean" },
        "linkage_target": { "$ref": "#/$defs/non_empty_string" },
        "linkage_stable": { "type": "boolean" },
        "imported_certainty_distinguished": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "decoration_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "chip_example": {
      "type": "object",
      "required": [
        "chip_id",
        "action_label",
        "fix_posture",
        "fix_is_exact",
        "fix_is_inferred",
        "claims_exact",
        "posture_stated",
        "apply_scope",
        "requires_preview",
        "preview_available",
        "is_blocked",
        "block_reason",
        "block_reason_stated",
        "side_effect_class",
        "touches_multiple_or_external",
        "side_effect_disclosed",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "fix_posture_legible_at_a_glance"
      ],
      "properties": {
        "chip_id": { "$ref": "#/$defs/non_empty_string" },
        "action_label": { "type": "string" },
        "fix_posture": { "$ref": "#/$defs/non_empty_string" },
        "fix_is_exact": { "type": "boolean" },
        "fix_is_inferred": { "type": "boolean" },
        "claims_exact": { "type": "boolean" },
        "posture_stated": { "type": "boolean" },
        "apply_scope": { "$ref": "#/$defs/non_empty_string" },
        "requires_preview": { "type": "boolean" },
        "preview_available": { "type": "boolean" },
        "is_blocked": { "type": "boolean" },
        "block_reason": { "$ref": "#/$defs/non_empty_string" },
        "block_reason_stated": { "type": "boolean" },
        "side_effect_class": { "$ref": "#/$defs/non_empty_string" },
        "touches_multiple_or_external": { "type": "boolean" },
        "side_effect_disclosed": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fix_posture_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "diagnostic_examples",
        "chip_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "diagnostic_severity_or_source_encoded_by_color_alone",
        "diagnostic_anchor_or_freshness_silently_drifts",
        "inferred_or_blocked_fix_presented_as_exact_or_ready",
        "code_action_bypasses_preview_or_apply_truth"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "diagnostic_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnostic_example" }
        },
        "chip_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chip_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "diagnostic_severity_or_source_encoded_by_color_alone": { "const": false },
        "diagnostic_anchor_or_freshness_silently_drifts": { "const": false },
        "inferred_or_blocked_fix_presented_as_exact_or_ready": { "const": false },
        "code_action_bypasses_preview_or_apply_truth": { "const": false }
      }
    }
  }
}
