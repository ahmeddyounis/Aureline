{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-stash-reflog-recovery-component.schema.json",
  "title": "Aureline M5 stash entries and reflog-recovery banners with untracked/staged scope, base-ref origin, apply/pop/drop/create-branch distinctions, and checkpoint lineage",
  "description": "Export-safe packet implementing the two recovery components frozen in the M5 Git-history component matrix: stash entries and reflog-recovery banners. A stash entry answers, from itself alone, which message and created-from ref name the stash, whether untracked and/or staged content is included, and which exact restore verb (apply, pop, drop, or create-branch-from-stash) it exposes — so a `stash@{n}` shorthand is never the only meaning-bearing label and one restore verb is never mistaken for another. A reflog-recovery banner links a risky history mutation back to a concrete checkpoint/recovery destination, discloses its expiry state, and stays reachable from Git history, review, and help/support surfaces until superseded or dismissed. Raw paths, raw object bytes, raw branch names, raw reflog/stash bodies, raw provider payloads, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "stash_entries",
    "reflog_banners",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "git_stash_reflog_recovery_component_truth"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "stash_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stash_entry_row"
      }
    },
    "reflog_banners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reflog_banner_row"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_state"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "content_scope": {
      "type": "string",
      "enum": [
        "tracked_modified",
        "tracked_and_staged",
        "tracked_and_untracked",
        "tracked_staged_untracked",
        "staged_only"
      ]
    },
    "restore_verb": {
      "type": "string",
      "enum": [
        "apply",
        "pop",
        "drop",
        "create_branch_from_stash"
      ]
    },
    "reachability": {
      "type": "string",
      "enum": [
        "reachable",
        "superseded",
        "dismissed"
      ]
    },
    "expiry_state": {
      "type": "string",
      "enum": [
        "fresh",
        "expiring_soon",
        "expired",
        "pruned",
        "pinned"
      ]
    },
    "recovery_surface": {
      "type": "string",
      "enum": [
        "git_history",
        "review",
        "help_support"
      ]
    },
    "recovery_action": {
      "type": "string",
      "enum": [
        "restore_to_checkpoint",
        "open_reflog_entry",
        "pin_recovery_point",
        "compare_with_current",
        "dismiss_banner",
        "open_provider_in_browser"
      ]
    },
    "downgrade_state": {
      "type": "string",
      "enum": [
        "stale_provider_overlay",
        "detached_or_missing_ref",
        "dirty_or_conflicted_worktree",
        "shallow_or_partial_topology",
        "reflog_only_fallback",
        "approval_invalidated",
        "offline_local_only"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review",
        "shell",
        "help",
        "support",
        "support_export",
        "provider_overlay",
        "cli",
        "ai_context"
      ]
    },
    "stash_entry_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "stash_shorthand",
        "message",
        "created_from_ref",
        "content_scope",
        "scope_disclosure",
        "restore_verbs",
        "recovery_reflog_note",
        "downgrade_vocab",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component": {
          "const": "stash_entry"
        },
        "stash_shorthand": {
          "$ref": "#/$defs/non_empty_string"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        },
        "created_from_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "content_scope": {
          "$ref": "#/$defs/content_scope"
        },
        "scope_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "restore_verbs": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/restore_verb"
          }
        },
        "recovery_reflog_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "downgrade_vocab": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_state"
          }
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "reflog_banner_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "mutation_label",
        "recovery_destination",
        "reachability",
        "expiry_state",
        "expiry_disclosure",
        "reachable_from_surfaces",
        "restore_actions",
        "downgrade_vocab",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component": {
          "const": "reflog_recovery_banner"
        },
        "mutation_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "recovery_destination": {
          "type": "string"
        },
        "reachability": {
          "$ref": "#/$defs/reachability"
        },
        "expiry_state": {
          "$ref": "#/$defs/expiry_state"
        },
        "expiry_disclosure": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reachable_from_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recovery_surface"
          }
        },
        "restore_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/recovery_action"
          }
        },
        "downgrade_vocab": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/downgrade_state"
          }
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reachability": {
                "const": "reachable"
              }
            }
          },
          "then": {
            "properties": {
              "recovery_destination": {
                "$ref": "#/$defs/non_empty_string"
              },
              "expiry_state": {
                "not": {
                  "enum": [
                    "expired",
                    "pruned"
                  ]
                }
              },
              "reachable_from_surfaces": {
                "type": "array",
                "minItems": 3,
                "allOf": [
                  {
                    "contains": {
                      "const": "git_history"
                    }
                  },
                  {
                    "contains": {
                      "const": "review"
                    }
                  },
                  {
                    "contains": {
                      "const": "help_support"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stash_shorthand_never_only_label",
        "stash_message_and_origin_explicit",
        "stash_scope_explicit",
        "restore_verbs_stay_distinct",
        "recovery_destination_always_concrete",
        "recovery_reachable_until_superseded_or_dismissed",
        "expiry_state_always_disclosed",
        "local_only_recovery_stays_explicit",
        "one_component_contract_no_hidden_meaning",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "stash_shorthand_never_only_label": {
          "type": "boolean",
          "const": true
        },
        "stash_message_and_origin_explicit": {
          "type": "boolean",
          "const": true
        },
        "stash_scope_explicit": {
          "type": "boolean",
          "const": true
        },
        "restore_verbs_stay_distinct": {
          "type": "boolean",
          "const": true
        },
        "recovery_destination_always_concrete": {
          "type": "boolean",
          "const": true
        },
        "recovery_reachable_until_superseded_or_dismissed": {
          "type": "boolean",
          "const": true
        },
        "expiry_state_always_disclosed": {
          "type": "boolean",
          "const": true
        },
        "local_only_recovery_stays_explicit": {
          "type": "boolean",
          "const": true
        },
        "one_component_contract_no_hidden_meaning": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_history_reuses_one_contract",
        "review_reuses_one_contract",
        "help_support_reuses_one_contract",
        "support_export_reuses_one_contract",
        "recovery_reachable_across_surfaces",
        "cli_headless_shows_truth",
        "provider_overlay_shows_truth",
        "ai_context_shows_truth"
      ],
      "properties": {
        "git_history_reuses_one_contract": {
          "type": "boolean",
          "const": true
        },
        "review_reuses_one_contract": {
          "type": "boolean",
          "const": true
        },
        "help_support_reuses_one_contract": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_one_contract": {
          "type": "boolean",
          "const": true
        },
        "recovery_reachable_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "provider_overlay_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "ai_context_shows_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
