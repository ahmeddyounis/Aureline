{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-session-summary-bar.schema.json",
  "title": "Aureline M5 session-summary-bar / watch-mode-banner primitive",
  "description": "Export-safe packet implementing the reusable M5 session-summary bar and watch-mode banner as one twin primitive. The packet binds one row per claimed status consumer — the test-explorer status bar, the editor status bar, the run-panel status, the headless/CLI status, and the session/watch report export — to the shared session and watch anatomy, the derived session posture (discovering/executing/watch-backlog/imported-refresh/settled — one distinct posture per activity phase so no two kinds of pending work collapse into one spinner), the exact selection scopes, the running/backlog/retry counts, the session outcomes and attempt-lineage retry state, the derived watch posture (live/reduced/polling/reconnecting/paused/unavailable — the frozen controlled vocabulary), the watch degrade reasons, the last successful cycle, bounded reveal/rerun/cancel/open-watch and reveal/recover/pause/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the two resolvers, and four hard invariants: it never collapses a distinct activity phase into one generic loading treatment, never leaves the retry lineage unstated, never invents an alternate label for a degraded watch, and never hides why watch degraded or the last successful cycle. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary. This is the canonical packet schema; the watch-banner companion schema at m5-test-watch-mode-banner.schema.json describes the watch resolution case shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_session_summary_bars_and_watch_mode_banners_with_exact_selection_running_backlog_retry_counts_live_reduced_polling_unavailable_state_last_successful_cycle_and_recover_pause_truth_across_claimed_m5_test_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "test_evidence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "session_anatomy_parts",
        "watch_anatomy_parts",
        "session_modes",
        "activity_phases",
        "selection_scopes",
        "session_outcomes",
        "session_postures",
        "attempt_lineage_kinds",
        "watch_fidelity_states",
        "watch_degrade_reasons",
        "watch_postures",
        "session_actions",
        "watch_actions",
        "session_export_fields",
        "watch_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "session_examples",
        "watch_examples",
        "collapses_activity_into_one_spinner",
        "drops_retry_lineage",
        "invents_alternate_watch_label",
        "hides_watch_degrade_or_last_cycle"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "test_explorer_status_bar",
            "editor_status_bar",
            "run_panel_status",
            "headless_cli_status",
            "session_watch_report_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "session_anatomy_parts": { "type": "array", "minItems": 1 },
        "watch_anatomy_parts": { "type": "array", "minItems": 1 },
        "session_modes": { "type": "array", "minItems": 1 },
        "activity_phases": { "type": "array", "minItems": 1 },
        "selection_scopes": { "type": "array", "minItems": 1 },
        "session_outcomes": { "type": "array", "minItems": 1 },
        "session_postures": { "type": "array", "minItems": 1 },
        "attempt_lineage_kinds": { "type": "array", "minItems": 1 },
        "watch_fidelity_states": { "type": "array", "minItems": 1 },
        "watch_degrade_reasons": { "type": "array", "minItems": 1 },
        "watch_postures": { "type": "array", "minItems": 1 },
        "session_actions": { "type": "array", "minItems": 1 },
        "watch_actions": { "type": "array", "minItems": 1 },
        "session_export_fields": { "type": "array", "minItems": 1 },
        "watch_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "session_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/session_example" }
        },
        "watch_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/watch_example" }
        },
        "collapses_activity_into_one_spinner": { "const": false },
        "drops_retry_lineage": { "const": false },
        "invents_alternate_watch_label": { "const": false },
        "hides_watch_degrade_or_last_cycle": { "const": false }
      }
    },
    "session_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "session_mode",
            "activity_phase",
            "selection_scope",
            "session_outcome",
            "attempt_lineage",
            "watch_fidelity",
            "running_count",
            "backlog_count",
            "retry_count",
            "session_identity_ref",
            "session_posture",
            "is_in_progress",
            "can_rerun",
            "can_cancel",
            "has_backlog",
            "has_retries",
            "watch_is_degraded",
            "available_actions"
          ]
        }
      }
    },
    "watch_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "watch_fidelity",
            "last_successful_cycle",
            "backlog_count",
            "watch_identity_ref",
            "watch_posture",
            "is_degraded",
            "can_recover",
            "can_pause",
            "explains_degradation",
            "preserves_last_successful_cycle",
            "available_actions"
          ]
        }
      }
    }
  }
}
