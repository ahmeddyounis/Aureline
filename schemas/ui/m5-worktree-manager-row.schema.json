{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-worktree-manager-row.schema.json",
  "title": "Aureline M5 worktree-manager row / cleanup preview",
  "description": "Canonical per-domain descriptor for a worktree-manager row and its orphan-cleanup preview. Names the cleanup target, previews running tasks, open editors, uncommitted changes, and recovery checkpoints, and shows the cleanup state (orphaned, abandoned) so an orphaned worktree or stale stack member is never deleted without previewing running work and export-safe evidence. Raw paths, raw provider payloads, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "change_orchestration_association",
    "cleanup_target",
    "landing_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "worktree_cleanup_preview"
      ]
    },
    "change_orchestration_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "cleanup_target": {
      "type": "string",
      "minLength": 1
    },
    "running_work_preview": {
      "type": "array"
    },
    "recovery_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "landing_state": {
      "enum": [
        "selected_change",
        "stale_validation",
        "restack_required",
        "queue_eligible",
        "queue_blocked",
        "protected_branch_blocked",
        "orphaned",
        "abandoned",
        "exported",
        "imported_reopened"
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
