{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-work-item-component-matrix.schema.json",
  "title": "Aureline M5 work-item component matrix",
  "description": "Export-safe packet freezing Aureline's reusable provider-backed work-item components. The packet names every issue-, task-, and incident-facing component family M5 claims that still drifts too easily by surface — the work-item row, the provider-chip group, the relation strip, the sync-pending pill, the work-item detail header, the status-transition sheet, the related-evidence card, and the offline-handoff-packet card — and binds each to the claimed M5 work-item surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: work-item kinds; provider-authority classes (provider_owned, local_draft, mirrored_read_only, imported_snapshot, unlinked_local, policy_pinned); local-versus-provider states (synced_with_provider, local_only_draft, queued_for_publish, publish_deferred, publish_failed, conflict_held); relation kinds; evidence kinds; transition effects; and handoff destinations with metadata-safe export boundaries. Hard invariants forbid masking canonical identity or provider authority, hiding local-versus-provider or publish-later state, inventing an alternate label for a governed state, and letting generic ticket/task wording conceal provider ownership, queued state, or linked context. Raw comment bodies, raw local paths, raw usernames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-provider is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "freeze_m5_work_item_component_matrix" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "work_item_matrix_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "work_item_matrix_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "work_item_row",
        "provider_chip_group",
        "relation_strip",
        "sync_pending_pill",
        "work_item_detail_header",
        "status_transition_sheet",
        "related_evidence_card",
        "offline_handoff_packet_card"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_identity_or_authority",
        "hides_local_or_publish_later_state",
        "invents_alternate_state_label",
        "uses_generic_ticket_wording"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "masks_identity_or_authority": { "const": false },
        "hides_local_or_publish_later_state": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "uses_generic_ticket_wording": { "const": false }
      }
    }
  }
}
