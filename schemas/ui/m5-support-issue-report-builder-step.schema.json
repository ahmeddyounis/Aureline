{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-issue-report-builder-step.schema.json",
  "title": "Aureline M5 issue-report-builder-step primitive",
  "description": "Export-safe packet implementing the reusable M5 issue-report builder step as one primitive. The packet binds one row per claimed support-intake consumer — support-center builder, recovery-center builder, Doctor handoff builder, headless/CLI builder, and support-packet export — to the shared builder-step anatomy, the derived step posture (share-blocked/no-evidence-selected/redaction-review-required/local-only-preview/ready-to-share), the builder step kinds, the selected and excluded evidence classes with their metadata/environment-adjacent/code-adjacent/high-risk data-risk class, the redaction states, the per-class local-boundary disposition, bounded reveal-boundary/preview-local-only/edit-selection/review-redaction/share/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks which evidence class it selects or omits, never hides the redaction posture, never drops the same-weight local-only preview, and never collapses the summary/repro steps/evidence into one opaque report-draft blob. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_issue_report_builder_steps_and_evidence_class_selectors_with_included_excluded_redaction_repro_and_local_only_preview_truth_across_claimed_m5_support_flows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "support_case_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "support_case_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "builder_step_kinds",
        "evidence_classes",
        "data_classes",
        "redaction_states",
        "step_postures",
        "step_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "builder_examples",
        "masks_evidence_class",
        "hides_redaction_state",
        "drops_local_only_preview",
        "collapses_report_into_blob"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "support_center_builder",
            "recovery_center_builder",
            "doctor_handoff_builder",
            "headless_cli_builder",
            "support_packet_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "builder_step_kinds": { "type": "array", "minItems": 1 },
        "evidence_classes": { "type": "array", "minItems": 1 },
        "data_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "metadata_only",
              "environment_adjacent",
              "code_adjacent",
              "high_risk"
            ]
          }
        },
        "redaction_states": { "type": "array", "minItems": 1 },
        "step_postures": { "type": "array", "minItems": 1 },
        "step_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "builder_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/builder_example" }
        },
        "masks_evidence_class": { "const": false },
        "hides_redaction_state": { "const": false },
        "drops_local_only_preview": { "const": false },
        "collapses_report_into_blob": { "const": false }
      }
    },
    "builder_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "step_kind",
            "summary",
            "repro_steps",
            "selected_evidence",
            "excluded_evidence",
            "redaction_state",
            "step_identity",
            "step_posture",
            "evidence_dispositions",
            "crossing_classes",
            "available_actions",
            "will_cross_local_boundary",
            "needs_redaction_review",
            "local_only_preview_available"
          ]
        }
      }
    }
  }
}
