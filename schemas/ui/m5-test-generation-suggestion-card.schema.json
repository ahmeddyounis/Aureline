{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-generation-suggestion-card.schema.json",
  "title": "Aureline M5 test-generation-suggestion-card primitive",
  "description": "Export-safe packet implementing the reusable M5 test-generation suggestion card as one primitive. The packet binds one row per claimed AI test-review consumer — the suggestion review panel, the editor inline suggestion, the test-tree suggestion, the headless/CLI suggestion, and the suggestion export — to the shared card anatomy, the derived suggestion posture (assertion-only/fixture-and-assertion/snapshot-included/full-bundle/review-required/apply-blocked — one distinct posture per apply scope so a full-bundle proposal never reads as an assertion-only apply), the trigger sources (uncovered line/branch, failing bug repro, regression-guard gap, missing-assertion gap, manual request), the distinct assertion/helper-fixture/snapshot-golden review classes the card separates its churn into, the generated-test assumption classes, the generated apply scopes, the provenance classes, bounded reveal/run-in-sandbox/open-diff/apply-reviewed-classes/rollback/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never bundles assumption, fixture, or snapshot churn into one opaque apply path, never hides the trigger source or target symbols behind a bare suggestion, never hides the assumption summary or generated file count, and never invents an alternate label for a governed suggestion or apply state. An apply-capable scope may only be offered when it names every review class it would apply, an apply-capable generated card must disclose its assumption summary, and an apply-capable proposal must keep a diff-first preview and a rollback. Raw generated source, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_test_generation_suggestion_cards_with_uncovered_path_or_bug_trigger_truth_assumption_summaries_helper_fixture_snapshot_separation_sandbox_validation_and_diff_first_apply_parity_across_claimed_m5_ai_test_flows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "test_evidence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "suggestion_anatomy_parts",
        "trigger_sources",
        "review_classes",
        "assumption_classes",
        "apply_scopes",
        "suggestion_postures",
        "provenance_classes",
        "suggestion_actions",
        "suggestion_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "suggestion_examples",
        "bundles_assumption_fixture_or_snapshot_into_opaque_apply",
        "hides_trigger_source_or_target_symbols",
        "hides_assumption_summary_or_generated_file_count",
        "invents_alternate_suggestion_or_apply_state_label"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "suggestion_review_panel",
            "editor_suggestion_inline",
            "test_tree_suggestion",
            "headless_cli_suggestion",
            "suggestion_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "suggestion_anatomy_parts": { "type": "array", "minItems": 1 },
        "trigger_sources": { "type": "array", "minItems": 1 },
        "review_classes": { "type": "array", "minItems": 1 },
        "assumption_classes": { "type": "array", "minItems": 1 },
        "apply_scopes": { "type": "array", "minItems": 1 },
        "suggestion_postures": { "type": "array", "minItems": 1 },
        "provenance_classes": { "type": "array", "minItems": 1 },
        "suggestion_actions": { "type": "array", "minItems": 1 },
        "suggestion_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "suggestion_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/suggestion_example" }
        },
        "bundles_assumption_fixture_or_snapshot_into_opaque_apply": { "const": false },
        "hides_trigger_source_or_target_symbols": { "const": false },
        "hides_assumption_summary_or_generated_file_count": { "const": false },
        "invents_alternate_suggestion_or_apply_state_label": { "const": false }
      }
    },
    "suggestion_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "trigger_source",
            "target_refs",
            "trigger_context_ref",
            "assumption_classes",
            "review_classes",
            "apply_scope",
            "generated_file_count",
            "provenance_class",
            "suggestion_identity_ref",
            "suggestion_posture",
            "available_actions",
            "is_apply_capable",
            "is_uncovered_path_or_bug",
            "bundles_non_assertion_churn",
            "apply_scope_names_every_class",
            "discloses_assumption_summary",
            "offers_sandbox_run",
            "offers_diff_preview",
            "offers_rollback",
            "preserves_preview_and_rollback",
            "needs_attention"
          ]
        }
      }
    }
  }
}
