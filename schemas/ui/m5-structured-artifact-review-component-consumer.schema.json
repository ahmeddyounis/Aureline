{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-structured-artifact-review-component-consumer.schema.json",
  "title": "M5 Structured-Artifact Review-Component Consumer Parity Packet",
  "description": "Export-safe packet binding the nine shared M5 structured-artifact review components (artifact-identity bar, diff-mode switcher, structure row, merge-decision row, generated-artifact notice, rendered-compare viewer, media-metadata rail, redaction/trust badge set, compare-summary card) to the diff toolbar, merge sheet, review workspace, Help surface, support packet, and exported-view consumers that render them, proving canonical-source/mode/risk/provenance parity for the same artifact object across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "artifact_review_component_consumer_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "artifact_identity_bar",
        "diff_mode_switcher",
        "structure_row",
        "merge_decision_row",
        "generated_artifact_notice",
        "rendered_compare_viewer",
        "media_metadata_rail",
        "redaction_or_trust_badge_set",
        "compare_summary_card"
      ]
    },
    "consumer": {
      "type": "string",
      "enum": [
        "diff_toolbar",
        "merge_sheet",
        "review_workspace",
        "help_surface",
        "support_packet",
        "exported_view"
      ]
    },
    "render_fidelity": {
      "type": "string",
      "enum": [
        "structured_faithful",
        "structured_partial",
        "schema_unrecognized",
        "render_untrusted",
        "raw_fallback",
        "redacted_or_withheld"
      ]
    },
    "render_mode": {
      "type": "string",
      "enum": [
        "full_parity",
        "structured_fidelity_narrowed",
        "raw_fallback_disclosed",
        "redaction_narrowed"
      ]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "structured_fidelity_degraded",
        "structured_mode_unavailable_raw_fallback",
        "content_redacted_or_withheld"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": [
        "open_raw_export_safe_fallback",
        "review_parser_schema_state",
        "review_redaction_posture"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "parser_unavailable",
        "schema_unrecognized",
        "render_untrusted",
        "redaction_applied",
        "parity_drift_detected",
        "trust_narrowing",
        "upstream_component_narrowed"
      ]
    },
    "parity_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_source_label",
        "mode_action",
        "risk_status_language",
        "provenance_relation"
      ],
      "properties": {
        "canonical_source_label": { "type": "string", "minLength": 1 },
        "mode_action": { "type": "string", "minLength": 1 },
        "risk_status_language": { "type": "string", "minLength": 1 },
        "provenance_relation": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_facets_note", "next_action", "next_action_label"],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_facets_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "artifact_object_id",
        "artifact_object_label",
        "component",
        "consumer",
        "render_fidelity",
        "render_mode",
        "parity_facets",
        "parity_state",
        "narrow_banner",
        "raw_fallback_note",
        "redaction_note",
        "promotes_compare_only_to_writable_state",
        "flattens_structured_mode_without_explanation",
        "hides_generated_from_relation_behind_generic_chrome",
        "drops_raw_or_export_safe_fallback",
        "rewords_artifact_labels_per_surface",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "artifact_object_id": { "type": "string", "minLength": 1 },
        "artifact_object_label": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "consumer": { "$ref": "#/$defs/consumer" },
        "render_fidelity": { "$ref": "#/$defs/render_fidelity" },
        "render_mode": { "$ref": "#/$defs/render_mode" },
        "parity_facets": { "$ref": "#/$defs/parity_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_banner": {
          "oneOf": [{ "$ref": "#/$defs/narrow_banner" }, { "type": "null" }]
        },
        "raw_fallback_note": { "type": "string" },
        "redaction_note": { "type": "string" },
        "promotes_compare_only_to_writable_state": { "const": false },
        "flattens_structured_mode_without_explanation": { "const": false },
        "hides_generated_from_relation_behind_generic_chrome": { "const": false },
        "drops_raw_or_export_safe_fallback": { "const": false },
        "rewords_artifact_labels_per_surface": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Full parity renders never carry a narrow banner.",
          "if": { "properties": { "render_mode": { "const": "full_parity" } } },
          "then": { "properties": { "narrow_banner": { "type": "null" } } }
        },
        {
          "comment": "Narrowed renders must carry a narrow banner.",
          "if": {
            "properties": {
              "render_mode": {
                "enum": [
                  "structured_fidelity_narrowed",
                  "raw_fallback_disclosed",
                  "redaction_narrowed"
                ]
              }
            }
          },
          "then": {
            "properties": { "narrow_banner": { "$ref": "#/$defs/narrow_banner" } }
          }
        },
        {
          "comment": "Fidelity that narrows structure or schema must keep an explicit raw / export-safe fallback note.",
          "if": {
            "properties": {
              "render_fidelity": {
                "enum": [
                  "structured_partial",
                  "render_untrusted",
                  "schema_unrecognized",
                  "raw_fallback"
                ]
              }
            }
          },
          "then": {
            "properties": { "raw_fallback_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "Redacted or withheld content must carry an explicit redaction-posture note.",
          "if": {
            "properties": { "render_fidelity": { "const": "redacted_or_withheld" } }
          },
          "then": {
            "properties": { "redaction_note": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_reuse_proven_by_fixtures",
        "same_object_same_language_across_surfaces",
        "compare_only_never_silently_writable",
        "structured_mode_never_flattened_without_explanation",
        "generated_from_relation_never_hidden",
        "canonical_source_labels_identical_across_surfaces",
        "risk_status_language_identical_across_surfaces",
        "raw_export_safe_fallback_kept_explicit",
        "redaction_posture_kept_explicit",
        "help_support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "component_reuse_proven_by_fixtures": { "const": true },
        "same_object_same_language_across_surfaces": { "const": true },
        "compare_only_never_silently_writable": { "const": true },
        "structured_mode_never_flattened_without_explanation": { "const": true },
        "generated_from_relation_never_hidden": { "const": true },
        "canonical_source_labels_identical_across_surfaces": { "const": true },
        "risk_status_language_identical_across_surfaces": { "const": true },
        "raw_export_safe_fallback_kept_explicit": { "const": true },
        "redaction_posture_kept_explicit": { "const": true },
        "help_support_export_point_canonical_contracts": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true },
        "stale_or_underqualified_blocks_promotion": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_toolbar_reuses_shared_components",
        "merge_sheet_reuses_shared_components",
        "review_workspace_reuses_shared_components",
        "help_surface_reuses_shared_components",
        "support_packet_reuses_shared_components",
        "exported_view_reuses_shared_components",
        "every_component_adopted_by_two_or_more_consumers",
        "parity_facets_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_preserves_canonical_source_and_compare_only_posture"
      ],
      "properties": {
        "diff_toolbar_reuses_shared_components": { "const": true },
        "merge_sheet_reuses_shared_components": { "const": true },
        "review_workspace_reuses_shared_components": { "const": true },
        "help_surface_reuses_shared_components": { "const": true },
        "support_packet_reuses_shared_components": { "const": true },
        "exported_view_reuses_shared_components": { "const": true },
        "every_component_adopted_by_two_or_more_consumers": { "const": true },
        "parity_facets_identical_for_same_object": { "const": true },
        "narrowing_disclosed_not_hidden": { "const": true },
        "export_preserves_canonical_source_and_compare_only_posture": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
