{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-glossary-chip-card-safe-explanation-banner-controls.schema.json",
  "title": "Aureline M5 glossary chips/cards and safe explanation banners",
  "description": "Export-safe packet implementing the reusable M5 glossary-chip-or-card and safe-explanation-banner components in two co-equal control vectors. Each glossary chip or card names a term's meaning, its cited source class and citation freshness, and a stable cited file/symbol/docs source; its citation class is derived from the citation state, so a stale, offline, or missing citation can never read as current, and an uncited source can never claim to rest on cited source truth. Each safe explanation banner names a grounded explanation and its cited source, states an explicit explain-versus-do boundary, and derives its apply disposition from the apply state, so an explanation can never quietly become an unannounced mutation; an explain-only banner offers no do action, and any apply stays behind the ordinary preview/approval/undo model. No control masks privacy or offline/local-only state, hides its cited source or freshness, implies an apply-capable action or hidden authority, invents an alternate state label, or lets prose drift away from cited source truth; raw docs bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "glossary_entries",
    "explanation_banners",
    "downgrade_triggers",
    "consumer_surfaces",
    "learnability_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_glossary_chips_or_cards_and_safe_explanation_banners_with_cited_file_symbol_doc_truth_freshness_source_class_labels_and_explain_versus_do_separation_across_claimed_m5_learning_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "glossary_entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/glossary_entry" }
    },
    "explanation_banners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/explanation_banner" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "learnability_review": { "$ref": "#/$defs/learnability_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "source_class": {
      "enum": [
        "cited_docs",
        "cited_spec",
        "cited_help_pack",
        "community_note",
        "uncited_draft",
        "unknown_source"
      ]
    },
    "citation_state": {
      "enum": [
        "citation_current",
        "citation_versioned",
        "citation_stale",
        "citation_cached",
        "citation_offline_unavailable",
        "citation_missing"
      ]
    },
    "citation_class": {
      "enum": ["cited_current", "cited_stale", "cited_cached", "offline_unavailable", "uncited"]
    },
    "boundary_class": {
      "enum": [
        "explain_only",
        "explain_then_offer_do",
        "preview_required",
        "approval_required",
        "sandboxed_only",
        "no_hidden_apply"
      ]
    },
    "apply_state": {
      "enum": [
        "no_apply",
        "preview_available",
        "approval_pending",
        "applied_with_undo",
        "blocked_apply",
        "mutation_declined"
      ]
    },
    "apply_disposition": {
      "enum": [
        "explain_only",
        "preview_offered",
        "approval_pending",
        "applied_reversible",
        "apply_withheld"
      ]
    },
    "deep_link_kind": {
      "enum": ["command_reference", "file_location", "symbol_location", "docs_anchor", "no_deep_link"]
    },
    "glossary_action": {
      "enum": [
        "show_definition",
        "open_citation",
        "open_related_concept",
        "copy_term",
        "open_glossary_surface",
        "dismiss_chip"
      ]
    },
    "banner_action": {
      "enum": [
        "show_explanation",
        "open_citation",
        "open_related_concept",
        "preview_change",
        "request_approval",
        "dismiss_banner"
      ]
    },
    "disposition": {
      "enum": [
        "learning_on",
        "paused",
        "replayable",
        "sandboxed",
        "cached",
        "local_only",
        "not_installed",
        "no_hidden_apply"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "citation_source",
        "explain_versus_do_boundary",
        "progress_ownership_and_privacy"
      ]
    },
    "surface_family": {
      "enum": [
        "first_run_onboarding",
        "guided_tour",
        "learning_mode_panel",
        "glossary_surface",
        "inline_help",
        "cli_help"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "onboarding_ui",
        "tour_overlay_ui",
        "learning_panel_ui",
        "glossary_ui",
        "exercise_ui",
        "help_panel_ui",
        "cli_help",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "learning_mode_state_unstated",
        "tip_command_binding_unstated",
        "exercise_step_state_unstated",
        "glossary_citation_severed",
        "explanation_apply_boundary_unstated",
        "progress_ownership_unstated",
        "offline_or_local_only_state_hidden",
        "sandbox_boundary_unstated",
        "cached_state_hidden",
        "not_installed_state_hidden",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "glossary_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "entry_id",
        "term_label",
        "source_class",
        "citation_state",
        "citation_class",
        "claims_citation_current",
        "claims_source_backed",
        "term_meaning",
        "stale_note",
        "offline_note",
        "citation_missing_note",
        "source_backing_note",
        "citation_kind",
        "citation_ref",
        "citation_label",
        "entry_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_privacy_or_offline_state",
        "hides_citation_source_or_freshness",
        "implies_apply_capable_action_or_hidden_authority",
        "invents_alternate_state_label",
        "drifts_prose_from_cited_source_truth"
      ],
      "properties": {
        "component": { "const": "glossary_chip_or_card" },
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "term_label": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "citation_state": { "$ref": "#/$defs/citation_state" },
        "citation_class": { "$ref": "#/$defs/citation_class" },
        "claims_citation_current": { "type": "boolean" },
        "claims_source_backed": { "type": "boolean" },
        "term_meaning": { "$ref": "#/$defs/non_empty_string" },
        "stale_note": { "type": "string" },
        "offline_note": { "type": "string" },
        "citation_missing_note": { "type": "string" },
        "source_backing_note": { "type": "string" },
        "citation_kind": { "$ref": "#/$defs/deep_link_kind" },
        "citation_ref": { "type": "string" },
        "citation_label": { "$ref": "#/$defs/non_empty_string" },
        "entry_actions": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "open_related_concept" },
          "items": { "$ref": "#/$defs/glossary_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_privacy_or_offline_state": { "const": false },
        "hides_citation_source_or_freshness": { "const": false },
        "implies_apply_capable_action_or_hidden_authority": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "drifts_prose_from_cited_source_truth": { "const": false }
      }
    },
    "explanation_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "banner_id",
        "banner_label",
        "boundary_class",
        "apply_state",
        "apply_disposition",
        "claims_explain_only",
        "explanation_body",
        "explain_versus_do_note",
        "undo_note",
        "withheld_note",
        "offers_do_action",
        "do_disclosure_note",
        "citation_kind",
        "citation_ref",
        "citation_label",
        "banner_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_privacy_or_offline_state",
        "hides_citation_source_or_freshness",
        "implies_apply_capable_action_or_hidden_authority",
        "invents_alternate_state_label",
        "drifts_prose_from_cited_source_truth"
      ],
      "properties": {
        "component": { "const": "safe_explanation_banner" },
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "banner_label": { "$ref": "#/$defs/non_empty_string" },
        "boundary_class": { "$ref": "#/$defs/boundary_class" },
        "apply_state": { "$ref": "#/$defs/apply_state" },
        "apply_disposition": { "$ref": "#/$defs/apply_disposition" },
        "claims_explain_only": { "type": "boolean" },
        "explanation_body": { "$ref": "#/$defs/non_empty_string" },
        "explain_versus_do_note": { "$ref": "#/$defs/non_empty_string" },
        "undo_note": { "type": "string" },
        "withheld_note": { "type": "string" },
        "offers_do_action": { "type": "boolean" },
        "do_disclosure_note": { "type": "string" },
        "citation_kind": { "$ref": "#/$defs/deep_link_kind" },
        "citation_ref": { "type": "string" },
        "citation_label": { "$ref": "#/$defs/non_empty_string" },
        "banner_actions": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "show_explanation" },
          "items": { "$ref": "#/$defs/banner_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_privacy_or_offline_state": { "const": false },
        "hides_citation_source_or_freshness": { "const": false },
        "implies_apply_capable_action_or_hidden_authority": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "drifts_prose_from_cited_source_truth": { "const": false }
      }
    },
    "learnability_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glossary_cites_source_truth",
        "glossary_names_term_meaning",
        "glossary_shows_source_class_and_freshness",
        "glossary_offers_open_related_concept",
        "citation_freshness_derived_never_asserted",
        "uncited_prose_never_shown_as_cited",
        "explanation_states_explain_versus_do_boundary",
        "explanation_cites_grounding_source",
        "explanation_never_implies_apply_capable_action",
        "apply_disposition_derived_never_asserted",
        "explain_only_banner_offers_no_do_action",
        "any_apply_uses_preview_approval_or_undo",
        "no_control_widens_trust_or_mutating_authority",
        "educational_surfaces_distinct_from_apply_capable_actions",
        "cached_offline_local_only_state_visible",
        "no_surface_invents_alternate_state_label",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glossary_ui_reads_single_source",
        "explanation_ui_reads_single_source",
        "citation_source_and_freshness_visible_before_trust",
        "explain_versus_do_boundary_visible_before_tap",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
