{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-review-component-accessibility-parity.schema.json",
  "title": "M5 Review-Component Accessibility, Headless, and Export Parity Packet",
  "description": "Export-safe packet proving that the seven shared M5 review components (review-request row, checks-summary card, pending-review tray, merge-readiness panel, merge-queue entry, stack-dependency chip, approval-invalidation banner) expose keyboard, screen-reader, CLI, and export forms at parity with the desktop, and that each component's provider-backed claim automatically narrows to the ceiling permitted by its condition when provider freshness is stale, queue authority drops to a local estimate, approval lineage is missing, or an out-of-scope action requires a browser handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "accessibility_rows",
    "downgrade_triggers",
    "rendering_surfaces",
    "trust_review",
    "projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "review_component_accessibility_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "accessibility_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "rendering_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rendering_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "projection": { "$ref": "#/$defs/projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "review_request_row",
        "checks_summary_card",
        "pending_review_tray",
        "merge_readiness_panel",
        "merge_queue_entry",
        "stack_dependency_chip",
        "approval_invalidation_banner"
      ]
    },
    "claim_condition": {
      "type": "string",
      "enum": [
        "provider_fresh",
        "provider_freshness_stale",
        "queue_authority_local_estimate",
        "approval_lineage_missing",
        "browser_handoff_required"
      ]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "provider_backed",
        "locally_reviewable",
        "estimate_only",
        "approval_unverified",
        "handoff_required"
      ]
    },
    "rendering_surface": {
      "type": "string",
      "enum": ["desktop_full", "cli_headless", "support_export"]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "refresh_provider_freshness",
        "reconcile_queue_authority",
        "restore_approval_lineage",
        "open_browser_handoff",
        "continue_local_review"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "provider_freshness_stale",
        "queue_authority_dropped_to_local_estimate",
        "approval_lineage_missing",
        "browser_handoff_required",
        "claim_overstated",
        "parity_dropped",
        "trust_narrowing"
      ]
    },
    "claim_narrowing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "narrowed_to", "preserved_truth_note", "next_action", "next_action_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_to": { "$ref": "#/$defs/claim_tier" },
        "preserved_truth_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "component",
        "condition",
        "effective_claim",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "rendering_surfaces",
        "narrowing",
        "local_continue_note",
        "browser_handoff_note",
        "is_pointer_only",
        "is_export_opaque",
        "desktop_stronger_than_cli",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "condition": { "$ref": "#/$defs/claim_condition" },
        "effective_claim": { "$ref": "#/$defs/claim_tier" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "rendering_surfaces": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing": {
          "oneOf": [{ "$ref": "#/$defs/claim_narrowing" }, { "type": "null" }]
        },
        "local_continue_note": { "type": "string" },
        "browser_handoff_note": { "type": "string" },
        "is_pointer_only": { "const": false },
        "is_export_opaque": { "const": false },
        "desktop_stronger_than_cli": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Fresh provider truth keeps the full claim and never narrows.",
          "if": { "properties": { "condition": { "const": "provider_fresh" } } },
          "then": { "properties": { "narrowing": { "type": "null" } } }
        },
        {
          "comment": "Any weakening condition must carry an explicit narrow disclosure.",
          "if": {
            "properties": {
              "condition": {
                "enum": [
                  "provider_freshness_stale",
                  "queue_authority_local_estimate",
                  "approval_lineage_missing",
                  "browser_handoff_required"
                ]
              }
            }
          },
          "then": {
            "properties": { "narrowing": { "$ref": "#/$defs/claim_narrowing" } }
          }
        },
        {
          "comment": "A required browser handoff must carry an explicit handoff note.",
          "if": {
            "properties": { "condition": { "const": "browser_handoff_required" } }
          },
          "then": {
            "properties": { "browser_handoff_note": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard_reachable_on_every_claim",
        "screen_reader_labeled_on_every_claim",
        "cli_enum_exposed_on_every_claim",
        "export_enum_exposed_on_every_claim",
        "explanation_field_present_on_every_claim",
        "no_component_pointer_only",
        "no_component_export_opaque",
        "desktop_never_stronger_than_cli",
        "claim_narrows_when_provider_backing_weakens",
        "provider_backed_never_overstated_under_weakening",
        "browser_handoff_kept_explicit",
        "local_continue_preserved_under_degraded_backing"
      ],
      "properties": {
        "keyboard_reachable_on_every_claim": { "const": true },
        "screen_reader_labeled_on_every_claim": { "const": true },
        "cli_enum_exposed_on_every_claim": { "const": true },
        "export_enum_exposed_on_every_claim": { "const": true },
        "explanation_field_present_on_every_claim": { "const": true },
        "no_component_pointer_only": { "const": true },
        "no_component_export_opaque": { "const": true },
        "desktop_never_stronger_than_cli": { "const": true },
        "claim_narrows_when_provider_backing_weakens": { "const": true },
        "provider_backed_never_overstated_under_weakening": { "const": true },
        "browser_handoff_kept_explicit": { "const": true },
        "local_continue_preserved_under_degraded_backing": { "const": true }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposes_keyboard_and_screen_reader_labels",
        "exposes_cli_and_export_enums",
        "exposes_explanation_fields",
        "auto_narrows_on_stale_freshness",
        "auto_narrows_on_local_estimate_queue_authority",
        "auto_narrows_on_missing_approval_lineage",
        "auto_narrows_on_required_browser_handoff",
        "desktop_cli_export_semantics_identical",
        "narrowing_prevents_overstated_provider_truth",
        "every_component_reachable_non_visually"
      ],
      "properties": {
        "exposes_keyboard_and_screen_reader_labels": { "const": true },
        "exposes_cli_and_export_enums": { "const": true },
        "exposes_explanation_fields": { "const": true },
        "auto_narrows_on_stale_freshness": { "const": true },
        "auto_narrows_on_local_estimate_queue_authority": { "const": true },
        "auto_narrows_on_missing_approval_lineage": { "const": true },
        "auto_narrows_on_required_browser_handoff": { "const": true },
        "desktop_cli_export_semantics_identical": { "const": true },
        "narrowing_prevents_overstated_provider_truth": { "const": true },
        "every_component_reachable_non_visually": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
