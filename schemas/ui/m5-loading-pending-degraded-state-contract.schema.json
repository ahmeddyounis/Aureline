{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-loading-pending-degraded-state-contract.schema.json",
  "title": "Aureline M5 loading / pending / warning-error / degraded state-block contract primitive",
  "description": "Export-safe packet implementing the reusable M5 degraded-state-application contract as one primitive. The packet binds one row per claimed M5 workflow block — the form, the background job row, the banner, the card, the dense row, and the review sheet — to the shared degraded-state anatomy, the four governed states (loading/pending/warning-error/degraded), the derived presentation posture, the warning-vs-error severity, the required non-color cues, the required disclosures (state cause / owner / block reason / recovery action), the recovery-disclosure and state cause classes, the export fields, the mandatory labels, and the non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never presents pending as generic loading, never collapses warning and error, never omits consequence or recovery on an explainable state, and never invents a private state name. Raw local paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_loading_pending_warning_error_and_degraded_state_blocks_with_submission_lineage_health_and_recovery_truth_across_claimed_m5_workflows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "degraded_state_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "degraded_state_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_kind",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "degraded_states",
        "presentations",
        "severities",
        "non_color_cues",
        "required_disclosures",
        "recovery_disclosure_classes",
        "state_cause_classes",
        "export_fields",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "state_examples",
        "presents_pending_as_generic_loading",
        "collapses_warning_and_error",
        "omits_consequence_or_recovery",
        "invents_private_state_name"
      ],
      "properties": {
        "block_kind": {
          "enum": ["form", "job_row", "banner", "card", "row", "review_sheet"]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "degraded_states": { "type": "array", "minItems": 1 },
        "presentations": { "type": "array", "minItems": 1 },
        "severities": { "type": "array", "minItems": 1 },
        "non_color_cues": { "type": "array", "minItems": 1 },
        "required_disclosures": { "type": "array", "minItems": 1 },
        "recovery_disclosure_classes": { "type": "array", "minItems": 1 },
        "state_cause_classes": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "keyboard_focusable" } },
            { "contains": { "const": "non_color_encoded" } }
          ]
        },
        "required_labels": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "state_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_example" }
        },
        "presents_pending_as_generic_loading": { "const": false },
        "collapses_warning_and_error": { "const": false },
        "omits_consequence_or_recovery": { "const": false },
        "invents_private_state_name": { "const": false }
      }
    },
    "state_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "block_kind",
            "degraded_state",
            "presentation",
            "severity",
            "required_non_color_cues",
            "required_disclosures",
            "recovery_class",
            "state_cause",
            "recovery_available",
            "retains_partial_capability",
            "high_contrast_active",
            "block_identity_ref",
            "state_style_ref",
            "submission_lineage_ref",
            "disclosure_ref",
            "explainable",
            "user_submitted",
            "loading_and_pending_stay_distinct",
            "warning_and_error_stay_distinct",
            "error_and_degraded_stay_distinct",
            "pending_never_masquerades_as_loading",
            "names_consequence_and_recovery_when_explainable",
            "preserves_submission_lineage_and_capability",
            "no_color_only_signaling",
            "keyboard_and_screen_reader_explainable",
            "driven_by_shared_state_contract"
          ]
        }
      }
    }
  }
}
