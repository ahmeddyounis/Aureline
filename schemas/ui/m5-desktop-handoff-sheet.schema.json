{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-desktop-handoff-sheet.schema.json",
  "title": "Aureline M5 desktop-handoff-sheet component",
  "description": "Names the exact target it will open on desktop and whether an active host is required — so a user always knows exactly what opens on desktop before a tap and a desktop-required action never reads as companion-safe. Canonical per-component contract frozen by the M5 companion component matrix (schemas/ui/m5-companion-component-matrix.schema.json); downstream M5 rows point at this schema instead of restating companion UI truth by hand. Raw file bodies, diff hunks, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["component_family", "object_kind", "handoff_target", "requires_active_host", "client_scope", "dispositions", "required_labels"],
  "properties": {
    "component_family": { "const": "desktop_handoff_sheet" },
    "object_kind": { "$ref": "#/$defs/object_kind" },
    "handoff_target": { "enum": ["file_location", "review_panel", "ci_pipeline_run", "incident_workspace", "agent_session", "no_handoff"] },
    "requires_active_host": { "type": "boolean" },
    "client_scope": { "$ref": "#/$defs/client_scope" },
    "dispositions": { "$ref": "#/$defs/dispositions" },
    "required_labels": { "$ref": "#/$defs/required_labels" }
  },
  "$defs": {
"object_kind": {
      "enum": ["notification_event", "review_item", "ci_run", "followed_session", "incident_record", "handoff_intent"]
    },
    "severity": {
      "enum": ["critical", "high", "moderate", "low", "informational", "unspecified"]
    },
    "client_scope": {
      "enum": ["workspace_scoped", "repo_scoped", "org_scoped", "device_scoped", "account_global", "unscoped"]
    },
    "freshness": {
      "enum": ["live", "cached", "stale", "offline_held", "expired_snapshot", "unknown_freshness"]
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["review_only", "comment_capable", "desktop_required", "cached", "stale", "policy_blocked", "handoff_ready"]
      }
    },
    "required_labels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["identity", "state", "keyboard_route", "scope_and_freshness", "capability_boundary", "severity_and_handoff_target"]
      }
    }
  }
}
