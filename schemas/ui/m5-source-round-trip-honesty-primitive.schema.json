      "type": "string",
      "enum": [
        "target_id",
        "sync_class",
        "chip_state",
        "write_authority",
        "boundary_class",
        "downgrade_trigger"
      ]
    },
    "status_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "node_label",
        "file_label",
        "sync_class",
        "round_trip",
        "boundary",
        "protected_posture",
        "has_unsaved_visual_edit"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
        "file_label": { "$ref": "#/$defs/non_empty_string" },
        "sync_class": { "$ref": "#/$defs/sync_class" },
        "round_trip": { "$ref": "#/$defs/round_trip" },
        "boundary": { "$ref": "#/$defs/boundary_class" },
        "protected_posture": { "$ref": "#/$defs/protected_path_posture" },
        "has_unsaved_visual_edit": { "type": "boolean" },
