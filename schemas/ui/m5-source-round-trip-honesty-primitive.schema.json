        "designer_write_permitted": { "type": "boolean" },
        "requires_owner_flow": { "type": "boolean" },
        "refuses_silent_widening": { "const": true },
        "notice_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "resolved_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "node_label",
        "file_label",
        "sync_class",
        "round_trip",
        "boundary",
        "write_authority",
        "chip",
        "no_silent_writeback"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
