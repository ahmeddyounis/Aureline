        "preview_surface": { "$ref": "#/$defs/preview_surface" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "sync_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sync_class" }
        },
