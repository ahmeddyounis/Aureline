        "preview_surface",
        "owner_role",
        "scope_summary",
        "sync_classes",
        "boundary_classes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_statuses",
        "normalizes_unsupported_silently",
        "widens_write_scope_without_disclosure",
        "hides_read_only_narrowing",
