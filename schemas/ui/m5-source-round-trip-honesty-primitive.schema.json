{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-source-round-trip-honesty-primitive.schema.json",
  "title": "Aureline M5 source-round-trip honesty primitive: source-sync chip, round-trip conflict banner, unsupported-construct card, and generated-or-protected boundary notice",
  "description": "Export-safe packet implementing Aureline's one reusable source-round-trip honesty primitive across every claimed M5 visual-design surface — desktop designer, source-first preview, browser-runtime inspector, framework-pack preview, embedded shell designer, and support-export replay. Each surface row binds the shared chip / banner / card / notice contract and carries worked resolution cases: a resolver input (a target's source-sync class, round-trip capability, source-boundary class, protected-path posture, an optional round-trip conflict, and an optional unsupported construct) and the resolved source-sync chip, optional conflict banner, optional unsupported-construct card, optional boundary notice, and honest write authority, which share one target identity so a user never loses their place moving between chip, banner, card, and notice. An unsupported construct, an open conflict, a generated / managed section, or a protected file can never be silently normalized into a write path: whenever a hard block is present the resolved write authority is narrowed to a source-first fallback or read-only, never a plain writable surface. When round-trip support drops the resolver names an exact source-first fallback route instead of a best-effort writeback. Every narrowing or read-only outcome carries a typed downgrade trigger and a precise label so support and release packets can explain why the surface narrowed. The stored resolution must equal a fresh resolve of its input. Hard invariants forbid silently normalizing an unsupported construct, widening write scope without disclosure, hiding a read-only narrowing, and inventing a private round-trip grammar. The source-sync class, round-trip capability class, sync-recovery route, round-trip conflict class, conflict resolution route, unsupported-construct reason, protected-path posture, downgrade triggers, preview surface, and visual-design surface families are reused verbatim from the frozen M5 visual-designer component matrix and the sibling primitives. Raw source bodies, diff hunks, file contents, credentials, and raw provider payloads never cross this boundary. The Rust validator and resolver in crates/aureline-preview are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_source_sync_chip_round_trip_conflict_and_generated_or_protected_boundary_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "surface_family": {
      "type": "string",
      "enum": [
        "desktop_designer",
        "source_first_preview",
        "browser_runtime_inspector",
        "framework_pack_preview",
        "embedded_shell_designer",
        "support_export_replay"
      ]
    },
    "preview_surface": {
      "type": "string",
      "enum": [
        "source_first_framework_preview",
        "visual_surface_mapping",
        "browser_runtime_inspection",
        "device_or_simulator_preview",
        "full_stack_preview_loop",
        "embedded_webview_preview",
        "visual_edit_transform",
        "support_export_projection"
      ]
    },
    "sync_class": {
      "type": "string",
      "enum": [
        "in_sync_from_source",
        "pending_rebuild",
        "drifted_from_source",
        "runtime_only_no_source",
        "unidentified_source_sync"
      ]
    },
    "round_trip": {
      "type": "string",
      "enum": [
        "exact_source_round_trip",
        "approximate_source_round_trip",
        "inspect_only_no_write",
        "source_only_fallback",
        "no_round_trip"
      ]
    },
    "chip_state": {
      "type": "string",
      "enum": [
        "in_sync",
        "unsaved",
        "needs_refresh",
        "unsupported_construct",
        "conflict"
