    "resolved_unsupported_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "node_label",
        "file_label",
        "reason",
        "source_first_fallback",
        "open_source_action_available",
        "preserves_selection_context",
        "card_label"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
        "file_label": { "$ref": "#/$defs/non_empty_string" },
