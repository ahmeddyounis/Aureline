        "inspect_only_no_recovery"
      ]
    },
    "boundary_class": {
      "type": "string",
      "enum": [
        "author_owned",
        "generated_managed",
        "protected_read_only",
        "mixed_managed_region",
        "external_vendored"
      ]
    },
    "write_authority": {
      "type": "string",
      "enum": [
        "writable",
        "writable_with_review",
        "source_only_fallback",
        "read_only"
      ]
    },
    "source_first_fallback": {
      "type": "string",
      "enum": [
        "open_source_edit_directly",
        "reload_source_then_reapply",
        "keep_source_discard_visual",
        "open_managed_file_owner_flow",
        "inspect_only_no_write"
      ]
    },
    "conflict_class": {
      "type": "string",
      "enum": [
