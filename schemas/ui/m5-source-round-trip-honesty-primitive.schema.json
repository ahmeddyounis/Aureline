        "unsupported": { "$ref": "#/$defs/unsupported_reason" }
      }
    },
    "resolved_chip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "sync_class",
        "chip_state",
        "recovery_route",
        "open_source_action_available",
        "open_diff_action_available",
        "chip_label"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "sync_class": { "$ref": "#/$defs/sync_class" },
        "chip_state": { "$ref": "#/$defs/chip_state" },
        "recovery_route": { "$ref": "#/$defs/recovery_route" },
        "open_source_action_available": { "type": "boolean" },
        "open_diff_action_available": { "type": "boolean" },
        "chip_label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "resolved_conflict_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "node_label",
        "file_label",
        "conflict_class",
        "resolution_route",
        "source_first_fallback",
        "refresh_action_available",
        "compare_action_available",
        "never_silent_writeback",
        "preserves_selection_context",
        "banner_label"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
        "file_label": { "$ref": "#/$defs/non_empty_string" },
        "conflict_class": { "$ref": "#/$defs/conflict_class" },
        "resolution_route": { "$ref": "#/$defs/resolution_route" },
        "source_first_fallback": { "$ref": "#/$defs/source_first_fallback" },
        "refresh_action_available": { "type": "boolean" },
        "compare_action_available": { "type": "boolean" },
        "never_silent_writeback": { "const": true },
        "preserves_selection_context": { "const": true },
        "banner_label": { "$ref": "#/$defs/non_empty_string" }
      }
