{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-mode-change-review-sheet.schema.json",
  "title": "Aureline M5 mode-change review sheet",
  "description": "Stable UI contract for an M5 mode-change review sheet. The sheet names from/to mode, durable boundary change, preserved local state, cache disposition, export-before-change, and rollback path before any durable deployment boundary moves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "from_mode",
    "to_mode",
    "boundary_change",
    "preserved_local_state_ref",
    "cache_disposition",
    "rollback_path_state",
    "reviewed_before_durable_change",
    "discloses_cache_and_rollback",
    "export_before_change_available",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_mode_change_review_sheet" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "from_mode": { "$ref": "#/$defs/deployment_mode" },
    "to_mode": { "$ref": "#/$defs/deployment_mode" },
    "boundary_change": {
      "enum": ["state_root_migration", "channel_switch", "updater_ownership_change", "mirror_reattach", "online_offline_transition"]
    },
    "preserved_local_state_ref": { "$ref": "#/$defs/ref" },
    "cache_disposition": {
      "enum": ["reuse_valid", "invalidate_stale", "rebuild_required", "preserve_pinned"]
    },
    "rollback_path_state": {
      "enum": ["available", "requires_checkpoint", "unavailable", "not_applicable"]
    },
    "reviewed_before_durable_change": { "const": true },
    "discloses_cache_and_rollback": { "const": true },
    "export_before_change_available": { "const": true },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "deployment_mode": {
      "enum": ["desktop", "managed", "self_hosted", "portable", "air_gapped"]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "enum": ["mirror_stale", "offline_cache_only", "state_root_unavailable", "provenance_incomplete"] },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
