{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-build-remote-boundary-component-certification.schema.json",
  "title": "Aureline M5 build/remote-boundary component profile certification packet",
  "description": "M05-1083 closing capstone certifying that the frozen M5 build/remote-boundary component families (adapter-confidence chip, discovery-diff card, host-boundary strip, execution-origin receipt row, managed-workspace lifecycle card, suspend/resume/rebuild review sheet, workspace-expiry banner, local-safe continuation card) hold their truth on every claimed M5 build / remote / managed execution profile. Keyed on the claimed profile (local, SSH, container, devcontainer, managed workspace, suspend/resume, rebuild/recreate, expiry/local-safe), each row certifies the profile across six truth axes — visual, keyboard, screen-reader, CLI/export, degraded-state, and boundary-truth behavior — and either passes (green), auto-narrows its boundary-support claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh first-party full-truth claim inherited from a healthier profile or a spec guardrail is breached. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; a stale/unverified/unsupported profile can never keep a fresh first-party full-truth claim; only the local profile may certify a live full-truth claim; and no profile may imply exact continuity after a material change, hide local-safe / companion handoff in overflow only, or let lower-confidence discovery overwrite a resolved target without review. Every row cites exactly one canonical build/remote-boundary proof bundle. The packet is metadata-only: raw provider tokens, credential material, and bearer secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_build_remote_boundary_component_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-build-remote-boundary-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "local_execution",
        "ssh_execution",
        "container_execution",
        "devcontainer_execution",
        "managed_workspace",
        "suspend_resume",
        "rebuild_recreate",
        "expiry_local_safe"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "boundary_truth"
      ]
    },
    "support_claim": {
      "enum": [
        "full_truth",
        "resolved_truth",
        "degraded",
        "stale",
        "unverified",
        "unsupported"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "adapter_confidence_chip",
        "discovery_diff_card",
        "host_boundary_strip",
        "execution_origin_receipt_row",
        "managed_workspace_lifecycle_card",
        "suspend_resume_rebuild_review_sheet",
        "workspace_expiry_banner",
        "local_safe_continuation_card"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "adapter_confidence_unstated",
        "discovery_drift_hidden",
        "host_boundary_unstated",
        "execution_origin_unstated",
        "lifecycle_state_unstated",
        "expiry_timing_unstated",
        "persistence_change_hidden",
        "exact_continuity_overclaimed",
        "local_safe_or_companion_handoff_overflow_only",
        "lower_confidence_overwrote_resolved_target",
        "generic_status_wording_used",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implies_exact_continuity_after_material_change",
        "hides_local_safe_or_companion_handoff_in_overflow_only",
        "lower_confidence_overwrites_resolved_target_without_review"
      ],
      "properties": {
        "implies_exact_continuity_after_material_change": { "const": false },
        "hides_local_safe_or_companion_handoff_in_overflow_only": { "const": false },
        "lower_confidence_overwrites_resolved_target_without_review": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/support_claim" },
        "to_claim": { "$ref": "#/$defs/support_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_build_remote_boundary_component_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/support_claim" },
        "certified_claim": { "$ref": "#/$defs/support_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-build-remote-boundary-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
