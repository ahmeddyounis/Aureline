{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-chronology-export-preview.schema.json",
  "title": "Aureline M5 chronology-group primitive: grouped phases, narrative summary cards, timezone-safe export previews, and no-lost-causality ordering",
  "description": "Export-safe packet implementing Aureline's one reusable chronology-grouping primitive across every M5 history that leaves the live surface — AI, policy, task, remote, update, and support. Each surface row binds one history lane to the shared grouping / narrative / export anatomy: the phase / range labels, retained ordering, event counts, primary outcomes, and collapse / expand controls of timeline groups; the one-sentence current state, most recent consequential event, next action, and export / open-details path of the narrative summary card; and the selected range, included fields, time zone, redaction class, and output format of the export preview. Each lane carries worked resolution cases: a resolver input (a lane's ordered events, each with a phase, a monotonic causal sequence, an absolute timestamp, a relative scanning label, a stable verb, a provenance badge, a controlled outcome, an object / scope, a consequential flag, and an optional reopen anchor, plus an export request) and the resolved timeline groups, narrative card, and export preview — the stored resolution must equal a fresh resolve of its input. Hard invariants forbid flattening causal ordering, dropping the absolute timestamp behind the relative label, dropping the export redaction intent, and dropping export / audit truth. The stable chronology verbs, provenance badges, chronology detail states, chronology export fields, accessibility routes, qualification classes, and downgrade triggers are reused verbatim from the frozen M5 trust-chronology component matrix; the shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix. This module mints new vocabulary only for what the frozen matrix left implicit about grouping a chronology: its history lanes, phases, resolver-side outcomes, next actions, redaction classes, export output formats, surface anatomy, and focus behaviors. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary; only opaque export-safe reprs are carried. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_chronology_group_narrative_card_timezone_safe_export_preview_and_no_lost_causality_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
