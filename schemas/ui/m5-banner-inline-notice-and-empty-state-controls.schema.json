{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-banner-inline-notice-and-empty-state-controls.schema.json",
  "title": "Aureline M5 banner / inline-notice and empty-state controls",
  "description": "Export-safe packet for the third implement lane over the frozen M5 decision-feedback component matrix. It carries resolved, honest projections of the banner / inline notice and the empty state across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved banner examples (naming the label, the notice scope with no unscoped/color-only meaning, the state disposition, the surface context, the shared degraded-state variant, the action posture, and the cause/what-still-works/primary-next-action/support-back-link/no-generic-failure-language/reconstructable truth) and the resolved empty-state examples (naming the label, the empty-state purpose with no blank-no-explanation, the state disposition, the surface context, the shared degraded-state variant, the emptiness reason, and the purpose/emptiness/best-next-action/no-decorative-filler/no-generic-failure-language/reconstructable truth). Hard invariants forbid banners relying on color alone for meaning, banners using generic failure language, empty states blanking a pane without a next action, and empty states using decorative marketing filler. Acceptance criteria — claimed banner/empty-state consumers avoid generic failure language and always expose the next safe action; scope and degraded-state vocabulary stay consistent across local, remote, managed, and export-sensitive panes; and help/support/export packets can reconstruct why the pane was empty or bannered at the time of capture — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_banner_inline_notice_and_empty_state_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "banner_example": {
      "type": "object",
      "required": [
        "banner_id",
        "banner_label",
        "notice_scope",
        "scope_is_unscoped_or_color_only",
        "disposition",
        "surface_context",
        "degraded_variant",
        "action_posture",
        "cause_named",
        "what_still_works_stated",
        "primary_next_action_present",
        "support_or_help_backlink_present",
        "avoids_generic_failure_language",
        "reconstructable_from_export",
        "degrade_reason",
        "next_action",
        "states_scope_cause_and_next_action"
      ],
      "properties": {
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "banner_label": { "type": "string" },
        "notice_scope": { "$ref": "#/$defs/non_empty_string" },
        "scope_is_unscoped_or_color_only": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "degraded_variant": { "$ref": "#/$defs/non_empty_string" },
        "action_posture": { "$ref": "#/$defs/non_empty_string" },
        "cause_named": { "type": "boolean" },
        "what_still_works_stated": { "type": "boolean" },
        "primary_next_action_present": { "type": "boolean" },
        "support_or_help_backlink_present": { "type": "boolean" },
        "avoids_generic_failure_language": { "type": "boolean" },
        "reconstructable_from_export": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "states_scope_cause_and_next_action": { "type": "boolean" }
      }
    },
    "empty_state_example": {
      "type": "object",
      "required": [
        "empty_state_id",
        "empty_state_label",
        "empty_purpose",
        "purpose_is_blank_disallowed",
        "disposition",
        "surface_context",
        "degraded_variant",
        "empty_reason",
        "purpose_stated",
        "emptiness_explained",
        "best_next_action_present",
        "avoids_decorative_filler",
        "avoids_generic_failure_language",
        "reconstructable_from_export",
        "degrade_reason",
        "next_action",
        "states_purpose_emptiness_and_next_action"
      ],
      "properties": {
        "empty_state_id": { "$ref": "#/$defs/non_empty_string" },
        "empty_state_label": { "type": "string" },
        "empty_purpose": { "$ref": "#/$defs/non_empty_string" },
        "purpose_is_blank_disallowed": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "degraded_variant": { "$ref": "#/$defs/non_empty_string" },
        "empty_reason": { "$ref": "#/$defs/non_empty_string" },
        "purpose_stated": { "type": "boolean" },
        "emptiness_explained": { "type": "boolean" },
        "best_next_action_present": { "type": "boolean" },
        "avoids_decorative_filler": { "type": "boolean" },
        "avoids_generic_failure_language": { "type": "boolean" },
        "reconstructable_from_export": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "states_purpose_emptiness_and_next_action": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "banner_examples",
        "empty_state_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "banner_relies_on_color_alone_for_meaning",
        "banner_uses_generic_failure_language",
        "empty_state_blanks_pane_without_next_action",
        "empty_state_uses_decorative_marketing_filler"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "banner_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/banner_example" }
        },
        "empty_state_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/empty_state_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "banner_relies_on_color_alone_for_meaning": { "const": false },
        "banner_uses_generic_failure_language": { "const": false },
        "empty_state_blanks_pane_without_next_action": { "const": false },
        "empty_state_uses_decorative_marketing_filler": { "const": false }
      }
    }
  }
}
