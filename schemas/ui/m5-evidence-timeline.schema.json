{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-evidence-timeline.schema.json",
  "title": "Aureline M5 evidence timeline component",
  "description": "Canonical single-instance shape of the M5 evidence timeline inline component. Every claimed M5 evidence timeline references this schema or the combined m5-editor-inline-component-matrix.schema.json rather than reinventing its own state, severity, anchor, confidence, fix-posture, or evidence wording. The Rust validator in crates/aureline-editor is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "encodes_tab_marker_or_diagnostic_state_by_color_alone",
    "lets_comment_anchor_or_evidence_pointer_silently_drift",
    "blurs_outdated_and_resolved_review_state",
    "presents_inferred_fix_as_exact",
    "hides_evidence_timeline_in_opaque_log"
  ],
  "properties": {
    "component_family": {
      "const": "evidence_timeline"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "modified",
          "preview",
          "pinned",
          "read_only",
          "shared",
          "generated",
          "remote",
          "exact_fix",
          "inferred_fix",
          "outdated",
          "resolved",
          "re_anchored",
          "blocked_by_policy",
          "streaming",
          "review_required",
          "applied",
          "reverted",
          "failed",
          "export_safe_evidence"
        ]
      }
    },
    "tab_states": {
      "type": "array"
    },
    "gutter_marker_kinds": {
      "type": "array"
    },
    "diagnostic_severities": {
      "type": "array"
    },
    "fix_postures": {
      "type": "array"
    },
    "diff_change_kinds": {
      "type": "array"
    },
    "anchor_durabilities": {
      "type": "array"
    },
    "ai_confidences": {
      "type": "array"
    },
    "evidence_disclosures": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "encodes_tab_marker_or_diagnostic_state_by_color_alone": {
      "const": false
    },
    "lets_comment_anchor_or_evidence_pointer_silently_drift": {
      "const": false
    },
    "blurs_outdated_and_resolved_review_state": {
      "const": false
    },
    "presents_inferred_fix_as_exact": {
      "const": false
    },
    "hides_evidence_timeline_in_opaque_log": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
