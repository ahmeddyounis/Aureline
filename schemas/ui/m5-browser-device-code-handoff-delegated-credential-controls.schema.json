{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-browser-device-code-handoff-delegated-credential-controls.schema.json",
  "title": "Aureline M5 browser-or-device-code handoff cards and delegated-credential rows",
  "description": "Export-safe packet implementing the reusable M5 browser-device-code-handoff-card and delegated-credential-row components in two co-equal control vectors. Each browser-or-device-code handoff card names its provider / org, its auth-handoff flow kind, its fallback state, its local continuity, and why a safer boundary is preferred; its handoff-boundary class is derived from the auth-handoff class, so a system-browser redirect, a device-code poll, an in-app local capture, and a delegated / offline-deferred handoff can never blur into one generic sign-in state, and an in-app local capture can never quietly present as an out-of-app system-browser boundary. It names its device code / expiry wherever a device-code poll is in play and offers keyboard-complete continue / cancel actions. Each delegated-credential row names its source identity, target scope, storage class, expiration, and policy owner, and offers keyboard-complete stop-forward / rotate actions; its identity origin is derived from the delegated-identity state and the storage mode, so a forwarded, remote-vault-held, or service-issued identity can never read as a locally stored credential. Friendly connected wording never conceals the handoff boundary or a forwarded / delegated identity; raw secret values, tokens, passphrases, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "handoff_cards",
    "delegated_rows",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "browser_device_code_handoff_delegated_credential_controls" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "handoff_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/handoff_card" }
    },
    "delegated_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/delegated_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "storage_mode": {
      "type": "string",
      "enum": [
        "os_keychain",
        "encrypted_vault",
        "secret_broker_handle",
        "session_memory_only",
        "external_reference",
        "no_secret_stored"
      ]
    },
    "credential_class": {
      "type": "string",
      "enum": [
        "oauth_token",
        "api_key",
        "personal_access_token",
        "ssh_or_signing_key",
        "client_certificate",
        "device_code_grant"
      ]
    },
    "reveal_posture": {
      "type": "string",
      "enum": [
        "handle_only",
        "masked_last_four",
        "reveal_on_demand",
        "clipboard_scoped",
        "never_revealed",
        "policy_blocked_reveal"
      ]
    },
    "auth_handoff_class": {
      "type": "string",
      "enum": [
        "system_browser_redirect",
        "device_code_poll",
        "embedded_prompt",
        "passkey_step_up",
        "delegated_forward",
        "offline_deferred"
      ]
    },
    "delegated_identity_state": {
      "type": "string",
      "enum": [
        "local_identity",
        "forwarded_identity",
        "delegated_on_behalf",
        "impersonation_scoped",
        "service_account_acting",
        "delegation_revoked"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "active_current",
        "refresh_needed",
        "rotation_due",
        "revoked",
        "expired",
        "superseded"
      ]
    },
    "handoff_boundary_class": {
      "type": "string",
      "enum": [
        "system_browser_boundary",
        "device_code_boundary",
        "local_capture_boundary",
        "delegated_or_deferred_boundary"
      ]
    },
    "handoff_action": {
      "type": "string",
      "enum": [
        "continue_preferred_boundary",
        "copy_device_code",
        "switch_to_device_code",
        "use_local_fallback",
        "view_safer_boundary_rationale",
        "cancel"
      ]
    },
    "identity_origin": {
      "type": "string",
      "enum": ["locally_stored", "forwarded", "remote_vault", "service_issued"]
    },
    "target_scope": {
      "type": "string",
      "enum": ["provider", "registry", "request", "database", "remote", "release"]
    },
    "delegated_row_action": {
      "type": "string",
      "enum": [
        "stop_forward",
        "rotate",
        "revoke_delegation",
        "view_policy_owner",
        "open_source_of_truth",
        "export_row"
      ]
    },
    "degraded_state": {
      "type": "string",
      "enum": [
        "fully_available",
        "limited_capability",
        "stale_needs_reauth",
        "offline_cached",
        "policy_blocked",
        "unavailable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "storage_and_reveal_posture",
        "identity_and_delegation",
        "expiry_and_export_boundary"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "sign_in_and_auth",
        "provider_and_registry",
        "remote_and_database",
        "package_and_release",
        "recovery_and_audit",
        "cli_and_headless"
      ]
    },
    "deployment_line": {
      "type": "string",
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "credential_settings_ui",
        "secret_prompt_ui",
        "vault_picker_ui",
        "device_code_handoff_ui",
        "delegated_identity_ui",
        "support_export",
        "cli_inspect",
        "status_bar_ui",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "storage_mode_unstated",
        "reveal_posture_unstated",
        "credential_class_unstated",
        "auth_handoff_class_unstated",
        "delegated_identity_unstated",
        "lifecycle_state_hidden",
        "store_capability_unstated",
        "export_safety_boundary_hidden",
        "alternate_state_label_invented",
        "friendly_connected_wording_used",
        "session_only_fallback_hidden",
        "proof_stale"
      ]
    },
    "degraded_state_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/degraded_state" }
    },
    "required_label_array": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/required_label" },
      "allOf": [
        { "contains": { "const": "identity" } },
        { "contains": { "const": "state" } },
        { "contains": { "const": "keyboard_route" } }
      ]
    },
    "accessibility_route_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_route" },
      "contains": { "const": "keyboard_focusable" }
    },
    "handoff_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "provider_org_label",
        "auth_handoff_class",
        "flow_kind_label",
        "credential_class",
        "reveal_posture",
        "handoff_boundary_class",
        "claims_out_of_app_boundary",
        "system_browser_note",
        "device_code_note",
        "local_capture_disclosure_note",
        "delegated_deferred_note",
        "fallback_state_note",
        "local_continuity_note",
        "safer_boundary_rationale_note",
        "storage_and_reveal_note",
        "default_actions",
        "degraded_states",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_storage_or_reveal_posture",
        "blurs_handoff_into_generic_sign_in",
        "uses_friendly_connected_wording"
      ],
      "properties": {
        "component": { "const": "browser_device_code_handoff_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "provider_org_label": { "$ref": "#/$defs/non_empty_string" },
        "auth_handoff_class": { "$ref": "#/$defs/auth_handoff_class" },
        "flow_kind_label": { "$ref": "#/$defs/non_empty_string" },
        "credential_class": { "$ref": "#/$defs/credential_class" },
        "reveal_posture": { "$ref": "#/$defs/reveal_posture" },
        "handoff_boundary_class": { "$ref": "#/$defs/handoff_boundary_class" },
        "claims_out_of_app_boundary": { "type": "boolean" },
        "system_browser_note": { "type": "string" },
        "device_code_note": { "type": "string" },
        "local_capture_disclosure_note": { "type": "string" },
        "delegated_deferred_note": { "type": "string" },
        "fallback_state_note": { "$ref": "#/$defs/non_empty_string" },
        "local_continuity_note": { "$ref": "#/$defs/non_empty_string" },
        "safer_boundary_rationale_note": { "$ref": "#/$defs/non_empty_string" },
        "storage_and_reveal_note": { "$ref": "#/$defs/non_empty_string" },
        "default_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/handoff_action" },
          "allOf": [
            { "contains": { "const": "continue_preferred_boundary" } },
            { "contains": { "const": "cancel" } }
          ]
        },
        "degraded_states": { "$ref": "#/$defs/degraded_state_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_storage_or_reveal_posture": { "const": false },
        "blurs_handoff_into_generic_sign_in": { "const": false },
        "uses_friendly_connected_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "handoff_boundary_class": { "const": "system_browser_boundary" } },
            "required": ["handoff_boundary_class"]
          },
          "then": {
            "properties": { "system_browser_note": { "$ref": "#/$defs/non_empty_string" } },
            "required": ["claims_out_of_app_boundary"]
          }
        },
        {
          "if": {
            "properties": { "handoff_boundary_class": { "const": "device_code_boundary" } },
            "required": ["handoff_boundary_class"]
          },
          "then": {
            "properties": { "device_code_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "handoff_boundary_class": { "const": "local_capture_boundary" } },
            "required": ["handoff_boundary_class"]
          },
          "then": {
            "properties": {
              "local_capture_disclosure_note": { "$ref": "#/$defs/non_empty_string" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "handoff_boundary_class": { "const": "delegated_or_deferred_boundary" }
            },
            "required": ["handoff_boundary_class"]
          },
          "then": {
            "properties": { "delegated_deferred_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "handoff_boundary_class": { "const": "system_browser_boundary" } },
            "required": ["handoff_boundary_class"]
          },
          "then": {
            "properties": { "claims_out_of_app_boundary": { "const": true } },
            "required": ["claims_out_of_app_boundary"]
          },
          "else": {
            "properties": { "claims_out_of_app_boundary": { "const": false } },
            "required": ["claims_out_of_app_boundary"]
          }
        }
      ]
    },
    "delegated_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "delegated_identity_state",
        "source_identity_label",
        "target_scope",
        "target_scope_note",
        "storage_mode",
        "lifecycle_state",
        "expiration_note",
        "policy_owner_label",
        "identity_origin",
        "claims_locally_stored",
        "forwarded_note",
        "remote_vault_note",
        "service_issued_note",
        "revoked_note",
        "storage_class_note",
        "identity_and_delegation_note",
        "default_actions",
        "degraded_states",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_forwarded_or_delegated_identity",
        "implies_raw_secret_exportable",
        "uses_friendly_connected_wording"
      ],
      "properties": {
        "component": { "const": "delegated_credential_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "delegated_identity_state": { "$ref": "#/$defs/delegated_identity_state" },
        "source_identity_label": { "$ref": "#/$defs/non_empty_string" },
        "target_scope": { "$ref": "#/$defs/target_scope" },
        "target_scope_note": { "$ref": "#/$defs/non_empty_string" },
        "storage_mode": { "$ref": "#/$defs/storage_mode" },
        "lifecycle_state": { "$ref": "#/$defs/lifecycle_state" },
        "expiration_note": { "$ref": "#/$defs/non_empty_string" },
        "policy_owner_label": { "$ref": "#/$defs/non_empty_string" },
        "identity_origin": { "$ref": "#/$defs/identity_origin" },
        "claims_locally_stored": { "type": "boolean" },
        "forwarded_note": { "type": "string" },
        "remote_vault_note": { "type": "string" },
        "service_issued_note": { "type": "string" },
        "revoked_note": { "type": "string" },
        "storage_class_note": { "$ref": "#/$defs/non_empty_string" },
        "identity_and_delegation_note": { "$ref": "#/$defs/non_empty_string" },
        "default_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/delegated_row_action" },
          "allOf": [
            { "contains": { "const": "stop_forward" } },
            { "contains": { "const": "rotate" } }
          ]
        },
        "degraded_states": { "$ref": "#/$defs/degraded_state_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_forwarded_or_delegated_identity": { "const": false },
        "implies_raw_secret_exportable": { "const": false },
        "uses_friendly_connected_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "identity_origin": { "const": "forwarded" } },
            "required": ["identity_origin"]
          },
          "then": {
            "properties": { "forwarded_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "identity_origin": { "const": "remote_vault" } },
            "required": ["identity_origin"]
          },
          "then": {
            "properties": { "remote_vault_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "identity_origin": { "const": "service_issued" } },
            "required": ["identity_origin"]
          },
          "then": {
            "properties": { "service_issued_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "delegated_identity_state": { "const": "delegation_revoked" } },
            "required": ["delegated_identity_state"]
          },
          "then": {
            "properties": { "revoked_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "identity_origin": { "const": "locally_stored" } },
            "required": ["identity_origin"]
          },
          "then": {
            "properties": { "claims_locally_stored": { "const": true } },
            "required": ["claims_locally_stored"]
          },
          "else": {
            "properties": { "claims_locally_stored": { "const": false } },
            "required": ["claims_locally_stored"]
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_shows_provider_org_and_flow_kind",
        "handoff_flows_never_blur_into_generic_sign_in",
        "system_browser_device_code_local_capture_stay_distinct",
        "safer_boundary_rationale_always_shown",
        "card_shows_fallback_state_and_local_continuity",
        "device_code_and_expiry_shown_where_relevant",
        "row_shows_source_identity_and_target_scope",
        "row_shows_storage_class_and_expiration",
        "identity_origin_derived_never_asserted",
        "forwarded_delegated_never_reads_as_local",
        "remote_vault_and_service_issued_stay_distinct",
        "policy_owner_and_stop_forward_rotate_present",
        "raw_secret_handling_never_normalized",
        "no_friendly_connected_wording",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "card_shows_provider_org_and_flow_kind": { "const": true },
        "handoff_flows_never_blur_into_generic_sign_in": { "const": true },
        "system_browser_device_code_local_capture_stay_distinct": { "const": true },
        "safer_boundary_rationale_always_shown": { "const": true },
        "card_shows_fallback_state_and_local_continuity": { "const": true },
        "device_code_and_expiry_shown_where_relevant": { "const": true },
        "row_shows_source_identity_and_target_scope": { "const": true },
        "row_shows_storage_class_and_expiration": { "const": true },
        "identity_origin_derived_never_asserted": { "const": true },
        "forwarded_delegated_never_reads_as_local": { "const": true },
        "remote_vault_and_service_issued_stay_distinct": { "const": true },
        "policy_owner_and_stop_forward_rotate_present": { "const": true },
        "raw_secret_handling_never_normalized": { "const": true },
        "no_friendly_connected_wording": { "const": true },
        "controls_stable_across_deployment_lines": { "const": true },
        "copy_and_export_safe": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_shows_flow_kind_and_boundary_without_docs",
        "safer_boundary_visible_before_local_capture",
        "row_shows_identity_origin_and_scope_inline",
        "cli_headless_shows_control_truth",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "card_shows_flow_kind_and_boundary_without_docs": { "const": true },
        "safer_boundary_visible_before_local_capture": { "const": true },
        "row_shows_identity_origin_and_scope_inline": { "const": true },
        "cli_headless_shows_control_truth": { "const": true },
        "support_export_shows_control_truth": { "const": true },
        "help_about_shows_control_truth": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
