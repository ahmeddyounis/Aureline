{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-contextual-teaching-migration-bridge-component-matrix.schema.json",
  "title": "Aureline M5 contextual-tip-card, migration-bridge-card, sequence-help-strip, why-unavailable-explanation-row, and source-language-fallback component matrix",
  "description": "Export-safe packet freezing Aureline's reusable contextual-teaching, migration, and blocked-action explanation components. The packet names every teaching- and help-facing component family M5 claims that still drifts too easily by surface — contextual tip cards, migration bridge cards, sequence-help strips, why-unavailable explanation rows, and source-language fallback surfaces — and binds each to the claimed M5 onboarding/help surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: tip trigger classes and dismissal states; migration mapping classes (exact, native, bridge, shimmed, partial, unsupported) and imported source tools; sequence-help states and step kinds; shared command-backing states; blocked-action owners, unavailable reasons, and next safe actions; and source-language classes and fallback states. Hard invariants forbid masking a command binding or migration mapping, hiding a blocked-action owner or reason, inventing an alternate label for a governed state, and severing a source-language citation. Raw docs bodies, raw local paths, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-learning is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_the_m5_contextual_tip_card_migration_bridge_card_sequence_help_strip_why_unavailable_explanation_row_and_source_language_fallback_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "teaching_component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "teaching_component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "contextual_tip_card",
        "migration_bridge_card",
        "sequence_help_strip",
        "why_unavailable_explanation_row",
        "source_language_fallback"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "migration_mapping_class": {
      "enum": [
        "exact",
        "native",
        "bridge",
        "shimmed",
        "partial",
        "unsupported"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_command_binding_or_migration_mapping",
        "hides_blocked_action_owner_or_reason",
        "invents_alternate_state_label",
        "severs_source_language_citation"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "migration_mapping_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/migration_mapping_class" }
        },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "masks_command_binding_or_migration_mapping": { "const": false },
        "hides_blocked_action_owner_or_reason": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "severs_source_language_citation": { "const": false }
      }
    }
  }
}
