{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-review-pack-summary.schema.json",
  "title": "Aureline M5 review-pack summary",
  "description": "Per-component contract for a review-pack summary: the reusable component that names review-pack freshness and parity so a stale pack or one that has drifted from the current head is visible rather than presented as fresh. Binds the frozen governance-state vocabulary plus the freshness state (fresh, stale, or expired) and the parity state so a locally evaluated parity result is never presented as the provider's confirmed verdict. The Rust validator in crates/aureline-review is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "review_pack_label",
    "freshness_state",
    "parity_state",
    "governance_state_vocab"
  ],
  "properties": {
    "component": {
      "const": "review_pack_summary"
    },
    "review_pack_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "freshness_state": {
      "$ref": "#/$defs/freshness_state"
    },
    "parity_state": {
      "$ref": "#/$defs/parity_state"
    },
    "governance_state_vocab": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/governance_state_vocab"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "freshness_state": {
      "enum": [
        "fresh",
        "stale",
        "expired"
      ]
    },
    "parity_state": {
      "enum": [
        "in_parity",
        "drifted",
        "unknown"
      ]
    },
    "governance_state_vocab": {
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    }
  }
}
