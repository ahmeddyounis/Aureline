{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-shared-state-taxonomy-accessibility-fallback.schema.json",
  "title": "Aureline M5 shared-component-state accessibility & auto-narrowing fallback",
  "description": "Export-safe packet for the M05-938 accessibility / keyboard / screen-reader / CLI / export parity and honest auto-narrowing capstone over the frozen M5 shared-component-state-taxonomy / interactive-state / selection-or-lock-state / degraded-state-application matrix. Each row certifies one of the four canonical component families as keyboard-complete, assistive-tech-reachable, CLI/export-safe, and self-narrowing. When a state's cause cannot be resolved, a lock / disabled / read-only owner cannot be named, a degraded / warning / error state's recovery cannot be preserved, or the accessibility / export proof has gone stale, the component's state claim auto-narrows from exact_state_truth / reviewable_state_guidance to a cause-narrowed / owner-narrowed / recovery-narrowed / stale-proof projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical state-cause / owner / block-reason / recovery lineage. A missing-cause / missing-owner / missing-recovery state never masquerades as exact state truth. The packet is metadata-only: raw credentials, tokens, request bodies, and endpoint secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_shared_state_taxonomy_accessibility_fallback_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "shared_component_state_taxonomy",
        "interactive_state",
        "selection_or_lock_state",
        "degraded_state_application"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "state_claim": {
      "type": "string",
      "enum": [
        "exact_state_truth",
        "reviewable_state_guidance",
        "cause_narrowed_projection",
        "owner_narrowed_projection",
        "recovery_narrowed_projection",
        "stale_proof_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "state_semantics",
        "interaction_state",
        "selection_or_lock_state",
        "recovery_readiness"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "live_exact_state",
        "state_cause_unresolved",
        "lock_owner_unresolved",
        "recovery_unavailable",
        "proof_stale"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "precedence_rule_unstated",
        "state_cause_unstated",
        "lock_owner_masked",
        "current_selected_collapsed",
        "pending_shown_as_loading",
        "consequence_or_recovery_omitted",
        "color_only_treatment",
        "keyboard_route_missing",
        "read_only_inspectability_lost",
        "disclosure_requirement_unmet",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "state_cause",
        "owner_or_block_reason",
        "recovery_action"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "design_system_ui",
        "shell_ui",
        "command_ui",
        "help_ui",
        "settings_ui",
        "support_export",
        "cli_headless",
        "product_ui"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_lineage_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/state_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_lineage_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "state_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_state_claim",
        "claim_conditions",
        "lineage_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_shared_state_taxonomy_accessibility_fallback_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "state_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_state_claim": { "$ref": "#/$defs/state_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "lineage_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "hierarchy_heavy_family_count",
        "all_hierarchy_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_exact_state_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_lineage_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "hierarchy_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_hierarchy_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_exact_state_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_lineage_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
