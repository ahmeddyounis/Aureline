{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-badge-family-consumer.schema.json",
  "title": "M5 Badge-Family Consumer Packet",
  "description": "Adoption matrix binding every claimed M5 badge consumer (marketplace/install, Help/About, settings/policy, onboarding/start-center, diagnostics, support export, runtime/deployment, workspace/archetype) to the six canonical badge families (support class, evidence freshness, lifecycle, channel, deployment scope, compatibility state) and the one shared label / explanation / downgrade-reason / filter-key parity vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_marketplace_help_settings_onboarding_diagnostics_export_runtime_and_workspace_consumers_so_badge_families_keep_label_explanation_and_downgrade_parity_across_claimed_m5_profiles"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "marketplace",
        "help_about",
        "settings",
        "onboarding",
        "diagnostics",
        "support_export",
        "runtime",
        "workspace"
      ]
    },
    "badge_family": {
      "enum": [
        "support_class",
        "evidence_freshness",
        "lifecycle",
        "channel",
        "deployment_scope",
        "compatibility_state"
      ]
    },
    "parity_facet": {
      "enum": ["label", "explanation", "downgrade_reason", "filter_key"]
    },
    "render_mode": {
      "enum": [
        "full_claim_scope",
        "freshness_narrowed",
        "scope_narrowed",
        "export_projection"
      ]
    },
    "parity_state": {
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "enum": ["evidence_stale", "scope_reduced", "export_snapshot"]
    },
    "family_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "badge_family": { "$ref": "#/$defs/badge_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "const": true },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "type": "object" }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "parity_facets",
        "render_modes",
        "downgrade_caveats",
        "parity_states",
        "narrow_reasons",
        "narrow_next_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "family_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_axes_into_one_pill",
        "implies_freshness_from_support_class",
        "drops_badge_meaning_in_export",
        "rewords_labels_per_surface"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": { "type": "string" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "deployment_lines": { "type": "array", "items": { "type": "string" } },
        "anatomy_parts": { "type": "array", "items": { "type": "string" } },
        "parity_facets": {
          "type": "array",
          "items": { "$ref": "#/$defs/parity_facet" },
          "minItems": 4
        },
        "render_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/render_mode" }
        },
        "downgrade_caveats": { "type": "array", "items": { "type": "string" } },
        "parity_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/parity_state" }
        },
        "narrow_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        },
        "narrow_next_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } },
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } },
        "family_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/family_binding" }
        },
        "required_proof_packet_refs": { "type": "array", "items": { "type": "string" } },
        "source_contract_refs": { "type": "array", "items": { "type": "string" } },
        "collapses_axes_into_one_pill": { "const": false },
        "implies_freshness_from_support_class": { "const": false },
        "drops_badge_meaning_in_export": { "const": false },
        "rewords_labels_per_surface": { "const": false }
      }
    }
  }
}
