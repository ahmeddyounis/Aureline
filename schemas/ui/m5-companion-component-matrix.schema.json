{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-companion-component-matrix.schema.json",
  "title": "Aureline M5 notification-row, mobile-review-card, ci-status-card, session-follow-tile, incident-snapshot-card, and desktop-handoff-sheet component matrix",
  "description": "Export-safe packet freezing Aureline's reusable companion-client components. The packet names every companion-surface component family M5 claims that still drifts too easily by surface — notification rows, mobile review cards, CI-status cards, session-follow tiles, incident-snapshot cards, and desktop-handoff sheets — and binds each to the claimed M5 surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: object kinds, client scopes, freshness classes, the single controlled disposition vocabulary consumers bind to (review_only, comment_capable, desktop_required, cached, stale, policy_blocked, handoff_ready), severities, review kinds, CI statuses, session-follow states, notification categories, and exact handoff targets. Hard invariants forbid masking a client scope or freshness, hiding a companion-versus-desktop capability boundary, inventing an alternate label for a governed state, and implying a desktop-required action is companion-safe. Raw file bodies, diff hunks, secret values, and private endpoints never cross this boundary. The Rust validator in crates/aureline-companion is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_notification_row_mobile_review_card_ci_status_card_session_follow_tile_incident_snapshot_card_and_desktop_handoff_sheet_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "companion_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "companion_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "notification_row",
        "mobile_review_card",
        "ci_status_card",
        "session_follow_tile",
        "incident_snapshot_card",
        "desktop_handoff_sheet"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "object_kinds",
        "client_scopes",
        "freshness_classes",
        "dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_scope_or_freshness",
        "hides_capability_boundary",
        "invents_alternate_state_label",
        "implies_desktop_action_is_companion_safe"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "object_kinds": { "type": "array", "minItems": 1 },
        "client_scopes": { "type": "array", "minItems": 1 },
        "freshness_classes": { "type": "array", "minItems": 1 },
        "dispositions": { "type": "array", "minItems": 1 },
        "degraded_reasons": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "masks_scope_or_freshness": { "const": false },
        "hides_capability_boundary": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "implies_desktop_action_is_companion_safe": { "const": false }
      }
    }
  }
}
