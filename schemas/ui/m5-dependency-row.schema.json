{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-dependency-row.schema.json",
  "title": "Aureline M5 dependency row",
  "description": "Reusable dependency row for package manager, review, project-health, framework-pack health, companion, support, and release surfaces. The row preserves direct/transitive truth, version delta, manifest scope, advisory count, and changelog/license actions from canonical dependency packets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "row_id",
    "package_identity_ref",
    "resolved_identity_ref",
    "manifest_identity",
    "dependency_relation",
    "version_delta",
    "advisory_summary",
    "license_action",
    "changelog_action",
    "freshness_state",
    "degraded_state",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_dependency_row" },
    "schema_version": { "const": 1 },
    "row_id": { "$ref": "#/$defs/id" },
    "package_identity_ref": { "$ref": "#/$defs/ref" },
    "resolved_identity_ref": { "$ref": "#/$defs/ref" },
    "manifest_identity": { "$ref": "#/$defs/manifest_identity" },
    "dependency_relation": {
      "type": "string",
      "enum": ["direct", "transitive", "workspace_local", "path", "vcs"]
    },
    "version_delta": { "$ref": "#/$defs/version_delta" },
    "advisory_summary": { "$ref": "#/$defs/advisory_summary" },
    "license_action": { "$ref": "#/$defs/action_ref" },
    "changelog_action": { "$ref": "#/$defs/action_ref" },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "degraded_state": {
      "type": "string",
      "enum": ["none", "stale", "partial", "blocked", "policy_hidden", "advisory_feed_stale", "manifest_scope_unknown"]
    },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "freshness_state": { "type": "string", "enum": ["current", "live", "warm_cached", "stale", "partial", "blocked", "policy_hidden", "expired", "unknown"] },
    "manifest_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_ref", "scope_kind", "ecosystem", "workspace_or_workset_ref"],
      "properties": {
        "manifest_ref": { "$ref": "#/$defs/ref" },
        "scope_kind": { "type": "string", "enum": ["whole_workspace", "selected_manifest", "workset_slice", "workspace_member", "path_or_vcs_target"] },
        "ecosystem": { "type": "string", "enum": ["cargo", "node_pnpm", "python_pip", "other"] },
        "workspace_or_workset_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "version_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_version_repr", "target_version_repr", "requested_range_repr", "delta_class", "lockfile_authority"],
      "properties": {
        "current_version_repr": { "$ref": "#/$defs/ref" },
        "target_version_repr": { "$ref": "#/$defs/ref" },
        "requested_range_repr": { "$ref": "#/$defs/ref" },
        "delta_class": { "type": "string", "enum": ["none", "patch", "minor", "major", "security_patch", "lockfile_only", "workspace_convergence", "unknown"] },
        "lockfile_authority": { "type": "string", "enum": ["exact_lockfile_pinned", "manifest_range_governed", "frozen_by_policy", "lockfile_missing", "lockfile_divergent", "authority_unknown"] }
      }
    },
    "advisory_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory_count", "highest_severity", "advisory_freshness", "suppression_counts"],
      "properties": {
        "advisory_count": { "type": "integer", "minimum": 0 },
        "highest_severity": { "type": "string", "enum": ["none", "info", "low", "medium", "high", "critical", "blocking"] },
        "advisory_freshness": { "type": "string", "enum": ["current", "stale", "snapshot_only", "unknown"] },
        "suppression_counts": { "$ref": "#/$defs/suppression_counts" }
      }
    },
    "suppression_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsuppressed", "suppressed_until_review", "suppressed_by_policy", "exception_expired"],
      "properties": {
        "unsuppressed": { "type": "integer", "minimum": 0 },
        "suppressed_until_review": { "type": "integer", "minimum": 0 },
        "suppressed_by_policy": { "type": "integer", "minimum": 0 },
        "exception_expired": { "type": "integer", "minimum": 0 }
      }
    },
    "action_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_state", "action_ref", "available", "disabled_reason"],
      "properties": {
        "action_state": { "type": "string", "enum": ["available", "not_applicable", "blocked", "policy_hidden", "unavailable"] },
        "action_ref": { "$ref": "#/$defs/ref" },
        "available": { "type": "boolean" },
        "disabled_reason": { "$ref": "#/$defs/ref" }
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["package_manager", "review_pane", "project_health_center", "framework_pack_health", "companion_client", "support_export", "release_proof"] }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } },
        "export_fields": { "$ref": "#/$defs/ref_array" },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
