{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-lifecycle-and-channel-badge.schema.json",
  "title": "Aureline M5 lifecycle and channel badge primitive",
  "description": "Export-safe packet for the reusable M5 lifecycle / channel badge primitive. It narrows the lifecycle and channel families frozen in schemas/ui/m5-badge-family-matrix.schema.json into one resolver plus a parity matrix, so a user can tell — from the two badges and their explanation drawers alone — how mature a capability is (labs/preview/beta/stable/lts_surface/deprecated/removal_scheduled) and which channel it is merely running on (nightly/preview/beta/stable/lts), as two distinct, composable cues rather than one overloaded badge. Each badge row binds one claimed badge consumer (the command row, the feature surface, the workflow bundle, the extension/install row, the release/install surface, and the ecosystem lifecycle review lane) to the shared badge anatomy, lifecycle values, channel values, derived effective-maturity postures, sunset reasons, next actions, explanation-drawer fields, export fields, and non-visual accessibility routes, plus worked resolution cases that must reproduce the resolver output exactly. The resolver derives the effective maturity from the lifecycle axis alone — a stable capability running on a preview channel is still stable, because maturity is never derived from the channel — and when the lifecycle is deprecated or removal-scheduled it produces a self-contained migration note that points to a replacement/migration path and preserves the underlying channel context. Hard invariants forbid collapsing the two axes into one overloaded badge, implying the channel from the lifecycle, dropping the replacement/migration path when a badge is deprecated, and letting exported evidence lose badge meaning. Raw URLs, raw signing keys, raw tokens, credentials, and user text bodies never cross this boundary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "badge_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_lifecycle_and_channel_badges_across_claimed_m5_command_feature_bundle_extension_and_install_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "badge_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/badge_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "consumer_surface": {
      "enum": [
        "command_row",
        "feature_surface",
        "workflow_bundle",
        "extension_install_row",
        "release_install_surface",
        "ecosystem_lifecycle_review"
      ]
    },
    "lifecycle": {
      "enum": [
        "labs",
        "preview",
        "beta",
        "stable",
        "lts_surface",
        "deprecated",
        "removal_scheduled"
      ]
    },
    "channel": {
      "enum": ["nightly", "preview", "beta", "stable", "lts"]
    },
    "effective_maturity": {
      "enum": [
        "maturity_experimental",
        "maturity_preview",
        "maturity_beta",
        "maturity_stable",
        "maturity_long_term_supported",
        "maturity_deprecated",
        "maturity_removal_scheduled"
      ]
    },
    "sunset_reason": {
      "enum": ["deprecated", "removal_scheduled"]
    },
    "next_action": {
      "enum": ["follow_migration_path", "complete_migration_before_removal"]
    },
    "badge_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "anatomy_parts",
        "lifecycle_values",
        "channel_values",
        "effective_maturity_postures",
        "sunset_reasons",
        "next_actions",
        "explanation_fields",
        "export_fields",
        "accessibility_routes",
        "example_resolutions"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "lifecycle_values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lifecycle" }
        },
        "channel_values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/channel" }
        },
        "effective_maturity_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effective_maturity" }
        },
        "sunset_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sunset_reason" }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/next_action" }
        },
        "explanation_fields": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "collapses_lifecycle_and_channel_into_one_badge": { "const": false },
        "implies_channel_from_lifecycle": { "const": false },
        "drops_migration_path_on_deprecation": { "const": false },
        "drops_badge_meaning_in_export": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "subject_label",
            "lifecycle",
            "channel",
            "effective_maturity",
            "is_stable_line",
            "is_prerelease",
            "is_sunsetting",
            "last_evaluated_repr"
          ],
          "properties": {
            "lifecycle": { "$ref": "#/$defs/lifecycle" },
            "channel": { "$ref": "#/$defs/channel" },
            "effective_maturity": { "$ref": "#/$defs/effective_maturity" },
            "is_stable_line": { "type": "boolean" },
            "is_prerelease": { "type": "boolean" },
            "is_sunsetting": { "type": "boolean" },
            "migration_note": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": [
                    "reason",
                    "next_action",
                    "replacement_path",
                    "preserved_channel",
                    "is_removal_scheduled",
                    "headline"
                  ],
                  "properties": {
                    "reason": { "$ref": "#/$defs/sunset_reason" },
                    "next_action": { "$ref": "#/$defs/next_action" },
                    "replacement_path": { "$ref": "#/$defs/non_empty_string" },
                    "preserved_channel": { "$ref": "#/$defs/channel" },
                    "is_removal_scheduled": { "type": "boolean" },
                    "headline": { "$ref": "#/$defs/non_empty_string" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
