{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-diff-view-review-thread-controls.schema.json",
  "title": "Aureline M5 diff-view and review-thread controls",
  "description": "Export-safe packet for the third implement lane over the frozen M5 editor-inline component matrix. It carries resolved, honest projections of the diff view and the review thread across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved diff-view examples (naming the change kind with no collapse, the moved-versus-hidden context visibility, the source-versus-rendered relationship, the stable hunk identity, and an inspectable export-safe structural summary) and the resolved review-thread examples (naming the controlled thread state with one vocabulary, the comment-anchor durability, the provider-local-versus-provider-hosted locality, and the outdated-versus-resolved distinction). Hard invariants forbid moved or hidden diff context pretending one immutable view, hunk identity or source rendering silently drifting, outdated and resolved review state being blurred, and comment anchors or provider locality silently drifting. Acceptance criteria — claimed review flows expose the same thread-state grammar and anchor durability across desktop, browser handoff, and exported packets; diff consumers stay honest when context is moved, elided, collapsed, or re-anchored; and users distinguish outdated from resolved without color or provider-specific jargon — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-editor is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_diff_view_and_review_thread_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "diff_example": {
      "type": "object",
      "required": [
        "diff_id",
        "hunk_label",
        "change_kind",
        "change_kind_stated",
        "context_visibility",
        "context_is_moved",
        "context_is_hidden",
        "moved_disclosed",
        "hidden_context_disclosed",
        "source_rendering",
        "source_needs_disclosure",
        "rendering_disclosed",
        "hunk_identity",
        "hunk_is_stable",
        "hunk_reidentification_disclosed",
        "export_summary_structured",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "diff_legible_at_a_glance"
      ],
      "properties": {
        "diff_id": { "$ref": "#/$defs/non_empty_string" },
        "hunk_label": { "type": "string" },
        "change_kind": { "$ref": "#/$defs/non_empty_string" },
        "change_kind_stated": { "type": "boolean" },
        "context_visibility": { "$ref": "#/$defs/non_empty_string" },
        "context_is_moved": { "type": "boolean" },
        "context_is_hidden": { "type": "boolean" },
        "moved_disclosed": { "type": "boolean" },
        "hidden_context_disclosed": { "type": "boolean" },
        "source_rendering": { "$ref": "#/$defs/non_empty_string" },
        "source_needs_disclosure": { "type": "boolean" },
        "rendering_disclosed": { "type": "boolean" },
        "hunk_identity": { "$ref": "#/$defs/non_empty_string" },
        "hunk_is_stable": { "type": "boolean" },
        "hunk_reidentification_disclosed": { "type": "boolean" },
        "export_summary_structured": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "diff_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "thread_example": {
      "type": "object",
      "required": [
        "thread_id",
        "comment_label",
        "thread_state",
        "thread_state_stated",
        "is_outdated",
        "is_resolved",
        "is_outdated_or_resolved",
        "outdated_resolved_distinguished",
        "needs_send",
        "pending_send_disclosed",
        "anchor_durability",
        "anchor_is_durable",
        "anchor_is_drifted",
        "anchor_drift_disclosed",
        "provider_locality",
        "provider_is_hosted",
        "provider_distinction_explicit",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "thread_legible_at_a_glance"
      ],
      "properties": {
        "thread_id": { "$ref": "#/$defs/non_empty_string" },
        "comment_label": { "type": "string" },
        "thread_state": { "$ref": "#/$defs/non_empty_string" },
        "thread_state_stated": { "type": "boolean" },
        "is_outdated": { "type": "boolean" },
        "is_resolved": { "type": "boolean" },
        "is_outdated_or_resolved": { "type": "boolean" },
        "outdated_resolved_distinguished": { "type": "boolean" },
        "needs_send": { "type": "boolean" },
        "pending_send_disclosed": { "type": "boolean" },
        "anchor_durability": { "$ref": "#/$defs/non_empty_string" },
        "anchor_is_durable": { "type": "boolean" },
        "anchor_is_drifted": { "type": "boolean" },
        "anchor_drift_disclosed": { "type": "boolean" },
        "provider_locality": { "$ref": "#/$defs/non_empty_string" },
        "provider_is_hosted": { "type": "boolean" },
        "provider_distinction_explicit": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "thread_legible_at_a_glance": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "diff_examples",
        "thread_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "diff_moved_or_hidden_context_pretends_immutable_view",
        "diff_hunk_identity_or_source_rendering_silently_drifts",
        "review_outdated_and_resolved_state_blurred",
        "review_anchor_or_provider_locality_silently_drifts"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "diff_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diff_example" }
        },
        "thread_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/thread_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "diff_moved_or_hidden_context_pretends_immutable_view": { "const": false },
        "diff_hunk_identity_or_source_rendering_silently_drifts": { "const": false },
        "review_outdated_and_resolved_state_blurred": { "const": false },
        "review_anchor_or_provider_locality_silently_drifts": { "const": false }
      }
    }
  }
}
