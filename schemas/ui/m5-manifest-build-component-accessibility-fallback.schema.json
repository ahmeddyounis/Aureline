{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-manifest-build-component-accessibility-fallback.schema.json",
  "title": "M5 Manifest / Build Component Accessibility Fallback Packet",
  "description": "Keyboard, screen-reader, and CLI/export parity plus honest auto-narrowing of interactive claims (inspect-only/read-only/review-required) for the frozen M5 manifest / build component families when schema freshness, connector state, adapter capability, or target-graph truth is partial, stale, or policy-blocked (M05-818).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_manifest_build_component_accessibility_fallback_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "manifest_editor_header",
        "schema_validator_row",
        "target_context_chip_group",
        "resource_link_row",
        "resource_explorer_row",
        "adapter_source_badge",
        "target_graph_row",
        "capability_matrix",
        "raw_event_drawer",
        "fallback_confidence_drawer"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["graph", "list", "table", "textual"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "handoff_packet",
        "cli_headless",
        "support_export"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "manifest_workspace",
        "resource_explorer",
        "build_launcher",
        "target_graph_panel",
        "incident_support",
        "docs_help",
        "support_export",
        "release_proof"
      ]
    },
    "reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "narrowed_claim_tier": {
      "type": "string",
      "enum": ["fully_executable", "review_required", "read_only", "inspect_only"]
    },
    "claim_affordance_state": {
      "type": "string",
      "enum": ["matches_truth", "auto_narrowed_disclosed", "overclaimed"]
    },
    "schema_freshness": {
      "type": "string",
      "enum": ["fresh", "stale", "unversioned", "unavailable"]
    },
    "adapter_source_kind": {
      "type": "string",
      "enum": [
        "native_build_server",
        "native_build_event",
        "heuristic_parse",
        "imported_snapshot",
        "provider_overlay",
        "unknown"
      ]
    },
    "discovery_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "schema_stale",
        "adapter_unavailable",
        "connector_loss",
        "policy_block",
        "drift_from_source",
        "low_confidence_discovery",
        "structured_channel_lost",
        "target_context_unresolved"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "target_context",
        "truth_class",
        "freshness_or_confidence",
        "adapter_source",
        "keyboard_route"
      ]
    },
    "truth_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_freshness", "discovery_confidence", "connector_live", "policy_blocked"],
      "properties": {
        "schema_freshness": { "$ref": "#/$defs/schema_freshness" },
        "adapter_source": { "$ref": "#/$defs/adapter_source_kind" },
        "discovery_confidence": { "$ref": "#/$defs/discovery_confidence" },
        "connector_live": { "type": "boolean" },
        "policy_blocked": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "narrowed_label", "preserves_target_context"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_target_context": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "target_id",
        "target_context_ref",
        "fallback_modalities",
        "reaches_target_backed_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "truth_signals",
        "baseline_claim",
        "granted_claim",
        "claim_affordance",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_manifest_build_component_accessibility_fallback_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "target_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "reaches_target_backed_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/reach_state" },
        "cli_reach": { "$ref": "#/$defs/reach_state" },
        "truth_signals": { "$ref": "#/$defs/truth_signals" },
        "baseline_claim": { "$ref": "#/$defs/narrowed_claim_tier" },
        "granted_claim": { "$ref": "#/$defs/narrowed_claim_tier" },
        "claim_affordance": { "$ref": "#/$defs/claim_affordance_state" },
        "granted_actions": { "type": "array", "items": { "type": "string" } },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowing_disclosure" }
        },
        "auto_narrow": { "$ref": "#/$defs/auto_narrow" },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_count",
        "visual_heavy_family_count",
        "all_visual_heavy_have_non_visual_fallback",
        "all_reach_target_backed_truth_via_at",
        "all_claims_honest",
        "all_export_summaries_preserve_meaning",
        "all_narrowing_disclosed",
        "field_triage_and_publication_aligned",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "family_count": { "type": "integer", "minimum": 0 },
        "visual_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_visual_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_target_backed_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "field_triage_and_publication_aligned": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
