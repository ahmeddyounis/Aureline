{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-embedded-boundary-component-consumer.schema.json",
  "title": "Aureline M5 embedded-boundary component consumer adoption",
  "description": "M05-1074 consumer-adoption lane over the frozen M5 embedded-boundary component matrix. Proves that the eight reusable embedded / browser-handoff component families (docs-pane header, embedded-origin bar, boundary-fact grid, marketplace/account boundary card, auth-handoff card, remote/service dashboard header, open-in-browser handoff row, embedded-state panel) are reused as primitives across the claimed M5 embedded/browser-handoff consumer classes — docs/help panes, marketplace/account content, extension-owned embedded webviews, browser/device-code auth handoffs, remote/service dashboards, and support/export + release packets — rather than being reinvented as per-pane embedded chrome. Each row points back to exactly one canonical component family (its matrix schema) and the one canonical controls contract (schema + doc + release-proof artifact) its family group belongs to, and preserves the identical owner/origin, data-boundary, source/version/last-updated, network/offline-state, browser-fallback, account-scope, freshness, capability-limit, and no-embedded-high-risk-approval labels plus the frozen boundary-disposition vocabulary. The same origin/boundary state renders with one vocabulary and one component family across every claimed embedded/browser-handoff consumer (AC1); help/support/release packets drop bespoke per-pane prose (AC2). The four spec guardrails stay false per row: no consumer imitates native permission or irreversible approval UI, hides owner/origin or browser fallback behind menus only, renders a stale/offline/provider-blocked pane as fresh first-party local truth, or embeds a high-risk approval without a native step-up. The packet is metadata-only: raw provider tokens, credential material, and cookies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_embedded_boundary_component_consumer_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "docs_pane_header",
        "embedded_origin_bar",
        "boundary_fact_grid",
        "marketplace_account_boundary_card",
        "auth_handoff_card",
        "remote_service_dashboard_header",
        "open_in_browser_handoff_row",
        "embedded_state_panel"
      ]
    },
    "controls_lane": {
      "type": "string",
      "enum": [
        "docs_boundary_facts",
        "origin_state",
        "marketplace_handoff",
        "auth_dashboard"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "docs_help_pane",
        "marketplace_account",
        "embedded_webview",
        "auth_handoff",
        "remote_service_dashboard",
        "support_export_help"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "docs_browser_ui",
        "marketplace_ui",
        "account_ui",
        "remote_dashboard_ui",
        "embedded_webview_ui",
        "auth_handoff_ui",
        "support_export",
        "product_ui"
      ]
    },
    "authority_mode": {
      "type": "string",
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "override_gated",
        "export_only",
        "policy_blocked"
      ]
    },
    "handoff_target": {
      "type": "string",
      "enum": [
        "none",
        "desktop_shell",
        "companion_app",
        "browser_readonly",
        "support_packet",
        "cli_headless"
      ]
    },
    "label_parity": {
      "type": "string",
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_class",
        "consumer_surface",
        "component_family",
        "controls_lane",
        "canonical_family_schema_ref",
        "canonical_controls_schema_ref",
        "canonical_controls_artifact_refs",
        "references_canonical_not_local_prose",
        "boundary_state_ref",
        "authority_mode",
        "preserved_label_families",
        "boundary_disposition_vocab",
        "label_parity",
        "handoff_target",
        "copy_export",
        "imitates_native_permission_or_approval_ui",
        "hides_owner_origin_or_browser_fallback_in_menus_only",
        "renders_stale_or_blocked_as_fresh_first_party_truth",
        "embeds_high_risk_approval_without_native_step_up",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_embedded_boundary_component_consumer_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_class": { "$ref": "#/$defs/consumer_class" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "controls_lane": { "$ref": "#/$defs/controls_lane" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "boundary_state_ref": { "type": "string", "minLength": 1 },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "boundary_disposition_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "imitates_native_permission_or_approval_ui": {
          "type": "boolean",
          "const": false
        },
        "hides_owner_origin_or_browser_fallback_in_menus_only": {
          "type": "boolean",
          "const": false
        },
        "renders_stale_or_blocked_as_fresh_first_party_truth": {
          "type": "boolean",
          "const": false
        },
        "embeds_high_risk_approval_without_native_step_up": {
          "type": "boolean",
          "const": false
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_class_count",
        "consumer_surface_count",
        "component_family_count",
        "controls_lane_count",
        "boundary_disposition_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_use_canonical_controls_lane",
        "all_boundary_rows_preserve_primary_truth",
        "all_rows_reconstructable",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "all_rows_guardrails_clear",
        "controls_lanes_stable_across_surfaces",
        "docs_help_pane_consumer_present",
        "marketplace_account_consumer_present",
        "embedded_webview_consumer_present",
        "auth_handoff_consumer_present",
        "remote_service_dashboard_consumer_present",
        "support_export_help_consumer_present",
        "docs_help_reference_present",
        "support_export_reference_present",
        "label_family_coverage_complete",
        "boundary_disposition_coverage_complete",
        "families_reused_across_classes"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_class_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "controls_lane_count": { "type": "integer", "minimum": 0 },
        "boundary_disposition_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_use_canonical_controls_lane": { "type": "boolean" },
        "all_boundary_rows_preserve_primary_truth": { "type": "boolean" },
        "all_rows_reconstructable": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "all_rows_guardrails_clear": { "type": "boolean" },
        "controls_lanes_stable_across_surfaces": { "type": "boolean" },
        "docs_help_pane_consumer_present": { "type": "boolean" },
        "marketplace_account_consumer_present": { "type": "boolean" },
        "embedded_webview_consumer_present": { "type": "boolean" },
        "auth_handoff_consumer_present": { "type": "boolean" },
        "remote_service_dashboard_consumer_present": { "type": "boolean" },
        "support_export_help_consumer_present": { "type": "boolean" },
        "docs_help_reference_present": { "type": "boolean" },
        "support_export_reference_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "boundary_disposition_coverage_complete": { "type": "boolean" },
        "families_reused_across_classes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
