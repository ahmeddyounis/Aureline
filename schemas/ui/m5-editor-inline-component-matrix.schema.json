{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-editor-inline-component-matrix.schema.json",
  "title": "Aureline M5 editor-tab, gutter, diagnostic-decoration, code-action-chip, diff-view, review-thread, AI-message-card, and evidence-timeline inline component matrix",
  "description": "Export-safe packet freezing Aureline's reusable editor / review / AI inline UI components. The packet names every claimed M5 surface that still ships its own editor tab, gutter marker, diagnostic decoration, code-action chip, diff view, review thread, AI message card, or evidence timeline \u2014 across editor, diff/merge, review, notebook, AI, diagnostics, and support surfaces \u2014 and binds each to the claimed surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, reduced-motion, CLI/export, support-packet), the degraded reasons it can name, its canonical per-component schema, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: the single controlled inline-disposition vocabulary consumers bind to (modified, preview, pinned, read_only, shared, generated, remote, exact_fix, inferred_fix, outdated, resolved, re_anchored, blocked_by_policy, streaming, review_required, applied, reverted, failed, export_safe_evidence), plus family-specific editor-tab states, gutter-marker kinds, diagnostic severities, fix postures, diff change kinds, anchor durabilities, AI confidences, and evidence-disclosure states. Hard invariants forbid encoding tab / marker / diagnostic state by color alone, letting comment anchors or AI evidence pointers silently drift, blurring outdated and resolved review state, presenting an inferred fix as exact, and hiding an evidence timeline in an opaque log without inspectable structure. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-editor is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_editor_tab_gutter_diagnostic_decoration_code_action_chip_diff_view_review_thread_ai_message_card_and_evidence_timeline_component_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/component_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "component_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "component_family": {
      "enum": [
        "editor_tab",
        "gutter",
        "diagnostic_decoration",
        "code_action_chip",
        "diff_view",
        "review_thread",
        "ai_message_card",
        "evidence_timeline"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "modified",
        "preview",
        "pinned",
        "read_only",
        "shared",
        "generated",
        "remote",
        "exact_fix",
        "inferred_fix",
        "outdated",
        "resolved",
        "re_anchored",
        "blocked_by_policy",
        "streaming",
        "review_required",
        "applied",
        "reverted",
        "failed",
        "export_safe_evidence"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "encodes_tab_marker_or_diagnostic_state_by_color_alone",
        "lets_comment_anchor_or_evidence_pointer_silently_drift",
        "blurs_outdated_and_resolved_review_state",
        "presents_inferred_fix_as_exact",
        "hides_evidence_timeline_in_opaque_log"
      ],
      "properties": {
        "component_family": {
          "$ref": "#/$defs/component_family"
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "modified",
              "preview",
              "pinned",
              "read_only",
              "shared",
              "generated",
              "remote",
              "exact_fix",
              "inferred_fix",
              "outdated",
              "resolved",
              "re_anchored",
              "blocked_by_policy",
              "streaming",
              "review_required",
              "applied",
              "reverted",
              "failed",
              "export_safe_evidence"
            ]
          }
        },
        "tab_states": {
          "type": "array"
        },
        "gutter_marker_kinds": {
          "type": "array"
        },
        "diagnostic_severities": {
          "type": "array"
        },
        "fix_postures": {
          "type": "array"
        },
        "diff_change_kinds": {
          "type": "array"
        },
        "anchor_durabilities": {
          "type": "array"
        },
        "ai_confidences": {
          "type": "array"
        },
        "evidence_disclosures": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "encodes_tab_marker_or_diagnostic_state_by_color_alone": {
          "const": false
        },
        "lets_comment_anchor_or_evidence_pointer_silently_drift": {
          "const": false
        },
        "blurs_outdated_and_resolved_review_state": {
          "const": false
        },
        "presents_inferred_fix_as_exact": {
          "const": false
        },
        "hides_evidence_timeline_in_opaque_log": {
          "const": false
        }
      }
    }
  }
}
