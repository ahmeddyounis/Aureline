{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-flaky-state-badge.schema.json",
  "title": "Aureline M5 flaky-state-badge / retry-history-row primitive",
  "description": "Export-safe packet implementing the reusable M5 flaky-state badge and retry-history row as one twin primitive. The packet binds one row per claimed quality consumer — the flaky dashboard, the editor / test-tree flaky badge, the retry-history panel, the headless/CLI flaky-retry surface, and the flaky-retry export — to the shared badge and row anatomy, the derived flaky posture (stable/suspected/reproduced/stable-again/muted/unknown — one distinct posture per classification so a suspected verdict never borrows the authority of a reproduced one), the flaky confidence classes, the classifier sources, the mute / quarantine states, the derived retry posture (passed-first-try/passed-on-retry/failed-all-retries/errored/skipped/aborted — one distinct posture per outcome), the retry scope classes, the local/remote/notebook/imported-CI attempt origins, the provenance classes, bounded reveal/open-retry-history/rerun/mute-or-quarantine and reveal/rerun/open-logs/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the two resolvers, and four hard invariants: it never labels one intermittent failure as confirmed flakiness, never hides the retry window or classifier source behind a bare verdict, never drops the environment / build / runtime delta context a retry row needs to explain divergent outcomes, and never invents an alternate label for a governed flaky or retry state. Raw test payloads, pasted paths, credentials, and private endpoints never cross this boundary. This is the canonical packet schema; the retry-history-row companion schema at m5-retry-history-row.schema.json describes the retry resolution case shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_flaky_state_badges_and_retry_history_rows_with_controlled_verdict_vocabulary_classifier_confidence_retry_window_visibility_environment_drift_notes_and_rerun_or_open_logs_parity_across_claimed_m5_quality_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "test_evidence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "flaky_anatomy_parts",
        "retry_anatomy_parts",
        "flaky_classifications",
        "flaky_confidence_classes",
        "classifier_sources",
        "mute_states",
        "provenance_classes",
        "flaky_postures",
        "retry_attempt_outcomes",
        "retry_scope_classes",
        "retry_attempt_origins",
        "retry_postures",
        "flaky_actions",
        "retry_actions",
        "flaky_export_fields",
        "retry_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "flaky_examples",
        "retry_examples",
        "labels_intermittent_as_confirmed_flaky",
        "hides_retry_window_or_classifier_source",
        "drops_env_build_runtime_delta_context",
        "invents_alternate_flaky_or_retry_state_label"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "flaky_dashboard_panel",
            "editor_test_tree_badge",
            "retry_history_panel",
            "headless_cli_flaky_retry",
            "flaky_retry_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "flaky_anatomy_parts": { "type": "array", "minItems": 1 },
        "retry_anatomy_parts": { "type": "array", "minItems": 1 },
        "flaky_classifications": { "type": "array", "minItems": 1 },
        "flaky_confidence_classes": { "type": "array", "minItems": 1 },
        "classifier_sources": { "type": "array", "minItems": 1 },
        "mute_states": { "type": "array", "minItems": 1 },
        "provenance_classes": { "type": "array", "minItems": 1 },
        "flaky_postures": { "type": "array", "minItems": 1 },
        "retry_attempt_outcomes": { "type": "array", "minItems": 1 },
        "retry_scope_classes": { "type": "array", "minItems": 1 },
        "retry_attempt_origins": { "type": "array", "minItems": 1 },
        "retry_postures": { "type": "array", "minItems": 1 },
        "flaky_actions": { "type": "array", "minItems": 1 },
        "retry_actions": { "type": "array", "minItems": 1 },
        "flaky_export_fields": { "type": "array", "minItems": 1 },
        "retry_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "flaky_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/flaky_example" }
        },
        "retry_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/retry_example" }
        },
        "labels_intermittent_as_confirmed_flaky": { "const": false },
        "hides_retry_window_or_classifier_source": { "const": false },
        "drops_env_build_runtime_delta_context": { "const": false },
        "invents_alternate_flaky_or_retry_state_label": { "const": false }
      }
    },
    "flaky_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "classification",
            "confidence_class",
            "classifier_source",
            "provenance_class",
            "mute_state",
            "retry_window_size",
            "observed_failures",
            "last_outcome",
            "badge_identity_ref",
            "test_identity_ref",
            "flaky_posture",
            "available_actions",
            "has_sufficient_evidence_window",
            "claims_reproduced_flaky",
            "reproduced_claim_supported",
            "is_confirmed_flaky",
            "is_muted_or_quarantined",
            "needs_attention"
          ]
        }
      }
    },
    "retry_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "last_outcome",
            "recent_outcomes",
            "scope_class",
            "attempt_origin",
            "confidence_class",
            "provenance_class",
            "has_env_delta",
            "has_build_delta",
            "has_runtime_delta",
            "test_identity_ref",
            "attempt_log_ref",
            "row_posture",
            "available_actions",
            "is_divergent",
            "preserves_outcome_order",
            "discloses_env_build_runtime_delta",
            "explains_divergent_outcomes",
            "is_imported",
            "widened_scope",
            "has_log_continuity",
            "needs_attention"
          ]
        }
      }
    }
  }
}
