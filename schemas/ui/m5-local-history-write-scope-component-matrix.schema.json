{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-local-history-write-scope-component-matrix.schema.json",
  "title": "Aureline M5 local-history-row, checkpoint-group-card, restore-preview-card, retention/export-card, write-scope-preview-tree, restore-granularity-selector, and history-export-manifest component matrix",
  "description": "Export-safe packet freezing Aureline's reusable local-history and write-scope components. The packet names every mutation- and recovery-facing component family M5 claims that still drifts too easily by surface — local-history rows, checkpoint-group cards, restore-preview cards, retention/export cards, write-scope preview trees, restore-granularity selectors, and history-export manifests — and binds each to the claimed M5 mutation/recovery surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Each component declares the controlled vocabularies it carries: snapshot origins, actor classes, and capture fidelities; checkpoint lineage classes and mutation classes; restore granularities and drift states; retention postures and export-redaction postures; write-scope classes and managed-file caveats; restore-selection modes; and export-manifest classes. Hard invariants forbid masking a snapshot actor or timestamp, hiding a generated-or-managed-file caveat, inventing a private history grammar, and bypassing the restore-scope review. Raw snapshot bodies, restored file contents, raw local paths, raw usernames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-history is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_local_history_row_checkpoint_group_card_restore_preview_card_retention_export_card_write_scope_preview_tree_restore_granularity_selector_and_history_export_manifest_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "recovery_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "recovery_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "local_history_row",
        "checkpoint_group_card",
        "restore_preview_card",
        "retention_export_card",
        "write_scope_preview_tree",
        "restore_granularity_selector",
        "history_export_manifest"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_actor_or_timestamp",
        "hides_generated_or_managed_caveat",
        "invents_private_history_grammar",
        "bypasses_restore_scope_review"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "masks_actor_or_timestamp": { "const": false },
        "hides_generated_or_managed_caveat": { "const": false },
        "invents_private_history_grammar": { "const": false },
        "bypasses_restore_scope_review": { "const": false }
      }
    }
  }
}
