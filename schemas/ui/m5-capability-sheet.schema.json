{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-capability-sheet.schema.json",
  "title": "Aureline M5 capability-sheet primitive: consequence grouping, transitive scope, reduced mode, and revoke / re-consent",
  "description": "Export-safe packet implementing Aureline's one reusable capability-sheet primitive across every M5 trust lane that asks for meaningful access — extension install, AI tool, provider route, remote connector, automation flow, and privileged helper. Each surface row binds the shared capability-sheet anatomy (actor identity, purpose text, consequence-grouped requests, scope choice, reduced-mode option, approve/deny/detail actions, and the transitive-scope disclosure), the consequence classes and scope states reused verbatim from the frozen M5 trust-chronology component matrix, the consent disclosures that keep a remembered grant's revoke path visible and forbid silent scope widening, the focus behaviors that keep approval deliberate and the revoke path deep-linkable, and the export fields that let the support export reconstruct capability truth with the same vocabulary. Each lane carries worked resolution cases: a resolver input (an actor's requested capabilities, each with a consequence class, decision posture, policy pre-decision, transitive origin, and reduced-mode availability) and the resolved scope states, consequence groups, and transitive / reduced / re-consent / revocable flags — the stored resolution must equal a fresh resolve of its input. Hard invariants forbid dropping consequence grouping (a vague generic access prompt), hiding transitive scope, skipping required re-consent, and dropping export/audit truth. The shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix; the consequence class, scope state, accessibility route, qualification class, and downgrade trigger vocabularies are reused verbatim from the frozen M5 trust-chronology component matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary; only opaque export-safe reprs are carried. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_capability_sheet_consequence_grouping_transitive_scope_and_reconsent_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "surface_family": {
      "type": "string",
      "enum": [
        "extension_install",
        "ai_tool_request",
        "provider_route",
        "remote_connector",
        "automation_flow",
        "privileged_helper"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "type": "string",
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "type": "string",
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "anatomy_part": {
      "type": "string",
      "enum": [
        "actor_identity",
        "purpose_text",
        "consequence_grouped_requests",
        "scope_choice",
        "reduced_mode_option",
        "approve_action",
        "deny_action",
        "detail_action",
        "transitive_scope_disclosure"
      ]
    },
    "consequence_class": {
      "type": "string",
      "enum": [
        "read_local_context",
        "modify_workspace",
        "execute_code",
        "network_access",
        "credential_access",
        "system_control"
      ]
    },
    "scope_state": {
      "type": "string",
      "enum": [
        "requested_not_granted",
        "granted_full_scope",
        "granted_reduced_scope",
        "transitive_scope_disclosed",
        "re_consent_required",
        "revoked_with_history"
      ]
    },
    "consent_disclosure": {
      "type": "string",
      "enum": [
        "remembered_grant_shown",
        "revoke_path_shown",
        "no_silent_scope_widening",
        "re_consent_reason_explained",
        "reduced_scope_disclosed",
        "transitive_origin_shown"
      ]
    },
    "focus_behavior": {
      "type": "string",
      "enum": [
        "approve_requires_explicit_focus",
        "detail_side_sheet_escalation",
        "return_focus_on_close",
        "per_consequence_group_navigation",
        "reduced_mode_toggle_reachable",
        "deep_link_to_revoke"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "actor_identity_repr",
        "consequence_class",
        "capability_token",
        "scope_state",
        "transitive_origin_repr",
        "reduced_mode_offered",
        "revocable_from_settings"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "effective_configured_conflated",
        "source_pill_missing",
        "lock_state_unexplained",
        "consequence_grouping_dropped",
        "transitive_scope_hidden",
        "re_consent_skipped",
        "verb_vocabulary_drift",
        "provenance_badge_missing",
        "chronology_detail_not_reopenable",
        "export_field_dropped",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "decision": {
      "type": "string",
      "enum": ["requested_not_granted", "approve_full", "approve_reduced", "revoke"]
    },
    "policy_predecision": {
      "type": "string",
      "enum": ["no_policy", "pre_approved", "pre_denied"]
    },
    "request_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_token",
        "consequence_class",
        "purpose_repr",
        "decision",
        "policy_predecision",
        "is_transitive",
        "reduced_mode_available",
        "re_consent_triggered",
        "has_prior_grant"
      ],
      "properties": {
        "capability_token": { "$ref": "#/$defs/non_empty_string" },
        "consequence_class": { "$ref": "#/$defs/consequence_class" },
        "purpose_repr": { "$ref": "#/$defs/non_empty_string" },
        "decision": { "$ref": "#/$defs/decision" },
        "policy_predecision": { "$ref": "#/$defs/policy_predecision" },
        "is_transitive": { "type": "boolean" },
        "transitive_origin_repr": { "type": ["string", "null"] },
        "reduced_mode_available": { "type": "boolean" },
        "re_consent_triggered": { "type": "boolean" },
        "has_prior_grant": { "type": "boolean" }
      }
    },
    "resolution_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "actor_identity_repr", "requests"],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "actor_identity_repr": { "$ref": "#/$defs/non_empty_string" },
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/request_item" }
        }
      }
    },
    "resolved_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_token",
        "consequence_class",
        "scope_state",
        "policy_predecision",
        "is_transitive",
        "reduced_mode_offered",
        "revocable"
      ],
      "properties": {
        "capability_token": { "$ref": "#/$defs/non_empty_string" },
        "consequence_class": { "$ref": "#/$defs/consequence_class" },
        "scope_state": { "$ref": "#/$defs/scope_state" },
        "policy_predecision": { "$ref": "#/$defs/policy_predecision" },
        "is_transitive": { "type": "boolean" },
        "transitive_origin_repr": { "type": ["string", "null"] },
        "reduced_mode_offered": { "type": "boolean" },
        "revocable": { "type": "boolean" }
      }
    },
    "consequence_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consequence_class", "capability_tokens"],
      "properties": {
        "consequence_class": { "$ref": "#/$defs/consequence_class" },
        "capability_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "resolved_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "actor_identity_repr",
        "resolved_requests",
        "consequence_groups",
        "widens_effective_scope",
        "reduced_mode_offered",
        "requires_re_consent",
        "revocable_from_settings"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "actor_identity_repr": { "$ref": "#/$defs/non_empty_string" },
        "resolved_requests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_request" }
        },
        "consequence_groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consequence_group" }
        },
        "widens_effective_scope": { "type": "boolean" },
        "reduced_mode_offered": { "type": "boolean" },
        "requires_re_consent": { "type": "boolean" },
        "revocable_from_settings": { "type": "boolean" }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/resolution_input" },
        "resolved": { "$ref": "#/$defs/resolved_sheet" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "anatomy_parts",
        "consequence_classes",
        "scope_states",
        "consent_disclosures",
        "focus_behaviors",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_sheets",
        "drops_consequence_grouping",
        "hides_transitive_scope",
        "skips_required_re_consent",
        "drops_export_or_audit_truth"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "anatomy_parts": {
          "type": "array",
          "minItems": 8,
          "items": { "$ref": "#/$defs/anatomy_part" }
        },
        "consequence_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consequence_class" }
        },
        "scope_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scope_state" }
        },
        "consent_disclosures": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/consent_disclosure" }
        },
        "focus_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/focus_behavior" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "example_sheets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "drops_consequence_grouping": { "const": false },
        "hides_transitive_scope": { "const": false },
        "skips_required_re_consent": { "const": false },
        "drops_export_or_audit_truth": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "anatomy_parts",
        "consequence_classes",
        "scope_states",
        "consent_disclosures",
        "focus_behaviors",
        "export_fields",
        "accessibility_routes"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "$ref": "#/$defs/surface_family" } },
        "anatomy_parts": { "type": "array", "items": { "$ref": "#/$defs/anatomy_part" } },
        "consequence_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/consequence_class" }
        },
        "scope_states": { "type": "array", "items": { "$ref": "#/$defs/scope_state" } },
        "consent_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/consent_disclosure" }
        },
        "focus_behaviors": { "type": "array", "items": { "$ref": "#/$defs/focus_behavior" } },
        "export_fields": { "type": "array", "items": { "$ref": "#/$defs/export_field" } },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_sheet_groups_by_consequence",
        "transitive_scope_always_disclosed",
        "reduced_mode_visible_before_approval",
        "policy_and_re_consent_preserved",
        "remembered_approvals_revocable_from_stable_surface",
        "support_export_keeps_capability_vocabulary",
        "no_surface_uses_generic_access_prompt",
        "every_sheet_bound_to_shell_zone",
        "every_sheet_declares_accessibility_route",
        "later_sheets_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_sheet_groups_by_consequence": { "const": true },
        "transitive_scope_always_disclosed": { "const": true },
        "reduced_mode_visible_before_approval": { "const": true },
        "policy_and_re_consent_preserved": { "const": true },
        "remembered_approvals_revocable_from_stable_surface": { "const": true },
        "support_export_keeps_capability_vocabulary": { "const": true },
        "no_surface_uses_generic_access_prompt": { "const": true },
        "every_sheet_bound_to_shell_zone": { "const": true },
        "every_sheet_declares_accessibility_route": { "const": true },
        "later_sheets_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_lanes_consume_shared_sheet",
        "resolver_reads_single_scope_ladder",
        "revoke_path_reads_single_source",
        "transitive_disclosure_reads_single_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "trust_lanes_consume_shared_sheet": { "const": true },
        "resolver_reads_single_scope_ladder": { "const": true },
        "revoke_path_reads_single_source": { "const": true },
        "transitive_disclosure_reads_single_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "capability_sheet_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "capability_sheet_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
