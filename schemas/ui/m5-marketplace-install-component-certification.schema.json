{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-marketplace-install-component-certification.schema.json",
  "title": "M5 Marketplace / Install-Review Component Surface Certification",
  "description": "M05-1107 closing capstone certifying that the frozen M5 marketplace-result-row / detail-fact-grid / compatibility-label / permission-manifest / activation-budget / install-review / publisher-continuity / installed-state-diagnostics component truth holds on every claimed M5 public / mirrored / enterprise registry profile, auto-narrowing any profile that cannot sustain it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_marketplace_install_component_certification_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "type": "string",
      "const": "artifacts/release/m5-marketplace-install-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "profile": {
      "type": "string",
      "enum": [
        "public_verified_registry",
        "mirrored_registry",
        "enterprise_registry",
        "side_load_reviewed_registry",
        "stale_compatibility_registry",
        "over_budget_throttled_registry",
        "rollback_unverifiable_registry",
        "transferred_publisher_registry"
      ]
    },
    "claim": {
      "type": "string",
      "enum": [
        "install_ready_result",
        "reviewable_listing_result",
        "compatibility_unverified_projection",
        "permission_unverified_projection",
        "activation_budget_projection",
        "rollback_unverified_projection",
        "publisher_continuity_projection",
        "quarantine_history_projection"
      ]
    },
    "family": {
      "type": "string",
      "enum": [
        "marketplace_result_row",
        "marketplace_detail_fact_grid",
        "compatibility_label_strip",
        "permission_manifest_summary",
        "activation_budget_band",
        "install_update_disable_rollback_review_sheet",
        "publisher_continuity_row",
        "installed_state_diagnostics_card"
      ]
    },
    "axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "registry_install_truth"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "status": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "compatibility_range_unstated",
        "host_model_unstated",
        "permission_widening_hidden",
        "transitive_permission_hidden",
        "activation_cost_hidden",
        "publisher_transfer_hidden",
        "registry_source_class_collapsed",
        "disable_scope_unstated",
        "rollback_incompatibility_hidden",
        "quarantine_history_hidden",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hides_permission_widening_or_activation_cost",
        "hides_publisher_transfer_disable_scope_or_rollback_incompatibility",
        "collapses_registry_source_class_across_public_mirrored_enterprise",
        "presents_incompatible_or_over_budget_as_ready"
      ],
      "properties": {
        "hides_permission_widening_or_activation_cost": { "type": "boolean", "const": false },
        "hides_publisher_transfer_disable_scope_or_rollback_incompatibility": {
          "type": "boolean",
          "const": false
        },
        "collapses_registry_source_class_across_public_mirrored_enterprise": {
          "type": "boolean",
          "const": false
        },
        "presents_incompatible_or_over_budget_as_ready": { "type": "boolean", "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "enum": ["text", "json", "markdown"] },
          "minItems": 3
        },
        "export_fields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "screenshot_only_prohibited": { "type": "boolean", "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/axis" },
        "from_claim": { "$ref": "#/$defs/claim" },
        "to_claim": { "$ref": "#/$defs/claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_marketplace_install_component_certification_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/profile" },
        "claimed_claim": { "$ref": "#/$defs/claim" },
        "certified_claim": { "$ref": "#/$defs/claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "type": "string",
          "const": "artifacts/release/m5-marketplace-install-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
