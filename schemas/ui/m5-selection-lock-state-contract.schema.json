{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-selection-lock-state-contract.schema.json",
  "title": "Aureline M5 selection-or-lock-state contract primitive",
  "description": "Export-safe packet implementing the reusable M5 selection-or-lock-state contract as one primitive. The packet binds one row per claimed M5 collection surface — the tab, the tree item, the dense list row, the grid/table row, the badge, the settings row, and the inspector entry — to the shared selection-or-lock anatomy, the five governed states (selected/current/disabled/read-only/locked), the derived presentation posture, the required non-color cues, the required disclosures (state cause / owner / block reason / recovery action), the lock owner and state cause classes, the export fields, the mandatory labels, and the non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never collapses selected and current, never hides a lock behind a disabled treatment, never drops read-only inspectability, and never invents a private state name. Raw local paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_selected_current_read_only_disabled_and_locked_state_parity_with_owner_reason_recovery_truth_across_claimed_m5_tabs_trees_lists_tables_badges_and_inspectors"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "selection_or_lock_state_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "selection_or_lock_state_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_kind",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "selection_or_lock_states",
        "presentations",
        "non_color_cues",
        "required_disclosures",
        "lock_owner_classes",
        "state_cause_classes",
        "export_fields",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "state_examples",
        "collapses_selected_and_current",
        "hides_lock_behind_disabled",
        "drops_read_only_inspectability",
        "invents_private_state_name"
      ],
      "properties": {
        "item_kind": {
          "enum": [
            "tab",
            "tree_item",
            "list_row",
            "table_row",
            "badge",
            "settings_row",
            "inspector_entry"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "selection_or_lock_states": { "type": "array", "minItems": 1 },
        "presentations": { "type": "array", "minItems": 1 },
        "non_color_cues": { "type": "array", "minItems": 1 },
        "required_disclosures": { "type": "array", "minItems": 1 },
        "lock_owner_classes": { "type": "array", "minItems": 1 },
        "state_cause_classes": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "keyboard_focusable" } },
            { "contains": { "const": "non_color_encoded" } }
          ]
        },
        "required_labels": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "state_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_example" }
        },
        "collapses_selected_and_current": { "const": false },
        "hides_lock_behind_disabled": { "const": false },
        "drops_read_only_inspectability": { "const": false },
        "invents_private_state_name": { "const": false }
      }
    },
    "state_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "item_kind",
            "selection_or_lock_state",
            "presentation",
            "required_non_color_cues",
            "required_disclosures",
            "lock_owner",
            "state_cause",
            "recovery_available",
            "inspectable",
            "high_contrast_active",
            "item_identity_ref",
            "state_style_ref",
            "disclosure_ref",
            "explainable",
            "owner_disclosed",
            "selected_and_current_stay_distinct",
            "read_only_preserves_inspectability",
            "lock_never_hidden_behind_disabled",
            "no_color_only_signaling",
            "names_owner_and_recovery_when_explainable",
            "keyboard_and_screen_reader_explainable",
            "driven_by_shared_state_contract"
          ]
        }
      }
    }
  }
}
