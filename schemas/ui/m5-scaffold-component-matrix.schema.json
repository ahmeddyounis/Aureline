{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-scaffold-component-matrix.schema.json",
  "title": "Aureline M5 scaffold-template-card, starter-parameter-row, scaffold-preflight-card, template-health-row, generated-project-diff-card, and scaffold-handoff-banner component matrix",
  "description": "Export-safe packet freezing Aureline's reusable scaffold / project-entry components. The packet names every starter-generation and project-entry component family M5 claims that still drifts too easily by surface — scaffold template cards, starter parameter rows, scaffold preflight cards, template health rows, generated-project diff cards, and scaffold handoff banners — and binds each to the claimed M5 project-entry / starter-generation surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Every component binds the one controlled disposition vocabulary (first_party, team_managed, community, local_only, create_empty, continue_without_starter, blocked, warning, optional) plus the family-specific controlled vocabularies it carries: starter source classes and template support classes; parameter source layers and action timings; preflight check classes and result states; health signal classes and freshness states; generated-zone classes and diff-review states; and handoff outcome classes and recovery actions. Hard invariants forbid hiding a starter source / support class, hiding a network / dependency / provisioning / trust side effect behind a generic Create, blurring the generated-versus-user-owned boundary, omitting a delete-generated or continue-without-starter recovery path, and inventing an alternate label for a governed state. Raw file bodies, raw diffs, raw local paths, repository URLs, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_the_m5_scaffold_template_card_starter_parameter_row_scaffold_preflight_card_template_health_row_generated_project_diff_card_and_scaffold_handoff_banner_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "scaffold_component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "scaffold_component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "scaffold_template_card",
        "starter_parameter_row",
        "scaffold_preflight_card",
        "template_health_row",
        "generated_project_diff_card",
        "scaffold_handoff_banner"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "first_party",
        "team_managed",
        "community",
        "local_only",
        "create_empty",
        "continue_without_starter",
        "blocked",
        "warning",
        "optional"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_starter_source_or_support_class",
        "hides_side_effect_behind_generic_create",
        "hides_generated_versus_user_owned_boundary",
        "omits_recovery_or_continue_without_starter_path",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "hides_starter_source_or_support_class": { "const": false },
        "hides_side_effect_behind_generic_create": { "const": false },
        "hides_generated_versus_user_owned_boundary": { "const": false },
        "omits_recovery_or_continue_without_starter_path": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    }
  }
}
