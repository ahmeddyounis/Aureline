{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-workflow-bundle-component-accessibility-fallback.schema.json",
  "title": "Aureline M5 workflow-bundle component accessibility fallback",
  "description": "M05-850 accessibility-and-auto-narrowing capstone over the frozen M5 workflow-bundle component matrix. Certifies, per component family (start-center bundle card, certified-archetype badge group, bundle detail page, install/update review sheet, drift banner, local-override row, rollback/remove card, class-disclosure card, claim-narrowing row), that workflow-bundle claims stay keyboard-complete, screen-reader-reachable, CLI/export-safe, and honestly self-narrowing. When bundle freshness, certification evidence, source provenance, artifact availability, or dependency posture is partial, stale, imported, mirror-only, offline, or policy-blocked, the component's bundle-support claim auto-narrows to supported / limited / retest-pending / imported / mirror-only / offline-cache-only / policy-blocked, discloses the narrowing with a precise frozen trigger and binding dimension, and preserves the canonical bundle identity rather than silently dropping it. A stale or partial bundle can no longer present as fully certified or fully self-sufficient (AC1); accessibility and export surfaces preserve the same bundle IDs, source classes, evidence ages, and drift states shown in-product (AC2); the same narrowed state surfaces across UI, docs/help, migration, diagnostics, and support/admin exports (AC3). The packet is metadata-only: raw manifests, credentials, entitlement tokens, and provider cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_workflow_bundle_component_accessibility_fallback_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "start_center_bundle_card",
        "certified_archetype_badge_group",
        "bundle_detail_page",
        "bundle_install_update_review_sheet",
        "bundle_drift_banner",
        "bundle_local_override_row",
        "bundle_rollback_remove_card",
        "bundle_class_disclosure_card",
        "bundle_claim_narrowing_row"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "handoff_packet",
        "support_export"
      ]
    },
    "non_visual_reach": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary": {
      "type": "string",
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "support_claim": {
      "type": "string",
      "enum": [
        "certified",
        "supported",
        "limited",
        "retest_pending",
        "imported",
        "mirror_only",
        "offline_cache_only",
        "policy_blocked"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "bundle_freshness",
        "certification_evidence",
        "source_provenance",
        "artifact_availability",
        "dependency_posture"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "intact",
        "partial",
        "stale",
        "imported",
        "mirror_stale",
        "offline_only",
        "policy_blocked"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "stale_certification",
        "mirror_stale",
        "offline_cache_only",
        "unverified_signer",
        "local_override_drift",
        "incompatible_aureline",
        "entitlement_dependency_unmet",
        "imported_not_native",
        "rollback_only_path"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "bundle_identity",
        "signer_source",
        "support_class",
        "certification_freshness",
        "mirror_offline_posture",
        "keyboard_route"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "start_center_class_card",
        "bundle_detail_class_panel",
        "migration_class_disclosure_row",
        "docs_help_class_block",
        "diagnostics_class_report",
        "support_export_replay"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/support_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "bundle_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_support_claim",
        "claim_conditions",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_workflow_bundle_component_accessibility_fallback_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "bundle_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach" },
        "export_summary": { "$ref": "#/$defs/export_summary" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_support_claim": { "$ref": "#/$defs/support_claim" },
        "claim_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition_entry" }
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_count",
        "hierarchy_heavy_family_count",
        "all_hierarchy_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_export_summaries_preserve_meaning",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "family_count": { "type": "integer", "minimum": 0 },
        "hierarchy_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_hierarchy_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
