{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-embedded-boundary-component-accessibility-parity.schema.json",
  "title": "Aureline M5 embedded-boundary component accessibility parity",
  "description": "M05-1073 accessibility-and-auto-narrowing capstone over the frozen M5 embedded-boundary component matrix. Certifies, per component family (docs-pane header, embedded-origin bar, boundary-fact grid, marketplace/account boundary card, auth-handoff card, remote/service dashboard header, open-in-browser handoff row, embedded-state panel), that owner/origin, data-boundary, browser-fallback, capability-limit, account-scope, and freshness truth stays keyboard-complete, screen-reader-reachable, reduced-motion safe, high-contrast legible, and CLI/export-safe, and honestly self-narrowing. When the owner/origin, data boundary, browser fallback, capability limit, account scope, or freshness becomes partial, stale, offline, or provider-blocked, the component's boundary-support claim auto-narrows from full-truth / resolved-truth to degraded / stale / offline / provider-blocked, discloses the narrowing with a precise frozen trigger and binding dimension, and preserves the canonical owner / origin / data-boundary / fallback / freshness identity rather than silently dropping it or letting a stale pane read as fresh. A stale, offline, provider-blocked, or partial boundary state can no longer keep an old fresh first-party full-truth label (AC1); accessibility and export surfaces preserve the same owner/origin, data boundary, browser fallback, capability limits, account scope, and freshness shown in-product (AC2); the same narrowed state surfaces across the docs/help browser, marketplace/account panes, the remote/service dashboard, embedded webviews, the auth-handoff surface, and support/admin exports (AC3). The packet is metadata-only: raw provider tokens, cookies, credentials, and page bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_embedded_boundary_component_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "docs_pane_header",
        "embedded_origin_bar",
        "boundary_fact_grid",
        "marketplace_account_boundary_card",
        "auth_handoff_card",
        "remote_service_dashboard_header",
        "open_in_browser_handoff_row",
        "embedded_state_panel"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "handoff_packet",
        "support_export"
      ]
    },
    "non_visual_reach": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary": {
      "type": "string",
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "support_claim": {
      "type": "string",
      "enum": [
        "full_truth",
        "resolved_truth",
        "degraded",
        "stale",
        "offline",
        "provider_blocked"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "owner_origin_truth",
        "data_boundary_truth",
        "browser_fallback_truth",
        "capability_limit_truth",
        "freshness_truth",
        "account_scope_truth"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": ["intact", "partial", "stale", "offline", "provider_blocked"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "owner_or_origin_unstated",
        "data_boundary_unstated",
        "browser_fallback_hidden_in_menus_only",
        "capability_limits_unstated",
        "stale_or_blocked_shown_as_fresh",
        "account_scope_unstated",
        "freshness_or_last_updated_unstated",
        "provider_health_unstated",
        "imitates_native_approval_chrome",
        "high_risk_approval_embedded",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "owner_and_origin",
        "data_boundary_and_fallback",
        "freshness_and_capability_limits"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "docs_browser_ui",
        "marketplace_ui",
        "account_ui",
        "remote_dashboard_ui",
        "embedded_webview_ui",
        "auth_handoff_ui",
        "support_export",
        "product_ui"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/support_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "boundary_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_support_claim",
        "claim_conditions",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_embedded_boundary_component_accessibility_parity_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "boundary_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach" },
        "export_summary": { "$ref": "#/$defs/export_summary" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_support_claim": { "$ref": "#/$defs/support_claim" },
        "claim_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition_entry" }
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_count",
        "hierarchy_heavy_family_count",
        "all_hierarchy_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_export_summaries_preserve_meaning",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "family_count": { "type": "integer", "minimum": 0 },
        "hierarchy_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_hierarchy_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
