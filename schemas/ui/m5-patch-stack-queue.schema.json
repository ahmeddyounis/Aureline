{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-patch-stack-queue.schema.json",
  "title": "Aureline M5 patch stack / queue",
  "description": "Canonical per-domain descriptor for one patch stack or merge / landing queue. Names the ordered stack members, their stack membership source, queue eligibility and any queue-blocked reason, and the stack dependency edges so members are never silently reordered, collapsed, or retargeted and membership is never inferred from branch names alone. Raw paths, raw provider payloads, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "object_class",
    "change_orchestration_association",
    "stack_member_order",
    "stack_membership_source",
    "landing_state"
  ],
  "properties": {
    "object_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "object_class": {
      "enum": [
        "patch_stack_queue"
      ]
    },
    "change_orchestration_association": {
      "$ref": "#/$defs/non_empty_string"
    },
    "export_class": {
      "enum": [
        "public_safe",
        "internal_only"
      ]
    },
    "stack_member_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stack_membership_source": {
      "enum": [
        "declared_in_change_object",
        "declared_locally",
        "inferred_from_branch_name",
        "stale_or_broken_membership"
      ]
    },
    "stack_dependency_edges": {
      "type": "array"
    },
    "landing_state": {
      "enum": [
        "selected_change",
        "stale_validation",
        "restack_required",
        "queue_eligible",
        "queue_blocked",
        "protected_branch_blocked",
        "orphaned",
        "abandoned",
        "exported",
        "imported_reopened"
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
