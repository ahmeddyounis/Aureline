{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-git-history-component-consumer.schema.json",
  "title": "M5 Git-History Component Consumer Parity Packet",
  "description": "Export-safe packet binding the twelve shared M5 Git-history and risky-mutation components (commit-graph header, history-graph row, branch-comparison chip, worktree row, stash entry, reflog-recovery banner, rebase-todo row, sequence-editor header, cherry-pick/revert review sheet, patch-apply review sheet, conflict-checkpoint card, force-push review dialog) to the history sidebar, risky-mutation sheet, review-workspace banner, command-help, support-bundle, and exported-recovery-packet consumers that render them, proving ref/worktree/recovery/verb parity for the same Git-history object across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "git_history_component_consumer_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "commit_graph_header",
        "history_graph_row",
        "branch_comparison_chip",
        "worktree_row",
        "stash_entry",
        "reflog_recovery_banner",
        "rebase_todo_row",
        "sequence_editor_header",
        "cherry_pick_revert_review_sheet",
        "patch_apply_review_sheet",
        "conflict_checkpoint_card",
        "force_push_review_dialog"
      ]
    },
    "consumer": {
      "type": "string",
      "enum": [
        "history_sidebar",
        "risky_mutation_sheet",
        "review_workspace_banner",
        "command_help",
        "support_bundle",
        "exported_recovery_packet"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "aligned_local_truth",
        "stale_provider_overlay",
        "detached_or_missing_ref",
        "dirty_or_conflicted_worktree",
        "shallow_or_partial_topology",
        "reflog_only_fallback",
        "approval_invalidated",
        "offline_local_only"
      ]
    },
    "render_mode": {
      "type": "string",
      "enum": [
        "full_parity",
        "identity_narrowed",
        "recovery_narrowed",
        "local_continue_fallback"
      ]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "ref_worktree_identity_narrowed",
        "recovery_destination_narrowed",
        "local_continue_engaged"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": [
        "reconcile_ref_worktree_identity",
        "open_recovery_checkpoint",
        "continue_local_history"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "provider_overlay_stale",
        "approval_invalidation_pending",
        "recovery_checkpoint_unreachable",
        "local_continue_unavailable",
        "parity_drift_detected",
        "trust_narrowing",
        "upstream_component_narrowed"
      ]
    },
    "parity_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_identity_label",
        "worktree_scope_label",
        "recovery_destination_label",
        "primary_verb"
      ],
      "properties": {
        "ref_identity_label": { "type": "string", "minLength": 1 },
        "worktree_scope_label": { "type": "string", "minLength": 1 },
        "recovery_destination_label": { "type": "string", "minLength": 1 },
        "primary_verb": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_facets_note", "next_action", "next_action_label"],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_facets_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "history_object_id",
        "history_object_label",
        "component",
        "consumer",
        "condition",
        "render_mode",
        "parity_facets",
        "parity_state",
        "narrow_banner",
        "ref_identity_note",
        "recovery_note",
        "local_continue_note",
        "collapses_git_verb_into_ambiguous_confirm",
        "hides_exact_target_ref_or_worktree",
        "drops_conflict_or_recovery_state_after_mutation",
        "rewords_ref_worktree_recovery_labels_per_surface",
        "hides_local_only_recovery_when_provider_linked",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "history_object_id": { "type": "string", "minLength": 1 },
        "history_object_label": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "consumer": { "$ref": "#/$defs/consumer" },
        "condition": { "$ref": "#/$defs/condition" },
        "render_mode": { "$ref": "#/$defs/render_mode" },
        "parity_facets": { "$ref": "#/$defs/parity_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_banner": {
          "oneOf": [{ "$ref": "#/$defs/narrow_banner" }, { "type": "null" }]
        },
        "ref_identity_note": { "type": "string" },
        "recovery_note": { "type": "string" },
        "local_continue_note": { "type": "string" },
        "collapses_git_verb_into_ambiguous_confirm": { "const": false },
        "hides_exact_target_ref_or_worktree": { "const": false },
        "drops_conflict_or_recovery_state_after_mutation": { "const": false },
        "rewords_ref_worktree_recovery_labels_per_surface": { "const": false },
        "hides_local_only_recovery_when_provider_linked": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Full-parity renders never carry a narrow banner.",
          "if": { "properties": { "render_mode": { "const": "full_parity" } } },
          "then": { "properties": { "narrow_banner": { "type": "null" } } }
        },
        {
          "comment": "Narrowed renders must carry a narrow banner.",
          "if": {
            "properties": {
              "render_mode": {
                "enum": ["identity_narrowed", "recovery_narrowed", "local_continue_fallback"]
              }
            }
          },
          "then": {
            "properties": { "narrow_banner": { "$ref": "#/$defs/narrow_banner" } }
          }
        },
        {
          "comment": "A detached/missing ref must spell out the exact target ref identity.",
          "if": {
            "properties": { "condition": { "const": "detached_or_missing_ref" } }
          },
          "then": {
            "properties": { "ref_identity_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "A narrowed recovery destination must stay named.",
          "if": {
            "properties": { "render_mode": { "const": "recovery_narrowed" } }
          },
          "then": {
            "properties": { "recovery_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "A local-only continuation must stay explicit.",
          "if": {
            "properties": { "render_mode": { "const": "local_continue_fallback" } }
          },
          "then": {
            "properties": { "local_continue_note": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_reuse_proven_by_fixtures",
        "same_object_same_language_across_surfaces",
        "exact_target_ref_and_worktree_never_hidden",
        "conflict_and_recovery_state_survives_mutation",
        "primary_verbs_identical_across_surfaces",
        "ref_worktree_recovery_labels_identical_across_surfaces",
        "local_only_recovery_stays_explicit_with_provider_state",
        "recovery_destination_always_reachable_when_risky",
        "no_git_verb_collapsed_into_ambiguous_confirm",
        "help_support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "component_reuse_proven_by_fixtures": { "const": true },
        "same_object_same_language_across_surfaces": { "const": true },
        "exact_target_ref_and_worktree_never_hidden": { "const": true },
        "conflict_and_recovery_state_survives_mutation": { "const": true },
        "primary_verbs_identical_across_surfaces": { "const": true },
        "ref_worktree_recovery_labels_identical_across_surfaces": { "const": true },
        "local_only_recovery_stays_explicit_with_provider_state": { "const": true },
        "recovery_destination_always_reachable_when_risky": { "const": true },
        "no_git_verb_collapsed_into_ambiguous_confirm": { "const": true },
        "help_support_export_point_canonical_contracts": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true },
        "stale_or_underqualified_blocks_promotion": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_sidebar_reuses_shared_components",
        "risky_mutation_sheet_reuses_shared_components",
        "review_workspace_banner_reuses_shared_components",
        "command_help_reuses_shared_components",
        "support_bundle_reuses_shared_components",
        "exported_recovery_packet_reuses_shared_components",
        "every_component_adopted_by_two_or_more_consumers",
        "parity_facets_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_preserves_ref_worktree_recovery_identity"
      ],
      "properties": {
        "history_sidebar_reuses_shared_components": { "const": true },
        "risky_mutation_sheet_reuses_shared_components": { "const": true },
        "review_workspace_banner_reuses_shared_components": { "const": true },
        "command_help_reuses_shared_components": { "const": true },
        "support_bundle_reuses_shared_components": { "const": true },
        "exported_recovery_packet_reuses_shared_components": { "const": true },
        "every_component_adopted_by_two_or_more_consumers": { "const": true },
        "parity_facets_identical_for_same_object": { "const": true },
        "narrowing_disclosed_not_hidden": { "const": true },
        "export_preserves_ref_worktree_recovery_identity": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
