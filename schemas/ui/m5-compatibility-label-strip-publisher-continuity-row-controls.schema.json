{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-compatibility-label-strip-publisher-continuity-row-controls.schema.json",
  "title": "Aureline M5 compatibility-label-strip and publisher-continuity-row controls",
  "description": "Export-safe packet for the second implement lane over the frozen M5 marketplace / install-review component matrix. It carries resolved, honest projections of the compatibility label strip and the publisher continuity row across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved strip examples (naming the compatibility state, host/runtime model, host-version range, manifest-schema version, lifecycle state, replacement path, and evidence freshness) and the resolved publisher-continuity row examples (naming the verified / transferred / lost / mirrored / unverifiable continuity presentation, registry source class, continuity language, and transfer history). Hard invariants forbid collapsing the registry source class across public/mirrored/enterprise, hiding the replacement path or lifecycle state behind compact chrome, hiding a publisher transfer or its continuity language, and leaving Certified/Supported language on stale or unverifiable evidence. Acceptance criteria — deprecated or transferred artifacts carry visible replacement/continuity language, and claim narrowing triggers when compatibility or continuity evidence becomes stale or unverifiable — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_compatibility_label_strip_and_publisher_continuity_row_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "source_disposition": {
      "type": ["string", "null"],
      "enum": [
        "public",
        "mirrored",
        "enterprise",
        "side_load",
        "verified",
        "transferred",
        "deprecated",
        "limited",
        "incompatible",
        "over_budget",
        "throttled",
        "quarantined",
        "disable_scope",
        "rollback_compatibility",
        null
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "compatibility_label_strip_example": {
      "type": "object",
      "required": [
        "strip_id",
        "artifact_identity",
        "compatibility",
        "is_installable",
        "host_runtime_model",
        "host_version_range",
        "manifest_schema_version",
        "lifecycle",
        "requires_replacement_path",
        "replacement_path",
        "certified_or_supported_claimed",
        "evidence_fresh",
        "presents_incompatible_as_ready",
        "leaves_stale_certified_overclaim",
        "degrade_reason",
        "next_action",
        "fully_legible"
      ],
      "properties": {
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "compatibility": { "$ref": "#/$defs/non_empty_string" },
        "is_installable": { "type": "boolean" },
        "host_runtime_model": { "$ref": "#/$defs/non_empty_string" },
        "host_version_range": { "type": "string" },
        "manifest_schema_version": { "type": "string" },
        "lifecycle": { "$ref": "#/$defs/non_empty_string" },
        "requires_replacement_path": { "type": "boolean" },
        "replacement_path": { "type": "string" },
        "certified_or_supported_claimed": { "type": "boolean" },
        "evidence_fresh": { "type": "boolean" },
        "presents_incompatible_as_ready": { "type": "boolean" },
        "leaves_stale_certified_overclaim": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fully_legible": { "type": "boolean" }
      }
    },
    "publisher_continuity_row_example": {
      "type": "object",
      "required": [
        "row_id",
        "artifact_identity",
        "continuity",
        "presentation",
        "publisher_changed",
        "continuity_language",
        "registry_source",
        "source_disposition",
        "transfer_history_available",
        "transfer_history_stated",
        "certified_or_supported_claimed",
        "evidence_fresh",
        "collapses_source_class",
        "hides_continuity_language",
        "leaves_stale_certified_overclaim",
        "degrade_reason",
        "next_action",
        "fully_legible"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_identity": { "type": "string" },
        "continuity": { "$ref": "#/$defs/non_empty_string" },
        "presentation": { "$ref": "#/$defs/non_empty_string" },
        "publisher_changed": { "type": "boolean" },
        "continuity_language": { "type": "string" },
        "registry_source": { "$ref": "#/$defs/non_empty_string" },
        "source_disposition": { "$ref": "#/$defs/source_disposition" },
        "transfer_history_available": { "type": "boolean" },
        "transfer_history_stated": { "type": "boolean" },
        "certified_or_supported_claimed": { "type": "boolean" },
        "evidence_fresh": { "type": "boolean" },
        "collapses_source_class": { "type": "boolean" },
        "hides_continuity_language": { "type": "boolean" },
        "leaves_stale_certified_overclaim": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "fully_legible": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "compatibility_label_strip_examples",
        "publisher_continuity_row_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_registry_source_class_across_public_mirrored_enterprise",
        "hides_replacement_path_or_lifecycle_state",
        "hides_publisher_transfer_or_continuity_language",
        "leaves_stale_evidence_certified_or_supported"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "compatibility_label_strip_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compatibility_label_strip_example" }
        },
        "publisher_continuity_row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publisher_continuity_row_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_registry_source_class_across_public_mirrored_enterprise": { "const": false },
        "hides_replacement_path_or_lifecycle_state": { "const": false },
        "hides_publisher_transfer_or_continuity_language": { "const": false },
        "leaves_stale_evidence_certified_or_supported": { "const": false }
      }
    }
  }
}
