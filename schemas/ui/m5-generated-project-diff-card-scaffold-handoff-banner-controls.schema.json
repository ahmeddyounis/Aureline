{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-generated-project-diff-card-scaffold-handoff-banner-controls.schema.json",
  "title": "Aureline M5 generated-project diff cards and scaffold handoff banners",
  "description": "Export-safe packet implementing the reusable M5 generated-project-diff-card and scaffold-handoff-banner components in two co-equal control vectors. Each diff card names its created/modified/renamed/deleted counts (the same vocabulary Aureline uses for AI patches, importers, and refactors), its template or generator source, its config/dependency/task/extension impact, a named checkpoint or rollback/delete-generated path, and a generated-versus-user-owned boundary cue; its review disposition and boundary posture are derived from the frozen diff-review state and generated-zone class, so a conflict or unavailable diff can never read as a clean applied change and a user-owned zone can never read as free-to-overwrite generated output. Each handoff banner names its created-workspace identity, its trust state, its health summary, its Run now/Run later/Review files/Open manifest choices, and a delete-generated or reopen-preflight recovery route; its outcome posture is derived from the frozen outcome class, so a partial or failed bootstrap can never read as a clean create. Every next step names one stable manifest/registry/docs/policy deep link rather than an ephemeral overlay or hidden route. No component hides the generated-versus-user-owned boundary, hides a side effect or trust state, assumes the safest next step without keeping recovery explicit, or invents an alternate state label; raw file bodies, raw secret values, pasted local paths, repository URLs, credentials, and secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "diff_cards",
    "handoff_banners",
    "downgrade_triggers",
    "consumer_surfaces",
    "generation_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_generated_project_diff_cards_and_scaffold_handoff_banners_with_create_modify_rename_delete_counts_dependency_task_extension_impact_trust_state_and_run_now_later_review_recovery_truth_across_claimed_m5_generation_flows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "diff_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/generated_project_diff_card" }
    },
    "handoff_banners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scaffold_handoff_banner" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "generation_review": { "$ref": "#/$defs/generation_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "generated_zone_class": {
      "enum": [
        "generated_only",
        "user_owned",
        "generated_then_edited",
        "runtime_only",
        "mixed_zone",
        "zone_unknown"
      ]
    },
    "diff_review_state": {
      "enum": [
        "preview_ready",
        "review_required",
        "no_changes",
        "conflict_detected",
        "diff_unavailable",
        "blocked"
      ]
    },
    "diff_source_kind": {
      "enum": [
        "template_starter",
        "framework_generator",
        "codemod",
        "imported_source",
        "user_authored"
      ]
    },
    "diff_review_disposition": {
      "enum": [
        "reviewable_preview",
        "review_required_before_write",
        "no_changes_to_review",
        "conflict_blocked",
        "diff_unavailable_blocked"
      ]
    },
    "generated_boundary_posture": {
      "enum": [
        "generated_owned",
        "user_owned",
        "generated_then_user_edited",
        "runtime_only",
        "mixed_ownership",
        "ownership_unknown"
      ]
    },
    "handoff_outcome_class": {
      "enum": [
        "create_succeeded",
        "partial_bootstrap",
        "create_failed",
        "continued_without_starter",
        "created_empty",
        "provisioning_pending"
      ]
    },
    "handoff_trust_state": {
      "enum": [
        "trusted",
        "trust_prompt_pending",
        "restricted_trust",
        "untrusted_blocked",
        "trust_not_applicable"
      ]
    },
    "handoff_outcome_posture": {
      "enum": [
        "clean_create",
        "partial_needs_recovery",
        "failed_needs_recovery",
        "continued_without_starter",
        "created_empty",
        "provisioning_pending"
      ]
    },
    "handoff_recovery_action": {
      "enum": [
        "open_workspace",
        "retry_bootstrap",
        "delete_generated",
        "continue_without_starter",
        "keep_partial_review",
        "no_recovery_needed"
      ]
    },
    "deep_link_kind": {
      "enum": [
        "template_manifest",
        "starter_registry_entry",
        "docs_anchor",
        "policy_reference",
        "no_deep_link"
      ]
    },
    "diff_card_action": {
      "enum": [
        "review_generated_diff",
        "review_change_impact",
        "review_ownership_boundary",
        "rollback_generated",
        "keep_generated",
        "open_deep_link"
      ]
    },
    "handoff_banner_action": {
      "enum": [
        "run_now",
        "run_later",
        "review_files",
        "open_manifest",
        "reopen_preflight",
        "open_deep_link"
      ]
    },
    "disposition": {
      "enum": [
        "first_party",
        "team_managed",
        "community",
        "local_only",
        "create_empty",
        "continue_without_starter",
        "blocked",
        "warning",
        "optional"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "starter_source_and_support",
        "side_effect_disclosure",
        "recovery_and_ownership_boundary"
      ]
    },
    "surface_family": {
      "enum": [
        "start_center",
        "template_gallery",
        "scaffold_preflight",
        "generation_diff_review",
        "workspace_handoff",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "start_center_ui",
        "template_gallery_ui",
        "parameter_form_ui",
        "preflight_ui",
        "diff_review_ui",
        "workspace_ui",
        "health_dashboard_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "starter_source_unstated",
        "support_class_unstated",
        "side_effect_undisclosed",
        "host_boundary_unstated",
        "parameter_source_unstated",
        "action_timing_unstated",
        "impact_undisclosed",
        "health_freshness_stale",
        "generated_boundary_blurred",
        "recovery_path_omitted",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "generated_project_diff_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "card_name",
        "generated_zone_class",
        "diff_review_state",
        "source_kind",
        "source_label",
        "created_count",
        "modified_count",
        "renamed_count",
        "deleted_count",
        "change_summary_note",
        "derived_review_disposition",
        "derived_boundary_posture",
        "claims_reviewable",
        "claims_blocking",
        "claims_user_owned_boundary",
        "review_required_note",
        "no_changes_note",
        "conflict_note",
        "unavailable_note",
        "boundary_note",
        "config_impact_label",
        "dependency_impact_label",
        "task_impact_label",
        "extension_impact_label",
        "checkpoint_label",
        "rollback_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_generated_versus_user_owned_boundary",
        "hides_side_effect_or_trust_state",
        "assumes_safest_next_step_without_recovery",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "generated_project_diff_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "card_name": { "$ref": "#/$defs/non_empty_string" },
        "generated_zone_class": { "$ref": "#/$defs/generated_zone_class" },
        "diff_review_state": { "$ref": "#/$defs/diff_review_state" },
        "source_kind": { "$ref": "#/$defs/diff_source_kind" },
        "source_label": { "$ref": "#/$defs/non_empty_string" },
        "created_count": { "type": "integer", "minimum": 0 },
        "modified_count": { "type": "integer", "minimum": 0 },
        "renamed_count": { "type": "integer", "minimum": 0 },
        "deleted_count": { "type": "integer", "minimum": 0 },
        "change_summary_note": { "$ref": "#/$defs/non_empty_string" },
        "derived_review_disposition": { "$ref": "#/$defs/diff_review_disposition" },
        "derived_boundary_posture": { "$ref": "#/$defs/generated_boundary_posture" },
        "claims_reviewable": { "type": "boolean" },
        "claims_blocking": { "type": "boolean" },
        "claims_user_owned_boundary": { "type": "boolean" },
        "review_required_note": { "type": "string" },
        "no_changes_note": { "type": "string" },
        "conflict_note": { "type": "string" },
        "unavailable_note": { "type": "string" },
        "boundary_note": { "$ref": "#/$defs/non_empty_string" },
        "config_impact_label": { "$ref": "#/$defs/non_empty_string" },
        "dependency_impact_label": { "$ref": "#/$defs/non_empty_string" },
        "task_impact_label": { "$ref": "#/$defs/non_empty_string" },
        "extension_impact_label": { "$ref": "#/$defs/non_empty_string" },
        "checkpoint_label": { "$ref": "#/$defs/non_empty_string" },
        "rollback_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "review_generated_diff" } },
            { "contains": { "const": "review_change_impact" } },
            { "contains": { "const": "review_ownership_boundary" } },
            { "contains": { "const": "rollback_generated" } }
          ],
          "items": { "$ref": "#/$defs/diff_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_generated_versus_user_owned_boundary": { "const": false },
        "hides_side_effect_or_trust_state": { "const": false },
        "assumes_safest_next_step_without_recovery": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "scaffold_handoff_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "banner_id",
        "banner_name",
        "outcome_class",
        "trust_state",
        "workspace_id_label",
        "workspace_name_label",
        "health_summary_label",
        "derived_outcome_posture",
        "claims_clean_create",
        "claims_needs_recovery",
        "claims_trusted",
        "partial_note",
        "failed_note",
        "pending_note",
        "trust_note",
        "optional_setup_note",
        "recovery_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "banner_actions",
        "recovery_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_generated_versus_user_owned_boundary",
        "hides_side_effect_or_trust_state",
        "assumes_safest_next_step_without_recovery",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "scaffold_handoff_banner" },
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "banner_name": { "$ref": "#/$defs/non_empty_string" },
        "outcome_class": { "$ref": "#/$defs/handoff_outcome_class" },
        "trust_state": { "$ref": "#/$defs/handoff_trust_state" },
        "workspace_id_label": { "$ref": "#/$defs/non_empty_string" },
        "workspace_name_label": { "$ref": "#/$defs/non_empty_string" },
        "health_summary_label": { "$ref": "#/$defs/non_empty_string" },
        "derived_outcome_posture": { "$ref": "#/$defs/handoff_outcome_posture" },
        "claims_clean_create": { "type": "boolean" },
        "claims_needs_recovery": { "type": "boolean" },
        "claims_trusted": { "type": "boolean" },
        "partial_note": { "type": "string" },
        "failed_note": { "type": "string" },
        "pending_note": { "type": "string" },
        "trust_note": { "type": "string" },
        "optional_setup_note": { "$ref": "#/$defs/non_empty_string" },
        "recovery_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "banner_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "run_now" } },
            { "contains": { "const": "run_later" } },
            { "contains": { "const": "review_files" } },
            { "contains": { "const": "open_manifest" } }
          ],
          "items": { "$ref": "#/$defs/handoff_banner_action" }
        },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "anyOf": [
            { "contains": { "const": "delete_generated" } },
            { "contains": { "const": "continue_without_starter" } },
            { "contains": { "const": "retry_bootstrap" } },
            { "contains": { "const": "keep_partial_review" } }
          ],
          "items": { "$ref": "#/$defs/handoff_recovery_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_generated_versus_user_owned_boundary": { "const": false },
        "hides_side_effect_or_trust_state": { "const": false },
        "assumes_safest_next_step_without_recovery": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "generation_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_card_shows_change_counts",
        "diff_card_uses_create_modify_rename_delete_vocabulary",
        "diff_card_shows_generated_versus_user_owned_boundary",
        "diff_card_names_rollback_or_delete_generated_path",
        "diff_card_shows_config_dependency_task_extension_impact",
        "handoff_banner_shows_workspace_identity_and_trust",
        "handoff_banner_shows_health_summary",
        "handoff_banner_keeps_optional_setup_optional",
        "handoff_banner_offers_run_now_run_later_review_open_manifest",
        "handoff_banner_preserves_recovery_and_delete_generated",
        "review_and_outcome_derived_never_asserted",
        "conflict_or_failure_never_shown_as_clean",
        "user_owned_boundary_never_overwritten_silently",
        "safest_next_step_never_assumed_for_user",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_review_surface_reads_single_source",
        "workspace_handoff_reads_single_source",
        "start_center_reads_single_source",
        "change_counts_visible_before_commit",
        "recovery_path_visible_after_create",
        "support_export_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
