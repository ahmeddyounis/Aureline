{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-deployment-profile-primitive.schema.json",
  "title": "Aureline M5 deployment-profile primitive",
  "description": "Canonical parity matrix for the reusable M5 deployment-profile primitive: an install-profile card, a side-by-side import sheet, and a rollout-ring row that all resolve from one deployment context and share one deployment identity. Narrows three families of the frozen M5 deployment/continuity component matrix (install_profile_card, side_by_side_import_sheet, rollout_ring_row) into one working resolver. Install ownership and rollback target are never hidden (AC1); a side-by-side handoff never depends on hidden state sharing (AC2); managed rollout preserves ring identity and promotion evidence rather than flattening every install into one generic version list (AC3). Raw config bytes, credentials, license keys, and mirror URLs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_deployment_profile_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "about_install_card",
        "update_center",
        "admin_fleet_console",
        "side_by_side_review",
        "diagnostics_deployment",
        "support_export_replay"
      ]
    },
    "install_scope": {
      "enum": ["per_user", "per_machine", "portable", "offline"]
    },
    "updater_owner": {
      "enum": ["self_managed", "managed_admin", "os_store", "offline_mirror"]
    },
    "rollback_target": {
      "enum": [
        "checkpoint_available",
        "prior_build_retained",
        "no_rollback",
        "unknown"
      ]
    },
    "state_sharing_model": {
      "enum": ["isolated", "shared_read_only", "shared_writable", "one_time_copy"]
    },
    "import_choice": {
      "enum": ["one_time_import", "one_time_copy", "link_shared", "skip"]
    },
    "export_field": {
      "enum": [
        "deployment_id",
        "install_identity",
        "operating_mode",
        "channel_and_updater",
        "provenance_freshness",
        "rollback_target",
        "rollout_ring"
      ]
    },
    "deployment_mode": {
      "enum": ["desktop", "managed", "self_hosted", "portable", "air_gapped"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_reported"]
    },
    "rollout_ring": {
      "enum": [
        "canary",
        "early_adopter",
        "broad",
        "general_availability",
        "paused"
      ]
    },
    "promotion_state": {
      "enum": ["held", "promoting", "promoted", "rolled_back", "blocked"]
    },
    "downgrade_trigger": {
      "enum": [
        "control_plane_impaired",
        "mirror_stale",
        "offline_cache_only",
        "signature_unverified",
        "rollout_paused",
        "handler_ownership_contested",
        "state_root_unavailable",
        "residual_vendor_dependency",
        "provenance_incomplete"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "deployment_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "surface_label",
        "install_id_ref",
        "install_mode",
        "install_scope",
        "channel_ref",
        "updater_owner",
        "state_root_ref",
        "build_ref",
        "truth_mode",
        "rollback_target",
        "state_sharing",
        "import_choice",
        "handler_capture",
        "moves_state_across_channel",
        "managed_rollout",
        "rollout_ring",
        "promotion_state",
        "ring_owner_ref",
        "platform_scope_ref",
        "evidence_freshness",
        "rollout_rollback_available"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string", "minLength": 1 },
        "install_id_ref": { "$ref": "#/$defs/ref" },
        "install_mode": { "$ref": "#/$defs/deployment_mode" },
        "install_scope": { "$ref": "#/$defs/install_scope" },
        "channel_ref": { "$ref": "#/$defs/ref" },
        "updater_owner": { "$ref": "#/$defs/updater_owner" },
        "state_root_ref": { "$ref": "#/$defs/ref" },
        "build_ref": { "$ref": "#/$defs/ref" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "rollback_target": { "$ref": "#/$defs/rollback_target" },
        "rollback_target_ref": { "type": "string" },
        "sibling_install_ref": { "type": "string" },
        "state_sharing": { "$ref": "#/$defs/state_sharing_model" },
        "import_choice": { "$ref": "#/$defs/import_choice" },
        "handler_capture": { "type": "boolean" },
        "moves_state_across_channel": { "type": "boolean" },
        "managed_rollout": { "type": "boolean" },
        "rollout_ring": { "$ref": "#/$defs/rollout_ring" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "ring_owner_ref": { "type": "string" },
        "platform_scope_ref": { "type": "string" },
        "evidence_freshness": { "$ref": "#/$defs/truth_mode" },
        "rollout_rollback_available": { "type": "boolean" },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_install_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "install_id_ref",
        "install_mode",
        "install_scope",
        "channel_ref",
        "updater_owner",
        "state_root_ref",
        "build_ref",
        "truth_mode",
        "rollback_target",
        "owns_running_app_disclosed",
        "discloses_state_roots"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "install_id_ref": { "$ref": "#/$defs/ref" },
        "install_mode": { "$ref": "#/$defs/deployment_mode" },
        "install_scope": { "$ref": "#/$defs/install_scope" },
        "channel_ref": { "$ref": "#/$defs/ref" },
        "updater_owner": { "$ref": "#/$defs/updater_owner" },
        "state_root_ref": { "$ref": "#/$defs/ref" },
        "build_ref": { "$ref": "#/$defs/ref" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "rollback_target": { "$ref": "#/$defs/rollback_target" },
        "rollback_target_ref": { "type": ["string", "null"] },
        "owns_running_app_disclosed": { "type": "boolean" },
        "discloses_state_roots": { "const": true }
      }
    },
    "resolved_import_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "truth_mode",
        "has_sibling",
        "state_sharing",
        "import_choice",
        "isolation_preserved",
        "rollback_checkpoint_preserved",
        "handler_capture",
        "state_sharing_explicit"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "sibling_install_ref": { "type": ["string", "null"] },
        "has_sibling": { "type": "boolean" },
        "state_sharing": { "$ref": "#/$defs/state_sharing_model" },
        "import_choice": { "$ref": "#/$defs/import_choice" },
        "isolation_preserved": { "type": "boolean" },
        "rollback_checkpoint_preserved": { "type": "boolean" },
        "handler_capture": { "const": false },
        "state_sharing_explicit": { "const": true }
      }
    },
    "resolved_rollout_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "evidence_freshness",
        "managed",
        "ring",
        "promotion_state",
        "ring_owner_ref",
        "platform_scope_ref",
        "rollback_available",
        "ring_identity_preserved"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "evidence_freshness": { "$ref": "#/$defs/truth_mode" },
        "managed": { "type": "boolean" },
        "ring": { "$ref": "#/$defs/rollout_ring" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "ring_owner_ref": { "type": "string" },
        "platform_scope_ref": { "type": "string" },
        "rollback_available": { "type": "boolean" },
        "ring_identity_preserved": { "const": true }
      }
    },
    "resolved_deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "install_card",
        "import_sheet",
        "rollout_row",
        "running_owner_disclosed",
        "state_sharing_explicit",
        "ring_identity_preserved"
      ],
      "properties": {
        "deployment_id": { "$ref": "#/$defs/id" },
        "install_card": { "$ref": "#/$defs/resolved_install_card" },
        "import_sheet": { "$ref": "#/$defs/resolved_import_sheet" },
        "rollout_row": { "$ref": "#/$defs/resolved_rollout_row" },
        "running_owner_disclosed": { "type": "boolean" },
        "state_sharing_explicit": { "type": "boolean" },
        "ring_identity_preserved": { "const": true },
        "degraded": {
          "oneOf": [{ "$ref": "#/$defs/degraded_state" }, { "type": "null" }]
        }
      }
    },
    "deployment_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/deployment_input" },
        "resolved": { "$ref": "#/$defs/resolved_deployment" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "install_scopes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_profiles",
        "hides_install_ownership",
        "assumes_hidden_state_sharing",
        "flattens_rollout_identity",
        "loses_rollback_target"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "install_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/install_scope" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_case" }
        },
        "hides_install_ownership": { "const": false },
        "assumes_hidden_state_sharing": { "const": false },
        "flattens_rollout_identity": { "const": false },
        "loses_rollback_target": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "install_scopes",
        "updater_owners",
        "rollback_targets",
        "state_sharing_models",
        "import_choices",
        "export_fields",
        "deployment_modes",
        "truth_modes",
        "rollout_rings",
        "promotion_states",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "install_scopes": { "type": "array", "items": { "type": "string" } },
        "updater_owners": { "type": "array", "items": { "type": "string" } },
        "rollback_targets": { "type": "array", "items": { "type": "string" } },
        "state_sharing_models": { "type": "array", "items": { "type": "string" } },
        "import_choices": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "deployment_modes": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "rollout_rings": { "type": "array", "items": { "type": "string" } },
        "promotion_states": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "deployment_identity_preserved_across_surfaces",
        "install_ownership_and_rollback_never_hidden",
        "state_sharing_explicit_before_handoff",
        "rollout_ring_identity_preserved",
        "support_export_reconstructs_deployment",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "deployment_identity_preserved_across_surfaces": { "const": true },
        "install_ownership_and_rollback_never_hidden": { "const": true },
        "state_sharing_explicit_before_handoff": { "const": true },
        "rollout_ring_identity_preserved": { "const": true },
        "support_export_reconstructs_deployment": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "side_by_side_reads_single_state_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "deployment_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "side_by_side_reads_single_state_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "deployment_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "deployment_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
