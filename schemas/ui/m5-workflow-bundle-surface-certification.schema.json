{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-workflow-bundle-surface-certification.schema.json",
  "title": "Aureline M5 workflow-bundle component surface certification",
  "description": "M05-851 certification capstone that closes the frozen M5 workflow-bundle component lane. Keyed on the claimed M5 stack-entry / migration surface (start-center picker, onboarding flow, migration center, docs/help, diagnostics, CLI/headless plus support-export/docs-help-embeds/release-proof evidence surfaces), each row certifies that the shared launch-wedge, detail-review, drift/override, rollback/remove, and class-disclosure component family behaves consistently: the surface either passes the shared component packet (certified) or auto-narrows its bundle-support claim to limited/retest-pending/imported/mirror-only/offline-cache-only/policy-blocked (narrowed_disclosed) with a binding component group and frozen downgrade trigger; a surface that hides drift, over-asserts support, or drops export truth is blocked. Unsupported or degraded native/mirror/offline/managed/imported distribution paths force a narrowed claim rather than inheriting a full-truth label (AC2), and every surface cites the one canonical component bundle and references the canonical component families it consumes (AC3). Raw manifest bytes, credentials, entitlement tokens, mirror URLs, and provider cursors never cross this metadata-only boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "as_of",
    "matrix_ref",
    "certification_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_workflow_bundle_surface_certification_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "certification_bundle_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "claimed_surface": {
      "enum": [
        "start_center_picker",
        "onboarding_flow",
        "migration_center",
        "docs_help",
        "diagnostics",
        "cli_headless",
        "support_export_replay",
        "docs_help_embeds",
        "release_proof"
      ]
    },
    "component_group": {
      "enum": [
        "launch_wedge",
        "detail_review",
        "drift_override",
        "rollback_remove",
        "class_disclosure"
      ]
    },
    "component_family": {
      "enum": [
        "start_center_bundle_card",
        "certified_archetype_badge_group",
        "bundle_detail_page",
        "bundle_install_update_review_sheet",
        "bundle_drift_banner",
        "bundle_local_override_row",
        "bundle_rollback_remove_card",
        "bundle_class_disclosure_card",
        "bundle_claim_narrowing_row"
      ]
    },
    "distribution_path": {
      "enum": ["native", "mirror", "offline", "managed", "imported"]
    },
    "distribution_parity_state": {
      "enum": ["current", "disclosed_narrowed", "unsupported"]
    },
    "gated_axis_state": {
      "enum": ["certified", "disclosed_narrowed", "blocked", "not_applicable"]
    },
    "export_parity_state": {
      "enum": ["certified", "disclosed_partial", "dropped"]
    },
    "support_claim": {
      "enum": [
        "certified",
        "supported",
        "limited",
        "retest_pending",
        "imported",
        "mirror_only",
        "offline_cache_only",
        "policy_blocked"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "stale_certification",
        "mirror_stale",
        "offline_cache_only",
        "unverified_signer",
        "local_override_drift",
        "incompatible_aureline",
        "entitlement_dependency_unmet",
        "imported_not_native",
        "rollback_only_path"
      ]
    },
    "required_label": {
      "enum": [
        "bundle_identity",
        "signer_source",
        "support_class",
        "certification_freshness",
        "mirror_offline_posture",
        "keyboard_route"
      ]
    },
    "export_field": {
      "enum": [
        "surface_identity",
        "consumed_groups",
        "declared_claim",
        "effective_claim",
        "per_axis_truth",
        "compatibility_notes",
        "narrowed_reason",
        "certification_bundle_ref"
      ]
    },
    "compatibility_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "parity"],
      "properties": {
        "path": { "$ref": "#/$defs/distribution_path" },
        "parity": { "$ref": "#/$defs/distribution_parity_state" },
        "note": { "type": "string" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_group",
        "trigger",
        "narrowed_label",
        "preserves_component_identity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/support_claim" },
        "binding_group": { "$ref": "#/$defs/component_group" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_component_identity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "claimed_surface",
        "source_matrix_ref",
        "certification_bundle_ref",
        "bundle_context_ref",
        "consumed_groups",
        "declared_claim",
        "effective_claim",
        "launch_wedge_truth",
        "detail_review_truth",
        "drift_override_truth",
        "rollback_remove_truth",
        "class_disclosure_truth",
        "export_parity",
        "compatibility_notes",
        "copy_export",
        "export_fields",
        "required_labels",
        "consumer_families",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_workflow_bundle_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "claimed_surface": { "$ref": "#/$defs/claimed_surface" },
        "source_matrix_ref": { "type": "string", "minLength": 1 },
        "certification_bundle_ref": { "type": "string", "minLength": 1 },
        "bundle_context_ref": { "type": "string", "minLength": 1 },
        "consumed_groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_group" }
        },
        "declared_claim": { "$ref": "#/$defs/support_claim" },
        "effective_claim": { "$ref": "#/$defs/support_claim" },
        "launch_wedge_truth": { "$ref": "#/$defs/gated_axis_state" },
        "detail_review_truth": { "$ref": "#/$defs/gated_axis_state" },
        "drift_override_truth": { "$ref": "#/$defs/gated_axis_state" },
        "rollback_remove_truth": { "$ref": "#/$defs/gated_axis_state" },
        "class_disclosure_truth": { "$ref": "#/$defs/gated_axis_state" },
        "export_parity": { "$ref": "#/$defs/export_parity_state" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compatibility_note" }
        },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_count",
        "evidence_surface_count",
        "green_count",
        "yellow_count",
        "red_count",
        "consumed_group_count",
        "path_count",
        "all_claims_honest",
        "all_export_preserve_truth",
        "all_unsupported_paths_narrowed",
        "group_coverage_complete",
        "path_coverage_complete"
      ],
      "properties": {
        "surface_count": { "type": "integer", "minimum": 0 },
        "evidence_surface_count": { "type": "integer", "minimum": 0 },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "consumed_group_count": { "type": "integer", "minimum": 0 },
        "path_count": { "type": "integer", "minimum": 0 },
        "all_claims_honest": { "type": "boolean" },
        "all_export_preserve_truth": { "type": "boolean" },
        "all_unsupported_paths_narrowed": { "type": "boolean" },
        "group_coverage_complete": { "type": "boolean" },
        "path_coverage_complete": { "type": "boolean" }
      }
    }
  }
}
