{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-editor-inline-component-surface-certification.schema.json",
  "title": "Aureline M5 editor-inline component surface certification packet",
  "description": "M05-1123 closing capstone certifying that the frozen M5 editor-inline component families (editor tab, gutter, diagnostic decoration, code-action chip, diff view, review thread, AI message card, evidence timeline) hold their truth on every claimed M5 editor / review / AI operating profile. Keyed on the claimed profile (live trusted inline surface, reviewable inline structure, drifted-anchor surface, stale-severity decoration, inferred-fix chip, stale-confidence message, unverified-approval thread, partial-evidence timeline), each row certifies the profile across eight truth axes — visual, keyboard, screen-reader, high-zoom-reflow, reduced-motion, CLI/export, degraded-state, and inline-component-truth behavior — and either passes (green), auto-narrows its inline claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted inline profile may certify a trusted inline result; and every B133 guardrail must hold (tab/marker/diagnostic state is never encoded by color alone, comment anchors and AI evidence pointers never silently drift, outdated and resolved review state are never blurred, an inferred fix is never presented as exact, and an evidence timeline is never hidden in an opaque log). Every row cites exactly one canonical editor-inline proof bundle. The packet is metadata-only: raw editor buffers, diff bodies, comment payloads, AI message bodies, credentials, and endpoint refs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_editor_inline_component_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-editor-inline-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_inline_surface",
        "reviewable_inline_structure",
        "drifted_anchor_surface",
        "stale_severity_decoration",
        "inferred_fix_chip",
        "stale_confidence_message",
        "unverified_approval_thread",
        "partial_evidence_timeline"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "reduced_motion",
        "cli_export",
        "degraded_state",
        "inline_component_truth"
      ]
    },
    "inline_claim": {
      "enum": [
        "trusted_inline_result",
        "reviewable_inline_result",
        "anchor_unverified_projection",
        "severity_unverified_projection",
        "fix_posture_unverified_projection",
        "confidence_unverified_projection",
        "approval_unverified_projection",
        "evidence_lineage_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "editor_tab",
        "gutter",
        "diagnostic_decoration",
        "code_action_chip",
        "diff_view",
        "review_thread",
        "ai_message_card",
        "evidence_timeline"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "tab_marker_diagnostic_color_only",
        "comment_anchor_drifted_silently",
        "evidence_pointer_drifted_silently",
        "outdated_and_resolved_blurred",
        "inferred_fix_shown_as_exact",
        "evidence_timeline_opaque_log",
        "diagnostic_freshness_unstated",
        "ai_confidence_unstated",
        "diff_change_kind_collapsed",
        "anchor_state_unstated",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encodes_state_by_color_alone",
        "lets_anchor_or_evidence_pointer_drift",
        "blurs_outdated_and_resolved_review_state",
        "presents_inferred_fix_as_exact",
        "hides_evidence_timeline_in_opaque_log"
      ],
      "properties": {
        "encodes_state_by_color_alone": { "const": false },
        "lets_anchor_or_evidence_pointer_drift": { "const": false },
        "blurs_outdated_and_resolved_review_state": { "const": false },
        "presents_inferred_fix_as_exact": { "const": false },
        "hides_evidence_timeline_in_opaque_log": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/inline_claim" },
        "to_claim": { "$ref": "#/$defs/inline_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_editor_inline_component_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/inline_claim" },
        "certified_claim": { "$ref": "#/$defs/inline_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-editor-inline-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
