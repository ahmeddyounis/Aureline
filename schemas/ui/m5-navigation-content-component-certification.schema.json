{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-navigation-content-component-certification.schema.json",
  "title": "Aureline M5 navigation-content component surface certification packet",
  "description": "M05-1115 closing capstone certifying that the frozen M5 navigation-content component families (tab strip, breadcrumbs, tree view, list view, table/grid, panel header) hold their truth on every claimed M5 navigation-content operating profile. Keyed on the claimed profile (live active-context shell, reviewable explorer tree, reviewable result grid, traced breadcrumb trail, stale-hierarchy breadcrumb, unresolved-count list, stale-provenance grid, partial-freshness panel), each row certifies the profile across eight truth axes — visual, keyboard, screen-reader, high-zoom-reflow, reduced-motion, CLI/export, degraded-state, and navigation-content-truth behavior — and either passes (green), auto-narrows its navigation/content claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh current-navigation claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party current-navigation profile may certify a current-navigation result; and every B132 guardrail must hold (tabs never masquerade as top-level navigation, counts or blocked rows are never hidden behind ellipses, tree/list/table actions are never hover-only, the panel header never becomes a secondary toolbar, and exact/loaded/all-matching count scopes never collapse into one total). Every row cites exactly one canonical navigation-content proof bundle. The packet is metadata-only: raw tree bodies, row payloads, query internals, credentials, and endpoint refs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_navigation_content_component_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-navigation-content-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_active_context_shell",
        "reviewable_explorer_tree",
        "reviewable_result_grid",
        "traced_breadcrumb_trail",
        "stale_hierarchy_breadcrumb",
        "unresolved_count_list",
        "stale_provenance_grid",
        "partial_freshness_panel"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "reduced_motion",
        "cli_export",
        "degraded_state",
        "navigation_content_truth"
      ]
    },
    "support_claim": {
      "enum": [
        "current_navigation_result",
        "reviewable_structure_result",
        "hierarchy_unverified_projection",
        "count_unverified_projection",
        "sort_filter_unverified_projection",
        "source_freshness_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "tab_strip",
        "breadcrumbs",
        "tree_view",
        "list_view",
        "table_grid",
        "panel_header"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "tabs_masquerade_as_workflow_nav",
        "active_context_unstated",
        "hierarchy_path_unstated",
        "disclosure_state_hidden",
        "selection_versus_current_collapsed",
        "count_scope_collapsed",
        "blocked_rows_hidden_behind_ellipsis",
        "hidden_by_policy_count_omitted",
        "local_actions_hover_only",
        "panel_header_overloaded",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabs_masquerade_as_top_level_navigation",
        "hides_counts_or_blocked_rows_behind_ellipses",
        "makes_tree_list_table_actions_hover_only",
        "panel_header_becomes_secondary_toolbar",
        "collapses_exact_loaded_all_matching_scopes"
      ],
      "properties": {
        "tabs_masquerade_as_top_level_navigation": { "const": false },
        "hides_counts_or_blocked_rows_behind_ellipses": { "const": false },
        "makes_tree_list_table_actions_hover_only": { "const": false },
        "panel_header_becomes_secondary_toolbar": { "const": false },
        "collapses_exact_loaded_all_matching_scopes": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/support_claim" },
        "to_claim": { "$ref": "#/$defs/support_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_navigation_content_component_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/support_claim" },
        "certified_claim": { "$ref": "#/$defs/support_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-navigation-content-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
