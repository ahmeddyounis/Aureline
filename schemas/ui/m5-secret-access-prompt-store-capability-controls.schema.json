{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-secret-access-prompt-store-capability-controls.schema.json",
  "title": "Aureline M5 secret-access prompt sheets and credential-store-capability rows",
  "description": "Export-safe packet implementing the reusable M5 secret-access-prompt-sheet and credential-store-capability-row components in two co-equal control vectors. Each secret-access prompt names its asking actor, purpose, requested scope, credential class, and raw-secret-versus-handle-only reveal posture; its handle-availability class is derived from the reveal posture, so when a handle-only path exists a user sees it surfaced instead of being nudged toward raw-secret sprawl, and a flow requesting the raw secret can never quietly present as handle-only. It always names its retention note, always offers keyboard-complete allow / deny / once actions, and always names what still works if denied. Each credential-store-capability row names its store type, store capabilities, and verification state, plus its portability / export posture and platform limitations; its trust class is derived from the verification state and capabilities, so an unverified, verification-failed, or unsupported store can never read as 'securely stored' and no vague 'saved securely' message stands in for an unproven store. Friendly connected wording never conceals storage mode, reveal posture, or an unverified store; raw secret values, tokens, passphrases, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "secret_access_prompts",
    "store_capability_rows",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "secret_access_prompt_store_capability_controls" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "secret_access_prompts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/secret_access_prompt" }
    },
    "store_capability_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/store_capability_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "storage_mode": {
      "type": "string",
      "enum": [
        "os_keychain",
        "encrypted_vault",
        "secret_broker_handle",
        "session_memory_only",
        "external_reference",
        "no_secret_stored"
      ]
    },
    "credential_class": {
      "type": "string",
      "enum": [
        "oauth_token",
        "api_key",
        "personal_access_token",
        "ssh_or_signing_key",
        "client_certificate",
        "device_code_grant"
      ]
    },
    "reveal_posture": {
      "type": "string",
      "enum": [
        "handle_only",
        "masked_last_four",
        "reveal_on_demand",
        "clipboard_scoped",
        "never_revealed",
        "policy_blocked_reveal"
      ]
    },
    "store_capability": {
      "type": "string",
      "enum": [
        "persist_across_restart",
        "os_locked_at_rest",
        "sync_across_devices",
        "hardware_backed",
        "store_export_blocked",
        "session_only"
      ]
    },
    "export_safety_class": {
      "type": "string",
      "enum": [
        "raw_secret_excluded",
        "metadata_only",
        "handle_reference_only",
        "redacted_share",
        "endpoints_masked",
        "export_blocked"
      ]
    },
    "degraded_state": {
      "type": "string",
      "enum": [
        "fully_available",
        "limited_capability",
        "stale_needs_reauth",
        "offline_cached",
        "policy_blocked",
        "unavailable"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "storage_and_reveal_posture",
        "identity_and_delegation",
        "expiry_and_export_boundary"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "sign_in_and_auth",
        "provider_and_registry",
        "remote_and_database",
        "package_and_release",
        "recovery_and_audit",
        "cli_and_headless"
      ]
    },
    "deployment_line": {
      "type": "string",
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "credential_settings_ui",
        "secret_prompt_ui",
        "vault_picker_ui",
        "device_code_handoff_ui",
        "delegated_identity_ui",
        "support_export",
        "cli_inspect",
        "status_bar_ui",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "storage_mode_unstated",
        "reveal_posture_unstated",
        "credential_class_unstated",
        "auth_handoff_class_unstated",
        "delegated_identity_unstated",
        "lifecycle_state_hidden",
        "store_capability_unstated",
        "export_safety_boundary_hidden",
        "alternate_state_label_invented",
        "friendly_connected_wording_used",
        "session_only_fallback_hidden",
        "proof_stale"
      ]
    },
    "secret_request_actor": {
      "type": "string",
      "enum": [
        "first_party_feature",
        "provider_connector",
        "registry_client",
        "remote_or_database_attach",
        "release_publisher",
        "delegated_agent"
      ]
    },
    "handle_availability_class": {
      "type": "string",
      "enum": [
        "handle_only_available",
        "scoped_reveal_only",
        "raw_reveal_requested",
        "reveal_policy_blocked"
      ]
    },
    "prompt_action": {
      "type": "string",
      "enum": [
        "allow_once",
        "allow_for_session",
        "allow_and_store",
        "deny",
        "review_scope",
        "copy_handle_reference"
      ]
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "hardware_attested",
        "os_verified",
        "encrypted_verified",
        "unverified",
        "verification_failed",
        "unsupported"
      ]
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "securely_stored",
        "limited_assurance",
        "unverified_store",
        "unsupported_store"
      ]
    },
    "store_row_action": {
      "type": "string",
      "enum": [
        "verify_store",
        "choose_different_store",
        "view_capabilities",
        "open_source_of_truth",
        "export_row"
      ]
    },
    "degraded_state_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/degraded_state" }
    },
    "required_label_array": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/required_label" },
      "allOf": [
        { "contains": { "const": "identity" } },
        { "contains": { "const": "state" } },
        { "contains": { "const": "keyboard_route" } }
      ]
    },
    "accessibility_route_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_route" },
      "contains": { "const": "keyboard_focusable" }
    },
    "secret_access_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "sheet_id",
        "actor",
        "actor_label",
        "purpose_note",
        "requested_scope_note",
        "credential_class",
        "reveal_posture",
        "handle_availability_class",
        "claims_handle_only_path",
        "handle_only_note",
        "raw_reveal_disclosure_note",
        "reveal_blocked_note",
        "retention_note",
        "denied_fallback_note",
        "storage_and_reveal_note",
        "default_actions",
        "degraded_states",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_storage_or_reveal_posture",
        "implies_raw_secret_exportable",
        "uses_friendly_connected_wording"
      ],
      "properties": {
        "component": { "const": "secret_access_prompt_sheet" },
        "sheet_id": { "$ref": "#/$defs/non_empty_string" },
        "actor": { "$ref": "#/$defs/secret_request_actor" },
        "actor_label": { "$ref": "#/$defs/non_empty_string" },
        "purpose_note": { "$ref": "#/$defs/non_empty_string" },
        "requested_scope_note": { "$ref": "#/$defs/non_empty_string" },
        "credential_class": { "$ref": "#/$defs/credential_class" },
        "reveal_posture": { "$ref": "#/$defs/reveal_posture" },
        "handle_availability_class": { "$ref": "#/$defs/handle_availability_class" },
        "claims_handle_only_path": { "type": "boolean" },
        "handle_only_note": { "type": "string" },
        "raw_reveal_disclosure_note": { "type": "string" },
        "reveal_blocked_note": { "type": "string" },
        "retention_note": { "$ref": "#/$defs/non_empty_string" },
        "denied_fallback_note": { "$ref": "#/$defs/non_empty_string" },
        "storage_and_reveal_note": { "$ref": "#/$defs/non_empty_string" },
        "default_actions": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/prompt_action" },
          "allOf": [
            { "contains": { "const": "allow_once" } },
            { "contains": { "const": "allow_and_store" } },
            { "contains": { "const": "deny" } }
          ]
        },
        "degraded_states": { "$ref": "#/$defs/degraded_state_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_storage_or_reveal_posture": { "const": false },
        "implies_raw_secret_exportable": { "const": false },
        "uses_friendly_connected_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "handle_availability_class": {
                "enum": ["handle_only_available", "scoped_reveal_only"]
              }
            },
            "required": ["handle_availability_class"]
          },
          "then": {
            "properties": { "handle_only_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "handle_availability_class": { "const": "raw_reveal_requested" } },
            "required": ["handle_availability_class"]
          },
          "then": {
            "properties": {
              "raw_reveal_disclosure_note": { "$ref": "#/$defs/non_empty_string" }
            }
          }
        },
        {
          "if": {
            "properties": { "handle_availability_class": { "const": "reveal_policy_blocked" } },
            "required": ["handle_availability_class"]
          },
          "then": {
            "properties": { "reveal_blocked_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "handle_availability_class": { "const": "handle_only_available" } },
            "required": ["handle_availability_class"]
          },
          "then": {
            "properties": { "claims_handle_only_path": { "const": true } },
            "required": ["claims_handle_only_path"]
          },
          "else": {
            "properties": { "claims_handle_only_path": { "const": false } },
            "required": ["claims_handle_only_path"]
          }
        }
      ]
    },
    "store_capability_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "store_label",
        "storage_mode",
        "store_capabilities",
        "verification_state",
        "verification_label",
        "export_safety_class",
        "trust_class",
        "claims_securely_stored",
        "portability_export_note",
        "platform_limitations_note",
        "unverified_note",
        "unsupported_note",
        "session_only_fallback_note",
        "storage_and_capability_note",
        "default_actions",
        "degraded_states",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_storage_or_reveal_posture",
        "implies_raw_secret_exportable",
        "uses_friendly_connected_wording"
      ],
      "properties": {
        "component": { "const": "credential_store_capability_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "store_label": { "$ref": "#/$defs/non_empty_string" },
        "storage_mode": { "$ref": "#/$defs/storage_mode" },
        "store_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/store_capability" }
        },
        "verification_state": { "$ref": "#/$defs/verification_state" },
        "verification_label": { "$ref": "#/$defs/non_empty_string" },
        "export_safety_class": { "$ref": "#/$defs/export_safety_class" },
        "trust_class": { "$ref": "#/$defs/trust_class" },
        "claims_securely_stored": { "type": "boolean" },
        "portability_export_note": { "$ref": "#/$defs/non_empty_string" },
        "platform_limitations_note": { "$ref": "#/$defs/non_empty_string" },
        "unverified_note": { "type": "string" },
        "unsupported_note": { "type": "string" },
        "session_only_fallback_note": { "type": "string" },
        "storage_and_capability_note": { "$ref": "#/$defs/non_empty_string" },
        "default_actions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/store_row_action" },
          "allOf": [
            { "contains": { "const": "verify_store" } },
            { "contains": { "const": "choose_different_store" } }
          ]
        },
        "degraded_states": { "$ref": "#/$defs/degraded_state_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_storage_or_reveal_posture": { "const": false },
        "implies_raw_secret_exportable": { "const": false },
        "uses_friendly_connected_wording": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "trust_class": { "const": "unverified_store" } },
            "required": ["trust_class"]
          },
          "then": {
            "properties": { "unverified_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "trust_class": { "const": "unsupported_store" } },
            "required": ["trust_class"]
          },
          "then": {
            "properties": { "unsupported_note": { "$ref": "#/$defs/non_empty_string" } }
          }
        },
        {
          "if": {
            "properties": { "trust_class": { "const": "limited_assurance" } },
            "required": ["trust_class"]
          },
          "then": {
            "properties": {
              "session_only_fallback_note": { "$ref": "#/$defs/non_empty_string" }
            }
          }
        },
        {
          "if": {
            "properties": { "trust_class": { "const": "securely_stored" } },
            "required": ["trust_class"]
          },
          "then": {
            "properties": { "claims_securely_stored": { "const": true } },
            "required": ["claims_securely_stored"]
          },
          "else": {
            "properties": { "claims_securely_stored": { "const": false } },
            "required": ["claims_securely_stored"]
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_shows_actor_purpose_and_scope",
        "prompt_shows_raw_versus_handle_only_posture",
        "handle_only_path_surfaced_when_available",
        "raw_reveal_never_nudged",
        "prompt_shows_retention_and_denied_fallback",
        "allow_deny_once_semantics_present",
        "store_row_shows_type_and_verification_state",
        "store_row_shows_portability_and_platform_limits",
        "trust_class_derived_never_asserted",
        "unverified_or_unsupported_never_reads_as_secure",
        "session_only_fallback_explicit_when_policy_allows",
        "raw_secret_handling_never_normalized",
        "no_vague_saved_securely_wording",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "prompt_shows_actor_purpose_and_scope": { "const": true },
        "prompt_shows_raw_versus_handle_only_posture": { "const": true },
        "handle_only_path_surfaced_when_available": { "const": true },
        "raw_reveal_never_nudged": { "const": true },
        "prompt_shows_retention_and_denied_fallback": { "const": true },
        "allow_deny_once_semantics_present": { "const": true },
        "store_row_shows_type_and_verification_state": { "const": true },
        "store_row_shows_portability_and_platform_limits": { "const": true },
        "trust_class_derived_never_asserted": { "const": true },
        "unverified_or_unsupported_never_reads_as_secure": { "const": true },
        "session_only_fallback_explicit_when_policy_allows": { "const": true },
        "raw_secret_handling_never_normalized": { "const": true },
        "no_vague_saved_securely_wording": { "const": true },
        "controls_stable_across_deployment_lines": { "const": true },
        "copy_and_export_safe": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_shows_actor_scope_and_alternative_without_docs",
        "handle_only_path_visible_before_raw_reveal",
        "store_row_shows_type_verification_and_limits_inline",
        "cli_headless_shows_control_truth",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "prompt_shows_actor_scope_and_alternative_without_docs": { "const": true },
        "handle_only_path_visible_before_raw_reveal": { "const": true },
        "store_row_shows_type_verification_and_limits_inline": { "const": true },
        "cli_headless_shows_control_truth": { "const": true },
        "support_export_shows_control_truth": { "const": true },
        "help_about_shows_control_truth": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
