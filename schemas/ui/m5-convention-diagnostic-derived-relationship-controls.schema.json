{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-convention-diagnostic-derived-relationship-controls.schema.json",
  "title": "Aureline M5 convention-diagnostic rows and derived-relationship banners",
  "description": "Export-safe packet implementing the reusable M5 convention-diagnostic-row and derived-relationship-banner families in two co-equal control vectors. Each diagnostic row names its distinct diagnostic class (hard contract violation, pack limitation, version mismatch, heuristic suspicion, deprecation notice, or unknown diagnostic), its affected entity / file, its confidence and severity, its detected source, its suggested fix / open-docs action, and its support-class caveat; its certainty posture (exact from source, runtime confirmed, heuristic, or partial / unresolved) is derived from the frozen confidence class, so a framework warning never collapses distinct problems into one generic warning state and a heuristic suspicion never reads as an exact contract fact. Each banner names its source of inference, its last refresh, its exact / partial / heuristic / runtime-confirmed state, its named place of consumption, and its open-raw-source / open-wider-graph actions, so an inferred link never reads as exact and a banner appears where inferred truth is consumed rather than hiding the approximation in the background. Every row and banner links back to a canonical proving source (source file, source symbol, runtime trace, or docs anchor) rather than acting as a hidden parallel model, and an ungrounded or unresolved component never claims a proving source it does not have. No component lets a heuristic diagnostic or link masquerade as exact, collapses distinct diagnostics into one generic warning, hides an approximation in the background, acts as a hidden parallel model, or invents an alternate state label; raw file bodies, raw source trees, pasted local paths, repository URLs, credentials, and secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "diagnostic_rows",
    "relationship_banners",
    "downgrade_triggers",
    "consumer_surfaces",
    "convention_relationship_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_convention_diagnostic_rows_and_derived_relationship_banners_with_diagnostic_class_affected_entity_or_file_certainty_detected_source_suggested_fix_or_open_docs_actions_support_class_caveats_and_open_raw_source_or_wider_graph_continuity"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "diagnostic_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/convention_diagnostic_row" }
    },
    "relationship_banners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/derived_relationship_banner" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "convention_relationship_review": { "$ref": "#/$defs/convention_relationship_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "convention_confidence_class": {
      "enum": [
        "verified",
        "high_confidence",
        "heuristic_convention",
        "derived_by_convention",
        "low_confidence",
        "unknown"
      ]
    },
    "diagnostic_severity": {
      "enum": ["error", "warning", "hint", "info", "suppressed", "stale"]
    },
    "derived_relationship_class": {
      "enum": [
        "exact_from_source",
        "inferred_from_runtime",
        "heuristic_link",
        "derived_by_convention",
        "partial_link",
        "unresolved_link"
      ]
    },
    "relationship_proving_state": {
      "enum": [
        "proving_source_linked",
        "source_linked_partial",
        "runtime_evidence_only",
        "convention_only",
        "no_proving_source",
        "unknown_proving"
      ]
    },
    "certainty_posture": {
      "enum": [
        "exact_from_source",
        "runtime_confirmed",
        "heuristic",
        "partial_or_unresolved"
      ]
    },
    "diagnostic_class": {
      "enum": [
        "hard_contract_violation",
        "pack_limitation",
        "version_mismatch",
        "heuristic_suspicion",
        "deprecation_notice",
        "unknown_diagnostic"
      ]
    },
    "detection_source": {
      "enum": [
        "static_analysis",
        "framework_contract",
        "pack_manifest",
        "runtime_probe",
        "heuristic_scan"
      ]
    },
    "support_caveat_class": {
      "enum": [
        "fully_supported",
        "pack_limited",
        "version_mismatch",
        "bridged_behavior",
        "heuristic_only",
        "unsupported"
      ]
    },
    "diagnostic_fix_action": {
      "enum": [
        "auto_fix_available",
        "manual_fix_guidance",
        "open_docs_only",
        "no_fix_available"
      ]
    },
    "inference_source": {
      "enum": [
        "static_source",
        "runtime_observation",
        "naming_convention",
        "dependency_graph",
        "manifest_declaration"
      ]
    },
    "refresh_state": {
      "enum": ["current", "imported", "stale", "never_refreshed", "unknown"]
    },
    "proving_source_link": {
      "enum": [
        "source_file",
        "source_symbol",
        "runtime_trace",
        "docs_anchor",
        "no_proving_source"
      ]
    },
    "diagnostic_row_action": {
      "enum": [
        "open_proving_file",
        "inspect_class_and_confidence",
        "open_docs_or_apply_fix",
        "copy_diagnostic_id",
        "open_reference"
      ]
    },
    "banner_action": {
      "enum": [
        "open_raw_source",
        "open_wider_graph",
        "inspect_state_and_source",
        "copy_banner_id",
        "open_reference"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "pack_source_and_certainty",
        "execution_boundary_and_impact",
        "proving_source_and_recovery_boundary"
      ]
    },
    "surface_family": {
      "enum": [
        "framework_pack_surface",
        "route_explorer",
        "topology_explorer",
        "convention_diagnostics",
        "generator_review",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "framework_pack_ui",
        "route_explorer_ui",
        "topology_ui",
        "diagnostic_center_ui",
        "generator_review_ui",
        "run_config_ui",
        "editor_gutter_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "pack_identity_unstated",
        "support_class_unstated",
        "exact_versus_heuristic_unstated",
        "authorship_unstated",
        "execution_boundary_unstated",
        "impact_undisclosed",
        "proving_source_omitted",
        "rollback_path_omitted",
        "derived_state_unlabeled",
        "convention_confidence_overstated",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "convention_diagnostic_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "diagnostic_id",
        "diagnostic_message_label",
        "diagnostic_class",
        "affected_entity_label",
        "affected_file_label",
        "convention_confidence_class",
        "diagnostic_severity",
        "certainty",
        "derived_certainty_posture",
        "claims_exact_from_source",
        "has_proving_source_form",
        "detection_source",
        "detected_source_label",
        "support_caveat",
        "support_caveat_label",
        "fix_action",
        "suggested_fix_label",
        "heuristic_note",
        "partial_note",
        "no_source_form_note",
        "certainty_and_confidence_note",
        "proving_source_kind",
        "proving_source_ref",
        "context_note",
        "row_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "lets_heuristic_masquerade_as_exact",
        "collapses_distinct_diagnostics_into_generic_warning",
        "acts_as_hidden_parallel_model",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "convention_diagnostic_row" },
        "diagnostic_id": { "$ref": "#/$defs/non_empty_string" },
        "diagnostic_message_label": { "$ref": "#/$defs/non_empty_string" },
        "diagnostic_class": { "$ref": "#/$defs/diagnostic_class" },
        "affected_entity_label": { "$ref": "#/$defs/non_empty_string" },
        "affected_file_label": { "$ref": "#/$defs/non_empty_string" },
        "convention_confidence_class": { "$ref": "#/$defs/convention_confidence_class" },
        "diagnostic_severity": { "$ref": "#/$defs/diagnostic_severity" },
        "certainty": { "$ref": "#/$defs/certainty_disposition" },
        "derived_certainty_posture": { "$ref": "#/$defs/certainty_posture" },
        "claims_exact_from_source": { "type": "boolean" },
        "has_proving_source_form": { "type": "boolean" },
        "detection_source": { "$ref": "#/$defs/detection_source" },
        "detected_source_label": { "$ref": "#/$defs/non_empty_string" },
        "support_caveat": { "$ref": "#/$defs/support_caveat_class" },
        "support_caveat_label": { "type": "string" },
        "fix_action": { "$ref": "#/$defs/diagnostic_fix_action" },
        "suggested_fix_label": { "$ref": "#/$defs/non_empty_string" },
        "heuristic_note": { "type": "string" },
        "partial_note": { "type": "string" },
        "no_source_form_note": { "type": "string" },
        "certainty_and_confidence_note": { "$ref": "#/$defs/non_empty_string" },
        "proving_source_kind": { "$ref": "#/$defs/proving_source_link" },
        "proving_source_ref": { "type": "string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "row_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_proving_file" } },
            { "contains": { "const": "inspect_class_and_confidence" } },
            { "contains": { "const": "open_docs_or_apply_fix" } }
          ],
          "items": { "$ref": "#/$defs/diagnostic_row_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certainty_disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "lets_heuristic_masquerade_as_exact": { "const": false },
        "collapses_distinct_diagnostics_into_generic_warning": { "const": false },
        "acts_as_hidden_parallel_model": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "derived_relationship_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "banner_id",
        "relationship_label",
        "derived_relationship_class",
        "relationship_proving_state",
        "certainty",
        "derived_certainty_posture",
        "claims_exact_from_source",
        "has_proving_source_form",
        "inference_source",
        "inference_source_label",
        "refresh_state",
        "last_refresh_label",
        "consumed_context_label",
        "heuristic_note",
        "partial_note",
        "no_source_form_note",
        "certainty_and_state_note",
        "proving_source_kind",
        "proving_source_ref",
        "context_note",
        "banner_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "lets_heuristic_masquerade_as_exact",
        "hides_approximation_in_background",
        "acts_as_hidden_parallel_model",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "derived_relationship_banner" },
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "relationship_label": { "$ref": "#/$defs/non_empty_string" },
        "derived_relationship_class": { "$ref": "#/$defs/derived_relationship_class" },
        "relationship_proving_state": { "$ref": "#/$defs/relationship_proving_state" },
        "certainty": { "$ref": "#/$defs/certainty_disposition" },
        "derived_certainty_posture": { "$ref": "#/$defs/certainty_posture" },
        "claims_exact_from_source": { "type": "boolean" },
        "has_proving_source_form": { "type": "boolean" },
        "inference_source": { "$ref": "#/$defs/inference_source" },
        "inference_source_label": { "$ref": "#/$defs/non_empty_string" },
        "refresh_state": { "$ref": "#/$defs/refresh_state" },
        "last_refresh_label": { "$ref": "#/$defs/non_empty_string" },
        "consumed_context_label": { "$ref": "#/$defs/non_empty_string" },
        "heuristic_note": { "type": "string" },
        "partial_note": { "type": "string" },
        "no_source_form_note": { "type": "string" },
        "certainty_and_state_note": { "$ref": "#/$defs/non_empty_string" },
        "proving_source_kind": { "$ref": "#/$defs/proving_source_link" },
        "proving_source_ref": { "type": "string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "banner_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_raw_source" } },
            { "contains": { "const": "open_wider_graph" } },
            { "contains": { "const": "inspect_state_and_source" } }
          ],
          "items": { "$ref": "#/$defs/banner_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certainty_disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "lets_heuristic_masquerade_as_exact": { "const": false },
        "hides_approximation_in_background": { "const": false },
        "acts_as_hidden_parallel_model": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "convention_relationship_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_row_shows_class_and_entity",
        "diagnostic_row_shows_confidence_and_severity",
        "diagnostic_row_offers_proving_file",
        "banner_shows_relationship_and_source",
        "banner_shows_state_and_refresh",
        "banner_offers_raw_source_and_wider_graph",
        "certainty_derived_never_asserted",
        "heuristic_never_shown_as_exact",
        "distinct_diagnostics_never_collapsed",
        "approximation_never_hidden_in_background",
        "support_class_caveat_always_visible",
        "every_component_links_to_proving_source",
        "ungrounded_component_never_fakes_a_source",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_center_reads_single_source",
        "editor_gutter_reads_single_source",
        "topology_explorer_reads_single_source",
        "certainty_and_caveat_visible_before_trust",
        "banner_appears_where_inferred_truth_consumed",
        "proving_source_reachable_before_trust",
        "support_export_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
