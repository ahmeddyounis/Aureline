{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-merge-decision-generated-notice-controls.schema.json",
  "title": "Aureline M5 merge decision rows and generated-artifact notices",
  "description": "Export-safe packet implementing the reusable M5 merge-decision-row and generated-artifact-notice components. Each merge decision row answers, from the component alone, which structured object is in conflict, what its Base, Current, Incoming, and Result summaries are, what conflict kind and conflict class the conflict belongs to, whether unknown fields are preserved, and which resolution guidance is safe — so a generated, lockfile, manifest, or policy-owned conflict never masquerades as an ordinary line merge and the flow states when regenerate-first or manual resolution is safer than direct write-back. Each generated-artifact notice names its generated-from relation and source-of-truth pointer, its stale/diverged state, its last-generated version or time, its regenerate/open-source actions, and its compare-only-versus-write-back restriction. A generated-artifact conflict merge row is accompanied by a generated-artifact notice for the same artifact. Raw artifact bodies, raw diffs, credentials, and live provider responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "merge_decision_rows",
    "generated_artifact_notices",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "merge_decision_rows_and_generated_artifact_notices"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "merge_decision_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/merge_decision_row"
      }
    },
    "generated_artifact_notices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/generated_artifact_notice"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_trigger"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "fidelity_state": {
      "type": "string",
      "enum": [
        "structured_faithful",
        "structured_partial",
        "schema_unrecognized",
        "render_untrusted",
        "raw_fallback",
        "redacted_or_withheld"
      ]
    },
    "rollback_posture": {
      "type": "string",
      "enum": [
        "read_only_no_mutation",
        "compare_only_no_write_back",
        "write_back_attributable",
        "regenerate_only_no_manual_edit",
        "evidence_preserved_no_revert",
        "not_applicable"
      ]
    },
    "conflict_class": {
      "type": "string",
      "enum": [
        "ordinary_line_merge",
        "generated_artifact_conflict",
        "lockfile_conflict",
        "manifest_conflict",
        "policy_owned_conflict"
      ]
    },
    "resolution_guidance": {
      "type": "string",
      "enum": [
        "manual",
        "regenerate_from_source",
        "accept_current",
        "accept_incoming",
        "accept_both"
      ]
    },
    "generated_artifact_state": {
      "type": "string",
      "enum": [
        "up_to_date",
        "stale",
        "diverged",
        "generation_unknown"
      ]
    },
    "write_back_restriction": {
      "type": "string",
      "enum": [
        "compare_only",
        "regenerate_only",
        "write_back_allowed"
      ]
    },
    "generated_notice_action": {
      "type": "string",
      "enum": [
        "regenerate",
        "open_source",
        "compare_against_source",
        "view_lineage",
        "dismiss"
      ]
    },
    "merge_component": {
      "type": "string",
      "const": "merge_decision_row"
    },
    "generated_component": {
      "type": "string",
      "const": "generated_artifact_notice"
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "schema_unrecognized",
        "generated_artifact_drifted",
        "compare_only_enforced",
        "regenerate_first_enforced",
        "redaction_applied",
        "trust_narrowing",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "diff_compare_view",
        "merge_conflict_workspace",
        "notebook_review",
        "artifact_browser",
        "cli_headless",
        "support_export",
        "help_about"
      ]
    },
    "merge_decision_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "artifact_ref",
        "object_path",
        "conflict_class",
        "conflict_kind",
        "base_summary",
        "current_summary",
        "incoming_summary",
        "result_summary",
        "preserve_unknown_fields_note",
        "available_guidance",
        "recommended_guidance",
        "write_back_safety_note",
        "schema_fidelity",
        "raw_context_action",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/merge_component"
        },
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "object_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "conflict_class": {
          "$ref": "#/$defs/conflict_class"
        },
        "conflict_kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "base_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "current_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "incoming_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "result_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "preserve_unknown_fields_note": {
          "type": "string"
        },
        "available_guidance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resolution_guidance"
          }
        },
        "recommended_guidance": {
          "$ref": "#/$defs/resolution_guidance"
        },
        "write_back_safety_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema_fidelity": {
          "$ref": "#/$defs/fidelity_state"
        },
        "raw_context_action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "conflict_class": {
                "not": {
                  "const": "ordinary_line_merge"
                }
              }
            }
          },
          "then": {
            "properties": {
              "preserve_unknown_fields_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "generated_artifact_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "notice_id",
        "artifact_ref",
        "artifact_class_label",
        "generated_from_relation",
        "source_of_truth_ref",
        "generation_state",
        "last_generated_label",
        "divergence_note",
        "available_actions",
        "write_back_restriction",
        "write_back_restriction_note",
        "schema_fidelity",
        "raw_context_action",
        "rollback_posture",
        "fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/generated_component"
        },
        "notice_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_class_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generated_from_relation": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_of_truth_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generation_state": {
          "$ref": "#/$defs/generated_artifact_state"
        },
        "last_generated_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "divergence_note": {
          "type": "string"
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/generated_notice_action"
          }
        },
        "write_back_restriction": {
          "$ref": "#/$defs/write_back_restriction"
        },
        "write_back_restriction_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema_fidelity": {
          "$ref": "#/$defs/fidelity_state"
        },
        "raw_context_action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rollback_posture": {
          "$ref": "#/$defs/rollback_posture"
        },
        "fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "generation_state": {
                "const": "diverged"
              }
            }
          },
          "then": {
            "properties": {
              "divergence_note": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_current_incoming_result_distinct",
        "special_conflict_never_ordinary_line_merge",
        "unknown_fields_preserved_explicitly",
        "regenerate_or_manual_stated_when_safer",
        "generated_from_relation_always_explicit",
        "stale_or_diverged_state_disclosed",
        "raw_context_always_reachable",
        "compare_only_never_silently_writable",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "base_current_incoming_result_distinct": {
          "type": "boolean",
          "const": true
        },
        "special_conflict_never_ordinary_line_merge": {
          "type": "boolean",
          "const": true
        },
        "unknown_fields_preserved_explicitly": {
          "type": "boolean",
          "const": true
        },
        "regenerate_or_manual_stated_when_safer": {
          "type": "boolean",
          "const": true
        },
        "generated_from_relation_always_explicit": {
          "type": "boolean",
          "const": true
        },
        "stale_or_diverged_state_disclosed": {
          "type": "boolean",
          "const": true
        },
        "raw_context_always_reachable": {
          "type": "boolean",
          "const": true
        },
        "compare_only_never_silently_writable": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge_row_shows_bcir_and_conflict_class",
        "generated_notice_shows_relation_and_restriction",
        "raw_context_reachable_from_both",
        "regenerate_first_guidance_shown",
        "cli_headless_shows_truth",
        "support_export_shows_truth",
        "help_about_shows_truth"
      ],
      "properties": {
        "merge_row_shows_bcir_and_conflict_class": {
          "type": "boolean",
          "const": true
        },
        "generated_notice_shows_relation_and_restriction": {
          "type": "boolean",
          "const": true
        },
        "raw_context_reachable_from_both": {
          "type": "boolean",
          "const": true
        },
        "regenerate_first_guidance_shown": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
