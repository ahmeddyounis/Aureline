{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-write-scope-preview-tree.schema.json",
  "title": "Aureline M5 write-scope-preview-tree primitive",
  "description": "Export-safe packet implementing the reusable M5 write-scope preview tree and its file nodes as one primitive pair. The packet binds one row per claimed multi-file change consumer — rename preview, refactor preview, search/replace preview, import preview, AI-apply preview, and repair preview — to the shared tree and node anatomy, the derived tree posture (focused/broad/generated-managed/out-of-workspace/conflict/blocked), the derived file-count bucket (empty/single/small/medium/large/sweeping), the derived node disposition (included/binary-included/generated-excludable/read-only-excluded/conflict-held/policy-blocked-excluded), the write-scope classes, managed-file caveats, mutation classes, change types, change actors, content classes, exclusion reasons, bounded inspect/expand/jump/narrow/exclude/apply/resolve and view-provenance/jump/toggle/reason/resolve actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked tree and node resolution cases proving the resolvers, and four hard invariants: it never flattens its files into a generic list, never drops ineligible files from the preview, never understates its write scope, and never hides a file node's actor provenance. Raw file bodies, diffs, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_write_scope_preview_trees_with_file_count_buckets_actor_provenance_selectable_scope_diff_jump_and_generated_read_only_conflict_exclusion_truth_across_claimed_m5_multi_file_change_flows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "recovery_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "recovery_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "tree_anatomy_parts",
        "node_anatomy_parts",
        "write_scope_classes",
        "mutation_classes",
        "managed_caveats",
        "change_types",
        "change_actors",
        "content_classes",
        "file_count_buckets",
        "tree_postures",
        "node_dispositions",
        "exclusion_reasons",
        "tree_actions",
        "node_actions",
        "tree_export_fields",
        "node_export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "tree_examples",
        "node_examples",
        "flattens_into_generic_file_list",
        "drops_ineligible_files",
        "understates_write_scope",
        "hides_actor_provenance"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "rename_preview",
            "refactor_preview",
            "search_replace_preview",
            "import_preview",
            "ai_apply_preview",
            "repair_preview"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "tree_anatomy_parts": { "type": "array", "minItems": 1 },
        "node_anatomy_parts": { "type": "array", "minItems": 1 },
        "write_scope_classes": { "type": "array", "minItems": 1 },
        "mutation_classes": { "type": "array", "minItems": 1 },
        "managed_caveats": { "type": "array", "minItems": 1 },
        "change_types": { "type": "array", "minItems": 1 },
        "change_actors": { "type": "array", "minItems": 1 },
        "content_classes": { "type": "array", "minItems": 1 },
        "file_count_buckets": { "type": "array", "minItems": 1 },
        "tree_postures": { "type": "array", "minItems": 1 },
        "node_dispositions": { "type": "array", "minItems": 1 },
        "exclusion_reasons": { "type": "array", "minItems": 1 },
        "tree_actions": { "type": "array", "minItems": 1 },
        "node_actions": { "type": "array", "minItems": 1 },
        "tree_export_fields": { "type": "array", "minItems": 1 },
        "node_export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tree_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tree_example" }
        },
        "node_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node_example" }
        },
        "flattens_into_generic_file_list": { "const": false },
        "drops_ineligible_files": { "const": false },
        "understates_write_scope": { "const": false },
        "hides_actor_provenance": { "const": false }
      }
    },
    "tree_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "tree_posture",
            "file_count_bucket",
            "scope_label",
            "write_scope_class",
            "can_apply",
            "can_narrow",
            "touches_generated_or_managed",
            "preserves_all_files",
            "understates_scope",
            "available_actions"
          ]
        }
      }
    },
    "node_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "node_disposition",
            "node_label",
            "change_type",
            "change_actor",
            "content_class",
            "is_included_in_apply",
            "preserves_file_in_preview",
            "available_actions"
          ]
        }
      }
    }
  }
}
