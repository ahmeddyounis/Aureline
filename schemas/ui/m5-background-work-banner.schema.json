{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-background-work-banner.schema.json",
  "title": "Aureline M5 background-work banner component",
  "description": "Canonical single-instance shape of the M5 background-work banner adaptive-efficiency component. One background-work banner names aggregate paused or slowed work explicitly, never behind toast-only messaging. Every claimed M5 background-work banner references this schema or the combined m5-efficiency-component-matrix.schema.json rather than reinventing its own low-power or thermal wording. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "work_dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "collapses_pressure_sources_into_generic_warning",
    "hides_paused_work_behind_toast_only",
    "presents_override_available_when_policy_blocks",
    "clears_stale_context_on_resume"
  ],
  "properties": {
    "component_family": {
      "const": "background_work_banner"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "work_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "running_full",
          "slowed",
          "paused",
          "policy_blocked",
          "override_available",
          "override_blocked",
          "resuming",
          "stale_result_shown",
          "not_evaluated"
        ]
      }
    },
    "pressure_sources": {
      "type": "array"
    },
    "efficiency_states": {
      "type": "array"
    },
    "affected_workloads": {
      "type": "array"
    },
    "override_postures": {
      "type": "array"
    },
    "policy_owners": {
      "type": "array"
    },
    "recovery_states": {
      "type": "array"
    },
    "stale_result_states": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "collapses_pressure_sources_into_generic_warning": {
      "const": false
    },
    "hides_paused_work_behind_toast_only": {
      "const": false
    },
    "presents_override_available_when_policy_blocks": {
      "const": false
    },
    "clears_stale_context_on_resume": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
