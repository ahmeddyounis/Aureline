{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-bundle-class-disclosure-primitive.schema.json",
  "title": "Aureline M5 bundle class-disclosure primitive",
  "description": "Canonical parity matrix for the reusable M5 bundle class-disclosure primitive: a class-disclosure card that names a bundle's disclosure class (native first-party, imported-user handoff, org-approved / managed, design-partner / certified, community, or local draft) with its policy owner, mirror source, entitlement dependency, and confidence / posture labels, and a claim-narrowing row that narrows the compatibility / support claim so an imported or org-approved bundle never inherits full native-parity language when it is capability-mapped or policy-bound. Both resolve from one disclosure context and share one disclosure identity. Narrows the bundle_class_disclosure_card and bundle_claim_narrowing_row families of the frozen M5 workflow-bundle component matrix into one working resolver. Users can tell why a bundle is recommended and how strong its claim actually is (AC1); imported and org-approved bundles no longer inherit native parity when capability-mapped or policy-bound (AC2); class disclosure stays stable across UI, docs / help, diagnostics, and support packets (AC3). Raw manifest bytes, credentials, entitlement tokens, mirror URLs, and provider cursors never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_bundle_class_disclosure_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "start_center_class_card",
        "bundle_detail_class_panel",
        "migration_class_disclosure_row",
        "docs_help_class_block",
        "diagnostics_class_report",
        "support_export_replay"
      ]
    },
    "disclosure_class": {
      "enum": [
        "native_first_party",
        "imported_user_handoff",
        "managed_approved",
        "design_partner_certified",
        "community",
        "local_draft"
      ]
    },
    "capability_confidence": {
      "enum": ["native", "exact", "capability_mapped", "approximate", "unsupported_gap"]
    },
    "export_field": {
      "enum": [
        "disclosure_id",
        "bundle_identity",
        "disclosure_class",
        "capability_confidence",
        "dependency_disclosure",
        "recommendation_reason",
        "support_claim_strength",
        "mirror_offline_posture"
      ]
    },
    "source_class": {
      "enum": [
        "certified",
        "managed_approved",
        "community_reviewed",
        "imported_pending_review",
        "local_draft"
      ]
    },
    "bundle_class": {
      "enum": [
        "launch_bundle",
        "framework_pack",
        "template_bundle",
        "imported_handoff_bundle",
        "org_managed_bundle",
        "no_bundle"
      ]
    },
    "signer_source": {
      "enum": ["first_party", "trusted_remote", "unverified_remote", "untrusted"]
    },
    "support_class": {
      "enum": [
        "stable",
        "preview",
        "labs",
        "policy_gated",
        "mirror_only",
        "bounded_platform"
      ]
    },
    "scorecard_class": {
      "enum": ["certified", "probable", "community", "imported", "preview", "local_draft"]
    },
    "freshness_state": {
      "enum": ["fresh", "aging", "stale", "missing"]
    },
    "imported_confidence": {
      "enum": ["native", "bridged", "approximated", "unverified"]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_supplied"]
    },
    "downgrade_trigger": {
      "enum": [
        "stale_certification",
        "mirror_stale",
        "offline_cache_only",
        "unverified_signer",
        "local_override_drift",
        "incompatible_aureline",
        "entitlement_dependency_unmet",
        "imported_not_native",
        "rollback_only_path"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "nullable_degraded_state": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/degraded_state" }]
    },
    "nullable_label": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "dependency_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depends_on_managed_registry",
        "depends_on_org_identity",
        "depends_on_mirror_freshness",
        "depends_on_policy_availability"
      ],
      "properties": {
        "depends_on_managed_registry": { "type": "boolean" },
        "depends_on_org_identity": { "type": "boolean" },
        "depends_on_mirror_freshness": { "type": "boolean" },
        "depends_on_policy_availability": { "type": "boolean" },
        "policy_owner": { "type": "string", "minLength": 1 },
        "mirror_source": { "type": "string", "minLength": 1 },
        "entitlement_dependency": { "type": "string", "minLength": 1 }
      }
    },
    "disclosure_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure_id",
        "surface_label",
        "bundle_id_ref",
        "bundle_name",
        "disclosure_class",
        "bundle_class",
        "signer_source",
        "support_class",
        "source_class",
        "scorecard_class",
        "certification_freshness",
        "imported_confidence",
        "capability_confidence",
        "compatible_aureline_range",
        "truth_mode",
        "dependencies",
        "reason_for_recommendation",
        "claims_full_native_parity",
        "implies_standalone_local_completeness",
        "claims_current_despite_stale"
      ],
      "properties": {
        "disclosure_id": { "$ref": "#/$defs/id" },
        "surface_label": { "type": "string" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "disclosure_class": { "$ref": "#/$defs/disclosure_class" },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/signer_source" },
        "support_class": { "$ref": "#/$defs/support_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "scorecard_class": { "$ref": "#/$defs/scorecard_class" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "imported_confidence": { "$ref": "#/$defs/imported_confidence" },
        "capability_confidence": { "$ref": "#/$defs/capability_confidence" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "dependencies": { "$ref": "#/$defs/dependency_disclosure" },
        "reason_for_recommendation": { "type": "string", "minLength": 1 },
        "claims_full_native_parity": { "type": "boolean" },
        "implies_standalone_local_completeness": { "const": false },
        "claims_current_despite_stale": { "const": false },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure_id",
        "bundle_id_ref",
        "bundle_name",
        "disclosure_class",
        "source_class",
        "capability_confidence",
        "posture_label",
        "policy_owner",
        "mirror_source",
        "entitlement_dependency",
        "depends_on_managed_registry",
        "depends_on_org_identity",
        "depends_on_mirror_freshness",
        "depends_on_policy_availability",
        "reason_for_recommendation",
        "discloses_class_meaning",
        "discloses_dependencies",
        "implies_standalone_local_completeness",
        "invents_private_class_meaning"
      ],
      "properties": {
        "disclosure_id": { "$ref": "#/$defs/id" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "bundle_name": { "type": "string", "minLength": 1 },
        "disclosure_class": { "$ref": "#/$defs/disclosure_class" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "capability_confidence": { "$ref": "#/$defs/capability_confidence" },
        "posture_label": { "type": "string", "minLength": 1 },
        "policy_owner": { "$ref": "#/$defs/nullable_label" },
        "mirror_source": { "$ref": "#/$defs/nullable_label" },
        "entitlement_dependency": { "$ref": "#/$defs/nullable_label" },
        "depends_on_managed_registry": { "type": "boolean" },
        "depends_on_org_identity": { "type": "boolean" },
        "depends_on_mirror_freshness": { "type": "boolean" },
        "depends_on_policy_availability": { "type": "boolean" },
        "reason_for_recommendation": { "type": "string", "minLength": 1 },
        "discloses_class_meaning": { "const": true },
        "discloses_dependencies": { "const": true },
        "implies_standalone_local_completeness": { "const": false },
        "invents_private_class_meaning": { "const": false }
      }
    },
    "resolved_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure_id",
        "bundle_id_ref",
        "capability_confidence",
        "support_claim_strength",
        "certification_freshness",
        "imported_confidence",
        "policy_bound",
        "is_narrowed",
        "inherits_native_parity",
        "narrowing_reason",
        "discloses_narrowing_reason",
        "invents_stale_wording"
      ],
      "properties": {
        "disclosure_id": { "$ref": "#/$defs/id" },
        "bundle_id_ref": { "$ref": "#/$defs/ref" },
        "capability_confidence": { "$ref": "#/$defs/capability_confidence" },
        "support_claim_strength": { "$ref": "#/$defs/scorecard_class" },
        "certification_freshness": { "$ref": "#/$defs/freshness_state" },
        "imported_confidence": { "$ref": "#/$defs/imported_confidence" },
        "policy_bound": { "type": "boolean" },
        "is_narrowed": { "type": "boolean" },
        "inherits_native_parity": { "type": "boolean" },
        "narrowing_reason": { "$ref": "#/$defs/nullable_label" },
        "discloses_narrowing_reason": { "type": "boolean" },
        "invents_stale_wording": { "const": false }
      }
    },
    "resolved_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure_id",
        "card",
        "row",
        "class_disclosed_with_shared_vocabulary",
        "native_parity_not_overclaimed",
        "standalone_completeness_not_overclaimed",
        "recommendation_and_strength_disclosed"
      ],
      "properties": {
        "disclosure_id": { "$ref": "#/$defs/id" },
        "card": { "$ref": "#/$defs/resolved_card" },
        "row": { "$ref": "#/$defs/resolved_row" },
        "class_disclosed_with_shared_vocabulary": { "const": true },
        "native_parity_not_overclaimed": { "const": true },
        "standalone_completeness_not_overclaimed": { "const": true },
        "recommendation_and_strength_disclosed": { "const": true },
        "degraded": { "$ref": "#/$defs/nullable_degraded_state" }
      }
    },
    "disclosure_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/disclosure_input" },
        "resolved": { "$ref": "#/$defs/resolved_disclosure" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "disclosure_classes",
        "capability_confidences",
        "source_classes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_disclosures",
        "overclaims_native_parity",
        "implies_standalone_completeness",
        "collapses_class_to_generic"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "disclosure_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disclosure_class" }
        },
        "capability_confidences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability_confidence" }
        },
        "source_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_class" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_disclosures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disclosure_case" }
        },
        "overclaims_native_parity": { "const": false },
        "implies_standalone_completeness": { "const": false },
        "collapses_class_to_generic": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "disclosure_classes",
        "capability_confidences",
        "export_fields",
        "source_classes",
        "bundle_classes",
        "signer_sources",
        "support_classes",
        "scorecard_classes",
        "freshness_states",
        "imported_confidences",
        "truth_modes",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "disclosure_classes": { "type": "array", "items": { "type": "string" } },
        "capability_confidences": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "source_classes": { "type": "array", "items": { "type": "string" } },
        "bundle_classes": { "type": "array", "items": { "type": "string" } },
        "signer_sources": { "type": "array", "items": { "type": "string" } },
        "support_classes": { "type": "array", "items": { "type": "string" } },
        "scorecard_classes": { "type": "array", "items": { "type": "string" } },
        "freshness_states": { "type": "array", "items": { "type": "string" } },
        "imported_confidences": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "disclosure_identity_preserved_across_surfaces",
        "class_disclosed_with_shared_vocabulary",
        "native_parity_never_inherited_when_mapped",
        "dependency_posture_disclosed",
        "recommendation_and_strength_disclosed",
        "support_export_reconstructs_disclosure",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "disclosure_identity_preserved_across_surfaces": { "const": true },
        "class_disclosed_with_shared_vocabulary": { "const": true },
        "native_parity_never_inherited_when_mapped": { "const": true },
        "dependency_posture_disclosed": { "const": true },
        "recommendation_and_strength_disclosed": { "const": true },
        "support_export_reconstructs_disclosure": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "narrowing_reads_single_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "disclosure_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "narrowing_reads_single_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "disclosure_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "disclosure_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
