{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-installed-state-diagnostics-card.schema.json",
  "title": "Aureline M5 installed-state diagnostics card component",
  "description": "Canonical single-instance shape of the M5 installed-state diagnostics card marketplace / install-review component. Every claimed M5 installed-state diagnostics card references this schema or the combined m5-marketplace-install-component-matrix.schema.json rather than reinventing its own source-class, compatibility, permission, budget, publisher, disable-scope, or rollback wording. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "hides_permission_widening_or_activation_cost",
    "hides_publisher_transfer_disable_scope_or_rollback_incompatibility",
    "collapses_registry_source_class_across_public_mirrored_enterprise",
    "presents_incompatible_or_over_budget_as_ready"
  ],
  "properties": {
    "component_family": {
      "const": "installed_state_diagnostics_card"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "public",
          "mirrored",
          "enterprise",
          "side_load",
          "verified",
          "transferred",
          "deprecated",
          "limited",
          "incompatible",
          "over_budget",
          "throttled",
          "quarantined",
          "disable_scope",
          "rollback_compatibility"
        ]
      }
    },
    "registry_source_classes": {
      "type": "array"
    },
    "compatibility_states": {
      "type": "array"
    },
    "host_runtime_models": {
      "type": "array"
    },
    "permission_postures": {
      "type": "array"
    },
    "activation_budget_bands": {
      "type": "array"
    },
    "publisher_continuity_states": {
      "type": "array"
    },
    "disable_scope_classes": {
      "type": "array"
    },
    "rollback_compatibility_states": {
      "type": "array"
    },
    "quarantine_states": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "hides_permission_widening_or_activation_cost": {
      "const": false
    },
    "hides_publisher_transfer_disable_scope_or_rollback_incompatibility": {
      "const": false
    },
    "collapses_registry_source_class_across_public_mirrored_enterprise": {
      "const": false
    },
    "presents_incompatible_or_over_budget_as_ready": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
