{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-flamegraph-view.schema.json",
  "title": "Aureline M5 flamegraph and profile compare view",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "view_id", "profile_ref", "session_ref", "view_mode", "artifact_origin", "thread_process_context", "mapping_quality", "symbol_summary", "focus_ref", "cost_scope", "call_tree_available", "source_navigation", "baseline", "textual_fallback_ref", "source_refs", "consumer_surfaces", "copy_export", "reduced_capability_banner", "support_export_join", "auto_narrowing_contract"],
  "properties": {
    "record_kind": { "enum": ["m5_flamegraph_view", "m5_heap_profile_compare_card"] },
    "schema_version": { "const": 1 },
    "view_id": { "$ref": "#/$defs/ref" },
    "profile_ref": { "$ref": "#/$defs/ref" },
    "session_ref": { "$ref": "#/$defs/ref" },
    "view_mode": { "enum": ["flamegraph", "icicle", "call_tree", "heavy_view", "heap_diff", "allocation_diff", "retained_size_diff"] },
    "artifact_origin": { "$ref": "#/$defs/artifact_origin" },
    "thread_process_context": { "type": "object", "additionalProperties": false, "required": ["process_ref", "thread_refs", "context_label"], "properties": { "process_ref": { "$ref": "#/$defs/ref" }, "thread_refs": { "$ref": "#/$defs/ref_array" }, "context_label": { "$ref": "#/$defs/ref" } } },
    "thread_process_filters": { "type": "object", "additionalProperties": false, "required": ["process_filter_ref", "thread_filter_refs", "active_filter_label"], "properties": { "process_filter_ref": { "$ref": "#/$defs/ref" }, "thread_filter_refs": { "$ref": "#/$defs/ref_array" }, "active_filter_label": { "$ref": "#/$defs/ref" } } },
    "mapping_quality": { "$ref": "#/$defs/mapping_quality" },
    "symbol_summary": { "type": "object", "additionalProperties": false, "required": ["symbolicated_frame_count", "unmapped_frame_count", "source_map_ref"], "properties": { "symbolicated_frame_count": { "type": "integer", "minimum": 0 }, "unmapped_frame_count": { "type": "integer", "minimum": 0 }, "source_map_ref": { "$ref": "#/$defs/ref" } } },
    "focus_ref": { "$ref": "#/$defs/ref" },
    "total_samples": { "type": "integer", "minimum": 0 },
    "total_time_ms": { "type": "integer", "minimum": 0 },
    "metric_presentation": { "enum": ["self_metric", "inclusive_metric", "self_and_inclusive"] },
    "cost_scope": { "type": "object", "additionalProperties": false, "required": ["metric", "scope_label", "sample_count_disclosed"], "properties": { "metric": { "enum": ["samples", "cpu_time", "wall_time", "allocations", "bytes", "retained_bytes"] }, "scope_label": { "$ref": "#/$defs/ref" }, "sample_count_disclosed": { "type": "boolean" } } },
    "zoom_state": { "type": "object", "additionalProperties": false, "required": ["root_ref", "selected_frame_ref", "depth_start", "depth_limit"], "properties": { "root_ref": { "$ref": "#/$defs/ref" }, "selected_frame_ref": { "$ref": "#/$defs/ref" }, "depth_start": { "type": "integer", "minimum": 0 }, "depth_limit": { "type": "integer", "minimum": 1 } } },
    "call_tree_available": { "type": "boolean" },
    "source_navigation": { "type": "object", "additionalProperties": false, "required": ["available", "disabled_reason_ref"], "properties": { "available": { "type": "boolean" }, "disabled_reason_ref": { "$ref": "#/$defs/ref" } } },
    "actions": { "type": "object", "additionalProperties": false, "required": ["export_available", "open_raw_available", "disabled_reason_refs"], "properties": { "export_available": { "type": "boolean" }, "open_raw_available": { "type": "boolean" }, "disabled_reason_refs": { "$ref": "#/$defs/ref_array" } } },
    "baseline": { "type": "object", "additionalProperties": false, "required": ["baseline_ref", "environment_state", "environment_delta_refs", "threshold_state", "waiver_ref", "confounder_refs"], "properties": { "baseline_ref": { "$ref": "#/$defs/ref" }, "environment_state": { "$ref": "#/$defs/baseline_environment_state" }, "environment_delta_refs": { "$ref": "#/$defs/ref_array" }, "threshold_state": { "$ref": "#/$defs/threshold_state" }, "waiver_ref": { "$ref": "#/$defs/ref" }, "confounder_refs": { "$ref": "#/$defs/ref_array" } } },
    "textual_fallback_ref": { "$ref": "#/$defs/ref" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" },
    "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
    "support_export_join": { "$ref": "#/$defs/support_export_join" },
    "auto_narrowing_contract": { "$ref": "#/$defs/auto_narrowing_contract" }
  },
  "allOf": [
    {
      "if": { "properties": { "record_kind": { "const": "m5_flamegraph_view" } } },
      "then": { "required": ["thread_process_filters", "total_samples", "total_time_ms", "metric_presentation", "zoom_state", "actions"] }
    }
  ],
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
    "consumer_surfaces": { "type": "array", "minItems": 1, "items": { "enum": ["desktop_profiler_workspace", "hotspot_workspace", "trace_viewer", "heap_analysis", "profile_compare", "review_workspace", "ai_context_panel", "incident_workspace", "support_export", "release_proof"] } },
    "artifact_origin": { "enum": ["live_capture", "replay_capture", "imported_artifact", "support_bundle", "cached_replay", "unknown"] },
    "mapping_quality": { "enum": ["exact", "symbolicated", "source_mapped", "partial", "heuristic", "missing", "not_applicable"] },
    "baseline_environment_state": { "enum": ["comparable", "comparable_with_deltas", "incomparable", "baseline_missing", "threshold_pending", "waived"] },
    "threshold_state": { "enum": ["not_applicable", "within_threshold", "regression", "improvement", "threshold_pending", "waived"] },
    "copy_export": { "type": "object", "additionalProperties": false, "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "minItems": 3, "items": { "enum": ["text", "json", "markdown"] } }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "type": "string" }, "json": { "type": "string" }, "markdown": { "type": "string" }, "screenshot_only_prohibited": { "const": true } } },
    "reduced_capability_banner": { "type": "object", "required": ["banner_id", "severity", "capability_state", "visible_label", "missing_capabilities", "preserved_fields"], "properties": { "banner_id": { "$ref": "#/$defs/ref" }, "severity": { "enum": ["info", "warning", "blocking"] }, "capability_state": { "enum": ["full", "read_only", "inspect_only", "compare_only", "export_only", "policy_blocked", "unavailable"] }, "visible_label": { "type": "string" }, "missing_capabilities": { "$ref": "#/$defs/ref_array" }, "preserved_fields": { "$ref": "#/$defs/ref_array" } } },
    "support_export_join": { "type": "object", "required": ["join_id", "schema_ref", "joined_object_kinds", "raw_profile_samples_exported", "raw_trace_events_exported", "gui_cli_support_label_parity"], "properties": { "join_id": { "$ref": "#/$defs/ref" }, "schema_ref": { "$ref": "#/$defs/ref" }, "joined_object_kinds": { "$ref": "#/$defs/ref_array" }, "raw_profile_samples_exported": { "const": false }, "raw_trace_events_exported": { "const": false }, "gui_cli_support_label_parity": { "const": true } } },
    "auto_narrowing_contract": { "type": "object", "required": ["narrow_on_missing_or_stale", "stale_or_missing_effect", "policy_blocked_effect", "degraded_state_reason_field", "release_help_claim_ceiling"], "properties": { "narrow_on_missing_or_stale": { "$ref": "#/$defs/ref_array" }, "stale_or_missing_effect": { "const": "narrow_claim" }, "policy_blocked_effect": { "enum": ["block_export_or_narrow_claim", "narrow_claim"] }, "degraded_state_reason_field": { "const": "narrowed_claim_reasons" }, "release_help_claim_ceiling": { "const": "available_evidence_only" } } }
  }
}
