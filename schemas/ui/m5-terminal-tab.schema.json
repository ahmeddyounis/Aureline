{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-terminal-tab.schema.json",
  "title": "Aureline M5 terminal-tab / header-strip primitive: session title, host boundary, shell-integration quality, cwd-or-transcript state, and shared control",
  "description": "Export-safe packet implementing Aureline's one reusable terminal-tab / header-strip primitive across every M5 terminal-console consumer — the terminal panel, the notebook console, the request console, the preview dev-server console, and the incident shell. Each console row binds the shared tab anatomy (session title, host-boundary badge, liveness state, shell-integration cue, cwd-or-transcript state, shared-control cue, reauthorization cue, and reconnect action), the derived input postures (write-capable-live, read-only-restored, read-only-reconnecting, inspect-only-observer, reauthorization-blocked, closed-no-input), the cwd display states, the shared-control postures, the export fields that let the support export reconstruct boundary and liveness truth, and the non-visual accessibility routes. The shell-integration quality, session-liveness state, host-boundary class, connection state, collaboration role, follow state, accessibility route, qualification class, and downgrade trigger vocabularies are reused verbatim from the frozen M5 runtime-boundary component matrix; the shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix. Each console carries worked resolution cases: a resolver input (session title, host boundary, shell integration, liveness, connection state, live-or-last-known cwd, and collaboration role / follow / reauthorization state) and the resolved input posture, cwd display state, and shared-control posture — the stored resolution must equal a fresh resolve of its input, so a restored transcript is never confused with a live write-capable shell. Hard invariants forbid masking the host / runtime boundary, conflating a live session with a restored one, inventing a private terminal grammar, and inferring shared-control state from background metadata. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary; session titles and cwds are carried only as opaque, export-safe representations. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "console_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_terminal_tab_and_header_strip_boundary_liveness_and_shared_control_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "console_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/console_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "console_surface": {
      "type": "string",
      "enum": [
        "terminal_panel",
        "notebook_console",
        "request_console",
        "preview_dev_server",
        "incident_shell"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "type": "string",
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "type": "string",
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "anatomy_part": {
      "type": "string",
      "enum": [
        "session_title",
        "host_boundary_badge",
        "liveness_state",
        "shell_integration_cue",
        "cwd_or_transcript_state",
        "shared_control_cue",
        "reauthorization_cue",
        "reconnect_action"
      ]
    },
    "input_posture": {
      "type": "string",
      "enum": [
        "write_capable_live",
        "read_only_restored",
        "read_only_reconnecting",
        "inspect_only_observer",
        "reauthorization_blocked",
        "closed_no_input"
      ]
    },
    "cwd_display_state": {
      "type": "string",
      "enum": [
        "live_cwd_reported",
        "last_known_cwd_shown",
        "cwd_unavailable",
        "cwd_not_reported_by_shell"
      ]
    },
    "shared_control_posture": {
      "type": "string",
      "enum": [
        "solo_session",
        "shared_control_held",
        "shared_observer_only",
        "shared_following_presenter",
        "reauthorization_required"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "session_title",
        "host_boundary",
        "shell_integration_quality",
        "liveness",
        "input_posture",
        "cwd_display_state",
        "shared_control_posture"
      ]
    },
    "shell_integration_quality": {
      "type": "string",
      "enum": [
        "fully_integrated",
        "command_marks_only",
        "cwd_reporting_only",
        "basic_pty_no_integration",
        "integration_degraded"
      ]
    },
    "session_liveness": {
      "type": "string",
      "enum": [
        "live_attached",
        "live_detached_running",
        "restored_from_transcript",
        "reconnecting",
        "closed_exited"
      ]
    },
    "host_boundary_class": {
      "type": "string",
      "enum": [
        "local_host",
        "remote_ssh_host",
        "container_host",
        "managed_workspace_host",
        "virtual_machine_host",
        "wasm_sandbox_host"
      ]
    },
    "connection_state": {
      "type": "string",
      "enum": ["connected", "connecting", "reconnecting", "disconnected", "offline_cached"]
    },
    "collaboration_role": {
      "type": "string",
      "enum": ["session_host", "collaborator", "presenter", "observer", "control_holder"]
    },
    "follow_state": {
      "type": "string",
      "enum": [
        "following_presenter",
        "being_followed",
        "not_following",
        "presenting_to_others",
        "follow_paused"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "shell_integration_quality_hidden",
        "session_liveness_ambiguous",
        "host_boundary_masked",
        "connection_state_stale",
        "runtime_source_unexplained",
        "toolchain_pin_conflict_hidden",
        "collaboration_role_masked",
        "follow_state_ambiguous",
        "repair_blast_radius_understated",
        "reversibility_overstated",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "resolution_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_title",
        "host_boundary",
        "shell_integration",
        "liveness",
        "reauthorization_required"
      ],
      "properties": {
        "session_title": { "$ref": "#/$defs/non_empty_string" },
        "host_boundary": { "$ref": "#/$defs/host_boundary_class" },
        "shell_integration": { "$ref": "#/$defs/shell_integration_quality" },
        "liveness": { "$ref": "#/$defs/session_liveness" },
        "connection_state": {
          "oneOf": [{ "$ref": "#/$defs/connection_state" }, { "type": "null" }]
        },
        "cwd_repr": { "type": ["string", "null"] },
        "last_known_cwd_repr": { "type": ["string", "null"] },
        "collaboration_role": {
          "oneOf": [{ "$ref": "#/$defs/collaboration_role" }, { "type": "null" }]
        },
        "follow_state": {
          "oneOf": [{ "$ref": "#/$defs/follow_state" }, { "type": "null" }]
        },
        "reauthorization_required": { "type": "boolean" }
      }
    },
    "resolved_tab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_title",
        "host_boundary",
        "boundary_is_local",
        "shell_integration",
        "liveness",
        "is_restored_transcript",
        "input_posture",
        "is_write_capable",
        "cwd_display",
        "shared_control_posture",
        "requires_reauthorization"
      ],
      "properties": {
        "session_title": { "$ref": "#/$defs/non_empty_string" },
        "host_boundary": { "$ref": "#/$defs/host_boundary_class" },
        "boundary_is_local": { "type": "boolean" },
        "connection_state": {
          "oneOf": [{ "$ref": "#/$defs/connection_state" }, { "type": "null" }]
        },
        "shell_integration": { "$ref": "#/$defs/shell_integration_quality" },
        "liveness": { "$ref": "#/$defs/session_liveness" },
        "is_restored_transcript": { "type": "boolean" },
        "input_posture": { "$ref": "#/$defs/input_posture" },
        "is_write_capable": { "type": "boolean" },
        "cwd_display": { "$ref": "#/$defs/cwd_display_state" },
        "cwd_repr": { "type": ["string", "null"] },
        "collaboration_role": {
          "oneOf": [{ "$ref": "#/$defs/collaboration_role" }, { "type": "null" }]
        },
        "follow_state": {
          "oneOf": [{ "$ref": "#/$defs/follow_state" }, { "type": "null" }]
        },
        "shared_control_posture": { "$ref": "#/$defs/shared_control_posture" },
        "requires_reauthorization": { "type": "boolean" }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/resolution_input" },
        "resolved": { "$ref": "#/$defs/resolved_tab" }
      }
    },
    "console_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "console_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "anatomy_parts",
        "input_postures",
        "cwd_display_states",
        "shared_control_postures",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "masks_host_or_runtime_boundary",
        "conflates_live_and_restored_session",
        "invents_private_terminal_grammar",
        "infers_shared_control_from_background_metadata"
      ],
      "properties": {
        "console_surface": { "$ref": "#/$defs/console_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "anatomy_parts": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/anatomy_part" }
        },
        "input_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/input_posture" }
        },
        "cwd_display_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cwd_display_state" }
        },
        "shared_control_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shared_control_posture" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "masks_host_or_runtime_boundary": { "const": false },
        "conflates_live_and_restored_session": { "const": false },
        "invents_private_terminal_grammar": { "const": false },
        "infers_shared_control_from_background_metadata": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "console_surfaces",
        "anatomy_parts",
        "input_postures",
        "cwd_display_states",
        "shared_control_postures",
        "export_fields",
        "shell_integration_qualities",
        "session_liveness_states",
        "host_boundary_classes",
        "connection_states",
        "collaboration_roles",
        "follow_states",
        "accessibility_routes"
      ],
      "properties": {
        "console_surfaces": { "type": "array", "items": { "$ref": "#/$defs/console_surface" } },
        "anatomy_parts": { "type": "array", "items": { "$ref": "#/$defs/anatomy_part" } },
        "input_postures": { "type": "array", "items": { "$ref": "#/$defs/input_posture" } },
        "cwd_display_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/cwd_display_state" }
        },
        "shared_control_postures": {
          "type": "array",
          "items": { "$ref": "#/$defs/shared_control_posture" }
        },
        "export_fields": { "type": "array", "items": { "$ref": "#/$defs/export_field" } },
        "shell_integration_qualities": {
          "type": "array",
          "items": { "$ref": "#/$defs/shell_integration_quality" }
        },
        "session_liveness_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/session_liveness" }
        },
        "host_boundary_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/host_boundary_class" }
        },
        "connection_states": { "type": "array", "items": { "$ref": "#/$defs/connection_state" } },
        "collaboration_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/collaboration_role" }
        },
        "follow_states": { "type": "array", "items": { "$ref": "#/$defs/follow_state" } },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_boundary_and_liveness",
        "session_title_and_host_boundary_always_shown",
        "live_versus_restored_never_conflated",
        "restored_transcript_never_write_capable",
        "cwd_or_last_known_cwd_always_disclosed",
        "shared_control_and_reauthorization_always_explicit",
        "support_export_reconstructs_boundary_truth",
        "no_surface_invents_second_terminal_grammar",
        "every_row_bound_to_shell_zone",
        "every_row_declares_accessibility_route",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_boundary_and_liveness": { "const": true },
        "session_title_and_host_boundary_always_shown": { "const": true },
        "live_versus_restored_never_conflated": { "const": true },
        "restored_transcript_never_write_capable": { "const": true },
        "cwd_or_last_known_cwd_always_disclosed": { "const": true },
        "shared_control_and_reauthorization_always_explicit": { "const": true },
        "support_export_reconstructs_boundary_truth": { "const": true },
        "no_surface_invents_second_terminal_grammar": { "const": true },
        "every_row_bound_to_shell_zone": { "const": true },
        "every_row_declares_accessibility_route": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_console_surfaces_consume_shared_primitive",
        "liveness_resolver_reads_single_source",
        "shared_control_reads_single_collaboration_source",
        "boundary_badge_reads_single_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "terminal_console_surfaces_consume_shared_primitive": { "const": true },
        "liveness_resolver_reads_single_source": { "const": true },
        "shared_control_reads_single_collaboration_source": { "const": true },
        "boundary_badge_reads_single_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "terminal_tab_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "terminal_tab_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
