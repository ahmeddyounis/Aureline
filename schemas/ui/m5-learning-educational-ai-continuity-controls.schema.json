{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-learning-educational-ai-continuity-controls.schema.json",
  "title": "Aureline M5 learning educational-AI continuity controls",
  "description": "Export-safe packet governing the degraded and disconnected states of every reusable M5 learning component across claimed guided-teaching surfaces. Each component binds one governed component family, the subject it teaches, a preserved last-known subject summary, a stable component identity, its learning scope, and one controlled continuity state (live, cached, local-only, offline, stale-pack, citation-unavailable, or not-installed). Its data-trust class and its next-safe-action are derived from that continuity state, so a cached, local-only, offline, or stale component can never read as live and the copy that tells the learner what to do next is never invented per component. A component whose enrichment is degraded but whose cited source is still reachable (cached, local-only, offline, stale-pack) names a source fallback and offers a resolvable cited source, so learning stays useful offline; a component whose citation is unavailable or whose pack is not installed degrades to an explicit uncited / not-installed state and stops routing to a cited source it does not have. The educational-AI apply posture is an independent axis whose apply disposition and live-mutation flag are derived, so no component implies a hidden apply and none mutates live state without crossing the ordinary preview / approval path. No control masks its privacy / offline state, hides its cited source, invents an alternate state label, or implies a hidden apply; raw private payloads, progress bodies, secret values, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "components",
    "downgrade_triggers",
    "consumer_surfaces",
    "glance_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "learning_educational_ai_continuity_controls" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/degraded_component" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "glance_review": { "$ref": "#/$defs/glance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "component_family": {
      "type": "string",
      "enum": [
        "learning_mode_toggle",
        "tip_card",
        "guided_exercise_step",
        "glossary_chip_or_card",
        "safe_explanation_banner",
        "progress_marker"
      ]
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "concept",
        "command",
        "file_or_symbol",
        "docs_topic",
        "exercise_task",
        "progress_record"
      ]
    },
    "learning_scope": {
      "type": "string",
      "enum": ["global", "workspace", "feature_family", "session", "surface", "unavailable"]
    },
    "continuity_state": {
      "type": "string",
      "enum": [
        "live",
        "cached",
        "local_only",
        "offline",
        "stale_pack",
        "citation_unavailable",
        "not_installed"
      ]
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "live_enriched",
        "cached_pack",
        "local_only_bounded",
        "offline_held",
        "stale_unverified",
        "uncited_withheld",
        "not_installed_unavailable"
      ]
    },
    "next_safe_action": {
      "type": "string",
      "enum": [
        "proceed_in_learning",
        "refresh_enrichment",
        "continue_local_only",
        "retry_when_online",
        "update_docs_pack",
        "show_uncited_explicitly",
        "install_to_enable"
      ]
    },
    "apply_posture": {
      "type": "string",
      "enum": ["explain_only", "sandboxed_practice", "preview_then_approve", "apply_blocked"]
    },
    "apply_disposition": {
      "type": "string",
      "enum": [
        "no_mutation",
        "sandbox_mutation_only",
        "preview_approval_required",
        "mutation_unavailable"
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "file_location",
        "symbol_location",
        "docs_page",
        "command_reference",
        "sandbox_target",
        "no_source"
      ]
    },
    "safe_verb": {
      "type": "string",
      "enum": [
        "explain",
        "open_source",
        "practice_in_sandbox",
        "refresh",
        "copy_reference",
        "dismiss"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "learning_on",
        "paused",
        "replayable",
        "sandboxed",
        "cached",
        "local_only",
        "not_installed",
        "no_hidden_apply"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "citation_source",
        "explain_versus_do_boundary",
        "progress_ownership_and_privacy"
      ]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "first_run_onboarding",
        "guided_tour",
        "learning_mode_panel",
        "glossary_surface",
        "inline_help",
        "cli_help"
      ]
    },
    "deployment_line": {
      "type": "string",
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "onboarding_ui",
        "tour_overlay_ui",
        "learning_panel_ui",
        "glossary_ui",
        "exercise_ui",
        "help_panel_ui",
        "cli_help",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "learning_mode_state_unstated",
        "tip_command_binding_unstated",
        "exercise_step_state_unstated",
        "glossary_citation_severed",
        "explanation_apply_boundary_unstated",
        "progress_ownership_unstated",
        "offline_or_local_only_state_hidden",
        "sandbox_boundary_unstated",
        "cached_state_hidden",
        "not_installed_state_hidden",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "disposition_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/disposition" }
    },
    "required_label_array": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/required_label" },
      "allOf": [
        { "contains": { "const": "identity" } },
        { "contains": { "const": "state" } },
        { "contains": { "const": "keyboard_route" } }
      ]
    },
    "accessibility_route_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessibility_route" },
      "contains": { "const": "keyboard_focusable" }
    },
    "degraded_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "component_id",
        "component_title",
        "subject_kind",
        "subject_label",
        "subject_summary_note",
        "cited_source_ref",
        "stable_component_ref",
        "learning_scope",
        "scope_label",
        "continuity_state",
        "trust_class",
        "claims_live_enrichment",
        "continuity_note",
        "state_explanation_note",
        "next_safe_action",
        "next_safe_action_note",
        "source_fallback_note",
        "source_kind",
        "source_label",
        "apply_posture",
        "apply_disposition",
        "offers_live_mutation",
        "apply_boundary_note",
        "safe_verbs",
        "dispositions",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "masks_privacy_or_offline_state",
        "hides_citation_source",
        "invents_alternate_state_label",
        "implies_hidden_apply_or_mutation",
        "mutates_live_without_preview_approval"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "component_id": { "$ref": "#/$defs/non_empty_string" },
        "component_title": { "$ref": "#/$defs/non_empty_string" },
        "subject_kind": { "$ref": "#/$defs/subject_kind" },
        "subject_label": { "$ref": "#/$defs/non_empty_string" },
        "subject_summary_note": { "$ref": "#/$defs/non_empty_string" },
        "cited_source_ref": { "type": "string" },
        "stable_component_ref": { "$ref": "#/$defs/non_empty_string" },
        "learning_scope": { "$ref": "#/$defs/learning_scope" },
        "scope_label": { "$ref": "#/$defs/non_empty_string" },
        "continuity_state": { "$ref": "#/$defs/continuity_state" },
        "trust_class": { "$ref": "#/$defs/trust_class" },
        "claims_live_enrichment": { "type": "boolean" },
        "continuity_note": { "$ref": "#/$defs/non_empty_string" },
        "state_explanation_note": { "type": "string" },
        "next_safe_action": { "$ref": "#/$defs/next_safe_action" },
        "next_safe_action_note": { "$ref": "#/$defs/non_empty_string" },
        "source_fallback_note": { "type": "string" },
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "source_label": { "$ref": "#/$defs/non_empty_string" },
        "apply_posture": { "$ref": "#/$defs/apply_posture" },
        "apply_disposition": { "$ref": "#/$defs/apply_disposition" },
        "offers_live_mutation": { "type": "boolean" },
        "apply_boundary_note": { "$ref": "#/$defs/non_empty_string" },
        "safe_verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/safe_verb" },
          "contains": { "const": "explain" }
        },
        "dispositions": { "$ref": "#/$defs/disposition_array" },
        "required_labels": { "$ref": "#/$defs/required_label_array" },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": { "$ref": "#/$defs/accessibility_route_array" },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": { "$ref": "#/$defs/non_empty_string_array" },
        "source_contract_refs": { "$ref": "#/$defs/non_empty_string_array" },
        "masks_privacy_or_offline_state": { "const": false },
        "hides_citation_source": { "const": false },
        "invents_alternate_state_label": { "const": false },
        "implies_hidden_apply_or_mutation": { "const": false },
        "mutates_live_without_preview_approval": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "continuity_state": { "const": "live" } },
            "required": ["continuity_state"]
          },
          "then": {
            "properties": { "claims_live_enrichment": { "const": true } },
            "required": ["claims_live_enrichment"]
          },
          "else": {
            "properties": {
              "claims_live_enrichment": { "const": false },
              "state_explanation_note": { "$ref": "#/$defs/non_empty_string" }
            },
            "required": ["claims_live_enrichment"]
          }
        },
        {
          "if": {
            "properties": {
              "continuity_state": {
                "enum": ["cached", "local_only", "offline", "stale_pack"]
              }
            },
            "required": ["continuity_state"]
          },
          "then": {
            "properties": {
              "cited_source_ref": { "$ref": "#/$defs/non_empty_string" },
              "source_fallback_note": { "$ref": "#/$defs/non_empty_string" },
              "safe_verbs": { "contains": { "const": "open_source" } },
              "source_kind": { "not": { "const": "no_source" } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "continuity_state": { "enum": ["citation_unavailable", "not_installed"] }
            },
            "required": ["continuity_state"]
          },
          "then": {
            "properties": {
              "cited_source_ref": { "const": "" },
              "source_kind": { "const": "no_source" },
              "safe_verbs": { "not": { "contains": { "const": "open_source" } } }
            }
          }
        },
        {
          "if": {
            "properties": { "apply_posture": { "const": "explain_only" } },
            "required": ["apply_posture"]
          },
          "then": {
            "properties": {
              "apply_disposition": { "const": "no_mutation" },
              "offers_live_mutation": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": { "apply_posture": { "const": "sandboxed_practice" } },
            "required": ["apply_posture"]
          },
          "then": {
            "properties": {
              "apply_disposition": { "const": "sandbox_mutation_only" },
              "offers_live_mutation": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": { "apply_posture": { "const": "preview_then_approve" } },
            "required": ["apply_posture"]
          },
          "then": {
            "properties": {
              "apply_disposition": { "const": "preview_approval_required" },
              "offers_live_mutation": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": { "apply_posture": { "const": "apply_blocked" } },
            "required": ["apply_posture"]
          },
          "then": {
            "properties": {
              "apply_disposition": { "const": "mutation_unavailable" },
              "offers_live_mutation": { "const": false }
            }
          }
        }
      ]
    },
    "glance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_component_names_subject_summary_and_identity",
        "every_component_states_its_continuity",
        "every_component_states_next_safe_action",
        "degraded_state_is_explicit_before_action",
        "live_cached_local_only_not_installed_distinguishable",
        "cached_or_stale_never_shown_as_live",
        "trust_class_derived_never_asserted",
        "learning_stays_useful_offline",
        "educational_ai_never_mutates_live_without_preview_approval",
        "no_component_implies_hidden_apply",
        "not_installed_or_uncited_state_stops_source_routing",
        "every_reachable_state_names_a_cited_or_cached_source",
        "subject_identity_always_explicit",
        "learning_scope_always_explicit",
        "no_component_invents_alternate_state_label",
        "controls_stable_across_deployment_lines",
        "copy_and_export_safe",
        "downgrade_narrows_instead_of_hides"
      ],
      "properties": {
        "every_component_names_subject_summary_and_identity": { "const": true },
        "every_component_states_its_continuity": { "const": true },
        "every_component_states_next_safe_action": { "const": true },
        "degraded_state_is_explicit_before_action": { "const": true },
        "live_cached_local_only_not_installed_distinguishable": { "const": true },
        "cached_or_stale_never_shown_as_live": { "const": true },
        "trust_class_derived_never_asserted": { "const": true },
        "learning_stays_useful_offline": { "const": true },
        "educational_ai_never_mutates_live_without_preview_approval": { "const": true },
        "no_component_implies_hidden_apply": { "const": true },
        "not_installed_or_uncited_state_stops_source_routing": { "const": true },
        "every_reachable_state_names_a_cited_or_cached_source": { "const": true },
        "subject_identity_always_explicit": { "const": true },
        "learning_scope_always_explicit": { "const": true },
        "no_component_invents_alternate_state_label": { "const": true },
        "controls_stable_across_deployment_lines": { "const": true },
        "copy_and_export_safe": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_surfaces_read_single_source",
        "help_surfaces_read_single_source",
        "first_glance_names_state_scope_and_citation",
        "next_safe_action_visible_before_action",
        "support_export_shows_control_truth",
        "help_about_shows_control_truth"
      ],
      "properties": {
        "learning_surfaces_read_single_source": { "const": true },
        "help_surfaces_read_single_source": { "const": true },
        "first_glance_names_state_scope_and_citation": { "const": true },
        "next_safe_action_visible_before_action": { "const": true },
        "support_export_shows_control_truth": { "const": true },
        "help_about_shows_control_truth": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "format": "date-time" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
