{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-scaffold-template-card-starter-parameter-row-controls.schema.json",
  "title": "Aureline M5 scaffold template cards and starter parameter rows",
  "description": "Export-safe packet implementing the reusable M5 scaffold-template-card and starter-parameter-row components in two co-equal control vectors. Each template card names its template name and version, its starter source class, its template support class, its target runtime and toolchain, its host boundary, and its setup-task or extension impact, and offers a first-class open-manifest action; its source class and support posture are derived from the frozen classes, so a community, local, mirrored, or unknown starter can never read as a governed first-party starter and bridge or heuristic behavior can never read as exact first-party support before a user commits. Each parameter row names its parameter name and type, its required/optional state, its source-precedence origin class (Template default, User input, Workspace value, Policy value, or Secret reference), its frozen source layer, its action timing, and its validation state, and offers inspect/review actions; its portability class is derived from the origin class, so a workspace-scoped or policy-managed value can never read as a portable user value and a secret reference never reveals a raw secret value. Every next step names one stable manifest/registry/docs/policy deep link rather than an ephemeral overlay or hidden route. No component hides its starter source or support class, hides a side effect behind a generic Create or leaves the host boundary unstated, exposes a raw secret or file body by default, or invents an alternate state label; raw file bodies, raw secret values, pasted local paths, repository URLs, credentials, and secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "template_cards",
    "parameter_rows",
    "downgrade_triggers",
    "consumer_surfaces",
    "scaffold_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_scaffold_template_cards_and_starter_parameter_rows_with_source_support_host_boundary_and_portability_truth_across_claimed_m5_project_entry_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "template_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scaffold_template_card" }
    },
    "parameter_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/starter_parameter_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "scaffold_review": { "$ref": "#/$defs/scaffold_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "starter_source_class": {
      "enum": [
        "first_party_starter",
        "team_managed_starter",
        "community_starter",
        "local_only_starter",
        "mirrored_starter",
        "unknown_source_starter"
      ]
    },
    "template_support_class": {
      "enum": [
        "officially_supported",
        "community_supported",
        "experimental",
        "bridge_behavior",
        "deprecated",
        "unsupported"
      ]
    },
    "derived_source_class": {
      "enum": [
        "first_party_template",
        "team_managed_template",
        "community_template",
        "local_template",
        "source_unknown"
      ]
    },
    "support_posture": {
      "enum": [
        "fully_supported",
        "community_supported",
        "experimental_or_bridge",
        "unsupported_or_deprecated"
      ]
    },
    "parameter_source_layer": {
      "enum": [
        "default_value",
        "user_provided",
        "profile_inherited",
        "environment_derived",
        "computed_derived",
        "unset_required"
      ]
    },
    "parameter_action_timing": {
      "enum": [
        "applied_immediately",
        "deferred_after_create",
        "requires_confirmation",
        "blocked_invalid",
        "optional_skippable",
        "not_applicable"
      ]
    },
    "origin_class": {
      "enum": [
        "template_default",
        "user_input",
        "workspace_value",
        "policy_value",
        "secret_reference"
      ]
    },
    "portability_class": {
      "enum": [
        "portable_template_value",
        "portable_user_value",
        "workspace_scoped_value",
        "policy_managed_value",
        "secret_reference_not_persisted"
      ]
    },
    "requirement": {
      "enum": ["required", "optional", "conditionally_required"]
    },
    "validation_state": {
      "enum": ["valid", "invalid", "unvalidated", "pending", "not_applicable"]
    },
    "deep_link_kind": {
      "enum": [
        "template_manifest",
        "starter_registry_entry",
        "docs_anchor",
        "policy_reference",
        "no_deep_link"
      ]
    },
    "template_card_action": {
      "enum": [
        "open_manifest",
        "inspect_source_and_support",
        "review_host_boundary",
        "start_from_template",
        "open_deep_link",
        "copy_template_id"
      ]
    },
    "parameter_row_action": {
      "enum": [
        "inspect_source",
        "review_validation",
        "edit_value",
        "reset_to_template_default",
        "open_secret_reference",
        "open_deep_link"
      ]
    },
    "disposition": {
      "enum": [
        "first_party",
        "team_managed",
        "community",
        "local_only",
        "create_empty",
        "continue_without_starter",
        "blocked",
        "warning",
        "optional"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "starter_source_and_support",
        "side_effect_disclosure",
        "recovery_and_ownership_boundary"
      ]
    },
    "surface_family": {
      "enum": [
        "start_center",
        "template_gallery",
        "scaffold_preflight",
        "generation_diff_review",
        "workspace_handoff",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "start_center_ui",
        "template_gallery_ui",
        "parameter_form_ui",
        "preflight_ui",
        "diff_review_ui",
        "workspace_ui",
        "health_dashboard_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "starter_source_unstated",
        "support_class_unstated",
        "side_effect_undisclosed",
        "host_boundary_unstated",
        "parameter_source_unstated",
        "action_timing_unstated",
        "impact_undisclosed",
        "health_freshness_stale",
        "generated_boundary_blurred",
        "recovery_path_omitted",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "scaffold_template_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "template_id",
        "template_name",
        "template_version",
        "source_class",
        "support_class",
        "derived_source_class",
        "derived_support_posture",
        "claims_governed_first_party",
        "claims_exact_first_party_support",
        "community_source_note",
        "local_source_note",
        "unknown_source_note",
        "nonexact_support_note",
        "source_and_support_note",
        "target_runtime_label",
        "toolchain_label",
        "host_boundary_label",
        "setup_task_or_extension_impact_label",
        "manifest_ref",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_starter_source_or_support_class",
        "hides_side_effect_or_host_boundary",
        "exposes_secret_or_raw_value_by_default",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "scaffold_template_card" },
        "template_id": { "$ref": "#/$defs/non_empty_string" },
        "template_name": { "$ref": "#/$defs/non_empty_string" },
        "template_version": { "$ref": "#/$defs/non_empty_string" },
        "source_class": { "$ref": "#/$defs/starter_source_class" },
        "support_class": { "$ref": "#/$defs/template_support_class" },
        "derived_source_class": { "$ref": "#/$defs/derived_source_class" },
        "derived_support_posture": { "$ref": "#/$defs/support_posture" },
        "claims_governed_first_party": { "type": "boolean" },
        "claims_exact_first_party_support": { "type": "boolean" },
        "community_source_note": { "type": "string" },
        "local_source_note": { "type": "string" },
        "unknown_source_note": { "type": "string" },
        "nonexact_support_note": { "type": "string" },
        "source_and_support_note": { "$ref": "#/$defs/non_empty_string" },
        "target_runtime_label": { "$ref": "#/$defs/non_empty_string" },
        "toolchain_label": { "$ref": "#/$defs/non_empty_string" },
        "host_boundary_label": { "$ref": "#/$defs/non_empty_string" },
        "setup_task_or_extension_impact_label": { "$ref": "#/$defs/non_empty_string" },
        "manifest_ref": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_manifest" } },
            { "contains": { "const": "inspect_source_and_support" } },
            { "contains": { "const": "review_host_boundary" } }
          ],
          "items": { "$ref": "#/$defs/template_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_starter_source_or_support_class": { "const": false },
        "hides_side_effect_or_host_boundary": { "const": false },
        "exposes_secret_or_raw_value_by_default": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "starter_parameter_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "parameter_id",
        "parameter_name",
        "parameter_type_label",
        "requirement",
        "source_layer",
        "origin_class",
        "action_timing",
        "validation_state",
        "derived_portability_class",
        "claims_portable",
        "secret_reference_note",
        "local_only_note",
        "confirmation_note",
        "blocked_note",
        "source_and_precedence_note",
        "persistence_or_portability_note",
        "value_display_label",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "row_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_starter_source_or_support_class",
        "hides_side_effect_or_host_boundary",
        "exposes_secret_or_raw_value_by_default",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "starter_parameter_row" },
        "parameter_id": { "$ref": "#/$defs/non_empty_string" },
        "parameter_name": { "$ref": "#/$defs/non_empty_string" },
        "parameter_type_label": { "$ref": "#/$defs/non_empty_string" },
        "requirement": { "$ref": "#/$defs/requirement" },
        "source_layer": { "$ref": "#/$defs/parameter_source_layer" },
        "origin_class": { "$ref": "#/$defs/origin_class" },
        "action_timing": { "$ref": "#/$defs/parameter_action_timing" },
        "validation_state": { "$ref": "#/$defs/validation_state" },
        "derived_portability_class": { "$ref": "#/$defs/portability_class" },
        "claims_portable": { "type": "boolean" },
        "secret_reference_note": { "type": "string" },
        "local_only_note": { "type": "string" },
        "confirmation_note": { "type": "string" },
        "blocked_note": { "type": "string" },
        "source_and_precedence_note": { "$ref": "#/$defs/non_empty_string" },
        "persistence_or_portability_note": { "$ref": "#/$defs/non_empty_string" },
        "value_display_label": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "row_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "inspect_source" } },
            { "contains": { "const": "review_validation" } }
          ],
          "items": { "$ref": "#/$defs/parameter_row_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_starter_source_or_support_class": { "const": false },
        "hides_side_effect_or_host_boundary": { "const": false },
        "exposes_secret_or_raw_value_by_default": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "scaffold_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_card_shows_source_and_support",
        "template_card_shows_host_boundary",
        "template_card_offers_open_manifest",
        "parameter_row_shows_source_precedence",
        "parameter_row_shows_validation_and_timing",
        "parameter_row_offers_inspect_and_review",
        "source_support_and_portability_derived_never_asserted",
        "nonfirst_party_never_shown_as_governed_first_party",
        "bridge_never_shown_as_exact_first_party_support",
        "secret_reference_never_reveals_raw_value",
        "create_never_generic_hides_side_effects",
        "every_next_step_names_stable_deep_link",
        "persistence_and_portability_always_explicit",
        "host_boundary_always_visible",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_center_reads_single_source",
        "template_gallery_reads_single_source",
        "parameter_form_reads_single_source",
        "source_and_support_visible_before_commit",
        "parameter_precedence_visible_before_commit",
        "support_export_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
