{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-presence-avatar-stack.schema.json",
  "title": "M5 Presence Avatar Stack and Role-or-Follow Badge Primitive Packet",
  "description": "Export-safe support packet for the reusable M5 presence-avatar-stack / role-or-follow-badge primitive: one row per claimed M5 collaboration surface binding the shared avatar-stack anatomy, role-or-follow badge anatomy, collaboration roles, follow states, participant liveness, link states, continuity postures, recording-or-retention cues, actions, export fields, and non-visual accessibility routes, plus worked resolution cases that reconstruct presence from one shared model. This packet schema overrides the per-fragment schema suggestions in the source set; the companion role-or-follow badge component fragment is schemas/ui/m5-role-follow-badge.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_presence_avatar_stack_and_role_or_follow_badge_recording_state_and_local_fallback_continuity_primitive"
    },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/definitions/consumer_row" }
    },
    "vocabulary_set": { "$ref": "#/definitions/vocabulary_set" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "presence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "presence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "type": "boolean" },
        "accessibility_parity_required": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "collaboration_role": {
      "enum": [
        "session_host",
        "collaborator",
        "presenter",
        "observer",
        "control_holder"
      ]
    },
    "follow_state": {
      "enum": [
        "following_presenter",
        "being_followed",
        "not_following",
        "presenting_to_others",
        "follow_paused"
      ]
    },
    "participant_liveness": {
      "enum": ["active", "idle", "reconnecting", "departed", "last_known_local"]
    },
    "link_state": {
      "enum": [
        "live",
        "degraded",
        "reconnecting",
        "offline_local_fallback",
        "session_ended"
      ]
    },
    "continuity_posture": {
      "enum": [
        "live",
        "degraded_visible",
        "reconnecting_visible",
        "local_fallback_visible",
        "ended_last_known_visible"
      ]
    },
    "recording_cue": {
      "enum": [
        "not_applicable",
        "recording",
        "retained",
        "retention_pending",
        "not_recorded"
      ]
    },
    "stack_part": {
      "enum": [
        "avatar_stack",
        "participant_identity",
        "role_badge",
        "follow_state_badge",
        "recording_retention_cue",
        "overflow_count",
        "text_participant_list"
      ]
    },
    "badge_part": {
      "enum": [
        "role_label",
        "follow_label",
        "presenter_marker",
        "control_holder_marker",
        "self_marker"
      ]
    },
    "presence_action": {
      "enum": [
        "view_participant_list",
        "follow_presenter",
        "stop_following",
        "reconnect_collaboration"
      ]
    },
    "export_field": {
      "enum": [
        "session_identity",
        "participant_identity",
        "participant_role",
        "follow_state",
        "presenter_identity",
        "control_holder_identity",
        "continuity_posture",
        "recording_retention_cue",
        "participant_liveness",
        "present_count",
        "available_actions"
      ]
    },
    "consumer_surface": {
      "enum": [
        "collaboration_strip",
        "shared_terminal_header",
        "shared_debug_pane",
        "review_session_header",
        "presenter_hud",
        "follow_mode_banner",
        "session_roster_panel",
        "activity_center_presence",
        "shared_preview_header"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surfaces",
        "stack_parts",
        "badge_parts",
        "participant_liveness_states",
        "link_states",
        "continuity_postures",
        "recording_cues",
        "presence_actions",
        "export_fields",
        "collaboration_roles",
        "follow_states",
        "accessibility_routes"
      ],
      "properties": {
        "consumer_surfaces": { "type": "array", "items": { "type": "string" } },
        "stack_parts": { "type": "array", "items": { "type": "string" } },
        "badge_parts": { "type": "array", "items": { "type": "string" } },
        "participant_liveness_states": { "type": "array", "items": { "type": "string" } },
        "link_states": { "type": "array", "items": { "type": "string" } },
        "continuity_postures": { "type": "array", "items": { "type": "string" } },
        "recording_cues": { "type": "array", "items": { "type": "string" } },
        "presence_actions": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "collaboration_roles": { "type": "array", "items": { "type": "string" } },
        "follow_states": { "type": "array", "items": { "type": "string" } },
        "accessibility_routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_repr", "role", "follow_state", "liveness", "is_self"],
      "properties": {
        "participant_repr": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/definitions/collaboration_role" },
        "follow_state": { "$ref": "#/definitions/follow_state" },
        "liveness": { "$ref": "#/definitions/participant_liveness" },
        "is_self": { "type": "boolean" }
      }
    },
    "ranked_participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_repr",
        "role",
        "follow_state",
        "liveness",
        "is_self",
        "is_presenter",
        "is_control_holder",
        "is_present",
        "salience_rank"
      ],
      "properties": {
        "participant_repr": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/definitions/collaboration_role" },
        "follow_state": { "$ref": "#/definitions/follow_state" },
        "liveness": { "$ref": "#/definitions/participant_liveness" },
        "is_self": { "type": "boolean" },
        "is_presenter": { "type": "boolean" },
        "is_control_holder": { "type": "boolean" },
        "is_present": { "type": "boolean" },
        "salience_rank": { "type": "integer", "minimum": 0 }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_title", "participants", "link_state", "recording_cue"],
          "properties": {
            "session_title": { "type": "string", "minLength": 1 },
            "participants": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/participant" }
            },
            "link_state": { "$ref": "#/definitions/link_state" },
            "recording_cue": { "$ref": "#/definitions/recording_cue" }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_title",
            "ordered_participants",
            "presenter_repr",
            "control_holder_repr",
            "current_view_being_followed",
            "self_is_following_presenter",
            "link_state",
            "continuity_posture",
            "collaboration_remains_visible",
            "recording_cue",
            "present_count",
            "roster_count",
            "available_actions",
            "non_avatar_reachable"
          ],
          "properties": {
            "session_title": { "type": "string", "minLength": 1 },
            "ordered_participants": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/ranked_participant" }
            },
            "presenter_repr": { "type": ["string", "null"] },
            "control_holder_repr": { "type": ["string", "null"] },
            "current_view_being_followed": { "type": "boolean" },
            "self_is_following_presenter": { "type": "boolean" },
            "link_state": { "$ref": "#/definitions/link_state" },
            "continuity_posture": { "$ref": "#/definitions/continuity_posture" },
            "collaboration_remains_visible": { "type": "boolean" },
            "recording_cue": { "$ref": "#/definitions/recording_cue" },
            "present_count": { "type": "integer", "minimum": 0 },
            "roster_count": { "type": "integer", "minimum": 1 },
            "available_actions": {
              "type": "array",
              "items": { "$ref": "#/definitions/presence_action" }
            },
            "non_avatar_reachable": { "type": "boolean" }
          }
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "stack_parts",
        "badge_parts",
        "collaboration_roles",
        "follow_states",
        "participant_liveness_states",
        "link_states",
        "continuity_postures",
        "recording_cues",
        "presence_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_resolutions",
        "masks_collaboration_role",
        "leaves_follow_state_ambiguous",
        "relies_on_avatar_imagery_alone",
        "drops_presence_when_degraded"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/definitions/consumer_surface" },
        "qualification": { "$ref": "#/definitions/qualification" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "shell_zone_slot": { "type": "string", "minLength": 1 },
        "responsive_classes": { "type": "array", "items": { "type": "string" } },
        "window_classes": { "type": "array", "items": { "type": "string" } },
        "stack_parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/stack_part" }
        },
        "badge_parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/badge_part" }
        },
        "collaboration_roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/collaboration_role" }
        },
        "follow_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/follow_state" }
        },
        "participant_liveness_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/participant_liveness" }
        },
        "link_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/link_state" }
        },
        "continuity_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/continuity_posture" }
        },
        "recording_cues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/recording_cue" }
        },
        "presence_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/presence_action" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/resolution_case" }
        },
        "masks_collaboration_role": { "const": false },
        "leaves_follow_state_ambiguous": { "const": false },
        "relies_on_avatar_imagery_alone": { "const": false },
        "drops_presence_when_degraded": { "const": false }
      }
    }
  }
}
