{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-provider-account-row.schema.json",
  "title": "Aureline M5 provider-account-row primitive",
  "description": "Export-safe packet implementing the reusable M5 provider-account row as one primitive. The packet binds one row per claimed provider surface consumer — the account-settings panel, the provider status bar, the connection picker, the headless/CLI accounts surface, and the support account export — to the shared account-row anatomy, the derived row posture (not-configured/signed-in/limited-scope/stale-session/offline-cached-read/policy-blocked), the provider identity classes, the account connection states, the tenant scopes, the effective write scopes, the token/session freshness, the derived access capability (can-read-and-write/can-read-write-limited/can-read-only-live/cached-inspect-only/no-access), bounded reveal-scope/sign-in/retry/remove/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks its connection state or write scope, never collapses the six connection states into one generic connected label, never renders a cached-only read with live certainty, and never forces blind credential re-entry. Raw comment bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_provider_account_rows_with_signed_in_limited_scope_stale_session_offline_cached_policy_blocked_truth_and_sign_in_retry_remove_parity_across_claimed_m5_provider_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "provider_account_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "provider_account_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "identity_classes",
        "connection_states",
        "tenant_scopes",
        "write_scopes",
        "session_freshness_states",
        "row_postures",
        "access_capabilities",
        "row_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "account_examples",
        "masks_connection_or_scope",
        "collapses_states_into_generic_connected",
        "overstates_cached_as_live",
        "forces_blind_credential_reentry"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "account_settings_panel",
            "provider_status_bar",
            "connection_picker",
            "headless_cli_accounts",
            "support_account_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "identity_classes": { "type": "array", "minItems": 1 },
        "connection_states": { "type": "array", "minItems": 1 },
        "tenant_scopes": { "type": "array", "minItems": 1 },
        "write_scopes": { "type": "array", "minItems": 1 },
        "session_freshness_states": { "type": "array", "minItems": 1 },
        "row_postures": { "type": "array", "minItems": 1 },
        "access_capabilities": { "type": "array", "minItems": 1 },
        "row_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "account_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/account_example" }
        },
        "masks_connection_or_scope": { "const": false },
        "collapses_states_into_generic_connected": { "const": false },
        "overstates_cached_as_live": { "const": false },
        "forces_blind_credential_reentry": { "const": false }
      }
    },
    "account_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "identity_class",
            "connection_state",
            "tenant_scope",
            "write_scope",
            "session_freshness",
            "account_identity_ref",
            "row_posture",
            "access_capability",
            "available_actions",
            "can_read_live",
            "can_write",
            "only_inspect_cached",
            "needs_attention",
            "needs_reauth",
            "preserves_local_drafts",
            "preserves_support_export_continuity",
            "requires_blind_credential_reentry"
          ]
        }
      }
    }
  }
}
