{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-tree-row.schema.json",
  "title": "Aureline M5 test-tree-row primitive",
  "description": "Export-safe packet implementing the reusable M5 test-tree row as one primitive. The packet binds one row per claimed test surface consumer — the test-explorer tree, the editor-gutter tree, the run-panel tree, the headless/CLI tree, and the test-report export — to the shared tree-row anatomy, the derived row posture (quarantined/partial-discovery/imported-evidence/stale-result/suite-aggregate/live-concrete), the tree item classes (suite/template/concrete-case/notebook-backed/imported-result/partial-discovery), identity classes, result origins, the exact rerun scope (whole-suite/parameterized-group/single-case/notebook-cells/imported-replay-only/nothing-concrete-yet), bounded reveal-identity/rerun/debug/review-quarantine/export actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks its item identity class or imported/live origin, never hides a quarantine's release impact, never renders imported or partial-discovery items with live certainty, and never silently widens the rerun scope. Raw log bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_test_tree_rows_with_suite_template_case_notebook_imported_result_distinction_parameterized_counts_freshness_target_chip_and_mute_quarantine_truth_across_claimed_m5_test_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "test_evidence_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "item_classes",
        "identity_classes",
        "result_origins",
        "row_postures",
        "rerun_scopes",
        "row_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "tree_examples",
        "masks_identity_or_origin",
        "hides_quarantine_release_impact",
        "overstates_imported_certainty",
        "widens_rerun_scope_silently"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "test_explorer_tree",
            "editor_gutter_tree",
            "run_panel_tree",
            "headless_cli_tree",
            "test_report_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "item_classes": { "type": "array", "minItems": 1 },
        "identity_classes": { "type": "array", "minItems": 1 },
        "result_origins": { "type": "array", "minItems": 1 },
        "row_postures": { "type": "array", "minItems": 1 },
        "rerun_scopes": { "type": "array", "minItems": 1 },
        "row_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tree_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tree_example" }
        },
        "masks_identity_or_origin": { "const": false },
        "hides_quarantine_release_impact": { "const": false },
        "overstates_imported_certainty": { "const": false },
        "widens_rerun_scope_silently": { "const": false }
      }
    },
    "tree_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "item_class",
            "identity_class",
            "result_origin",
            "result_freshness",
            "item_identity_ref",
            "row_posture",
            "rerun_scope",
            "can_rerun",
            "can_debug",
            "shows_live_certainty",
            "carries_reduced_certainty",
            "is_muted",
            "available_actions"
          ]
        }
      }
    }
  }
}
