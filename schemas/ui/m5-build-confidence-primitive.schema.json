{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-build-confidence-primitive.schema.json",
  "title": "Aureline M5 build / run confidence primitive",
  "description": "Canonical parity matrix for the reusable M5 build / run confidence primitive: an adapter-source badge with a confidence chip, a target-graph row, a capability-matrix sheet, a raw-event drawer, and a fallback-confidence drawer that all resolve from one build-target context and share one target identity and one disclosed adapter source. Narrows the five remaining build / run families of the frozen M5 manifest/build component matrix (adapter-source badge, target-graph row, capability matrix, raw-event drawer, fallback-confidence drawer) into one working resolver. Adapter provenance is never hidden (AC1); target identity and confidence stay inspectable before any run/test/debug action (AC2); support and AI consumers reuse the same component truth rather than re-deriving it from logs (AC3). Raw build output, event payloads, credentials, and endpoint data never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_build_confidence_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "adapter_source_badge",
        "target_graph_row",
        "capability_matrix_sheet",
        "raw_event_drawer",
        "fallback_confidence_drawer",
        "support_export_replay"
      ]
    },
    "build_verb": {
      "enum": ["build", "test", "run", "debug", "coverage", "package"]
    },
    "action_kind": {
      "enum": [
        "inspect_capabilities",
        "view_raw_events",
        "copy_export",
        "open_target_graph",
        "open_source_truth"
      ]
    },
    "export_field": {
      "enum": [
        "target_id",
        "target_identity",
        "adapter_source",
        "adapter_version",
        "confidence",
        "freshness",
        "fallback_state"
      ]
    },
    "adapter_source_kind": {
      "enum": [
        "native_build_server",
        "native_build_event",
        "heuristic_parse",
        "imported_snapshot",
        "provider_overlay",
        "unknown"
      ]
    },
    "capability_state": {
      "enum": ["supported", "partial", "unsupported", "unknown", "provider_gated"]
    },
    "raw_event_channel": {
      "enum": [
        "native_build_event",
        "native_build_server",
        "task_event_bus",
        "heuristic_parse",
        "imported_log"
      ]
    },
    "target_graph_node_kind": {
      "enum": [
        "build_target",
        "test_target",
        "run_target",
        "dependency_edge",
        "container_target"
      ]
    },
    "fallback_confidence_state": {
      "enum": [
        "structured_high",
        "structured_degraded",
        "heuristic_fallback",
        "imported_only",
        "unknown"
      ]
    },
    "fallback_reason": {
      "enum": [
        "adapter_unavailable",
        "structured_channel_lost",
        "schema_drift",
        "connector_loss",
        "policy_block"
      ]
    },
    "fallback_recovery_route": {
      "enum": [
        "reattach_adapter",
        "rerun_discovery",
        "inspect_only",
        "open_source_truth",
        "retry_connector"
      ]
    },
    "truth_mode_enum": {
      "enum": ["desired", "rendered", "plan", "live", "provider_overlay"]
    },
    "resource_freshness": {
      "enum": ["live_fresh", "cached_stale", "imported_snapshot", "plan_only", "unknown"]
    },
    "discovery_confidence": {
      "enum": ["high", "medium", "low", "unknown"]
    },
    "downgrade_trigger": {
      "enum": [
        "schema_stale",
        "adapter_unavailable",
        "connector_loss",
        "policy_block",
        "drift_from_source",
        "low_confidence_discovery",
        "structured_channel_lost",
        "target_context_unresolved"
      ]
    },
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kind", "stable_id", "owning_module", "workspace_root"],
      "properties": {
        "node_kind": { "$ref": "#/$defs/target_graph_node_kind" },
        "stable_id": { "type": "string", "minLength": 1 },
        "owning_module": { "type": "string", "minLength": 1 },
        "workspace_root": { "type": "string", "minLength": 1 }
      }
    },
    "capability_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "state"],
      "properties": {
        "verb": { "$ref": "#/$defs/build_verb" },
        "state": { "$ref": "#/$defs/capability_state" }
      }
    },
    "resolved_capability_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "state", "downgraded"],
      "properties": {
        "verb": { "$ref": "#/$defs/build_verb" },
        "state": { "$ref": "#/$defs/capability_state" },
        "downgraded": { "type": "boolean" }
      }
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "confidence_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_ref",
        "target_label",
        "identity",
        "truth_mode",
        "adapter_source",
        "adapter_version",
        "confidence",
        "freshness",
        "required_environment",
        "event_channel",
        "payload_lineage",
        "capabilities",
        "fallback_state",
        "recovery_route",
        "target_identity_ref",
        "available_actions"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "target_ref": { "$ref": "#/$defs/ref" },
        "target_label": { "type": "string", "minLength": 1 },
        "identity": { "$ref": "#/$defs/target_identity" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "adapter_source": { "$ref": "#/$defs/adapter_source_kind" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "freshness": { "$ref": "#/$defs/resource_freshness" },
        "required_environment": { "type": "array", "items": { "type": "string" } },
        "event_channel": { "$ref": "#/$defs/raw_event_channel" },
        "payload_lineage": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/raw_event_channel" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability_cell" }
        },
        "fallback_state": { "$ref": "#/$defs/fallback_confidence_state" },
        "fallback_reason": { "$ref": "#/$defs/fallback_reason" },
        "recovery_route": { "$ref": "#/$defs/fallback_recovery_route" },
        "fallback_note": { "type": "string" },
        "target_identity_ref": { "$ref": "#/$defs/ref" },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_kind" }
        },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_adapter_badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "adapter_source",
        "confidence",
        "source_kind_explicit",
        "is_native",
        "confidence_consistent"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "adapter_source": { "$ref": "#/$defs/adapter_source_kind" },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "source_kind_explicit": { "const": true },
        "is_native": { "type": "boolean" },
        "confidence_consistent": { "const": true }
      }
    },
    "resolved_target_graph_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "identity",
        "node_kind",
        "truth_mode",
        "edge_confidence",
        "freshness",
        "supported_verbs",
        "required_environment",
        "target_context_visible"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "identity": { "$ref": "#/$defs/target_identity" },
        "node_kind": { "$ref": "#/$defs/target_graph_node_kind" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "edge_confidence": { "$ref": "#/$defs/discovery_confidence" },
        "freshness": { "$ref": "#/$defs/resource_freshness" },
        "supported_verbs": { "type": "array", "items": { "$ref": "#/$defs/build_verb" } },
        "required_environment": { "type": "array", "items": { "type": "string" } },
        "target_context_visible": { "const": true }
      }
    },
    "resolved_capability_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "adapter_source",
        "confidence",
        "cells",
        "downgraded_verbs",
        "discloses_source_and_confidence"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "adapter_source": { "$ref": "#/$defs/adapter_source_kind" },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_capability_cell" }
        },
        "downgraded_verbs": { "type": "array", "items": { "$ref": "#/$defs/build_verb" } },
        "discloses_source_and_confidence": { "const": true }
      }
    },
    "resolved_raw_event_drawer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "event_channel",
        "adapter_version",
        "payload_lineage",
        "redaction_applied",
        "preserves_event_identity",
        "export_actions"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "event_channel": { "$ref": "#/$defs/raw_event_channel" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "payload_lineage": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/raw_event_channel" }
        },
        "redaction_applied": { "const": true },
        "preserves_event_identity": { "const": true },
        "export_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_kind" }
        }
      }
    },
    "resolved_fallback_drawer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "confidence_state",
        "recovery_route",
        "is_fallback",
        "never_overwrites_structured_silently"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "confidence_state": { "$ref": "#/$defs/fallback_confidence_state" },
        "fallback_reason": {
          "oneOf": [{ "$ref": "#/$defs/fallback_reason" }, { "type": "null" }]
        },
        "recovery_route": { "$ref": "#/$defs/fallback_recovery_route" },
        "is_fallback": { "type": "boolean" },
        "fallback_note": { "type": ["string", "null"] },
        "never_overwrites_structured_silently": { "const": true },
        "downgrade_trigger": {
          "oneOf": [{ "$ref": "#/$defs/downgrade_trigger" }, { "type": "null" }]
        }
      }
    },
    "resolved_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "adapter_badge",
        "target_graph_row",
        "capability_matrix",
        "raw_event_drawer",
        "fallback_drawer",
        "provenance_disclosed",
        "identity_inspectable_before_action"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "adapter_badge": { "$ref": "#/$defs/resolved_adapter_badge" },
        "target_graph_row": { "$ref": "#/$defs/resolved_target_graph_row" },
        "capability_matrix": { "$ref": "#/$defs/resolved_capability_matrix" },
        "raw_event_drawer": { "$ref": "#/$defs/resolved_raw_event_drawer" },
        "fallback_drawer": { "$ref": "#/$defs/resolved_fallback_drawer" },
        "provenance_disclosed": { "const": true },
        "identity_inspectable_before_action": { "const": true },
        "degraded": {
          "oneOf": [{ "$ref": "#/$defs/degraded_state" }, { "type": "null" }]
        }
      }
    },
    "confidence_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/confidence_input" },
        "resolved": { "$ref": "#/$defs/resolved_confidence" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "adapter_source_kinds",
        "truth_modes",
        "build_verbs",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_confidence",
        "hides_adapter_source",
        "blurs_structured_and_fallback",
        "hides_target_identity",
        "presents_fallback_as_structured"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "adapter_source_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/adapter_source_kind" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode_enum" }
        },
        "build_verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/build_verb" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_confidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/confidence_case" }
        },
        "hides_adapter_source": { "const": false },
        "blurs_structured_and_fallback": { "const": false },
        "hides_target_identity": { "const": false },
        "presents_fallback_as_structured": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "build_verbs",
        "action_kinds",
        "export_fields",
        "adapter_source_kinds",
        "capability_states",
        "raw_event_channels",
        "target_graph_node_kinds",
        "fallback_confidence_states",
        "fallback_reasons",
        "fallback_recovery_routes",
        "truth_modes",
        "resource_freshness",
        "discovery_confidence",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "build_verbs": { "type": "array", "items": { "type": "string" } },
        "action_kinds": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "adapter_source_kinds": { "type": "array", "items": { "type": "string" } },
        "capability_states": { "type": "array", "items": { "type": "string" } },
        "raw_event_channels": { "type": "array", "items": { "type": "string" } },
        "target_graph_node_kinds": { "type": "array", "items": { "type": "string" } },
        "fallback_confidence_states": { "type": "array", "items": { "type": "string" } },
        "fallback_reasons": { "type": "array", "items": { "type": "string" } },
        "fallback_recovery_routes": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "resource_freshness": { "type": "array", "items": { "type": "string" } },
        "discovery_confidence": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "target_identity_preserved_across_surfaces",
        "adapter_source_never_hidden",
        "structured_and_fallback_never_blurred",
        "identity_and_confidence_inspectable_before_action",
        "support_export_reconstructs_confidence",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "target_identity_preserved_across_surfaces": { "const": true },
        "adapter_source_never_hidden": { "const": true },
        "structured_and_fallback_never_blurred": { "const": true },
        "identity_and_confidence_inspectable_before_action": { "const": true },
        "support_export_reconstructs_confidence": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "capability_matrix_reads_single_source",
        "support_and_ai_reuse_shared_component"
      ],
      "properties": {
        "confidence_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "capability_matrix_reads_single_source": { "const": true },
        "support_and_ai_reuse_shared_component": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "confidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "confidence_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
