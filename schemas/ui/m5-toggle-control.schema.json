{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-toggle-control.schema.json",
  "title": "Aureline M5 checkbox / radio / switch toggle control component",
  "description": "Canonical single-instance shape of the M5 checkbox / radio / switch toggle control core control (checkbox / radio / switch toggle control whose boolean semantics stay distinct). Every claimed M5 toggle_control references this schema or the combined m5-core-action-input-component-matrix.schema.json rather than reinventing its own state, label, value, or validation wording. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "lets_placeholder_text_replace_the_label",
    "lets_loading_relabel_the_action_or_lose_attribution",
    "leaves_icon_only_destructive_action_unlabeled",
    "blurs_switch_with_deferred_checkbox",
    "lets_split_button_default_to_riskier_alternate",
    "hides_locked_or_degraded_semantics_behind_generic_disabled"
  ],
  "properties": {
    "component_family": {
      "const": "toggle_control"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "default",
          "hover",
          "focus_visible",
          "pressed",
          "loading",
          "disabled",
          "locked",
          "read_only",
          "degraded"
        ]
      }
    },
    "button_emphases": {
      "type": "array"
    },
    "icon_label_modes": {
      "type": "array"
    },
    "split_postures": {
      "type": "array"
    },
    "field_label_modes": {
      "type": "array"
    },
    "field_validations": {
      "type": "array"
    },
    "search_affordances": {
      "type": "array"
    },
    "combobox_value_sources": {
      "type": "array"
    },
    "toggle_semantics": {
      "type": "array"
    },
    "segmented_modes": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "lets_placeholder_text_replace_the_label": {
      "const": false
    },
    "lets_loading_relabel_the_action_or_lose_attribution": {
      "const": false
    },
    "leaves_icon_only_destructive_action_unlabeled": {
      "const": false
    },
    "blurs_switch_with_deferred_checkbox": {
      "const": false
    },
    "lets_split_button_default_to_riskier_alternate": {
      "const": false
    },
    "hides_locked_or_degraded_semantics_behind_generic_disabled": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
