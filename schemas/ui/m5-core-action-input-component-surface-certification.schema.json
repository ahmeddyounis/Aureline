{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-core-action-input-component-surface-certification.schema.json",
  "title": "Aureline M5 core-action-input component surface certification packet",
  "description": "M05-1131 closing capstone certifying that the frozen M5 core-action-input component families (button, icon button, split button, text field, search field, combobox, checkbox-radio-switch toggle control, segmented control) hold their truth on every claimed M5 forms / settings / search / entry / review / repair operating profile. Keyed on the claimed profile (live trusted control surface, reviewable control structure, unbound-command surface, unlabeled-icon surface, riskier-split-default surface, stale-validation field, unverified-toggle control, partial-retention search field), each row certifies the profile across eight truth axes — visual, keyboard, screen-reader, high-zoom-reflow, reduced-motion, CLI/export, degraded-state, and control-component-truth behavior — and either passes (green), auto-narrows its control claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted control profile may certify a trusted control; and every B134 guardrail must hold (placeholder text is never the only label, a loading control never relabels or resizes its action out of attribution, an icon-only destructive action is never unlabeled, a switch is never blurred with a deferred checkbox, a split button never defaults to a riskier alternate, and locked / degraded semantics are never hidden behind generic disabled chrome). Every row cites exactly one canonical core-action-input proof bundle. The packet is metadata-only: raw field values, option payloads, credentials, secrets, and endpoint refs never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_core_action_input_component_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-core-action-input-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_control_surface",
        "reviewable_control_structure",
        "unbound_command_surface",
        "unlabeled_icon_surface",
        "riskier_split_default_surface",
        "stale_validation_field",
        "unverified_toggle_control",
        "partial_retention_search_field"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "reduced_motion",
        "cli_export",
        "degraded_state",
        "control_component_truth"
      ]
    },
    "control_claim": {
      "enum": [
        "trusted_control",
        "reviewable_control",
        "command_binding_unverified_projection",
        "accessible_name_unverified_projection",
        "default_safety_unverified_projection",
        "validation_unverified_projection",
        "toggle_semantics_unverified_projection",
        "retention_disclosed_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "component_family": {
      "enum": [
        "button",
        "icon_button",
        "split_button",
        "text_field",
        "search_field",
        "combobox",
        "toggle_control",
        "segmented_control"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "placeholder_used_as_label",
        "loading_relabeled_or_resized",
        "icon_only_destructive_unlabeled",
        "switch_and_deferred_checkbox_blurred",
        "split_defaulted_to_riskier_alternate",
        "locked_or_degraded_hidden_behind_disabled",
        "value_source_unstated",
        "validation_state_unstated",
        "command_binding_unstated",
        "state_taxonomy_drifted",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_placeholder_as_label",
        "lets_loading_relabel_or_resize_action",
        "leaves_icon_only_destructive_unlabeled",
        "blurs_switch_with_deferred_checkbox",
        "lets_split_default_to_riskier_alternate",
        "hides_locked_or_degraded_behind_disabled"
      ],
      "properties": {
        "uses_placeholder_as_label": { "const": false },
        "lets_loading_relabel_or_resize_action": { "const": false },
        "leaves_icon_only_destructive_unlabeled": { "const": false },
        "blurs_switch_with_deferred_checkbox": { "const": false },
        "lets_split_default_to_riskier_alternate": { "const": false },
        "hides_locked_or_degraded_behind_disabled": { "const": false }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/control_claim" },
        "to_claim": { "$ref": "#/$defs/control_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_core_action_input_component_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/control_claim" },
        "certified_claim": { "$ref": "#/$defs/control_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-core-action-input-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
