{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-visual-designer-component-matrix.schema.json",
  "title": "M5 Visual-Designer Component Matrix",
  "description": "Frozen reusable visual-designer component contract: design canvas, structure-tree rows, property-inspector rows, source-sync chips, breakpoint/device-preview rows, unsupported-construct cards, and round-trip conflict banners. One canonical family later M5 rows reference instead of restating visual-designer truth in feature-local prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "set_label",
    "components",
    "guardrails",
    "consumer_projection",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_visual_designer_component_matrix" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "set_label": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component_row" }
    },
    "guardrails": { "$ref": "#/definitions/guardrails" },
    "consumer_projection": { "$ref": "#/definitions/consumer_projection" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "component_family": {
      "enum": [
        "design_canvas",
        "structure_tree_row",
        "property_inspector_row",
        "source_sync_chip",
        "breakpoint_preview_row",
        "unsupported_construct_card",
        "round_trip_conflict_banner"
      ]
    },
    "source_sync_class": {
      "enum": [
        "in_sync_from_source",
        "pending_rebuild",
        "drifted_from_source",
        "runtime_only_no_source",
        "unidentified_source_sync"
      ]
    },
    "round_trip_capability_class": {
      "enum": [
        "exact_source_round_trip",
        "approximate_source_round_trip",
        "inspect_only_no_write",
        "source_only_fallback",
        "no_round_trip"
      ]
    },
    "preview_surface": {
      "enum": [
        "source_first_framework_preview",
        "visual_surface_mapping",
        "browser_runtime_inspection",
        "device_or_simulator_preview",
        "full_stack_preview_loop",
        "embedded_webview_preview",
        "visual_edit_transform",
        "support_export_projection"
      ]
    },
    "preview_diff_class": {
      "enum": [
        "real_source_unified_diff",
        "real_source_multi_file_diff",
        "code_first_suggestion_diff",
        "no_diff_inspect_only"
      ]
    },
    "protected_path_posture": {
      "enum": [
        "unprotected",
        "protected_review_required",
        "protected_owner_approval_required",
        "protected_blocked"
      ]
    },
    "mutation_review_posture": {
      "enum": ["confirmation_required", "review_required", "blocked_needs_elevation"]
    },
    "required_label": {
      "enum": [
        "identity",
        "source_ownership",
        "state",
        "sync_or_freshness",
        "keyboard_route"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "drifted_from_source",
        "unmapped_source",
        "runtime_unavailable",
        "protected_path_blocked",
        "unsupported_construct",
        "round_trip_conflict_open",
        "unidentified_posture"
      ]
    },
    "design_canvas_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas_state",
        "is_derivative_of_source",
        "selection_synced_with_tree_and_source",
        "source_revision_ref"
      ],
      "properties": {
        "canvas_state": {
          "enum": [
            "source_bound_editable",
            "source_bound_read_only",
            "runtime_mirrored",
            "snapshot_static",
            "detached_needs_resync"
          ]
        },
        "is_derivative_of_source": { "type": "boolean" },
        "selection_synced_with_tree_and_source": { "type": "boolean" },
        "source_revision_ref": { "type": "string", "minLength": 1 }
      }
    },
    "structure_tree_row_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_kind",
        "maps_to_source_span",
        "selection_synced_with_canvas_and_source"
      ],
      "properties": {
        "node_kind": {
          "enum": [
            "source_element",
            "component_instance",
            "slot_or_children",
            "text_leaf",
            "generated_node",
            "unmapped_node"
          ]
        },
        "maps_to_source_span": { "type": "boolean" },
        "selection_synced_with_canvas_and_source": { "type": "boolean" },
        "source_span_ref": { "type": "string", "minLength": 1 }
      }
    },
    "property_inspector_row_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_state",
        "write_scope",
        "protected_path_posture",
        "preview_diff",
        "widens_write_scope_silently"
      ],
      "properties": {
        "value_state": {
          "enum": [
            "literal",
            "design_token",
            "bound_expression",
            "inherited",
            "mixed",
            "unset"
          ]
        },
        "write_scope": {
          "enum": [
            "single_literal_span",
            "token_definition_shared",
            "instance_override",
            "no_write_inspect_only",
            "blocked_protected"
          ]
        },
        "protected_path_posture": { "$ref": "#/definitions/protected_path_posture" },
        "preview_diff": { "$ref": "#/definitions/preview_diff_class" },
        "review_posture": { "$ref": "#/definitions/mutation_review_posture" },
        "widens_write_scope_silently": { "type": "boolean" }
      }
    },
    "source_sync_chip_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sync_class", "recovery_route"],
      "properties": {
        "sync_class": { "$ref": "#/definitions/source_sync_class" },
        "recovery_route": {
          "enum": [
            "none_in_sync",
            "rebuild_from_source",
            "resync_mapping",
            "reattach_runtime",
            "inspect_only_no_recovery"
          ]
        }
      }
    },
    "breakpoint_preview_row_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_class", "data_posture", "mapping_quality", "runtime_origin_token"],
      "properties": {
        "device_class": {
          "enum": [
            "desktop_viewport",
            "tablet_viewport",
            "mobile_viewport",
            "custom_viewport",
            "device_tethered",
            "simulator_preview"
          ]
        },
        "data_posture": { "enum": ["live", "mock", "captured"] },
        "mapping_quality": { "enum": ["exact", "approximate", "unmapped"] },
        "runtime_origin_token": { "type": "string", "minLength": 1 }
      }
    },
    "unsupported_construct_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserves_selection_context", "card_label"],
      "properties": {
        "reason": {
          "enum": [
            "dynamic_binding",
            "conditional_or_loop_origin",
            "generated_or_external_artifact",
            "ambiguous_source_mapping",
            "lossy_transform_rejected",
            "protected_path_blocked"
          ]
        },
        "preserves_selection_context": { "type": "boolean" },
        "card_label": { "type": "string", "minLength": 1 }
      }
    },
    "round_trip_conflict_banner_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_class",
        "resolution_route",
        "never_silent_writeback",
        "preserves_selection_context"
      ],
      "properties": {
        "conflict_class": {
          "enum": [
            "source_changed_under_edit",
            "generated_file_protected",
            "ambiguous_mapping",
            "concurrent_external_edit",
            "lossy_transform_refused"
          ]
        },
        "resolution_route": {
          "enum": [
            "reload_source_reapply",
            "keep_source_discard_visual",
            "open_source_manual_merge",
            "inspect_only_no_write"
          ]
        },
        "never_silent_writeback": { "type": "boolean" },
        "preserves_selection_context": { "type": "boolean" }
      }
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/definitions/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "family",
        "surface_label",
        "preview_surface",
        "source_sync",
        "round_trip",
        "required_labels",
        "export_safe",
        "assistive_ready",
        "label_summary",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/definitions/component_family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "preview_surface": { "$ref": "#/definitions/preview_surface" },
        "source_sync": { "$ref": "#/definitions/source_sync_class" },
        "round_trip": { "$ref": "#/definitions/round_trip_capability_class" },
        "required_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/required_label" }
        },
        "export_safe": { "type": "boolean" },
        "assistive_ready": { "type": "boolean" },
        "design_canvas": { "$ref": "#/definitions/design_canvas_descriptor" },
        "structure_tree_row": { "$ref": "#/definitions/structure_tree_row_descriptor" },
        "property_inspector_row": { "$ref": "#/definitions/property_inspector_row_descriptor" },
        "source_sync_chip": { "$ref": "#/definitions/source_sync_chip_descriptor" },
        "breakpoint_preview_row": { "$ref": "#/definitions/breakpoint_preview_row_descriptor" },
        "unsupported_construct_card": { "$ref": "#/definitions/unsupported_construct_card" },
        "round_trip_conflict_banner": { "$ref": "#/definitions/round_trip_conflict_banner_descriptor" },
        "degraded": { "$ref": "#/definitions/degraded_state" },
        "label_summary": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_remains_canonical",
        "canvas_state_derivative_and_explicit",
        "tree_canvas_source_selection_synchronized",
        "property_editors_distinguish_value_state_no_silent_widening",
        "unsupported_generated_protected_conflicts_never_silent",
        "breakpoint_previews_keep_origin_posture_and_mapping_visible",
        "components_bound_to_shared_vocabulary",
        "no_new_engine_framework_or_runtime"
      ],
      "properties": {
        "source_remains_canonical": { "type": "boolean" },
        "canvas_state_derivative_and_explicit": { "type": "boolean" },
        "tree_canvas_source_selection_synchronized": { "type": "boolean" },
        "property_editors_distinguish_value_state_no_silent_widening": { "type": "boolean" },
        "unsupported_generated_protected_conflicts_never_silent": { "type": "boolean" },
        "breakpoint_previews_keep_origin_posture_and_mapping_visible": { "type": "boolean" },
        "components_bound_to_shared_vocabulary": { "type": "boolean" },
        "no_new_engine_framework_or_runtime": { "type": "boolean" }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ingests_components",
        "docs_help_ingests_components",
        "diagnostics_ingests_components",
        "support_export_ingests_components",
        "release_control_ingests_components",
        "later_rows_reference_one_canonical_family"
      ],
      "properties": {
        "product_ingests_components": { "type": "boolean" },
        "docs_help_ingests_components": { "type": "boolean" },
        "diagnostics_ingests_components": { "type": "boolean" },
        "support_export_ingests_components": { "type": "boolean" },
        "release_control_ingests_components": { "type": "boolean" },
        "later_rows_reference_one_canonical_family": { "type": "boolean" }
      }
    }
  }
}
