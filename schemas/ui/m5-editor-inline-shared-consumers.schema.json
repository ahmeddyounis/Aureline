{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-editor-inline-shared-consumers.schema.json",
  "title": "M5 Editor-Inline Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the eight B133 inline components (editor tab, gutter, diagnostic decoration, code-action chip, diff view, review thread, AI message card, evidence timeline) to the editor / diff / review / notebook / AI / diagnostics / CLI-export / support / product consumers that render them, proving one shared vocabulary across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_editor_inline_shared_consumer_vocabulary_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 12,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "editor_tab",
        "gutter",
        "diagnostic_decoration",
        "code_action_chip",
        "diff_view",
        "review_thread",
        "ai_message_card",
        "evidence_timeline"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "editor_ui",
        "diff_ui",
        "review_ui",
        "notebook_ui",
        "ai_ui",
        "diagnostics_ui",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_evidence"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "vocabulary_drift_detected",
        "anchor_or_evidence_drift",
        "outdated_resolved_blurred",
        "inferred_fix_shown_as_exact",
        "evidence_hidden_in_opaque_log",
        "canonical_reference_missing",
        "upstream_component_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_word",
        "severity_or_confidence_word",
        "anchor_freshness_word",
        "approval_state_word",
        "evidence_lineage_word"
      ],
      "properties": {
        "state_word": { "type": "string", "minLength": 1 },
        "severity_or_confidence_word": { "type": "string", "minLength": 1 },
        "anchor_freshness_word": { "type": "string", "minLength": 1 },
        "approval_state_word": { "type": "string", "minLength": 1 },
        "evidence_lineage_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_vocabulary_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_vocabulary_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "inline_object_id",
        "inline_object_label",
        "component",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_evidence_note",
        "encodes_state_by_color_alone",
        "lets_anchor_or_evidence_pointer_silently_drift",
        "blurs_outdated_and_resolved_review_state",
        "presents_inferred_fix_as_exact",
        "hides_evidence_in_opaque_log",
        "rewords_inline_vocabulary_per_surface",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "inline_object_id": { "type": "string", "minLength": 1 },
        "inline_object_label": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_evidence_note": { "type": "string" },
        "encodes_state_by_color_alone": { "type": "boolean", "const": false },
        "lets_anchor_or_evidence_pointer_silently_drift": {
          "type": "boolean",
          "const": false
        },
        "blurs_outdated_and_resolved_review_state": {
          "type": "boolean",
          "const": false
        },
        "presents_inferred_fix_as_exact": { "type": "boolean", "const": false },
        "hides_evidence_in_opaque_log": { "type": "boolean", "const": false },
        "rewords_inline_vocabulary_per_surface": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_reuse_proven_by_fixtures",
        "same_object_same_vocabulary_across_surfaces",
        "state_words_stay_in_frozen_vocabulary",
        "state_never_encoded_by_color_alone",
        "anchors_and_evidence_never_silently_drift",
        "outdated_and_resolved_stay_distinct",
        "inferred_fix_never_shown_as_exact",
        "evidence_keeps_inspectable_structure",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "component_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_object_same_vocabulary_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "state_words_stay_in_frozen_vocabulary": { "type": "boolean", "const": true },
        "state_never_encoded_by_color_alone": { "type": "boolean", "const": true },
        "anchors_and_evidence_never_silently_drift": {
          "type": "boolean",
          "const": true
        },
        "outdated_and_resolved_stay_distinct": { "type": "boolean", "const": true },
        "inferred_fix_never_shown_as_exact": { "type": "boolean", "const": true },
        "evidence_keeps_inspectable_structure": { "type": "boolean", "const": true },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": { "type": "boolean", "const": true },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editor_ui_reuses_shared_components",
        "diff_ui_reuses_shared_components",
        "review_ui_reuses_shared_components",
        "notebook_ui_reuses_shared_components",
        "ai_ui_reuses_shared_components",
        "diagnostics_ui_reuses_shared_components",
        "support_export_reuses_shared_components",
        "every_component_adopted_by_two_or_more_consumers",
        "vocabulary_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_contract_family"
      ],
      "properties": {
        "editor_ui_reuses_shared_components": { "type": "boolean", "const": true },
        "diff_ui_reuses_shared_components": { "type": "boolean", "const": true },
        "review_ui_reuses_shared_components": { "type": "boolean", "const": true },
        "notebook_ui_reuses_shared_components": { "type": "boolean", "const": true },
        "ai_ui_reuses_shared_components": { "type": "boolean", "const": true },
        "diagnostics_ui_reuses_shared_components": {
          "type": "boolean",
          "const": true
        },
        "support_export_reuses_shared_components": {
          "type": "boolean",
          "const": true
        },
        "every_component_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "vocabulary_identical_for_same_object": { "type": "boolean", "const": true },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_contract_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
