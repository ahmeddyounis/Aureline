{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-execution-lifecycle-component-consumer.schema.json",
  "title": "Aureline M5 execution-lifecycle component consumer packet",
  "description": "M05-825 first-consumer adoption packet proving the five frozen M5 execution-lifecycle component families (run/attempt header, input-request prompt, artifact-publish row, rerun-comparison review, and debug-session hierarchy) are reusable primitives. Each row is one consumer on one M5 execution surface — task/test, request/database, notebook/preview, AI/publish, or support/export — that points back to exactly one canonical component family (its primitive schema + release-proof packet) instead of inventing per-surface run/debug identity language. Every consumer keeps the identical run/attempt-identity, outcome-state, rerun-context-difference, artifact-lineage/retention, and debug-control-posture labels and the identical degraded-state vocabulary; a narrower consumer discloses the reduction with a reduced-capability banner (and a handoff note when it punts to another surface). The packet is metadata-only: raw run logs, request bodies, artifact payloads, stack frames, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_execution_lifecycle_component_consumer_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "consumer_group": {
      "enum": [
        "task_test",
        "request_database",
        "notebook_preview",
        "ai_publish",
        "support_export"
      ]
    },
    "consumer_surface": {
      "enum": [
        "task_run_pane",
        "test_explorer",
        "request_run_pane",
        "database_execution_pane",
        "notebook_execution_cell",
        "preview_runtime_lane",
        "ai_mediated_run",
        "publish_deploy_flow",
        "support_export_replay",
        "history_activity_center",
        "help_center_docs"
      ]
    },
    "component_family": {
      "enum": [
        "run_attempt_header",
        "input_request_prompt",
        "artifact_publish_row",
        "rerun_review",
        "debug_hierarchy"
      ]
    },
    "authority_mode": {
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "compare_only",
        "export_only",
        "policy_blocked"
      ]
    },
    "handoff_target": {
      "enum": [
        "none",
        "companion_app",
        "browser_readonly",
        "handoff_packet",
        "desktop_primary",
        "cli_headless"
      ]
    },
    "label_parity": {
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "label_family": {
      "enum": [
        "run_attempt_identity",
        "outcome_state",
        "rerun_context_difference",
        "artifact_lineage_retention",
        "debug_control_posture"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_group",
        "consumer_surface",
        "component_family",
        "canonical_family_schema_ref",
        "canonical_packet_refs",
        "references_canonical_not_local_prose",
        "authority_mode",
        "preserved_label_families",
        "degraded_state_vocab",
        "label_parity",
        "handoff_target",
        "copy_export",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_execution_lifecycle_component_consumer_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_group": { "$ref": "#/$defs/consumer_group" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_packet_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/label_family" }
        },
        "degraded_state_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_group_count",
        "consumer_surface_count",
        "component_family_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "task_test_consumer_present",
        "request_database_consumer_present",
        "notebook_preview_consumer_present",
        "ai_publish_consumer_present",
        "support_export_consumer_present",
        "docs_help_reference_present",
        "label_family_coverage_complete",
        "families_reused_across_groups"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_group_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "task_test_consumer_present": { "type": "boolean" },
        "request_database_consumer_present": { "type": "boolean" },
        "notebook_preview_consumer_present": { "type": "boolean" },
        "ai_publish_consumer_present": { "type": "boolean" },
        "support_export_consumer_present": { "type": "boolean" },
        "docs_help_reference_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "families_reused_across_groups": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
