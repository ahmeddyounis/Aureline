{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-provider-settings-repair-entrypoint-row.schema.json",
  "title": "Aureline M5 provider-settings repair-entrypoint row primitive",
  "description": "Export-safe packet shipping the reusable M5 provider-settings repair-entrypoint row as a primitive. The packet binds one row per claimed provider-settings consumer — the provider-account row, the project/board mapping row, the sync-behavior row, the privacy/redaction row, and the provider status bar — to the shared repair-row anatomy, the boundary class (network-egress/auth-stale/auth-scope/mapping-broken/provider-incompatible/policy-blocked), the account connection state, the derived repair posture, the concrete repair entrypoint the row links to, the linked diagnostics (network-egress/auth-session/support-bundle/provider-compatibility/export-redaction), the continuity guarantees (queued drafts/cached read/reviewed export/no blind credential re-entry), and bounded reveal/open-entrypoint/open-diagnostics/export-evidence/request-escalation actions. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked repair resolution cases proving the resolver, and five hard invariants: it never isolates settings from diagnostics, never loses queued work, never forces a blind credential re-entry, never breaks cached-read continuity, and never breaks the reviewed export path. Credentials, private endpoints, and raw bodies never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "ship_m5_provider_settings_repair_entrypoints_and_linked_diagnostics_so_network_egress_auth_compatibility_boundaries_stay_explicit_across_claimed_m5_provider_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "provider_repair_diagnostics_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "provider_repair_diagnostics_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "boundary_classes",
        "connection_states",
        "repair_postures",
        "repair_entrypoints",
        "linked_diagnostics",
        "continuity_guarantees",
        "row_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "examples",
        "isolates_settings_from_diagnostics",
        "loses_queued_work",
        "requires_blind_credential_reentry",
        "breaks_cached_read_continuity",
        "breaks_reviewed_export_path"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "provider_account_row",
            "project_board_mapping_row",
            "sync_behavior_row",
            "privacy_redaction_row",
            "provider_status_bar"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "boundary_classes": { "type": "array", "minItems": 1 },
        "connection_states": { "type": "array", "minItems": 1 },
        "repair_postures": { "type": "array", "minItems": 1 },
        "repair_entrypoints": { "type": "array", "minItems": 1 },
        "linked_diagnostics": { "type": "array", "minItems": 1 },
        "continuity_guarantees": { "type": "array", "minItems": 1 },
        "row_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/example" }
        },
        "isolates_settings_from_diagnostics": { "const": false },
        "loses_queued_work": { "const": false },
        "requires_blind_credential_reentry": { "const": false },
        "breaks_cached_read_continuity": { "const": false },
        "breaks_reviewed_export_path": { "const": false }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "boundary_class",
            "connection_state",
            "has_queued_drafts",
            "has_cached_read",
            "boundary_label",
            "repair_target_label",
            "repair_ref",
            "row_posture",
            "repair_entrypoint",
            "linked_diagnostics",
            "continuity_guarantees",
            "available_actions",
            "links_to_diagnostics",
            "preserves_queued_work",
            "preserves_cached_read_continuity",
            "preserves_reviewed_export_path",
            "requires_blind_credential_reentry",
            "isolated_from_diagnostics"
          ]
        }
      }
    }
  }
}
