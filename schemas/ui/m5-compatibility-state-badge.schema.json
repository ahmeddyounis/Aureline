{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-compatibility-state-badge.schema.json",
  "title": "Aureline M5 compatibility-state badge primitive",
  "description": "Export-safe packet for the reusable M5 compatibility-state badge primitive. It narrows the compatibility-state family frozen in schemas/ui/m5-badge-family-matrix.schema.json into one resolver plus a parity matrix, so a user can tell — from the badge and its explanation and reconciliation drawers alone — which compatibility posture an artifact carries (exact_match/compatible/limited/mismatch) before an install/import/apply/reopen flow proceeds, as one distinct, composable cue that never collapses into support class, lifecycle, or channel status and never softens a Limited or Mismatch reading into a generic warning. Each badge row binds one claimed badge consumer (the workspace-reopen card, the toolchain-install row, the extension-import row, the workflow-bundle-apply card, the compare/review panel, and the support-export row) to the shared badge anatomy, state values, derived compatibility postures, gap classes, residual capabilities, repair actions, explanation-drawer fields, export fields, and non-visual accessibility routes, plus worked resolution cases that must reproduce the resolver output exactly. The resolver derives the compatibility posture from the state axis alone — an exact-match artifact is full parity regardless of its support class, lifecycle, or channel — and when the state is Limited or Mismatch it produces a self-contained reconciliation note that discloses the reconciliation detail, states the residual capability and repair action, and preserves the underlying state context so the badge preserves enough detail for repair, compare, support export, and claim narrowing rather than collapsing into a generic warning. Hard invariants forbid collapsing the state into another axis, implying the support class from the state, dropping the reconciliation detail when a state is Limited or Mismatch, and letting exported evidence lose badge meaning. Raw URLs, raw signing keys, raw tokens, credentials, and user text bodies never cross this boundary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "badge_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "ship_m5_compatibility_state_badges_and_mismatch_review_affordances_across_claimed_m5_workspace_toolchain_extension_bundle_and_artifact_flows"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "badge_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/badge_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "consumer_surface": {
      "enum": [
        "workspace_reopen_card",
        "toolchain_install_row",
        "extension_import_row",
        "workflow_bundle_apply_card",
        "compare_review_panel",
        "support_export_row"
      ]
    },
    "state": {
      "enum": ["exact_match", "compatible", "limited", "mismatch"]
    },
    "compatibility_posture": {
      "enum": [
        "full_parity",
        "compatible_within_range",
        "reduced_capability",
        "incompatible_as_claimed"
      ]
    },
    "gap_class": {
      "enum": ["capability_subset_reduced", "version_or_schema_mismatch"]
    },
    "residual_capability": {
      "enum": ["continues_with_reduced_scope", "blocked_until_reconciled"]
    },
    "repair_action": {
      "enum": ["compare_and_review_reduced_scope", "repair_before_apply"]
    },
    "badge_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "state_summary",
        "anatomy_parts",
        "state_values",
        "compatibility_postures",
        "gap_classes",
        "residual_capabilities",
        "repair_actions",
        "explanation_fields",
        "export_fields",
        "accessibility_routes",
        "example_resolutions"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "state_summary": { "$ref": "#/$defs/non_empty_string" },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "state_values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state" }
        },
        "compatibility_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compatibility_posture" }
        },
        "gap_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gap_class" }
        },
        "residual_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/residual_capability" }
        },
        "repair_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repair_action" }
        },
        "explanation_fields": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "collapses_state_into_support_lifecycle_or_channel": { "const": false },
        "implies_support_class_from_compatibility_state": { "const": false },
        "drops_reconciliation_detail_on_mismatch": { "const": false },
        "drops_badge_meaning_in_export": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "subject_label",
            "state",
            "compatibility_posture",
            "is_full_parity",
            "is_compatible_within_range",
            "requires_reconciliation",
            "is_reduced_capability",
            "is_hard_mismatch",
            "last_evaluated_repr"
          ],
          "properties": {
            "state": { "$ref": "#/$defs/state" },
            "compatibility_posture": { "$ref": "#/$defs/compatibility_posture" },
            "is_full_parity": { "type": "boolean" },
            "is_compatible_within_range": { "type": "boolean" },
            "requires_reconciliation": { "type": "boolean" },
            "is_reduced_capability": { "type": "boolean" },
            "is_hard_mismatch": { "type": "boolean" },
            "reconciliation_note": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": [
                    "gap_class",
                    "repair_action",
                    "reconciliation_detail",
                    "residual_capability",
                    "preserved_state",
                    "is_reduced_capability",
                    "is_hard_mismatch",
                    "headline"
                  ],
                  "properties": {
                    "gap_class": { "$ref": "#/$defs/gap_class" },
                    "repair_action": { "$ref": "#/$defs/repair_action" },
                    "reconciliation_detail": { "$ref": "#/$defs/non_empty_string" },
                    "residual_capability": { "$ref": "#/$defs/residual_capability" },
                    "preserved_state": { "$ref": "#/$defs/state" },
                    "is_reduced_capability": { "type": "boolean" },
                    "is_hard_mismatch": { "type": "boolean" },
                    "headline": { "$ref": "#/$defs/non_empty_string" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
