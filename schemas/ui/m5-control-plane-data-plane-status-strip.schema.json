{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-control-plane-data-plane-status-strip.schema.json",
  "title": "Aureline M5 control-plane/data-plane status strip",
  "description": "Stable UI contract for an M5 control-plane/data-plane status strip. The strip keeps plane states and local-safe next step distinct so control-plane impairment never masquerades as local-runtime or data-plane failure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "component_id",
    "control_plane_state",
    "data_plane_state",
    "local_runtime_unaffected",
    "impairment_not_masked_as_local_failure",
    "local_safe_next_step",
    "keyboard_route_ref",
    "export_safe"
  ],
  "properties": {
    "record_kind": { "const": "m5_control_plane_data_plane_status_strip" },
    "schema_version": { "const": 1 },
    "component_id": { "$ref": "#/$defs/ref" },
    "control_plane_state": { "$ref": "#/$defs/plane_state" },
    "data_plane_state": { "$ref": "#/$defs/plane_state" },
    "local_runtime_unaffected": { "type": "boolean" },
    "impairment_not_masked_as_local_failure": { "const": true },
    "local_safe_next_step": {
      "enum": ["continue_local_work", "work_offline_cached", "retry_control_plane", "restore_from_checkpoint", "contact_admin"]
    },
    "keyboard_route_ref": { "$ref": "#/$defs/ref" },
    "degraded": { "$ref": "#/$defs/degraded_state" },
    "export_safe": { "const": true }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "plane_state": { "enum": ["operational", "degraded", "unavailable", "unknown"] },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "const": "control_plane_impaired" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
