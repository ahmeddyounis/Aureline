{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-host-boundary-strip-execution-origin-receipt-row-controls.schema.json",
  "title": "Aureline M5 host-boundary-strip and execution-origin-receipt-row controls",
  "description": "Export-safe packet for the second implement lane over the frozen M5 build/remote-boundary component matrix. It carries resolved, honest projections of the host-boundary strip and the execution-origin receipt row across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved host-boundary strip examples (naming the single controlled locality class, the host kind, the derived origin locus, the target label, the owning runtime/service lane, and the connection/reconnect/degraded state) and the resolved execution-origin receipt row examples (naming the action class, resolved target identity, host kind, origin locus, receipt state, origin confidence, any host-narrowing reason, and whether the export-safe target lineage is stable enough for reuse). Hard invariants forbid hiding the host locality class or owning runtime/service lane, dropping the execution origin when a surface is restored/handed off/degraded, publishing a receipt whose lineage is not stable for reuse, and concealing a boundary or origin behind generic status wording. Acceptance criteria are proven by the resolved examples, not merely asserted: a user can distinguish local, SSH, container, devcontainer, managed, and browser-bridge execution without opening a separate inspector; receipts remain stable enough for diagnostics, support exports, and release evidence to reuse without rewriting target lineage; and host ownership never disappears when a surface is restored, handed off, or degraded. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-remote is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_host_boundary_strip_and_execution_origin_receipt_row_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "boundary_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "boundary_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "locality": {
      "enum": ["local", "ssh", "container", "devcontainer", "managed", "browser_bridge", "service_plane"]
    },
    "origin_confidence": {
      "enum": ["confirmed", "attributed", "provisional", "stale", "unattributed"]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "host_boundary_strip_example": {
      "type": "object",
      "required": [
        "strip_id",
        "locality",
        "host_kind",
        "origin_locus",
        "target_label",
        "owning_runtime_lane",
        "connection_state",
        "is_degraded",
        "open_details_available",
        "degrade_reason",
        "next_action",
        "locality_disclosed",
        "target_label_disclosed",
        "owning_lane_disclosed",
        "reconnect_state_disclosed"
      ],
      "properties": {
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "locality": { "$ref": "#/$defs/locality" },
        "host_kind": { "$ref": "#/$defs/non_empty_string" },
        "origin_locus": { "$ref": "#/$defs/non_empty_string" },
        "target_label": { "type": "string" },
        "owning_runtime_lane": { "type": "string" },
        "connection_state": { "$ref": "#/$defs/non_empty_string" },
        "is_degraded": { "type": "boolean" },
        "open_details_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "locality_disclosed": { "type": "boolean" },
        "target_label_disclosed": { "type": "boolean" },
        "owning_lane_disclosed": { "type": "boolean" },
        "reconnect_state_disclosed": { "type": "boolean" }
      }
    },
    "execution_origin_receipt_row_example": {
      "type": "object",
      "required": [
        "receipt_id",
        "action_class",
        "resolved_target_identity",
        "host_kind",
        "origin_locus",
        "receipt_state",
        "connection_state",
        "origin_confidence",
        "host_narrowing_reason",
        "restored_or_handed_off",
        "ownership_retained",
        "export_safe_lineage_present",
        "lineage_stable_for_reuse",
        "action_class_disclosed",
        "target_identity_disclosed",
        "provenance_disclosed",
        "degrade_reason",
        "next_action",
        "drops_ownership_on_restore"
      ],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/non_empty_string" },
        "action_class": { "type": "string" },
        "resolved_target_identity": { "type": "string" },
        "host_kind": { "$ref": "#/$defs/non_empty_string" },
        "origin_locus": { "$ref": "#/$defs/non_empty_string" },
        "receipt_state": { "$ref": "#/$defs/non_empty_string" },
        "connection_state": { "$ref": "#/$defs/non_empty_string" },
        "origin_confidence": { "$ref": "#/$defs/origin_confidence" },
        "host_narrowing_reason": { "type": ["string", "null"] },
        "restored_or_handed_off": { "type": "boolean" },
        "ownership_retained": { "type": "boolean" },
        "export_safe_lineage_present": { "type": "boolean" },
        "lineage_stable_for_reuse": { "type": "boolean" },
        "action_class_disclosed": { "type": "boolean" },
        "target_identity_disclosed": { "type": "boolean" },
        "provenance_disclosed": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "drops_ownership_on_restore": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "host_boundary_strip_examples",
        "execution_origin_receipt_row_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_host_locality_or_owning_lane",
        "drops_execution_origin_when_restored_or_degraded",
        "receipt_lineage_not_stable_for_reuse",
        "conceals_boundary_or_origin_in_generic_status_wording"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "host_boundary_strip_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/host_boundary_strip_example" }
        },
        "execution_origin_receipt_row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/execution_origin_receipt_row_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_host_locality_or_owning_lane": { "const": false },
        "drops_execution_origin_when_restored_or_degraded": { "const": false },
        "receipt_lineage_not_stable_for_reuse": { "const": false },
        "conceals_boundary_or_origin_in_generic_status_wording": { "const": false }
      }
    }
  }
}
