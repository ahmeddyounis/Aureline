{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-package-management-component-consumer.schema.json",
  "title": "M5 Package-Management Component Consumer Parity Packet",
  "description": "Export-safe packet binding the eight shared M5 package-management components (package explorer row, manifest-scope switcher, install-review sheet, registry-or-mirror row, script-risk notice, lockfile-impact card, grouped-update planner, rollback-checkpoint strip) to the package explorer, dependency search/detail pane, Help surface, support packet, diagnostics view, and exported-view consumers that render them, proving manifest-scope/registry-auth/risk/recovery parity for the same package object across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "package_component_consumer_parity_truth"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "package_explorer_row",
        "manifest_scope_switcher",
        "install_review_sheet",
        "registry_or_mirror_row",
        "script_risk_notice",
        "lockfile_impact_card",
        "grouped_update_planner",
        "rollback_checkpoint_strip"
      ]
    },
    "consumer": {
      "type": "string",
      "enum": [
        "package_explorer",
        "dependency_search_detail",
        "help_surface",
        "support_packet",
        "diagnostics",
        "exported_view"
      ]
    },
    "registry_state": {
      "type": "string",
      "enum": [
        "resolved_exact",
        "manifest_range_only",
        "mirror_backed",
        "offline_snapshot_only",
        "auth_required_unsatisfied",
        "unknown_or_stale"
      ]
    },
    "render_mode": {
      "type": "string",
      "enum": [
        "full_parity",
        "manifest_range_narrowed",
        "mirror_or_offline_narrowed",
        "auth_required_narrowed",
        "unknown_or_stale_narrowed"
      ]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "exact_resolution_unavailable_range_only",
        "mirror_or_offline_continuity",
        "registry_auth_required",
        "package_state_unknown_or_stale"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": [
        "review_manifest_range",
        "review_mirror_offline_continuity",
        "complete_registry_auth",
        "review_package_state_freshness"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "registry_unreachable",
        "auth_required",
        "mirror_backed_only",
        "offline_snapshot_only",
        "lockfile_divergent",
        "script_or_native_build_risk",
        "broad_lockfile_regeneration",
        "rollback_unavailable",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "parity_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_scope_label",
        "registry_source_auth_label",
        "risk_language",
        "recovery_language"
      ],
      "properties": {
        "manifest_scope_label": { "type": "string", "minLength": 1 },
        "registry_source_auth_label": { "type": "string", "minLength": 1 },
        "risk_language": { "type": "string", "minLength": 1 },
        "recovery_language": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "preserved_facets_note", "next_action", "next_action_label"],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_facets_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "package_object_id",
        "package_object_label",
        "component",
        "consumer",
        "registry_state",
        "render_mode",
        "parity_facets",
        "parity_state",
        "narrow_banner",
        "continuity_note",
        "auth_note",
        "uses_generic_manage_package_language_hiding_scope",
        "uses_one_click_update_language_hiding_risk",
        "conceals_registry_auth_posture",
        "hides_broad_lockfile_regeneration",
        "drops_mirror_offline_or_rollback_truth",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "package_object_id": { "type": "string", "minLength": 1 },
        "package_object_label": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "consumer": { "$ref": "#/$defs/consumer" },
        "registry_state": { "$ref": "#/$defs/registry_state" },
        "render_mode": { "$ref": "#/$defs/render_mode" },
        "parity_facets": { "$ref": "#/$defs/parity_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_banner": {
          "oneOf": [{ "$ref": "#/$defs/narrow_banner" }, { "type": "null" }]
        },
        "continuity_note": { "type": "string" },
        "auth_note": { "type": "string" },
        "uses_generic_manage_package_language_hiding_scope": { "const": false },
        "uses_one_click_update_language_hiding_risk": { "const": false },
        "conceals_registry_auth_posture": { "const": false },
        "hides_broad_lockfile_regeneration": { "const": false },
        "drops_mirror_offline_or_rollback_truth": { "const": false },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "comment": "Full parity renders never carry a narrow banner.",
          "if": { "properties": { "render_mode": { "const": "full_parity" } } },
          "then": { "properties": { "narrow_banner": { "type": "null" } } }
        },
        {
          "comment": "Narrowed renders must carry a narrow banner.",
          "if": {
            "properties": {
              "render_mode": {
                "enum": [
                  "manifest_range_narrowed",
                  "mirror_or_offline_narrowed",
                  "auth_required_narrowed",
                  "unknown_or_stale_narrowed"
                ]
              }
            }
          },
          "then": {
            "properties": { "narrow_banner": { "$ref": "#/$defs/narrow_banner" } }
          }
        },
        {
          "comment": "Mirror-backed or offline-snapshot answers must keep an explicit continuity note.",
          "if": {
            "properties": {
              "registry_state": {
                "enum": ["mirror_backed", "offline_snapshot_only"]
              }
            }
          },
          "then": {
            "properties": { "continuity_note": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "comment": "Unsatisfied-auth answers must carry an explicit registry-auth note.",
          "if": {
            "properties": { "registry_state": { "const": "auth_required_unsatisfied" } }
          },
          "then": {
            "properties": { "auth_note": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_reuse_proven_by_fixtures",
        "same_object_same_language_across_surfaces",
        "manifest_scope_identical_across_surfaces",
        "registry_source_and_auth_identical_across_surfaces",
        "script_native_build_risk_identical_across_surfaces",
        "lockfile_churn_never_understated_across_surfaces",
        "rollback_checkpoint_identity_kept_explicit",
        "mirror_offline_continuity_kept_explicit",
        "generic_one_click_language_never_conceals_scope_or_risk",
        "help_support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "component_reuse_proven_by_fixtures": { "const": true },
        "same_object_same_language_across_surfaces": { "const": true },
        "manifest_scope_identical_across_surfaces": { "const": true },
        "registry_source_and_auth_identical_across_surfaces": { "const": true },
        "script_native_build_risk_identical_across_surfaces": { "const": true },
        "lockfile_churn_never_understated_across_surfaces": { "const": true },
        "rollback_checkpoint_identity_kept_explicit": { "const": true },
        "mirror_offline_continuity_kept_explicit": { "const": true },
        "generic_one_click_language_never_conceals_scope_or_risk": { "const": true },
        "help_support_export_point_canonical_contracts": { "const": true },
        "downgrade_narrows_instead_of_hides": { "const": true },
        "stale_or_underqualified_blocks_promotion": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_explorer_reuses_shared_components",
        "dependency_search_detail_reuses_shared_components",
        "help_surface_reuses_shared_components",
        "support_packet_reuses_shared_components",
        "diagnostics_reuses_shared_components",
        "exported_view_reuses_shared_components",
        "every_component_adopted_by_two_or_more_consumers",
        "parity_facets_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_preserves_scope_auth_and_lockfile_posture"
      ],
      "properties": {
        "package_explorer_reuses_shared_components": { "const": true },
        "dependency_search_detail_reuses_shared_components": { "const": true },
        "help_surface_reuses_shared_components": { "const": true },
        "support_packet_reuses_shared_components": { "const": true },
        "diagnostics_reuses_shared_components": { "const": true },
        "exported_view_reuses_shared_components": { "const": true },
        "every_component_adopted_by_two_or_more_consumers": { "const": true },
        "parity_facets_identical_for_same_object": { "const": true },
        "narrowing_disclosed_not_hidden": { "const": true },
        "export_preserves_scope_auth_and_lockfile_posture": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
