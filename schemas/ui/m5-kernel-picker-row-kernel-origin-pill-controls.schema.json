{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-kernel-picker-row-kernel-origin-pill-controls.schema.json",
  "title": "Aureline M5 kernel picker rows and kernel origin pills",
  "description": "Export-safe packet implementing the reusable M5 kernel-picker-row and kernel-origin-pill components in two co-equal control vectors. Each kernel picker row names a candidate's kernel class, environment identity/fingerprint, locality, compatibility state, trust/policy limits, and last-seen availability, and offers first-class choose/inspect/view-compatibility actions; its choice state is derived from the kernel selection state, so an incompatible, unavailable, or install-first candidate can never read as a clean, immediately-selectable choice. Each kernel origin pill names where the current kernel physically runs, how trusted that origin is, its derived provenance class, its environment fingerprint state, and whether reattaching/rerunning keeps exact continuity, and offers inspect/view-provenance/copy actions; its provenance class is derived from the origin trust state, so a third-party, unverified, restricted, or unknown origin can never read as exact provenance, and exact continuity may be claimed only when the environment fingerprint matches and provenance is exact. Every next step names one stable kernel-manager/notebook/docs/support deep link rather than an ephemeral overlay or hidden route. No component collapses local/SSH/container/managed/browser-bridge kernels into one badge, implies exact continuity when the environment fingerprint differs materially, hides trust or compatibility behind a hover-only affordance, or overwrites resolved provenance with lower-confidence provenance without review; raw notebook payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "picker_rows",
    "origin_pills",
    "downgrade_triggers",
    "consumer_surfaces",
    "kernel_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_kernel_picker_rows_and_kernel_origin_pills_with_kernel_class_environment_identity_locality_trust_limits_exact_or_degraded_provenance_and_rerun_reattach_continuity_across_claimed_m5_notebook_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "picker_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kernel_picker_row" }
    },
    "origin_pills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kernel_origin_pill" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "kernel_review": { "$ref": "#/$defs/kernel_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "kernel_candidate_kind": {
      "enum": [
        "local_interpreter",
        "virtual_env",
        "conda_env",
        "container_kernel",
        "remote_kernel",
        "managed_kernel"
      ]
    },
    "kernel_selection_state": {
      "enum": [
        "selected",
        "available",
        "recommended",
        "incompatible",
        "unavailable",
        "needs_install"
      ]
    },
    "kernel_choice_state": {
      "enum": [
        "currently_selected",
        "recommended_choice",
        "available_choice",
        "needs_setup_first",
        "incompatible_choice",
        "unavailable_choice"
      ]
    },
    "kernel_origin_class": {
      "enum": [
        "local_host",
        "ssh_remote",
        "container",
        "devcontainer",
        "managed_workspace",
        "browser_bridge"
      ]
    },
    "kernel_origin_trust_state": {
      "enum": [
        "trusted_origin",
        "first_party",
        "third_party",
        "unverified_origin",
        "restricted_origin",
        "unknown_origin"
      ]
    },
    "kernel_provenance_class": {
      "enum": [
        "exact_provenance",
        "degraded_provenance",
        "restricted_provenance",
        "unknown_provenance"
      ]
    },
    "kernel_fingerprint_state": {
      "enum": [
        "fingerprint_matched",
        "fingerprint_drifted",
        "fingerprint_unknown",
        "fingerprint_not_evaluated"
      ]
    },
    "deep_link_kind": {
      "enum": [
        "notebook_location",
        "kernel_manager",
        "docs_anchor",
        "support_bundle",
        "no_deep_link"
      ]
    },
    "picker_action": {
      "enum": [
        "choose_kernel",
        "inspect_candidate",
        "view_compatibility",
        "keep_current_kernel",
        "install_kernel",
        "open_deep_link"
      ]
    },
    "pill_action": {
      "enum": [
        "inspect_origin",
        "view_provenance",
        "copy_origin_identity",
        "reattach_kernel",
        "review_continuity",
        "open_deep_link"
      ]
    },
    "disposition": {
      "enum": [
        "no_kernel",
        "queued",
        "busy",
        "ready",
        "disconnected",
        "managed",
        "remote",
        "stale_output",
        "sanitized",
        "active",
        "reconnect",
        "restart_clean",
        "choose_another_kernel"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "kernel_origin_and_class",
        "output_trust_and_freshness",
        "restart_and_recovery"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook_surface",
        "kernel_manager_surface",
        "output_viewer_surface",
        "debug_surface",
        "review_surface",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "notebook_ui",
        "kernel_manager_ui",
        "output_viewer_ui",
        "debugger_ui",
        "ai_context_ui",
        "review_ui",
        "cli_surface",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "kernel_origin_unstated",
        "kernel_class_collapsed",
        "document_identity_unstated",
        "output_trust_unstated",
        "stale_output_shown_as_live",
        "trust_class_hover_only",
        "provenance_severed",
        "restart_consequence_implied_rerun",
        "recovery_overclaimed",
        "reconnect_shown_as_fresh",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "kernel_picker_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "row_label",
        "candidate_kind",
        "selection_state",
        "choice_state",
        "claims_selectable_now",
        "claims_current",
        "incompatible_note",
        "unavailable_note",
        "install_note",
        "kernel_class_label",
        "environment_identity_label",
        "locality_label",
        "compatibility_note",
        "trust_policy_limit_note",
        "last_seen_label",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "picker_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "collapses_kernel_origins_into_one_badge",
        "implies_exact_continuity_on_material_drift",
        "hides_trust_or_compatibility_behind_hover_only",
        "overwrites_provenance_without_review"
      ],
      "properties": {
        "component": { "const": "kernel_picker_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "row_label": { "$ref": "#/$defs/non_empty_string" },
        "candidate_kind": { "$ref": "#/$defs/kernel_candidate_kind" },
        "selection_state": { "$ref": "#/$defs/kernel_selection_state" },
        "choice_state": { "$ref": "#/$defs/kernel_choice_state" },
        "claims_selectable_now": { "type": "boolean" },
        "claims_current": { "type": "boolean" },
        "incompatible_note": { "type": "string" },
        "unavailable_note": { "type": "string" },
        "install_note": { "type": "string" },
        "kernel_class_label": { "$ref": "#/$defs/non_empty_string" },
        "environment_identity_label": { "$ref": "#/$defs/non_empty_string" },
        "locality_label": { "$ref": "#/$defs/non_empty_string" },
        "compatibility_note": { "$ref": "#/$defs/non_empty_string" },
        "trust_policy_limit_note": { "$ref": "#/$defs/non_empty_string" },
        "last_seen_label": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "picker_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "choose_kernel" } },
            { "contains": { "const": "inspect_candidate" } },
            { "contains": { "const": "view_compatibility" } }
          ],
          "items": { "$ref": "#/$defs/picker_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_kernel_origins_into_one_badge": { "const": false },
        "implies_exact_continuity_on_material_drift": { "const": false },
        "hides_trust_or_compatibility_behind_hover_only": { "const": false },
        "overwrites_provenance_without_review": { "const": false }
      }
    },
    "kernel_origin_pill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "pill_id",
        "pill_label",
        "origin_class",
        "trust_state",
        "fingerprint_state",
        "provenance_class",
        "claims_exact_provenance",
        "claims_exact_continuity",
        "degraded_note",
        "restricted_note",
        "unknown_origin_note",
        "drift_note",
        "origin_label",
        "provenance_label",
        "trust_limit_note",
        "continuity_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "pill_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "collapses_kernel_origins_into_one_badge",
        "implies_exact_continuity_on_material_drift",
        "hides_trust_or_compatibility_behind_hover_only",
        "overwrites_provenance_without_review"
      ],
      "properties": {
        "component": { "const": "kernel_origin_pill" },
        "pill_id": { "$ref": "#/$defs/non_empty_string" },
        "pill_label": { "$ref": "#/$defs/non_empty_string" },
        "origin_class": { "$ref": "#/$defs/kernel_origin_class" },
        "trust_state": { "$ref": "#/$defs/kernel_origin_trust_state" },
        "fingerprint_state": { "$ref": "#/$defs/kernel_fingerprint_state" },
        "provenance_class": { "$ref": "#/$defs/kernel_provenance_class" },
        "claims_exact_provenance": { "type": "boolean" },
        "claims_exact_continuity": { "type": "boolean" },
        "degraded_note": { "type": "string" },
        "restricted_note": { "type": "string" },
        "unknown_origin_note": { "type": "string" },
        "drift_note": { "type": "string" },
        "origin_label": { "$ref": "#/$defs/non_empty_string" },
        "provenance_label": { "$ref": "#/$defs/non_empty_string" },
        "trust_limit_note": { "$ref": "#/$defs/non_empty_string" },
        "continuity_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "pill_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "inspect_origin" } },
            { "contains": { "const": "view_provenance" } },
            { "contains": { "const": "copy_origin_identity" } }
          ],
          "items": { "$ref": "#/$defs/pill_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_kernel_origins_into_one_badge": { "const": false },
        "implies_exact_continuity_on_material_drift": { "const": false },
        "hides_trust_or_compatibility_behind_hover_only": { "const": false },
        "overwrites_provenance_without_review": { "const": false }
      }
    },
    "kernel_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "picker_shows_kernel_class",
        "picker_shows_environment_identity",
        "picker_shows_compatibility_and_trust_limits",
        "picker_offers_choose_inspect_compatibility",
        "pill_shows_kernel_origin_class",
        "pill_shows_provenance_confidence",
        "pill_offers_inspect_provenance_copy",
        "provenance_and_choice_derived_never_asserted",
        "choose_another_kernel_without_losing_provenance",
        "kernel_origin_visible_in_tabs_headers_debug_support",
        "exact_continuity_never_implied_on_material_drift",
        "no_kernel_origins_collapsed_into_one_badge",
        "trust_and_compatibility_never_hover_only",
        "every_next_step_names_stable_deep_link",
        "picker_and_pill_consistent_across_surfaces",
        "no_component_widens_export_scope_or_exposes_raw_by_default",
        "components_stable_across_deployment_lines",
        "copy_and_export_safe",
        "no_surface_invents_alternate_state_label",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_manager_surface_reads_single_source",
        "notebook_tab_shows_kernel_origin",
        "debug_bridge_shows_kernel_origin",
        "support_export_shows_kernel_origin",
        "picker_choice_visible_before_run",
        "help_docs_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
