{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-coverage-import-merge-sheet.schema.json",
  "title": "Aureline M5 coverage-import-merge-sheet resolution case",
  "description": "Companion schema for the M5 coverage-import / merge sheet half of the snapshot-review-card / coverage-import-merge-sheet twin primitive. It describes one worked coverage-import / merge sheet resolution case: an input import / merge state and its resolved truth. The resolved truth carries the frozen controlled merge vocabulary (merged-clean/shard-omission/conflicting-overlap/partial-merge/superseded/merge-unavailable) as its derived merge posture, the coverage import source (local-run/imported-CI/cached-local/stale-prior/uploaded/unknown), the line-versus-branch metric kinds, the included and excluded run labels, whether omitted shards are exposed, whether a stale-or-incompatible warning is disclosed, whether the sheet discloses its metric dimension, whether the report is imported, whether the merged number may be treated as exact current truth, and the bounded reveal/review-run-scope/open-incompatible/export actions. The canonical packet schema that embeds these cases is m5-snapshot-review-card.schema.json. Raw snapshot payloads, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "resolved"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_source",
        "merge_resolution",
        "metric_kinds",
        "included_runs",
        "excluded_runs",
        "provenance_class",
        "is_stale",
        "is_incompatible",
        "claims_exact_current_truth",
        "commit_identity_ref",
        "build_identity_ref",
        "sheet_identity_ref"
      ],
      "properties": {
        "import_source": { "$ref": "#/$defs/import_source" },
        "merge_resolution": { "$ref": "#/$defs/merge_resolution" },
        "metric_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric_kind" }
        },
        "included_runs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded_runs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "is_stale": { "type": "boolean" },
        "is_incompatible": { "type": "boolean" },
        "claims_exact_current_truth": { "type": "boolean" },
        "commit_identity_ref": { "type": "string", "minLength": 1 },
        "build_identity_ref": { "type": "string", "minLength": 1 },
        "sheet_identity_ref": { "type": "string", "minLength": 1 }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_source",
        "merge_resolution",
        "metric_kinds",
        "included_runs",
        "excluded_runs",
        "provenance_class",
        "is_stale",
        "is_incompatible",
        "commit_identity_ref",
        "build_identity_ref",
        "sheet_identity_ref",
        "merge_posture",
        "available_actions",
        "exposes_omitted_shards",
        "discloses_stale_or_incompatible",
        "discloses_metric_dimension",
        "is_imported",
        "is_exact_current_truth",
        "exact_truth_is_qualified",
        "discloses_resulting_scope",
        "needs_attention"
      ],
      "properties": {
        "import_source": { "$ref": "#/$defs/import_source" },
        "merge_resolution": { "$ref": "#/$defs/merge_resolution" },
        "metric_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric_kind" }
        },
        "included_runs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded_runs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance_class": { "$ref": "#/$defs/provenance_class" },
        "is_stale": { "type": "boolean" },
        "is_incompatible": { "type": "boolean" },
        "commit_identity_ref": { "type": "string", "minLength": 1 },
        "build_identity_ref": { "type": "string", "minLength": 1 },
        "sheet_identity_ref": { "type": "string", "minLength": 1 },
        "merge_posture": {
          "enum": [
            "merged_clean_sheet",
            "shard_omission_sheet",
            "conflicting_overlap_sheet",
            "partial_merge_sheet",
            "superseded_sheet",
            "merge_unavailable_sheet"
          ]
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reveal_merge_details",
              "review_run_scope",
              "open_incompatible_report",
              "export_merge_sheet"
            ]
          }
        },
        "exposes_omitted_shards": { "type": "boolean" },
        "discloses_stale_or_incompatible": { "type": "boolean" },
        "discloses_metric_dimension": { "const": true },
        "is_imported": { "type": "boolean" },
        "is_exact_current_truth": { "type": "boolean" },
        "exact_truth_is_qualified": { "const": true },
        "discloses_resulting_scope": { "const": true },
        "needs_attention": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "import_source": {
      "enum": [
        "local_run",
        "imported_ci_artifact",
        "cached_local",
        "stale_prior",
        "uploaded_report",
        "unknown_source"
      ]
    },
    "merge_resolution": {
      "enum": [
        "merged_clean",
        "shard_omission_detected",
        "conflicting_overlap",
        "partial_merge",
        "superseded_by_newer",
        "merge_unavailable"
      ]
    },
    "metric_kind": {
      "enum": [
        "line_coverage",
        "branch_coverage",
        "function_coverage",
        "statement_coverage",
        "region_coverage",
        "combined_metric"
      ]
    },
    "provenance_class": {
      "enum": [
        "verified_current_run",
        "imported_ci_artifact",
        "cached_local_result",
        "stale_prior_result",
        "suspected_flaky",
        "reproduced_flaky",
        "stable_again",
        "manually_muted",
        "unknown"
      ]
    }
  }
}
