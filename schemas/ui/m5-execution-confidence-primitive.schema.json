{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-execution-confidence-primitive.schema.json",
  "title": "Aureline M5 execution-confidence primitive",
  "description": "Canonical parity matrix for the reusable M5 execution-confidence primitive: an adapter-drift banner (prior versus current adapter, capability delta, affected targets, recompute / open-diagnostics actions), a run / test / debug launcher-state projection, a launcher-state-parity fan-out onto problem surfaces, artifact views, and follow-on automation / AI, and a no-higher-confidence overwrite guard — all resolved from one execution-target context that shares one target identity and one disclosed adapter source. Execution lanes narrow affordances before launch when adapter capability drops (AC1); adapter drift and affected targets are visible before action (AC2); lower-confidence or fallback results never masquerade as native, protocol-backed truth (AC3). Raw build output, event payloads, credentials, and endpoint data never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_execution_confidence_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "adapter_drift_banner",
        "execution_launcher",
        "launcher_state_parity",
        "overwrite_guard",
        "support_export_replay"
      ]
    },
    "parity_surface": {
      "enum": ["problem_surface", "artifact_view", "follow_on_automation", "ai_action"]
    },
    "capability_delta_kind": {
      "enum": ["gained", "retained", "downgraded", "lost"]
    },
    "affordance_state": {
      "enum": ["available", "narrowed", "blocked"]
    },
    "overwrite_verdict": {
      "enum": [
        "promoted_higher_confidence",
        "matched_existing_confidence",
        "recorded_explicit_downgrade"
      ]
    },
    "action_kind": {
      "enum": [
        "recompute",
        "open_diagnostics",
        "inspect_capabilities",
        "copy_export",
        "open_source_truth",
        "acknowledge_downgrade"
      ]
    },
    "export_field": {
      "enum": [
        "target_id",
        "target_identity",
        "prior_adapter",
        "current_adapter",
        "confidence",
        "freshness",
        "overwrite_verdict"
      ]
    },
    "build_verb": {
      "enum": ["build", "test", "run", "debug", "coverage", "package"]
    },
    "adapter_source_kind": {
      "enum": [
        "native_build_server",
        "native_build_event",
        "heuristic_parse",
        "imported_snapshot",
        "provider_overlay",
        "unknown"
      ]
    },
    "capability_state": {
      "enum": ["supported", "partial", "unsupported", "unknown", "provider_gated"]
    },
    "fallback_confidence_state": {
      "enum": [
        "structured_high",
        "structured_degraded",
        "heuristic_fallback",
        "imported_only",
        "unknown"
      ]
    },
    "target_graph_node_kind": {
      "enum": [
        "build_target",
        "test_target",
        "run_target",
        "dependency_edge",
        "container_target"
      ]
    },
    "truth_mode_enum": {
      "enum": ["desired", "rendered", "plan", "live", "provider_overlay"]
    },
    "resource_freshness": {
      "enum": ["live_fresh", "cached_stale", "imported_snapshot", "plan_only", "unknown"]
    },
    "discovery_confidence": {
      "enum": ["high", "medium", "low", "unknown"]
    },
    "downgrade_trigger": {
      "enum": [
        "schema_stale",
        "adapter_unavailable",
        "connector_loss",
        "policy_block",
        "drift_from_source",
        "low_confidence_discovery",
        "structured_channel_lost",
        "target_context_unresolved"
      ]
    },
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kind", "stable_id", "owning_module", "workspace_root"],
      "properties": {
        "node_kind": { "$ref": "#/$defs/target_graph_node_kind" },
        "stable_id": { "type": "string", "minLength": 1 },
        "owning_module": { "type": "string", "minLength": 1 },
        "workspace_root": { "type": "string", "minLength": 1 }
      }
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "verb_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "prior_state", "current_state"],
      "properties": {
        "verb": { "$ref": "#/$defs/build_verb" },
        "prior_state": { "$ref": "#/$defs/capability_state" },
        "current_state": { "$ref": "#/$defs/capability_state" }
      }
    },
    "resolved_verb_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "prior_state", "current_state", "delta"],
      "properties": {
        "verb": { "$ref": "#/$defs/build_verb" },
        "prior_state": { "$ref": "#/$defs/capability_state" },
        "current_state": { "$ref": "#/$defs/capability_state" },
        "delta": { "$ref": "#/$defs/capability_delta_kind" }
      }
    },
    "resolved_launch_affordance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "current_state", "affordance", "launchable_before_run"],
      "properties": {
        "verb": { "$ref": "#/$defs/build_verb" },
        "current_state": { "$ref": "#/$defs/capability_state" },
        "affordance": { "$ref": "#/$defs/affordance_state" },
        "launchable_before_run": { "type": "boolean" }
      }
    },
    "resolved_parity_consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "adapter_source",
        "confidence",
        "carries_adapter_source",
        "carries_confidence"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/parity_surface" },
        "adapter_source": { "$ref": "#/$defs/adapter_source_kind" },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "carries_adapter_source": { "const": true },
        "carries_confidence": { "const": true }
      }
    },
    "execution_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_ref",
        "target_label",
        "identity",
        "truth_mode",
        "prior_adapter",
        "current_adapter",
        "adapter_version",
        "confidence",
        "freshness",
        "fallback_state",
        "verbs",
        "affected_targets",
        "parity_consumers",
        "existing_confidence",
        "existing_adapter",
        "downgrade_acknowledged",
        "available_actions"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "target_ref": { "$ref": "#/$defs/ref" },
        "target_label": { "type": "string", "minLength": 1 },
        "identity": { "$ref": "#/$defs/target_identity" },
        "truth_mode": { "$ref": "#/$defs/truth_mode_enum" },
        "prior_adapter": { "$ref": "#/$defs/adapter_source_kind" },
        "current_adapter": { "$ref": "#/$defs/adapter_source_kind" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "freshness": { "$ref": "#/$defs/resource_freshness" },
        "fallback_state": { "$ref": "#/$defs/fallback_confidence_state" },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verb_input" }
        },
        "affected_targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target_identity" }
        },
        "divergence_note": { "type": "string" },
        "parity_consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parity_surface" }
        },
        "existing_confidence": { "$ref": "#/$defs/discovery_confidence" },
        "existing_adapter": { "$ref": "#/$defs/adapter_source_kind" },
        "downgrade_acknowledged": { "type": "boolean" },
        "downgrade_note": { "type": "string" },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_kind" }
        },
        "degraded": { "$ref": "#/$defs/degraded_state" }
      }
    },
    "resolved_drift_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "prior_adapter",
        "current_adapter",
        "adapter_changed",
        "capability_delta",
        "gained_verbs",
        "downgraded_verbs",
        "lost_verbs",
        "affected_targets",
        "drift_detected",
        "actions",
        "visible_before_action"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "prior_adapter": { "$ref": "#/$defs/adapter_source_kind" },
        "current_adapter": { "$ref": "#/$defs/adapter_source_kind" },
        "adapter_changed": { "type": "boolean" },
        "capability_delta": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_verb_delta" }
        },
        "gained_verbs": { "type": "array", "items": { "$ref": "#/$defs/build_verb" } },
        "downgraded_verbs": { "type": "array", "items": { "$ref": "#/$defs/build_verb" } },
        "lost_verbs": { "type": "array", "items": { "$ref": "#/$defs/build_verb" } },
        "affected_targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target_identity" }
        },
        "drift_detected": { "type": "boolean" },
        "divergence_note": { "type": ["string", "null"] },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_kind" }
        },
        "visible_before_action": { "const": true }
      }
    },
    "resolved_launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "adapter_source",
        "confidence",
        "freshness",
        "affordances",
        "blocked_verbs",
        "narrowed_before_launch",
        "carries_adapter_source_and_confidence"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "adapter_source": { "$ref": "#/$defs/adapter_source_kind" },
        "confidence": { "$ref": "#/$defs/discovery_confidence" },
        "freshness": { "$ref": "#/$defs/resource_freshness" },
        "affordances": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_launch_affordance" }
        },
        "blocked_verbs": { "type": "array", "items": { "$ref": "#/$defs/build_verb" } },
        "narrowed_before_launch": { "type": "boolean" },
        "carries_adapter_source_and_confidence": { "const": true }
      }
    },
    "resolved_overwrite_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "existing_adapter",
        "existing_confidence",
        "incoming_adapter",
        "incoming_confidence",
        "verdict",
        "explicit_downgrade_recorded",
        "preserves_higher_confidence_truth",
        "never_overwrites_higher_silently"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "existing_adapter": { "$ref": "#/$defs/adapter_source_kind" },
        "existing_confidence": { "$ref": "#/$defs/discovery_confidence" },
        "incoming_adapter": { "$ref": "#/$defs/adapter_source_kind" },
        "incoming_confidence": { "$ref": "#/$defs/discovery_confidence" },
        "verdict": { "$ref": "#/$defs/overwrite_verdict" },
        "explicit_downgrade_recorded": { "type": "boolean" },
        "preserves_higher_confidence_truth": { "const": true },
        "downgrade_note": { "type": ["string", "null"] },
        "never_overwrites_higher_silently": { "const": true },
        "downgrade_trigger": {
          "oneOf": [{ "$ref": "#/$defs/downgrade_trigger" }, { "type": "null" }]
        }
      }
    },
    "resolved_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "drift_banner",
        "launcher",
        "parity_consumers",
        "overwrite_guard",
        "affordances_narrowed_before_launch",
        "drift_visible_before_action",
        "lower_confidence_never_masquerades"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/id" },
        "drift_banner": { "$ref": "#/$defs/resolved_drift_banner" },
        "launcher": { "$ref": "#/$defs/resolved_launcher" },
        "parity_consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_parity_consumer" }
        },
        "overwrite_guard": { "$ref": "#/$defs/resolved_overwrite_guard" },
        "affordances_narrowed_before_launch": { "type": "boolean" },
        "drift_visible_before_action": { "const": true },
        "lower_confidence_never_masquerades": { "const": true },
        "degraded": {
          "oneOf": [{ "$ref": "#/$defs/degraded_state" }, { "type": "null" }]
        }
      }
    },
    "execution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/execution_input" },
        "resolved": { "$ref": "#/$defs/resolved_execution" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "adapter_source_kinds",
        "truth_modes",
        "build_verbs",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_confidence",
        "hides_adapter_source",
        "narrows_after_launch",
        "hides_drift",
        "allows_silent_overwrite"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "adapter_source_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/adapter_source_kind" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode_enum" }
        },
        "build_verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/build_verb" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_confidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/execution_case" }
        },
        "hides_adapter_source": { "const": false },
        "narrows_after_launch": { "const": false },
        "hides_drift": { "const": false },
        "allows_silent_overwrite": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "parity_surfaces",
        "capability_delta_kinds",
        "affordance_states",
        "overwrite_verdicts",
        "action_kinds",
        "export_fields",
        "build_verbs",
        "adapter_source_kinds",
        "capability_states",
        "fallback_confidence_states",
        "truth_modes",
        "resource_freshness",
        "discovery_confidence",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "parity_surfaces": { "type": "array", "items": { "type": "string" } },
        "capability_delta_kinds": { "type": "array", "items": { "type": "string" } },
        "affordance_states": { "type": "array", "items": { "type": "string" } },
        "overwrite_verdicts": { "type": "array", "items": { "type": "string" } },
        "action_kinds": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "build_verbs": { "type": "array", "items": { "type": "string" } },
        "adapter_source_kinds": { "type": "array", "items": { "type": "string" } },
        "capability_states": { "type": "array", "items": { "type": "string" } },
        "fallback_confidence_states": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "resource_freshness": { "type": "array", "items": { "type": "string" } },
        "discovery_confidence": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "target_identity_preserved_across_surfaces",
        "adapter_drift_visible_before_action",
        "affordances_narrow_before_launch",
        "lower_confidence_never_overwrites_silently",
        "launcher_state_parity_carries_source_and_confidence",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "target_identity_preserved_across_surfaces": { "const": true },
        "adapter_drift_visible_before_action": { "const": true },
        "affordances_narrow_before_launch": { "const": true },
        "lower_confidence_never_overwrites_silently": { "const": true },
        "launcher_state_parity_carries_source_and_confidence": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "launchers_read_single_confidence_source",
        "support_and_ai_reuse_shared_component"
      ],
      "properties": {
        "execution_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "launchers_read_single_confidence_source": { "const": true },
        "support_and_ai_reuse_shared_component": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "confidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "confidence_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
