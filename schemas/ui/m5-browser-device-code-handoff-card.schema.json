{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-browser-device-code-handoff-card.schema.json",
  "title": "Aureline M5 browser/device-code handoff card component",
  "description": "Names the auth-handoff class currently in flight and which identity it carries \u2014 so a user always knows how authentication will complete and never has to infer whether a browser or device-code flow is under way. Canonical per-component contract frozen by the M5 credential component matrix (schemas/ui/m5-credential-component-matrix.schema.json); downstream M5 rows point at this schema instead of restating credential UI truth by hand. Raw secret values, tokens, passphrases, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "auth_handoff_class",
    "delegated_identity_state",
    "degraded_state",
    "required_labels"
  ],
  "properties": {
    "component_family": {
      "const": "browser_device_code_handoff_card"
    },
    "auth_handoff_class": {
      "enum": [
        "system_browser_redirect",
        "device_code_poll",
        "embedded_prompt",
        "passkey_step_up",
        "delegated_forward",
        "offline_deferred"
      ]
    },
    "delegated_identity_state": {
      "enum": [
        "local_identity",
        "forwarded_identity",
        "delegated_on_behalf",
        "impersonation_scoped",
        "service_account_acting",
        "delegation_revoked"
      ]
    },
    "degraded_state": {
      "enum": [
        "fully_available",
        "limited_capability",
        "stale_needs_reauth",
        "offline_cached",
        "policy_blocked",
        "unavailable"
      ]
    },
    "required_labels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "state",
          "keyboard_route",
          "storage_and_reveal_posture",
          "identity_and_delegation",
          "expiry_and_export_boundary"
        ]
      }
    }
  }
}
