{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-toast-and-loading-state-controls.schema.json",
  "title": "Aureline M5 toast and loading-state controls",
  "description": "Export-safe packet for the fourth implement lane over the frozen M5 decision-feedback component matrix. It carries resolved, honest projections of the toast and the loading state across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved toast examples (naming the label, the toast durability with no toast-only truth, the state disposition, the surface context, the acknowledgement scope, the durable-object backlink target, and the transient/durable-backlink-when-outcome-matters/bounded-action/no-toast-only-truth/reconstructable truth) and the resolved loading-state examples (naming the label, the loading fidelity with no full-screen spinner where partial capability exists, the state disposition, the surface context, the loading treatment, the readiness posture, and the partial-content-preserved/no-blanked-pane/no-readiness-overclaim/purpose-stated/reconstructable truth). Hard invariants forbid toasts representing durable work as toast-only truth, toasts omitting a durable backlink when the outcome matters, loading states blanking a useful pane, and loading states using a full-screen spinner where partial capability exists. Acceptance criteria — claimed toasts always point back to a durable object when the result matters after dismissal; loading states preserve useful partial content and do not overclaim readiness while data is warming or blocked; and release/help/support packets can explain why a toast appeared or a loading state persisted without losing object identity — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_toast_and_loading_state_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "toast_example": {
      "type": "object",
      "required": [
        "toast_id",
        "toast_label",
        "toast_durability",
        "durability_is_toast_only",
        "disposition",
        "surface_context",
        "acknowledgement_scope",
        "backlink_target",
        "acknowledges_transiently",
        "outcome_matters_after_dismissal",
        "durable_backlink_present",
        "bounded_action_present",
        "action_is_bounded",
        "avoids_toast_only_truth",
        "reconstructable_from_export",
        "degrade_reason",
        "next_action",
        "acknowledges_without_becoming_only_truth"
      ],
      "properties": {
        "toast_id": { "$ref": "#/$defs/non_empty_string" },
        "toast_label": { "type": "string" },
        "toast_durability": { "$ref": "#/$defs/non_empty_string" },
        "durability_is_toast_only": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "acknowledgement_scope": { "$ref": "#/$defs/non_empty_string" },
        "backlink_target": { "$ref": "#/$defs/non_empty_string" },
        "acknowledges_transiently": { "type": "boolean" },
        "outcome_matters_after_dismissal": { "type": "boolean" },
        "durable_backlink_present": { "type": "boolean" },
        "bounded_action_present": { "type": "boolean" },
        "action_is_bounded": { "type": "boolean" },
        "avoids_toast_only_truth": { "type": "boolean" },
        "reconstructable_from_export": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "acknowledges_without_becoming_only_truth": { "type": "boolean" }
      }
    },
    "loading_state_example": {
      "type": "object",
      "required": [
        "loading_state_id",
        "loading_label",
        "loading_fidelity",
        "fidelity_is_full_screen_spinner",
        "disposition",
        "surface_context",
        "loading_treatment",
        "readiness_posture",
        "partial_content_available",
        "partial_content_preserved",
        "pane_blanked",
        "overclaims_readiness",
        "purpose_stated",
        "reconstructable_from_export",
        "degrade_reason",
        "next_action",
        "preserves_partial_and_readiness_honesty"
      ],
      "properties": {
        "loading_state_id": { "$ref": "#/$defs/non_empty_string" },
        "loading_label": { "type": "string" },
        "loading_fidelity": { "$ref": "#/$defs/non_empty_string" },
        "fidelity_is_full_screen_spinner": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/non_empty_string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "loading_treatment": { "$ref": "#/$defs/non_empty_string" },
        "readiness_posture": { "$ref": "#/$defs/non_empty_string" },
        "partial_content_available": { "type": "boolean" },
        "partial_content_preserved": { "type": "boolean" },
        "pane_blanked": { "type": "boolean" },
        "overclaims_readiness": { "type": "boolean" },
        "purpose_stated": { "type": "boolean" },
        "reconstructable_from_export": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "preserves_partial_and_readiness_honesty": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "toast_examples",
        "loading_state_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "toast_represents_durable_work_as_toast_only",
        "toast_lacks_durable_backlink_when_outcome_matters",
        "loading_blanks_useful_pane",
        "loading_uses_full_screen_spinner_when_partial_capable"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "toast_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/toast_example" }
        },
        "loading_state_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/loading_state_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "toast_represents_durable_work_as_toast_only": { "const": false },
        "toast_lacks_durable_backlink_when_outcome_matters": { "const": false },
        "loading_blanks_useful_pane": { "const": false },
        "loading_uses_full_screen_spinner_when_partial_capable": { "const": false }
      }
    }
  }
}
