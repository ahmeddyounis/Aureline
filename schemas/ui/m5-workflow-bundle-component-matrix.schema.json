{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-workflow-bundle-component-matrix.schema.json",
  "title": "M5 Workflow-Bundle Component Matrix",
  "description": "Frozen reusable workflow-bundle component family: start-center bundle cards, certified-archetype badge groups, bundle detail pages, install/update review sheets, drift banners, local-override rows, rollback/remove cards, bundle class disclosure cards, and claim-narrowing rows. Every consumer projects from this one matrix instead of inventing private badge or stale-claim wording.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "set_label",
    "components",
    "guardrails",
    "consumer_projection",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_workflow_bundle_component_matrix" },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "set_label": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "guardrails": { "$ref": "#/$defs/guardrails" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component_family": {
      "enum": [
        "start_center_bundle_card",
        "certified_archetype_badge_group",
        "bundle_detail_page",
        "bundle_install_update_review_sheet",
        "bundle_drift_banner",
        "bundle_local_override_row",
        "bundle_rollback_remove_card",
        "bundle_class_disclosure_card",
        "bundle_claim_narrowing_row"
      ]
    },
    "truth_mode": {
      "enum": ["live", "mirrored", "cached_offline", "imported", "provider_supplied"]
    },
    "bundle_class": {
      "enum": [
        "launch_bundle",
        "framework_pack",
        "template_bundle",
        "imported_handoff_bundle",
        "org_managed_bundle",
        "no_bundle"
      ]
    },
    "source_trust": {
      "enum": ["first_party", "trusted_remote", "unverified_remote", "untrusted"]
    },
    "lifecycle_stage": {
      "enum": ["stable", "preview", "labs", "policy_gated", "mirror_only", "bounded_platform"]
    },
    "certification_target": {
      "enum": [
        "certified",
        "managed_approved",
        "community_reviewed",
        "imported_pending_review",
        "local_draft"
      ]
    },
    "evidence_freshness": { "enum": ["fresh", "aging", "stale", "missing"] },
    "archetype_confidence": { "enum": ["confirmed", "probable", "mixed", "undetected"] },
    "bundle_scorecard_class": {
      "enum": ["certified", "probable", "community", "imported", "preview", "local_draft"]
    },
    "imported_vs_native_confidence": {
      "enum": ["native", "bridged", "approximated", "unverified"]
    },
    "review_operation": { "enum": ["install", "update", "remove", "drift_review"] },
    "diff_action": { "enum": ["added", "removed", "modified", "unchanged"] },
    "asset_ownership": {
      "enum": [
        "bundle_owned",
        "locally_overridden",
        "adopted",
        "removable",
        "blocked_by_policy",
        "blocked_by_lifecycle"
      ]
    },
    "resolution_choice": {
      "enum": [
        "keep_local",
        "adopt_bundle",
        "rebase",
        "compare",
        "remove_bundle_owned",
        "not_applicable"
      ]
    },
    "drift_state": {
      "enum": ["in_sync", "local_ahead", "bundle_ahead", "diverged", "unknown"]
    },
    "required_label": {
      "enum": [
        "bundle_identity",
        "signer_source",
        "support_class",
        "certification_freshness",
        "mirror_offline_posture",
        "keyboard_route"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "stale_certification",
        "mirror_stale",
        "offline_cache_only",
        "unverified_signer",
        "local_override_drift",
        "incompatible_aureline",
        "entitlement_dependency_unmet",
        "imported_not_native",
        "rollback_only_path"
      ]
    },
    "degraded_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "start_center_bundle_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id_ref",
        "bundle_class",
        "signer_source",
        "lifecycle_stage",
        "certification",
        "certification_freshness",
        "compatible_aureline_range",
        "discloses_signer_source",
        "discloses_certification_freshness"
      ],
      "properties": {
        "bundle_id_ref": { "type": "string", "minLength": 1 },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/source_trust" },
        "lifecycle_stage": { "$ref": "#/$defs/lifecycle_stage" },
        "certification": { "$ref": "#/$defs/certification_target" },
        "certification_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "discloses_signer_source": { "type": "boolean" },
        "discloses_certification_freshness": { "type": "boolean" }
      }
    },
    "certified_archetype_badge_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype_family_ref",
        "archetype_confidence",
        "certification",
        "certification_freshness",
        "badge_count",
        "invents_private_badge_meaning",
        "discloses_certification_freshness"
      ],
      "properties": {
        "archetype_family_ref": { "type": "string", "minLength": 1 },
        "archetype_confidence": { "$ref": "#/$defs/archetype_confidence" },
        "certification": { "$ref": "#/$defs/certification_target" },
        "certification_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "badge_count": { "type": "integer", "minimum": 1 },
        "invents_private_badge_meaning": { "type": "boolean" },
        "discloses_certification_freshness": { "type": "boolean" }
      }
    },
    "bundle_detail_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id_ref",
        "signer_source",
        "certification",
        "certification_freshness",
        "compatible_aureline_range",
        "lists_entitlement_dependencies",
        "discloses_mirror_offline_posture"
      ],
      "properties": {
        "bundle_id_ref": { "type": "string", "minLength": 1 },
        "signer_source": { "$ref": "#/$defs/source_trust" },
        "certification": { "$ref": "#/$defs/certification_target" },
        "certification_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "compatible_aureline_range": { "type": "string", "minLength": 1 },
        "lists_entitlement_dependencies": { "type": "boolean" },
        "discloses_mirror_offline_posture": { "type": "boolean" }
      }
    },
    "bundle_install_update_review_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id_ref",
        "operation",
        "diff_scope",
        "local_override_state",
        "resolution",
        "reviewed_before_apply",
        "discloses_diff_scope"
      ],
      "properties": {
        "bundle_id_ref": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/review_operation" },
        "diff_scope": { "$ref": "#/$defs/diff_action" },
        "local_override_state": { "$ref": "#/$defs/asset_ownership" },
        "resolution": { "$ref": "#/$defs/resolution_choice" },
        "reviewed_before_apply": { "type": "boolean" },
        "discloses_diff_scope": { "type": "boolean" }
      }
    },
    "bundle_drift_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id_ref",
        "drift_state",
        "local_override_state",
        "reads_like_generic_package_update",
        "discloses_override_state"
      ],
      "properties": {
        "bundle_id_ref": { "type": "string", "minLength": 1 },
        "drift_state": { "$ref": "#/$defs/drift_state" },
        "local_override_state": { "$ref": "#/$defs/asset_ownership" },
        "reads_like_generic_package_update": { "type": "boolean" },
        "discloses_override_state": { "type": "boolean" }
      }
    },
    "bundle_local_override_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_ref",
        "ownership",
        "resolution",
        "diff_scope",
        "preserves_local_override",
        "discloses_ownership"
      ],
      "properties": {
        "asset_ref": { "type": "string", "minLength": 1 },
        "ownership": { "$ref": "#/$defs/asset_ownership" },
        "resolution": { "$ref": "#/$defs/resolution_choice" },
        "diff_scope": { "$ref": "#/$defs/diff_action" },
        "preserves_local_override": { "type": "boolean" },
        "discloses_ownership": { "type": "boolean" }
      }
    },
    "bundle_rollback_remove_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id_ref",
        "operation",
        "removable_ownership",
        "discloses_rollback_path",
        "discloses_side_effects"
      ],
      "properties": {
        "bundle_id_ref": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/review_operation" },
        "removable_ownership": { "$ref": "#/$defs/asset_ownership" },
        "discloses_rollback_path": { "type": "boolean" },
        "discloses_side_effects": { "type": "boolean" }
      }
    },
    "bundle_class_disclosure_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_class",
        "signer_source",
        "certification",
        "scorecard_class",
        "discloses_class_meaning",
        "invents_private_class_meaning"
      ],
      "properties": {
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "signer_source": { "$ref": "#/$defs/source_trust" },
        "certification": { "$ref": "#/$defs/certification_target" },
        "scorecard_class": { "$ref": "#/$defs/bundle_scorecard_class" },
        "discloses_class_meaning": { "type": "boolean" },
        "invents_private_class_meaning": { "type": "boolean" }
      }
    },
    "bundle_claim_narrowing_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id_ref",
        "certification_freshness",
        "imported_confidence",
        "narrows_on_stale_claim",
        "discloses_narrowing_reason",
        "invents_stale_wording"
      ],
      "properties": {
        "bundle_id_ref": { "type": "string", "minLength": 1 },
        "certification_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "imported_confidence": { "$ref": "#/$defs/imported_vs_native_confidence" },
        "narrows_on_stale_claim": { "type": "boolean" },
        "discloses_narrowing_reason": { "type": "boolean" },
        "invents_stale_wording": { "type": "boolean" }
      }
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "family",
        "surface_label",
        "truth_mode",
        "bundle_class",
        "bundle_context_ref",
        "required_labels",
        "export_safe",
        "assistive_ready",
        "label_summary",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/component_family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "bundle_class": { "$ref": "#/$defs/bundle_class" },
        "bundle_context_ref": { "type": "string", "minLength": 1 },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "export_safe": { "const": true },
        "assistive_ready": { "const": true },
        "start_center_bundle_card": { "$ref": "#/$defs/start_center_bundle_card" },
        "certified_archetype_badge_group": {
          "$ref": "#/$defs/certified_archetype_badge_group"
        },
        "bundle_detail_page": { "$ref": "#/$defs/bundle_detail_page" },
        "bundle_install_update_review_sheet": {
          "$ref": "#/$defs/bundle_install_update_review_sheet"
        },
        "bundle_drift_banner": { "$ref": "#/$defs/bundle_drift_banner" },
        "bundle_local_override_row": { "$ref": "#/$defs/bundle_local_override_row" },
        "bundle_rollback_remove_card": { "$ref": "#/$defs/bundle_rollback_remove_card" },
        "bundle_class_disclosure_card": { "$ref": "#/$defs/bundle_class_disclosure_card" },
        "bundle_claim_narrowing_row": { "$ref": "#/$defs/bundle_claim_narrowing_row" },
        "degraded": { "$ref": "#/$defs/degraded_state" },
        "label_summary": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer_source_and_freshness_explicit_on_every_surface",
        "diff_scope_and_local_override_state_never_hidden",
        "drift_never_reads_like_generic_package_update",
        "rollback_path_and_side_effects_disclosed_before_remove",
        "stale_certification_narrows_claims_never_silently",
        "entitlement_policy_dependencies_stay_explicit",
        "badges_and_classes_carry_no_private_meaning",
        "exported_evidence_preserves_bundle_ids_classes_and_freshness",
        "components_bound_to_shared_bundle_vocabulary",
        "no_new_manifest_formats_certification_systems_or_marketplaces"
      ],
      "properties": {
        "signer_source_and_freshness_explicit_on_every_surface": { "const": true },
        "diff_scope_and_local_override_state_never_hidden": { "const": true },
        "drift_never_reads_like_generic_package_update": { "const": true },
        "rollback_path_and_side_effects_disclosed_before_remove": { "const": true },
        "stale_certification_narrows_claims_never_silently": { "const": true },
        "entitlement_policy_dependencies_stay_explicit": { "const": true },
        "badges_and_classes_carry_no_private_meaning": { "const": true },
        "exported_evidence_preserves_bundle_ids_classes_and_freshness": { "const": true },
        "components_bound_to_shared_bundle_vocabulary": { "const": true },
        "no_new_manifest_formats_certification_systems_or_marketplaces": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_center_ingests_components",
        "migration_center_ingests_components",
        "docs_help_ingests_components",
        "diagnostics_ingests_components",
        "support_export_ingests_components",
        "release_control_ingests_components",
        "later_rows_reference_one_canonical_family"
      ],
      "properties": {
        "start_center_ingests_components": { "const": true },
        "migration_center_ingests_components": { "const": true },
        "docs_help_ingests_components": { "const": true },
        "diagnostics_ingests_components": { "const": true },
        "support_export_ingests_components": { "const": true },
        "release_control_ingests_components": { "const": true },
        "later_rows_reference_one_canonical_family": { "const": true }
      }
    }
  }
}
