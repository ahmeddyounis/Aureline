{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-about-service-health-card.schema.json",
  "title": "Aureline M5 About and service-health card",
  "description": "Reusable card for About summaries, service-health banners, and service-health status cards. It keeps build/provenance/service state local-first, trust-class explicit, freshness-visible, and support-export safe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "card_id",
    "card_family",
    "build_identity_ref",
    "service_family",
    "service_contract_state",
    "source_trust_class",
    "freshness_state",
    "local_continuity_state",
    "downgrade_state",
    "build_summary",
    "service_health_summary",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_about_service_health_card" },
    "schema_version": { "const": 1 },
    "card_id": { "$ref": "#/$defs/id" },
    "card_family": {
      "type": "string",
      "enum": ["about_summary", "service_health_banner", "service_health_status_card"]
    },
    "build_identity_ref": { "$ref": "#/$defs/ref" },
    "service_family": { "$ref": "#/$defs/ref" },
    "service_contract_state": {
      "type": "string",
      "enum": ["ready", "degraded", "local_only", "stale", "contract_mismatch", "policy_blocked", "unavailable"]
    },
    "source_trust_class": {
      "type": "string",
      "enum": ["official", "mirrored_official", "local_only", "managed_service", "community_owned", "vendor_managed", "unknown"]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["live", "cached", "mirrored", "offline_pack", "stale_cache", "policy_limited"]
    },
    "local_continuity_state": {
      "type": "string",
      "enum": ["available", "narrowed", "unavailable", "not_applicable"]
    },
    "downgrade_state": {
      "type": "string",
      "enum": ["none", "cached_service_health", "local_only_continuity", "service_degraded", "policy_limited", "unavailable"]
    },
    "build_summary": { "$ref": "#/$defs/build_summary" },
    "service_health_summary": { "$ref": "#/$defs/service_health_summary" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["help_about", "service_health", "diagnostics", "release_notes", "support_export", "migration_notice"]
      }
    },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "local_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "action_kind", "label", "requires_auth", "opens_browser", "local_available"],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "action_kind": {
          "type": "string",
          "enum": ["copy_build_info", "open_local_diagnostics", "export_diagnostics"]
        },
        "label": { "$ref": "#/$defs/ref" },
        "requires_auth": { "const": false },
        "opens_browser": { "const": false },
        "local_available": { "const": true }
      }
    },
    "build_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "channel",
        "install_mode",
        "provenance_state",
        "open_local_boundary_note",
        "copy_build_info_action"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/ref" },
        "channel": {
          "type": "string",
          "enum": ["stable", "beta", "nightly", "enterprise", "local_dev", "unknown"]
        },
        "install_mode": {
          "type": "string",
          "enum": ["local_app", "self_hosted", "managed_cloud", "air_gapped", "portable", "unknown"]
        },
        "provenance_state": {
          "type": "string",
          "enum": ["verified", "mirrored_verified", "local_only", "unsigned", "stale", "unknown"]
        },
        "open_local_boundary_note": { "$ref": "#/$defs/ref" },
        "copy_build_info_action": { "$ref": "#/$defs/local_action" }
      }
    },
    "service_health_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_service_family",
        "current_contract_state",
        "cached_freshness",
        "local_workflows_available",
        "managed_features_affected",
        "diagnostics_action",
        "export_action"
      ],
      "properties": {
        "affected_service_family": { "$ref": "#/$defs/ref" },
        "current_contract_state": {
          "type": "string",
          "enum": ["ready", "degraded", "local_only", "stale", "contract_mismatch", "policy_blocked", "unavailable"]
        },
        "cached_freshness": {
          "type": "string",
          "enum": ["live", "cached", "mirrored", "offline_pack", "stale_cache", "policy_limited"]
        },
        "local_workflows_available": { "$ref": "#/$defs/ref_array" },
        "managed_features_affected": { "$ref": "#/$defs/ref_array" },
        "diagnostics_action": { "$ref": "#/$defs/local_action" },
        "export_action": { "$ref": "#/$defs/local_action" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["text", "json", "markdown"] }
        },
        "export_fields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "card_family",
              "build_identity_ref",
              "service_family",
              "service_contract_state",
              "source_trust_class",
              "freshness_state",
              "local_continuity_state",
              "downgrade_state",
              "version",
              "channel",
              "install_mode",
              "provenance_state",
              "open_local_boundary_note",
              "copy_build_info_action",
              "local_workflows_available",
              "diagnostics_action",
              "export_action"
            ]
          }
        },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
