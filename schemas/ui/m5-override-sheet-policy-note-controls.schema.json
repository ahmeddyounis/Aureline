{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-override-sheet-policy-note-controls.schema.json",
  "title": "Aureline M5 per-workspace override-sheet and override-policy note-row controls",
  "description": "Export-safe packet for the third implement lane over the frozen M5 efficiency component matrix. It carries resolved, honest projections of the per-workspace override sheet and the override-policy note row across the claimed M5 consumer surfaces. Each controls row binds a consumer surface to the resolved override-sheet examples (previewing the current efficiency mode, the allowed policy ceilings, the expected effect on indexing / AI / extensions, and the exact reset path) and the resolved override-policy note-row examples (explaining when an override is blocked, who owns the policy, and what remains changeable locally). AC1 is proven by sheets and notes that show a blocked override as blocked-by-policy, degrading to dead_override_control_offered when they present a dead or misleading actionable control; AC2 is proven by sheets that state the performance-versus-freshness trade-off, degrading to performance_freshness_tradeoff_unstated or side_effects_hidden_by_generic_language rather than reading clean. Hard invariants forbid presenting an override as available when policy blocks it, hiding side effects behind generic efficiency language, collapsing distinct pressure sources into one generic warning, and hiding what remains changeable locally. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_per_workspace_override_sheet_and_override_policy_note_row_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "efficiency_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "efficiency_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "work_disposition": {
      "enum": [
        "running_full",
        "slowed",
        "paused",
        "policy_blocked",
        "override_available",
        "override_blocked",
        "resuming",
        "stale_result_shown",
        "not_evaluated"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "override_sheet_example": {
      "type": "object",
      "required": [
        "sheet_id",
        "current_mode",
        "expected_effect_workloads",
        "work_disposition",
        "override_posture",
        "policy_owner",
        "override_available",
        "allowed_ceiling_stated",
        "performance_freshness_tradeoff_stated",
        "hides_side_effects_generic_language",
        "reset_path",
        "override_control_honest",
        "degrade_reason",
        "next_action",
        "presented_dead_override_control"
      ],
      "properties": {
        "sheet_id": { "$ref": "#/$defs/non_empty_string" },
        "current_mode": { "$ref": "#/$defs/non_empty_string" },
        "expected_effect_workloads": { "type": "array", "items": { "type": "string" } },
        "work_disposition": { "$ref": "#/$defs/work_disposition" },
        "override_posture": { "$ref": "#/$defs/non_empty_string" },
        "policy_owner": { "$ref": "#/$defs/non_empty_string" },
        "override_available": { "type": "boolean" },
        "allowed_ceiling_stated": { "type": "boolean" },
        "performance_freshness_tradeoff_stated": { "type": "boolean" },
        "hides_side_effects_generic_language": { "type": "boolean" },
        "reset_path": { "type": ["string", "null"] },
        "override_control_honest": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "presented_dead_override_control": { "type": "boolean" }
      }
    },
    "policy_note_example": {
      "type": "object",
      "required": [
        "note_id",
        "work_disposition",
        "override_posture",
        "policy_owner",
        "override_available",
        "block_reason_explained",
        "locally_changeable",
        "override_control_honest",
        "degrade_reason",
        "next_action",
        "presented_dead_override_control"
      ],
      "properties": {
        "note_id": { "$ref": "#/$defs/non_empty_string" },
        "work_disposition": { "$ref": "#/$defs/work_disposition" },
        "override_posture": { "$ref": "#/$defs/non_empty_string" },
        "policy_owner": { "$ref": "#/$defs/non_empty_string" },
        "override_available": { "type": "boolean" },
        "block_reason_explained": { "type": "boolean" },
        "locally_changeable": { "type": "array", "items": { "type": "string" } },
        "override_control_honest": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "presented_dead_override_control": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "override_sheet_examples",
        "policy_note_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "presents_override_available_when_policy_blocks",
        "hides_side_effects_behind_generic_efficiency_language",
        "collapses_pressure_sources_into_generic_warning",
        "hides_what_remains_changeable_locally"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "override_sheet_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/override_sheet_example" }
        },
        "policy_note_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/policy_note_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "presents_override_available_when_policy_blocks": { "const": false },
        "hides_side_effects_behind_generic_efficiency_language": { "const": false },
        "collapses_pressure_sources_into_generic_warning": { "const": false },
        "hides_what_remains_changeable_locally": { "const": false }
      }
    }
  }
}
