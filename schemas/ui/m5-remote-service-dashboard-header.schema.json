{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-remote-service-dashboard-header.schema.json",
  "title": "Aureline M5 remote/service dashboard header component",
  "description": "Canonical single-instance shape of the M5 remote/service dashboard header embedded / browser-handoff boundary component. One remote/service dashboard header names who owns the dashboard, the data boundary, provider health, and freshness so a stale, offline, or provider-blocked view is never rendered as fresh first-party local truth. Every claimed M5 remote/service dashboard header references this schema or the combined m5-embedded-boundary-component-matrix.schema.json rather than reinventing its own owner/origin or browser-handoff wording. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the single-component shape.",
  "type": "object",
  "required": [
    "component_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "boundary_dispositions",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "imitates_native_permission_or_approval_ui",
    "hides_owner_origin_or_browser_fallback_in_menus_only",
    "renders_stale_or_blocked_as_fresh_first_party_truth",
    "embeds_high_risk_approval_without_native_step_up"
  ],
  "properties": {
    "component_family": {
      "const": "remote_service_dashboard_header"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "boundary_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "live_first_party_local",
          "live_first_party_hosted",
          "live_provider_owned",
          "stale_snapshot",
          "offline_snapshot",
          "provider_blocked",
          "browser_handoff_only",
          "capability_limited",
          "not_evaluated"
        ]
      }
    },
    "owner_classes": {
      "type": "array"
    },
    "data_exit_boundaries": {
      "type": "array"
    },
    "browser_handoff_kinds": {
      "type": "array"
    },
    "capability_limits": {
      "type": "array"
    },
    "freshness_states": {
      "type": "array"
    },
    "account_scopes": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "imitates_native_permission_or_approval_ui": {
      "const": false
    },
    "hides_owner_origin_or_browser_fallback_in_menus_only": {
      "const": false
    },
    "renders_stale_or_blocked_as_fresh_first_party_truth": {
      "const": false
    },
    "embeds_high_risk_approval_without_native_step_up": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
