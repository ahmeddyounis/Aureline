{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-rerun-comparison-sheet.schema.json",
  "title": "Aureline M5 rerun-comparison-sheet primitive",
  "description": "Canonical parity matrix for the reusable M5 rerun-comparison-sheet and retry-scope-review primitive: a rerun comparison sheet, a set of changed-context rows, a CLI/headless line, and a support-export projection that all resolve from one bounded rerun review and share one sheet identity, one prior-run identity, and one prior-attempt identity. Narrows the rerun_comparison_sheet family of the frozen M5 execution-lifecycle component matrix into one working resolver. Rerun controls no longer present as one generic action when inputs, targets, or authority have changed (AC1); every changed dimension — input, target, runtime, profile, approval/authority, or side-effect class — is reviewable before the rerun leaves the shell (AC2); support and export artifacts preserve the reviewed rerun mode and the changed-input summary (AC3). Raw command bytes, secret values, credentials, provider cursors, and raw diff payloads never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_rerun_comparison_sheet_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "task_run_pane",
        "test_run_pane",
        "request_run_pane",
        "notebook_execution",
        "ai_mediated_execution",
        "publish_flow",
        "preview_flow",
        "history_activity_center",
        "support_export_replay",
        "companion_summary"
      ]
    },
    "rerun_mode": {
      "enum": ["rerun_exactly", "rerun_with_current_context", "retry_failed_step_only"]
    },
    "rerun_context": {
      "enum": ["exact_replay", "current_context", "modified_selection", "modified_environment"]
    },
    "retry_scope": {
      "enum": ["whole_run", "failed_step_only", "selected_subset"]
    },
    "change_dimension": {
      "enum": [
        "input",
        "target",
        "runtime",
        "profile",
        "approval_authority",
        "side_effect_class"
      ]
    },
    "change_state": {
      "enum": ["unchanged", "changed", "unknown", "not_applicable"]
    },
    "side_effect_class": {
      "enum": ["none", "read_only", "local_write", "external_write", "irreversible"]
    },
    "outcome": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "waiting_input",
        "partially_complete",
        "passed",
        "failed",
        "cancelled",
        "stale_output"
      ]
    },
    "truth_mode": {
      "enum": ["live", "captured", "imported", "planned", "provider_reported"]
    },
    "locality": { "enum": ["local", "remote", "container", "managed"] },
    "export_field": {
      "enum": [
        "prior_run_id",
        "prior_attempt_id",
        "prior_attempt_ordinal",
        "new_attempt_ordinal",
        "rerun_mode",
        "rerun_context",
        "retry_scope",
        "changed_dimensions",
        "change_summary",
        "difference_reason",
        "side_effect_class",
        "baseline_run_ref"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_attempt_identity_unresolved",
        "input_consequence_unknown",
        "artifact_lineage_lost",
        "artifact_retention_expired",
        "rerun_context_drift",
        "captured_evidence_only",
        "connector_lost",
        "debug_adapter_unavailable",
        "symbols_unavailable"
      ]
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "rerun_modes",
        "change_dimensions",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_reruns",
        "collapses_distinct_actions",
        "hides_changed_context",
        "drops_prior_lineage",
        "drops_export_mode_or_summary"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "rerun_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rerun_mode" }
        },
        "change_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/change_dimension" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_reruns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case" }
        },
        "collapses_distinct_actions": { "const": false },
        "hides_changed_context": { "const": false },
        "drops_prior_lineage": { "const": false },
        "drops_export_mode_or_summary": { "const": false }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/input" },
        "resolved": { "$ref": "#/$defs/resolved" }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "sheet_id",
        "prior_run_ref",
        "prior_attempt_ref",
        "prior_attempt_ordinal",
        "new_attempt_ordinal",
        "prior_run_outcome",
        "baseline_run_ref",
        "run_label",
        "context_summary",
        "age_label",
        "truth_mode",
        "target_boundary",
        "rerun_mode",
        "rerun_context",
        "retry_scope",
        "available_modes",
        "prior_side_effect_class",
        "rerun_side_effect_class",
        "difference_reason"
      ],
      "properties": {
        "sheet_id": { "$ref": "#/$defs/id" },
        "prior_run_ref": { "$ref": "#/$defs/ref" },
        "prior_attempt_ref": { "$ref": "#/$defs/ref" },
        "prior_attempt_ordinal": { "type": "integer", "minimum": 1 },
        "new_attempt_ordinal": { "type": "integer", "minimum": 1 },
        "prior_run_outcome": { "$ref": "#/$defs/outcome" },
        "baseline_run_ref": { "$ref": "#/$defs/ref" },
        "run_label": { "type": "string", "minLength": 1 },
        "context_summary": { "type": "string", "minLength": 1 },
        "age_label": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "target_boundary": { "$ref": "#/$defs/locality" },
        "rerun_mode": { "$ref": "#/$defs/rerun_mode" },
        "rerun_context": { "$ref": "#/$defs/rerun_context" },
        "retry_scope": { "$ref": "#/$defs/retry_scope" },
        "available_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rerun_mode" }
        },
        "prior_side_effect_class": { "$ref": "#/$defs/side_effect_class" },
        "rerun_side_effect_class": { "$ref": "#/$defs/side_effect_class" },
        "difference_reason": { "type": "string", "minLength": 1 },
        "changed_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/change_input" }
        }
      }
    },
    "change_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state", "detail"],
      "properties": {
        "dimension": { "$ref": "#/$defs/change_dimension" },
        "state": { "$ref": "#/$defs/change_state" },
        "before_label": { "type": "string", "minLength": 1 },
        "after_label": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "resolved": {
      "type": "object",
      "required": [
        "sheet_id",
        "prior_run_ref",
        "prior_attempt_ref",
        "prior_attempt_ordinal",
        "sheet",
        "change_rows",
        "cli_line",
        "export",
        "distinct_actions_preserved",
        "context_reviewable_before_dispatch",
        "export_preserves_mode_and_summary"
      ],
      "properties": {
        "sheet_id": { "$ref": "#/$defs/id" },
        "distinct_actions_preserved": { "const": true },
        "context_reviewable_before_dispatch": { "const": true },
        "export_preserves_mode_and_summary": { "const": true }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "rerun_modes",
        "rerun_contexts",
        "retry_scopes",
        "change_dimensions",
        "change_states",
        "side_effect_classes",
        "export_fields",
        "outcomes",
        "truth_modes",
        "localities",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "rerun_modes": { "type": "array", "items": { "type": "string" } },
        "rerun_contexts": { "type": "array", "items": { "type": "string" } },
        "retry_scopes": { "type": "array", "items": { "type": "string" } },
        "change_dimensions": { "type": "array", "items": { "type": "string" } },
        "change_states": { "type": "array", "items": { "type": "string" } },
        "side_effect_classes": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "outcomes": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "localities": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "distinct_rerun_actions_never_collapsed",
        "changed_context_reviewable_before_dispatch",
        "prior_attempt_lineage_preserved",
        "reviewed_mode_and_summary_survive_export",
        "support_export_reconstructs_rerun",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "distinct_rerun_actions_never_collapsed": { "const": true },
        "changed_context_reviewable_before_dispatch": { "const": true },
        "prior_attempt_lineage_preserved": { "const": true },
        "reviewed_mode_and_summary_survive_export": { "const": true },
        "support_export_reconstructs_rerun": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "change_rows_read_single_diff_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "execution_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "change_rows_read_single_diff_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "rerun_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "rerun_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
