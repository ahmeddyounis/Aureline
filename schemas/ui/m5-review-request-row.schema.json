{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-review-request-row.schema.json",
  "title": "Aureline M5 review-request rows with provider/base-head/branch freshness, scope, and local-versus-provider truth",
  "description": "Export-safe packet implementing the reusable M5 review-request row contract. Each row answers, from the row alone, what the object is, which provider or local object owns it, what scope it covers, how fresh that truth is, and whether the row is a local review estimate, a provider-backed pull/merge request, an offline/exported review packet, or a browser-handoff placeholder. A local estimate never claims hosted status, a degraded provider is never flattened into a local estimate, and browser handoff plus local continuation stay explicit. The same row contract is reused by review lists, inboxes, switchers, companion queues, and handoff packets. Raw diff bodies, raw check logs, raw provider payloads, credentials, and live provider responses never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "rows",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "review_request_row_local_versus_provider_truth"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/review_request_row"
      }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downgrade_trigger"
      }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_surface"
      }
    },
    "trust_review": {
      "$ref": "#/$defs/trust_review"
    },
    "consumer_projection": {
      "$ref": "#/$defs/consumer_projection"
    },
    "proof_freshness": {
      "$ref": "#/$defs/proof_freshness"
    },
    "source_contract_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "backing_kind": {
      "type": "string",
      "enum": [
        "local_review_estimate",
        "provider_backed_request",
        "offline_exported_packet",
        "browser_handoff_placeholder"
      ]
    },
    "base_head_freshness": {
      "type": "string",
      "enum": [
        "current",
        "stale_base",
        "outdated_head",
        "diverged",
        "unknown"
      ]
    },
    "stack_relation": {
      "type": "string",
      "enum": [
        "standalone",
        "stack_root",
        "stack_member_parent_ready",
        "stack_member_parent_blocked"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "full_request",
        "stack_segment",
        "single_commit",
        "partial_selection"
      ]
    },
    "provider_freshness": {
      "type": "string",
      "enum": [
        "provider_fresh",
        "provider_refreshing",
        "provider_stale",
        "provider_unreachable",
        "provider_conflict",
        "local_only_continuation"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "open_in_workspace",
        "open_provider_in_browser",
        "export_review_packet",
        "continue_local_review",
        "refresh_provider_truth"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "provider_freshness_stale",
        "approval_invalidated",
        "stack_parent_blocked",
        "browser_handoff_unavailable",
        "trust_narrowing",
        "scope_expansion_unqualified",
        "upstream_dependency_narrowed"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "review_list",
        "review_inbox",
        "review_switcher",
        "companion_queue",
        "handoff_packet",
        "cli_headless",
        "support_export",
        "diagnostics",
        "help_about"
      ]
    },
    "review_request_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "backing_kind",
        "provider_identity_label",
        "object_id_label",
        "base_ref_label",
        "head_ref_label",
        "base_head_freshness",
        "stack_relation",
        "scope",
        "provider_freshness",
        "claims_provider_backed",
        "browser_handoff_boundary",
        "local_continue_fallback",
        "actions",
        "row_fields_shown",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backing_kind": {
          "$ref": "#/$defs/backing_kind"
        },
        "provider_identity_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "object_id_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "base_ref_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "head_ref_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "base_head_freshness": {
          "$ref": "#/$defs/base_head_freshness"
        },
        "stack_relation": {
          "$ref": "#/$defs/stack_relation"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "provider_freshness": {
          "$ref": "#/$defs/provider_freshness"
        },
        "claims_provider_backed": {
          "type": "boolean"
        },
        "browser_handoff_boundary": {
          "type": "string"
        },
        "local_continue_fallback": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "row_fields_shown": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "source_contract_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backing_kind": {
                "const": "provider_backed_request"
              }
            }
          },
          "then": {
            "properties": {
              "claims_provider_backed": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "claims_provider_backed": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_local_estimate_distinct",
        "local_estimate_never_claims_hosted",
        "offline_exported_packet_distinct",
        "provider_freshness_explicit",
        "base_head_relation_explicit",
        "stack_relation_explicit",
        "browser_handoff_explicit",
        "local_continue_preserved_on_degraded_freshness",
        "no_forced_raw_provider_navigation_for_triage",
        "one_row_contract_no_hidden_provider_meaning",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "provider_local_estimate_distinct": {
          "type": "boolean",
          "const": true
        },
        "local_estimate_never_claims_hosted": {
          "type": "boolean",
          "const": true
        },
        "offline_exported_packet_distinct": {
          "type": "boolean",
          "const": true
        },
        "provider_freshness_explicit": {
          "type": "boolean",
          "const": true
        },
        "base_head_relation_explicit": {
          "type": "boolean",
          "const": true
        },
        "stack_relation_explicit": {
          "type": "boolean",
          "const": true
        },
        "browser_handoff_explicit": {
          "type": "boolean",
          "const": true
        },
        "local_continue_preserved_on_degraded_freshness": {
          "type": "boolean",
          "const": true
        },
        "no_forced_raw_provider_navigation_for_triage": {
          "type": "boolean",
          "const": true
        },
        "one_row_contract_no_hidden_provider_meaning": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_list_reuses_one_row_contract",
        "inbox_reuses_one_row_contract",
        "switcher_reuses_one_row_contract",
        "companion_queue_reuses_one_row_contract",
        "handoff_packet_reuses_one_row_contract",
        "row_distinguishes_local_provider_offline",
        "cli_headless_shows_truth",
        "support_export_shows_truth",
        "diagnostics_shows_truth",
        "help_about_shows_truth"
      ],
      "properties": {
        "review_list_reuses_one_row_contract": {
          "type": "boolean",
          "const": true
        },
        "inbox_reuses_one_row_contract": {
          "type": "boolean",
          "const": true
        },
        "switcher_reuses_one_row_contract": {
          "type": "boolean",
          "const": true
        },
        "companion_queue_reuses_one_row_contract": {
          "type": "boolean",
          "const": true
        },
        "handoff_packet_reuses_one_row_contract": {
          "type": "boolean",
          "const": true
        },
        "row_distinguishes_local_provider_offline": {
          "type": "boolean",
          "const": true
        },
        "cli_headless_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "support_export_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "diagnostics_shows_truth": {
          "type": "boolean",
          "const": true
        },
        "help_about_shows_truth": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "type": "string",
          "format": "date-time"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
