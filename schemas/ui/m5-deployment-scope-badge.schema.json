{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-deployment-scope-badge.schema.json",
  "title": "Aureline M5 deployment-scope badge primitive",
  "description": "Export-safe packet for the reusable M5 deployment-scope badge primitive. It narrows the deployment-scope family frozen in schemas/ui/m5-badge-family-matrix.schema.json into one resolver plus a parity matrix, so a user can tell — from the badge and its explanation and residual-dependency drawers alone — which operating mode a capability runs in (local_only/managed/self_hosted/mirrored/offline_capable/browser_companion), as one distinct, composable cue that never collapses into support class, lifecycle, or channel status. Each badge row binds one claimed badge consumer (the runtime capability row, the install/deployment card, the Help/About panel, the diagnostics report, the support-export row, and the companion-mode card) to the shared badge anatomy, scope values, derived sovereignty postures, residual-dependency classes, local-safe continuities, next actions, explanation-drawer fields, export fields, and non-visual accessibility routes, plus worked resolution cases that must reproduce the resolver output exactly. The resolver derives the sovereignty posture from the scope axis alone — a local-only capability is locally sovereign regardless of its support class, lifecycle, or channel — and when the scope makes a local, offline, self-host, mirror, or browser-companion authority claim it produces a self-contained residual-dependency note that discloses the residual dependency, states the local-safe continuity, and preserves the underlying scope context so the badge never overstates sovereignty, offline readiness, or client authority. Hard invariants forbid collapsing the scope into another axis, implying the lifecycle from the scope, dropping the residual dependency when a scope makes a local-authority claim, and letting exported evidence lose badge meaning. Raw URLs, raw signing keys, raw tokens, credentials, and user text bodies never cross this boundary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "badge_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_deployment_scope_badges_across_claimed_m5_runtime_install_help_and_export_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "badge_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/badge_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "consumer_projection": {
      "type": "object",
      "description": "Every flag is a hard invariant and must be true."
    },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": { "type": "object" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "consumer_surface": {
      "enum": [
        "runtime_capability_row",
        "install_deployment_card",
        "help_about_panel",
        "diagnostics_report",
        "support_export_row",
        "companion_mode_card"
      ]
    },
    "scope": {
      "enum": [
        "local_only",
        "managed",
        "self_hosted",
        "mirrored",
        "offline_capable",
        "browser_companion"
      ]
    },
    "sovereignty_posture": {
      "enum": [
        "locally_sovereign",
        "provider_governed",
        "operator_governed",
        "mirror_synced",
        "offline_resilient",
        "host_delegated"
      ]
    },
    "residual_dependency_class": {
      "enum": [
        "signing_and_update_channel",
        "operator_infrastructure",
        "upstream_mirror_sync",
        "cached_capability_window",
        "host_browser_runtime"
      ]
    },
    "local_safe_continuity": {
      "enum": [
        "continues_fully_local",
        "continues_with_last_mirrored_state",
        "continues_with_cached_window",
        "continues_within_host_session"
      ]
    },
    "next_action": {
      "enum": [
        "review_residual_dependency",
        "confirm_offline_readiness_window",
        "confirm_host_companion_scope"
      ]
    },
    "badge_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "anatomy_parts",
        "scope_values",
        "sovereignty_postures",
        "residual_dependency_classes",
        "local_safe_continuities",
        "next_actions",
        "explanation_fields",
        "export_fields",
        "accessibility_routes",
        "example_resolutions"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "qualification": {
          "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
        },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "scope_values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scope" }
        },
        "sovereignty_postures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sovereignty_posture" }
        },
        "residual_dependency_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/residual_dependency_class" }
        },
        "local_safe_continuities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/local_safe_continuity" }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/next_action" }
        },
        "explanation_fields": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "example_resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "collapses_scope_into_support_lifecycle_or_channel": { "const": false },
        "implies_lifecycle_from_deployment_scope": { "const": false },
        "drops_residual_dependency_on_sovereignty_claim": { "const": false },
        "drops_badge_meaning_in_export": { "const": false }
      }
    },
    "resolution_case": {
      "type": "object",
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "subject_label",
            "scope",
            "sovereignty_posture",
            "is_provider_governed",
            "is_locally_sovereign",
            "is_offline_or_mirror",
            "is_browser_companion",
            "last_evaluated_repr"
          ],
          "properties": {
            "scope": { "$ref": "#/$defs/scope" },
            "sovereignty_posture": { "$ref": "#/$defs/sovereignty_posture" },
            "is_provider_governed": { "type": "boolean" },
            "is_locally_sovereign": { "type": "boolean" },
            "is_offline_or_mirror": { "type": "boolean" },
            "is_browser_companion": { "type": "boolean" },
            "residual_dependency_note": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": [
                    "residual_dependency_class",
                    "next_action",
                    "residual_dependency",
                    "local_safe_continuity",
                    "preserved_scope",
                    "is_offline_readiness_claim",
                    "is_browser_companion",
                    "headline"
                  ],
                  "properties": {
                    "residual_dependency_class": { "$ref": "#/$defs/residual_dependency_class" },
                    "next_action": { "$ref": "#/$defs/next_action" },
                    "residual_dependency": { "$ref": "#/$defs/non_empty_string" },
                    "local_safe_continuity": { "$ref": "#/$defs/local_safe_continuity" },
                    "preserved_scope": { "$ref": "#/$defs/scope" },
                    "is_offline_readiness_claim": { "type": "boolean" },
                    "is_browser_companion": { "type": "boolean" },
                    "headline": { "$ref": "#/$defs/non_empty_string" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
