{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-public-surface-diff-merge-control-controls.schema.json",
  "title": "Aureline M5 public-surface-diff-card / merge-control-banner controls",
  "description": "Boundary contract for the reusable M5 public-surface diff card and merge-control banner controls: one export-safe packet binding a vector of public-surface diff cards and a vector of merge-control banners to one confirmation-locus, surface-change, and blocker vocabulary. The Rust validator in crates/aureline-review is the authoritative gate; this schema documents the export shape. A local estimate or machine-generated local diff never masquerades as provider-confirmed, a stable-contract change never hides inside ordinary review without an explicit diff card and migration/evidence links, and a guarded merge never names a generic blocker instead of the current gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "public_surface_diff_cards",
    "merge_control_banners",
    "downgrade_triggers",
    "consumer_surfaces",
    "review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_public_surface_diff_cards_and_merge_control_banners_with_surface_class_stability_label_schema_or_command_delta_disclosure_blocker_reason_bypass_policy_and_migration_note_continuity"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "public_surface_diff_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/public_surface_diff_card" }
    },
    "merge_control_banners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/merge_control_banner" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "governance_state_vocab": {
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "confirmation_locus_source": {
      "enum": [
        "provider_confirmed_gate",
        "provider_reported_state",
        "machine_generated_locally",
        "local_heuristic_estimate",
        "not_evaluated_here",
        "stale_against_base_head"
      ]
    },
    "confirmation_locus_posture": {
      "enum": [
        "provider_confirmed",
        "machine_generated_local",
        "local_estimate",
        "not_evaluated_here",
        "stale_relative_to_head"
      ]
    },
    "surface_change_source": {
      "enum": [
        "incompatible_signature_change",
        "semantic_behavior_break",
        "backward_compatible_addition",
        "clarifying_compatible_change",
        "deprecation_announced",
        "surface_removed"
      ]
    },
    "surface_change_posture": {
      "enum": ["breaking", "compatible", "deprecation", "removal"]
    },
    "public_surface_class": {
      "enum": [
        "command",
        "cli_flag",
        "schema",
        "manifest",
        "sdk_wit_surface",
        "token",
        "message_id",
        "automation_contract",
        "compatibility_claim"
      ]
    },
    "stability_class": {
      "enum": ["stable", "beta", "experimental", "internal"]
    },
    "diff_evidence_kind": {
      "enum": [
        "machine_generated_diff",
        "migration_guide",
        "compatibility_report",
        "changelog_entry",
        "no_diff_evidence"
      ]
    },
    "merge_blocker_class": {
      "enum": [
        "required_check_failing",
        "required_review_missing",
        "branch_protection_rule",
        "ruleset_violation",
        "merge_conflict",
        "no_blocker"
      ]
    },
    "protection_state": {
      "enum": ["provider_enforced", "ruleset_enforced", "advisory_only", "not_configured"]
    },
    "required_check_state": {
      "enum": ["passing", "failing", "pending", "missing"]
    },
    "bypass_policy_class": {
      "enum": [
        "no_bypass_allowed",
        "admin_bypass_allowed",
        "emergency_bypass_allowed",
        "bypass_used"
      ]
    },
    "required_check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["check_label", "check_state", "is_blocking"],
      "properties": {
        "check_label": { "$ref": "#/$defs/non_empty_string" },
        "check_state": { "$ref": "#/$defs/required_check_state" },
        "is_blocking": { "type": "boolean" }
      }
    },
    "public_surface_diff_card": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "component",
        "card_id",
        "change_title_label",
        "surface_classes",
        "surface_class_label",
        "stability_class",
        "stability_label",
        "surface_change_source",
        "derived_surface_change",
        "claims_breaking",
        "delta_disclosure_label",
        "confirmation_locus_source",
        "derived_confirmation_locus",
        "claims_provider_confirmed",
        "governance_state_vocab",
        "diff_evidence_kind",
        "context_note"
      ],
      "properties": {
        "component": { "const": "public_surface_diff_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "change_title_label": { "$ref": "#/$defs/non_empty_string" },
        "surface_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/public_surface_class" }
        },
        "surface_class_label": { "$ref": "#/$defs/non_empty_string" },
        "stability_class": { "$ref": "#/$defs/stability_class" },
        "stability_label": { "$ref": "#/$defs/non_empty_string" },
        "surface_change_source": { "$ref": "#/$defs/surface_change_source" },
        "derived_surface_change": { "$ref": "#/$defs/surface_change_posture" },
        "claims_breaking": { "type": "boolean" },
        "delta_disclosure_label": { "$ref": "#/$defs/non_empty_string" },
        "confirmation_locus_source": { "$ref": "#/$defs/confirmation_locus_source" },
        "derived_confirmation_locus": { "$ref": "#/$defs/confirmation_locus_posture" },
        "claims_provider_confirmed": { "type": "boolean" },
        "governance_state_vocab": {
          "type": "array",
          "items": { "$ref": "#/$defs/governance_state_vocab" }
        },
        "diff_evidence_kind": { "$ref": "#/$defs/diff_evidence_kind" },
        "context_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "merge_control_banner": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "component",
        "banner_id",
        "gate_title_label",
        "blocker_class",
        "required_checks",
        "required_checks_label",
        "protection_state",
        "protection_state_label",
        "bypass_policy",
        "bypass_policy_label",
        "confirmation_locus_source",
        "derived_confirmation_locus",
        "claims_provider_confirmed",
        "claims_evaluated_here",
        "mergeability_label",
        "export_parity_label",
        "governance_state_vocab",
        "context_note"
      ],
      "properties": {
        "component": { "const": "merge_control_banner" },
        "banner_id": { "$ref": "#/$defs/non_empty_string" },
        "gate_title_label": { "$ref": "#/$defs/non_empty_string" },
        "blocker_class": { "$ref": "#/$defs/merge_blocker_class" },
        "blocker_reason_label": { "type": "string" },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/required_check" }
        },
        "required_checks_label": { "$ref": "#/$defs/non_empty_string" },
        "protection_state": { "$ref": "#/$defs/protection_state" },
        "protection_state_label": { "$ref": "#/$defs/non_empty_string" },
        "bypass_policy": { "$ref": "#/$defs/bypass_policy_class" },
        "bypass_policy_label": { "$ref": "#/$defs/non_empty_string" },
        "confirmation_locus_source": { "$ref": "#/$defs/confirmation_locus_source" },
        "derived_confirmation_locus": { "$ref": "#/$defs/confirmation_locus_posture" },
        "claims_provider_confirmed": { "type": "boolean" },
        "claims_evaluated_here": { "type": "boolean" },
        "mergeability_label": { "$ref": "#/$defs/non_empty_string" },
        "export_parity_label": { "$ref": "#/$defs/non_empty_string" },
        "governance_state_vocab": {
          "type": "array",
          "items": { "$ref": "#/$defs/governance_state_vocab" }
        },
        "context_note": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
