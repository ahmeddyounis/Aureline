{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-framework-pack-header-status-strip-controls.schema.json",
  "title": "Aureline M5 framework pack headers and framework status strips",
  "description": "Export-safe packet implementing the reusable M5 framework-pack-header component family in two co-equal control vectors: the full pack header and the compact status strip. Each pack header names its pack identity and version range, its support class, its provider source, its selected workspace scope, its freshness, its certainty, and its execution boundary, and offers a first-class open-compatibility-details action; its support posture, framework-experience class (core native, pack-backed, bridged, or heuristic), and scope posture (local, container, remote, managed, or unknown) are derived from the frozen classes, so bridge or heuristic behavior can never read as exact first-party support and a remote, managed, container, or unknown scope can never read as local before a user trusts a framework lens. Each status strip preserves the detected framework and version, the pack health, the compatibility notes, and the bridge-or-heuristic posture wherever a framework-aware feature is claimed, and offers inspect/review actions. Every next step names one stable pack-manifest / provider-registry / docs / compatibility deep link rather than an ephemeral overlay. No component hides its pack identity, version, or support class, lets bridge or heuristic behavior masquerade as exact, hides the local/container/SSH/managed boundary, or invents an alternate state label; raw file bodies, raw manifests, pasted local paths, repository URLs, credentials, and secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "pack_headers",
    "status_strips",
    "downgrade_triggers",
    "consumer_surfaces",
    "framework_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_framework_pack_headers_and_framework_status_strips_with_pack_identity_version_support_range_provider_source_freshness_compatibility_and_local_versus_remote_scope_truth"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "pack_headers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/framework_pack_header" }
    },
    "status_strips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/framework_status_strip" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "framework_review": { "$ref": "#/$defs/framework_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "pack_support_class": {
      "enum": [
        "officially_supported",
        "community_supported",
        "experimental",
        "bridge_only",
        "deprecated",
        "unsupported"
      ]
    },
    "pack_identity_state": {
      "enum": [
        "identified_versioned",
        "version_pinned",
        "version_drifted",
        "multiple_detected",
        "unversioned",
        "unknown_pack"
      ]
    },
    "execution_boundary_class": {
      "enum": [
        "local_process",
        "container",
        "ssh_remote",
        "managed_workspace",
        "cloud_remote",
        "unknown_boundary"
      ]
    },
    "support_posture": {
      "enum": [
        "fully_supported",
        "community_supported",
        "experimental_or_bridge",
        "unsupported_or_deprecated"
      ]
    },
    "experience_class": {
      "enum": ["core_native", "pack_backed", "bridged", "heuristic"]
    },
    "scope_posture": {
      "enum": [
        "local_scope",
        "container_scope",
        "remote_scope",
        "managed_scope",
        "unknown_scope"
      ]
    },
    "freshness_state": {
      "enum": ["current", "imported", "stale", "never_scanned", "unknown"]
    },
    "health_class": {
      "enum": ["healthy", "degraded", "compatibility_warning", "broken", "unknown"]
    },
    "deep_link_kind": {
      "enum": [
        "pack_manifest",
        "provider_registry_entry",
        "docs_anchor",
        "compatibility_reference",
        "no_deep_link"
      ]
    },
    "pack_header_action": {
      "enum": [
        "open_compatibility_details",
        "inspect_pack_source_and_support",
        "review_scope_boundary",
        "select_workspace_scope",
        "open_deep_link",
        "copy_pack_id"
      ]
    },
    "status_strip_action": {
      "enum": [
        "inspect_framework_and_version",
        "review_compatibility_notes",
        "open_pack_header",
        "open_deep_link",
        "copy_pack_id"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "pack_source_and_certainty",
        "execution_boundary_and_impact",
        "proving_source_and_recovery_boundary"
      ]
    },
    "surface_family": {
      "enum": [
        "framework_pack_surface",
        "route_explorer",
        "topology_explorer",
        "convention_diagnostics",
        "generator_review",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "framework_pack_ui",
        "route_explorer_ui",
        "topology_ui",
        "diagnostic_center_ui",
        "generator_review_ui",
        "run_config_ui",
        "editor_gutter_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "pack_identity_unstated",
        "support_class_unstated",
        "exact_versus_heuristic_unstated",
        "authorship_unstated",
        "execution_boundary_unstated",
        "impact_undisclosed",
        "proving_source_omitted",
        "rollback_path_omitted",
        "derived_state_unlabeled",
        "convention_confidence_overstated",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "framework_pack_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "pack_id",
        "pack_name",
        "framework_name",
        "framework_version_range",
        "support_class",
        "identity_state",
        "certainty",
        "execution_boundary",
        "derived_support_posture",
        "derived_experience_class",
        "derived_scope_posture",
        "claims_exact_first_party_support",
        "claims_local_scope",
        "provider_source_label",
        "workspace_scope_label",
        "freshness_state",
        "freshness_label",
        "nonexact_support_note",
        "bridge_or_heuristic_note",
        "remote_scope_note",
        "version_drift_note",
        "multiple_pack_note",
        "unversioned_note",
        "unknown_pack_note",
        "pack_source_and_certainty_note",
        "compatibility_details_ref",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "header_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_pack_identity_or_support_class",
        "lets_heuristic_masquerade_as_exact",
        "hides_local_container_ssh_or_managed_boundary",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "framework_pack_header" },
        "pack_id": { "$ref": "#/$defs/non_empty_string" },
        "pack_name": { "$ref": "#/$defs/non_empty_string" },
        "framework_name": { "$ref": "#/$defs/non_empty_string" },
        "framework_version_range": { "$ref": "#/$defs/non_empty_string" },
        "support_class": { "$ref": "#/$defs/pack_support_class" },
        "identity_state": { "$ref": "#/$defs/pack_identity_state" },
        "certainty": { "$ref": "#/$defs/certainty_disposition" },
        "execution_boundary": { "$ref": "#/$defs/execution_boundary_class" },
        "derived_support_posture": { "$ref": "#/$defs/support_posture" },
        "derived_experience_class": { "$ref": "#/$defs/experience_class" },
        "derived_scope_posture": { "$ref": "#/$defs/scope_posture" },
        "claims_exact_first_party_support": { "type": "boolean" },
        "claims_local_scope": { "type": "boolean" },
        "provider_source_label": { "$ref": "#/$defs/non_empty_string" },
        "workspace_scope_label": { "$ref": "#/$defs/non_empty_string" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "freshness_label": { "$ref": "#/$defs/non_empty_string" },
        "nonexact_support_note": { "type": "string" },
        "bridge_or_heuristic_note": { "type": "string" },
        "remote_scope_note": { "type": "string" },
        "version_drift_note": { "type": "string" },
        "multiple_pack_note": { "type": "string" },
        "unversioned_note": { "type": "string" },
        "unknown_pack_note": { "type": "string" },
        "pack_source_and_certainty_note": { "$ref": "#/$defs/non_empty_string" },
        "compatibility_details_ref": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "header_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "open_compatibility_details" } },
            { "contains": { "const": "inspect_pack_source_and_support" } },
            { "contains": { "const": "review_scope_boundary" } }
          ],
          "items": { "$ref": "#/$defs/pack_header_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certainty_disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_pack_identity_or_support_class": { "const": false },
        "lets_heuristic_masquerade_as_exact": { "const": false },
        "hides_local_container_ssh_or_managed_boundary": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "framework_status_strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "pack_id",
        "detected_framework_label",
        "detected_version_label",
        "support_class",
        "identity_state",
        "certainty",
        "execution_boundary",
        "derived_support_posture",
        "derived_experience_class",
        "derived_scope_posture",
        "claims_exact_first_party_support",
        "claims_local_scope",
        "pack_health_class",
        "pack_health_label",
        "compatibility_notes_label",
        "nonexact_support_note",
        "bridge_or_heuristic_note",
        "remote_scope_note",
        "version_drift_note",
        "degraded_health_note",
        "pack_source_and_certainty_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "strip_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_pack_identity_or_support_class",
        "lets_heuristic_masquerade_as_exact",
        "hides_local_container_ssh_or_managed_boundary",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "framework_pack_header" },
        "pack_id": { "$ref": "#/$defs/non_empty_string" },
        "detected_framework_label": { "$ref": "#/$defs/non_empty_string" },
        "detected_version_label": { "$ref": "#/$defs/non_empty_string" },
        "support_class": { "$ref": "#/$defs/pack_support_class" },
        "identity_state": { "$ref": "#/$defs/pack_identity_state" },
        "certainty": { "$ref": "#/$defs/certainty_disposition" },
        "execution_boundary": { "$ref": "#/$defs/execution_boundary_class" },
        "derived_support_posture": { "$ref": "#/$defs/support_posture" },
        "derived_experience_class": { "$ref": "#/$defs/experience_class" },
        "derived_scope_posture": { "$ref": "#/$defs/scope_posture" },
        "claims_exact_first_party_support": { "type": "boolean" },
        "claims_local_scope": { "type": "boolean" },
        "pack_health_class": { "$ref": "#/$defs/health_class" },
        "pack_health_label": { "$ref": "#/$defs/non_empty_string" },
        "compatibility_notes_label": { "$ref": "#/$defs/non_empty_string" },
        "nonexact_support_note": { "type": "string" },
        "bridge_or_heuristic_note": { "type": "string" },
        "remote_scope_note": { "type": "string" },
        "version_drift_note": { "type": "string" },
        "degraded_health_note": { "type": "string" },
        "pack_source_and_certainty_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "strip_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "inspect_framework_and_version" } },
            { "contains": { "const": "review_compatibility_notes" } }
          ],
          "items": { "$ref": "#/$defs/status_strip_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certainty_disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_pack_identity_or_support_class": { "const": false },
        "lets_heuristic_masquerade_as_exact": { "const": false },
        "hides_local_container_ssh_or_managed_boundary": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "framework_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_header_shows_identity_and_support",
        "pack_header_shows_provider_and_scope",
        "pack_header_offers_compatibility_details",
        "status_strip_shows_framework_and_version",
        "status_strip_shows_health_and_compatibility",
        "status_strip_offers_inspect_and_review",
        "support_experience_and_scope_derived_never_asserted",
        "bridge_or_heuristic_never_shown_as_exact",
        "version_drift_and_multiple_pack_always_disclosed",
        "remote_scope_never_shown_as_local",
        "freshness_and_health_always_explicit",
        "every_next_step_names_stable_deep_link",
        "execution_boundary_always_visible",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_pack_surface_reads_single_source",
        "route_and_topology_surfaces_read_single_source",
        "diagnostics_surface_reads_single_source",
        "identity_and_support_visible_before_trust",
        "scope_and_experience_visible_before_trust",
        "support_export_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
