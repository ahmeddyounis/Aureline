{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aureline.dev/schemas/ui/m5-visual-designer-component-qualification.schema.json",
  "title": "M5 Visual-Designer Component Qualification Packet",
  "description": "M05-811 qualification packet: one referenceable certification bundle proving that every claimed visual-design, preview, framework-pack, docs/demo, and handoff consumer of the shared visual-designer components either passes the shared component parity check on every dimension (source ownership, mapping quality, round-trip state, token/binding provenance, accessibility/export behavior) or narrows automatically. Consolidates the whole B94 lane's certified component packets. Metadata-only: no raw source bodies, diffs, credentials, or provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "certification_bundle_ref",
    "certified_component_packets",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_visual_designer_component_qualification_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "certification_bundle_ref": { "type": "string", "minLength": 1 },
    "certified_component_packets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/row" }
    },
    "summary": { "$ref": "#/definitions/summary" }
  },
  "definitions": {
    "parity_state": {
      "type": "string",
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "source_ownership",
        "mapping_quality",
        "round_trip_state",
        "token_binding_provenance",
        "accessibility_export_behavior"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "drifted_from_source",
        "unmapped_source",
        "runtime_unavailable",
        "protected_path_blocked",
        "unsupported_construct",
        "round_trip_conflict_open",
        "unidentified_posture"
      ]
    },
    "consumer": {
      "type": "string",
      "enum": [
        "visual_design_surface",
        "preview_runtime",
        "framework_pack_preview",
        "docs_demo_embeds",
        "handoff_consumer",
        "support_packet",
        "help_center",
        "release_evidence"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": ["identity", "source_ownership", "state", "sync_or_freshness", "keyboard_route"]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "consumer_identity",
        "source_ownership",
        "mapping_quality",
        "round_trip_state",
        "token_binding_provenance",
        "accessibility_behavior",
        "verdict",
        "narrowed_reason"
      ]
    },
    "dimension_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/definitions/dimension" },
        "state": { "$ref": "#/definitions/parity_state" },
        "trigger": { "$ref": "#/definitions/downgrade_trigger" },
        "reason_label": { "type": "string" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer",
        "uses_shared_components",
        "dimensions",
        "copy_export",
        "preserved_export_fields",
        "required_labels",
        "canonical_component_refs",
        "certification_bundle_ref",
        "source_family_schema_ref",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_visual_designer_component_qualification_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer": { "$ref": "#/definitions/consumer" },
        "uses_shared_components": { "type": "boolean" },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/definitions/dimension_parity" }
        },
        "copy_export": { "$ref": "#/definitions/copy_export" },
        "preserved_export_fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/export_field" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/definitions/required_label" }
        },
        "canonical_component_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "certification_bundle_ref": { "type": "string", "minLength": 1 },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_count",
        "all_use_shared_components",
        "all_exports_preserve_truth",
        "all_narrowing_disclosed",
        "evidence_consumers_present",
        "dimensions_covered",
        "green_count",
        "yellow_count",
        "red_count",
        "canonical_packet_count"
      ],
      "properties": {
        "consumer_count": { "type": "integer", "minimum": 0 },
        "all_use_shared_components": { "type": "boolean" },
        "all_exports_preserve_truth": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "evidence_consumers_present": { "type": "boolean" },
        "dimensions_covered": { "type": "integer", "minimum": 0 },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "canonical_packet_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
