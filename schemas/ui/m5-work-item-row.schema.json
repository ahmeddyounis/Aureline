{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-work-item-row.schema.json",
  "title": "Aureline M5 work-item row",
  "description": "Canonical reusable work-item row. Names the work item's canonical identity (kind), the provider authority behind it, and its local-versus-provider state, so generic ticket/task wording never conceals who owns the object or what is only local and not yet published. Governed by the M5 work-item component matrix in crates/aureline-provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_item_object_id",
    "title",
    "work_item_kind",
    "provider_authority",
    "local_state"
  ],
  "properties": {
    "work_item_object_id": { "$ref": "#/$defs/non_empty_string" },
    "title": { "$ref": "#/$defs/non_empty_string" },
    "work_item_kind": { "$ref": "#/$defs/work_item_kind" },
    "provider_authority": { "$ref": "#/$defs/provider_authority" },
    "local_state": { "$ref": "#/$defs/local_state" },
    "canonical_reference": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "work_item_kind": {
      "enum": ["issue", "task", "incident", "change_request", "epic", "unknown_kind"]
    },
    "provider_authority": {
      "enum": [
        "provider_owned",
        "local_draft",
        "mirrored_read_only",
        "imported_snapshot",
        "unlinked_local",
        "policy_pinned"
      ]
    },
    "local_state": {
      "enum": [
        "synced_with_provider",
        "local_only_draft",
        "queued_for_publish",
        "publish_deferred",
        "publish_failed",
        "conflict_held"
      ]
    }
  }
}
