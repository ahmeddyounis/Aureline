{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-merge-control-banner.schema.json",
  "title": "Aureline M5 merge-control banner",
  "description": "Per-component contract for a merge-control banner: the reusable component that names each merge blocker individually rather than collapsing them into one generic warning pill. Binds the frozen governance-state vocabulary plus the blocker class and enforcement authority so a locally predicted blocker is never asserted as the provider's final block and no blocker is hidden. The Rust validator in crates/aureline-review is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "blocker_labels",
    "blocker_class",
    "enforcement_authority",
    "governance_state_vocab"
  ],
  "properties": {
    "component": {
      "const": "merge_control_banner"
    },
    "blocker_labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "blocker_class": {
      "$ref": "#/$defs/blocker_class"
    },
    "enforcement_authority": {
      "$ref": "#/$defs/enforcement_authority"
    },
    "governance_state_vocab": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/governance_state_vocab"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "blocker_class": {
      "enum": [
        "owner_backup_missing",
        "approval_expired",
        "review_pack_stale",
        "public_surface_unreviewed",
        "policy_blocked",
        "none"
      ]
    },
    "enforcement_authority": {
      "enum": [
        "advisory",
        "authoritative",
        "provider_authoritative",
        "local_estimate"
      ]
    },
    "governance_state_vocab": {
      "enum": [
        "advisory",
        "authoritative",
        "covered",
        "backup_missing",
        "waived",
        "expired",
        "stale",
        "provider_authoritative",
        "local_estimate"
      ]
    }
  }
}
