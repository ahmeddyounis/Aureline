{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-local-history-write-scope-component-consumer.schema.json",
  "title": "Aureline M5 local-history / write-scope component consumers",
  "description": "Export-safe packet for the adoption lane over the frozen M5 local-history / write-scope component matrix. It binds one row per claimed M5 mutation / recovery consumer — the editor rename / refactor transaction, the replace-in-files apply, the import / migration session, the repair transaction, the generated-artifact provenance surface, the AI apply / review surface, and the support / export desk — to the seven canonical component families (local-history row, checkpoint-group card, restore-preview card, retention/export card, write-scope preview tree, restore-granularity selector, history-export manifest), the one shared descriptor vocabulary (checkpoint / rollback / restore / export), the parity-health modes, export caveats, claim-parity states, narrowing reasons, recovery actions, export fields, and non-visual accessibility routes. Each consumer points at the primitive's canonical schema and artifact rather than re-wording checkpoint, rollback, restore, or export facts in local prose. A weakened parity-health mode (preview-only, unreconciled external drift, generated / managed scope, or applied export redaction) auto-narrows the claim and always discloses a self-contained banner naming the exact reason and recovery action. Raw file bodies, raw paths, credentials, and external endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "consumer_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "add_shared_rename_refactor_replace_import_repair_generated_artifact_and_ai_review_consumers_so_local_history_and_write_scope_components_keep_checkpoint_rollback_language_aligned_across_claimed_m5_mutation_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "consumer_rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/consumer_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "recovery_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "recovery_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "consumer": {
      "enum": [
        "editor_rename_refactor",
        "replace_in_files",
        "import_migration",
        "repair_transaction",
        "generated_artifact",
        "ai_review",
        "support_export"
      ]
    },
    "component_family": {
      "enum": [
        "local_history_row",
        "checkpoint_group_card",
        "restore_preview_card",
        "retention_export_card",
        "write_scope_preview_tree",
        "restore_granularity_selector",
        "history_export_manifest"
      ]
    },
    "descriptor": {
      "enum": ["checkpoint", "rollback", "restore", "export"]
    },
    "parity_health": {
      "enum": [
        "full_parity",
        "preview_only_narrowed",
        "external_drift_narrowed",
        "generated_managed_narrowed",
        "export_redacted_narrowed"
      ]
    },
    "claim_parity_state": {
      "enum": ["claims_preserved", "claims_auto_narrowed"]
    },
    "narrowing_reason": {
      "enum": [
        "preview_only_workflow",
        "external_drift_unreconciled",
        "generated_or_managed_scope",
        "export_redaction_applied"
      ]
    },
    "recovery_action": {
      "enum": [
        "return_to_recovery_center_to_commit",
        "reconcile_external_drift_first",
        "regenerate_from_source_instead",
        "request_unredacted_export"
      ]
    },
    "export_caveat": {
      "enum": [
        "restore_commit_disabled_preview_only",
        "scope_uncertain_until_drift_reconciled",
        "generated_file_restore_caveated",
        "export_redacted_not_full_evidence"
      ]
    },
    "resolved_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "component_family",
        "canonical_schema_ref",
        "descriptor_families",
        "parity_health",
        "export_caveats",
        "claim_parity_state",
        "is_narrowed",
        "auto_narrow_banner"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health": { "$ref": "#/$defs/parity_health" },
        "export_caveats": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_state": { "$ref": "#/$defs/claim_parity_state" },
        "is_narrowed": { "type": "boolean" },
        "auto_narrow_banner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "recovery_action",
                "consumer",
                "component_family",
                "preserved_descriptors",
                "export_caveats",
                "headline"
              ],
              "properties": {
                "reason": { "$ref": "#/$defs/narrowing_reason" },
                "recovery_action": { "$ref": "#/$defs/recovery_action" },
                "consumer": { "$ref": "#/$defs/consumer" },
                "component_family": { "$ref": "#/$defs/component_family" },
                "preserved_descriptors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/descriptor" }
                },
                "export_caveats": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/export_caveat" }
                },
                "headline": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "binding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": { "$ref": "#/$defs/resolved_binding" }
      }
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "canonical_schema_ref",
        "canonical_artifact_ref",
        "references_canonical_not_local_prose",
        "example_bindings"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_artifact_ref": { "type": "string", "minLength": 1 },
        "references_canonical_not_local_prose": { "const": true },
        "example_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding_case" }
        }
      }
    },
    "consumer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "descriptor_families",
        "parity_health_modes",
        "export_caveats",
        "claim_parity_states",
        "narrowing_reasons",
        "recovery_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "component_bindings",
        "required_proof_packet_refs",
        "source_contract_refs",
        "rewords_claims_per_surface",
        "invents_new_recovery_grammar",
        "drops_checkpoint_rollback_restore_or_export_when_narrowed",
        "inherits_stronger_label_from_healthier_lane"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "descriptor_families": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "parity_health_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parity_health" }
        },
        "export_caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/export_caveat" }
        },
        "claim_parity_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim_parity_state" }
        },
        "narrowing_reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/narrowing_reason" }
        },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recovery_action" }
        },
        "export_fields": { "type": "array", "minItems": 5 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_binding" }
        },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rewords_claims_per_surface": { "const": false },
        "invents_new_recovery_grammar": { "const": false },
        "drops_checkpoint_rollback_restore_or_export_when_narrowed": { "const": false },
        "inherits_stronger_label_from_healthier_lane": { "const": false }
      }
    }
  }
}
