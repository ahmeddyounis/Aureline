{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-build-remote-boundary-component-consumer.schema.json",
  "title": "Aureline M5 build/remote-boundary component consumer adoption",
  "description": "M05-1082 consumer-adoption lane over the frozen M5 build/remote-boundary component matrix. Proves that the eight reusable build / remote / managed-workspace component families (adapter-confidence chip, discovery-diff card, host-boundary strip, execution-origin receipt row, managed-workspace lifecycle card, suspend/resume/rebuild review sheet, workspace-expiry banner, local-safe continuation card) are reused as primitives across the claimed M5 execution / export consumer classes — run/test/debug, notebook, preview, AI tool routing, companion handoff, and support/export + release packets — rather than being reinvented as per-feature build/remote chrome. Each row points back to exactly one canonical component family (its matrix schema) and the one canonical controls contract (schema + doc + release-proof artifact) its family group belongs to, and preserves the identical adapter-confidence, discovery-drift, host-boundary, execution-origin, lifecycle-state, changed-persistence, continuity, expiry-timing, and local-safe-continuation labels plus the frozen boundary-disposition vocabulary. The same host / confidence / lifecycle / continuation state renders with one vocabulary and one component family across every claimed execution/export consumer (AC1); support/export/release packets drop bespoke feature-local translation tables (AC2). The three spec guardrails stay false per row: no consumer implies exact continuity after target identity, image, template, or persistence class changed materially, hides local-safe continuation or browser/companion handoff behind overflow-only affordances, or lets lower-confidence discovery overwrite higher-confidence resolved target truth without an explicit review state. The packet is metadata-only: raw provider tokens, credential material, and bearer secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": {
      "type": "string",
      "const": "m5_build_remote_boundary_component_consumer_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "adapter_confidence_chip",
        "discovery_diff_card",
        "host_boundary_strip",
        "execution_origin_receipt_row",
        "managed_workspace_lifecycle_card",
        "suspend_resume_rebuild_review_sheet",
        "workspace_expiry_banner",
        "local_safe_continuation_card"
      ]
    },
    "controls_lane": {
      "type": "string",
      "enum": [
        "adapter_discovery",
        "host_origin",
        "managed_lifecycle",
        "expiry_continuation"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "run_test_debug",
        "notebook",
        "preview",
        "ai_tool_routing",
        "companion_handoff",
        "support_export"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "run_test_debug_ui",
        "notebook_ui",
        "preview_ui",
        "companion_ui",
        "incident_ui",
        "support_export",
        "product_ui"
      ]
    },
    "authority_mode": {
      "type": "string",
      "enum": [
        "full_interactive",
        "read_only",
        "inspect_only",
        "override_gated",
        "export_only",
        "policy_blocked"
      ]
    },
    "handoff_target": {
      "type": "string",
      "enum": [
        "none",
        "desktop_shell",
        "companion_app",
        "browser_readonly",
        "support_packet",
        "cli_headless"
      ]
    },
    "label_parity": {
      "type": "string",
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "screenshot_only_prohibited": { "type": "boolean" }
      }
    },
    "reduced_capability_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "capability_state"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "capability_state": { "type": "string", "minLength": 1 },
        "missing_capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_class",
        "consumer_surface",
        "component_family",
        "controls_lane",
        "canonical_family_schema_ref",
        "canonical_controls_schema_ref",
        "canonical_controls_artifact_refs",
        "references_canonical_not_local_prose",
        "boundary_state_ref",
        "authority_mode",
        "preserved_label_families",
        "boundary_disposition_vocab",
        "label_parity",
        "handoff_target",
        "copy_export",
        "implies_exact_continuity_after_material_change",
        "hides_local_safe_or_companion_handoff_in_overflow_only",
        "lower_confidence_overwrites_resolved_target_without_review",
        "observed_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "m5_build_remote_boundary_component_consumer_row"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_class": { "$ref": "#/$defs/consumer_class" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "controls_lane": { "$ref": "#/$defs/controls_lane" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_controls_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "boundary_state_ref": { "type": "string", "minLength": 1 },
        "authority_mode": { "$ref": "#/$defs/authority_mode" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "boundary_disposition_vocab": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "handoff_target": { "$ref": "#/$defs/handoff_target" },
        "handoff_note_ref": { "type": "string" },
        "reduced_capability_banner": { "$ref": "#/$defs/reduced_capability_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "implies_exact_continuity_after_material_change": {
          "type": "boolean",
          "const": false
        },
        "hides_local_safe_or_companion_handoff_in_overflow_only": {
          "type": "boolean",
          "const": false
        },
        "lower_confidence_overwrites_resolved_target_without_review": {
          "type": "boolean",
          "const": false
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_class_count",
        "consumer_surface_count",
        "component_family_count",
        "controls_lane_count",
        "boundary_disposition_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_use_canonical_controls_lane",
        "all_boundary_rows_preserve_primary_truth",
        "all_rows_reconstructable",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "all_rows_guardrails_clear",
        "controls_lanes_stable_across_surfaces",
        "run_test_debug_consumer_present",
        "notebook_consumer_present",
        "preview_consumer_present",
        "ai_tool_routing_consumer_present",
        "companion_handoff_consumer_present",
        "support_export_consumer_present",
        "run_test_debug_reference_present",
        "support_export_reference_present",
        "label_family_coverage_complete",
        "boundary_disposition_coverage_complete",
        "families_reused_across_classes"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_class_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "controls_lane_count": { "type": "integer", "minimum": 0 },
        "boundary_disposition_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_use_canonical_controls_lane": { "type": "boolean" },
        "all_boundary_rows_preserve_primary_truth": { "type": "boolean" },
        "all_rows_reconstructable": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "all_rows_guardrails_clear": { "type": "boolean" },
        "controls_lanes_stable_across_surfaces": { "type": "boolean" },
        "run_test_debug_consumer_present": { "type": "boolean" },
        "notebook_consumer_present": { "type": "boolean" },
        "preview_consumer_present": { "type": "boolean" },
        "ai_tool_routing_consumer_present": { "type": "boolean" },
        "companion_handoff_consumer_present": { "type": "boolean" },
        "support_export_consumer_present": { "type": "boolean" },
        "run_test_debug_reference_present": { "type": "boolean" },
        "support_export_reference_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "boundary_disposition_coverage_complete": { "type": "boolean" },
        "families_reused_across_classes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
