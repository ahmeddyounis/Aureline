{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-support-package-card.schema.json",
  "title": "Aureline M5 support package card",
  "description": "Reusable card for support-package review and handoff surfaces. It distinguishes local-only saved packages from submitted packages, preserves redaction/count truth, and keeps copy/export evidence reviewable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "package_id",
    "support_package_ref",
    "package_state",
    "destination_class",
    "trust_class",
    "local_save_state",
    "redaction_state",
    "included_counts",
    "excluded_counts",
    "policy_locked_counts",
    "inspect_before_submit_required",
    "package_contents",
    "local_save_summary",
    "redaction_export_summary",
    "submit_later_summary",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_support_package_card" },
    "schema_version": { "const": 1 },
    "package_id": { "$ref": "#/$defs/id" },
    "support_package_ref": { "$ref": "#/$defs/ref" },
    "package_state": {
      "type": "string",
      "enum": ["review_ready", "narrowed_review", "send_blocked", "saved_local_only", "submitted", "stale_schema"]
    },
    "destination_class": {
      "type": "string",
      "enum": [
        "local_only_review",
        "vendor_case_handoff",
        "user_initiated_upload",
        "managed_admin_handoff",
        "private_security_channel",
        "official_support"
      ]
    },
    "trust_class": {
      "type": "string",
      "enum": ["local_only", "vendor_managed", "user_chosen_upload", "managed_admin", "private_security", "official_authenticated"]
    },
    "local_save_state": {
      "type": "string",
      "enum": ["first_class_available", "saved_local_only", "not_available"]
    },
    "redaction_state": {
      "type": "string",
      "enum": ["default_safe", "policy_narrowed", "user_broadened", "blocked_high_risk", "stale_schema"]
    },
    "included_counts": { "$ref": "#/$defs/data_class_counts" },
    "excluded_counts": { "$ref": "#/$defs/data_class_counts" },
    "policy_locked_counts": { "$ref": "#/$defs/data_class_counts" },
    "inspect_before_submit_required": { "type": "boolean" },
    "package_contents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "build_info",
          "service_health_snapshot",
          "diagnostic_summary",
          "redaction_manifest",
          "import_preview",
          "migration_diff",
          "policy_receipts",
          "local_logs_metadata",
          "reproduction_steps"
        ]
      }
    },
    "local_save_summary": { "$ref": "#/$defs/local_save_summary" },
    "redaction_export_summary": { "$ref": "#/$defs/redaction_export_summary" },
    "submit_later_summary": { "$ref": "#/$defs/submit_later_summary" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["support_center", "cli_headless", "formal_support_handoff", "support_export", "help_about"]
      }
    },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "data_class_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_only", "environment_adjacent", "code_adjacent", "high_risk"],
      "properties": {
        "metadata_only": { "type": "integer", "minimum": 0 },
        "environment_adjacent": { "type": "integer", "minimum": 0 },
        "code_adjacent": { "type": "integer", "minimum": 0 },
        "high_risk": { "type": "integer", "minimum": 0 }
      }
    },
    "local_save_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["saved_to_local_store", "local_packet_ref", "submit_state", "requires_auth_to_inspect"],
      "properties": {
        "saved_to_local_store": { "type": "boolean" },
        "local_packet_ref": { "$ref": "#/$defs/ref" },
        "submit_state": {
          "type": "string",
          "enum": ["not_submitted", "submit_ready_after_review", "submitted", "blocked"]
        },
        "requires_auth_to_inspect": { "const": false }
      }
    },
    "redaction_export_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redaction_state",
        "export_state",
        "high_risk_excluded",
        "policy_locked_exclusions_visible"
      ],
      "properties": {
        "redaction_state": {
          "type": "string",
          "enum": ["default_safe", "policy_narrowed", "user_broadened", "blocked_high_risk", "stale_schema"]
        },
        "export_state": {
          "type": "string",
          "enum": ["local_export_ready", "off_machine_blocked", "submitted", "stale_schema"]
        },
        "high_risk_excluded": { "type": "boolean" },
        "policy_locked_exclusions_visible": { "const": true }
      }
    },
    "submit_later_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "would_submit_only_after_user_action",
        "would_send_destination_class",
        "would_require_inspection",
        "current_card_represents_submission",
        "opens_browser_before_local_review"
      ],
      "properties": {
        "would_submit_only_after_user_action": { "const": true },
        "would_send_destination_class": {
          "type": "string",
          "enum": [
            "vendor_case_handoff",
            "user_initiated_upload",
            "managed_admin_handoff",
            "private_security_channel",
            "official_support"
          ]
        },
        "would_require_inspection": { "const": true },
        "current_card_represents_submission": { "const": false },
        "opens_browser_before_local_review": { "const": false }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["text", "json", "markdown"] }
        },
        "export_fields": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "support_package_ref",
              "package_state",
              "destination_class",
              "trust_class",
              "local_save_state",
              "redaction_state",
              "included_counts",
              "excluded_counts",
              "policy_locked_counts",
              "inspect_before_submit_required",
              "package_contents",
              "local_save_summary",
              "redaction_export_summary",
              "submit_later_summary"
            ]
          }
        },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}
