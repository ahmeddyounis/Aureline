{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-editor-inline-component-accessibility-parity.schema.json",
  "title": "Aureline M5 editor-inline-component accessibility & auto-narrowing parity",
  "description": "Export-safe packet for the M05-1122 keyboard / screen-reader / high-zoom / reduced-motion / CLI / export parity and honest auto-narrowing capstone over the frozen M5 editor-inline component matrix. Each row certifies one of the eight canonical component families (editor tab, gutter, diagnostic decoration, code-action chip, diff view, review thread, AI message card, evidence timeline) as keyboard-complete, assistive-tech-reachable, high-zoom / reduced-motion-safe, CLI/export-safe, and self-narrowing. When an anchor durability signal is stale / drifted, a severity or source attribution is stale, a fix posture is only inferred, a confidence or source is stale, an approval state is unverified, or an evidence lineage is only partial, the component's claim auto-narrows from trusted_inline_result / reviewable_inline_result to an anchor-unverified / severity-unverified / fix-posture-unverified / confidence-unverified / approval-unverified / evidence-lineage projection, discloses the narrowing with a precise trigger and binding dimension, and preserves the canonical component identity / last-known state. An inferred fix never masquerades as an exact one, and a drifted comment anchor never reads as a durably anchored review. The packet is metadata-only: raw document bodies, diff hunks, message transcripts, evidence blobs, credentials, secrets, and endpoint refs never cross this boundary, and a raw payload is never the only export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": {
      "const": "m5_editor_inline_component_accessibility_parity_packet"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" },
      "minItems": 8
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "type": "string",
      "enum": [
        "editor_tab",
        "gutter",
        "diagnostic_decoration",
        "code_action_chip",
        "diff_view",
        "review_thread",
        "ai_message_card",
        "evidence_timeline"
      ]
    },
    "fallback_modality": {
      "type": "string",
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "type": "string",
      "enum": [
        "desktop_full",
        "companion_app",
        "browser_readonly",
        "cli_headless",
        "docs_export",
        "support_export"
      ]
    },
    "non_visual_reach_state": {
      "type": "string",
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "type": "string",
      "enum": [
        "reconstructable_without_raw_payload",
        "disclosed_partial_capture",
        "requires_raw_payload"
      ]
    },
    "narrowing_disclosure_state": {
      "type": "string",
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "inline_claim": {
      "type": "string",
      "enum": [
        "trusted_inline_result",
        "reviewable_inline_result",
        "anchor_unverified_projection",
        "severity_unverified_projection",
        "fix_posture_unverified_projection",
        "confidence_unverified_projection",
        "approval_unverified_projection",
        "evidence_lineage_projection"
      ]
    },
    "claim_dimension": {
      "type": "string",
      "enum": [
        "state_clarity",
        "marker_layer_clarity",
        "severity_source_freshness_clarity",
        "fix_posture_clarity",
        "change_anchor_clarity",
        "review_approval_clarity",
        "confidence_source_clarity",
        "evidence_lineage_clarity"
      ]
    },
    "condition_state": {
      "type": "string",
      "enum": [
        "fully_qualified",
        "anchor_durability_stale",
        "severity_source_stale",
        "fix_posture_inferred",
        "confidence_stale",
        "approval_unverified",
        "evidence_lineage_partial"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "tab_marker_diagnostic_color_only",
        "comment_anchor_drifted_silently",
        "evidence_pointer_drifted_silently",
        "outdated_and_resolved_blurred",
        "inferred_fix_shown_as_exact",
        "evidence_timeline_opaque_log",
        "diagnostic_freshness_unstated",
        "ai_confidence_unstated",
        "diff_change_kind_collapsed",
        "anchor_state_unstated",
        "generic_chrome_wording_used",
        "proof_stale"
      ]
    },
    "required_label": {
      "type": "string",
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "anchor_and_freshness",
        "confidence_and_source",
        "evidence_lineage"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "editor_ui",
        "diff_ui",
        "review_ui",
        "notebook_ui",
        "ai_ui",
        "diagnostics_ui",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity",
        "preserves_truth_continuity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/inline_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "type": "boolean" },
        "preserves_truth_continuity": { "type": "boolean" }
      }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "raw_payload_only_prohibited": { "type": "boolean" }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state", "preserved_labels", "reduced_interactions"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": { "type": "array", "items": { "type": "string" } },
        "reduced_interactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "component_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "high_zoom_reach",
        "reduced_motion_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_ready_claim",
        "claim_conditions",
        "truth_preserved",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": {
          "const": "m5_editor_inline_component_accessibility_parity_row"
        },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "component_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/fallback_modality" },
          "minItems": 1
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "high_zoom_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "reduced_motion_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "cli_reach": { "$ref": "#/$defs/non_visual_reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_ready_claim": { "$ref": "#/$defs/inline_claim" },
        "claim_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition_entry" },
          "minItems": 1
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "truth_preserved": { "type": "boolean" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer_surface" },
          "minItems": 2
        },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "family_count",
        "structure_heavy_family_count",
        "all_structure_heavy_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_trusted_honesty_holds",
        "all_export_summaries_preserve_meaning",
        "all_truth_preserved",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "structure_heavy_family_count": { "type": "integer", "minimum": 0 },
        "all_structure_heavy_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_trusted_honesty_holds": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_truth_preserved": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
