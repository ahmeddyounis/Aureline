{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-sequence-help-strip.schema.json",
  "title": "Aureline M5 sequence-help-strip primitive",
  "description": "Export-safe packet implementing the reusable M5 sequence-help strip as one primitive. The packet binds one row per claimed modal / command-language consumer — the leader-sequence overlay, the modal-operator strip, the partial-command hint, the command-palette sequence hint, and the support sequence export — to the shared strip anatomy, the sequence-help states (ready/awaiting_next_key/partial_match/no_binding/conflicting_binding/disabled_in_context), the sequence step kinds (leader_key/chord/prefix_argument/motion/operator/terminal_action), the command-backing states, the derived help posture (ready-for-input/awaiting-next-key/partial-sequence/unbound-dead-end/conflicting-binding/disabled-in-context), the bounded show-valid-next-keys/run-example-command/resolve-conflicting-binding/cancel-sequence/open-full-cheat-sheet actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks its current mode or valid next keys, never lets a partial or ambiguous sequence fail silently, never requires pointer hover, and never severs the command backing or cheat-sheet route. Raw keystroke logs, pasted buffers, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_sequence_help_strips_with_current_mode_next_key_guidance_cancel_hints_and_keyboard_only_parity_across_claimed_m5_modal_and_command_language_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "sequence_help_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "sequence_help_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "help_states",
        "step_kinds",
        "command_backing_states",
        "help_postures",
        "help_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "sequence_examples",
        "masks_current_mode_or_next_keys",
        "fails_silently_on_partial_or_ambiguous",
        "requires_pointer_hover",
        "severs_command_backing_or_cheat_sheet"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "leader_sequence_overlay",
            "modal_operator_strip",
            "partial_command_hint",
            "command_palette_sequence_hint",
            "support_sequence_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "help_states": { "type": "array", "minItems": 1 },
        "step_kinds": { "type": "array", "minItems": 1 },
        "command_backing_states": { "type": "array", "minItems": 1 },
        "help_postures": { "type": "array", "minItems": 1 },
        "help_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sequence_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sequence_example" }
        },
        "masks_current_mode_or_next_keys": { "const": false },
        "fails_silently_on_partial_or_ambiguous": { "const": false },
        "requires_pointer_hover": { "const": false },
        "severs_command_backing_or_cheat_sheet": { "const": false }
      }
    },
    "sequence_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "help_state",
            "step_kind",
            "command_backing",
            "current_mode_or_leader_ref",
            "valid_next_keys",
            "cancel_key",
            "example_command_ref",
            "screen_reader_announcement",
            "cheat_sheet_ref",
            "strip_identity_ref",
            "help_posture",
            "available_actions",
            "is_awaiting_more",
            "is_dead_end",
            "is_ambiguous",
            "is_disabled",
            "is_command_backed",
            "shows_next_keys",
            "example_command_available",
            "cancel_available",
            "cheat_sheet_available",
            "shows_current_mode_or_leader",
            "explains_next_keys_or_dead_end",
            "shows_cancel_key",
            "never_requires_pointer_hover",
            "provides_screen_reader_announcement",
            "keeps_full_cheat_sheet_reachable",
            "preserves_command_backing_honestly"
          ]
        }
      }
    }
  }
}
