{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-intelligence-component-consumer.schema.json",
  "title": "Aureline M5 test-intelligence component consumer packet",
  "description": "M05-1033 consumer-adoption packet proving the seven frozen M5 test-intelligence component families (coverage summary bar, coverage overlay marker, flaky-state badge, retry-history row, snapshot-or-golden review card, coverage-import merge sheet, and test-generation suggestion card) are reusable primitives across the claimed M5 quality surfaces. Each row is one consumer on one M5 quality surface — editor gutter overlay, editor coverage summary, test-tree panel, PR / review coverage diff, PR / review snapshot card, CLI quality summary, imported-CI detail view, or support / export packet — that points back to exactly one canonical component family (its primitive schema + release-proof packet) instead of inventing per-surface test vocabulary. Every consumer keeps the identical provenance-freshness, included-run-scope, baseline-identity, raw-or-text-fallback, and assumption-boundary labels and one shared state lexicon (imported_not_local / suspected_not_confirmed / generated_review_first), plus the family-appropriate rerun / open-logs / open-report / raw-fallback / rollback actions. A consumer whose evidence is imported, whose shard scope is omitted, whose provenance is cached or stale, whose flakiness is only suspected, or whose generated test still carries unverified assumptions auto-narrows its visible claim and discloses the reduction with an auto-narrow banner naming the reason and a recovery hint, and never lets a single percentage hide a shard omission, an intermittent failure read as confirmed flakiness, or generated changes collapse into one opaque apply. The packet is metadata-only: raw runner output, coverage line data, assertion diffs, snapshot bytes, stack frames, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_test_intelligence_component_consumer_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "consumer_class": {
      "enum": [
        "editor_surface",
        "test_tree",
        "review_surface",
        "cli_summary",
        "imported_ci_detail",
        "support_export"
      ]
    },
    "consumer_surface": {
      "enum": [
        "editor_gutter_overlay",
        "editor_coverage_summary",
        "test_tree_panel",
        "review_coverage_diff",
        "review_snapshot_card",
        "cli_quality_summary",
        "imported_ci_detail_view",
        "support_export_packet"
      ]
    },
    "component_family": {
      "enum": [
        "coverage_summary_bar",
        "coverage_overlay_marker",
        "flaky_state_badge",
        "retry_history_row",
        "snapshot_review_card",
        "coverage_import_merge_sheet",
        "test_generation_suggestion_card"
      ]
    },
    "result_provenance": {
      "enum": [
        "verified_current_run",
        "imported_ci_artifact",
        "cached_local_result",
        "stale_prior_result",
        "suspected_flaky",
        "reproduced_flaky",
        "stable_again",
        "manually_muted",
        "unknown"
      ]
    },
    "claim_narrow_reason": {
      "enum": [
        "evidence_imported",
        "shard_scope_omitted",
        "provenance_stale",
        "flakiness_unconfirmed",
        "generated_assumptions_unverified"
      ]
    },
    "label_parity": {
      "enum": ["preserved", "disclosed_narrowed", "renamed_or_dropped"]
    },
    "label_family": {
      "enum": [
        "provenance_and_freshness",
        "included_run_scope",
        "baseline_identity",
        "raw_or_text_fallback",
        "assumption_boundary"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collapses_shard_omission_into_single_percentage",
        "labels_intermittent_as_confirmed_flaky",
        "bundles_generated_changes_into_opaque_apply",
        "rewords_scope_freshness_or_baseline_per_surface",
        "invents_alternate_state_label"
      ],
      "properties": {
        "collapses_shard_omission_into_single_percentage": { "const": false },
        "labels_intermittent_as_confirmed_flaky": { "const": false },
        "bundles_generated_changes_into_opaque_apply": { "const": false },
        "rewords_scope_freshness_or_baseline_per_surface": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "auto_narrow_banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner_id", "visible_label", "reasons", "recovery_hints"],
      "properties": {
        "banner_id": { "type": "string", "minLength": 1 },
        "visible_label": { "type": "string", "minLength": 1 },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim_narrow_reason" }
        },
        "recovery_hints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "consumer_class",
        "consumer_surface",
        "component_family",
        "canonical_family_schema_ref",
        "canonical_packet_refs",
        "references_canonical_not_local_prose",
        "result_provenance",
        "preserved_label_families",
        "shared_state_lexicon",
        "preserved_actions",
        "claim_narrow_reasons",
        "label_parity",
        "copy_export",
        "invariants",
        "source_refs",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_test_intelligence_component_consumer_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "consumer_class": { "$ref": "#/$defs/consumer_class" },
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "canonical_family_schema_ref": { "type": "string", "minLength": 1 },
        "canonical_packet_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references_canonical_not_local_prose": { "type": "boolean" },
        "result_provenance": { "$ref": "#/$defs/result_provenance" },
        "preserved_label_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/label_family" }
        },
        "shared_state_lexicon": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "preserved_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "claim_narrow_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_narrow_reason" }
        },
        "label_parity": { "$ref": "#/$defs/label_parity" },
        "auto_narrow_banner": { "$ref": "#/$defs/auto_narrow_banner" },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "invariants": { "$ref": "#/$defs/invariants" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "consumer_class_count",
        "consumer_surface_count",
        "component_family_count",
        "all_rows_point_to_canonical_family",
        "all_rows_preserve_labels",
        "all_rows_preserve_required_actions",
        "all_rows_provenance_claim_consistent",
        "all_narrowed_rows_disclose",
        "all_rows_have_copy_export",
        "all_row_invariants_hold",
        "editor_surface_present",
        "test_tree_present",
        "review_surface_present",
        "cli_summary_present",
        "imported_ci_detail_present",
        "support_export_present",
        "label_family_coverage_complete",
        "all_narrow_reasons_demonstrated",
        "imported_and_current_both_present",
        "shared_lexicon_uniform",
        "families_reused_across_classes"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "consumer_class_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 },
        "component_family_count": { "type": "integer", "minimum": 0 },
        "all_rows_point_to_canonical_family": { "type": "boolean" },
        "all_rows_preserve_labels": { "type": "boolean" },
        "all_rows_preserve_required_actions": { "type": "boolean" },
        "all_rows_provenance_claim_consistent": { "type": "boolean" },
        "all_narrowed_rows_disclose": { "type": "boolean" },
        "all_rows_have_copy_export": { "type": "boolean" },
        "all_row_invariants_hold": { "type": "boolean" },
        "editor_surface_present": { "type": "boolean" },
        "test_tree_present": { "type": "boolean" },
        "review_surface_present": { "type": "boolean" },
        "cli_summary_present": { "type": "boolean" },
        "imported_ci_detail_present": { "type": "boolean" },
        "support_export_present": { "type": "boolean" },
        "label_family_coverage_complete": { "type": "boolean" },
        "all_narrow_reasons_demonstrated": { "type": "boolean" },
        "imported_and_current_both_present": { "type": "boolean" },
        "shared_lexicon_uniform": { "type": "boolean" },
        "families_reused_across_classes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
