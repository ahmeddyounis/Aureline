{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-run-attempt-header.schema.json",
  "title": "Aureline M5 run/attempt-header primitive",
  "description": "Canonical parity matrix for the reusable M5 run/attempt-header primitive: a run/attempt header, an attempt selector, a CLI/headless header line, and a support-export projection that all resolve from one run-and-attempt context and share one run identity, one attempt identity, and one outcome-state label. Narrows the run_attempt_header family of the frozen M5 execution-lifecycle component matrix plus the attempt selector it implies into one working resolver. One run with multiple attempts stays distinguishable from multiple separate runs without leaving the surface (AC1); header state labels stay consistent across task/test/request/notebook/AI/publish/preview flows (AC2); exported evidence preserves the same run/attempt IDs and visible states shown in-product (AC3). Raw run logs, provider cursors, credentials, and raw event payloads never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_run_attempt_header_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "task_run_pane",
        "test_run_pane",
        "request_run_pane",
        "notebook_execution",
        "ai_mediated_execution",
        "publish_flow",
        "preview_flow",
        "history_activity_center",
        "support_export_replay",
        "companion_summary"
      ]
    },
    "initiator_class": {
      "enum": ["user_manual", "scheduled", "ci_triggered", "agent_ai", "watch_auto"]
    },
    "admission_control": {
      "enum": [
        "immediate",
        "capacity_queued",
        "dependency_queued",
        "concurrency_limited",
        "policy_gated"
      ]
    },
    "outcome": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "waiting_input",
        "partially_complete",
        "passed",
        "failed",
        "cancelled",
        "stale_output"
      ]
    },
    "truth_mode": {
      "enum": ["live", "captured", "imported", "planned", "provider_reported"]
    },
    "locality": { "enum": ["local", "remote", "container", "managed"] },
    "export_field": {
      "enum": [
        "run_id",
        "attempt_id",
        "attempt_ordinal",
        "initiator",
        "target_boundary",
        "outcome",
        "truth_class",
        "context_summary",
        "age"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_attempt_identity_unresolved",
        "input_consequence_unknown",
        "artifact_lineage_lost",
        "artifact_retention_expired",
        "rerun_context_drift",
        "captured_evidence_only",
        "connector_lost",
        "debug_adapter_unavailable",
        "symbols_unavailable"
      ]
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "outcomes",
        "truth_modes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_headers",
        "hides_run_or_attempt_identity",
        "blurs_run_and_attempt",
        "drops_state_label_parity",
        "drops_export_ids_or_states"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        },
        "truth_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/truth_mode" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_headers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case" }
        },
        "hides_run_or_attempt_identity": { "const": false },
        "blurs_run_and_attempt": { "const": false },
        "drops_state_label_parity": { "const": false },
        "drops_export_ids_or_states": { "const": false }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/input" },
        "resolved": { "$ref": "#/$defs/resolved" }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "header_id",
        "run_ref",
        "attempt_ref",
        "attempt_ordinal",
        "run_label",
        "initiator",
        "target_ref",
        "target_boundary",
        "context_summary",
        "age_label",
        "outcome",
        "truth_mode",
        "admission_control"
      ],
      "properties": {
        "header_id": { "$ref": "#/$defs/id" },
        "run_ref": { "$ref": "#/$defs/ref" },
        "attempt_ref": { "$ref": "#/$defs/ref" },
        "attempt_ordinal": { "type": "integer", "minimum": 1 },
        "run_label": { "type": "string", "minLength": 1 },
        "initiator": { "$ref": "#/$defs/initiator_class" },
        "target_ref": { "$ref": "#/$defs/ref" },
        "target_boundary": { "$ref": "#/$defs/locality" },
        "context_summary": { "type": "string", "minLength": 1 },
        "age_label": { "type": "string", "minLength": 1 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "admission_control": { "$ref": "#/$defs/admission_control" },
        "sibling_attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/sibling_attempt" }
        }
      }
    },
    "sibling_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_ref", "attempt_ordinal", "outcome", "is_current"],
      "properties": {
        "attempt_ref": { "$ref": "#/$defs/ref" },
        "attempt_ordinal": { "type": "integer", "minimum": 1 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "is_current": { "type": "boolean" }
      }
    },
    "resolved": {
      "type": "object",
      "required": [
        "header_id",
        "header",
        "selector",
        "cli_line",
        "export",
        "run_identity_disclosed",
        "state_label_parity",
        "export_preserves_ids_states"
      ],
      "properties": {
        "header_id": { "$ref": "#/$defs/id" },
        "run_identity_disclosed": { "const": true },
        "state_label_parity": { "const": true },
        "export_preserves_ids_states": { "const": true }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "initiator_classes",
        "admission_controls",
        "export_fields",
        "outcomes",
        "truth_modes",
        "localities",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "initiator_classes": { "type": "array", "items": { "type": "string" } },
        "admission_controls": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "outcomes": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "localities": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "run_and_attempt_identity_kept_distinct",
        "state_labels_consistent_across_surfaces",
        "queue_and_admission_preserved_in_shared_vocabulary",
        "exported_evidence_preserves_ids_and_states",
        "support_export_reconstructs_run_attempt",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "run_and_attempt_identity_kept_distinct": { "const": true },
        "state_labels_consistent_across_surfaces": { "const": true },
        "queue_and_admission_preserved_in_shared_vocabulary": { "const": true },
        "exported_evidence_preserves_ids_and_states": { "const": true },
        "support_export_reconstructs_run_attempt": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "attempt_selector_reads_single_run_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "execution_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "attempt_selector_reads_single_run_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "header_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "header_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
