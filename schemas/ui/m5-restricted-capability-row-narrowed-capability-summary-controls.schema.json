{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-restricted-capability-row-narrowed-capability-summary-controls.schema.json",
  "title": "Aureline M5 restricted-capability-row and narrowed-capability-summary controls",
  "description": "Export-safe packet for the restricted-mode implement lane over the frozen M5 workspace-trust / guided-repair component matrix. It carries resolved, honest projections of the restricted-capability row and its narrowed-capability summary across the claimed M5 consumer surfaces, so restricted mode reads as a stable operating posture rather than a vague blocked state. Each controls row binds a consumer surface to the resolved restricted-capability row examples (naming the restricted object, restriction scope, restriction source and reason, narrowed capability, the enumerated blocked action families, and the still-safe actions) and the resolved narrowed-capability summary examples (the same fields rolled up with blocked-family and still-safe counts). Every clean example keeps a command-backed recovery set reachable, anchored on inspect-trust. Hard invariants forbid collapsing a restricted surface into generic unavailable copy, hiding the blocked families or still-safe actions, routing recovery through docs or logs only, and implying a blanket restriction across roots or routes. Acceptance criteria — restricted surfaces never collapse into generic unavailable copy, and users can tell which actions remain safe with consistent command-backed recovery — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "controls_label",
    "controls_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_restricted_capability_row_and_narrowed_capability_summary_controls"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "controls_label": { "$ref": "#/$defs/non_empty_string" },
    "controls_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controls_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "trust_disposition": {
      "type": ["string", "null"],
      "enum": [
        "trusted",
        "restricted",
        "mixed_root",
        "policy_blocked",
        "reduced_mode",
        "preview_ready",
        "checkpoint_missing",
        "exact_reversal",
        "compensate",
        "regenerate",
        "manual_follow_up",
        "audit_only",
        null
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "action_family_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "recovery_action_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "restricted_capability_row_example": {
      "type": "object",
      "required": [
        "row_id",
        "object_identity",
        "restriction_scope",
        "trust_disposition",
        "root_trust",
        "grant_source",
        "restriction_reason_stated",
        "capability_narrow",
        "capability_narrowed",
        "blocked_action_families",
        "still_safe_actions",
        "recovery_actions",
        "approval_available",
        "is_mixed_root",
        "collapses_into_generic_unavailable",
        "collapses_per_root_into_uniform",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "restricted_posture_legible"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "object_identity": { "type": "string" },
        "restriction_scope": { "$ref": "#/$defs/non_empty_string" },
        "trust_disposition": { "$ref": "#/$defs/trust_disposition" },
        "root_trust": { "$ref": "#/$defs/non_empty_string" },
        "grant_source": { "$ref": "#/$defs/non_empty_string" },
        "restriction_reason_stated": { "type": "boolean" },
        "capability_narrow": { "$ref": "#/$defs/non_empty_string" },
        "capability_narrowed": { "type": "boolean" },
        "blocked_action_families": { "$ref": "#/$defs/action_family_array" },
        "still_safe_actions": { "$ref": "#/$defs/action_family_array" },
        "recovery_actions": { "$ref": "#/$defs/recovery_action_array" },
        "approval_available": { "type": "boolean" },
        "is_mixed_root": { "type": "boolean" },
        "collapses_into_generic_unavailable": { "type": "boolean" },
        "collapses_per_root_into_uniform": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "restricted_posture_legible": { "type": "boolean" }
      }
    },
    "narrowed_capability_summary_example": {
      "type": "object",
      "required": [
        "summary_id",
        "object_identity",
        "restriction_scope",
        "trust_disposition",
        "grant_source",
        "restriction_reason_stated",
        "capability_narrow",
        "capability_narrowed",
        "blocked_family_count",
        "blocked_action_families",
        "safe_action_count",
        "still_safe_actions",
        "recovery_actions",
        "collapses_into_generic_unavailable",
        "collapses_blocked_families",
        "detail_command_available",
        "degrade_reason",
        "next_action",
        "posture_legible"
      ],
      "properties": {
        "summary_id": { "$ref": "#/$defs/non_empty_string" },
        "object_identity": { "type": "string" },
        "restriction_scope": { "$ref": "#/$defs/non_empty_string" },
        "trust_disposition": { "$ref": "#/$defs/trust_disposition" },
        "grant_source": { "$ref": "#/$defs/non_empty_string" },
        "restriction_reason_stated": { "type": "boolean" },
        "capability_narrow": { "$ref": "#/$defs/non_empty_string" },
        "capability_narrowed": { "type": "boolean" },
        "blocked_family_count": { "type": "integer", "minimum": 0 },
        "blocked_action_families": { "$ref": "#/$defs/action_family_array" },
        "safe_action_count": { "type": "integer", "minimum": 0 },
        "still_safe_actions": { "$ref": "#/$defs/action_family_array" },
        "recovery_actions": { "$ref": "#/$defs/recovery_action_array" },
        "collapses_into_generic_unavailable": { "type": "boolean" },
        "collapses_blocked_families": { "type": "boolean" },
        "detail_command_available": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "posture_legible": { "type": "boolean" }
      }
    },
    "controls_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "restricted_capability_row_examples",
        "narrowed_capability_summary_examples",
        "required_proof_packet_refs",
        "source_contract_refs",
        "collapses_restricted_into_generic_unavailable",
        "hides_blocked_families_or_still_safe_actions",
        "routes_recovery_through_docs_or_logs_only",
        "implies_blanket_restriction_across_roots_or_routes"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "restricted_capability_row_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/restricted_capability_row_example" }
        },
        "narrowed_capability_summary_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/narrowed_capability_summary_example" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "collapses_restricted_into_generic_unavailable": { "const": false },
        "hides_blocked_families_or_still_safe_actions": { "const": false },
        "routes_recovery_through_docs_or_logs_only": { "const": false },
        "implies_blanket_restriction_across_roots_or_routes": { "const": false }
      }
    }
  }
}
