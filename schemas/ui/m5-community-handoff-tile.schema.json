{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-community-handoff-tile.schema.json",
  "title": "Aureline M5 community handoff tile",
  "description": "Reusable tile for public, official, private, community, vendor, and local-only handoff destinations. It discloses ownership, visibility, auth, data-exit, commitment, degraded destination state, local fallback, and copy/export-safe evidence before a user leaves the product.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "tile_id",
    "route",
    "ownership_class",
    "trust_class",
    "visibility_boundary",
    "auth_expectation",
    "data_exit_boundary",
    "commitment_class",
    "destination_state",
    "pre_exit_review_required",
    "local_safe_fallback_ref",
    "community_owned_destination",
    "source_refs",
    "consumer_surfaces",
    "copy_export"
  ],
  "properties": {
    "record_kind": { "const": "m5_community_handoff_tile" },
    "schema_version": { "const": 1 },
    "tile_id": { "$ref": "#/$defs/id" },
    "route": {
      "type": "string",
      "enum": ["public_issue", "security_disclosure", "docs_feedback", "rfc_discussion", "community_support", "official_support", "local_draft"]
    },
    "ownership_class": {
      "type": "string",
      "enum": ["official", "community", "private_security", "official_authenticated", "vendor_managed", "local_only"]
    },
    "trust_class": {
      "type": "string",
      "enum": ["official_public", "official_authenticated", "community", "private_security", "vendor_managed", "local_only"]
    },
    "visibility_boundary": {
      "type": "string",
      "enum": ["world_readable_public", "official_account_visible", "community_visible", "private_security_channel", "vendor_visible", "local_never_leaves"]
    },
    "auth_expectation": {
      "type": "string",
      "enum": ["no_account_needed", "official_account_required", "community_account_typical", "security_channel_credential", "vendor_account_required", "local_no_network"]
    },
    "data_exit_boundary": {
      "type": "string",
      "enum": [
        "no_payload_leaves_product",
        "metadata_safe_object_refs",
        "proposal_refs_only",
        "redacted_support_packet",
        "security_payloads_only",
        "external_public_browse",
        "vendor_or_third_party_outbound"
      ]
    },
    "commitment_class": {
      "type": "string",
      "enum": [
        "official_supported_commitment",
        "best_effort_community",
        "no_commitment_public_forum",
        "security_handled_privately",
        "local_draft_no_delivery"
      ]
    },
    "destination_state": {
      "type": "string",
      "enum": ["ready", "browser_blocked", "offline", "policy_blocked", "stale_cached_target", "unsupported_profile"]
    },
    "pre_exit_review_required": { "type": "boolean" },
    "local_safe_fallback_ref": { "$ref": "#/$defs/ref" },
    "community_owned_destination": { "type": "boolean" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["help_about", "issue_report_template", "docs_feedback", "security_disclosure", "support_handoff", "local_draft"]
      }
    },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["text", "json", "markdown"] }
        },
        "export_fields": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "route",
              "ownership_class",
              "trust_class",
              "visibility_boundary",
              "auth_expectation",
              "data_exit_boundary",
              "commitment_class",
              "destination_state",
              "pre_exit_review_required",
              "local_safe_fallback_ref",
              "community_owned_destination"
            ]
          }
        },
        "text": { "$ref": "#/$defs/ref" },
        "json": { "$ref": "#/$defs/ref" },
        "markdown": { "$ref": "#/$defs/ref" },
        "screenshot_only_prohibited": { "const": true }
      }
    }
  }
}

