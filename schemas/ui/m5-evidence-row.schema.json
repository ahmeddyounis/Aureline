{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-evidence-row.schema.json",
  "title": "Aureline M5 evidence / activity row primitive: stable verbs, provenance badges, disclosure-ready detail, and text / JSON / Markdown copy parity",
  "description": "Export-safe packet implementing Aureline's one reusable event / history row primitive across every M5 lane that explains what happened — AI evidence, task events, policy changes, provider mutations, remote reconnects, update history, support exports, and repair flows. Each surface row binds the shared row anatomy (timestamp, actor, action, object or scope, outcome, provenance badge, and the expandable detail link), the stable chronology verbs and provenance badges reused verbatim from the frozen M5 trust-chronology component matrix, the chronology detail states, the copy formats (text, JSON, Markdown) offered by every lane that claims portable evidence, the focus behaviors that keep terse rows scannable while detail and copy stay keyboard-reachable, and the chronology export fields that let the support export reconstruct what happened without a screenshot. Each lane carries worked resolution cases: a resolver input (a lane's raw events, each with a timestamp, actor, stable verb, object / scope, outcome, provenance badge, and optional detail anchor) and the resolved detail states plus the three portable copy renderings — the stored resolution must equal a fresh resolve of its input. Hard invariants forbid drifting from the stable verb vocabulary, dropping the provenance badge, leaving detail un-reopenable from durable history, and dropping export / audit truth. The shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix; the chronology verb, provenance badge, chronology detail state, chronology export field, accessibility route, qualification class, and downgrade trigger vocabularies are reused verbatim from the frozen M5 trust-chronology component matrix. Raw URLs, raw local paths, raw usernames, raw hostnames, tokens, and credentials never cross this boundary; only opaque export-safe reprs are carried. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_evidence_and_activity_timeline_row_stable_verbs_provenance_and_copy_parity_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "surface_family": {
      "type": "string",
      "enum": [
        "ai_evidence",
        "task_events",
        "policy_changes",
        "provider_mutations",
        "remote_reconnects",
        "update_history",
        "support_exports",
        "repair_flows"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "type": "string",
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "type": "string",
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "anatomy_part": {
      "type": "string",
      "enum": [
        "timestamp",
        "actor",
        "action",
        "object_or_scope",
        "outcome",
        "provenance_badge",
        "detail_link"
      ]
    },
    "chronology_verb": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "ran",
        "approved",
        "rejected",
        "failed",
        "recovered",
        "exported"
      ]
    },
    "provenance_badge": {
      "type": "string",
      "enum": [
        "human_initiated",
        "ai_initiated",
        "automation_initiated",
        "remote_actor",
        "system_initiated",
        "replayed_from_history"
      ]
    },
    "detail_state": {
      "type": "string",
      "enum": [
        "collapsed",
        "expanded",
        "grouped_by_object",
        "grouped_by_time",
        "filtered",
        "reopenable_detail"
      ]
    },
    "copy_format": {
      "type": "string",
      "enum": ["text", "json", "markdown"]
    },
    "focus_behavior": {
      "type": "string",
      "enum": [
        "row_keyboard_focusable",
        "detail_expand_reachable",
        "return_focus_on_collapse",
        "copy_action_reachable",
        "per_row_navigation",
        "deep_link_to_durable_history"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "event_verb",
        "provenance",
        "timestamp",
        "object_ref",
        "actor_role",
        "outcome_code",
        "redaction_class"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": ["succeeded", "failed", "pending", "denied", "reverted"]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "effective_configured_conflated",
        "source_pill_missing",
        "lock_state_unexplained",
        "consequence_grouping_dropped",
        "transitive_scope_hidden",
        "re_consent_skipped",
        "verb_vocabulary_drift",
        "provenance_badge_missing",
        "chronology_detail_not_reopenable",
        "export_field_dropped",
        "audit_truth_lost_off_primary_surface",
        "proof_stale"
      ]
    },
    "event_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_repr",
        "actor_repr",
        "verb",
        "object_repr",
        "outcome",
        "provenance",
        "has_detail"
      ],
      "properties": {
        "timestamp_repr": { "$ref": "#/$defs/non_empty_string" },
        "actor_repr": { "$ref": "#/$defs/non_empty_string" },
        "verb": { "$ref": "#/$defs/chronology_verb" },
        "object_repr": { "$ref": "#/$defs/non_empty_string" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "provenance": { "$ref": "#/$defs/provenance_badge" },
        "has_detail": { "type": "boolean" },
        "detail_ref": { "type": ["string", "null"] }
      }
    },
    "resolution_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "portable_evidence", "events"],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "portable_evidence": { "type": "boolean" },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event_item" }
        }
      }
    },
    "row_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "json", "markdown"],
      "properties": {
        "text": { "$ref": "#/$defs/non_empty_string" },
        "json": { "$ref": "#/$defs/non_empty_string" },
        "markdown": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "resolved_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_repr",
        "actor_repr",
        "verb",
        "object_repr",
        "outcome",
        "provenance",
        "detail_state"
      ],
      "properties": {
        "timestamp_repr": { "$ref": "#/$defs/non_empty_string" },
        "actor_repr": { "$ref": "#/$defs/non_empty_string" },
        "verb": { "$ref": "#/$defs/chronology_verb" },
        "object_repr": { "$ref": "#/$defs/non_empty_string" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "provenance": { "$ref": "#/$defs/provenance_badge" },
        "detail_state": { "$ref": "#/$defs/detail_state" },
        "detail_ref": { "type": ["string", "null"] },
        "copy": {
          "oneOf": [{ "$ref": "#/$defs/row_copy" }, { "type": "null" }]
        }
      }
    },
    "resolved_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "portable_evidence",
        "resolved_events",
        "emits_portable_copy"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "portable_evidence": { "type": "boolean" },
        "resolved_events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolved_event" }
        },
        "emits_portable_copy": { "type": "boolean" }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/resolution_input" },
        "resolved": { "$ref": "#/$defs/resolved_log" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "anatomy_parts",
        "chronology_verbs",
        "provenance_badges",
        "detail_states",
        "portable_evidence",
        "copy_formats",
        "focus_behaviors",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_logs",
        "drifts_from_verb_vocabulary",
        "drops_provenance_badge",
        "detail_not_reopenable",
        "drops_export_or_audit_truth"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "anatomy_parts": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/anatomy_part" }
        },
        "chronology_verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chronology_verb" }
        },
        "provenance_badges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance_badge" }
        },
        "detail_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/detail_state" }
        },
        "portable_evidence": { "type": "boolean" },
        "copy_formats": {
          "type": "array",
          "items": { "$ref": "#/$defs/copy_format" }
        },
        "focus_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/focus_behavior" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "example_logs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "drifts_from_verb_vocabulary": { "const": false },
        "drops_provenance_badge": { "const": false },
        "detail_not_reopenable": { "const": false },
        "drops_export_or_audit_truth": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_families",
        "anatomy_parts",
        "chronology_verbs",
        "provenance_badges",
        "detail_states",
        "copy_formats",
        "focus_behaviors",
        "export_fields",
        "accessibility_routes"
      ],
      "properties": {
        "history_families": { "type": "array", "items": { "$ref": "#/$defs/surface_family" } },
        "anatomy_parts": { "type": "array", "items": { "$ref": "#/$defs/anatomy_part" } },
        "chronology_verbs": { "type": "array", "items": { "$ref": "#/$defs/chronology_verb" } },
        "provenance_badges": { "type": "array", "items": { "$ref": "#/$defs/provenance_badge" } },
        "detail_states": { "type": "array", "items": { "$ref": "#/$defs/detail_state" } },
        "copy_formats": { "type": "array", "items": { "$ref": "#/$defs/copy_format" } },
        "focus_behaviors": { "type": "array", "items": { "$ref": "#/$defs/focus_behavior" } },
        "export_fields": { "type": "array", "items": { "$ref": "#/$defs/export_field" } },
        "accessibility_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibility_route" }
        }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_row_model_across_history_lanes",
        "stable_verb_vocabulary_enforced",
        "provenance_badge_always_attributed",
        "detail_reopenable_from_durable_history",
        "copy_export_parity_text_json_markdown",
        "support_export_keeps_chronology_vocabulary",
        "no_lane_invents_local_prose_verbs",
        "every_row_bound_to_shell_zone",
        "every_row_declares_accessibility_route",
        "later_lanes_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_row_model_across_history_lanes": { "const": true },
        "stable_verb_vocabulary_enforced": { "const": true },
        "provenance_badge_always_attributed": { "const": true },
        "detail_reopenable_from_durable_history": { "const": true },
        "copy_export_parity_text_json_markdown": { "const": true },
        "support_export_keeps_chronology_vocabulary": { "const": true },
        "no_lane_invents_local_prose_verbs": { "const": true },
        "every_row_bound_to_shell_zone": { "const": true },
        "every_row_declares_accessibility_route": { "const": true },
        "later_lanes_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_lanes_consume_shared_row",
        "resolver_reads_single_verb_vocabulary",
        "provenance_reads_single_source",
        "detail_reopen_reads_single_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "history_lanes_consume_shared_row": { "const": true },
        "resolver_reads_single_verb_vocabulary": { "const": true },
        "provenance_reads_single_source": { "const": true },
        "detail_reopen_reads_single_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "evidence_row_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_row_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
