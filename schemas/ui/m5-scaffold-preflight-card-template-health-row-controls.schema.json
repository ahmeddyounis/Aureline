{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-scaffold-preflight-card-template-health-row-controls.schema.json",
  "title": "Aureline M5 scaffold preflight cards and template health rows",
  "description": "Export-safe packet implementing the reusable M5 scaffold-preflight-card and template-health-row components in two co-equal control vectors. Each preflight card names its target path and name, its generated file and folder counts, its dependency/task/extension impact, the concrete side effect it discloses (package install, dependency restore, remote provisioning, trust prompt, script execution, or extension install), whether that action runs immediately or is deferred, and a named checkpoint or delete-generated recovery path; its severity is derived from the frozen result state, so a blocked prerequisite can never read as an optional optimization and a not-run or unknown check can never read as passed. Each health row names its check name, its status, its freshness/source, its Blocker/Warning/Info severity, an auto-fix or manual-fix note, and rerun/open-detail actions, and keeps an explicit same-weight path to Create empty or Continue without starter; its freshness posture is derived from the frozen freshness state, so a stale, expired, never-checked, or unavailable signal can never read as fresh. Every next step names one stable manifest/registry/docs/policy deep link rather than an ephemeral overlay or hidden route. No component hides a side effect behind a generic Create, hides its generated impact or recovery path, monopolizes the plain Create-empty/Continue-without-starter path, or invents an alternate state label; raw file bodies, raw secret values, pasted local paths, repository URLs, credentials, and secrets never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "preflight_cards",
    "health_rows",
    "downgrade_triggers",
    "consumer_surfaces",
    "readiness_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "ship_scaffold_preflight_cards_and_template_health_rows_with_generated_file_counts_immediate_versus_deferred_actions_blocked_warning_optional_checks_and_create_empty_parity_across_claimed_m5_bootstrap_lanes"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "surface_label": { "$ref": "#/$defs/non_empty_string" },
    "preflight_cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scaffold_preflight_card" }
    },
    "health_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/template_health_row" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "readiness_review": { "$ref": "#/$defs/readiness_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "preflight_check_class": {
      "enum": [
        "tooling_present",
        "dependency_availability",
        "network_access",
        "workspace_writable",
        "host_boundary",
        "credential_scope"
      ]
    },
    "preflight_result_state": {
      "enum": ["passed", "warning", "blocked", "skipped_optional", "not_run", "unknown"]
    },
    "side_effect_kind": {
      "enum": [
        "package_install",
        "dependency_restore",
        "remote_provisioning",
        "trust_prompt",
        "script_execution",
        "extension_install",
        "no_side_effect"
      ]
    },
    "action_timing": {
      "enum": [
        "runs_immediately",
        "deferred_for_later",
        "requires_confirmation",
        "blocked_until_resolved",
        "not_applicable"
      ]
    },
    "preflight_severity": {
      "enum": [
        "clear",
        "advisory",
        "blocked_prerequisite",
        "optional_skipped",
        "needs_attention"
      ]
    },
    "health_signal_class": {
      "enum": [
        "build_health",
        "dependency_freshness",
        "security_advisories",
        "test_status",
        "maintenance_cadence",
        "compatibility"
      ]
    },
    "health_freshness_state": {
      "enum": ["fresh", "aging", "stale", "expired", "never_checked", "unavailable"]
    },
    "health_severity": {
      "enum": ["blocker", "warning", "info"]
    },
    "health_fix_kind": {
      "enum": ["auto_fix_available", "manual_fix_required", "no_fix_needed"]
    },
    "health_freshness_posture": {
      "enum": ["current", "aging", "stale_or_expired", "never_checked", "unavailable"]
    },
    "deep_link_kind": {
      "enum": [
        "template_manifest",
        "starter_registry_entry",
        "docs_anchor",
        "policy_reference",
        "no_deep_link"
      ]
    },
    "preflight_card_action": {
      "enum": [
        "review_side_effects",
        "review_generated_impact",
        "review_recovery_path",
        "run_immediate_actions",
        "create_empty",
        "open_deep_link"
      ]
    },
    "health_row_action": {
      "enum": [
        "rerun_check",
        "open_detail",
        "create_empty",
        "continue_without_starter",
        "apply_fix",
        "open_deep_link"
      ]
    },
    "disposition": {
      "enum": [
        "first_party",
        "team_managed",
        "community",
        "local_only",
        "create_empty",
        "continue_without_starter",
        "blocked",
        "warning",
        "optional"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "state",
        "keyboard_route",
        "starter_source_and_support",
        "side_effect_disclosure",
        "recovery_and_ownership_boundary"
      ]
    },
    "surface_family": {
      "enum": [
        "start_center",
        "template_gallery",
        "scaffold_preflight",
        "generation_diff_review",
        "workspace_handoff",
        "cli_surface"
      ]
    },
    "deployment_line": {
      "enum": ["local_oss", "self_hosted", "managed", "air_gapped", "mirror_offline"]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "enum": [
        "start_center_ui",
        "template_gallery_ui",
        "parameter_form_ui",
        "preflight_ui",
        "diff_review_ui",
        "workspace_ui",
        "health_dashboard_ui",
        "cli_surface",
        "support_export"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "starter_source_unstated",
        "support_class_unstated",
        "side_effect_undisclosed",
        "host_boundary_unstated",
        "parameter_source_unstated",
        "action_timing_unstated",
        "impact_undisclosed",
        "health_freshness_stale",
        "generated_boundary_blurred",
        "recovery_path_omitted",
        "alternate_state_label_invented",
        "proof_stale"
      ]
    },
    "scaffold_preflight_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "card_id",
        "card_name",
        "check_class",
        "result_state",
        "side_effect_kind",
        "action_timing",
        "derived_severity",
        "claims_blocking_prerequisite",
        "claims_side_effecting",
        "claims_immediate_action",
        "side_effect_note",
        "blocked_note",
        "warning_note",
        "skipped_note",
        "attention_note",
        "target_path_label",
        "target_name_label",
        "generated_file_count",
        "generated_folder_count",
        "generated_impact_note",
        "dependency_impact_label",
        "task_impact_label",
        "extension_impact_label",
        "immediate_action_label",
        "deferred_action_label",
        "recovery_path_label",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "card_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_side_effect_behind_generic_create",
        "hides_generated_impact_or_recovery_path",
        "monopolizes_plain_create_without_starter_path",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "scaffold_preflight_card" },
        "card_id": { "$ref": "#/$defs/non_empty_string" },
        "card_name": { "$ref": "#/$defs/non_empty_string" },
        "check_class": { "$ref": "#/$defs/preflight_check_class" },
        "result_state": { "$ref": "#/$defs/preflight_result_state" },
        "side_effect_kind": { "$ref": "#/$defs/side_effect_kind" },
        "action_timing": { "$ref": "#/$defs/action_timing" },
        "derived_severity": { "$ref": "#/$defs/preflight_severity" },
        "claims_blocking_prerequisite": { "type": "boolean" },
        "claims_side_effecting": { "type": "boolean" },
        "claims_immediate_action": { "type": "boolean" },
        "side_effect_note": { "type": "string" },
        "blocked_note": { "type": "string" },
        "warning_note": { "type": "string" },
        "skipped_note": { "type": "string" },
        "attention_note": { "type": "string" },
        "target_path_label": { "$ref": "#/$defs/non_empty_string" },
        "target_name_label": { "$ref": "#/$defs/non_empty_string" },
        "generated_file_count": { "type": "integer", "minimum": 0 },
        "generated_folder_count": { "type": "integer", "minimum": 0 },
        "generated_impact_note": { "$ref": "#/$defs/non_empty_string" },
        "dependency_impact_label": { "$ref": "#/$defs/non_empty_string" },
        "task_impact_label": { "$ref": "#/$defs/non_empty_string" },
        "extension_impact_label": { "$ref": "#/$defs/non_empty_string" },
        "immediate_action_label": { "$ref": "#/$defs/non_empty_string" },
        "deferred_action_label": { "$ref": "#/$defs/non_empty_string" },
        "recovery_path_label": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "card_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "review_side_effects" } },
            { "contains": { "const": "review_generated_impact" } },
            { "contains": { "const": "review_recovery_path" } },
            { "contains": { "const": "create_empty" } }
          ],
          "items": { "$ref": "#/$defs/preflight_card_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_side_effect_behind_generic_create": { "const": false },
        "hides_generated_impact_or_recovery_path": { "const": false },
        "monopolizes_plain_create_without_starter_path": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "template_health_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "row_id",
        "check_name",
        "signal_class",
        "freshness_state",
        "severity",
        "fix_kind",
        "derived_freshness_posture",
        "claims_current",
        "claims_blocking_prerequisite",
        "status_label",
        "freshness_or_source_label",
        "stale_note",
        "never_checked_note",
        "unavailable_note",
        "fix_note",
        "create_empty_or_continue_note",
        "context_note",
        "deep_link_kind",
        "deep_link_ref",
        "row_actions",
        "dispositions",
        "downgrade_triggers",
        "required_labels",
        "surface_families",
        "deployment_lines",
        "accessibility_routes",
        "consumer_surfaces",
        "fields_shown",
        "source_contract_refs",
        "hides_side_effect_behind_generic_create",
        "hides_generated_impact_or_recovery_path",
        "monopolizes_plain_create_without_starter_path",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component": { "const": "template_health_row" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "check_name": { "$ref": "#/$defs/non_empty_string" },
        "signal_class": { "$ref": "#/$defs/health_signal_class" },
        "freshness_state": { "$ref": "#/$defs/health_freshness_state" },
        "severity": { "$ref": "#/$defs/health_severity" },
        "fix_kind": { "$ref": "#/$defs/health_fix_kind" },
        "derived_freshness_posture": { "$ref": "#/$defs/health_freshness_posture" },
        "claims_current": { "type": "boolean" },
        "claims_blocking_prerequisite": { "type": "boolean" },
        "status_label": { "$ref": "#/$defs/non_empty_string" },
        "freshness_or_source_label": { "$ref": "#/$defs/non_empty_string" },
        "stale_note": { "type": "string" },
        "never_checked_note": { "type": "string" },
        "unavailable_note": { "type": "string" },
        "fix_note": { "type": "string" },
        "create_empty_or_continue_note": { "$ref": "#/$defs/non_empty_string" },
        "context_note": { "$ref": "#/$defs/non_empty_string" },
        "deep_link_kind": { "$ref": "#/$defs/deep_link_kind" },
        "deep_link_ref": { "type": "string" },
        "row_actions": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "rerun_check" } },
            { "contains": { "const": "open_detail" } },
            {
              "anyOf": [
                { "contains": { "const": "create_empty" } },
                { "contains": { "const": "continue_without_starter" } }
              ]
            }
          ],
          "items": { "$ref": "#/$defs/health_row_action" }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployment_line" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" },
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "fields_shown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_side_effect_behind_generic_create": { "const": false },
        "hides_generated_impact_or_recovery_path": { "const": false },
        "monopolizes_plain_create_without_starter_path": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    },
    "readiness_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_card_shows_side_effects",
        "preflight_card_shows_generated_impact",
        "preflight_card_shows_immediate_versus_deferred",
        "preflight_card_names_recovery_path",
        "health_row_shows_severity_and_freshness",
        "health_row_shows_fix_note",
        "health_row_offers_rerun_and_open_detail",
        "health_row_offers_create_empty_or_continue_without_starter",
        "severity_and_freshness_derived_never_asserted",
        "blocked_prerequisite_never_shown_as_optional",
        "stale_signal_never_shown_as_fresh",
        "create_never_generic_hides_side_effects",
        "generated_file_counts_always_explicit",
        "recovery_path_always_reachable",
        "no_surface_invents_alternate_state_label",
        "components_stable_across_deployment_lines",
        "downgrade_narrows_instead_of_hides"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_center_reads_single_source",
        "preflight_surface_reads_single_source",
        "health_dashboard_reads_single_source",
        "side_effects_visible_before_commit",
        "recovery_path_visible_before_commit",
        "support_export_shows_component_truth"
      ],
      "patternProperties": { "^.*$": { "const": true } }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
