{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-test-intelligence-component-matrix.schema.json",
  "title": "Aureline M5 coverage-summary-bar, coverage-overlay-marker, flaky-state-badge, retry-history-row, snapshot-review-card, coverage-import-merge-sheet, and test-generation-suggestion-card component matrix",
  "description": "Export-safe packet freezing Aureline's reusable test-intelligence, quality-evidence, and AI-generated-test review components. The packet names every coverage-, flake-, snapshot-, and generated-test-facing component family M5 claims that still drifts too easily by surface — coverage-summary bars, coverage-overlay markers, flaky-state badges, retry-history rows, snapshot/golden review cards, coverage-import/merge sheets, and test-generation suggestion cards — and binds each to the claimed M5 test surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Every component binds the one controlled provenance vocabulary (verified current run, imported CI artifact, cached local result, stale prior result, suspected flaky, reproduced flaky, stable again, manually muted, unknown). Each component also declares the family-specific controlled vocabularies it carries: coverage scope classes and line-versus-branch metric kinds; overlay states and changed-line emphasis classes; flaky classifications and classifier confidence classes; retry attempt outcomes and rerun scope classes; snapshot baseline identities and diff states; coverage import sources and merge-resolution states; and generated-test assumption classes and apply scopes. Hard invariants forbid masking a provenance or freshness class, hiding a shard omission behind a single percentage, labelling an intermittent failure as confirmed flakiness, bundling generated changes into one opaque apply path, and inventing an alternate label for a governed state. Raw log bodies, raw local paths, raw usernames, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-runtime is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_coverage_summary_bar_coverage_overlay_marker_flaky_state_badge_retry_history_row_snapshot_review_card_coverage_import_merge_sheet_and_test_generation_suggestion_card_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "test_evidence_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "test_evidence_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "coverage_summary_bar",
        "coverage_overlay_marker",
        "flaky_state_badge",
        "retry_history_row",
        "snapshot_review_card",
        "coverage_import_merge_sheet",
        "test_generation_suggestion_card"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "provenance_classes",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_provenance_or_freshness_class",
        "hides_shard_omission_behind_single_percentage",
        "labels_intermittent_failure_as_confirmed_flaky",
        "bundles_generated_changes_into_opaque_apply",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "provenance_classes": { "type": "array", "minItems": 1 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "masks_provenance_or_freshness_class": { "const": false },
        "hides_shard_omission_behind_single_percentage": { "const": false },
        "labels_intermittent_failure_as_confirmed_flaky": { "const": false },
        "bundles_generated_changes_into_opaque_apply": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    }
  }
}
