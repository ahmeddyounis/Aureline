{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-response-tabset.schema.json",
  "title": "Aureline M5 response tabset",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "tabset_id", "request_identity_ref", "response_identity_ref", "tabs", "active_tab", "status_summary", "body_summary", "headers_cookies_summary", "assertions_summary", "timeline_summary", "actions", "execution_origin", "freshness_state", "export_posture", "source_refs", "consumer_surfaces", "copy_export"],
  "properties": {
    "record_kind": { "const": "m5_response_tabset" },
    "schema_version": { "const": 1 },
    "tabset_id": { "$ref": "#/$defs/id" },
    "request_identity_ref": { "$ref": "#/$defs/ref" },
    "response_identity_ref": { "$ref": "#/$defs/ref" },
    "tabs": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string", "enum": ["summary", "body", "headers_cookies", "assertions", "timeline", "raw", "rendered_safety"] } },
    "active_tab": { "type": "string", "enum": ["summary", "body", "headers_cookies", "assertions", "timeline", "raw", "rendered_safety"] },
    "status_summary": { "$ref": "#/$defs/ref" },
    "body_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_viewer_kind", "body_size_bytes", "truncation_state", "render_safety_state"],
      "properties": {
        "body_viewer_kind": { "type": "string", "enum": ["json_tree", "raw_text", "metadata_only", "redacted", "sanitized_rich", "binary_metadata"] },
        "body_size_bytes": { "type": "integer", "minimum": 0 },
        "truncation_state": { "type": "string", "enum": ["none", "body_truncated_size_budget", "body_truncated_policy", "metadata_only"] },
        "render_safety_state": { "type": "string", "enum": ["safe_structured", "sanitized_render", "raw_render_blocked", "metadata_only"] }
      }
    },
    "headers_cookies_summary": { "type": "object", "additionalProperties": false, "required": ["header_count", "cookie_count", "cookie_values_redacted"], "properties": { "header_count": { "type": "integer", "minimum": 0 }, "cookie_count": { "type": "integer", "minimum": 0 }, "cookie_values_redacted": { "const": true } } },
    "assertions_summary": { "type": "object", "additionalProperties": false, "required": ["pass", "fail", "error", "skipped"], "properties": { "pass": { "type": "integer", "minimum": 0 }, "fail": { "type": "integer", "minimum": 0 }, "error": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 } } },
    "timeline_summary": { "type": "object", "additionalProperties": false, "required": ["timing_ref", "phase_count", "captured_at"], "properties": { "timing_ref": { "$ref": "#/$defs/ref" }, "phase_count": { "type": "integer", "minimum": 0 }, "captured_at": { "$ref": "#/$defs/ref" } } },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_actions", "compare_actions", "action_label_parity"],
      "properties": {
        "export_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["export_summary", "export_body_redacted", "export_headers_cookies_redacted", "export_assertions", "export_timeline_transport", "export_support_packet"]
          }
        },
        "compare_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["compare_summary", "compare_body_metadata", "compare_headers_redacted", "compare_assertions", "compare_timeline_transport"]
          }
        },
        "action_label_parity": { "const": true }
      }
    },
    "browser_runtime_trust": { "type": ["object", "null"], "additionalProperties": false, "required": ["trust_class", "surface_kind", "cross_origin_disclosed"], "properties": { "trust_class": { "type": "string", "enum": ["network", "dom", "console", "storage", "not_applicable"] }, "surface_kind": { "$ref": "#/$defs/ref" }, "cross_origin_disclosed": { "type": "boolean" } } },
    "execution_origin": { "$ref": "#/$defs/origin" },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "export_posture": { "$ref": "#/$defs/export_posture" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "origin": { "type": "string", "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "imported_snapshot", "cli_headless"] },
    "freshness_state": { "type": "string", "enum": ["live", "current", "warm_cached", "cached", "imported", "stale", "superseded", "partial", "expired", "policy_limited", "unknown"] },
    "export_posture": { "type": "string", "enum": ["metadata_only", "redacted_typed", "visible_rows_only_typed", "full_result_typed", "blocked_pending_consent", "blocked_pending_policy", "blocked_redaction_class_too_high"] },
    "consumer_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["desktop_request_workspace", "desktop_database_tool", "remote_workspace", "container_workspace", "managed_workspace", "browser_runtime_panel", "notebook_handoff", "chart_handoff", "ai_context_handoff", "cli_headless", "support_export", "release_proof"] } },
    "copy_export": { "type": "object", "additionalProperties": false, "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "$ref": "#/$defs/ref" }, "json": { "$ref": "#/$defs/ref" }, "markdown": { "$ref": "#/$defs/ref" }, "screenshot_only_prohibited": { "const": true } } }
  }
}
