{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-framework-pack-header.schema.json",
  "title": "Aureline M5 framework pack header",
  "description": "Per-component contract for a framework pack header: the reusable component that names which framework pack and version is active and how it is supported. Binds the one controlled certainty vocabulary plus the pack support class and pack identity state. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape. A framework pack header never leaves its pack identity, version, or support class implicit and never presents bridge or heuristic behavior as exact first-party support.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "identity_label",
    "state_label",
    "keyboard_route_label",
    "certainty",
    "pack_support_class",
    "pack_identity_state"
  ],
  "properties": {
    "component_family": {
      "const": "framework_pack_header"
    },
    "identity_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "state_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certainty": {
      "$ref": "#/$defs/certainty_disposition"
    },
    "pack_support_class": {
      "$ref": "#/$defs/pack_support_class"
    },
    "pack_identity_state": {
      "$ref": "#/$defs/pack_identity_state"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "pack_support_class": {
      "enum": [
        "officially_supported",
        "community_supported",
        "experimental",
        "bridge_only",
        "deprecated",
        "unsupported"
      ]
    },
    "pack_identity_state": {
      "enum": [
        "identified_versioned",
        "version_pinned",
        "version_drifted",
        "multiple_detected",
        "unversioned",
        "unknown_pack"
      ]
    }
  }
}
