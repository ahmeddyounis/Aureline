{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-convention-diagnostic-row.schema.json",
  "title": "Aureline M5 convention-diagnostic row",
  "description": "Per-component contract for a convention-diagnostic row: the reusable component that names how confident a convention diagnostic is and its severity. Binds the one controlled certainty vocabulary plus the convention confidence class and diagnostic severity. The Rust validator in crates/aureline-templates is the authoritative gate; this schema documents the shape. A heuristic convention guess never reads as a verified fact and every diagnostic names the files that prove it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "identity_label",
    "state_label",
    "keyboard_route_label",
    "certainty",
    "convention_confidence_class",
    "diagnostic_severity"
  ],
  "properties": {
    "component_family": {
      "const": "convention_diagnostic_row"
    },
    "identity_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "state_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "certainty": {
      "$ref": "#/$defs/certainty_disposition"
    },
    "convention_confidence_class": {
      "$ref": "#/$defs/convention_confidence_class"
    },
    "diagnostic_severity": {
      "$ref": "#/$defs/diagnostic_severity"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "certainty_disposition": {
      "enum": [
        "core_native",
        "framework_pack",
        "bridge",
        "heuristic_convention",
        "verified",
        "derived_by_convention",
        "runtime_confirmed",
        "partial"
      ]
    },
    "convention_confidence_class": {
      "enum": [
        "verified",
        "high_confidence",
        "heuristic_convention",
        "derived_by_convention",
        "low_confidence",
        "unknown"
      ]
    },
    "diagnostic_severity": {
      "enum": [
        "error",
        "warning",
        "hint",
        "info",
        "suppressed",
        "stale"
      ]
    }
  }
}
