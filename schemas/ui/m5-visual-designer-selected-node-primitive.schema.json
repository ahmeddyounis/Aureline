{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-visual-designer-selected-node-primitive.schema.json",
  "title": "Aureline M5 selected-node primitive: design-canvas frame, structure-tree row, and property-inspector rows",
  "description": "Export-safe packet implementing Aureline's one reusable selected-node primitive across every claimed M5 visual-design surface — desktop designer, source-first preview, browser-runtime inspector, framework-pack preview, embedded shell designer, and support-export replay. Each surface row binds the shared canvas-frame / tree-row / inspector-row contract and carries worked selection cases: a resolver input (a selected node, its canvas source-ownership state, its support state, its viewport, and per-property edit inputs) and the resolved canvas frame, tree row, and inspector rows, which share one selection identity so a user never loses selection context moving between canvas, tree, inspector, and source. Each inspector row renders the distinct property-editor kind for its value state so a literal, a design token, a bound expression, an inherited value, a mixed value, and an unset value never collapse into one control. A property that claims a writing scope on a node that has not disclosed source ownership, or whose support state forbids a write, or that targets a blocked protected path, is refused rather than silently applied. The stored resolution must equal a fresh resolve of its input. Hard invariants forbid flattening property value states, losing selection identity across surfaces, mutating before source ownership is disclosed, and inventing a private designer grammar. The canvas state, structure-node kinds, property value states, property write scopes, device classes, and downgrade triggers are reused verbatim from the frozen M5 visual-designer component matrix; the protected-path posture, preview-diff class, mutation-review posture, and preview surface are reused from the sibling preview matrices. Raw source bodies, diff hunks, file contents, credentials, and raw provider payloads never cross this boundary. The Rust validator and resolver in crates/aureline-preview are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_design_canvas_structure_tree_and_property_inspector_selected_node_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "surface_family": {
      "type": "string",
      "enum": [
        "desktop_designer",
        "source_first_preview",
        "browser_runtime_inspector",
        "framework_pack_preview",
        "embedded_shell_designer",
        "support_export_replay"
      ]
    },
    "preview_surface": {
      "type": "string",
      "enum": [
        "source_first_framework_preview",
        "visual_surface_mapping",
        "browser_runtime_inspection",
        "device_or_simulator_preview",
        "full_stack_preview_loop",
        "embedded_webview_preview",
        "visual_edit_transform",
        "support_export_projection"
      ]
    },
    "node_kind": {
      "type": "string",
      "enum": [
        "source_element",
        "component_instance",
        "slot_or_children",
        "text_leaf",
        "generated_node",
        "unmapped_node"
      ]
    },
    "canvas_state": {
      "type": "string",
      "enum": [
        "source_bound_editable",
        "source_bound_read_only",
        "runtime_mirrored",
        "snapshot_static",
        "detached_needs_resync"
      ]
    },
    "support_state": {
      "type": "string",
      "enum": [
        "fully_supported",
        "partially_supported",
        "inspect_only",
        "unsupported_construct",
        "unmapped_node"
      ]
    },
    "value_state": {
      "type": "string",
      "enum": [
        "literal",
        "design_token",
        "bound_expression",
        "inherited",
        "mixed",
        "unset"
      ]
    },
    "write_scope": {
      "type": "string",
      "enum": [
        "single_literal_span",
        "token_definition_shared",
        "instance_override",
        "no_write_inspect_only",
        "blocked_protected"
      ]
    },
    "editor_kind": {
      "type": "string",
      "enum": [
        "literal_field",
        "token_bound_picker",
        "bound_expression_inspector",
        "inherited_value_trace",
        "mixed_multi_value",
        "unset_placeholder"
      ]
    },
    "device_class": {
      "type": "string",
      "enum": [
        "desktop_viewport",
        "tablet_viewport",
        "mobile_viewport",
        "custom_viewport",
        "device_tethered",
        "simulator_preview"
      ]
    },
    "protected_path_posture": {
      "type": "string",
      "enum": [
        "unprotected",
        "protected_review_required",
        "protected_blocked"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "selection_id",
        "node_kind",
        "canvas_state",
        "support_state",
        "property_value_states",
        "source_span_ref"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "drifted_from_source",
        "unmapped_source",
        "runtime_unavailable",
        "protected_path_blocked",
        "unsupported_construct",
        "round_trip_conflict_open",
        "unidentified_posture"
      ]
    },
    "property_edit_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_key", "value_state", "write_scope", "protected_path_posture", "value_repr"],
      "properties": {
        "property_key": { "$ref": "#/$defs/non_empty_string" },
        "value_state": { "$ref": "#/$defs/value_state" },
        "write_scope": { "$ref": "#/$defs/write_scope" },
        "protected_path_posture": { "$ref": "#/$defs/protected_path_posture" },
        "value_repr": { "type": "string" }
      }
    },
    "selection_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "node_label",
        "node_kind",
        "canvas_state",
        "support_state",
        "viewport",
        "visibility_hidden",
        "locked",
        "properties"
      ],
      "properties": {
        "selection_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
        "node_kind": { "$ref": "#/$defs/node_kind" },
        "canvas_state": { "$ref": "#/$defs/canvas_state" },
        "support_state": { "$ref": "#/$defs/support_state" },
        "viewport": { "$ref": "#/$defs/device_class" },
        "source_span_ref": { "type": "string" },
        "visibility_hidden": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "search_query": { "type": "string" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property_edit_input" }
        }
      }
    },
    "resolved_canvas_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "viewport",
        "canvas_state",
        "selected_node_outlined",
        "support_state",
        "open_source_action_available",
        "editable"
      ],
      "properties": {
        "selection_id": { "$ref": "#/$defs/non_empty_string" },
        "viewport": { "$ref": "#/$defs/device_class" },
        "canvas_state": { "$ref": "#/$defs/canvas_state" },
        "selected_node_outlined": { "type": "boolean" },
        "support_state": { "$ref": "#/$defs/support_state" },
        "open_source_action_available": { "type": "boolean" },
        "editable": { "type": "boolean" }
      }
    },
    "resolved_tree_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "node_label",
        "node_kind",
        "visibility_hidden",
        "locked",
        "support_state",
        "selection_synced",
        "search_match_highlighted",
        "open_source_action_available"
      ],
      "properties": {
        "selection_id": { "$ref": "#/$defs/non_empty_string" },
        "node_label": { "$ref": "#/$defs/non_empty_string" },
        "node_kind": { "$ref": "#/$defs/node_kind" },
        "visibility_hidden": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "support_state": { "$ref": "#/$defs/support_state" },
        "selection_synced": { "type": "boolean" },
        "search_match_highlighted": { "type": "boolean" },
        "open_source_action_available": { "type": "boolean" }
      }
    },
    "resolved_property_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_key",
        "value_state",
        "editor_kind",
        "write_scope",
        "writable",
        "reset_action_available",
        "open_source_action_available",
        "support_note",
        "requires_review"
      ],
      "properties": {
        "property_key": { "$ref": "#/$defs/non_empty_string" },
        "value_state": { "$ref": "#/$defs/value_state" },
        "editor_kind": { "$ref": "#/$defs/editor_kind" },
        "write_scope": { "$ref": "#/$defs/write_scope" },
        "writable": { "type": "boolean" },
        "reset_action_available": { "type": "boolean" },
        "open_source_action_available": { "type": "boolean" },
        "support_note": { "$ref": "#/$defs/non_empty_string" },
        "requires_review": { "type": "boolean" }
      }
    },
    "resolved_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "canvas_frame",
        "tree_row",
        "inspector_rows",
        "source_ownership_disclosed",
        "support_state_disclosed",
        "any_writable"
      ],
      "properties": {
        "selection_id": { "$ref": "#/$defs/non_empty_string" },
        "canvas_frame": { "$ref": "#/$defs/resolved_canvas_frame" },
        "tree_row": { "$ref": "#/$defs/resolved_tree_row" },
        "inspector_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolved_property_row" }
        },
        "source_ownership_disclosed": { "type": "boolean" },
        "support_state_disclosed": { "type": "boolean" },
        "any_writable": { "type": "boolean" }
      }
    },
    "selection_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/selection_input" },
        "resolved": { "$ref": "#/$defs/resolved_selection" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "preview_surface",
        "owner_role",
        "scope_summary",
        "value_states",
        "support_states",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_selections",
        "flattens_property_value_states",
        "loses_selection_identity_across_surfaces",
        "mutates_before_source_ownership_disclosed",
        "invents_private_designer_grammar"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "preview_surface": { "$ref": "#/$defs/preview_surface" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "value_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/value_state" }
        },
        "support_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/support_state" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "example_selections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selection_case" }
        },
        "flattens_property_value_states": { "const": false },
        "loses_selection_identity_across_surfaces": { "const": false },
        "mutates_before_source_ownership_disclosed": { "const": false },
        "invents_private_designer_grammar": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "support_states",
        "editor_kinds",
        "value_states",
        "write_scopes",
        "export_fields"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "$ref": "#/$defs/surface_family" } },
        "support_states": { "type": "array", "items": { "$ref": "#/$defs/support_state" } },
        "editor_kinds": { "type": "array", "items": { "$ref": "#/$defs/editor_kind" } },
        "value_states": { "type": "array", "items": { "$ref": "#/$defs/value_state" } },
        "write_scopes": { "type": "array", "items": { "$ref": "#/$defs/write_scope" } },
        "export_fields": { "type": "array", "items": { "$ref": "#/$defs/export_field" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_canvas_tree_inspector",
        "selection_identity_preserved_across_surfaces",
        "property_value_states_never_flattened",
        "source_ownership_and_support_disclosed_before_mutation",
        "support_export_reconstructs_selected_node",
        "no_surface_invents_second_grammar",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_canvas_tree_inspector": { "const": true },
        "selection_identity_preserved_across_surfaces": { "const": true },
        "property_value_states_never_flattened": { "const": true },
        "source_ownership_and_support_disclosed_before_mutation": { "const": true },
        "support_export_reconstructs_selected_node": { "const": true },
        "no_surface_invents_second_grammar": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "inspector_reads_single_editor_kind_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "visual_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "inspector_reads_single_editor_kind_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "selected_node_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "selected_node_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
