{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-execution-lifecycle-component-matrix.schema.json",
  "title": "Aureline M5 execution-lifecycle component matrix",
  "description": "Canonical freeze matrix for the reusable M5 execution-lifecycle component family: run/attempt headers, input-request prompts, artifact-publish rows, rerun comparison sheets, debug session headers, thread/process trees, and dump/crash artifact cards. Every reusable primitive, its state vocabulary, and its export / assistive parity are defined once so later M5 rows reference one canonical family instead of restating run/debug identity truth in feature-local prose. Run identity and attempt identity stay distinct; queued/preparing/running/waiting-input/partially-complete/passed/failed/cancelled/stale-output outcomes stay stable across UI/CLI/export; produced artifacts never lose producing-run lineage or retention truth; rerun controls disclose exact-versus-current-context differences before dispatch; debug hierarchy/cards keep launch/attach/core/replay/inspect-only, live-versus-captured, and local/remote/container/managed boundaries explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "set_label",
    "components",
    "guardrails",
    "consumer_projection",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_execution_lifecycle_component_matrix" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "set_label": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/component" }
    },
    "guardrails": { "$ref": "#/$defs/guardrails" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time", "minLength": 1 },
    "truth_mode": {
      "description": "Captured-versus-live truth class.",
      "enum": ["live", "captured", "imported", "planned", "provider_reported"]
    },
    "locality": {
      "description": "Local / remote / container / managed execution boundary.",
      "enum": ["local", "remote", "container", "managed"]
    },
    "run_outcome": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "waiting_input",
        "partially_complete",
        "passed",
        "failed",
        "cancelled",
        "stale_output"
      ]
    },
    "retention": {
      "enum": [
        "retained_durable",
        "expires_scheduled",
        "ephemeral_session_only",
        "evicted_recoverable",
        "evicted_gone"
      ]
    },
    "family": {
      "enum": [
        "run_attempt_header",
        "input_request_prompt",
        "artifact_publish_row",
        "rerun_comparison_sheet",
        "debug_session_header",
        "thread_process_tree",
        "dump_crash_artifact_card"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "execution_context",
        "truth_class",
        "outcome_or_state",
        "execution_boundary",
        "keyboard_route"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_attempt_identity_unresolved",
        "input_consequence_unknown",
        "artifact_lineage_lost",
        "artifact_retention_expired",
        "rerun_context_drift",
        "captured_evidence_only",
        "connector_lost",
        "debug_adapter_unavailable",
        "symbols_unavailable"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "family",
        "surface_label",
        "truth_mode",
        "locality",
        "execution_context_ref",
        "required_labels",
        "export_safe",
        "assistive_ready",
        "label_summary",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "component_id": { "$ref": "#/$defs/id" },
        "family": { "$ref": "#/$defs/family" },
        "surface_label": { "type": "string", "minLength": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "locality": { "$ref": "#/$defs/locality" },
        "execution_context_ref": { "$ref": "#/$defs/ref" },
        "required_labels": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "export_safe": { "type": "boolean" },
        "assistive_ready": { "type": "boolean" },
        "label_summary": { "type": "string", "minLength": 1 },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "degraded": { "$ref": "#/$defs/degraded" },
        "run_attempt_header": { "$ref": "#/$defs/run_attempt_header" },
        "input_request_prompt": { "$ref": "#/$defs/input_request_prompt" },
        "artifact_publish_row": { "$ref": "#/$defs/artifact_publish_row" },
        "rerun_comparison_sheet": { "$ref": "#/$defs/rerun_comparison_sheet" },
        "debug_session_header": { "$ref": "#/$defs/debug_session_header" },
        "thread_process_tree": { "$ref": "#/$defs/thread_process_tree" },
        "dump_crash_artifact_card": { "$ref": "#/$defs/dump_crash_artifact_card" }
      }
    },
    "degraded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "degraded_label"],
      "properties": {
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "degraded_label": { "type": "string", "minLength": 1 }
      }
    },
    "run_attempt_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_identity_ref",
        "attempt_identity_ref",
        "attempt_ordinal",
        "outcome",
        "truth_mode",
        "run_and_attempt_distinct"
      ],
      "properties": {
        "run_identity_ref": { "$ref": "#/$defs/ref" },
        "attempt_identity_ref": { "$ref": "#/$defs/ref" },
        "attempt_ordinal": { "type": "integer", "minimum": 1 },
        "outcome": { "$ref": "#/$defs/run_outcome" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "run_and_attempt_distinct": { "type": "boolean" }
      }
    },
    "input_request_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_ref",
        "consequence",
        "discloses_timeout",
        "discloses_approval",
        "has_deadline"
      ],
      "properties": {
        "prompt_ref": { "$ref": "#/$defs/ref" },
        "consequence": {
          "enum": [
            "timeout_cancels_run",
            "timeout_applies_default",
            "requires_approval",
            "blocks_until_answered",
            "dismiss_leaves_waiting"
          ]
        },
        "discloses_timeout": { "type": "boolean" },
        "discloses_approval": { "type": "boolean" },
        "has_deadline": { "type": "boolean" }
      }
    },
    "artifact_publish_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "producing_run_ref",
        "retention",
        "lineage_preserved",
        "retention_visible"
      ],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/ref" },
        "producing_run_ref": { "$ref": "#/$defs/ref" },
        "retention": { "$ref": "#/$defs/retention" },
        "lineage_preserved": { "type": "boolean" },
        "retention_visible": { "type": "boolean" }
      }
    },
    "rerun_comparison_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_run_ref",
        "rerun_context",
        "discloses_context_delta",
        "context_diff_shown_before_dispatch"
      ],
      "properties": {
        "baseline_run_ref": { "$ref": "#/$defs/ref" },
        "rerun_context": {
          "enum": [
            "exact_replay",
            "current_context",
            "modified_selection",
            "modified_environment"
          ]
        },
        "discloses_context_delta": { "type": "boolean" },
        "context_diff_shown_before_dispatch": { "type": "boolean" }
      }
    },
    "debug_session_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_ref",
        "session_mode",
        "truth_mode",
        "locality",
        "boundary_explicit"
      ],
      "properties": {
        "session_ref": { "$ref": "#/$defs/ref" },
        "session_mode": {
          "enum": ["launch", "attach", "core", "replay", "inspect_only"]
        },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "locality": { "$ref": "#/$defs/locality" },
        "boundary_explicit": { "type": "boolean" }
      }
    },
    "thread_process_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_ref",
        "node_count",
        "truth_mode",
        "locality",
        "live_vs_captured_explicit"
      ],
      "properties": {
        "root_ref": { "$ref": "#/$defs/ref" },
        "node_count": { "type": "integer", "minimum": 1 },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "locality": { "$ref": "#/$defs/locality" },
        "live_vs_captured_explicit": { "type": "boolean" }
      }
    },
    "dump_crash_artifact_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dump_ref",
        "producing_run_ref",
        "symbolication",
        "retention",
        "captured_truth"
      ],
      "properties": {
        "dump_ref": { "$ref": "#/$defs/ref" },
        "producing_run_ref": { "$ref": "#/$defs/ref" },
        "symbolication": {
          "enum": ["symbolicated", "partial_symbols", "unsymbolicated", "symbols_unavailable"]
        },
        "retention": { "$ref": "#/$defs/retention" },
        "captured_truth": { "type": "boolean" }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_and_attempt_identity_distinct",
        "outcomes_stable_across_ui_cli_export",
        "artifacts_never_lose_lineage_or_retention",
        "rerun_discloses_context_delta_before_dispatch",
        "debug_keeps_mode_truth_and_boundary_explicit",
        "exported_evidence_preserves_ids_states_and_lineage",
        "components_bound_to_shared_vocabulary",
        "no_new_runtimes_adapters_or_backends"
      ],
      "properties": {
        "run_and_attempt_identity_distinct": { "const": true },
        "outcomes_stable_across_ui_cli_export": { "const": true },
        "artifacts_never_lose_lineage_or_retention": { "const": true },
        "rerun_discloses_context_delta_before_dispatch": { "const": true },
        "debug_keeps_mode_truth_and_boundary_explicit": { "const": true },
        "exported_evidence_preserves_ids_states_and_lineage": { "const": true },
        "components_bound_to_shared_vocabulary": { "const": true },
        "no_new_runtimes_adapters_or_backends": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ingests_components",
        "docs_help_ingests_components",
        "diagnostics_ingests_components",
        "support_export_ingests_components",
        "release_control_ingests_components",
        "later_rows_reference_one_canonical_family"
      ],
      "properties": {
        "product_ingests_components": { "const": true },
        "docs_help_ingests_components": { "const": true },
        "diagnostics_ingests_components": { "const": true },
        "support_export_ingests_components": { "const": true },
        "release_control_ingests_components": { "const": true },
        "later_rows_reference_one_canonical_family": { "const": true }
      }
    }
  }
}
