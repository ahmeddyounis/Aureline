{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-migration-bridge-card.schema.json",
  "title": "Aureline M5 migration-bridge-card primitive",
  "description": "Export-safe packet implementing the reusable M5 migration bridge card as one primitive. The packet binds one row per claimed importer / migration consumer — the migration report panel, the import diff row, the first-run switch summary, the keybinding migration notice, and the support migration export — to the shared bridge-card anatomy, the migration mapping classes (exact/native/bridge/shimmed/partial/unsupported), the imported source tools, the derived bridge posture (exact-parity/native-equivalent/bridged-approximation/shimmed-compatibility/partial-coverage/unsupported-no-mapping), the bounded view-mapping-details/open-native-command/undo-import-changes/review-import-checkpoint/report-unsupported-edge-case actions, export fields, and non-visual accessibility routes. A self-describing vocabulary set freezes the controlled vocabulary. Each row carries worked resolution cases proving the resolver, and four hard invariants: it never masks its migration mapping state, never overstates an approximated or partial mapping as exact parity, never drops the affected scope or the unsupported edge cases, and never severs the import rollback / undo linkage. Raw imported config bodies, pasted paths, credentials, and private endpoints never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_migration_bridge_cards_with_old_path_new_command_mapping_native_bridge_shimmed_partial_states_and_undo_import_parity_across_claimed_m5_importer_and_migration_surfaces"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "matrix_label": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "migration_bridge_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "type": "string", "minLength": 1 },
        "migration_bridge_audit_ref": { "type": "string", "minLength": 1 },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "anatomy_parts",
        "mapping_classes",
        "source_tools",
        "bridge_postures",
        "bridge_actions",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "bridge_examples",
        "masks_mapping_state",
        "overstates_as_exact_parity",
        "drops_affected_scope_or_edge_cases",
        "severs_import_rollback_linkage"
      ],
      "properties": {
        "consumer_surface": {
          "enum": [
            "migration_report_panel",
            "import_diff_row",
            "first_run_switch_summary",
            "keybinding_migration_notice",
            "support_migration_export"
          ]
        },
        "qualification": {
          "enum": [
            "stable",
            "beta",
            "preview",
            "experimental",
            "unavailable",
            "held"
          ]
        },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 1 },
        "mapping_classes": { "type": "array", "minItems": 1 },
        "source_tools": { "type": "array", "minItems": 1 },
        "bridge_postures": { "type": "array", "minItems": 1 },
        "bridge_actions": { "type": "array", "minItems": 1 },
        "export_fields": { "type": "array", "minItems": 1 },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "contains": { "const": "keyboard_focusable" }
        },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "required_proof_packet_refs": { "type": "array" },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "bridge_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bridge_example" }
        },
        "masks_mapping_state": { "const": false },
        "overstates_as_exact_parity": { "const": false },
        "drops_affected_scope_or_edge_cases": { "const": false },
        "severs_import_rollback_linkage": { "const": false }
      }
    },
    "bridge_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "type": "object" },
        "resolved": {
          "type": "object",
          "required": [
            "mapping_class",
            "source_tool",
            "old_path_ref",
            "new_command_ref",
            "affected_scope",
            "unsupported_edge_cases",
            "rollback_checkpoint_ref",
            "bridge_identity_ref",
            "bridge_posture",
            "available_actions",
            "claims_exact_parity",
            "is_faithful_mapping",
            "is_approximated_mapping",
            "is_incomplete_mapping",
            "is_unsupported_mapping",
            "import_created_durable_change",
            "has_rollback_checkpoint",
            "open_native_command_available",
            "undo_available",
            "discloses_old_path_and_new_command",
            "discloses_mapping_state_honestly",
            "never_overstates_as_exact_parity",
            "preserves_affected_scope",
            "preserves_unsupported_edge_cases",
            "preserves_import_rollback_linkage",
            "keeps_undo_review_available_for_durable_changes"
          ]
        }
      }
    }
  }
}
