{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-on-call-strip.schema.json",
  "title": "Aureline M5 on-call strip",
  "description": "Export-safe shape for a single M5 on call strip instance. The component carries the frozen governance readiness-state vocabulary shared across the M5 governance-dashboard component matrix plus its own family-specific vocabulary. The Rust validator in crates/aureline-release is the authoritative gate; this schema documents the shape. Raw URLs, raw tokens, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_family",
    "qualification",
    "identity",
    "readiness_state",
    "evidence_freshness",
    "keyboard_route",
    "on_call_coverage_state",
    "escalation_route"
  ],
  "properties": {
    "component_family": {
      "const": "on_call_strip"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "identity": {
      "$ref": "#/$defs/non_empty_string"
    },
    "readiness_state": {
      "$ref": "#/$defs/readiness_state"
    },
    "evidence_freshness": {
      "$ref": "#/$defs/non_empty_string"
    },
    "keyboard_route": {
      "$ref": "#/$defs/non_empty_string"
    },
    "on_call_coverage_state": {
      "$ref": "#/$defs/on_call_coverage_state"
    },
    "escalation_route": {
      "$ref": "#/$defs/escalation_route_class"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "readiness_state": {
      "enum": [
        "passing",
        "warning",
        "blocked",
        "waived",
        "expired_waiver",
        "evidence_stale",
        "owner_unresolved",
        "forum_unresolved",
        "not_evaluated"
      ]
    },
    "on_call_coverage_state": {
      "enum": [
        "on_call_covered",
        "on_call_gap",
        "escalation_only",
        "follow_the_sun",
        "on_call_unknown"
      ]
    },
    "escalation_route_class": {
      "enum": [
        "page_primary",
        "page_backup",
        "escalate_to_manager",
        "incident_bridge",
        "no_escalation_path"
      ]
    }
  }
}
