{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-experiment-component-matrix.schema.json",
  "title": "Aureline M5 experiment-run-row, dataset-provenance-card, artifact-lineage-panel, run-comparison-table, environment-fingerprint-card, compare-guard-banner, sensitivity-sharing-banner, and result-summary-card component matrix",
  "description": "Export-safe packet freezing Aureline's reusable experiment / reproducibility components. The packet names every notebook-adjacent and data-workflow component family M5 claims that still drifts too easily by surface — experiment run rows, dataset provenance cards, artifact lineage panels, run comparison tables, environment fingerprint cards, compare guard banners, sensitivity / sharing banners, and result summary cards — and binds each to the claimed M5 notebook-adjacent / data-workflow surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers, and the mandatory labels it must be able to show. Every component binds the one controlled disposition vocabulary (local_run, managed_run, imported_run, manual_attach, reproducible, likely_reproducible, needs_rerun, context_incomplete) plus the family-specific controlled vocabularies it carries: run origin kinds and status states; dataset source classes and provenance states; artifact kinds and lineage states; comparison axes and comparability states; fingerprint scopes and capture states; compare guard reasons and guard states; sensitivity classes and share scopes; and summary content classes and export scopes. Hard invariants forbid masking a dataset provenance / sensitivity state, hiding a run origin / code revision, implying an apples-to-apples comparison without parity evidence, and inventing an alternate label for a governed state. Raw dataset payloads, raw local paths, tokens, and credentials never cross this boundary. The Rust validator in crates/aureline-notebook is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_the_m5_experiment_run_row_dataset_provenance_card_artifact_lineage_panel_run_comparison_table_environment_fingerprint_card_compare_guard_banner_sensitivity_sharing_banner_and_result_summary_card_component_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "experiment_component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "experiment_component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "experiment_run_row",
        "dataset_provenance_card",
        "artifact_lineage_panel",
        "run_comparison_table",
        "environment_fingerprint_card",
        "compare_guard_banner",
        "sensitivity_sharing_banner",
        "result_summary_card"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "disposition": {
      "enum": [
        "local_run",
        "managed_run",
        "imported_run",
        "manual_attach",
        "reproducible",
        "likely_reproducible",
        "needs_rerun",
        "context_incomplete"
      ]
    },
    "component_row": {
      "type": "object",
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "dispositions",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "masks_provenance_or_sensitivity_state",
        "hides_run_origin_or_revision",
        "implies_apples_to_apples_without_parity",
        "invents_alternate_state_label"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "surface_families": { "type": "array", "minItems": 1 },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/disposition" }
        },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "consumer_surfaces": { "type": "array", "minItems": 1 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "masks_provenance_or_sensitivity_state": { "const": false },
        "hides_run_origin_or_revision": { "const": false },
        "implies_apples_to_apples_without_parity": { "const": false },
        "invents_alternate_state_label": { "const": false }
      }
    }
  }
}
