{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-package-management-component-certification.schema.json",
  "title": "M5 Package-Management Component Surface Certification",
  "description": "Surface certification that the eight shared M5 package-management components (package-explorer-row, manifest-scope-switcher, install-review-sheet, registry-or-mirror-row, script-risk-notice, lockfile-impact-card, grouped-update-planner, rollback-checkpoint-strip) present the same controlled component truth on every claimed M5 package-management surface, with no hidden manifest-scope, registry-source, auth, script-risk, or lockfile-churn drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "certification_label",
    "surface_rows",
    "summary",
    "downgrade_triggers",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_package_management_component_surface_certification_truth" },
    "schema_version": { "type": "integer", "const": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "certification_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 9,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "component": {
      "type": "string",
      "enum": [
        "package_explorer_row",
        "manifest_scope_switcher",
        "install_review_sheet",
        "registry_or_mirror_row",
        "script_risk_notice",
        "lockfile_impact_card",
        "grouped_update_planner",
        "rollback_checkpoint_strip"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "package_explorer_surface",
        "dependency_search_detail_surface",
        "install_review_sheet_surface",
        "help_package_surface",
        "support_export",
        "exported_package_review_packet",
        "cli_headless",
        "diagnostics"
      ]
    },
    "axis": {
      "type": "string",
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "cli_export",
        "degraded_state",
        "scope_and_source_provenance"
      ]
    },
    "axis_state": {
      "type": "string",
      "enum": ["certified", "narrowed_certified", "not_certified_here"]
    },
    "claim_tier": {
      "type": "string",
      "enum": [
        "full_reviewable_management",
        "manifest_range_scoped",
        "mirror_or_offline_sourced",
        "auth_required_read_only",
        "lockfile_impact_unknown",
        "rollback_unavailable_manual_recovery"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["certified_parity", "narrowed_parity", "parity_blocked"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "evidence_packet_invalid",
        "policy_blocked",
        "manifest_scope_partial",
        "registry_freshness_stale",
        "auth_state_unsatisfied",
        "lockfile_impact_unavailable",
        "script_risk_undisclosed",
        "rollback_checkpoint_unavailable",
        "upstream_dependency_narrowed"
      ]
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "note"],
      "properties": {
        "axis": { "$ref": "#/$defs/axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface",
        "components_present",
        "claimed_claim",
        "certified_claim",
        "status",
        "axis_outcomes",
        "narrowed_axes",
        "downgrade_trigger",
        "component_truth_preserved",
        "keyboard_label",
        "screen_reader_label",
        "cli_enum_token",
        "export_enum_token",
        "explanation_field",
        "source_contract_refs"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "components_present": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "claimed_claim": { "$ref": "#/$defs/claim_tier" },
        "certified_claim": { "$ref": "#/$defs/claim_tier" },
        "status": { "$ref": "#/$defs/status" },
        "axis_outcomes": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "narrowed_axes": {
          "type": "array",
          "items": { "$ref": "#/$defs/axis" }
        },
        "downgrade_trigger": {
          "oneOf": [{ "$ref": "#/$defs/downgrade_trigger" }, { "type": "null" }]
        },
        "component_truth_preserved": { "type": "boolean" },
        "keyboard_label": { "type": "string", "minLength": 1 },
        "screen_reader_label": { "type": "string", "minLength": 1 },
        "cli_enum_token": { "type": "string", "minLength": 1 },
        "export_enum_token": { "type": "string", "minLength": 1 },
        "explanation_field": { "type": "string", "minLength": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "component_truth_preserved": { "const": false } } },
          "then": { "properties": { "status": { "const": "parity_blocked" } } }
        },
        {
          "if": {
            "properties": { "narrowed_axes": { "minItems": 1 } }
          },
          "then": {
            "properties": { "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" } }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "certified_count",
        "narrowed_count",
        "blocked_count",
        "all_rows_preserve_component_truth",
        "all_surfaces_covered",
        "all_components_covered",
        "certification_note"
      ],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "certified_count": { "type": "integer", "minimum": 0 },
        "narrowed_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "all_rows_preserve_component_truth": { "type": "boolean" },
        "all_surfaces_covered": { "type": "boolean" },
        "all_components_covered": { "type": "boolean" },
        "certification_note": { "type": "string", "minLength": 1 }
      }
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_component_truth_on_every_surface",
        "manifest_scope_and_relation_explicit",
        "registry_source_and_freshness_explicit",
        "auth_posture_explicit",
        "script_and_native_build_risk_explicit",
        "lockfile_churn_quantified_not_understated",
        "grouped_update_reason_and_rollback_identity_explicit",
        "certified_never_implies_safe_one_click",
        "mirror_or_offline_continuity_explicit",
        "narrows_instead_of_dropping_meaning",
        "flattened_truth_blocks_certification"
      ],
      "properties": {
        "same_component_truth_on_every_surface": { "const": true },
        "manifest_scope_and_relation_explicit": { "const": true },
        "registry_source_and_freshness_explicit": { "const": true },
        "auth_posture_explicit": { "const": true },
        "script_and_native_build_risk_explicit": { "const": true },
        "lockfile_churn_quantified_not_understated": { "const": true },
        "grouped_update_reason_and_rollback_identity_explicit": { "const": true },
        "certified_never_implies_safe_one_click": { "const": true },
        "mirror_or_offline_continuity_explicit": { "const": true },
        "narrows_instead_of_dropping_meaning": { "const": true },
        "flattened_truth_blocks_certification": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_explorer_surface_shows_certification",
        "dependency_search_detail_surface_shows_certification",
        "install_review_sheet_surface_shows_certification",
        "help_package_surface_shows_certification",
        "support_export_shows_certification",
        "exported_package_review_packet_shows_certification",
        "cli_headless_shows_certification",
        "diagnostics_shows_certification",
        "narrowed_surfaces_visibly_labelled"
      ],
      "properties": {
        "package_explorer_surface_shows_certification": { "const": true },
        "dependency_search_detail_surface_shows_certification": { "const": true },
        "install_review_sheet_surface_shows_certification": { "const": true },
        "help_package_surface_shows_certification": { "const": true },
        "support_export_shows_certification": { "const": true },
        "exported_package_review_packet_shows_certification": { "const": true },
        "cli_headless_shows_certification": { "const": true },
        "diagnostics_shows_certification": { "const": true },
        "narrowed_surfaces_visibly_labelled": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
