{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-explain-plan-pane.schema.json",
  "title": "Aureline M5 explain plan pane",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "pane_id", "statement_identity_ref", "engine_family", "engine_version_ref", "plan_capture_kind", "estimated_vs_actual_truth", "actual_execution_disclosed", "freshness_state", "captured_at", "execution_origin", "plan_node_count", "comparison", "export_posture", "source_refs", "consumer_surfaces", "copy_export"],
  "properties": {
    "record_kind": { "const": "m5_explain_plan_pane" },
    "schema_version": { "const": 1 },
    "pane_id": { "$ref": "#/$defs/id" },
    "statement_identity_ref": { "$ref": "#/$defs/ref" },
    "engine_family": { "type": "string", "enum": ["postgresql", "mysql", "sqlite", "duckdb", "snowflake", "bigquery", "unknown"] },
    "engine_version_ref": { "$ref": "#/$defs/ref" },
    "plan_capture_kind": { "type": "string", "enum": ["estimated", "actual", "imported_estimated", "imported_actual", "unavailable"] },
    "estimated_vs_actual_truth": { "type": "string", "enum": ["estimated_no_execution", "actual_executed", "imported_estimated_not_replayed", "imported_actual_prior_execution", "unavailable"] },
    "actual_execution_disclosed": { "type": "boolean" },
    "freshness_state": { "$ref": "#/$defs/freshness_state" },
    "captured_at": { "$ref": "#/$defs/ref" },
    "execution_origin": { "$ref": "#/$defs/origin" },
    "plan_node_count": { "type": "integer", "minimum": 0 },
    "comparison": { "type": "object", "additionalProperties": false, "required": ["comparison_basis", "baseline_plan_ref", "compared_plan_ref", "diff_visible", "rollback_recommendation"], "properties": { "comparison_basis": { "type": "string", "enum": ["none", "estimated_vs_actual", "same_query_different_time", "imported_vs_live", "different_query"] }, "baseline_plan_ref": { "type": ["string", "null"], "minLength": 1 }, "compared_plan_ref": { "type": ["string", "null"], "minLength": 1 }, "diff_visible": { "type": "boolean" }, "rollback_recommendation": { "type": "string", "enum": ["none", "recommended", "not_available", "inconclusive"] } } },
    "export_posture": { "$ref": "#/$defs/export_posture" },
    "source_refs": { "$ref": "#/$defs/ref_array" },
    "consumer_surfaces": { "$ref": "#/$defs/consumer_surfaces" },
    "copy_export": { "$ref": "#/$defs/copy_export" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "ref_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "origin": { "type": "string", "enum": ["local_desktop", "ssh_remote", "container_workspace", "managed_workspace", "browser_runtime", "imported_snapshot", "cli_headless"] },
    "freshness_state": { "type": "string", "enum": ["live", "current", "warm_cached", "cached", "imported", "stale", "superseded", "partial", "expired", "policy_limited", "unknown"] },
    "export_posture": { "type": "string", "enum": ["metadata_only", "redacted_typed", "visible_rows_only_typed", "full_result_typed", "blocked_pending_consent", "blocked_pending_policy", "blocked_redaction_class_too_high"] },
    "consumer_surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["desktop_request_workspace", "desktop_database_tool", "remote_workspace", "container_workspace", "managed_workspace", "browser_runtime_panel", "notebook_handoff", "chart_handoff", "ai_context_handoff", "cli_headless", "support_export", "release_proof"] } },
    "copy_export": { "type": "object", "additionalProperties": false, "required": ["formats", "export_fields", "text", "json", "markdown", "screenshot_only_prohibited"], "properties": { "formats": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["text", "json", "markdown"] } }, "export_fields": { "$ref": "#/$defs/ref_array" }, "text": { "$ref": "#/$defs/ref" }, "json": { "$ref": "#/$defs/ref" }, "markdown": { "$ref": "#/$defs/ref" }, "screenshot_only_prohibited": { "const": true } } }
  }
}
