{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-deployment-continuity-accessibility-fallback.schema.json",
  "title": "Aureline M5 deployment/continuity component accessibility fallback & auto-narrowing",
  "description": "M05-834 accessibility-and-auto-narrowing capstone over the frozen M5 deployment/continuity component matrix. Certifies, per component family, that install-profile cards, rollout rows, deployment summaries, residual-dependency rows, control-plane/data-plane status strips, mirror/offline rows, and review sheets stay keyboard-complete, screen-reader-reachable, CLI/export-safe, and self-narrowing. A stale or limited deployment lane cannot present as fully healthy, fully self-hosted, or fully current; accessibility and export surfaces preserve the same install/deployment IDs, operating-mode labels, and residual-dependency states shown in-product; and claim publication stays aligned with field triage downgrade behavior. Raw config bytes, credentials, license keys, mirror URLs, provider cursors, and raw device identifiers never cross this metadata-only boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_deployment_continuity_accessibility_fallback_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "component_family": {
      "enum": [
        "install_profile_card",
        "side_by_side_import_sheet",
        "rollout_ring_row",
        "deployment_summary_card",
        "residual_dependency_row",
        "control_plane_data_plane_status_strip",
        "mirror_offline_artifact_row",
        "mode_change_review_sheet",
        "channel_association_review_row"
      ]
    },
    "fallback_modality": {
      "enum": ["structured", "list", "textual", "cli"]
    },
    "rendering_surface": {
      "enum": [
        "desktop_full",
        "admin_console",
        "browser_readonly",
        "cli_headless",
        "handoff_packet",
        "support_export"
      ]
    },
    "reach_state": {
      "enum": [
        "reachable_and_labeled",
        "disclosed_reduced_but_reachable",
        "view_only_trap"
      ]
    },
    "export_summary_state": {
      "enum": [
        "reconstructable_without_screenshot",
        "disclosed_partial_capture",
        "absent_needs_screenshot"
      ]
    },
    "narrowing_disclosure_state": {
      "enum": ["parity_preserved", "disclosed_narrowed", "silently_dropped"]
    },
    "interactive_claim": {
      "enum": [
        "fully_current_managed",
        "review_required",
        "local_cached_only",
        "inspect_only"
      ]
    },
    "claim_dimension": {
      "enum": [
        "rollout_state",
        "residual_dependency",
        "control_plane_freshness",
        "mirror_verification",
        "handler_ownership",
        "state_root_integrity"
      ]
    },
    "claim_condition_state": {
      "enum": ["intact", "partial", "stale", "unavailable", "policy_blocked"]
    },
    "downgrade_trigger": {
      "enum": [
        "control_plane_impaired",
        "mirror_stale",
        "offline_cache_only",
        "signature_unverified",
        "rollout_paused",
        "handler_ownership_contested",
        "state_root_unavailable",
        "residual_vendor_dependency",
        "provenance_incomplete"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "operating_mode",
        "ownership_or_scope",
        "freshness_class",
        "continuity_state",
        "keyboard_route"
      ]
    },
    "consumer_surface": {
      "enum": [
        "about_install_card",
        "update_center",
        "admin_fleet_console",
        "side_by_side_review",
        "diagnostics_deployment",
        "support_export_replay"
      ]
    },
    "copy_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "screenshot_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_only_prohibited": { "const": true }
      }
    },
    "claim_condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state"],
      "properties": {
        "dimension": { "$ref": "#/$defs/claim_dimension" },
        "state": { "$ref": "#/$defs/claim_condition_state" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrowed_to",
        "binding_dimension",
        "trigger",
        "narrowed_label",
        "preserves_canonical_identity"
      ],
      "properties": {
        "narrowed_to": { "$ref": "#/$defs/interactive_claim" },
        "binding_dimension": { "$ref": "#/$defs/claim_dimension" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "narrowed_label": { "type": "string", "minLength": 1 },
        "preserves_canonical_identity": { "const": true }
      }
    },
    "rendering_narrowing_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_surface", "state"],
      "properties": {
        "rendering_surface": { "$ref": "#/$defs/rendering_surface" },
        "state": { "$ref": "#/$defs/narrowing_disclosure_state" },
        "preserved_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reduced_interactions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "component_family",
        "source_family_schema_ref",
        "operating_context_ref",
        "fallback_modalities",
        "reaches_canonical_truth",
        "keyboard_reach",
        "screen_reader_reach",
        "cli_reach",
        "export_summary",
        "export_summary_ref",
        "copy_export",
        "full_interactive_claim",
        "claim_conditions",
        "rendering_surfaces",
        "narrowing_disclosures",
        "required_labels",
        "consumer_surfaces",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_deployment_continuity_accessibility_fallback_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "component_family": { "$ref": "#/$defs/component_family" },
        "source_family_schema_ref": { "type": "string", "minLength": 1 },
        "operating_context_ref": { "type": "string", "minLength": 1 },
        "fallback_modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback_modality" }
        },
        "reaches_canonical_truth": { "type": "boolean" },
        "keyboard_reach": { "$ref": "#/$defs/reach_state" },
        "screen_reader_reach": { "$ref": "#/$defs/reach_state" },
        "cli_reach": { "$ref": "#/$defs/reach_state" },
        "export_summary": { "$ref": "#/$defs/export_summary_state" },
        "export_summary_ref": { "type": "string", "minLength": 1 },
        "copy_export": { "$ref": "#/$defs/copy_export" },
        "full_interactive_claim": { "$ref": "#/$defs/interactive_claim" },
        "claim_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim_condition_entry" }
        },
        "claim_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "rendering_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_surface" }
        },
        "narrowing_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/rendering_narrowing_disclosure" }
        },
        "required_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_label" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_count",
        "non_visual_layout_family_count",
        "all_non_visual_layout_have_non_visual_fallback",
        "all_reach_canonical_truth_via_at",
        "all_claims_honest",
        "all_export_summaries_preserve_meaning",
        "all_narrowing_disclosed",
        "green_count",
        "yellow_count",
        "red_count",
        "rendering_surface_count",
        "consumer_surface_count"
      ],
      "properties": {
        "family_count": { "type": "integer", "minimum": 0 },
        "non_visual_layout_family_count": { "type": "integer", "minimum": 0 },
        "all_non_visual_layout_have_non_visual_fallback": { "type": "boolean" },
        "all_reach_canonical_truth_via_at": { "type": "boolean" },
        "all_claims_honest": { "type": "boolean" },
        "all_export_summaries_preserve_meaning": { "type": "boolean" },
        "all_narrowing_disclosed": { "type": "boolean" },
        "green_count": { "type": "integer", "minimum": 0 },
        "yellow_count": { "type": "integer", "minimum": 0 },
        "red_count": { "type": "integer", "minimum": 0 },
        "rendering_surface_count": { "type": "integer", "minimum": 0 },
        "consumer_surface_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
