{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ui/m5-input-request-artifact-publish.schema.json",
  "title": "Aureline M5 input-request / artifact-publish primitive",
  "description": "Canonical parity matrix for the reusable M5 input-request-prompt and artifact-publish-row primitive: a typed input-request prompt, a set of produced artifact-publish rows, a CLI/headless line, and a support-export projection that all resolve from one bounded execution interaction and share one interaction identity, one run identity, and one attempt identity. Narrows the input_request_prompt and artifact_publish_row families of the frozen M5 execution-lifecycle component matrix into one working resolver. Dismissed or timed-out requests resolve to a visible, attributable posture rather than a silent failure (AC1); produced artifacts stay attributable to their producing run and attempt after the live pane clears (AC2); every artifact discloses whether it is live, buffered, imported, sampled, or provider-supplied before it is opened or exported (AC3). Raw prompt bytes, secret values, artifact bytes, provider cursors, credentials, and raw event payloads never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_input_request_artifact_publish_primitive" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "matrix_label": { "type": "string", "minLength": 1 },
    "surface_rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ref" }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "surface_family": {
      "enum": [
        "task_run_pane",
        "test_run_pane",
        "request_run_pane",
        "notebook_execution",
        "ai_mediated_execution",
        "publish_flow",
        "preview_flow",
        "history_activity_center",
        "support_export_replay",
        "companion_summary"
      ]
    },
    "input_kind": {
      "enum": [
        "plain_text",
        "secret_input",
        "file_path_selection",
        "approval",
        "choice",
        "device_browser_handoff"
      ]
    },
    "input_disposition": {
      "enum": ["awaiting_response", "continued", "timed_out", "dismissed", "cancelled"]
    },
    "input_result_posture": {
      "enum": [
        "awaiting_response",
        "run_proceeds",
        "run_proceeds_with_default",
        "run_blocked_waiting",
        "run_cancelled"
      ]
    },
    "input_consequence": {
      "enum": [
        "timeout_cancels_run",
        "timeout_applies_default",
        "requires_approval",
        "blocks_until_answered",
        "dismiss_leaves_waiting"
      ]
    },
    "artifact_kind": {
      "enum": [
        "report",
        "trace",
        "preview_endpoint",
        "bundle",
        "imported_provider_artifact",
        "diagnostic_log"
      ]
    },
    "artifact_freshness": {
      "enum": ["live", "buffered", "imported", "sampled", "provider_supplied"]
    },
    "artifact_trust_class": {
      "enum": [
        "first_party_verified",
        "first_party_unverified",
        "provider_attested",
        "untrusted"
      ]
    },
    "retention_class": {
      "enum": [
        "retained_durable",
        "expires_scheduled",
        "ephemeral_session_only",
        "evicted_recoverable",
        "evicted_gone"
      ]
    },
    "outcome": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "waiting_input",
        "partially_complete",
        "passed",
        "failed",
        "cancelled",
        "stale_output"
      ]
    },
    "truth_mode": {
      "enum": ["live", "captured", "imported", "planned", "provider_reported"]
    },
    "locality": { "enum": ["local", "remote", "container", "managed"] },
    "export_field": {
      "enum": [
        "run_id",
        "attempt_id",
        "attempt_ordinal",
        "run_outcome",
        "input_prompt_ref",
        "input_disposition",
        "input_result_posture",
        "artifact_ref",
        "producing_run_ref",
        "artifact_freshness",
        "artifact_retention",
        "artifact_trust"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "run_attempt_identity_unresolved",
        "input_consequence_unknown",
        "artifact_lineage_lost",
        "artifact_retention_expired",
        "rerun_context_drift",
        "captured_evidence_only",
        "connector_lost",
        "debug_adapter_unavailable",
        "symbols_unavailable"
      ]
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_family",
        "owner_role",
        "scope_summary",
        "input_kinds",
        "artifact_kinds",
        "freshness_classes",
        "export_fields",
        "downgrade_triggers",
        "consumer_surfaces",
        "source_contract_refs",
        "example_interactions",
        "hides_input_consequence",
        "drops_artifact_lineage",
        "hides_artifact_freshness",
        "drops_export_ids_or_states"
      ],
      "properties": {
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owner_role": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string", "minLength": 1 },
        "input_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/input_kind" }
        },
        "artifact_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_kind" }
        },
        "freshness_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_freshness" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "example_interactions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case" }
        },
        "hides_input_consequence": { "const": false },
        "drops_artifact_lineage": { "const": false },
        "hides_artifact_freshness": { "const": false },
        "drops_export_ids_or_states": { "const": false }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/input" },
        "resolved": { "$ref": "#/$defs/resolved" }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "interaction_id",
        "run_ref",
        "attempt_ref",
        "attempt_ordinal",
        "run_label",
        "run_outcome",
        "truth_mode",
        "target_boundary",
        "context_summary",
        "age_label"
      ],
      "properties": {
        "interaction_id": { "$ref": "#/$defs/id" },
        "run_ref": { "$ref": "#/$defs/ref" },
        "attempt_ref": { "$ref": "#/$defs/ref" },
        "attempt_ordinal": { "type": "integer", "minimum": 1 },
        "run_label": { "type": "string", "minLength": 1 },
        "run_outcome": { "$ref": "#/$defs/outcome" },
        "truth_mode": { "$ref": "#/$defs/truth_mode" },
        "target_boundary": { "$ref": "#/$defs/locality" },
        "context_summary": { "type": "string", "minLength": 1 },
        "age_label": { "type": "string", "minLength": 1 },
        "input_request": { "$ref": "#/$defs/input_request" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "input_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_ref",
        "kind",
        "prompt_label",
        "consequence",
        "disposition",
        "has_deadline"
      ],
      "properties": {
        "prompt_ref": { "$ref": "#/$defs/ref" },
        "kind": { "$ref": "#/$defs/input_kind" },
        "prompt_label": { "type": "string", "minLength": 1 },
        "consequence": { "$ref": "#/$defs/input_consequence" },
        "disposition": { "$ref": "#/$defs/input_disposition" },
        "has_deadline": { "type": "boolean" },
        "deadline_label": { "type": "string", "minLength": 1 },
        "default_label": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "producing_run_ref",
        "producing_attempt_ref",
        "producing_step_label",
        "artifact_label",
        "kind",
        "freshness",
        "retention",
        "trust"
      ],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/ref" },
        "producing_run_ref": { "$ref": "#/$defs/ref" },
        "producing_attempt_ref": { "$ref": "#/$defs/ref" },
        "producing_step_label": { "type": "string", "minLength": 1 },
        "artifact_label": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/artifact_kind" },
        "freshness": { "$ref": "#/$defs/artifact_freshness" },
        "retention": { "$ref": "#/$defs/retention_class" },
        "trust": { "$ref": "#/$defs/artifact_trust_class" },
        "open_action_ref": { "$ref": "#/$defs/ref" },
        "export_action_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "resolved": {
      "type": "object",
      "required": [
        "interaction_id",
        "run_ref",
        "attempt_ref",
        "attempt_ordinal",
        "artifact_rows",
        "cli_line",
        "export",
        "input_disposition_attributable",
        "artifact_lineage_preserved",
        "artifact_freshness_disclosed"
      ],
      "properties": {
        "interaction_id": { "$ref": "#/$defs/id" },
        "input_disposition_attributable": { "const": true },
        "artifact_lineage_preserved": { "const": true },
        "artifact_freshness_disclosed": { "const": true }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_families",
        "input_kinds",
        "input_dispositions",
        "input_result_postures",
        "input_consequences",
        "artifact_kinds",
        "artifact_freshnesses",
        "artifact_trust_classes",
        "retention_classes",
        "export_fields",
        "outcomes",
        "truth_modes",
        "localities",
        "downgrade_triggers"
      ],
      "properties": {
        "surface_families": { "type": "array", "items": { "type": "string" } },
        "input_kinds": { "type": "array", "items": { "type": "string" } },
        "input_dispositions": { "type": "array", "items": { "type": "string" } },
        "input_result_postures": { "type": "array", "items": { "type": "string" } },
        "input_consequences": { "type": "array", "items": { "type": "string" } },
        "artifact_kinds": { "type": "array", "items": { "type": "string" } },
        "artifact_freshnesses": { "type": "array", "items": { "type": "string" } },
        "artifact_trust_classes": { "type": "array", "items": { "type": "string" } },
        "retention_classes": { "type": "array", "items": { "type": "string" } },
        "export_fields": { "type": "array", "items": { "type": "string" } },
        "outcomes": { "type": "array", "items": { "type": "string" } },
        "truth_modes": { "type": "array", "items": { "type": "string" } },
        "localities": { "type": "array", "items": { "type": "string" } },
        "downgrade_triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primitive_carries_all_surfaces",
        "input_consequences_never_silent",
        "artifact_lineage_preserved_after_pane_clears",
        "artifact_freshness_disclosed_before_action",
        "exported_evidence_preserves_ids_and_states",
        "support_export_reconstructs_interaction",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_primitive_carries_all_surfaces": { "const": true },
        "input_consequences_never_silent": { "const": true },
        "artifact_lineage_preserved_after_pane_clears": { "const": true },
        "artifact_freshness_disclosed_before_action": { "const": true },
        "exported_evidence_preserves_ids_and_states": { "const": true },
        "support_export_reconstructs_interaction": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_surfaces_consume_shared_primitive",
        "resolver_reads_single_model",
        "artifact_rows_read_single_run_source",
        "support_export_reads_single_source"
      ],
      "properties": {
        "execution_surfaces_consume_shared_primitive": { "const": true },
        "resolver_reads_single_model": { "const": true },
        "artifact_rows_read_single_run_source": { "const": true },
        "support_export_reads_single_source": { "const": true }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "interaction_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/ref" },
        "interaction_audit_ref": { "$ref": "#/$defs/ref" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
