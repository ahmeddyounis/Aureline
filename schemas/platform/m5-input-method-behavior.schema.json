{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-input-method-behavior.schema.json",
  "title": "Aureline M5 input-method-behavior platform-fit entry",
  "description": "Canonical single-entry shape of an M5 input-method platform-fit family (IME composition, dead keys and AltGr, dictation and emoji, and layout switching that preserve text and trust fidelity). Every claimed M5 desktop surface references this schema or the combined m5-platform-fit-matrix.schema.json rather than reinventing its own input-method handling. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the single-entry shape.",
  "type": "object",
  "required": [
    "platform_fit_family",
    "qualification",
    "owner_role",
    "scope_summary",
    "surface_families",
    "deployment_lines",
    "required_labels",
    "semantic_roles",
    "degraded_reasons",
    "accessibility_routes",
    "consumer_surfaces",
    "downgrade_triggers",
    "required_proof_packet_refs",
    "source_contract_refs",
    "platform_wording_changes_command_or_permission_meaning",
    "hides_primary_action_only_in_os_chrome",
    "falls_back_to_plaintext_secret_storage_silently",
    "input_method_corrupts_text_or_trust_fidelity",
    "screenshot_or_docs_mislabels_shortcut_or_path_verb"
  ],
  "properties": {
    "platform_fit_family": {
      "$ref": "#/$defs/platform_fit_family"
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "owner_role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "scope_summary": {
      "$ref": "#/$defs/non_empty_string"
    },
    "surface_families": {
      "type": "array",
      "minItems": 1
    },
    "deployment_lines": {
      "type": "array",
      "minItems": 1
    },
    "required_labels": {
      "type": "array",
      "minItems": 3
    },
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "shortcut",
          "window_menu",
          "path_terminology",
          "appearance",
          "credential_wording",
          "input_fidelity",
          "command_stability"
        ]
      }
    },
    "platform_convention_roles": {
      "type": "array"
    },
    "shortcut_notation_roles": {
      "type": "array"
    },
    "file_path_reveal_roles": {
      "type": "array"
    },
    "theme_contrast_live_change_roles": {
      "type": "array"
    },
    "credential_store_wording_roles": {
      "type": "array"
    },
    "input_method_roles": {
      "type": "array"
    },
    "degraded_reasons": {
      "type": "array",
      "minItems": 1
    },
    "accessibility_routes": {
      "type": "array",
      "minItems": 1
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1
    },
    "required_proof_packet_refs": {
      "type": "array"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "platform_wording_changes_command_or_permission_meaning": {
      "const": false
    },
    "hides_primary_action_only_in_os_chrome": {
      "const": false
    },
    "falls_back_to_plaintext_secret_storage_silently": {
      "const": false
    },
    "input_method_corrupts_text_or_trust_fidelity": {
      "const": false
    },
    "screenshot_or_docs_mislabels_shortcut_or_path_verb": {
      "const": false
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "platform_fit_family": {
      "enum": [
        "input_method"
      ]
    }
  }
}
