{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-shortcut-notation-and-command-label-registries.schema.json",
  "title": "Aureline M5 shortcut-notation and command-label registries",
  "description": "Export-safe packet for the first implement lane over the frozen M5 platform-fit matrix. It carries resolved, honest projections of the shortcut-notation platform-fit family across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved shortcut-notation entries (naming a canonical registry token, a stable command ID, a semantic role, a shortcut-notation role, a host platform, rendered notation that matches the host's modifier convention, and visual/spoken/searchable notation-form coverage while preserving the command ID and explaining any reserved-key fallback) and resolved command-label mapping entries (naming a canonical registry token, a stable command ID, a mapping role, a semantic role, a label kind, a human label, platform-appropriate shortcut text, and the stable-ID / human-label / shortcut-text discovery triple). Hard invariants forbid platform-specific notation changing command or permission meaning, a primary command hidden only in OS chrome, notation hand-copied instead of tracing to the registry, and a screenshot or docs page mislabeling a shortcut. Acceptance criteria — the same command is discoverable by stable command ID, human label, and platform-appropriate shortcut text on every claimed profile; user-visible keyboard notation and help/screenshot content stay consistent with the active platform; and regression suites fail when a surface shows the wrong modifier notation, label mapping, or reserved-key explanation — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_shortcut_notation_and_command_label_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "platform_fit_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "platform_fit_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shortcut_notation_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "command_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_command_identity_under_platform_adaptation",
        "notation_role",
        "notation_role_hardcoded",
        "host_platform",
        "host_platform_is_classified",
        "host_uses_glyph_notation",
        "surface_context",
        "rendered_notation",
        "notation_form_coverage",
        "covers_all_notation_forms",
        "notation_matches_host",
        "bound_to_registry",
        "preserves_command_id",
        "reserved_by_os",
        "fallback_explained",
        "degrade_reason",
        "next_action",
        "notation_holds_across_surfaces_and_platforms"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_command_identity_under_platform_adaptation": { "type": "boolean" },
        "notation_role": { "$ref": "#/$defs/non_empty_string" },
        "notation_role_hardcoded": { "type": "boolean" },
        "host_platform": { "$ref": "#/$defs/non_empty_string" },
        "host_platform_is_classified": { "type": "boolean" },
        "host_uses_glyph_notation": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "rendered_notation": { "type": "string" },
        "notation_form_coverage": { "type": "array" },
        "covers_all_notation_forms": { "type": "boolean" },
        "notation_matches_host": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "preserves_command_id": { "type": "boolean" },
        "reserved_by_os": { "type": "boolean" },
        "fallback_explained": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "notation_holds_across_surfaces_and_platforms": { "type": "boolean" }
      }
    },
    "command_label_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "command_id",
        "token_name",
        "mapping_role",
        "mapping_role_hardcoded",
        "semantic_role",
        "label_kind",
        "label_kind_is_classified",
        "surface_context",
        "notation_form_coverage",
        "covers_all_notation_forms",
        "human_label",
        "shortcut_text",
        "discoverable_by_id_label_and_shortcut",
        "provides_complete_discovery_triple",
        "degrade_reason",
        "next_action",
        "command_discoverable_on_every_profile"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "token_name": { "type": "string" },
        "mapping_role": { "$ref": "#/$defs/non_empty_string" },
        "mapping_role_hardcoded": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "label_kind": { "$ref": "#/$defs/non_empty_string" },
        "label_kind_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "notation_form_coverage": { "type": "array" },
        "covers_all_notation_forms": { "type": "boolean" },
        "human_label": { "type": "string" },
        "shortcut_text": { "type": "string" },
        "discoverable_by_id_label_and_shortcut": { "type": "boolean" },
        "provides_complete_discovery_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "command_discoverable_on_every_profile": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "shortcut_notation_entries",
        "command_label_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "notation_changes_command_or_permission_meaning",
        "primary_command_hidden_only_in_os_chrome",
        "notation_hardcoded_instead_of_registry",
        "screenshot_or_docs_mislabels_shortcut"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "shortcut_notation_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shortcut_notation_entry" }
        },
        "command_label_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command_label_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "notation_changes_command_or_permission_meaning": { "const": false },
        "primary_command_hidden_only_in_os_chrome": { "const": false },
        "notation_hardcoded_instead_of_registry": { "const": false },
        "screenshot_or_docs_mislabels_shortcut": { "const": false }
      }
    }
  }
}
