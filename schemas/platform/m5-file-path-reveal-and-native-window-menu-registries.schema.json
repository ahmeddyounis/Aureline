{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-file-path-reveal-and-native-window-menu-registries.schema.json",
  "title": "Aureline M5 file-path-presentation and native-window / menu registries",
  "description": "Export-safe packet for the file-and-window implement lane over the frozen M5 platform-fit matrix. It carries resolved, honest projections of the file-path-reveal and platform-convention families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved file-path-presentation entries (naming a canonical registry token, a stable command ID, a semantic role, a file-path-reveal role, a host platform, a rendered host-styled path and reveal verb that match the host's separator and reveal convention, and host-styled/canonical/accessible presentation-form coverage while keeping the literal-versus-canonical path truth explicit and explaining any unavailable-reveal fallback) and resolved window / menu action entries (naming a canonical registry token, a stable command ID, a platform-convention role, a semantic role, a product action surface, a human label, an in-product command route, and the stable-ID / in-product-surface / command reachability triple). Hard invariants forbid platform-specific path wording changing command or permission meaning, a primary action reachable only in OS chrome, terminology hand-copied instead of tracing to the registry, and a screenshot or docs page mislabeling a path or reveal verb. Acceptance criteria — file, folder, workspace, and reveal flows use host-correct terms and separators on every claimed profile; no critical action is reachable only through OS chrome or menu-bar affordances; and review fixtures fail when a surface shows the wrong path separator, reveal verb, or a menu-only action — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_file_path_reveal_and_native_window_menu_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "platform_fit_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "platform_fit_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "file_path_presentation_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "command_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_command_identity_under_platform_adaptation",
        "path_role",
        "path_role_mislabeled",
        "host_platform",
        "host_platform_is_classified",
        "host_uses_backslash_separator",
        "surface_context",
        "rendered_path",
        "reveal_verb",
        "canonical_reveal_verb",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "path_matches_host",
        "bound_to_registry",
        "preserves_canonical_path_truth",
        "reveal_target_unavailable",
        "fallback_explained",
        "degrade_reason",
        "next_action",
        "path_truth_holds_across_surfaces_and_platforms"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_command_identity_under_platform_adaptation": { "type": "boolean" },
        "path_role": { "$ref": "#/$defs/non_empty_string" },
        "path_role_mislabeled": { "type": "boolean" },
        "host_platform": { "$ref": "#/$defs/non_empty_string" },
        "host_platform_is_classified": { "type": "boolean" },
        "host_uses_backslash_separator": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "rendered_path": { "type": "string" },
        "reveal_verb": { "type": "string" },
        "canonical_reveal_verb": { "type": "string" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "path_matches_host": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "preserves_canonical_path_truth": { "type": "boolean" },
        "reveal_target_unavailable": { "type": "boolean" },
        "fallback_explained": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "path_truth_holds_across_surfaces_and_platforms": { "type": "boolean" }
      }
    },
    "window_menu_action_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "command_id",
        "token_name",
        "action_role",
        "action_role_invented",
        "semantic_role",
        "action_surface",
        "action_surface_is_classified",
        "surface_context",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "human_label",
        "in_product_route",
        "reachable_by_id_surface_and_command",
        "provides_complete_reachability_triple",
        "degrade_reason",
        "next_action",
        "action_reachable_on_every_profile"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "token_name": { "type": "string" },
        "action_role": { "$ref": "#/$defs/non_empty_string" },
        "action_role_invented": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "action_surface": { "$ref": "#/$defs/non_empty_string" },
        "action_surface_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "human_label": { "type": "string" },
        "in_product_route": { "type": "string" },
        "reachable_by_id_surface_and_command": { "type": "boolean" },
        "provides_complete_reachability_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "action_reachable_on_every_profile": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "file_path_presentation_entries",
        "window_menu_action_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "path_terminology_changes_command_or_permission_meaning",
        "primary_action_reachable_only_in_os_chrome",
        "terminology_hardcoded_instead_of_registry",
        "screenshot_or_docs_mislabels_path_verb"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "file_path_presentation_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file_path_presentation_entry" }
        },
        "window_menu_action_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_menu_action_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "path_terminology_changes_command_or_permission_meaning": { "const": false },
        "primary_action_reachable_only_in_os_chrome": { "const": false },
        "terminology_hardcoded_instead_of_registry": { "const": false },
        "screenshot_or_docs_mislabels_path_verb": { "const": false }
      }
    }
  }
}
