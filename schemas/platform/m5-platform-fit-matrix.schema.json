{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-platform-fit-matrix.schema.json",
  "title": "Aureline M5 platform-convention, shortcut-notation, file-path-reveal, theme/contrast live-change, credential-store wording, and input-method platform-fit matrix",
  "description": "Export-safe packet freezing Aureline's concrete desktop-fit conventions. The packet names every claimed M5 desktop surface that still describes its own platform-native shortcut notation, window and menu behavior, file / path / reveal / save terminology, live theme / contrast / accent / text-scale response, credential-store wording, or IME / dead-key / AltGr / dictation / emoji / layout-switch behavior — across macOS, Windows, and Linux — and binds each governed family to the claimed surface families that render it, the deployment lines it keeps the same truth across, the non-visual accessibility routes it offers (keyboard, screen-reader, high-zoom, high-contrast, CLI/export, support-packet), the degraded reasons it can name, its canonical per-domain schema, and the mandatory labels it must be able to show. Each family declares the controlled vocabularies it carries: the single controlled platform-fit-role vocabulary consumers bind to (shortcut, window_menu, path_terminology, appearance, credential_wording, input_fidelity, command_stability), plus family-specific platform-convention roles, shortcut-notation roles, file-path-reveal roles, theme-contrast-live-change roles, credential-store-wording roles, and input-method roles. Hard invariants forbid platform-specific wording changing command or permission meaning, hiding a primary action only in OS chrome, silently falling back to plaintext secret storage, an input method corrupting text or trust fidelity, and a screenshot or docs page mislabeling a shortcut or path / reveal verb. The matrix binds back to the already-landed native-desktop matrix packet. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "platform_fit_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_platform_convention_shortcut_notation_file_path_reveal_theme_contrast_live_change_credential_store_wording_and_input_method_matrix"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "matrix_label": {
      "$ref": "#/$defs/non_empty_string"
    },
    "platform_fit_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/platform_fit_row"
      }
    },
    "vocabulary_set": {
      "type": "object"
    },
    "governance_review": {
      "type": "object"
    },
    "consumer_projection": {
      "type": "object"
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": {
          "type": "integer",
          "minimum": 1
        },
        "last_proof_refresh": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auto_narrow_on_stale": {
          "type": "boolean"
        }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_packet_ref",
        "platform_fit_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "platform_fit_audit_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "support_export_parity_required": {
          "const": true
        },
        "accessibility_parity_required": {
          "const": true
        }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "redaction_class_token": {
      "$ref": "#/$defs/non_empty_string"
    },
    "minted_at": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "platform_fit_family": {
      "enum": [
        "platform_convention",
        "shortcut_notation",
        "file_path_reveal",
        "theme_contrast_live_change",
        "credential_store_wording",
        "input_method"
      ]
    },
    "qualification": {
      "enum": [
        "stable",
        "beta",
        "preview",
        "experimental",
        "unavailable",
        "held"
      ]
    },
    "semantic_role": {
      "enum": [
        "shortcut",
        "window_menu",
        "path_terminology",
        "appearance",
        "credential_wording",
        "input_fidelity",
        "command_stability"
      ]
    },
    "platform_fit_row": {
      "type": "object",
      "required": [
        "platform_fit_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "surface_families",
        "deployment_lines",
        "required_labels",
        "semantic_roles",
        "degraded_reasons",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "platform_wording_changes_command_or_permission_meaning",
        "hides_primary_action_only_in_os_chrome",
        "falls_back_to_plaintext_secret_storage_silently",
        "input_method_corrupts_text_or_trust_fidelity",
        "screenshot_or_docs_mislabels_shortcut_or_path_verb"
      ],
      "properties": {
        "platform_fit_family": {
          "$ref": "#/$defs/platform_fit_family"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "owner_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope_summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "surface_families": {
          "type": "array",
          "minItems": 1
        },
        "deployment_lines": {
          "type": "array",
          "minItems": 1
        },
        "required_labels": {
          "type": "array",
          "minItems": 3
        },
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_role"
          }
        },
        "platform_convention_roles": {
          "type": "array"
        },
        "shortcut_notation_roles": {
          "type": "array"
        },
        "file_path_reveal_roles": {
          "type": "array"
        },
        "theme_contrast_live_change_roles": {
          "type": "array"
        },
        "credential_store_wording_roles": {
          "type": "array"
        },
        "input_method_roles": {
          "type": "array"
        },
        "degraded_reasons": {
          "type": "array",
          "minItems": 1
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1
        },
        "required_proof_packet_refs": {
          "type": "array"
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "platform_wording_changes_command_or_permission_meaning": {
          "const": false
        },
        "hides_primary_action_only_in_os_chrome": {
          "const": false
        },
        "falls_back_to_plaintext_secret_storage_silently": {
          "const": false
        },
        "input_method_corrupts_text_or_trust_fidelity": {
          "const": false
        },
        "screenshot_or_docs_mislabels_shortcut_or_path_verb": {
          "const": false
        }
      }
    }
  }
}
