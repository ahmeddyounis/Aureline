{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-system-appearance-live-apply-and-source-provenance-registries.schema.json",
  "title": "Aureline M5 system-appearance live-apply and appearance-source-provenance registries",
  "description": "Export-safe packet for the live system-appearance-response implement lane over the frozen M5 platform-fit matrix. It carries resolved, honest projections of the theme-contrast-live-change family across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved appearance-response entries (naming a canonical registry token, a stable command ID, a semantic role, a theme-contrast-live-change role, a support posture, a rendered applied-appearance summary and posture label that match the claimed live-apply / restart-required / unsupported posture, applied/canonical/accessible response-form coverage, preserved active-context continuity, and an explained fallback for any narrower-than-live posture) and resolved appearance-source-provenance entries (naming a canonical registry token, a stable command ID, a theme-contrast-live-change role, a semantic role, a record surface, a source signal, a record route, and the stable-ID / record-surface / source-signal recording triple). Hard invariants forbid a live appearance change corrupting focus, layout, or meaning on a protected path, a live change forcing a mystery repaint or resetting local context, appearance response hand-copied instead of tracing to the registry, and diagnostics or exports that cannot distinguish live-apply from restart-required or unsupported. Acceptance criteria — claimed desktop profiles either apply host appearance changes live or clearly explain the narrower supported behavior; live changes do not corrupt focus, layout, or meaning on protected paths; and diagnostics and support exports can distinguish live-apply from restart-required or unsupported — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_system_appearance_live_apply_and_source_provenance_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "platform_fit_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "platform_fit_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "appearance_live_apply_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "command_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_command_identity_under_platform_adaptation",
        "appearance_role",
        "appearance_role_silent_drift",
        "posture",
        "posture_is_classified",
        "posture_applies_live",
        "surface_context",
        "applied_appearance_summary",
        "posture_label",
        "canonical_posture_label",
        "response_form_coverage",
        "covers_all_response_forms",
        "posture_matches_support",
        "bound_to_registry",
        "preserves_active_context_continuity",
        "live_reapplied",
        "fallback_explained",
        "degrade_reason",
        "next_action",
        "appearance_response_honest_across_surfaces_and_channels"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_command_identity_under_platform_adaptation": { "type": "boolean" },
        "appearance_role": { "$ref": "#/$defs/non_empty_string" },
        "appearance_role_silent_drift": { "type": "boolean" },
        "posture": { "$ref": "#/$defs/non_empty_string" },
        "posture_is_classified": { "type": "boolean" },
        "posture_applies_live": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "applied_appearance_summary": { "type": "string" },
        "posture_label": { "type": "string" },
        "canonical_posture_label": { "type": "string" },
        "response_form_coverage": { "type": "array" },
        "covers_all_response_forms": { "type": "boolean" },
        "posture_matches_support": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "preserves_active_context_continuity": { "type": "boolean" },
        "live_reapplied": { "type": "boolean" },
        "fallback_explained": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "appearance_response_honest_across_surfaces_and_channels": { "type": "boolean" }
      }
    },
    "appearance_source_provenance_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "command_id",
        "token_name",
        "provenance_role",
        "provenance_role_silent_drift",
        "semantic_role",
        "record_surface",
        "record_surface_is_classified",
        "surface_context",
        "response_form_coverage",
        "covers_all_response_forms",
        "source_signal_label",
        "record_route",
        "posture_recorded",
        "provides_complete_provenance_triple",
        "degrade_reason",
        "next_action",
        "source_recorded_on_every_profile"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "token_name": { "type": "string" },
        "provenance_role": { "$ref": "#/$defs/non_empty_string" },
        "provenance_role_silent_drift": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "record_surface": { "$ref": "#/$defs/non_empty_string" },
        "record_surface_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "response_form_coverage": { "type": "array" },
        "covers_all_response_forms": { "type": "boolean" },
        "source_signal_label": { "type": "string" },
        "record_route": { "type": "string" },
        "posture_recorded": { "type": "boolean" },
        "provides_complete_provenance_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "source_recorded_on_every_profile": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "appearance_live_apply_entries",
        "appearance_source_provenance_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "appearance_change_corrupts_focus_layout_or_meaning_on_protected_path",
        "live_change_forces_mystery_repaint_or_resets_context",
        "appearance_response_hardcoded_instead_of_registry",
        "diagnostics_or_export_cannot_distinguish_live_from_restart"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "appearance_live_apply_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/appearance_live_apply_entry" }
        },
        "appearance_source_provenance_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/appearance_source_provenance_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "appearance_change_corrupts_focus_layout_or_meaning_on_protected_path": { "const": false },
        "live_change_forces_mystery_repaint_or_resets_context": { "const": false },
        "appearance_response_hardcoded_instead_of_registry": { "const": false },
        "diagnostics_or_export_cannot_distinguish_live_from_restart": { "const": false }
      }
    }
  }
}
