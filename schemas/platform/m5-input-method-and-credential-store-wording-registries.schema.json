{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-input-method-and-credential-store-wording-registries.schema.json",
  "title": "Aureline M5 input-method and credential-store-wording registries",
  "description": "Export-safe packet for the input-and-credential implement lane over the frozen M5 platform-fit matrix. It carries resolved, honest projections of the input-method and credential-store-wording families across the claimed M5 consumer surfaces. Each registry row binds a consumer surface to resolved input-composition entries (naming a canonical registry token, a stable command ID, a semantic role, an input-method role, an input-method stack, a committed text that matches the expected text for its stack, and literal/canonical/accessible presentation-form coverage while preserving command interpretation, shortcut routing, and trust/approval copy, and explaining any unsupported-composition fallback) and resolved credential-store-wording entries (naming a canonical registry token, a stable command ID, a credential-store-wording role, a semantic role, a credential-wording surface, truthful generic copy, a disclosure route, and the generic-wording / disclosure-route / truthful-and-non-leaky disclosure triple). Hard invariants forbid a platform input method corrupting text, command interpretation, or trust fidelity, shortcut routing and composition fighting each other, credential wording hiding a plaintext storage downgrade or leaking a secret, and input or credential wording hand-copied instead of tracing to the registry. Acceptance criteria — text arrives intact and correctly segmented on every claimed profile; shortcut handling and text composition do not fight; and credential-store copy stays truthful, privacy-safe, and platform-correct without leaking false certainty or hidden storage downgrades — are proven by the resolved examples, not merely asserted. Raw secret values and private endpoints never cross this boundary. The Rust validator in crates/aureline-ui is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "registries_label",
    "registry_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_input_method_and_credential_store_wording_registries"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "registries_label": { "$ref": "#/$defs/non_empty_string" },
    "registry_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_row" }
    },
    "vocabulary_set": { "type": "object" },
    "governance_review": { "type": "object" },
    "consumer_projection": { "type": "object" },
    "proof_freshness": {
      "type": "object",
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "required": [
        "proof_packet_ref",
        "platform_fit_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "platform_fit_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "input_composition_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "command_id",
        "token_name",
        "semantic_role",
        "semantic_role_preserves_command_identity_under_platform_adaptation",
        "input_role",
        "input_role_names_corruption",
        "input_stack",
        "input_stack_is_classified",
        "canonical_composition_model",
        "surface_context",
        "committed_text",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "composed_text_intact",
        "bound_to_registry",
        "preserves_command_and_trust_fidelity",
        "composition_unsupported_on_surface",
        "fallback_input_path_explained",
        "degrade_reason",
        "next_action",
        "text_fidelity_holds_across_surfaces_and_profiles"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "token_name": { "type": "string" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "semantic_role_preserves_command_identity_under_platform_adaptation": { "type": "boolean" },
        "input_role": { "$ref": "#/$defs/non_empty_string" },
        "input_role_names_corruption": { "type": "boolean" },
        "input_stack": { "$ref": "#/$defs/non_empty_string" },
        "input_stack_is_classified": { "type": "boolean" },
        "canonical_composition_model": { "type": "string" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "committed_text": { "type": "string" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "composed_text_intact": { "type": "boolean" },
        "bound_to_registry": { "type": "boolean" },
        "preserves_command_and_trust_fidelity": { "type": "boolean" },
        "composition_unsupported_on_surface": { "type": "boolean" },
        "fallback_input_path_explained": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "text_fidelity_holds_across_surfaces_and_profiles": { "type": "boolean" }
      }
    },
    "credential_store_wording_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "command_id",
        "token_name",
        "wording_role",
        "wording_role_hides_plaintext",
        "semantic_role",
        "wording_surface",
        "wording_surface_is_classified",
        "surface_context",
        "presentation_form_coverage",
        "covers_all_presentation_forms",
        "generic_wording",
        "disclosure_route",
        "storage_is_truthful",
        "non_leaky",
        "plaintext_fallback_used",
        "plaintext_fallback_disclosed",
        "platform_detail_disclosed",
        "platform_detail_justified",
        "wording_stays_truthful",
        "provides_complete_disclosure_triple",
        "degrade_reason",
        "next_action",
        "wording_truthful_on_every_profile"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "command_id": { "type": "string" },
        "token_name": { "type": "string" },
        "wording_role": { "$ref": "#/$defs/non_empty_string" },
        "wording_role_hides_plaintext": { "type": "boolean" },
        "semantic_role": { "$ref": "#/$defs/non_empty_string" },
        "wording_surface": { "$ref": "#/$defs/non_empty_string" },
        "wording_surface_is_classified": { "type": "boolean" },
        "surface_context": { "$ref": "#/$defs/non_empty_string" },
        "presentation_form_coverage": { "type": "array" },
        "covers_all_presentation_forms": { "type": "boolean" },
        "generic_wording": { "type": "string" },
        "disclosure_route": { "type": "string" },
        "storage_is_truthful": { "type": "boolean" },
        "non_leaky": { "type": "boolean" },
        "plaintext_fallback_used": { "type": "boolean" },
        "plaintext_fallback_disclosed": { "type": "boolean" },
        "platform_detail_disclosed": { "type": "boolean" },
        "platform_detail_justified": { "type": "boolean" },
        "wording_stays_truthful": { "type": "boolean" },
        "provides_complete_disclosure_triple": { "type": "boolean" },
        "degrade_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string" },
        "wording_truthful_on_every_profile": { "type": "boolean" }
      }
    },
    "registry_row": {
      "type": "object",
      "required": [
        "consumer_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "deployment_lines",
        "required_labels",
        "accessibility_routes",
        "anatomy_parts",
        "export_fields",
        "downgrade_triggers",
        "input_composition_entries",
        "credential_store_wording_entries",
        "required_proof_packet_refs",
        "source_contract_refs",
        "input_method_corrupts_text_command_or_trust",
        "shortcut_routing_and_composition_fight",
        "credential_wording_hides_plaintext_downgrade_or_leaks",
        "input_or_credential_wording_hardcoded_instead_of_registry"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/non_empty_string" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "deployment_lines": { "type": "array", "minItems": 1 },
        "required_labels": { "type": "array", "minItems": 3 },
        "accessibility_routes": { "type": "array", "minItems": 1 },
        "anatomy_parts": { "type": "array", "minItems": 3 },
        "export_fields": { "type": "array", "minItems": 5 },
        "downgrade_triggers": { "type": "array", "minItems": 1 },
        "input_composition_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/input_composition_entry" }
        },
        "credential_store_wording_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/credential_store_wording_entry" }
        },
        "required_proof_packet_refs": { "type": "array", "minItems": 1 },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "input_method_corrupts_text_command_or_trust": { "const": false },
        "shortcut_routing_and_composition_fight": { "const": false },
        "credential_wording_hides_plaintext_downgrade_or_leaks": { "const": false },
        "input_or_credential_wording_hardcoded_instead_of_registry": { "const": false }
      }
    }
  }
}
