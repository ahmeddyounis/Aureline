{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-platform-fit-shared-consumers.schema.json",
  "title": "M5 Platform-Fit Shared-Consumer Parity Packet",
  "description": "Export-safe record binding the six B139 platform-fit families (platform convention, shortcut notation, file / path / reveal, live theme / contrast, credential-store wording, input method) to the shell / settings / auth / input / docs-help / onboarding / CLI-export / support-export / product consumers that render them, proving one shared platform-fit convention across surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "surface_label",
    "consumer_bindings",
    "downgrade_triggers",
    "consumer_surfaces",
    "trust_review",
    "consumer_projection",
    "proof_freshness",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "const": "m5_platform_fit_shared_consumer_convention_parity"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "surface_label": { "type": "string", "minLength": 1 },
    "consumer_bindings": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "downgrade_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_trigger" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_surface" }
    },
    "trust_review": { "$ref": "#/$defs/trust_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction_class_token": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "platform_fit_family": {
      "type": "string",
      "enum": [
        "platform_convention",
        "shortcut_notation",
        "file_path_reveal",
        "theme_contrast_live_change",
        "credential_store_wording",
        "input_method"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_ui",
        "settings_ui",
        "auth_ui",
        "input_ui",
        "docs_help",
        "onboarding",
        "cli_export",
        "support_export",
        "product_ui"
      ]
    },
    "representation": {
      "type": "string",
      "enum": [
        "desktop_full",
        "compact_narrowed",
        "remote_projected",
        "exported_redacted"
      ]
    },
    "parity_state": {
      "type": "string",
      "enum": ["facets_preserved", "facets_disclosed_narrowed"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "compaction_narrowed",
        "remote_projection_narrowed",
        "export_redaction_narrowed"
      ]
    },
    "narrow_next_action": {
      "type": "string",
      "enum": ["expand_in_desktop", "open_remote_source", "open_full_detail"]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "proof_stale",
        "policy_blocked",
        "platform_grammar_drift_detected",
        "command_identity_or_permission_meaning_dropped",
        "platform_wording_changed_command_or_permission_meaning",
        "primary_action_hidden_only_in_os_chrome",
        "credential_store_fell_back_to_plaintext_silently",
        "input_method_corrupted_text_or_trust_fidelity",
        "screenshot_or_docs_mislabeled_shortcut_or_path_verb",
        "canonical_registry_reference_missing",
        "upstream_platform_fit_narrowed"
      ]
    },
    "state_facet_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_fit_role_word",
        "family_word",
        "registry_reference_word",
        "host_platform_word",
        "surface_context_word",
        "command_identity_word"
      ],
      "properties": {
        "platform_fit_role_word": {
          "type": "string",
          "enum": [
            "shortcut",
            "window_menu",
            "path_terminology",
            "appearance",
            "credential_wording",
            "input_fidelity",
            "command_stability"
          ]
        },
        "family_word": { "type": "string", "minLength": 1 },
        "registry_reference_word": { "type": "string", "minLength": 1 },
        "host_platform_word": { "type": "string", "minLength": 1 },
        "surface_context_word": { "type": "string", "minLength": 1 },
        "command_identity_word": { "type": "string", "minLength": 1 }
      }
    },
    "narrow_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preserved_grammar_note",
        "next_action",
        "next_action_label"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrow_reason" },
        "preserved_grammar_note": { "type": "string", "minLength": 1 },
        "next_action": { "$ref": "#/$defs/narrow_next_action" },
        "next_action_label": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "platform_fit_object_id",
        "platform_fit_object_label",
        "family",
        "consumer",
        "representation",
        "state_facets",
        "parity_state",
        "narrow_note",
        "remote_source_note",
        "export_detail_note",
        "platform_wording_changes_command_or_permission_meaning",
        "hides_primary_action_only_in_os_chrome",
        "falls_back_to_plaintext_credential_storage_silently",
        "input_method_corrupts_text_or_trust_fidelity",
        "screenshot_or_docs_mislabels_shortcut_or_path_verb",
        "source_contract_refs"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "platform_fit_object_id": { "type": "string", "minLength": 1 },
        "platform_fit_object_label": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/platform_fit_family" },
        "consumer": { "$ref": "#/$defs/consumer_surface" },
        "representation": { "$ref": "#/$defs/representation" },
        "state_facets": { "$ref": "#/$defs/state_facet_values" },
        "parity_state": { "$ref": "#/$defs/parity_state" },
        "narrow_note": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrow_note" }]
        },
        "remote_source_note": { "type": "string" },
        "export_detail_note": { "type": "string" },
        "platform_wording_changes_command_or_permission_meaning": {
          "type": "boolean",
          "const": false
        },
        "hides_primary_action_only_in_os_chrome": {
          "type": "boolean",
          "const": false
        },
        "falls_back_to_plaintext_credential_storage_silently": {
          "type": "boolean",
          "const": false
        },
        "input_method_corrupts_text_or_trust_fidelity": {
          "type": "boolean",
          "const": false
        },
        "screenshot_or_docs_mislabels_shortcut_or_path_verb": {
          "type": "boolean",
          "const": false
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": { "const": "desktop_full" }
            }
          },
          "then": {
            "properties": {
              "parity_state": { "const": "facets_preserved" },
              "narrow_note": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "parity_state": { "const": "facets_disclosed_narrowed" },
              "narrow_note": { "$ref": "#/$defs/narrow_note" }
            }
          }
        }
      ]
    },
    "trust_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_reuse_proven_by_fixtures",
        "same_object_same_platform_fit_across_surfaces",
        "platform_fit_role_words_stay_in_frozen_vocabulary",
        "adaptation_roles_never_change_command_or_permission_meaning",
        "platform_wording_never_changes_command_or_permission_meaning",
        "primary_actions_never_hidden_only_in_os_chrome",
        "credentials_never_fall_back_to_plaintext_silently",
        "input_methods_never_corrupt_text_or_trust_fidelity",
        "screenshots_and_docs_never_mislabel_shortcut_or_path_verb",
        "narrowing_disclosed_across_representations",
        "support_export_point_canonical_contracts",
        "downgrade_narrows_instead_of_hides",
        "stale_or_underqualified_blocks_promotion"
      ],
      "properties": {
        "family_reuse_proven_by_fixtures": { "type": "boolean", "const": true },
        "same_object_same_platform_fit_across_surfaces": {
          "type": "boolean",
          "const": true
        },
        "platform_fit_role_words_stay_in_frozen_vocabulary": {
          "type": "boolean",
          "const": true
        },
        "adaptation_roles_never_change_command_or_permission_meaning": {
          "type": "boolean",
          "const": true
        },
        "platform_wording_never_changes_command_or_permission_meaning": {
          "type": "boolean",
          "const": true
        },
        "primary_actions_never_hidden_only_in_os_chrome": {
          "type": "boolean",
          "const": true
        },
        "credentials_never_fall_back_to_plaintext_silently": {
          "type": "boolean",
          "const": true
        },
        "input_methods_never_corrupt_text_or_trust_fidelity": {
          "type": "boolean",
          "const": true
        },
        "screenshots_and_docs_never_mislabel_shortcut_or_path_verb": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_across_representations": {
          "type": "boolean",
          "const": true
        },
        "support_export_point_canonical_contracts": {
          "type": "boolean",
          "const": true
        },
        "downgrade_narrows_instead_of_hides": {
          "type": "boolean",
          "const": true
        },
        "stale_or_underqualified_blocks_promotion": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_ui_consumes_shared_platform_fit",
        "settings_ui_consumes_shared_platform_fit",
        "auth_ui_consumes_shared_platform_fit",
        "input_ui_consumes_shared_platform_fit",
        "docs_help_consumes_shared_platform_fit",
        "support_export_consumes_shared_platform_fit",
        "product_ui_consumes_shared_platform_fit",
        "every_family_adopted_by_two_or_more_consumers",
        "platform_fit_identical_for_same_object",
        "narrowing_disclosed_not_hidden",
        "export_maps_back_to_one_platform_fit_family"
      ],
      "properties": {
        "shell_ui_consumes_shared_platform_fit": {
          "type": "boolean",
          "const": true
        },
        "settings_ui_consumes_shared_platform_fit": {
          "type": "boolean",
          "const": true
        },
        "auth_ui_consumes_shared_platform_fit": {
          "type": "boolean",
          "const": true
        },
        "input_ui_consumes_shared_platform_fit": {
          "type": "boolean",
          "const": true
        },
        "docs_help_consumes_shared_platform_fit": {
          "type": "boolean",
          "const": true
        },
        "support_export_consumes_shared_platform_fit": {
          "type": "boolean",
          "const": true
        },
        "product_ui_consumes_shared_platform_fit": {
          "type": "boolean",
          "const": true
        },
        "every_family_adopted_by_two_or_more_consumers": {
          "type": "boolean",
          "const": true
        },
        "platform_fit_identical_for_same_object": {
          "type": "boolean",
          "const": true
        },
        "narrowing_disclosed_not_hidden": { "type": "boolean", "const": true },
        "export_maps_back_to_one_platform_fit_family": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_freshness_slo_hours",
        "last_proof_refresh",
        "auto_narrow_on_stale"
      ],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "type": "string", "minLength": 1 },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    }
  }
}
