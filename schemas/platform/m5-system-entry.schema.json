{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-system-entry.schema.json",
  "title": "Aureline M5 system-open and file-association intake report",
  "description": "Boundary schema for the system-entry intake report emitted by the aureline-shell m5_system_entry module. Every OS-initiated open (file, folder, workspace, review-link, patch-bundle, provider-return) is projected as one typed intake that preserves the export-safe literal target the OS handed over, the canonical target Aureline detected, and the intended verb and resulting mode resolved through the same project-entry vocabulary the in-product Open/Clone/Import/Restore/Resume flows use. Acceptance: every required intake kind MUST be present; an entry-flow intake MUST provably reuse the canonical resolver output (a divergence is a verb_coercion blocker) and a routed intake MUST name its reviewed surface; any scope wider than a plain local read MUST be gated behind an explicit interstitial (a silent widen to workspace scope is a silent_scope_widen blocker and a silent widen to a mutating provider flow is a distinct silent_provider_mutation blocker); a non-exact target MUST offer a recovery action and each unavailable class stays a distinct failure (wrong_target_no_recovery, unavailable_path_silent_loss, policy_block_unsafe); every intake MUST carry a literal target, a canonical target, an active-profile owner, a channel/build owner, a trust checkpoint, the canonical in-product command, a continuity note, a non-empty degraded-state vocabulary, at least one platform, a downgrade rule, and registered_on_system_entry_harness=true; stale evidence on a marketed intake is a blocker; and the report MUST cross-link the native-desktop matrix, install-topology, project-entry contract, entry interstitials, handoff-review, and auth-recovery packets so ownership and routing cannot drift independently. This schema is the only boundary contract for the JSON fixtures under fixtures/platform/m5-system-entry/ and the support/case-export wrappers consumed by the CI gate at tools/ci/m5/system_entry_check.py. Records carry no credential bodies, raw provider payloads, or raw filesystem paths -- the literal target is an opaque captured ref only.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/system_entry_report_record" },
    { "$ref": "#/$defs/system_entry_support_export_record" },
    { "$ref": "#/$defs/system_entry_case_export_record" }
  ],
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Integer schema version. Bumped only on breaking payload changes."
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "shell:m5_system_entry:v1",
      "description": "Stable shared contract ref every record carries."
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "intake_kind": {
      "type": "string",
      "enum": ["file", "folder", "workspace", "review_link", "patch_bundle", "provider_return"]
    },
    "source_surface": {
      "type": "string",
      "enum": [
        "system_open",
        "file_association",
        "protocol_handler",
        "auth_callback",
        "recent_item",
        "dock_taskbar_jumplist"
      ]
    },
    "platform": {
      "type": "string",
      "enum": ["macos", "windows", "linux"]
    },
    "ownership_kind": {
      "type": "string",
      "enum": [
        "channel_scoped_owner",
        "shared_default_arbitrated",
        "managed_fleet_owned",
        "portable_non_registering"
      ]
    },
    "literal_format": {
      "type": "string",
      "enum": [
        "windows_drive_path",
        "windows_unc_path",
        "posix_path",
        "file_uri",
        "deep_link_uri",
        "provider_callback",
        "unknown"
      ]
    },
    "parity_class": {
      "type": "string",
      "enum": ["entry_flow_resolved", "routed_to_review_surface", "routed_to_auth_recovery"]
    },
    "scope_class": {
      "type": "string",
      "enum": [
        "plain_local_read",
        "widens_to_workspace_scope",
        "crosses_boundary",
        "widens_to_provider_mutation",
        "requires_trust_decision"
      ]
    },
    "availability": {
      "type": "string",
      "enum": [
        "exact_available",
        "wrong_association",
        "moved_target",
        "mixed_root",
        "blocked_by_policy",
        "missing_or_unmounted"
      ]
    },
    "recovery_action": {
      "type": "string",
      "enum": [
        "reopen_in_active_profile",
        "choose_different_target",
        "open_with_correct_handler",
        "reconnect_volume",
        "keep_last_saved_copy",
        "sign_in_to_reopen",
        "select_intended_root",
        "reroute_to_compatible_verb",
        "return_to_review",
        "show_policy_block_detail"
      ]
    },
    "evidence_freshness": {
      "type": "string",
      "enum": ["fresh", "stale"]
    },
    "entry_verb": {
      "type": "string",
      "enum": ["open", "clone", "import", "add_root", "restore", "resume", "start_from_snapshot"]
    },
    "resulting_mode": {
      "type": "string",
      "enum": [
        "single_file",
        "folder",
        "repo_root",
        "workspace_candidate",
        "workspace_with_roots",
        "workset_slice",
        "inspect_only",
        "clone_then_review",
        "clone_then_open",
        "clone_then_add",
        "clone_only",
        "extract_then_review",
        "compare_before_restore",
        "apply_to_active_workspace",
        "open_prebuild_with_setup_actions",
        "open_prebuild_minimal",
        "resume_live_session",
        "restore_last_session",
        "restore_from_checkpoint"
      ]
    },
    "nullable_resulting_mode": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/resulting_mode" }]
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "local_file",
        "local_folder",
        "local_repo_root",
        "workspace_manifest",
        "workset_manifest",
        "remote_repository",
        "ssh_workspace",
        "container_workspace",
        "devcontainer_workspace",
        "managed_cloud_workspace",
        "portable_state_package",
        "handoff_packet",
        "competitor_config_root",
        "template_or_prebuild_snapshot",
        "review_or_work_item_deep_link",
        "recovery_checkpoint"
      ]
    },
    "open_flow_sheet_class": {
      "type": "string",
      "enum": ["open_local_target", "clone_remote_target", "import_artifact", "restore_or_resume"]
    },
    "nullable_open_flow_sheet_class": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/open_flow_sheet_class" }]
    },
    "failure_mode": {
      "type": "string",
      "enum": [
        "silent_scope_widen",
        "silent_provider_mutation",
        "verb_coercion",
        "wrong_target_no_recovery",
        "unavailable_path_silent_loss",
        "policy_block_unsafe",
        "trust_evaluation_bypassed",
        "hidden_channel_ownership"
      ]
    },
    "finding_class": {
      "type": "string",
      "enum": [
        "silent_scope_widen",
        "silent_provider_mutation",
        "verb_coercion",
        "wrong_target_no_recovery",
        "unavailable_path_silent_loss",
        "policy_block_unsafe",
        "trust_evaluation_bypassed",
        "hidden_channel_ownership",
        "missing_active_profile_owner",
        "missing_literal_target",
        "missing_canonical_target",
        "missing_canonical_command",
        "missing_interstitial",
        "missing_routed_surface",
        "missing_continuity_note",
        "missing_degraded_state_vocabulary",
        "missing_claimed_platforms",
        "missing_downgrade_rule",
        "stale_evidence_on_marketed_intake",
        "intake_not_on_harness"
      ]
    },
    "blocking_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "intake_id"],
      "properties": {
        "class": { "$ref": "#/$defs/finding_class" },
        "intake_id": { "$ref": "#/$defs/non_empty_string" },
        "scope_class": { "$ref": "#/$defs/scope_class" },
        "availability": { "$ref": "#/$defs/availability" },
        "intended_entry_verb": { "$ref": "#/$defs/entry_verb" },
        "intended_resulting_mode": { "$ref": "#/$defs/resulting_mode" },
        "resolved_resulting_mode": { "$ref": "#/$defs/nullable_resulting_mode" }
      }
    },
    "cross_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_desktop_matrix_ref",
        "install_topology_ref",
        "project_entry_contract_ref",
        "entry_interstitial_ref",
        "handoff_review_ref",
        "auth_recovery_ref"
      ],
      "properties": {
        "native_desktop_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "install_topology_ref": { "$ref": "#/$defs/non_empty_string" },
        "project_entry_contract_ref": { "$ref": "#/$defs/non_empty_string" },
        "entry_interstitial_ref": { "$ref": "#/$defs/non_empty_string" },
        "handoff_review_ref": { "$ref": "#/$defs/non_empty_string" },
        "auth_recovery_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "intake_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_id",
        "intake_kind",
        "source_surface",
        "descriptor_revision_ref",
        "primary_label_ref",
        "literal_target_ref",
        "literal_format",
        "canonical_target_ref",
        "detected_target_kind",
        "intended_entry_verb",
        "intended_resulting_mode",
        "candidate_resulting_modes",
        "parity_class",
        "routed_surface_ref",
        "active_profile_owner_ref",
        "channel_build_owner_ref",
        "ownership_kind",
        "trust_checkpoint_ref",
        "canonical_command_ref",
        "scope_class",
        "requires_explicit_interstitial",
        "interstitial_ref",
        "availability",
        "recovery_actions",
        "continuity_note",
        "degraded_state_vocabulary",
        "claimed_platforms",
        "evidence_freshness",
        "evidence_captured_at",
        "downgrade_rule_ref",
        "marketed",
        "registered_on_system_entry_harness"
      ],
      "properties": {
        "intake_id": { "$ref": "#/$defs/non_empty_string" },
        "intake_kind": { "$ref": "#/$defs/intake_kind" },
        "source_surface": { "$ref": "#/$defs/source_surface" },
        "descriptor_revision_ref": { "$ref": "#/$defs/non_empty_string" },
        "primary_label_ref": { "$ref": "#/$defs/non_empty_string" },
        "literal_target_ref": { "$ref": "#/$defs/non_empty_string" },
        "literal_format": { "$ref": "#/$defs/literal_format" },
        "canonical_target_ref": { "$ref": "#/$defs/non_empty_string" },
        "detected_target_kind": { "$ref": "#/$defs/target_kind" },
        "intended_entry_verb": { "$ref": "#/$defs/entry_verb" },
        "intended_resulting_mode": { "$ref": "#/$defs/resulting_mode" },
        "candidate_resulting_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/resulting_mode" }
        },
        "parity_class": { "$ref": "#/$defs/parity_class" },
        "routed_surface_ref": { "$ref": "#/$defs/nullable_string" },
        "active_profile_owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "channel_build_owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "ownership_kind": { "$ref": "#/$defs/ownership_kind" },
        "trust_checkpoint_ref": { "$ref": "#/$defs/non_empty_string" },
        "canonical_command_ref": { "$ref": "#/$defs/non_empty_string" },
        "scope_class": { "$ref": "#/$defs/scope_class" },
        "requires_explicit_interstitial": { "type": "boolean" },
        "interstitial_ref": { "$ref": "#/$defs/nullable_string" },
        "availability": { "$ref": "#/$defs/availability" },
        "recovery_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/recovery_action" }
        },
        "continuity_note": { "$ref": "#/$defs/non_empty_string" },
        "degraded_state_vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "claimed_platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platform" }
        },
        "evidence_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "evidence_captured_at": { "$ref": "#/$defs/non_empty_string" },
        "downgrade_rule_ref": { "$ref": "#/$defs/non_empty_string" },
        "marketed": { "type": "boolean" },
        "registered_on_system_entry_harness": { "type": "boolean" }
      }
    },
    "parity_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parity_class", "reuses_project_entry_path"],
      "properties": {
        "parity_class": { "$ref": "#/$defs/parity_class" },
        "reuses_project_entry_path": { "type": "boolean" },
        "resolved_sheet_class": { "$ref": "#/$defs/nullable_open_flow_sheet_class" },
        "resolved_resulting_mode": { "$ref": "#/$defs/nullable_resulting_mode" },
        "routed_surface_ref": { "$ref": "#/$defs/nullable_string" },
        "divergence_note": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "intake_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor",
        "parity_outcome",
        "blocking_findings",
        "marketed"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "shell_m5_system_entry_intake_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor": { "$ref": "#/$defs/intake_descriptor" },
        "parity_outcome": { "$ref": "#/$defs/parity_outcome" },
        "blocking_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocking_finding" }
        },
        "marketed": { "type": "boolean" }
      }
    },
    "finding_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "count"],
      "properties": {
        "class": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "findings_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_blocking_findings", "by_class"],
      "properties": {
        "total_blocking_findings": { "type": "integer", "minimum": 0 },
        "by_class": { "type": "array", "items": { "$ref": "#/$defs/finding_count" } }
      }
    },
    "kind_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intake_kind", "intake_count"],
      "properties": {
        "intake_kind": { "$ref": "#/$defs/intake_kind" },
        "intake_count": { "type": "integer", "minimum": 0 }
      }
    },
    "scope_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_class", "intake_count", "gated_behind_interstitial"],
      "properties": {
        "scope_class": { "$ref": "#/$defs/scope_class" },
        "intake_count": { "type": "integer", "minimum": 0 },
        "gated_behind_interstitial": { "type": "integer", "minimum": 0 }
      }
    },
    "resulting_mode_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_id",
        "intake_kind",
        "canonical_target_ref",
        "intended_entry_verb",
        "intended_resulting_mode",
        "scope_class",
        "availability"
      ],
      "properties": {
        "intake_id": { "$ref": "#/$defs/non_empty_string" },
        "intake_kind": { "$ref": "#/$defs/intake_kind" },
        "canonical_target_ref": { "$ref": "#/$defs/non_empty_string" },
        "intended_entry_verb": { "$ref": "#/$defs/entry_verb" },
        "intended_resulting_mode": { "$ref": "#/$defs/resulting_mode" },
        "scope_class": { "$ref": "#/$defs/scope_class" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "narrowable_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intake_id", "failure_mode", "reason"],
      "properties": {
        "intake_id": { "$ref": "#/$defs/non_empty_string" },
        "failure_mode": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/failure_mode" }]
        },
        "reason": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "system_entry_report_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "report_id",
        "source_schema_ref",
        "required_intake_kinds",
        "claimed_platforms",
        "cross_links",
        "entries",
        "intake_kind_coverage",
        "scope_class_coverage",
        "findings_summary",
        "resulting_mode_index",
        "registered_intake_count",
        "marketed_intake_count",
        "project_entry_parity_count",
        "narrowable_marketed_entries",
        "report_clean",
        "published_report_ref",
        "published_doc_ref",
        "docs_help_refs",
        "support_export_refs",
        "generated_at"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "shell_m5_system_entry_report_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "report_id": { "$ref": "#/$defs/non_empty_string" },
        "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "required_intake_kinds": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/intake_kind" }
        },
        "claimed_platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platform" }
        },
        "cross_links": { "$ref": "#/$defs/cross_links" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/intake_row" }
        },
        "intake_kind_coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/kind_coverage" }
        },
        "scope_class_coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/scope_coverage" }
        },
        "findings_summary": { "$ref": "#/$defs/findings_summary" },
        "resulting_mode_index": {
          "type": "array",
          "items": { "$ref": "#/$defs/resulting_mode_entry" }
        },
        "registered_intake_count": { "type": "integer", "minimum": 0 },
        "marketed_intake_count": { "type": "integer", "minimum": 0 },
        "project_entry_parity_count": { "type": "integer", "minimum": 0 },
        "narrowable_marketed_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowable_entry" }
        },
        "report_clean": { "type": "boolean" },
        "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
        "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "docs_help_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "support_export_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "generated_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "system_entry_support_export_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "support_export_id",
        "report",
        "case_ids"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_system_entry_support_export_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "support_export_id": { "$ref": "#/$defs/non_empty_string" },
        "report": { "$ref": "#/$defs/system_entry_report_record" },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "system_entry_case_export_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "case_export_id",
        "case_label",
        "availability",
        "intake",
        "recovery_actions",
        "reproduction_note"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "shell_m5_system_entry_case_export_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "case_export_id": { "$ref": "#/$defs/non_empty_string" },
        "case_label": { "$ref": "#/$defs/non_empty_string" },
        "availability": { "$ref": "#/$defs/availability" },
        "intake": { "$ref": "#/$defs/intake_row" },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recovery_action" }
        },
        "reproduction_note": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
