{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-native-desktop-qualification.schema.json",
  "title": "Aureline M5 native-desktop per-desktop-profile qualification family",
  "description": "Boundary schema for the native-desktop qualification family emitted by the aureline-shell m5_native_desktop_qualification module. The family certifies the native-desktop matrix across every claimed desktop profile (platform × delivery channel): one row per profile binds each of the seven canonical qualification dimensions (channel_build_ownership, protocol_handler_ownership, file_association_ownership, reopen_fidelity, notification_privacy, external_root_recovery, store_lock_recovery) to the platform-conformance drill it is qualified by (channel_ownership_audit, handler_conflict, wrong_target_reopen, lock_screen_privacy, missing_root_recovery, store_lock), and the report derives an auto-narrowing claim scope that Help/About, install/update, docs, support, evaluation, shiproom, and release-center surfaces ingest. Acceptance: every profile MUST bind all seven dimensions and every dimension MUST be qualified by at least one profile; every profile MUST carry a platform, a delivery channel, a channel/build owner, a trust checkpoint, a non-empty continuity note, a downgrade rule, and registered_on_qualification_harness=true; every qualified dimension MUST carry its drill ref and an evidence pack that names this profile so a row can never borrow another profile's or channel's proof; a failed dimension is a blocker and each failure stays a distinct class (ownership_unprovable, protocol_handler_conflict, file_association_conflict, wrong_target_reopen, lock_screen_leak, missing_root_silent_loss, store_lock_dead_end are never collapsed); stale evidence on a marketed profile is a blocker so release tooling can narrow it; and the published claim_state for each profile MUST be derived from its dimension qualification so the claim can never be greener than the proof. This schema is the only boundary contract for the JSON fixtures checked in under fixtures/platform/m5-native-desktop-qualification/ and the support-export and claim-packet wrappers consumed by the CI gate at tools/ci/m5/native_desktop_qualification_check.py.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/qualification_report_record" },
    { "$ref": "#/$defs/qualification_support_export_record" },
    { "$ref": "#/$defs/qualification_claim_packet_record" }
  ],
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Integer schema version. Bumped only on breaking payload changes."
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "shell:m5_native_desktop_qualification:v1",
      "description": "Stable shared contract ref every record carries."
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "ref_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "platform": {
      "type": "string",
      "enum": ["macos", "windows", "linux"]
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "managed_fleet", "portable"]
    },
    "ownership_kind": {
      "type": "string",
      "enum": [
        "channel_scoped_owner",
        "shared_default_arbitrated",
        "managed_fleet_owned",
        "portable_non_registering"
      ]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "channel_build_ownership",
        "protocol_handler_ownership",
        "file_association_ownership",
        "reopen_fidelity",
        "notification_privacy",
        "external_root_recovery",
        "store_lock_recovery"
      ]
    },
    "drill": {
      "type": "string",
      "enum": [
        "channel_ownership_audit",
        "handler_conflict",
        "wrong_target_reopen",
        "lock_screen_privacy",
        "missing_root_recovery",
        "store_lock"
      ]
    },
    "qualification_status": {
      "type": "string",
      "enum": [
        "qualified",
        "not_applicable",
        "explicitly_narrowed",
        "unqualified",
        "failed"
      ]
    },
    "failure_mode": {
      "type": "string",
      "enum": [
        "ownership_unprovable",
        "protocol_handler_conflict",
        "file_association_conflict",
        "wrong_target_reopen",
        "lock_screen_leak",
        "missing_root_silent_loss",
        "store_lock_dead_end"
      ]
    },
    "evidence_freshness": {
      "type": "string",
      "enum": ["fresh", "stale"]
    },
    "claim_state": {
      "type": "string",
      "enum": ["published", "narrowed", "withheld"]
    },
    "finding_class": {
      "type": "string",
      "enum": [
        "ownership_unprovable",
        "protocol_handler_conflict",
        "file_association_conflict",
        "wrong_target_reopen",
        "lock_screen_leak",
        "missing_root_silent_loss",
        "store_lock_dead_end",
        "unqualified_marketed_dimension",
        "failure_mode_drift",
        "drill_kind_drift",
        "missing_drill_ref",
        "missing_evidence_pack",
        "borrowed_proof_across_profile",
        "missing_narrowing_reason",
        "missing_required_dimension",
        "stale_evidence_on_marketed_profile",
        "missing_channel_build_owner",
        "missing_trust_checkpoint",
        "missing_continuity_note",
        "missing_downgrade_rule",
        "profile_not_on_harness"
      ]
    },
    "cross_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_desktop_matrix_ref",
        "channel_ownership_ref",
        "protocol_handler_ownership_ref",
        "file_association_ownership_ref",
        "reopen_corpus_ref",
        "notification_privacy_ref",
        "external_root_recovery_ref",
        "install_topology_ref"
      ],
      "properties": {
        "native_desktop_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "channel_ownership_ref": { "$ref": "#/$defs/non_empty_string" },
        "protocol_handler_ownership_ref": { "$ref": "#/$defs/non_empty_string" },
        "file_association_ownership_ref": { "$ref": "#/$defs/non_empty_string" },
        "reopen_corpus_ref": { "$ref": "#/$defs/non_empty_string" },
        "notification_privacy_ref": { "$ref": "#/$defs/non_empty_string" },
        "external_root_recovery_ref": { "$ref": "#/$defs/non_empty_string" },
        "install_topology_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "platform",
        "channel",
        "descriptor_revision_ref",
        "display_label_ref",
        "channel_build_owner_ref",
        "ownership_kind",
        "trust_checkpoint_ref",
        "continuity_note",
        "evidence_freshness",
        "evidence_captured_at",
        "downgrade_rule_ref",
        "marketed",
        "registered_on_qualification_harness"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/non_empty_string" },
        "platform": { "$ref": "#/$defs/platform" },
        "channel": { "$ref": "#/$defs/channel" },
        "descriptor_revision_ref": { "$ref": "#/$defs/non_empty_string" },
        "display_label_ref": { "$ref": "#/$defs/non_empty_string" },
        "channel_build_owner_ref": { "$ref": "#/$defs/non_empty_string" },
        "ownership_kind": { "$ref": "#/$defs/ownership_kind" },
        "trust_checkpoint_ref": { "$ref": "#/$defs/non_empty_string" },
        "continuity_note": { "$ref": "#/$defs/non_empty_string" },
        "evidence_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "evidence_captured_at": { "$ref": "#/$defs/non_empty_string" },
        "downgrade_rule_ref": { "$ref": "#/$defs/non_empty_string" },
        "marketed": { "type": "boolean" },
        "registered_on_qualification_harness": { "type": "boolean" }
      }
    },
    "dimension_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "required_drill",
        "status",
        "failure_mode",
        "drill_ref",
        "evidence_pack_ref",
        "narrowing_reason",
        "note"
      ],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "required_drill": { "$ref": "#/$defs/drill" },
        "status": { "$ref": "#/$defs/qualification_status" },
        "failure_mode": {
          "oneOf": [{ "$ref": "#/$defs/failure_mode" }, { "type": "null" }]
        },
        "drill_ref": { "$ref": "#/$defs/nullable_string" },
        "evidence_pack_ref": { "$ref": "#/$defs/nullable_string" },
        "narrowing_reason": { "$ref": "#/$defs/nullable_string" },
        "note": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "blocking_finding": {
      "type": "object",
      "required": ["class", "profile_id"],
      "properties": {
        "class": { "$ref": "#/$defs/finding_class" },
        "profile_id": { "$ref": "#/$defs/non_empty_string" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "status": { "$ref": "#/$defs/qualification_status" },
        "declared_failure_mode": {
          "oneOf": [{ "$ref": "#/$defs/failure_mode" }, { "type": "null" }]
        },
        "declared_drill": { "$ref": "#/$defs/drill" }
      }
    },
    "dimension_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "qualified",
        "not_applicable",
        "explicitly_narrowed",
        "unqualified",
        "failed"
      ],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "qualified": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 },
        "explicitly_narrowed": { "type": "integer", "minimum": 0 },
        "unqualified": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "profile_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "platform",
        "channel",
        "claim_state",
        "qualified_dimensions",
        "narrowed_dimensions",
        "blocked_dimensions",
        "evidence_freshness",
        "downgrade_rule_ref",
        "reason"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/non_empty_string" },
        "platform": { "$ref": "#/$defs/platform" },
        "channel": { "$ref": "#/$defs/channel" },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "qualified_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "narrowed_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "blocked_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "evidence_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "downgrade_rule_ref": { "$ref": "#/$defs/non_empty_string" },
        "reason": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "count"],
      "properties": {
        "class": { "$ref": "#/$defs/finding_class" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "findings_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_blocking_findings", "by_class"],
      "properties": {
        "total_blocking_findings": { "type": "integer", "minimum": 0 },
        "by_class": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding_count" }
        }
      }
    },
    "narrowable_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "dimension", "reason"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/non_empty_string" },
        "dimension": {
          "oneOf": [{ "$ref": "#/$defs/dimension" }, { "type": "null" }]
        },
        "reason": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "profile_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor",
        "bindings",
        "blocking_findings",
        "claim_state",
        "marketed"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_native_desktop_qualification_profile_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor": { "$ref": "#/$defs/descriptor" },
        "bindings": {
          "type": "array",
          "minItems": 7,
          "items": { "$ref": "#/$defs/dimension_binding" }
        },
        "blocking_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocking_finding" }
        },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "marketed": { "type": "boolean" }
      }
    },
    "qualification_report_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "report_id",
        "source_schema_ref",
        "required_dimensions",
        "required_drills",
        "claimed_platforms",
        "cross_links",
        "profiles",
        "dimension_coverage",
        "claim_scope",
        "findings_summary",
        "registered_profile_count",
        "marketed_profile_count",
        "dimensions_checked",
        "published_claim_count",
        "narrowed_claim_count",
        "withheld_claim_count",
        "narrowable_marketed_profiles",
        "report_clean",
        "published_report_ref",
        "published_doc_ref",
        "claim_packet_ref",
        "matrix_report_ref",
        "docs_help_refs",
        "support_export_refs",
        "generated_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_native_desktop_qualification_report_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "report_id": { "$ref": "#/$defs/non_empty_string" },
        "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "required_dimensions": {
          "type": "array",
          "minItems": 7,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "required_drills": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/drill" }
        },
        "claimed_platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platform" }
        },
        "cross_links": { "$ref": "#/$defs/cross_links" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/profile_record" }
        },
        "dimension_coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension_coverage" }
        },
        "claim_scope": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile_claim" }
        },
        "findings_summary": { "$ref": "#/$defs/findings_summary" },
        "registered_profile_count": { "type": "integer", "minimum": 0 },
        "marketed_profile_count": { "type": "integer", "minimum": 0 },
        "dimensions_checked": { "type": "integer", "minimum": 0 },
        "published_claim_count": { "type": "integer", "minimum": 0 },
        "narrowed_claim_count": { "type": "integer", "minimum": 0 },
        "withheld_claim_count": { "type": "integer", "minimum": 0 },
        "narrowable_marketed_profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowable_profile" }
        },
        "report_clean": { "type": "boolean" },
        "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
        "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "claim_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "matrix_report_ref": { "$ref": "#/$defs/non_empty_string" },
        "docs_help_refs": { "$ref": "#/$defs/ref_array" },
        "support_export_refs": { "$ref": "#/$defs/ref_array" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "qualification_support_export_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "support_export_id",
        "report",
        "case_ids"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_native_desktop_qualification_support_export_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "support_export_id": { "$ref": "#/$defs/non_empty_string" },
        "report": { "$ref": "#/$defs/qualification_report_record" },
        "case_ids": { "$ref": "#/$defs/ref_array" }
      }
    },
    "claim_downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "claim_state", "downgrade_rule_ref"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/non_empty_string" },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "downgrade_rule_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "qualification_claim_packet_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "claim_packet_id",
        "report",
        "publishable_profiles",
        "narrowed_profiles",
        "withheld_profiles",
        "downgrade_rules",
        "claim_publishable",
        "case_ids"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_m5_native_desktop_qualification_claim_packet_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "claim_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "report": { "$ref": "#/$defs/qualification_report_record" },
        "publishable_profiles": { "$ref": "#/$defs/ref_array" },
        "narrowed_profiles": { "$ref": "#/$defs/ref_array" },
        "withheld_profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "downgrade_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_downgrade_rule" }
        },
        "claim_publishable": { "type": "boolean" },
        "case_ids": { "$ref": "#/$defs/ref_array" }
      }
    }
  }
}
