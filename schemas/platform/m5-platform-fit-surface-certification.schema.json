{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/platform/m5-platform-fit-surface-certification.schema.json",
  "title": "Aureline M5 platform-fit surface certification packet",
  "description": "M05-1171 closing capstone certifying that the frozen M5 platform-fit families (platform-convention, shortcut-notation, file-path-reveal, theme-contrast-live-change, credential-store-wording, input-method) hold their truth on every claimed M5 desktop operating profile. Keyed on the claimed profile (live trusted platform-fit surface, reviewable platform-fit structure, disclosed path-terminology profile, unverified appearance-response profile, unverified credential-wording profile, unverified input-fidelity profile), each row certifies the profile across nine truth axes — visual, keyboard, screen-reader, high-zoom-reflow, high-contrast, localization, CLI/export, degraded-state, and platform-fit-component-truth behavior — and either passes (green), auto-narrows its platform-fit claim to the weakest supported ceiling (yellow), or blocks (red) when a degraded axis is hidden behind a fresh trusted claim inherited from a healthier profile. A degraded axis must produce a visible claim narrowing; CLI/export parity must always certify; only a live first-party trusted platform-fit profile may certify a trusted platform-fit surface; and every B139 hard invariant must hold (platform-specific wording never changes command or permission meaning; a primary action is never hidden only in OS chrome; secret storage never silently falls back to plaintext; an input method never corrupts text or trust fidelity; and a screenshot or docs page never mislabels a shortcut or path / reveal verb). Every row cites exactly one canonical platform-fit proof bundle. The packet is metadata-only: raw credentials, plaintext secrets, bearer tokens, endpoint URLs, and private-key material never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "as_of",
    "matrix_ref",
    "canonical_bundle_ref",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "m5_platform_fit_surface_certification_packet" },
    "packet_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "canonical_bundle_ref": {
      "const": "artifacts/release/m5-platform-fit-proof/support_export.json"
    },
    "rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "certified_profile": {
      "enum": [
        "live_trusted_platform_fit_surface",
        "reviewable_platform_fit_structure",
        "disclosed_path_terminology_profile",
        "unverified_appearance_response_profile",
        "unverified_credential_wording_profile",
        "unverified_input_fidelity_profile"
      ]
    },
    "certification_axis": {
      "enum": [
        "visual",
        "keyboard",
        "screen_reader",
        "high_zoom_reflow",
        "high_contrast",
        "localization",
        "cli_export",
        "degraded_state",
        "platform_fit_component_truth"
      ]
    },
    "platform_fit_claim": {
      "enum": [
        "trusted_platform_fit_surface",
        "reviewable_platform_fit_surface",
        "path_terminology_disclosed_projection",
        "appearance_response_unverified_projection",
        "credential_wording_unverified_projection",
        "input_fidelity_unverified_projection"
      ]
    },
    "axis_state": {
      "enum": ["certified", "disclosed_narrowed", "undisclosed_drift"]
    },
    "profile_status": {
      "enum": ["green", "yellow", "red"]
    },
    "platform_fit_family": {
      "enum": [
        "platform_convention",
        "shortcut_notation",
        "file_path_reveal",
        "theme_contrast_live_change",
        "credential_store_wording",
        "input_method"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "platform_wording_changed_command_or_permission_meaning",
        "primary_action_hidden_only_in_os_chrome",
        "secret_storage_fell_back_to_plaintext_silently",
        "input_method_corrupted_text_or_trust",
        "screenshot_or_docs_mislabeled_shortcut_or_path_verb",
        "theme_or_contrast_change_did_not_apply_live_or_explain_fallback",
        "shortcut_notation_drifted_by_platform",
        "host_platform_unstated",
        "shortcut_notation_unstated",
        "path_verb_unstated",
        "registry_reference_unstated",
        "proof_stale"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lets_platform_wording_change_command_or_permission_meaning",
        "hides_a_primary_action_only_in_os_chrome",
        "falls_back_to_plaintext_secret_storage_silently",
        "lets_an_input_method_corrupt_text_or_trust_fidelity",
        "produces_a_screenshot_or_docs_page_that_mislabels_a_shortcut_or_path_verb"
      ],
      "properties": {
        "lets_platform_wording_change_command_or_permission_meaning": { "const": false },
        "hides_a_primary_action_only_in_os_chrome": { "const": false },
        "falls_back_to_plaintext_secret_storage_silently": { "const": false },
        "lets_an_input_method_corrupt_text_or_trust_fidelity": { "const": false },
        "produces_a_screenshot_or_docs_page_that_mislabels_a_shortcut_or_path_verb": {
          "const": false
        }
      }
    },
    "export_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "export_fields", "raw_payload_only_prohibited"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "export_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_only_prohibited": { "const": true }
      }
    },
    "axis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "state", "parity_note"],
      "properties": {
        "axis": { "$ref": "#/$defs/certification_axis" },
        "state": { "$ref": "#/$defs/axis_state" },
        "parity_note": { "type": "string", "minLength": 1 },
        "narrowing_reason": { "type": "string", "minLength": 1 },
        "downgrade_trigger": { "$ref": "#/$defs/downgrade_trigger" }
      }
    },
    "claim_auto_narrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_axis", "from_claim", "to_claim", "visible_label"],
      "properties": {
        "binding_axis": { "$ref": "#/$defs/certification_axis" },
        "from_claim": { "$ref": "#/$defs/platform_fit_claim" },
        "to_claim": { "$ref": "#/$defs/platform_fit_claim" },
        "visible_label": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "profile",
        "claimed_claim",
        "certified_claim",
        "consumed_families",
        "axis_outcomes",
        "guardrails",
        "canonical_bundle_ref",
        "derived_status",
        "export_parity",
        "compatibility_notes",
        "observed_at",
        "evidence_refs"
      ],
      "properties": {
        "record_kind": { "const": "m5_platform_fit_surface_certification_row" },
        "schema_version": { "const": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/certified_profile" },
        "claimed_claim": { "$ref": "#/$defs/platform_fit_claim" },
        "certified_claim": { "$ref": "#/$defs/platform_fit_claim" },
        "consumed_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platform_fit_family" }
        },
        "axis_outcomes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/axis_outcome" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" },
        "claim_auto_narrow": { "$ref": "#/$defs/claim_auto_narrow" },
        "canonical_bundle_ref": {
          "const": "artifacts/release/m5-platform-fit-proof/support_export.json"
        },
        "derived_status": { "$ref": "#/$defs/profile_status" },
        "export_parity": { "$ref": "#/$defs/export_parity" },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "profile_count",
        "green_row_count",
        "yellow_row_count",
        "red_row_count",
        "all_profiles_present",
        "all_families_covered",
        "all_rows_publishable",
        "all_status_fresh",
        "all_rows_cite_canonical_bundle",
        "all_rows_export_parity_certified",
        "all_guardrails_held",
        "every_axis_covered_on_every_row",
        "narrowed_profile_count",
        "report_clean"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "profile_count": { "type": "integer", "minimum": 0 },
        "green_row_count": { "type": "integer", "minimum": 0 },
        "yellow_row_count": { "type": "integer", "minimum": 0 },
        "red_row_count": { "type": "integer", "minimum": 0 },
        "all_profiles_present": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "all_rows_publishable": { "type": "boolean" },
        "all_status_fresh": { "type": "boolean" },
        "all_rows_cite_canonical_bundle": { "type": "boolean" },
        "all_rows_export_parity_certified": { "type": "boolean" },
        "all_guardrails_held": { "type": "boolean" },
        "every_axis_covered_on_every_row": { "type": "boolean" },
        "narrowed_profile_count": { "type": "integer", "minimum": 0 },
        "report_clean": { "type": "boolean" }
      }
    }
  }
}
