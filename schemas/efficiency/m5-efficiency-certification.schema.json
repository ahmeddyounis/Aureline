{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/efficiency/m5-efficiency-certification.schema.json",
  "title": "M5 efficiency certification proof packet",
  "description": "The canonical, export-safe proof packet certifying power, thermal, battery-efficiency, and hidden-work-shedding truth on every claimed laptop/desktop profile and long-running M5 surface family. Each row runs a fixed drill set against current energy/thermal, hidden-pane, and session-pressure evidence; stale, partial, or missing evidence and any failed drill narrow the row's claim and fire the promotion gate. Release, support, docs, and help consume this packet instead of cloning a low-power claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "as_of",
    "title",
    "summary",
    "matrix_ref",
    "matrix_schema_ref",
    "schema_ref",
    "source_refs",
    "evidence_freshness_window_days",
    "claim_levels",
    "drills",
    "evidence_kinds",
    "narrowing_reasons",
    "certification_states",
    "required_publication_surfaces",
    "rows",
    "promotion_gate",
    "publication_bindings",
    "summary_counts",
    "inspection"
  ],
  "properties": {
    "record_kind": { "const": "efficiency_m5_proof_packet" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "matrix_ref": { "type": "string", "minLength": 1 },
    "matrix_schema_ref": { "type": "string", "minLength": 1 },
    "schema_ref": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_freshness_window_days": { "type": "integer", "minimum": 1 },
    "claim_levels": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/claimLevelDeclaration" }
    },
    "drills": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/drillDeclaration" }
    },
    "evidence_kinds": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/evidenceKindDeclaration" }
    },
    "narrowing_reasons": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/narrowingReasonDeclaration" }
    },
    "certification_states": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/certificationStateDeclaration" }
    },
    "required_publication_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certificationRow" }
    },
    "promotion_gate": { "$ref": "#/$defs/promotionGate" },
    "publication_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/publicationBinding" }
    },
    "summary_counts": { "$ref": "#/$defs/summaryCounts" },
    "inspection": { "$ref": "#/$defs/inspection" }
  },
  "$defs": {
    "claimLevel": {
      "type": "string",
      "enum": [
        "undeclared_badge",
        "state_declared",
        "qualified_low_power",
        "certified_low_power"
      ]
    },
    "efficiencyState": {
      "type": "string",
      "enum": [
        "Nominal",
        "EfficiencyAware",
        "ThermalConstrained",
        "ProtectCore",
        "Recovery"
      ]
    },
    "subjectKind": {
      "type": "string",
      "enum": ["laptop_or_desktop_profile", "m5_surface_family"]
    },
    "drillToken": {
      "type": "string",
      "enum": [
        "efficiency_state_behavior",
        "hidden_work_suppression",
        "protected_path_preservation",
        "session_aware_shedding",
        "staged_recovery"
      ]
    },
    "evidenceKind": {
      "type": "string",
      "enum": [
        "energy_thermal_trace",
        "hidden_pane_audit",
        "session_pressure_posture"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["current", "stale", "partial", "missing"]
    },
    "narrowingReason": {
      "type": "string",
      "enum": [
        "missing_efficiency_evidence",
        "stale_efficiency_evidence",
        "partial_evidence_coverage",
        "unqualified_hidden_work_suppression",
        "protected_path_regression_under_pressure",
        "session_shed_order_violation",
        "recovery_not_staged"
      ]
    },
    "certificationState": {
      "type": "string",
      "enum": ["certified", "narrowed", "quarantined"]
    },
    "outcome": {
      "type": "string",
      "enum": ["pass", "fail", "stale", "partial", "missing"]
    },
    "claimLevelDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rank", "claim_bearing", "label", "description"],
      "properties": {
        "level": { "$ref": "#/$defs/claimLevel" },
        "rank": { "type": "integer", "minimum": 0, "maximum": 3 },
        "claim_bearing": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "drillDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drill", "label", "proves", "evidence_kind", "failure_reason"],
      "properties": {
        "drill": { "$ref": "#/$defs/drillToken" },
        "label": { "type": "string", "minLength": 1 },
        "proves": { "type": "string", "minLength": 1 },
        "evidence_kind": { "$ref": "#/$defs/evidenceKind" },
        "failure_reason": { "$ref": "#/$defs/narrowingReason" }
      }
    },
    "evidenceKindDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": { "$ref": "#/$defs/evidenceKind" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "narrowingReasonDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "narrows_to",
        "detects",
        "auto_detectable",
        "stop_rule"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/narrowingReason" },
        "narrows_to": { "$ref": "#/$defs/claimLevel" },
        "detects": { "type": "string", "minLength": 1 },
        "auto_detectable": { "const": true },
        "stop_rule": { "type": "string", "minLength": 1 }
      }
    },
    "certificationStateDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "is_certified",
        "blocks_when_claim_bearing",
        "description"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/certificationState" },
        "is_certified": { "type": "boolean" },
        "blocks_when_claim_bearing": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "drillResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "drill",
        "drill_label",
        "proves",
        "evidence_kind",
        "evidence_refs",
        "evidence_as_of",
        "freshness",
        "outcome",
        "passed",
        "detail"
      ],
      "properties": {
        "record_kind": { "const": "efficiency_m5_certification_drill_result" },
        "drill": { "$ref": "#/$defs/drillToken" },
        "drill_label": { "type": "string", "minLength": 1 },
        "proves": { "type": "string", "minLength": 1 },
        "evidence_kind": { "$ref": "#/$defs/evidenceKind" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_as_of": { "type": "string" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "passed": { "type": "boolean" },
        "narrowing_reason": { "$ref": "#/$defs/narrowingReason" },
        "detail": { "type": "string" }
      }
    },
    "promotionBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks_promotion", "blocker_reasons", "posture_label"],
      "properties": {
        "blocks_promotion": { "type": "boolean" },
        "blocker_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowingReason" }
        },
        "posture_label": { "type": "string", "minLength": 1 }
      }
    },
    "certificationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "row_id",
        "subject_kind",
        "subject_token",
        "subject_label",
        "claimed_efficiency_states",
        "published_claim_ceiling",
        "required_drills",
        "drill_results",
        "fired_narrowing_reasons",
        "effective_posture",
        "certification_state",
        "promotion_blocker",
        "protected_paths_preserved",
        "hidden_work_suppressed",
        "optional_work_sheds_first",
        "evidence_freshness",
        "evidence_as_of",
        "publication_targets",
        "governance_row_ref"
      ],
      "properties": {
        "record_kind": { "const": "efficiency_m5_certification_row" },
        "row_id": { "type": "string", "minLength": 1 },
        "subject_kind": { "$ref": "#/$defs/subjectKind" },
        "subject_token": { "type": "string", "minLength": 1 },
        "subject_label": { "type": "string", "minLength": 1 },
        "claimed_efficiency_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/efficiencyState" }
        },
        "published_claim_ceiling": { "$ref": "#/$defs/claimLevel" },
        "required_drills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/drillToken" }
        },
        "drill_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/drillResult" }
        },
        "fired_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowingReason" }
        },
        "effective_posture": { "$ref": "#/$defs/claimLevel" },
        "certification_state": { "$ref": "#/$defs/certificationState" },
        "promotion_blocker": { "$ref": "#/$defs/promotionBlocker" },
        "protected_paths_preserved": { "type": "boolean" },
        "hidden_work_suppressed": { "type": "boolean" },
        "optional_work_sheds_first": { "type": "boolean" },
        "evidence_freshness": { "$ref": "#/$defs/freshness" },
        "evidence_as_of": { "type": "string" },
        "publication_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "governance_row_ref": { "type": "string" }
      }
    },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "blocking_row_ids", "blocking_reasons", "rationale"],
      "properties": {
        "decision": { "type": "string", "enum": ["proceed", "hold"] },
        "blocking_row_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocking_reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "publicationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "projection", "ingests"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "projection": { "type": "string", "minLength": 1 },
        "ingests": { "type": "string", "minLength": 1 }
      }
    },
    "summaryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "rows_certified",
        "rows_narrowed",
        "rows_quarantined",
        "profile_rows",
        "surface_family_rows",
        "claim_bearing_rows",
        "rows_blocking_promotion",
        "covered_profiles",
        "covered_surface_families"
      ],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "rows_certified": { "type": "integer", "minimum": 0 },
        "rows_narrowed": { "type": "integer", "minimum": 0 },
        "rows_quarantined": { "type": "integer", "minimum": 0 },
        "profile_rows": { "type": "integer", "minimum": 0 },
        "surface_family_rows": { "type": "integer", "minimum": 0 },
        "claim_bearing_rows": { "type": "integer", "minimum": 0 },
        "rows_blocking_promotion": { "type": "integer", "minimum": 0 },
        "covered_profiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "covered_surface_families": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "how_to_recompute",
        "freshness_rule",
        "promotion_rule",
        "governance_matrix_ref"
      ],
      "properties": {
        "how_to_recompute": { "type": "string", "minLength": 1 },
        "freshness_rule": { "type": "string", "minLength": 1 },
        "promotion_rule": { "type": "string", "minLength": 1 },
        "governance_matrix_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
