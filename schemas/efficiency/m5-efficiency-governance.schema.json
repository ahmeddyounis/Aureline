{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/efficiency/m5-efficiency-governance.schema.json",
  "title": "M5 efficiency-state governance matrix",
  "description": "Boundary schema for the canonical M5 efficiency-state governance matrix. The matrix freezes one typed vocabulary for efficiency state, source-of-change, throttled subsystem, hidden-pane behaviour, override posture, and recovery state, and binds every M5 surface that claims low-power behaviour (notebooks, previews, docs/browser panes, traces, pipelines, remote sessions, support exports, and companion-adjacent views) to the evidence that backs it. Each row recomputes the narrowing reasons that fire, the narrowed effective posture, and the certification state from its inline efficiency-state evidence, hidden-work suppression, protected-path preservation, override policy-awareness, recovery staging, and consumer propagation; a green tile cannot mask a fired reason, and a claim-bearing row that narrows below the posture it asserts holds promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "as_of",
    "title",
    "summary",
    "evidence_index_ref",
    "source_refs",
    "closed_vocabularies",
    "claim_levels",
    "pillars",
    "narrowing_reasons",
    "certification_states",
    "m5_surfaces",
    "required_publication_surfaces",
    "rows",
    "promotion_gate",
    "consumer_bindings",
    "inspection"
  ],
  "properties": {
    "record_kind": { "const": "efficiency_m5_governance_matrix" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "evidence_index_ref": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "closed_vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "efficiency_state",
        "source_of_change",
        "throttled_subsystem",
        "hidden_pane_behavior",
        "visibility_state",
        "override_posture",
        "recovery_state"
      ],
      "properties": {
        "efficiency_state": {
          "type": "array",
          "items": { "$ref": "#/$defs/efficiencyState" },
          "minItems": 5,
          "uniqueItems": true
        },
        "source_of_change": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceOfChange" },
          "minItems": 1,
          "uniqueItems": true
        },
        "throttled_subsystem": {
          "type": "array",
          "items": { "$ref": "#/$defs/throttledSubsystem" },
          "minItems": 1,
          "uniqueItems": true
        },
        "hidden_pane_behavior": {
          "type": "array",
          "items": { "$ref": "#/$defs/hiddenPaneBehavior" },
          "minItems": 1,
          "uniqueItems": true
        },
        "visibility_state": {
          "type": "array",
          "items": { "$ref": "#/$defs/visibilityState" },
          "minItems": 1,
          "uniqueItems": true
        },
        "override_posture": {
          "type": "array",
          "items": { "$ref": "#/$defs/overridePosture" },
          "minItems": 1,
          "uniqueItems": true
        },
        "recovery_state": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryState" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "claim_levels": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "rank", "claim_bearing", "label", "description"],
        "properties": {
          "level": { "$ref": "#/$defs/claimLevel" },
          "rank": { "type": "integer", "minimum": 0 },
          "claim_bearing": { "type": "boolean" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pillars": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pillar", "proves"],
        "properties": {
          "pillar": { "$ref": "#/$defs/pillar" },
          "proves": { "type": "string", "minLength": 1 }
        }
      }
    },
    "narrowing_reasons": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "pillar", "detects", "narrows_to", "auto_detectable", "stop_rule"],
        "properties": {
          "reason": { "$ref": "#/$defs/narrowingReason" },
          "pillar": { "$ref": "#/$defs/pillar" },
          "detects": { "type": "string", "minLength": 1 },
          "narrows_to": { "$ref": "#/$defs/claimLevel" },
          "auto_detectable": { "const": true },
          "stop_rule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "certification_states": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "is_certified", "blocks_when_claim_bearing", "description"],
        "properties": {
          "state": { "$ref": "#/$defs/certificationState" },
          "is_certified": { "type": "boolean" },
          "blocks_when_claim_bearing": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "m5_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "description"],
        "properties": {
          "surface": { "$ref": "#/$defs/m5Surface" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_publication_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/governanceRow" }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "blocking_row_ids", "blocking_reasons", "rationale"],
      "properties": {
        "decision": { "enum": ["proceed", "hold"] },
        "blocking_row_ids": { "type": "array", "items": { "type": "string" } },
        "blocking_reasons": { "type": "array", "items": { "$ref": "#/$defs/narrowingReason" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer", "source_projection", "ingests"],
        "properties": {
          "consumer": { "type": "string", "minLength": 1 },
          "source_projection": { "type": "string", "minLength": 1 },
          "ingests": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["how_to_recompute", "promotion_gate", "evidence_index_ref"],
      "properties": {
        "how_to_recompute": { "type": "string", "minLength": 1 },
        "promotion_gate": { "type": "string", "minLength": 1 },
        "vocabulary_binding": { "type": "string", "minLength": 1 },
        "evidence_index_ref": { "type": "string", "minLength": 1 }
      }
    },
    "summary_counts": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "claimLevel": {
      "enum": [
        "undeclared_badge",
        "state_declared",
        "qualified_low_power",
        "certified_low_power"
      ]
    },
    "m5Surface": {
      "enum": [
        "notebooks",
        "previews",
        "docs_browser_panes",
        "traces",
        "pipelines",
        "remote_sessions",
        "support_exports",
        "companion_adjacent"
      ]
    },
    "pillar": {
      "enum": [
        "efficiency_state_evidence",
        "behavior_declaration",
        "hidden_work_suppression",
        "protected_path_preservation",
        "override_policy_awareness",
        "recovery_staging",
        "consumer_propagation"
      ]
    },
    "narrowingReason": {
      "enum": [
        "missing_efficiency_state_evidence",
        "vague_low_power_badge",
        "unqualified_hidden_work_suppression",
        "protected_path_regression_under_pressure",
        "override_not_policy_aware",
        "recovery_not_staged",
        "missing_consumer_propagation"
      ]
    },
    "certificationState": { "enum": ["certified", "narrowed", "quarantined"] },
    "efficiencyState": {
      "enum": [
        "Nominal",
        "EfficiencyAware",
        "ThermalConstrained",
        "ProtectCore",
        "Recovery"
      ]
    },
    "sourceOfChange": {
      "enum": [
        "ac_power",
        "battery",
        "os_battery_saver",
        "user_low_power_mode",
        "low_battery",
        "critical_battery",
        "thermal_pressure",
        "frame_miss_pressure",
        "policy_cap",
        "pressure_cleared"
      ]
    },
    "throttledSubsystem": {
      "enum": [
        "ai_warmup",
        "speculative_prefetch",
        "upload_transfer",
        "non_essential_animation",
        "indexing_refresh",
        "extension_polling",
        "preview_refresh",
        "graph_enrichment",
        "remote_session_helper"
      ]
    },
    "hiddenPaneBehavior": {
      "enum": [
        "render_suppressed",
        "animation_suppressed",
        "polling_paused",
        "correctness_poll_only",
        "fully_quiescent"
      ]
    },
    "visibilityState": {
      "enum": [
        "visible_focused",
        "visible_background",
        "occluded_window",
        "hidden_tab",
        "collapsed_split",
        "detached_offscreen"
      ]
    },
    "overridePosture": {
      "enum": [
        "not_overridable",
        "user_override_session_only",
        "user_override_persistent",
        "policy_blocked",
        "admin_controlled"
      ]
    },
    "recoveryState": {
      "enum": [
        "not_in_recovery",
        "staged_resume",
        "awaiting_user_restore_power",
        "awaiting_reconnect",
        "awaiting_admin_policy",
        "recovered"
      ]
    },
    "hiddenPaneBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility_state", "behaviors"],
      "properties": {
        "visibility_state": { "$ref": "#/$defs/visibilityState" },
        "behaviors": {
          "type": "array",
          "items": { "$ref": "#/$defs/hiddenPaneBehavior" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "rowEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "efficiency_state_evidence_present",
        "declares_behavior_change",
        "binds_hidden_panes",
        "hidden_work_suppression_qualified",
        "hidden_pane_render_violation_count",
        "protected_paths_preserved",
        "override_policy_aware",
        "override_policy_ref",
        "recovery_required",
        "recovery_staged",
        "propagated_surfaces"
      ],
      "properties": {
        "efficiency_state_evidence_present": { "type": "boolean" },
        "declares_behavior_change": { "type": "boolean" },
        "binds_hidden_panes": { "type": "boolean" },
        "hidden_work_suppression_qualified": { "type": "boolean" },
        "hidden_pane_render_violation_count": { "type": "integer", "minimum": 0 },
        "protected_paths_preserved": { "type": "boolean" },
        "override_policy_aware": { "type": "boolean" },
        "override_policy_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "recovery_required": { "type": "boolean" },
        "recovery_staged": { "type": "boolean" },
        "propagated_surfaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dimensionFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certification_status", "narrowing_reason", "bound_refs"],
      "properties": {
        "certification_status": { "enum": ["certified", "gap"] },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/narrowingReason" }]
        },
        "bound_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "governanceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "subject_kind",
        "m5_surface",
        "title",
        "efficiency_state",
        "source_of_change",
        "throttled_subsystems",
        "hidden_pane_bindings",
        "override_posture",
        "recovery_state",
        "posture",
        "published_claim_ceiling",
        "required_publication_surfaces",
        "evidence",
        "evidence_refs",
        "dimension_findings",
        "fired_narrowing_reasons",
        "effective_posture",
        "certification_state",
        "promotion_blocker",
        "release_binding"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "subject_kind": { "const": "m5_efficiency_governance_row" },
        "m5_surface": { "$ref": "#/$defs/m5Surface" },
        "title": { "type": "string", "minLength": 1 },
        "efficiency_state": { "$ref": "#/$defs/efficiencyState" },
        "source_of_change": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceOfChange" },
          "minItems": 1,
          "uniqueItems": true
        },
        "throttled_subsystems": {
          "type": "array",
          "items": { "$ref": "#/$defs/throttledSubsystem" },
          "uniqueItems": true
        },
        "hidden_pane_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/hiddenPaneBinding" }
        },
        "override_posture": { "$ref": "#/$defs/overridePosture" },
        "recovery_state": { "$ref": "#/$defs/recoveryState" },
        "posture": { "$ref": "#/$defs/claimLevel" },
        "published_claim_ceiling": { "$ref": "#/$defs/claimLevel" },
        "required_publication_surfaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": { "$ref": "#/$defs/rowEvidence" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dimension_findings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "efficiency_state_evidence",
            "behavior_declaration",
            "hidden_work_suppression",
            "protected_path_preservation",
            "override_policy_awareness",
            "recovery_staging",
            "consumer_propagation"
          ],
          "properties": {
            "efficiency_state_evidence": { "$ref": "#/$defs/dimensionFinding" },
            "behavior_declaration": { "$ref": "#/$defs/dimensionFinding" },
            "hidden_work_suppression": { "$ref": "#/$defs/dimensionFinding" },
            "protected_path_preservation": { "$ref": "#/$defs/dimensionFinding" },
            "override_policy_awareness": { "$ref": "#/$defs/dimensionFinding" },
            "recovery_staging": { "$ref": "#/$defs/dimensionFinding" },
            "consumer_propagation": { "$ref": "#/$defs/dimensionFinding" }
          }
        },
        "fired_narrowing_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrowingReason" }
        },
        "effective_posture": { "$ref": "#/$defs/claimLevel" },
        "certification_state": { "$ref": "#/$defs/certificationState" },
        "promotion_blocker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocks_promotion", "blocker_reasons", "posture_label"],
          "properties": {
            "blocks_promotion": { "type": "boolean" },
            "blocker_reasons": { "type": "array", "items": { "$ref": "#/$defs/narrowingReason" } },
            "posture_label": { "type": "string", "minLength": 1 }
          }
        },
        "release_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_packet_ref",
            "declared_certification_state",
            "declared_effective_posture"
          ],
          "properties": {
            "release_packet_ref": { "type": "string", "minLength": 1 },
            "declared_certification_state": { "$ref": "#/$defs/certificationState" },
            "declared_effective_posture": { "$ref": "#/$defs/claimLevel" }
          }
        }
      }
    }
  }
}
