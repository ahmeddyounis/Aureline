{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/efficiency/m5-efficiency-governance-fixture.schema.json",
  "title": "M5 efficiency-governance recompute fixture record",
  "description": "Self-contained efficiency-governance recompute fixture. It carries one governance row under test (its efficiency state, source-of-change, throttled subsystems, hidden-pane bindings, override posture, recovery state, declared and ceiling postures, required publication surfaces, and inline evidence), an evaluation date, and the expected fired narrowing reasons, narrowed effective posture, certification state, and promotion blocker the engine must reproduce. Each fixture proves one fail-closed narrowing path through the same engine the matrix rows use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "description",
    "as_of",
    "row",
    "expected_fired_reasons",
    "expected_effective_posture",
    "expected_certification_state"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "fixture_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "m5_surface",
        "efficiency_state",
        "source_of_change",
        "throttled_subsystems",
        "hidden_pane_bindings",
        "override_posture",
        "recovery_state",
        "posture",
        "published_claim_ceiling",
        "required_publication_surfaces",
        "evidence"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "m5_surface": { "$ref": "#/$defs/m5Surface" },
        "efficiency_state": { "$ref": "#/$defs/efficiencyState" },
        "source_of_change": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceOfChange" },
          "minItems": 1,
          "uniqueItems": true
        },
        "throttled_subsystems": {
          "type": "array",
          "items": { "$ref": "#/$defs/throttledSubsystem" },
          "uniqueItems": true
        },
        "hidden_pane_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/hiddenPaneBinding" }
        },
        "override_posture": { "$ref": "#/$defs/overridePosture" },
        "recovery_state": { "$ref": "#/$defs/recoveryState" },
        "posture": { "$ref": "#/$defs/claimLevel" },
        "published_claim_ceiling": { "$ref": "#/$defs/claimLevel" },
        "required_publication_surfaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": { "$ref": "#/$defs/rowEvidence" }
      }
    },
    "expected_fired_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/narrowingReason" }
    },
    "expected_effective_posture": { "$ref": "#/$defs/claimLevel" },
    "expected_certification_state": { "$ref": "#/$defs/certificationState" },
    "expected_blocks_promotion": { "type": "boolean" }
  },
  "$defs": {
    "claimLevel": {
      "enum": [
        "undeclared_badge",
        "state_declared",
        "qualified_low_power",
        "certified_low_power"
      ]
    },
    "m5Surface": {
      "enum": [
        "notebooks",
        "previews",
        "docs_browser_panes",
        "traces",
        "pipelines",
        "remote_sessions",
        "support_exports",
        "companion_adjacent"
      ]
    },
    "narrowingReason": {
      "enum": [
        "missing_efficiency_state_evidence",
        "vague_low_power_badge",
        "unqualified_hidden_work_suppression",
        "protected_path_regression_under_pressure",
        "override_not_policy_aware",
        "recovery_not_staged",
        "missing_consumer_propagation"
      ]
    },
    "certificationState": { "enum": ["certified", "narrowed", "quarantined"] },
    "efficiencyState": {
      "enum": [
        "Nominal",
        "EfficiencyAware",
        "ThermalConstrained",
        "ProtectCore",
        "Recovery"
      ]
    },
    "sourceOfChange": {
      "enum": [
        "ac_power",
        "battery",
        "os_battery_saver",
        "user_low_power_mode",
        "low_battery",
        "critical_battery",
        "thermal_pressure",
        "frame_miss_pressure",
        "policy_cap",
        "pressure_cleared"
      ]
    },
    "throttledSubsystem": {
      "enum": [
        "ai_warmup",
        "speculative_prefetch",
        "upload_transfer",
        "non_essential_animation",
        "indexing_refresh",
        "extension_polling",
        "preview_refresh",
        "graph_enrichment",
        "remote_session_helper"
      ]
    },
    "hiddenPaneBehavior": {
      "enum": [
        "render_suppressed",
        "animation_suppressed",
        "polling_paused",
        "correctness_poll_only",
        "fully_quiescent"
      ]
    },
    "visibilityState": {
      "enum": [
        "visible_focused",
        "visible_background",
        "occluded_window",
        "hidden_tab",
        "collapsed_split",
        "detached_offscreen"
      ]
    },
    "overridePosture": {
      "enum": [
        "not_overridable",
        "user_override_session_only",
        "user_override_persistent",
        "policy_blocked",
        "admin_controlled"
      ]
    },
    "recoveryState": {
      "enum": [
        "not_in_recovery",
        "staged_resume",
        "awaiting_user_restore_power",
        "awaiting_reconnect",
        "awaiting_admin_policy",
        "recovered"
      ]
    },
    "hiddenPaneBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility_state", "behaviors"],
      "properties": {
        "visibility_state": { "$ref": "#/$defs/visibilityState" },
        "behaviors": {
          "type": "array",
          "items": { "$ref": "#/$defs/hiddenPaneBehavior" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "rowEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "efficiency_state_evidence_present",
        "declares_behavior_change",
        "binds_hidden_panes",
        "hidden_work_suppression_qualified",
        "hidden_pane_render_violation_count",
        "protected_paths_preserved",
        "override_policy_aware",
        "override_policy_ref",
        "recovery_required",
        "recovery_staged",
        "propagated_surfaces"
      ],
      "properties": {
        "efficiency_state_evidence_present": { "type": "boolean" },
        "declares_behavior_change": { "type": "boolean" },
        "binds_hidden_panes": { "type": "boolean" },
        "hidden_work_suppression_qualified": { "type": "boolean" },
        "hidden_pane_render_violation_count": { "type": "integer", "minimum": 0 },
        "protected_paths_preserved": { "type": "boolean" },
        "override_policy_aware": { "type": "boolean" },
        "override_policy_ref": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "recovery_required": { "type": "boolean" },
        "recovery_staged": { "type": "boolean" },
        "propagated_surfaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
