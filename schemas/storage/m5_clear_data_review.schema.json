{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/storage/m5_clear_data_review.schema.json",
  "title": "Aureline M5 clear-data review sheet",
  "description": "Boundary schema for the m5_clear_data_review_sheet record authored under /fixtures/storage/m5_clear_data_review_cases/ and folded by crates/aureline-support/src/m5_clear_data_review. A review sheet is the operator-facing object shown before any cleanup commits: it enumerates the families and workspaces selected for cleanup, how much disk each reclaims, what is retained or protected and therefore excluded, what a rebuild would cost, whether an export-before-delete path exists first, and which removals are irreversible. The storage_class_id, authority_class, rebuild_cost_class, clear_cache_protection_class, low_disk_ladder_step, pin_source_class, and clear_data_action vocabularies re-export verbatim from /artifacts/storage/m5_artifact_family_storage_matrix.yaml and /artifacts/runtime/storage_classes.yaml; the rebuild_safety_summary_class and offline_rebuild_risk_class vocabularies re-export from the storage inspector. Only the cleanup-flow/trigger/initiator, selection-state, retention-reason, export-before-delete, reversibility, and consent labels are introduced here, and they are bounded explanatory tokens. Adding a value to a closed vocabulary is additive-minor and bumps schema_version; repurposing a value or weakening a protected-class invariant (no generic clear of evidence or user-owned recovery state, export-before-delete on protected classes, no auto-disposal under disk/quota pressure) is breaking and requires a new decision row.",
  "type": "object",
  "$ref": "#/$defs/m5_clear_data_review_sheet",
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "byte_count": {
      "type": "integer",
      "minimum": 0
    },
    "repo_relative_ref": {
      "type": "string",
      "minLength": 1
    },
    "monotonic_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_family_id": {
      "type": "string",
      "enum": [
        "generated_preview",
        "notebook_output",
        "docs_pack",
        "model_pack",
        "template_pack",
        "extension_download",
        "prebuild_layer",
        "profiler_trace",
        "replay_bundle",
        "support_artifact",
        "review_incident_evidence",
        "user_owned_recovery_state"
      ]
    },
    "storage_class_id": {
      "type": "string",
      "enum": [
        "interactive_hot_cache",
        "knowledge_cache",
        "artifact_cache",
        "prebuild_environment_cache",
        "evidence_support_cache",
        "user_owned_recovery_state"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "user_authored_durable_truth",
        "user_owned_recovery_state",
        "admin_or_control_artifact",
        "disposable_derived_cache"
      ]
    },
    "rebuild_cost_class": {
      "type": "string",
      "enum": [
        "authoritative_no_rebuild",
        "high_rebuild_cost",
        "medium_rebuild_cost",
        "low_rebuild_cost"
      ]
    },
    "clear_cache_protection_class": {
      "type": "string",
      "enum": [
        "generic_clear_always_allowed",
        "generic_clear_with_pin_exclusions",
        "protected_requires_class_specific_review",
        "protected_never_generic_clear"
      ]
    },
    "low_disk_ladder_step": {
      "type": "string",
      "enum": [
        "stop_speculative_fetch_and_prefetch",
        "pause_managed_replication_and_pack_refresh",
        "trim_interactive_hot_cache",
        "trim_knowledge_cache_rebuildable",
        "trim_artifact_cache_unpinned",
        "trim_prebuild_environment_unpinned",
        "expire_unpinned_evidence_past_retention",
        "user_owned_recovery_state_only_under_explicit_review"
      ]
    },
    "pin_source_class": {
      "type": "string",
      "enum": [
        "explicit_user_pin",
        "explicit_admin_policy_pin",
        "release_artifact_graph_ref",
        "case_reference_ref",
        "review_pack_ref",
        "offline_bundle_ref",
        "certified_archetype_or_template_ref",
        "policy_bundle_last_known_good_ref",
        "support_export_assembly_ref",
        "retention_window_ref"
      ]
    },
    "clear_data_action_class": {
      "type": "string",
      "enum": [
        "generic_clear_in_bulk",
        "generic_clear_excluding_pins",
        "class_selective_clear",
        "class_specific_review_required",
        "explicit_per_item_review_required",
        "export_before_delete_offered"
      ]
    },
    "rebuild_safety_summary_class": {
      "type": "string",
      "enum": [
        "cheap_to_rebuild_safe_to_remove",
        "expensive_to_rebuild_but_safe",
        "impossible_to_rebuild_offline",
        "dangerous_to_delete_authoritative"
      ]
    },
    "offline_rebuild_risk_class": {
      "type": "string",
      "enum": [
        "safe_to_remove_offline",
        "rebuild_requires_network_resync",
        "rebuild_requires_mirror_or_offline_bundle",
        "rebuild_requires_admin_or_policy_signed_pack",
        "not_rebuildable_after_removal"
      ]
    },
    "cleanup_flow_class": {
      "type": "string",
      "enum": [
        "user_driven_cleanup",
        "admin_driven_cleanup",
        "offboarding_reset"
      ]
    },
    "cleanup_trigger_class": {
      "type": "string",
      "enum": [
        "manual_user_request",
        "low_disk_pressure",
        "managed_quota_pressure",
        "offboarding_or_device_reset",
        "admin_policy_cleanup"
      ]
    },
    "initiator_class": {
      "type": "string",
      "enum": [
        "local_user",
        "admin_or_tenant_policy",
        "offboarding_workflow"
      ]
    },
    "selection_state_class": {
      "type": "string",
      "enum": [
        "selected_for_cleanup",
        "retained_not_selected",
        "excluded_protected_unless_selected",
        "excluded_pinned"
      ]
    },
    "retention_reason_class": {
      "type": "string",
      "enum": [
        "not_selected_by_user",
        "protected_recovery_state_excluded_by_default",
        "protected_evidence_excluded_by_default",
        "pinned_entry_preserved",
        "policy_held_retained",
        "offline_continuity_preserved"
      ]
    },
    "export_before_delete_class": {
      "type": "string",
      "enum": [
        "export_required_before_delete",
        "export_offered_optional",
        "export_not_applicable_disposable"
      ]
    },
    "reversibility_class": {
      "type": "string",
      "enum": [
        "reversible_rebuildable",
        "reversible_from_pinned_or_offline_source",
        "irreversible_authoritative_loss",
        "irreversible_evidence_loss"
      ]
    },
    "consent_state_class": {
      "type": "string",
      "enum": [
        "pending_review",
        "confirmed",
        "cancelled",
        "blocked_by_guardrail"
      ]
    },
    "workspace_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_ref", "label"],
      "properties": {
        "scope_ref": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "export_before_delete_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "export_class", "export_path_label", "export_action_ref"],
      "properties": {
        "family_id": { "$ref": "#/$defs/artifact_family_id" },
        "export_class": { "$ref": "#/$defs/export_before_delete_class" },
        "export_path_label": { "$ref": "#/$defs/non_empty_string" },
        "export_action_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "clear_data_review_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "family_id",
        "storage_class_id",
        "workspace_scope_ref",
        "workspace_label",
        "selection_state",
        "explicit_selection",
        "authority_class",
        "clear_cache_protection_class",
        "clear_data_action",
        "total_bytes",
        "freed_bytes",
        "preserved_bytes",
        "rebuild_cost_class",
        "rebuild_safety_summary_class",
        "offline_rebuild_risk_class",
        "rebuild_disclosure",
        "export_before_delete_class",
        "reversibility_class",
        "low_disk_ladder_step",
        "low_disk_ladder_order",
        "note"
      ],
      "properties": {
        "record_kind": { "const": "m5_clear_data_review_row" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "family_id": { "$ref": "#/$defs/artifact_family_id" },
        "storage_class_id": { "$ref": "#/$defs/storage_class_id" },
        "workspace_scope_ref": { "$ref": "#/$defs/non_empty_string" },
        "workspace_label": { "$ref": "#/$defs/non_empty_string" },
        "selection_state": { "$ref": "#/$defs/selection_state_class" },
        "explicit_selection": { "type": "boolean" },
        "retention_reason": { "$ref": "#/$defs/retention_reason_class" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "clear_cache_protection_class": { "$ref": "#/$defs/clear_cache_protection_class" },
        "clear_data_action": { "$ref": "#/$defs/clear_data_action_class" },
        "total_bytes": { "$ref": "#/$defs/byte_count" },
        "freed_bytes": { "$ref": "#/$defs/byte_count" },
        "preserved_bytes": { "$ref": "#/$defs/byte_count" },
        "preserved_pin_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/pin_source_class" }
        },
        "rebuild_cost_class": { "$ref": "#/$defs/rebuild_cost_class" },
        "rebuild_safety_summary_class": { "$ref": "#/$defs/rebuild_safety_summary_class" },
        "offline_rebuild_risk_class": { "$ref": "#/$defs/offline_rebuild_risk_class" },
        "rebuild_disclosure": { "$ref": "#/$defs/non_empty_string" },
        "export_before_delete_class": { "$ref": "#/$defs/export_before_delete_class" },
        "export_action_ref": { "$ref": "#/$defs/non_empty_string" },
        "reversibility_class": { "$ref": "#/$defs/reversibility_class" },
        "irreversible_consequence": { "$ref": "#/$defs/non_empty_string" },
        "low_disk_ladder_step": { "$ref": "#/$defs/low_disk_ladder_step" },
        "low_disk_ladder_order": { "type": "integer", "minimum": 1, "maximum": 8 },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "$comment": "Protected classes (evidence and user-owned recovery state) must require export-before-delete and never offer a generic clear.",
          "if": {
            "properties": {
              "storage_class_id": {
                "enum": ["evidence_support_cache", "user_owned_recovery_state"]
              }
            }
          },
          "then": {
            "properties": {
              "export_before_delete_class": { "const": "export_required_before_delete" },
              "clear_data_action": {
                "enum": ["class_specific_review_required", "explicit_per_item_review_required"]
              },
              "rebuild_safety_summary_class": { "const": "dangerous_to_delete_authoritative" },
              "reversibility_class": {
                "enum": ["irreversible_authoritative_loss", "irreversible_evidence_loss"]
              }
            },
            "required": ["export_action_ref", "retention_reason"]
          }
        }
      ]
    },
    "m5_clear_data_review_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "sheet_id",
        "emitted_at",
        "title",
        "cleanup_flow_class",
        "cleanup_trigger_class",
        "initiator_class",
        "affected_workspaces",
        "selected_rows",
        "retained_rows",
        "total_selected_reclaimable_bytes",
        "total_protected_preserved_bytes",
        "low_disk_order_disclosed",
        "consent_state",
        "matrix_ref",
        "schema_ref",
        "doc_ref",
        "redaction_class",
        "raw_content_exported",
        "export_safe",
        "note"
      ],
      "properties": {
        "record_kind": { "const": "m5_clear_data_review_sheet" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "sheet_id": { "$ref": "#/$defs/non_empty_string" },
        "emitted_at": { "$ref": "#/$defs/monotonic_timestamp" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "cleanup_flow_class": { "$ref": "#/$defs/cleanup_flow_class" },
        "cleanup_trigger_class": { "$ref": "#/$defs/cleanup_trigger_class" },
        "initiator_class": { "$ref": "#/$defs/initiator_class" },
        "affected_workspaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workspace_scope" }
        },
        "selected_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/clear_data_review_row" }
        },
        "retained_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/clear_data_review_row" }
        },
        "total_selected_reclaimable_bytes": { "$ref": "#/$defs/byte_count" },
        "total_protected_preserved_bytes": { "$ref": "#/$defs/byte_count" },
        "export_before_delete_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_before_delete_option" }
        },
        "irreversible_consequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "guardrail_notices": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "low_disk_order_disclosed": { "type": "boolean" },
        "low_disk_eviction_order": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_family_id" }
        },
        "consent_state": { "$ref": "#/$defs/consent_state_class" },
        "matrix_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "schema_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "doc_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "redaction_class": { "const": "metadata_safe_default" },
        "raw_content_exported": { "const": false },
        "export_safe": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
