{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/storage/m5_storage_certification.schema.json",
  "title": "Aureline M5 storage certification packet",
  "description": "Boundary schema for the m5_storage_certification_packet emitted by aureline-support. The packet certifies each claimed M5 heavy-artifact family on each claimed M5 profile by binding one shared row to storage-class-truth, class-selective clear-data, low-disk / managed-quota pressure, pin/retention, corruption-repair, and export-before-delete proof, then exposing the same certification index to Help/About, service-health, support-export, and release-manifest consumers. The packet is metadata-safe and never embeds raw artifact payloads, raw caches, raw logs, or live credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "doc_ref",
    "schema_ref",
    "artifact_ref",
    "source_spec_refs",
    "supporting_contract_refs",
    "claimed_profiles",
    "certification_rows",
    "downgrade_rules",
    "surface_bindings",
    "export_safe_summary"
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "claimed_profile": {
      "type": "string",
      "enum": [
        "desktop_local_first",
        "hybrid_remote_attach",
        "managed_cloud",
        "self_hosted_sovereign",
        "air_gapped_mirror_only"
      ]
    },
    "artifact_family": {
      "type": "string",
      "enum": [
        "generated_preview",
        "notebook_output",
        "docs_pack",
        "model_pack",
        "template_pack",
        "extension_download",
        "prebuild_layer",
        "profiler_trace",
        "replay_bundle",
        "support_artifact",
        "review_incident_evidence",
        "user_owned_recovery_state"
      ]
    },
    "storage_class_id": {
      "type": "string",
      "enum": [
        "interactive_hot_cache",
        "knowledge_cache",
        "artifact_cache",
        "prebuild_environment_cache",
        "evidence_support_cache",
        "user_owned_recovery_state"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "user_authored_durable_truth",
        "user_owned_recovery_state",
        "admin_or_control_artifact",
        "disposable_derived_cache"
      ]
    },
    "certification_state": {
      "type": "string",
      "enum": [
        "qualified",
        "limited_class_scoped",
        "protected_review_gated_only",
        "blocked_unverified"
      ]
    },
    "pressure_source_posture": {
      "type": "string",
      "enum": [
        "local_disk_only",
        "disk_and_managed_quota",
        "managed_quota_protected_excluded"
      ]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "help_about",
        "service_health",
        "support_export",
        "release_manifest"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "storage_class_truth_stale",
        "clear_data_review_stale",
        "low_disk_pressure_proof_stale",
        "pin_retention_evidence_stale",
        "corruption_repair_drill_stale",
        "export_before_delete_validation_stale",
        "consumer_binding_missing"
      ]
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification_row_id",
        "family_id",
        "family_label",
        "profile",
        "published_state",
        "storage_class_id",
        "authority_class",
        "protected_continuity",
        "pressure_source_posture",
        "storage_class_truth_ref",
        "clear_data_review_ref",
        "low_disk_pressure_ref",
        "pin_retention_ref",
        "corruption_repair_ref",
        "export_before_delete_ref",
        "stale_proof_tokens",
        "downgrade_rule_ids",
        "summary"
      ],
      "properties": {
        "certification_row_id": { "$ref": "#/$defs/non_empty_string" },
        "family_id": { "$ref": "#/$defs/artifact_family" },
        "family_label": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/claimed_profile" },
        "published_state": { "$ref": "#/$defs/certification_state" },
        "storage_class_id": { "$ref": "#/$defs/storage_class_id" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "protected_continuity": { "type": "boolean" },
        "pressure_source_posture": { "$ref": "#/$defs/pressure_source_posture" },
        "storage_class_truth_ref": { "$ref": "#/$defs/non_empty_string" },
        "clear_data_review_ref": { "$ref": "#/$defs/non_empty_string" },
        "low_disk_pressure_ref": { "$ref": "#/$defs/non_empty_string" },
        "pin_retention_ref": { "$ref": "#/$defs/non_empty_string" },
        "corruption_repair_ref": { "$ref": "#/$defs/non_empty_string" },
        "export_before_delete_ref": { "$ref": "#/$defs/non_empty_string" },
        "stale_proof_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "downgrade_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_class",
        "source_state",
        "downgraded_state",
        "required_effect",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_class": { "$ref": "#/$defs/downgrade_trigger" },
        "source_state": { "$ref": "#/$defs/certification_state" },
        "downgraded_state": { "$ref": "#/$defs/certification_state" },
        "required_effect": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "consumer_ref",
        "ingested_packet_id",
        "certification_row_count",
        "required_verbatim_fields",
        "narrow_on_stale_proof",
        "explicit_limited_state_labels_required",
        "summary"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/surface_class" },
        "consumer_ref": { "$ref": "#/$defs/non_empty_string" },
        "ingested_packet_id": { "$ref": "#/$defs/non_empty_string" },
        "certification_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_verbatim_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 1
        },
        "narrow_on_stale_proof": { "type": "boolean" },
        "explicit_limited_state_labels_required": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  },
  "properties": {
    "record_kind": {
      "const": "m5_storage_certification_packet"
    },
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "doc_ref": {
      "const": "docs/storage/m5_storage_certification_contract.md"
    },
    "schema_ref": {
      "const": "schemas/storage/m5_storage_certification.schema.json"
    },
    "artifact_ref": {
      "const": "artifacts/storage/m5_storage_certification.md"
    },
    "source_spec_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 1
    },
    "supporting_contract_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 1
    },
    "claimed_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/claimed_profile" },
      "minItems": 1
    },
    "certification_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/certification_row" },
      "minItems": 1
    },
    "downgrade_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_rule" },
      "minItems": 1
    },
    "surface_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface_binding" },
      "minItems": 1
    },
    "export_safe_summary": {
      "$ref": "#/$defs/non_empty_string"
    }
  }
}
