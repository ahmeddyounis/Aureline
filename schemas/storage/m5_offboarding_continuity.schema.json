{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/storage/m5_offboarding_continuity.schema.json",
  "title": "Aureline M5 offboarding continuity plan",
  "description": "Boundary schema for the m5_offboarding_continuity_plan record authored under /fixtures/storage/m5_offboarding_continuity_cases/ and folded by crates/aureline-support/src/m5_offboarding_continuity. An offboarding continuity plan is the operator-facing object shown before an account offboarding, device reset, workspace wipe, or sign-out cleanup removes anything: per family it states whether the bytes are exportable durable state or non-portable derived data, what offline / mirror / certified-workspace continuity removal would break, which families are pinned by an offline bundle, certified template/archetype, or last-known-good policy bundle and therefore stay protected unless explicitly reviewed away, an export-before-delete posture, and a portability-honesty headline that never implies the user exported everything when only caches were cleared. The artifact_family_id, storage_class_id, authority_class, and pin_source_class vocabularies re-export verbatim from /artifacts/storage/m5_artifact_family_storage_matrix.yaml and /artifacts/runtime/storage_classes.yaml; the offline_rebuild_risk_class, initiator_class, and export_before_delete_class vocabularies re-export from the storage inspector and clear-data review. Only the offboarding-flow, portability, continuity-warning, disposition, and portability-honesty labels are introduced here, and they are bounded explanatory tokens. Adding a value to a closed vocabulary is additive-minor and bumps schema_version; repurposing a value or weakening a protected-class invariant (no silent disposal of evidence, user-owned recovery state, or offline/certified/policy pins; export-before-delete on protected classes; honest portability headline) is breaking and requires a new decision row.",
  "type": "object",
  "$ref": "#/$defs/m5_offboarding_continuity_plan",
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "byte_count": {
      "type": "integer",
      "minimum": 0
    },
    "repo_relative_ref": {
      "type": "string",
      "minLength": 1
    },
    "monotonic_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_family_id": {
      "type": "string",
      "enum": [
        "generated_preview",
        "notebook_output",
        "docs_pack",
        "model_pack",
        "template_pack",
        "extension_download",
        "prebuild_layer",
        "profiler_trace",
        "replay_bundle",
        "support_artifact",
        "review_incident_evidence",
        "user_owned_recovery_state"
      ]
    },
    "storage_class_id": {
      "type": "string",
      "enum": [
        "interactive_hot_cache",
        "knowledge_cache",
        "artifact_cache",
        "prebuild_environment_cache",
        "evidence_support_cache",
        "user_owned_recovery_state"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "user_authored_durable_truth",
        "user_owned_recovery_state",
        "admin_or_control_artifact",
        "disposable_derived_cache"
      ]
    },
    "pin_source_class": {
      "type": "string",
      "enum": [
        "explicit_user_pin",
        "explicit_admin_policy_pin",
        "release_artifact_graph_ref",
        "case_reference_ref",
        "review_pack_ref",
        "offline_bundle_ref",
        "certified_archetype_or_template_ref",
        "policy_bundle_last_known_good_ref",
        "support_export_assembly_ref",
        "retention_window_ref"
      ]
    },
    "offline_rebuild_risk_class": {
      "type": "string",
      "enum": [
        "safe_to_remove_offline",
        "rebuild_requires_network_resync",
        "rebuild_requires_mirror_or_offline_bundle",
        "rebuild_requires_admin_or_policy_signed_pack",
        "not_rebuildable_after_removal"
      ]
    },
    "export_before_delete_class": {
      "type": "string",
      "enum": [
        "export_required_before_delete",
        "export_offered_optional",
        "export_not_applicable_disposable"
      ]
    },
    "initiator_class": {
      "type": "string",
      "enum": [
        "local_user",
        "admin_or_tenant_policy",
        "offboarding_workflow"
      ]
    },
    "offboarding_flow_class": {
      "type": "string",
      "enum": [
        "account_offboarding",
        "device_reset",
        "workspace_wipe",
        "sign_out_cleanup"
      ]
    },
    "portability_class": {
      "type": "string",
      "enum": [
        "exportable_durable_state",
        "captured_evidence_export_to_retain",
        "rebuildable_from_pinned_or_offline_source",
        "non_portable_derived_cache"
      ]
    },
    "continuity_warning_class": {
      "type": "string",
      "enum": [
        "no_continuity_impact",
        "offline_readiness_lost",
        "mirror_continuity_broken",
        "certified_workspace_readiness_broken",
        "policy_bundle_continuity_lost",
        "evidence_continuity_lost",
        "recovery_state_continuity_lost"
      ]
    },
    "offboarding_disposition_class": {
      "type": "string",
      "enum": [
        "dispose_rebuildable",
        "export_then_dispose",
        "retained_protected_continuity",
        "retained_for_offline_continuity",
        "retained_not_selected"
      ]
    },
    "portability_honesty_class": {
      "type": "string",
      "enum": [
        "nothing_disposed_all_retained",
        "caches_only_removed_durable_retained",
        "durable_state_exported_before_removal"
      ]
    },
    "workspace_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_ref", "label"],
      "properties": {
        "scope_ref": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "export_before_delete_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "export_class", "export_path_label", "export_action_ref"],
      "properties": {
        "family_id": { "$ref": "#/$defs/artifact_family_id" },
        "export_class": { "$ref": "#/$defs/export_before_delete_class" },
        "export_path_label": { "$ref": "#/$defs/non_empty_string" },
        "export_action_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "offboarding_continuity_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "family_id",
        "storage_class_id",
        "workspace_scope_ref",
        "workspace_label",
        "authority_class",
        "portability_class",
        "continuity_warnings",
        "offline_rebuild_risk_class",
        "disposition",
        "reviewed_away",
        "protected_continuity",
        "continuity_pinned",
        "continuity_preserved",
        "export_before_delete_class",
        "total_bytes",
        "disposed_bytes",
        "retained_bytes",
        "continuity_note",
        "note"
      ],
      "properties": {
        "record_kind": { "const": "m5_offboarding_continuity_row" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "family_id": { "$ref": "#/$defs/artifact_family_id" },
        "storage_class_id": { "$ref": "#/$defs/storage_class_id" },
        "workspace_scope_ref": { "$ref": "#/$defs/non_empty_string" },
        "workspace_label": { "$ref": "#/$defs/non_empty_string" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "portability_class": { "$ref": "#/$defs/portability_class" },
        "continuity_warnings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/continuity_warning_class" }
        },
        "offline_rebuild_risk_class": { "$ref": "#/$defs/offline_rebuild_risk_class" },
        "disposition": { "$ref": "#/$defs/offboarding_disposition_class" },
        "reviewed_away": { "type": "boolean" },
        "protected_continuity": { "type": "boolean" },
        "continuity_pinned": { "type": "boolean" },
        "continuity_preserved": { "type": "boolean" },
        "pin_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/pin_source_class" }
        },
        "export_before_delete_class": { "$ref": "#/$defs/export_before_delete_class" },
        "export_action_ref": { "$ref": "#/$defs/non_empty_string" },
        "total_bytes": { "$ref": "#/$defs/byte_count" },
        "disposed_bytes": { "$ref": "#/$defs/byte_count" },
        "retained_bytes": { "$ref": "#/$defs/byte_count" },
        "continuity_note": { "$ref": "#/$defs/non_empty_string" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "$comment": "Protected classes (evidence and user-owned recovery state) must require export-before-delete and may only be disposed through an explicit review.",
          "if": {
            "properties": {
              "storage_class_id": {
                "enum": ["evidence_support_cache", "user_owned_recovery_state"]
              }
            }
          },
          "then": {
            "properties": {
              "export_before_delete_class": { "const": "export_required_before_delete" },
              "protected_continuity": { "const": true },
              "disposition": {
                "enum": [
                  "export_then_dispose",
                  "retained_protected_continuity"
                ]
              }
            },
            "required": ["export_action_ref"]
          }
        },
        {
          "$comment": "A disposed disposition removes all bytes; a reviewed-away row is always disposed.",
          "if": {
            "properties": { "disposition": { "const": "dispose_rebuildable" } }
          },
          "then": {
            "properties": {
              "protected_continuity": { "const": false },
              "continuity_pinned": { "const": false },
              "reviewed_away": { "const": false },
              "portability_class": { "const": "non_portable_derived_cache" },
              "continuity_preserved": { "const": false },
              "retained_bytes": { "const": 0 }
            }
          }
        },
        {
          "$comment": "Export-then-dispose only applies to protected or continuity-pinned families the operator explicitly reviewed away.",
          "if": {
            "properties": { "disposition": { "const": "export_then_dispose" } }
          },
          "then": {
            "properties": {
              "reviewed_away": { "const": true },
              "continuity_preserved": { "const": false },
              "retained_bytes": { "const": 0 },
              "export_before_delete_class": {
                "enum": ["export_required_before_delete", "export_offered_optional"]
              }
            }
          }
        }
      ]
    },
    "m5_offboarding_continuity_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "plan_id",
        "emitted_at",
        "title",
        "offboarding_flow_class",
        "initiator_class",
        "affected_workspaces",
        "disposed_rows",
        "retained_rows",
        "total_disposed_bytes",
        "total_retained_bytes",
        "portability_honesty_class",
        "portability_summary",
        "open_inspector_action_ref",
        "open_clear_data_review_action_ref",
        "matrix_ref",
        "schema_ref",
        "doc_ref",
        "redaction_class",
        "raw_content_exported",
        "export_safe",
        "note"
      ],
      "properties": {
        "record_kind": { "const": "m5_offboarding_continuity_plan" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "plan_id": { "$ref": "#/$defs/non_empty_string" },
        "emitted_at": { "$ref": "#/$defs/monotonic_timestamp" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "offboarding_flow_class": { "$ref": "#/$defs/offboarding_flow_class" },
        "initiator_class": { "$ref": "#/$defs/initiator_class" },
        "affected_workspaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workspace_scope" }
        },
        "disposed_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/offboarding_continuity_row" }
        },
        "retained_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/offboarding_continuity_row" }
        },
        "total_disposed_bytes": { "$ref": "#/$defs/byte_count" },
        "total_retained_bytes": { "$ref": "#/$defs/byte_count" },
        "continuity_warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/continuity_warning_class" }
        },
        "export_before_delete_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_before_delete_option" }
        },
        "protected_families_retained": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_family_id" }
        },
        "guardrail_notices": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "portability_honesty_class": { "$ref": "#/$defs/portability_honesty_class" },
        "portability_summary": { "$ref": "#/$defs/non_empty_string" },
        "open_inspector_action_ref": {
          "const": "action.storage.open_inspector"
        },
        "open_clear_data_review_action_ref": {
          "const": "action.storage.open_clear_data_review"
        },
        "matrix_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "schema_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "doc_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "redaction_class": { "const": "metadata_safe_default" },
        "raw_content_exported": { "const": false },
        "export_safe": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
