{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/storage/m5_artifact_family_storage_matrix.schema.json",
  "title": "Aureline M5 artifact-family storage-class matrix record",
  "description": "Boundary schema for the m5_artifact_family_storage_matrix record frozen in docs/m5/freeze-the-m5-storage-class-pin-source-clear-data-and-low-disk-ordering-matrix-for-new-artifact-families.md and authored at /artifacts/storage/m5_artifact_family_storage_matrix.yaml. Each row maps one M5 heavy-artifact family to a frozen storage_class_id plus its authority_class, rebuild_cost_class, gc_policy_class, default_retention_class, clear_cache_protection_class, low_disk_ladder_step, admissible pin_source_classes, allowed clear-data actions, export-before-delete posture, and protected-continuity flag. The storage_class_id, authority_class, rebuild_cost_class, gc_policy_class, pin_source_class, clear_cache_protection_class, and low_disk_ladder_step vocabularies re-export verbatim from /artifacts/runtime/storage_classes.yaml; this schema mints no new storage primitive. The default_retention_class and clear_data_action_class vocabularies are the only sets introduced here, and they are bounded explanatory labels. Every row's declared posture MUST be admissible under the canonical runtime row for its storage_class_id; surfaces (storage inspector, workspace-storage detail, clear-data review, low-disk banner, pin manager, cleanup-history lane, offboarding/reset, support export) project these rows rather than mint a parallel cleanup vocabulary. Adding a value to a closed vocabulary is additive-minor and bumps schema_version; repurposing a value, weakening a protected-class invariant, or relaxing the disposable / rebuildable / authoritative posture distinctions is breaking and requires a new decision row.",
  "type": "object",
  "$ref": "#/$defs/m5_artifact_family_storage_matrix",
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "reviewable_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "reviewable_sentence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "repo_relative_ref": {
      "type": "string",
      "minLength": 1
    },
    "monotonic_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_family_id": {
      "type": "string",
      "enum": [
        "generated_preview",
        "notebook_output",
        "docs_pack",
        "model_pack",
        "template_pack",
        "extension_download",
        "prebuild_layer",
        "profiler_trace",
        "replay_bundle",
        "support_artifact",
        "review_incident_evidence",
        "user_owned_recovery_state"
      ]
    },
    "storage_class_id": {
      "type": "string",
      "enum": [
        "interactive_hot_cache",
        "knowledge_cache",
        "artifact_cache",
        "prebuild_environment_cache",
        "evidence_support_cache",
        "user_owned_recovery_state"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "user_authored_durable_truth",
        "user_owned_recovery_state",
        "admin_or_control_artifact",
        "disposable_derived_cache"
      ]
    },
    "rebuild_cost_class": {
      "type": "string",
      "enum": [
        "authoritative_no_rebuild",
        "high_rebuild_cost",
        "medium_rebuild_cost",
        "low_rebuild_cost"
      ]
    },
    "gc_policy_class": {
      "type": "string",
      "enum": [
        "never_gc_authoritative",
        "gc_on_version_replace",
        "gc_on_pressure_if_unpinned",
        "gc_on_case_close",
        "gc_on_explicit_reset_only"
      ]
    },
    "clear_cache_protection_class": {
      "type": "string",
      "enum": [
        "generic_clear_always_allowed",
        "generic_clear_with_pin_exclusions",
        "protected_requires_class_specific_review",
        "protected_never_generic_clear"
      ]
    },
    "low_disk_ladder_step": {
      "type": "string",
      "enum": [
        "stop_speculative_fetch_and_prefetch",
        "pause_managed_replication_and_pack_refresh",
        "trim_interactive_hot_cache",
        "trim_knowledge_cache_rebuildable",
        "trim_artifact_cache_unpinned",
        "trim_prebuild_environment_unpinned",
        "expire_unpinned_evidence_past_retention",
        "user_owned_recovery_state_only_under_explicit_review"
      ]
    },
    "pin_source_class": {
      "type": "string",
      "enum": [
        "explicit_user_pin",
        "explicit_admin_policy_pin",
        "release_artifact_graph_ref",
        "case_reference_ref",
        "review_pack_ref",
        "offline_bundle_ref",
        "certified_archetype_or_template_ref",
        "policy_bundle_last_known_good_ref",
        "support_export_assembly_ref",
        "retention_window_ref"
      ]
    },
    "default_retention_class": {
      "type": "string",
      "description": "Bounded explanatory label for the family's default retention posture. Introduced by this matrix; not a runtime storage primitive.",
      "enum": [
        "evict_on_session_end",
        "evict_under_pressure_if_unpinned",
        "retain_until_version_replace",
        "retain_for_policy_window",
        "retain_until_explicit_user_reset"
      ]
    },
    "clear_data_action_class": {
      "type": "string",
      "description": "Bounded explanatory label for an allowed clear-data action on the family. Introduced by this matrix; class-selective and previewable by construction.",
      "enum": [
        "generic_clear_in_bulk",
        "generic_clear_excluding_pins",
        "class_selective_clear",
        "class_specific_review_required",
        "explicit_per_item_review_required",
        "export_before_delete_offered"
      ]
    },
    "m5_artifact_family_storage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "family_id",
        "label",
        "summary",
        "storage_class_id",
        "authority_class",
        "rebuild_cost_class",
        "gc_policy_class",
        "default_retention_class",
        "clear_cache_protection_class",
        "low_disk_ladder_step",
        "pin_source_classes",
        "allowed_clear_data_actions",
        "export_before_delete_required",
        "protected_continuity",
        "schema_ref",
        "doc_ref"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "record_kind": { "type": "string", "const": "m5_artifact_family_storage_row" },
        "family_id": { "$ref": "#/$defs/artifact_family_id" },
        "label": { "$ref": "#/$defs/reviewable_label" },
        "summary": { "$ref": "#/$defs/reviewable_sentence" },
        "storage_class_id": { "$ref": "#/$defs/storage_class_id" },
        "authority_class": { "$ref": "#/$defs/authority_class" },
        "rebuild_cost_class": { "$ref": "#/$defs/rebuild_cost_class" },
        "gc_policy_class": { "$ref": "#/$defs/gc_policy_class" },
        "default_retention_class": { "$ref": "#/$defs/default_retention_class" },
        "clear_cache_protection_class": { "$ref": "#/$defs/clear_cache_protection_class" },
        "low_disk_ladder_step": { "$ref": "#/$defs/low_disk_ladder_step" },
        "pin_source_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/pin_source_class" },
          "uniqueItems": true
        },
        "allowed_clear_data_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/clear_data_action_class" },
          "uniqueItems": true
        },
        "export_before_delete_required": { "type": "boolean" },
        "protected_continuity": { "type": "boolean" },
        "schema_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "doc_ref": { "$ref": "#/$defs/repo_relative_ref" }
      },
      "allOf": [
        {
          "description": "Protected classes (evidence and user-owned recovery) carry protected_continuity and require export-before-delete; a generic bulk clear is never an allowed action.",
          "if": {
            "properties": {
              "storage_class_id": {
                "enum": ["evidence_support_cache", "user_owned_recovery_state"]
              }
            },
            "required": ["storage_class_id"]
          },
          "then": {
            "properties": {
              "protected_continuity": { "const": true },
              "export_before_delete_required": { "const": true },
              "allowed_clear_data_actions": {
                "not": {
                  "contains": {
                    "enum": ["generic_clear_in_bulk", "generic_clear_excluding_pins", "class_selective_clear"]
                  }
                }
              }
            }
          }
        },
        {
          "description": "Disposable / rebuildable classes are not protected continuity and do not force export-before-delete.",
          "if": {
            "properties": {
              "storage_class_id": {
                "enum": [
                  "interactive_hot_cache",
                  "knowledge_cache",
                  "artifact_cache",
                  "prebuild_environment_cache"
                ]
              }
            },
            "required": ["storage_class_id"]
          },
          "then": {
            "properties": {
              "protected_continuity": { "const": false },
              "export_before_delete_required": { "const": false }
            }
          }
        },
        {
          "description": "user_owned_recovery_state class binds matching authority and the never-generic-clear protection.",
          "if": {
            "properties": { "storage_class_id": { "const": "user_owned_recovery_state" } },
            "required": ["storage_class_id"]
          },
          "then": {
            "properties": {
              "authority_class": { "const": "user_owned_recovery_state" },
              "rebuild_cost_class": { "const": "authoritative_no_rebuild" },
              "clear_cache_protection_class": { "const": "protected_never_generic_clear" },
              "low_disk_ladder_step": { "const": "user_owned_recovery_state_only_under_explicit_review" }
            }
          }
        },
        {
          "description": "evidence_support_cache class requires the class-specific-review protection.",
          "if": {
            "properties": { "storage_class_id": { "const": "evidence_support_cache" } },
            "required": ["storage_class_id"]
          },
          "then": {
            "properties": {
              "clear_cache_protection_class": { "const": "protected_requires_class_specific_review" },
              "low_disk_ladder_step": { "const": "expire_unpinned_evidence_past_retention" }
            }
          }
        },
        {
          "description": "generic_clear_always_allowed admits no pin sources (no entry survives a generic clear).",
          "if": {
            "properties": { "clear_cache_protection_class": { "const": "generic_clear_always_allowed" } },
            "required": ["clear_cache_protection_class"]
          },
          "then": {
            "properties": {
              "pin_source_classes": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    },
    "m5_artifact_family_storage_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "matrix_id",
        "title",
        "schema_ref",
        "doc_ref",
        "runtime_storage_classes_ref",
        "emitted_at",
        "rows"
      ],
      "properties": {
        "$schema": { "type": "string" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "record_kind": { "type": "string", "const": "m5_artifact_family_storage_matrix" },
        "matrix_id": { "$ref": "#/$defs/reviewable_label" },
        "title": { "$ref": "#/$defs/reviewable_label" },
        "schema_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "doc_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "runtime_storage_classes_ref": { "$ref": "#/$defs/repo_relative_ref" },
        "emitted_at": { "$ref": "#/$defs/monotonic_timestamp" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/m5_artifact_family_storage_row" }
        }
      }
    }
  }
}
