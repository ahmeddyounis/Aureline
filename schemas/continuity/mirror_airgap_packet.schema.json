      "properties": {
        "record_kind": {
          "type": "string",
          "const": "mirror_airgap_continuity_outcome_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "claim_row_id": { "$ref": "#/$defs/opaque_id" },
        "connectivity_posture_token": { "$ref": "#/$defs/connectivity_posture" },
        "qualification_token": { "$ref": "#/$defs/qualification" },
        "narrowed": { "type": "boolean" },
        "claim_withheld": { "type": "boolean" },
        "trust_root_posture_token": { "$ref": "#/$defs/trust_root_posture" },
