{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/continuity/mirror_airgap_packet.schema.json",
  "title": "Aureline mirror-only and air-gapped continuity packet",
  "description": "Canonical schema for the mirror-only and air-gapped continuity lane that turns offline-leaning continuity into first-class evidence instead of assuming a public-network rescue path. Each packet states a connectivity posture (mirror-only, air-gapped, self-hosted-restricted, or local-only), the trust-root continuity backing the boundary (posture and how it renews offline), the mirror or offline-bundle freshness, the offline import and export paths, where advisory and revocation data come from, and whether public fallback is prohibited, unavailable, or policy-gated. A descriptor is projected identically onto the release-center, shiproom, support-center, partner-qualification, and public claim-manifest surfaces. A typed offline-continuity registry reports, per claimed offline row, whether a current packet backs the claim. A mirror-only or air-gapped row that silently falls back to public endpoints, sources advisories from a live public fetch, or depends on a trust root that needs a public reissue fails closed. The packet is metadata-only: it carries closed-vocabulary tokens, export-safe plain-language labels, UTC timestamps, and opaque refs. Raw mirror bytes, raw provider payloads, raw endpoint hostnames, raw trust-root key material, and secret bodies never appear. The root accepts a page record, a summary record, a registry record, or a support-export record, discriminated by record_kind.",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/registry" },
    { "$ref": "#/$defs/support_export" }
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "continuity:m5_mirror_airgap_continuity_packets:v1"
    },
    "profile_class": {
      "type": "string",
      "enum": ["managed", "self_hosted", "sovereign", "local_only"]
    },
    "connectivity_posture": {
      "type": "string",
      "enum": [
        "mirror_only",
        "air_gapped",
        "self_hosted_restricted",
        "local_only"
      ]
    },
    "trust_root_posture": {
      "type": "string",
      "enum": [
        "os_store_trust_root",
        "vendor_managed_trust_root",
        "customer_managed_trust_root",
        "offline_trust_root",
        "hybrid_trust_root",
        "trust_root_undisclosed",
        "not_applicable"
      ]
    },
    "trust_root_renewal": {
      "type": "string",
      "enum": [
        "offline_signed_rotation",
        "mirror_replicated_rotation",
        "customer_operated_rotation",
        "public_reissue_required",
        "undisclosed",
        "not_applicable"
      ]
    },
    "mirror_freshness": {
      "type": "string",
      "enum": [
        "fresh_within_window",
        "stale_within_grace",
        "stale_needs_sync",
        "never_synced",
        "not_applicable"
      ]
    },
    "offline_exchange": {
      "type": "string",
      "enum": [
        "signed_offline_bundle",
        "physical_media_transfer",
        "mirror_pull_push",
        "no_offline_path",
        "undisclosed",
        "not_applicable"
      ]
    },
    "advisory_revocation_source": {
      "type": "string",
      "enum": [
        "offline_bundle",
        "mirror_replicated",
        "local_cache_only",
        "live_public_fetch",
        "undisclosed",
        "not_applicable"
      ]
    },
    "public_fallback_policy": {
      "type": "string",
      "enum": [
        "prohibited",
        "unavailable",
        "policy_gated",
        "silent_public_fallback",
        "undisclosed",
        "not_applicable"
      ]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "release_center",
        "shiproom",
        "support_center",
        "partner_qualification",
        "public_claim_manifest"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "not_narrowed",
        "silent_public_fallback",
        "advisory_implies_live_public_fetch",
        "trust_root_breaks_offline",
        "mirror_never_synced",
        "mirror_freshness_stale",
        "trust_root_continuity_undeclared",
        "offline_exchange_undisclosed",
        "advisory_revocation_undisclosed",
        "public_fallback_undisclosed",
        "profile_posture_mismatch",
        "packet_vocabulary_drift",
        "surface_reuse_incomplete",
        "packet_evidence_missing"
      ]
    },
    "coverage_class": {
      "type": "string",
      "enum": [
        "current_packet",
        "stale_packet_needs_refresh",
        "packet_withheld",
        "no_packet"
      ]
    },
    "trust_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posture",
        "posture_token",
        "renewal",
        "renewal_token",
        "continuity_note"
      ],
      "properties": {
        "posture": { "$ref": "#/$defs/trust_root_posture" },
        "posture_token": { "$ref": "#/$defs/trust_root_posture" },
        "renewal": { "$ref": "#/$defs/trust_root_renewal" },
        "renewal_token": { "$ref": "#/$defs/trust_root_renewal" },
        "continuity_note": { "$ref": "#/$defs/label" }
      }
    },
    "mirror_freshness_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "state_token",
        "last_synced_at",
        "freshness_expires_at",
        "mirror_ref"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/mirror_freshness" },
        "state_token": { "$ref": "#/$defs/mirror_freshness" },
        "last_synced_at": { "$ref": "#/$defs/label" },
        "freshness_expires_at": { "$ref": "#/$defs/label" },
        "mirror_ref": { "$ref": "#/$defs/label" }
      }
    },
    "packet_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "claim_row_id",
        "surface_label",
        "profile_class",
        "profile_class_token",
        "connectivity_posture",
        "connectivity_posture_token",
        "backs_offline_claim",
        "trust_root",
        "mirror_freshness",
        "offline_import",
        "offline_import_token",
        "offline_export",
        "offline_export_token",
        "offline_exchange_note",
        "advisory_revocation_source",
        "advisory_revocation_source_token",
        "advisory_revocation_note",
        "public_fallback_policy",
        "public_fallback_policy_token",
        "public_fallback_note",
        "projected_surfaces"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "claim_row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "profile_class": { "$ref": "#/$defs/profile_class" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "connectivity_posture": { "$ref": "#/$defs/connectivity_posture" },
        "connectivity_posture_token": { "$ref": "#/$defs/connectivity_posture" },
        "backs_offline_claim": { "type": "boolean" },
        "trust_root": { "$ref": "#/$defs/trust_root" },
        "mirror_freshness": { "$ref": "#/$defs/mirror_freshness_record" },
        "offline_import": { "$ref": "#/$defs/offline_exchange" },
        "offline_import_token": { "$ref": "#/$defs/offline_exchange" },
        "offline_export": { "$ref": "#/$defs/offline_exchange" },
        "offline_export_token": { "$ref": "#/$defs/offline_exchange" },
        "offline_exchange_note": { "$ref": "#/$defs/label" },
        "advisory_revocation_source": { "$ref": "#/$defs/advisory_revocation_source" },
        "advisory_revocation_source_token": { "$ref": "#/$defs/advisory_revocation_source" },
        "advisory_revocation_note": { "$ref": "#/$defs/label" },
        "public_fallback_policy": { "$ref": "#/$defs/public_fallback_policy" },
        "public_fallback_policy_token": { "$ref": "#/$defs/public_fallback_policy" },
        "public_fallback_note": { "$ref": "#/$defs/label" },
        "projected_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_class" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_label", "packets", "expected_claim_row_ids"],
      "properties": {
        "input_label": { "$ref": "#/$defs/label" },
        "packets": {
          "type": "array",
          "items": { "$ref": "#/$defs/packet_entry" }
        },
        "expected_claim_row_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/opaque_id" }
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor_id",
        "packet_id",
        "claim_row_id",
        "surface_label",
        "profile_class_token",
        "profile_class_plain",
        "connectivity_posture_token",
        "connectivity_posture_plain",
        "trust_root_posture_token",
        "trust_root_renewal_token",
        "trust_root_survives_offline",
        "mirror_freshness_token",
        "mirror_fresh",
        "offline_import_token",
        "offline_export_token",
        "advisory_revocation_source_token",
        "public_fallback_policy_token",
        "public_fallback_governed",
        "trust_root_line",
        "mirror_freshness_line",
        "offline_exchange_line",
        "advisory_line",
        "public_fallback_line"
