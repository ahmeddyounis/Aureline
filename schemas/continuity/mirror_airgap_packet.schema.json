      "properties": {
        "record_kind": {
          "type": "string",
          "const": "mirror_airgap_continuity_descriptor_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "claim_row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "profile_class_plain": { "$ref": "#/$defs/label" },
        "connectivity_posture_token": { "$ref": "#/$defs/connectivity_posture" },
        "connectivity_posture_plain": { "$ref": "#/$defs/label" },
        "trust_root_posture_token": { "$ref": "#/$defs/trust_root_posture" },
        "trust_root_renewal_token": { "$ref": "#/$defs/trust_root_renewal" },
        "trust_root_survives_offline": { "type": "boolean" },
        "mirror_freshness_token": { "$ref": "#/$defs/mirror_freshness" },
        "mirror_fresh": { "type": "boolean" },
        "offline_import_token": { "$ref": "#/$defs/offline_exchange" },
        "offline_export_token": { "$ref": "#/$defs/offline_exchange" },
        "advisory_revocation_source_token": { "$ref": "#/$defs/advisory_revocation_source" },
        "public_fallback_policy_token": { "$ref": "#/$defs/public_fallback_policy" },
        "public_fallback_governed": { "type": "boolean" },
        "trust_root_line": { "$ref": "#/$defs/label" },
        "mirror_freshness_line": { "$ref": "#/$defs/label" },
        "offline_exchange_line": { "$ref": "#/$defs/label" },
