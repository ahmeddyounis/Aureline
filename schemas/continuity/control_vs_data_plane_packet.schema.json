{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/continuity/control_vs_data_plane_packet.schema.json",
  "title": "Aureline control-plane-versus-data-plane outage taxonomy packet",
  "description": "Canonical schema for the outage taxonomy that describes optional-service impairment by lane (identity/policy, registry/updates/docs, collaboration, remote control plane, AI gateway, telemetry/support) without conflating it with local editing failure. Each packet carries a degraded-state descriptor (optional-service family, impaired plane across control plane / managed data plane / both, severity, narrower fallback, typed degraded state, and the local-core continuity that survives the outage), projected identically onto desktop, CLI/headless explain, service-health, support-center export, shiproom, and docs/public-truth surfaces. An optional-service outage that flips a global IDE-down state or marks local editing/save/search/version control unavailable fails closed: its claim is withdrawn and the typed degraded state is recorded as a misclaim. The packet is metadata-only: it carries closed-vocabulary tokens, export-safe plain-language labels, and opaque refs. Raw provider payloads, raw incident bodies, hostnames, and secret material never appear. The root accepts a page record, a summary record, or a support-export record, discriminated by record_kind.",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/support_export" }
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "continuity:m5_control_plane_vs_data_plane_outage:v1"
    },
    "family": {
      "type": "string",
      "enum": [
        "identity_policy",
        "registry_updates_docs",
        "collaboration",
        "remote_control_plane",
        "ai_gateway",
        "telemetry_support"
      ]
    },
    "impaired_plane": {
      "type": "string",
      "enum": [
        "control_plane_impairment",
        "data_plane_impairment",
        "both_planes"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["operational", "degraded", "unavailable", "recovering"]
    },
    "fallback": {
      "type": "string",
      "enum": [
        "none_needed",
        "queue_and_reconcile",
        "serve_from_cache",
        "local_model_or_manual_fallback",
        "cached_policy_read_only",
        "buffer_locally_and_ship_later",
        "fail_closed_local_core_only",
        "not_declared"
      ]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["current", "stale_within_grace", "stale_needs_refresh", "missing"]
    },
    "degraded_state": {
      "type": "string",
      "enum": [
        "operational",
        "control_plane_impaired_local_core_preserved",
        "managed_data_plane_impaired_local_core_preserved",
        "both_managed_planes_impaired_local_core_preserved",
        "local_core_conflated_misclaim"
      ]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "desktop",
        "cli_headless_explain",
        "service_health",
        "support_export",
        "shiproom",
        "docs_public_truth"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "not_narrowed",
        "local_core_conflated",
        "fallback_undeclared",
        "operational_state_inconsistent",
        "outage_evidence_missing",
        "outage_evidence_stale",
        "outage_vocabulary_drift",
        "surface_reuse_incomplete",
        "plane_distinction_missing",
        "family_coverage_incomplete"
      ]
    },
    "local_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editing_available",
        "save_available",
        "search_available",
        "version_control_available"
      ],
      "properties": {
        "editing_available": { "type": "boolean" },
        "save_available": { "type": "boolean" },
        "search_available": { "type": "boolean" },
        "version_control_available": { "type": "boolean" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "family",
        "family_token",
        "lane_label",
        "impaired_plane",
        "impaired_plane_token",
        "severity",
        "severity_token",
        "fallback",
        "fallback_token",
        "local_core",
        "sets_global_ide_down",
        "evidence_state",
        "evidence_state_token",
        "outage_evidence_ref",
        "impairment_note",
        "projected_surfaces"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "family": { "$ref": "#/$defs/family" },
        "family_token": { "$ref": "#/$defs/family" },
        "lane_label": { "$ref": "#/$defs/label" },
        "impaired_plane": { "$ref": "#/$defs/impaired_plane" },
        "impaired_plane_token": { "$ref": "#/$defs/impaired_plane" },
        "severity": { "$ref": "#/$defs/severity" },
        "severity_token": { "$ref": "#/$defs/severity" },
        "fallback": { "$ref": "#/$defs/fallback" },
        "fallback_token": { "$ref": "#/$defs/fallback" },
        "local_core": { "$ref": "#/$defs/local_core" },
        "sets_global_ide_down": { "type": "boolean" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "evidence_state_token": { "$ref": "#/$defs/evidence_state" },
        "outage_evidence_ref": { "$ref": "#/$defs/label" },
        "impairment_note": { "$ref": "#/$defs/label" },
        "projected_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_class" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_label", "entries"],
      "properties": {
        "input_label": { "$ref": "#/$defs/label" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor_id",
        "packet_id",
        "family_token",
        "family_plain",
        "lane_label",
        "impaired_plane_token",
        "impaired_plane_plain",
        "severity_token",
        "severity_plain",
        "fallback_token",
        "fallback_plain",
        "degraded_state_token",
        "degraded_state_plain",
        "local_editing_available",
        "local_save_available",
        "local_search_available",
        "local_version_control_available",
        "local_core_preserved",
        "sets_global_ide_down",
        "conflates_local_core",
        "outage_summary_line",
        "local_core_line",
        "impairment_note"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "service_outage_descriptor_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "family_token": { "$ref": "#/$defs/family" },
        "family_plain": { "$ref": "#/$defs/label" },
        "lane_label": { "$ref": "#/$defs/label" },
        "impaired_plane_token": { "$ref": "#/$defs/impaired_plane" },
        "impaired_plane_plain": { "$ref": "#/$defs/label" },
        "severity_token": { "$ref": "#/$defs/severity" },
        "severity_plain": { "$ref": "#/$defs/label" },
        "fallback_token": { "$ref": "#/$defs/fallback" },
        "fallback_plain": { "$ref": "#/$defs/label" },
        "degraded_state_token": { "$ref": "#/$defs/degraded_state" },
        "degraded_state_plain": { "$ref": "#/$defs/label" },
        "local_editing_available": { "type": "boolean" },
        "local_save_available": { "type": "boolean" },
        "local_search_available": { "type": "boolean" },
        "local_version_control_available": { "type": "boolean" },
        "local_core_preserved": { "type": "boolean" },
        "sets_global_ide_down": { "type": "boolean" },
        "conflates_local_core": { "type": "boolean" },
        "outage_summary_line": { "$ref": "#/$defs/label" },
        "local_core_line": { "$ref": "#/$defs/label" },
        "impairment_note": { "$ref": "#/$defs/label" }
      }
    },
    "surface_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "surface",
        "surface_token",
        "packet_id",
        "descriptor_id",
        "outage_summary_line",
        "local_core_line"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "outage_surface_projection_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "surface": { "$ref": "#/$defs/surface_class" },
        "surface_token": { "$ref": "#/$defs/surface_class" },
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "outage_summary_line": { "$ref": "#/$defs/label" },
        "local_core_line": { "$ref": "#/$defs/label" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "packet_id",
        "family_token",
        "qualification_token",
        "narrowed",
        "claim_withheld",
        "conflates_local_core",
        "local_core_preserved",
        "degraded_state_token",
        "narrow_reason_tokens"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "service_outage_outcome_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "packet_id": { "$ref": "#/$defs/opaque_id" },
        "family_token": { "$ref": "#/$defs/family" },
        "qualification_token": { "$ref": "#/$defs/qualification" },
        "narrowed": { "type": "boolean" },
        "claim_withheld": { "type": "boolean" },
        "conflates_local_core": { "type": "boolean" },
        "local_core_preserved": { "type": "boolean" },
        "degraded_state_token": { "$ref": "#/$defs/degraded_state" },
        "narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "defect_id",
        "narrow_reason",
        "narrow_reason_token",
        "source",
        "note"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "outage_taxonomy_defect_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "defect_id": { "$ref": "#/$defs/opaque_id" },
        "narrow_reason": { "$ref": "#/$defs/narrow_reason" },
        "narrow_reason_token": { "$ref": "#/$defs/narrow_reason" },
        "source": { "$ref": "#/$defs/opaque_id" },
        "note": { "$ref": "#/$defs/label" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "overall_qualification_token",
        "packet_count",
        "family_count",
        "control_plane_impaired_count",
        "data_plane_impaired_count",
        "operational_count",
        "degraded_count",
        "unavailable_count",
        "recovering_count",
        "local_core_preserved_count",
        "narrowed_count",
        "withdrawn_count",
        "surface_projection_count",
        "vocabulary_consistent",
        "all_local_core_preserved",
        "no_global_ide_down_misclaim",
        "all_families_covered",
        "plane_distinction_present",
        "raw_payloads_excluded",
        "defect_count"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "outage_taxonomy_summary_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "overall_qualification_token": { "$ref": "#/$defs/qualification" },
        "packet_count": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "control_plane_impaired_count": { "type": "integer", "minimum": 0 },
        "data_plane_impaired_count": { "type": "integer", "minimum": 0 },
        "operational_count": { "type": "integer", "minimum": 0 },
        "degraded_count": { "type": "integer", "minimum": 0 },
        "unavailable_count": { "type": "integer", "minimum": 0 },
        "recovering_count": { "type": "integer", "minimum": 0 },
        "local_core_preserved_count": { "type": "integer", "minimum": 0 },
        "narrowed_count": { "type": "integer", "minimum": 0 },
        "withdrawn_count": { "type": "integer", "minimum": 0 },
        "surface_projection_count": { "type": "integer", "minimum": 0 },
        "vocabulary_consistent": { "type": "boolean" },
        "all_local_core_preserved": { "type": "boolean" },
        "no_global_ide_down_misclaim": { "type": "boolean" },
        "all_families_covered": { "type": "boolean" },
        "plane_distinction_present": { "type": "boolean" },
        "raw_payloads_excluded": { "type": "boolean" },
        "defect_count": { "type": "integer", "minimum": 0 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "page_id",
        "page_label",
        "generated_at",
        "summary",
        "defects",
        "descriptors",
        "surface_projections",
        "outcomes",
        "input"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "outage_taxonomy_page_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "page_id": { "$ref": "#/$defs/opaque_id" },
        "page_label": { "$ref": "#/$defs/label" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "summary": { "$ref": "#/$defs/summary" },
        "defects": {
          "type": "array",
          "items": { "$ref": "#/$defs/defect" }
        },
        "descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "surface_projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_projection" }
        },
        "outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/outcome" }
        },
        "input": { "$ref": "#/$defs/input" }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "export_id",
        "generated_at",
        "page",
        "narrow_reasons_present",
        "raw_payloads_excluded"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "outage_taxonomy_support_export_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "export_id": { "$ref": "#/$defs/opaque_id" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "page": { "$ref": "#/$defs/page" },
        "narrow_reasons_present": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        },
        "raw_payloads_excluded": { "type": "boolean" }
      }
    }
  }
}
