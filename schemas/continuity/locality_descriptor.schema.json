{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/continuity/locality_descriptor.schema.json",
  "title": "Aureline locality-descriptor and tenant-boundary-card packet",
  "description": "Canonical schema for the plain-language locality descriptors and tenant-boundary cards rendered on every claimed managed, self-hosted, and sovereign surface. Each claimed row carries a locality descriptor (processing location, storage location, region pin with a honored/cannot-honor state, and retention class) and a tenant-boundary card (tenant scope, isolation posture, key mode), projected identically onto desktop, CLI/headless inspect, service-health, support-export, About/Help, and docs/public-truth surfaces. Managed-lane rows fail closed when a declared region pin cannot be honored, and self-hosted or sovereign rows that imply broader locality than their topology are withdrawn; local-core rows stay accurately labeled. The packet is metadata-only: it carries closed-vocabulary tokens, export-safe plain-language labels, and opaque refs. Raw hostnames, raw tenant identifiers, raw KMS handles, and secret material never appear. The root accepts a card-page record, a summary record, or a support-export record, discriminated by record_kind.",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/support_export" }
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "continuity:m5_locality_descriptors_and_tenant_cards:v1"
    },
    "profile_class": {
      "type": "string",
      "enum": ["managed", "self_hosted", "sovereign", "local_only"]
    },
    "continuity_lane": {
      "type": "string",
      "enum": ["local_core", "managed_lane"]
    },
    "locality_class": {
      "type": "string",
      "enum": [
        "device_local",
        "single_region",
        "multi_region",
        "customer_region",
        "in_country_sovereign",
        "air_gapped_isolated",
        "undisclosed"
      ]
    },
    "tenant_scope": {
      "type": "string",
      "enum": [
        "single_user_local",
        "customer_tenant",
        "dedicated_tenant",
        "shared_multi_tenant",
        "tenant_boundary_recheck_required",
        "not_applicable"
      ]
    },
    "key_mode": {
      "type": "string",
      "enum": [
        "local_os_keystore",
        "vendor_managed_keys",
        "customer_managed_keys",
        "customer_held_root",
        "hybrid_envelope",
        "not_applicable"
      ]
    },
    "region_pin": {
      "type": "string",
      "enum": [
        "unpinned",
        "single_region_pinned",
        "multi_region_pinned",
        "in_country_pinned",
        "customer_region_pinned",
        "pin_not_applicable"
      ]
    },
    "region_pin_honor": {
      "type": "string",
      "enum": ["honored", "drifted_within_grace", "cannot_honor", "not_applicable"]
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "device_local_retention",
        "customer_configured_retention",
        "vendor_default_retention",
        "legal_hold_retention",
        "ephemeral_no_retention",
        "retention_undisclosed"
      ]
    },
    "tenant_isolation": {
      "type": "string",
      "enum": [
        "process_local_isolation",
        "dedicated_infrastructure",
        "logical_multi_tenant",
        "customer_boundary",
        "isolation_unverified",
        "not_applicable"
      ]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "desktop",
        "cli_headless",
        "service_health",
        "support_export",
        "about_help",
        "docs_public_truth"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "not_narrowed",
        "processing_location_undisclosed",
        "storage_location_undisclosed",
        "region_pin_undeclared_on_managed",
        "region_pin_unhonored",
        "retention_class_undisclosed",
        "tenant_scope_undisclosed",
        "tenant_boundary_unverified",
        "locality_vocabulary_drift",
        "self_hosted_locality_overclaimed",
        "surface_projection_incomplete"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface_label",
        "profile_class",
        "profile_class_token",
        "has_claimed_managed_dependency",
        "continuity_lane",
        "continuity_lane_token",
        "processing_location",
        "processing_location_token",
        "storage_location",
        "storage_location_token",
        "residency_label",
        "region_pin",
        "region_pin_token",
        "region_pin_honor",
        "region_pin_honor_token",
        "region_pin_label",
        "retention_class",
        "retention_class_token",
        "tenant_scope",
        "tenant_scope_token",
        "tenant_isolation",
        "tenant_isolation_token",
        "key_mode",
        "key_mode_token",
        "projected_surfaces"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "profile_class": { "$ref": "#/$defs/profile_class" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "has_claimed_managed_dependency": { "type": "boolean" },
        "continuity_lane": { "$ref": "#/$defs/continuity_lane" },
        "continuity_lane_token": { "$ref": "#/$defs/continuity_lane" },
        "processing_location": { "$ref": "#/$defs/locality_class" },
        "processing_location_token": { "$ref": "#/$defs/locality_class" },
        "storage_location": { "$ref": "#/$defs/locality_class" },
        "storage_location_token": { "$ref": "#/$defs/locality_class" },
        "residency_label": { "$ref": "#/$defs/label" },
        "region_pin": { "$ref": "#/$defs/region_pin" },
        "region_pin_token": { "$ref": "#/$defs/region_pin" },
        "region_pin_honor": { "$ref": "#/$defs/region_pin_honor" },
        "region_pin_honor_token": { "$ref": "#/$defs/region_pin_honor" },
        "region_pin_label": { "$ref": "#/$defs/label" },
        "retention_class": { "$ref": "#/$defs/retention_class" },
        "retention_class_token": { "$ref": "#/$defs/retention_class" },
        "tenant_scope": { "$ref": "#/$defs/tenant_scope" },
        "tenant_scope_token": { "$ref": "#/$defs/tenant_scope" },
        "tenant_isolation": { "$ref": "#/$defs/tenant_isolation" },
        "tenant_isolation_token": { "$ref": "#/$defs/tenant_isolation" },
        "key_mode": { "$ref": "#/$defs/key_mode" },
        "key_mode_token": { "$ref": "#/$defs/key_mode" },
        "projected_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_class" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_label", "entries"],
      "properties": {
        "input_label": { "$ref": "#/$defs/label" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor_id",
        "row_id",
        "surface_label",
        "profile_class_token",
        "profile_plain",
        "continuity_lane_token",
        "continuity_lane_plain",
        "processing_location_token",
        "processing_location_plain",
        "storage_location_token",
        "storage_location_plain",
        "residency_label",
        "region_pin_token",
        "region_pin_plain",
        "region_pin_honor_token",
        "region_pin_honor_plain",
        "region_pin_label",
        "retention_class_token",
        "retention_plain",
        "locality_summary_line",
        "fail_closed_on_managed_lane"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "locality_descriptor_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "profile_plain": { "$ref": "#/$defs/label" },
        "continuity_lane_token": { "$ref": "#/$defs/continuity_lane" },
        "continuity_lane_plain": { "$ref": "#/$defs/label" },
        "processing_location_token": { "$ref": "#/$defs/locality_class" },
        "processing_location_plain": { "$ref": "#/$defs/label" },
        "storage_location_token": { "$ref": "#/$defs/locality_class" },
        "storage_location_plain": { "$ref": "#/$defs/label" },
        "residency_label": { "$ref": "#/$defs/label" },
        "region_pin_token": { "$ref": "#/$defs/region_pin" },
        "region_pin_plain": { "$ref": "#/$defs/label" },
        "region_pin_honor_token": { "$ref": "#/$defs/region_pin_honor" },
        "region_pin_honor_plain": { "$ref": "#/$defs/label" },
        "region_pin_label": { "$ref": "#/$defs/label" },
        "retention_class_token": { "$ref": "#/$defs/retention_class" },
        "retention_plain": { "$ref": "#/$defs/label" },
        "locality_summary_line": { "$ref": "#/$defs/label" },
        "fail_closed_on_managed_lane": { "type": "boolean" }
      }
    },
    "tenant_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "card_id",
        "row_id",
        "surface_label",
        "tenant_scope_token",
        "tenant_scope_plain",
        "tenant_isolation_token",
        "tenant_isolation_plain",
        "key_mode_token",
        "key_mode_plain",
        "tenant_summary_line",
        "boundary_verified"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "tenant_boundary_card_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "card_id": { "$ref": "#/$defs/opaque_id" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "tenant_scope_token": { "$ref": "#/$defs/tenant_scope" },
        "tenant_scope_plain": { "$ref": "#/$defs/label" },
        "tenant_isolation_token": { "$ref": "#/$defs/tenant_isolation" },
        "tenant_isolation_plain": { "$ref": "#/$defs/label" },
        "key_mode_token": { "$ref": "#/$defs/key_mode" },
        "key_mode_plain": { "$ref": "#/$defs/label" },
        "tenant_summary_line": { "$ref": "#/$defs/label" },
        "boundary_verified": { "type": "boolean" }
      }
    },
    "surface_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "surface",
        "surface_token",
        "row_id",
        "descriptor_id",
        "card_id",
        "locality_summary_line",
        "tenant_summary_line"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "locality_surface_projection_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "surface": { "$ref": "#/$defs/surface_class" },
        "surface_token": { "$ref": "#/$defs/surface_class" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "card_id": { "$ref": "#/$defs/opaque_id" },
        "locality_summary_line": { "$ref": "#/$defs/label" },
        "tenant_summary_line": { "$ref": "#/$defs/label" }
      }
    },
    "row_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "row_id",
        "profile_class_token",
        "in_managed_scope",
        "qualification_token",
        "narrowed",
        "claim_withheld",
        "fail_closed",
        "narrow_reason_tokens"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "locality_tenant_row_outcome_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "in_managed_scope": { "type": "boolean" },
        "qualification_token": { "$ref": "#/$defs/qualification" },
        "narrowed": { "type": "boolean" },
        "claim_withheld": { "type": "boolean" },
        "fail_closed": { "type": "boolean" },
        "narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "defect_id",
        "narrow_reason",
        "narrow_reason_token",
        "source",
        "note"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "locality_tenant_defect_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "defect_id": { "$ref": "#/$defs/opaque_id" },
        "narrow_reason": { "$ref": "#/$defs/narrow_reason" },
        "narrow_reason_token": { "$ref": "#/$defs/narrow_reason" },
        "source": { "$ref": "#/$defs/opaque_id" },
        "note": { "$ref": "#/$defs/label" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "overall_qualification_token",
        "entry_count",
        "managed_scope_entry_count",
        "local_core_entry_count",
        "region_pinned_entry_count",
        "fail_closed_entry_count",
        "narrowed_entry_count",
        "withdrawn_entry_count",
        "surface_projection_count",
        "vocabulary_consistent",
        "defect_count"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "locality_tenant_summary_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "overall_qualification_token": { "$ref": "#/$defs/qualification" },
        "entry_count": { "type": "integer", "minimum": 0 },
        "managed_scope_entry_count": { "type": "integer", "minimum": 0 },
        "local_core_entry_count": { "type": "integer", "minimum": 0 },
        "region_pinned_entry_count": { "type": "integer", "minimum": 0 },
        "fail_closed_entry_count": { "type": "integer", "minimum": 0 },
        "narrowed_entry_count": { "type": "integer", "minimum": 0 },
        "withdrawn_entry_count": { "type": "integer", "minimum": 0 },
        "surface_projection_count": { "type": "integer", "minimum": 0 },
        "vocabulary_consistent": { "type": "boolean" },
        "defect_count": { "type": "integer", "minimum": 0 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "page_id",
        "page_label",
        "generated_at",
        "summary",
        "defects",
        "descriptors",
        "tenant_cards",
        "surface_projections",
        "row_outcomes",
        "input"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "locality_tenant_card_page_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "page_id": { "$ref": "#/$defs/opaque_id" },
        "page_label": { "$ref": "#/$defs/label" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "summary": { "$ref": "#/$defs/summary" },
        "defects": {
          "type": "array",
          "items": { "$ref": "#/$defs/defect" }
        },
        "descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "tenant_cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/tenant_card" }
        },
        "surface_projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_projection" }
        },
        "row_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/row_outcome" }
        },
        "input": { "$ref": "#/$defs/input" }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "export_id",
        "generated_at",
        "page",
        "narrow_reasons_present",
        "raw_private_material_excluded"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "locality_tenant_support_export_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "export_id": { "$ref": "#/$defs/opaque_id" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "page": { "$ref": "#/$defs/page" },
        "narrow_reasons_present": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        },
        "raw_private_material_excluded": { "type": "boolean" }
      }
    }
  }
}
