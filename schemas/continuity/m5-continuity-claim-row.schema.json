{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/continuity/m5-continuity-claim-row.schema.json",
  "title": "Aureline continuity-claim matrix packet",
  "description": "Canonical schema for the locality, tenant/key-mode, backup/restore/failover, and continuity-drill matrix consumed by About, Help, service-health, support exports, docs/public-truth pages, and partner qualification packets. The packet classifies every claimed managed, self-hosted, and sovereign surface by locality, tenant scope, key mode, continuity lane, degraded-fallback plane, continuity packet family, restore identity, partial loss, and drill cadence/owner/evidence, and narrows automatically when continuity evidence is missing, stale, or profile-mismatched. The packet is metadata-only: it carries closed-vocabulary tokens, export-safe labels, UTC timestamps, and opaque refs. Raw hostnames, raw tenant identifiers, raw KMS handles, raw trust roots, raw backup bytes, and secret material never appear. The root accepts a matrix page record, a matrix summary record, or a support-export record, discriminated by record_kind.",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/support_export" }
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "profile_class": {
      "type": "string",
      "enum": ["managed", "self_hosted", "sovereign", "local_only"]
    },
    "continuity_lane": {
      "type": "string",
      "enum": ["local_core", "managed_lane"]
    },
    "locality_class": {
      "type": "string",
      "enum": [
        "device_local",
        "single_region",
        "multi_region",
        "customer_region",
        "in_country_sovereign",
        "air_gapped_isolated",
        "undisclosed"
      ]
    },
    "tenant_scope": {
      "type": "string",
      "enum": [
        "single_user_local",
        "customer_tenant",
        "dedicated_tenant",
        "shared_multi_tenant",
        "tenant_boundary_recheck_required",
        "not_applicable"
      ]
    },
    "key_mode": {
      "type": "string",
      "enum": [
        "local_os_keystore",
        "vendor_managed_keys",
        "customer_managed_keys",
        "customer_held_root",
        "hybrid_envelope",
        "not_applicable"
      ]
    },
    "plane_impairment": {
      "type": "string",
      "enum": ["control_plane_impairment", "data_plane_impairment", "both_planes"]
    },
    "packet_family": {
      "type": "string",
      "enum": ["backup", "restore", "failover", "snapshot_replication", "local_core_continuity"]
    },
    "restore_failover_hosting": {
      "type": "string",
      "enum": [
        "local_core",
        "customer_operated",
        "vendor_operated",
        "mirror_backed",
        "offline_snapshot"
      ]
    },
    "restore_identity": {
      "type": "string",
      "enum": [
        "same_identity_restore",
        "reissued_identity_restore",
        "new_install_rebind",
        "not_applicable"
      ]
    },
    "partial_loss": {
      "type": "string",
      "enum": [
        "no_partial_loss",
        "bounded_recent_window_loss",
        "queued_action_loss",
        "cache_only_loss",
        "undisclosed"
      ]
    },
    "drill_cadence": {
      "type": "string",
      "enum": ["per_release", "monthly", "quarterly", "semiannual", "annual", "on_demand_only"]
    },
    "drill_evidence_state": {
      "type": "string",
      "enum": [
        "current",
        "stale_within_grace",
        "stale_needs_drill",
        "never_run",
        "reconstructable_from_snapshot"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "not_narrowed",
        "locality_undisclosed",
        "tenant_key_posture_missing",
        "degraded_fallback_class_missing",
        "continuity_lane_distinction_missing",
        "continuity_packet_family_missing",
        "drill_cadence_or_owner_missing",
        "drill_evidence_stale",
        "drill_never_run",
        "restore_identity_undeclared",
        "partial_loss_undisclosed",
        "profile_mismatch",
        "sovereign_continuity_overclaimed",
        "local_only_overclaimed_as_managed",
        "surface_reuse_incomplete"
      ]
    },
    "surface_visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "about",
        "help",
        "service_health",
        "support_export",
        "docs_public_truth",
        "partner_qualification"
      ],
      "properties": {
        "about": { "type": "boolean" },
        "help": { "type": "boolean" },
        "service_health": { "type": "boolean" },
        "support_export": { "type": "boolean" },
        "docs_public_truth": { "type": "boolean" },
        "partner_qualification": { "type": "boolean" }
      }
    },
    "locality_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_locality",
        "processing_locality_token",
        "storage_locality",
        "storage_locality_token",
        "residency_label"
      ],
      "properties": {
        "processing_locality": { "$ref": "#/$defs/locality_class" },
        "processing_locality_token": { "$ref": "#/$defs/locality_class" },
        "storage_locality": { "$ref": "#/$defs/locality_class" },
        "storage_locality_token": { "$ref": "#/$defs/locality_class" },
        "residency_label": { "$ref": "#/$defs/label" }
      }
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cadence",
        "cadence_token",
        "evidence_state",
        "evidence_state_token",
        "current_owner_label",
        "future_owner_label",
        "last_drill_at",
        "drill_packet_ref"
      ],
      "properties": {
        "cadence": { "$ref": "#/$defs/drill_cadence" },
        "cadence_token": { "$ref": "#/$defs/drill_cadence" },
        "evidence_state": { "$ref": "#/$defs/drill_evidence_state" },
        "evidence_state_token": { "$ref": "#/$defs/drill_evidence_state" },
        "current_owner_label": { "$ref": "#/$defs/label" },
        "future_owner_label": { "$ref": "#/$defs/label" },
        "last_drill_at": { "$ref": "#/$defs/timestamp" },
        "drill_packet_ref": { "$ref": "#/$defs/label" }
      }
    },
    "claim_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface_label",
        "profile_class",
        "profile_class_token",
        "has_claimed_managed_dependency",
        "continuity_lane",
        "continuity_lane_token",
        "locality",
        "tenant_scope",
        "tenant_scope_token",
        "key_mode",
        "key_mode_token",
        "degraded_fallback_class",
        "degraded_fallback_class_token",
        "continuity_packet_family",
        "continuity_packet_family_token",
        "continuity_packet_ref",
        "restore_failover_hosting",
        "restore_failover_hosting_token",
        "external_dependency_disclosed",
        "restore_identity",
        "restore_identity_token",
        "partial_loss",
        "partial_loss_token",
        "partial_loss_note",
        "drill",
        "surface_visibility"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "profile_class": { "$ref": "#/$defs/profile_class" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "has_claimed_managed_dependency": { "type": "boolean" },
        "continuity_lane": { "$ref": "#/$defs/continuity_lane" },
        "continuity_lane_token": { "$ref": "#/$defs/continuity_lane" },
        "locality": { "$ref": "#/$defs/locality_posture" },
        "tenant_scope": { "$ref": "#/$defs/tenant_scope" },
        "tenant_scope_token": { "$ref": "#/$defs/tenant_scope" },
        "key_mode": { "$ref": "#/$defs/key_mode" },
        "key_mode_token": { "$ref": "#/$defs/key_mode" },
        "degraded_fallback_class": { "$ref": "#/$defs/plane_impairment" },
        "degraded_fallback_class_token": { "$ref": "#/$defs/plane_impairment" },
        "continuity_packet_family": { "$ref": "#/$defs/packet_family" },
        "continuity_packet_family_token": { "$ref": "#/$defs/packet_family" },
        "continuity_packet_ref": { "$ref": "#/$defs/label" },
        "restore_failover_hosting": { "$ref": "#/$defs/restore_failover_hosting" },
        "restore_failover_hosting_token": { "$ref": "#/$defs/restore_failover_hosting" },
        "external_dependency_disclosed": { "type": "boolean" },
        "restore_identity": { "$ref": "#/$defs/restore_identity" },
        "restore_identity_token": { "$ref": "#/$defs/restore_identity" },
        "partial_loss": { "$ref": "#/$defs/partial_loss" },
        "partial_loss_token": { "$ref": "#/$defs/partial_loss" },
        "partial_loss_note": { "$ref": "#/$defs/label" },
        "drill": { "$ref": "#/$defs/drill" },
        "surface_visibility": { "$ref": "#/$defs/surface_visibility" }
      }
    },
    "row_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "row_id",
        "profile_class_token",
        "in_managed_scope",
        "qualification_token",
        "narrowed",
        "claim_withheld",
        "narrow_reason_tokens"
      ],
      "properties": {
        "record_kind": { "const": "continuity_claim_row_outcome_record" },
        "schema_version": { "const": 1 },
        "shared_contract_ref": {
          "const": "continuity:m5_locality_tenant_keymode_and_drill_matrix:v1"
        },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "in_managed_scope": { "type": "boolean" },
        "qualification_token": { "$ref": "#/$defs/qualification" },
        "narrowed": { "type": "boolean" },
        "claim_withheld": { "type": "boolean" },
        "narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        }
      }
    },
    "drill_schedule_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_family",
        "packet_family_token",
        "row_count",
        "cadence_tokens",
        "current_owner_labels",
        "future_owner_labels",
        "evidence_state_tokens",
        "needs_drill_row_count"
      ],
      "properties": {
        "packet_family": { "$ref": "#/$defs/packet_family" },
        "packet_family_token": { "$ref": "#/$defs/packet_family" },
        "row_count": { "type": "integer", "minimum": 0 },
        "cadence_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill_cadence" }
        },
        "current_owner_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/label" }
        },
        "future_owner_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/label" }
        },
        "evidence_state_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill_evidence_state" }
        },
        "needs_drill_row_count": { "type": "integer", "minimum": 0 }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "defect_id",
        "narrow_reason",
        "narrow_reason_token",
        "source",
        "note"
      ],
      "properties": {
        "record_kind": { "const": "continuity_claim_defect_record" },
        "schema_version": { "const": 1 },
        "shared_contract_ref": {
          "const": "continuity:m5_locality_tenant_keymode_and_drill_matrix:v1"
        },
        "defect_id": { "$ref": "#/$defs/opaque_id" },
        "narrow_reason": { "$ref": "#/$defs/narrow_reason" },
        "narrow_reason_token": { "$ref": "#/$defs/narrow_reason" },
        "source": { "$ref": "#/$defs/opaque_id" },
        "note": { "$ref": "#/$defs/label" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_label", "claim_rows"],
      "properties": {
        "matrix_label": { "$ref": "#/$defs/label" },
        "claim_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_row" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "overall_qualification_token",
        "claim_row_count",
        "managed_scope_row_count",
        "local_core_row_count",
        "managed_lane_row_count",
        "control_plane_impairment_row_count",
        "data_plane_impairment_row_count",
        "narrowed_row_count",
        "withdrawn_row_count",
        "drill_family_count",
        "needs_drill_row_count",
        "defect_count"
      ],
      "properties": {
        "record_kind": { "const": "continuity_claim_matrix_summary_record" },
        "schema_version": { "const": 1 },
        "shared_contract_ref": {
          "const": "continuity:m5_locality_tenant_keymode_and_drill_matrix:v1"
        },
        "overall_qualification_token": { "$ref": "#/$defs/qualification" },
        "claim_row_count": { "type": "integer", "minimum": 0 },
        "managed_scope_row_count": { "type": "integer", "minimum": 0 },
        "local_core_row_count": { "type": "integer", "minimum": 0 },
        "managed_lane_row_count": { "type": "integer", "minimum": 0 },
        "control_plane_impairment_row_count": { "type": "integer", "minimum": 0 },
        "data_plane_impairment_row_count": { "type": "integer", "minimum": 0 },
        "narrowed_row_count": { "type": "integer", "minimum": 0 },
        "withdrawn_row_count": { "type": "integer", "minimum": 0 },
        "drill_family_count": { "type": "integer", "minimum": 0 },
        "needs_drill_row_count": { "type": "integer", "minimum": 0 },
        "defect_count": { "type": "integer", "minimum": 0 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "page_id",
        "page_label",
        "generated_at",
        "summary",
        "defects",
        "row_outcomes",
        "drill_schedule",
        "input"
      ],
      "properties": {
        "record_kind": { "const": "continuity_claim_matrix_page_record" },
        "schema_version": { "const": 1 },
        "shared_contract_ref": {
          "const": "continuity:m5_locality_tenant_keymode_and_drill_matrix:v1"
        },
        "page_id": { "$ref": "#/$defs/opaque_id" },
        "page_label": { "$ref": "#/$defs/label" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "summary": { "$ref": "#/$defs/summary" },
        "defects": {
          "type": "array",
          "items": { "$ref": "#/$defs/defect" }
        },
        "row_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/row_outcome" }
        },
        "drill_schedule": {
          "type": "array",
          "items": { "$ref": "#/$defs/drill_schedule_entry" }
        },
        "input": { "$ref": "#/$defs/input" }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "export_id",
        "generated_at",
        "page",
        "narrow_reasons_present",
        "defect_counts_by_narrow_reason",
        "raw_private_material_excluded"
      ],
      "properties": {
        "record_kind": { "const": "continuity_claim_matrix_support_export_record" },
        "schema_version": { "const": 1 },
        "shared_contract_ref": {
          "const": "continuity:m5_locality_tenant_keymode_and_drill_matrix:v1"
        },
        "export_id": { "$ref": "#/$defs/opaque_id" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "page": { "$ref": "#/$defs/page" },
        "narrow_reasons_present": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        },
        "defect_counts_by_narrow_reason": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "raw_private_material_excluded": { "type": "boolean" }
      }
    }
  }
}
