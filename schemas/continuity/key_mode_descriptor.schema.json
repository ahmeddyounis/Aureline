{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/continuity/key_mode_descriptor.schema.json",
  "title": "Aureline key-mode and storage-posture inspector packet",
  "description": "Canonical schema for the key-mode and storage-posture inspectors rendered on every claimed managed, self-hosted, and sovereign surface. Each claimed row carries a key-mode descriptor (key mode, trust-root posture across OS store / vendor-managed / customer-managed / offline trust root, runtime key-availability state, store-lock state, key-evidence freshness, and a typed degraded state) and a storage-posture descriptor (encryption-at-rest posture naming the specific protecting key mode), projected identically onto desktop, CLI/headless inspect, service-health, support-center export, About/Help, and docs/public-truth surfaces. Managed-scope rows fail closed when a customer-managed key is unavailable, the trust root mismatches, or key material is lost: only the protected managed lane narrows while local-core continuity is preserved. A claim of 'encrypted' without a named key mode is not sufficient and narrows. The packet is metadata-only: it carries closed-vocabulary tokens, export-safe plain-language labels, and opaque refs. Raw KMS handles, raw trust roots, raw key bytes, and secret material never appear. The root accepts a page record, a summary record, or a support-export record, discriminated by record_kind.",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/support_export" }
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "shared_contract_ref": {
      "type": "string",
      "const": "continuity:m5_key_mode_and_storage_posture:v1"
    },
    "profile_class": {
      "type": "string",
      "enum": ["managed", "self_hosted", "sovereign", "local_only"]
    },
    "continuity_lane": {
      "type": "string",
      "enum": ["local_core", "managed_lane"]
    },
    "key_mode": {
      "type": "string",
      "enum": [
        "local_os_keystore",
        "vendor_managed_keys",
        "customer_managed_keys",
        "customer_held_root",
        "hybrid_envelope",
        "not_applicable"
      ]
    },
    "trust_root_posture": {
      "type": "string",
      "enum": [
        "os_store_trust_root",
        "vendor_managed_trust_root",
        "customer_managed_trust_root",
        "offline_trust_root",
        "hybrid_trust_root",
        "trust_root_undisclosed",
        "not_applicable"
      ]
    },
    "key_availability": {
      "type": "string",
      "enum": [
        "available",
        "customer_key_unavailable",
        "trust_root_mismatch",
        "key_material_lost"
      ]
    },
    "store_lock": {
      "type": "string",
      "enum": ["unlocked", "locked", "not_applicable"]
    },
    "storage_encryption": {
      "type": "string",
      "enum": [
        "device_local_encrypted",
        "vendor_key_encrypted",
        "customer_key_encrypted",
        "offline_sealed_encrypted",
        "encrypted_key_mode_opaque",
        "encryption_undisclosed",
        "not_applicable"
      ]
    },
    "key_evidence_state": {
      "type": "string",
      "enum": ["current", "stale_within_grace", "stale_needs_recheck", "missing"]
    },
    "degraded_state": {
      "type": "string",
      "enum": ["none_healthy", "managed_lane_fail_closed", "store_locked_degraded"]
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "desktop",
        "cli_headless",
        "service_health",
        "support_center",
        "about_help",
        "docs_public_truth"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "withdrawn"]
    },
    "narrow_reason": {
      "type": "string",
      "enum": [
        "not_narrowed",
        "key_mode_undisclosed",
        "trust_root_posture_undisclosed",
        "encryption_posture_opaque",
        "encryption_posture_undisclosed",
        "customer_key_unavailable",
        "trust_root_mismatch",
        "key_material_lost",
        "store_locked_on_managed_lane",
        "key_evidence_stale",
        "key_posture_evidence_missing",
        "profile_key_mode_mismatch",
        "surface_reuse_incomplete",
        "key_storage_vocabulary_drift",
        "local_only_key_overclaimed"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "surface_label",
        "profile_class",
        "profile_class_token",
        "has_claimed_managed_dependency",
        "continuity_lane",
        "continuity_lane_token",
        "protects_durable_state",
        "key_mode",
        "key_mode_token",
        "trust_root_posture",
        "trust_root_posture_token",
        "key_availability",
        "key_availability_token",
        "store_lock",
        "store_lock_token",
        "storage_encryption",
        "storage_encryption_token",
        "key_evidence_state",
        "key_evidence_state_token",
        "key_posture_evidence_ref",
        "projected_surfaces"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "profile_class": { "$ref": "#/$defs/profile_class" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "has_claimed_managed_dependency": { "type": "boolean" },
        "continuity_lane": { "$ref": "#/$defs/continuity_lane" },
        "continuity_lane_token": { "$ref": "#/$defs/continuity_lane" },
        "protects_durable_state": { "type": "boolean" },
        "key_mode": { "$ref": "#/$defs/key_mode" },
        "key_mode_token": { "$ref": "#/$defs/key_mode" },
        "trust_root_posture": { "$ref": "#/$defs/trust_root_posture" },
        "trust_root_posture_token": { "$ref": "#/$defs/trust_root_posture" },
        "key_availability": { "$ref": "#/$defs/key_availability" },
        "key_availability_token": { "$ref": "#/$defs/key_availability" },
        "store_lock": { "$ref": "#/$defs/store_lock" },
        "store_lock_token": { "$ref": "#/$defs/store_lock" },
        "storage_encryption": { "$ref": "#/$defs/storage_encryption" },
        "storage_encryption_token": { "$ref": "#/$defs/storage_encryption" },
        "key_evidence_state": { "$ref": "#/$defs/key_evidence_state" },
        "key_evidence_state_token": { "$ref": "#/$defs/key_evidence_state" },
        "key_posture_evidence_ref": { "$ref": "#/$defs/label" },
        "projected_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_class" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_label", "entries"],
      "properties": {
        "input_label": { "$ref": "#/$defs/label" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "key_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor_id",
        "row_id",
        "surface_label",
        "profile_class_token",
        "profile_plain",
        "continuity_lane_token",
        "continuity_lane_plain",
        "key_mode_token",
        "key_mode_plain",
        "trust_root_posture_token",
        "trust_root_posture_plain",
        "key_availability_token",
        "key_availability_plain",
        "store_lock_token",
        "store_lock_plain",
        "key_evidence_state_token",
        "key_evidence_state_plain",
        "degraded_state_token",
        "degraded_state_plain",
        "key_summary_line",
        "fail_closed_on_managed_lane",
        "local_core_preserved",
        "protects_durable_state"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "key_mode_descriptor_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "profile_plain": { "$ref": "#/$defs/label" },
        "continuity_lane_token": { "$ref": "#/$defs/continuity_lane" },
        "continuity_lane_plain": { "$ref": "#/$defs/label" },
        "key_mode_token": { "$ref": "#/$defs/key_mode" },
        "key_mode_plain": { "$ref": "#/$defs/label" },
        "trust_root_posture_token": { "$ref": "#/$defs/trust_root_posture" },
        "trust_root_posture_plain": { "$ref": "#/$defs/label" },
        "key_availability_token": { "$ref": "#/$defs/key_availability" },
        "key_availability_plain": { "$ref": "#/$defs/label" },
        "store_lock_token": { "$ref": "#/$defs/store_lock" },
        "store_lock_plain": { "$ref": "#/$defs/label" },
        "key_evidence_state_token": { "$ref": "#/$defs/key_evidence_state" },
        "key_evidence_state_plain": { "$ref": "#/$defs/label" },
        "degraded_state_token": { "$ref": "#/$defs/degraded_state" },
        "degraded_state_plain": { "$ref": "#/$defs/label" },
        "key_summary_line": { "$ref": "#/$defs/label" },
        "fail_closed_on_managed_lane": { "type": "boolean" },
        "local_core_preserved": { "type": "boolean" },
        "protects_durable_state": { "type": "boolean" }
      }
    },
    "storage_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "descriptor_id",
        "row_id",
        "surface_label",
        "storage_encryption_token",
        "storage_encryption_plain",
        "key_mode_token",
        "key_mode_plain",
        "trust_root_posture_token",
        "trust_root_posture_plain",
        "storage_summary_line",
        "key_mode_visible"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "storage_posture_descriptor_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "surface_label": { "$ref": "#/$defs/label" },
        "storage_encryption_token": { "$ref": "#/$defs/storage_encryption" },
        "storage_encryption_plain": { "$ref": "#/$defs/label" },
        "key_mode_token": { "$ref": "#/$defs/key_mode" },
        "key_mode_plain": { "$ref": "#/$defs/label" },
        "trust_root_posture_token": { "$ref": "#/$defs/trust_root_posture" },
        "trust_root_posture_plain": { "$ref": "#/$defs/label" },
        "storage_summary_line": { "$ref": "#/$defs/label" },
        "key_mode_visible": { "type": "boolean" }
      }
    },
    "surface_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "surface",
        "surface_token",
        "row_id",
        "key_descriptor_id",
        "storage_descriptor_id",
        "key_summary_line",
        "storage_summary_line"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "key_posture_surface_projection_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "surface": { "$ref": "#/$defs/surface_class" },
        "surface_token": { "$ref": "#/$defs/surface_class" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "key_descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "storage_descriptor_id": { "$ref": "#/$defs/opaque_id" },
        "key_summary_line": { "$ref": "#/$defs/label" },
        "storage_summary_line": { "$ref": "#/$defs/label" }
      }
    },
    "row_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "row_id",
        "profile_class_token",
        "in_managed_scope",
        "qualification_token",
        "narrowed",
        "claim_withheld",
        "fail_closed",
        "local_core_preserved",
        "degraded_state_token",
        "narrow_reason_tokens"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "key_posture_row_outcome_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "row_id": { "$ref": "#/$defs/opaque_id" },
        "profile_class_token": { "$ref": "#/$defs/profile_class" },
        "in_managed_scope": { "type": "boolean" },
        "qualification_token": { "$ref": "#/$defs/qualification" },
        "narrowed": { "type": "boolean" },
        "claim_withheld": { "type": "boolean" },
        "fail_closed": { "type": "boolean" },
        "local_core_preserved": { "type": "boolean" },
        "degraded_state_token": { "$ref": "#/$defs/degraded_state" },
        "narrow_reason_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "defect_id",
        "narrow_reason",
        "narrow_reason_token",
        "source",
        "note"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "key_posture_defect_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "defect_id": { "$ref": "#/$defs/opaque_id" },
        "narrow_reason": { "$ref": "#/$defs/narrow_reason" },
        "narrow_reason_token": { "$ref": "#/$defs/narrow_reason" },
        "source": { "$ref": "#/$defs/opaque_id" },
        "note": { "$ref": "#/$defs/label" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "overall_qualification_token",
        "entry_count",
        "managed_scope_entry_count",
        "local_core_entry_count",
        "customer_controlled_key_entry_count",
        "offline_trust_root_entry_count",
        "fail_closed_entry_count",
        "store_locked_entry_count",
        "narrowed_entry_count",
        "withdrawn_entry_count",
        "surface_projection_count",
        "vocabulary_consistent",
        "all_local_core_preserved",
        "raw_key_material_excluded",
        "defect_count"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "key_mode_storage_posture_summary_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "overall_qualification_token": { "$ref": "#/$defs/qualification" },
        "entry_count": { "type": "integer", "minimum": 0 },
        "managed_scope_entry_count": { "type": "integer", "minimum": 0 },
        "local_core_entry_count": { "type": "integer", "minimum": 0 },
        "customer_controlled_key_entry_count": { "type": "integer", "minimum": 0 },
        "offline_trust_root_entry_count": { "type": "integer", "minimum": 0 },
        "fail_closed_entry_count": { "type": "integer", "minimum": 0 },
        "store_locked_entry_count": { "type": "integer", "minimum": 0 },
        "narrowed_entry_count": { "type": "integer", "minimum": 0 },
        "withdrawn_entry_count": { "type": "integer", "minimum": 0 },
        "surface_projection_count": { "type": "integer", "minimum": 0 },
        "vocabulary_consistent": { "type": "boolean" },
        "all_local_core_preserved": { "type": "boolean" },
        "raw_key_material_excluded": { "type": "boolean" },
        "defect_count": { "type": "integer", "minimum": 0 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "page_id",
        "page_label",
        "generated_at",
        "summary",
        "defects",
        "key_descriptors",
        "storage_descriptors",
        "surface_projections",
        "row_outcomes",
        "input"
      ],
      "properties": {
        "record_kind": { "type": "string", "const": "key_mode_storage_posture_page_record" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "page_id": { "$ref": "#/$defs/opaque_id" },
        "page_label": { "$ref": "#/$defs/label" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "summary": { "$ref": "#/$defs/summary" },
        "defects": {
          "type": "array",
          "items": { "$ref": "#/$defs/defect" }
        },
        "key_descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/key_descriptor" }
        },
        "storage_descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/storage_descriptor" }
        },
        "surface_projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_projection" }
        },
        "row_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/row_outcome" }
        },
        "input": { "$ref": "#/$defs/input" }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "export_id",
        "generated_at",
        "page",
        "narrow_reasons_present",
        "raw_key_material_excluded"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "key_mode_storage_posture_support_export_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": { "$ref": "#/$defs/shared_contract_ref" },
        "export_id": { "$ref": "#/$defs/opaque_id" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "page": { "$ref": "#/$defs/page" },
        "narrow_reasons_present": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrow_reason" }
        },
        "raw_key_material_excluded": { "type": "boolean" }
      }
    }
  }
}
