{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/m5-localization-parity.schema.json",
  "title": "Aureline M5 localization parity report",
  "description": "Cross-locale parity proof for the claimed localized M5 profiles. For every claimed locale it records whether the rendered message-id sequence matches the source-language render, whether stable non-prose refs and placeholders survived localization, whether severity and scope survive truncation, the text-expansion ceiling, and the message ids the locale leaves untranslated. Carries no translated bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "report_id",
    "generated_at",
    "source_language_locale",
    "target_build_identity_ref",
    "registry_packet_id_ref",
    "catalog_id_ref",
    "truncation_budget_graphemes",
    "claimed_locales",
    "rows",
    "parity_clean"
  ],
  "properties": {
    "record_kind": { "const": "m5_localization_parity_report" },
    "schema_version": { "const": 1 },
    "report_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_language_locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "target_build_identity_ref": { "type": "string", "minLength": 1 },
    "registry_packet_id_ref": { "type": "string", "minLength": 1 },
    "catalog_id_ref": { "type": "string", "minLength": 1 },
    "truncation_budget_graphemes": { "type": "integer", "minimum": 0 },
    "claimed_locales": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "text_direction",
          "rendered_row_count",
          "id_set_matches_source",
          "localized_count",
          "source_fallback_count",
          "all_stable_refs_preserved",
          "all_placeholders_preserved",
          "severity_preserved_under_truncation",
          "max_expansion_ratio_pct",
          "nonlocalized_message_ids"
        ],
        "properties": {
          "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "text_direction": { "enum": ["left_to_right", "right_to_left"] },
          "rendered_row_count": { "type": "integer", "minimum": 0 },
          "id_set_matches_source": { "type": "boolean" },
          "localized_count": { "type": "integer", "minimum": 0 },
          "source_fallback_count": { "type": "integer", "minimum": 0 },
          "all_stable_refs_preserved": { "type": "boolean" },
          "all_placeholders_preserved": { "type": "boolean" },
          "severity_preserved_under_truncation": { "type": "boolean" },
          "max_expansion_ratio_pct": { "type": "integer", "minimum": 0 },
          "nonlocalized_message_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "parity_clean": { "type": "boolean" }
  }
}
