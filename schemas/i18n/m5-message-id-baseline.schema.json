{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/m5-message-id-baseline.schema.json",
  "title": "Aureline M5 message-id baseline snapshot",
  "description": "Frozen snapshot of message ids and source-language keys captured at a prior release build. The current M5 message registry is diffed against this snapshot so a removed id or a drifted source-language key fails the release-build continuity check. Carries no translated bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "snapshot_id",
    "build_identity_ref",
    "source_language_locale",
    "generated_at",
    "ids"
  ],
  "properties": {
    "record_kind": { "const": "m5_message_id_baseline_snapshot" },
    "schema_version": { "const": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "build_identity_ref": { "type": "string", "minLength": 1 },
    "source_language_locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "source_language_key", "surface"],
        "properties": {
          "message_id": { "type": "string", "minLength": 1 },
          "source_language_key": { "type": "string", "minLength": 1 },
          "surface": {
            "enum": [
              "shell_chrome",
              "command_palette",
              "settings",
              "help",
              "error",
              "notification"
            ]
          }
        }
      }
    }
  }
}
