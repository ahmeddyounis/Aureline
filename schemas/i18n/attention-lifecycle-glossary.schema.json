{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/attention-lifecycle-glossary.schema.json",
  "title": "Aureline attention and lifecycle vocabulary glossary",
  "description": "The single governed terminology glossary for durable-attention surfaces: activity-center rows and partitions, job-row badges, notification summaries, lifecycle-state copy, and quiet-hours/admin suppression messaging. Each term binds one concept to a stable locale-neutral term key, a locale-neutral severity rank and action-order index that translation cannot soften, strengthen, or reorder, one canonical source-language definition, and per-locale translations. Downstream shell, support, docs, and exported packets map localized attention states back to these term keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "glossary_id",
    "generated_at",
    "target_build_identity_ref",
    "source_language_locale",
    "claimed_locales",
    "truncation_budget_graphemes",
    "terms",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "attention_vocabulary_glossary_record" },
    "schema_version": { "const": 1 },
    "glossary_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_build_identity_ref": { "type": "string", "minLength": 1 },
    "source_language_locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "claimed_locales": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
    },
    "truncation_budget_graphemes": { "type": "integer", "minimum": 1 },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/term" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "domain": {
      "type": "string",
      "enum": [
        "lifecycle_state",
        "activity_partition",
        "job_row_badge",
        "quiet_hours_mode",
        "suppression_reason"
      ]
    },
    "severity_rank": {
      "type": "string",
      "enum": [
        "informational",
        "in_progress",
        "pending",
        "success",
        "needs_attention",
        "degraded",
        "failure",
        "critical"
      ]
    },
    "text_direction": {
      "type": "string",
      "enum": ["left_to_right", "right_to_left"]
    },
    "localization_state": {
      "type": "string",
      "enum": ["localized", "source_language_fallback"]
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "text_direction",
        "localized_term",
        "localization_state",
        "source_grapheme_len",
        "display_grapheme_len",
        "expansion_ratio_pct",
        "truncated_term",
        "was_truncated",
        "severity_preserved_under_truncation",
        "asserted_severity_rank",
        "asserted_action_order_index",
        "placeholders_preserved"
      ],
      "properties": {
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "text_direction": { "$ref": "#/$defs/text_direction" },
        "localized_term": { "type": "string", "minLength": 1 },
        "localization_state": { "$ref": "#/$defs/localization_state" },
        "source_grapheme_len": { "type": "integer", "minimum": 0 },
        "display_grapheme_len": { "type": "integer", "minimum": 0 },
        "expansion_ratio_pct": { "type": "integer", "minimum": 0 },
        "truncated_term": { "type": "string", "minLength": 1 },
        "was_truncated": { "type": "boolean" },
        "severity_preserved_under_truncation": { "type": "boolean" },
        "asserted_severity_rank": { "$ref": "#/$defs/severity_rank" },
        "asserted_action_order_index": { "type": "integer", "minimum": 0 },
        "placeholders_preserved": { "type": "boolean" }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term_key",
        "domain",
        "severity_rank",
        "action_order_index",
        "durable",
        "source_term",
        "definition",
        "translations"
      ],
      "properties": {
        "term_key": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/domain" },
        "severity_rank": { "$ref": "#/$defs/severity_rank" },
        "action_order_index": { "type": "integer", "minimum": 0 },
        "durable": { "type": "boolean" },
        "source_term": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "translations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/translation" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_terms",
        "domains_covered",
        "claimed_locales",
        "durable_term_count",
        "max_expansion_ratio_pct"
      ],
      "properties": {
        "total_terms": { "type": "integer", "minimum": 0 },
        "domains_covered": {
          "type": "array",
          "items": { "$ref": "#/$defs/domain" }
        },
        "claimed_locales": {
          "type": "array",
          "items": { "type": "string" }
        },
        "durable_term_count": { "type": "integer", "minimum": 0 },
        "max_expansion_ratio_pct": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
