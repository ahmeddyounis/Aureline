{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/localized-claim-status.schema.json",
  "title": "Aureline localized-profile qualification and locale-bearing claim-status packet",
  "description": "Canonical packet that certifies each claimed localized M5 profile against the distinct localization evidence lanes a stable-profile claim depends on (pseudoloc, text expansion, RTL/bidi, IME composition, translated-help parity, and locale-pack compatibility). It auto-narrows a localized claim to source-language fallback when a required lane is stale or missing, blocks it when a lane is failing, and publishes the known limits and downgrade reasons that Help/About, release center, diagnostics, and support export ingest. Raw translated bodies, raw URLs, signing keys, and credentials do not cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "source_language_locale",
    "release_channel",
    "target_build_identity_ref",
    "source_contract_refs",
    "runtime_consumer_refs",
    "evidence_lane_refs",
    "claimed_profiles",
    "known_limits",
    "consumption_bindings",
    "release_gate_rows",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "localized_claim_status_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_language_locale": { "$ref": "#/$defs/locale" },
    "release_channel": { "type": "string", "minLength": 1 },
    "target_build_identity_ref": { "$ref": "#/$defs/stable_id" },
    "source_contract_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "runtime_consumer_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stable_id" },
      "uniqueItems": true
    },
    "evidence_lane_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "claimed_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/localized_profile_claim_row" }
    },
    "known_limits": {
      "type": "array",
      "items": { "$ref": "#/$defs/known_limit_row" }
    },
    "consumption_bindings": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/consumption_binding_row" }
    },
    "release_gate_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release_gate_row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "qualification_lane_kind": {
      "type": "string",
      "enum": [
        "pseudolocalization",
        "text_expansion",
        "rtl_bidi",
        "ime_composition",
        "translated_help_parity",
        "locale_pack_compatibility"
      ]
    },
    "lane_evidence_state": {
      "type": "string",
      "enum": ["current_passing", "current_failing", "stale", "missing", "waived_bounded"]
    },
    "lane_narrow_cause": {
      "type": "string",
      "enum": ["evidence_failing", "evidence_stale", "evidence_missing"]
    },
    "profile_claim_class": {
      "type": "string",
      "enum": ["claimed_localized", "source_language_fallback_only", "not_localized"]
    },
    "gate_state": {
      "type": "string",
      "enum": ["green", "narrowed", "blocked"]
    },
    "text_direction": {
      "type": "string",
      "enum": ["left_to_right", "right_to_left"]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "shell_chrome",
        "command_palette",
        "help_and_docs",
        "cli_and_doctor",
        "notifications",
        "extension_contributed_ui",
        "companion_handoff",
        "notebook_tooling",
        "data_and_api_tooling",
        "guided_learning",
        "support_flows",
        "release_and_about"
      ]
    },
    "consumer_kind": {
      "type": "string",
      "enum": [
        "release_center",
        "help_about",
        "diagnostics",
        "claim_narrowing",
        "support_export",
        "docs_browser"
      ]
    },
    "profile_lane_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_kind",
        "evidence_state",
        "evidence_packet_ref",
        "evidence_fixture_ref",
        "required_for_claim",
        "detail"
      ],
      "properties": {
        "lane_kind": { "$ref": "#/$defs/qualification_lane_kind" },
        "evidence_state": { "$ref": "#/$defs/lane_evidence_state" },
        "evidence_packet_ref": { "$ref": "#/$defs/stable_id" },
        "evidence_fixture_ref": { "type": "string", "minLength": 1 },
        "required_for_claim": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 },
        "waiver_ref": { "$ref": "#/$defs/stable_id" },
        "narrow_cause": { "$ref": "#/$defs/lane_narrow_cause" }
      }
    },
    "localized_profile_claim_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "title",
        "requested_locale",
        "source_language_locale",
        "text_direction",
        "fallback_chain",
        "primary_pack_ref",
        "intended_claim_class",
        "effective_claim_class",
        "gate_state",
        "narrowed",
        "blocks_promotion",
        "lane_results",
        "satisfied_lane_count",
        "stale_or_missing_lane_count",
        "failing_lane_count",
        "waived_lane_count",
        "affected_lane_kinds",
        "source_language_route_ref",
        "visible_in_settings",
        "visible_in_help_about",
        "visible_in_release_center",
        "visible_in_diagnostics",
        "visible_in_support_export",
        "non_blocking_core_use"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/stable_id" },
        "title": { "type": "string", "minLength": 1 },
        "requested_locale": { "$ref": "#/$defs/locale" },
        "source_language_locale": { "$ref": "#/$defs/locale" },
        "text_direction": { "$ref": "#/$defs/text_direction" },
        "fallback_chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locale" }
        },
        "primary_pack_ref": { "$ref": "#/$defs/stable_id" },
        "intended_claim_class": { "$ref": "#/$defs/profile_claim_class" },
        "effective_claim_class": { "$ref": "#/$defs/profile_claim_class" },
        "gate_state": { "$ref": "#/$defs/gate_state" },
        "narrowed": { "type": "boolean" },
        "blocks_promotion": { "type": "boolean" },
        "lane_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/profile_lane_result" }
        },
        "satisfied_lane_count": { "type": "integer", "minimum": 0 },
        "stale_or_missing_lane_count": { "type": "integer", "minimum": 0 },
        "failing_lane_count": { "type": "integer", "minimum": 0 },
        "waived_lane_count": { "type": "integer", "minimum": 0 },
        "affected_lane_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualification_lane_kind" },
          "uniqueItems": true
        },
        "source_language_route_ref": { "$ref": "#/$defs/stable_id" },
        "visible_in_settings": { "type": "boolean" },
        "visible_in_help_about": { "type": "boolean" },
        "visible_in_release_center": { "type": "boolean" },
        "visible_in_diagnostics": { "type": "boolean" },
        "visible_in_support_export": { "type": "boolean" },
        "non_blocking_core_use": { "type": "boolean" }
      }
    },
    "known_limit_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit_id",
        "profile_id_ref",
        "lane_kind",
        "cause",
        "gate_state",
        "summary",
        "affected_surface_families",
        "source_language_route_ref",
        "published_to"
      ],
      "properties": {
        "limit_id": { "$ref": "#/$defs/stable_id" },
        "profile_id_ref": { "$ref": "#/$defs/stable_id" },
        "lane_kind": { "$ref": "#/$defs/qualification_lane_kind" },
        "cause": { "$ref": "#/$defs/lane_narrow_cause" },
        "gate_state": { "$ref": "#/$defs/gate_state" },
        "summary": { "type": "string", "minLength": 1 },
        "affected_surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" },
          "uniqueItems": true
        },
        "source_language_route_ref": { "$ref": "#/$defs/stable_id" },
        "published_to": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_kind" },
          "uniqueItems": true
        }
      }
    },
    "consumption_binding_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer_kind", "consumer_ref", "ingests_summary", "consumed_fields"],
      "properties": {
        "consumer_kind": { "$ref": "#/$defs/consumer_kind" },
        "consumer_ref": { "$ref": "#/$defs/stable_id" },
        "ingests_summary": { "type": "string", "minLength": 1 },
        "consumed_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "release_gate_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "proof_kind",
        "command",
        "fixture_refs",
        "artifact_refs",
        "required_for_claimed_profiles",
        "gate_state"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/stable_id" },
        "proof_kind": { "$ref": "#/$defs/stable_id" },
        "command": { "type": "string", "minLength": 1 },
        "fixture_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_for_claimed_profiles": { "type": "boolean" },
        "gate_state": { "$ref": "#/$defs/gate_state" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_profiles",
        "claimed_localized_profiles",
        "narrowed_profiles",
        "blocked_profiles",
        "not_localized_profiles",
        "total_lane_results",
        "satisfied_lane_results",
        "stale_or_missing_lane_results",
        "failing_lane_results",
        "waived_lane_results",
        "published_known_limits",
        "promotion_state"
      ],
      "properties": {
        "total_profiles": { "type": "integer", "minimum": 0 },
        "claimed_localized_profiles": { "type": "integer", "minimum": 0 },
        "narrowed_profiles": { "type": "integer", "minimum": 0 },
        "blocked_profiles": { "type": "integer", "minimum": 0 },
        "not_localized_profiles": { "type": "integer", "minimum": 0 },
        "total_lane_results": { "type": "integer", "minimum": 0 },
        "satisfied_lane_results": { "type": "integer", "minimum": 0 },
        "stale_or_missing_lane_results": { "type": "integer", "minimum": 0 },
        "failing_lane_results": { "type": "integer", "minimum": 0 },
        "waived_lane_results": { "type": "integer", "minimum": 0 },
        "published_known_limits": { "type": "integer", "minimum": 0 },
        "promotion_state": { "$ref": "#/$defs/gate_state" }
      }
    }
  }
}
