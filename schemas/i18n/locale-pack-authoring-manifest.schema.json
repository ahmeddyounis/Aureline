{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/locale-pack-authoring-manifest.schema.json",
  "title": "Aureline locale-pack authoring manifest",
  "description": "Author-facing manifest a contributor writes to declare a locale pack or translated overlay before it is signed and admitted. It names the pack identity, owner class, locale and fallback behavior, compatibility build range, the surface families and namespace it owns, its coverage claim, and its host-stable-label posture. The contribution validator checks this manifest together with the pack's strings and glossary files. It carries refs and metadata only: no translated bodies, signing keys, or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "pack_id",
    "owner_id",
    "owner_class",
    "locale",
    "source_language_locale",
    "fallback_locale",
    "fallback_chain",
    "compatibility_build_range",
    "owned_surface_families",
    "discloses_source_language_fallback",
    "claims_complete_coverage",
    "may_override_host_stable_labels",
    "strings_refs",
    "presentation_label"
  ],
  "properties": {
    "record_kind": { "const": "locale_pack_authoring_manifest" },
    "schema_version": { "const": 1 },
    "pack_id": { "$ref": "#/$defs/stable_id" },
    "owner_id": { "$ref": "#/$defs/stable_id" },
    "owner_class": { "$ref": "#/$defs/owner_class" },
    "locale": { "$ref": "#/$defs/locale" },
    "source_language_locale": { "$ref": "#/$defs/locale" },
    "fallback_locale": { "$ref": "#/$defs/locale" },
    "fallback_chain": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/locale" }
    },
    "compatibility_build_range": { "$ref": "#/$defs/compatibility_build_range" },
    "owned_surface_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/surface_family" }
    },
    "owned_namespace_prefix": {
      "type": "string",
      "minLength": 1,
      "description": "Required for extension-owned and companion-overlay packs: the reserved id prefix the pack may write into. Omitted for first-party and community packs that translate host message ids."
    },
    "discloses_source_language_fallback": {
      "type": "boolean",
      "description": "Must be true: untranslated keys fall back to the source language with the fallback disclosed."
    },
    "claims_complete_coverage": {
      "type": "boolean",
      "description": "True only when the pack translates every host message id for its owned surfaces. A complete-coverage claim with missing keys fails validation."
    },
    "may_override_host_stable_labels": {
      "type": "boolean",
      "description": "Must be false. Host-stable trust, policy, capability, lifecycle, recovery, and AI-safety labels are rendered from the host catalog and can never be replaced."
    },
    "host_stable_labels_referenced": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/host_stable_label_class" }
    },
    "signature": { "$ref": "#/$defs/signature" },
    "strings_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "glossary_ref": { "type": "string", "minLength": 1 },
    "presentation_label": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "stable_id": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "owner_class": {
      "enum": [
        "first_party_pack",
        "community_pack",
        "extension_owned_pack",
        "companion_overlay_pack"
      ]
    },
    "host_stable_label_class": {
      "enum": ["trust_label", "policy_label", "capability_label", "lifecycle_label", "recovery_label"]
    },
    "surface_family": {
      "enum": [
        "shell_chrome",
        "command_label",
        "settings_help_or_error",
        "docs_tour_or_auth_text",
        "extension_contributed_ui",
        "cli_help_text",
        "export_or_report_heading",
        "screenshot_or_demo_caption",
        "glossary_or_terminology_term",
        "policy_legal_or_recovery_text",
        "pseudoloc_only_test_string"
      ]
    },
    "compatibility_build_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_build_identity_ref", "max_build_identity_ref"],
      "properties": {
        "min_build_identity_ref": { "$ref": "#/$defs/stable_id" },
        "max_build_identity_ref": { "$ref": "#/$defs/stable_id" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": [
            "signed_verified",
            "signed_unverified",
            "unsigned_explicit_acceptance",
            "signature_failed_blocked",
            "not_applicable_built_in"
          ]
        },
        "signer_identity_ref": { "$ref": "#/$defs/stable_id" },
        "signature_artifact_ref": { "$ref": "#/$defs/stable_id" }
      }
    }
  }
}
