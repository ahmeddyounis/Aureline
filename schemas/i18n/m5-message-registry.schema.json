{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/m5-message-registry.schema.json",
  "title": "Aureline M5 stable message-id registry",
  "description": "Canonical catalog that binds every translatable string on the new M5 shell, command, settings, help, error, and notification surfaces to a stable, locale-neutral message id and a stable source-language key, alongside the command, setting, diagnostic, telemetry, and policy refs that business logic routes by. Settings, Help/About, diagnostics, and support-export surfaces ingest this packet instead of cloning localization status text. Raw translated bodies, signing keys, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "source_language_locale",
    "target_build_identity_ref",
    "baseline_build_identity_ref",
    "source_contract_refs",
    "runtime_consumer_refs",
    "entries",
    "locale_profiles",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_message_registry_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_language_locale": { "$ref": "#/$defs/locale" },
    "target_build_identity_ref": { "$ref": "#/$defs/stable_id" },
    "baseline_build_identity_ref": { "$ref": "#/$defs/stable_id" },
    "source_contract_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "runtime_consumer_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stable_id" },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/entry" }
    },
    "locale_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/locale_profile" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "stable_id": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "surface": {
      "enum": [
        "shell_chrome",
        "command_palette",
        "settings",
        "help",
        "error",
        "notification"
      ]
    },
    "message_id_class": {
      "enum": [
        "stable_canonical",
        "extension_overlay",
        "derived_with_upstream_id",
        "pseudoloc_test_only"
      ]
    },
    "machine_output_locale_class": {
      "enum": [
        "locale_neutral_canonical",
        "locale_neutral_with_translated_human_field",
        "locale_native_human_only",
        "forbidden_for_machine_output"
      ]
    },
    "escape_hatch": {
      "enum": [
        "inline_source_language_toggle",
        "command_open_in_source_language",
        "docs_pane_source_language_route",
        "cli_locale_neutral_output_flag",
        "export_in_source_language_for_review"
      ]
    },
    "fallback_origin": {
      "enum": [
        "requested_locale_authoritative",
        "requested_locale_partial_with_base_fill",
        "base_locale_fallback",
        "source_language_fallback",
        "pack_signature_failed_source_language_only",
        "pack_missing_source_language_only",
        "policy_disabled_source_language_only"
      ]
    },
    "degraded_state": {
      "enum": [
        "fully_localized",
        "partial_translation_disclosed",
        "mixed_locale_strict_separation",
        "glossary_only_localized",
        "source_language_with_pseudoloc",
        "failed_pack_source_language_only"
      ]
    },
    "stable_refs": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "command_id_ref": { "$ref": "#/$defs/stable_id" },
        "semantic_action_id_ref": { "$ref": "#/$defs/stable_id" },
        "diagnostic_id_ref": { "$ref": "#/$defs/stable_id" },
        "docs_pack_key_ref": { "$ref": "#/$defs/stable_id" },
        "setting_id_ref": { "$ref": "#/$defs/stable_id" },
        "telemetry_key_ref": { "$ref": "#/$defs/stable_id" },
        "policy_name_ref": { "$ref": "#/$defs/stable_id" },
        "schema_id_ref": { "$ref": "#/$defs/stable_id" }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholder_id", "placeholder_kind", "translator_note"],
      "properties": {
        "placeholder_id": { "type": "string", "minLength": 1 },
        "placeholder_kind": { "type": "string", "minLength": 1 },
        "translator_note": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "source_language_key",
        "surface",
        "surface_family",
        "message_id_class",
        "source_language_locale",
        "source_text",
        "stable_refs",
        "placeholders",
        "machine_output_locale_class",
        "source_language_escape_hatches",
        "translated_in_locales",
        "localized_human_prose_allowed",
        "machine_identifier_fields_locale_neutral",
        "routed_by_localized_prose",
        "introduced_in_build_ref",
        "present_in_baseline_build"
      ],
      "properties": {
        "message_id": { "$ref": "#/$defs/stable_id" },
        "source_language_key": { "$ref": "#/$defs/stable_id" },
        "surface": { "$ref": "#/$defs/surface" },
        "surface_family": { "type": "string", "minLength": 1 },
        "message_id_class": { "$ref": "#/$defs/message_id_class" },
        "source_language_locale": { "$ref": "#/$defs/locale" },
        "source_text": { "type": "string", "minLength": 1 },
        "stable_refs": { "$ref": "#/$defs/stable_refs" },
        "placeholders": {
          "type": "array",
          "items": { "$ref": "#/$defs/placeholder" }
        },
        "machine_output_locale_class": { "$ref": "#/$defs/machine_output_locale_class" },
        "source_language_escape_hatches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/escape_hatch" },
          "uniqueItems": true
        },
        "translated_in_locales": {
          "type": "array",
          "items": { "$ref": "#/$defs/locale" },
          "uniqueItems": true
        },
        "localized_human_prose_allowed": { "type": "boolean" },
        "machine_identifier_fields_locale_neutral": { "const": true },
        "routed_by_localized_prose": { "const": false },
        "introduced_in_build_ref": { "$ref": "#/$defs/stable_id" },
        "present_in_baseline_build": { "type": "boolean" }
      }
    },
    "locale_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_locale",
        "effective_locale",
        "source_language_locale",
        "fallback_chain",
        "fallback_origin",
        "degraded_state",
        "source_language_route_active"
      ],
      "properties": {
        "requested_locale": { "$ref": "#/$defs/locale" },
        "effective_locale": { "$ref": "#/$defs/locale" },
        "source_language_locale": { "$ref": "#/$defs/locale" },
        "fallback_chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locale" }
        },
        "fallback_origin": { "$ref": "#/$defs/fallback_origin" },
        "degraded_state": { "$ref": "#/$defs/degraded_state" },
        "source_language_route_active": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_entries",
        "entries_by_surface",
        "baseline_entries",
        "newly_introduced_entries",
        "supported_locales",
        "fully_localized_locales",
        "source_language_fallback_locales",
        "continuity_stable",
        "source_language_locale"
      ],
      "properties": {
        "total_entries": { "type": "integer", "minimum": 1 },
        "entries_by_surface": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "baseline_entries": { "type": "integer", "minimum": 0 },
        "newly_introduced_entries": { "type": "integer", "minimum": 0 },
        "supported_locales": { "type": "integer", "minimum": 1 },
        "fully_localized_locales": { "type": "integer", "minimum": 0 },
        "source_language_fallback_locales": { "type": "integer", "minimum": 0 },
        "continuity_stable": { "type": "boolean" },
        "source_language_locale": { "$ref": "#/$defs/locale" }
      }
    }
  }
}
