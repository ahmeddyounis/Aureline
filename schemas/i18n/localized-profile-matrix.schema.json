{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/localized-profile-matrix.schema.json",
  "title": "Aureline localized-profile matrix, surface inventory, and fallback-chain truth packet",
  "description": "Canonical packet that freezes the localized profiles, the localizable surface inventory with owning packs and stable identifiers, the required fallback chain per profile, and the auto-narrowing of claims when pack compatibility or proof is missing. Release, Help/About, diagnostics, and claim-narrowing tooling ingest this packet instead of cloning localization status text. Raw translated bodies, raw URLs, signing keys, and credentials do not cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "source_contract_refs",
    "runtime_consumer_refs",
    "surface_inventory",
    "localized_profiles",
    "profile_surface_coverage",
    "consumption_bindings",
    "release_gate_rows",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "localized_profile_matrix_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_contract_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "runtime_consumer_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stable_id" },
      "uniqueItems": true
    },
    "surface_inventory": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/surface_inventory_row" }
    },
    "localized_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/localized_profile_row" }
    },
    "profile_surface_coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile_surface_coverage_row" }
    },
    "consumption_bindings": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/consumption_binding_row" }
    },
    "release_gate_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release_gate_row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@#/-]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "surface_localization_state": {
      "type": "string",
      "enum": ["localized", "source_language_fallback_only", "not_localized"]
    },
    "profile_claim_class": {
      "type": "string",
      "enum": ["claimed_localized", "source_language_fallback_only", "not_localized"]
    },
    "pack_compatibility_state": {
      "type": "string",
      "enum": ["compatible", "incompatible", "unverified", "missing", "not_applicable"]
    },
    "evidence_freshness_state": {
      "type": "string",
      "enum": ["current", "stale", "missing", "not_required"]
    },
    "claim_narrow_reason": {
      "type": "string",
      "enum": [
        "pack_missing",
        "pack_incompatible",
        "pack_unverified",
        "evidence_missing",
        "evidence_stale"
      ]
    },
    "matrix_gate_state": {
      "type": "string",
      "enum": ["green", "narrowed", "blocked"]
    },
    "surface_family": {
      "type": "string",
      "enum": [
        "shell_chrome",
        "command_palette",
        "help_and_docs",
        "cli_and_doctor",
        "notifications",
        "extension_contributed_ui",
        "companion_handoff",
        "notebook_tooling",
        "data_and_api_tooling",
        "guided_learning",
        "support_flows",
        "release_and_about"
      ]
    },
    "stable_element_kind": {
      "type": "string",
      "enum": [
        "command_id",
        "canonical_verb",
        "keybinding_path",
        "cli_subcommand_name",
        "cli_flag_literal",
        "json_key",
        "schema_id",
        "setting_id",
        "policy_id",
        "telemetry_key",
        "error_code_or_finding_id",
        "docs_anchor_id",
        "citation_anchor_id",
        "recovery_route_id",
        "notification_id",
        "extension_namespace_id",
        "host_stable_identifier"
      ]
    },
    "machine_output_locale_class": {
      "type": "string",
      "enum": [
        "locale_neutral_canonical",
        "locale_neutral_with_translated_human_field",
        "locale_native_human_only",
        "forbidden_for_machine_output"
      ]
    },
    "consumer_kind": {
      "type": "string",
      "enum": [
        "release_center",
        "help_about",
        "diagnostics",
        "claim_narrowing",
        "support_export",
        "docs_browser"
      ]
    },
    "surface_inventory_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "title",
        "surface_family",
        "owning_pack_ref",
        "stable_element_kinds",
        "localizable_element_summary",
        "source_language_route_ref",
        "machine_output_locale_class"
      ],
      "properties": {
        "surface_id": { "$ref": "#/$defs/stable_id" },
        "title": { "type": "string", "minLength": 1 },
        "surface_family": { "$ref": "#/$defs/surface_family" },
        "owning_pack_ref": { "$ref": "#/$defs/stable_id" },
        "stable_element_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stable_element_kind" },
          "uniqueItems": true
        },
        "localizable_element_summary": { "type": "string", "minLength": 1 },
        "source_language_route_ref": { "$ref": "#/$defs/stable_id" },
        "machine_output_locale_class": { "$ref": "#/$defs/machine_output_locale_class" }
      }
    },
    "localized_profile_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "title",
        "requested_locale",
        "source_language_locale",
        "fallback_chain",
        "primary_pack_ref",
        "supporting_pack_refs",
        "intended_claim_class",
        "claim_class",
        "narrowed",
        "source_language_route_ref",
        "visible_in_settings",
        "visible_in_diagnostics",
        "visible_in_support_export",
        "visible_in_help_about",
        "non_blocking_core_use"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/stable_id" },
        "title": { "type": "string", "minLength": 1 },
        "requested_locale": { "$ref": "#/$defs/locale" },
        "source_language_locale": { "$ref": "#/$defs/locale" },
        "fallback_chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locale" }
        },
        "primary_pack_ref": { "$ref": "#/$defs/stable_id" },
        "supporting_pack_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" },
          "uniqueItems": true
        },
        "intended_claim_class": { "$ref": "#/$defs/profile_claim_class" },
        "claim_class": { "$ref": "#/$defs/profile_claim_class" },
        "narrowed": { "type": "boolean" },
        "narrow_reason": { "$ref": "#/$defs/claim_narrow_reason" },
        "source_language_route_ref": { "$ref": "#/$defs/stable_id" },
        "visible_in_settings": { "type": "boolean" },
        "visible_in_diagnostics": { "type": "boolean" },
        "visible_in_support_export": { "type": "boolean" },
        "visible_in_help_about": { "type": "boolean" },
        "non_blocking_core_use": { "type": "boolean" }
      }
    },
    "profile_surface_coverage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "profile_id_ref",
        "surface_id_ref",
        "claimed_localization_state",
        "pack_ref",
        "pack_compatibility",
        "evidence_refs",
        "evidence_freshness",
        "required_for_claim",
        "effective_localization_state",
        "narrowed",
        "gate_state"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/stable_id" },
        "profile_id_ref": { "$ref": "#/$defs/stable_id" },
        "surface_id_ref": { "$ref": "#/$defs/stable_id" },
        "claimed_localization_state": { "$ref": "#/$defs/surface_localization_state" },
        "pack_ref": { "$ref": "#/$defs/stable_id" },
        "pack_compatibility": { "$ref": "#/$defs/pack_compatibility_state" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_freshness": { "$ref": "#/$defs/evidence_freshness_state" },
        "required_for_claim": { "type": "boolean" },
        "effective_localization_state": { "$ref": "#/$defs/surface_localization_state" },
        "narrowed": { "type": "boolean" },
        "narrow_reason": { "$ref": "#/$defs/claim_narrow_reason" },
        "gate_state": { "$ref": "#/$defs/matrix_gate_state" }
      }
    },
    "consumption_binding_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer_kind", "consumer_ref", "ingests_summary", "consumed_fields"],
      "properties": {
        "consumer_kind": { "$ref": "#/$defs/consumer_kind" },
        "consumer_ref": { "$ref": "#/$defs/stable_id" },
        "ingests_summary": { "type": "string", "minLength": 1 },
        "consumed_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "release_gate_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "proof_kind",
        "command",
        "fixture_refs",
        "artifact_refs",
        "required_for_claimed_profiles",
        "gate_state"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/stable_id" },
        "proof_kind": { "$ref": "#/$defs/stable_id" },
        "command": { "type": "string", "minLength": 1 },
        "fixture_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_for_claimed_profiles": { "type": "boolean" },
        "gate_state": { "$ref": "#/$defs/matrix_gate_state" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_surfaces",
        "total_profiles",
        "claimed_localized_profiles",
        "source_language_fallback_profiles",
        "not_localized_profiles",
        "narrowed_profiles",
        "localized_surface_cells",
        "source_language_fallback_cells",
        "not_localized_cells",
        "narrowed_cells",
        "blocked_rows",
        "promotion_state"
      ],
      "properties": {
        "total_surfaces": { "type": "integer", "minimum": 0 },
        "total_profiles": { "type": "integer", "minimum": 0 },
        "claimed_localized_profiles": { "type": "integer", "minimum": 0 },
        "source_language_fallback_profiles": { "type": "integer", "minimum": 0 },
        "not_localized_profiles": { "type": "integer", "minimum": 0 },
        "narrowed_profiles": { "type": "integer", "minimum": 0 },
        "localized_surface_cells": { "type": "integer", "minimum": 0 },
        "source_language_fallback_cells": { "type": "integer", "minimum": 0 },
        "not_localized_cells": { "type": "integer", "minimum": 0 },
        "narrowed_cells": { "type": "integer", "minimum": 0 },
        "blocked_rows": { "type": "integer", "minimum": 0 },
        "promotion_state": { "$ref": "#/$defs/matrix_gate_state" }
      }
    }
  }
}
