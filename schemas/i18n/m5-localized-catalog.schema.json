{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/m5-localized-catalog.schema.json",
  "title": "Aureline M5 localized prose catalog",
  "description": "First-party localized display strings for the new M5 shell, command, settings, help, error, and notification surfaces, bound to the stable message ids of the M5 message registry. Holds exactly the (message_id, locale) pairs the registry declares translated; each string preserves its message's placeholder tokens. This catalog is the locale-pack content and does carry translated bodies; downstream support exports omit them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "catalog_id",
    "generated_at",
    "source_language_locale",
    "target_build_identity_ref",
    "registry_packet_id_ref",
    "claimed_locales",
    "strings",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "m5_localized_catalog_packet" },
    "schema_version": { "const": 1 },
    "catalog_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_language_locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "target_build_identity_ref": { "type": "string", "minLength": 1 },
    "registry_packet_id_ref": { "type": "string", "minLength": 1 },
    "claimed_locales": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "locale", "text_direction", "localized_text"],
        "properties": {
          "message_id": { "type": "string", "minLength": 1 },
          "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "text_direction": { "enum": ["left_to_right", "right_to_left"] },
          "localized_text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_strings",
        "strings_by_locale",
        "translated_message_ids",
        "claimed_locales"
      ],
      "properties": {
        "total_strings": { "type": "integer", "minimum": 0 },
        "strings_by_locale": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "translated_message_ids": { "type": "integer", "minimum": 0 },
        "claimed_locales": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
