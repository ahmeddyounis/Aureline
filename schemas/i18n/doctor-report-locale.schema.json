{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/doctor-report-locale.schema.json",
  "title": "Aureline Project Doctor report localization posture",
  "description": "Truth packet that lets Project Doctor finding titles, explanations, and recommended-action prose localize while finding codes, probe ids, canonical exit classes, evidence-ref kinds, scope labels, and recovery command ids stay locale-neutral. Fallback profiles expose the requested-to-source chain per locale, and the metadata-only support export keeps active locale, fallback, and finding codes inspectable on exported Doctor and support artifacts while omitting raw translated bodies and evidence payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "generated_at",
    "source_language_locale",
    "target_build_identity_ref",
    "source_contract_refs",
    "runtime_consumer_refs",
    "entries",
    "locale_profiles",
    "support_export",
    "summary"
  ],
  "properties": {
    "record_kind": { "const": "doctor_report_localization_packet" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/stable_id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_language_locale": { "$ref": "#/$defs/locale" },
    "target_build_identity_ref": { "$ref": "#/$defs/stable_id" },
    "source_contract_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "runtime_consumer_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stable_id" },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/entry" }
    },
    "locale_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/locale_profile" }
    },
    "support_export": { "$ref": "#/$defs/support_export" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "stable_id": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "surface": {
      "enum": [
        "finding_title",
        "finding_explanation",
        "recommended_action",
        "unsupported_state_note",
        "report_heading",
        "support_export_heading"
      ]
    },
    "machine_output_locale_class": {
      "enum": [
        "locale_neutral_canonical",
        "locale_neutral_with_translated_human_field",
        "locale_native_human_only",
        "forbidden_for_machine_output"
      ]
    },
    "escape_hatch": {
      "enum": [
        "inline_source_language_toggle",
        "command_open_in_source_language",
        "docs_pane_source_language_route",
        "cli_locale_neutral_output_flag",
        "export_in_source_language_for_review"
      ]
    },
    "fallback_origin": {
      "enum": [
        "requested_locale_authoritative",
        "requested_locale_partial_with_base_fill",
        "base_locale_fallback",
        "source_language_fallback",
        "pack_signature_failed_source_language_only",
        "pack_missing_source_language_only",
        "policy_disabled_source_language_only"
      ]
    },
    "degraded_state": {
      "enum": [
        "fully_localized",
        "partial_translation_disclosed",
        "mixed_locale_strict_separation",
        "glossary_only_localized",
        "source_language_with_pseudoloc",
        "failed_pack_source_language_only"
      ]
    },
    "doctor_refs": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "finding_code_ref": { "$ref": "#/$defs/stable_id" },
        "probe_id_ref": { "$ref": "#/$defs/stable_id" },
        "exit_class_ref": { "$ref": "#/$defs/stable_id" },
        "evidence_ref_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stable_id" },
          "uniqueItems": true
        },
        "scope_label_ref": { "$ref": "#/$defs/stable_id" },
        "recovery_command_id_ref": { "$ref": "#/$defs/stable_id" },
        "policy_name_ref": { "$ref": "#/$defs/stable_id" },
        "docs_pack_key_ref": { "$ref": "#/$defs/stable_id" },
        "telemetry_key_ref": { "$ref": "#/$defs/stable_id" }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholder_id", "placeholder_kind", "translator_note"],
      "properties": {
        "placeholder_id": { "type": "string", "minLength": 1 },
        "placeholder_kind": { "type": "string", "minLength": 1 },
        "translator_note": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "source_language_key",
        "surface",
        "surface_family",
        "source_language_locale",
        "source_text",
        "doctor_refs",
        "placeholders",
        "machine_output_locale_class",
        "source_language_escape_hatches",
        "translated_in_locales",
        "localized_human_prose_allowed",
        "machine_identifier_fields_locale_neutral",
        "routed_by_localized_prose"
      ],
      "properties": {
        "message_id": { "$ref": "#/$defs/stable_id" },
        "source_language_key": { "$ref": "#/$defs/stable_id" },
        "surface": { "$ref": "#/$defs/surface" },
        "surface_family": { "type": "string", "minLength": 1 },
        "source_language_locale": { "$ref": "#/$defs/locale" },
        "source_text": { "type": "string", "minLength": 1 },
        "doctor_refs": { "$ref": "#/$defs/doctor_refs" },
        "placeholders": {
          "type": "array",
          "items": { "$ref": "#/$defs/placeholder" }
        },
        "machine_output_locale_class": { "$ref": "#/$defs/machine_output_locale_class" },
        "source_language_escape_hatches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/escape_hatch" },
          "uniqueItems": true
        },
        "translated_in_locales": {
          "type": "array",
          "items": { "$ref": "#/$defs/locale" },
          "uniqueItems": true
        },
        "localized_human_prose_allowed": { "type": "boolean" },
        "machine_identifier_fields_locale_neutral": { "const": true },
        "routed_by_localized_prose": { "const": false }
      }
    },
    "locale_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_locale",
        "effective_locale",
        "source_language_locale",
        "fallback_chain",
        "fallback_origin",
        "degraded_state",
        "source_language_route_active",
        "missing_key_count"
      ],
      "properties": {
        "requested_locale": { "$ref": "#/$defs/locale" },
        "effective_locale": { "$ref": "#/$defs/locale" },
        "source_language_locale": { "$ref": "#/$defs/locale" },
        "fallback_chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locale" }
        },
        "fallback_origin": { "$ref": "#/$defs/fallback_origin" },
        "degraded_state": { "$ref": "#/$defs/degraded_state" },
        "source_language_route_active": { "type": "boolean" },
        "missing_key_count": { "type": "integer", "minimum": 0 }
      }
    },
    "support_export_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "source_language_key",
        "surface_key",
        "stable_anchor_refs",
        "effective_locale",
        "used_source_language_fallback",
        "raw_translated_body_omitted"
      ],
      "properties": {
        "message_id": { "$ref": "#/$defs/stable_id" },
        "source_language_key": { "$ref": "#/$defs/stable_id" },
        "surface_key": { "type": "string", "minLength": 1 },
        "finding_code_ref": { "$ref": "#/$defs/stable_id" },
        "stable_anchor_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "effective_locale": { "$ref": "#/$defs/locale" },
        "used_source_language_fallback": { "type": "boolean" },
        "raw_translated_body_omitted": { "const": true }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "export_id",
        "source_packet_id",
        "requested_locale",
        "effective_locale",
        "source_language_locale",
        "fallback_chain",
        "fallback_origin",
        "degraded_state",
        "missing_key_count",
        "source_language_route_active",
        "preserved_finding_codes",
        "rows",
        "raw_translated_bodies_exported",
        "omitted_material_classes",
        "generated_at"
      ],
      "properties": {
        "record_kind": { "const": "doctor_report_locale_support_export" },
        "schema_version": { "const": 1 },
        "export_id": { "$ref": "#/$defs/stable_id" },
        "source_packet_id": { "$ref": "#/$defs/stable_id" },
        "requested_locale": { "$ref": "#/$defs/locale" },
        "effective_locale": { "$ref": "#/$defs/locale" },
        "source_language_locale": { "$ref": "#/$defs/locale" },
        "fallback_chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locale" }
        },
        "fallback_origin": { "$ref": "#/$defs/fallback_origin" },
        "degraded_state": { "$ref": "#/$defs/degraded_state" },
        "missing_key_count": { "type": "integer", "minimum": 0 },
        "source_language_route_active": { "type": "boolean" },
        "preserved_finding_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stable_id" },
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/support_export_row" }
        },
        "raw_translated_bodies_exported": { "const": false },
        "omitted_material_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_entries",
        "entries_by_surface",
        "finding_codes_covered",
        "supported_locales",
        "fully_localized_locales",
        "source_language_fallback_locales",
        "preserved_anchor_count",
        "source_language_locale"
      ],
      "properties": {
        "total_entries": { "type": "integer", "minimum": 1 },
        "entries_by_surface": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "finding_codes_covered": { "type": "integer", "minimum": 1 },
        "supported_locales": { "type": "integer", "minimum": 1 },
        "fully_localized_locales": { "type": "integer", "minimum": 0 },
        "source_language_fallback_locales": { "type": "integer", "minimum": 0 },
        "preserved_anchor_count": { "type": "integer", "minimum": 0 },
        "source_language_locale": { "$ref": "#/$defs/locale" }
      }
    }
  }
}
