{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/i18n/locale-pack.schema.json",
  "title": "Aureline versioned locale-pack delivery artifact",
  "description": "Static, shippable locale-pack artifact: a versioned, signed, mirrorable record carrying a compatibility build range, signer identity, mirrorability metadata, an integrity digest, and per-surface translation coverage. Whether the pack renders in a given environment is decided by runtime compatibility evaluation, not by this artifact. Raw translated message bodies, signing keys, and credentials never cross this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "pack_id",
    "pack_version",
    "pack_revision_ref",
    "locale",
    "coverage_locales",
    "source_language_locale",
    "base_locale_fallback_chain",
    "source_class",
    "distribution_class",
    "integrity_digest_sha256",
    "mirrorability_class",
    "mirror_receipt_refs",
    "compatibility_build_range",
    "rollback_ref",
    "surface_coverage",
    "presentation_label",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "locale_pack_artifact_record" },
    "schema_version": { "const": 1 },
    "pack_id": { "$ref": "#/$defs/stable_id" },
    "pack_version": { "type": "string", "minLength": 1 },
    "pack_revision_ref": { "$ref": "#/$defs/stable_id" },
    "locale": { "$ref": "#/$defs/locale" },
    "coverage_locales": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/locale" },
      "uniqueItems": true
    },
    "source_language_locale": { "$ref": "#/$defs/locale" },
    "base_locale_fallback_chain": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/locale" }
    },
    "source_class": { "$ref": "#/$defs/source_class" },
    "distribution_class": { "$ref": "#/$defs/distribution_class" },
    "signer_identity_ref": { "$ref": "#/$defs/stable_id" },
    "signature_artifact_ref": { "$ref": "#/$defs/stable_id" },
    "integrity_digest_sha256": { "$ref": "#/$defs/sha256_hex" },
    "mirrorability_class": { "$ref": "#/$defs/mirrorability_class" },
    "mirror_receipt_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/stable_id" }
    },
    "offline_import_ref": { "$ref": "#/$defs/stable_id" },
    "compatibility_build_range": { "$ref": "#/$defs/compatibility_build_range" },
    "rollback_ref": { "$ref": "#/$defs/stable_id" },
    "surface_coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface_coverage" }
    },
    "presentation_label": { "type": "string", "minLength": 1 },
    "minted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "stable_id": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_class": {
      "enum": [
        "first_party_source_language",
        "first_party_locale_pack",
        "reviewed_community_pack",
        "extension_owned_pack"
      ]
    },
    "distribution_class": {
      "enum": [
        "built_in_with_product",
        "mirrored_official_pack",
        "community_supplied_pack",
        "extension_overlay_pack",
        "air_gapped_offline_pack"
      ]
    },
    "mirrorability_class": {
      "enum": [
        "mirror_allowed",
        "mirror_with_attribution_required",
        "mirror_forbidden",
        "air_gapped_only",
        "not_mirrorable_signed_blob"
      ]
    },
    "compatibility_build_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_build_identity_ref", "max_build_identity_ref"],
      "properties": {
        "min_build_identity_ref": { "$ref": "#/$defs/stable_id" },
        "max_build_identity_ref": { "$ref": "#/$defs/stable_id" }
      }
    },
    "surface_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_family", "total_key_count", "translated_key_count"],
      "properties": {
        "surface_family": {
          "enum": [
            "shell_chrome",
            "command_label",
            "settings_help_or_error",
            "docs_tour_or_auth_text",
            "extension_contributed_ui",
            "cli_help_text",
            "export_or_report_heading",
            "screenshot_or_demo_caption",
            "glossary_or_terminology_term",
            "policy_legal_or_recovery_text",
            "pseudoloc_only_test_string"
          ]
        },
        "total_key_count": { "type": "integer", "minimum": 0 },
        "translated_key_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
