{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ecosystem/m5-sideload-review.schema.json",
  "title": "Aureline M5 sideload review sheets",
  "description": "Schema for the m5_sideload_review packet. The packet freezes one reviewed-install model per unpacked or archive-backed side-load of a marketed M5 artifact family. A side-load never reaches the registry first, so the review sheet is the only place its source identity, signing state, requested permissions, disclosed external executables, and registry-binding decision (stay local, bind to the registry later, or already bound) are made explicit before install or reload. Three published values are recomputed from each sheet's facts and the stored values must equal the recomputation: the rendered trust tier is capped by both the signing state and the registry-binding decision, so a locally-built or side-loaded artifact never inherits a verified-publisher or enterprise-approved badge; the review-trigger set is computed from the installed baseline, so a permission widening, runtime-class change, host/ABI rebind, newly introduced external executable, changed registry binding, or changed release channel forces a fresh review instead of a silent hot reload; and the disposition is the stronger of that trigger gate and a hard block for a revoked signature or an anti-abuse quarantine. A reload that does not rebind to the registry preserves the installed row's limited-trust continuity rather than silently raising its badge. The model is metadata-only: every field is a typed state, a redacted display hint, or an opaque ref, and it carries no absolute filesystem paths, raw archive bytes, signing secrets, or external-executable payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "package_kinds",
    "source_classes",
    "runtime_classes",
    "host_abi_classes",
    "signature_states",
    "trust_postures",
    "anti_abuse_states",
    "source_kinds",
    "source_path_classes",
    "update_bindings",
    "release_channels",
    "permission_scope_kinds",
    "permission_changes",
    "external_executable_classes",
    "executable_changes",
    "install_kinds",
    "review_triggers",
    "dispositions",
    "action_kinds",
    "review_sheets",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_sideload_review" },
    "packet_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "package_kinds": { "type": "array", "items": { "$ref": "#/$defs/package_kind" } },
    "source_classes": { "type": "array", "items": { "$ref": "#/$defs/source_class" } },
    "runtime_classes": { "type": "array", "items": { "$ref": "#/$defs/runtime_class" } },
    "host_abi_classes": { "type": "array", "items": { "$ref": "#/$defs/host_abi_class" } },
    "signature_states": { "type": "array", "items": { "$ref": "#/$defs/signature_state" } },
    "trust_postures": { "type": "array", "items": { "$ref": "#/$defs/trust_posture" } },
    "anti_abuse_states": { "type": "array", "items": { "$ref": "#/$defs/anti_abuse_state" } },
    "source_kinds": { "type": "array", "items": { "$ref": "#/$defs/source_kind" } },
    "source_path_classes": { "type": "array", "items": { "$ref": "#/$defs/source_path_class" } },
    "update_bindings": { "type": "array", "items": { "$ref": "#/$defs/update_binding" } },
    "release_channels": { "type": "array", "items": { "$ref": "#/$defs/release_channel" } },
    "permission_scope_kinds": { "type": "array", "items": { "$ref": "#/$defs/permission_scope_kind" } },
    "permission_changes": { "type": "array", "items": { "$ref": "#/$defs/permission_change" } },
    "external_executable_classes": { "type": "array", "items": { "$ref": "#/$defs/external_executable_class" } },
    "executable_changes": { "type": "array", "items": { "$ref": "#/$defs/executable_change" } },
    "install_kinds": { "type": "array", "items": { "$ref": "#/$defs/install_kind" } },
    "review_triggers": { "type": "array", "items": { "$ref": "#/$defs/review_trigger" } },
    "dispositions": { "type": "array", "items": { "$ref": "#/$defs/disposition" } },
    "action_kinds": { "type": "array", "items": { "$ref": "#/$defs/action_kind" } },
    "review_sheets": { "type": "array", "items": { "$ref": "#/$defs/review_sheet" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "package_kind": {
      "type": "string",
      "enum": [
        "first_party_framework_pack",
        "docs_pack",
        "local_model_pack",
        "signed_recipe_pack",
        "template_artifact",
        "bridge_backed_package",
        "side_loaded_package",
        "mirrored_registry_variant"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": ["first_party", "verified_partner", "community", "unverified"]
    },
    "runtime_class": {
      "type": "string",
      "enum": [
        "passive_package",
        "wasm_capability_sandbox",
        "declarative_host_rendered_view",
        "external_host",
        "compatibility_bridge",
        "remote_side_component"
      ]
    },
    "host_abi_class": {
      "type": "string",
      "enum": [
        "no_code_execution",
        "local_machine",
        "managed_host",
        "remote_target",
        "external_process",
        "browser_runtime"
      ]
    },
    "signature_state": {
      "type": "string",
      "enum": [
        "signed_verified",
        "signed_unverified",
        "unsigned_local_dev",
        "unsigned_sideload",
        "revoked_signature"
      ]
    },
    "trust_posture": {
      "type": "string",
      "enum": [
        "unsigned_local_only",
        "registry_bound",
        "verified_publisher",
        "enterprise_approved"
      ]
    },
    "anti_abuse_state": {
      "type": "string",
      "enum": [
        "disclosed_clean",
        "publisher_loss_history_disclosed",
        "undisclosed",
        "quarantined"
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": ["unpacked_directory", "archive_bundle"]
    },
    "source_path_class": {
      "type": "string",
      "enum": [
        "workspace_relative_path",
        "user_home_relative_path",
        "removable_media",
        "network_mount",
        "process_stream",
        "not_applicable"
      ]
    },
    "update_binding": {
      "type": "string",
      "enum": ["stay_local", "bind_to_registry_later", "bound_to_registry_identity"]
    },
    "release_channel": {
      "type": "string",
      "enum": ["local_dev", "preview", "stable"]
    },
    "permission_scope_kind": {
      "type": "string",
      "enum": [
        "filesystem_read",
        "filesystem_write",
        "shell_execute",
        "network_egress",
        "ai_provider_access",
        "connected_provider_access",
        "secret_handle_use",
        "workspace_settings_read",
        "workspace_settings_write",
        "execution_context_bind",
        "subscription_subscribe",
        "ui_command_contribute",
        "capability_inherit"
      ]
    },
    "permission_change": {
      "type": "string",
      "enum": ["added", "widened", "unchanged", "narrowed", "removed"]
    },
    "external_executable_class": {
      "type": "string",
      "enum": ["external_host_process", "helper_binary"]
    },
    "executable_change": {
      "type": "string",
      "enum": ["introduced", "unchanged", "removed"]
    },
    "install_kind": {
      "type": "string",
      "enum": ["first_sideload", "reload_or_update"]
    },
    "review_trigger": {
      "type": "string",
      "enum": [
        "permission_widening",
        "runtime_class_changed",
        "host_or_abi_rebound",
        "external_executable_introduced",
        "update_binding_changed",
        "release_channel_changed"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": ["reviewed_install_ready", "fresh_review_required", "blocked"]
    },
    "action_kind": {
      "type": "string",
      "enum": [
        "accept_sideload",
        "keep_local",
        "bind_to_registry_later",
        "request_fresh_review",
        "cancel"
      ]
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path_class", "display_hint"],
      "properties": {
        "kind": { "$ref": "#/$defs/source_kind" },
        "path_class": { "$ref": "#/$defs/source_path_class" },
        "display_hint": { "type": "string", "minLength": 1 },
        "content_address_ref": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "permission_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "rationale", "change"],
      "properties": {
        "kind": { "$ref": "#/$defs/permission_scope_kind" },
        "target": { "type": "string", "minLength": 1 },
        "constraint": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1 },
        "change": { "$ref": "#/$defs/permission_change" }
      }
    },
    "external_executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "identity_label", "purpose_label", "change"],
      "properties": {
        "class": { "$ref": "#/$defs/external_executable_class" },
        "identity_label": { "type": "string", "minLength": 1 },
        "purpose_label": { "type": "string", "minLength": 1 },
        "content_address_ref": { "type": "string", "minLength": 1 },
        "signed_by_ref": { "type": "string", "minLength": 1 },
        "change": { "$ref": "#/$defs/executable_change" }
      }
    },
    "installed_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_ref",
        "runtime_class",
        "host_abi",
        "update_binding",
        "release_channel",
        "rendered_trust_tier"
      ],
      "properties": {
        "revision_ref": { "type": "string", "minLength": 1 },
        "runtime_class": { "$ref": "#/$defs/runtime_class" },
        "host_abi": { "$ref": "#/$defs/host_abi_class" },
        "update_binding": { "$ref": "#/$defs/update_binding" },
        "release_channel": { "$ref": "#/$defs/release_channel" },
        "rendered_trust_tier": { "$ref": "#/$defs/trust_posture" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_kind", "action_ref", "enabled"],
      "properties": {
        "action_kind": { "$ref": "#/$defs/action_kind" },
        "action_ref": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" }
      }
    },
    "review_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheet_id",
        "listing_ref",
        "display_label",
        "governance_family_ref",
        "package_kind",
        "source_class",
        "extension_identity",
        "extension_version",
        "source",
        "runtime_class",
        "host_abi",
        "host_abi_range",
        "signature_state",
        "claimed_trust_tier",
        "rendered_trust_tier",
        "anti_abuse",
        "update_binding",
        "release_channel",
        "install_kind",
        "disposition",
        "summary"
      ],
      "properties": {
        "sheet_id": { "type": "string", "minLength": 1 },
        "listing_ref": { "type": "string", "minLength": 1 },
        "display_label": { "type": "string", "minLength": 1 },
        "governance_family_ref": { "type": "string", "minLength": 1 },
        "package_kind": { "$ref": "#/$defs/package_kind" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "extension_identity": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "extension_version": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source_identity" },
        "runtime_class": { "$ref": "#/$defs/runtime_class" },
        "host_abi": { "$ref": "#/$defs/host_abi_class" },
        "host_abi_range": { "type": "string", "minLength": 1 },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "signature_ref": { "type": "string", "minLength": 1 },
        "claimed_trust_tier": { "$ref": "#/$defs/trust_posture" },
        "rendered_trust_tier": { "$ref": "#/$defs/trust_posture" },
        "anti_abuse": { "$ref": "#/$defs/anti_abuse_state" },
        "requested_permissions": { "type": "array", "items": { "$ref": "#/$defs/permission_scope" } },
        "external_executables": { "type": "array", "items": { "$ref": "#/$defs/external_executable" } },
        "update_binding": { "$ref": "#/$defs/update_binding" },
        "release_channel": { "$ref": "#/$defs/release_channel" },
        "install_kind": { "$ref": "#/$defs/install_kind" },
        "installed_baseline": { "$ref": "#/$defs/installed_baseline" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "review_triggers": { "type": "array", "items": { "$ref": "#/$defs/review_trigger" } },
        "disposition": { "$ref": "#/$defs/disposition" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_sheets",
        "reviewed_install_ready_sheets",
        "fresh_review_required_sheets",
        "blocked_sheets",
        "permission_widening_sheets",
        "runtime_class_change_sheets",
        "host_rebind_sheets",
        "external_executable_introduced_sheets",
        "update_binding_change_sheets",
        "release_channel_change_sheets",
        "stay_local_sheets",
        "bind_to_registry_later_sheets",
        "registry_bound_sheets",
        "external_executable_using_sheets",
        "unsigned_or_revoked_sheets",
        "local_only_trust_sheets",
        "first_sideload_sheets",
        "reload_or_update_sheets",
        "distinct_package_kinds"
      ],
      "properties": {
        "total_sheets": { "type": "integer", "minimum": 0 },
        "reviewed_install_ready_sheets": { "type": "integer", "minimum": 0 },
        "fresh_review_required_sheets": { "type": "integer", "minimum": 0 },
        "blocked_sheets": { "type": "integer", "minimum": 0 },
        "permission_widening_sheets": { "type": "integer", "minimum": 0 },
        "runtime_class_change_sheets": { "type": "integer", "minimum": 0 },
        "host_rebind_sheets": { "type": "integer", "minimum": 0 },
        "external_executable_introduced_sheets": { "type": "integer", "minimum": 0 },
        "update_binding_change_sheets": { "type": "integer", "minimum": 0 },
        "release_channel_change_sheets": { "type": "integer", "minimum": 0 },
        "stay_local_sheets": { "type": "integer", "minimum": 0 },
        "bind_to_registry_later_sheets": { "type": "integer", "minimum": 0 },
        "registry_bound_sheets": { "type": "integer", "minimum": 0 },
        "external_executable_using_sheets": { "type": "integer", "minimum": 0 },
        "unsigned_or_revoked_sheets": { "type": "integer", "minimum": 0 },
        "local_only_trust_sheets": { "type": "integer", "minimum": 0 },
        "first_sideload_sheets": { "type": "integer", "minimum": 0 },
        "reload_or_update_sheets": { "type": "integer", "minimum": 0 },
        "distinct_package_kinds": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
