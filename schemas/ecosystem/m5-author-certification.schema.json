{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ecosystem/m5-author-certification.schema.json",
  "title": "Aureline M5 author-side certification, trust-cap automation, and downgrade paths",
  "description": "Schema for the m5_author_certification packet. The packet is the author-side counterpart to the install-side m5_ecosystem_certification: it decides whether a marketed M5 ecosystem family's author lane still backs the end-user install claim it advertises. Each entry aggregates the per-lane evidence the author drills produce — local-dev workspace, sideload review, sandbox/runtime inspection, publish preview, hot-reload and last-loaded-build continuity, and anti-abuse transparency — alongside the family's signing state, workspace origin, registry binding, evidence freshness, and owner, and recomputes two published values: the effective trust posture, capped by the weakest of the signing-state, workspace-origin, and registry-binding ceilings so a locally-built, side-loaded, or pending-rebind artifact never inherits a verified-publisher or enterprise-approved badge; and the effective author support class, the weakest of the end-user install claim, the author-side ceiling, and the disposition ceiling, so the marketed row narrows automatically when author-side trust or publish truth is weaker than the install claim. An entry's certification signals, disposition, and downgrade path are recomputed from its facts: a lane carrying warnings narrows to conditionally_certified; a fresh-review-required or stale lane, stale evidence, or an author claim below the install claim narrow to downgraded; and a missing or failed lane, a missing owner, a blocked publish gate, or an anti-abuse quarantine hold each force an uncertified row whose support collapses to unsupported. The author claim may never exceed the install claim it guards. Local authoring surfaces, marketplace badges, diagnostics, support, and release evidence consume the same certification index and downgrade report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "package_kinds",
    "source_classes",
    "runtime_classes",
    "host_abi_classes",
    "signature_states",
    "workspace_origins",
    "registry_bindings",
    "trust_postures",
    "support_classes",
    "evidence_freshness_classes",
    "publish_readiness_states",
    "author_certification_lanes",
    "author_lane_states",
    "author_certification_signals",
    "author_certification_dispositions",
    "entries",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_author_certification" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "package_kinds": { "type": "array", "items": { "$ref": "#/$defs/package_kind" } },
    "source_classes": { "type": "array", "items": { "$ref": "#/$defs/source_class" } },
    "runtime_classes": { "type": "array", "items": { "$ref": "#/$defs/runtime_class" } },
    "host_abi_classes": { "type": "array", "items": { "$ref": "#/$defs/host_abi_class" } },
    "signature_states": { "type": "array", "items": { "$ref": "#/$defs/signature_state" } },
    "workspace_origins": { "type": "array", "items": { "$ref": "#/$defs/workspace_origin" } },
    "registry_bindings": { "type": "array", "items": { "$ref": "#/$defs/registry_binding" } },
    "trust_postures": { "type": "array", "items": { "$ref": "#/$defs/trust_posture" } },
    "support_classes": { "type": "array", "items": { "$ref": "#/$defs/support_class" } },
    "evidence_freshness_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_freshness" }
    },
    "publish_readiness_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/publish_readiness" }
    },
    "author_certification_lanes": {
      "type": "array",
      "items": { "$ref": "#/$defs/author_certification_lane" }
    },
    "author_lane_states": { "type": "array", "items": { "$ref": "#/$defs/author_lane_state" } },
    "author_certification_signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/author_certification_signal" }
    },
    "author_certification_dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/author_certification_disposition" }
    },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "package_kind": {
      "enum": [
        "first_party_framework_pack",
        "docs_pack",
        "local_model_pack",
        "signed_recipe_pack",
        "template_artifact",
        "bridge_backed_package",
        "side_loaded_package",
        "mirrored_registry_variant"
      ]
    },
    "source_class": {
      "enum": [
        "first_party",
        "partner",
        "community",
        "bridge_backed",
        "side_loaded",
        "mirrored_registry",
        "private_registry"
      ]
    },
    "runtime_class": {
      "enum": [
        "passive_package",
        "wasm_capability_sandbox",
        "declarative_host_rendered_view",
        "external_host",
        "compatibility_bridge",
        "remote_side_component"
      ]
    },
    "host_abi_class": {
      "enum": [
        "no_code_execution",
        "local_machine",
        "managed_host",
        "remote_target",
        "external_process",
        "browser_runtime"
      ]
    },
    "signature_state": {
      "enum": [
        "signed_verified",
        "signed_unverified",
        "unsigned_local_dev",
        "unsigned_sideload",
        "revoked_signature"
      ]
    },
    "workspace_origin": {
      "enum": [
        "local_dev_workspace",
        "sideloaded_workspace",
        "published_registry_backed",
        "mirror_backed"
      ]
    },
    "registry_binding": {
      "enum": [
        "not_applicable_published",
        "stay_local",
        "bind_review_required",
        "bound_published_identity"
      ]
    },
    "trust_posture": {
      "enum": [
        "unsigned_local_only",
        "registry_bound",
        "verified_publisher",
        "enterprise_approved"
      ]
    },
    "support_class": {
      "enum": [
        "fully_supported",
        "best_effort_supported",
        "community_supported",
        "unsupported"
      ]
    },
    "evidence_freshness": { "enum": ["current", "stale", "expired", "unknown"] },
    "publish_readiness": {
      "enum": [
        "ready_to_publish",
        "publishable_with_warnings",
        "blocked_from_publish",
        "withheld_quarantined"
      ]
    },
    "author_certification_lane": {
      "enum": [
        "local_dev_workspace",
        "sideload_review",
        "sandbox_inspection",
        "publish_preview",
        "reload_continuity",
        "anti_abuse_transparency"
      ]
    },
    "author_lane_state": {
      "enum": ["clean", "warnings_disclosed", "fresh_review_required", "stale", "missing", "failed"]
    },
    "author_certification_signal": {
      "enum": [
        "trust_capped_below_publish_gate",
        "lane_warnings",
        "publish_gate_not_clear",
        "lane_fresh_review_required",
        "lane_stale",
        "evidence_not_current",
        "author_claim_below_install_claim",
        "owner_missing",
        "lane_missing",
        "lane_failed",
        "publish_gate_blocked",
        "quarantine_hold"
      ]
    },
    "author_certification_disposition": {
      "enum": ["certified", "conditionally_certified", "downgraded", "uncertified"]
    },
    "lane_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "state", "evidence_ref", "summary"],
      "properties": {
        "lane": { "$ref": "#/$defs/author_certification_lane" },
        "state": { "$ref": "#/$defs/author_lane_state" },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "downgrade_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "from_support_class",
        "to_support_class",
        "effective_trust_posture",
        "signals",
        "requalification_ref"
      ],
      "properties": {
        "applied": { "type": "boolean" },
        "from_support_class": { "$ref": "#/$defs/support_class" },
        "to_support_class": { "$ref": "#/$defs/support_class" },
        "effective_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/author_certification_signal" } },
        "requalification_ref": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "display_label",
        "author_matrix_ref",
        "install_certification_ref",
        "governance_family_ref",
        "package_kind",
        "source_class",
        "runtime_class",
        "host_abi",
        "signature_state",
        "workspace_origin",
        "registry_binding",
        "declared_trust_posture",
        "effective_trust_posture",
        "end_user_install_support_class",
        "claimed_author_support_class",
        "effective_author_support_class",
        "author_publish_readiness",
        "evidence_freshness",
        "lane_evidence",
        "certification_disposition",
        "downgrade_path",
        "release_evidence_ref",
        "support_export_ref",
        "summary"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "display_label": { "$ref": "#/$defs/non_empty_string" },
        "author_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
        "install_certification_ref": { "$ref": "#/$defs/non_empty_string" },
        "governance_family_ref": { "$ref": "#/$defs/non_empty_string" },
        "package_kind": { "$ref": "#/$defs/package_kind" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "runtime_class": { "$ref": "#/$defs/runtime_class" },
        "host_abi": { "$ref": "#/$defs/host_abi_class" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "workspace_origin": { "$ref": "#/$defs/workspace_origin" },
        "registry_binding": { "$ref": "#/$defs/registry_binding" },
        "declared_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "effective_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "end_user_install_support_class": { "$ref": "#/$defs/support_class" },
        "claimed_author_support_class": { "$ref": "#/$defs/support_class" },
        "effective_author_support_class": { "$ref": "#/$defs/support_class" },
        "author_publish_readiness": { "$ref": "#/$defs/publish_readiness" },
        "evidence_freshness": { "$ref": "#/$defs/evidence_freshness" },
        "owner_ref": { "type": "string" },
        "lane_evidence": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/lane_evidence" }
        },
        "caveats": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certification_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/author_certification_signal" }
        },
        "certification_disposition": { "$ref": "#/$defs/author_certification_disposition" },
        "downgrade_path": { "$ref": "#/$defs/downgrade_path" },
        "requalification_ref": { "type": "string" },
        "release_evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_ref": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_entries",
        "certified_entries",
        "conditionally_certified_entries",
        "downgraded_entries",
        "uncertified_entries",
        "entries_with_downgrade_applied",
        "local_only_trust_entries",
        "fully_supported_entries",
        "unsupported_entries",
        "distinct_package_kinds",
        "distinct_source_classes",
        "total_caveats",
        "total_lane_evidence"
      ],
      "properties": {
        "total_entries": { "type": "integer", "minimum": 0 },
        "certified_entries": { "type": "integer", "minimum": 0 },
        "conditionally_certified_entries": { "type": "integer", "minimum": 0 },
        "downgraded_entries": { "type": "integer", "minimum": 0 },
        "uncertified_entries": { "type": "integer", "minimum": 0 },
        "entries_with_downgrade_applied": { "type": "integer", "minimum": 0 },
        "local_only_trust_entries": { "type": "integer", "minimum": 0 },
        "fully_supported_entries": { "type": "integer", "minimum": 0 },
        "unsupported_entries": { "type": "integer", "minimum": 0 },
        "distinct_package_kinds": { "type": "integer", "minimum": 0 },
        "distinct_source_classes": { "type": "integer", "minimum": 0 },
        "total_caveats": { "type": "integer", "minimum": 0 },
        "total_lane_evidence": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
