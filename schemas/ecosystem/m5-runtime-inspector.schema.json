{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ecosystem/m5-runtime-inspector.schema.json",
  "title": "Aureline M5 runtime inspector cards",
  "description": "Schema for the m5_runtime_inspector packet. The packet freezes one runtime inspector card per claimed M5 ecosystem family. Each card surfaces the running truth of an installed or locally-built family — its activation time, current host, granted capabilities with declared-versus-exercised state, recent redacted logs, recent failures, hot-reload posture, and the quarantine/disable/re-enable actions — without scraping raw supervisor traces. Three published values are recomputed from each card's facts and the stored values must equal the recomputation: the rendered trust tier is capped by the signing state, so an unsigned local-dev, side-loaded, or revoked artifact never inherits a verified-publisher or enterprise-approved badge; the review-trigger set is computed from the hot-reload posture and the granted-capability state, so a hot reload that widens the runtime class, expands permissions, or adds an external executable — or an undeclared exercised capability — forces a fresh review instead of a silent hot reload; and the disposition is the strongest of the load-state base, that fresh-review gate, and a hard quarantine for an anti-abuse hold. A card whose current load failed or whose source path disappeared must keep a last-known-good state visible, and that last-good state can never render a stronger badge than the family's current cap. The model is metadata-only: every field is a typed state, a redacted display hint, or an opaque ref, and it carries no absolute filesystem paths, raw log bodies, supervisor traces, signing secrets, or provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "package_kinds",
    "source_classes",
    "runtime_classes",
    "host_abi_classes",
    "signature_states",
    "trust_postures",
    "anti_abuse_states",
    "hot_reload_postures",
    "activation_buckets",
    "resource_pressures",
    "capability_classes",
    "capability_exercise_states",
    "load_states",
    "log_levels",
    "failure_classes",
    "action_kinds",
    "review_triggers",
    "dispositions",
    "inspector_cards",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "type": "string", "const": "m5_runtime_inspector" },
    "packet_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "overview_page": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "package_kinds": { "type": "array", "items": { "$ref": "#/$defs/package_kind" } },
    "source_classes": { "type": "array", "items": { "$ref": "#/$defs/source_class" } },
    "runtime_classes": { "type": "array", "items": { "$ref": "#/$defs/runtime_class" } },
    "host_abi_classes": { "type": "array", "items": { "$ref": "#/$defs/host_abi_class" } },
    "signature_states": { "type": "array", "items": { "$ref": "#/$defs/signature_state" } },
    "trust_postures": { "type": "array", "items": { "$ref": "#/$defs/trust_posture" } },
    "anti_abuse_states": { "type": "array", "items": { "$ref": "#/$defs/anti_abuse_state" } },
    "hot_reload_postures": { "type": "array", "items": { "$ref": "#/$defs/hot_reload_posture" } },
    "activation_buckets": { "type": "array", "items": { "$ref": "#/$defs/activation_bucket" } },
    "resource_pressures": { "type": "array", "items": { "$ref": "#/$defs/resource_pressure" } },
    "capability_classes": { "type": "array", "items": { "$ref": "#/$defs/capability_class" } },
    "capability_exercise_states": { "type": "array", "items": { "$ref": "#/$defs/capability_exercise_state" } },
    "load_states": { "type": "array", "items": { "$ref": "#/$defs/load_state" } },
    "log_levels": { "type": "array", "items": { "$ref": "#/$defs/log_level" } },
    "failure_classes": { "type": "array", "items": { "$ref": "#/$defs/failure_class" } },
    "action_kinds": { "type": "array", "items": { "$ref": "#/$defs/action_kind" } },
    "review_triggers": { "type": "array", "items": { "$ref": "#/$defs/review_trigger" } },
    "dispositions": { "type": "array", "items": { "$ref": "#/$defs/disposition" } },
    "inspector_cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/inspector_card" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "package_kind": {
      "type": "string",
      "enum": [
        "first_party_framework_pack",
        "docs_pack",
        "local_model_pack",
        "signed_recipe_pack",
        "template_artifact",
        "bridge_backed_package",
        "side_loaded_package",
        "mirrored_registry_variant"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": ["first_party", "verified_partner", "community", "unverified"]
    },
    "runtime_class": {
      "type": "string",
      "enum": [
        "passive_package",
        "wasm_capability_sandbox",
        "declarative_host_rendered_view",
        "external_host",
        "compatibility_bridge",
        "remote_side_component"
      ]
    },
    "host_abi_class": {
      "type": "string",
      "enum": [
        "no_code_execution",
        "local_machine",
        "managed_host",
        "remote_target",
        "external_process",
        "browser_runtime"
      ]
    },
    "signature_state": {
      "type": "string",
      "enum": [
        "signed_verified",
        "signed_unverified",
        "unsigned_local_dev",
        "unsigned_sideload",
        "revoked_signature"
      ]
    },
    "trust_posture": {
      "type": "string",
      "enum": ["unsigned_local_only", "registry_bound", "verified_publisher", "enterprise_approved"]
    },
    "anti_abuse_state": {
      "type": "string",
      "enum": [
        "disclosed_clean",
        "publisher_loss_history_disclosed",
        "undisclosed",
        "quarantined"
      ]
    },
    "hot_reload_posture": {
      "type": "string",
      "enum": [
        "no_widening",
        "relaunch_only",
        "runtime_class_widened_pending_review",
        "permissions_widened_pending_review",
        "external_executable_added_pending_review"
      ]
    },
    "activation_bucket": {
      "type": "string",
      "enum": ["cold", "warm"]
    },
    "resource_pressure": {
      "type": "string",
      "enum": ["healthy", "elevated", "over_budget", "unknown", "not_applicable"]
    },
    "capability_class": {
      "type": "string",
      "enum": [
        "filesystem_read",
        "filesystem_write",
        "network_access",
        "process_spawn",
        "clipboard_access",
        "secrets_read",
        "telemetry_emit",
        "model_inference",
        "workspace_settings_write",
        "background_execution"
      ]
    },
    "capability_exercise_state": {
      "type": "string",
      "enum": ["declared_exercised", "declared_unused", "undeclared_exercised"]
    },
    "load_state": {
      "type": "string",
      "enum": [
        "loaded_healthy",
        "loaded_degraded",
        "load_failed",
        "source_missing",
        "quarantine_held",
        "operator_disabled"
      ]
    },
    "log_level": {
      "type": "string",
      "enum": ["info", "notice", "warning", "error"]
    },
    "failure_class": {
      "type": "string",
      "enum": [
        "activation_timeout",
        "crash_on_activation",
        "crash_loop",
        "host_disconnect",
        "capability_denied",
        "memory_exhausted",
        "undeclared_capability_use"
      ]
    },
    "action_kind": {
      "type": "string",
      "enum": [
        "view_logs",
        "restart",
        "reload_source",
        "disable_for_workspace",
        "disable_globally",
        "quarantine",
        "re_enable",
        "request_fresh_review"
      ]
    },
    "review_trigger": {
      "type": "string",
      "enum": [
        "runtime_class_widened",
        "permissions_widened",
        "external_executable_added",
        "undeclared_capability_exercised"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "running_healthy",
        "running_degraded",
        "showing_last_known_good",
        "fresh_review_required",
        "operator_disabled",
        "quarantined"
      ]
    },
    "activation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "activation_millis", "memory_pressure", "peak_memory_mib"],
      "properties": {
        "bucket": { "$ref": "#/$defs/activation_bucket" },
        "activation_millis": { "type": "integer", "minimum": 0 },
        "memory_pressure": { "$ref": "#/$defs/resource_pressure" },
        "peak_memory_mib": { "type": "integer", "minimum": 0 }
      }
    },
    "granted_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "exercise_state", "target_label", "rationale"],
      "properties": {
        "class": { "$ref": "#/$defs/capability_class" },
        "exercise_state": { "$ref": "#/$defs/capability_exercise_state" },
        "target_label": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "log_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "code", "message_label", "seq"],
      "properties": {
        "level": { "$ref": "#/$defs/log_level" },
        "code": { "type": "string", "minLength": 1 },
        "message_label": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 0 }
      }
    },
    "recent_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "occurrence_count", "last_seen_label", "detail_label"],
      "properties": {
        "class": { "$ref": "#/$defs/failure_class" },
        "occurrence_count": { "type": "integer", "minimum": 1 },
        "last_seen_label": { "type": "string", "minLength": 1 },
        "detail_label": { "type": "string", "minLength": 1 }
      }
    },
    "last_known_good_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_ref", "runtime_class", "host_abi", "captured_label", "rendered_trust_tier", "summary"],
      "properties": {
        "revision_ref": { "type": "string", "minLength": 1 },
        "runtime_class": { "$ref": "#/$defs/runtime_class" },
        "host_abi": { "$ref": "#/$defs/host_abi_class" },
        "captured_label": { "type": "string", "minLength": 1 },
        "rendered_trust_tier": { "$ref": "#/$defs/trust_posture" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "inspector_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_kind", "action_ref", "enabled"],
      "properties": {
        "action_kind": { "$ref": "#/$defs/action_kind" },
        "action_ref": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" }
      }
    },
    "inspector_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "listing_ref",
        "display_label",
        "governance_family_ref",
        "package_kind",
        "source_class",
        "extension_identity",
        "extension_version",
        "runtime_class",
        "current_host",
        "signature_state",
        "claimed_trust_tier",
        "rendered_trust_tier",
        "anti_abuse",
        "hot_reload_posture",
        "load_state",
        "activation",
        "disposition",
        "summary"
      ],
      "properties": {
        "card_id": { "type": "string", "minLength": 1 },
        "listing_ref": { "type": "string", "minLength": 1 },
        "display_label": { "type": "string", "minLength": 1 },
        "governance_family_ref": { "type": "string", "minLength": 1 },
        "package_kind": { "$ref": "#/$defs/package_kind" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "extension_identity": { "type": "string", "minLength": 1, "pattern": "/" },
        "extension_version": { "type": "string", "minLength": 1 },
        "runtime_class": { "$ref": "#/$defs/runtime_class" },
        "current_host": { "$ref": "#/$defs/host_abi_class" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "signature_ref": { "type": "string", "minLength": 1 },
        "claimed_trust_tier": { "$ref": "#/$defs/trust_posture" },
        "rendered_trust_tier": { "$ref": "#/$defs/trust_posture" },
        "anti_abuse": { "$ref": "#/$defs/anti_abuse_state" },
        "hot_reload_posture": { "$ref": "#/$defs/hot_reload_posture" },
        "load_state": { "$ref": "#/$defs/load_state" },
        "activation": { "$ref": "#/$defs/activation_profile" },
        "granted_capabilities": { "type": "array", "items": { "$ref": "#/$defs/granted_capability" } },
        "recent_logs": { "type": "array", "items": { "$ref": "#/$defs/log_entry" } },
        "recent_failures": { "type": "array", "items": { "$ref": "#/$defs/recent_failure" } },
        "last_known_good": { "$ref": "#/$defs/last_known_good_state" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/inspector_action" } },
        "review_triggers": { "type": "array", "items": { "$ref": "#/$defs/review_trigger" } },
        "disposition": { "$ref": "#/$defs/disposition" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cards",
        "running_healthy_cards",
        "running_degraded_cards",
        "showing_last_known_good_cards",
        "fresh_review_required_cards",
        "operator_disabled_cards",
        "quarantined_cards",
        "cards_with_failures",
        "cards_with_last_known_good",
        "local_only_trust_cards",
        "undeclared_capability_cards",
        "over_memory_budget_cards",
        "distinct_package_kinds"
      ],
      "properties": {
        "total_cards": { "type": "integer", "minimum": 0 },
        "running_healthy_cards": { "type": "integer", "minimum": 0 },
        "running_degraded_cards": { "type": "integer", "minimum": 0 },
        "showing_last_known_good_cards": { "type": "integer", "minimum": 0 },
        "fresh_review_required_cards": { "type": "integer", "minimum": 0 },
        "operator_disabled_cards": { "type": "integer", "minimum": 0 },
        "quarantined_cards": { "type": "integer", "minimum": 0 },
        "cards_with_failures": { "type": "integer", "minimum": 0 },
        "cards_with_last_known_good": { "type": "integer", "minimum": 0 },
        "local_only_trust_cards": { "type": "integer", "minimum": 0 },
        "undeclared_capability_cards": { "type": "integer", "minimum": 0 },
        "over_memory_budget_cards": { "type": "integer", "minimum": 0 },
        "distinct_package_kinds": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
