{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ecosystem/m5-anti-abuse-and-repro.schema.json",
  "title": "Aureline M5 anti-abuse, continuity-history, and repro-export board",
  "description": "Schema for the m5_anti_abuse_and_repro_board packet. The packet freezes one transparency row per marketed M5 artifact family for local-to-published, mirrored, and sideload-to-registry flows. Each row carries the package identity, an opaque source-path ref, the runtime class, host/ABI, workspace origin, signing state, and the declared and rendered trust posture; a set of ranking/anti-abuse reason chips with a recomputed ranking explainability; a sequenced continuity timeline with recomputed quarantine-history and publisher-continuity states; a reproducible export packet with package id, digest, host ABI, redacted logs, conformance results, and a manifest ref; a local-to-published binding decision with its review ref; and a recomputed transparency disposition. The row caps the rendered trust posture by the signing state, the workspace origin, and the registry-binding decision, so a locally-built, side-loaded, or freshly bound artifact never inherits a verified-publisher or enterprise-approved badge; vanity metrics (install count, star rating, trending velocity) may be shown but must never dominate the ranking, and an anti-abuse demotion always leads it; a current quarantine must be reflected in the ranking chips so anti-abuse action is never hidden in a moderation-only tool; the repro export must be self-contained, with no raw supervisor traces or paid service; and a local-to-published rebind must pass an explicit bind-published-identity review, so a bound published identity never appears on a still-local or side-loaded origin. The recorded rendered trust posture, ranking explainability, quarantine-history state, publisher-continuity state, repro-export state, and transparency disposition must each equal the recomputed value, and the row never renders a stronger badge than the publish-preview gate would grant the same family.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "artifact_families",
    "runtime_classes",
    "host_abi_classes",
    "workspace_origins",
    "signature_states",
    "trust_postures",
    "ranking_reason_categories",
    "ranking_reason_chips",
    "ranking_explainability_states",
    "history_event_kinds",
    "quarantine_history_states",
    "publisher_continuity_states",
    "repro_export_states",
    "bind_decisions",
    "transparency_dispositions",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_anti_abuse_and_repro_board" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "artifact_families": { "type": "array", "items": { "$ref": "#/$defs/artifact_family" } },
    "runtime_classes": { "type": "array", "items": { "$ref": "#/$defs/runtime_class" } },
    "host_abi_classes": { "type": "array", "items": { "$ref": "#/$defs/host_abi_class" } },
    "workspace_origins": { "type": "array", "items": { "$ref": "#/$defs/workspace_origin" } },
    "signature_states": { "type": "array", "items": { "$ref": "#/$defs/signature_state" } },
    "trust_postures": { "type": "array", "items": { "$ref": "#/$defs/trust_posture" } },
    "ranking_reason_categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/ranking_reason_category" }
    },
    "ranking_reason_chips": {
      "type": "array",
      "items": { "$ref": "#/$defs/ranking_reason_chip" }
    },
    "ranking_explainability_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/ranking_explainability" }
    },
    "history_event_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/history_event_kind" }
    },
    "quarantine_history_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/quarantine_history_state" }
    },
    "publisher_continuity_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/publisher_continuity_state" }
    },
    "repro_export_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/repro_export_state" }
    },
    "bind_decisions": { "type": "array", "items": { "$ref": "#/$defs/bind_decision" } },
    "transparency_dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transparency_disposition" }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "possibly_empty_string": { "type": "string" },
    "artifact_family": {
      "enum": [
        "first_party_framework_pack",
        "docs_pack",
        "local_model_pack",
        "signed_recipe_pack",
        "template_artifact",
        "bridge_backed_package",
        "side_loaded_package",
        "mirrored_registry_variant"
      ]
    },
    "runtime_class": {
      "enum": [
        "passive_package",
        "wasm_capability_sandbox",
        "declarative_host_rendered_view",
        "external_host",
        "compatibility_bridge",
        "remote_side_component"
      ]
    },
    "host_abi_class": {
      "enum": [
        "no_code_execution",
        "local_machine",
        "managed_host",
        "remote_target",
        "external_process",
        "browser_runtime"
      ]
    },
    "workspace_origin": {
      "enum": [
        "local_dev_workspace",
        "sideloaded_workspace",
        "published_registry_backed",
        "mirror_backed"
      ]
    },
    "signature_state": {
      "enum": [
        "signed_verified",
        "signed_unverified",
        "unsigned_local_dev",
        "unsigned_sideload",
        "revoked_signature"
      ]
    },
    "trust_posture": {
      "enum": ["unsigned_local_only", "registry_bound", "verified_publisher", "enterprise_approved"]
    },
    "ranking_reason_category": {
      "enum": ["trust_signal", "quality_signal", "anti_abuse_demotion", "vanity_metric"]
    },
    "ranking_reason_chip": {
      "enum": [
        "conformance_verified",
        "security_review_passed",
        "publisher_verified",
        "maintained_actively",
        "compatibility_current",
        "docs_complete",
        "anti_abuse_rate_limited",
        "anti_abuse_ranking_demoted",
        "anti_abuse_quarantined",
        "install_count_popularity",
        "star_rating_popularity",
        "trending_velocity"
      ]
    },
    "ranking_explainability": {
      "enum": ["trust_led", "anti_abuse_led", "vanity_dominated"]
    },
    "history_event_kind": {
      "enum": [
        "published",
        "version_published",
        "publisher_transferred",
        "verified_publisher_granted",
        "verified_publisher_lost",
        "quarantined",
        "quarantine_cleared",
        "removed",
        "reinstated"
      ]
    },
    "quarantine_history_state": {
      "enum": ["clean", "prior_action_disclosed", "currently_withheld"]
    },
    "publisher_continuity_state": {
      "enum": ["continuous", "publisher_transferred_disclosed", "verified_publisher_lost"]
    },
    "repro_export_state": {
      "enum": ["complete", "incomplete"]
    },
    "bind_decision": {
      "enum": [
        "not_applicable_published",
        "stay_local",
        "bind_review_required",
        "bound_published_identity"
      ]
    },
    "transparency_disposition": {
      "enum": ["visible_clean", "visible_with_history_disclosure", "withheld_quarantined"]
    },
    "history_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "at", "detail_ref", "note"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "kind": { "$ref": "#/$defs/history_event_kind" },
        "at": { "$ref": "#/$defs/non_empty_string" },
        "detail_ref": { "$ref": "#/$defs/non_empty_string" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "repro_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "digest",
        "host_abi",
        "logs_ref",
        "conformance_results_ref",
        "manifest_ref",
        "self_contained",
        "state"
      ],
      "properties": {
        "package_id": { "$ref": "#/$defs/non_empty_string" },
        "digest": { "$ref": "#/$defs/non_empty_string" },
        "host_abi": { "$ref": "#/$defs/host_abi_class" },
        "logs_ref": { "$ref": "#/$defs/possibly_empty_string" },
        "conformance_results_ref": { "$ref": "#/$defs/possibly_empty_string" },
        "manifest_ref": { "$ref": "#/$defs/possibly_empty_string" },
        "self_contained": { "type": "boolean" },
        "state": { "$ref": "#/$defs/repro_export_state" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "artifact_family",
        "package_identity",
        "source_path_ref",
        "runtime_class",
        "host_abi",
        "origin",
        "signature_state",
        "declared_trust_posture",
        "rendered_trust_posture",
        "ranking_reasons",
        "ranking_explainability",
        "history_events",
        "quarantine_history_state",
        "publisher_continuity_state",
        "repro_export",
        "bind_decision",
        "bind_review_ref",
        "transparency_disposition",
        "marketplace_ref",
        "authoring_ref",
        "publish_preview_ref",
        "support_export_ref",
        "note"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_family": { "$ref": "#/$defs/artifact_family" },
        "package_identity": { "$ref": "#/$defs/non_empty_string" },
        "source_path_ref": { "$ref": "#/$defs/non_empty_string" },
        "runtime_class": { "$ref": "#/$defs/runtime_class" },
        "host_abi": { "$ref": "#/$defs/host_abi_class" },
        "origin": { "$ref": "#/$defs/workspace_origin" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "declared_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "rendered_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "ranking_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/ranking_reason_chip" }
        },
        "ranking_explainability": { "$ref": "#/$defs/ranking_explainability" },
        "history_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/history_event" }
        },
        "quarantine_history_state": { "$ref": "#/$defs/quarantine_history_state" },
        "publisher_continuity_state": { "$ref": "#/$defs/publisher_continuity_state" },
        "repro_export": { "$ref": "#/$defs/repro_export" },
        "bind_decision": { "$ref": "#/$defs/bind_decision" },
        "bind_review_ref": { "$ref": "#/$defs/possibly_empty_string" },
        "transparency_disposition": { "$ref": "#/$defs/transparency_disposition" },
        "marketplace_ref": { "$ref": "#/$defs/non_empty_string" },
        "authoring_ref": { "$ref": "#/$defs/non_empty_string" },
        "publish_preview_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": { "$ref": "#/$defs/string_array" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "family_count",
        "visible_clean_rows",
        "visible_with_disclosure_rows",
        "withheld_quarantined_rows",
        "prior_action_rows",
        "publisher_transferred_rows",
        "verified_publisher_lost_rows",
        "anti_abuse_led_rows",
        "trust_led_rows",
        "complete_repro_export_rows",
        "incomplete_repro_export_rows",
        "bind_review_required_rows",
        "bound_published_identity_rows",
        "local_only_rendered_rows",
        "verified_or_enterprise_rendered_rows"
      ],
      "properties": {
        "total_rows": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "visible_clean_rows": { "type": "integer", "minimum": 0 },
        "visible_with_disclosure_rows": { "type": "integer", "minimum": 0 },
        "withheld_quarantined_rows": { "type": "integer", "minimum": 0 },
        "prior_action_rows": { "type": "integer", "minimum": 0 },
        "publisher_transferred_rows": { "type": "integer", "minimum": 0 },
        "verified_publisher_lost_rows": { "type": "integer", "minimum": 0 },
        "anti_abuse_led_rows": { "type": "integer", "minimum": 0 },
        "trust_led_rows": { "type": "integer", "minimum": 0 },
        "complete_repro_export_rows": { "type": "integer", "minimum": 0 },
        "incomplete_repro_export_rows": { "type": "integer", "minimum": 0 },
        "bind_review_required_rows": { "type": "integer", "minimum": 0 },
        "bound_published_identity_rows": { "type": "integer", "minimum": 0 },
        "local_only_rendered_rows": { "type": "integer", "minimum": 0 },
        "verified_or_enterprise_rendered_rows": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
