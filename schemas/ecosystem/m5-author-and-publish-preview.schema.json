{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ecosystem/m5-author-and-publish-preview.schema.json",
  "title": "Aureline M5 author-and-publish-preview matrix",
  "description": "Schema for the m5_author_and_publish_preview_matrix packet. The packet freezes one author-side row per marketed M5 artifact family (first-party framework pack, docs pack, local-model pack, signed recipe pack, template artifact, bridge-backed package, side-loaded package, mirrored/private-registry variant) covering the local extension workspace, sideload review, sandbox/runtime inspection, hot-reload/relaunch, and publish preview. Each row names its runtime class, host/ABI, local-workspace build state, signing state, declared trust posture, hot-reload widening posture, publish-review requirement, conformance output, and anti-abuse transparency state. A non-inheriting publish gate caps the published trust posture by the signing state, so a locally-built, side-loaded, or revoked artifact can never inherit a verified-publisher or enterprise-approved badge; it emits explicit blocker and warning findings so the publish preview keeps registry-policy consequences visible rather than collapsing to a manifest lint; and it derives a publish-readiness verdict that withholds a quarantined family, blocks a family carrying any blocker, publishes-with-warnings a family carrying only warnings, and clears a clean family. The recorded published trust posture, readiness, and findings must equal the recomputed gate decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "artifact_families",
    "runtime_classes",
    "host_abi_classes",
    "workspace_states",
    "signature_states",
    "trust_postures",
    "hot_reload_postures",
    "publish_review_requirements",
    "conformance_outputs",
    "anti_abuse_transparency_states",
    "finding_severities",
    "finding_domains",
    "finding_codes",
    "publish_readiness_states",
    "families",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_author_and_publish_preview_matrix" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "artifact_families": { "type": "array", "items": { "$ref": "#/$defs/artifact_family" } },
    "runtime_classes": { "type": "array", "items": { "$ref": "#/$defs/runtime_class" } },
    "host_abi_classes": { "type": "array", "items": { "$ref": "#/$defs/host_abi_class" } },
    "workspace_states": { "type": "array", "items": { "$ref": "#/$defs/workspace_state" } },
    "signature_states": { "type": "array", "items": { "$ref": "#/$defs/signature_state" } },
    "trust_postures": { "type": "array", "items": { "$ref": "#/$defs/trust_posture" } },
    "hot_reload_postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/hot_reload_posture" }
    },
    "publish_review_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/publish_review_requirement" }
    },
    "conformance_outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/conformance_output" }
    },
    "anti_abuse_transparency_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/anti_abuse_transparency" }
    },
    "finding_severities": { "type": "array", "items": { "$ref": "#/$defs/finding_severity" } },
    "finding_domains": { "type": "array", "items": { "$ref": "#/$defs/finding_domain" } },
    "finding_codes": { "type": "array", "items": { "$ref": "#/$defs/finding_code" } },
    "publish_readiness_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/publish_readiness" }
    },
    "families": { "type": "array", "items": { "$ref": "#/$defs/family" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "artifact_family": {
      "enum": [
        "first_party_framework_pack",
        "docs_pack",
        "local_model_pack",
        "signed_recipe_pack",
        "template_artifact",
        "bridge_backed_package",
        "side_loaded_package",
        "mirrored_registry_variant"
      ]
    },
    "runtime_class": {
      "enum": [
        "passive_package",
        "wasm_capability_sandbox",
        "declarative_host_rendered_view",
        "external_host",
        "compatibility_bridge",
        "remote_side_component"
      ]
    },
    "host_abi_class": {
      "enum": [
        "no_code_execution",
        "local_machine",
        "managed_host",
        "remote_target",
        "external_process",
        "browser_runtime"
      ]
    },
    "workspace_state": {
      "enum": ["source_present_built", "source_missing", "build_failed"]
    },
    "signature_state": {
      "enum": [
        "signed_verified",
        "signed_unverified",
        "unsigned_local_dev",
        "unsigned_sideload",
        "revoked_signature"
      ]
    },
    "trust_posture": {
      "enum": ["unsigned_local_only", "registry_bound", "verified_publisher", "enterprise_approved"]
    },
    "hot_reload_posture": {
      "enum": [
        "no_widening",
        "relaunch_only",
        "runtime_class_widened_pending_review",
        "permissions_widened_pending_review",
        "external_executable_added_pending_review"
      ]
    },
    "publish_review_requirement": {
      "enum": [
        "full_registry_policy_review",
        "standard_review",
        "expedited_review",
        "not_publishable_from_local"
      ]
    },
    "conformance_output": {
      "enum": ["conformant", "bridge_conformant", "partial", "failed", "retest_pending", "not_run"]
    },
    "anti_abuse_transparency": {
      "enum": [
        "disclosed_clean",
        "publisher_loss_history_disclosed",
        "undisclosed",
        "quarantined"
      ]
    },
    "finding_severity": { "enum": ["blocker", "warning"] },
    "finding_domain": {
      "enum": ["local_workspace", "sideload_trust", "hot_reload", "conformance", "anti_abuse"]
    },
    "finding_code": {
      "enum": [
        "build_failed",
        "source_missing",
        "signature_revoked",
        "provenance_unverified",
        "hot_reload_runtime_widened",
        "hot_reload_permissions_widened",
        "hot_reload_external_executable_added",
        "conformance_failed",
        "conformance_incomplete",
        "anti_abuse_undisclosed",
        "publisher_loss_history",
        "anti_abuse_quarantined"
      ]
    },
    "publish_readiness": {
      "enum": [
        "ready_to_publish",
        "publishable_with_warnings",
        "blocked_from_publish",
        "withheld_quarantined"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "domain"],
      "properties": {
        "code": { "$ref": "#/$defs/finding_code" },
        "severity": { "$ref": "#/$defs/finding_severity" },
        "domain": { "$ref": "#/$defs/finding_domain" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "artifact_family",
        "runtime_class",
        "host_abi",
        "workspace_state",
        "signature_state",
        "declared_trust_posture",
        "published_trust_posture",
        "hot_reload_posture",
        "publish_review_requirement",
        "conformance_output",
        "anti_abuse_transparency",
        "publish_readiness",
        "workspace_ref",
        "sideload_review_ref",
        "inspector_ref",
        "publish_preview_ref",
        "anti_abuse_ref",
        "conformance_ref",
        "support_export_ref",
        "note"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_family": { "$ref": "#/$defs/artifact_family" },
        "runtime_class": { "$ref": "#/$defs/runtime_class" },
        "host_abi": { "$ref": "#/$defs/host_abi_class" },
        "workspace_state": { "$ref": "#/$defs/workspace_state" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "declared_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "published_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "hot_reload_posture": { "$ref": "#/$defs/hot_reload_posture" },
        "publish_review_requirement": { "$ref": "#/$defs/publish_review_requirement" },
        "conformance_output": { "$ref": "#/$defs/conformance_output" },
        "anti_abuse_transparency": { "$ref": "#/$defs/anti_abuse_transparency" },
        "publish_readiness": { "$ref": "#/$defs/publish_readiness" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "workspace_ref": { "$ref": "#/$defs/non_empty_string" },
        "sideload_review_ref": { "$ref": "#/$defs/non_empty_string" },
        "inspector_ref": { "$ref": "#/$defs/non_empty_string" },
        "publish_preview_ref": { "$ref": "#/$defs/non_empty_string" },
        "anti_abuse_ref": { "$ref": "#/$defs/non_empty_string" },
        "conformance_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": { "$ref": "#/$defs/string_array" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_families",
        "family_count",
        "ready_to_publish_families",
        "publishable_with_warnings_families",
        "blocked_from_publish_families",
        "withheld_quarantined_families",
        "families_with_blockers",
        "families_with_warnings",
        "local_only_published_families",
        "verified_or_enterprise_published_families",
        "publisher_loss_history_families",
        "quarantined_families"
      ],
      "properties": {
        "total_families": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "ready_to_publish_families": { "type": "integer", "minimum": 0 },
        "publishable_with_warnings_families": { "type": "integer", "minimum": 0 },
        "blocked_from_publish_families": { "type": "integer", "minimum": 0 },
        "withheld_quarantined_families": { "type": "integer", "minimum": 0 },
        "families_with_blockers": { "type": "integer", "minimum": 0 },
        "families_with_warnings": { "type": "integer", "minimum": 0 },
        "local_only_published_families": { "type": "integer", "minimum": 0 },
        "verified_or_enterprise_published_families": { "type": "integer", "minimum": 0 },
        "publisher_loss_history_families": { "type": "integer", "minimum": 0 },
        "quarantined_families": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
