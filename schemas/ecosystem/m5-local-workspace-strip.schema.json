{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/ecosystem/m5-local-workspace-strip.schema.json",
  "title": "Aureline M5 local-workspace-strip board",
  "description": "Schema for the m5_local_workspace_strip_board packet. The packet freezes one local extension workspace strip per marketed M5 artifact family (first-party framework pack, docs pack, local-model pack, signed recipe pack, template artifact, bridge-backed package, side-loaded package, mirrored/private-registry variant). Each strip is the per-workspace authoring chrome an author reads while building a pack: it names the package identity, an opaque source-path ref, the workspace origin (local-dev, sideloaded, published-registry-backed, or mirror-backed), the runtime class, the host/ABI, the signing state, the declared and rendered trust posture, the build freshness (last-built), the load state (last-loaded and hot-reload/relaunch posture), and the hot-reload posture. The strip caps the rendered trust posture by both the signing state and the workspace origin, so a local-dev or side-loaded workspace renders unsigned_local_only even when signed on a trusted machine, and an unsigned or revoked artifact never inherits a verified-publisher or enterprise-approved badge; a hot reload that would widen the runtime class, add an external executable, or expand permissions holds the running instance in reload_held_for_review rather than widening authority silently. The recorded rendered trust posture and load state must equal the recomputed strip decision, and the strip never renders a stronger badge than the publish-preview gate would grant the same family.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "packet_id",
    "status",
    "overview_page",
    "as_of",
    "artifact_families",
    "runtime_classes",
    "host_abi_classes",
    "workspace_origins",
    "signature_states",
    "trust_postures",
    "build_freshness_states",
    "load_states",
    "hot_reload_postures",
    "strips",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "record_kind": { "const": "m5_local_workspace_strip_board" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "status": { "$ref": "#/$defs/non_empty_string" },
    "overview_page": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date" },
    "artifact_families": { "type": "array", "items": { "$ref": "#/$defs/artifact_family" } },
    "runtime_classes": { "type": "array", "items": { "$ref": "#/$defs/runtime_class" } },
    "host_abi_classes": { "type": "array", "items": { "$ref": "#/$defs/host_abi_class" } },
    "workspace_origins": { "type": "array", "items": { "$ref": "#/$defs/workspace_origin" } },
    "signature_states": { "type": "array", "items": { "$ref": "#/$defs/signature_state" } },
    "trust_postures": { "type": "array", "items": { "$ref": "#/$defs/trust_posture" } },
    "build_freshness_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/build_freshness" }
    },
    "load_states": { "type": "array", "items": { "$ref": "#/$defs/load_state" } },
    "hot_reload_postures": {
      "type": "array",
      "items": { "$ref": "#/$defs/hot_reload_posture" }
    },
    "strips": { "type": "array", "items": { "$ref": "#/$defs/strip" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "artifact_family": {
      "enum": [
        "first_party_framework_pack",
        "docs_pack",
        "local_model_pack",
        "signed_recipe_pack",
        "template_artifact",
        "bridge_backed_package",
        "side_loaded_package",
        "mirrored_registry_variant"
      ]
    },
    "runtime_class": {
      "enum": [
        "passive_package",
        "wasm_capability_sandbox",
        "declarative_host_rendered_view",
        "external_host",
        "compatibility_bridge",
        "remote_side_component"
      ]
    },
    "host_abi_class": {
      "enum": [
        "no_code_execution",
        "local_machine",
        "managed_host",
        "remote_target",
        "external_process",
        "browser_runtime"
      ]
    },
    "workspace_origin": {
      "enum": [
        "local_dev_workspace",
        "sideloaded_workspace",
        "published_registry_backed",
        "mirror_backed"
      ]
    },
    "signature_state": {
      "enum": [
        "signed_verified",
        "signed_unverified",
        "unsigned_local_dev",
        "unsigned_sideload",
        "revoked_signature"
      ]
    },
    "trust_posture": {
      "enum": ["unsigned_local_only", "registry_bound", "verified_publisher", "enterprise_approved"]
    },
    "build_freshness": {
      "enum": ["built_from_current_source", "built_stale_vs_source", "never_built", "build_failed"]
    },
    "load_state": {
      "enum": [
        "loaded_current_build",
        "reload_pending_relaunch",
        "reload_held_for_review",
        "not_loaded",
        "load_failed"
      ]
    },
    "hot_reload_posture": {
      "enum": [
        "no_widening",
        "relaunch_only",
        "runtime_class_widened_pending_review",
        "permissions_widened_pending_review",
        "external_executable_added_pending_review"
      ]
    },
    "strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strip_id",
        "artifact_family",
        "package_identity",
        "source_path_ref",
        "origin",
        "runtime_class",
        "host_abi",
        "signature_state",
        "declared_trust_posture",
        "rendered_trust_posture",
        "build_freshness",
        "load_state",
        "hot_reload_posture",
        "last_built_ref",
        "last_loaded_ref",
        "publish_preview_ref",
        "support_export_ref",
        "note"
      ],
      "properties": {
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_family": { "$ref": "#/$defs/artifact_family" },
        "package_identity": { "$ref": "#/$defs/non_empty_string" },
        "source_path_ref": { "$ref": "#/$defs/non_empty_string" },
        "origin": { "$ref": "#/$defs/workspace_origin" },
        "runtime_class": { "$ref": "#/$defs/runtime_class" },
        "host_abi": { "$ref": "#/$defs/host_abi_class" },
        "signature_state": { "$ref": "#/$defs/signature_state" },
        "declared_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "rendered_trust_posture": { "$ref": "#/$defs/trust_posture" },
        "build_freshness": { "$ref": "#/$defs/build_freshness" },
        "load_state": { "$ref": "#/$defs/load_state" },
        "hot_reload_posture": { "$ref": "#/$defs/hot_reload_posture" },
        "last_built_ref": { "$ref": "#/$defs/non_empty_string" },
        "last_loaded_ref": { "$ref": "#/$defs/non_empty_string" },
        "publish_preview_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_ref": { "$ref": "#/$defs/non_empty_string" },
        "evidence_refs": { "$ref": "#/$defs/string_array" },
        "note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_strips",
        "family_count",
        "local_only_strips",
        "published_registry_backed_strips",
        "mirror_backed_strips",
        "local_dev_strips",
        "sideloaded_strips",
        "reload_held_for_review_strips",
        "stale_build_strips",
        "build_failed_strips",
        "never_built_strips",
        "verified_or_enterprise_rendered_strips"
      ],
      "properties": {
        "total_strips": { "type": "integer", "minimum": 0 },
        "family_count": { "type": "integer", "minimum": 0 },
        "local_only_strips": { "type": "integer", "minimum": 0 },
        "published_registry_backed_strips": { "type": "integer", "minimum": 0 },
        "mirror_backed_strips": { "type": "integer", "minimum": 0 },
        "local_dev_strips": { "type": "integer", "minimum": 0 },
        "sideloaded_strips": { "type": "integer", "minimum": 0 },
        "reload_held_for_review_strips": { "type": "integer", "minimum": 0 },
        "stale_build_strips": { "type": "integer", "minimum": 0 },
        "build_failed_strips": { "type": "integer", "minimum": 0 },
        "never_built_strips": { "type": "integer", "minimum": 0 },
        "verified_or_enterprise_rendered_strips": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
