{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/automation/m5-automation-certification.schema.json",
  "title": "Aureline M5 automation surface certification",
  "description": "Boundary schema for the automation certification packet, its support export, its evidence joins, and its CLI/headless view. The packet turns the frozen recipe-builder, parameter-review, dry-run/explain, run-history, macro-recorder, and label-parity proofs into a claim-bearing surface matrix: each claimed M5 notebook/request-API/package/test-debug/incident/AI-linked automation surface is graded on six certification dimensions (builder parity, parameter review, dry-run/explain coverage, run-history integrity, macro-scope safety, and label reuse), narrows below stable on aged proof, and rolls up into a certification index. It reuses the safety-label, promotion-state, and finding-severity vocabulary frozen in schemas/automation/automation-contract-baseline.schema.json. A surface that authors outside the declarative recipe builder, cites no evidence, routes unreviewed inputs, shows no side-effect preview, keeps no durable run history, records unsafe macros, or invents a label vocabulary blocks stable; a surface whose proof has aged past its freshness window narrows below stable; a surface that presents itself as shareable without full current proof is itself a finding.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/certification_packet" },
    { "$ref": "#/$defs/support_export" },
    { "$ref": "#/$defs/evidence_join_view" },
    { "$ref": "#/$defs/cli_headless_view" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "enum": [
        "notebook_automation",
        "request_api_automation",
        "package_automation",
        "test_debug_automation",
        "incident_automation",
        "ai_linked_automation"
      ]
    },
    "authoring_path": {
      "type": "string",
      "enum": [
        "declarative_recipe_builder",
        "ad_hoc_feature_dialog",
        "hidden_command_metadata",
        "unreviewed_free_text"
      ]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "builder_parity",
        "parameter_review",
        "dry_run_explain_coverage",
        "run_history_integrity",
        "macro_scope_safety",
        "label_reuse"
      ]
    },
    "safety_label": {
      "type": "string",
      "enum": [
        "macro_safe",
        "recipe_safe",
        "headless_safe",
        "ui_only",
        "approval_required",
        "writes_files",
        "runs_process",
        "network_call",
        "remote_mutation"
      ]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["current", "stale"]
    },
    "claim_state": {
      "type": "string",
      "enum": ["shareable", "narrowed_below_stable", "blocked"]
    },
    "evidence_surface": {
      "type": "string",
      "enum": ["support_bundle", "incident_packet", "ai_evidence"]
    },
    "promotion_state": {
      "type": "string",
      "enum": ["stable", "narrowed_below_stable", "blocks_stable"]
    },
    "validation_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "severity", "summary"],
      "properties": {
        "finding_kind": { "$ref": "#/$defs/non_empty_string" },
        "severity": { "type": "string", "enum": ["blocker", "warning"] },
        "subject": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "dimension_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "passed", "detail"],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "passed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "claim_summary",
        "presents_as_shareable",
        "authoring_path",
        "parameters_reviewed",
        "secret_references_safe",
        "side_effect_preview_shown",
        "predicted_effects_disclosed",
        "run_history_durable",
        "run_history_redaction_safe",
        "rerun_under_current_policy",
        "macro_scope_declared",
        "macro_fails_closed_on_mismatch",
        "reuses_controlled_labels",
        "safety_labels",
        "evidence_refs",
        "last_certified_at",
        "proof_age_days",
        "freshness_window_days",
        "freshness_state",
        "dimension_outcomes",
        "certified",
        "claim_state"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/surface" },
        "claim_summary": { "$ref": "#/$defs/non_empty_string" },
        "presents_as_shareable": { "type": "boolean" },
        "authoring_path": { "$ref": "#/$defs/authoring_path" },
        "parameters_reviewed": { "type": "boolean" },
        "secret_references_safe": { "type": "boolean" },
        "side_effect_preview_shown": { "type": "boolean" },
        "predicted_effects_disclosed": { "type": "boolean" },
        "run_history_durable": { "type": "boolean" },
        "run_history_redaction_safe": { "type": "boolean" },
        "rerun_under_current_policy": { "type": "boolean" },
        "macro_scope_declared": { "type": "boolean" },
        "macro_fails_closed_on_mismatch": { "type": "boolean" },
        "reuses_controlled_labels": { "type": "boolean" },
        "safety_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/safety_label" }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "last_certified_at": { "$ref": "#/$defs/non_empty_string" },
        "proof_age_days": { "type": "integer", "minimum": 0 },
        "freshness_window_days": { "type": "integer", "minimum": 0 },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "dimension_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension_outcome" }
        },
        "certified": { "type": "boolean" },
        "claim_state": { "$ref": "#/$defs/claim_state" }
      }
    },
    "certification_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification_ref",
        "all_surfaces_current",
        "all_surfaces_certified",
        "shareable_surfaces",
        "narrowed_surfaces",
        "blocked_surfaces",
        "certification_summary"
      ],
      "properties": {
        "certification_ref": { "$ref": "#/$defs/non_empty_string" },
        "all_surfaces_current": { "type": "boolean" },
        "all_surfaces_certified": { "type": "boolean" },
        "shareable_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "narrowed_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "blocked_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "certification_summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "claim_summary",
        "presents_as_shareable",
        "authoring_path",
        "claim_state",
        "freshness_state",
        "proof_age_days",
        "freshness_window_days",
        "certified",
        "shareable",
        "evidence_ref_count",
        "safety_label_tokens",
        "failed_dimensions",
        "explanation"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/surface" },
        "claim_summary": { "$ref": "#/$defs/non_empty_string" },
        "presents_as_shareable": { "type": "boolean" },
        "authoring_path": { "$ref": "#/$defs/authoring_path" },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "freshness_state": { "$ref": "#/$defs/freshness_state" },
        "proof_age_days": { "type": "integer", "minimum": 0 },
        "freshness_window_days": { "type": "integer", "minimum": 0 },
        "certified": { "type": "boolean" },
        "shareable": { "type": "boolean" },
        "evidence_ref_count": { "type": "integer", "minimum": 0 },
        "safety_label_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/safety_label" }
        },
        "failed_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "explanation": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "certification_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "packet_id",
        "generated_at",
        "certification_schema_ref",
        "contract_baseline_schema_ref",
        "doc_ref",
        "surfaces",
        "surface_digest",
        "certification_index",
        "promotion_state"
      ],
      "properties": {
        "record_kind": { "const": "m5_automation_certification_packet" },
        "schema_version": { "const": 1 },
        "packet_id": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "certification_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "contract_baseline_schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "doc_ref": { "$ref": "#/$defs/non_empty_string" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_certification" }
        },
        "surface_digest": { "$ref": "#/$defs/non_empty_string" },
        "certification_index": { "$ref": "#/$defs/certification_index" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "validation_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_finding" }
        }
      }
    },
    "support_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "export_id",
        "exported_at",
        "packet_id_ref",
        "packet"
      ],
      "properties": {
        "record_kind": { "const": "m5_automation_certification_support_export" },
        "schema_version": { "const": 1 },
        "export_id": { "$ref": "#/$defs/non_empty_string" },
        "exported_at": { "$ref": "#/$defs/non_empty_string" },
        "packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "packet": { "$ref": "#/$defs/certification_packet" }
      }
    },
    "evidence_join_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "view_id",
        "surface",
        "generated_at",
        "packet_id_ref",
        "surface_digest",
        "certification_index",
        "surface_rows"
      ],
      "properties": {
        "record_kind": { "const": "m5_automation_certification_evidence_join" },
        "schema_version": { "const": 1 },
        "view_id": { "$ref": "#/$defs/non_empty_string" },
        "surface": { "$ref": "#/$defs/evidence_surface" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "surface_digest": { "$ref": "#/$defs/non_empty_string" },
        "certification_index": { "$ref": "#/$defs/certification_index" },
        "surface_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_row" }
        }
      }
    },
    "cli_headless_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "view_id",
        "generated_at",
        "packet_id_ref",
        "surface_digest",
        "promotion_state",
        "certification_index",
        "surface_rows"
      ],
      "properties": {
        "record_kind": { "const": "m5_automation_certification_cli_headless" },
        "schema_version": { "const": 1 },
        "view_id": { "$ref": "#/$defs/non_empty_string" },
        "generated_at": { "$ref": "#/$defs/non_empty_string" },
        "packet_id_ref": { "$ref": "#/$defs/non_empty_string" },
        "surface_digest": { "$ref": "#/$defs/non_empty_string" },
        "promotion_state": { "$ref": "#/$defs/promotion_state" },
        "certification_index": { "$ref": "#/$defs/certification_index" },
        "surface_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface_row" }
        }
      }
    }
  }
}
