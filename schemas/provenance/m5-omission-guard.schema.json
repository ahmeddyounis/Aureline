{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/provenance/m5-omission-guard.schema.json",
  "title": "Aureline M5 no-silent-omission guard registry",
  "description": "One weaker-evidence-state vocabulary and the no-silent-omission rule every public-truth consumer must obey. Each case reads a descriptor object (from m5-descriptor-object.schema.json), derives the canonical set of present weaker-evidence states from its facets — Mirrored, Offline, Side-loaded, Unverified, Partial, Retest pending, Stale, Expired, Missing, Scoped client, Handoff required, Not provided, plus the authoritative Official anchor — and projects that exact set onto every consumer (release center, Help/About, marketplace, docs/help, certification, evaluation packs, support exports, companion handoffs). The present set is never empty, every state resolves to one shared label and one explanation message id identical across consumers, and a consumer can neither drop a present state (silent omission) nor invent an absent one. Weakening is present exactly when the shared claim-narrowing runtime narrows the claim, so mirror/offline/side-loaded/not-provided states can never disappear. The packet carries metadata and refs only: no credential bodies or raw provider payloads.",
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "omission_message_id": {
      "type": "string",
      "pattern": "^public_truth_descriptor\\."
    },
    "state": {
      "enum": [
        "official",
        "vendor",
        "community",
        "mirrored",
        "offline",
        "side_loaded",
        "unverified",
        "partial",
        "retest_pending",
        "stale",
        "expired",
        "missing",
        "scoped_client",
        "handoff_required",
        "not_provided"
      ]
    },
    "claim_state": {
      "enum": [
        "fully_supported",
        "limited",
        "retest_pending",
        "evidence_stale",
        "unsupported_client",
        "unsupported"
      ]
    },
    "facet": {
      "enum": [
        "source_class",
        "signature_state",
        "freshness_state",
        "freshness_evidence",
        "support_class",
        "qualification_evidence",
        "client_kind",
        "authority_class",
        "handoff_requirement"
      ]
    },
    "consumer": {
      "enum": [
        "release_center",
        "help_about",
        "marketplace",
        "docs_help",
        "certification",
        "evaluation_packs",
        "support_export",
        "companion_handoff"
      ]
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_family",
        "artifact_kind",
        "schema_ref",
        "content_digest_ref"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_family": { "$ref": "#/$defs/non_empty_string" },
        "artifact_kind": { "$ref": "#/$defs/non_empty_string" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "content_digest_ref": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "descriptor_object": {
      "$ref": "https://aureline.dev/schemas/provenance/m5-descriptor-object.schema.json#/$defs/descriptor_object"
    },
    "rendered_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "label", "is_weakening", "sourced_from", "explanation_message_id"],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "is_weakening": { "type": "boolean" },
        "sourced_from": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "explanation_message_id": { "$ref": "#/$defs/omission_message_id" }
      }
    },
    "consumer_state_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "surface_field",
        "rendered_states",
        "omits_no_present_state",
        "status_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "$ref": "#/$defs/non_empty_string" },
        "surface_field": { "$ref": "#/$defs/non_empty_string" },
        "rendered_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rendered_state" }
        },
        "omits_no_present_state": { "const": true },
        "status_message_id": { "$ref": "#/$defs/omission_message_id" }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present_set_non_empty",
        "present_set_derived_from_descriptor",
        "all_consumers_projected",
        "no_consumer_omits_present_state",
        "no_consumer_adds_absent_state",
        "labels_identical_across_consumers",
        "explanations_identical_across_consumers",
        "weakening_aligns_with_claim_narrowing"
      ],
      "properties": {
        "present_set_non_empty": { "const": true },
        "present_set_derived_from_descriptor": { "const": true },
        "all_consumers_projected": { "const": true },
        "no_consumer_omits_present_state": { "const": true },
        "no_consumer_adds_absent_state": { "const": true },
        "labels_identical_across_consumers": { "const": true },
        "explanations_identical_across_consumers": { "const": true },
        "weakening_aligns_with_claim_narrowing": { "const": true }
      }
    },
    "omission_guard_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "case_id",
        "case_label",
        "descriptor_id",
        "descriptor_label",
        "artifact_ref",
        "descriptor",
        "present_states",
        "weakening_present",
        "claim_state",
        "consumer_projections",
        "guard",
        "explanation_drawer_message_id"
      ],
      "properties": {
        "record_kind": { "const": "m5_omission_guard_case" },
        "case_id": { "$ref": "#/$defs/non_empty_string" },
        "case_label": { "$ref": "#/$defs/non_empty_string" },
        "descriptor_id": { "$ref": "#/$defs/non_empty_string" },
        "descriptor_label": { "$ref": "#/$defs/non_empty_string" },
        "artifact_ref": { "$ref": "#/$defs/artifact_binding" },
        "descriptor": { "$ref": "#/$defs/descriptor_object" },
        "present_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rendered_state" }
        },
        "weakening_present": { "type": "boolean" },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "consumer_projections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_state_projection" }
        },
        "guard": { "$ref": "#/$defs/guard" },
        "explanation_drawer_message_id": { "$ref": "#/$defs/omission_message_id" }
      }
    },
    "omission_state_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "label", "is_weakening", "explanation_message_id"],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "is_weakening": { "type": "boolean" },
        "explanation_message_id": { "$ref": "#/$defs/omission_message_id" }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "consumers", "claim_states", "facets"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/omission_state_entry" }
        },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "claim_states": { "type": "array", "items": { "$ref": "#/$defs/claim_state" } },
        "facets": { "type": "array", "items": { "$ref": "#/$defs/facet" } }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases_validate",
        "present_sets_derived_from_descriptors",
        "one_vocabulary_across_consumers",
        "no_consumer_silently_omits",
        "mirror_offline_side_loaded_first_class",
        "not_provided_never_hidden",
        "partial_states_surfaced",
        "official_anchor_explicit",
        "weakening_aligns_with_claim_narrowing",
        "controlled_enums_frozen",
        "shared_across_consumers",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "cases_validate": { "const": true },
        "present_sets_derived_from_descriptors": { "const": true },
        "one_vocabulary_across_consumers": { "const": true },
        "no_consumer_silently_omits": { "const": true },
        "mirror_offline_side_loaded_first_class": { "const": true },
        "not_provided_never_hidden": { "const": true },
        "partial_states_surfaced": { "const": true },
        "official_anchor_explicit": { "const": true },
        "weakening_aligns_with_claim_narrowing": { "const": true },
        "controlled_enums_frozen": { "const": true },
        "shared_across_consumers": { "const": true },
        "export_carries_no_raw_material": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cases",
        "cases_with_weakening",
        "fully_official_cases",
        "total_state_renderings",
        "distinct_states_exercised"
      ],
      "properties": {
        "total_cases": { "type": "integer", "minimum": 0 },
        "cases_with_weakening": { "type": "integer", "minimum": 0 },
        "fully_official_cases": { "type": "integer", "minimum": 0 },
        "total_state_renderings": { "type": "integer", "minimum": 0 },
        "distinct_states_exercised": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "registry_id",
    "report_label",
    "cases",
    "vocabulary",
    "consumers",
    "conformance",
    "summary",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_omission_guard_registry" },
    "schema_version": { "const": 1 },
    "registry_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/omission_guard_case" }
    },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "conformance": { "$ref": "#/$defs/conformance" },
    "summary": { "$ref": "#/$defs/summary" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  }
}
