{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/provenance/m5-descriptor-badge-matrix.schema.json",
  "title": "Aureline M5 descriptor / badge matrix packet",
  "description": "The canonical M5 provenance, freshness, qualification, and client-scope descriptor and badge runtime. Each descriptor object declares its badge family, frozen value vocabulary, explanation-drawer message id, first consumer, source-of-truth schema, the proof packet that keeps it current, and a freshness state. The frozen downgrade rules name how each non-authoritative origin, non-current freshness state, and narrowed client scope narrows or blocks a claim. Each claimed public-truth consumer binds the descriptor families it renders, and the matrix derives each consumer's coverage gaps, gate decision, and effective qualification: a stale descriptor proof deterministically auto-narrows the consumers that bind it below Stable, and a missing/expired proof — or a descriptor family the matrix does not govern — blocks them, so weaker evidence never leaves a claim standing as implied stable authority. The release center, Help/About, marketplace, docs/help, support exports, and companion handoffs all consume this one runtime. The packet carries metadata and refs only: no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "descriptors",
    "downgrade_rules",
    "consumer_bindings",
    "summary",
    "disclosure",
    "release_gate",
    "vocabulary",
    "conformance",
    "source_proof_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_descriptor_badge_matrix" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "$ref": "#/$defs/non_empty_string" },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/descriptor_contract" }
    },
    "downgrade_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_rule" }
    },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_binding" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "release_gate": { "$ref": "#/$defs/release_gate" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "source_proof_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "descriptor_message_id": {
      "type": "string",
      "pattern": "^public_truth_descriptor\\."
    },
    "descriptor_family": {
      "enum": ["provenance", "freshness", "qualification", "client_scope"]
    },
    "badge_family": {
      "enum": [
        "provenance_badge",
        "freshness_badge",
        "qualification_badge",
        "client_scope_badge"
      ]
    },
    "provenance_class": {
      "enum": [
        "first_party_signed",
        "vendor",
        "community",
        "mirror",
        "offline_bundle",
        "side_loaded",
        "not_provided"
      ]
    },
    "freshness_state": {
      "enum": ["current", "stale", "expired", "missing"]
    },
    "qualification_class": {
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "client_scope": {
      "enum": [
        "desktop_full",
        "companion_scoped",
        "mobile_companion",
        "embedded_panel",
        "browser_reference",
        "handoff_only"
      ]
    },
    "consumer": {
      "enum": [
        "release_center",
        "help_about",
        "marketplace",
        "docs_help",
        "certification",
        "evaluation_packs",
        "support_export",
        "companion_handoff"
      ]
    },
    "gate_decision": {
      "enum": ["governed", "narrowed", "blocked"]
    },
    "signal": {
      "enum": ["green", "yellow", "red"]
    },
    "consumer_status": {
      "enum": ["mapped", "provisional", "unmapped"]
    },
    "gap_kind": {
      "enum": ["descriptor_mapping_missing", "proof_stale", "proof_expired", "proof_missing"]
    },
    "downgrade_effect": {
      "enum": ["narrow", "block"]
    },
    "descriptor_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "descriptor_object_id",
        "descriptor_label",
        "badge_family",
        "value_tokens",
        "badge_tokens",
        "explanation_drawer_message_id",
        "owner_role",
        "first_consumer",
        "schema_ref",
        "proof_packet_ref",
        "proof_freshness",
        "detail_message_id"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/descriptor_family" },
        "descriptor_object_id": { "$ref": "#/$defs/non_empty_string" },
        "descriptor_label": { "$ref": "#/$defs/non_empty_string" },
        "badge_family": { "$ref": "#/$defs/badge_family" },
        "value_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "badge_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "explanation_drawer_message_id": { "$ref": "#/$defs/descriptor_message_id" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "first_consumer": { "$ref": "#/$defs/consumer" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "proof_freshness": { "$ref": "#/$defs/freshness_state" },
        "detail_message_id": { "$ref": "#/$defs/descriptor_message_id" }
      }
    },
    "downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_family",
        "trigger_token",
        "effect",
        "effective_floor",
        "rationale_message_id"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_family": { "$ref": "#/$defs/descriptor_family" },
        "trigger_token": { "$ref": "#/$defs/non_empty_string" },
        "effect": { "$ref": "#/$defs/downgrade_effect" },
        "effective_floor": { "$ref": "#/$defs/qualification_class" },
        "rationale_message_id": { "$ref": "#/$defs/descriptor_message_id" }
      }
    },
    "descriptor_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "family", "gap_kind", "cause_message_id"],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "family": { "$ref": "#/$defs/descriptor_family" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "cause_message_id": { "$ref": "#/$defs/descriptor_message_id" }
      }
    },
    "consumer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "owner_role",
        "claimed_qualification",
        "bound_families",
        "covered_badge_families",
        "effective_qualification",
        "status",
        "signal",
        "gate_decision",
        "gaps",
        "status_message_id",
        "gate_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "claimed_qualification": { "$ref": "#/$defs/qualification_class" },
        "bound_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/descriptor_family" }
        },
        "covered_badge_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/badge_family" }
        },
        "effective_qualification": { "$ref": "#/$defs/qualification_class" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gate_decision": { "$ref": "#/$defs/gate_decision" },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor_gap" }
        },
        "status_message_id": { "$ref": "#/$defs/descriptor_message_id" },
        "gate_message_id": { "$ref": "#/$defs/descriptor_message_id" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_descriptors",
        "total_badge_families",
        "total_downgrade_rules",
        "total_consumers",
        "governed_consumer_count",
        "narrowed_consumer_count",
        "blocked_consumer_count",
        "current_descriptor_count",
        "stale_descriptor_count",
        "expired_descriptor_count",
        "missing_descriptor_count",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_descriptors": { "type": "integer", "minimum": 0 },
        "total_badge_families": { "type": "integer", "minimum": 0 },
        "total_downgrade_rules": { "type": "integer", "minimum": 0 },
        "total_consumers": { "type": "integer", "minimum": 0 },
        "governed_consumer_count": { "type": "integer", "minimum": 0 },
        "narrowed_consumer_count": { "type": "integer", "minimum": 0 },
        "blocked_consumer_count": { "type": "integer", "minimum": 0 },
        "current_descriptor_count": { "type": "integer", "minimum": 0 },
        "stale_descriptor_count": { "type": "integer", "minimum": 0 },
        "expired_descriptor_count": { "type": "integer", "minimum": 0 },
        "missing_descriptor_count": { "type": "integer", "minimum": 0 },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_center_consumes_runtime",
        "help_about_consumes_runtime",
        "marketplace_consumes_runtime",
        "docs_help_consumes_runtime",
        "support_export_consumes_runtime",
        "companion_handoff_consumes_runtime"
      ],
      "properties": {
        "release_center_consumes_runtime": { "const": true },
        "help_about_consumes_runtime": { "const": true },
        "marketplace_consumes_runtime": { "const": true },
        "docs_help_consumes_runtime": { "const": true },
        "support_export_consumes_runtime": { "const": true },
        "companion_handoff_consumes_runtime": { "const": true }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_stable_promotion",
        "blocked_consumers",
        "narrowed_consumers",
        "governed_consumers",
        "gate_message_id"
      ],
      "properties": {
        "blocks_stable_promotion": { "type": "boolean" },
        "blocked_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "narrowed_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "governed_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "gate_message_id": { "$ref": "#/$defs/descriptor_message_id" }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_families",
        "badge_families",
        "provenance_classes",
        "freshness_states",
        "qualification_classes",
        "client_scopes",
        "consumers",
        "gate_decisions",
        "signals",
        "consumer_statuses",
        "gap_kinds",
        "downgrade_effects"
      ],
      "properties": {
        "descriptor_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor_family" }
        },
        "badge_families": { "type": "array", "items": { "$ref": "#/$defs/badge_family" } },
        "provenance_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance_class" }
        },
        "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness_state" } },
        "qualification_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualification_class" }
        },
        "client_scopes": { "type": "array", "items": { "$ref": "#/$defs/client_scope" } },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "gate_decisions": { "type": "array", "items": { "$ref": "#/$defs/gate_decision" } },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
        "consumer_statuses": { "type": "array", "items": { "$ref": "#/$defs/consumer_status" } },
        "gap_kinds": { "type": "array", "items": { "$ref": "#/$defs/gap_kind" } },
        "downgrade_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/downgrade_effect" }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_family_has_a_descriptor",
        "every_badge_family_maps_to_a_descriptor",
        "every_consumer_binds_at_least_one_descriptor",
        "every_consumer_maps_to_descriptors_or_narrows",
        "stale_proof_narrows_deterministically",
        "missing_descriptor_blocks_stable_promotion",
        "exact_gaps_named_per_consumer",
        "weaker_origins_never_omitted",
        "downgrade_rules_cover_every_weaker_value",
        "surfaces_consume_one_runtime",
        "generated_from_checked_in_descriptors",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "every_family_has_a_descriptor": { "const": true },
        "every_badge_family_maps_to_a_descriptor": { "const": true },
        "every_consumer_binds_at_least_one_descriptor": { "const": true },
        "every_consumer_maps_to_descriptors_or_narrows": { "const": true },
        "stale_proof_narrows_deterministically": { "const": true },
        "missing_descriptor_blocks_stable_promotion": { "const": true },
        "exact_gaps_named_per_consumer": { "const": true },
        "weaker_origins_never_omitted": { "const": true },
        "downgrade_rules_cover_every_weaker_value": { "const": true },
        "surfaces_consume_one_runtime": { "const": true },
        "generated_from_checked_in_descriptors": { "const": true },
        "export_carries_no_raw_material": { "const": true }
      }
    }
  }
}
