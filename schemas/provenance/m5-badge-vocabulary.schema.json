{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/provenance/m5-badge-vocabulary.schema.json",
  "title": "Aureline M5 badge vocabulary and explanation-drawer packet",
  "description": "The one resolved badge / explanation-drawer toolkit every public-truth surface renders for the provenance, freshness, qualification, and client-scope descriptors. For each controlled-enum value behind a badge it publishes an export-safe badge id, a user-facing label drawn from the controlled vocabulary, a one-line summary, the explanation-drawer body, a tone, the claim effect it carries, and the descriptor identity (badge family + dimension + value token) behind it. Entries are grouped under the four badge families, each citing the family explanation-drawer message id the descriptor matrix already points at. The disclosure records that the release center, Help/About, marketplace, docs/help, support exports, and companion handoffs render this one vocabulary, and the required-term coverage proves each contract-named user-facing term renders as exactly one badge. The packet carries metadata and copy only: no credential bodies or raw provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "families",
    "required_term_coverage",
    "summary",
    "disclosure",
    "vocabulary",
    "conformance",
    "source_descriptor_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_badge_vocabulary" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "$ref": "#/$defs/non_empty_string" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family_group" }
    },
    "required_term_coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/required_term_coverage" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "source_descriptor_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "badge_message_id": {
      "type": "string",
      "pattern": "^public_truth_descriptor\\.badge\\."
    },
    "family_drawer_message_id": {
      "type": "string",
      "pattern": "^public_truth_descriptor\\."
    },
    "badge_family": {
      "enum": [
        "provenance_badge",
        "freshness_badge",
        "qualification_badge",
        "client_scope_badge"
      ]
    },
    "descriptor_family": {
      "enum": ["provenance", "freshness", "qualification", "client_scope"]
    },
    "dimension": {
      "enum": [
        "source_origin",
        "signature_state",
        "freshness_state",
        "evidence_state",
        "support_class",
        "client_kind",
        "authority_class",
        "handoff_requirement"
      ]
    },
    "tone": {
      "enum": ["authoritative", "informational", "caution", "blocking"]
    },
    "signal": {
      "enum": ["green", "yellow", "red"]
    },
    "claim_effect": {
      "enum": ["none", "narrows", "blocks"]
    },
    "support_class": {
      "enum": [
        "certified",
        "supported",
        "limited",
        "community",
        "experimental",
        "unsupported"
      ]
    },
    "badge_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_family",
        "descriptor_family",
        "dimension",
        "value_token",
        "badge_id",
        "label",
        "summary",
        "explanation_drawer",
        "tone",
        "signal",
        "claim_effect",
        "message_id"
      ],
      "properties": {
        "badge_family": { "$ref": "#/$defs/badge_family" },
        "descriptor_family": { "$ref": "#/$defs/descriptor_family" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "value_token": { "$ref": "#/$defs/non_empty_string" },
        "badge_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "explanation_drawer": { "$ref": "#/$defs/non_empty_string" },
        "tone": { "$ref": "#/$defs/tone" },
        "signal": { "$ref": "#/$defs/signal" },
        "claim_effect": { "$ref": "#/$defs/claim_effect" },
        "message_id": { "$ref": "#/$defs/badge_message_id" }
      }
    },
    "family_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_family",
        "descriptor_family",
        "family_label",
        "family_drawer_message_id",
        "entries"
      ],
      "properties": {
        "badge_family": { "$ref": "#/$defs/badge_family" },
        "descriptor_family": { "$ref": "#/$defs/descriptor_family" },
        "family_label": { "$ref": "#/$defs/non_empty_string" },
        "family_drawer_message_id": { "$ref": "#/$defs/family_drawer_message_id" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/badge_entry" }
        }
      }
    },
    "required_term_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "badge_id", "dimension", "value_token"],
      "properties": {
        "term": { "$ref": "#/$defs/non_empty_string" },
        "badge_id": { "$ref": "#/$defs/non_empty_string" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "value_token": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_families",
        "total_dimensions",
        "total_badges",
        "authoritative_badge_count",
        "informational_badge_count",
        "caution_badge_count",
        "blocking_badge_count",
        "narrowing_badge_count",
        "blocking_claim_badge_count",
        "required_terms_covered"
      ],
      "properties": {
        "total_families": { "type": "integer", "minimum": 0 },
        "total_dimensions": { "type": "integer", "minimum": 0 },
        "total_badges": { "type": "integer", "minimum": 0 },
        "authoritative_badge_count": { "type": "integer", "minimum": 0 },
        "informational_badge_count": { "type": "integer", "minimum": 0 },
        "caution_badge_count": { "type": "integer", "minimum": 0 },
        "blocking_badge_count": { "type": "integer", "minimum": 0 },
        "narrowing_badge_count": { "type": "integer", "minimum": 0 },
        "blocking_claim_badge_count": { "type": "integer", "minimum": 0 },
        "required_terms_covered": { "type": "integer", "minimum": 0 }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_center_renders_vocabulary",
        "help_about_renders_vocabulary",
        "marketplace_renders_vocabulary",
        "docs_help_renders_vocabulary",
        "support_export_renders_vocabulary",
        "companion_handoff_renders_vocabulary"
      ],
      "properties": {
        "release_center_renders_vocabulary": { "const": true },
        "help_about_renders_vocabulary": { "const": true },
        "marketplace_renders_vocabulary": { "const": true },
        "docs_help_renders_vocabulary": { "const": true },
        "support_export_renders_vocabulary": { "const": true },
        "companion_handoff_renders_vocabulary": { "const": true }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_families",
        "dimensions",
        "tones",
        "signals",
        "claim_effects",
        "support_classes",
        "required_terms"
      ],
      "properties": {
        "badge_families": { "type": "array", "items": { "$ref": "#/$defs/badge_family" } },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
        "tones": { "type": "array", "items": { "$ref": "#/$defs/tone" } },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
        "claim_effects": { "type": "array", "items": { "$ref": "#/$defs/claim_effect" } },
        "support_classes": { "type": "array", "items": { "$ref": "#/$defs/support_class" } },
        "required_terms": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_family_has_badges",
        "every_dimension_maps_to_a_family",
        "labels_from_controlled_enums",
        "every_required_term_present",
        "weaker_badges_carry_claim_effect",
        "weaker_origins_never_omitted",
        "export_preserves_descriptor_identity",
        "same_drawer_text_across_consumers",
        "surfaces_render_one_vocabulary",
        "generated_from_controlled_enums",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "every_family_has_badges": { "const": true },
        "every_dimension_maps_to_a_family": { "const": true },
        "labels_from_controlled_enums": { "const": true },
        "every_required_term_present": { "const": true },
        "weaker_badges_carry_claim_effect": { "const": true },
        "weaker_origins_never_omitted": { "const": true },
        "export_preserves_descriptor_identity": { "const": true },
        "same_drawer_text_across_consumers": { "const": true },
        "surfaces_render_one_vocabulary": { "const": true },
        "generated_from_controlled_enums": { "const": true },
        "export_carries_no_raw_material": { "const": true }
      }
    }
  }
}
