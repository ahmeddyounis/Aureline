{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/provenance/m5-freshness-descriptor.schema.json",
  "title": "Aureline M5 evidence-freshness descriptor object",
  "description": "The shared evidence-freshness descriptor object: the frozen freshness vocabulary, its badge family, explanation drawer, first consumer, and the proof packet that keeps it current. Stale evidence narrows a claim; expired or missing evidence blocks Stable promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family",
    "descriptor_object_id",
    "descriptor_label",
    "badge_family",
    "value_tokens",
    "badge_tokens",
    "explanation_drawer_message_id",
    "owner_role",
    "first_consumer",
    "schema_ref",
    "proof_packet_ref",
    "proof_freshness",
    "detail_message_id"
  ],
  "properties": {
    "family": { "const": "freshness" },
    "descriptor_object_id": { "$ref": "#/$defs/non_empty_string" },
    "descriptor_label": { "$ref": "#/$defs/non_empty_string" },
    "badge_family": { "const": "freshness_badge" },
    "value_tokens": { "const": ["current", "stale", "expired", "missing"] },
    "badge_tokens": { "const": ["current", "stale", "expired", "missing"] },
    "explanation_drawer_message_id": { "$ref": "#/$defs/descriptor_message_id" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "first_consumer": { "const": "release_center" },
    "schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "proof_freshness": { "enum": ["current", "stale", "expired", "missing"] },
    "detail_message_id": { "$ref": "#/$defs/descriptor_message_id" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "descriptor_message_id": { "type": "string", "pattern": "^public_truth_descriptor\\." }
  }
}
