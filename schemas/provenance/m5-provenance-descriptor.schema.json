{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/provenance/m5-provenance-descriptor.schema.json",
  "title": "Aureline M5 provenance / source-origin descriptor object",
  "description": "The shared provenance descriptor object: the frozen source-origin vocabulary, its badge family, explanation drawer, first consumer, and the proof packet that keeps it current. Mirror, offline-bundle, side-loaded, and not-provided are first-class tokens so a weaker origin can never disappear into omission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family",
    "descriptor_object_id",
    "descriptor_label",
    "badge_family",
    "value_tokens",
    "badge_tokens",
    "explanation_drawer_message_id",
    "owner_role",
    "first_consumer",
    "schema_ref",
    "proof_packet_ref",
    "proof_freshness",
    "detail_message_id"
  ],
  "properties": {
    "family": { "const": "provenance" },
    "descriptor_object_id": { "$ref": "#/$defs/non_empty_string" },
    "descriptor_label": { "$ref": "#/$defs/non_empty_string" },
    "badge_family": { "const": "provenance_badge" },
    "value_tokens": {
      "const": [
        "first_party_signed",
        "vendor",
        "community",
        "mirror",
        "offline_bundle",
        "side_loaded",
        "not_provided"
      ]
    },
    "badge_tokens": {
      "const": [
        "first_party_signed",
        "vendor",
        "community",
        "mirror",
        "offline_bundle",
        "side_loaded",
        "not_provided"
      ]
    },
    "explanation_drawer_message_id": { "$ref": "#/$defs/descriptor_message_id" },
    "owner_role": { "$ref": "#/$defs/non_empty_string" },
    "first_consumer": { "const": "help_about" },
    "schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "proof_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "proof_freshness": { "enum": ["current", "stale", "expired", "missing"] },
    "detail_message_id": { "$ref": "#/$defs/descriptor_message_id" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "descriptor_message_id": { "type": "string", "pattern": "^public_truth_descriptor\\." }
  }
}
