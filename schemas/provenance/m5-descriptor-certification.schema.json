{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/provenance/m5-descriptor-certification.schema.json",
  "title": "Aureline M5 descriptor / badge certification",
  "description": "The certification over the shared M5 public-truth runtime lanes (descriptor object, descriptor/badge matrix, badge vocabulary, claim narrowing, descriptor join, omission guard, client-scope card). It binds every claimed M5 consumer — release center, Help/About, marketplace, docs/help, certification, evaluation packs, support exports, and companion handoffs — to the runtime lanes it reads, the descriptor schemas and badge families those lanes expose, the frozen downgrade rules that govern them, and the release-grade parity-proof fixtures that keep them current, then auto-narrows a consumer's claim deterministically the moment any lane it reads goes stale (narrow) or expired/missing/uncertified (block). Each lane belongs to one of three certification dimensions — descriptor parity, badge/runtime proof, or freshness integration — so a drift report names which dimension aged out. The packet is the one certification output release, support, docs, and evaluation surfaces consume; it carries metadata and refs only: no credential bodies or raw provider payloads.",
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "certification_message_id": {
      "type": "string",
      "pattern": "^public_truth_descriptor\\."
    },
    "runtime_lane": {
      "enum": [
        "descriptor_object",
        "descriptor_badge_matrix",
        "badge_vocabulary",
        "claim_narrowing",
        "descriptor_join",
        "omission_guard",
        "client_scope_card"
      ]
    },
    "dimension": {
      "enum": ["descriptor_parity", "badge_runtime", "freshness_integration"]
    },
    "descriptor_family": {
      "enum": ["provenance", "freshness", "qualification", "client_scope"]
    },
    "badge_family": {
      "enum": [
        "provenance_badge",
        "freshness_badge",
        "qualification_badge",
        "client_scope_badge"
      ]
    },
    "consumer": {
      "enum": [
        "release_center",
        "help_about",
        "marketplace",
        "docs_help",
        "certification",
        "evaluation_packs",
        "support_export",
        "companion_handoff"
      ]
    },
    "freshness": {
      "enum": ["current", "stale", "expired", "missing"]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "deprecated", "unavailable"]
    },
    "gate": { "enum": ["governed", "narrowed", "blocked"] },
    "signal": { "enum": ["green", "yellow", "red"] },
    "consumer_status": { "enum": ["mapped", "provisional", "unmapped"] },
    "gap_kind": {
      "enum": ["descriptor_mapping_missing", "proof_stale", "proof_expired", "proof_missing"]
    },
    "downgrade_effect": { "enum": ["narrow", "block"] },
    "certified_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "lane_label",
        "dimension",
        "schema_ref",
        "published_artifact_ref",
        "parity_proof_ref",
        "owner_role",
        "proof_freshness",
        "status",
        "signal",
        "detail_message_id"
      ],
      "properties": {
        "lane": { "$ref": "#/$defs/runtime_lane" },
        "lane_label": { "$ref": "#/$defs/non_empty_string" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "schema_ref": { "$ref": "#/$defs/non_empty_string" },
        "published_artifact_ref": { "$ref": "#/$defs/non_empty_string" },
        "parity_proof_ref": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "proof_freshness": { "$ref": "#/$defs/freshness" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "detail_message_id": { "$ref": "#/$defs/certification_message_id" }
      }
    },
    "downgrade_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger_family",
        "trigger_token",
        "effect",
        "effective_floor",
        "rationale_message_id"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "trigger_family": { "$ref": "#/$defs/descriptor_family" },
        "trigger_token": { "$ref": "#/$defs/non_empty_string" },
        "effect": { "$ref": "#/$defs/downgrade_effect" },
        "effective_floor": { "$ref": "#/$defs/qualification" },
        "rationale_message_id": { "$ref": "#/$defs/certification_message_id" }
      }
    },
    "certification_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "lane", "dimension", "gap_kind", "cause_message_id"],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "lane": { "$ref": "#/$defs/runtime_lane" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "gap_kind": { "$ref": "#/$defs/gap_kind" },
        "cause_message_id": { "$ref": "#/$defs/certification_message_id" }
      }
    },
    "certified_consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "consumer_label",
        "owner_role",
        "claimed_qualification",
        "bound_families",
        "covered_badge_families",
        "bound_descriptor_schemas",
        "certified_lanes",
        "applicable_downgrade_rule_ids",
        "proof_fixture_refs",
        "effective_qualification",
        "status",
        "signal",
        "gate_decision",
        "gaps",
        "status_message_id",
        "gate_message_id"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer" },
        "consumer_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "claimed_qualification": { "$ref": "#/$defs/qualification" },
        "bound_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/descriptor_family" }
        },
        "covered_badge_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/badge_family" }
        },
        "bound_descriptor_schemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "certified_lanes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runtime_lane" }
        },
        "applicable_downgrade_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "proof_fixture_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "effective_qualification": { "$ref": "#/$defs/qualification" },
        "status": { "$ref": "#/$defs/consumer_status" },
        "signal": { "$ref": "#/$defs/signal" },
        "gate_decision": { "$ref": "#/$defs/gate" },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/certification_gap" }
        },
        "status_message_id": { "$ref": "#/$defs/certification_message_id" },
        "gate_message_id": { "$ref": "#/$defs/certification_message_id" }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_center_consumes_certification",
        "help_about_consumes_certification",
        "marketplace_consumes_certification",
        "docs_help_consumes_certification",
        "certification_consumes_certification",
        "evaluation_packs_consume_certification",
        "support_export_consumes_certification",
        "companion_handoff_consumes_certification"
      ],
      "properties": {
        "release_center_consumes_certification": { "const": true },
        "help_about_consumes_certification": { "const": true },
        "marketplace_consumes_certification": { "const": true },
        "docs_help_consumes_certification": { "const": true },
        "certification_consumes_certification": { "const": true },
        "evaluation_packs_consume_certification": { "const": true },
        "support_export_consumes_certification": { "const": true },
        "companion_handoff_consumes_certification": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_lanes",
        "current_lanes",
        "stale_lanes",
        "expired_lanes",
        "missing_lanes",
        "total_consumers",
        "certified_consumer_count",
        "narrowed_consumer_count",
        "blocked_consumer_count",
        "total_downgrade_rules",
        "blocks_stable_promotion"
      ],
      "properties": {
        "total_lanes": { "type": "integer", "minimum": 0 },
        "current_lanes": { "type": "integer", "minimum": 0 },
        "stale_lanes": { "type": "integer", "minimum": 0 },
        "expired_lanes": { "type": "integer", "minimum": 0 },
        "missing_lanes": { "type": "integer", "minimum": 0 },
        "total_consumers": { "type": "integer", "minimum": 0 },
        "certified_consumer_count": { "type": "integer", "minimum": 0 },
        "narrowed_consumer_count": { "type": "integer", "minimum": 0 },
        "blocked_consumer_count": { "type": "integer", "minimum": 0 },
        "total_downgrade_rules": { "type": "integer", "minimum": 0 },
        "blocks_stable_promotion": { "type": "boolean" }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_stable_promotion",
        "blocked_consumers",
        "narrowed_consumers",
        "certified_consumers",
        "drifted_dimensions",
        "gate_message_id"
      ],
      "properties": {
        "blocks_stable_promotion": { "type": "boolean" },
        "blocked_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "narrowed_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "certified_consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "drifted_dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
        "gate_message_id": { "$ref": "#/$defs/certification_message_id" }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_lanes",
        "dimensions",
        "descriptor_families",
        "badge_families",
        "consumers",
        "freshness_states",
        "qualification_classes",
        "gate_decisions",
        "signals",
        "consumer_statuses",
        "gap_kinds"
      ],
      "properties": {
        "runtime_lanes": { "type": "array", "items": { "$ref": "#/$defs/runtime_lane" } },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
        "descriptor_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor_family" }
        },
        "badge_families": { "type": "array", "items": { "$ref": "#/$defs/badge_family" } },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
        "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/freshness" } },
        "qualification_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualification" }
        },
        "gate_decisions": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
        "consumer_statuses": { "type": "array", "items": { "$ref": "#/$defs/consumer_status" } },
        "gap_kinds": { "type": "array", "items": { "$ref": "#/$defs/gap_kind" } }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_lane_certified_with_proof",
        "every_dimension_covered",
        "every_consumer_maps_to_descriptors_and_proof",
        "every_consumer_reads_at_least_one_lane",
        "stale_proof_narrows_deterministically",
        "missing_proof_blocks_stable_promotion",
        "exact_gaps_named_per_consumer",
        "downgrade_rules_cover_every_weaker_value",
        "surfaces_consume_one_certification",
        "generated_from_checked_in_proofs",
        "controlled_enums_frozen",
        "export_carries_no_raw_material"
      ],
      "properties": {
        "every_lane_certified_with_proof": { "const": true },
        "every_dimension_covered": { "const": true },
        "every_consumer_maps_to_descriptors_and_proof": { "const": true },
        "every_consumer_reads_at_least_one_lane": { "const": true },
        "stale_proof_narrows_deterministically": { "const": true },
        "missing_proof_blocks_stable_promotion": { "const": true },
        "exact_gaps_named_per_consumer": { "const": true },
        "downgrade_rules_cover_every_weaker_value": { "const": true },
        "surfaces_consume_one_certification": { "const": true },
        "generated_from_checked_in_proofs": { "const": true },
        "controlled_enums_frozen": { "const": true },
        "export_carries_no_raw_material": { "const": true }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "report_label",
    "evaluated_at",
    "lanes",
    "downgrade_rules",
    "consumers",
    "consumer_tokens",
    "disclosure",
    "summary",
    "release_gate",
    "vocabulary",
    "conformance",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": { "const": "m5_descriptor_certification" },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "report_label": { "$ref": "#/$defs/non_empty_string" },
    "evaluated_at": { "$ref": "#/$defs/non_empty_string" },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certified_lane" }
    },
    "downgrade_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/downgrade_rule" }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certified_consumer" }
    },
    "consumer_tokens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "summary": { "$ref": "#/$defs/summary" },
    "release_gate": { "$ref": "#/$defs/release_gate" },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  }
}
