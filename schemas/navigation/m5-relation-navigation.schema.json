{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/navigation/m5-relation-navigation.schema.json",
  "title": "Aureline relation-navigation matrix",
  "description": "Boundary schema for the relation-navigation matrix: the frozen, typed contract for Aureline's definition/declaration/implementation/reference/hierarchy/related-object and rename-preview navigation truth. The matrix names each governed relation-navigation object family (navigation target, reference occurrence, hierarchy edge, related-object relation, rename-preview set, and the relation/fallback vocabulary), cites the canonical boundary schema(s) and producing crate module it binds, maps each one to the proof packet that keeps it current, pins one shared qualification-state vocabulary, defines the controlled vocabulary spanning relation kind, proof class, access kind, ambiguity, freshness, partiality, generated/runtime label, and rename omission reason, and lists the consumer surfaces (search palette, editor assist, graph overlay, docs/help, AI context, review workspace, support export, CLI/headless, and shell continuity) that render it. Relation kinds stay explicit and trustworthy: a definition is not a declaration, grep fallback never masquerades as semantic certainty, implementation and hierarchy edges preserve proof class and ambiguity, related-object navigation stays source-attributed, and rename preview exposes blocked/generated/read-only/partial-scope candidates before any broad mutation. No source bodies, raw paths, provider payloads, URLs, hostnames, or credentials cross this boundary; the record carries opaque object refs, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_relation_navigation_schema_version",
    "schema_ref",
    "matrix_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "shared_vocabulary",
    "state_vocabulary",
    "objects",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_relation_navigation_matrix" },
    "m5_relation_navigation_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/navigation/m5-relation-navigation.schema.json" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "shared_vocabulary": { "$ref": "#/$defs/shared_vocabulary" },
    "state_vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state_term" }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/object_entry" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matrix_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path. A fragment after '#' may name an enum variant for provenance.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "object_class": {
      "type": "string",
      "enum": [
        "navigation_target",
        "reference_occurrence",
        "hierarchy_edge",
        "related_object_relation",
        "rename_preview_set",
        "relation_fallback_vocabulary"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "exact_semantic",
        "indexed_semantic",
        "imported_snapshot",
        "lexical_fallback_disclosed",
        "syntax_fallback_disclosed",
        "framework_derived_disclosed",
        "runtime_observed_disclosed",
        "ambiguous_needs_selection",
        "multiple_candidates_ranked",
        "drifted_needs_review",
        "partial_scope",
        "stale_scope",
        "generated_boundary_disclosed",
        "read_only_protected",
        "rename_blocked_pending_review",
        "missing_target",
        "scope_unavailable",
        "unavailable"
      ]
    },
    "controlled_vocabulary": {
      "type": "string",
      "enum": [
        "relation_kind",
        "proof_class",
        "access_kind",
        "ambiguity",
        "freshness",
        "partiality",
        "generated_runtime_label",
        "rename_omission_reason"
      ]
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "definition",
        "declaration",
        "implementation",
        "reference",
        "type",
        "call",
        "route-binding",
        "owner-link",
        "doc-link"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "search_palette",
        "editor_assist",
        "graph_overlay",
        "docs_help",
        "ai_context",
        "review_workspace",
        "support_export",
        "cli_headless",
        "shell_continuity"
      ]
    },
    "redaction_class": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "summary_and_refs_only",
        "operator_only_restricted",
        "internal_support_restricted"
      ]
    },
    "token_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "label"],
      "properties": {
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "token_def_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/token_def" }
    },
    "shared_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_kinds",
        "proof_classes",
        "access_kinds",
        "ambiguity_classes",
        "freshness_classes",
        "partiality_classes",
        "generated_runtime_labels",
        "rename_omission_reasons",
        "redaction_classes",
        "consumer_classes",
        "source_schema_refs"
      ],
      "properties": {
        "relation_kinds": { "$ref": "#/$defs/token_def_array" },
        "proof_classes": { "$ref": "#/$defs/token_def_array" },
        "access_kinds": { "$ref": "#/$defs/token_def_array" },
        "ambiguity_classes": { "$ref": "#/$defs/token_def_array" },
        "freshness_classes": { "$ref": "#/$defs/token_def_array" },
        "partiality_classes": { "$ref": "#/$defs/token_def_array" },
        "generated_runtime_labels": { "$ref": "#/$defs/token_def_array" },
        "rename_omission_reasons": { "$ref": "#/$defs/token_def_array" },
        "redaction_classes": { "$ref": "#/$defs/token_def_array" },
        "consumer_classes": { "$ref": "#/$defs/token_def_array" },
        "source_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        }
      }
    },
    "state_term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "token",
        "label",
        "requires_disclosure",
        "is_fallback_proof",
        "is_ambiguity",
        "is_rename_omission",
        "derived_from_refs"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/state_class" },
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "requires_disclosure": { "type": "boolean" },
        "is_fallback_proof": { "type": "boolean" },
        "is_ambiguity": { "type": "boolean" },
        "is_rename_omission": { "type": "boolean" },
        "derived_from_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        }
      }
    },
    "field_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "label", "required"],
      "properties": {
        "field_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "required": { "type": "boolean" }
      }
    },
    "object_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "object_id",
        "label",
        "summary",
        "canonical_schema_refs",
        "produced_by_refs",
        "proof_packet_ref",
        "consumed_by",
        "relation_kinds",
        "applicable_states",
        "controlled_vocabularies",
        "required_fields",
        "proof_class_required",
        "carries_source_attribution",
        "source_attribution_field",
        "default_redaction",
        "locally_inspectable",
        "typed_not_prose_only",
        "boundary_note"
      ],
      "properties": {
        "object": { "$ref": "#/$defs/object_class" },
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "canonical_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "produced_by_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "consumed_by": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_class" }
        },
        "relation_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relation_kind" }
        },
        "applicable_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_class" }
        },
        "controlled_vocabularies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/controlled_vocabulary" }
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field_def" }
        },
        "proof_class_required": { "const": true },
        "carries_source_attribution": { "type": "boolean" },
        "source_attribution_field": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "default_redaction": { "$ref": "#/$defs/redaction_class" },
        "locally_inspectable": { "const": true },
        "typed_not_prose_only": { "const": true },
        "boundary_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "matrix_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
