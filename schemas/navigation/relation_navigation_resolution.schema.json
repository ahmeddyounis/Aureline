{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/navigation/relation_navigation_resolution.schema.json",
  "title": "Aureline relation-navigation resolution corpus",
  "description": "Boundary schema for the relation-resolution corpus: the frozen contract for how Aureline resolves a Go to Definition / Declaration / Implementation / Type Definition command without silently aliasing one relation kind for another. Each scenario carries a navigation request and the resolution the resolver produces for it: a distinct relation kind resolved to a single target, a disambiguation set opened instead of guessing a best target, or a command reported unavailable. A relation kind that differs from the request only ever appears as a disclosed fallback carrying a missing-provider reason and a fallback note; it is never relabeled under the requested kind. Every resolution records the request id, navigated relation kind, provider/proof/freshness/ambiguity truth, and a replay explanation, so support and debug packets can reconstruct which relation kind was navigated and why. No source bodies, raw paths, provider payloads, URLs, hostnames, or credentials cross this boundary; the record carries opaque object handles, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "relation_resolution_schema_version",
    "schema_ref",
    "set_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "scenarios",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "relation_navigation_resolution_set" },
    "relation_resolution_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/navigation/relation_navigation_resolution.schema.json" },
    "set_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "pattern": "^(schemas|crates|artifacts|fixtures|docs)/"
    },
    "handle_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(aureline://|schemas/|crates/|artifacts/|fixtures/|docs/)"
    },
    "navigation_command": {
      "type": "string",
      "enum": [
        "go_to_definition",
        "go_to_declaration",
        "go_to_implementation",
        "go_to_type_definition"
      ]
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "definition",
        "declaration",
        "implementation",
        "reference",
        "type",
        "call",
        "route-binding",
        "owner-link",
        "doc-link"
      ]
    },
    "provider_class": {
      "type": "string",
      "enum": [
        "syntax",
        "project_graph",
        "language_server",
        "framework_pack",
        "notebook_adapter",
        "generated_source_bridge",
        "search_index",
        "remote_index",
        "imported_snapshot",
        "runtime_observer",
        "ai_assist"
      ]
    },
    "proof_class": {
      "type": "string",
      "enum": [
        "direct_semantic",
        "indexed_semantic",
        "lexical_fallback",
        "syntax_fallback",
        "imported_evidence",
        "framework_derived",
        "runtime_observed",
        "ai_inferred",
        "unavailable"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "exact",
        "indexed",
        "imported",
        "partial",
        "stale",
        "unavailable",
        "heuristic",
        "workspace_slice_limited"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["authoritative_live", "warm_cached", "degraded_cached", "stale", "unverified"]
    },
    "ambiguity_class": {
      "type": "string",
      "enum": [
        "unambiguous",
        "ambiguous_needs_selection",
        "multiple_candidates_ranked",
        "drifted_needs_review",
        "missing_target",
        "scope_unavailable"
      ]
    },
    "scope_completeness": {
      "type": "string",
      "enum": [
        "complete_for_declared_scope",
        "partial_for_declared_scope",
        "stale_for_declared_scope",
        "unavailable_for_declared_scope"
      ]
    },
    "generated_or_external_state": {
      "type": "string",
      "enum": [
        "authored_source",
        "generated_source",
        "external_dependency",
        "read_only_source",
        "imported_snapshot"
      ]
    },
    "downgrade_reason": {
      "type": "string",
      "enum": [
        "sparse_workset",
        "policy_limited",
        "missing_provider",
        "provider_unavailable",
        "stale_shard",
        "lexical_fallback_only",
        "syntax_fallback_only",
        "generated_boundary",
        "runtime_or_framework_only",
        "ambiguous_candidates",
        "bookmark_or_history_drift",
        "metadata_only_export"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": ["resolved_single", "opened_disambiguation", "unavailable"]
    },
    "aliasing_posture": {
      "type": "string",
      "enum": ["no_alias", "disclosed_fallback", "no_resolution"]
    },
    "downgrade_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_reason" }
    },
    "handle_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/handle_ref" }
    },
    "string_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "relation_kind", "object_ref", "anchor_ref"],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "object_ref": { "$ref": "#/$defs/handle_ref" },
        "anchor_ref": { "$ref": "#/$defs/handle_ref" }
      }
    },
    "navigation_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "relation_kind",
        "object_ref",
        "anchor_ref",
        "provider_class",
        "proof_class",
        "confidence",
        "freshness",
        "ambiguity_class",
        "scope_completeness",
        "scope_ref",
        "generated_or_external_state",
        "downgrade_reasons",
        "evidence_refs",
        "summary"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "object_ref": { "$ref": "#/$defs/handle_ref" },
        "anchor_ref": { "$ref": "#/$defs/handle_ref" },
        "provider_class": { "$ref": "#/$defs/provider_class" },
        "proof_class": { "$ref": "#/$defs/proof_class" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "ambiguity_class": { "$ref": "#/$defs/ambiguity_class" },
        "scope_completeness": { "$ref": "#/$defs/scope_completeness" },
        "scope_ref": { "$ref": "#/$defs/handle_ref" },
        "generated_or_external_state": { "$ref": "#/$defs/generated_or_external_state" },
        "downgrade_reasons": { "$ref": "#/$defs/downgrade_reasons" },
        "evidence_refs": { "$ref": "#/$defs/handle_refs" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "disambiguation_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set_id",
        "requested_relation",
        "candidate_target_refs",
        "selection_policy",
        "created_at",
        "ambiguity_class",
        "confidence",
        "freshness",
        "scope_completeness",
        "downgrade_reasons",
        "evidence_refs",
        "summary"
      ],
      "properties": {
        "set_id": { "$ref": "#/$defs/non_empty_string" },
        "requested_relation": { "$ref": "#/$defs/relation_kind" },
        "candidate_target_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "selection_policy": { "$ref": "#/$defs/non_empty_string" },
        "created_at": { "type": "string", "format": "date-time" },
        "ambiguity_class": { "$ref": "#/$defs/ambiguity_class" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "scope_completeness": { "$ref": "#/$defs/scope_completeness" },
        "downgrade_reasons": { "$ref": "#/$defs/downgrade_reasons" },
        "evidence_refs": { "$ref": "#/$defs/handle_refs" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "provider_reach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolvable_relations", "provider_classes"],
      "properties": {
        "resolvable_relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation_kind" }
        },
        "provider_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/provider_class" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "command",
        "origin_object_ref",
        "origin_anchor_ref",
        "provider_reach",
        "candidates"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/non_empty_string" },
        "command": { "$ref": "#/$defs/navigation_command" },
        "origin_object_ref": { "$ref": "#/$defs/handle_ref" },
        "origin_anchor_ref": { "$ref": "#/$defs/handle_ref" },
        "provider_reach": { "$ref": "#/$defs/provider_reach" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/navigation_target" }
        }
      }
    },
    "resolved_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "provider_class",
        "proof_class",
        "confidence",
        "freshness",
        "ambiguity_class",
        "ambiguity_count",
        "generated_or_external_state",
        "downgrade_reasons",
        "fallback_notes",
        "summary"
      ],
      "properties": {
        "target_ref": { "$ref": "#/$defs/target_ref" },
        "provider_class": { "$ref": "#/$defs/provider_class" },
        "proof_class": { "$ref": "#/$defs/proof_class" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "ambiguity_class": { "$ref": "#/$defs/ambiguity_class" },
        "ambiguity_count": { "type": "integer", "minimum": 1 },
        "generated_or_external_state": { "$ref": "#/$defs/generated_or_external_state" },
        "downgrade_reasons": { "$ref": "#/$defs/downgrade_reasons" },
        "fallback_notes": { "$ref": "#/$defs/string_list" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "command",
        "requested_relation",
        "disposition",
        "aliasing_posture",
        "navigated_relation",
        "selected_target",
        "disambiguation_set",
        "considered_target_refs",
        "provider_classes",
        "proof_class",
        "confidence",
        "freshness",
        "ambiguity_class",
        "ambiguity_count",
        "downgrade_reasons",
        "fallback_notes",
        "replay_explanation",
        "summary"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/non_empty_string" },
        "command": { "$ref": "#/$defs/navigation_command" },
        "requested_relation": { "$ref": "#/$defs/relation_kind" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "aliasing_posture": { "$ref": "#/$defs/aliasing_posture" },
        "navigated_relation": {
          "anyOf": [{ "$ref": "#/$defs/relation_kind" }, { "type": "null" }]
        },
        "selected_target": {
          "anyOf": [{ "$ref": "#/$defs/resolved_target" }, { "type": "null" }]
        },
        "disambiguation_set": {
          "anyOf": [{ "$ref": "#/$defs/disambiguation_set" }, { "type": "null" }]
        },
        "considered_target_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/target_ref" }
        },
        "provider_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/provider_class" }
        },
        "proof_class": { "$ref": "#/$defs/proof_class" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "ambiguity_class": { "$ref": "#/$defs/ambiguity_class" },
        "ambiguity_count": { "type": "integer", "minimum": 0 },
        "downgrade_reasons": { "$ref": "#/$defs/downgrade_reasons" },
        "fallback_notes": { "$ref": "#/$defs/string_list" },
        "replay_explanation": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "title", "request", "resolution", "expectation_note"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "request": { "$ref": "#/$defs/request" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "expectation_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    }
  }
}
