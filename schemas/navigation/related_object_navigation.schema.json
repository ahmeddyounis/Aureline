{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/navigation/related_object_navigation.schema.json",
  "title": "Aureline related-object navigation corpus",
  "description": "Boundary schema for the related-object navigation corpus: the frozen contract for how Aureline turns the related links for an anchor into a typed, source-attributed panel. Each scenario carries a panel-building input and the panel the builder produces for it. A panel groups route/component/test/doc/owner/generated-artifact links by a graph-derived/framework-derived/curated/runtime-derived source legend, carries each link's fallback mode, freshness, proof, and scope so a framework guess never poses as a graph-proven fact and a runtime observation never reads as a curated rule, separates current-scope from captured-scope counts, partitions its counts across the four sources and six fallback modes, names the anchor context the panel was invoked from and whether it supports stable relation anchors so notebook/diff/docs-linked/generated-artifact contexts reuse the same relation semantics and unsupported parity is labeled honestly, exposes the competing links and a disambiguation set ref before a jump while gating its navigating actions, exposes the five open/peek/split/reveal/export actions identically across the related panel, editor gutter, graph overlay, search panel, docs link, and keyboard routes with one stable history effect each, and projects to every consumer surface without flattening into generic links or exporting code bodies. No source bodies, raw paths, provider payloads, URLs, hostnames, or credentials cross this boundary; the record carries opaque object handles, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "related_object_nav_schema_version",
    "schema_ref",
    "set_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "scenarios",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "related_object_navigation_set" },
    "related_object_nav_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/navigation/related_object_navigation.schema.json" },
    "set_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "pattern": "^(schemas|crates|artifacts|fixtures|docs)/"
    },
    "handle_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(aureline://|schemas/|crates/|artifacts/|fixtures/|docs/)"
    },
    "nullable_handle_ref": {
      "anyOf": [{ "$ref": "#/$defs/handle_ref" }, { "type": "null" }]
    },
    "object_kind": {
      "type": "string",
      "enum": ["route", "component", "test", "doc", "owner", "generated_artifact"]
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "definition",
        "declaration",
        "implementation",
        "reference",
        "type",
        "call",
        "route-binding",
        "owner-link",
        "doc-link"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": ["graph_derived", "framework_derived", "curated", "runtime_derived"]
    },
    "source_headline": {
      "type": "string",
      "enum": ["graph_derived", "framework_derived", "curated", "runtime_derived", "mixed", "empty"]
    },
    "fallback_mode": {
      "type": "string",
      "enum": [
        "primary",
        "disambiguation_required",
        "lexical_fallback",
        "imported_snapshot",
        "runtime_observed_only",
        "unavailable"
      ]
    },
    "anchor_context": {
      "type": "string",
      "enum": [
        "editor_symbol",
        "notebook_cell",
        "diff_hunk",
        "docs_linked_symbol",
        "generated_artifact"
      ]
    },
    "anchor_parity": {
      "type": "string",
      "enum": ["stable_anchors_supported", "partial_anchors_supported", "anchors_unsupported"]
    },
    "proof_class": {
      "type": "string",
      "enum": [
        "direct_semantic",
        "indexed_semantic",
        "lexical_fallback",
        "syntax_fallback",
        "imported_evidence",
        "framework_derived",
        "runtime_observed",
        "ai_inferred",
        "unavailable"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "exact",
        "indexed",
        "imported",
        "partial",
        "stale",
        "unavailable",
        "heuristic",
        "workspace_slice_limited"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["authoritative_live", "warm_cached", "degraded_cached", "stale", "unverified"]
    },
    "scope_completeness": {
      "type": "string",
      "enum": [
        "complete_for_declared_scope",
        "partial_for_declared_scope",
        "stale_for_declared_scope",
        "unavailable_for_declared_scope"
      ]
    },
    "generated_or_external_state": {
      "type": "string",
      "enum": [
        "authored_source",
        "generated_source",
        "external_dependency",
        "read_only_source",
        "imported_snapshot"
      ]
    },
    "downgrade_reason": {
      "type": "string",
      "enum": [
        "sparse_workset",
        "policy_limited",
        "missing_provider",
        "provider_unavailable",
        "stale_shard",
        "lexical_fallback_only",
        "syntax_fallback_only",
        "generated_boundary",
        "runtime_or_framework_only",
        "ambiguous_candidates",
        "bookmark_or_history_drift",
        "metadata_only_export"
      ]
    },
    "export_redaction_class": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "operator_only_restricted",
        "internal_support_restricted",
        "signing_evidence_only"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "editor_ui",
        "cli_headless",
        "ai_context",
        "review_workspace",
        "support_export",
        "graph_overlay",
        "shell_continuity"
      ]
    },
    "history_effect": {
      "type": "string",
      "enum": ["advances_history", "preserves_current", "no_editor_history"]
    },
    "action_kind": {
      "type": "string",
      "enum": ["open", "peek", "split_open", "reveal_attribution", "export"]
    },
    "action_route": {
      "type": "string",
      "enum": [
        "related_panel",
        "editor_gutter",
        "graph_overlay",
        "search_panel",
        "docs_link",
        "keyboard_shortcut"
      ]
    },
    "label": {
      "type": "string",
      "enum": [
        "graph_derived",
        "framework_derived",
        "curated",
        "runtime_derived",
        "disambiguation_required",
        "lexical_fallback",
        "imported_snapshot",
        "runtime_observed_only",
        "unavailable",
        "generated",
        "captured_scope_only",
        "incomplete_scope",
        "stale_evidence",
        "unsupported_parity"
      ]
    },
    "downgrade_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/downgrade_reason" }
    },
    "handle_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/handle_ref" }
    },
    "string_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/label" }
    },
    "proof_classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof_class" }
    },
    "object_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_kind" }
    },
    "fallback_modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/fallback_mode" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_count",
        "current_scope_count",
        "captured_scope_count",
        "graph_derived_count",
        "framework_derived_count",
        "curated_count",
        "runtime_derived_count",
        "primary_count",
        "disambiguation_required_count",
        "lexical_fallback_count",
        "imported_snapshot_count",
        "runtime_observed_only_count",
        "unavailable_count",
        "incomplete_scope_count",
        "generated_count"
      ],
      "properties": {
        "total_count": { "type": "integer", "minimum": 0 },
        "current_scope_count": { "type": "integer", "minimum": 0 },
        "captured_scope_count": { "type": "integer", "minimum": 0 },
        "graph_derived_count": { "type": "integer", "minimum": 0 },
        "framework_derived_count": { "type": "integer", "minimum": 0 },
        "curated_count": { "type": "integer", "minimum": 0 },
        "runtime_derived_count": { "type": "integer", "minimum": 0 },
        "primary_count": { "type": "integer", "minimum": 0 },
        "disambiguation_required_count": { "type": "integer", "minimum": 0 },
        "lexical_fallback_count": { "type": "integer", "minimum": 0 },
        "imported_snapshot_count": { "type": "integer", "minimum": 0 },
        "runtime_observed_only_count": { "type": "integer", "minimum": 0 },
        "unavailable_count": { "type": "integer", "minimum": 0 },
        "incomplete_scope_count": { "type": "integer", "minimum": 0 },
        "generated_count": { "type": "integer", "minimum": 0 }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "object_kind",
        "relation_kind",
        "source_class",
        "anchor_ref",
        "target_ref",
        "alternate_target_refs",
        "fallback_mode",
        "proof_class",
        "confidence",
        "freshness",
        "scope_completeness",
        "generated_or_external_state",
        "downgrade_reasons",
        "evidence_refs",
        "summary"
      ],
      "properties": {
        "link_id": { "$ref": "#/$defs/non_empty_string" },
        "object_kind": { "$ref": "#/$defs/object_kind" },
        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "anchor_ref": { "$ref": "#/$defs/handle_ref" },
        "target_ref": { "$ref": "#/$defs/handle_ref" },
        "alternate_target_refs": { "$ref": "#/$defs/handle_refs" },
        "fallback_mode": { "$ref": "#/$defs/fallback_mode" },
        "proof_class": { "$ref": "#/$defs/proof_class" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "scope_completeness": { "$ref": "#/$defs/scope_completeness" },
        "generated_or_external_state": { "$ref": "#/$defs/generated_or_external_state" },
        "downgrade_reasons": { "$ref": "#/$defs/downgrade_reasons" },
        "evidence_refs": { "$ref": "#/$defs/handle_refs" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "disambiguation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_selection",
        "competing_link_refs",
        "disambiguation_set_ref",
        "requires_inspection_before_jump",
        "note"
      ],
      "properties": {
        "requires_selection": { "type": "boolean" },
        "competing_link_refs": { "$ref": "#/$defs/string_list" },
        "disambiguation_set_ref": { "$ref": "#/$defs/nullable_handle_ref" },
        "requires_inspection_before_jump": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "anchor_ref",
        "anchor_context",
        "anchor_parity",
        "parity_note",
        "scope_ref",
        "captured_scope_ref",
        "redaction_class",
        "links",
        "disambiguation_set_ref",
        "disambiguation_note"
      ],
      "properties": {
        "panel_id": { "$ref": "#/$defs/non_empty_string" },
        "anchor_ref": { "$ref": "#/$defs/handle_ref" },
        "anchor_context": { "$ref": "#/$defs/anchor_context" },
        "anchor_parity": { "$ref": "#/$defs/anchor_parity" },
        "parity_note": { "type": "string" },
        "scope_ref": { "$ref": "#/$defs/handle_ref" },
        "captured_scope_ref": { "$ref": "#/$defs/nullable_handle_ref" },
        "redaction_class": { "$ref": "#/$defs/export_redaction_class" },
        "links": { "$ref": "#/$defs/links" },
        "disambiguation_set_ref": { "$ref": "#/$defs/nullable_handle_ref" },
        "disambiguation_note": { "type": "string" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "links",
        "counts",
        "scope_completeness",
        "freshness",
        "confidence",
        "proof_classes",
        "object_kinds",
        "fallback_modes",
        "labels",
        "downgrade_reasons",
        "attribution_notes",
        "summary"
      ],
      "properties": {
        "source_class": { "$ref": "#/$defs/source_class" },
        "links": { "$ref": "#/$defs/links" },
        "counts": { "$ref": "#/$defs/counts" },
        "scope_completeness": { "$ref": "#/$defs/scope_completeness" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "proof_classes": { "$ref": "#/$defs/proof_classes" },
        "object_kinds": { "$ref": "#/$defs/object_kinds" },
        "fallback_modes": { "$ref": "#/$defs/fallback_modes" },
        "labels": { "$ref": "#/$defs/labels" },
        "downgrade_reasons": { "$ref": "#/$defs/downgrade_reasons" },
        "attribution_notes": { "$ref": "#/$defs/string_list" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "action_affordance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_kind",
        "history_effect",
        "available_routes",
        "anchor_ref",
        "preserves_anchor_identity",
        "gated_by_disambiguation",
        "summary"
      ],
      "properties": {
        "action_kind": { "$ref": "#/$defs/action_kind" },
        "history_effect": { "$ref": "#/$defs/history_effect" },
        "available_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_route" }
        },
        "anchor_ref": { "$ref": "#/$defs/handle_ref" },
        "preserves_anchor_identity": { "type": "boolean" },
        "gated_by_disambiguation": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_surface",
        "projected_group_count",
        "preserves_source_attribution",
        "preserves_counts",
        "preserves_fallback_truth",
        "preserves_anchor_parity",
        "preserves_freshness_and_confidence",
        "flattens_to_generic_links",
        "exports_code_bodies",
        "redaction_class",
        "summary"
      ],
      "properties": {
        "consumer_surface": { "$ref": "#/$defs/consumer_surface" },
        "projected_group_count": { "type": "integer", "minimum": 0 },
        "preserves_source_attribution": { "type": "boolean" },
        "preserves_counts": { "type": "boolean" },
        "preserves_fallback_truth": { "type": "boolean" },
        "preserves_anchor_parity": { "type": "boolean" },
        "preserves_freshness_and_confidence": { "type": "boolean" },
        "flattens_to_generic_links": { "const": false },
        "exports_code_bodies": { "const": false },
        "redaction_class": { "$ref": "#/$defs/export_redaction_class" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "anchor_ref",
        "anchor_context",
        "anchor_parity",
        "parity_note",
        "scope_ref",
        "captured_scope_ref",
        "groups",
        "totals",
        "source_headline",
        "scope_completeness",
        "freshness",
        "confidence",
        "labels",
        "disambiguation",
        "actions",
        "consumer_projections",
        "downgrade_reasons",
        "attribution_notes",
        "redaction_class",
        "summary"
      ],
      "properties": {
        "panel_id": { "$ref": "#/$defs/non_empty_string" },
        "anchor_ref": { "$ref": "#/$defs/handle_ref" },
        "anchor_context": { "$ref": "#/$defs/anchor_context" },
        "anchor_parity": { "$ref": "#/$defs/anchor_parity" },
        "parity_note": { "type": "string" },
        "scope_ref": { "$ref": "#/$defs/handle_ref" },
        "captured_scope_ref": { "$ref": "#/$defs/nullable_handle_ref" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "totals": { "$ref": "#/$defs/counts" },
        "source_headline": { "$ref": "#/$defs/source_headline" },
        "scope_completeness": { "$ref": "#/$defs/scope_completeness" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "labels": { "$ref": "#/$defs/labels" },
        "disambiguation": { "$ref": "#/$defs/disambiguation" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action_affordance" }
        },
        "consumer_projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/projection" }
        },
        "downgrade_reasons": { "$ref": "#/$defs/downgrade_reasons" },
        "attribution_notes": { "$ref": "#/$defs/string_list" },
        "redaction_class": { "$ref": "#/$defs/export_redaction_class" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "title", "input", "panel", "expectation_note"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/non_empty_string" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "input": { "$ref": "#/$defs/input" },
        "panel": { "$ref": "#/$defs/panel" },
        "expectation_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "type": "boolean" }
      }
    }
  }
}
