{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/navigation/relation_navigation_qualification.schema.json",
  "title": "Aureline relation-navigation qualification certification",
  "description": "Boundary schema for the relation-navigation qualification certification: the claim-governance lane that certifies each claimed M5 search/graph/docs/editor relation-navigation family and auto-narrows the claim when its proof is stale or failing. It names every certified family (definition/declaration/implementation target-kind honesty, references/access-kind truth, hierarchy proof classes, related-object attribution, rename-preview completeness, and continuity/replay fidelity), binds each to the relation-navigation matrix object(s) it certifies plus the producing module, boundary schema, proof packet, and freeze gate that keep it current, publishes one qualification row per claimed surface with a claim state derived purely from its proof state and freshness, emits explicit release evidence rows, and lists the consumer surfaces (About, Help, search/navigation, support, compatibility, release-truth, and public-truth) that consume the same state rather than restating relation-navigation quality by hand. No source bodies, raw paths, provider payloads, URLs, hostnames, or credentials cross this boundary; the record carries opaque object refs, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "relation_navigation_qualification_schema_version",
    "schema_ref",
    "certification_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "families",
    "rows",
    "release_evidence",
    "consumer_projections",
    "invariants",
    "all_claims_qualified",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "relation_navigation_qualification_certification" },
    "relation_navigation_qualification_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": {
      "const": "schemas/navigation/relation_navigation_qualification.schema.json"
    },
    "certification_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family_entry" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/qualification_row" }
    },
    "release_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release_evidence_row" }
    },
    "consumer_projections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_projection" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/certification_invariant" }
    },
    "all_claims_qualified": { "type": "boolean" },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path. A fragment after '#' may name an enum variant for provenance.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "matrix_object_ref": {
      "type": "string",
      "description": "A relation-navigation matrix object id, namespaced under relation_nav_object.",
      "pattern": "^relation_nav_object\\."
    },
    "family_class": {
      "type": "string",
      "enum": [
        "target_kind_honesty",
        "reference_access_kind_truth",
        "hierarchy_proof_classes",
        "related_object_attribution",
        "rename_preview_completeness",
        "continuity_replay_fidelity"
      ]
    },
    "claimed_surface": {
      "type": "string",
      "enum": ["search_navigation", "graph_topology", "docs_help", "editor_assist"]
    },
    "proof_state": {
      "type": "string",
      "enum": ["passing", "pending", "failing", "missing"]
    },
    "proof_freshness": {
      "type": "string",
      "enum": ["live", "warm", "degraded", "stale", "unverified"]
    },
    "claim_state": {
      "type": "string",
      "enum": [
        "qualified",
        "narrowed_disclosed",
        "narrowed_stale",
        "withdrawn_pending_proof",
        "withdrawn_failing"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "about",
        "help",
        "search_navigation",
        "support",
        "compatibility",
        "release_truth",
        "public_truth"
      ]
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "definition",
        "declaration",
        "implementation",
        "reference",
        "type",
        "call",
        "route-binding",
        "owner-link",
        "doc-link"
      ]
    },
    "family_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "family_id",
        "label",
        "summary",
        "certified_object_refs",
        "produced_by_refs",
        "canonical_schema_refs",
        "proof_packet_ref",
        "freeze_gate_ref",
        "relation_kinds",
        "claimed_surfaces",
        "honesty_rule",
        "is_release_evidence_family"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/family_class" },
        "family_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "certified_object_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/matrix_object_ref" }
        },
        "produced_by_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "canonical_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
        "relation_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relation_kind" }
        },
        "claimed_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimed_surface" }
        },
        "honesty_rule": { "$ref": "#/$defs/non_empty_string" },
        "is_release_evidence_family": { "type": "boolean" }
      }
    },
    "qualification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "family",
        "claimed_surface",
        "claim_text",
        "proof_packet_ref",
        "freeze_gate_ref",
        "proof_state",
        "proof_freshness",
        "claim_state",
        "narrowing_reason",
        "disclosure_note"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family_class" },
        "claimed_surface": { "$ref": "#/$defs/claimed_surface" },
        "claim_text": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
        "proof_state": { "$ref": "#/$defs/proof_state" },
        "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "narrowing_reason": { "type": ["string", "null"], "minLength": 1 },
        "disclosure_note": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "release_evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "family",
        "evidence_claim",
        "proof_packet_ref",
        "freeze_gate_ref",
        "proof_state",
        "proof_freshness",
        "claim_state",
        "holds"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/non_empty_string" },
        "family": { "$ref": "#/$defs/family_class" },
        "evidence_claim": { "$ref": "#/$defs/non_empty_string" },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
        "proof_state": { "$ref": "#/$defs/proof_state" },
        "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
        "claim_state": { "$ref": "#/$defs/claim_state" },
        "holds": { "type": "boolean" }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "label",
        "summary",
        "surfaced_family_tokens",
        "highlights_narrowed",
        "consumes_shared_state",
        "restates_manually"
      ],
      "properties": {
        "consumer": { "$ref": "#/$defs/consumer_class" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "surfaced_family_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "highlights_narrowed": { "type": "boolean" },
        "consumes_shared_state": { "const": true },
        "restates_manually": { "const": false }
      }
    },
    "certification_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
