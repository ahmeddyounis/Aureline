        "drift_state": { "$ref": "#/$defs/drift_state" },
        "changed_count": { "type": "integer", "minimum": 0 },
        "held_count": { "type": "integer", "minimum": 0 },
        "disambiguation_set_ref": { "$ref": "#/$defs/handle_ref" },
