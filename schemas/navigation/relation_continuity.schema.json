    "label": {
      "type": "string",
      "enum": [
        "captured_scope_only",
        "runtime_observed",
        "framework_derived",
        "imported_snapshot",
        "lexical_fallback",
        "syntax_fallback",
        "generated",
        "external",
        "read_only",
        "test_only",
        "remapped",
        "drifted",
        "missing_target",
        "scope_unavailable",
        "archived",
        "ambiguous_needs_selection"
      ]
    },
    "downgrade_reason": {
      "type": "string",
      "enum": [
        "sparse_workset",
        "policy_limited",
        "missing_provider",
        "provider_unavailable",
        "stale_shard",
        "lexical_fallback_only",
        "syntax_fallback_only",
        "generated_boundary",
        "runtime_or_framework_only",
        "ambiguous_candidates",
        "bookmark_or_history_drift",
        "metadata_only_export"
