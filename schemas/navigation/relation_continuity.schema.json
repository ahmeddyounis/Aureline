        "entry_kind": { "$ref": "#/$defs/entry_kind" },
        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "return_anchor": { "$ref": "#/$defs/return_anchor" },
        "captured_target": { "$ref": "#/$defs/target_snapshot" },
        "current_target": { "$ref": "#/$defs/target_snapshot" },
        "drift_state": { "$ref": "#/$defs/drift_state" },
        "drift_reason": { "$ref": "#/$defs/non_empty_string" },
        "remap_evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/handle_ref" } },
        "used_nearby_fallback": { "const": false },
        "auto_open_allowed": { "type": "boolean" },
        "proof_class": { "$ref": "#/$defs/proof_class" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "provider_class": { "$ref": "#/$defs/provider_class" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "ambiguity_class": { "$ref": "#/$defs/ambiguity_class" },
        "scope_completeness": { "$ref": "#/$defs/scope_completeness" },
        "current_scope": { "type": "boolean" },
        "disambiguation_set_ref": { "$ref": "#/$defs/handle_ref" },
        "replay_target_id": { "$ref": "#/$defs/handle_ref" },
        "recovery_choices": { "type": "array", "items": { "$ref": "#/$defs/recovery_choice" } },
        "labels": { "type": "array", "items": { "$ref": "#/$defs/label" } },
        "downgrade_reasons": { "type": "array", "items": { "$ref": "#/$defs/downgrade_reason" } },
        "fallback_notes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/handle_ref" } },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rename_evidence_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
