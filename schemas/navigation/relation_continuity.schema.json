        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "object_ref": { "$ref": "#/$defs/handle_ref" },
        "anchor_ref": { "$ref": "#/$defs/handle_ref" },
        "scope_ref": { "$ref": "#/$defs/handle_ref" }
      }
    },
    "entry_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "entry_kind",
        "relation_kind",
        "origin_surface",
        "origin_object_ref",
        "origin_scope_ref",
        "captured_target_id",
        "captured_object_ref",
        "captured_anchor_ref",
        "captured_scope_ref",
        "drift_state",
        "remap_evidence_refs",
        "access_kind",
        "proof_class",
        "provider_class",
        "confidence",
        "freshness",
        "ambiguity_class",
        "scope_completeness",
        "generated_or_external_state",
        "downgrade_reasons",
        "evidence_refs",
        "summary"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "entry_kind": { "$ref": "#/$defs/entry_kind" },
        "relation_kind": { "$ref": "#/$defs/relation_kind" },
        "origin_surface": { "$ref": "#/$defs/consumer_surface" },
        "origin_object_ref": { "$ref": "#/$defs/handle_ref" },
        "origin_scope_ref": { "$ref": "#/$defs/handle_ref" },
        "captured_target_id": { "$ref": "#/$defs/handle_ref" },
        "captured_object_ref": { "$ref": "#/$defs/handle_ref" },
        "captured_anchor_ref": { "$ref": "#/$defs/handle_ref" },
        "captured_scope_ref": { "$ref": "#/$defs/handle_ref" },
        "drift_state": { "$ref": "#/$defs/drift_state" },
        "remapped_object_ref": { "$ref": "#/$defs/handle_ref" },
        "remapped_anchor_ref": { "$ref": "#/$defs/handle_ref" },
