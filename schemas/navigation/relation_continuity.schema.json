{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/navigation/relation_continuity.schema.json",
  "title": "Aureline relation-continuity corpus",
  "description": "Boundary schema for the relation-continuity corpus: the frozen contract for how Aureline keeps symbol navigation and rename evidence relation-aware across replay, drift, and return-context restoration. Each scenario carries a packet-building input and the packet the builder produces for it. A packet lists relation-aware navigation entries (peek, temporary reveal, open-in-split, back/forward history, recent location) in canonical order, each preserving its relation kind, origin surface, a return anchor that restores the origin selection and viewport, a captured target snapshot, and — for a bound or remapped entry — a current target snapshot of the same relation kind. An entry auto-opens only when it is bound with fresh, semantic evidence; a remapped entry cites stable remap evidence and never a nearby fallback; and a drifted, missing-target, scope-unavailable, or archived entry carries no current target, keeps its drift reason and recovery choices visible, and routes selection ambiguity through a disambiguation set — so a return jump never lands on a nearby guess. Every entry and rename-preview-evidence row names its evidence class so a grep fallback is never replayed as semantic, and carries a replay-safe target id derived from its own stable id. The packet separates current-versus-captured truth in its counts and projects to every consumer surface without retargeting or exporting code bodies. No source bodies, raw paths, identifiers, provider payloads, URLs, hostnames, or credentials cross this boundary; the record carries opaque object handles, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "relation_continuity_schema_version",
    "schema_ref",
    "set_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "scenarios",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "relation_continuity_set" },
    "relation_continuity_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/navigation/relation_continuity.schema.json" },
    "set_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "pattern": "^(schemas|crates|artifacts|fixtures|docs)/"
    },
    "handle_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(aureline://|schemas/|crates/|artifacts/|fixtures/|docs/)"
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "definition",
        "declaration",
        "implementation",
        "reference",
        "type",
        "call",
        "route-binding",
        "owner-link",
        "doc-link"
      ]
    },
    "entry_kind": {
      "type": "string",
      "enum": [
        "peek",
        "temporary_reveal",
        "open_in_split",
        "back_history",
        "forward_history",
        "recent_location"
      ]
    },
    "drift_state": {
      "type": "string",
      "enum": [
        "bound",
        "remapped",
        "drifted",
        "missing_target",
        "scope_unavailable",
        "archived"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "semantic",
        "framework_derived",
        "runtime_observed",
        "imported_snapshot",
        "lexical_fallback",
        "syntax_fallback",
        "unavailable"
      ]
    },
    "access_kind": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "call",
        "inherit",
        "import",
        "export",
        "test-only",
        "generated"
      ]
    },
    "proof_class": {
      "type": "string",
      "enum": [
        "direct_semantic",
        "indexed_semantic",
        "lexical_fallback",
        "syntax_fallback",
        "imported_evidence",
        "framework_derived",
        "runtime_observed",
        "ai_inferred",
        "unavailable"
      ]
    },
    "provider_class": {
      "type": "string",
      "enum": [
        "syntax",
        "project_graph",
        "language_server",
        "framework_pack",
        "notebook_adapter",
        "generated_source_bridge",
        "search_index",
        "remote_index",
        "imported_snapshot",
        "runtime_observer",
        "ai_assist"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "exact",
        "indexed",
        "imported",
        "partial",
        "stale",
        "unavailable",
        "heuristic",
        "workspace_slice_limited"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["authoritative_live", "warm_cached", "degraded_cached", "stale", "unverified"]
    },
    "ambiguity_class": {
      "type": "string",
      "enum": [
        "unambiguous",
        "ambiguous_needs_selection",
        "multiple_candidates_ranked",
        "drifted_needs_review",
        "missing_target",
        "scope_unavailable"
      ]
    },
    "scope_completeness": {
      "type": "string",
      "enum": [
        "complete_for_declared_scope",
        "partial_for_declared_scope",
        "stale_for_declared_scope",
        "unavailable_for_declared_scope"
      ]
    },
    "generated_or_external_state": {
      "type": "string",
      "enum": [
        "authored_source",
        "generated_source",
        "external_dependency",
        "read_only_source",
        "imported_snapshot"
      ]
    },
    "recovery_choice": {
      "type": "string",
      "enum": [
        "open_remapped_target",
        "inspect_drift",
        "choose_from_disambiguation",
        "restore_return_anchor_only",
        "widen_scope",
        "refresh_provider",
        "keep_archived_reference"
      ]
