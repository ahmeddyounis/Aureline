{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/security/m5-emergency-notice-banner.schema.json",
  "title": "Aureline M5 emergency-notice banner primitive: reason class, affected capability, blast radius, local-work continuity, deadline / urgency, primary / recovery actions, and dismissal-rule parity across channels",
  "description": "Export-safe packet implementing Aureline's one reusable emergency-notice banner primitive for every M5 event that changes what is safe to do next — a capability kill switch, a trust-root rotation, a channel freeze, a forced-disable action, or a signed emergency bundle. Each reason-class row binds the shared banner anatomy (reason class, affected capability, blast radius, local-continuity note, deadline / urgency, and the primary / recovery actions — all rendered inline without a detail drawer), the severity classes, action states, required actions, dismissal states, continuity claims, export fields, and accessibility routes reused verbatim from the frozen M5 advisory-component matrix, the four channels (update center, extension host, native notification, support bundle) that render the banner in parity, the dismissal policies that govern acknowledge / snooze / dismiss agency, and the focus behaviors that keep the reason, continuity, the primary and recovery actions, and the dismissal controls keyboard-reachable. Each lane carries worked resolution cases: a resolver input (one emergency on one reason-class lane with its copy-safe notice id, severity, affected capability, blast radius, local-work state, deadline, recovery path, signer / source state, action state, primary and recovery actions, local-continuity claim, and dismissal policy) and the resolved banner — the derived continuity posture, the local-work-safe flag, the implies-data-loss flag (true only when the event proves it), the always-visible posture, the derived dismissal state and allowed dismissal actions, the per-channel projections, and the copy-safe export summary — where the stored resolution must equal a fresh resolve of its input. Hard invariants forbid hiding emergency truth behind a detail drawer, implying data loss without proof, collapsing dismissal into one generic close button, and dropping the copy-safe notice id or export summary. The local-work state, the derived continuity posture, and the dismissal policy are resolver-side vocabularies, kept out of the frozen set. The shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix; the severity class, action state, required action, dismissal state, continuity claim, export field, accessibility route, qualification class, and downgrade trigger vocabularies are reused verbatim from the frozen M5 advisory-component matrix. Raw reporter identities, raw exploit payloads, raw signatures, raw hostnames, raw paths, private registry URLs, and credentials never cross this boundary; only opaque export-safe reprs are carried. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "reason_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_emergency_notice_banner_reason_class_affected_capability_continuity_deadline_and_dismissal_parity_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "reason_rows": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/reason_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
