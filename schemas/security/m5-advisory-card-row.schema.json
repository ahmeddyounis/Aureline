    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_center_renders_shared_row",
        "marketplace_renders_shared_row",
        "help_about_renders_shared_row",
        "support_export_reads_single_source",
        "resolver_reads_single_advisory_vocabulary"
      ],
      "properties": {
        "update_center_renders_shared_row": { "const": true },
        "marketplace_renders_shared_row": { "const": true },
        "help_about_renders_shared_row": { "const": true },
        "support_export_reads_single_source": { "const": true },
        "resolver_reads_single_advisory_vocabulary": { "const": true }
      }
