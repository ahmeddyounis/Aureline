{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/security/m5-advisory-card-row.schema.json",
  "title": "Aureline M5 security-advisory card / row primitive: severity, affected surface, exposure state, fixed version or mitigation, signer / source truth, and primary-action parity across channels",
  "description": "Export-safe packet implementing Aureline's one reusable security-advisory card / row primitive across every M5 surface a published vulnerability, revocation, or security-impacting fix can affect — the desktop app, an extension, a remote helper, a managed service, a docs artifact, or a signing / update path. Each surface row binds the shared advisory-row anatomy (advisory id, severity, affected surface, current exposure, fixed version or mitigation, signer / source state, and primary action — all rendered inline without a detail drawer), the severity classes, action states, required actions, continuity claims, export fields, and accessibility routes reused verbatim from the frozen M5 advisory-component matrix, the four channels (update center, marketplace, Help / About, support bundle) that render the row in parity, and the focus behaviors that keep severity, exposure, the primary action, and the copy-safe id keyboard-reachable. Each lane carries worked resolution cases: a resolver input (one advisory affecting one surface with its copy-safe id, severity, affected object, install state, fixed version or mitigation, signer / source state, action state, primary action, and local-continuity claim) and the resolved row — the derived exposure state, the installed-but-affected flag, the always-visible / never-degrading posture, the per-channel projections, and the copy-safe export summary — where the stored resolution must equal a fresh resolve of its input. Hard invariants forbid hiding advisory truth behind a detail drawer, letting an installed-but-affected row disappear, degrading to a generic update prompt, and dropping the copy-safe id or export summary. The install state and exposure state are resolver-side vocabularies, kept out of the frozen set. The shell zone, responsive class, window class, and consumer surface vocabularies are reused verbatim from the frozen M5 shell-zone matrix; the severity class, action state, required action, continuity claim, export field, accessibility route, qualification class, and downgrade trigger vocabularies are reused verbatim from the frozen M5 advisory-component matrix. Raw reporter identities, raw exploit payloads, raw signatures, raw hostnames, raw paths, private registry URLs, and credentials never cross this boundary; only opaque export-safe reprs are carried. The Rust validator and resolver in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "surface_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "implement_m5_advisory_card_and_row_severity_affected_surface_exposure_and_primary_action_parity_primitive"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "surface_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/surface_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "affected_surface": {
      "type": "string",
      "enum": [
        "desktop_app",
        "extension",
        "remote_helper",
        "managed_service",
        "docs_artifact",
        "signing_update_path"
      ]
    },
    "qualification": {
      "type": "string",
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "type": "string",
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "type": "string",
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "type": "string",
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "anatomy_part": {
      "type": "string",
      "enum": [
        "advisory_id",
        "severity",
        "affected_surface",
        "current_exposure",
        "fixed_version_or_mitigation",
        "signer_source_state",
        "primary_action"
      ]
    },
    "severity_class": {
      "type": "string",
      "enum": ["informational", "low", "moderate", "high", "critical", "operational_emergency"]
    },
    "action_state": {
      "type": "string",
      "enum": [
        "informational",
        "review_recommended",
        "action_required",
        "blocking",
        "immediate_remediation",
        "mitigation_complete"
      ]
    },
    "required_action": {
      "type": "string",
      "enum": [
        "none",
        "review_notice",
        "update_to_fixed_version",
        "rollback_or_repin",
        "disable_or_remove",
        "import_signed_snapshot",
        "rotate_trust_root",
        "export_support_packet",
        "contact_admin",
        "wait_for_superseding_action"
      ]
    },
    "continuity_claim": {
      "type": "string",
      "enum": [
        "local_use_unaffected",
        "degraded_local_mode",
        "requires_disabling_affected_profile",
        "offline_mirror_lag_disclosed",
        "no_safe_local_continuity",
        "continuity_pending_fix"
      ]
    },
    "channel": {
      "type": "string",
      "enum": ["update_center", "marketplace", "help_about", "support_bundle"]
    },
    "focus_behavior": {
      "type": "string",
      "enum": [
        "row_keyboard_focusable",
        "primary_action_reachable",
        "copy_advisory_id_reachable",
        "exposure_announced_to_screen_reader",
        "per_row_navigation",
        "deep_link_to_advisory_detail"
      ]
    },
    "export_field": {
      "type": "string",
      "enum": [
        "advisory_id",
        "severity",
        "action_state",
        "affected_surface",
        "mitigation_state",
        "delivery_profile",
        "freshness_state",
        "continuity_note",
        "disclosure_visibility",
        "history_state"
      ]
    },
    "accessibility_route": {
      "type": "string",
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "consumer_surface": {
      "type": "string",
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "affected_scope_hidden",
        "exposure_hidden_behind_generic_banner",
        "fixed_version_or_mitigation_missing",
        "signer_source_state_hidden",
        "local_continuity_hidden",
        "dismissal_rule_violated",
        "forced_disable_scope_hidden",
        "mirror_lag_undisclosed",
        "unsigned_distribution_undisclosed",
        "stale_notice_state_silent",
        "external_disclosure_only",
        "proof_stale"
      ]
    },
    "install_state": {
      "type": "string",
      "enum": [
        "installed_active",
        "installed_mitigated",
        "installed_blocked",
        "installed_disabled",
        "installed_awaiting_rollback",
        "not_installed",
        "superseded"
      ]
    },
    "exposure_state": {
      "type": "string",
      "enum": [
        "exposed",
        "mitigated_in_place",
        "contained_by_block",
        "contained_by_disable",
        "awaiting_rollback",
        "not_affected",
        "resolved"
      ]
    },
    "resolution_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_surface",
        "advisory_id",
        "severity",
        "affected_object_repr",
        "install_state",
        "fixed_version_or_mitigation_repr",
        "signer_source_state_repr",
        "action_state",
        "primary_action",
        "continuity_claim"
      ],
      "properties": {
        "affected_surface": { "$ref": "#/$defs/affected_surface" },
        "advisory_id": { "$ref": "#/$defs/non_empty_string" },
        "severity": { "$ref": "#/$defs/severity_class" },
        "affected_object_repr": { "$ref": "#/$defs/non_empty_string" },
        "install_state": { "$ref": "#/$defs/install_state" },
        "fixed_version_or_mitigation_repr": { "$ref": "#/$defs/non_empty_string" },
        "signer_source_state_repr": { "$ref": "#/$defs/non_empty_string" },
        "action_state": { "$ref": "#/$defs/action_state" },
        "primary_action": { "$ref": "#/$defs/required_action" },
        "continuity_claim": { "$ref": "#/$defs/continuity_claim" }
      }
    },
    "channel_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "headline", "severity", "exposure_state", "primary_action"],
      "properties": {
        "channel": { "$ref": "#/$defs/channel" },
        "headline": { "$ref": "#/$defs/non_empty_string" },
        "severity": { "$ref": "#/$defs/severity_class" },
        "exposure_state": { "$ref": "#/$defs/exposure_state" },
        "primary_action": { "$ref": "#/$defs/required_action" }
      }
    },
    "export_column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value"],
      "properties": {
        "field": { "$ref": "#/$defs/export_field" },
        "value": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "export_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory_id", "columns"],
      "properties": {
        "advisory_id": { "$ref": "#/$defs/non_empty_string" },
        "columns": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_column" }
        }
      }
    },
    "resolved_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_surface",
        "advisory_id",
        "severity",
        "affected_object_repr",
        "install_state",
        "exposure_state",
        "fixed_version_or_mitigation_repr",
        "signer_source_state_repr",
        "action_state",
        "primary_action",
        "continuity_claim",
        "installed_but_affected",
        "remains_visible",
        "degrades_to_generic_prompt",
        "channel_projections",
        "export_summary"
      ],
      "properties": {
        "affected_surface": { "$ref": "#/$defs/affected_surface" },
        "advisory_id": { "$ref": "#/$defs/non_empty_string" },
        "severity": { "$ref": "#/$defs/severity_class" },
        "affected_object_repr": { "$ref": "#/$defs/non_empty_string" },
        "install_state": { "$ref": "#/$defs/install_state" },
        "exposure_state": { "$ref": "#/$defs/exposure_state" },
        "fixed_version_or_mitigation_repr": { "$ref": "#/$defs/non_empty_string" },
        "signer_source_state_repr": { "$ref": "#/$defs/non_empty_string" },
        "action_state": { "$ref": "#/$defs/action_state" },
        "primary_action": { "$ref": "#/$defs/required_action" },
        "continuity_claim": { "$ref": "#/$defs/continuity_claim" },
        "installed_but_affected": { "type": "boolean" },
        "remains_visible": { "const": true },
        "degrades_to_generic_prompt": { "const": false },
        "channel_projections": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/channel_projection" }
        },
        "export_summary": { "$ref": "#/$defs/export_summary" }
      }
    },
    "resolution_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved"],
      "properties": {
        "input": { "$ref": "#/$defs/resolution_input" },
        "resolved": { "$ref": "#/$defs/resolved_row" }
      }
    },
    "surface_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_surface",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "anatomy_parts",
        "severity_classes",
        "channels",
        "action_states",
        "required_actions",
        "continuity_claims",
        "focus_behaviors",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "example_advisories",
        "hides_field_behind_detail_drawer",
        "disappears_when_installed_but_affected",
        "degrades_to_generic_update_prompt",
        "drops_copy_safe_id_or_export"
      ],
      "properties": {
        "affected_surface": { "$ref": "#/$defs/affected_surface" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "anatomy_parts": {
          "type": "array",
          "minItems": 7,
          "items": { "$ref": "#/$defs/anatomy_part" }
        },
        "severity_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/severity_class" }
        },
        "channels": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/channel" }
        },
        "action_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action_state" }
        },
        "required_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/required_action" }
        },
        "continuity_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/continuity_claim" }
        },
        "focus_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/focus_behavior" }
        },
        "export_fields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "example_advisories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolution_case" }
        },
        "hides_field_behind_detail_drawer": { "const": false },
        "disappears_when_installed_but_affected": { "const": false },
        "degrades_to_generic_update_prompt": { "const": false },
        "drops_copy_safe_id_or_export": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_surfaces",
        "anatomy_parts",
        "severity_classes",
        "action_states",
        "required_actions",
        "continuity_claims",
        "channels",
        "focus_behaviors",
        "export_fields",
        "accessibility_routes"
      ],
      "properties": {
        "affected_surfaces": { "type": "array", "items": { "$ref": "#/$defs/affected_surface" } },
        "anatomy_parts": { "type": "array", "items": { "$ref": "#/$defs/anatomy_part" } },
        "severity_classes": { "type": "array", "items": { "$ref": "#/$defs/severity_class" } },
        "action_states": { "type": "array", "items": { "$ref": "#/$defs/action_state" } },
        "required_actions": { "type": "array", "items": { "$ref": "#/$defs/required_action" } },
        "continuity_claims": { "type": "array", "items": { "$ref": "#/$defs/continuity_claim" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "focus_behaviors": { "type": "array", "items": { "$ref": "#/$defs/focus_behavior" } },
