        "export_summary_reconstructs_advisory_truth",
        "primary_action_parity_across_channels",
        "every_row_bound_to_shell_zone",
        "every_row_declares_accessibility_route",
        "later_lanes_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "one_row_model_across_channels": { "const": true },
        "severity_scope_exposure_visible_without_drawer": { "const": true },
        "installed_but_affected_stays_visible": { "const": true },
        "never_degrades_to_generic_update_prompt": { "const": true },
        "copy_safe_advisory_id_preserved": { "const": true },
        "export_summary_reconstructs_advisory_truth": { "const": true },
        "primary_action_parity_across_channels": { "const": true },
        "every_row_bound_to_shell_zone": { "const": true },
        "every_row_declares_accessibility_route": { "const": true },
