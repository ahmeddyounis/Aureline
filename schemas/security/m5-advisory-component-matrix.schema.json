{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/security/m5-advisory-component-matrix.schema.json",
  "title": "Aureline M5 security-advisory, emergency-notice, affected-install, and disclosure-link component matrix",
  "description": "Export-safe packet freezing Aureline's user-facing security-advisory component model. The packet names every advisory primitive family M5 claims that still drifts too easily into website copy or a generic update banner — security-advisory cards, emergency notices, affected-install panels, disclosure/history blocks, advisory activity rows, and native-notification handoff — and binds each to a canonical shell zone, the responsive classes it must survive, the window classes it keeps continuity across, and the claimed M5 surface families that render it. Each component declares the controlled vocabularies it carries: severity classes, required advisory anatomy, action states and required actions, emergency dismissal states, local-continuity claims, delivery profiles and mirror-freshness states, disclosure fields, native notification behaviors, export fields, projection surfaces, non-visual accessibility routes, and mandatory labels. Hard invariants forbid hiding the affected scope, hiding local continuity, inventing generic advisory language, and staying silent on a stale or unsigned distribution state. The shell zone, responsive class, window class, consumer surface, and surface family vocabularies are reused verbatim from the frozen M5 shell-zone matrix; the severity, action-state, dismissal, delivery, freshness, and disclosure vocabularies are aligned to the frozen advisory-surface, affected-install, and severity contracts under schemas/security and docs/security. Raw reporter identities, raw exploit payloads, raw signatures, raw hostnames, raw paths, private registry URLs, credentials, and raw evidence bodies never cross this boundary. The Rust validator in crates/aureline-shell is the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "packet_id",
    "matrix_label",
    "component_rows",
    "vocabulary_set",
    "governance_review",
    "consumer_projection",
    "proof_freshness",
    "release_posture",
    "source_contract_refs",
    "redaction_class_token",
    "minted_at"
  ],
  "properties": {
    "record_kind": {
      "const": "freeze_m5_security_advisory_emergency_notice_affected_install_and_disclosure_link_matrix"
    },
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "matrix_label": { "$ref": "#/$defs/non_empty_string" },
    "component_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/component_row" }
    },
    "vocabulary_set": { "$ref": "#/$defs/vocabulary_set" },
    "governance_review": { "$ref": "#/$defs/governance_review" },
    "consumer_projection": { "$ref": "#/$defs/consumer_projection" },
    "proof_freshness": { "$ref": "#/$defs/proof_freshness" },
    "release_posture": { "$ref": "#/$defs/release_posture" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "redaction_class_token": { "$ref": "#/$defs/non_empty_string" },
    "minted_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "enum": [
        "advisory_card",
        "emergency_notice",
        "affected_install_panel",
        "disclosure_block",
        "advisory_activity_row",
        "native_notification_handoff"
      ]
    },
    "qualification": {
      "enum": ["stable", "beta", "preview", "experimental", "unavailable", "held"]
    },
    "shell_zone_slot": {
      "enum": [
        "title_context_bar",
        "activity_rail",
        "left_sidebar",
        "main_workspace",
        "right_inspector",
        "bottom_panel",
        "status_bar",
        "transient_overlay"
      ]
    },
    "responsive_class": {
      "enum": ["compact_desktop", "standard_desktop", "expanded_desktop"]
    },
    "window_class": {
      "enum": [
        "primary_workspace_window",
        "secondary_detached_window",
        "floating_utility_window",
        "companion_overlay_window"
      ]
    },
    "surface_family": {
      "enum": [
        "notebook",
        "data_grid",
        "profiler",
        "pipeline",
        "docs",
        "preview",
        "review",
        "incident",
        "companion",
        "operator"
      ]
    },
    "consumer_surface": {
      "enum": [
        "shell_frame",
        "windowing",
        "layout",
        "status_bar",
        "attention_router",
        "notification_envelope",
        "docs_help",
        "release_proof",
        "support_export",
        "product_ui"
      ]
    },
    "required_label": {
      "enum": [
        "identity",
        "severity",
        "keyboard_route",
        "provenance",
        "primary_action",
        "continuity_note"
      ]
    },
    "severity_class": {
      "enum": ["informational", "low", "moderate", "high", "critical", "operational_emergency"]
    },
    "anatomy_field": {
      "enum": [
        "affected_object",
        "severity",
        "current_exposure",
        "fixed_version_or_mitigation",
        "signer_source_state",
        "primary_actions",
        "local_continuity"
      ]
    },
    "action_state": {
      "enum": [
        "informational",
        "review_recommended",
        "action_required",
        "blocking",
        "immediate_remediation",
        "mitigation_complete"
      ]
    },
    "required_action": {
      "enum": [
        "none",
        "review_notice",
        "update_to_fixed_version",
        "rollback_or_repin",
        "disable_or_remove",
        "import_signed_snapshot",
        "rotate_trust_root",
        "export_support_packet",
        "contact_admin",
        "wait_for_superseding_action"
      ]
    },
    "dismissal_state": {
      "enum": [
        "not_acknowledgeable",
        "unacknowledged",
        "acknowledged",
        "snoozed_until_review",
        "blocked_until_remediated"
      ]
    },
    "continuity_claim": {
      "enum": [
        "local_use_unaffected",
        "degraded_local_mode",
        "requires_disabling_affected_profile",
        "offline_mirror_lag_disclosed",
        "no_safe_local_continuity",
        "continuity_pending_fix"
      ]
    },
    "delivery_profile": {
      "enum": ["local_only", "managed", "offline_mirror", "manual_import"]
    },
    "freshness_state": {
      "enum": ["up_to_date", "stale_within_grace", "stale_past_grace", "offline_expired", "unknown"]
    },
    "disclosure_field": {
      "enum": [
        "aureline_advisory_id",
        "cve_alias",
        "ghsa_alias",
        "disclosure_timing",
        "visibility_posture",
        "history_state",
        "external_disclosure_link"
      ]
    },
    "notification_behavior": {
      "enum": [
        "os_notification_summary",
        "click_through_to_advisory",
        "respects_quiet_hours",
        "no_sensitive_body_in_payload",
        "emergency_bypasses_quiet_hours",
        "dismissal_syncs_to_in_app"
      ]
    },
    "export_field": {
      "enum": [
        "advisory_id",
        "severity",
        "action_state",
        "affected_surface",
        "mitigation_state",
        "delivery_profile",
        "freshness_state",
        "continuity_note",
        "disclosure_visibility",
        "history_state"
      ]
    },
    "projection_surface": {
      "enum": [
        "update_center",
        "marketplace",
        "help_about",
        "support_bundle",
        "native_notification",
        "mirror_offline_drill",
        "activity_center",
        "release_packet"
      ]
    },
    "accessibility_route": {
      "enum": [
        "keyboard_focusable",
        "screen_reader_announced",
        "non_hover_reachable",
        "pointer_optional",
        "high_contrast_safe",
        "support_exportable"
      ]
    },
    "downgrade_trigger": {
      "enum": [
        "affected_scope_hidden",
        "exposure_hidden_behind_generic_banner",
        "fixed_version_or_mitigation_missing",
        "signer_source_state_hidden",
        "local_continuity_hidden",
        "dismissal_rule_violated",
        "forced_disable_scope_hidden",
        "mirror_lag_undisclosed",
        "unsigned_distribution_undisclosed",
        "stale_notice_state_silent",
        "external_disclosure_only",
        "proof_stale"
      ]
    },
    "component_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "qualification",
        "owner_role",
        "scope_summary",
        "shell_zone_slot",
        "responsive_classes",
        "window_classes",
        "surface_families",
        "required_labels",
        "severity_classes",
        "projection_surfaces",
        "anatomy_fields",
        "action_states",
        "required_actions",
        "dismissal_states",
        "continuity_claims",
        "delivery_profiles",
        "freshness_states",
        "disclosure_fields",
        "notification_behaviors",
        "export_fields",
        "accessibility_routes",
        "consumer_surfaces",
        "downgrade_triggers",
        "required_proof_packet_refs",
        "source_contract_refs",
        "hides_affected_scope",
        "hides_local_continuity",
        "invents_generic_advisory_language",
        "stays_silent_on_stale_or_unsigned"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "qualification": { "$ref": "#/$defs/qualification" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "shell_zone_slot": { "$ref": "#/$defs/shell_zone_slot" },
        "responsive_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsive_class" }
        },
        "window_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/window_class" }
        },
        "surface_families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface_family" }
        },
        "required_labels": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/required_label" }
        },
        "severity_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/severity_class" }
        },
        "projection_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projection_surface" }
        },
        "anatomy_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/anatomy_field" }
        },
        "action_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/action_state" }
        },
        "required_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_action" }
        },
        "dismissal_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/dismissal_state" }
        },
        "continuity_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/continuity_claim" }
        },
        "delivery_profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/delivery_profile" }
        },
        "freshness_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/freshness_state" }
        },
        "disclosure_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/disclosure_field" }
        },
        "notification_behaviors": {
          "type": "array",
          "items": { "$ref": "#/$defs/notification_behavior" }
        },
        "export_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_field" }
        },
        "accessibility_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accessibility_route" }
        },
        "consumer_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_surface" }
        },
        "downgrade_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/downgrade_trigger" }
        },
        "required_proof_packet_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "source_contract_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "hides_affected_scope": { "const": false },
        "hides_local_continuity": { "const": false },
        "invents_generic_advisory_language": { "const": false },
        "stays_silent_on_stale_or_unsigned": { "const": false }
      }
    },
    "vocabulary_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_families",
        "severity_classes",
        "anatomy_fields",
        "action_states",
        "required_actions",
        "dismissal_states",
        "continuity_claims",
        "delivery_profiles",
        "freshness_states",
        "disclosure_fields",
        "notification_behaviors",
        "export_fields",
        "projection_surfaces",
        "accessibility_routes",
        "required_labels"
      ],
      "properties": {
        "component_families": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "severity_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "anatomy_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "action_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "required_actions": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "dismissal_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "continuity_claims": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "delivery_profiles": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "freshness_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "disclosure_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "notification_behaviors": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "export_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "projection_surfaces": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "accessibility_routes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "required_labels": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_card_names_required_anatomy",
        "severity_vocabulary_is_closed",
        "emergency_notice_declares_blast_radius_and_dismissal",
        "affected_install_panel_preserves_local_continuity",
        "disclosure_block_keeps_ids_and_history",
        "activity_row_reconstructable_from_support_export",
        "native_notification_carries_no_sensitive_body",
        "mirror_lag_or_unsigned_auto_narrows",
        "no_component_invents_generic_advisory_language",
        "every_component_bound_to_shell_zone",
        "every_component_declares_accessibility_route",
        "later_rows_cannot_invent_parallel_vocabulary"
      ],
      "properties": {
        "advisory_card_names_required_anatomy": { "const": true },
        "severity_vocabulary_is_closed": { "const": true },
        "emergency_notice_declares_blast_radius_and_dismissal": { "const": true },
        "affected_install_panel_preserves_local_continuity": { "const": true },
        "disclosure_block_keeps_ids_and_history": { "const": true },
        "activity_row_reconstructable_from_support_export": { "const": true },
        "native_notification_carries_no_sensitive_body": { "const": true },
        "mirror_lag_or_unsigned_auto_narrows": { "const": true },
        "no_component_invents_generic_advisory_language": { "const": true },
        "every_component_bound_to_shell_zone": { "const": true },
        "every_component_declares_accessibility_route": { "const": true },
        "later_rows_cannot_invent_parallel_vocabulary": { "const": true }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_center_reads_advisory_matrix",
        "marketplace_reads_advisory_matrix",
        "help_about_reads_advisory_matrix",
        "support_bundle_reads_single_source",
        "native_notifications_read_single_source",
        "mirror_offline_drills_read_single_source"
      ],
      "properties": {
        "update_center_reads_advisory_matrix": { "const": true },
        "marketplace_reads_advisory_matrix": { "const": true },
        "help_about_reads_advisory_matrix": { "const": true },
        "support_bundle_reads_single_source": { "const": true },
        "native_notifications_read_single_source": { "const": true },
        "mirror_offline_drills_read_single_source": { "const": true }
      }
    },
    "proof_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_freshness_slo_hours", "last_proof_refresh", "auto_narrow_on_stale"],
      "properties": {
        "proof_freshness_slo_hours": { "type": "integer", "minimum": 1 },
        "last_proof_refresh": { "$ref": "#/$defs/non_empty_string" },
        "auto_narrow_on_stale": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_packet_ref",
        "advisory_component_audit_ref",
        "support_export_parity_required",
        "accessibility_parity_required"
      ],
      "properties": {
        "release_packet_ref": { "$ref": "#/$defs/non_empty_string" },
        "advisory_component_audit_ref": { "$ref": "#/$defs/non_empty_string" },
        "support_export_parity_required": { "const": true },
        "accessibility_parity_required": { "const": true }
      }
    }
  }
}
