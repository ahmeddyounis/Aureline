{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/security/m5-advisory-component-release-proof.schema.json",
  "title": "Aureline M5 advisory-component release-proof certification packet",
  "description": "Release-evidence certification packet for advisory-card, emergency-notice, affected-install, disclosure/history, advisory activity, and native-notification advisory truth across claimed M5 channels, install topologies, and mirror/offline profiles. Each row derives green/yellow/red status from advisory contract truth, cross-channel parity, support-export proof, proof freshness, and no-hidden-advisory-truth invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "advisory_card_contract_ref",
    "affected_install_contract_ref",
    "severity_matrix_ref",
    "mirror_offline_drill_ref",
    "continuity_gate_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_proof_dimensions",
    "required_truth_pillars",
    "required_surface_families",
    "rows",
    "covered_families",
    "covered_truth_pillars",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "certification_causes",
    "blocking_findings",
    "report_clean",
    "claim_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "component_family": {
      "type": "string",
      "enum": [
        "advisory_card",
        "emergency_notice",
        "affected_install_panel",
        "disclosure_block",
        "advisory_activity_row",
        "native_notification_handoff"
      ]
    },
    "status": { "type": "string", "enum": ["green", "yellow", "red"] },
    "proof_dimension": {
      "type": "string",
      "enum": [
        "advisory_contract_truth",
        "cross_channel_parity",
        "support_export_proof",
        "proof_freshness"
      ]
    },
    "truth_pillar": {
      "type": "string",
      "enum": [
        "affected_scope_exposure_and_continuity",
        "emergency_blast_radius_and_forced_disable",
        "disclosure_provenance_and_history"
      ]
    },
    "advisory_contract_truth_state": {
      "type": "string",
      "enum": [
        "advisory_truth_certified_every_channel",
        "disclosed_reduced_advisory_truth",
        "advisory_truth_collapsed_or_drifted"
      ]
    },
    "cross_channel_parity_state": {
      "type": "string",
      "enum": [
        "parity_certified_across_channels",
        "disclosed_reduced_channel_projection",
        "channel_grammar_diverged_off_primary_channel"
      ]
    },
    "support_export_proof_state": {
      "type": "string",
      "enum": [
        "reconstructable_in_export_and_screenshot",
        "disclosed_partial_capture",
        "advisory_truth_absent_from_capture"
      ]
    },
    "proof_freshness_state": {
      "type": "string",
      "enum": [
        "exported_proof_fresh_and_current",
        "disclosed_partial_refresh",
        "exported_proof_stale_or_divergent"
      ]
    },
    "downgrade_trigger": {
      "type": "string",
      "enum": [
        "affected_scope_hidden",
        "dismissal_rule_violated",
        "exposure_hidden_behind_generic_banner",
        "external_disclosure_only",
        "fixed_version_or_mitigation_missing",
        "forced_disable_scope_hidden",
        "local_continuity_hidden",
        "mirror_lag_undisclosed",
        "proof_stale",
        "signer_source_state_hidden",
        "stale_notice_state_silent",
        "unsigned_distribution_undisclosed"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "component_family", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "component_family": { "$ref": "#/$defs/component_family" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_family", "trigger", "disclosed", "detail"],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "trigger": { "$ref": "#/$defs/downgrade_trigger" },
        "disclosed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": { "$ref": "#/$defs/non_empty_string" },
        "family": { "type": "string" },
        "waiver_id": { "type": "string" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_family",
        "matrix_qualification",
        "owner_role",
        "family_label",
        "scope_summary",
        "certified_truth_pillars",
        "shell_zone_slot",
        "certified_responsive_classes",
        "certified_window_classes",
        "certified_surface_families",
        "certified_severity_classes",
        "certified_projection_surfaces",
        "certified_anatomy_fields",
        "certified_action_states",
        "certified_required_actions",
        "certified_dismissal_states",
        "certified_continuity_claims",
        "certified_delivery_profiles",
        "certified_freshness_states",
        "certified_disclosure_fields",
        "certified_notification_behaviors",
        "certified_export_fields",
        "accessibility_routes",
        "required_labels",
        "consumer_surfaces",
        "applicable_downgrade_triggers",
        "advisory_contract_truth",
        "cross_channel_parity",
        "support_export_proof",
        "proof_freshness",
        "never_hides_advisory_truth_off_channel",
        "active_waiver",
        "derived_status",
        "certification_causes",
        "narrowing_reason"
      ],
      "properties": {
        "component_family": { "$ref": "#/$defs/component_family" },
        "matrix_qualification": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "family_label": { "$ref": "#/$defs/non_empty_string" },
        "scope_summary": { "$ref": "#/$defs/non_empty_string" },
        "certified_truth_pillars": { "type": "array", "items": { "$ref": "#/$defs/truth_pillar" }, "minItems": 1 },
        "shell_zone_slot": { "$ref": "#/$defs/non_empty_string" },
        "certified_responsive_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_window_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_surface_families": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_severity_classes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_projection_surfaces": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_anatomy_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_action_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_required_actions": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_dismissal_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_continuity_claims": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_delivery_profiles": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_freshness_states": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_disclosure_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_notification_behaviors": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "certified_export_fields": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "accessibility_routes": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "required_labels": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "consumer_surfaces": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "applicable_downgrade_triggers": { "type": "array", "items": { "$ref": "#/$defs/downgrade_trigger" } },
        "advisory_contract_truth": { "$ref": "#/$defs/advisory_contract_truth_state" },
        "cross_channel_parity": { "$ref": "#/$defs/cross_channel_parity_state" },
        "support_export_proof": { "$ref": "#/$defs/support_export_proof_state" },
        "proof_freshness": { "$ref": "#/$defs/proof_freshness_state" },
        "never_hides_advisory_truth_off_channel": { "type": "boolean" },
        "active_waiver": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }] },
        "derived_status": { "$ref": "#/$defs/status" },
        "certification_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
        "narrowing_reason": { "oneOf": [{ "type": "null" }, { "type": "string" }] }
      }
    }
  },
  "properties": {
    "record_kind": { "const": "security_m5_advisory_component_release_proof_packet_record" },
    "schema_version": { "const": 1 },
    "shared_contract_ref": { "$ref": "#/$defs/non_empty_string" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "advisory_card_contract_ref": { "$ref": "#/$defs/non_empty_string" },
    "affected_install_contract_ref": { "$ref": "#/$defs/non_empty_string" },
    "severity_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
    "mirror_offline_drill_ref": { "$ref": "#/$defs/non_empty_string" },
    "continuity_gate_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_proof_dimensions": { "type": "array", "items": { "$ref": "#/$defs/proof_dimension" }, "minItems": 4, "uniqueItems": true },
    "required_truth_pillars": { "type": "array", "items": { "$ref": "#/$defs/truth_pillar" }, "minItems": 3, "uniqueItems": true },
    "required_surface_families": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" }, "minItems": 1, "uniqueItems": true },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" }, "minItems": 6 },
    "covered_families": { "type": "array", "items": { "$ref": "#/$defs/component_family" }, "minItems": 6, "uniqueItems": true },
    "covered_truth_pillars": { "type": "array", "items": { "$ref": "#/$defs/truth_pillar" }, "minItems": 3, "uniqueItems": true },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } },
    "certification_causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
    "blocking_findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "report_clean": { "type": "boolean" },
    "claim_automation_refs": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "release_center_refs": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "help_docs_refs": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "support_export_refs": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  }
}
