{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/security/m5-advisory-claim-downgrade-certification.schema.json",
  "title": "Aureline M5 advisory-claim downgrade certification: stale-advisory, mirror-lag, unsigned-distribution, and continuity-downgrade rules that auto-narrow release/help/procurement/evaluation/support advisory claims across managed, self-hosted, and offline profiles",
  "description": "Export-safe certification packet that decides, for every claimed M5 deployment profile — managed, self-hosted, and offline — whether Aureline may keep its release / help / procurement / evaluation / support advisory claims, and auto-narrows those claims the moment advisory freshness, mirror propagation, distribution signature, or local-continuity proof falls behind. Each profile row certifies four downgrade dimensions together (advisory freshness, mirror propagation, distribution signature, local continuity), naming the claimed advisory-component families it evaluated (pulled verbatim from the frozen M5 advisory-component matrix) and the claim surfaces its downgrade state projects into. The green/yellow/red status is derived, never asserted: a row drops to yellow the moment the profile discloses a stale notice, a lagging mirror, a partially verified distribution, or a reduced local-continuity proof; it drops to red if any of those goes silent and overclaims, local continuity is lost, or the profile fails to evaluate every claimed advisory family or project into every claimed claim surface. Managed, self-hosted, and offline each preserve their own distinct downgrade reason (warning-only vs mirror-lagged vs unsigned/unverified vs awaiting-user-action vs forced-disable) rather than collapsing into one generic 'degraded' state, and every claim cause names the exact frozen downgrade trigger that fired and the restore action that would restore the claim. The record carries only stable ids, closed vocabulary, counts, refs, and short labels — never raw URLs, raw paths, credentials, or tokens. The Rust builder and validator in crates/aureline-shell are the authoritative gate; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "shared_contract_ref",
    "packet_id",
    "source_schema_ref",
    "headline",
    "matrix_packet_ref",
    "matrix_schema_ref",
    "advisory_card_contract_ref",
    "affected_install_contract_ref",
    "severity_matrix_ref",
    "mirror_offline_drill_ref",
    "continuity_gate_ref",
    "build_identity_ref",
    "release_channel_class",
    "required_dimensions",
    "required_profiles",
    "required_families",
    "required_channels",
    "required_claim_states",
    "rows",
    "covered_profiles",
    "covered_claim_states",
    "row_count",
    "green_row_count",
    "yellow_row_count",
    "red_row_count",
    "all_rows_publishable",
    "active_waivers",
    "claim_causes",
    "blocking_findings",
    "report_clean",
    "claim_automation_refs",
    "release_center_refs",
    "help_docs_refs",
    "support_export_refs",
    "published_report_ref",
    "published_packet_ref",
    "published_dashboard_ref",
    "published_doc_ref",
    "generated_at"
  ],
  "properties": {
    "record_kind": {
      "const": "security_m5_advisory_claim_downgrade_certification_packet_record"
    },
    "schema_version": { "const": 1 },
    "shared_contract_ref": { "$ref": "#/$defs/non_empty_string" },
    "packet_id": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "headline": { "$ref": "#/$defs/non_empty_string" },
    "matrix_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "matrix_schema_ref": { "$ref": "#/$defs/non_empty_string" },
    "advisory_card_contract_ref": { "$ref": "#/$defs/non_empty_string" },
    "affected_install_contract_ref": { "$ref": "#/$defs/non_empty_string" },
    "severity_matrix_ref": { "$ref": "#/$defs/non_empty_string" },
    "mirror_offline_drill_ref": { "$ref": "#/$defs/non_empty_string" },
    "continuity_gate_ref": { "$ref": "#/$defs/non_empty_string" },
    "build_identity_ref": { "$ref": "#/$defs/non_empty_string" },
    "release_channel_class": { "$ref": "#/$defs/non_empty_string" },
    "required_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimension_token" },
      "minItems": 4,
      "uniqueItems": true
    },
    "required_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile_token" },
      "minItems": 3,
      "uniqueItems": true
    },
    "required_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "minItems": 6,
      "uniqueItems": true
    },
    "required_channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/channel_token" },
      "minItems": 5,
      "uniqueItems": true
    },
    "required_claim_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim_state_token" },
      "minItems": 5,
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/certification_row" }
    },
    "covered_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile_token" },
      "uniqueItems": true
    },
    "covered_claim_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim_state_token" },
      "uniqueItems": true
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "green_row_count": { "type": "integer", "minimum": 0 },
    "yellow_row_count": { "type": "integer", "minimum": 0 },
    "red_row_count": { "type": "integer", "minimum": 0 },
    "all_rows_publishable": { "type": "boolean" },
    "active_waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "claim_causes": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim_cause" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "report_clean": { "type": "boolean" },
    "claim_automation_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "release_center_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "help_docs_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "support_export_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "published_report_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_packet_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_dashboard_ref": { "$ref": "#/$defs/non_empty_string" },
    "published_doc_ref": { "$ref": "#/$defs/non_empty_string" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "profile_token": {
      "type": "string",
      "enum": ["managed", "self_hosted", "offline"]
    },
    "dimension_token": {
      "type": "string",
      "enum": [
        "advisory_freshness",
        "mirror_propagation",
        "distribution_signature",
        "local_continuity"
      ]
    },
    "channel_token": {
      "type": "string",
      "enum": ["release", "help", "procurement", "evaluation", "support"]
    },
    "claim_state_token": {
      "type": "string",
      "enum": [
        "warning_only",
        "forced_disable",
        "awaiting_user_action",
        "mirror_lagged",
        "unsigned_unverified"
      ]
    },
    "status_token": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "restore_action_token": {
      "type": "string",
      "enum": [
        "refresh_mirror",
        "re_sign_or_reverify",
        "acknowledge_or_act",
        "await_notice_refresh",
        "restore_continuity_proof",
        "none_required"
      ]
    },
    "advisory_freshness_token": {
      "type": "string",
      "enum": [
        "fresh_advisory_state_certified",
        "disclosed_stale_notice_narrowing",
        "advisory_state_stale_and_overclaimed"
      ]
    },
    "mirror_propagation_token": {
      "type": "string",
      "enum": [
        "mirror_current_and_propagated",
        "disclosed_mirror_lag_narrowing",
        "mirror_lagged_claim_overclaimed"
      ]
    },
    "distribution_signature_token": {
      "type": "string",
      "enum": [
        "fully_signed_and_verified",
        "disclosed_partial_verification_narrowing",
        "unsigned_or_unverified_distribution"
      ]
    },
    "local_continuity_token": {
      "type": "string",
      "enum": [
        "local_continuity_proven_and_safe",
        "disclosed_reduced_continuity_proof",
        "continuity_proof_missing_or_unsafe"
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver_id", "profile", "reason", "owner_role", "expires_at"],
      "properties": {
        "waiver_id": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "$ref": "#/$defs/profile_token" },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "expires_at": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "claim_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "dimension",
        "trigger",
        "disclosed",
        "restore_action",
        "detail"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/profile_token" },
        "dimension": { "$ref": "#/$defs/dimension_token" },
        "trigger": { "$ref": "#/$defs/non_empty_string" },
        "disclosed": { "type": "boolean" },
        "restore_action": { "$ref": "#/$defs/restore_action_token" },
        "detail": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": { "$ref": "#/$defs/non_empty_string" },
        "profile": { "type": "string" },
        "waiver_id": { "type": "string" }
      }
    },
    "certification_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profile_label",
        "owner_role",
        "scenario_summary",
        "evaluated_families",
        "projected_channels",
        "advisory_freshness",
        "mirror_propagation",
        "distribution_signature",
        "local_continuity",
        "applicable_downgrade_triggers",
        "active_waiver",
        "derived_status",
        "claim_states",
        "claim_causes",
        "narrowing_reason"
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/profile_token" },
        "profile_label": { "$ref": "#/$defs/non_empty_string" },
        "owner_role": { "$ref": "#/$defs/non_empty_string" },
        "scenario_summary": { "$ref": "#/$defs/non_empty_string" },
        "evaluated_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "minItems": 6,
          "uniqueItems": true
        },
        "projected_channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/channel_token" },
          "minItems": 5,
          "uniqueItems": true
        },
        "advisory_freshness": { "$ref": "#/$defs/advisory_freshness_token" },
        "mirror_propagation": { "$ref": "#/$defs/mirror_propagation_token" },
        "distribution_signature": { "$ref": "#/$defs/distribution_signature_token" },
        "local_continuity": { "$ref": "#/$defs/local_continuity_token" },
        "applicable_downgrade_triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "active_waiver": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/waiver" }]
        },
        "derived_status": { "$ref": "#/$defs/status_token" },
        "claim_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_state_token" },
          "uniqueItems": true
        },
        "claim_causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_cause" }
        },
        "narrowing_reason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }]
        }
      }
    }
  }
}
