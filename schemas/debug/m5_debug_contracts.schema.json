{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/debug/m5_debug_contracts.schema.json",
  "title": "Aureline M5 debug-contracts matrix",
  "description": "Boundary schema for the M5 debug-contracts matrix: the frozen, typed contract for Aureline's debug-session, attach-target, breakpoint/watch/evaluate, console, chronology, replay, and notebook-debug-parity truth. The matrix names each governed debugger object family (debug session, attach target, breakpoint spec, frame mapping, variable/watch snapshot, evaluate request/result, console emission, chronology capability, replay session, and notebook-debug parity), cites the canonical boundary schema(s) and producing crate module it binds, maps each one to the proof packet that keeps it current, pins one shared qualification-state vocabulary, defines the controlled vocabulary spanning session mode, breakpoint/mapping state, variable freshness, evaluate purity, mapping fidelity, and restore/reattach posture, and lists the consumer surfaces (core debugger, notebook debug, profiler, incident review, support export, AI context, review workspace, CLI/headless, and docs/help) that render it. Debug truth stays explicit and replay-safe: launch, attach, core-file, replay, and inspect-only sessions stay distinct; breakpoint and mapping states stay visible; variables and watches never masquerade as live when stale; evaluation discloses side-effect risk; notebook, debugger, and replay share one support vocabulary; and a restored layout never implies reacquired authority over a target. No source bodies, raw paths, provider payloads, URLs, hostnames, or credentials cross this boundary; the record carries opaque object refs, stable tokens, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_debug_contracts_schema_version",
    "schema_ref",
    "matrix_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "shared_vocabulary",
    "state_vocabulary",
    "objects",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_debug_contracts_matrix" },
    "m5_debug_contracts_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/debug/m5_debug_contracts.schema.json" },
    "matrix_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "shared_vocabulary": { "$ref": "#/$defs/shared_vocabulary" },
    "state_vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state_term" }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/object_entry" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matrix_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "object_class": {
      "type": "string",
      "enum": [
        "debug_session",
        "attach_target",
        "breakpoint_spec",
        "frame_mapping",
        "variable_watch_snapshot",
        "evaluate_request_result",
        "console_emission",
        "chronology_capability",
        "replay_session",
        "notebook_debug_parity"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "session_launch",
        "session_attach",
        "session_core_file",
        "session_replay",
        "session_inspect_only",
        "breakpoint_verified",
        "breakpoint_pending",
        "breakpoint_unbound_unverified",
        "breakpoint_mapping_adjusted",
        "breakpoint_rejected",
        "variable_live_at_stop",
        "variable_stale_since_resume",
        "variable_unavailable_optimized_out",
        "evaluate_side_effect_free",
        "evaluate_mutating",
        "evaluate_unknown_side_effects",
        "evaluate_blocked_inspect_only",
        "mapping_exact",
        "mapping_approximate",
        "mapping_symbol_only",
        "mapping_unmapped",
        "restore_layout_only_not_reattached",
        "restore_reattach_required",
        "restore_reacquired_authority"
      ]
    },
    "controlled_vocabulary": {
      "type": "string",
      "enum": [
        "session_mode",
        "breakpoint_state",
        "variable_freshness",
        "evaluate_purity",
        "mapping_fidelity",
        "restore_posture"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "core_debugger",
        "notebook_debug",
        "profiler",
        "incident_review",
        "support_export",
        "ai_context",
        "review_workspace",
        "cli_headless",
        "docs_help"
      ]
    },
    "redaction_class": {
      "type": "string",
      "enum": [
        "metadata_safe_default",
        "summary_and_refs_only",
        "operator_only_restricted",
        "internal_support_restricted"
      ]
    },
    "token_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "label"],
      "properties": {
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "token_def_array": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/token_def" }
    },
    "shared_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_modes",
        "breakpoint_states",
        "variable_freshness_classes",
        "evaluate_purity_classes",
        "mapping_fidelity_classes",
        "restore_postures",
        "redaction_classes",
        "consumer_classes",
        "source_schema_refs"
      ],
      "properties": {
        "session_modes": { "$ref": "#/$defs/token_def_array" },
        "breakpoint_states": { "$ref": "#/$defs/token_def_array" },
        "variable_freshness_classes": { "$ref": "#/$defs/token_def_array" },
        "evaluate_purity_classes": { "$ref": "#/$defs/token_def_array" },
        "mapping_fidelity_classes": { "$ref": "#/$defs/token_def_array" },
        "restore_postures": { "$ref": "#/$defs/token_def_array" },
        "redaction_classes": { "$ref": "#/$defs/token_def_array" },
        "consumer_classes": { "$ref": "#/$defs/token_def_array" },
        "source_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        }
      }
    },
    "state_term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "token",
        "label",
        "vocabulary",
        "requires_disclosure",
        "implies_live_authority",
        "discloses_side_effect_risk",
        "is_inspect_only",
        "concerns_authority"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/state_class" },
        "token": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "vocabulary": { "$ref": "#/$defs/controlled_vocabulary" },
        "requires_disclosure": { "type": "boolean" },
        "implies_live_authority": { "type": "boolean" },
        "discloses_side_effect_risk": { "type": "boolean" },
        "is_inspect_only": { "type": "boolean" },
        "concerns_authority": { "type": "boolean" }
      }
    },
    "field_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "label", "required"],
      "properties": {
        "field_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "required": { "type": "boolean" }
      }
    },
    "object_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "object_id",
        "label",
        "summary",
        "canonical_schema_refs",
        "produced_by_refs",
        "proof_packet_ref",
        "consumed_by",
        "applicable_states",
        "controlled_vocabularies",
        "required_fields",
        "state_always_visible",
        "discloses_authority_posture",
        "freshness_tracked",
        "side_effect_disclosed",
        "carries_source_attribution",
        "source_attribution_field",
        "default_redaction",
        "locally_inspectable",
        "typed_not_prose_only",
        "boundary_note"
      ],
      "properties": {
        "object": { "$ref": "#/$defs/object_class" },
        "object_id": { "$ref": "#/$defs/non_empty_string" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "canonical_schema_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "produced_by_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "consumed_by": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumer_class" }
        },
        "applicable_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_class" }
        },
        "controlled_vocabularies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/controlled_vocabulary" }
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field_def" }
        },
        "state_always_visible": { "const": true },
        "discloses_authority_posture": { "type": "boolean" },
        "freshness_tracked": { "type": "boolean" },
        "side_effect_disclosed": { "type": "boolean" },
        "carries_source_attribution": { "type": "boolean" },
        "source_attribution_field": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "default_redaction": { "$ref": "#/$defs/redaction_class" },
        "locally_inspectable": { "const": true },
        "typed_not_prose_only": { "const": true },
        "boundary_note": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "matrix_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
