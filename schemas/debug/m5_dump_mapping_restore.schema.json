{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/schemas/debug/m5_dump_mapping_restore.schema.json",
  "title": "Aureline M5 dump/mapping/restore set",
  "description": "Boundary schema for the typed M5 dump/core-file/source-map/symbol artifact strips, the shared six-state mapping-fidelity vocabulary, and the restore-honesty records every debugger, notebook, profiler, incident, support, and AI surface reads. Every artifact strip carries one pill that pins one mapping fidelity (exact, approximate, symbol_only, unresolved, imported, mismatched_build), one build-match outcome, and one source class (workspace_source, local_artifact, provider_supplied, mirror_supplied, imported_attachment), so a precise source link renders only for an exact mapping backed by an exact-build match; an imported or build-mismatched strip never renders it; core-file, crash-dump, open-replay, and open-inspect-only are four distinct session entrypoints, distinct from importing a symbol or source-map artifact; and every strip carries its build/artifact identity, capture time, and (for mapping inputs) debug format. Every restored layout carries one pill that names whether the prior process/session is gone, inspect-only, reconnect-required, or manually relaunchable, never implies live target continuity or reacquired process authority, and shows an exact-build mapping only when it is still verified. No dump bodies, memory contents, source bodies, value bodies, raw paths, provider payloads, URLs, hostnames, or credentials cross this boundary; the record carries opaque object refs, stable tokens, opaque digests, and short reviewable sentences only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "m5_dump_mapping_restore_schema_version",
    "schema_ref",
    "set_id",
    "as_of",
    "freeze_gate_ref",
    "summary",
    "source_schema_refs",
    "producer_refs",
    "consumer_surfaces",
    "artifacts",
    "restored_layouts",
    "invariants",
    "raw_payload_excluded"
  ],
  "properties": {
    "record_kind": { "const": "m5_dump_mapping_restore_set" },
    "m5_dump_mapping_restore_schema_version": { "type": "integer", "const": 1 },
    "schema_ref": { "const": "schemas/debug/m5_dump_mapping_restore.schema.json" },
    "set_id": { "$ref": "#/$defs/non_empty_string" },
    "as_of": { "type": "string", "format": "date-time" },
    "freeze_gate_ref": { "$ref": "#/$defs/repo_ref" },
    "summary": { "$ref": "#/$defs/non_empty_string" },
    "source_schema_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repo_ref" }
    },
    "producer_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repo_ref" }
    },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer_class" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/debug_artifact_strip" }
    },
    "restored_layouts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/restored_layout_record" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dump_restore_invariant" }
    },
    "raw_payload_excluded": { "const": true }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A repo-relative object ref or opaque aureline:// handle. Never a URL, host, credential, or absolute path.",
      "pattern": "^(schemas/|crates/|artifacts/|fixtures/|docs/|aureline://)"
    },
    "mapping_fidelity": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "symbol_only",
        "unresolved",
        "imported",
        "mismatched_build"
      ]
    },
    "build_match": {
      "type": "string",
      "enum": [
        "exact_build_verified",
        "approximate_candidate",
        "mismatched_rejected",
        "no_candidate"
      ]
    },
    "artifact_kind": {
      "type": "string",
      "enum": [
        "core_file",
        "crash_dump",
        "inspect_only_session",
        "symbol_artifact",
        "source_map",
        "replay_capture"
      ]
    },
    "entrypoint": {
      "type": "string",
      "enum": [
        "open_core_file",
        "open_crash_dump",
        "open_replay",
        "open_inspect_only",
        "import_symbols_or_source_map"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": [
        "workspace_source",
        "local_artifact",
        "provider_supplied",
        "mirror_supplied",
        "imported_attachment"
      ]
    },
    "restore_posture": {
      "type": "string",
      "enum": [
        "process_gone",
        "inspect_only_continuation",
        "reconnect_required",
        "manually_relaunchable"
      ]
    },
    "debug_format": {
      "type": "string",
      "enum": [
        "pdb",
        "dsym",
        "dwarf",
        "javascript_source_map",
        "typescript_source_map",
        "css_source_map"
      ]
    },
    "consumer_class": {
      "type": "string",
      "enum": [
        "core_debugger",
        "notebook_debug",
        "profiler",
        "incident_review",
        "support_export",
        "ai_context",
        "review_workspace",
        "cli_headless",
        "docs_help"
      ]
    },
    "debug_artifact_pill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fidelity",
        "fidelity_token",
        "build_match",
        "build_match_token",
        "source_class",
        "source_class_token",
        "label",
        "shows_exact_source_link",
        "requires_disclosure",
        "allows_source_navigation",
        "is_mirrored_source",
        "is_imported_source",
        "is_inspect_only"
      ],
      "properties": {
        "fidelity": { "$ref": "#/$defs/mapping_fidelity" },
        "fidelity_token": { "$ref": "#/$defs/mapping_fidelity" },
        "build_match": { "$ref": "#/$defs/build_match" },
        "build_match_token": { "$ref": "#/$defs/build_match" },
        "source_class": { "$ref": "#/$defs/source_class" },
        "source_class_token": { "$ref": "#/$defs/source_class" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "shows_exact_source_link": { "type": "boolean" },
        "requires_disclosure": { "type": "boolean" },
        "allows_source_navigation": { "type": "boolean" },
        "is_mirrored_source": { "type": "boolean" },
        "is_imported_source": { "type": "boolean" },
        "is_inspect_only": { "type": "boolean" }
      }
    },
    "debug_artifact_strip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strip_id",
        "artifact_kind",
        "artifact_kind_token",
        "entrypoint",
        "entrypoint_token",
        "opens_inspect_only_session",
        "captured_as_of",
        "pill",
        "proof_packet_ref",
        "summary"
      ],
      "properties": {
        "strip_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_kind": { "$ref": "#/$defs/artifact_kind" },
        "artifact_kind_token": { "$ref": "#/$defs/artifact_kind" },
        "entrypoint": { "$ref": "#/$defs/entrypoint" },
        "entrypoint_token": { "$ref": "#/$defs/entrypoint" },
        "opens_inspect_only_session": { "type": "boolean" },
        "build_id": { "$ref": "#/$defs/non_empty_string" },
        "artifact_ref": { "$ref": "#/$defs/repo_ref" },
        "debug_format": { "$ref": "#/$defs/debug_format" },
        "captured_as_of": { "type": "string", "format": "date-time" },
        "pill": { "$ref": "#/$defs/debug_artifact_pill" },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "restore_pill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posture",
        "posture_token",
        "mapping_fidelity",
        "mapping_fidelity_token",
        "label",
        "implies_live_continuity",
        "implies_process_authority",
        "implies_exact_build_mapping",
        "requires_explicit_action",
        "reconnect_available",
        "relaunch_available",
        "requires_disclosure"
      ],
      "properties": {
        "posture": { "$ref": "#/$defs/restore_posture" },
        "posture_token": { "$ref": "#/$defs/restore_posture" },
        "mapping_fidelity": { "$ref": "#/$defs/mapping_fidelity" },
        "mapping_fidelity_token": { "$ref": "#/$defs/mapping_fidelity" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "implies_live_continuity": { "const": false },
        "implies_process_authority": { "const": false },
        "implies_exact_build_mapping": { "type": "boolean" },
        "requires_explicit_action": { "type": "boolean" },
        "reconnect_available": { "type": "boolean" },
        "relaunch_available": { "type": "boolean" },
        "requires_disclosure": { "const": true }
      }
    },
    "restored_layout_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_id",
        "restored_strip_ref",
        "prior_session_ref",
        "restored_as_of",
        "exact_build_still_verified",
        "pill",
        "proof_packet_ref",
        "summary"
      ],
      "properties": {
        "layout_id": { "$ref": "#/$defs/non_empty_string" },
        "restored_strip_ref": { "$ref": "#/$defs/non_empty_string" },
        "prior_session_ref": { "$ref": "#/$defs/non_empty_string" },
        "restored_as_of": { "type": "string", "format": "date-time" },
        "exact_build_still_verified": { "type": "boolean" },
        "pill": { "$ref": "#/$defs/restore_pill" },
        "proof_packet_ref": { "$ref": "#/$defs/repo_ref" },
        "summary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "dump_restore_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "holds"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/non_empty_string" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "holds": { "const": true }
      }
    }
  }
}
