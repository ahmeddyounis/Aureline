        {
          "limit_class": "not_native_trust_chrome",
          "limit_note": "This is untrusted content and is never native Aureline trust chrome."
        },
        {
          "limit_class": "cannot_verify_updates",
          "limit_note": "Untrusted content cannot verify updates."
        },
        {
          "limit_class": "cannot_grant_device_permission",
          "limit_note": "Untrusted content cannot grant device permissions."
        },
        {
          "limit_class": "cannot_display_product_security",
