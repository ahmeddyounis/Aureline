      "owner_class": "provider_owned",
      "owner_identity_ref": "owner.provider.connected_provider",
      "owner_label": "Connected provider",
      "origin_label": "app.provider.example",
      "origin_disclosure": "named_provider_origin",
      "permission_state": "no_elevated_permissions",
      "open_in_browser": {
        "action_ref": "action.open_in_browser.provider",
        "action_label": "Open in browser",
        "available": true
      },
      "capability_limits": [
        {
          "limit_class": "not_native_trust_chrome",
          "limit_note": "This bar is provider content, not native Aureline trust chrome."
