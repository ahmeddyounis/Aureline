        {
          "limit_class": "cannot_grant_device_permission",
          "limit_note": "Provider content cannot grant device permissions."
        },
        {
          "limit_class": "cannot_enter_product_credentials",
          "limit_note": "Never enter your Aureline credentials into provider content."
