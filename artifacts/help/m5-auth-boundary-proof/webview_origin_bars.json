{
  "schema_version": 1,
  "record_kind": "m5_webview_origin_bar_set",
  "set_id": "m5_webview_origin_bar_set:default",
  "set_label": "M5 webview origin bars",
  "bars": [
    {
      "webview_origin_bar_schema_version": 1,
      "record_kind": "webview_origin_bar_record",
      "bar_id": "webview_origin_bar:extension_owned",
