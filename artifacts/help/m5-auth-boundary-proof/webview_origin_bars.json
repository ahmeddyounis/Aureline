      "labeled_as_embedded": true,
      "impersonates_native_chrome": false,
      "may_show_update_verification": false,
      "may_show_device_permission_prompt": false,
      "may_show_product_security_messaging": false,
      "headline_label": "Provider content",
      "bar_summary": "Embedded provider content, labeled with its origin and disclosed as not native trust chrome.",
      "contract_doc_ref": "docs/help/m5_auth_boundaries_contract.md",
      "notes": null
    },
