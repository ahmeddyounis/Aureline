    {
      "rule_id": "rule.claim_label_narrowed",
      "title": "Inherited claim ceiling",
      "trigger_reason": "claim_label_narrowed",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "narrow_label",
      "blocks_promotion": true,
      "rationale": "A family whose backing public claim is already narrowed inherits that ceiling and may not republish wider."
    },
    {
      "rule_id": "rule.rehearsal_packet_missing",
      "title": "Missing rehearsal evidence",
      "trigger_reason": "rehearsal_packet_missing",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "rerun_rehearsal",
      "blocks_promotion": true,
      "rationale": "A claimed family with a rehearsal that has never run holds promotion until the rehearsal produces evidence."
    },
    {
      "rule_id": "rule.rehearsal_packet_stale",
      "title": "Stale rehearsal evidence",
      "trigger_reason": "rehearsal_packet_stale",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "rerun_rehearsal",
      "blocks_promotion": true,
      "rationale": "A rehearsal packet that has breached its freshness SLO holds promotion until it is re-run."
    },
    {
      "rule_id": "rule.rehearsal_failed",
      "title": "Red rehearsal",
      "trigger_reason": "rehearsal_failed",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "rerun_rehearsal",
      "blocks_promotion": true,
      "rationale": "A rehearsal that ran red holds promotion until the family is fixed and the rehearsal passes."
    },
    {
      "rule_id": "rule.rebuild_cache_only",
      "title": "Warmed-cache rebuild is not proof",
      "trigger_reason": "rebuild_cache_only",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "rerun_rehearsal",
      "blocks_promotion": true,
      "rationale": "A clean-room rebuild rehearsal that only rebuilt from a warmed cache never counts as rebuild proof and holds promotion."
    },
    {
      "rule_id": "rule.symbolication_freshness_decoupled",
      "title": "Symbolication freshness decoupled from release-center sync",
      "trigger_reason": "symbolication_freshness_decoupled",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "recouple_freshness",
      "blocks_promotion": true,
      "rationale": "Exact-build symbolication freshness may never run ahead of the release-center sync that grounds support and export freshness."
    },
    {
      "rule_id": "rule.evidence_incomplete",
      "title": "Incomplete rehearsal evidence",
      "trigger_reason": "evidence_incomplete",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "refresh_evidence",
      "blocks_promotion": true,
      "rationale": "A family whose rehearsal evidence is incomplete holds promotion until the evidence is recaptured."
    },
    {
      "rule_id": "rule.waiver_expired",
      "title": "Expired rehearsal waiver",
      "trigger_reason": "waiver_expired",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "refresh_evidence",
      "blocks_promotion": true,
      "rationale": "A family relying on a waiver that has expired holds promotion until the underlying rehearsal evidence is restored."
    },
    {
      "rule_id": "rule.owner_signoff_missing",
      "title": "Missing owner sign-off",
      "trigger_reason": "owner_signoff_missing",
      "applies_to_labels": ["lts", "stable"],
      "default_action": "request_owner_signoff",
      "blocks_promotion": true,
      "rationale": "A claimed family without owner sign-off on its rehearsal posture holds promotion until the owner signs off."
    }
