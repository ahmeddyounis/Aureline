      "term": "managed",
      "surface": "settings",
      "canonical_text": "Managed cloud sync keeps the workspaces you choose in sync across devices.",
      "claim_kind": "states_boundary",
      "support_metadata_ref": "support.metadata.cloud_sync_compatibility",
      "actual_boundary_posture": "managed_optional",
      "introduces_managed_or_paid": true,
      "core_workflow_remains_local": true,
      "implications": [
        {
          "dimension": "identity",
          "posture": "required",
          "disclosure": "Requires sign-in to the managed workspace to sync."
        },
        {
          "dimension": "network",
          "posture": "required",
          "disclosure": "Requires network access to the managed sync service."
        },
        {
          "dimension": "data",
          "posture": "optional",
          "disclosure": "You choose which workspace data syncs; nothing leaves the device without opt-in."
        },
        {
          "dimension": "export",
          "posture": "retained",
          "disclosure": "A full local export of synced data remains available at any time."
        },
        {
          "dimension": "rollback",
          "posture": "retained",
          "disclosure": "You can roll back to the local-only configuration and keep editing."
        }
      ],
      "alternative_paths": [
        {
          "path": "local_only",
          "available": true,
          "disclosure": "Keep working fully local without sync.",
          "reference_ref": "support.metadata.local_only_path"
        },
        {
          "path": "byok",
          "available": true,
          "disclosure": "Use your own storage credentials instead of managed storage.",
          "reference_ref": "support.metadata.byok_path"
        },
        {
          "path": "self_hosted",
          "available": true,
          "disclosure": "Point sync at a self-hosted endpoint you operate.",
          "reference_ref": "support.metadata.self_hosted_path"
        },
        {
          "path": "export",
          "available": true,
          "disclosure": "Export everything locally before or after enabling sync.",
          "reference_ref": "support.metadata.export_path"
        },
        {
          "path": "rollback",
          "available": true,
          "disclosure": "Disable sync and revert to the local-only configuration.",
          "reference_ref": "support.metadata.rollback_path"
        }
      ],
