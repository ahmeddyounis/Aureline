{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureline.dev/artifacts/migration/m3/mapping_report.schema.json",
  "title": "Aureline M3 migration wizard mapping report contract",
  "description": "Boundary schema for shell_migration_wizard_beta_mapping_report_record. The record is the retained dry-run mapping report produced by the M3 migration wizard. It carries every reviewed item classified as Exact, Translated, Partial, Shimmed, or Unsupported plus the rollback requirement ref and the reopen links that keep the report visible after first run. A requirement ref is not a checkpoint handle. Raw profile bodies, raw absolute paths, raw credentials, and raw support payloads never cross this boundary.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/shell_migration_wizard_beta_mapping_report_record" }
  ],
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^(?![/\\\\~]|[A-Za-z]:)(?!.*(?:\\.\\.[/\\\\]|://))(?!.*(?:^|[=/\\\\({,:;\\[])[Ff][Ii][Ll][Ee]:)[^\\s\\u0000-\\u001F\\u007F]+$",
      "description": "Bounded opaque stable identifier safe to log, persist, or export; raw paths, URLs, traversal, whitespace, and control data are excluded."
    },
    "monotonic_timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "redaction_aware_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|\\s|[=/\\\\({,:;\\[])[Ff][Ii][Ll][Ee]:)(?!.*(?:^|\\s|[=({,:;\\[])(?:[/\\\\~][^\\s]|[A-Za-z]:[/\\\\]))(?!.*(?:\\.\\.[/\\\\]|://))\\S(?:[^\\u0000-\\u001F\\u007F]*\\S)?$"
    },
    "ref_array": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/opaque_id" },
      "uniqueItems": true
    },
    "non_empty_ref_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/opaque_id" },
      "uniqueItems": true
    },
    "mapping_row_id": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^import-diff-row:[a-z0-9_]+:(settings|shortcuts|keymaps|themes_and_visuals|snippets_and_templates|tasks_and_run_configs|launch_debug|extensions_and_providers|workspace_profile):(exact|translated|partial|shimmed|unsupported):[A-Za-z0-9._:-]+$"
    },
    "mapping_gap_id": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^migration-wizard-gap:import-diff-row:[a-z0-9_]+:(settings|shortcuts|keymaps|themes_and_visuals|snippets_and_templates|tasks_and_run_configs|launch_debug|extensions_and_providers|workspace_profile):(shimmed|unsupported):[A-Za-z0-9._:-]+$"
    },
    "source_item_ref": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^[a-z0-9_]+:[A-Za-z0-9._:-]+$"
    },
    "target_item_ref": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^aureline:(settings|shortcuts|keymaps|themes_and_visuals|snippets_and_templates|tasks_and_run_configs|launch_debug|extensions_and_providers|workspace_profile):[A-Za-z0-9._:-]+$"
    },
    "import_mapping_classification": {
      "type": "string",
      "enum": [
        "exact",
        "translated",
        "partial",
        "shimmed",
        "unsupported"
      ]
    },
    "import_review_domain": {
      "type": "string",
      "enum": [
        "settings",
        "shortcuts",
        "keymaps",
        "themes_and_visuals",
        "snippets_and_templates",
        "tasks_and_run_configs",
        "launch_debug",
        "extensions_and_providers",
        "workspace_profile"
      ]
    },
    "reopen_surface": {
      "type": "string",
      "enum": ["settings", "help", "support_export"]
    },
    "source_classification": {
      "type": "string",
      "enum": [
        "vscode_workspace_root",
        "jetbrains_idea_root",
        "unknown_config_root"
      ]
    },
    "descriptors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_classification",
        "source_descriptor",
        "target_descriptor",
        "source_ecosystem_id"
      ],
      "properties": {
        "source_classification": { "$ref": "#/$defs/source_classification" },
        "source_descriptor": { "$ref": "#/$defs/redaction_aware_text" },
        "target_descriptor": { "$ref": "#/$defs/redaction_aware_text" },
        "source_ecosystem_id": { "$ref": "#/$defs/opaque_id" }
      }
    },
    "mapping_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "row_id",
        "domain",
        "classification",
        "source_item_ref",
        "source_label",
        "target_label",
        "before_value_label",
        "after_value_label",
        "rollback_requirement_ref",
        "docs_help_refs",
        "support_export_refs",
        "retained_after_apply"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_migration_wizard_beta_mapping_row_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "row_id": { "$ref": "#/$defs/mapping_row_id" },
        "domain": { "$ref": "#/$defs/import_review_domain" },
        "classification": { "$ref": "#/$defs/import_mapping_classification" },
        "source_item_ref": { "$ref": "#/$defs/source_item_ref" },
        "source_label": { "$ref": "#/$defs/redaction_aware_text" },
        "target_item_ref": {
          "anyOf": [
            { "$ref": "#/$defs/target_item_ref" },
            { "type": "null" }
          ]
        },
        "target_label": { "$ref": "#/$defs/redaction_aware_text" },
        "before_value_label": { "$ref": "#/$defs/redaction_aware_text" },
        "after_value_label": { "$ref": "#/$defs/redaction_aware_text" },
        "rollback_requirement_ref": { "$ref": "#/$defs/opaque_id" },
        "lossy_or_unsupported_note": {
          "anyOf": [
            { "$ref": "#/$defs/redaction_aware_text" },
            { "type": "null" }
          ]
        },
        "docs_help_refs": { "$ref": "#/$defs/non_empty_ref_array" },
        "support_export_refs": { "$ref": "#/$defs/non_empty_ref_array" },
        "retained_after_apply": { "type": "boolean", "const": true }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": ["partial", "shimmed", "unsupported"]
              }
            },
            "required": ["classification"]
          },
          "then": {
            "required": ["lossy_or_unsupported_note"],
            "properties": {
              "lossy_or_unsupported_note": { "$ref": "#/$defs/redaction_aware_text" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": { "const": "unsupported" }
            },
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "target_item_ref": { "type": "null" }
            }
          },
          "else": {
            "required": ["target_item_ref"],
            "properties": {
              "target_item_ref": { "$ref": "#/$defs/target_item_ref" }
            }
          }
        }
      ]
    },
    "unsupported_gap_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "gap_id",
        "domain",
        "classification",
        "source_label",
        "gap_summary",
        "visible_before_apply",
        "retained_after_apply",
        "docs_help_refs",
        "support_export_refs"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_migration_wizard_beta_unsupported_gap_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "gap_id": { "$ref": "#/$defs/mapping_gap_id" },
        "domain": { "$ref": "#/$defs/import_review_domain" },
        "classification": {
          "type": "string",
          "enum": ["shimmed", "unsupported"]
        },
        "source_label": { "$ref": "#/$defs/redaction_aware_text" },
        "gap_summary": { "$ref": "#/$defs/redaction_aware_text" },
        "visible_before_apply": { "type": "boolean", "const": true },
        "retained_after_apply": { "type": "boolean", "const": true },
        "docs_help_refs": { "$ref": "#/$defs/non_empty_ref_array" },
        "support_export_refs": { "$ref": "#/$defs/non_empty_ref_array" }
      }
    },
    "classification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "translated", "partial", "shimmed", "unsupported"],
      "properties": {
        "exact": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "translated": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "partial": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "shimmed": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "unsupported": { "type": "integer", "minimum": 0, "maximum": 4096 }
      }
    },
    "reopen_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "action_ref",
        "migration_report_ref",
        "shortcut_delta_report_ref",
        "label"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/reopen_surface" },
        "action_ref": { "$ref": "#/$defs/opaque_id" },
        "migration_report_ref": { "$ref": "#/$defs/opaque_id" },
        "shortcut_delta_report_ref": { "$ref": "#/$defs/opaque_id" },
        "label": { "$ref": "#/$defs/redaction_aware_text" }
      }
    },
    "shell_migration_wizard_beta_mapping_report_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "schema_version",
        "shared_contract_ref",
        "mapping_report_id",
        "migration_review_ref",
        "descriptors",
        "rows",
        "classification_summary",
        "classifications_present",
        "unsupported_gaps",
        "rollback_requirement_ref",
        "shortcut_delta_report_ref",
        "retained_after_first_run",
        "reopen_links",
        "generated_at"
      ],
      "properties": {
        "record_kind": {
          "type": "string",
          "const": "shell_migration_wizard_beta_mapping_report_record"
        },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "shared_contract_ref": {
          "type": "string",
          "const": "shell:migration_wizard_beta:v2"
        },
        "mapping_report_id": { "type": "string", "maxLength": 200, "pattern": "^mapping-report:[A-Za-z0-9._:-]+$" },
        "migration_review_ref": { "type": "string", "maxLength": 200, "pattern": "^migration-review:[A-Za-z0-9._:-]+$" },
        "descriptors": { "$ref": "#/$defs/descriptors" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/mapping_row" }
        },
        "classification_summary": { "$ref": "#/$defs/classification_summary" },
        "classifications_present": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/import_mapping_classification" }
        },
        "unsupported_gaps": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/unsupported_gap_row" }
        },
        "rollback_requirement_ref": { "type": "string", "maxLength": 200, "pattern": "^rollback-requirement:[A-Za-z0-9._:-]+$" },
        "shortcut_delta_report_ref": { "type": "string", "maxLength": 200, "pattern": "^shortcut_delta_digest:[A-Za-z0-9._:-]+$" },
        "retained_after_first_run": { "type": "boolean", "const": true },
        "reopen_links": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reopen_link" }
        },
        "generated_at": { "$ref": "#/$defs/monotonic_timestamp" }
      }
    }
  }
}
