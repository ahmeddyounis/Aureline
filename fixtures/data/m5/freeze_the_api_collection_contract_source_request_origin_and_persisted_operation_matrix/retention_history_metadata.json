{
  "retention_id": "retention:history_metadata",
  "scope": "history",
  "mode": "metadata_only",
  "default_excludes_bodies": true,
  "default_excludes_headers": true,
  "opt_in_required_for_full_capture": true,
  "offline_mirror_behavior": "mirror_maintained",
  "mirror_maintained": true,
  "rationale": "Request history keeps method, url, status, and timing metadata only; raw bodies and headers are excluded by default."
}
