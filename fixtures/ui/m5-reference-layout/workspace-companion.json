{
  "workspace_kind": "companion",
  "workspace_id": "design-system:reference-layout:companion",
  "display_name": "Companion workspace",
  "lifecycle": {
    "owner_role": "Workspace owner",
    "lifecycle_state": "stable",
    "layout_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "zone_occupancy": [
    {
      "zone": "title_context_bar",
      "slot_id": "slot.title_context_bar.identity",
      "surface_role": "Companion identity and paired session",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Reserve the bar and show the pairing target with an unresolved-session cue."
    },
    {
      "zone": "activity_rail",
      "slot_id": "slot.activity_rail.primary_routes",
      "surface_role": "Top-level route rail",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the rail with a quiet skeleton until routes resolve."
    },
    {
      "zone": "main_workspace",
      "slot_id": "slot.main_workspace.working_set",
      "surface_role": "Mirrored primary-session working set",
      "surface_kind": "first_party",
      "required": true,
      "placeholder_behavior": "Show the not-paired guidance with a pair-device route, never a blank mirror."
    },
    {
      "zone": "right_inspector",
      "slot_id": "slot.right_inspector.contextual_detail",
      "surface_role": "Companion actions and device handoff",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Show an action skeleton until the paired session reports."
    },
    {
      "zone": "transient_overlay",
      "slot_id": "slot.overlay.dialog_or_sheet",
      "surface_role": "Pairing and handoff sheets",
      "surface_kind": "host_chrome",
      "required": false,
      "placeholder_behavior": "Keep the overlay dismissible and reserved for pairing/handoff sheets."
    },
    {
      "zone": "status_bar",
      "slot_id": "status.slot.recovery.primary",
      "surface_role": "Pairing state, sync freshness, and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the strip present and announce pairing/sync transitions."
    }
  ],
  "responsive_collapse": [
    {
      "adaptive_class": "compact_desktop",
      "collapsed_zones": [
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "Companion actions move to an attached sheet; the mirrored working set stays full-width."
    },
    {
      "adaptive_class": "standard_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    },
    {
      "adaptive_class": "expanded_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    }
  ],
  "missing_dependency_rules": [
    {
      "dependency_id": "companion.paired_session",
      "affected_zone": "main_workspace",
      "placeholder_class": "missing_remote",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:companion.placeholder.session",
      "degraded_behavior": "The last mirrored snapshot stays readable; live mirroring resumes when the paired session returns."
    },
    {
      "dependency_id": "companion.handoff_service",
      "affected_zone": "transient_overlay",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:companion.placeholder.handoff",
      "degraded_behavior": "The mirrored view stays visible; device handoff resumes when the service returns."
    }
  ],
  "reopen_routes": [
    {
      "route_id": "reopen_actions",
      "route_kind": "reopen",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:companion.route.reopen_actions",
      "keys": "Ctrl+Alt+A",
      "description": "Reopen the companion actions and device handoff in the right inspector zone."
    },
    {
      "route_id": "reset_layout",
      "route_kind": "reset",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:companion.route.reset_layout",
      "keys": "Ctrl+Alt+0",
      "description": "Reset the workspace to its reference zone layout."
    }
  ],
  "summary_message_id": "design_system_reference_layout.design-system:reference-layout:companion.summary"
}
