          "surface_kind": "first_party",
          "required": false,
          "placeholder_behavior": "Show an outline skeleton; never collapse silently."
        },
        {
          "zone": "main_workspace",
          "slot_id": "slot.main_workspace.working_set",
          "surface_role": "Cell working set (code, markdown, output)",
          "surface_kind": "first_party",
          "required": true,
          "placeholder_behavior": "Show the empty-notebook guidance with an add-cell route, never a blank canvas."
        },
        {
          "zone": "right_inspector",
          "slot_id": "slot.right_inspector.contextual_detail",
          "surface_role": "Variable, output, and kernel inspector",
          "surface_kind": "provider_backed",
          "required": false,
          "placeholder_behavior": "Show an inspector skeleton until the kernel reports."
        },
        {
          "zone": "bottom_panel",
          "slot_id": "slot.bottom_panel.tool_panels",
          "surface_role": "Kernel log and execution output",
          "surface_kind": "provider_backed",
          "required": false,
          "placeholder_behavior": "Reserve the panel and disclose connection progress."
        },
        {
          "zone": "status_bar",
          "slot_id": "status.slot.recovery.primary",
          "surface_role": "Kernel state, run progress, and trust",
          "surface_kind": "host_chrome",
          "required": true,
          "placeholder_behavior": "Keep the strip present and announce kernel/run transitions."
        }
      ],
      "responsive_collapse": [
        {
          "adaptive_class": "compact_desktop",
          "collapsed_zones": [
            "left_sidebar",
            "right_inspector"
          ],
          "placement": "sheet",
          "preserves_zone_identity": true,
          "behavior": "Outline and inspector move to attached sheets; the cell working set stays full-width."
        },
        {
          "adaptive_class": "standard_desktop",
          "collapsed_zones": [
            "right_inspector"
          ],
          "placement": "sheet",
          "preserves_zone_identity": true,
          "behavior": "The inspector moves to an attached sheet; the outline stays docked."
        },
        {
          "adaptive_class": "expanded_desktop",
          "collapsed_zones": [],
          "placement": "docked",
          "preserves_zone_identity": true,
          "behavior": "All zones stay docked."
        }
      ],
