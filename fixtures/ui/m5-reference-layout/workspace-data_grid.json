{
  "workspace_kind": "data_grid",
  "workspace_id": "design-system:reference-layout:data_grid",
  "display_name": "Data-grid workspace",
  "lifecycle": {
    "owner_role": "Workspace owner",
    "lifecycle_state": "stable",
    "layout_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "zone_occupancy": [
    {
      "zone": "title_context_bar",
      "slot_id": "slot.title_context_bar.identity",
      "surface_role": "Result-grid identity, source, and row count",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Reserve the bar and show the source with an unresolved-query cue."
    },
    {
      "zone": "activity_rail",
      "slot_id": "slot.activity_rail.primary_routes",
      "surface_role": "Top-level route rail",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the rail with a quiet skeleton until routes resolve."
    },
    {
      "zone": "left_sidebar",
      "slot_id": "slot.sidebar.section_surface",
      "surface_role": "Saved queries and schema browser",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Show a schema skeleton; never collapse silently."
    },
    {
      "zone": "main_workspace",
      "slot_id": "slot.main_workspace.working_set",
      "surface_role": "Dense, virtualizable result grid",
      "surface_kind": "first_party",
      "required": true,
      "placeholder_behavior": "Show the empty-result guidance with a run-query route, never a blank grid."
    },
    {
      "zone": "right_inspector",
      "slot_id": "slot.right_inspector.contextual_detail",
      "surface_role": "Row detail and cell inspector",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Show an inspector skeleton until a row is selected."
    },
    {
      "zone": "bottom_panel",
      "slot_id": "slot.bottom_panel.tool_panels",
      "surface_role": "Query editor and execution console",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Reserve the panel and keep the last query editable."
    },
    {
      "zone": "status_bar",
      "slot_id": "status.slot.recovery.primary",
      "surface_role": "Query state, row count, and source trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the strip present and announce query/row transitions."
    }
  ],
  "responsive_collapse": [
    {
      "adaptive_class": "compact_desktop",
      "collapsed_zones": [
        "left_sidebar",
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "The schema browser and row detail move to attached sheets; the grid stays full-width."
    },
    {
      "adaptive_class": "standard_desktop",
      "collapsed_zones": [
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "Row detail moves to an attached sheet; the schema browser stays docked."
    },
    {
      "adaptive_class": "expanded_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    }
  ],
  "missing_dependency_rules": [
    {
      "dependency_id": "data_grid.query_provider",
      "affected_zone": "main_workspace",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:data_grid.placeholder.query",
      "degraded_behavior": "The last result set stays readable and exportable; new queries are disabled until the provider reconnects."
    },
    {
      "dependency_id": "data_grid.row_detail_service",
      "affected_zone": "right_inspector",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:data_grid.placeholder.detail",
      "degraded_behavior": "Grid rows stay visible; per-row detail loads when the service returns."
    }
  ],
  "reopen_routes": [
    {
      "route_id": "reopen_query_console",
      "route_kind": "reopen",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:data_grid.route.reopen_query_console",
      "keys": "Ctrl+Alt+Q",
      "description": "Reopen the query editor and execution console in the bottom panel zone."
    },
    {
      "route_id": "reset_layout",
      "route_kind": "reset",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:data_grid.route.reset_layout",
      "keys": "Ctrl+Alt+0",
      "description": "Reset the workspace to its reference zone layout."
    }
  ],
  "summary_message_id": "design_system_reference_layout.design-system:reference-layout:data_grid.summary"
}
