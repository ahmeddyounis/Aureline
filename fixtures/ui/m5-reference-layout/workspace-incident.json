{
  "workspace_kind": "incident",
  "workspace_id": "design-system:reference-layout:incident",
  "display_name": "Incident workspace",
  "lifecycle": {
    "owner_role": "Workspace owner",
    "lifecycle_state": "stable",
    "layout_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "zone_occupancy": [
    {
      "zone": "title_context_bar",
      "slot_id": "slot.title_context_bar.identity",
      "surface_role": "Incident identity, severity, and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Reserve the bar and show the incident with an unresolved-signal cue."
    },
    {
      "zone": "activity_rail",
      "slot_id": "slot.activity_rail.primary_routes",
      "surface_role": "Top-level route rail",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the rail with a quiet skeleton until routes resolve."
    },
    {
      "zone": "left_sidebar",
      "slot_id": "slot.sidebar.section_surface",
      "surface_role": "Incident timeline and linked signals",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Show a timeline skeleton; never collapse silently."
    },
    {
      "zone": "main_workspace",
      "slot_id": "slot.main_workspace.review_surface",
      "surface_role": "Incident timeline and evidence review surface",
      "surface_kind": "first_party",
      "required": true,
      "placeholder_behavior": "Show the no-incident guidance with a recent-incidents route, never a blank surface."
    },
    {
      "zone": "right_inspector",
      "slot_id": "slot.right_inspector.contextual_detail",
      "surface_role": "Signal, owner, and action detail",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Show an inspector skeleton until a signal is selected."
    },
    {
      "zone": "bottom_panel",
      "slot_id": "slot.bottom_panel.tool_panels",
      "surface_role": "Linked logs and live signal stream",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Reserve the panel and disclose stream progress."
    },
    {
      "zone": "status_bar",
      "slot_id": "status.slot.recovery.primary",
      "surface_role": "Incident state, severity, and acknowledgement",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the strip present and announce severity/acknowledgement transitions."
    }
  ],
  "responsive_collapse": [
    {
      "adaptive_class": "compact_desktop",
      "collapsed_zones": [
        "left_sidebar",
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "The timeline list and signal detail move to attached sheets; the review surface stays full-width."
    },
    {
      "adaptive_class": "standard_desktop",
      "collapsed_zones": [
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "Signal detail moves to an attached sheet; the timeline list stays docked."
    },
    {
      "adaptive_class": "expanded_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    }
  ],
  "missing_dependency_rules": [
    {
      "dependency_id": "incident.signal_provider",
      "affected_zone": "bottom_panel",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:incident.placeholder.signals",
      "degraded_behavior": "The recorded timeline stays readable; live signals resume when the provider reconnects."
    },
    {
      "dependency_id": "incident.remote_session",
      "affected_zone": "main_workspace",
      "placeholder_class": "missing_remote",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:incident.placeholder.remote",
      "degraded_behavior": "The recorded incident timeline stays readable; new actions are disabled until the session returns."
    }
  ],
  "reopen_routes": [
    {
      "route_id": "reopen_signal_detail",
      "route_kind": "reopen",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:incident.route.reopen_signal_detail",
      "keys": "Ctrl+Alt+S",
      "description": "Reopen the signal, owner, and action detail in the right inspector zone."
    },
    {
      "route_id": "reset_layout",
      "route_kind": "reset",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:incident.route.reset_layout",
      "keys": "Ctrl+Alt+0",
      "description": "Reset the workspace to its reference zone layout."
    }
  ],
  "summary_message_id": "design_system_reference_layout.design-system:reference-layout:incident.summary"
}
