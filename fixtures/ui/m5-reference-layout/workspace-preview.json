{
  "workspace_kind": "preview",
  "workspace_id": "design-system:reference-layout:preview",
  "display_name": "Preview workspace",
  "lifecycle": {
    "owner_role": "Workspace owner",
    "lifecycle_state": "stable",
    "layout_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "zone_occupancy": [
    {
      "zone": "title_context_bar",
      "slot_id": "slot.title_context_bar.identity",
      "surface_role": "Preview route, target, and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Reserve the bar and show the route with an unresolved-server cue."
    },
    {
      "zone": "activity_rail",
      "slot_id": "slot.activity_rail.primary_routes",
      "surface_role": "Top-level route rail",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the rail with a quiet skeleton until routes resolve."
    },
    {
      "zone": "main_workspace",
      "slot_id": "slot.main_workspace.working_set",
      "surface_role": "Live preview canvas",
      "surface_kind": "first_party",
      "required": true,
      "placeholder_behavior": "Show the no-preview guidance with a start-server route, never a blank canvas."
    },
    {
      "zone": "right_inspector",
      "slot_id": "slot.right_inspector.contextual_detail",
      "surface_role": "Route, device, and trust inspector",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Show an inspector skeleton until the preview connects."
    },
    {
      "zone": "bottom_panel",
      "slot_id": "slot.bottom_panel.tool_panels",
      "surface_role": "Preview console and request log",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Reserve the panel and disclose connection progress."
    },
    {
      "zone": "status_bar",
      "slot_id": "status.slot.recovery.primary",
      "surface_role": "Preview route, reload state, and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the strip present and announce route/reload transitions."
    }
  ],
  "responsive_collapse": [
    {
      "adaptive_class": "compact_desktop",
      "collapsed_zones": [
        "right_inspector",
        "bottom_panel"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "The inspector and console move to attached sheets; the preview canvas stays full-width."
    },
    {
      "adaptive_class": "standard_desktop",
      "collapsed_zones": [
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "The inspector moves to an attached sheet; the console stays docked."
    },
    {
      "adaptive_class": "expanded_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    }
  ],
  "missing_dependency_rules": [
    {
      "dependency_id": "preview.dev_server",
      "affected_zone": "main_workspace",
      "placeholder_class": "missing_remote",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:preview.placeholder.server",
      "degraded_behavior": "The last rendered frame stays visible with a stale badge; live reload resumes when the dev server returns."
    },
    {
      "dependency_id": "preview.route_trust",
      "affected_zone": "right_inspector",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:preview.placeholder.trust",
      "degraded_behavior": "The canvas stays visible; route trust detail resolves when the trust service responds."
    }
  ],
  "reopen_routes": [
    {
      "route_id": "reopen_console",
      "route_kind": "reopen",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:preview.route.reopen_console",
      "keys": "Ctrl+Alt+K",
      "description": "Reopen the preview console and request log in the bottom panel zone."
    },
    {
      "route_id": "reset_layout",
      "route_kind": "reset",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:preview.route.reset_layout",
      "keys": "Ctrl+Alt+0",
      "description": "Reset the workspace to its reference zone layout."
    }
  ],
  "summary_message_id": "design_system_reference_layout.design-system:reference-layout:preview.summary"
}
