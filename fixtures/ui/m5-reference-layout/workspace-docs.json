{
  "workspace_kind": "docs",
  "workspace_id": "design-system:reference-layout:docs",
  "display_name": "Docs workspace",
  "lifecycle": {
    "owner_role": "Workspace owner",
    "lifecycle_state": "stable",
    "layout_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "zone_occupancy": [
    {
      "zone": "title_context_bar",
      "slot_id": "slot.title_context_bar.identity",
      "surface_role": "Docs source identity and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Reserve the bar and show the source with an unresolved-page cue."
    },
    {
      "zone": "activity_rail",
      "slot_id": "slot.activity_rail.primary_routes",
      "surface_role": "Top-level route rail",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the rail with a quiet skeleton until routes resolve."
    },
    {
      "zone": "left_sidebar",
      "slot_id": "slot.sidebar.section_surface",
      "surface_role": "Table of contents and search",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Show a table-of-contents skeleton; never collapse silently."
    },
    {
      "zone": "main_workspace",
      "slot_id": "slot.main_workspace.working_set",
      "surface_role": "Embedded docs/browser reading pane",
      "surface_kind": "first_party",
      "required": true,
      "placeholder_behavior": "Show the no-page guidance with a search route, never a blank pane."
    },
    {
      "zone": "right_inspector",
      "slot_id": "slot.right_inspector.contextual_detail",
      "surface_role": "On-this-page outline and related links",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Show an outline skeleton until the page renders."
    },
    {
      "zone": "status_bar",
      "slot_id": "status.slot.recovery.primary",
      "surface_role": "Reading position, source, and offline state",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the strip present and announce page/offline transitions."
    }
  ],
  "responsive_collapse": [
    {
      "adaptive_class": "compact_desktop",
      "collapsed_zones": [
        "left_sidebar",
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "The table of contents and page outline move to attached sheets; the reading pane stays full-width."
    },
    {
      "adaptive_class": "standard_desktop",
      "collapsed_zones": [
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "The page outline moves to an attached sheet; the table of contents stays docked."
    },
    {
      "adaptive_class": "expanded_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    }
  ],
  "missing_dependency_rules": [
    {
      "dependency_id": "docs.content_provider",
      "affected_zone": "main_workspace",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:docs.placeholder.content",
      "degraded_behavior": "Cached pages stay readable offline; uncached pages load when the content provider returns."
    },
    {
      "dependency_id": "docs.search_index",
      "affected_zone": "left_sidebar",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:docs.placeholder.search",
      "degraded_behavior": "The table of contents stays browsable; full-text search resumes when the index loads."
    }
  ],
  "reopen_routes": [
    {
      "route_id": "reopen_outline",
      "route_kind": "reopen",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:docs.route.reopen_outline",
      "keys": "Ctrl+Alt+O",
      "description": "Reopen the on-this-page outline in the right inspector zone."
    },
    {
      "route_id": "reset_layout",
      "route_kind": "reset",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:docs.route.reset_layout",
      "keys": "Ctrl+Alt+0",
      "description": "Reset the workspace to its reference zone layout."
    }
  ],
  "summary_message_id": "design_system_reference_layout.design-system:reference-layout:docs.summary"
}
