{
  "workspace_kind": "pipeline",
  "workspace_id": "design-system:reference-layout:pipeline",
  "display_name": "Pipeline workspace",
  "lifecycle": {
    "owner_role": "Workspace owner",
    "lifecycle_state": "stable",
    "layout_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "zone_occupancy": [
    {
      "zone": "title_context_bar",
      "slot_id": "slot.title_context_bar.identity",
      "surface_role": "Pipeline identity, run, and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Reserve the bar and show the pipeline with an unresolved-run cue."
    },
    {
      "zone": "activity_rail",
      "slot_id": "slot.activity_rail.primary_routes",
      "surface_role": "Top-level route rail",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the rail with a quiet skeleton until routes resolve."
    },
    {
      "zone": "left_sidebar",
      "slot_id": "slot.sidebar.section_surface",
      "surface_role": "Stage list and run history",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Show a run-history skeleton; never collapse silently."
    },
    {
      "zone": "main_workspace",
      "slot_id": "slot.main_workspace.review_surface",
      "surface_role": "Stage cards and run review surface",
      "surface_kind": "first_party",
      "required": true,
      "placeholder_behavior": "Show the no-run guidance with a trigger-run route, never a blank board."
    },
    {
      "zone": "right_inspector",
      "slot_id": "slot.right_inspector.contextual_detail",
      "surface_role": "Job log and artifact detail",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Show an inspector skeleton until a job is selected."
    },
    {
      "zone": "bottom_panel",
      "slot_id": "slot.bottom_panel.tool_panels",
      "surface_role": "Live run output and step log",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Reserve the panel and disclose stream progress."
    },
    {
      "zone": "status_bar",
      "slot_id": "status.slot.recovery.primary",
      "surface_role": "Run state, stage progress, and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the strip present and announce run/stage transitions."
    }
  ],
  "responsive_collapse": [
    {
      "adaptive_class": "compact_desktop",
      "collapsed_zones": [
        "left_sidebar",
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "Run history and job detail move to attached sheets; the stage board stays full-width."
    },
    {
      "adaptive_class": "standard_desktop",
      "collapsed_zones": [
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "Job detail moves to an attached sheet; run history stays docked."
    },
    {
      "adaptive_class": "expanded_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    }
  ],
  "missing_dependency_rules": [
    {
      "dependency_id": "pipeline.run_provider",
      "affected_zone": "main_workspace",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:pipeline.placeholder.run",
      "degraded_behavior": "The last run's stage cards stay readable; new runs are disabled until the pipeline backend reconnects."
    },
    {
      "dependency_id": "pipeline.log_stream",
      "affected_zone": "bottom_panel",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:pipeline.placeholder.log",
      "degraded_behavior": "Stage cards stay visible; the live log resumes when the stream reconnects."
    }
  ],
  "reopen_routes": [
    {
      "route_id": "reopen_job_detail",
      "route_kind": "reopen",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:pipeline.route.reopen_job_detail",
      "keys": "Ctrl+Alt+J",
      "description": "Reopen the job log and artifact detail in the right inspector zone."
    },
    {
      "route_id": "reset_layout",
      "route_kind": "reset",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:pipeline.route.reset_layout",
      "keys": "Ctrl+Alt+0",
      "description": "Reset the workspace to its reference zone layout."
    }
  ],
  "summary_message_id": "design_system_reference_layout.design-system:reference-layout:pipeline.summary"
}
