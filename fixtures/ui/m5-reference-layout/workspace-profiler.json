{
  "workspace_kind": "profiler",
  "workspace_id": "design-system:reference-layout:profiler",
  "display_name": "Profiler workspace",
  "lifecycle": {
    "owner_role": "Workspace owner",
    "lifecycle_state": "stable",
    "layout_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "zone_occupancy": [
    {
      "zone": "title_context_bar",
      "slot_id": "slot.title_context_bar.identity",
      "surface_role": "Profiler capture identity and target",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Reserve the bar and show the target with an unresolved-capture cue."
    },
    {
      "zone": "activity_rail",
      "slot_id": "slot.activity_rail.primary_routes",
      "surface_role": "Top-level route rail",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the rail with a quiet skeleton until routes resolve."
    },
    {
      "zone": "left_sidebar",
      "slot_id": "slot.sidebar.section_surface",
      "surface_role": "Capture list and call-tree navigator",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Show a capture-list skeleton; never collapse silently."
    },
    {
      "zone": "main_workspace",
      "slot_id": "slot.main_workspace.working_set",
      "surface_role": "Flame and capture working set",
      "surface_kind": "first_party",
      "required": true,
      "placeholder_behavior": "Show the empty-capture guidance with a start-capture route, never a blank flame."
    },
    {
      "zone": "right_inspector",
      "slot_id": "slot.right_inspector.contextual_detail",
      "surface_role": "Frame and allocation detail",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Show an inspector skeleton until a frame is selected."
    },
    {
      "zone": "bottom_panel",
      "slot_id": "slot.bottom_panel.tool_panels",
      "surface_role": "Capture log and sampling output",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Reserve the panel and disclose sampling progress."
    },
    {
      "zone": "status_bar",
      "slot_id": "status.slot.recovery.primary",
      "surface_role": "Capture state and sampling progress",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the strip present and announce capture/sampling transitions."
    }
  ],
  "responsive_collapse": [
    {
      "adaptive_class": "compact_desktop",
      "collapsed_zones": [
        "left_sidebar",
        "right_inspector",
        "bottom_panel"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "The capture list, frame detail, and sampling log move to attached sheets; the flame surface stays full-width."
    },
    {
      "adaptive_class": "standard_desktop",
      "collapsed_zones": [
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "Frame detail moves to an attached sheet; the capture list and log stay docked."
    },
    {
      "adaptive_class": "expanded_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    }
  ],
  "missing_dependency_rules": [
    {
      "dependency_id": "profiler.capture_provider",
      "affected_zone": "main_workspace",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:profiler.placeholder.capture",
      "degraded_behavior": "Saved captures stay viewable; new captures are disabled until the profiler backend reconnects."
    },
    {
      "dependency_id": "profiler.symbol_service",
      "affected_zone": "right_inspector",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:profiler.placeholder.symbols",
      "degraded_behavior": "Frames stay visible with raw addresses; symbol names resolve when the service returns."
    }
  ],
  "reopen_routes": [
    {
      "route_id": "reopen_inspector",
      "route_kind": "reopen",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:profiler.route.reopen_inspector",
      "keys": "Ctrl+Alt+I",
      "description": "Reopen the frame and allocation inspector in the right inspector zone."
    },
    {
      "route_id": "reset_layout",
      "route_kind": "reset",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:profiler.route.reset_layout",
      "keys": "Ctrl+Alt+0",
      "description": "Reset the workspace to its reference zone layout."
    }
  ],
  "summary_message_id": "design_system_reference_layout.design-system:reference-layout:profiler.summary"
}
