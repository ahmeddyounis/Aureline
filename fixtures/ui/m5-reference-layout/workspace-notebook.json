{
  "workspace_kind": "notebook",
  "workspace_id": "design-system:reference-layout:notebook",
  "display_name": "Notebook workspace",
  "lifecycle": {
    "owner_role": "Workspace owner",
    "lifecycle_state": "stable",
    "layout_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "zone_occupancy": [
    {
      "zone": "title_context_bar",
      "slot_id": "slot.title_context_bar.identity",
      "surface_role": "Notebook identity, kernel target, and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Reserve the bar and show the notebook name with an unresolved-kernel cue."
    },
    {
      "zone": "activity_rail",
      "slot_id": "slot.activity_rail.primary_routes",
      "surface_role": "Top-level route rail",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the rail with a quiet skeleton until routes resolve."
    },
    {
      "zone": "left_sidebar",
      "slot_id": "slot.sidebar.section_surface",
      "surface_role": "Notebook outline and cell navigator",
      "surface_kind": "first_party",
      "required": false,
      "placeholder_behavior": "Show an outline skeleton; never collapse silently."
    },
    {
      "zone": "main_workspace",
      "slot_id": "slot.main_workspace.working_set",
      "surface_role": "Cell working set (code, markdown, output)",
      "surface_kind": "first_party",
      "required": true,
      "placeholder_behavior": "Show the empty-notebook guidance with an add-cell route, never a blank canvas."
    },
    {
      "zone": "right_inspector",
      "slot_id": "slot.right_inspector.contextual_detail",
      "surface_role": "Variable, output, and kernel inspector",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Show an inspector skeleton until the kernel reports."
    },
    {
      "zone": "bottom_panel",
      "slot_id": "slot.bottom_panel.tool_panels",
      "surface_role": "Kernel log and execution output",
      "surface_kind": "provider_backed",
      "required": false,
      "placeholder_behavior": "Reserve the panel and disclose connection progress."
    },
    {
      "zone": "status_bar",
      "slot_id": "status.slot.recovery.primary",
      "surface_role": "Kernel state, run progress, and trust",
      "surface_kind": "host_chrome",
      "required": true,
      "placeholder_behavior": "Keep the strip present and announce kernel/run transitions."
    }
  ],
  "responsive_collapse": [
    {
      "adaptive_class": "compact_desktop",
      "collapsed_zones": [
        "left_sidebar",
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "Outline and inspector move to attached sheets; the cell working set stays full-width."
    },
    {
      "adaptive_class": "standard_desktop",
      "collapsed_zones": [
        "right_inspector"
      ],
      "placement": "sheet",
      "preserves_zone_identity": true,
      "behavior": "The inspector moves to an attached sheet; the outline stays docked."
    },
    {
      "adaptive_class": "expanded_desktop",
      "collapsed_zones": [],
      "placement": "docked",
      "preserves_zone_identity": true,
      "behavior": "All zones stay docked."
    }
  ],
  "missing_dependency_rules": [
    {
      "dependency_id": "notebook.kernel_runtime",
      "affected_zone": "bottom_panel",
      "placeholder_class": "missing_provider",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:notebook.placeholder.kernel",
      "degraded_behavior": "Cells stay editable and the last run's outputs stay visible; execution resumes when a kernel reconnects."
    },
    {
      "dependency_id": "notebook.remote_session",
      "affected_zone": "main_workspace",
      "placeholder_class": "missing_remote",
      "placeholder_message_id": "design_system_reference_layout.design-system:reference-layout:notebook.placeholder.remote",
      "degraded_behavior": "Stored cells and outputs stay readable read-only; execution is disabled until the session returns."
    }
  ],
  "reopen_routes": [
    {
      "route_id": "reopen_inspector",
      "route_kind": "reopen",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:notebook.route.reopen_inspector",
      "keys": "Ctrl+Alt+I",
      "description": "Reopen the variable and output inspector in the right inspector zone."
    },
    {
      "route_id": "reset_layout",
      "route_kind": "reset",
      "command_message_id": "design_system_reference_layout.design-system:reference-layout:notebook.route.reset_layout",
      "keys": "Ctrl+Alt+0",
      "description": "Reset the workspace to its reference zone layout."
    }
  ],
  "summary_message_id": "design_system_reference_layout.design-system:reference-layout:notebook.summary"
}
