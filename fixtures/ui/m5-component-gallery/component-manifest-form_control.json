{
  "component_kind": "form_control",
  "component_id": "design-system:component:form_control",
  "display_name": "Form control",
  "lifecycle": {
    "owner_role": "Component owner",
    "lifecycle_state": "stable",
    "manifest_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "anatomy": [
    {
      "part_id": "root",
      "role": "field container",
      "required": true
    },
    {
      "part_id": "label",
      "role": "field label",
      "required": true
    },
    {
      "part_id": "input",
      "role": "control",
      "required": true
    },
    {
      "part_id": "hint",
      "role": "supporting text",
      "required": false
    },
    {
      "part_id": "error_text",
      "role": "validation message",
      "required": false
    }
  ],
  "states": {
    "mandatory": [
      "empty",
      "error",
      "completed"
    ],
    "optional": [
      "loading",
      "pending",
      "degraded",
      "blocked"
    ]
  },
  "labels": [
    {
      "label_id": "label",
      "message_id": "design_system_component.design-system:component:form_control.label.label",
      "purpose": "Names the field"
    },
    {
      "label_id": "hint",
      "message_id": "design_system_component.design-system:component:form_control.label.hint",
      "purpose": "Explains the expected input"
    },
    {
      "label_id": "error_text",
      "message_id": "design_system_component.design-system:component:form_control.label.error_text",
      "purpose": "States how to correct an invalid value"
    }
  ],
  "commands": [
    {
      "command_id": "submit",
      "label_message_id": "design_system_component.design-system:component:form_control.command.submit",
      "keys": "Enter"
    },
    {
      "command_id": "reset",
      "label_message_id": "design_system_component.design-system:component:form_control.command.reset",
      "keys": "Ctrl+Z"
    }
  ],
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Move focus to the input, then onward out of the field."
    },
    {
      "keys": "Enter",
      "action": "Submit the field's owning form when valid."
    },
    {
      "keys": "Ctrl+Z",
      "action": "Reset the field to its last committed value."
    }
  ],
  "accessibility": {
    "role": "group",
    "screen_reader_label_rule": "The input is programmatically labelled by the field label, described by the hint, and linked to the error text when invalid.",
    "focus_order_rule": "Focus reaches the label-associated input directly; the hint and error text are announced as descriptions, not separate stops.",
    "notes": [
      "An invalid field marks the input invalid and links the error text as its description.",
      "The error state names how to fix the value, never just that it is wrong."
    ]
  },
  "token_dependencies": [
    "color.surface.raised",
    "color.text.primary",
    "color.text.secondary",
    "typography.body",
    "space.2",
    "space.4"
  ],
  "extension_guidance": {
    "guidance_ref": "docs/sdk/extension-ui-component-contracts.md",
    "consumption_rules": [
      "Render the empty, error, and completed states; they are mandatory for a form control.",
      "Associate the label, hint, and error text programmatically with the input.",
      "Name the correction in the error state; do not report only that the value is invalid."
    ]
  },
  "summary_message_id": "design_system_component.design-system:component:form_control.summary"
}
