{
  "component_kind": "review_sheet",
  "component_id": "design-system:component:review_sheet",
  "display_name": "Review sheet",
  "lifecycle": {
    "owner_role": "Component owner",
    "lifecycle_state": "preview",
    "manifest_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "anatomy": [
    {
      "part_id": "root",
      "role": "dialog container",
      "required": true
    },
    {
      "part_id": "header",
      "role": "heading",
      "required": true
    },
    {
      "part_id": "summary",
      "role": "decision summary",
      "required": true
    },
    {
      "part_id": "body",
      "role": "scrollable detail",
      "required": true
    },
    {
      "part_id": "action_bar",
      "role": "control group",
      "required": true
    }
  ],
  "states": {
    "mandatory": [
      "pending",
      "blocked",
      "completed"
    ],
    "optional": [
      "empty",
      "loading",
      "degraded",
      "error"
    ]
  },
  "labels": [
    {
      "label_id": "header",
      "message_id": "design_system_component.design-system:component:review_sheet.label.header",
      "purpose": "Names the decision under review"
    },
    {
      "label_id": "summary",
      "message_id": "design_system_component.design-system:component:review_sheet.label.summary",
      "purpose": "Summarizes what will change on approval"
    },
    {
      "label_id": "approve",
      "message_id": "design_system_component.design-system:component:review_sheet.label.approve",
      "purpose": "Names the approve action"
    },
    {
      "label_id": "reject",
      "message_id": "design_system_component.design-system:component:review_sheet.label.reject",
      "purpose": "Names the reject action"
    }
  ],
  "commands": [
    {
      "command_id": "approve",
      "label_message_id": "design_system_component.design-system:component:review_sheet.command.approve",
      "keys": "Ctrl+Enter"
    },
    {
      "command_id": "reject",
      "label_message_id": "design_system_component.design-system:component:review_sheet.command.reject",
      "keys": "Ctrl+Backspace"
    },
    {
      "command_id": "dismiss",
      "label_message_id": "design_system_component.design-system:component:review_sheet.command.dismiss",
      "keys": "Escape"
    }
  ],
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Cycle focus within the sheet; focus is trapped while open."
    },
    {
      "keys": "Ctrl+Enter",
      "action": "Approve the staged decision."
    },
    {
      "keys": "Ctrl+Backspace",
      "action": "Reject the staged decision."
    },
    {
      "keys": "Escape",
      "action": "Dismiss without deciding and return focus to the invoker."
    }
  ],
  "accessibility": {
    "role": "dialog",
    "screen_reader_label_rule": "Announces the header and summary on open; the action bar names the consequence of each control.",
    "focus_order_rule": "Focus moves to the summary on open, is trapped within the sheet, and returns to the invoker on close.",
    "notes": [
      "The sheet is modal; background content is inert while it is open.",
      "Approve and reject are distinct commands and never share a single ambiguous control.",
      "The blocked state explains why the decision cannot be made and offers no approve action."
    ]
  },
  "token_dependencies": [
    "color.surface.shell",
    "color.surface.raised",
    "color.text.primary",
    "color.text.secondary",
    "typography.heading",
    "typography.body",
    "space.4",
    "space.6"
  ],
  "extension_guidance": {
    "guidance_ref": "docs/sdk/extension-ui-component-contracts.md",
    "consumption_rules": [
      "Stage decisions in the pending state and record the outcome in the completed state; both are mandatory.",
      "Keep approve and reject as separate commands; do not collapse them into one toggle.",
      "Trap focus while the sheet is open and restore it to the invoker on close."
    ]
  },
  "summary_message_id": "design_system_component.design-system:component:review_sheet.summary"
}
