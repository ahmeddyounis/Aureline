{
  "component_kind": "job_row",
  "component_id": "design-system:component:job_row",
  "display_name": "Job row",
  "lifecycle": {
    "owner_role": "Component owner",
    "lifecycle_state": "stable",
    "manifest_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "anatomy": [
    {
      "part_id": "root",
      "role": "row container",
      "required": true
    },
    {
      "part_id": "status_icon",
      "role": "state indicator",
      "required": true
    },
    {
      "part_id": "title",
      "role": "primary label",
      "required": true
    },
    {
      "part_id": "meta",
      "role": "secondary label",
      "required": true
    },
    {
      "part_id": "progress",
      "role": "progress indicator",
      "required": false
    },
    {
      "part_id": "row_action",
      "role": "control",
      "required": false
    }
  ],
  "states": {
    "mandatory": [
      "pending",
      "error",
      "completed"
    ],
    "optional": [
      "empty",
      "loading",
      "degraded",
      "blocked"
    ]
  },
  "labels": [
    {
      "label_id": "title",
      "message_id": "design_system_component.design-system:component:job_row.label.title",
      "purpose": "Names the job"
    },
    {
      "label_id": "meta",
      "message_id": "design_system_component.design-system:component:job_row.label.meta",
      "purpose": "Names the job's source, time, or owner"
    },
    {
      "label_id": "status",
      "message_id": "design_system_component.design-system:component:job_row.label.status",
      "purpose": "Names the current job state"
    }
  ],
  "commands": [
    {
      "command_id": "open",
      "label_message_id": "design_system_component.design-system:component:job_row.command.open",
      "keys": "Enter"
    },
    {
      "command_id": "cancel",
      "label_message_id": "design_system_component.design-system:component:job_row.command.cancel",
      "keys": "Ctrl+."
    },
    {
      "command_id": "retry",
      "label_message_id": "design_system_component.design-system:component:job_row.command.retry",
      "keys": "Ctrl+R"
    }
  ],
  "keyboard": [
    {
      "keys": "Up / Down",
      "action": "Move row selection within the collection."
    },
    {
      "keys": "Enter",
      "action": "Open the job's detail surface."
    },
    {
      "keys": "Ctrl+.",
      "action": "Cancel a running job."
    },
    {
      "keys": "Ctrl+R",
      "action": "Retry a failed job."
    }
  ],
  "accessibility": {
    "role": "row",
    "screen_reader_label_rule": "Announces the title, then the state, then the meta; progress is announced as a percentage when present.",
    "focus_order_rule": "The row is one focus stop; row actions are reached via the roving collection model, not separate tab stops.",
    "notes": [
      "The status icon's meaning is also present in text for assistive tech.",
      "Progress updates are throttled so they do not flood the announcement channel."
    ]
  },
  "token_dependencies": [
    "color.surface.shell",
    "color.text.primary",
    "color.text.secondary",
    "color.state.success",
    "icon.size.sm",
    "typography.body",
    "space.2"
  ],
  "extension_guidance": {
    "guidance_ref": "docs/sdk/extension-ui-component-contracts.md",
    "consumption_rules": [
      "Render the pending, error, and completed states; they are mandatory for a job row.",
      "Expose row actions through the collection's roving model, not as independent tab stops.",
      "Throttle progress announcements so dense lists do not flood assistive tech."
    ]
  },
  "summary_message_id": "design_system_component.design-system:component:job_row.summary"
}
