{
  "component_kind": "dense_collection",
  "component_id": "design-system:component:dense_collection",
  "display_name": "Dense collection",
  "lifecycle": {
    "owner_role": "Component owner",
    "lifecycle_state": "experimental",
    "manifest_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "anatomy": [
    {
      "part_id": "root",
      "role": "collection container",
      "required": true
    },
    {
      "part_id": "viewport",
      "role": "virtualized scroll region",
      "required": true
    },
    {
      "part_id": "item",
      "role": "collection item",
      "required": true
    },
    {
      "part_id": "header",
      "role": "column or section header",
      "required": false
    },
    {
      "part_id": "empty_slot",
      "role": "empty-state surface",
      "required": false
    }
  ],
  "states": {
    "mandatory": [
      "empty",
      "loading",
      "completed"
    ],
    "optional": [
      "pending",
      "degraded",
      "blocked",
      "error"
    ]
  },
  "labels": [
    {
      "label_id": "collection",
      "message_id": "design_system_component.design-system:component:dense_collection.label.collection",
      "purpose": "Names the collection and its item count"
    },
    {
      "label_id": "item",
      "message_id": "design_system_component.design-system:component:dense_collection.label.item",
      "purpose": "Names an individual item"
    },
    {
      "label_id": "empty_slot",
      "message_id": "design_system_component.design-system:component:dense_collection.label.empty_slot",
      "purpose": "Explains why the collection is empty"
    }
  ],
  "commands": [
    {
      "command_id": "activate",
      "label_message_id": "design_system_component.design-system:component:dense_collection.command.activate",
      "keys": "Enter"
    },
    {
      "command_id": "select",
      "label_message_id": "design_system_component.design-system:component:dense_collection.command.select",
      "keys": "Space"
    },
    {
      "command_id": "expand",
      "label_message_id": "design_system_component.design-system:component:dense_collection.command.expand",
      "keys": "Right"
    },
    {
      "command_id": "collapse",
      "label_message_id": "design_system_component.design-system:component:dense_collection.command.collapse",
      "keys": "Left"
    }
  ],
  "keyboard": [
    {
      "keys": "Up / Down",
      "action": "Move the focused item within the collection."
    },
    {
      "keys": "Home / End",
      "action": "Jump to the first or last item."
    },
    {
      "keys": "Enter",
      "action": "Activate the focused item."
    },
    {
      "keys": "Space",
      "action": "Toggle selection of the focused item."
    },
    {
      "keys": "Right / Left",
      "action": "Expand or collapse a tree item."
    }
  ],
  "accessibility": {
    "role": "grid",
    "screen_reader_label_rule": "Announces the collection name and total count; each item announces its position and selection state.",
    "focus_order_rule": "The collection is a single tab stop with a roving focus model; arrow keys move within it without leaving the page tab order.",
    "notes": [
      "Virtualized items expose their true position and total count so assistive tech is not misled by the rendered window.",
      "The empty state remains keyboard-reachable and names why the collection is empty."
    ]
  },
  "token_dependencies": [
    "color.surface.shell",
    "color.text.primary",
    "color.text.secondary",
    "typography.body",
    "typography.code",
    "space.2"
  ],
  "extension_guidance": {
    "guidance_ref": "docs/sdk/extension-ui-component-contracts.md",
    "consumption_rules": [
      "Render the empty, loading, and completed states; they are mandatory for a dense collection.",
      "Use a single roving tab stop with arrow-key navigation rather than one tab stop per item.",
      "Expose true item position and total count even when the collection is virtualized."
    ]
  },
  "summary_message_id": "design_system_component.design-system:component:dense_collection.summary"
}
