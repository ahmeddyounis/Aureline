{
  "component_kind": "placeholder_card",
  "component_id": "design-system:component:placeholder_card",
  "display_name": "Placeholder card",
  "lifecycle": {
    "owner_role": "Component owner",
    "lifecycle_state": "stable",
    "manifest_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "anatomy": [
    {
      "part_id": "root",
      "role": "container",
      "required": true
    },
    {
      "part_id": "title",
      "role": "heading",
      "required": true
    },
    {
      "part_id": "description",
      "role": "supporting text",
      "required": true
    },
    {
      "part_id": "illustration",
      "role": "decorative graphic",
      "required": false
    },
    {
      "part_id": "primary_action",
      "role": "control",
      "required": false
    }
  ],
  "states": {
    "mandatory": [
      "empty",
      "loading"
    ],
    "optional": [
      "pending",
      "degraded",
      "blocked",
      "error",
      "completed"
    ]
  },
  "labels": [
    {
      "label_id": "title",
      "message_id": "design_system_component.design-system:component:placeholder_card.label.title",
      "purpose": "Names what is absent and why the surface is ready"
    },
    {
      "label_id": "description",
      "message_id": "design_system_component.design-system:component:placeholder_card.label.description",
      "purpose": "Explains the next useful route the user can take"
    },
    {
      "label_id": "primary_action",
      "message_id": "design_system_component.design-system:component:placeholder_card.label.primary_action",
      "purpose": "Names the recommended first action"
    }
  ],
  "commands": [
    {
      "command_id": "invoke_primary",
      "label_message_id": "design_system_component.design-system:component:placeholder_card.command.invoke_primary",
      "keys": "Enter"
    },
    {
      "command_id": "dismiss",
      "label_message_id": "design_system_component.design-system:component:placeholder_card.command.dismiss",
      "keys": "Escape"
    }
  ],
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Move focus to the next interactive part."
    },
    {
      "keys": "Enter",
      "action": "Invoke the primary action when one is offered."
    },
    {
      "keys": "Escape",
      "action": "Dismiss the card and return focus to the invoker."
    }
  ],
  "accessibility": {
    "role": "group",
    "screen_reader_label_rule": "Announces the title, then the description, then the primary action when present.",
    "focus_order_rule": "The illustration is decorative and skipped; focus reaches the primary action last.",
    "notes": [
      "The illustration carries no semantic meaning and is hidden from assistive tech.",
      "An empty placeholder still exposes a reachable next action."
    ]
  },
  "token_dependencies": [
    "color.surface.raised",
    "color.text.primary",
    "color.text.secondary",
    "typography.heading",
    "typography.body",
    "space.4"
  ],
  "extension_guidance": {
    "guidance_ref": "docs/sdk/extension-ui-component-contracts.md",
    "consumption_rules": [
      "Reuse the published title / description / primary-action label slots; do not invent parallel ones.",
      "Render the empty and loading states; both are mandatory for this component.",
      "Resolve surfaces from the named foundation token references rather than literal values."
    ]
  },
  "summary_message_id": "design_system_component.design-system:component:placeholder_card.summary"
}
