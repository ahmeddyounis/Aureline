{
  "component_kind": "state_block",
  "component_id": "design-system:component:state_block",
  "display_name": "State block",
  "lifecycle": {
    "owner_role": "Component owner",
    "lifecycle_state": "stable",
    "manifest_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "anatomy": [
    {
      "part_id": "root",
      "role": "container",
      "required": true
    },
    {
      "part_id": "status_icon",
      "role": "state indicator",
      "required": true
    },
    {
      "part_id": "title",
      "role": "heading",
      "required": true
    },
    {
      "part_id": "detail",
      "role": "supporting text",
      "required": true
    },
    {
      "part_id": "recovery_action",
      "role": "control",
      "required": false
    }
  ],
  "states": {
    "mandatory": [
      "pending",
      "degraded",
      "blocked",
      "error",
      "completed"
    ],
    "optional": [
      "empty",
      "loading"
    ]
  },
  "labels": [
    {
      "label_id": "title",
      "message_id": "design_system_component.design-system:component:state_block.label.title",
      "purpose": "Names the current controlled state"
    },
    {
      "label_id": "detail",
      "message_id": "design_system_component.design-system:component:state_block.label.detail",
      "purpose": "Explains what still works or what is required"
    },
    {
      "label_id": "recovery_action",
      "message_id": "design_system_component.design-system:component:state_block.label.recovery_action",
      "purpose": "Names the retry, repair, or unblock action"
    }
  ],
  "commands": [
    {
      "command_id": "recover",
      "label_message_id": "design_system_component.design-system:component:state_block.command.recover",
      "keys": "Enter"
    },
    {
      "command_id": "show_diagnostics",
      "label_message_id": "design_system_component.design-system:component:state_block.command.show_diagnostics",
      "keys": "Ctrl+D"
    }
  ],
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Move focus to the recovery action when present."
    },
    {
      "keys": "Enter",
      "action": "Invoke the recovery action."
    },
    {
      "keys": "Ctrl+D",
      "action": "Open diagnostics for the failing or degraded state."
    }
  ],
  "accessibility": {
    "role": "status",
    "screen_reader_label_rule": "Announces the state, then the title, then the detail; error and blocked states use an assertive live region.",
    "focus_order_rule": "Focus reaches the recovery action after the detail text is announced.",
    "notes": [
      "Blocked states never present a spinner; they name the policy, trust, or capability that blocks them.",
      "The status icon's meaning is mirrored in text, never carried by color alone."
    ]
  },
  "token_dependencies": [
    "color.surface.raised",
    "color.text.primary",
    "color.text.secondary",
    "color.state.success",
    "icon.size.md",
    "typography.heading",
    "typography.body",
    "space.4"
  ],
  "extension_guidance": {
    "guidance_ref": "docs/sdk/extension-ui-component-contracts.md",
    "consumption_rules": [
      "Map every controlled state your surface can enter onto this block; the pending, degraded, blocked, error, and completed states are mandatory.",
      "Never render a spinner in the blocked state; name what blocks the action instead.",
      "Mirror the status icon in the title text so meaning is not carried by color alone."
    ]
  },
  "summary_message_id": "design_system_component.design-system:component:state_block.summary"
}
