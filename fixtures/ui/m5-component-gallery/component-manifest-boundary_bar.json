{
  "component_kind": "boundary_bar",
  "component_id": "design-system:component:boundary_bar",
  "display_name": "Boundary bar",
  "lifecycle": {
    "owner_role": "Component owner",
    "lifecycle_state": "preview",
    "manifest_version": 1,
    "introduced_in_package_version": "1.0.0"
  },
  "anatomy": [
    {
      "part_id": "root",
      "role": "banner container",
      "required": true
    },
    {
      "part_id": "boundary_icon",
      "role": "trust indicator",
      "required": true
    },
    {
      "part_id": "route_label",
      "role": "origin label",
      "required": true
    },
    {
      "part_id": "capability_summary",
      "role": "capability label",
      "required": true
    },
    {
      "part_id": "manage_action",
      "role": "control",
      "required": false
    }
  ],
  "states": {
    "mandatory": [
      "degraded",
      "blocked"
    ],
    "optional": [
      "empty",
      "loading",
      "pending",
      "error",
      "completed"
    ]
  },
  "labels": [
    {
      "label_id": "route_label",
      "message_id": "design_system_component.design-system:component:boundary_bar.label.route_label",
      "purpose": "Names the route or origin of the embedded surface"
    },
    {
      "label_id": "capability_summary",
      "message_id": "design_system_component.design-system:component:boundary_bar.label.capability_summary",
      "purpose": "Names which capabilities are available across the boundary"
    },
    {
      "label_id": "manage_action",
      "message_id": "design_system_component.design-system:component:boundary_bar.label.manage_action",
      "purpose": "Names the action that manages the boundary"
    }
  ],
  "commands": [
    {
      "command_id": "manage",
      "label_message_id": "design_system_component.design-system:component:boundary_bar.command.manage",
      "keys": "Enter"
    },
    {
      "command_id": "learn_more",
      "label_message_id": "design_system_component.design-system:component:boundary_bar.command.learn_more",
      "keys": "Ctrl+I"
    }
  ],
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Move focus to the manage action when present."
    },
    {
      "keys": "Enter",
      "action": "Open the boundary management surface."
    },
    {
      "keys": "Ctrl+I",
      "action": "Explain what the boundary restricts and why."
    }
  ],
  "accessibility": {
    "role": "region",
    "screen_reader_label_rule": "Announces the route, then the capability summary, then any degraded or blocked reason.",
    "focus_order_rule": "The bar precedes the surface it guards in focus order; the manage action is its last stop.",
    "notes": [
      "The trust indicator never relies on color alone to convey the boundary state.",
      "A blocked boundary names the policy or capability gap rather than failing silently."
    ]
  },
  "token_dependencies": [
    "color.surface.shell",
    "color.text.primary",
    "color.text.secondary",
    "icon.metaphor.lock",
    "icon.size.sm",
    "typography.body",
    "space.2"
  ],
  "extension_guidance": {
    "guidance_ref": "docs/sdk/extension-ui-component-contracts.md",
    "consumption_rules": [
      "Render the degraded and blocked states; they are mandatory for a boundary bar.",
      "Name the route and capability gap in text; never convey trust state by color alone.",
      "Place the bar before the surface it guards in both visual and focus order."
    ]
  },
  "summary_message_id": "design_system_component.design-system:component:boundary_bar.summary"
}
