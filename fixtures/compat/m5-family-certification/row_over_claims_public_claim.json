        "lts",
        "stable"
      ],
      "default_action": "narrow_row",
      "blocks_promotion": false,
      "rationale": "The qualification row or claim publication narrowed below the cutline; the certification inherits it and is gated upstream."
    },
    {
      "rule_id": "m5_family_certification_rule:qualification_stale",
      "title": "Qualification evidence stale",
      "trigger_reason": "qualification_stale",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "refresh_evidence",
      "blocks_promotion": true,
      "rationale": "A qualification dimension's evidence went stale; the certification must narrow until it refreshes."
    },
    {
      "rule_id": "m5_family_certification_rule:retest_pending",
      "title": "Retest pending",
      "trigger_reason": "retest_pending",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "schedule_retest",
      "blocks_promotion": true,
      "rationale": "A dimension or boundary requires a retest; the certification must narrow until it completes."
    },
    {
      "rule_id": "m5_family_certification_rule:skew_window_exceeded",
      "title": "Skew window exceeded",
      "trigger_reason": "skew_window_exceeded",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "narrow_row",
      "blocks_promotion": true,
      "rationale": "A peer is outside the supported skew window; the certification must narrow."
    },
    {
      "rule_id": "m5_family_certification_rule:deprecation_scheduled",
      "title": "Deprecation scheduled",
      "trigger_reason": "deprecation_scheduled",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "narrow_row",
      "blocks_promotion": true,
      "rationale": "The family is deprecated with a scheduled removal; the certification must narrow."
    },
    {
      "rule_id": "m5_family_certification_rule:diff_report_missing",
      "title": "Diff report missing",
      "trigger_reason": "diff_report_missing",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "publish_diff_report",
      "blocks_promotion": true,
      "rationale": "A stable-facing contract changed without a diff/deprecation packet; the certification must narrow until one is published."
    },
    {
      "rule_id": "m5_family_certification_rule:claim_parity_broken",
      "title": "Claim parity broken",
      "trigger_reason": "claim_parity_broken",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "align_claim_parity",
      "blocks_promotion": true,
      "rationale": "The certified claim disagrees with the public claim's label or support class; the certification holds until parity is restored."
    },
    {
      "rule_id": "m5_family_certification_rule:evidence_stale",
      "title": "Certification evidence stale",
      "trigger_reason": "evidence_stale",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "refresh_evidence",
      "blocks_promotion": true,
      "rationale": "The certification proof packet or a backing pillar breached its freshness SLO; a still-stable claim holds promotion."
    },
    {
      "rule_id": "m5_family_certification_rule:evidence_missing",
      "title": "Certification evidence missing",
      "trigger_reason": "evidence_missing",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "refresh_evidence",
      "blocks_promotion": true,
      "rationale": "No certification proof packet or backing pillar was captured; a still-stable claim holds promotion."
    },
    {
      "rule_id": "m5_family_certification_rule:owner_signoff_missing",
      "title": "Owner sign-off missing",
      "trigger_reason": "owner_signoff_missing",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "request_owner_signoff",
      "blocks_promotion": true,
      "rationale": "Required owner sign-off is missing; a still-stable claim holds promotion."
    },
    {
      "rule_id": "m5_family_certification_rule:validity_window_expired",
      "title": "Validity window expired",
      "trigger_reason": "validity_window_expired",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "renew_validity_window",
      "blocks_promotion": true,
      "rationale": "The certification validity window expired; the certification must renew it before publishing."
    },
    {
      "rule_id": "m5_family_certification_rule:claim_publication_missing",
      "title": "Claim publication missing",
      "trigger_reason": "claim_publication_missing",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "hold_certification",
      "blocks_promotion": true,
      "rationale": "The backing public claim publication is missing; the certification holds promotion."
    }
