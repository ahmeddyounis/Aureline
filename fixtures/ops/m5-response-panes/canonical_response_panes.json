  "invariants": [
    {
      "invariant_id": "response_panes.surface_binding",
      "statement": "Every strip, pane, and continuity view binds a surface family that exists in the operator-surface matrix, by the matrix's own surface id, rather than cloning a per-surface model.",
      "holds": true
    },
    {
      "invariant_id": "response_panes.canonical_object_identity",
      "statement": "Every strip, pane, step, and continuity view carries a canonical aureline:// object handle and routes open-detail to that exact handle.",
      "holds": true
    },
    {
      "invariant_id": "response_panes.service_owner_oncall_visible",
      "statement": "Every service strip names a primary owner, an active on-call lane, a decision right, and an escalation action, so service ownership and on-call authority are never hidden in side docs.",
      "holds": true
    },
    {
      "invariant_id": "response_panes.authority_source_visible",
      "statement": "Every service strip declares whether its state is authoritative or advisory.",
      "holds": true
    },
    {
      "invariant_id": "response_panes.no_silent_green",
      "statement": "Every strip and continuity view's effective state equals the computed no-silent-green state, so a stale strip or view is never reported clear.",
      "holds": true
    },
    {
      "invariant_id": "response_panes.local_continuity_explicit",
      "statement": "Every service strip declares a local-continuity posture, so an operator can answer what still works locally if the service is impaired.",
      "holds": true
    },
    {
      "invariant_id": "response_panes.steps_ordered",
      "statement": "Every pane's steps are contiguously ordered from 1, so the guided response has a defined sequence.",
      "holds": true
    },
    {
      "invariant_id": "response_panes.execution_computed",
      "statement": "Every step's execution admission equals the computed admission from its intent, boundary, approval, boundary state, and live-target presence.",
      "holds": true
