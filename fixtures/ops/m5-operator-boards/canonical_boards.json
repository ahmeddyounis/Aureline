  "invariants": [
    {
      "invariant_id": "operator_boards.canonical_object_identity",
      "statement": "Every tile carries a canonical aureline:// object handle and routes open-detail to that exact handle, so boards never invent a separate identity layer for the objects they summarize.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.surface_binding",
      "statement": "Every board binds a surface family that exists in the operator-surface matrix, by the matrix's own surface id, rather than cloning a per-surface model.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.no_silent_green",
      "statement": "Every tile's effective state equals the computed no-silent-green state, so a stale or waived tile can never be frozen as a clear green tile.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.owner_blocker_visible",
      "statement": "Every tile names an owner and decision right, and any blocked or waived tile carries a visible reason rather than hiding it behind hover-only chrome.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.saved_views_present",
      "statement": "Every board offers at least one saved view, its default view resolves to one, and every view names its order with a stated reason.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.shared_filter_vocabulary",
      "statement": "Every filter clause references a facet from the shared vocabulary, and every value on a closed-vocabulary facet is one of that facet's allowed tokens.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.open_detail_parity",
      "statement": "Every board offers a canonical open-detail action and every tile's open-detail route is its canonical object handle.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.export_parity",
      "statement": "Every board's frozen export equals re-applying its default saved view, so the export preserves the exact filters, order, and per-tile state.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.export_preserves_truth",
      "statement": "Every export carries the applied view's scope, owner, filters, and order, labels itself a snapshot, and preserves each row's effective state, freshness, ownership, and blocker/waiver reason.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.first_real_boards_present",
      "statement": "The incident-response, support-queue, admin-approvals, and release-readiness boards are all present, proving the shared contract across real boards.",
      "holds": true
    },
    {
      "invariant_id": "operator_boards.stable_ids_unique",
      "statement": "Board ids, saved-view ids, and tile ids are each defined once and unique across the set.",
      "holds": true
    }
  ],
