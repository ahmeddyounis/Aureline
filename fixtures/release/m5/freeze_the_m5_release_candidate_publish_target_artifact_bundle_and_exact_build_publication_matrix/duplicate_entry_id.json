      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "re_attest",
      "blocks_publication": true,
      "rationale": "A stable artifact family must publish a verifiable build attestation."
    },
    {
      "rule_id": "stop-sbom-incomplete",
      "title": "SBOM incomplete",
      "trigger_reason": "sbom_incomplete",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "regenerate_sbom",
      "blocks_publication": true,
      "rationale": "A stable artifact family must publish an in-scope SBOM."
    },
    {
      "rule_id": "stop-symbols-missing",
      "title": "Symbols or source maps missing",
      "trigger_reason": "symbols_missing",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "publish_symbols",
      "blocks_publication": true,
      "rationale": "A stable artifact family must be symbolicatable from published or retained symbols."
    },
    {
      "rule_id": "stop-mirror-stale",
      "title": "Mirror copy stale or unpublished",
      "trigger_reason": "mirror_stale",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "refresh_mirror",
      "blocks_publication": true,
      "rationale": "A mirror-expected stable family must keep its mirror copy current with the canonical graph."
    },
    {
      "rule_id": "stop-rollback-target-missing",
      "title": "Rollback target missing",
      "trigger_reason": "rollback_target_missing",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "record_rollback_target",
      "blocks_publication": true,
      "rationale": "A stable artifact family must record a last-known-good rollback target."
    },
    {
      "rule_id": "stop-exact-build-linkage-broken",
      "title": "Exact-build linkage broken",
      "trigger_reason": "exact_build_linkage_broken",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "rebuild_exact_build",
      "blocks_publication": true,
      "rationale": "Build success is not publication readiness; a stable family must link its published artifact to a verifiable rebuild."
    },
    {
      "rule_id": "stop-evidence-incomplete",
      "title": "Evidence set incomplete",
      "trigger_reason": "evidence_incomplete",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "recapture_evidence",
      "blocks_publication": true,
      "rationale": "A stable artifact family must carry its complete required evidence set."
    },
    {
      "rule_id": "stop-proof-packet-missing",
      "title": "Proof packet missing",
      "trigger_reason": "proof_packet_missing",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "refresh_proof_packet",
      "blocks_publication": true,
      "rationale": "A stable artifact family must have a captured proof packet."
    },
    {
      "rule_id": "stop-proof-packet-stale",
      "title": "Proof packet stale",
      "trigger_reason": "proof_packet_stale",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "refresh_proof_packet",
      "blocks_publication": true,
      "rationale": "A stable artifact family must ride a proof packet within its freshness SLO."
    },
    {
      "rule_id": "stop-waiver-expired",
      "title": "Waiver expired",
      "trigger_reason": "waiver_expired",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "narrow_claim",
      "blocks_publication": true,
      "rationale": "A stable family relying on an expired waiver must narrow before publication."
    },
    {
      "rule_id": "stop-owner-signoff-missing",
      "title": "Owner sign-off missing",
      "trigger_reason": "owner_signoff_missing",
      "applies_to_labels": [
        "lts",
        "stable"
      ],
      "default_action": "request_owner_signoff",
      "blocks_publication": true,
      "rationale": "A stable artifact family must be owner-signed before publication."
    }
