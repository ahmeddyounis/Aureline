  "invariants": [
    {
      "invariant_id": "breakpoints.one_canonical_pill_vocabulary",
      "statement": "Every breakpoint carries exactly one pill whose verification and mapping tokens come from the frozen vocabulary and whose flags equal their derivation, so a breakpoint shown anywhere traces back to one spec and one state vocabulary.",
      "holds": true
    },
    {
      "invariant_id": "breakpoints.verification_vocabulary_complete",
      "statement": "Pending, verified, unbound, unsupported, and policy-blocked are all materialized.",
      "holds": true
    },
    {
      "invariant_id": "breakpoints.mapping_vocabulary_complete",
      "statement": "Exact, misaligned, needs-remap, and unmapped are all materialized.",
      "holds": true
    },
    {
      "invariant_id": "breakpoints.green_never_hides_unverified_misaligned_replay_or_blocked",
      "statement": "The unqualified confirmed-stop icon renders only for a verified, exact, non-replay breakpoint; an unbound, misaligned, replay-only, or policy-blocked breakpoint always discloses.",
      "holds": true
    },
    {
      "invariant_id": "breakpoints.lost_identity_degrades_to_needs_remap",
      "statement": "A breakpoint whose stable source identity was lost stays visible and is flagged needs-remap rather than vanishing, and a needs-remap state only ever comes from a lost source identity.",
      "holds": true
    },
    {
      "invariant_id": "breakpoints.lexical_fallback_never_presented_as_exact",
      "statement": "A lexical-fallback mapping is never presented as an exact semantic mapping; it always discloses it is a textual match.",
      "holds": true
    },
    {
      "invariant_id": "breakpoints.notebook_preserves_stable_cell_identity",
      "statement": "Every notebook-scoped breakpoint keeps a stable cell anchor and is never shown as a clean confirmed stop while its in-cell mapping is not exact.",
      "holds": true
    },
    {
      "invariant_id": "breakpoints.replay_preserves_stable_frame_identity_and_stays_replay_only",
      "statement": "Every replay-scoped breakpoint keeps a stable frame anchor, stays replay-only, and never renders a live confirmed stop.",
      "holds": true
    },
    {
      "invariant_id": "breakpoints.export_retains_verification_and_mapping_state",
      "statement": "Every breakpoint retains its verification and mapping state as typed pill fields and cites an export-safe proof packet, so support export never flattens it into rendered chrome.",
      "holds": true
    }
  ],
  "raw_payload_excluded": true
}
