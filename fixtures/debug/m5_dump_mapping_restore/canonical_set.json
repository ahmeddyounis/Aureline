  "invariants": [
    {
      "invariant_id": "artifacts.one_canonical_mapping_pill",
      "statement": "Every artifact strip carries exactly one pill whose fidelity, build-match, and source-class tokens come from the frozen vocabulary and whose flags equal their derivation.",
      "holds": true
    },
    {
      "invariant_id": "artifacts.mapping_vocabulary_complete",
      "statement": "Exact, approximate, symbol-only, unresolved, imported, and mismatched-build are all materialized across the strips.",
      "holds": true
    },
    {
      "invariant_id": "artifacts.artifact_kind_vocabulary_complete",
      "statement": "Core file, crash dump, inspect-only session, symbol artifact, source map, and replay capture are all materialized.",
      "holds": true
    },
    {
      "invariant_id": "artifacts.source_class_vocabulary_complete",
      "statement": "Workspace, local, provider, mirror, and imported source classes are all materialized.",
      "holds": true
    },
    {
      "invariant_id": "artifacts.exact_link_never_hides_degraded_mapping",
      "statement": "The unqualified precise source link renders only for an exact mapping backed by an exact-build match; any degraded strip always discloses.",
      "holds": true
    },
    {
      "invariant_id": "artifacts.imported_and_mismatch_stay_honest",
      "statement": "Imported and build-mismatch are both materialized; an imported mapping is always sourced from an import, a build-mismatch always carries a rejected build match, and neither ever renders the exact source link.",
      "holds": true
    },
    {
      "invariant_id": "artifacts.entrypoints_distinct_and_visible",
      "statement": "Core-file, crash-dump, open-replay, and open-inspect-only are each present and each open an inspect-only session, distinct from importing a symbol or source-map artifact, which never opens a session.",
      "holds": true
    },
    {
      "invariant_id": "artifacts.build_artifact_identity_present",
      "statement": "Every strip carries a build id or artifact ref, a capture time, an entrypoint that accepts its kind, and a debug format exactly for mapping inputs.",
      "holds": true
    },
    {
      "invariant_id": "artifacts.mirrored_and_imported_sources_disclosed",
      "statement": "Mirrored and imported sources are both materialized and disclose their provenance rather than posing as a local-trusted one.",
      "holds": true
    },
    {
      "invariant_id": "restore.posture_vocabulary_complete",
      "statement": "Process-gone, inspect-only-continuation, reconnect-required, and manually-relaunchable are all materialized.",
      "holds": true
    },
    {
      "invariant_id": "restore.never_implies_live_continuity_or_authority",
      "statement": "Every restored layout carries one canonical pill that never implies live target continuity or reacquired process authority and always discloses its non-live posture.",
      "holds": true
    },
    {
      "invariant_id": "restore.exact_build_mapping_only_when_still_verified",
      "statement": "A restored layout shows an exact-build mapping only when the mapping is exact and the build is still verified; at least one restored layout carries a degraded mapping.",
      "holds": true
    },
    {
      "invariant_id": "restore.required_action_named",
      "statement": "Reconnect-required and manually-relaunchable name an explicit action; gone and inspect-only do not; both an action-required and a no-action restore exist.",
      "holds": true
    },
    {
      "invariant_id": "set.shared_mapping_vocabulary_supersets_frame_fidelity",
      "statement": "The shared mapping vocabulary is a strict superset of the frame-mapping fidelity: each frame fidelity widens and narrows back to itself, and the imported and mismatched-build states exist beyond the four frame states.",
      "holds": true
    },
    {
      "invariant_id": "set.export_retains_artifact_and_restore_state",
      "statement": "Every strip and restore retains its typed tokens and cites an export-safe proof packet, so support export never flattens it into rendered chrome.",
      "holds": true
    }
  ],
