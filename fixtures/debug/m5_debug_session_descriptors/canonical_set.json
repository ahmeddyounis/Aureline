  "invariants": [
    {
      "invariant_id": "descriptors.session_modes_distinct",
      "statement": "Launch, attach, core-file, replay, and inspect-only appear as five distinct session modes, never one generic debug session.",
      "holds": true
    },
    {
      "invariant_id": "descriptors.inspect_only_modes_hold_no_live_authority",
      "statement": "Core-file, replay, and inspect-only sessions never hold live authority over a target.",
      "holds": true
    },
    {
      "invariant_id": "descriptors.restore_never_reacquires_authority_silently",
      "statement": "A restored-layout-only or reattach-required session holds no live authority; only an explicit reattach reacquires it.",
      "holds": true
    },
    {
      "invariant_id": "descriptors.live_authority_derived_from_mode_posture_drift",
      "statement": "Each session's live-authority flag equals the derivation from its mode, re-entry posture, and adapter drift together.",
      "holds": true
    },
    {
      "invariant_id": "descriptors.attach_identity_preserved_picker_to_session",
      "statement": "Each session resolves its attach target and echoes the target identity, mutability, privilege class, boundary, and adapter drift unchanged from the picker descriptor.",
      "holds": true
    },
    {
      "invariant_id": "descriptors.adapter_drift_first_class",
      "statement": "Adapter drift is a first-class label on every session and target — drift, reconnect-required, inspect-only, and unsupported-skew all appear and require disclosure.",
      "holds": true
    },
    {
      "invariant_id": "descriptors.every_session_routes_execution_context",
      "statement": "Every session carries a non-empty execution-context id and a typed entrypoint, so re-entry, restart, and open-in-support reuse one canonical identity.",
      "holds": true
    },
    {
      "invariant_id": "descriptors.run_state_authority_consistent",
      "statement": "No reconstructed, awaiting-reattach, or terminated run state is paired with held live authority.",
      "holds": true
