  "downgrade_rules": [
    {
      "rule_id": "surface_evidence_stale_blocks_own_claim",
      "trigger_class": "surface_evidence_stale",
      "source_state": "qualified",
      "downgraded_state": "blocked_unverified",
      "required_effect": "When a supportability surface's own lane evidence (schema, artifact, or fixture) is stale or missing, the surface blocks and any integrated surface that binds it narrows; neither may inherit a greener neighboring claim.",
      "rationale": "The integrated Support Center, export, and intake surfaces each need their own proof; a passing crash or Doctor row may not keep a stale surface green.",
      "evidence_refs": [
        "docs/help/support/m5-supportability-qualification.md",
        "schemas/support/m5-support-center-matrix.schema.json",
        "schemas/runtime/m5-environment-status-strip.schema.json"
      ]
    },
    {
      "rule_id": "supportability_drill_stale_narrows_send_claim",
      "trigger_class": "supportability_drill_stale",
      "source_state": "qualified",
      "downgraded_state": "local_self_diagnosis_only",
      "required_effect": "When a bound supportability drill (diagnosis latency, consent-sheet accuracy, export-mode parity, crash-loop recovery, or exact-build intake) is stale, the rows it backs narrow; a send-capable surface narrows to a local-save / self-diagnosis claim while local-save stays first-class.",
      "rationale": "A send or consent claim is only safe while the drill that proves its accuracy and parity is current.",
      "evidence_refs": [
        "artifacts/support/diagnosis_latency_scoreboard.yaml",
        "artifacts/support/redaction_accuracy_checks.yaml",
        "artifacts/support/recovery_ladder_cases.yaml"
      ]
    },
    {
      "rule_id": "deployment_mode_parity_lost_narrows_claim",
      "trigger_class": "deployment_mode_parity_lost",
      "source_state": "qualified",
      "downgraded_state": "limited_profile_scoped",
      "required_effect": "When a surface stops projecting identically across desktop and CLI/headless, its row narrows to the deployment modes it still covers; the qualification may not imply parity it cannot prove.",
      "rationale": "Blocked-user recovery must not fragment across deployment modes; a missing mode narrows the claim.",
      "evidence_refs": [
        "docs/help/support/m5-supportability-qualification.md",
        "schemas/support/m5-support-center-matrix.schema.json"
      ]
    },
    {
      "rule_id": "policy_blocked_send_keeps_local_save_first",
      "trigger_class": "policy_blocked_send",
      "source_state": "qualified",
      "downgraded_state": "local_self_diagnosis_only",
      "required_effect": "When a profile policy-blocks a team-share or formal-support send, the surface narrows to a local-save / self-diagnosis claim; local-save and self-diagnosis stay first-class and are never demoted below a blocked send path.",
      "rationale": "Support claims may not widen on profiles or deployment modes whose send paths are policy-blocked, but local recovery must remain fully claimable.",
      "evidence_refs": [
        "schemas/support/m5-support-bundle-consent.schema.json",
        "schemas/support/m5-supportability-handoff-packets.schema.json"
      ]
    },
    {
      "rule_id": "consumer_binding_missing_blocks_shared_truth",
      "trigger_class": "consumer_binding_missing",
      "source_state": "qualified",
      "downgraded_state": "blocked_unverified",
      "required_effect": "If Help/About, the desktop Support Center, CLI/headless, support export, shiproom, or release manifest stops ingesting this packet by reference, the broad supportability claim blocks until parity is restored.",
      "rationale": "The task requires one supportability qualification index; broken consumer bindings invalidate that promise.",
      "evidence_refs": [
        "docs/help/support/m5-supportability-qualification.md",
        "artifacts/shiproom/m5-supportability-claim-packet/m5_supportability_claim_packet.md",
        "schemas/support/support_bundle_manifest.schema.json",
        "artifacts/release/stable/claim-publication-manifest/manifest.json"
      ]
    }
  ],
