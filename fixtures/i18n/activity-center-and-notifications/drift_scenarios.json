{
  "record_kind": "attention_vocabulary_drift_scenario_set_record",
  "schema_version": 1,
  "scenario_set_id": "i18n-drift:m5-attention-and-lifecycle:v1",
  "glossary_id_ref": "i18n-glossary:m5-attention-and-lifecycle:v1",
  "scenarios": [
    {
      "scenario_id": "drift:severity-softened:failed:es-MX",
      "description": "A translation softens a failed job to merely informational.",
      "mutation": {
        "kind": "set_asserted_severity",
        "term_key": "attention.lifecycle.failed",
        "locale": "es-MX",
        "rank": "informational"
      },
      "expected_class": "severity_rank_altered"
    },
    {
      "scenario_id": "drift:severity-strengthened:completed:ja-JP",
      "description": "A translation strengthens a successful completion into a failure.",
      "mutation": {
        "kind": "set_asserted_severity",
        "term_key": "attention.lifecycle.completed",
        "locale": "ja-JP",
        "rank": "failure"
      },
      "expected_class": "severity_rank_altered"
    },
    {
      "scenario_id": "drift:action-reordered:needs_approval:ar-SA",
      "description": "A translation reorders a lifecycle state in the row sequence.",
      "mutation": {
        "kind": "set_asserted_action_order",
        "term_key": "attention.lifecycle.needs_approval",
        "locale": "ar-SA",
        "index": 99
      },
      "expected_class": "action_order_altered"
    },
    {
      "scenario_id": "drift:lexical-inconsistent:running:es-MX",
      "description": "The running lifecycle state and running badge translate the same word differently.",
      "mutation": {
        "kind": "set_localized_term",
        "term_key": "attention.lifecycle.running",
        "locale": "es-MX",
        "text": "Ejecutándose ahora"
      },
      "expected_class": "lexical_consistency_broken"
    },
    {
      "scenario_id": "drift:collision:failed-vs-suppressed:ja-JP",
      "description": "A failed state collides onto the policy-suppressed translation.",
      "mutation": {
        "kind": "set_localized_term",
        "term_key": "attention.suppression.suppressed_by_policy",
        "locale": "ja-JP",
        "text": "失敗"
      },
      "expected_class": "term_collision"
    },
    {
      "scenario_id": "drift:severity-hidden-truncation:admin:ar-SA",
      "description": "Truncation hides the severity of admin suppression messaging.",
      "mutation": {
        "kind": "hide_severity_under_truncation",
        "term_key": "attention.suppression.admin_suppression",
        "locale": "ar-SA"
      },
      "expected_class": "severity_hidden_under_truncation"
    }
  ]
}
